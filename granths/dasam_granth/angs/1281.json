{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1281,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1281_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਛ ਭੋਜ ਪਕਵਾਨ ਪਕਾਯੋ ॥",
      "transliteration": "bhachh bhoj pakavaan pakaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਖਾਣ ਲਈ ਬਹੁਤ ਪਕਵਾਨ ਅਤੇ ਭੋਜਨ ਤਿਆਰ ਕਰਵਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "भछ भोज पकवान पकायो ॥",
      "sourceLineId": "134555",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਦਰਾ ਅਧਿਕ ਤਹਾ ਲੈ ਧਰਾ ॥",
      "transliteration": "madharaa adhik tahaa lai dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੀ ਸ਼ਰਾਬ ਉਥੇ ਰਖਵਾ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "मदरा अधिक तहा लै धरा ॥",
      "sourceLineId": "134556",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਾਤ ਬਾਰ ਜੁ ਚੁਆਇਨਿ ਕਰਾ ॥੧੦॥",
      "transliteration": "saat baar ju chuaain karaa ||10||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਤ ਵਾਰ (ਭੱਠੀ ਤੋਂ) ਕਢੀ ਗਈ ਸੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "सात बार जु चुआइनि करा ॥१०॥",
      "sourceLineId": "134557",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਲੀ ਭਾਤਿ ਸਭ ਅੰਨ ਬਨਾਏ ॥",
      "transliteration": "bhalee bhaat sabh a(n)n banaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਖਾਣ ਦੇ ਪਦਾਰਥ ਬਣਵਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "भली भाति सभ अंन बनाए ॥",
      "sourceLineId": "134558",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਬਿਖੁ ਸਾਥ ਮਿਲਾਏ ॥",
      "transliteration": "bhaat bhaat bikh saath milaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਵਿਚ ਅਨੇਕ ਪ੍ਰਕਾਰ ਦੀ ਵਿਸ਼ ਮਿਲਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "भाति भाति बिखु साथ मिलाए ॥",
      "sourceLineId": "134559",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਰਧਭਾਨ ਬਹੁ ਦਈ ਅਫੀਮੈ ॥",
      "transliteration": "garadhabhaan bahu dhiee afeemai ||",
      "translation": "",
      "punjabiViakhya": "ਖੋਤਿਆਂ ਨੂੰ ਬਹੁਤ ਅਫ਼ੀਮ ਖਵਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "गरधभान बहु दई अफीमै ॥",
      "sourceLineId": "134560",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਾਧੇ ਆਨਿ ਅਸੁਰ ਕੀ ਸੀਮੈ ॥੧੧॥",
      "transliteration": "baadhe aan asur kee seemai ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੈਂਤ ਦੀ ਸੀਮਾ ਵਿਚ ਲਿਆ ਕੇ ਬੰਨ੍ਰਹ ਦਿੱਤੇ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "बाधे आनि असुर की सीमै ॥११॥",
      "sourceLineId": "134561",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਧੀ ਰਾਤਿ ਦੈਤ ਤਹ ਆਯੋ ॥",
      "transliteration": "aadhee raat dhait teh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਧੀ ਰਾਤ ਨੂੰ ਦੈਂਤ ਉਥੇ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "आधी राति दैत तह आयो ॥",
      "sourceLineId": "134562",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਰਧਭਾਨ ਮਹਿਖਾਨ ਚਬਾਯੋ ॥",
      "transliteration": "garadhabhaan mahikhaan chabaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਖੋਤਿਆਂ ਤੇ ਝੋਟਿਆਂ ਨੂੰ ਚਬਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "गरधभान महिखान चबायो ॥",
      "sourceLineId": "134563",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭਛ ਭੋਜ ਬਹੁਤੇ ਤਬ ਖਾਏ ॥",
      "transliteration": "bhachh bhoj bahute tab khaae ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਤਦ ਬਹੁਤ ਭੋਜਨ ਖਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "भछ भोज बहुते तब खाए ॥",
      "sourceLineId": "134564",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਰਿ ਭਰਿ ਪ੍ਯਾਲੇ ਮਦਹਿ ਚੜਾਏ ॥੧੨॥",
      "transliteration": "bhar bhar payaale madheh chaRaae ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਰਾਬ ਨਾਲ ਭਰ ਭਰ ਕੇ ਪਿਆਲੇ ਪੀਤੇ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "भरि भरि प्याले मदहि चड़ाए ॥१२॥",
      "sourceLineId": "134565",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਦ ਕੀ ਪੀਏ ਬਿਸੁਧ ਹ੍ਵੈ ਰਹਾ ॥",
      "transliteration": "madh kee pe'ee bisudh havai rahaa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਰਾਬ ਪੀ ਕੇ ਬੇਹੋਸ਼ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "मद की पीए बिसुध ह्वै रहा ॥",
      "sourceLineId": "134566",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਨਿ ਅਫੀਮ ਗਰੌ ਤਿਹ ਗਹਾ ॥",
      "transliteration": "aan afeem garau teh gahaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਫ਼ੀਮ ਨੇ ਉਸ ਦਾ ਗੱਲਾ ਘੁਟ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "आनि अफीम गरौ तिह गहा ॥",
      "sourceLineId": "134567",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੋਇ ਰਹਾ ਸੁਧਿ ਕਛੂ ਨ ਪਾਈ ॥",
      "transliteration": "soi rahaa sudh kachhoo na paiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸੌਂ ਗਿਆ ਅਤੇ ਕੋਈ ਵੀ ਹੋਸ਼ ਨਾ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "सोइ रहा सुधि कछू न पाई ॥",
      "sourceLineId": "134568",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਰਿ ਪਛਾਨ ਘਾਤ ਕਹ ਧਾਈ ॥੧੩॥",
      "transliteration": "naar pachhaan ghaat keh dhaiee ||13||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੌਕਾ ਤਕ ਕੇ (ਉਹ) ਇਸਤਰੀ ਮਾਰਨ ਲਈ ਆ ਗਈ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "नारि पछान घात कह धाई ॥१३॥",
      "sourceLineId": "134569",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਠ ਹਜ਼ਾਰ ਮਨ ਸਿਕਾ ਲਯੋ ॥",
      "transliteration": "aTh hazaar man sikaa layo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਅੱਠ ਹਜ਼ਾਰ ਮਣ ਸਿੱਕਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "अठ हज़ार मन सिका लयो ॥",
      "sourceLineId": "134570",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾ ਪਰ ਅਵਟਿ ਢਾਰਿ ਕਰਿ ਦਯੋ ॥",
      "transliteration": "taa par avaT ddaar kar dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੰਘਾਰ ਕੇ ਉਸ ਉਤੇ ਪਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "ता पर अवटि ढारि करि दयो ॥",
      "sourceLineId": "134571",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭਸਮੀ ਭੂਤ ਦੈਤ ਵਹੁ ਕਿਯੋ ॥",
      "transliteration": "bhasamee bhoot dhait vahu kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੈਂਤ ਨੂੰ ਸਾੜ ਕੇ ਸੁਆਹ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "भसमी भूत दैत वहु कियो ॥",
      "sourceLineId": "134572",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਿਰਹਵਤੀ ਪੁਰ ਕੌ ਸੁਖ ਦਿਯੋ ॥੧੪॥",
      "transliteration": "birahavatee pur kau sukh dhiyo ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਿਰਹਵਤੀ ਨਾ ਦੇ ਨਗਰ ਨੂੰ ਸੁਖ ਦਿੱਤਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "बिरहवती पुर कौ सुख दियो ॥१४॥",
      "sourceLineId": "134573",
      "sourceShabadId": "12579",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "134574",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਹ ਛਲ ਅਬਲਾ ਅਸੁਰ ਹਨਿ ਨ੍ਰਿਪਹਿ ਬਰਿਯੋ ਸੁਖ ਪਾਇ ॥",
      "transliteration": "eeh chhal abalaa asur han nirapeh bariyo sukh pai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਇਸਤਰੀ (ਵੇਸਵਾ) ਨੇ ਦੈਂਤ ਨੂੰ ਮਾਰਿਆ ਅਤੇ ਰਾਜੇ ਨਾਲ ਵਿਆਹ ਕਰ ਕੇ ਸੁਖ ਪਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "इह छल अबला असुर हनि नृपहि बरियो सुख पाइ ॥",
      "sourceLineId": "134575",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਕਲ ਪ੍ਰਜਾ ਸੁਖ ਸੌ ਬਸੀ ਹ੍ਰਿਦੈ ਹਰਖ ਉਪਜਾਇ ॥੧੫॥",
      "transliteration": "sakal prajaa sukh sau basee hiradhai harakh upajai ||15||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਪ੍ਰਜਾ ਹਿਰਦੇ ਵਿਚ ਪ੍ਰਸੰਨ ਹੋ ਕੇ ਸੁਖ ਪੂਰਵਕ ਰਹਿਣ ਲਗੀ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "सकल प्रजा सुख सौ बसी हृदै हरख उपजाइ ॥१५॥",
      "sourceLineId": "134576",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੦॥੬੧੯੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau tees charitr samaapatam sat subham sat ||330||6193||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੩੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੩੦॥੬੧੯੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ तीस चरित्र समापतम सतु सुभम सतु ॥३३०॥६१९३॥अफजूँ॥",
      "sourceLineId": "134577",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134578",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਵਲੰਦੇਜ ਕੋ ਏਕ ਨ੍ਰਿਪਾਲਾ ॥",
      "transliteration": "vala(n)dhej ko ek nirapaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਵਲੰਦੇਜ (ਦੇਸ਼) ਦਾ ਇਕ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "वलंदेज को एक नृपाला ॥",
      "sourceLineId": "134579",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਵਲੰਦੇਜ ਦੇਈ ਘਰ ਬਾਲਾ ॥",
      "transliteration": "vala(n)dhej dheiee ghar baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਵਲੰਦੇਜ ਦੇਈ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "वलंदेज देई घर बाला ॥",
      "sourceLineId": "134580",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾ ਪੁਰ ਕੁਪ੍ਰਯੋ ਫਿਰੰਗ ਰਾਇ ਮਨ ॥",
      "transliteration": "taa pur kuprayo fira(n)g rai man ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੇ ਫਿਰੰਗ ਰਾਇ ਮਨ ਵਿਚ ਕ੍ਰੋਧਿਤ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "ता पुर कुप्रयो फिरंग राइ मन ॥",
      "sourceLineId": "134581",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੈਨ ਚੜਾ ਲੈ ਕਰਿ ਸੰਗ ਅਨਗਨ ॥੧॥",
      "transliteration": "sain chaRaa lai kar sa(n)g anagan ||1||",
      "translation": "",
      "punjabiViakhya": "ਅਣਗਿਣਤ ਸੈਨਾ ਲੈ ਕੇ ਚੜ੍ਰਹਾਈ ਕਰ ਦਿੱਤੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "सैन चड़ा लै करि संग अनगन ॥१॥",
      "sourceLineId": "134582",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਮੁ ਫਿਰੰਗੀ ਰਾਇ ਨ੍ਰਿਪਤਿ ਤਿਹ ॥",
      "transliteration": "naam fira(n)gee rai nirapat teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਜੇ ਦਾ ਨਾ ਫਿਰੰਗੀ ਰਾਇ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "नामु फिरंगी राइ नृपति तिह ॥",
      "sourceLineId": "134583",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅੰਗਰੇਜਨ ਪਰ ਚੜਤ ਕਰੀ ਜਿਹ ॥",
      "transliteration": "a(n)garejan par chaRat karee jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਅੰਗ੍ਰੇਜ਼ਾ ਉਤੇ ਚੜ੍ਰਹਾਈ ਕੀਤੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "अंगरेजन पर चड़त करी जिह ॥",
      "sourceLineId": "134584",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਨਗਨ ਲਏ ਚਮੂੰ ਚਤੁਰੰਗਾ ॥",
      "transliteration": "anagan le chamoo(n) chatura(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਅਣਗਿਣਤ ਚਤੁਰੰਗਨੀ ਸੈਨਾ ਨਾਲ ਲੈ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "अनगन लए चमूँ चतुरंगा ॥",
      "sourceLineId": "134585",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਨੁ ਕਰਿ ਉਮਡਿ ਚਲਿਯੋ ਜਲ ਗੰਗਾ ॥੨॥",
      "transliteration": "jan kar umadd chaliyo jal ga(n)gaa ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਗੰਗਾ ਦਾ ਜਲ ਉਮਡ ਪਿਆ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "जनु करि उमडि चलियो जल गंगा ॥२॥",
      "sourceLineId": "134586",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਵਲੰਦੇਜ ਦੇਈ ਕੇ ਨਾਥਹਿ ॥",
      "transliteration": "vala(n)dhej dheiee ke naatheh ||",
      "translation": "",
      "punjabiViakhya": "ਵਲੰਦੇਜ ਦੇਈ ਦੇ ਪਤੀ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "वलंदेज देई के नाथहि ॥",
      "sourceLineId": "134587",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪ੍ਰਾਨ ਤਜੇ ਡਰ ਹੀ ਕੇ ਸਾਥਹਿ ॥",
      "transliteration": "praan taje ddar hee ke saatheh ||",
      "translation": "",
      "punjabiViakhya": "ਡਰ ਨਾਲ ਹੀ ਪ੍ਰਾਣ ਤਿਆਗ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "प्रान तजे डर ही के साथहि ॥",
      "sourceLineId": "134588",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਾਨੀ ਭੇਦ ਨ ਕਾਹੂ ਦਯੋ ॥",
      "transliteration": "raanee bhedh na kaahoo dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਇਹ ਭੇਦ ਕਿਸੇ ਨੂੰ ਨਾ ਦਸਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "रानी भेद न काहू दयो ॥",
      "sourceLineId": "134589",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤ੍ਰਾਸ ਤ੍ਰਸਤ ਰਾਜਾ ਮਰਿ ਗਯੋ ॥੩॥",
      "transliteration": "traas trasat raajaa mar gayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਜਾ ਡਰ ਕਰ ਕੇ ਹੀ ਮਰ ਗਿਆ ਹੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "त्रास त्रसत राजा मरि गयो ॥३॥",
      "sourceLineId": "134590",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮ੍ਰਿਤਕ ਨਾਥ ਤਿਹ ਸਮੈ ਨਿਹਾਰਾ ॥",
      "transliteration": "mritak naath teh samai nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਸ ਵੇਲੇ ਆਪਣੇ ਮੋਏ ਹੋਏ ਪਤੀ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "मृतक नाथ तिह समै निहारा ॥",
      "sourceLineId": "134591",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਔਰ ਸੰਗ ਬਹੁ ਸੈਨ ਬਿਚਾਰਾ ॥",
      "transliteration": "aauar sa(n)g bahu sain bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੈਨਾ ਨਾਲ ਵਿਚਾਰ ਵਿਟਾਦਰਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "और संग बहु सैन बिचारा ॥",
      "sourceLineId": "134592",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਹੈ ਘਾਤ ਜਿਯ ਮਾਹਿ ਬਿਚਾਰੀ ॥",
      "transliteration": "eihai ghaat jiy maeh bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮਨ ਵਿਚ ਇਹ ਵਿਓਾਂਤ ਬਣਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "इहै घात जिय माहि बिचारी ॥",
      "sourceLineId": "134593",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਾਸਟ ਪੁਤ੍ਰਿਕਾ ਲਛ ਸਵਾਰੀ ॥੪॥",
      "transliteration": "kaasaT putirakaa lachh savaaree ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਠ ਦੀਆਂ ਇਕ ਲਖ ਮੂਰਤੀਆਂ ਬਣਵਾ ਲਈਆਂ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "कासट पुतृका लछ सवारी ॥४॥",
      "sourceLineId": "134594",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਲਛ ਹੀ ਹਾਥ ਬੰਦੂਕ ਸਵਾਰੀ ॥",
      "transliteration": "lachh hee haath ba(n)dhook savaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਹੱਥਾ ਵਿਚ ਲੱਖ ਹੀ ਬੰਦੂਕਾ ਥੰਮਾ ਦਿੱਤੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "लछ ही हाथ बंदूक सवारी ॥",
      "sourceLineId": "134595",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦਾਰੂ ਗੋਲਿਨ ਭਰੀ ਸੁਧਾਰੀ ॥",
      "transliteration": "dhaaroo golin bharee sudhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦਾਰੂ ਅਤੇ ਗੋਲੀਆਂ ਨਾਲ ਭਰੀਆਂ ਹੋਈਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "दारू गोलिन भरी सुधारी ॥",
      "sourceLineId": "134596",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਡਿਵਢਾ ਚੁਨਤ ਭਈ ਤੁਪਖਾਨਾ ॥",
      "transliteration": "ddivaddaa chunat bhiee tupakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਡਿਉਡੀ ਉਤੇ ਤੋਪਖਾਨੇ ਨੂੰ ਬੀੜ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "डिवढा चुनत भई तुपखाना ॥",
      "sourceLineId": "134597",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤੀਰ ਬੰਦੂਕ ਕਮਾਨ ਅਰੁ ਬਾਨਾ ॥੫॥",
      "transliteration": "teer ba(n)dhook kamaan ar baanaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੀਰ, ਬੰਦੂਕ, ਕਮਾਨ ਅਤੇ ਬਾਣ ਆਦਿ (ਇਕੱਠੇ ਕਰ ਲਏ) ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "तीर बंदूक कमान अरु बाना ॥५॥",
      "sourceLineId": "134598",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਬ ਅਰਿ ਸੈਨ ਨਿਕਟ ਤਿਹ ਆਈ ॥",
      "transliteration": "jab ar sain nikaT teh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਵੈਰੀ ਦੀ ਸੈਨਾ ਨੇੜੇ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "जब अरि सैन निकट तिह आई ॥",
      "sourceLineId": "134599",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਭਹਿਨ ਗਈ ਪਲੀਤਾ ਲਾਈ ॥",
      "transliteration": "sabhahin giee paleetaa laiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਾਰਿਆਂ ਪਲੀਤਿਆਂ ਨੂੰ (ਅੱਗ) ਲਗਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "सभहिन गई पलीता लाई ॥",
      "sourceLineId": "134600",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬੀਸ ਹਜਾਰ ਤੁਪਕ ਇਕ ਬਾਰ ॥",
      "transliteration": "bees hajaar tupak ik baar ||",
      "translation": "",
      "punjabiViakhya": "ਵੀਹ ਹਜ਼ਾਰ ਬੰਦੂਕਾ ਇਕੋ ਵਾਰ ਛੁਟ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "बीस हजार तुपक इक बार ॥",
      "sourceLineId": "134601",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਛੁਟਗੀ ਕਛੁ ਨ ਰਹੀ ਸੰਭਾਰਾ ॥੬॥",
      "transliteration": "chhuTagee kachh na rahee sa(n)bhaaraa ||6||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਸੇ ਨੂੰ) ਕੋਈ ਸੰਭਾਲ ਨਾ ਰਹੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "छुटगी कछु न रही संभारा ॥६॥",
      "sourceLineId": "134602",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਿਮਿ ਮਖੀਰ ਕੀ ਉਡਤ ਸੁ ਮਾਖੀ ॥",
      "transliteration": "jim makheer kee uddat su maakhee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸ਼ਹਿਦ ਦੇ ਛੱਤੇ ਤੋਂ ਮੱਖੀਆਂ ਉਡਦੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "जिमि मखीर की उडत सु माखी ॥",
      "sourceLineId": "134603",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਿਮਿ ਹੀ ਚਲੀ ਬੰਦੂਕੈ ਬਾਖੀ ॥",
      "transliteration": "tim hee chalee ba(n)dhookai baakhee ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਵੇਾਂ ਹੀ ਬਾਕੀ ਦੀਆਂ ਬੰਦੂਕਾ ਵੀ ਚਲ ਪਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "तिमि ही चली बंदूकै बाखी ॥",
      "sourceLineId": "134604",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਾ ਕੇ ਲਗੇ ਅੰਗ ਮੌ ਬਾਨਾ ॥",
      "transliteration": "jaa ke lage a(n)g mau baanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਬਾਣ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "जा के लगे अंग मौ बाना ॥",
      "sourceLineId": "134605",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤਤਛਿਨ ਤਿਨ ਭਟ ਤਜੇ ਪਰਾਨਾ ॥੭॥",
      "transliteration": "tatachhin tin bhaT taje paraanaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਸੂਰਮੇ ਤੁਰਤ ਪ੍ਰਾਣ ਛਡ ਗਏ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "ततछिन तिन भट तजे पराना ॥७॥",
      "sourceLineId": "134606",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਰਫਰਾਹਿ ਗੌਰਿਨ ਕੇ ਮਾਰੇ ॥",
      "transliteration": "tarafaraeh gauarin ke maare ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਲੀਆਂ ਦੇ ਲਗਣ ਕਰ ਕੇ ਤੜਫੜਾਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "तरफराहि गौरिन के मारे ॥",
      "sourceLineId": "134607",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪਛੁ ਸੁਤ ਓਰਨ ਜਨੁਕ ਬਿਦਾਰੇ ॥",
      "transliteration": "pachh sut oran januk bidhaare ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਗੜ੍ਰਹਿਆਂ ਦੇ ਪੈਣ ਨਾਲ ਪੰਛੀਆਂ ਦੇ ਬੱਚੇ ਮਰ ਗਏ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "पछु सुत ओरन जनुक बिदारे ॥",
      "sourceLineId": "134608",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਰਥੀ ਸੁ ਨਾਗਪਤੀ ਅਰੁ ਬਾਜਾ ॥",
      "transliteration": "rathee su naagapatee ar baajaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਥਵਾਨ, ਹਾਥੀਆਂ ਦੇ ਮਾਲਕ ਅਤੇ ਘੋੜੇ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "रथी सु नागपती अरु बाजा ॥",
      "sourceLineId": "134609",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਜਮ ਪੁਰ ਗਏ ਸਹਿਤ ਨਿਜੁ ਰਾਜਾ ॥੮॥",
      "transliteration": "jam pur ge sahit nij raajaa ||8||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਰਾਜੇ ਸਮੇਤ ਜਮਪੁਰੀ ਨੂੰ ਚਲੇ ਗਏ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "जम पुर गए सहित निजु राजा ॥८॥",
      "sourceLineId": "134610",
      "sourceShabadId": "12580",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "134611",
      "sourceShabadId": "12581",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਤਨ ਚੰਚਲਾ ਕੂਟੋ ਕਟਕ ਹਜਾਰ ॥",
      "transliteration": "eeh charitr tan cha(n)chalaa kooTo kaTak hajaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਇਸਤਰੀ ਨੇ ਹਜ਼ਾਰਾ ਸੈਨਿਕਾ ਨੂੰ ਕੁਟ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र तन चंचला कूटो कटक हजार ॥",
      "sourceLineId": "134612",
      "sourceShabadId": "12581",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਅਰਿ ਮਾਰੇ ਰਾਜਾ ਸਹਿਤ ਗਏ ਗ੍ਰਿਹਨ ਕੌ ਹਾਰਿ ॥੯॥",
      "transliteration": "ar maare raajaa sahit ge girahan kau haar ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਸਹਿਤ ਵੈਰੀਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਅਤੇ ਜੋ (ਬਚੇ ਉਹ) ਹਾਰ ਕੇ ਘਰਾ ਨੂੰ ਪਰਤ ਗਏ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "अरि मारे राजा सहित गए गृहन कौ हारि ॥९॥",
      "sourceLineId": "134613",
      "sourceShabadId": "12581",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੧॥੬੨੦੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau ikatees charitr samaapatam sat subham sat ||331||6202||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੩੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੩੧॥੬੨੦੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ इकतीस चरित्र समापतम सतु सुभम सतु ॥३३१॥६२०२॥अफजूँ॥",
      "sourceLineId": "134614",
      "sourceShabadId": "12581",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134615",
      "sourceShabadId": "12582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਸਹਿਰ ਭੇਹਰੇ ਏਕ ਨ੍ਰਿਪਤਿ ਬਰ ॥",
      "transliteration": "sahir bhehare ek nirapat bar ||",
      "translation": "",
      "punjabiViakhya": "ਭੇਹਰੇ ਸ਼ਹਿਰ ਦਾ ਇਕ ਚੰਗਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "सहिर भेहरे एक नृपति बर ॥",
      "sourceLineId": "134616",
      "sourceShabadId": "12582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਾਮ ਸੈਨ ਤਿਹ ਨਾਮ ਕਹਤ ਨਰ ॥",
      "transliteration": "kaam sain teh naam kahat nar ||",
      "translation": "",
      "punjabiViakhya": "ਲੋਕੀਂ ਉਸ ਦਾ ਨਾ ਕਾਮ ਸੈਨ ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "काम सैन तिह नाम कहत नर ॥",
      "sourceLineId": "134617",
      "sourceShabadId": "12582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਕਾਮਾਵਤੀ ਤਵਨ ਕੀ ਨਾਰੀ ॥",
      "transliteration": "kaamaavatee tavan kee naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਇਸਤਰੀ ਕਾਮਾਵਤੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "कामावती तवन की नारी ॥",
      "sourceLineId": "134618",
      "sourceShabadId": "12582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਰੂਪਵਾਨ ਦੁਤਿਵਾਨ ਉਜਿਯਾਰੀ ॥੧॥",
      "transliteration": "roopavaan dhutivaan ujiyaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਰੂਪਵਾਨ, ਸੁੰਦਰ ਅਤੇ ਉਜਲੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "रूपवान दुतिवान उजियारी ॥१॥",
      "sourceLineId": "134619",
      "sourceShabadId": "12582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਤਾ ਕੇ ਬਹੁਤ ਰਹੈ ਗ੍ਰਿਹ ਬਾਜਿਨ ॥",
      "transliteration": "taa ke bahut rahai gireh baajin ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਬਹੁਤ ਘੋੜੀਆਂ ਹੁੰਦੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "ता के बहुत रहै गृह बाजिन ॥",
      "sourceLineId": "134620",
      "sourceShabadId": "12582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਜਯੋ ਕਰਤ ਤਾਜੀ ਅਰੁ ਤਾਜਿਨ ॥",
      "transliteration": "jayo karat taajee ar taajin ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਘੋੜੇ ਅਤੇ ਘੋੜੀਆਂ ਪੈਦਾ ਕਰਦੀਆਂ ਰਹਿੰਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "जयो करत ताजी अरु ताजिन ॥",
      "sourceLineId": "134621",
      "sourceShabadId": "12582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਤਹ ਭਵ ਏਕ ਬਛੇਰਾ ਲਯੋ ॥",
      "transliteration": "teh bhav ek bachheraa layo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਵਿਛੇਰੇ ਨੇ ਜਨਮ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "तह भव एक बछेरा लयो ॥",
      "sourceLineId": "134622",
      "sourceShabadId": "12582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਭੂਤ ਭਵਿਖ੍ਯ ਨ ਵੈਸੇ ਭਯੋ ॥੨॥",
      "transliteration": "bhoot bhavikhay na vaise bhayo ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗਾ (ਕੋਈ ਸੁੰਦਰ ਵਛੇਰਾ) ਨਾ ਭੂਤ ਵਿਚ ਹੋਇਆ ਸੀ ਅਤੇ ਨਾ ਭਵਿਖ ਵਿਚ ਹੋਵੇਗਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "भूत भविख्य न वैसे भयो ॥२॥",
      "sourceLineId": "134623",
      "sourceShabadId": "12582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਤਹ ਇਕ ਹੋਤ ਸਾਹ ਬਡਭਾਗੀ ॥",
      "transliteration": "teh ik hot saeh baddabhaagee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਵਡਭਾਗੀ ਸ਼ਾਹ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "तह इक होत साह बडभागी ॥",
      "sourceLineId": "134624",
      "sourceShabadId": "12582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਰੂਪ ਕੁਅਰ ਨਾਮਾ ਅਨੁਰਾਗੀ ॥",
      "transliteration": "roop kuar naamaa anuraagee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਸਿਕ ਦਾ ਨਾ ਰੂਪ ਕੁਮਾਰ (ਕੁਅਰ) ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "रूप कुअर नामा अनुरागी ॥",
      "sourceLineId": "134625",
      "sourceShabadId": "12582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1281_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਪ੍ਰੀਤਿ ਕਲਾ ਤਿਹ ਸੁਤਾ ਭਨਿਜੈ ॥",
      "transliteration": "preet kalaa teh sutaa bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪੁੱਤਰੀ ਦਾ ਨਾ ਪ੍ਰੀਤ ਕਲਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1281,
      "hindi": "",
      "hindiTransliteration": "प्रीति कला तिह सुता भनिजै ॥",
      "sourceLineId": "134626",
      "sourceShabadId": "12582",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
