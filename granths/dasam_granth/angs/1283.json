{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1283,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1283_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਕ ਇਕ ਤੇ ਕਰਿ ਦ੍ਵੈ ਦ੍ਵੈ ਡਾਰੇ ॥",
      "transliteration": "eik ik te kar dhavai dhavai ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਇਕ ਦੇ ਦੋ ਦੋ ਟੋਟੇ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "इक इक ते करि द्वै द्वै डारे ॥",
      "sourceLineId": "134675",
      "sourceShabadId": "12584",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਘੋਰਾ ਸਹਿਤ ਘਾਇ ਜੋ ਘਏ ॥",
      "transliteration": "ghoraa sahit ghai jo ghe ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜਿਆਂ ਸਹਿਤ ਜੋ ਮਾਰੇ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "घोरा सहित घाइ जो घए ॥",
      "sourceLineId": "134676",
      "sourceShabadId": "12584",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦ੍ਵੈ ਤੇ ਚਾਰਿ ਟੂਕ ਤੇ ਭਏ ॥੧੫॥",
      "transliteration": "dhavai te chaar Took te bhe ||15||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੋ ਤੋਂ ਚਾਰ ਟੋਟੇ ਹੋ ਗਏ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "द्वै ते चारि टूक ते भए ॥१५॥",
      "sourceLineId": "134677",
      "sourceShabadId": "12584",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "134678",
      "sourceShabadId": "12585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਬੀਰ ਬਿਦਾਰ ਬਹੁ ਨਦੀ ਤੁਰੰਗ ਤਰਾਇ ॥",
      "transliteration": "eeh bidh beer bidhaar bahu nadhee tura(n)g tarai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਬਹੁਤ ਸੂਰਮੇ ਮਾਰ ਕੇ ਅਤੇ ਨਦੀ ਵਿਚ ਘੋੜੇ ਨੂੰ ਤੈਰਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "इह बिधि बीर बिदार बहु नदी तुरंग तराइ ॥",
      "sourceLineId": "134679",
      "sourceShabadId": "12585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਹਾ ਮਿਤ੍ਰ ਕੋ ਗ੍ਰਿਹ ਹੁਤੋ ਤਹੀ ਨਿਕਾਸ੍ਰਯੋ ਆਇ ॥੧੬॥",
      "transliteration": "jahaa mitr ko gireh huto tahee nikaasrayo aai ||16||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਜਾ ਪਹੁੰਚੀ ਜਿਥੇ ਮਿਤਰ ਦਾ ਘਰ ਸੀ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "जहा मित्र को गृह हुतो तही निकास्रयो आइ ॥१६॥",
      "sourceLineId": "134680",
      "sourceShabadId": "12585",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134681",
      "sourceShabadId": "12586",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਬ ਤਿਹ ਆਨਿ ਤੁਰੰਗਮ ਦੀਯੋ ॥",
      "transliteration": "jab teh aan tura(n)gam dheeyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੇ ਆ ਕੇ ਘੋੜਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "जब तिह आनि तुरंगम दीयो ॥",
      "sourceLineId": "134682",
      "sourceShabadId": "12586",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਾ ਸੈ ਦ੍ਰਿੜ ਕੀਯੋ ॥",
      "transliteration": "kaam bhog taa sai dhiraR keeyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੇ ਵੀ ਉਸ ਨਾਲ ਚੰਗੀ ਤਰ੍ਰਹਾ ਰਤੀਕਰਮ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "काम भोग ता सै दृड़ कीयो ॥",
      "sourceLineId": "134683",
      "sourceShabadId": "12586",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੌ ਪਾਛੇ ਤਿਨ ਫੌਜ ਨਿਹਾਰੀ ॥",
      "transliteration": "jau paachhe tin fauaj nihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਮਿਤਰ ਨੇ) ਉਸ ਦੇ ਪਿਛੇ ਫ਼ੌਜ ਨੂੰ (ਲਗਿਆ) ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "जौ पाछे तिन फौज निहारी ॥",
      "sourceLineId": "134684",
      "sourceShabadId": "12586",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸੌ ਤਿਹ ਤ੍ਰਿਯਹਿ ਉਚਾਰੀ ॥੧੭॥",
      "transliteration": "eeh bidh sau teh tirayeh uchaaree ||17||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "इह बिधि सौ तिह तृयहि उचारी ॥१७॥",
      "sourceLineId": "134685",
      "sourceShabadId": "12586",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "134686",
      "sourceShabadId": "12587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬੁਰੋ ਕਰਮ ਹਮ ਕਰਿਯੋ ਤੁਰੰਗ ਨ੍ਰਿਪ ਕੋ ਹਰਿਯੋ ॥",
      "transliteration": "buro karam ham kariyo tura(n)g nirap ko hariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਸੀਂ ਮਾੜਾ ਕੰਮ ਕੀਤਾ ਹੈ ਜੋ ਰਾਜੇ ਦਾ ਘੋੜਾ ਚੁਰਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "बुरो करम हम करियो तुरंग नृप को हरियो ॥",
      "sourceLineId": "134687",
      "sourceShabadId": "12587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਪੁ ਆਪੁਨੇ ਪਗਨ ਕੁਹਾਰਾ ਕੌ ਮਰਿਯੋ ॥",
      "transliteration": "aap aapune pagan kuhaaraa kau mariyo ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਪੈਰਾ ਉਤੇ ਆਪ ਕੁਹਾੜਾ ਮਾਰਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "आपु आपुने पगन कुहारा कौ मरियो ॥",
      "sourceLineId": "134688",
      "sourceShabadId": "12587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਬ ਏ ਤੁਰੰਗ ਸਮੇਤ ਪਕਰਿ ਲੈ ਜਾਇ ਹੈ ॥",
      "transliteration": "ab e tura(n)g samet pakar lai jai hai ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਇਹ ਘੋੜੇ ਸਮੇਤ ਪਕੜ ਕੇ ਲੈ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "अब ए तुरंग समेत पकरि लै जाइ है ॥",
      "sourceLineId": "134689",
      "sourceShabadId": "12587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹੋ ਫਾਸੀ ਦੈਹੈ ਦੁਹੂੰ ਕਿ ਸੂਰੀ ਦ੍ਰਯਾਇ ਹੈ ॥੧੮॥",
      "transliteration": "ho faasee dhaihai dhuhoo(n) k sooree dhrayai hai ||18||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੂੰ ਫਾਸੀ ਦੇਣਗੇ ਜਾ ਸੂਲੀ ਉਤੇ ਟੰਗਣਗੇ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "हो फासी दैहै दुहूँ कि सूरी द्रयाइ है ॥१८॥",
      "sourceLineId": "134690",
      "sourceShabadId": "12587",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134691",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤ੍ਰਿਯ ਭਾਖ੍ਯੋ ਪਿਯ ਸੋਕ ਨ ਕਰੋ ॥",
      "transliteration": "tiray bhaakhayo piy sok na karo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਕਿਹਾ, ਹੇ ਪ੍ਰੀਤਮ! ਦੁਖੀ ਨਾ ਹੋਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "तृय भाख्यो पिय सोक न करो ॥",
      "sourceLineId": "134692",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਾਜ ਸਹਿਤ ਦੋਊ ਬਚੇ ਬਿਚਰੋ ॥",
      "transliteration": "baaj sahit dhouoo bache bicharo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹੀ ਸਮਝੋ ਕਿ ਘੋੜੇ ਸਮੇਤ ਦੋਵੇਾਂ ਬਚੇ ਹੋਏ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "बाज सहित दोऊ बचे बिचरो ॥",
      "sourceLineId": "134693",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਐਸੋ ਚਰਿਤ ਅਬੈ ਮੈ ਕਰਿ ਹੋ ॥",
      "transliteration": "aaiso charit abai mai kar ho ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਹੁਣੇ ਅਜਿਹਾ ਚਰਿਤ੍ਰ ਕਰਦੀ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "ऐसो चरित अबै मै करि हो ॥",
      "sourceLineId": "134694",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੁਸਟਨ ਡਾਰਿ ਸਿਰ ਛਾਰਿ ਉਬਰਿ ਹੋ ॥੧੯॥",
      "transliteration": "dhusaTan ddaar sir chhaar ubar ho ||19||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਦੁਸ਼ਟਾ ਦੇ ਸਿਰ ਸੁਆਹ ਪਾ ਕੇ ਬਚ ਜਾਵਾਗੇ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "दुसटन डारि सिर छारि उबरि हो ॥१९॥",
      "sourceLineId": "134695",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਹਾ ਪੁਰਖ ਕੋ ਭੇਸ ਬਨਾਇ ॥",
      "transliteration": "tahaa purakh ko bhes banai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਪੁਰਸ਼ ਦੇ ਬਸਤ੍ਰ ਪਾ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "तहा पुरख को भेस बनाइ ॥",
      "sourceLineId": "134696",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦਲ ਕਹ ਮਿਲੀ ਅਗਮਨੇ ਜਾਇ ॥",
      "transliteration": "dhal keh milee agamane jai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫ਼ੌਜ ਨੂੰ ਅਗੋਂ ਜਾ ਕੇ ਮਿਲੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "दल कह मिली अगमने जाइ ॥",
      "sourceLineId": "134697",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਹੀ ਹਮਾਰੋ ਸਤਰ ਉਬਾਰੋ ॥",
      "transliteration": "kahee hamaaro satar ubaaro ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿਣ ਲਗੀ ਕਿ ਮੇਰੇ ਪਰਦੇ ('ਸਤਰ') ਨੂੰ ਬਚਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "कही हमारो सतर उबारो ॥",
      "sourceLineId": "134698",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਔਰ ਗਾਵ ਤੇ ਸਕਲ ਨਿਹਾਰੋ ॥੨੦॥",
      "transliteration": "aauar gaav te sakal nihaaro ||20||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਸਾਡੇ ਪਿੰਡ ਤੋਂ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਵੇਖ ਲਵੋ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "और गाव ते सकल निहारो ॥२०॥",
      "sourceLineId": "134699",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਿਲਿ ਦਲ ਧਾਮ ਅਗਮਨੇ ਜਾਇ ॥",
      "transliteration": "mil dhal dhaam agamane jai ||",
      "translation": "",
      "punjabiViakhya": "ਫ਼ੌਜ ਨੂੰ ਮਿਲ ਕੇ ਅਗੋਂ ਹੀ ਘਰ ਜਾ ਪਹੁੰਚੀ",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "मिलि दल धाम अगमने जाइ ॥",
      "sourceLineId": "134700",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਾਜ ਪਾਇ ਝਾਝਰ ਪਹਿਰਾਇ ॥",
      "transliteration": "baaj pai jhaajhar pahirai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘੋੜੇ ਦੇ ਪੈਰਾ ਵਿਚ ਝਾਝਰ ਪਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "बाज पाइ झाझर पहिराइ ॥",
      "sourceLineId": "134701",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਕਲ ਗਾਵ ਤਿਨ ਕਹ ਦਿਖਰਾਈ ॥",
      "transliteration": "sakal gaav tin keh dhikharaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਸਾਰਾ ਪਿੰਡ ਵਿਖਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "सकल गाव तिन कह दिखराई ॥",
      "sourceLineId": "134702",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਫਿਰਿ ਤਿਹ ਠੌਰਿ ਤਿਨੈ ਲੈ ਆਈ ॥੨੧॥",
      "transliteration": "fir teh Thauar tinai lai aaiee ||21||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਨ੍ਰਹਾ ਨੂੰ ਉਥੇ ਹੀ ਲੈ ਆਈ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "फिरि तिह ठौरि तिनै लै आई ॥२१॥",
      "sourceLineId": "134703",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਰਦਾ ਲੇਤ ਤਾਨਿ ਆਗੇ ਤਿਨ ॥",
      "transliteration": "paradhaa let taan aage tin ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਉਨ੍ਰਹਾ ਅਗੇ ਪਰਦਾ ਤਾਣ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "परदा लेत तानि आगे तिन ॥",
      "sourceLineId": "134704",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦੇਖਹੁ ਜਾਇ ਜਨਾਨਾ ਕਹਿ ਜਿਨ ॥",
      "transliteration": "dhekhahu jai janaanaa keh jin ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮਤਾ ਕੋਈ ਇਸਤਰੀਆਂ ਨੂੰ ਵੇਖ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "देखहु जाइ जनाना कहि जिन ॥",
      "sourceLineId": "134705",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਆਗੇ ਕਰਿ ਸਭਹਿਨ ਕੇ ਬਾਜਾ ॥",
      "transliteration": "aage kar sabhahin ke baajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਸਾਰਿਆਂ ਦੇ ਅਗੇ ਘੋੜੇ ਨੂੰ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "आगे करि सभहिन के बाजा ॥",
      "sourceLineId": "134706",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਹ ਛਲ ਬਾਮ ਨਿਕਾਰਿਯੋ ਰਾਜਾ ॥੨੨॥",
      "transliteration": "eeh chhal baam nikaariyo raajaa ||22||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਇਸ ਛਲ ਨਾਲ ਰਾਜੇ ਨੂੰ ਕਢ ਦਿੱਤਾ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "इह छल बाम निकारियो राजा ॥२२॥",
      "sourceLineId": "134707",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੋ ਆਂਗਨ ਲੈ ਤਿਨੈ ਦਿਖਾਵੈ ॥",
      "transliteration": "so aa(n)gan lai tinai dhikhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਉਨ੍ਰਹਾ ਨੂੰ (ਇਕ) ਵੇਹੜਾ ਵਿਖਾ ਦਿੰਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "सो आँगन लै तिनै दिखावै ॥",
      "sourceLineId": "134708",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਗੇ ਬਹੁਰਿ ਕਨਾਤ ਤਨਾਵੈ ॥",
      "transliteration": "aage bahur kanaat tanaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਅਗੇ ਕਨਾਤ ਤਾਣ ਦਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "आगे बहुरि कनात तनावै ॥",
      "sourceLineId": "134709",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਗੇ ਕਰਿ ਕਰਿ ਬਾਜ ਨਿਕਾਰੈ ॥",
      "transliteration": "aage kar kar baaj nikaarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਗੇ ਕਰ ਕਰ ਕੇ ਉਹ ਘੋੜੇ ਨੂੰ ਹੋਰ ਅਗੇ ਨੂੰ ਕਰੀ ਜਾਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "आगे करि करि बाज निकारै ॥",
      "sourceLineId": "134710",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨੇਵਰ ਕੇ ਬਾਜਤ ਝਨਕਾਰੈ ॥੨੩॥",
      "transliteration": "nevar ke baajat jhanakaarai ||23||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਝਾਝਰ ਦੀ ਆਵਾਜ਼ ਆ ਰਹੀ ਸੀ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "नेवर के बाजत झनकारै ॥२३॥",
      "sourceLineId": "134711",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਹੂ ਬਧੂ ਤਿਨ ਕੀ ਵਹੁ ਜਾਨੈ ॥",
      "transliteration": "bahoo badhoo tin kee vahu jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਘੋੜੇ ਨੂੰ ਉਸ ਦੀ ਪਤਨੀ ਜਾ ਬਹੂ ਸਮਝ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "बहू बधू तिन की वहु जानै ॥",
      "sourceLineId": "134712",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਾਜੀ ਕਹ ਮੂਰਖ ਨ ਪਛਾਨੈ ॥",
      "transliteration": "baajee keh moorakh na pachhaanai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੂਰਖ ਲੋਕ ਘੋੜੇ ਨੂੰ ਨਹੀਂ ਪਛਾਣ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "बाजी कह मूरख न पछानै ॥",
      "sourceLineId": "134713",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨੇਵਰ ਕੈ ਬਾਜਤ ਝਨਕਾਰਾ ॥",
      "transliteration": "nevar kai baajat jhanakaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਝਾਝਰ ਦੀ ਝਨਕਾਰ ਹੋ ਰਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "नेवर कै बाजत झनकारा ॥",
      "sourceLineId": "134714",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਜਾਤ ਬਿਚਾਰਾ ॥੨੪॥",
      "transliteration": "bhedh abhedh na jaat bichaaraa ||24||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕੋਈ ਭੇਦ ਅਭੇਦ ਸਮਝਿਆ ਨਹੀਂ ਜਾ ਰਿਹਾ ਸੀ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न जात बिचारा ॥२४॥",
      "sourceLineId": "134715",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੁਹਿਤਾ ਬਹੂ ਤਿਨੈ ਕਰਿ ਜਾਨੈ ॥",
      "transliteration": "dhuhitaa bahoo tinai kar jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਉਹ ਧੀ ਜਾ ਬਹੂ ਸਮਝ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "दुहिता बहू तिनै करि जानै ॥",
      "sourceLineId": "134716",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁਨਿ ਸੁਨਿ ਧੁਨਿ ਨੇਵਰ ਕੀ ਕਾਨੈ ॥",
      "transliteration": "sun sun dhun nevar kee kaanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਝਾਝਰ ਦੀ ਆਵਾਜ਼ ਨੂੰ ਕੰਨਾ ਨਾਲ ਸੁਣ ਕੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "सुनि सुनि धुनि नेवर की कानै ॥",
      "sourceLineId": "134717",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕਛੂ ਨ ਬਿਚਾਰੀ ॥",
      "transliteration": "bhedh abhedh kachhoo na bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਭੇਦ ਅਭੇਦ ਕੁਝ ਨਾ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद कछू न बिचारी ॥",
      "sourceLineId": "134718",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਹ ਛਲ ਛਲੈ ਪੁਰਖ ਸਭ ਨਾਰੀ ॥੨੫॥",
      "transliteration": "eeh chhal chhalai purakh sabh naaree ||25||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਇਸਤਰੀ ਨੇ ਸਾਰਿਆਂ ਬੰਦਿਆਂ ਨੂੰ ਛਲ ਲਿਆ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "इह छल छलै पुरख सभ नारी ॥२५॥",
      "sourceLineId": "134719",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਵਨ ਰੁਚਾ ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਤਿਹ ਭਜਾ ॥",
      "transliteration": "javan ruchaa jayo(n) tayo(n) teh bhajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀ ਨੂੰ) ਜੋ ਵੀ ਚੰਗਾ ਲਗਦਾ ਹੈ, ਉਸ ਨੂੰ ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਪ੍ਰਾਪਤ ਕਰ ਲੈਂਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "जवन रुचा ज्यों त्यों तिह भजा ॥",
      "sourceLineId": "134720",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਿਯ ਜੁ ਨ ਭਾਯੋ ਤਿਹ ਕੌ ਤਜਾ ॥",
      "transliteration": "jiy ju na bhaayo teh kau tajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਮਨ ਨੂੰ ਚੰਗਾ ਨਹੀਂ ਲਗਦਾ ਹੈ, ਉਸ ਨੂੰ ਛਡ ਦਿੰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "जिय जु न भायो तिह कौ तजा ॥",
      "sourceLineId": "134721",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1283_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਨ ਇਸਤ੍ਰੀਨ ਕੇ ਚਰਿਤ ਅਪਾਰਾ ॥",
      "transliteration": "ein isatreen ke charit apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਇਸਤਰੀਆਂ ਦੇ ਚਰਿਤ੍ਰ ਅਪਾਰ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1283,
      "hindi": "",
      "hindiTransliteration": "इन इसत्रीन के चरित अपारा ॥",
      "sourceLineId": "134722",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
