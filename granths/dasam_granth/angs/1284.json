{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1284,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1284_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਨੈ ਨ ਬਿਧਨਾ ਸਕਤ ਬਿਚਾਰਾ ॥੨੬॥",
      "transliteration": "jinai na bidhanaa sakat bichaaraa ||26||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੂੰ ਵਿਧਾਤਾ ਵੀ ਨਹੀਂ ਵਿਚਾਰ ਸਕਿਆ ਹੈ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "जिनै न बिधना सकत बिचारा ॥२६॥",
      "sourceLineId": "134723",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਬਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੨॥੬੨੨੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau batees charitr samaapatam sat subham sat ||332||6228||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੩੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੩੨॥੬੨੨੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ बतीस चरित्र समापतम सतु सुभम सतु ॥३३२॥६२२८॥अफजूँ॥",
      "sourceLineId": "134724",
      "sourceShabadId": "12588",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134725",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੁਨਹੋ ਰਾਜ ਕੁਅਰਿ ਇਕ ਬਾਤਾ ॥",
      "transliteration": "sunaho raaj kuar ik baataa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! (ਮੈਂ ਤੁਹਾਨੂੰ) ਇਕ ਕੁਮਾਰੀ ਦੀ ਗੱਲ ਸੁਣਾਉਾਂਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "सुनहो राज कुअरि इक बाता ॥",
      "sourceLineId": "134726",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਜੋ ਕਿਯ ਬਿਖ੍ਯਾਤਾ ॥",
      "transliteration": "tiray charitr jo kiy bikhayaataa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਬੜਾ ਪ੍ਰਸਿੱਧ ਚਰਿਤ੍ਰ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "तृय चरित्र जो किय बिख्याता ॥",
      "sourceLineId": "134727",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਸਚਿਮ ਦਿਸਾ ਹੁਤੀ ਇਕ ਨਗਰੀ ॥",
      "transliteration": "pasachim dhisaa hutee ik nagaree ||",
      "translation": "",
      "punjabiViakhya": "ਪੱਛਮ ਵਾਲੇ ਪਾਸੇ ਇਕ ਨਗਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "पसचिम दिसा हुती इक नगरी ॥",
      "sourceLineId": "134728",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹੰਸ ਮਾਲਨੀ ਨਾਮ ਉਜਗਰੀ ॥੧॥",
      "transliteration": "ha(n)s maalanee naam ujagaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਹੰਸ ਮਾਲਨੀ ਨਾਮ ਜਣਿਆ ਜਾਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "हंस मालनी नाम उजगरी ॥१॥",
      "sourceLineId": "134729",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹੰਸ ਸੈਨ ਜਿਹ ਰਾਜ ਬਿਰਾਜੈ ॥",
      "transliteration": "ha(n)s sain jeh raaj biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਹੰਸ ਸੈਨ ਨਾ ਦਾ ਰਾਜਾ ਰਾਜ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "हंस सैन जिह राज बिराजै ॥",
      "sourceLineId": "134730",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹੰਸ ਪ੍ਰਭਾ ਜਾ ਕੀ ਤ੍ਰਿਯ ਰਾਜੈ ॥",
      "transliteration": "ha(n)s prabhaa jaa kee tiray raajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਇਸਤਰੀ ਦਾ ਨਾ ਹੰਸ ਪ੍ਰਭਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "हंस प्रभा जा की तृय राजै ॥",
      "sourceLineId": "134731",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰੂਪਵਾਨ ਗੁਨਵਾਨੁਜਿਯਾਰੀ ॥",
      "transliteration": "roopavaan gunavaanujiyaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰੂਪਵਾਨ, ਗੁਣਵਾਨ ਅਤੇ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "रूपवान गुनवानुजियारी ॥",
      "sourceLineId": "134732",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਾਹਿਰ ਲੋਕ ਚੌਦਹੂੰ ਪ੍ਯਾਰੀ ॥੨॥",
      "transliteration": "jaahir lok chauadhahoo(n) payaaree ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪਿਆਰੀ ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਪ੍ਰਸਿੱਧ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "जाहिर लोक चौदहूँ प्यारी ॥२॥",
      "sourceLineId": "134733",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਹ ਇਕ ਸਾਹੁ ਸੁਤਾ ਦੁਤਿਮਾਨਾ ॥",
      "transliteration": "teh ik saahu sutaa dhutimaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸ਼ਾਹ ਦੀ ਸੁੰਦਰ ਪੁੱਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "तह इक साहु सुता दुतिमाना ॥",
      "sourceLineId": "134734",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਹੁਰਿ ਜਿਯਤ ਜਿਹ ਨਿਰਖਿ ਸਸਾਨਾ ॥",
      "transliteration": "bahur jiyat jeh nirakh sasaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਸਹਿਕਦਾ ਹੋਇਆ (ਆਦਮੀ) ਫਿਰ ਜੀ ਪੈਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "बहुरि जियत जिह निरखि ससाना ॥",
      "sourceLineId": "134735",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜੋਬਨ ਭਯੋ ਅਧਿਕ ਤਿਹ ਜਬ ਹੀ ॥",
      "transliteration": "joban bhayo adhik teh jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਹ ਭਰ ਜਵਾਨ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "जोबन भयो अधिक तिह जब ही ॥",
      "sourceLineId": "134736",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਹੁਤਨ ਸਾਥ ਬਿਹਾਰਤ ਤਬ ਹੀ ॥੩॥",
      "transliteration": "bahutan saath bihaarat tab hee ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬਹੁਤ ਬੰਦਿਆਂ ਨਾਲ ਵਿਚਰਨ ਲਗ ਗਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "बहुतन साथ बिहारत तब ही ॥३॥",
      "sourceLineId": "134737",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਇਕ ਦਿਨ ਭੇਸ ਪੁਰਖ ਕੋ ਧਾਰਿ ॥",
      "transliteration": "eik dhin bhes purakh ko dhaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਦਿਨ ਪੁਰਸ਼ ਦਾ ਭੇਸ ਧਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "इक दिन भेस पुरख को धारि ॥",
      "sourceLineId": "134738",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਿਜੁ ਪਤਿ ਸਾਥ ਕਰੀ ਬਹੁ ਰਾਰਿ ॥",
      "transliteration": "nij pat saath karee bahu raar ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਪਤੀ ਨਾਲ ਬਹੁਤ ਝਗੜਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "निजु पति साथ करी बहु रारि ॥",
      "sourceLineId": "134739",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਲਾਤ ਮੁਸਟ ਕੇ ਕਰਤ ਪ੍ਰਹਾਰ ॥",
      "transliteration": "laat musaT ke karat prahaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਲੱਤਾ ਅਤੇ ਮੁੱਕਿਆਂ ਨਾਲ ਮਾਰ ਰਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "लात मुसट के करत प्रहार ॥",
      "sourceLineId": "134740",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋ ਤਿਹ ਨਾਰਿ ਨ ਸਕੈ ਬਿਚਾਰਿ ॥੪॥",
      "transliteration": "so teh naar na sakai bichaar ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਹ ਉਸ ਨੂੰ ਆਪਣੀ ਇਸਤਰੀ ਵਜੋਂ ਨਹੀਂ ਪਛਾਣ ਰਿਹਾ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "सो तिह नारि न सकै बिचारि ॥४॥",
      "sourceLineId": "134741",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਸੌ ਲਰਿ ਕਾਜੀ ਪਹਿ ਗਈ ॥",
      "transliteration": "taa sau lar kaajee peh giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਉਸ ਨਾਲ ਲੜ ਕੇ ਕਾਜ਼ੀ ਕੋਲ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "ता सौ लरि काजी पहि गई ॥",
      "sourceLineId": "134742",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਲੈ ਇਲਾਮ ਪ੍ਰਯਾਦਨ ਸੰਗ ਅਈ ॥",
      "transliteration": "lai ilaam prayaadhan sa(n)g iee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਰਵਾਨਾ ਲੈ ਕੇ ਪਿਆਦਿਆਂ ਨਾਲ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "लै इलाम प्रयादन संग अई ॥",
      "sourceLineId": "134743",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਐਚ ਪਤਿਹਿ ਲੈ ਤਹਾ ਸਿਧਾਈ ॥",
      "transliteration": "aaich pateh lai tahaa sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਨੂੰ ਖਿਚ ਕੇ ਉਥੇ ਲੈ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "ऐच पतिहि लै तहा सिधाई ॥",
      "sourceLineId": "134744",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕੋਤਵਾਰ ਕਾਜੀ ਜਿਹ ਠਾਈ ॥੫॥",
      "transliteration": "kotavaar kaajee jeh Thaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਥਾ ਤੇ ਕੋਤਵਾਲ ਅਤੇ ਕਾਜ਼ੀ ਸਨ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "कोतवार काजी जिह ठाई ॥५॥",
      "sourceLineId": "134745",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪ੍ਰਯਾਦਨ ਸਾਥ ਦ੍ਵਾਰ ਪਤਿ ਥਿਰ ਕਰਿ ॥",
      "transliteration": "prayaadhan saath dhavaiaar pat thir kar ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਆਦਿਆਂ ਨਾਲ ਪਤੀ ਨੂੰ ਦਰਵਾਜ਼ੇ ਉਤੇ ਖੜਾ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "प्रयादन साथ द्वार पति थिर करि ॥",
      "sourceLineId": "134746",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦਿਨ ਕਹ ਗਈ ਮਿਤ੍ਰ ਅਪਨੇ ਘਰ ॥",
      "transliteration": "dhin keh giee mitr apane ghar ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਨੇ ਹੀ ਮਿਤਰ ਕੋਲ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "दिन कह गई मित्र अपने घर ॥",
      "sourceLineId": "134747",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਾ ਸੰਗ ਕਰਿ ਕ੍ਰੀੜਾ ਕੀ ਗਾਥਾ ॥",
      "transliteration": "taa sa(n)g kar kreeRaa kee gaathaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਕੇਲਿ ਦੀ ਗੱਲ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "ता संग करि क्रीड़ा की गाथा ॥",
      "sourceLineId": "134748",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਲੈ ਆਈ ਸਾਹਿਦ ਕਹਿ ਸਾਥਾ ॥੬॥",
      "transliteration": "lai aaiee saahidh keh saathaa ||6||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਗਵਾਹ ਬਣਾ ਕੇ ਨਾਲ ਲੈ ਆਈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "लै आई साहिद कहि साथा ॥६॥",
      "sourceLineId": "134749",
      "sourceShabadId": "12589",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "134750",
      "sourceShabadId": "12590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾਰ ਪ੍ਰਯਾਦਨ ਪਤਿ ਜੁਤਿ ਦ੍ਵਾਰੇ ਠਾਢਿ ਕਰ ॥",
      "transliteration": "jaar prayaadhan pat jut dhavaiaare Thaadd kar ||",
      "translation": "",
      "punjabiViakhya": "ਯਾਰ ਨੂੰ ਪਿਆਦਿਆਂ ਅਤੇ ਪਤੀ ਨਾਲ ਦੁਆਰ ਉਤੇ ਖੜਾ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "जार प्रयादन पति जुति द्वारे ठाढि कर ॥",
      "sourceLineId": "134751",
      "sourceShabadId": "12590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੁਤਿਯ ਮਿਤ੍ਰ ਕੇ ਗਈ ਦਿਵਸ ਕਹ ਨਾਰਿ ਘਰ ॥",
      "transliteration": "dhutiy mitr ke giee dhivas keh naar ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੂਜੇ ਮਿਤਰ ਦੇ ਘਰ ਦਿਨੇ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "दुतिय मित्र के गई दिवस कह नारि घर ॥",
      "sourceLineId": "134752",
      "sourceShabadId": "12590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥਿ ਕੀਯਾ ਰੁਚਿ ਮਾਨਿ ਕਰਿ ॥",
      "transliteration": "kaam bhog teh saath keeyaa ruch maan kar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਰੁਚੀ ਪੂਰਵਕ ਕਾਮ ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह साथि कीया रुचि मानि करि ॥",
      "sourceLineId": "134753",
      "sourceShabadId": "12590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹੋ ਸਾਹਿਦ ਕੈ ਲ੍ਯਾਈ ਅਪਨੇ ਤਿਹ ਸਾਥ ਧਰਿ ॥੭॥",
      "transliteration": "ho saahidh kai layaiee apane teh saath dhar ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੀ ਗਵਾਹ ਬਣਾ ਕੇ ਨਾਲ ਲੈ ਆਈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "हो साहिद कै ल्याई अपने तिह साथ धरि ॥७॥",
      "sourceLineId": "134754",
      "sourceShabadId": "12590",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134755",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹਾ ਲਗੇ ਮੈ ਕਹੋ ਉਚਰਿ ਕਰਿ ॥",
      "transliteration": "kahaa lage mai kaho uchar kar ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਕਿਥੋਂ ਤਕ ਬਖਾਨ ਕਰਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "कहा लगे मै कहो उचरि करि ॥",
      "sourceLineId": "134756",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਗਈ ਬਹੁਤਨ ਕੇ ਘਰ ॥",
      "transliteration": "eeh bidh giee bahutan ke ghar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਹ ਬਹੁਤ ਯਾਰਾ ਦੇ ਘਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "इह बिधि गई बहुतन के घर ॥",
      "sourceLineId": "134757",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੰਗ ਸਾਹਿਦ ਸਭ ਹੀ ਕਰਿ ਲੀਨੇ ॥",
      "transliteration": "sa(n)g saahidh sabh hee kar leene ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਗਵਾਹ ਬਣਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "संग साहिद सभ ही करि लीने ॥",
      "sourceLineId": "134758",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਕਲ ਰੁਜੂ ਕਾਜੀ ਕੇ ਕੀਨੇ ॥੮॥",
      "transliteration": "sakal rujoo kaajee ke keene ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਕਾਜ਼ੀ ਦੇ ਧਿਆਨ ਵਿਚ ਲਿਆਂਦੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "सकल रुजू काजी के कीने ॥८॥",
      "sourceLineId": "134759",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਿਹ ਅਪਨੀ ਅਪਨੀ ਤੇ ਮਾਨੈ ॥",
      "transliteration": "teh apanee apanee te maanai ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਉਸ ਨੂੰ ਆਪਣੀ ਆਪਣੀ ਹੀ ਸਮਝਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "तिह अपनी अपनी ते मानै ॥",
      "sourceLineId": "134760",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਏਕ ਏਕ ਕੋ ਭੇਦ ਨ ਜਾਨੈ ॥",
      "transliteration": "ek ek ko bhedh na jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਦੂਜੇ ਦਾ ਭੇਦ ਨਹੀਂ ਜਾਣਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "एक एक को भेद न जानै ॥",
      "sourceLineId": "134761",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੁ ਤ੍ਰਿਯ ਕਹਤ ਸੋ ਪੁਰਖ ਬਖਾਨਤ ॥",
      "transliteration": "j tiray kahat so purakh bakhaanat ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਉਹ ਇਸਤਰੀ ਕਹਿੰਦੀ, ਉਹੀ ਉਹ ਮਰਦ ਕਹਿੰਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "जु तृय कहत सो पुरख बखानत ॥",
      "sourceLineId": "134762",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਪੁ ਆਪੁ ਕੀ ਬਾਤ ਨ ਜਾਨਤ ॥੯॥",
      "transliteration": "aap aap kee baat na jaanat ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਸ ਵਿਚ ਦੀ ਗੱਲ ਨਹੀਂ ਸਮਝਦੇ ਸਨ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "आपु आपु की बात न जानत ॥९॥",
      "sourceLineId": "134763",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਭ ਸਾਹਿਦ ਜਬ ਨਜਰਿ ਗੁਜਰੇ ॥",
      "transliteration": "sabh saahidh jab najar gujare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸਾਰੇ ਗਵਾਹ ਨਜ਼ਰੋਂ ਲੰਘ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "सभ साहिद जब नजरि गुजरे ॥",
      "sourceLineId": "134764",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਏਕ ਬਚਨ ਵਹ ਤ੍ਰਿਯਾ ਉਚਰੇ ॥",
      "transliteration": "ek bachan veh tirayaa uchare ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਸਤਰੀ ਨੇ ਇਕ ਗੱਲ ਕਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "एक बचन वह तृया उचरे ॥",
      "sourceLineId": "134765",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਬ ਕਾਜੀ ਸਾਚੀ ਇਹ ਕੀਨੋ ॥",
      "transliteration": "tab kaajee saachee ieh keeno ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਜ਼ੀ ਨੇ ਉਸ ਗੱਲ ਨੂੰ ਸੱਚਾ ਮੰਨ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "तब काजी साची इह कीनो ॥",
      "sourceLineId": "134766",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦਰਬ ਬਟਾਇ ਅਰਧ ਤਿਹ ਦੀਨੋ ॥੧੦॥",
      "transliteration": "dharab baTai aradh teh dheeno ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੱਧਾ ਧਨ ਵੰਡ ਕੇ ਉਸ ਨੂੰ ਦੇ ਦਿੱਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "दरब बटाइ अरध तिह दीनो ॥१०॥",
      "sourceLineId": "134767",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਿਨੂੰ ਨ ਤਾ ਕੋ ਭੇਦ ਬਿਚਾਰਾ ॥",
      "transliteration": "kinoo(n) na taa ko bhedh bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ ਉਸ ਦੇ ਭੇਦ ਨੂੰ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "किनूँ न ता को भेद बिचारा ॥",
      "sourceLineId": "134768",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਸ ਚਰਿਤ੍ਰ ਇਹ ਨਾਰਿ ਦਿਖਾਰਾ ॥",
      "transliteration": "kas charitr ieh naar dhikhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਇਸਤਰੀ ਨੇ ਕੀ ਚਰਿਤ੍ਰ ਕਰ ਵਿਖਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "कस चरित्र इह नारि दिखारा ॥",
      "sourceLineId": "134769",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1284_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਔਰਨ ਕੀ ਕੋਊ ਕਹਾ ਬਖਾਨੈ ॥",
      "transliteration": "aauaran kee kouoo kahaa bakhaanai ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰਾ ਦੀ ਗੱਲ ਕੋਈ ਕੀ ਕਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1284,
      "hindi": "",
      "hindiTransliteration": "औरन की कोऊ कहा बखानै ॥",
      "sourceLineId": "134770",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
