{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1285,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1285_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਪੁ ਆਪ ਮਹਿ ਤੇਊ ਨ ਜਾਨੈ ॥੧੧॥",
      "transliteration": "aap aap meh teuoo na jaanai ||11||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਆਪਸ ਵਿਚ ਵੀ ਕੁਝ ਨਹੀਂ ਜਾਣਦੇ ਸਨ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "आपु आप महि तेऊ न जानै ॥११॥",
      "sourceLineId": "134771",
      "sourceShabadId": "12591",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "134772",
      "sourceShabadId": "12592",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਹਾ ਲਖਾ ਤ੍ਰਿਯ ਕਰਮ ਕਰਿ ਕੈਸੇ ਕਰਮ ਕਮਾਇ ॥",
      "transliteration": "kahaa lakhaa tiray karam kar kaise karam kamai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸ ਨੇ ਸਮਝਿਆ ਹੈ ਕਿ ਉਸ ਇਸਤਰੀ ਨੇ ਕੀ ਕਰਮ ਕੀਤਾ ਅਤੇ ਕਿਵੇਾਂ ਕਰਮ ਕਮਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "कहा लखा तृय करम करि कैसे करम कमाइ ॥",
      "sourceLineId": "134773",
      "sourceShabadId": "12592",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਸਭ ਆਪੁ ਮਹਿ ਸਕਾ ਨ ਕੋਊ ਪਾਇ ॥੧੨॥",
      "transliteration": "bhedh abhedh sabh aap meh sakaa na kouoo pai ||12||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ) ਸਾਰਿਆਂ ਵਿਚੋਂ ਕੋਈ ਵੀ ਆਪਸ ਵਿਚ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਸਮਝ ਸਕਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद सभ आपु महि सका न कोऊ पाइ ॥१२॥",
      "sourceLineId": "134774",
      "sourceShabadId": "12592",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤੇਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੩॥੬੨੪੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau tetees charitr samaapatam sat subham sat ||333||6240||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੩੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੩੩॥੬੨੪੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ तेतीस चरित्र समापतम सतु सुभम सतु ॥३३३॥६२४०॥अफजूँ॥",
      "sourceLineId": "134775",
      "sourceShabadId": "12592",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134776",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਾਜ ਸੈਨ ਇਕ ਰਾਜਾ ਦਛਿਨ ॥",
      "transliteration": "raaj sain ik raajaa dhachhin ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਖਣ ਵਿਚ ਰਾਜ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "राज सैन इक राजा दछिन ॥",
      "sourceLineId": "134777",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤ੍ਰਿਯ ਤਿਹ ਰਾਜ ਮਤੀ ਸੁਭ ਲਛਨ ॥",
      "transliteration": "tiray teh raaj matee subh lachhan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਰਾਜ ਮਤੀ ਨਾ ਦੀ ਸ਼ੁਭ ਲੱਛਣਾ ਵਾਲੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "तृय तिह राज मती सुभ लछन ॥",
      "sourceLineId": "134778",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਮਿਤ ਦਰਬ ਤਨ ਭਰੇ ਭੰਡਾਰਾ ॥",
      "transliteration": "amit dharab tan bhare bha(n)ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅਣਮਿਣਵੇਾਂ ਧਨ ਨਾਲ ਭੰਡਾਰ ਭਰੇ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "अमित दरब तन भरे भंडारा ॥",
      "sourceLineId": "134779",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਨ ਕੋ ਆਵਤ ਵਾਰ ਨ ਪਾਰਾ ॥੧॥",
      "transliteration": "jin ko aavat vaar na paaraa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦਾ ਕੋਈ ਅੰਤ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "जिन को आवत वार न पारा ॥१॥",
      "sourceLineId": "134780",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਿੰਗਲ ਦੇ ਤਹ ਸਾਹ ਦੁਲਾਰੀ ॥",
      "transliteration": "pi(n)gal dhe teh saeh dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਪਿੰਗਲ ਦੇ (ਦੇਈ) ਨਾ ਦੀ (ਇਕ) ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "पिंगल दे तह साह दुलारी ॥",
      "sourceLineId": "134781",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾ ਕੀ ਸਮ ਨਹਿ ਦੁਤਿਯ ਕੁਮਾਰੀ ॥",
      "transliteration": "jaa kee sam neh dhutiy kumaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਕੋਈ ਦੂਜੀ ਕੁਮਾਰੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "जा की सम नहि दुतिय कुमारी ॥",
      "sourceLineId": "134782",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਿਰਖਿ ਨ੍ਰਿਪਤਿ ਤ੍ਰਿਯ ਭਈ ਦਿਵਾਨੀ ॥",
      "transliteration": "nirakh nirapat tiray bhiee dhivaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸਤਰੀ ਰਾਜੇ ਨੂੰ ਵੇਖ ਕੇ ਦੀਵਾਨੀ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "निरखि नृपति तृय भई दिवानी ॥",
      "sourceLineId": "134783",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਬ ਤੇ ਰੁਚਤ ਖਾਨ ਨਹਿ ਪਾਨੀ ॥੨॥",
      "transliteration": "tab te ruchat khaan neh paanee ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੋਂ (ਉਸ ਨੂੰ) ਖਾਣਾ ਪੀਣਾ ਚੰਗਾ ਨਾ ਲਗਣ ਲਗਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "तब ते रुचत खान नहि पानी ॥२॥",
      "sourceLineId": "134784",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਾ ਕੀ ਲਗਨਿ ਨ੍ਰਿਪਤਿ ਤਨ ਲਾਗੀ ॥",
      "transliteration": "taa kee lagan nirapat tan laagee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਲਗਨ ਰਾਜੇ ਨਾਲ ਲਗ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "ता की लगनि नृपति तन लागी ॥",
      "sourceLineId": "134785",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਛੂਟੈ ਕਹਾ ਅਨੋਖੀ ਜਾਗੀ ॥",
      "transliteration": "chhooTai kahaa anokhee jaagee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਅਨੋਖੀ ਪ੍ਰੀਤ ਲਗ ਜਾਣ ਤੋਂ ਬਾਦ ਕਿਵੇਾਂ ਛੁਟੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "छूटै कहा अनोखी जागी ॥",
      "sourceLineId": "134786",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਖੀ ਚੀਨਿ ਇਕ ਹਿਤੂ ਸ੍ਯਾਨੀ ॥",
      "transliteration": "sakhee cheen ik hitoo sayaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਹਿਤ ਵਾਲੀ ਇਕ ਸਿਆਣੀ ਸਖੀ ਨੂੰ ਘੋਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "सखी चीनि इक हितू स्यानी ॥",
      "sourceLineId": "134787",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਠੈ ਦਈ ਨ੍ਰਿਪ ਕੀ ਰਜਧਾਨੀ ॥੩॥",
      "transliteration": "paThai dhiee nirap kee rajadhaanee ||3||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੀ ਰਾਜਧਾਨੀ ਵਿਚ ਭੇਜ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "पठै दई नृप की रजधानी ॥३॥",
      "sourceLineId": "134788",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਮਿ ਤਿਮਿ ਬਦਾ ਮਿਲਨ ਤਿਹ ਸੰਗਾ ॥",
      "transliteration": "jim tim badhaa milan teh sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨਾਲ ਮਿਲਣ ਲਈ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "जिमि तिमि बदा मिलन तिह संगा ॥",
      "sourceLineId": "134789",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਿਹ ਤਨ ਬ੍ਯਾਪਿਯੋ ਅਧਿਕ ਅਨੰਗਾ ॥",
      "transliteration": "teh tan bayaapiyo adhik ana(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਕਾਮ ਭਾਵਨਾ ਬਹੁਤ ਵਿਆਪਤ ਹੋ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "तिह तन ब्यापियो अधिक अनंगा ॥",
      "sourceLineId": "134790",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਿਹ ਭੇਟਨ ਕੌ ਚਿਤ ਲਲਚਾਵੈ ॥",
      "transliteration": "teh bheTan kau chit lalachaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮਿਲਣ ਤੇ (ਉਸ ਦਾ) ਚਿਤ ਲਲਚਾਉਾਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "तिह भेटन कौ चित ललचावै ॥",
      "sourceLineId": "134791",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਘਾਤ ਨ ਨਿਕਸਨ ਕੀ ਤ੍ਰਿਯ ਪਾਵੈ ॥੪॥",
      "transliteration": "ghaat na nikasan kee tiray paavai ||4||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਨਿਕਲਣ ਦਾ ਕੋਈ ਦਾਓ ਨਹੀਂ ਲਗ ਰਿਹਾ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "घात न निकसन की तृय पावै ॥४॥",
      "sourceLineId": "134792",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਹਿਯੋ ਸਾਹੁ ਇਕ ਭੂਪ ਬੁਲਾਵਤ ॥",
      "transliteration": "kahiyo saahu ik bhoop bulaavat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਇਸਤਰੀ) ਨੇ ਸ਼ਾਹ ਨੂੰ ਕਿਹਾ ਕਿ ਇਕ ਰਾਜਾ ਬੁਲਾ ਰਿਹਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "कहियो साहु इक भूप बुलावत ॥",
      "sourceLineId": "134793",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਭ ਅੰਨਨ ਕੋ ਨਿਰਖ ਲਿਖਾਵਤ ॥",
      "transliteration": "sabh a(n)nan ko nirakh likhaavat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਅੰਨਾ ਦਾ ਨਿਰਖ (ਭਾਅ) ਲਿਖ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "सभ अंनन को निरख लिखावत ॥",
      "sourceLineId": "134794",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਚਨ ਸੁਨਤ ਤਹ ਸਾਹੁ ਸਿਧਾਰਾ ॥",
      "transliteration": "bachan sunat teh saahu sidhaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ) ਗੱਲ ਸੁਣ ਕੇ ਸ਼ਾਹ ਉਥੇ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "बचन सुनत तह साहु सिधारा ॥",
      "sourceLineId": "134795",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਲੋ ਬੁਰੋ ਨਹਿ ਮੂੜ ਬਿਚਾਰਾ ॥੫॥",
      "transliteration": "bhalo buro neh mooR bichaaraa ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੇ ਚੰਗੇ ਮਾੜੇ ਦਾ ਵਿਚਾਰ ਨਾ ਕੀਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "भलो बुरो नहि मूड़ बिचारा ॥५॥",
      "sourceLineId": "134796",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਿਕਸਤ ਭਈ ਘਾਤ ਤ੍ਰਿਯ ਪਾਇ ॥",
      "transliteration": "nikasat bhiee ghaat tiray pai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਮੌਕਾ ਵੇਖ ਕੇ ਨਿਕਲ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "निकसत भई घात तृय पाइ ॥",
      "sourceLineId": "134797",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭੋਗ ਕੀਆ ਰਾਜਾ ਸੋ ਜਾਇ ॥",
      "transliteration": "bhog keeaa raajaa so jai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਾ ਕੇ ਰਾਜੇ ਨਾਲ ਸੰਯੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "भोग कीआ राजा सो जाइ ॥",
      "sourceLineId": "134798",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਹਿਯੋ ਮੂੜ ਪਰ ਦ੍ਵਾਰ ਬਹਿਠੋ ॥",
      "transliteration": "rahiyo mooR par dhavaiaar bahiTho ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੂਰਖ ਦੁਆਰ ਉਤੇ ਬੈਠਾ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "रहियो मूड़ पर द्वार बहिठो ॥",
      "sourceLineId": "134799",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਲਾ ਬੁਰਾ ਕਛੁ ਲਗਿਯੋ ਨ ਡਿਠੋ ॥੬॥",
      "transliteration": "bhalaa buraa kachh lagiyo na ddiTho ||6||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਕੁਝ ਚੰਗਾ ਮਾੜਾ ਨਾ ਲਗਿਆ ਅਤੇ ਨਾ ਵੇਖਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "भला बुरा कछु लगियो न डिठो ॥६॥",
      "sourceLineId": "134800",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤ੍ਰਿਯ ਕਰਿ ਕੇਲ ਭੂਪ ਸੌ ਆਈ ॥",
      "transliteration": "tiray kar kel bhoop sau aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਰਾਜੇ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ ਵਾਪਸ ਪਰਤ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "तृय करि केल भूप सौ आई ॥",
      "sourceLineId": "134801",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਲਯੋ ਸਾਹੁ ਘਰ ਬਹੁਰਿ ਬੁਲਾਈ ॥",
      "transliteration": "layo saahu ghar bahur bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਸ਼ਾਹ ਨੂੰ ਘਰ ਵਾਪਸ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "लयो साहु घर बहुरि बुलाई ॥",
      "sourceLineId": "134802",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਹਿਯੋ ਪ੍ਰਾਤ ਹਮ ਤੁਮ ਦੋਊ ਜੈ ਹੈ ॥",
      "transliteration": "kahiyo praat ham tum dhouoo jai hai ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿਣ ਲਗੀ ਕਿ ਸਵੇਰੇ ਮੈਂ ਤੇ ਤੁਸੀਂ ਦੋਵੇਾਂ (ਰਾਜੇ ਕੋਲ) ਜਾਵਾਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "कहियो प्रात हम तुम दोऊ जै है ॥",
      "sourceLineId": "134803",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਜਾ ਕਹਤ ਵਹੈ ਕਰਿ ਐਹੈ ॥੭॥",
      "transliteration": "raajaa kahat vahai kar aaihai ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੋ ਰਾਜਾ ਕਹੇਗਾ, ਉਹੀ ਕਰ ਆਵਾਗੇ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "राजा कहत वहै करि ऐहै ॥७॥",
      "sourceLineId": "134804",
      "sourceShabadId": "12593",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "134805",
      "sourceShabadId": "12594",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਹ ਛਲ ਮੂਰਖ ਤਿਹ ਛਲਾ ਸਕਿਯੋ ਨ ਭੇਦ ਬਿਚਾਰ ॥",
      "transliteration": "eeh chhal moorakh teh chhalaa sakiyo na bhedh bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਉਸ ਮੂਰਖ ਨੂੰ ਛਲ ਲਿਆ, (ਉਹ) ਅਸਲ ਭੇਦ ਨੂੰ ਨਾ ਸਮਝ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "इह छल मूरख तिह छला सकियो न भेद बिचार ॥",
      "sourceLineId": "134806",
      "sourceShabadId": "12594",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਹਾ ਚਰਿਤ ਇਨ ਤ੍ਰਿਯ ਕਿਯਾ ਨ੍ਰਿਪ ਸੰਗ ਰਮੀ ਸੁਧਾਰਿ ॥੮॥",
      "transliteration": "kahaa charit in tiray kiyaa nirap sa(n)g ramee sudhaar ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਕਿਸ ਤਰ੍ਰਹਾ ਦਾ ਚਰਿਤ੍ਰ ਕੀਤਾ ਅਤੇ ਰਾਜੇ ਨਾਲ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਰਮਣ ਕੀਤਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "कहा चरित इन तृय किया नृप संग रमी सुधारि ॥८॥",
      "sourceLineId": "134807",
      "sourceShabadId": "12594",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚੌਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੪॥੬੨੪੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chauatees charitr samaapatam sat subham sat ||334||6248||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੩੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੩੪॥੬੨੪੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ चौतीस चरित्र समापतम सतु सुभम सतु ॥३३४॥६२४८॥अफजूँ॥",
      "sourceLineId": "134808",
      "sourceShabadId": "12594",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "134809",
      "sourceShabadId": "12595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਹਿਰ ਸਰੋਹੀ ਕੇ ਬਿਖੈ ਬਿਕ੍ਰਤ ਕਰਨ ਇਕ ਰਾਇ ॥",
      "transliteration": "sahir sarohee ke bikhai bikrat karan ik rai ||",
      "translation": "",
      "punjabiViakhya": "ਸਰੋਹੀ ਨਗਰ ਵਿਚ ਬਿਕ੍ਰਤ ਕਰਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "सहिर सरोही के बिखै बिक्रत करन इक राइ ॥",
      "sourceLineId": "134810",
      "sourceShabadId": "12595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬੀਰ ਬਡੋ ਬਾਕੋ ਰਥੀ ਰਾਖਤ ਸਭ ਕੋ ਭਾਇ ॥੧॥",
      "transliteration": "beer baddo baako rathee raakhat sabh ko bhai ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵੱਡਾ ਯੋਧਾ, ਬਾਕਾ ਰਥੀ ਅਤੇ ਸਭ ਨਾਲ ਹਿਤ ਕਰਨ ਵਾਲਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "बीर बडो बाको रथी राखत सभ को भाइ ॥१॥",
      "sourceLineId": "134811",
      "sourceShabadId": "12595",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134812",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਬਲਾ ਦੇ ਰਾਨੀ ਤਾ ਕੇ ਘਰ ॥",
      "transliteration": "abalaa dhe raanee taa ke ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਅਬਲਾ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "अबला दे रानी ता के घर ॥",
      "sourceLineId": "134813",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਧਿਕ ਪੰਡਿਤਾ ਸਕਲ ਹੁਨਰ ਕਰਿ ॥",
      "transliteration": "adhik pa(n)dditaa sakal hunar kar ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਾਰੀਆਂ ਕਲਾਵਾ ਵਿਚ ਬਹੁਤ ਪ੍ਰਬੀਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "अधिक पंडिता सकल हुनर करि ॥",
      "sourceLineId": "134814",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬੀਰਮ ਦੇਵ ਪੁਤ੍ਰ ਤਿਹ ਜਾਯੋ ॥",
      "transliteration": "beeram dhev putr teh jaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬੀਰਮ ਦੇਵ ਨਾ ਦੇ ਪੁੱਤਰ ਨੂੰ ਜਨਮ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "बीरम देव पुत्र तिह जायो ॥",
      "sourceLineId": "134815",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤੇਜਵਾਨ ਬਲਵਾਨ ਸੁਹਾਯੋ ॥੨॥",
      "transliteration": "tejavaan balavaan suhaayo ||2||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਤੇਜਵਾਨ ਅਤੇ ਬਲਵਾਨ ਵਜੋਂ ਸਜਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1285,
      "hindi": "",
      "hindiTransliteration": "तेजवान बलवान सुहायो ॥२॥",
      "sourceLineId": "134816",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1285_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਾ ਕੀ ਜਾਤ ਨ ਪ੍ਰਭਾ ਬਖਾਨੀ ॥",
      "transliteration": "taa kee jaat na prabhaa bakhaanee ||",
      "translation": "",
