{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1286,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1286_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਹ ਲਗਿ ਪ੍ਰਭਾ ਕਰੈ ਕਵਨੈ ਕਬਿ ॥",
      "transliteration": "keh lag prabhaa karai kavanai kab ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਕਿਹੜਾ ਕਵੀ ਕਦੋਂ ਤਕ ਵਰਣਨ ਕਰ ਸਕਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "कह लगि प्रभा करै कवनै कबि ॥",
      "sourceLineId": "134819",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਿਰਖਿ ਸੂਰ ਸਸਿ ਰਹਤ ਇੰਦ੍ਰ ਦਬਿ ॥੩॥",
      "transliteration": "nirakh soor sas rahat i(n)dhr dhab ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਸੂਰਜ, ਚੰਦ੍ਰਮਾ ਅਤੇ ਇੰਦਰ ਦਬੇ ਦਬੇ ਰਹਿੰਦੇ ਹਨ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "निरखि सूर ससि रहत इंद्र दबि ॥३॥",
      "sourceLineId": "134820",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਛੈਲ ਛਬੀਲੋ ਕੁਅਰ ਅਪਾਰਾ ॥",
      "transliteration": "chhail chhabeelo kuar apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਅਪਾਰ ਸੁੰਦਰ ਅਤੇ ਜਵਾਨ ਕੁਮਾਰ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "छैल छबीलो कुअर अपारा ॥",
      "sourceLineId": "134821",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਪੁ ਘੜਾ ਜਾਨੁਕ ਕਰਤਾਰਾ ॥",
      "transliteration": "aap ghaRaa jaanuk karataaraa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਪਰਮਾਤਮਾ ਨੇ ਆਪ ਘੜਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "आपु घड़ा जानुक करतारा ॥",
      "sourceLineId": "134822",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨ ਢਾਰਿਯੋ ॥",
      "transliteration": "kanak avaT saache jan ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸੋਨੇ ਨੂੰ ਪੰਘਾਰ ਕੇ ਸੰਚੇ ਵਿਚ ਢਾਲਿਆ ਗਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "कनक अवटि साचे जन ढारियो ॥",
      "sourceLineId": "134823",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰੀਝਿ ਰਹਤ ਜਿਨ ਬ੍ਰਹਮ ਸਵਾਰਿਯੋ ॥੪॥",
      "transliteration": "reejh rahat jin braham savaariyo ||4||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਬਣਾਉਣ ਵਾਲਾ ਬ੍ਰਹਮਾ ਵੀ (ਵੇਖ ਕੇ) ਰੀਝਿਆ ਰਹਿੰਦਾ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "रीझि रहत जिन ब्रहम सवारियो ॥४॥",
      "sourceLineId": "134824",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨੈਨ ਫਬਤ ਮ੍ਰਿਗ ਸੇ ਕਜਰਾਰੇ ॥",
      "transliteration": "nain fabat mirag se kajaraare ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਸੁਰਮੇ ਵਾਲੇ ਨੈਣ ਹਿਰਨ (ਦੀਆਂ ਅੱਖਾ ਵਾਗ) ਫਬਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "नैन फबत मृग से कजरारे ॥",
      "sourceLineId": "134825",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕੇਸ ਜਾਲ ਜਨੁ ਫਾਸ ਸਵਾਰੇ ॥",
      "transliteration": "kes jaal jan faas savaare ||",
      "translation": "",
      "punjabiViakhya": "ਕੇਸਾ ਦਾ ਖਿਲਾਰ ('ਜਾਲ') ਮਾਨੋ ਫਾਸੀ (ਦੇ ਫੰਦੇ) ਸੰਵਾਰੇ ਹੋਏ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "केस जाल जनु फास सवारे ॥",
      "sourceLineId": "134826",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਾ ਕੇ ਪਰੇ ਗਰੈ ਸੋਈ ਜਾਨੈ ॥",
      "transliteration": "jaa ke pare garai soiee jaanai ||",
      "translation": "",
      "punjabiViakhya": "(ਕੇਸਾ ਦੇ ਫੰਦੇ) ਜਿਸ ਦੇ ਗਲੇ ਵਿਚ ਪੈਂਦੇ ਹਨ, ਉਹੀ (ਉਨ੍ਰਹਾ ਦਾ ਪ੍ਰਭਾਵ ਨੂੰ) ਜਾਣ ਸਕਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "जा के परे गरै सोई जानै ॥",
      "sourceLineId": "134827",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਨੁ ਬੂਝੈ ਕੋਈ ਕਹਾ ਪਛਾਨੈ ॥੫॥",
      "transliteration": "bin boojhai koiee kahaa pachhaanai ||5||",
      "translation": "",
      "punjabiViakhya": "ਬਿਨਾ ਜਾਣੇ ਕੋਈ ਭਲਾ ਕੀ ਪਛਾਣ ਸਕਦਾ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "बिनु बूझै कोई कहा पछानै ॥५॥",
      "sourceLineId": "134828",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੇਤਿਕ ਦੇਤ ਪ੍ਰਭਾ ਸਭ ਹੀ ਕਬਿ ॥",
      "transliteration": "jetik dhet prabhaa sabh hee kab ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਦੀ (ਜਿਹੜੀਆਂ ਉਪਮਾਵਾ) ਸਾਰੇ ਕਵੀ ਦਿੰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "जेतिक देत प्रभा सभ ही कबि ॥",
      "sourceLineId": "134829",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੇਤਿਕ ਹੁਤੀ ਤਵਨ ਭੀਤਰਿ ਛਬਿ ॥",
      "transliteration": "tetik hutee tavan bheetar chhab ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਦੇ ਅੰਤਰਗਤ ਹਨ (ਭਾਵ-ਉਹ ਉਪਮਾਵਾ ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਸਹੀ ਬਿੰਬ ਪੇਸ਼ ਨਹੀਂ ਕਰ ਸਕਦੀਆਂ)।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "तेतिक हुती तवन भीतरि छबि ॥",
      "sourceLineId": "134830",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪੁਰਖ ਨਾਰਿ ਚਿਤਵਹ ਜੋ ਤਾਹਿ ॥",
      "transliteration": "purakh naar chitaveh jo taeh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜੋ ਪੁਰਸ਼ ਅਤੇ ਇਸਤਰੀ ਵੇਖਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "पुरख नारि चितवह जो ताहि ॥",
      "sourceLineId": "134831",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਛੁ ਨ ਸੰਭਾਰ ਰਹਤ ਤਬ ਵਾਹਿ ॥੬॥",
      "transliteration": "kachh na sa(n)bhaar rahat tab vaeh ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੂੰ (ਆਪਣੀ) ਕੋਈ ਸੰਭਾਲ ਨਹੀਂ ਰਹਿੰਦੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "कछु न संभार रहत तब वाहि ॥६॥",
      "sourceLineId": "134832",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੰਚਰੀਟ ਦੁਤਿ ਦੇਖਿ ਬਿਕਾਨੇ ॥",
      "transliteration": "cha(n)chareeT dhut dhekh bikaane ||",
      "translation": "",
      "punjabiViakhya": "ਮਮੋਲੇ (ਪੰਛੀ) (ਉਸ ਦੀ) ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ ਵਿਕ ਗਏ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "चंचरीट दुति देखि बिकाने ॥",
      "sourceLineId": "134833",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਵਰ ਆਜੁ ਲਗਿ ਫਿਰਤਿ ਦਿਵਾਨੇ ॥",
      "transliteration": "bhavar aaj lag firat dhivaane ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੌਰੇ ਅਜ ਤਕ ਦੀਵਾਨੇ ਹੋਏ ਫਿਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "भवर आजु लगि फिरति दिवाने ॥",
      "sourceLineId": "134834",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਹਾਦੇਵ ਤੇ ਨੈਕ ਨਿਹਾਰੇ ॥",
      "transliteration": "mahaadhev te naik nihaare ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਦੇਵ ਉਸ ਨੂੰ ਥੋੜਾ ਜਿੰਨਾ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "महादेव ते नैक निहारे ॥",
      "sourceLineId": "134835",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਬ ਲਗਿ ਬਨ ਮੈ ਬਸਤ ਉਘਾਰੇ ॥੭॥",
      "transliteration": "ab lag ban mai basat ughaare ||7||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਤਕ ਬਨ ਵਿਚ ਨੰਗਾ ਰਹਿ ਰਿਹਾ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "अब लगि बन मै बसत उघारे ॥७॥",
      "sourceLineId": "134836",
      "sourceShabadId": "12596",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "134837",
      "sourceShabadId": "12597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਤੁਰਾਨਨ ਮੁਖ ਚਤੁਰ ਲਖਿ ਯਾਹੀ ਤੇ ਕਰੈ ॥",
      "transliteration": "chaturaanan mukh chatur lakh yaahee te karai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖਣ ਲਈ ਹੀ ਬ੍ਰਹਮਾ ਨੇ ਚਾਰ ਮੁਖ ਬਣਾ ਲਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "चतुरानन मुख चतुर लखि याही ते करै ॥",
      "sourceLineId": "134838",
      "sourceShabadId": "12597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਿਖਿ ਬਾਹਨ ਖਟ ਬਦਨ ਸੁ ਯਾਹੀ ਤੇ ਧਰੈ ॥",
      "transliteration": "sikh baahan khaT badhan su yaahee te dharai ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਰਤਿਕੇਯ ('ਸਿਖਿ ਬਾਹਨ' ਮੋਰ ਦੀ ਸਵਾਰੀ ਕਰਨ ਵਾਲੇ) ਨੇ ਇਸੇ ਲਈ ਛੇ ਮੂੰਹ ਬਣਾਏ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "सिखि बाहन खट बदन सु याही ते धरै ॥",
      "sourceLineId": "134839",
      "sourceShabadId": "12597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪੰਚਾਨਨ ਯਾ ਤੇ ਸਿਵ ਭਏ ਬਚਾਰਿ ਕਰਿ ॥",
      "transliteration": "pa(n)chaanan yaa te siv bhe bachaar kar ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਵੀ ਇਸੇ ਵਿਚਾਰ ਕਰ ਕੇ ਪੰਜ ਮੂੰਹਾ ਵਾਲੇ ਬਣ ਗਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "पंचानन या ते सिव भए बचारि करि ॥",
      "sourceLineId": "134840",
      "sourceShabadId": "12597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹੋ ਸਹਸਾਨਨ ਨਹੁ ਸਕਾ ਪ੍ਰਭਾ ਕੋ ਸਿੰਧੁ ਤਰਿ ॥੮॥",
      "transliteration": "ho sahasaanan nahu sakaa prabhaa ko si(n)dh tar ||8||",
      "translation": "",
      "punjabiViakhya": "ਹਜ਼ਾਰ ਮੂੰਹਾ ਵਾਲਾ ਸ਼ੇਸ਼ਨਾਗ ਵੀ (ਉਸ ਦੀ) ਸੁੰਦਰਤਾ ਦੇ ਸਾਗਰ ਨੂੰ ਤਰ ਨਹੀਂ ਸਕਿਆ ਸੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "हो सहसानन नहु सका प्रभा को सिंधु तरि ॥८॥",
      "sourceLineId": "134841",
      "sourceShabadId": "12597",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134842",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੇ ਅਬਲਾ ਤਿਹ ਰੂਪ ਨਿਹਾਰਤ ॥",
      "transliteration": "je abalaa teh roop nihaarat ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਸਤਰੀ ਉਸ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "जे अबला तिह रूप निहारत ॥",
      "sourceLineId": "134843",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਲਾਜ ਸਾਜ ਧਨ ਧਾਮ ਬਿਸਾਰਤ ॥",
      "transliteration": "laaj saaj dhan dhaam bisaarat ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਲਾਜ, ਸਾਜ, ਧਨ, ਘਰ ਆਦਿ (ਸਭ ਕੁਝ) ਭੁਲ ਜਾਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "लाज साज धन धाम बिसारत ॥",
      "sourceLineId": "134844",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਨ ਮੈ ਰਹਤ ਮਗਨ ਹ੍ਵੈ ਨਾਰੀ ॥",
      "transliteration": "man mai rahat magan havai naaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਮਨ ਵਿਚ ਹੀ ਮਗਨ ਹੋਈਆਂ ਰਹਿੰਦੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "मन मै रहत मगन ह्वै नारी ॥",
      "sourceLineId": "134845",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾਨੁ ਬਿਸਿਖ ਤਨ ਮ੍ਰਿਗੀ ਪ੍ਰਹਾਰੀ ॥੯॥",
      "transliteration": "jaan bisikh tan miragee prahaaree ||9||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਹਿਰਨੀ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਤੀਰ ਲਗਣ ਨਾਲ (ਉਹ ਬੇਸੁਧ ਹੋ ਜਾਦੀ ਹੋਵੇ) ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "जानु बिसिख तन मृगी प्रहारी ॥९॥",
      "sourceLineId": "134846",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਾਹ ਜੈਨ ਅਲਾਵਦੀਨ ਜਹ ॥",
      "transliteration": "saeh jain alaavadheen jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਬਾਦਸ਼ਾਹ ਜੈਨ ਅਲਾਵਦੀਨ (ਅਲਾਉੱਦੀਨ ਖ਼ਿਲਜੀ) ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "साह जैन अलावदीन जह ॥",
      "sourceLineId": "134847",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਯੋ ਕੁਅਰ ਰਹਨ ਚਾਕਰ ਤਹ ॥",
      "transliteration": "aayo kuar rahan chaakar teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਕੋਲ ਇਹ ਕੁਮਾਰ ਨੌਕਰੀ ਕਰਨ ਲਈ ਆਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "आयो कुअर रहन चाकर तह ॥",
      "sourceLineId": "134848",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਫੂਲਮਤੀ ਹਜਰਤਿ ਕੀ ਨਾਰੀ ॥",
      "transliteration": "foolamatee hajarat kee naaree ||",
      "translation": "",
      "punjabiViakhya": "ਫੂਲਮਤੀ ਨਾ ਦੀ ਬਾਦਸ਼ਾਹ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "फूलमती हजरति की नारी ॥",
      "sourceLineId": "134849",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਕੇ ਗ੍ਰਿਹ ਇਕ ਭਈ ਕੁਮਾਰੀ ॥੧੦॥",
      "transliteration": "taa ke gireh ik bhiee kumaaree ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਇਕ ਸ਼ਹਿਜ਼ਾਦੀ ਪੈਦਾ ਹੋਈ ਸੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "ता के गृह इक भई कुमारी ॥१०॥",
      "sourceLineId": "134850",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸ੍ਰੀ ਦਿਮਾਗ ਰੋਸਨ ਵਹ ਬਾਰੀ ॥",
      "transliteration": "sree dhimaag rosan veh baaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਬਾਲਿਕਾ ਦਾ ਨਾ ਰੌਸ਼ਨ ਦਿਮਾਗ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "स्री दिमाग रोसन वह बारी ॥",
      "sourceLineId": "134851",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਨੁ ਰਤਿ ਪਤਿ ਤੇ ਭਈ ਕੁਮਾਰੀ ॥",
      "transliteration": "jan rat pat te bhiee kumaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਤਨੀ ਸੁੰਦਰ ਸੀ) ਮਾਨੋ ਕਾਮ ਦੇਵ ਦੀ ਹੀ ਪੁੱਤਰੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "जनु रति पति ते भई कुमारी ॥",
      "sourceLineId": "134852",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਨੁਕ ਚੀਰਿ ਚੰਦ੍ਰਮਾ ਬਨਾਈ ॥",
      "transliteration": "januk cheer cha(n)dhramaa banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਚੰਦ੍ਰਮਾ ਨੂੰ ਚੀਰ ਕੇ (ਉਸ ਨੂੰ) ਬਣਾਇਆ ਗਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "जनुक चीरि चंद्रमा बनाई ॥",
      "sourceLineId": "134853",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾਹੀ ਤੇ ਤਾ ਮੈ ਅਤਿਤਾਈ ॥੧੧॥",
      "transliteration": "taahee te taa mai atitaiee ||11||",
      "translation": "",
      "punjabiViakhya": "ਇਸੇ ਕਰ ਕੇ ਉਸ ਵਿਚ ਬਹੁਤ ਹੰਕਾਰ ਸੀ (ਅਰਥਾਤਰ-ਬਹੁਤ ਸੁੰਦਰਤਾ ਸੀ) ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "ताही ते ता मै अतिताई ॥११॥",
      "sourceLineId": "134854",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬੀਰਮ ਦੇ ਮੁਜਰਾ ਕਹ ਆਯੋ ॥",
      "transliteration": "beeram dhe mujaraa keh aayo ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ ਦਿਨ) ਬੀਰਮ ਦੇਵ ਮੁਜਰੇ (ਸਲਾਮੀ) ਲਈ ਆਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "बीरम दे मुजरा कह आयो ॥",
      "sourceLineId": "134855",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਾਹੁ ਸੁਤਾ ਕੋ ਹ੍ਰਿਦੈ ਚੁਰਾਯੋ ॥",
      "transliteration": "saahu sutaa ko hiradhai churaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਾਦਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਦਾ (ਉਸ ਨੇ) ਹਿਰਦਾ ਚੁਰਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "साहु सुता को हृदै चुरायो ॥",
      "sourceLineId": "134856",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਨਿਕ ਜਤਨ ਅਬਲਾ ਕਰਿ ਹਾਰੀ ॥",
      "transliteration": "anik jatan abalaa kar haaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਾਲਿਕਾ ਬਹੁਤ ਯਤਨ ਕਰ ਹਟੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "अनिक जतन अबला करि हारी ॥",
      "sourceLineId": "134857",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕੈ ਸਿਹੁ ਮਿਲਾ ਨ ਪ੍ਰੀਤਮ ਪ੍ਯਾਰੀ ॥੧੨॥",
      "transliteration": "kai sih milaa na preetam payaaree ||12||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਪਿਆਰੀ ਨੂੰ ਕਿਸੇ ਤਰ੍ਰਹਾ ਪ੍ਰੀਤਮ ਨਾ ਮਿਲਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "कै सिहु मिला न प्रीतम प्यारी ॥१२॥",
      "sourceLineId": "134858",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਾਮਾਤੁਰ ਭੀ ਅਧਿਕ ਬਿਗਮ ਜਬ ॥",
      "transliteration": "kaamaatur bhee adhik bigam jab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਉਹ) ਬੇਗ਼ਮ ਬਹੁਤ ਕਾਮ ਆਤੁਰ ਹੋ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "कामातुर भी अधिक बिगम जब ॥",
      "sourceLineId": "134859",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਿਤਾ ਪਾਸ ਤਜਿ ਲਾਜ ਕਹੀ ਤਬ ॥",
      "transliteration": "pitaa paas taj laaj kahee tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੇ ਲਾਜ ਨੂੰ ਤਿਆਗ ਕੇ ਪਿਤਾ ਨੂੰ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "पिता पास तजि लाज कही तब ॥",
      "sourceLineId": "134860",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੈ ਬਾਬੁਲ ਗ੍ਰਿਹ ਗੋਰਿ ਖੁਦਾਓ ॥",
      "transliteration": "kai baabul gireh gor khudhaao ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਤਾ ਜੀ! ਜਾ ਤਾ ਮੇਰੀ ਘਰ ਵਿਚ ਕਬਰ ਪੁਟਵਾ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "कै बाबुल गृह गोरि खुदाओ ॥",
      "sourceLineId": "134861",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕੈ ਬੀਰਮ ਦੇ ਮੁਹਿ ਬਰ ਦ੍ਰਯਾਓ ॥੧੩॥",
      "transliteration": "kai beeram dhe muh bar dhrayaao ||13||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਬੀਰਮ ਦੇਵ ਨਾਲ ਮੇਰਾ ਵਿਆਹ ਕਰ ਦਿਓ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "कै बीरम दे मुहि बर द्रयाओ ॥१३॥",
      "sourceLineId": "134862",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਲੀ ਭਲੀ ਤਬ ਸਾਹ ਉਚਾਰੀ ॥",
      "transliteration": "bhalee bhalee tab saeh uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬਾਦਸ਼ਾਹ ਨੇ ਕਿਹਾ ਕਿ (ਤੇਰੀ ਗੱਲ) ਚੰਗੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "भली भली तब साह उचारी ॥",
      "sourceLineId": "134863",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੁਸਲਮਾਨ ਬੀਰਮ ਕਰ ਪ੍ਯਾਰੀ ॥",
      "transliteration": "musalamaan beeram kar payaaree ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਹੇ ਪਿਆਰੀ ਬੇਟੀ! ਪਹਿਲਾ ਤੂੰ ਬੀਰਮ ਦੇਵ ਨੂੰ ਮੁਸਲਮਾਨ ਬਣਾ ਲੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "मुसलमान बीरम कर प्यारी ॥",
      "sourceLineId": "134864",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਹੁਰਿ ਤਾਹਿ ਤੁਮ ਕਰੌ ਨਿਕਾਹਾ ॥",
      "transliteration": "bahur taeh tum karau nikaahaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਨਾਲ ਤੂੰ ਨਿਕਾਹ ਕਰ ਲਈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1286,
      "hindi": "",
      "hindiTransliteration": "बहुरि ताहि तुम करौ निकाहा ॥",
      "sourceLineId": "134865",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1286_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਿਹ ਸੌ ਤੁਮਰੀ ਲਗੀ ਨਿਗਾਹਾ ॥੧੪॥",
      "transliteration": "jeh sau tumaree lagee nigaahaa ||14||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਤੇਰੀ ਨਜ਼ਰ ਲਗੀ ਹੋਈ ਹੈ ॥੧੪॥",
      "source": "DASAM_GRANTH",
