{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1287,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1287_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬੀਰਮ ਤੀਰ ਵਜੀਰ ਪਠਾਯੋ ॥",
      "transliteration": "beeram teer vajeer paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਦਸ਼ਾਹ ਨੇ ਬੀਰਮ ਦੇਵ ਕੋਲ ਵਜ਼ੀਰ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "बीरम तीर वजीर पठायो ॥",
      "sourceLineId": "134867",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਹ ਕਹਿਯੋ ਤਿਹ ਤਾਹਿ ਸੁਨਾਯੋ ॥",
      "transliteration": "saeh kahiyo teh taeh sunaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਬਾਦਸ਼ਾਹ ਨੇ ਕਿਹਾ ਸੀ, (ਉਹੀ) ਵਜ਼ੀਰ ਨੇ ਉਸ ਨੂੰ ਸੁਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "साह कहियो तिह ताहि सुनायो ॥",
      "sourceLineId": "134868",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਮਰੇ ਦੀਨ ਪ੍ਰਥਮ ਤੁਮ ਆਵਹੁ ॥",
      "transliteration": "hamare dheen pratham tum aavahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਤੂੰ ਸਾਡੇ ਧਰਮ ਵਿਚ ਪ੍ਰਵੇਸ਼ ਕਰ,",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "हमरे दीन प्रथम तुम आवहु ॥",
      "sourceLineId": "134869",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਹੁਰਿ ਦਿਲਿਸ ਕੀ ਸੁਤਾ ਬਿਯਾਵਹੁ ॥੧੫॥",
      "transliteration": "bahur dhilis kee sutaa biyaavahu ||15||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਦਿੱਲੀ ਦੇ ਬਾਦਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨਾਲ ਵਿਆਹ ਕਰ ਲੈ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "बहुरि दिलिस की सुता बियावहु ॥१५॥",
      "sourceLineId": "134870",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬੀਰਮ ਦੇਵ ਕਹਾ ਨਹਿ ਮਾਨਾ ॥",
      "transliteration": "beeram dhev kahaa neh maanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰਮ ਦੇਵ ਨੇ ਉਸ ਦਾ ਕਿਹਾ ਨਾ ਮੰਨਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "बीरम देव कहा नहि माना ॥",
      "sourceLineId": "134871",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਰਿਯੋ ਆਪਨੇ ਦੇਸ ਪਯਾਨਾ ॥",
      "transliteration": "kariyo aapane dhes payaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਦੇਸ ਨੂੰ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "करियो आपने देस पयाना ॥",
      "sourceLineId": "134872",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪ੍ਰਾਤੇ ਖਬਰਿ ਦਿਲਿਸ ਜਬ ਪਾਈ ॥",
      "transliteration": "praate khabar dhilis jab paiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਵੇਲੇ ਜਦੋਂ ਬਾਦਸ਼ਾਹ ਨੂੰ ਖ਼ਬਰ ਹੋਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "प्राते खबरि दिलिस जब पाई ॥",
      "sourceLineId": "134873",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਮਿਤਿ ਸੈਨ ਅਰਿ ਗਹਨ ਪਠਾਈ ॥੧੬॥",
      "transliteration": "amit sain ar gahan paThaiee ||16||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਹੁਤ ਸਾਰੀ ਸੈਨਾ (ਉਸ) ਵੈਰੀ ਨੂੰ ਪਕੜਨ ਲਈ ਭੇਜ ਦਿੱਤੀ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "अमिति सैन अरि गहन पठाई ॥१६॥",
      "sourceLineId": "134874",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬੀਰਮ ਦੇਵ ਖਬਰਿ ਜਬ ਪਾਈ ॥",
      "transliteration": "beeram dhev khabar jab paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਬੀਰਮ ਦੇਵ ਨੂੰ ਇਸ ਦਾ ਪਤਾ ਲਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "बीरम देव खबरि जब पाई ॥",
      "sourceLineId": "134875",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਲਟ ਕਰੀ ਤਿਨ ਸਾਥ ਲਰਾਈ ॥",
      "transliteration": "palaT karee tin saath laraiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੇ ਪਰਤ ਕੇ ਉਨ੍ਰਹਾ ਨਾਲ ਲੜਾਈ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "पलट करी तिन साथ लराई ॥",
      "sourceLineId": "134876",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਭਾਰੀ ਭਟ ਘਾਏ ॥",
      "transliteration": "bhaat bhaat bhaaree bhaT ghaae ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਭਾਤ ਭਾਤ ਦੇ ਵੱਡੇ ਸੂਰਮੇ ਮਾਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "भाति भाति भारी भट घाए ॥",
      "sourceLineId": "134877",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਹਾ ਨ ਟਿਕੇ ਤਵਨ ਕੇ ਪਾਏ ॥੧੭॥",
      "transliteration": "tahaa na Tike tavan ke paae ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਥੇ ਉਨ੍ਰਹਾ ਦੇ ਪੈਰ ਨਾ ਟਿਕ ਸਕੇ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "तहा न टिके तवन के पाए ॥१७॥",
      "sourceLineId": "134878",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਾਧਲ ਵਤ ਰਾਜਾ ਥੋ ਜਹਾ ॥",
      "transliteration": "kaadhal vat raajaa tho jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਾਧਲ ਵਤ ਨਾ ਦਾ ਰਾਜਾ ਰਾਜ ਕਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "काधल वत राजा थो जहा ॥",
      "sourceLineId": "134879",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬੀਰਮ ਦੇਵ ਜਾਤ ਭਯੋ ਤਹਾ ॥",
      "transliteration": "beeram dhev jaat bhayo tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰਮ ਦੇਵ ਉਥੇ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "बीरम देव जात भयो तहा ॥",
      "sourceLineId": "134880",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਾਧਲ ਦੇ ਆਗੇ ਜਹਾ ਰਾਨੀ ॥",
      "transliteration": "kaadhal dhe aage jahaa raanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਅਗੇ ਰਾਜੇ ਦੀ ਕਾਧਲ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "काधल दे आगे जहा रानी ॥",
      "sourceLineId": "134881",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਸ੍ਯਾਨੀ ॥੧੮॥",
      "transliteration": "roopavaan gunavaan sayaanee ||18||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਰੂਪਮਾਨ, ਗੁਣਵਾਨ ਅਤੇ ਸਿਆਣੀ ਸੀ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "रूपवान गुनवान स्यानी ॥१८॥",
      "sourceLineId": "134882",
      "sourceShabadId": "12598",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "134883",
      "sourceShabadId": "12599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਾਧਲ ਦੇ ਰਾਨੀ ਤਿਹ ਰੂਪ ਨਿਹਾਰਿ ਕੈ ॥",
      "transliteration": "kaadhal dhe raanee teh roop nihaar kai ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਧਲ ਦੇਈ ਰਾਣੀ ਉਸ ਦਾ ਰੂਪ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "काधल दे रानी तिह रूप निहारि कै ॥",
      "sourceLineId": "134884",
      "sourceShabadId": "12599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗਿਰੀ ਧਰਨਿ ਕੇ ਭੀਤਰ ਹਿਯੇ ਬਿਚਾਰਿ ਕੈ ॥",
      "transliteration": "giree dharan ke bheetar hiye bichaar kai ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਈ ਅਤੇ ਮਨ ਵਿਚ ਸੋਚਣ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "गिरी धरनि के भीतर हिये बिचारि कै ॥",
      "sourceLineId": "134885",
      "sourceShabadId": "12599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਐਸੋ ਇਕ ਪਲ ਕੁਅਰ ਜੁ ਭੇਟਨ ਪਾਈਯੈ ॥",
      "transliteration": "aaiso ik pal kuar ju bheTan paieeyai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜੇ ਅਜਿਹਾ ਰਾਜ ਕੁਮਾਰ ਇਕ ਪਲ ਲਈ ਵੀ ਮਿਲ ਪਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "ऐसो इक पल कुअर जु भेटन पाईयै ॥",
      "sourceLineId": "134886",
      "sourceShabadId": "12599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹੋ ਜਨਮ ਪਚਾਸਿਕ ਲੌ ਸਖੀ ਬਲਿ ਬਲਿ ਜਾਈਯੈ ॥੧੯॥",
      "transliteration": "ho janam pachaasik lau sakhee bal bal jaieeyai ||19||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਹੇ ਸਖੀ! ਪੰਜਾਹ ਜਨਮਾ ਤਕ ਉਸ ਤੋਂ ਵਾਰਨੇ ਜਾਈਏ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "हो जनम पचासिक लौ सखी बलि बलि जाईयै ॥१९॥",
      "sourceLineId": "134887",
      "sourceShabadId": "12599",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134888",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾਇ ਸਖੀ ਬੀਰਮ ਦੇ ਪਾਸਾ ॥",
      "transliteration": "jai sakhee beeram dhe paasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸਖੀ ਬੀਰਮ ਦੇਵ ਪਾਸ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "जाइ सखी बीरम दे पासा ॥",
      "sourceLineId": "134889",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸਾਥ ਕਰੀ ਅਰਦਾਸਾ ॥",
      "transliteration": "eeh bidh saath karee aradhaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਅਗੇ ਇਸ ਤਰ੍ਰਹਾ ਬੇਨਤੀ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "इह बिधि साथ करी अरदासा ॥",
      "sourceLineId": "134890",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕੈ ਤੁਮ ਕਾਧਲ ਦੇ ਕੋ ਭਜੋ ॥",
      "transliteration": "kai tum kaadhal dhe ko bhajo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਾ ਤਾ ਤੁਸੀਂ ਕਾਧਲ ਦੇਈ (ਰਾਣੀ) ਨਾਲ ਸੰਯੋਗ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कै तुम काधल दे को भजो ॥",
      "sourceLineId": "134891",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕੈ ਇਹ ਦੇਸ ਹਮਾਰੋ ਤਜੋ ॥੨੦॥",
      "transliteration": "kai ieh dhes hamaaro tajo ||20||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਸਾਡਾ ਦੇਸ ਛਡ ਦਿਓ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कै इह देस हमारो तजो ॥२०॥",
      "sourceLineId": "134892",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪਾਛੇ ਲਗੀ ਫੌਜ ਤਿਨ ਮਾਨੀ ॥",
      "transliteration": "paachhe lagee fauaj tin maanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸੋਚਿਆ ਕਿ (ਮੇਰੇ) ਪਿਛੇ ਫ਼ੌਜ ਲਗੀ ਹੋਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "पाछे लगी फौज तिन मानी ॥",
      "sourceLineId": "134893",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੁਤਿਯ ਰਹਨ ਕੀ ਠੌਰ ਨ ਜਾਨੀ ॥",
      "transliteration": "dhutiy rahan kee Thauar na jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਹਿਣ ਲਈ ਕੋਈ ਹੋਰ ਥਾ ਵੀ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "दुतिय रहन की ठौर न जानी ॥",
      "sourceLineId": "134894",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾ ਕੋ ਦੇਸ ਤਰੁਨਿ ਨਹਿ ਤਜੋ ॥",
      "transliteration": "taa ko dhes tarun neh tajo ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ ਬੀਰਮ ਦੇਵ ਨੇ ਸਖੀ ਰਾਹੀਂ ਕਹਿ ਭੇਜਿਆ ਕਿ ਮੈਂ) ਉਸ ਇਸਤਰੀ ਦਾ ਦੇਸ ਨਹੀਂ ਛਡਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "ता को देस तरुनि नहि तजो ॥",
      "sourceLineId": "134895",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਾਧਲ ਦੇ ਰਾਨੀ ਕਹ ਭਜੋ ॥੨੧॥",
      "transliteration": "kaadhal dhe raanee keh bhajo ||21||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਧਲ ਦੇਈ ਰਾਣੀ ਨਾਲ ਸੰਯੋਗ ਕਰਾਗਾ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "काधल दे रानी कह भजो ॥२१॥",
      "sourceLineId": "134896",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਨੀ ਰਮੀ ਮਿਤ੍ਰ ਕੇ ਭੋਗਾ ॥",
      "transliteration": "raanee ramee mitr ke bhogaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਆਪਣੇ ਮਿਤਰ ਨਾਲ ਸੰਯੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "रानी रमी मित्र के भोगा ॥",
      "sourceLineId": "134897",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਿਤ ਕੇ ਦਏ ਤ੍ਯਾਗਿ ਸਭ ਸੋਗਾ ॥",
      "transliteration": "chit ke dhe tayaag sabh sogaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਦੇ ਸਾਰੇ ਗ਼ਮ ਦੂਰ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "चित के दए त्यागि सभ सोगा ॥",
      "sourceLineId": "134898",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਬ ਲਗਿ ਲਿਖੋ ਸਾਹ ਕੋ ਆਯੋ ॥",
      "transliteration": "tab lag likho saeh ko aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਬਾਦਸ਼ਾਹ ਦਾ ਲਿਖਿਆ ਹੋਇਆ (ਪਰਵਾਨਾ) ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "तब लगि लिखो साह को आयो ॥",
      "sourceLineId": "134899",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਾਚਿ ਮੰਤ੍ਰਿਯਨ ਭਾਖਿ ਸੁਨਾਯੋ ॥੨੨॥",
      "transliteration": "baach ma(n)tirayan bhaakh sunaayo ||22||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਮੰਤ੍ਰੀਆਂ ਨੇ ਪੜ੍ਰਹ ਕੇ ਸੁਣਾ ਦਿੱਤਾ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "बाचि मंतृयन भाखि सुनायो ॥२२॥",
      "sourceLineId": "134900",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲਿਖਿ ਸੁ ਲਿਖਾ ਮਹਿ ਯਹੈ ਪਠਾਈ ॥",
      "transliteration": "likh su likhaa meh yahai paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਰਵਾਨੇ ਵਿਚ ਇਹੀ ਲਿਖ ਕੇ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "लिखि सु लिखा महि यहै पठाई ॥",
      "sourceLineId": "134901",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਔਰ ਬਾਤ ਦੂਜੀ ਨ ਜਨਾਈ ॥",
      "transliteration": "aauar baat dhoojee na janaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਕੋਈ ਦੂਜੀ ਗੱਲ ਨਹੀਂ ਦਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "और बात दूजी न जनाई ॥",
      "sourceLineId": "134902",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕੈ ਬੀਰਮ ਕਹ ਬਾਧਿ ਪਠਾਵਹੁ ॥",
      "transliteration": "kai beeram keh baadh paThaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਤਾ ਬੀਰਾਮ ਦੇਵ ਨੂੰ ਬੰਨ੍ਰਹ ਕੇ (ਮੇਰੇ ਕੋਲ) ਭੇਜ ਦਿਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कै बीरम कह बाधि पठावहु ॥",
      "sourceLineId": "134903",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕੈ ਮੇਰੇ ਸੰਗ ਜੁਧ ਮਚਾਵਹੁ ॥੨੩॥",
      "transliteration": "kai mere sa(n)g judh machaavahu ||23||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਮੇਰੇ ਨਾਲ ਯੁੱਧ ਕਰੋ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कै मेरे संग जुध मचावहु ॥२३॥",
      "sourceLineId": "134904",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਨੀ ਬਾਧਿ ਨ ਬੀਰਮ ਦਯੋ ॥",
      "transliteration": "raanee baadh na beeram dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਬੀਰਮ ਦੇਵ ਨੂੰ ਬੰਨ੍ਰਹ ਕੇ ਨਾ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "रानी बाधि न बीरम दयो ॥",
      "sourceLineId": "134905",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਹਿਰ ਕੌਚ ਦੁੰਦਭੀ ਬਜਯੋ ॥",
      "transliteration": "pahir kauach dhu(n)dhabhee bajayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਵਚ ਪਾ ਕੇ ਨਗਾਰਾ ਵਜਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "पहिर कौच दुँदभी बजयो ॥",
      "sourceLineId": "134906",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਿਰਭੈ ਚਲੀ ਜੁਧ ਕੇ ਕਾਜਾ ॥",
      "transliteration": "nirabhai chalee judh ke kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਘੋੜੇ, ਹਾਥੀ, ਰਥ, ਬਾਣ ਆਦਿ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "निरभै चली जुध के काजा ॥",
      "sourceLineId": "134907",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹੈ ਗੈ ਰਥ ਸਾਜਤ ਸਰ ਸਾਜਾ ॥੨੪॥",
      "transliteration": "hai gai rath saajat sar saajaa ||24||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰ ਅਸਤ੍ਰ ਸਜਾ ਕੇ ਨਿਰਭੈ ਹੋ ਕੇ ਯੁੱਧਕਰਮ ਲਈ ਚਲ ਪਈ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "है गै रथ साजत सर साजा ॥२४॥",
      "sourceLineId": "134908",
      "sourceShabadId": "12600",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "134909",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਜ੍ਯੋ ਰਾਗ ਮਾਰੂ ਮੰਡੇ ਛਤ੍ਰਧਾਰੀ ॥",
      "transliteration": "bajayo raag maaroo ma(n)dde chhatradhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰੂ ਰਾਗ ਵਜਿਆ ਅਤੇ ਛਤ੍ਰਧਾਰੀ (ਸੂਰਮੇ ਯੁੱਧ ਵਿਚ) ਡੱਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "बज्यो राग मारू मंडे छत्रधारी ॥",
      "sourceLineId": "134910",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਹੈ ਤੀਰ ਤਰਵਾਰ ਕਾਤੀ ਕਟਾਰੀ ॥",
      "transliteration": "bahai teer taravaar kaatee kaTaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰ, ਤਲਵਾਰਾ, ਕਾਤੀਆਂ ਅਤੇ ਕਟਾਰਾ ਚਲਣ ਲਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "बहै तीर तरवार काती कटारी ॥",
      "sourceLineId": "134911",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਹੂੰ ਕੇਤੁ ਫਾਟੇ ਗਿਰੇ ਛਤ੍ਰ ਟੂਟੇ ॥",
      "transliteration": "kahoo(n) ket faaTe gire chhatr TooTe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਝੰਡੇ ਫਟੇ ਪਏ ਸਨ ਅਤੇ ਕਿਤੇ ਛਤ੍ਰ ਟੁਟ ਕੇ ਡਿਗੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कहूँ केतु फाटे गिरे छत्र टूटे ॥",
      "sourceLineId": "134912",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਹੂੰ ਮਤ ਦੰਤੀ ਫਿਰੈ ਬਾਜ ਛੂਟੈ ॥੨੫॥",
      "transliteration": "kahoo(n) mat dha(n)tee firai baaj chhooTai ||25||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਮਸਤ ਹਾਥੀ ਅਤੇ ਘੋੜੇ ਛੁਟੇ ਫਿਰਦੇ ਸਨ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कहूँ मत दंती फिरै बाज छूटै ॥२५॥",
      "sourceLineId": "134913",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਹੂੰ ਬਾਜ ਜੂਝੇ ਪਰੇ ਹੈ ਮਤੰਗੈ ॥",
      "transliteration": "kahoo(n) baaj joojhe pare hai mata(n)gai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘੋੜੇ ਅਤੇ ਕਿਤੇ ਹਾਥੀ ਮਰੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कहूँ बाज जूझे परे है मतंगै ॥",
      "sourceLineId": "134914",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਹੂੰ ਨਾਗ ਮਾਰੇ ਬਿਰਾਜੈ ਉਤੰਗੈ ॥",
      "transliteration": "kahoo(n) naag maare biraajai uta(n)gai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਉਚੇ ਵੱਡੇ ਹਾਥੀ ਮਾਰੇ ਹੋਏ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कहूँ नाग मारे बिराजै उतंगै ॥",
      "sourceLineId": "134915",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਡਾਰੇ ਪਰੇ ਬਰਮ ਫਾਟੇ ॥",
      "transliteration": "kahoo(n) beer ddaare pare baram faaTe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਮੇ ਟੁਟੇ ਫਟੇ ਕਵਚਾ ਨਾਲ ਪਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर डारे परे बरम फाटे ॥",
      "sourceLineId": "134916",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਹੂੰ ਖੇਤ ਖਾਡੇ ਲਸੈ ਚਰਮ ਕਾਟੇ ॥੨੬॥",
      "transliteration": "kahoo(n) khet khaadde lasai charam kaaTe ||26||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਕਟੀਆਂ ਹੋਈਆਂ ਢਾਲਾ ਅਤੇ ਤਲਵਾਰਾ (ਪਈਆਂ ਹੋਈਆਂ) ਚਮਕ ਰਹੀਆਂ ਸਨ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कहूँ खेत खाडे लसै चरम काटे ॥२६॥",
      "sourceLineId": "134917",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗਿਰੇ ਬੀਰ ਮਾਰੇ ਕਾ ਲੌ ਗਨਾਊ ॥",
      "transliteration": "gire beer maare kaa lau ganaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰੇ ਜਾਣ ਤੇ ਡਿਗੇ ਪਏ ਸੂਰਮਿਆਂ ਦੀ ਗਿਣਤੀ (ਮੈਂ) ਕਿਥੋਂ ਤਕ ਕਰਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "गिरे बीर मारे का लौ गनाऊ ॥",
      "sourceLineId": "134918",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਹੌ ਜੋ ਸਭੈ ਏਕ ਗ੍ਰੰਥੈ ਬਨਾਊ ॥",
      "transliteration": "kahau jo sabhai ek gra(n)thai banaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਸਾਰਿਆਂ ਬਾਰੇ ਕਹਾ ਤਾ ਇਕ ਗ੍ਰੰਥ ਹੀ ਬਣਾ ਦਿਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कहौ जो सभै एक ग्रंथै बनाऊ ॥",
      "sourceLineId": "134919",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਥਾ ਸਕਤਿ ਕੈ ਅਲਪ ਤਾ ਤੇ ਉਚਾਰੋ ॥",
      "transliteration": "jathaa sakat kai alap taa te uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਇਸੇ ਲਈ ਯਥਾ ਸ਼ਕਤੀ ਥੋੜੇ ਹੀ ਉਚਾਰੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "जथा सकति कै अलप ता ते उचारो ॥",
      "sourceLineId": "134920",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸੁਨੋ ਕਾਨ ਦੈ ਕੈ ਸਭੇ ਹੀ ਪਿਆਰੋ ॥੨੭॥",
      "transliteration": "suno kaan dhai kai sabhe hee piaaro ||27||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਆਰਿਓ! ਸਾਰੇ ਕੰਨ ਦੇ ਕੇ ਸੁਣੋ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "सुनो कान दै कै सभे ही पिआरो ॥२७॥",
      "sourceLineId": "134921",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਇਤੈ ਖਾਨ ਢੂਕੇ ਉਤੈ ਰਾਜ ਨੀਕੇ ॥",
      "transliteration": "eitai khaan ddooke utai raaj neeke ||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰੋਂ ਖ਼ਾਨ ਢੁਕੇ ਹੋਏ ਸਨ ਅਤੇ ਉਧਰੋਂ ਚੰਗੇ ਰਾਜੇ (ਚੜ੍ਰਹੇ ਹੋਏ ਸਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "इतै खान ढूके उतै राज नीके ॥",
      "sourceLineId": "134922",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਹਠੀ ਰੋਸ ਬਾਢੇ ਸੁ ਗਾਢੇ ਅਨੀਕੇ ॥",
      "transliteration": "haThee ros baadde su gaadde aneeke ||",
      "translation": "",
      "punjabiViakhya": "ਤਕੜੀ ਸੈਨਾ ਦੇ ਹਠੀ ਯੋਧਿਆਂ ਨੇ ਰੋਹ ਵਧਾ ਲਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "हठी रोस बाढे सु गाढे अनीके ॥",
      "sourceLineId": "134923",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਲਰੇ ਕੋਪ ਕੈ ਕੈ ਸੁ ਏਕੈ ਨ ਭਾਜ੍ਯੋ ॥",
      "transliteration": "lare kop kai kai su ekai na bhaajayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਲੜੇ ਅਤੇ ਇਕ ਵੀ ਨਾ ਭਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "लरे कोप कै कै सु एकै न भाज्यो ॥",
      "sourceLineId": "134924",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਘਰੀ ਚਾਰਿ ਲੌ ਸਾਰ ਸੌ ਸਾਰ ਬਾਜ੍ਯੋ ॥੨੮॥",
      "transliteration": "gharee chaar lau saar sau saar baajayo ||28||",
      "translation": "",
      "punjabiViakhya": "ਚਾਰ ਘੜੀਆਂ ਤਕ ਲੋਹੇ ਨਾਲ ਲੋਹਾ ਖੜਕਿਆ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "घरी चारि लौ सार सौ सार बाज्यो ॥२८॥",
      "sourceLineId": "134925",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਤਹਾ ਸੰਖ ਭੇਰੀ ਘਨੇ ਨਾਦ ਬਾਜੇ ॥",
      "transliteration": "tahaa sa(n)kh bheree ghane naadh baaje ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸੰਖ, ਭੇਰੀ, ਮ੍ਰਿਦੰਗ, ਮੁਚੰਗ, ਉਪੰਗ ਆਦਿ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "तहा संख भेरी घने नाद बाजे ॥",
      "sourceLineId": "134926",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਮ੍ਰਿਦੰਗੈ ਮੁਚੰਗੈ ਉਪੰਗੈ ਬਿਰਾਜੇ ॥",
      "transliteration": "miradha(n)gai mucha(n)gai upa(n)gai biraaje ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਜ਼ਿਆਦਾ ਵਾਜੇ ਵਜਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "मृदंगै मुचंगै उपंगै बिराजे ॥",
      "sourceLineId": "134927",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕਹੂੰ ਨਾਇ ਨਾਫੀਰਿਯੈਂ ਔ ਨਗਾਰੇ ॥",
      "transliteration": "kahoo(n) nai naafeeriyai(n) aau nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸ਼ਹਿਨਾਈ, ਨਫ਼ੀਰੀ ਅਤੇ ਨਗਾਰੇ ਵਜਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कहूँ नाइ नाफीरियैं औ नगारे ॥",
      "sourceLineId": "134928",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਹੂੰ ਝਾਝ ਬੀਨਾ ਬਜੈ ਘੰਟ ਭਾਰੇ ॥੨੯॥",
      "transliteration": "kahoo(n) jhaajh beenaa bajai gha(n)T bhaare ||29||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਝਾਝ, ਬੀਨ, ਭਾਰੇ ਘੜਿਆਲ ਆਦਿ ਵਾਜੇ ਵਜਦੇ ਸਨ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कहूँ झाझ बीना बजै घंट भारे ॥२९॥",
      "sourceLineId": "134929",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਕਹੂੰ ਟੂਕ ਟੂਕ ਹੈ ਗਿਰੈ ਹੈ ਸਿਪਾਹੀ ॥",
      "transliteration": "kahoo(n) Took Took hai girai hai sipaahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸਿਪਾਹੀ ਟੋਟੇ ਟੋਟੇ ਹੋ ਕੇ ਡਿਗੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "कहूँ टूक टूक है गिरै है सिपाही ॥",
      "sourceLineId": "134930",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਮਰੇ ਸ੍ਵਾਮਿ ਕੇ ਕਾਜਹੂੰ ਕੋ ਨਿਬਾਹੀ ॥",
      "transliteration": "mare savaiaam ke kaajahoo(n) ko nibaahee ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਆਮੀ ਦੇ ਕਾਰਜ ਨੂੰ ਨਿਭਾਉਾਂਦੇ ਹੋਏ ਮਰ ਗਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "मरे स्वामि के काजहूँ को निबाही ॥",
      "sourceLineId": "134931",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਤਹਾ ਕੌਚ ਧਾਰੇ ਚੜੇ ਛਤ੍ਰ ਧਾਰੀ ॥",
      "transliteration": "tahaa kauach dhaare chaRe chhatr dhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਕਵਚ ਧਾਰੀ ਅਤੇ ਛਤ੍ਰਧਾਰੀ ਸੂਰਮੇ ਚੜ੍ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "तहा कौच धारे चड़े छत्र धारी ॥",
      "sourceLineId": "134932",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਮਿਲੈ ਮੇਲ ਮਾਨੋ ਮਦਾਰੈ ਮਦਾਰੀ ॥੩੦॥",
      "transliteration": "milai mel maano madhaarai madhaaree ||30||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਹੈ) ਮਾਨੋ ਮਦਾਰੀ ਨੂੰ ਮਦਾਰੀ ਮਿਲਿਆ ਹੋਵੇ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "मिलै मेल मानो मदारै मदारी ॥३०॥",
      "sourceLineId": "134933",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਕਿਤੇ ਭੂਮਿ ਲੋਟੈ ਸੁ ਹਾਥੈ ਉਚਾਏ ॥",
      "transliteration": "kite bhoom loTai su haathai uchaae ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਹੱਥ ਚੁਕੇ ਹੋਇਆਂ ਧਰਤੀ ਉਤੇ ਲੇਟਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "किते भूमि लोटै सु हाथै उचाए ॥",
      "sourceLineId": "134934",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਡਰੈ ਸੇਖ ਜੈਸੇ ਸਮਾਈ ਸਮਾਏ ॥",
      "transliteration": "ddarai sekh jaise samaiee samaae ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸ਼ੇਖ਼ (ਫ਼ਕੀਰ) ਲੋਕ ਸੰਗੀਤ ਵਿਚ ਮਗਨ ਹੋਏ (ਧਰਮ ਦੀ ਉਲੰਘਣਾ ਤੋਂ) ਡਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "डरै सेख जैसे समाई समाए ॥",
      "sourceLineId": "134935",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਜੁਝੈ ਜ੍ਵਾਨ ਜੋਧਾ ਜਗੇ ਜੋਰ ਜੰਗੈ ॥",
      "transliteration": "jujhai javaiaan jodhaa jage jor ja(n)gai ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ਬਰਦਸਤ ਜੰਗ ਵਿਚ ਜਵਾਨ ਯੋਧੇ ਜੂਝ ਰਹੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "जुझै ज्वान जोधा जगे जोर जंगै ॥",
      "sourceLineId": "134936",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਮਨੋ ਪਾਨ ਕੈ ਭੰਗ ਸੋਏ ਮਲੰਗੈ ॥੩੧॥",
      "transliteration": "mano paan kai bha(n)g soe mala(n)gai ||31||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਭੰਗ ਪੀ ਕੇ ਮਲੰਗ ਸੁਤੇ ਪਏ ਹੋਣ ॥੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "मनो पान कै भंग सोए मलंगै ॥३१॥",
      "sourceLineId": "134937",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1287_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਬਹੈ ਆਨ ਐਸੇ ਬਚੈ ਬੀਰ ਕੌਨੈ ॥",
      "transliteration": "bahai aan aaise bachai beer kauanai ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣਾ ਦੇ ਇਸ ਤਰ੍ਰਹਾ ਚਲਣ ਨਾਲ ਕਿਹੜਾ ਸੂਰਮਾ ਬਚ ਸਕਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1287,
      "hindi": "",
      "hindiTransliteration": "बहै आन ऐसे बचै बीर कौनै ॥",
      "sourceLineId": "134938",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
