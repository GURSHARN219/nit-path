{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1288,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1288_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਲਰਿਯੋ ਆਨਿ ਜੋ ਪੈ ਗਯੋ ਜੂਝਿ ਤੌਨੈ ॥",
      "transliteration": "lariyo aan jo pai gayo joojh tauanai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵੀ ਆ ਕੇ ਲੜਿਆ ਸੀ, ਉਹੀ ਮਾਰਿਆ ਗਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "लरियो आनि जो पै गयो जूझि तौनै ॥",
      "sourceLineId": "134939",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਹਾ ਜੋਜਨੰ ਪਾਚ ਭਯੋ ਬੀਰ ਖੇਤੰ ॥",
      "transliteration": "tahaa jojana(n) paach bhayo beer kheta(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਪੰਜ ਜੋਜਨਾ (ਵੀਹ ਕੋਹਾ) ਤਕ ਦੇ ਖੇਤਰ ਵਿਚ ਯੁੱਧ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "तहा जोजनं पाच भयो बीर खेतं ॥",
      "sourceLineId": "134940",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਦਾਰੇ ਪਰੇ ਬੀਰ ਬ੍ਰਿੰਦੇ ਬਿਚੇਤੰ ॥੩੨॥",
      "transliteration": "bidhaare pare beer bira(n)dhe bicheta(n) ||32||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸੂਰਮਿਆਂ ਦੇ ਸਮੂਹ ਮਾਰੇ ਹੋਏ ਅਚੇਤ ਪਏ ਸਨ ॥੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "बिदारे परे बीर बृंदे बिचेतं ॥३२॥",
      "sourceLineId": "134941",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਬੈਤਾਲ ਬੀਨਾ ਬਜਾਵੈ ॥",
      "transliteration": "kahoo(n) beer baitaal beenaa bajaavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਬੀਰ ਬੈਤਾਲ ਬੀਣਾ ਵਜਾ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर बैताल बीना बजावै ॥",
      "sourceLineId": "134942",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਹੂੰ ਜੋਗਨੀਯੈਂ ਖਰੀ ਗੀਤ ਗਾਵੈ ॥",
      "transliteration": "kahoo(n) joganeeyai(n) kharee geet gaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਜੋਗਣਾ ਖੜੋ ਕੇ ਗੀਤ ਗਾ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "कहूँ जोगनीयैं खरी गीत गावै ॥",
      "sourceLineId": "134943",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਹੂੰ ਲੈ ਬਰੰਗਨਿ ਬਰੈਂ ਵੈ ਤਿਸੀ ਕੋ ॥",
      "transliteration": "kahoo(n) lai bara(n)gan barai(n) vai tisee ko ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਅਪੱਛਰਾਵਾ ਉਨ੍ਰਹਾ ਨੂੰ ਵਰ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "कहूँ लै बरंगनि बरैं वै तिसी को ॥",
      "sourceLineId": "134944",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲਹੈ ਸਾਮੁਹੇ ਜੁਧ ਜੁਝੋ ਜਿਸੀ ਕੋ ॥੩੩॥",
      "transliteration": "lahai saamuhe judh jujho jisee ko ||33||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਆਹਮੋ ਸਾਹਮਣੇ ਯੁੱਧ ਕਰ ਕੇ ਮਰਦੇ ਸਨ ॥੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "लहै सामुहे जुध जुझो जिसी को ॥३३॥",
      "sourceLineId": "134945",
      "sourceShabadId": "12601",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134946",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਬ ਹੀ ਸੈਨ ਜੂਝਿ ਸਭ ਗਈ ॥",
      "transliteration": "jab hee sain joojh sabh giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸਾਰੀ ਸੈਨਾ ਮਾਰੀ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "जब ही सैन जूझि सभ गई ॥",
      "sourceLineId": "134947",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਬ ਤ੍ਰਿਯ ਸੁਤਹਿ ਪਠਾਵਤ ਭਈ ॥",
      "transliteration": "tab tiray suteh paThaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸਤਰੀ ਨੇ ਪੁੱਤਰ ਨੂੰ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "तब तृय सुतहि पठावत भई ॥",
      "sourceLineId": "134948",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੋਊ ਜੂਝਿ ਜਬ ਸ੍ਵਰਗ ਸਿਧਾਯੋ ॥",
      "transliteration": "souoo joojh jab savairag sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਵੀ ਲੜ ਕੇ ਸਵਰਗ ਨੂੰ ਸਿਧਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "सोऊ जूझि जब स्वरग सिधायो ॥",
      "sourceLineId": "134949",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੁਤਿਯ ਪੁਤ੍ਰ ਤਹ ਔਰ ਪਠਾਯੋ ॥੩੪॥",
      "transliteration": "dhutiy putr teh aauar paThaayo ||34||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਧਰ ਨੂੰ ਦੂਜਾ ਪੁੱਤਰ ਹੋਰ ਭੇਜਿਆ ॥੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "दुतिय पुत्र तह और पठायो ॥३४॥",
      "sourceLineId": "134950",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੋਊ ਗਿਰਿਯੋ ਜੂਝਿ ਰਨ ਜਬ ਹੀ ॥",
      "transliteration": "souoo giriyo joojh ran jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਵੀ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਲੜ ਮਰਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "सोऊ गिरियो जूझि रन जब ही ॥",
      "sourceLineId": "134951",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤੀਜੇ ਸੁਤਹਿ ਪਠਾਯੋ ਤਬ ਹੀ ॥",
      "transliteration": "teeje suteh paThaayo tab hee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੁਰਤ ਤੀਜੇ ਪੁੱਤਰ ਨੂੰ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "तीजे सुतहि पठायो तब ही ॥",
      "sourceLineId": "134952",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੋਊ ਜੂਝਿ ਜਬ ਗਯੋ ਦਿਵਾਲੈ ॥",
      "transliteration": "souoo joojh jab gayo dhivaalai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਵੀ ਜੂਝ ਕੇ ਦੇਵ ਲੋਕ ਚਲਾ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "सोऊ जूझि जब गयो दिवालै ॥",
      "sourceLineId": "134953",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚੌਥੇ ਪੂਤ ਪਠਾਯੋ ਬਾਲੈ ॥੩੫॥",
      "transliteration": "chauathe poot paThaayo baalai ||35||",
      "translation": "",
      "punjabiViakhya": "ਤਾ (ਉਸ) ਇਸਤਰੀ ਨੇ ਚੌਥਾ ਪੁੱਤਰ ਭੇਜਿਆ ॥੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "चौथे पूत पठायो बालै ॥३५॥",
      "sourceLineId": "134954",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚਾਰੌ ਗਿਰੇ ਜੂਝਿ ਸੁਤ ਜਬ ਹੀ ॥",
      "transliteration": "chaarau gire joojh sut jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਚਾਰੇ ਪੁੱਤਰ ਜੂਝ ਕੇ ਡਿਗ ਪਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "चारौ गिरे जूझि सुत जब ही ॥",
      "sourceLineId": "134955",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਬਲਾ ਚਲੀ ਜੁਧ ਕੌ ਤਬ ਹੀ ॥",
      "transliteration": "abalaa chalee judh kau tab hee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸਤਰੀ ਖ਼ੁਦ ਯੁੱਧ ਲਈ ਚਲ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "अबला चली जुध कौ तब ही ॥",
      "sourceLineId": "134956",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੂਰ ਬਚੇ ਤੇ ਸਕਲ ਬੁਲਾਇਸਿ ॥",
      "transliteration": "soor bache te sakal bulais ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਕੀ ਬਚ ਰਹੇ ਸਾਰੇ ਸੂਰਮਿਆਂ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "सूर बचे ते सकल बुलाइसि ॥",
      "sourceLineId": "134957",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਲਰਨ ਚਲੀ ਦੁੰਦਭੀ ਬਜਾਇਸਿ ॥੩੬॥",
      "transliteration": "laran chalee dhu(n)dhabhee bajais ||36||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੜਨ ਲਈ ਨਗਾਰਾ ਵਜਾ ਦਿੱਤਾ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "लरन चली दुँदभी बजाइसि ॥३६॥",
      "sourceLineId": "134958",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਐਸਾ ਕਰਾ ਬਾਲ ਤਹ ਜੁਧਾ ॥",
      "transliteration": "aaisaa karaa baal teh judhaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਅਜਿਹਾ ਯੁੱਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "ऐसा करा बाल तह जुधा ॥",
      "sourceLineId": "134959",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਹੀ ਨ ਭਟ ਕਾਹੂ ਮਹਿ ਸੁਧਾ ॥",
      "transliteration": "rahee na bhaT kaahoo meh sudhaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਕਿਸੇ ਵੀ ਯੋਧੇ ਵਿਚ ਕੋਈ ਸੁੱਧ ਬੁੱਧ ਨਾ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "रही न भट काहू महि सुधा ॥",
      "sourceLineId": "134960",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਾਰੇ ਪਰੇ ਬੀਰ ਬਿਕਰਾਰਾ ॥",
      "transliteration": "maare pare beer bikaraaraa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਭਿਆਨਕ ਸੂਰਮੇ ਮਾਰੇ ਪਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "मारे परे बीर बिकरारा ॥",
      "sourceLineId": "134961",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੋਮੁਖ ਝਾਝਰ ਬਸਤ ਨਗਾਰਾ ॥੩੭॥",
      "transliteration": "gomukh jhaajhar basat nagaaraa ||37||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗੋਮੁਖ (ਰਣ ਸਿੰਘੇ) ਝਾਝਰ ਆਦਿ ਨਗਾਰੇ ਵਜ ਰਹੇ ਸਨ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "गोमुख झाझर बसत नगारा ॥३७॥",
      "sourceLineId": "134962",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਾ ਪਰ ਸਿਮਟਿ ਸਰੋਹੀ ਮਾਰਤਿ ॥",
      "transliteration": "jaa par simaT sarohee maarat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਉਤੇ (ਰਾਣੀ) ਸਿਮਟ ਕੇ ਸਿਰੋਹੀ (ਸਿਰੋਹੀ ਨਗਰ ਦੀ ਬਣੀ ਹੋਈ ਤਲਵਾਰ) ਦਾ ਵਾਰ ਕਰਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "जा पर सिमटि सरोही मारति ॥",
      "sourceLineId": "134963",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਾ ਕੋ ਕਾਟਿ ਭੂਮ ਸਿਰ ਡਾਰਤਿ ॥",
      "transliteration": "taa ko kaaT bhoom sir ddaarat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸਿਰ ਕਟ ਕੇ ਭੂਮੀ ਉਤੇ ਸੁਟ ਦਿੰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "ता को काटि भूम सिर डारति ॥",
      "sourceLineId": "134964",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਾ ਕੇ ਹਨੈ ਤਰੁਨਿ ਤਨ ਬਾਨਾ ॥",
      "transliteration": "jaa ke hanai tarun tan baanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਰਾਣੀ ਨੇ ਬਾਣ ਮਾਰਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "जा के हनै तरुनि तन बाना ॥",
      "sourceLineId": "134965",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਰੈ ਸੁਭਟ ਮ੍ਰਿਤ ਲੋਕ ਪਯਾਨਾ ॥੩੮॥",
      "transliteration": "karai subhaT mirat lok payaanaa ||38||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸੂਰਮੇ ਨੇ (ਤੁਰਤ) ਜਮਲੋਕ ਨੂੰ ਚਾਲੇ ਪਾ ਦਿੱਤੇ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "करै सुभट मृत लोक पयाना ॥३८॥",
      "sourceLineId": "134966",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੁਨਿ ਚੁਨਿ ਜ੍ਵਾਨ ਪਖਰਿਯਾ ਮਾਰੇ ॥",
      "transliteration": "chun chun javaiaan pakhariyaa maare ||",
      "translation": "",
      "punjabiViakhya": "ਚੁਣ ਚੁਣ ਕੇ ਘੋੜ ਸਵਾਰ ਜਵਾਨਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "चुनि चुनि ज्वान पखरिया मारे ॥",
      "sourceLineId": "134967",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਕ ਇਕ ਤੇ ਦ੍ਵੈ ਦ੍ਵੈ ਕਰਿ ਡਾਰੇ ॥",
      "transliteration": "eik ik te dhavai dhavai kar ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਇਕ ਦੇ ਦੋ ਦੋ ਟੋਟੇ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "इक इक ते द्वै द्वै करि डारे ॥",
      "sourceLineId": "134968",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਉਠੀ ਧੂਰਿ ਲਾਗੀ ਅਸਮਾਨਾ ॥",
      "transliteration": "auThee dhoor laagee asamaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਯੂੱਧ-ਭੂਮੀ ਵਿਚੋਂ) ਧੂੜ ਉਡ ਕੇ ਆਸਮਾਨ ਨੂੰ ਜਾ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "उठी धूरि लागी असमाना ॥",
      "sourceLineId": "134969",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਸਿ ਚਮਕੈ ਬਿਜੁਰੀ ਪਰਮਾਨਾ ॥੩੯॥",
      "transliteration": "as chamakai bijuree paramaanaa ||39||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਲਵਾਰਾ ਬਿਜਲੀ ਵਾਗ ਚਮਕਣ ਲਗੀਆਂ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "असि चमकै बिजुरी परमाना ॥३९॥",
      "sourceLineId": "134970",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਾਟੇ ਸੁਭਟ ਸਰੋਹਿਨ ਪਰੇ ॥",
      "transliteration": "kaaTe subhaT sarohin pare ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਰੋਹੀਆਂ ਨਾਲ ਕਟੇ ਹੋਏ ਸੂਰਮੇ ਇਸ ਤਰ੍ਰਹਾ ਪਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "काटे सुभट सरोहिन परे ॥",
      "sourceLineId": "134971",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਨੁ ਮਾਰੁਤ ਬਰ ਬਿਰਛ ਉਪਰੇ ॥",
      "transliteration": "jan maarut bar birachh upare ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਝਖੜ ਨੇ ਵੱਡੇ ਬ੍ਰਿਛ ਪੁਟ ਕੇ ਸੁਟੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "जनु मारुत बर बिरछ उपरे ॥",
      "sourceLineId": "134972",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗਜ ਜੂਝੇ ਮਾਰੇ ਬਾਜੀ ਰਨ ॥",
      "transliteration": "gaj joojhe maare baajee ran ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਵਿਚ ਹਾਥੀ ਅਤੇ ਘੋੜੇ ਮਾਰੇ ਗਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "गज जूझे मारे बाजी रन ॥",
      "sourceLineId": "134973",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਨੁ ਕ੍ਰੀੜਾ ਸਿਵ ਕੋ ਯਹ ਹੈ ਬਨ ॥੪੦॥",
      "transliteration": "jan kreeRaa siv ko yeh hai ban ||40||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ ਕਿ ਯੁੱਧ-ਭੂਮੀ) ਮਾਨੋ ਸ਼ਿਵ ਦਾ ਕ੍ਰੀੜਾ-ਸਥਲ ਹੋਵੇ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "जनु क्रीड़ा सिव को यह है बन ॥४०॥",
      "sourceLineId": "134974",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰਨ ਐਸੋ ਅਬਲਾ ਤਿਨ ਕੀਯਾ ॥",
      "transliteration": "ran aaiso abalaa tin keeyaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਣੀ ਨੇ ਅਜਿਹਾ ਯੁੱਧ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "रन ऐसो अबला तिन कीया ॥",
      "sourceLineId": "134975",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪਾਛੇ ਭਯੋ ਨ ਆਗੇ ਹੂਆ ॥",
      "transliteration": "paachhe bhayo na aage hooaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਨਾ ਪਿਛੇ ਹੋਇਆ ਸੀ ਅਤੇ ਨਾ ਅਗੇ ਹੋਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "पाछे भयो न आगे हूआ ॥",
      "sourceLineId": "134976",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਖੰਡ ਖੰਡ ਹ੍ਵੈ ਗਿਰੀ ਧਰਨਿ ਪਰ ॥",
      "transliteration": "kha(n)dd kha(n)dd havai giree dharan par ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਟੋਟੇ ਟੋਟੇ ਹੋ ਕੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "खंड खंड ह्वै गिरी धरनि पर ॥",
      "sourceLineId": "134977",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਨ ਜੂਝੀ ਭਵਸਿੰਧੁ ਗਈ ਤਰਿ ॥੪੧॥",
      "transliteration": "ran joojhee bhavasi(n)dh giee tar ||41||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਣ ਵਿਚ ਜੂਝ ਕੇ ਸੰਸਾਰ ਸਾਗਰ ਨੂੰ ਤਰ ਗਈ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "रन जूझी भवसिंधु गई तरि ॥४१॥",
      "sourceLineId": "134978",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਖੰਡ ਖੰਡ ਬਾਜੀ ਪਰ ਭਈ ॥",
      "transliteration": "kha(n)dd kha(n)dd baajee par bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਘੋੜੇ ਉਤੇ ਹੀ ਟੋਟੇ ਟੋਟੇ ਹੋ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "खंड खंड बाजी पर भई ॥",
      "sourceLineId": "134979",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਊ ਨ ਛੋਰਿ ਅਯੋਧਨ ਗਈ ॥",
      "transliteration": "tuoo na chhor ayodhan giee ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਤਾ ਵੀ ਰਣ-ਖੇਤਰ ਨੂੰ ਛਡ ਕੇ ਨਹੀਂ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "तऊ न छोरि अयोधन गई ॥",
      "sourceLineId": "134980",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੂਤ ਪਿਸਾਚ ਗਏ ਭਖਿ ਤਾਮਾ ॥",
      "transliteration": "bhoot pisaach ge bhakh taamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਮਾਸ ('ਤਾਮਾ') ਭੂਤ ਅਤੇ ਪਿਸ਼ਾਚ ਖਾ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "भूत पिसाच गए भखि तामा ॥",
      "sourceLineId": "134981",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਾਗਿ ਮੋਰਿ ਤਊ ਭਜੀ ਨ ਬਾਮਾ ॥੪੨॥",
      "transliteration": "baag mor tuoo bhajee na baamaa ||42||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਹ (ਘੋੜੇ ਦੀ) ਲਗ਼ਾਮ ਮੋੜ ਕੇ (ਰਣ ਵਿਚੋਂ) ਨਹੀਂ ਭਜੀ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "बागि मोरि तऊ भजी न बामा ॥४२॥",
      "sourceLineId": "134982",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪ੍ਰਥਮ ਚਾਰਊ ਪੁਤ੍ਰ ਜੁਝਾਏ ॥",
      "transliteration": "pratham chaaruoo putr jujhaae ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਚਾਰ ਪੁੱਤਰ ਮਰਵਾ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "प्रथम चारऊ पुत्र जुझाए ॥",
      "sourceLineId": "134983",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਹੁਰਿ ਆਪੁ ਬੈਰੀ ਬਹੁ ਘਾਏ ॥",
      "transliteration": "bahur aap bairee bahu ghaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਆਪ ਬਹੁਤ ਵੈਰੀ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "बहुरि आपु बैरी बहु घाए ॥",
      "sourceLineId": "134984",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰਥਮ ਬਾਲ ਕੌ ਜਬੈ ਸੰਘਾਰਿਯੋ ॥",
      "transliteration": "pratham baal kau jabai sa(n)ghaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਪਹਿਲਾ ਰਾਣੀ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "प्रथम बाल कौ जबै संघारियो ॥",
      "sourceLineId": "134985",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1288_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਹ ਪਾਛੇ ਬੀਰਮ ਦੇ ਮਾਰਿਯੋ ॥੪੩॥",
      "transliteration": "teh paachhe beeram dhe maariyo ||43||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਪਿਛੋਂ ਬੀਰਮ ਦੇਵ ਨੂੰ ਮਾਰਿਆ ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1288,
      "hindi": "",
      "hindiTransliteration": "तिह पाछे बीरम दे मारियो ॥४३॥",
      "sourceLineId": "134986",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
