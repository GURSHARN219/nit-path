{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1289,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1289_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਾ ਕੋ ਮਾਰਿ ਕਾਟਿ ਸਿਰ ਲਿਯੋ ॥",
      "transliteration": "taa ko maar kaaT sir liyo ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰਮ ਦੇਵ ਨੂੰ ਮਾਰ ਕੇ ਉਸ ਦਾ ਸਿਰ ਕਟ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "ता को मारि काटि सिर लियो ॥",
      "sourceLineId": "134987",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਲੈ ਹਾਜਿਰ ਹਜਰਤਿ ਕੇ ਕਿਯੋ ॥",
      "transliteration": "lai haajir hajarat ke kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਿਆ ਕੇ ਬਾਦਸ਼ਾਹ ਦੇ ਪੇਸ਼ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "लै हाजिर हजरति के कियो ॥",
      "sourceLineId": "134988",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਬ ਪਿਤ ਪਠੈ ਸੁਤਾ ਪਹਿ ਦੀਨਾ ॥",
      "transliteration": "tab pit paThai sutaa peh dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਪਿਤਾ ਨੇ (ਉਹ ਸਿਰ) ਪੁੱਤਰੀ ਵਲ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "तब पित पठै सुता पहि दीना ॥",
      "sourceLineId": "134989",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਧਿਕ ਦੁਖਿਤ ਹ੍ਵੈ ਦਹੁਤਾ ਚੀਨਾ ॥੪੪॥",
      "transliteration": "adhik dhukhit havai dhahutaa cheenaa ||44||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰੀ (ਉਸ ਨੂੰ) ਪਛਾਣ ਕੇ ਬਹੁਤ ਦੁਖੀ ਹੋਈ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "अधिक दुखित ह्वै दहुता चीना ॥४४॥",
      "sourceLineId": "134990",
      "sourceShabadId": "12602",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "134991",
      "sourceShabadId": "12603",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਬ ਬੇਗਮ ਤਿਹ ਸ੍ਵਾਰ ਕੌ ਦੇਖਾ ਸੀਸ ਉਘਾਰਿ ॥",
      "transliteration": "jab begam teh savaiaar kau dhekhaa sees ughaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬੇਗਮ (ਬਾਦਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ) ਨੇ ਸਵਾਰ ਦੇ ਸਿਰ ਤੋਂ (ਕਪੜਾ) ਚੁਕ ਕੇ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "जब बेगम तिह स्वार कौ देखा सीस उघारि ॥",
      "sourceLineId": "134992",
      "sourceShabadId": "12603",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਲਟਿ ਪਰਾ ਤਬ ਮੂੰਡ ਨ੍ਰਿਪ ਤਉ ਨ ਕਬੂਲੀ ਨਾਰਿ ॥੪੫॥",
      "transliteration": "palaT paraa tab moo(n)dd nirap tau na kaboolee naar ||45||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਜੇ ਦਾ ਸਿਰ ਪਿਛੇ ਨੂੰ ਡਿਗ ਪਿਆ ਅਤੇ (ਅਜਿਹੀ ਅਵਸਥਾ ਵਿਚ ਵੀ) ਉਸ ਨੇ (ਮੁਸਲਮਾਣ) ਇਸਤਰੀ ਨੂੰ ਪ੍ਰਵਾਨ ਨਾ ਕੀਤਾ ॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "पलटि परा तब मूँड नृप तउ न कबूली नारि ॥४५॥",
      "sourceLineId": "134993",
      "sourceShabadId": "12603",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "134994",
      "sourceShabadId": "12604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬੇਗਮ ਸੋਕਮਾਨ ਤਬ ਹ੍ਵੈ ਕੈ ॥",
      "transliteration": "begam sokamaan tab havai kai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬਾਦਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨੇ ਗ਼ਮਗੀਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "बेगम सोकमान तब ह्वै कै ॥",
      "sourceLineId": "134995",
      "sourceShabadId": "12604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਮਧਰ ਹਨਾ ਉਦਰ ਕਰ ਲੈ ਕੈ ॥",
      "transliteration": "jamadhar hanaa udhar kar lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਹੱਥ ਵਿਚ ਜਮਧਰ ਲੈ ਕੇ ਪੇਟ ਵਿਚ ਮਾਰ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "जमधर हना उदर कर लै कै ॥",
      "sourceLineId": "134996",
      "sourceShabadId": "12604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪ੍ਰਾਨ ਮਿਤ੍ਰ ਕੇ ਲੀਨੇ ਦੀਨਾ ॥",
      "transliteration": "praan mitr ke leene dheenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗੀ ਕਿ) ਮੇਰੇ ਮਿਤਰ ਦੇ ਪ੍ਰਾਣ 'ਦੀਨ' (ਇਸਲਾਮ ਧਰਮ) ਨੇ ਲੈ ਲਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "प्रान मित्र के लीने दीना ॥",
      "sourceLineId": "134997",
      "sourceShabadId": "12604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਧ੍ਰਿਗ ਮੋ ਕੌ ਜਿਨ ਅਸ ਕ੍ਰਮ ਕੀਨਾ ॥੪੬॥",
      "transliteration": "dhirag mo kau jin as kram keenaa ||46||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਧਿੱਕਾਰ ਹੈ ਜਿਸ ਨੇ ਅਜਿਹਾ ਕੰਮ ਕੀਤਾ ਹੈ ॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "धृग मो कौ जिन अस क्रम कीना ॥४६॥",
      "sourceLineId": "134998",
      "sourceShabadId": "12604",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "134999",
      "sourceShabadId": "12605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬੀਰਮ ਦੇ ਰਾਜਾ ਨਿਮਿਤ ਬੇਗਮ ਤਜੇ ਪਰਾਨ ॥",
      "transliteration": "beeram dhe raajaa nimit begam taje paraan ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰਮ ਦੇਵ ਰਾਜੇ ਲਈ ਬਾਦਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨੇ ਪ੍ਰਾਣ ਤਿਆਗ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "बीरम दे राजा निमित बेगम तजे परान ॥",
      "sourceLineId": "135000",
      "sourceShabadId": "12605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁ ਕਬਿ ਸ੍ਯਾਮ ਯਾ ਕਥਾ ਕੋ ਤਬ ਹੀ ਭਯੋ ਨਿਦਾਨ ॥੪੭॥",
      "transliteration": "s kab sayaam yaa kathaa ko tab hee bhayo nidhaan ||47||",
      "translation": "",
      "punjabiViakhya": "ਕਵੀ ਸ਼ਿਆਮ ਕਹਿੰਦੇ ਹਨ, ਤਦ ਹੀ ਇਸ ਕਥਾ ਦਾ ਅੰਤ ਹੋ ਗਿਆ ॥੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "सु कबि स्याम या कथा को तब ही भयो निदान ॥४७॥",
      "sourceLineId": "135001",
      "sourceShabadId": "12605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪੈਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੫॥੬੨੯੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau paitees charitr samaapatam sat subham sat ||335||6295||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੩੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੩੫॥੬੨੯੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ पैतीस चरित्र समापतम सतु सुभम सतु ॥३३५॥६२९५॥अफजूँ॥",
      "sourceLineId": "135002",
      "sourceShabadId": "12605",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135003",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਾਜ ਸੈਨ ਇਕ ਸੁਨਾ ਨ੍ਰਿਪਤਿ ਬਰ ॥",
      "transliteration": "raaj sain ik sunaa nirapat bar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "राज सैन इक सुना नृपति बर ॥",
      "sourceLineId": "135004",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਜ ਦੇਇ ਰਾਨੀ ਤਾ ਕੇ ਘਰ ॥",
      "transliteration": "raaj dhei raanee taa ke ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਰਾਜ ਦੇਈ ਨਾ ਦੀ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "राज देइ रानी ता के घर ॥",
      "sourceLineId": "135005",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰੰਗਝੜ ਦੇ ਦੁਹਿਤਾ ਤਹ ਸੋਹੈ ॥",
      "transliteration": "ra(n)gajhaR dhe dhuhitaa teh sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਘਰ ਰੰਗਝੜ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਪੁੱਤਰੀ ਸ਼ੋਭਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "रंगझड़ दे दुहिता तह सोहै ॥",
      "sourceLineId": "135006",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੁਰ ਨਰ ਨਾਗ ਅਸੁਰ ਮਨ ਮੋਹੈ ॥੧॥",
      "transliteration": "sur nar naag asur man mohai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦੇਵਤਿਆਂ, ਨਰਾ, ਨਾਗਾ ਅਤੇ ਦੈਂਤਾ ਦਾ ਮਨ ਮੋਹ ਲੈਂਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "सुर नर नाग असुर मन मोहै ॥१॥",
      "sourceLineId": "135007",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਢਤ ਬਢਤ ਅਬਲਾ ਜਬ ਬਢੀ ॥",
      "transliteration": "baddat baddat abalaa jab baddee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬਾਲਿਕਾ ਵੱਧਦੀ ਵੱਧਦੀ ਜਵਾਨ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "बढत बढत अबला जब बढी ॥",
      "sourceLineId": "135008",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਦਨ ਸੁ ਨਾਰ ਆਪੁ ਜਨੁ ਗਢੀ ॥",
      "transliteration": "madhan su naar aap jan gaddee ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਇੰਜ ਪ੍ਰਤੀਤ ਹੋਣ ਲਗਾ) ਮਾਨੋ ਕਾਮ ਦੇਵ ਨੇ ਆਪ ਇਹ ਇਸਤਰੀ ਬਣਾਈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "मदन सु नार आपु जनु गढी ॥",
      "sourceLineId": "135009",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਚਰਚਾ ਭਈ ਜੋਈ ॥",
      "transliteration": "maat pitaa charachaa bhiee joiee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਉਹ ਮਾਤਾ ਪਿਤਾ ਦੀ ਚਰਚਾ ਦਾ ਕਾਰਨ ਬਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "मात पिता चरचा भई जोई ॥",
      "sourceLineId": "135010",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰਚੁਰ ਭਈ ਜਗ ਭੀਤਰਿ ਸੋਈ ॥੨॥",
      "transliteration": "prachur bhiee jag bheetar soiee ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਸਾਰੇ ਜਗਤ ਵਿਚ (ਸੁੰਦਰਤਾ ਕਰ ਕੇ) ਪ੍ਰਸਿੱਧ ਹੋ ਗਈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "प्रचुर भई जग भीतरि सोई ॥२॥",
      "sourceLineId": "135011",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਾਤੈ ਕਹੀ ਸੁਤਾ ਕੇ ਸੰਗਾ ॥",
      "transliteration": "maatai kahee sutaa ke sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾ ਨੇ ਪੁੱਤਰੀ ਨੂੰ (ਇਕ ਦਿਨ) ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "मातै कही सुता के संगा ॥",
      "sourceLineId": "135012",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚੰਚਲਤਾ ਜਿਨ ਕਰੁ ਸੁੰਦ੍ਰੰਗਾ ॥",
      "transliteration": "cha(n)chalataa jin kar su(n)dhra(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸੁੰਦਰ ਅੰਗਾ ਵਾਲੀਏ! ਚੰਚਲਤਾ ਨਾ ਕਰ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "चंचलता जिन करु सुँद्रंगा ॥",
      "sourceLineId": "135013",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਹਾ ਬਿਸੇਸ ਧੁਜਹਿ ਤੂ ਬਰਿ ਹੈ ॥",
      "transliteration": "kahaa bises dhujeh too bar hai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਕਿਹਾ, ਕਿ ਤੂੰ ਬਿਸੇਸ ਧੁਜ ਨਾਲ ਵਿਆਹ ਕਰ ਲੈ",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "कहा बिसेस धुजहि तू बरि है ॥",
      "sourceLineId": "135014",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾ ਕੋ ਜੀਤਿ ਦਾਸ ਲੈ ਕਰਿ ਹੈ ॥੩॥",
      "transliteration": "taa ko jeet dhaas lai kar hai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਜਿਤ ਕੇ ਆਪਣਾ ਦਾਸ ਬਣਾ ਲੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "ता को जीति दास लै करि है ॥३॥",
      "sourceLineId": "135015",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁਨਤ ਬਾਤ ਤਾ ਕਹ ਲਗਿ ਗਈ ॥",
      "transliteration": "sunat baat taa keh lag giee ||",
      "translation": "",
      "punjabiViakhya": "ਮਾ ਦੀ ਗੱਲ ਸੁਣ ਕੇ (ਉਸ ਦੇ ਦਿਲ) ਨੂੰ ਲਗ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "सुनत बात ता कह लगि गई ॥",
      "sourceLineId": "135016",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਖੀ ਗੂੜ ਨ ਭਾਖਤ ਭਈ ॥",
      "transliteration": "raakhee gooR na bhaakhat bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਗੁਪਤ ਹੀ ਰਖੀ (ਅਤੇ ਕਿਸੇ ਨੂੰ) ਨਾ ਦਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "राखी गूड़ न भाखत भई ॥",
      "sourceLineId": "135017",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਬ ਅਬਲਾ ਨਿਸਿ ਕੌ ਘਰ ਆਈ ॥",
      "transliteration": "jab abalaa nis kau ghar aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਅਬਲਾ ਰਾਤ ਵੇਲੇ ਘਰ ਆਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "जब अबला निसि कौ घर आई ॥",
      "sourceLineId": "135018",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚਲੀ ਤਹਾ ਨਰ ਭੇਸ ਬਨਾਈ ॥੪॥",
      "transliteration": "chalee tahaa nar bhes banaiee ||4||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਮਰਦਾਵੇਾਂ ਬਸਤ੍ਰ ਪਾ ਕੇ ਉਥੋਂ ਚਲ ਪਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "चली तहा नर भेस बनाई ॥४॥",
      "sourceLineId": "135019",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚਲਤ ਚਲਤ ਬਹੁ ਚਿਰ ਤਹ ਗਈ ॥",
      "transliteration": "chalat chalat bahu chir teh giee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਚਿਰ ਤਕ ਚਲਦਿਆਂ ਚਲਦਿਆਂ ਉਥੇ ਜਾ ਪਹੁੰਚੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "चलत चलत बहु चिर तह गई ॥",
      "sourceLineId": "135020",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਹਾ ਬਿਲਾਸਵਤੀ ਨਗਰਈ ॥",
      "transliteration": "jahaa bilaasavatee nagariee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਬਿਲਾਸਵਤੀ ਨਗਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "जहा बिलासवती नगरई ॥",
      "sourceLineId": "135021",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਵਨ ਨਗਰ ਚਲਿ ਜੂਪ ਮਚਾਯੋ ॥",
      "transliteration": "tavan nagar chal joop machaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਜਾ ਕੇ ਉਸ ਨੇ ਜੂਆ (ਖੇਡਣ ਦੀ) ਧੁੰਮ ਮਚਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "तवन नगर चलि जूप मचायो ॥",
      "sourceLineId": "135022",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਊਚ ਨੀਚ ਸਭ ਹੀ ਨਹਰਾਯੋ ॥੫॥",
      "transliteration": "uooch neech sabh hee naharaayo ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉੱਚੇ ਨੀਵੇਾਂ ਸਭ ਨੂੰ ਝੁਕਾ ਦਿੱਤਾ (ਅਰਥਾਤ ਹਰਾ ਦਿੱਤਾ) ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच सभ ही नहरायो ॥५॥",
      "sourceLineId": "135023",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਡੇ ਬਡੇ ਜੂਪੀ ਜਬ ਹਾਰੇ ॥",
      "transliteration": "badde badde joopee jab haare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਵੱਡੇ ਵੱਡੇ ਜੁਆਰੀਏ ਹਾਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "बडे बडे जूपी जब हारे ॥",
      "sourceLineId": "135024",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਿਲਿ ਰਾਜਾ ਕੇ ਤੀਰ ਪੁਕਾਰੇ ॥",
      "transliteration": "mil raajaa ke teer pukaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਾਰਿਆਂ ਨੇ ਮਿਲ ਕੇ ਰਾਜੇ ਅਗੇ ਪੁਕਾਰ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "मिलि राजा के तीर पुकारे ॥",
      "sourceLineId": "135025",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਇਕ ਹ੍ਯਾਂ ਐਸ ਜੁਆਰੀ ਆਯੋ ॥",
      "transliteration": "eik hayaa(n) aais juaaree aayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਥੇ ਇਕ ਅਜਿਹਾ ਜੁਆਰੀਆ ਆਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "इक ह्याँ ऐस जुआरी आयो ॥",
      "sourceLineId": "135026",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਿਸੂ ਪਾਸ ਨਹਿ ਜਾਤ ਹਰਾਯੋ ॥੬॥",
      "transliteration": "kisoo paas neh jaat haraayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕਿਸੇ ਕੋਲੋਂ ਹਰਾਇਆ ਨਹੀਂ ਜਾ ਸਕਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "किसू पास नहि जात हरायो ॥६॥",
      "sourceLineId": "135027",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸੁਨੇ ਬਚਨ ਜਬ ਰਾਜਾ ॥",
      "transliteration": "eeh bidh sune bachan jab raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਬੋਲ ਸੁਣੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "इह बिधि सुने बचन जब राजा ॥",
      "sourceLineId": "135028",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਪਨ ਸਜਿਯੋ ਜੂਪ ਕੋ ਸਾਜਾ ॥",
      "transliteration": "aapan sajiyo joop ko saajaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਆਪ ਜੂਆ ਖੇਡਣ ਦੀ ਵਿਵਸਥਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "आपन सजियो जूप को साजा ॥",
      "sourceLineId": "135029",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਹਿਯੋ ਤਾਹਿ ਹ੍ਯਾਂ ਲੇਹੁ ਬੁਲਾਇ ॥",
      "transliteration": "kahiyo taeh hayaa(n) leh bulai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਕਿਹਾ, ਉਸ ਨੂੰ ਇਥੇ ਬੁਲਾ ਲੌ,",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "कहियो ताहि ह्याँ लेहु बुलाइ ॥",
      "sourceLineId": "135030",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਿਨ ਜੂਪੀ ਸਭ ਲਏ ਹਰਾਇ ॥੭॥",
      "transliteration": "jin joopee sabh le harai ||7||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਸਾਰਿਆਂ ਜੁਆਰੀਆਂ ਨੂੰ ਹਰਾ ਦਿੱਤਾ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "जिन जूपी सभ लए हराइ ॥७॥",
      "sourceLineId": "135031",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭ੍ਰਿਤ ਸੁਨਿ ਬਚਨ ਪਹੂੰਚੇ ਤਹਾ ॥",
      "transliteration": "bhirat sun bachan pahoo(n)che tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੇਵਕ (ਰਾਜੇ ਦੇ) ਬੋਲ ਸੁਣ ਕੇ ਉਥੇ ਪਹੁੰਚੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "भृत सुनि बचन पहूँचे तहा ॥",
      "sourceLineId": "135032",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੂਪਿਨ ਕੁਅਰਿ ਹਰਾਵਤ ਜਹਾ ॥",
      "transliteration": "joopin kuar haraavat jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਜੁਆਰੀਆਂ ਨੂੰ ਕੁਮਾਰੀ ਹਰਾ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "जूपिन कुअरि हरावत जहा ॥",
      "sourceLineId": "135033",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1289_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਹਿਯੋ ਤਾਹਿ ਤੁਹਿ ਰਾਇ ਬੁਲਾਯੋ ॥",
      "transliteration": "kahiyo taeh tuh rai bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿਣ ਲਗੇ ਕਿ ਤੈਨੂੰ ਰਾਜੇ ਨੇ ਬੁਲਾਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1289,
      "hindi": "",
      "hindiTransliteration": "कहियो ताहि तुहि राइ बुलायो ॥",
      "sourceLineId": "135034",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
