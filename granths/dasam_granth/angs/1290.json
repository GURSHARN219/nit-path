{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1290,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1290_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਾਹਤ ਤੁਮ ਸੌ ਜੂਪ ਮਚਾਯੋ ॥੮॥",
      "transliteration": "chaahat tum sau joop machaayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਾਹੁੰਦਾ ਹੈ ਕਿ ਤੇਰੇ ਨਾਲ ਜੂਆ ਖੇਡੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "चाहत तुम सौ जूप मचायो ॥८॥",
      "sourceLineId": "135035",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੇ ਤੀਰ ਤਰੁਨਿ ਤਬ ਗਈ ॥",
      "transliteration": "nirap ke teer tarun tab giee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕੁਮਾਰੀ ਰਾਜੇ ਕੋਲ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "नृप के तीर तरुनि तब गई ॥",
      "sourceLineId": "135036",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਜੂਪ ਮਚਾਵਤ ਭਈ ॥",
      "transliteration": "bahu bidh joop machaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਜੂਆ ਖੇਡਣਾ ਸ਼ੁਰੂ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि जूप मचावत भई ॥",
      "sourceLineId": "135037",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਧਿਕ ਦਰਬ ਤਿਨ ਭੂਪ ਹਰਾਯੋ ॥",
      "transliteration": "adhik dharab tin bhoop haraayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਜੇ ਨੇ ਇਤਨਾ ਧਨ ਹਰਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "अधिक दरब तिन भूप हरायो ॥",
      "sourceLineId": "135038",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਤੇ ਨਹਿ ਜਾਤ ਗਨਾਯੋ ॥੯॥",
      "transliteration": "brahamaa te neh jaat ganaayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਬ੍ਰਹਮਾ ਕੋਲੋਂ ਵੀ ਗਿਣਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ ਸੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "ब्रहमा ते नहि जात गनायो ॥९॥",
      "sourceLineId": "135039",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਬ ਨ੍ਰਿਪ ਦਰਬ ਬਹੁਤ ਬਿਧਿ ਹਾਰਾ ॥",
      "transliteration": "jab nirap dharab bahut bidh haaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਧਨ ਹਾਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "जब नृप दरब बहुत बिधि हारा ॥",
      "sourceLineId": "135040",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਤ ਊਪਰ ਪਾਸਾ ਤਬ ਢਾਰਾ ॥",
      "transliteration": "sut uoopar paasaa tab ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਸ ਨੇ ਆਪਣਾ) ਪੁੱਤਰ ਦਾਓ ਉਤੇ ਲਗਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "सुत ऊपर पासा तब ढारा ॥",
      "sourceLineId": "135041",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਵਹੈ ਹਰਾਯੋ ਦੇਸ ਲਗਾਯੋ ॥",
      "transliteration": "vahai haraayo dhes lagaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਪੁੱਤਰ ਵੀ ਹਾਰ ਗਿਆ, ਤਾ (ਦਾਓ ਉਤੇ) ਦੇਸ਼ ਲਗਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "वहै हरायो देस लगायो ॥",
      "sourceLineId": "135042",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੀਤਾ ਕੁਅਰ ਭਜ੍ਯੋ ਮਨ ਭਾਯੋ ॥੧੦॥",
      "transliteration": "jeetaa kuar bhajayo man bhaayo ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਕੁੰਵਰ ਨੂੰ ਜਿਤ ਲਿਆ ਅਤੇ (ਉਸ ਨਾਲ) ਮਨ ਚਾਹਿਆ ਸੰਯੋਗ ਕੀਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "जीता कुअर भज्यो मन भायो ॥१०॥",
      "sourceLineId": "135043",
      "sourceShabadId": "12606",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "135044",
      "sourceShabadId": "12607",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੀਤਿ ਸਕਲ ਧਨ ਤਵਨ ਕੋ ਦੀਨਾ ਦੇਸ ਨਿਕਾਰ ॥",
      "transliteration": "jeet sakal dhan tavan ko dheenaa dhes nikaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਰਾਜੇ) ਦਾ ਸਾਰਾ ਧਨ ਜਿਤ ਕੇ ਦੇਸੋਂ ਕਢ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "जीति सकल धन तवन को दीना देस निकार ॥",
      "sourceLineId": "135045",
      "sourceShabadId": "12607",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕੁਅਰ ਜੀਤਿ ਕਰਿ ਪਤਿ ਕਰਾ ਬਸੀ ਧਾਮ ਹ੍ਵੈ ਨਾਰ ॥੧੧॥",
      "transliteration": "kuar jeet kar pat karaa basee dhaam havai naar ||11||",
      "translation": "",
      "punjabiViakhya": "ਕੁੰਵਰ ਨੂੰ ਜਿਤ ਕੇ ਪਤੀ ਬਣਾਇਆ ਅਤੇ (ਉਸ ਦੇ) ਘਰ ਪਤਨੀ ਹੋ ਕੇ ਵਸ ਗਈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "कुअर जीति करि पति करा बसी धाम ह्वै नार ॥११॥",
      "sourceLineId": "135046",
      "sourceShabadId": "12607",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੰਚਲਾਨ ਕੇ ਚਰਿਤ ਕੋ ਸਕਤ ਨ ਕੋਈ ਬਿਚਾਰ ॥",
      "transliteration": "cha(n)chalaan ke charit ko sakat na koiee bichaar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਦੇ ਚਰਿਤ੍ਰ ਨੂੰ ਕੋਈ ਵੀ ਵਿਚਾਰ ਨਹੀਂ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "चंचलान के चरित को सकत न कोई बिचार ॥",
      "sourceLineId": "135047",
      "sourceShabadId": "12607",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬ੍ਰਹਮ ਬਿਸਨ ਸਿਵ ਖਟ ਬਦਨ ਜਿਨ ਸਿਰਜੀ ਕਰਤਾਰ ॥੧੨॥",
      "transliteration": "braham bisan siv khaT badhan jin sirajee karataar ||12||",
      "translation": "",
      "punjabiViakhya": "ਭਾਵੇਾਂ ਬ੍ਰਹਮਾ, ਵਿਸ਼ਣੂ, ਸ਼ਿਵ ਅਤੇ ਕਾਰਤਿਕੇਯ ਅਤੇ ਕਰਤਾਰ (ਵੀ ਕਿਉਾਂ ਨਾ ਹੋਵੇ) ਜਿਸ ਨੇ ਖ਼ੁਦ ਇਸ ਨੂੰ ਸਿਰਜਿਆ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "ब्रहम बिसन सिव खट बदन जिन सिरजी करतार ॥१२॥",
      "sourceLineId": "135048",
      "sourceShabadId": "12607",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੬॥੬੩੦੭॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chhatees charitr samaapatam sat subham sat ||336||6307||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋ ਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੩੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੩੬॥੬੩੦੭॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ छतीस चरित्र समापतम सतु सुभम सतु ॥३३६॥६३०७॥अफजूँ॥",
      "sourceLineId": "135049",
      "sourceShabadId": "12607",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135050",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਮਲ ਸੈਨ ਰਾਜਾ ਬਲਵਾਨਾ ॥",
      "transliteration": "jamal sain raajaa balavaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਮਲ ਸੈਨ ਨਾ ਦਾ ਇਕ ਬਲਵਾਨ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "जमल सैन राजा बलवाना ॥",
      "sourceLineId": "135051",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤੀਨ ਲੋਕ ਮਾਨਤ ਜਿਹ ਆਨਾ ॥",
      "transliteration": "teen lok maanat jeh aanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਤਿੰਨੋ ਲੋਕ ਅਧੀਨਗੀ ਸਵੀਕਾਰ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "तीन लोक मानत जिह आना ॥",
      "sourceLineId": "135052",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਮਲਾ ਟੋਡੀ ਕੋ ਨਰਪਾਲਾ ॥",
      "transliteration": "jamalaa Toddee ko narapaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਜਮਲਾ ਟੋਡੀ ਦਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "जमला टोडी को नरपाला ॥",
      "sourceLineId": "135053",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੂਰਬੀਰ ਅਰੁ ਬੁਧਿ ਬਿਸਾਲਾ ॥੧॥",
      "transliteration": "soorabeer ar budh bisaalaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸ਼ੂਰਵੀਰ ਤੇ ਵਿਸ਼ਾਲ ਬੁੱਧੀ ਦਾ ਸੁਆਮੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "सूरबीर अरु बुधि बिसाला ॥१॥",
      "sourceLineId": "135054",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੋਰਠ ਦੇ ਰਾਨੀ ਤਿਹ ਸੁਨਿਯਤ ॥",
      "transliteration": "soraTh dhe raanee teh suniyat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਰਾਣੀ ਸੋਰਠ ਦੇ (ਦੇਈ) ਸੁਣੀਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "सोरठ दे रानी तिह सुनियत ॥",
      "sourceLineId": "135055",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦਾਨ ਸੀਲ ਜਾ ਕੋ ਜਗ ਗੁਨਿਯਤ ॥",
      "transliteration": "dhaan seel jaa ko jag guniyat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਸੰਸਾਰ ਵਾਲੇ ਦਾਨੀ ਅਤੇ ਸ਼ੀਲਵਾਨ ਮੰਨਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "दान सील जा को जग गुनियत ॥",
      "sourceLineId": "135056",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਰਜ ਮਤੀ ਦੁਹਿਤਾ ਇਕ ਤਾ ਕੀ ॥",
      "transliteration": "paraj matee dhuhitaa ik taa kee ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਜ ਮਤੀ ਨਾ ਦੀ ਉਸ ਦੀ ਇਕ ਪੁੱਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "परज मती दुहिता इक ता की ॥",
      "sourceLineId": "135057",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਰੀ ਨਾਗਨੀ ਸਮ ਨਹਿ ਜਾ ਕੀ ॥੨॥",
      "transliteration": "naree naaganee sam neh jaa kee ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸਮਾਨ ਨਰੀ ਜਾ ਨਾਗਨੀ (ਕੋਈ ਵੀ) ਨਹੀਂ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "नरी नागनी सम नहि जा की ॥२॥",
      "sourceLineId": "135058",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਿਸਹਰ ਕੋ ਇਕ ਹੁਤੋ ਨ੍ਰਿਪਾਲਾ ॥",
      "transliteration": "bisahar ko ik huto nirapaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਸਹਰ (ਸ਼ਹਿਰ) ਦਾ ਇਕ ਰਾਜਾ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "बिसहर को इक हुतो नृपाला ॥",
      "sourceLineId": "135059",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਯੋ ਗੜ ਜਮਲਾ ਕਿਹ ਕਾਲਾ ॥",
      "transliteration": "aayo gaR jamalaa keh kaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਕਿਸੇ ਸਮੇਾਂ ਜਮਲਾ ਗੜ੍ਰਹ ਵਿਚ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "आयो गड़ जमला किह काला ॥",
      "sourceLineId": "135060",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਛਾਛ ਕਾਮਨੀ ਕੀ ਪੂਜਾ ਹਿਤ ॥",
      "transliteration": "chhaachh kaamanee kee poojaa hit ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਛਾਛ ਕਾਮਨੀ (ਸੀਤਲਾ ਦੇਵੀ) ਦੀ ਪੂਜਾ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "छाछ कामनी की पूजा हित ॥",
      "sourceLineId": "135061",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਨ ਕ੍ਰਮ ਬਚਨ ਇਹੈ ਕਰਿ ਕਰਿ ਬ੍ਰਤ ॥੩॥",
      "transliteration": "man kram bachan ihai kar kar brat ||3||",
      "translation": "",
      "punjabiViakhya": "ਮਨ, ਬਚਨ ਅਤੇ ਕਰਮ ਕਰ ਕੇ ਬ੍ਰਤ ਧਾਰ ਕੇ (ਆਇਆ ਸੀ) ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "मन क्रम बचन इहै करि करि ब्रत ॥३॥",
      "sourceLineId": "135062",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਠਾਢਿ ਪਰਜ ਦੇ ਨੀਕ ਨਿਵਾਸਨ ॥",
      "transliteration": "Thaadd paraj dhe neek nivaasan ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਜ ਦੇਈ (ਆਪਣੇ) ਸੁੰਦਰ ਨਿਵਾਸ ਵਿਚ ਖੜੋਤੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "ठाढि परज दे नीक निवासन ॥",
      "sourceLineId": "135063",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਨਿਰਖਾ ਦੁਖ ਨਾਸਨ ॥",
      "transliteration": "raaj kuar nirakhaa dhukh naasan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦੁਖ ਨੂੰ ਦੂਰ ਕਰਨ ਵਾਲੇ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "राज कुअर निरखा दुख नासन ॥",
      "sourceLineId": "135064",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਹੈ ਚਿਤ ਮੈ ਕੀਅਸਿ ਬਿਚਾਰਾ ॥",
      "transliteration": "eihai chit mai keeas bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਮਨ ਵਿਚ ਇਹੀ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "इहै चित मै कीअसि बिचारा ॥",
      "sourceLineId": "135065",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਰੌ ਯਾਹਿ ਕਰਿ ਕਵਨ ਪ੍ਰਕਾਰਾ ॥੪॥",
      "transliteration": "barau yaeh kar kavan prakaaraa ||4||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਕਿਸੇ ਤਰ੍ਰਹਾ ਨਾਲ ਇਸ ਨਾਲ ਵਿਆਹ ਕਰਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "बरौ याहि करि कवन प्रकारा ॥४॥",
      "sourceLineId": "135066",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਖੀ ਭੇਜਿ ਤਿਹ ਧਾਮ ਬੁਲਾਯੋ ॥",
      "transliteration": "sakhee bhej teh dhaam bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀ ਨੂੰ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਘਰ ਬੁਲਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "सखी भेजि तिह धाम बुलायो ॥",
      "sourceLineId": "135067",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੋ ਭੋਗ ਕਮਾਯੋ ॥",
      "transliteration": "bhaat bhaat ko bhog kamaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਭਾਤ ਭਾਤ ਦਾ ਰਮਣ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "भाति भाति को भोग कमायो ॥",
      "sourceLineId": "135068",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਹ ਉਪਦੇਸ ਤਵਨ ਕਹ ਦਯੋ ॥",
      "transliteration": "eeh upadhes tavan keh dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਇਹ ਗੱਲ (ਭੇਦ ਭਰੇ ਢੰਗ ਨਾਲ) ਸਮਝਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "इह उपदेस तवन कह दयो ॥",
      "sourceLineId": "135069",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੌਰਿ ਪੁਜਾਇ ਬਿਦਾ ਕਰ ਗਯੋ ॥੫॥",
      "transliteration": "gauar pujai bidhaa kar gayo ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗੌਰੀ ਦੀ ਪੂਜਾ ਕਰਵਾ ਕੇ ਘਰ ਭੇਜ ਦਿੱਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "गौरि पुजाइ बिदा कर गयो ॥५॥",
      "sourceLineId": "135070",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਿਦਾ ਕੀਆ ਤਿਹ ਐਸ ਸਿਖਾਇ ॥",
      "transliteration": "bidhaa keeaa teh aais sikhai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਸਿਖਾ ਕੇ ਵਿਦਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "बिदा कीआ तिह ऐस सिखाइ ॥",
      "sourceLineId": "135071",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਪੁ ਨ੍ਰਿਪਤਿ ਸੋ ਕਹੀ ਜਤਾਇ ॥",
      "transliteration": "aap nirapat so kahee jatai ||",
      "translation": "",
      "punjabiViakhya": "ਆਪ ਰਾਜੇ ਨੂੰ ਜਤਾ ਕੇ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "आपु नृपति सो कही जताइ ॥",
      "sourceLineId": "135072",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਨੀਕਰਨ ਤੀਰਥ ਮੈ ਜੈ ਹੌ ॥",
      "transliteration": "maneekaran teerath mai jai hau ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੈਂ ਮਨੀਕਰਨ ਤੀਰਥ ਉਤੇ ਜਾ ਰਹੀ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "मनीकरन तीरथ मै जै हौ ॥",
      "sourceLineId": "135073",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾਇ ਧੋਇ ਜਮਲਾ ਫਿਰਿ ਐ ਹੌ ॥੬॥",
      "transliteration": "nai dhoi jamalaa fir aai hau ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ਼ਨਾਨ ਕਰ ਕੇ ਫਿਰ ਜਮਲਾ ਗੜ੍ਰਹ ਆ ਜਾਵਾਗੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "नाइ धोइ जमला फिरि ऐ हौ ॥६॥",
      "sourceLineId": "135074",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਾਤ ਤੀਰਥ ਜਾਤ੍ਰਾ ਕਹ ਭਈ ॥",
      "transliteration": "jaat teerath jaatraa keh bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਗਈ ਤਾ ਤੀਰਥ ਯਾਤ੍ਰਾ ਉਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "जात तीरथ जात्रा कह भई ॥",
      "sourceLineId": "135075",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਹਿਰ ਬੇਸਹਿਰ ਮੋ ਚਲਿ ਗਈ ॥",
      "transliteration": "sahir besahir mo chal giee ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਬੇਸਹਿਰ ਨਗਰ ਵਿਚ ਜਾ ਪਹੁੰਚੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "सहिर बेसहिर मो चलि गई ॥",
      "sourceLineId": "135076",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹੋਤ ਤਵਨ ਸੌ ਭੇਦ ਜਤਾਯੋ ॥",
      "transliteration": "hot tavan sau bhedh jataayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਉਸ ਨੂੰ ਸਾਰਾ ਭੇਦ ਦਸਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "होत तवन सौ भेद जतायो ॥",
      "sourceLineId": "135077",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮਨ ਮਾਨਤ ਕੇ ਭੋਗ ਕਮਾਯੋ ॥੭॥",
      "transliteration": "man maanat ke bhog kamaayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਨ ਭਾਉਾਂਦਾ ਰਮਣ ਕੀਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "मन मानत के भोग कमायो ॥७॥",
      "sourceLineId": "135078",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਕਰਿ ਕੈ ਘਰ ਰਾਖੀ ॥",
      "transliteration": "kaam bhog kar kai ghar raakhee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਰਾਜੇ ਨੇ) ਉਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ ਘਰ ਵਿਚ ਹੀ ਰਖ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "काम भोग करि कै घर राखी ॥",
      "sourceLineId": "135079",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰਛਪਾਲਕਨ ਸੋ ਅਸ ਭਾਖੀ ॥",
      "transliteration": "rachhapaalakan so as bhaakhee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਹਿਰੇਦਾਰਾ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "रछपालकन सो अस भाखी ॥",
      "sourceLineId": "135080",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬੇਗਿ ਨਗਰ ਤੇ ਇਨੈ ਨਿਕਾਰਹੁ ॥",
      "transliteration": "beg nagar te inai nikaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਨ੍ਰਹਾ (ਇਸ ਦੇ ਸਾਥੀਆਂ) ਨੂੰ ਤੁਰਤ ਨਗਰ ਵਿਚੋਂ ਕਢ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "बेगि नगर ते इनै निकारहु ॥",
      "sourceLineId": "135081",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1290_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹਾਥ ਉਠਾਵੈ ਤਿਹ ਹਨਿ ਮਾਰਹੁ ॥੮॥",
      "transliteration": "haath uThaavai teh han maarahu ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੋ ਹੱਥ ਚੁਕੇ, ਉਸ ਨੂੰ ਮਾਰ ਮੁਕਾਓ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1290,
      "hindi": "",
      "hindiTransliteration": "हाथ उठावै तिह हनि मारहु ॥८॥",
      "sourceLineId": "135082",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
