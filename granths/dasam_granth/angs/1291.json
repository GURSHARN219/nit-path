{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1291,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1291_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੋ ਤਰੁਨੀ ਤਿਹ ਰਸ ਰਸਿ ਗਈ ॥",
      "transliteration": "so tarunee teh ras ras giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਕੁਮਾਰੀ ਉਸ ਦੇ ਪ੍ਰੇਮ ਵਿਚ ਮਗਨ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "सो तरुनी तिह रस रसि गई ॥",
      "sourceLineId": "135083",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਾਢਿ ਸਮਿਗ੍ਰੀ ਸਿਗਰੀ ਦਈ ॥",
      "transliteration": "kaadd samigree sigaree dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਘਰੋਂ ਲਿਆਂਦੀ) ਸਾਰੀ ਸਾਮਗ੍ਰੀ ਕਢ ਕੇ ਦੇ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "काढि समिग्री सिगरी दई ॥",
      "sourceLineId": "135084",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਇਹ ਛਲ ਸਾਥ ਲਹਾ ਮਨ ਭਾਵਨ ॥",
      "transliteration": "eeh chhal saath lahaa man bhaavan ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ (ਉਸ ਨੇ) ਮਨ ਭਾਉਾਂਦਾ (ਪਤੀ) ਪ੍ਰਾਪਤ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "इह छल साथ लहा मन भावन ॥",
      "sourceLineId": "135085",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਕਾ ਚੀਨ ਕੋਊ ਪੁਰਖ ਉਪਾਵਨ ॥੯॥",
      "transliteration": "sakaa cheen kouoo purakh upaavan ||9||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਪੁਰਸ਼ ਵੀ (ਉਸ ਦੇ) ਚਰਿਤ੍ਰ ('ਉਪਾਵ') ਨੂੰ ਨਾ ਸਮਝ ਸਕਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "सका चीन कोऊ पुरख उपावन ॥९॥",
      "sourceLineId": "135086",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਾਢਿ ਦਏ ਸਭ ਹੀ ਰਖਵਾਰੇ ॥",
      "transliteration": "kaadd dhe sabh hee rakhavaare ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਰਖਵਾਲਿਆਂ ਨੂੰ ਕਢ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "काढि दए सभ ही रखवारे ॥",
      "sourceLineId": "135087",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲੋਹ ਕਰਾ ਜਿਨ ਤੇ ਹਨਿ ਡਾਰੇ ॥",
      "transliteration": "loh karaa jin te han ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ ਹਥਿਆਰ ਚੁਕੇ, ਉਨ੍ਰਹਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "लोह करा जिन ते हनि डारे ॥",
      "sourceLineId": "135088",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਮਲੇਸ੍ਵਰ ਨ੍ਰਿਪ ਸੌ ਯੌ ਭਾਖੀ ॥",
      "transliteration": "jamalesavair nirap sau yau bhaakhee ||",
      "translation": "",
      "punjabiViakhya": "ਜਮਲਾ ਗੜ ਦੇ ਰਾਜੇ ਨੂੰ ਇਹ ਅਖਵਾ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "जमलेस्वर नृप सौ यौ भाखी ॥",
      "sourceLineId": "135089",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੁਮਰੀ ਛੀਨਿ ਸੁਤਾ ਨ੍ਰਿਪ ਰਾਖੀ ॥੧੦॥",
      "transliteration": "tumaree chheen sutaa nirap raakhee ||10||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੁਹਾਡੀ ਪੁੱਤਰੀ ਨੂੰ (ਬੇਸਹਿਰ) ਦੇ ਰਾਜੇ ਨੇ ਖੋਹ ਕੇ ਰਖ ਲਿਆ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "तुमरी छीनि सुता नृप राखी ॥१०॥",
      "sourceLineId": "135090",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬੇਸਹਰਾ ਪਰ ਕਛੁ ਨ ਬਸਾਯੋ ॥",
      "transliteration": "besaharaa par kachh na basaayo ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਸਹਰਾ (ਦੇ ਰਾਜੇ) ਉਤੇ (ਜਮਲਾ ਗੜ੍ਰਹ ਦੇ ਰਾਜੇ ਦਾ) ਕੁਝ ਵਸ ਨਹੀਂ ਚਲਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "बेसहरा पर कछु न बसायो ॥",
      "sourceLineId": "135091",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁਨਤ ਬਾਤ ਨ੍ਰਿਪ ਮੂੰਡ ਢੁਰਾਯੋ ॥",
      "transliteration": "sunat baat nirap moo(n)dd dduraayo ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ ਇਹ) ਗੱਲ ਸੁਣ ਕੇ ਰਾਜੇ ਨੇ ਸਿਰ ਹਿਲਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "सुनत बात नृप मूँड ढुरायो ॥",
      "sourceLineId": "135092",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਹ ਛਲ ਬਰਾ ਕੁਅਰਿ ਵਹੁ ਰਾਜਾ ॥",
      "transliteration": "eeh chhal baraa kuar vahu raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਸ ਰਾਜੇ ਨਾਲ ਵਿਆਹ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "इह छल बरा कुअरि वहु राजा ॥",
      "sourceLineId": "135093",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਾਇ ਰਹਾ ਮੁਖ ਸਕਲ ਸਮਾਜਾ ॥੧੧॥",
      "transliteration": "bai rahaa mukh sakal samaajaa ||11||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਾ ਸਮਾਜ ਮੂੰਹ ਅੱਡੀ ਰਹਿ ਗਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "बाइ रहा मुख सकल समाजा ॥११॥",
      "sourceLineId": "135094",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸੈਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੭॥੬੩੧੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau saitees charitr samaapatam sat subham sat ||337||6318||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੩੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੩੭॥੬੩੧੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ सैतीस चरित्र समापतम सतु सुभम सतु ॥३३७॥६३१८॥अफजूँ॥",
      "sourceLineId": "135095",
      "sourceShabadId": "12608",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "135096",
      "sourceShabadId": "12609",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਗਰ ਬਿਭਾਸਾਵਤੀ ਮੈ ਕਰਨ ਬਿਭਾਸ ਨਰੇਸ ॥",
      "transliteration": "nagar bibhaasaavatee mai karan bibhaas nares ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਭਾਸਾਵਤੀ ਨਗਰ ਵਿਚ ਬਿਭਾਸ ਕਰਨ ਨਾ ਦਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "नगर बिभासावती मै करन बिभास नरेस ॥",
      "sourceLineId": "135097",
      "sourceShabadId": "12609",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾ ਕੇ ਤੇਜ ਰੁ ਤ੍ਰਾਸ ਕੌ ਜਾਨਤ ਸਗਰੋ ਦੇਸ ॥੧॥",
      "transliteration": "jaa ke tej r traas kau jaanat sagaro dhes ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਤੇਜ ਅਤੇ ਭੈ ਨੂੰ ਸਾਰਾ ਦੇਸ਼ ਜਾਣਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "जा के तेज रु त्रास कौ जानत सगरो देस ॥१॥",
      "sourceLineId": "135098",
      "sourceShabadId": "12609",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135099",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਤੀ ਬਿਵਾਸ ਤਵਨ ਕੀ ਰਾਨੀ ॥",
      "transliteration": "matee bivaas tavan kee raanee ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਵਾਸ ਮਤੀ ਉਸ ਦੀ ਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "मती बिवास तवन की रानी ॥",
      "sourceLineId": "135100",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੁੰਦਰਿ ਭਵਨ ਚਤ੍ਰਦਸ ਜਾਨੀ ॥",
      "transliteration": "su(n)dhar bhavan chatradhas jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਸੁੰਦਰ ਮੰਨੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "सुँदरि भवन चत्रदस जानी ॥",
      "sourceLineId": "135101",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਤ ਸਵਤਿ ਤਾ ਕੀ ਛਬਿਮਾਨ ॥",
      "transliteration": "saat savat taa kee chhabimaan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀਆਂ ਸੱਤ ਸੁੰਦਰ ਸੌਂਕਣਾ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "सात सवति ता की छबिमान ॥",
      "sourceLineId": "135102",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾਨੁਕ ਸਾਤ ਰੂਪ ਕੀ ਖਾਨ ॥੨॥",
      "transliteration": "jaanuk saat roop kee khaan ||2||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸਤੇ ਹੀ ਰੂਪ ਦੀ ਖਾਣ ਹੋਣ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "जानुक सात रूप की खान ॥२॥",
      "sourceLineId": "135103",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਯੋ ਤਹਾ ਏਕ ਬੈਰਾਗੀ ॥",
      "transliteration": "aayo tahaa ek bairaagee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਬੈਰਾਗੀ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "आयो तहा एक बैरागी ॥",
      "sourceLineId": "135104",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਤਿਆਗੀ ॥",
      "transliteration": "roopavaan gunavaan tiaagee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਰੂਪਵਾਨ, ਗੁਣਵਾਨ ਅਤੇ ਤਿਆਗੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "रूपवान गुनवान तिआगी ॥",
      "sourceLineId": "135105",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸ੍ਯਾਮ ਦਾਸ ਤਾ ਕੋ ਭਨਿ ਨਾਮਾ ॥",
      "transliteration": "sayaam dhaas taa ko bhan naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਸ਼ਿਆਮ ਦਾਸ ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "स्याम दास ता को भनि नामा ॥",
      "sourceLineId": "135106",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਿਸ ਦਿਨ ਨਿਰਖਿ ਰਹਤ ਤਿਹ ਬਾਮਾ ॥੩॥",
      "transliteration": "nis dhin nirakh rahat teh baamaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਰਾਤ ਦਿਨ ਇਸਤਰੀਆਂ ਵੇਖਦੀਆਂ ਰਹਿੰਦੀਆਂ ਸਨ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "निस दिन निरखि रहत तिह बामा ॥३॥",
      "sourceLineId": "135107",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਤੀ ਬਿਭਾਸ ਤਵਨ ਰਸ ਰਾਚੀ ॥",
      "transliteration": "matee bibhaas tavan ras raachee ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਭਾਸ ਮਤੀ ਉਸ ਦੇ ਪ੍ਰੇਮ ਵਿਚ ਮਗਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "मती बिभास तवन रस राची ॥",
      "sourceLineId": "135108",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਮਿਤਵਾ ਕੇ ਮਾਚੀ ॥",
      "transliteration": "kaam bhog mitavaa ke maachee ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਨਾਲ ਖ਼ੂਬ ਕਾਮ ਭੋਗ ਕਰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "काम भोग मितवा के माची ॥",
      "sourceLineId": "135109",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਵਨ ਕਰੌ ਤਾ ਸੌ ਮਨ ਭਾਵੈ ॥",
      "transliteration": "gavan karau taa sau man bhaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉਸ ਨਾਲ ਮਨ ਭਾਉਾਂਦਾ ਸੰਯੋਗ ਕਰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "गवन करौ ता सौ मन भावै ॥",
      "sourceLineId": "135110",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਵਤਿਨ ਸੋਕ ਹ੍ਰਿਦੈ ਮਹਿ ਆਵੈ ॥੪॥",
      "transliteration": "savatin sok hiradhai meh aavai ||4||",
      "translation": "",
      "punjabiViakhya": "ਸੌਂਕਣਾ (ਇਸ ਕਰ ਕੇ) ਮਨ ਵਿਚ ਬਹੁਤ ਦੁਖੀ ਹੁੰਦੀਆਂ ਸਨ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "सवतिन सोक हृदै महि आवै ॥४॥",
      "sourceLineId": "135111",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਹਿਧੁਜ ਦੇ ਝਖਕੇਤੁ ਮਤੀ ਭਨਿ ॥",
      "transliteration": "ahidhuj dhe jhakhaket matee bhan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ ਇਕ ਸੌਂਕਣ) ਅਹਿਧੁਜ ਦੇਈ ਨੇ (ਦੂਜੀ ਸੌਂਕਣ) ਝਖਕੇਤੁ ਮਤੀ ਨੂੰ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "अहिधुज दे झखकेतु मती भनि ॥",
      "sourceLineId": "135112",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪੁਹਪ ਮੰਜਰੀ ਫੂਲ ਮਤੀ ਗਨਿ ॥",
      "transliteration": "puhap ma(n)jaree fool matee gan ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੁਹਪ ਮੰਜਰੀ ਨੇ ਫੂਲਮਤੀ ਨੂੰ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "पुहप मंजरी फूल मती गनि ॥",
      "sourceLineId": "135113",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਗਰਿ ਦੇ ਨਾਗਨਿ ਦੇ ਰਾਨੀ ॥",
      "transliteration": "naagar dhe naagan dhe raanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਨਾਗਰ ਦੇ (ਦੇਈ) ਅਤੇ ਨਾਗਨ ਦੇ (ਦੇਈ) ਨਾ ਦੀਆਂ ਵੀ (ਦੋ) ਰਾਣੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "नागरि दे नागनि दे रानी ॥",
      "sourceLineId": "135114",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨ੍ਰਿਤ ਮਤੀ ਸਭ ਹੀ ਜਗ ਜਾਨੀ ॥੫॥",
      "transliteration": "nirat matee sabh hee jag jaanee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਸੱਤਵੀਂ) ਨ੍ਰਿਤ ਮਤੀ ਸਾਰੇ ਜਗਤ ਵਿਚ ਜਾਣੀ ਜਾਦੀ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "नृत मती सभ ही जग जानी ॥५॥",
      "sourceLineId": "135115",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਿਨ ਦਿਨ ਏਕ ਕਰੀ ਮਿਜਮਾਨੀ ॥",
      "transliteration": "tin dhin ek karee mijamaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਬਿਭਾਸ ਮਤੀ ਰਾਣੀ ਨੇ) ਇਕ ਦਿਨ ਪ੍ਰੀਤੀ ਭੋਜਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "तिन दिन एक करी मिजमानी ॥",
      "sourceLineId": "135116",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਿਵਤਿ ਪਠੀ ਸਭ ਹੀ ਘਰ ਰਾਨੀ ॥",
      "transliteration": "nivat paThee sabh hee ghar raanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀਆਂ ਰਾਣੀਆਂ ਨੂੰ ਨਿਉਤਾ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "निवति पठी सभ ही घर रानी ॥",
      "sourceLineId": "135117",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿਖੁ ਕੌ ਭੋਜਨ ਸਭਨ ਖਵਾਇ ॥",
      "transliteration": "bikh kau bhojan sabhan khavai ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਵਿਸ਼ ਮਿਲਿਆ ਭੋਜਨ ਖਵਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "बिखु कौ भोजन सभन खवाइ ॥",
      "sourceLineId": "135118",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਕਲ ਦਈ ਮ੍ਰਿਤ ਲੋਕ ਪਠਾਇ ॥੬॥",
      "transliteration": "sakal dhiee mirat lok paThai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੀਆਂ ਨੂੰ ਜਮਲੋਕ ਭੇਜ ਦਿੱਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "सकल दई मृत लोक पठाइ ॥६॥",
      "sourceLineId": "135119",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਿਖੁ ਕਹ ਖਾਇ ਮਰੀ ਸਵਤੈ ਸਬ ॥",
      "transliteration": "bikh keh khai maree savatai sab ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਵਿਸ਼ ਨੂੰ ਖਾ ਕੇ ਸਾਰੀਆਂ ਸੌਂਕਣਾ ਮਰ ਗਈਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "बिखु कह खाइ मरी सवतै सब ॥",
      "sourceLineId": "135120",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰੋਵਤ ਭਈ ਬਿਭਾਸ ਮਤੀ ਤਬ ॥",
      "transliteration": "rovat bhiee bibhaas matee tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬਿਭਾਸ ਮਤੀ ਰੋਣ ਲਗ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "रोवत भई बिभास मती तब ॥",
      "sourceLineId": "135121",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਾਪ ਕਰਮ ਕੀਨਾ ਮੈ ਭਾਰੋ ॥",
      "transliteration": "paap karam keenaa mai bhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੈਂ ਵੱਡਾ ਪਾਪ-ਕਰਮ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "पाप करम कीना मै भारो ॥",
      "sourceLineId": "135122",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਧੋਖੇ ਲਵਨ ਇਨੈ ਬਿਖੁ ਖ੍ਵਾਰੋ ॥੭॥",
      "transliteration": "dhokhe lavan inai bikh khavaiaaro ||7||",
      "translation": "",
      "punjabiViakhya": "ਲੂਣ ਦੇ ਭੁਲੇਖੇ ਇਨ੍ਰਹਾ ਨੂੰ ਵਿਸ਼ ਖਵਾ ਦਿੱਤੀ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "धोखे लवन इनै बिखु ख्वारो ॥७॥",
      "sourceLineId": "135123",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਬ ਮੈ ਗਰੌ ਹਿਮਾਚਲ ਜਾਇ ॥",
      "transliteration": "ab mai garau himaachal jai ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਹਿਮਾਲਾ ਪਰਬਤ ਵਿਚ ਜਾ ਕੇ ਗਲ ਜਾਵਾਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "अब मै गरौ हिमाचल जाइ ॥",
      "sourceLineId": "135124",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੈ ਪਾਵਕ ਮਹਿ ਬਰੌ ਬਨਾਇ ॥",
      "transliteration": "kai paavak meh barau banai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਮੈਂ ਅੱਗ ਵਿਚ ਸੜ ਮਰਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "कै पावक महि बरौ बनाइ ॥",
      "sourceLineId": "135125",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਹਚਰਿ ਸਹਸ ਹਟਕਿ ਤਿਹ ਰਹੀ ॥",
      "transliteration": "sahachar sahas haTak teh rahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਹਜ਼ਾਰਾ ਸਹੇਲੀਆਂ ਰੋਕ ਹਟੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "सहचरि सहस हटकि तिह रही ॥",
      "sourceLineId": "135126",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਾਨਤ ਭਈ ਨ ਤਿਨ ਕੀ ਕਹੀ ॥੮॥",
      "transliteration": "maanat bhiee na tin kee kahee ||8||",
      "translation": "",
      "punjabiViakhya": "ਪਰ (ਉਸ ਨੇ) ਉਨ੍ਰਹਾ ਦੀ ਗੱਲ ਨੂੰ ਨਾ ਮੰਨਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "मानत भई न तिन की कही ॥८॥",
      "sourceLineId": "135127",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਵਹੈ ਸੰਗ ਬੈਰਾਗੀ ਲੀਨਾ ॥",
      "transliteration": "vahai sa(n)g bairaagee leenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਹੀ ਬੈਰਾਗੀ ਨਾਲ ਲੈ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "वहै संग बैरागी लीना ॥",
      "sourceLineId": "135128",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਾ ਸੌ ਕਾਮ ਭੋਗ ਕਹ ਕੀਨਾ ॥",
      "transliteration": "jaa sau kaam bhog keh keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਉਸ ਨੇ ਕਾਮ ਭੋਗ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "जा सौ काम भोग कह कीना ॥",
      "sourceLineId": "135129",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1291_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਲੋਗ ਲਖੈ ਤ੍ਰਿਯ ਗਰਬੇ ਗਈ ॥",
      "transliteration": "log lakhai tiray garabe giee ||",
      "translation": "",
      "punjabiViakhya": "ਲੋਕੀਂ ਸੋਚਦੇ ਕਿ ਇਸਤਰੀ (ਹਿਮਾਲਾ ਪਰਬਤ ਉਤੇ) ਗਲਣ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1291,
      "hindi": "",
      "hindiTransliteration": "लोग लखै तृय गरबे गई ॥",
      "sourceLineId": "135130",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
