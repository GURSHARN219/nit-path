{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1292,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1292_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਿਨਹੂੰ ਬਾਤ ਜਾਨਿ ਨਹਿ ਲਈ ॥੯॥",
      "transliteration": "kinahoo(n) baat jaan neh liee ||9||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ (ਅਸਲੀ) ਗੱਲ ਨਹੀਂ ਸਮਝੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "किनहूँ बात जानि नहि लई ॥९॥",
      "sourceLineId": "135131",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮੂਰਖ ਰਾਇ ਬਾਇ ਮੁਖ ਰਹਾ ॥",
      "transliteration": "moorakh rai bai mukh rahaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜਾ ਮੂੰਹ ਅੱਡੀ ਰਹਿ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "मूरख राइ बाइ मुख रहा ॥",
      "sourceLineId": "135132",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭਲਾ ਬੁਰਾ ਕਛੁ ਤਾਹਿ ਨ ਕਹਾ ॥",
      "transliteration": "bhalaa buraa kachh taeh na kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ (ਇਸਤਰੀ) ਨੂੰ ਕੁਝ ਵੀ ਮਾੜਾ ਚੰਗਾ ਨਾ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "भला बुरा कछु ताहि न कहा ॥",
      "sourceLineId": "135133",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਰਿ ਜਾਰਿ ਕੇ ਸਾਥ ਸਿਧਾਈ ॥",
      "transliteration": "naar jaar ke saath sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਯਾਰ ਨਾਲ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "नारि जारि के साथ सिधाई ॥",
      "sourceLineId": "135134",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਾਤ ਭੇਦ ਕੀ ਕਿਨਹੁ ਨ ਪਾਈ ॥੧੦॥",
      "transliteration": "baat bhedh kee kinahu na paiee ||10||",
      "translation": "",
      "punjabiViakhya": "ਭੇਦ ਦੀ ਗੱਲ ਕਿਸੇ ਨੇ ਵੀ ਨਾ ਸਮਝੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "बात भेद की किनहु न पाई ॥१०॥",
      "sourceLineId": "135135",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤ੍ਰਿਯ ਕੋ ਚਰਿਤ ਨ ਬਿਧਨਾ ਜਾਨੈ ॥",
      "transliteration": "tiray ko charit na bidhanaa jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਦਾ ਚਰਿਤ੍ਰ ਤਾ ਵਿਧਾਤਾ ਵੀ ਨਹੀਂ ਸਮਝਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "तृय को चरित न बिधना जानै ॥",
      "sourceLineId": "135136",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਹਾ ਰੁਦ੍ਰ ਭੀ ਕਛੁ ਨ ਪਛਾਨੈ ॥",
      "transliteration": "mahaa rudhr bhee kachh na pachhaanai ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਰੁਦ੍ਰ ਵੀ ਕੁਝ ਨਹੀਂ ਜਾਣਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "महा रुद्र भी कछु न पछानै ॥",
      "sourceLineId": "135137",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਨ ਕੀ ਬਾਤ ਏਕ ਹੀ ਪਾਈ ॥",
      "transliteration": "ein kee baat ek hee paiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਦੀ ਗੱਲ ਇਕ ਨੇ ਹੀ ਸਮਝੀ ਹੈ?",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "इन की बात एक ही पाई ॥",
      "sourceLineId": "135138",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਿਨ ਇਸਤ੍ਰੀ ਜਗਦੀਸ ਬਨਾਈ ॥੧੧॥",
      "transliteration": "jin isatree jagadhees banaiee ||11||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਜਗਦੀਸ਼ ਨੇ ਇਸਤਰੀ ਦੀ ਸਿਰਜਨਾ ਕੀਤੀ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "जिन इसत्री जगदीस बनाई ॥११॥",
      "sourceLineId": "135139",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਤੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੮॥੬੩੨੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau aThatees charitr samaapatam sat subham sat ||338||6329||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੩੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੩੮॥੬੩੨੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ अठतीस चरित्र समापतम सतु सुभम सतु ॥३३८॥६३२९॥अफजूँ॥",
      "sourceLineId": "135140",
      "sourceShabadId": "12610",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135141",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁਨਿਯਤ ਇਕ ਨਗਰੀ ਉਜਿਯਾਰੀ ॥",
      "transliteration": "suniyat ik nagaree ujiyaaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਬਹੁਤ ਸੁੰਦਰ ਨਗਰੀ ਸੁਣੀਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "सुनियत इक नगरी उजियारी ॥",
      "sourceLineId": "135142",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਿਸੁਕਰਮਾ ਨਿਜੁ ਹਾਥ ਸਵਾਰੀ ॥",
      "transliteration": "bisukaramaa nij haath savaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵਿਸ਼੍ਵਕਰਮਾ ਨੇ ਆਪਣੇ ਹੱਥਾ ਨਾਲ ਸੰਵਾਰਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "बिसुकरमा निजु हाथ सवारी ॥",
      "sourceLineId": "135143",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਮੁ ਅਲੂਰਾ ਤਾ ਕੋ ਸੋਹੈ ॥",
      "transliteration": "naam alooraa taa ko sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਅਲੂਰਾ (ਅਲੋਰਾ) ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "नामु अलूरा ता को सोहै ॥",
      "sourceLineId": "135144",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤੀਨੋ ਲੋਕ ਰਚਿਤ ਤਿਨ ਮੋਹੈ ॥੧॥",
      "transliteration": "teeno lok rachit tin mohai ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਹ (ਵਿਧਾਤਾ ਦੁਆਰਾ) ਰਚੇ ਹੋਏ ਤਿੰਨਾ ਲੋਕਾ ਨੂੰ ਮੋਂਹਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "तीनो लोक रचित तिन मोहै ॥१॥",
      "sourceLineId": "135145",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭੂਪ ਭਦ੍ਰ ਤਿਹ ਗੜ ਕੋ ਰਾਜਾ ॥",
      "transliteration": "bhoop bhadhr teh gaR ko raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਪ ਭਦ੍ਰ ਉਸ ਗੜ੍ਰਹ ਦਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "भूप भद्र तिह गड़ को राजा ॥",
      "sourceLineId": "135146",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਜ ਪਾਟ ਤਾਹੀ ਕਹ ਛਾਜਾ ॥",
      "transliteration": "raaj paaT taahee keh chhaajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਗਰੀ ਦਾ) ਰਾਜ-ਪਾਟ ਉਸੇ ਨੂੰ ਸ਼ੋਭਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "राज पाट ताही कह छाजा ॥",
      "sourceLineId": "135147",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਤਨ ਮਤੀ ਤਿਹ ਨ੍ਰਿਪ ਕੀ ਰਾਨੀ ॥",
      "transliteration": "ratan matee teh nirap kee raanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਤਨ ਮਤੀ ਉਸ ਰਾਜੇ ਦੀ ਪਤਨੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "रतन मती तिह नृप की रानी ॥",
      "sourceLineId": "135148",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਧਿਕ ਕੁਰੂਪ ਜਗਤ ਮਹਿ ਜਾਨੀ ॥੨॥",
      "transliteration": "adhik kuroop jagat meh jaanee ||2||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਾਰੇ ਸੰਸਾਰ ਵਿਚ ਬਹੁਤ ਕੁਰੂਪ ਸਮਝੀ ਜਾਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "अधिक कुरूप जगत महि जानी ॥२॥",
      "sourceLineId": "135149",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਕੇ ਨਿਕਟ ਨ ਰਾਜਾ ਜਾਵੈ ॥",
      "transliteration": "taa ke nikaT na raajaa jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਉਸ ਪਾਸ ਨਹੀਂ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "ता के निकट न राजा जावै ॥",
      "sourceLineId": "135150",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਿਰਖਿ ਨਾਰਿ ਕੋ ਰੂਪ ਡਰਾਵੈ ॥",
      "transliteration": "nirakh naar ko roop ddaraavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਦਾ ਰੂਪ ਵੇਖ ਕੇ ਡਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "निरखि नारि को रूप डरावै ॥",
      "sourceLineId": "135151",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਵਰ ਰਾਨਿਯਨ ਕੇ ਘਰ ਰਹੈ ॥",
      "transliteration": "avar raaniyan ke ghar rahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਹੋਰਨਾ ਰਾਣੀਆਂ ਦੇ ਘਰ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "अवर रानियन के घर रहै ॥",
      "sourceLineId": "135152",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਾ ਸੌ ਬੈਨ ਨ ਬੋਲਾ ਚਹੈ ॥੩॥",
      "transliteration": "taa sau bain na bolaa chahai ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਗੱਲ ਕਰਨੀ ਵੀ ਨਹੀਂ ਚਾਹੁੰਦਾ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "ता सौ बैन न बोला चहै ॥३॥",
      "sourceLineId": "135153",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਯਹ ਦੁਖ ਅਧਿਕ ਨਾਰਿ ਕੇ ਮਨੈ ॥",
      "transliteration": "yeh dhukh adhik naar ke manai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਦਾ ਰਾਣੀ ਦੇ ਮਨ ਵਿਚ (ਬਹੁਤ) ਦੁਖ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "यह दुख अधिक नारि के मनै ॥",
      "sourceLineId": "135154",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚਾਹਤ ਪ੍ਰੀਤਿ ਨ੍ਰਿਪਤਿ ਸੌ ਬਨੈ ॥",
      "transliteration": "chaahat preet nirapat sau banai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਚਾਹੁੰਦੀ ਸੀ ਕਿ ਰਾਜੇ ਨਾਲ ਪ੍ਰੇਮ ਸੰਬੰਧ ਬਣ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "चाहत प्रीति नृपति सौ बनै ॥",
      "sourceLineId": "135155",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਏਕ ਜਤਨ ਤਬ ਕਿਯਾ ਪਿਆਰੀ ॥",
      "transliteration": "ek jatan tab kiyaa piaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਸ) ਪਿਆਰੀ ਨੇ ਇਕ ਯਤਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "एक जतन तब किया पिआरी ॥",
      "sourceLineId": "135156",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੁਨਹੁ ਕਹਤ ਹੌ ਕਥਾ ਬਿਚਾਰੀ ॥੪॥",
      "transliteration": "sunahu kahat hau kathaa bichaaree ||4||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਸੁਣੋ! ਮੈਂ ਵਿਚਾਰ ਪੂਰਵਕ ਕਥਾ ਕਹਿੰਦਾ ਹਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "सुनहु कहत हौ कथा बिचारी ॥४॥",
      "sourceLineId": "135157",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪੂਜਾ ਕਰਤ ਲਖਿਯੋ ਜਬ ਰਾਜਾ ॥",
      "transliteration": "poojaa karat lakhiyo jab raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੇ ਰਾਜੇ ਨੂੰ ਪੂਜਾ ਕਰਦਿਆਂ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "पूजा करत लखियो जब राजा ॥",
      "sourceLineId": "135158",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਬ ਤਨ ਸਜਾ ਸਕਲ ਤ੍ਰਿਯ ਸਾਜਾ ॥",
      "transliteration": "tab tan sajaa sakal tiray saajaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਇਸਤਰੀ ਨੇ ਸ਼ਰੀਰ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਸਜਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "तब तन सजा सकल तृय साजा ॥",
      "sourceLineId": "135159",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਹਾ ਰੁਦ੍ਰ ਕੋ ਭੇਸ ਬਨਾਇ ॥",
      "transliteration": "mahaa rudhr ko bhes banai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਮਹਾ ਰੁਦ੍ਰ ਦਾ ਭੇਸ ਬਣਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "महा रुद्र को भेस बनाइ ॥",
      "sourceLineId": "135160",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਪਨੈ ਅੰਗ ਬਿਭੂਤਿ ਚੜਾਇ ॥੫॥",
      "transliteration": "apanai a(n)g bibhoot chaRai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਅੰਗਾ ਉਤੇ ਬਿਭੂਤੀ (ਸੁਆਹ) ਮਲ ਲਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "अपनै अंग बिभूति चड़ाइ ॥५॥",
      "sourceLineId": "135161",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਰਤ ਹੁਤੋ ਰਾਜਾ ਜਪੁ ਜਹਾ ॥",
      "transliteration": "karat huto raajaa jap jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਜਿਥੇ ਜਪ ਕਰ ਰਿਹਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "करत हुतो राजा जपु जहा ॥",
      "sourceLineId": "135162",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਿਵ ਬਨਿ ਆਨਿ ਠਾਢਿ ਭੀ ਤਹਾ ॥",
      "transliteration": "siv ban aan Thaadd bhee tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਉਹ) ਸ਼ਿਵ ਬਣ ਕੇ ਆ ਖੜੋਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "सिव बनि आनि ठाढि भी तहा ॥",
      "sourceLineId": "135163",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਬ ਰਾਜੈ ਤਿਹ ਰੂਪ ਨਿਹਰਾ ॥",
      "transliteration": "jab raajai teh roop niharaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਉਸ ਦਾ ਰੂਪ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "जब राजै तिह रूप निहरा ॥",
      "sourceLineId": "135164",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਨ ਕ੍ਰਮ ਈਸ ਜਾਨਿ ਪਗ ਪਰਾ ॥੬॥",
      "transliteration": "man kram iees jaan pag paraa ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਨ, (ਬਚ) ਕਰਮ ਕਰ ਕੇ ਉਸ ਨੂੰ ਸ਼ਿਵ ਸਮਝ ਕੇ ਪੈਰਾ ਉਤੇ ਡਿਗ ਪਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "मन क्रम ईस जानि पग परा ॥६॥",
      "sourceLineId": "135165",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਫਲ ਭਯੋ ਅਬ ਜਨਮ ਹਮਾਰਾ ॥",
      "transliteration": "sufal bhayo ab janam hamaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ ਕਹਿਣ ਲਗਾ) ਹੁਣ ਮੇਰਾ ਜਨਮ ਸਫਲ ਹੋ ਗਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "सुफल भयो अब जनम हमारा ॥",
      "sourceLineId": "135166",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਹਾਦੇਵ ਕੋ ਦਰਸ ਨਿਹਾਰਾ ॥",
      "transliteration": "mahaadhev ko dharas nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ ਮੈਂ) ਮਹਾਦੇਵ ਦੇ ਦਰਸ਼ਨ ਕਰ ਲਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "महादेव को दरस निहारा ॥",
      "sourceLineId": "135167",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਹਿਯੋ ਕਰੀ ਮੈ ਬਡੀ ਕਮਾਈ ॥",
      "transliteration": "kahiyo karee mai baddee kamaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿਣ ਲਗਾ ਕਿ ਮੈਂ ਬਹੁਤ ਵੱਡੀ ਕਮਾਈ ਕੀਤੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "कहियो करी मै बडी कमाई ॥",
      "sourceLineId": "135168",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾ ਤੇ ਦੀਨੀ ਰੁਦ੍ਰ ਦਿਖਾਈ ॥੭॥",
      "transliteration": "jaa te dheenee rudhr dhikhaiee ||7||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਰੁਦ੍ਰ ਨੇ ਮੈਨੂੰ ਦਰਸ਼ਨ ਦਿੱਤੇ ਹਨ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "जा ते दीनी रुद्र दिखाई ॥७॥",
      "sourceLineId": "135169",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਰੰਬ੍ਰੂਹ ਤਿਹ ਕਹਾ ਨਾਰਿ ਤਬ ॥",
      "transliteration": "bara(n)braooh teh kahaa naar tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਸਤਰੀ ਨੇ ਉਸ ਨੂੰ ਕਿਹਾ, ਵਰ ਮੰਗੋ ('ਬਰੰਬ੍ਰੁਹ')",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "बरंब्रूह तिह कहा नारि तब ॥",
      "sourceLineId": "135170",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੌ ਜੜ ਰੁਦ੍ਰ ਲਖਿਯੋ ਜਾਨਾ ਜਬ ॥",
      "transliteration": "jau jaR rudhr lakhiyo jaanaa jab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਮੂਰਖ (ਰਾਜੇ) ਨੇ (ਉਸ ਇਸਤਰੀ ਨੂੰ) ਰੁਦ੍ਰ ਸਮਝ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "जौ जड़ रुद्र लखियो जाना जब ॥",
      "sourceLineId": "135171",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤੈ ਮੁਰਿ ਕਰੀ ਸੇਵ ਭਾਖਾ ਅਤਿ ॥",
      "transliteration": "tai mur karee sev bhaakhaa at ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕਿਹਾ, ਤੂੰ ਮੇਰੀ ਬਹੁਤ ਸੇਵਾ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "तै मुरि करी सेव भाखा अति ॥",
      "sourceLineId": "135172",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਬ ਤਹਿ ਦਰਸੁ ਦਿਯੋ ਮੈ ਸੁਭ ਮਤਿ ॥੮॥",
      "transliteration": "tab teh dharas dhiyo mai subh mat ||8||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸ਼ੁਭ ਮਤ ਵਾਲੇ! ਤਦ ਹੀ ਮੈਂ ਤੈਨੂੰ ਦਰਸ਼ਨ ਦਿੱਤੇ ਹਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "तब तहि दरसु दियो मै सुभ मति ॥८॥",
      "sourceLineId": "135173",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੁਨਿ ਬਚ ਨਾਰਿ ਰਾਇ ਹਰਖਾਨਾ ॥",
      "transliteration": "sun bach naar rai harakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਦੇ ਬਚਨ ਸੁਣ ਕੇ ਰਾਜਾ ਬਹੁਤ ਪ੍ਰਸੰਨ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "सुनि बच नारि राइ हरखाना ॥",
      "sourceLineId": "135174",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਜੜ ਕਛੂ ਨ ਜਾਨਾ ॥",
      "transliteration": "bhedh abhedh jaR kachhoo na jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਨੇ ਭੇਦ ਅਭੇਦ ਕੁਝ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद जड़ कछू न जाना ॥",
      "sourceLineId": "135175",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤ੍ਰਿਯ ਕੇ ਚਰਨ ਰਹਾ ਲਪਟਾਈ ॥",
      "transliteration": "tiray ke charan rahaa lapaTaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਦੇ ਚਰਨਾ ਨਾਲ ਲਿਪਟਿਆ ਰਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "तृय के चरन रहा लपटाई ॥",
      "sourceLineId": "135176",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਰਿ ਚਰਿਤ ਕੀ ਬਾਤ ਨ ਪਾਈ ॥੯॥",
      "transliteration": "naar charit kee baat na paiee ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਾਰੀ ਚਰਿਤ੍ਰ ਦੀ ਗੱਲ ਨੂੰ ਨਾ ਸਮਝਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "नारि चरित की बात न पाई ॥९॥",
      "sourceLineId": "135177",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1292_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਬ ਐਸਾ ਤ੍ਰਿਯ ਕਿਯਾ ਉਚਾਰਾ ॥",
      "transliteration": "tab aaisaa tiray kiyaa uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1292,
      "hindi": "",
      "hindiTransliteration": "तब ऐसा तृय किया उचारा ॥",
      "sourceLineId": "135178",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
