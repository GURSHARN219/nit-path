{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1293,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1293_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁਨਹੁ ਬਾਤ ਤੁਮ ਰਾਜ ਕੁਮਾਰਾ ॥",
      "transliteration": "sunahu baat tum raaj kumaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜ ਕੁਮਾਰ! ਤੁਸੀਂ (ਮੇਰੀ) ਗੱਲ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "सुनहु बात तुम राज कुमारा ॥",
      "sourceLineId": "135179",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਤਨ ਮਤੀ ਤੁਮਰੀ ਜੋ ਰਾਨੀ ॥",
      "transliteration": "ratan matee tumaree jo raanee ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਡੀ ਜੋ ਰਾਣੀ ਰਤਨ ਮਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "रतन मती तुमरी जो रानी ॥",
      "sourceLineId": "135180",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਯਹ ਮੁਰਿ ਅਤਿ ਸੇਵਕੀ ਪ੍ਰਮਾਨੀ ॥੧੦॥",
      "transliteration": "yeh mur at sevakee pramaanee ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮੇਰੀ ਬਹੁਤ ਪੱਕੀ ਸੇਵਿਕਾ ਸਮਝੋ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "यह मुरि अति सेवकी प्रमानी ॥१०॥",
      "sourceLineId": "135181",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੌ ਯਾ ਸੌ ਤੁਮ ਕਰਹੁ ਪ੍ਯਾਰਾ ॥",
      "transliteration": "jau yaa sau tum karahu payaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੁਸੀਂ ਉਸ ਨਾਲ ਪ੍ਰੇਮ ਕਰੋਂਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "जौ या सौ तुम करहु प्यारा ॥",
      "sourceLineId": "135182",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹ੍ਵੈ ਹੈ ਤੁਮਰੋ ਤਬੈ ਉਧਾਰਾ ॥",
      "transliteration": "havai hai tumaro tabai udhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਤੁਹਾਡਾ ਉੱਧਾਰ ਹੋਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "ह्वै है तुमरो तबै उधारा ॥",
      "sourceLineId": "135183",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਤ੍ਰ ਹੋਇਗੋ ਨਾਸ ਤਿਹਾਰੋ ॥",
      "transliteration": "satr hoigo naas tihaaro ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਡੇ ਵੈਰੀ ਨਸ਼ਟ ਹੋਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "सत्र होइगो नास तिहारो ॥",
      "sourceLineId": "135184",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਬ ਜਾਨੌ ਤੂ ਭਗਤ ਹਮਾਰੋ ॥੧੧॥",
      "transliteration": "tab jaanau too bhagat hamaaro ||11||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਮੈਂ) ਸਮਝਾਗਾ ਕਿ ਤੂੰ ਮੇਰਾ ਭਗਤ ਹੈਂ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "तब जानौ तू भगत हमारो ॥११॥",
      "sourceLineId": "135185",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਯੌ ਕਹਿ ਲੋਕੰਜਨ ਦ੍ਰਿਗ ਡਾਰੀ ॥",
      "transliteration": "yau keh loka(n)jan dhirag ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ (ਉਸ ਨੇ) ਲੋਕੰਜਨ (ਸੁਰਮਾ) ਅੱਖਾ ਵਿਚ ਪਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "यौ कहि लोकंजन दृग डारी ॥",
      "sourceLineId": "135186",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਈ ਲੋਪ ਨਹਿ ਜਾਇ ਨਿਹਾਰੀ ॥",
      "transliteration": "bhiee lop neh jai nihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਭੇਦ ਭਰੇ ਢੰਗ ਨਾਲ ਅਲੋਪ ਹੋ ਗਈ ਅਤੇ ਵੇਖੀ ਨਾ ਜਾ ਸਕੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "भई लोप नहि जाइ निहारी ॥",
      "sourceLineId": "135187",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮੂੜ ਰਾਵ ਤਿਹ ਰੁਦ੍ਰ ਪ੍ਰਮਾਨਾ ॥",
      "transliteration": "mooR raav teh rudhr pramaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ ਰੁਦ੍ਰ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "मूड़ राव तिह रुद्र प्रमाना ॥",
      "sourceLineId": "135188",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕਛੁ ਪਸੂ ਨ ਜਾਨਾ ॥੧੨॥",
      "transliteration": "bhedh abhedh kachh pasoo na jaanaa ||12||",
      "translation": "",
      "punjabiViakhya": "ਭੇਦ ਅਭੇਦ ਨੂੰ ਮੂਰਖ ਨੇ ਕੁਝ ਨਾ ਜਾਣਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद कछु पसू न जाना ॥१२॥",
      "sourceLineId": "135189",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਬ ਤੇ ਤਾ ਸੌ ਕੀਆ ਪ੍ਯਾਰਾ ॥",
      "transliteration": "tab te taa sau keeaa payaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੋਂ ਉਸ ਨਾਲ (ਰਾਜੇ ਨੇ) ਹੋਰ ਸਾਰੀਆਂ ਸੁੰਦਰ ਰਾਣੀਆਂ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "तब ते ता सौ कीआ प्यारा ॥",
      "sourceLineId": "135190",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਜਿ ਕਰਿ ਸਕਲ ਸੁੰਦਰੀ ਨਾਰਾ ॥",
      "transliteration": "taj kar sakal su(n)dharee naaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਆਗ ਕੇ ਪਿਆਰ ਕਰਨਾ ਸ਼ੁਰੂ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "तजि करि सकल सुँदरी नारा ॥",
      "sourceLineId": "135191",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਹ ਛਲ ਛਲਾ ਚੰਚਲਾ ਰਾਜਾ ॥",
      "transliteration": "eeh chhal chhalaa cha(n)chalaa raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਚੰਚਲਾ ਨੇ ਰਾਜੇ ਨੂੰ ਛਲ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "इह छल छला चंचला राजा ॥",
      "sourceLineId": "135192",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਆਲੂਰੇ ਗੜ ਕੋ ਸਿਰਤਾਜਾ ॥੧੩॥",
      "transliteration": "aaloore gaR ko sirataajaa ||13||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਆਲੂਰ ਗੜ੍ਰਹ ਦਾ ਸੁਆਮੀ ਸੀ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "आलूरे गड़ को सिरताजा ॥१३॥",
      "sourceLineId": "135193",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਉਨਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੩੯॥੬੩੪੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau unataalees charitr samaapatam sat subham sat ||339||6342||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੩੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੩੯॥੬੩੪੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ उनतालीस चरित्र समापतम सतु सुभम सतु ॥३३९॥६३४२॥अफजूँ॥",
      "sourceLineId": "135194",
      "sourceShabadId": "12611",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135195",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਥੁਰਾ ਨਾਮ ਹਮਾਰੇ ਰਹੈ ॥",
      "transliteration": "mathuraa naam hamaare rahai ||",
      "translation": "",
      "punjabiViakhya": "ਮਥੁਰਾ ਨਾ ਦਾ (ਇਕ ਵਿਅਕਤੀ) ਸਾਡੇ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "मथुरा नाम हमारे रहै ॥",
      "sourceLineId": "135196",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਗ ਤਿਹ ਤ੍ਰਿਯਹਿ ਗੁਲਾਬੇ ਕਹੈ ॥",
      "transliteration": "jag teh tirayeh gulaabe kahai ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਉਸ ਦੀ ਇਸਤਰੀ ਨੂੰ ਗੁਲਾਬੋ ਕਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "जग तिह तृयहि गुलाबे कहै ॥",
      "sourceLineId": "135197",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਮ ਦਾਸ ਨਾਮਾ ਤਹ ਆਯੋ ॥",
      "transliteration": "raam dhaas naamaa teh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਰਾਮ ਦਾਸ ਨਾ ਦਾ ਵਿਅਕਤੀ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "राम दास नामा तह आयो ॥",
      "sourceLineId": "135198",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਿਰਖਿ ਨਾਰਿ ਤਿਹ ਮਦਨ ਸਤਾਯੋ ॥੧॥",
      "transliteration": "nirakh naar teh madhan sataayo ||1||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਨੂੰ ਵੇਖ ਕੇ ਉਸ ਨੂੰ ਕਾਮ ਨੇ ਪਰੇਸ਼ਾਨ ਕੀਤਾ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "निरखि नारि तिह मदन सतायो ॥१॥",
      "sourceLineId": "135199",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਹੁਤ ਬਰਿਸ ਤਾ ਸੌ ਵਹੁ ਰਹਾ ॥",
      "transliteration": "bahut baris taa sau vahu rahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਹੁਤ ਵਰ੍ਰਹਿਆਂ ਤਕ ਉਸ ਨਾਲ ਰਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "बहुत बरिस ता सौ वहु रहा ॥",
      "sourceLineId": "135200",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪੁਨਿ ਐਸੇ ਤਿਹ ਤ੍ਰਿਯ ਸੌ ਕਹਾ ॥",
      "transliteration": "pun aaise teh tiray sau kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਇਸ ਤਰ੍ਰਹਾ ਇਸਤਰੀ ਪ੍ਰਤਿ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "पुनि ऐसे तिह तृय सौ कहा ॥",
      "sourceLineId": "135201",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਉ ਹੋਹਿ ਹਮਰੀ ਤੈ ਨਾਰੀ ॥",
      "transliteration": "aau hoh hamaree tai naaree ||",
      "translation": "",
      "punjabiViakhya": "ਆ! ਅਤੇ (ਹੁਣ) ਤੂੰ ਮੇਰੀ ਇਸਤਰੀ ਬਣ ਜਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "आउ होहि हमरी तै नारी ॥",
      "sourceLineId": "135202",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਸਿ ਦੈ ਹੈ ਤੁਹਿ ਯਹ ਮੁਰਦਾਰੀ ॥੨॥",
      "transliteration": "kas dhai hai tuh yeh muradhaaree ||2||",
      "translation": "",
      "punjabiViakhya": "ਇਹ (ਮਥੁਰਾ) ਮੁਰਦਾਰ ਤੈਨੂੰ ਕੀ ਦਿੰਦਾ ਹੈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "कसि दै है तुहि यह मुरदारी ॥२॥",
      "sourceLineId": "135203",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਲੀ ਭਲੀ ਅਬਲਾ ਤਿਨ ਭਾਖੀ ॥",
      "transliteration": "bhalee bhalee abalaa tin bhaakhee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਉਸ ਨੂੰ 'ਭਲੀ ਭਲੀ' ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "भली भली अबला तिन भाखी ॥",
      "sourceLineId": "135204",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚਿਤ ਮਹਿ ਰਾਖਿ ਨ ਕਾਹੂ ਆਖੀ ॥",
      "transliteration": "chit meh raakh na kaahoo aakhee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਇਹ ਗੱਲ) ਆਪਣੇ ਚਿਤ ਵਿਚ ਰਖੀ, ਕਿਸੇ ਨੂੰ ਨਾ ਦਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "चित महि राखि न काहू आखी ॥",
      "sourceLineId": "135205",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਬ ਮਥੁਰਾ ਆਯੋ ਤਿਹ ਧਾਮਾ ॥",
      "transliteration": "jab mathuraa aayo teh dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਮਥੁਰਾ ਉਸ ਦੇ ਘਰ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "जब मथुरा आयो तिह धामा ॥",
      "sourceLineId": "135206",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਬ ਅਸਿ ਬਚਨ ਬਖਾਨ੍ਯੋ ਬਾਮਾ ॥੩॥",
      "transliteration": "tab as bachan bakhaanayo baamaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕੀਤੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "तब असि बचन बखान्यो बामा ॥३॥",
      "sourceLineId": "135207",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਰੀ ਚੰਦ ਰਾਜਾ ਜਗ ਭਯੋ ॥",
      "transliteration": "haree cha(n)dh raajaa jag bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਵਿਚ ਰਾਜਾ ਹਰੀ ਚੰਦ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "हरी चंद राजा जग भयो ॥",
      "sourceLineId": "135208",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅੰਤ ਕਾਲ ਸੋ ਭੀ ਮਰਿ ਗਯੋ ॥",
      "transliteration": "a(n)t kaal so bhee mar gayo ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਤ ਸਮੇਾਂ ਉਹ ਵੀ ਮਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "अंत काल सो भी मरि गयो ॥",
      "sourceLineId": "135209",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਾਨਧਾਤ ਪ੍ਰਭ ਭੂਪ ਬਢਾਯੋ ॥",
      "transliteration": "maanadhaat prabh bhoop baddaayo ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨਧਾਤਾ ਨਾ ਦਾ ਇਕ ਵੱਡਾ ਰਾਜਾ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "मानधात प्रभ भूप बढायो ॥",
      "sourceLineId": "135210",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅੰਤ ਕਾਲ ਸੋਊ ਕਾਲ ਖਪਾਯੋ ॥੪॥",
      "transliteration": "a(n)t kaal souoo kaal khapaayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੀ ਅੰਤ ਵਿਚ ਕਾਲ ਨੇ ਖਪਾ ਦਿੱਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "अंत काल सोऊ काल खपायो ॥४॥",
      "sourceLineId": "135211",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੋ ਨਰ ਨਾਰਿ ਭਯੋ ਸੋ ਮਰਾ ॥",
      "transliteration": "jo nar naar bhayo so maraa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਸੰਸਾਰ ਵਿਚ) ਜੋ ਇਸਤਰੀ ਪੁਰਸ਼ ਪੈਦਾ ਹੋਇਆ ਹੈ, ਉਹ ਮਰ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "जो नर नारि भयो सो मरा ॥",
      "sourceLineId": "135212",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਯਾ ਜਗ ਮਹਿ ਕੋਊ ਨ ਉਬਰਾ ॥",
      "transliteration": "yaa jag meh kouoo na ubaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਜਗਤ ਵਿਚ ਕੋਈ ਵੀ ਬਚਿਆ ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "या जग महि कोऊ न उबरा ॥",
      "sourceLineId": "135213",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਹ ਜਗ ਥਿਰ ਏਕੈ ਕਰਤਾਰਾ ॥",
      "transliteration": "eeh jag thir ekai karataaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਜਗਤ ਵਿਚ ਇਕ ਕਰਤਾਰ ਹੀ ਸਥਾਈ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "इह जग थिर एकै करतारा ॥",
      "sourceLineId": "135214",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਔਰ ਮ੍ਰਿਤਕ ਇਹ ਸਗਲ ਸੰਸਾਰਾ ॥੫॥",
      "transliteration": "aauar mritak ieh sagal sa(n)saaraa ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਸਾਰਾ ਸੰਸਾਰ ਨਾਸ਼ਮਾਨ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "और मृतक इह सगल संसारा ॥५॥",
      "sourceLineId": "135215",
      "sourceShabadId": "12612",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "135216",
      "sourceShabadId": "12613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਯਾ ਜਗ ਮਹਿ ਸੋਈ ਜਿਯਤ ਪੁੰਨ੍ਯ ਦਾਨ ਜਿਨ ਕੀਨ ॥",
      "transliteration": "yaa jag meh soiee jiyat pu(n)nay dhaan jin keen ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਸੰਸਾਰ ਵਿਚ ਉਹੀ ਜੀਉਾਂਦਾ ਰਹਿੰਦਾ ਹੈ (ਭਾਵ ਅਮਰ ਹੈ) ਜਿਸ ਨੇ ਪੁੰਨ ਦਾਨ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "या जग महि सोई जियत पुँन्य दान जिन कीन ॥",
      "sourceLineId": "135217",
      "sourceShabadId": "12613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਿਖਿਯਨ ਕੀ ਸੇਵਾ ਕਰੀ ਜੋ ਮਾਗੈ ਸੋ ਦੀਨ ॥੬॥",
      "transliteration": "sikhiyan kee sevaa karee jo maagai so dheen ||6||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਸਿੱਖਾ (ਸੇਵਕਾ) ਦੀ ਸੇਵਾ ਕੀਤੀ ਹੈ (ਉਸ ਨੇ) ਜੋ ਮੰਗਿਆ ਹੈ, ਉਹੀ ਦਿੱਤਾ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "सिखियन की सेवा करी जो मागै सो दीन ॥६॥",
      "sourceLineId": "135218",
      "sourceShabadId": "12613",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135219",
      "sourceShabadId": "12614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਯਹ ਉਪਦੇਸ ਸੁਨਤ ਜੜ ਢਰਿਯੋ ॥",
      "transliteration": "yeh upadhes sunat jaR ddariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਉਪਦੇਸ਼ ਸੁਣ ਕੇ ਮੂਰਖ ਮਥੁਰਾ ਢਲ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "यह उपदेस सुनत जड़ ढरियो ॥",
      "sourceLineId": "135220",
      "sourceShabadId": "12614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਹੁਰਿ ਨਾਰਿ ਸੌ ਬਚਨ ਉਚਰਿਯੋ ॥",
      "transliteration": "bahur naar sau bachan uchariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਇਸਤਰੀ ਪ੍ਰਤਿ ਕਹਿਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "बहुरि नारि सौ बचन उचरियो ॥",
      "sourceLineId": "135221",
      "sourceShabadId": "12614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੋ ਉਪਜੈ ਜਿਯ ਭਲੀ ਤਿਹਾਰੈ ॥",
      "transliteration": "jo upajai jiy bhalee tihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਤੇਰੇ ਮਨ ਵਿਚ ਆਇਆ ਹੈ, ਉਹ ਠੀਕ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "जो उपजै जिय भली तिहारै ॥",
      "sourceLineId": "135222",
      "sourceShabadId": "12614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਵਹੈ ਕਾਮ ਮੈ ਕਰੌ ਸਵਾਰੈ ॥੭॥",
      "transliteration": "vahai kaam mai karau savaarai ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਕੰਮ ਮੈਂ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਕਰਾਗਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "वहै काम मै करौ सवारै ॥७॥",
      "sourceLineId": "135223",
      "sourceShabadId": "12614",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤ੍ਰਿਯ ਬਾਚ ॥",
      "transliteration": "tiray baach ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "तृय बाच ॥",
      "sourceLineId": "135224",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਫਟਾ ਬਸਤ੍ਰ ਜਾ ਕਾ ਲਖਿ ਲੀਜੈ ॥",
      "transliteration": "faTaa basatr jaa kaa lakh leejai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕਿਸੇ ਦਾ ਫਟਿਆ ਹੋਇਆ ਬਸਤ੍ਰ ਵੇਖੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "फटा बसत्र जा का लखि लीजै ॥",
      "sourceLineId": "135225",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਸਤ੍ਰ ਨਵੀਨ ਤੁਰਤ ਤਿਹ ਦੀਜੈ ॥",
      "transliteration": "basatr naveen turat teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਤੁਰਤ ਨਵੇਾਂ ਬਸਤ੍ਰ ਦੇ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "बसत्र नवीन तुरत तिह दीजै ॥",
      "sourceLineId": "135226",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਾ ਕੈ ਘਰਿ ਮਹਿ ਹੋਇ ਨ ਦਾਰਾ ॥",
      "transliteration": "jaa kai ghar meh hoi na dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਘਰ ਵਿਚ ਇਸਤਰੀ ਨਾ ਹੋਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "जा कै घरि महि होइ न दारा ॥",
      "sourceLineId": "135227",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਾ ਕਹ ਦੀਜੈ ਅਪਨੀ ਨਾਰਾ ॥੮॥",
      "transliteration": "taa keh dheejai apanee naaraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਆਪਣੀ ਇਸਤਰੀ ਦੇ ਦਿਓ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "ता कह दीजै अपनी नारा ॥८॥",
      "sourceLineId": "135228",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਰਾਮ ਦਾਸ ਤਬ ਤਾਹਿ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "raam dhaas tab taeh nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਮ ਦਾਸ ਨੇ ਤਦ ਉਸ ਵਲ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "राम दास तब ताहि निहारियो ॥",
      "sourceLineId": "135229",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਧਨ ਬਿਹੀਨ ਬਿਨੁ ਨਾਰਿ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "dhan biheen bin naar bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਧਨ ਤੋਂ ਸਖਣਾ ਅਤੇ ਇਸਤਰੀ ਤੋਂ ਬਿਨਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "धन बिहीन बिनु नारि बिचारियो ॥",
      "sourceLineId": "135230",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਧਨ ਹੂੰ ਦੀਯਾ ਨਾਰਿ ਹੂੰ ਦੀਨੀ ॥",
      "transliteration": "dhan hoo(n) dheeyaa naar hoo(n) dheenee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ ਮਥੁਰਾ ਨੇ) ਧਨ ਵੀ ਦੇ ਦਿੱਤਾ ਅਤੇ ਇਸਤਰੀ ਵੀ ਦੇ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "धन हूँ दीया नारि हूँ दीनी ॥",
      "sourceLineId": "135231",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਭਲੀ ਬੁਰੀ ਜੜ ਕਛੂ ਨ ਚੀਨੀ ॥੯॥",
      "transliteration": "bhalee buree jaR kachhoo na cheenee ||9||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੇ ਮਾੜੀ ਚੰਗੀ ਕੋਈ ਗੱਲ ਨਹੀਂ ਸੋਚੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "भली बुरी जड़ कछू न चीनी ॥९॥",
      "sourceLineId": "135232",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਇਹ ਛਲ ਗਈ ਜਾਰ ਕੇ ਨਾਰਾ ॥",
      "transliteration": "eeh chhal giee jaar ke naaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ (ਉਹ) ਇਸਤਰੀ ਯਾਰ ਨਾਲ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "इह छल गई जार के नारा ॥",
      "sourceLineId": "135233",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਬਸਤ੍ਰ ਦਰਬ ਲੈ ਸਾਥ ਅਪਾਰਾ ॥",
      "transliteration": "basatr dharab lai saath apaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਆਪਣੇ) ਨਾਲ ਬਹੁਤ ਸਾਰੇ ਬਸਤ੍ਰ ਅਤੇ ਧਨ ਲੈ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "बसत्र दरब लै साथ अपारा ॥",
      "sourceLineId": "135234",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਇਹ ਆਪਨ ਅਤਿ ਸਾਧ ਪਛਾਨਾ ॥",
      "transliteration": "eeh aapan at saadh pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ (ਭਾਵ-ਮਥੁਰਾ ਨੇ) ਆਪਣੇ ਆਪ ਨੂੰ ਵੱਡਾ ਸਾਧ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "इह आपन अति साध पछाना ॥",
      "sourceLineId": "135235",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਭਲੀ ਬੁਰੀ ਕਾ ਭੇਵ ਨ ਜਾਨਾ ॥੧੦॥",
      "transliteration": "bhalee buree kaa bhev na jaanaa ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਲੇ ਬੁਰੇ ਦਾ ਭੇਦ ਨਾ ਸਮਝਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "भली बुरी का भेव न जाना ॥१०॥",
      "sourceLineId": "135236",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੦॥੬੩੫੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chaalees charitr samaapatam sat subham sat ||340||6352||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੪੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੪੦॥੬੩੫੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ चालीस चरित्र समापतम सतु सुभम सतु ॥३४०॥६३५२॥अफजूँ॥",
      "sourceLineId": "135237",
      "sourceShabadId": "12615",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135238",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸੁਕ੍ਰਿਤਾਵਤੀ ਨਗਰ ਇਕ ਸੁਨਾ ॥",
      "transliteration": "sukirataavatee nagar ik sunaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਕ੍ਰਿਤਾਵਤੀ ਨਾ ਦਾ ਇਕ ਨਗਰ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "सुकृतावती नगर इक सुना ॥",
      "sourceLineId": "135239",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਸੁਕ੍ਰਿਤ ਸੈਨ ਰਾਜਾ ਬਹੁ ਗੁਨਾ ॥",
      "transliteration": "sukirat sain raajaa bahu gunaa ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਥੋਂ ਦਾ) ਸੁਕ੍ਰਿਤ ਸੈਨ ਨਾ ਦਾ ਬਹੁਤ ਗੁਣਵਾਨ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "सुकृत सैन राजा बहु गुना ॥",
      "sourceLineId": "135240",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਸੁਭ ਲਛਨਿ ਦੇ ਨਾਰਿ ਬਿਰਾਜੈ ॥",
      "transliteration": "subh lachhan dhe naar biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ (ਘਰ) ਸੁਭ ਲਛਨਿ ਦੇ (ਦੇਈ) ਇਸਤਰੀ ਰਹਿੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "सुभ लछनि दे नारि बिराजै ॥",
      "sourceLineId": "135241",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਚੰਦ੍ਰ ਸੂਰ ਕੀ ਲਖਿ ਦੁਤਿ ਲਾਜੈ ॥੧॥",
      "transliteration": "cha(n)dhr soor kee lakh dhut laajai ||1||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਵੇਖ ਕੇ ਚੰਦ੍ਰਮਾ ਅਤੇ ਸੂਰਜ ਦੀ ਜੋਤਿ (ਚਮਕ) ਸ਼ਰਮਾਉਾਂਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "चंद्र सूर की लखि दुति लाजै ॥१॥",
      "sourceLineId": "135242",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਸ੍ਰੀ ਅਪਛਰਾ ਦੇਇ ਸੁ ਬਾਲਾ ॥",
      "transliteration": "sree apachharaa dhei su baalaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਅਪੱਛਰਾ ਦੇਈ ਨਾ ਦੀ ਬਾਲਿਕਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "स्री अपछरा देइ सु बाला ॥",
      "sourceLineId": "135243",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਮਾਨਹੁ ਸਕਲ ਰਾਗ ਕੀ ਮਾਲਾ ॥",
      "transliteration": "maanahu sakal raag kee maalaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸਾਰਿਆਂ ਰਾਗਾ ਦੀ ਮਾਲਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "मानहु सकल राग की माला ॥",
      "sourceLineId": "135244",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਕਹੀ ਨ ਜਾਤ ਤਵਨ ਕੀ ਸੋਭਾ ॥",
      "transliteration": "kahee na jaat tavan kee sobhaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸ਼ੋਭਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "कही न जात तवन की सोभा ॥",
      "sourceLineId": "135245",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਇੰਦ੍ਰ ਚੰਦ੍ਰ ਜਸ ਰਵਿ ਲਖਿ ਲੋਭਾ ॥੨॥",
      "transliteration": "ei(n)dhr cha(n)dhr jas rav lakh lobhaa ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ ਇੰਦਰ, ਚੰਦ੍ਰਮਾ ਅਤੇ ਸੂਰਜ ਵੀ ਲੋਭੀ ਹੋ ਜਾਦੇ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "इंद्र चंद्र जस रवि लखि लोभा ॥२॥",
      "sourceLineId": "135246",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਤਹ ਇਕ ਆਇ ਗਯੋ ਸੌਦਾਗਰ ॥",
      "transliteration": "teh ik aai gayo sauadhaagar ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸੌਦਾਗਰ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "तह इक आइ गयो सौदागर ॥",
      "sourceLineId": "135247",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਪੂਤ ਸਾਥ ਤਿਹ ਜਾਨੁ ਪ੍ਰਭਾਕਰ ॥",
      "transliteration": "poot saath teh jaan prabhaakar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਸੂਰਜ ਵਰਗਾ ਪੁੱਤਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "पूत साथ तिह जानु प्रभाकर ॥",
      "sourceLineId": "135248",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਤਿਹ ਊਪਰ ਅਟਕੀ ॥",
      "transliteration": "raaj sutaa teh uoopar aTakee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਉਸ ਉਤੇ ਮੋਹਿਤ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "राज सुता तिह ऊपर अटकी ॥",
      "sourceLineId": "135249",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1293_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਚਟਪਟ ਲਾਜ ਲੋਕ ਕੀ ਸਟਕੀ ॥੩॥",
      "transliteration": "chaTapaT laaj lok kee saTakee ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੋਕ ਲਾਜ ਨੂੰ ਝਟਪਟ ਸੁਟ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1293,
      "hindi": "",
      "hindiTransliteration": "चटपट लाज लोक की सटकी ॥३॥",
      "sourceLineId": "135250",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
