{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1294,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1294_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਤੁਰਿ ਜਾਨਿ ਤਹ ਸਖੀ ਪਠਾਈ ॥",
      "transliteration": "chatur jaan teh sakhee paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਸਿਆਣੀ ਸਖੀ ਨੂੰ ਉਸ ਪਾਸ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "चतुरि जानि तह सखी पठाई ॥",
      "sourceLineId": "135251",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਤਹਾ ਤਾਹਿ ਲੈ ਆਈ ॥",
      "transliteration": "jayo(n) tayo(n) tahaa taeh lai aaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨੂੰ ਉਥੇ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "ज्यों त्यों तहा ताहि लै आई ॥",
      "sourceLineId": "135252",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਤਾ ਸੌ ਰਤਿ ਮਾਨੀ ॥",
      "transliteration": "raaj sutaa taa sau rat maanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਸ ਨਾਲ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "राज सुता ता सौ रति मानी ॥",
      "sourceLineId": "135253",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕੇਲ ਕਰਤ ਸਭ ਰਾਤਿ ਬਿਹਾਨੀ ॥੪॥",
      "transliteration": "kel karat sabh raat bihaanee ||4||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ-ਕੇਲਿ ਕਰਦਿਆਂ ਸਾਰੀ ਰਾਤ ਬਿਤਾ ਦਿੱਤੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "केल करत सभ राति बिहानी ॥४॥",
      "sourceLineId": "135254",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਾਢਾ ਬਿਰਹ ਦੁਹਨ ਕੋ ਐਸਾ ॥",
      "transliteration": "baaddaa bireh dhuhan ko aaisaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ) ਦੋਹਾ ਦਾ ਅਜਿਹਾ ਬਿਰਹਾ (ਪ੍ਰੇਮ) ਵਧਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "बाढा बिरह दुहन को ऐसा ॥",
      "sourceLineId": "135255",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਮ ਤੇ ਭਾਖਿ ਨ ਜਾਈ ਕੈਸਾ ॥",
      "transliteration": "ham te bhaakh na jaiee kaisaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੇਰੇ ਤੋਂ ਬਿਆਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ਕਿ (ਉਹ) ਕਿਹੋ ਜਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "हम ते भाखि न जाई कैसा ॥",
      "sourceLineId": "135256",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਏਕ ਛੋਰਿ ਇਕ ਅਨਤ ਨ ਜਾਵੈ ॥",
      "transliteration": "ek chhor ik anat na jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਨੂੰ ਛਡ ਕੇ ਦੂਜਾ ਕਿਤੇ ਨਹੀਂ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "एक छोरि इक अनत न जावै ॥",
      "sourceLineId": "135257",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਲਕ ਓਟ ਜੁਗ ਕੋਟਿ ਬਿਹਾਵੈ ॥੫॥",
      "transliteration": "palak oT jug koT bihaavai ||5||",
      "translation": "",
      "punjabiViakhya": "ਪਲਕ (ਦੇ ਝਪਕਣ ਜਿੰਨਾ) ਓਹਲਾ ਕਰੋੜ ਯੁਗਾ ਦੇ ਬੀਤਣ ਜਿੰਨਾ ਲਗਦਾ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "पलक ओट जुग कोटि बिहावै ॥५॥",
      "sourceLineId": "135258",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਕਰਿ ਬਦਾ ਸੰਕੇਤਾ ॥",
      "transliteration": "kaam bhog kar badhaa sa(n)ketaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ ਭੋਗ ਕਰਨ ਉਪਰੰਤ ਸੰਕੇਤ ਦਸਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "काम भोग करि बदा संकेता ॥",
      "sourceLineId": "135259",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਲਾਗਿਯੋ ਸਾਹ ਪੁਤ੍ਰ ਸੋ ਹੇਤਾ ॥",
      "transliteration": "laagiyo saeh putr so hetaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਨਾਲ ਪ੍ਰੇਮ ਹੋ ਗਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "लागियो साह पुत्र सो हेता ॥",
      "sourceLineId": "135260",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੁਹਿ ਅਪਨੇ ਲੈ ਸੰਗ ਸਿਧਾਰੋ ॥",
      "transliteration": "muh apane lai sa(n)g sidhaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੀ ਜੇ (ਤੂੰ) ਮੈਨੂੰ ਆਪਣੇ ਨਾਲ ਲੈ ਜਾਏਾਂ",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "मुहि अपने लै संग सिधारो ॥",
      "sourceLineId": "135261",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਬ ਜਾਨੌ ਤੈ ਯਾਰ ਹਮਾਰੋ ॥੬॥",
      "transliteration": "tab jaanau tai yaar hamaaro ||6||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤਦ ਹੀ ਤੈਨੂੰ ਆਪਣਾ ਮਿਤਰ ਸਮਝਾਗੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "तब जानौ तै यार हमारो ॥६॥",
      "sourceLineId": "135262",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾ ਸੌ ਰਤਿ ਕਰਿ ਧਾਮ ਸਿਧਾਯੋ ॥",
      "transliteration": "taa sau rat kar dhaam sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ (ਉਸ ਨਾਲ) ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ ਘਰ ਨੂੰ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "ता सौ रति करि धाम सिधायो ॥",
      "sourceLineId": "135263",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੀਯਾ ਜਤਨ ਜੋ ਹਿਤੂ ਸਿਖਾਯੋ ॥",
      "transliteration": "keeyaa jatan jo hitoo sikhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਹੀ ਯਤਨ ਕੀਤਾ ਜਿਵੇਾਂ ਕਿ ਹਿਤੂ (ਇਸਤਰੀ) ਨੇ ਸਿਖਾਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "कीया जतन जो हितू सिखायो ॥",
      "sourceLineId": "135264",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਸਤ੍ਰ ਬਹੁਤ ਬਹੁ ਮੋਲ ਪਠਾਏ ॥",
      "transliteration": "basatr bahut bahu mol paThaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬਹੁਤ ਮੁੱਲ ਵਾਲੇ ਕਪੜੇ (ਖ਼ਰੀਦ ਕੇ) ਭੇਜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "बसत्र बहुत बहु मोल पठाए ॥",
      "sourceLineId": "135265",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪ੍ਰਥਮ ਨ੍ਰਿਪਤਿ ਕਹ ਸਕਲ ਦਿਖਾਏ ॥੭॥",
      "transliteration": "pratham nirapat keh sakal dhikhaae ||7||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਸਾਰੇ ਰਾਜੇ ਨੂੰ ਵਿਖਾਏ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "प्रथम नृपति कह सकल दिखाए ॥७॥",
      "sourceLineId": "135266",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪੁਨਿ ਰਨਿਵਾਸਹਿ ਪਠੈ ਬਨਾਏ ॥",
      "transliteration": "pun ranivaaseh paThai banaae ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਹ (ਬਸਤ੍ਰ) ਰਣਵਾਸ ਵਿਚ ਭੇਜ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "पुनि रनिवासहि पठै बनाए ॥",
      "sourceLineId": "135267",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਾਜ ਸੁਤਹਿ ਅਸ ਗਯੋ ਜਤਾਏ ॥",
      "transliteration": "raaj suteh as gayo jataae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਵੀ ਇਸ ਤਰ੍ਰਹਾ ਦਸ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "राज सुतहि अस गयो जताए ॥",
      "sourceLineId": "135268",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੋ ਪਸੰਦ ਇਨ ਮੈ ਤੇ ਕੀਜੈ ॥",
      "transliteration": "jo pasa(n)dh in mai te keejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਵਿਚੋਂ ਜੋ ਪਸੰਦ ਕਰੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "जो पसंद इन मै ते कीजै ॥",
      "sourceLineId": "135269",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋ ਦੇ ਬਸਤ੍ਰ ਮੋਲਿ ਮੁਰਿ ਲੀਜੈ ॥੮॥",
      "transliteration": "so dhe basatr mol mur leejai ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੈਨੂੰ ਮੁੱਲ ਦੇ ਕੇ ਲੈ ਲਵੋ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "सो दे बसत्र मोलि मुरि लीजै ॥८॥",
      "sourceLineId": "135270",
      "sourceShabadId": "12616",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "135271",
      "sourceShabadId": "12617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਾਨੀ ਮਾਲੁ ਦਿਖਾਇ ਬਹੁਰਿ ਲੈ ਕੁਅਰਿ ਦਿਖਾਯੋ ॥",
      "transliteration": "raanee maal dhikhai bahur lai kuar dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ (ਸਾਰਾ) ਮਾਲ (ਬਸਤ੍ਰ) ਵੇਖ ਕੇ ਫਿਰ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਵਿਖਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "रानी मालु दिखाइ बहुरि लै कुअरि दिखायो ॥",
      "sourceLineId": "135272",
      "sourceShabadId": "12617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਲਪਟਿ ਤਰੁਨਿ ਤਿਹ ਮਾਹਿ ਆਪਨੋ ਅੰਗ ਦੁਰਾਯੋ ॥",
      "transliteration": "lapaT tarun teh maeh aapano a(n)g dhuraayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਨ੍ਰਹਾ ਬਸਤ੍ਰਾ ਵਿਚ ਲਿਪਟ ਕੇ ਆਪਣਾ ਸ਼ਰੀਰ ਲੁਕਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "लपटि तरुनि तिह माहि आपनो अंग दुरायो ॥",
      "sourceLineId": "135273",
      "sourceShabadId": "12617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗਈ ਮਿਤ੍ਰ ਕੇ ਧਾਮ ਨ ਭੂਪ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "giee mitr ke dhaam na bhoop bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਹ ਮਿਤਰ ਦੇ ਘਰ ਚਲੀ ਗਈ, ਪਰ ਰਾਜੇ ਨੇ ਕੋਈ ਵਿਚਾਰ ਨਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "गई मित्र के धाम न भूप बिचारियो ॥",
      "sourceLineId": "135274",
      "sourceShabadId": "12617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹੋ ਇਹ ਛਲ ਤਿਹ ਲੈ ਸਾਥ ਹਰੀਫ ਸਿਧਾਰਿਯੋ ॥੯॥",
      "transliteration": "ho ieh chhal teh lai saath hareef sidhaariyo ||9||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ (ਉਹ) 'ਹਰੀਫ਼' (ਮਿਤਰ) ਉਸ ਨੂੰ ਲੈ ਕੇ ਚਲਾ ਗਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "हो इह छल तिह लै साथ हरीफ सिधारियो ॥९॥",
      "sourceLineId": "135275",
      "sourceShabadId": "12617",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "135276",
      "sourceShabadId": "12618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭਾਗ ਨ ਭੌਦੂ ਪਿਯਤ ਥੋ ਰਾਹਤ ਭਯੌ ਪਰਬੀਨ ॥",
      "transliteration": "bhaag na bhauadhoo piyat tho raahat bhayau parabeen ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ ਆਪਣੇ ਆਪ ਨੂੰ) ਪ੍ਰਬੀਨ ਸਮਝਦਾ ਸੀ, ਪਰ ਉਹ ਮੂਰਖ ਭੰਗ ਨਹੀਂ ਪੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "भाग न भौदू पियत थो राहत भयौ परबीन ॥",
      "sourceLineId": "135277",
      "sourceShabadId": "12618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੁਹਿਤਾ ਹਰੀ ਹਰੀਫ ਯੌ ਸਕਾ ਨ ਜੜ ਛਲ ਚੀਨ ॥੧੦॥",
      "transliteration": "dhuhitaa haree hareef yau sakaa na jaR chhal cheen ||10||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਪੁੱਤਰੀ ਹਰ ਲਈ, ਉਹ ਮੂਰਖ ਛਲ ਨੂੰ ਸਮਝ ਨਾ ਸਕਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "दुहिता हरी हरीफ यौ सका न जड़ छल चीन ॥१०॥",
      "sourceLineId": "135278",
      "sourceShabadId": "12618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੧॥੬੩੬੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau ikataalees charitr samaapatam sat subham sat ||341||6362||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੪੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੪੧॥੬੩੬੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ इकतालीस चरित्र समापतम सतु सुभम सतु ॥३४१॥६३६२॥अफजूँ॥",
      "sourceLineId": "135279",
      "sourceShabadId": "12618",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135280",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਉਤਰ ਦਿਸਾ ਪ੍ਰਗਟ ਇਕ ਨਗਰੀ ॥",
      "transliteration": "autar dhisaa pragaT ik nagaree ||",
      "translation": "",
      "punjabiViakhya": "ਉੱਤਰ ਦਿਸ਼ਾ ਵਿਚ  ਇਕ ਪ੍ਰਮੁਖ ਅਤੇ ਪ੍ਰਸਿੱਧ ਨਗਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "उतर दिसा प्रगट इक नगरी ॥",
      "sourceLineId": "135281",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸ੍ਰੀ ਬ੍ਰਿਜਰਾਜਵਤੀ ਸੁ ਉਜਗਰੀ ॥",
      "transliteration": "sree birajaraajavatee su ujagaree ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਿਜਰਾਜਵਤੀ ਨਾ ਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "स्री बृजराजवती सु उजगरी ॥",
      "sourceLineId": "135282",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸ੍ਰੀ ਬ੍ਰਿਜਰਾਜ ਸੈਨ ਤਹ ਰਾਜਾ ॥",
      "transliteration": "sree birajaraaj sain teh raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਿਜਰਾਜ ਸੈਨ ਉਥੋਂ ਦਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "स्री बृजराज सैन तह राजा ॥",
      "sourceLineId": "135283",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾ ਕਹ ਨਿਰਖਿ ਇੰਦ੍ਰ ਅਤਿ ਲਾਜਾ ॥੧॥",
      "transliteration": "jaa keh nirakh i(n)dhr at laajaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਇੰਦਰ ਵੀ ਲਜਾਉਾਂਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "जा कह निरखि इंद्र अति लाजा ॥१॥",
      "sourceLineId": "135284",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸ੍ਰੀ ਬ੍ਰਿਜਰਾਜ ਮਤੀ ਤਿਹ ਰਾਨੀ ॥",
      "transliteration": "sree birajaraaj matee teh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਰਾਣੀ ਬ੍ਰਿਜਰਾਜ ਮਤੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "स्री बृजराज मती तिह रानी ॥",
      "sourceLineId": "135285",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁੰਦਰਿ ਭਵਨ ਚਤਰਦਸ ਜਾਨੀ ॥",
      "transliteration": "su(n)dhar bhavan chataradhas jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਸੁੰਦਰ ਮੰਨੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "सुँदरि भवन चतरदस जानी ॥",
      "sourceLineId": "135286",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸ੍ਰੀ ਬਰੰਗਨਾ ਦੇ ਤਿਹ ਬਾਲਾ ॥",
      "transliteration": "sree bara(n)ganaa dhe teh baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਘਰ ਬਰੰਗਨਾ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "स्री बरंगना दे तिह बाला ॥",
      "sourceLineId": "135287",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਨੁ ਨਿਰਧੂਮ ਅਗਨਿ ਕੀ ਜ੍ਵਾਲਾ ॥੨॥",
      "transliteration": "jan niradhoom agan kee javaiaalaa ||2||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਧੂੰਏਾਂ ਤੋਂ ਬਿਨਾ ਅੱਗ ਦੀ ਲਾਟ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "जनु निरधूम अगनि की ज्वाला ॥२॥",
      "sourceLineId": "135288",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚਤੁਰਿ ਸਖੀ ਜਬ ਤਾਹਿ ਨਿਹਾਰੈ ॥",
      "transliteration": "chatur sakhee jab taeh nihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸਿਆਣੀਆਂ ਸਹੇਲੀਆਂ ਉਸ ਨੂੰ ਵੇਖਦੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "चतुरि सखी जब ताहि निहारै ॥",
      "sourceLineId": "135289",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਧੁਰ ਬਚਨ ਮਿਲਿ ਐਸ ਉਚਾਰੈ ॥",
      "transliteration": "madhur bachan mil aais uchaarai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਿਲ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਮਿਠੇ ਬੋਲ ਬੋਲਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "मधुर बचन मिलि ऐस उचारै ॥",
      "sourceLineId": "135290",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੈਸੀ ਇਹ ਹੈ ਦੁਤਿਯ ਨ ਜਈ ॥",
      "transliteration": "jaisee ieh hai dhutiy na jiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੋ ਜਿਹੀ ਇਹ ਹੈ, ਦੂਜੀ ਕੋਈ ਪੈਦਾ ਨਹੀਂ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "जैसी इह है दुतिय न जई ॥",
      "sourceLineId": "135291",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਗੇ ਹੋਇ ਨ ਪਾਛੇ ਭਈ ॥੩॥",
      "transliteration": "aage hoi na paachhe bhiee ||3||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਅਗੇ ਹੋਈ ਹੈ, ਨਾ ਬਾਦ ਵਿਚ ਹੋਵੇਗੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "आगे होइ न पाछे भई ॥३॥",
      "sourceLineId": "135292",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਬ ਬਰੰਗਨਾ ਦੇਇ ਤਰੁਨਿ ਭੀ ॥",
      "transliteration": "jab bara(n)ganaa dhei tarun bhee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬਰੰਗਨਾ ਦੇਈ ਜਵਾਨ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "जब बरंगना देइ तरुनि भी ॥",
      "sourceLineId": "135293",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਲਰਿਕਾਪਨ ਕੀ ਬਾਤ ਬਿਸਰਿਗੀ ॥",
      "transliteration": "larikaapan kee baat bisarigee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਚਪਨ ਦੀ ਗੱਲ ਭੁਲ ਗਈ (ਅਰਥਾਤ ਭਰ ਜਵਾਨ ਹੋ ਗਈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "लरिकापन की बात बिसरिगी ॥",
      "sourceLineId": "135294",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਤਬ ਤਾਹਿ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "raaj kuar tab taeh nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਇਕ) ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਉਸ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "राज कुअर तब ताहि निहारियो ॥",
      "sourceLineId": "135295",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਾ ਪਰ ਤਰੁਨਿ ਪ੍ਰਾਨ ਕਹ ਵਾਰਿਯੋ ॥੪॥",
      "transliteration": "taa par tarun praan keh vaariyo ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਉਤੇ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਪ੍ਰਾਣ ਵਾਰ ਦਿੱਤੇ (ਭਾਵ-ਮੋਹਿਤ ਹੋ ਗਈ) ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "ता पर तरुनि प्रान कह वारियो ॥४॥",
      "sourceLineId": "135296",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਾ ਸੌ ਕਾਮ ਭੋਗ ਨਿਤ ਮਾਨੈ ॥",
      "transliteration": "taa sau kaam bhog nit maanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਰਾਜ ਕੁਮਾਰ) ਨਾਲ ਨਿੱਤ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1294,
      "hindi": "",
      "hindiTransliteration": "ता सौ काम भोग नित मानै ॥",
      "sourceLineId": "135297",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1294_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦ੍ਵੈ ਤੈ ਏਕ ਦੇਹ ਕਰਿ ਜਾਨੈ ॥",
      "transliteration": "dhavai tai ek dheh kar jaanai ||",
