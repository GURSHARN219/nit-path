{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1295,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1295_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਬ ਚਤੁਰਾ ਇਹ ਚਰਿਤ੍ਰ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "tab chaturaa ieh charitr bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਚਤੁਰ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਇਹ ਚਰਿਤ੍ਰ ਵਿਚਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "तब चतुरा इह चरित्र बिचारियो ॥",
      "sourceLineId": "135299",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਹੋ ਨ੍ਰਿਪਤਿ ਸੋ ਪ੍ਰਗਟ ਉਚਾਰਿਯੋ ॥੫॥",
      "transliteration": "kaho nirapat so pragaT uchaariyo ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਸਾਫ ਸਾਫ ਕਿਹਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "कहो नृपति सो प्रगट उचारियो ॥५॥",
      "sourceLineId": "135300",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੋ ਕੌ ਸ੍ਰਾਪ ਸਦਾ ਸਿਵ ਦੀਨਾ ॥",
      "transliteration": "mo kau sraap sadhaa siv dheenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਹੇ ਪਿਤਾ ਜੀ!) ਮੈਨੂੰ ਸਦਾ ਸ਼ਿਵ ਨੇ ਸ੍ਰਾਪ ਦਿੱਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "मो कौ स्राप सदा सिव दीना ॥",
      "sourceLineId": "135301",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਾ ਤੇ ਜਨਮ ਤਿਹਾਰੇ ਲੀਨਾ ॥",
      "transliteration": "taa te janam tihaare leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸੇ ਕਰ ਕੇ ਤੁਹਾਡੇ ਘਰ ਜਨਮ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "ता ते जनम तिहारे लीना ॥",
      "sourceLineId": "135302",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸ੍ਰਾਪ ਅਵਧਿ ਪੂਰਨ ਹ੍ਵੈ ਹੈ ਜਬ ॥",
      "transliteration": "sraap avadh pooran havai hai jab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸ੍ਰਾਪ ਦਾ ਸਮਾ ਪੂਰਾ ਹੋ ਜਾਏਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "स्राप अवधि पूरन ह्वै है जब ॥",
      "sourceLineId": "135303",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪੁਨਿ ਜੈ ਹੌ ਹਰਿ ਲੋਕ ਬਿਖੈ ਤਬ ॥੬॥",
      "transliteration": "pun jai hau har lok bikhai tab ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮੈਂ ਫਿਰ ਸਵਰਗ ਲੋਕ ਵਿਚ ਚਲੀ ਜਾਵਾਗੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "पुनि जै हौ हरि लोक बिखै तब ॥६॥",
      "sourceLineId": "135304",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਇਕ ਦਿਨ ਗਈ ਮਿਤ੍ਰ ਕੇ ਸੰਗਾ ॥",
      "transliteration": "eik dhin giee mitr ke sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਉਹ ਆਪਣੇ ਹੱਥ ਨਾਲ ਚਿੱਠੀ ਲਿਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "इक दिन गई मित्र के संगा ॥",
      "sourceLineId": "135305",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਲਿਖਿ ਪਤ੍ਰਾ ਪਰ ਅਪਨੇ ਅੰਗਾ ॥",
      "transliteration": "likh patraa par apane a(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "(ਆਪਣੇ) ਮਿਤਰ ਨਾਲ ਨਿਕਲ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "लिखि पत्रा पर अपने अंगा ॥",
      "sourceLineId": "135306",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸ੍ਰਾਪ ਅਵਧਿ ਪੂਰਨ ਅਬ ਭਈ ॥",
      "transliteration": "sraap avadh pooran ab bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਚਿੱਠੀ ਵਿਚ ਉਸ ਨੇ ਲਿਖਿਆ ਕਿ) ਹੁਣ ਸ੍ਰਾਪ ਦਾ ਸਮਾ ਪੂਰਾ ਹੋ ਗਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "स्राप अवधि पूरन अब भई ॥",
      "sourceLineId": "135307",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁਰਪੁਰ ਸੁਤਾ ਤਿਹਾਰੀ ਗਈ ॥੭॥",
      "transliteration": "surapur sutaa tihaaree giee ||7||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਤੁਹਾਡੀ ਪੁੱਤਰੀ ਸਵਰਗ ਨੂੰ ਚਲੀ ਗਈ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "सुरपुर सुता तिहारी गई ॥७॥",
      "sourceLineId": "135308",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਬ ਜੋ ਧਾਮ ਹਮਾਰੇ ਮਾਲਾ ॥",
      "transliteration": "ab jo dhaam hamaare maalaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਜੋ ਮੇਰੇ ਘਰ ਧਨ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "अब जो धाम हमारे माला ॥",
      "sourceLineId": "135309",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੋ ਦੀਜੈ ਦਿਜ ਕੌ ਤਤਕਾਲਾ ॥",
      "transliteration": "so dheejai dhij kau tatakaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਤੁਰਤ ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਦੇ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "सो दीजै दिज कौ ततकाला ॥",
      "sourceLineId": "135310",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਯਾਰ ਅਪਨੇ ਬ੍ਰਹਮਨ ਠਹਰਾਯੋ ॥",
      "transliteration": "yaar apane brahaman Thaharaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਪਣੇ ਯਾਰ ਨੂੰ ਹੀ ਬ੍ਰਾਹਮਣ ਬਣਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "यार अपने ब्रहमन ठहरायो ॥",
      "sourceLineId": "135311",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਕਲ ਦਰਬ ਇਹ ਛਲ ਤਿਹ ਦ੍ਰਯਾਯੋ ॥੮॥",
      "transliteration": "sakal dharab ieh chhal teh dhrayaayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਸਾਰਾ ਧਨ ਉਸ ਨੂੰ ਦਿਵਾ ਦਿੱਤਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "सकल दरब इह छल तिह द्रयायो ॥८॥",
      "sourceLineId": "135312",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਗੀ ਮਿਤ੍ਰਹ ਸਾਥਾ ॥",
      "transliteration": "eeh charitr gee mitreh saathaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਉਹ ਮਿਤਰ ਦੇ ਨਾਲ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र गी मित्रह साथा ॥",
      "sourceLineId": "135313",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੈ ਧਨ ਕਿਯਾ ਅਨਾਥ ਸਨਾਥਾ ॥",
      "transliteration": "dhai dhan kiyaa anaath sanaathaa ||",
      "translation": "",
      "punjabiViakhya": "ਧਨ ਦੇ ਕੇ ਗ਼ਰੀਬ (ਯਾਰ) ਨੂੰ ਧਨਵਾਨ ਬਣਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "दै धन किया अनाथ सनाथा ॥",
      "sourceLineId": "135314",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਸਭ ਅਸ ਲਖਿ ਲਈ ॥",
      "transliteration": "maat pitaa sabh as lakh liee ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਤਾ ਪਿਤਾ ਨੇ ਇਹ ਸਮਝ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "मात पिता सभ अस लखि लई ॥",
      "sourceLineId": "135315",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸ੍ਰਾਪ ਮੁਚਿਤ ਭਯੋ ਸੁਰਪੁਰ ਗਈ ॥੯॥",
      "transliteration": "sraap muchit bhayo surapur giee ||9||",
      "translation": "",
      "punjabiViakhya": "ਸ੍ਰਾਪ ਦੇ ਖ਼ਤਮ ਹੋਣ ਤੇ ਸਵਰਗ ਨੂੰ ਚਲੀ ਗਈ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "स्राप मुचित भयो सुरपुर गई ॥९॥",
      "sourceLineId": "135316",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਬਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੨॥੬੩੭੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau bataalees charitr samaapatam sat subham sat ||342||6371||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੪੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੪੨॥੬੩੭੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ बतालीस चरित्र समापतम सतु सुभम सतु ॥३४२॥६३७१॥अफजूँ॥",
      "sourceLineId": "135317",
      "sourceShabadId": "12619",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135318",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੋਰਠ ਦੇਸ ਬਸਤ ਹੈ ਜਹਾ ॥",
      "transliteration": "soraTh dhes basat hai jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਸੋਰਠ ਨਾ ਦਾ ਦੇਸ਼ ਵਸਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "सोरठ देस बसत है जहा ॥",
      "sourceLineId": "135319",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦਿਜਬਰ ਸੈਨ ਨਰਾਧਿਪ ਤਹਾ ॥",
      "transliteration": "dhijabar sain naraadhip tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਦਿਜਬਰ ਸੈਨ ਨਾ ਦਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "दिजबर सैन नराधिप तहा ॥",
      "sourceLineId": "135320",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਤੀ ਸੁਮੇਰ ਤਵਨ ਕੀ ਨਾਰੀ ॥",
      "transliteration": "matee sumer tavan kee naaree ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਮੇਰ ਮਤੀ ਉਸ ਦੀ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "मती सुमेर तवन की नारी ॥",
      "sourceLineId": "135321",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੁਤਿਯ ਨ ਜਗ ਮੈ ਐਸਿ ਕੁਮਾਰੀ ॥੧॥",
      "transliteration": "dhutiy na jag mai aais kumaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਸੰਸਾਰ ਵਿਚ ਕੋਈ ਹੋਰ ਇਸਤਰੀ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "दुतिय न जग मै ऐसि कुमारी ॥१॥",
      "sourceLineId": "135322",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੋਰਠ ਦੇਇ ਸੁਤਾ ਇਕ ਤਾ ਕੇ ॥",
      "transliteration": "soraTh dhei sutaa ik taa ke ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਰਠ ਦੇਈ ਨਾ ਦੀ ਉਸ ਦੀ ਇਕ ਪੁੱਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "सोरठ देइ सुता इक ता के ॥",
      "sourceLineId": "135323",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਔਰ ਨਾਰ ਸਮ ਤੁਲਿ ਨ ਵਾ ਕੇ ॥",
      "transliteration": "aauar naar sam tul na vaa ke ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਬਰਾਬਰ ਹੋਰ ਕੋਈ ਇਸਤਰੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "और नार सम तुलि न वा के ॥",
      "sourceLineId": "135324",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੁਤਿਯ ਪਰਜ ਦੇ ਭਈ ਕੁਮਾਰੀ ॥",
      "transliteration": "dhutiy paraj dhe bhiee kumaaree ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਜ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਦੂਜੀ ਕੁਮਾਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "दुतिय परज दे भई कुमारी ॥",
      "sourceLineId": "135325",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਿਹ ਸੀ ਦੁਤਿਯ ਨ ਬ੍ਰਹਮ ਸਵਾਰੀ ॥੨॥",
      "transliteration": "jeh see dhutiy na braham savaaree ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਬ੍ਰਹਮਾ ਨੇ ਕੋਈ ਹੋਰ ਨਹੀਂ ਬਣਾਈ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "जिह सी दुतिय न ब्रहम सवारी ॥२॥",
      "sourceLineId": "135326",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੋਊ ਸੁਤਾ ਤਰੁਨਿ ਜਬ ਭਈ ॥",
      "transliteration": "dhouoo sutaa tarun jab bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੋਵੇਾਂ ਪੁੱਤਰੀਆਂ ਜਵਾਨ ਹੋ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "दोऊ सुता तरुनि जब भई ॥",
      "sourceLineId": "135327",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਨ ਕਰਿ ਕਿਰਣਿ ਸੂਰ ਸਸਿ ਵਈ ॥",
      "transliteration": "jan kar kiran soor sas viee ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਇੰਜ ਲਗਦੀਆਂ ਸਨ) ਮਾਨੋ ਸੂਰਜ ਅਤੇ ਚੰਦ੍ਰਮਾ ਦੀਆਂ ਕਿਰਨਾ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "जन करि किरणि सूर ससि वई ॥",
      "sourceLineId": "135328",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਐਸੀ ਪ੍ਰਭਾ ਹੋਤ ਭੀ ਤਿਨ ਕੀ ॥",
      "transliteration": "aaisee prabhaa hot bhee tin kee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਅਜਿਹੀ ਸੁੰਦਰਤਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "ऐसी प्रभा होत भी तिन की ॥",
      "sourceLineId": "135329",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਾਛਾ ਕਰਤ ਬਿਧਾਤਾ ਜਿਨ ਕੀ ॥੩॥",
      "transliteration": "baachhaa karat bidhaataa jin kee ||3||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਿਨ੍ਰਹਾ ਨੂੰ (ਪ੍ਰਾਪਤ ਕਰਨ ਦੀ) ਇੱਛਾ ਬ੍ਰਹਮਾ ਵੀ ਕਰਦਾ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "बाछा करत बिधाता जिन की ॥३॥",
      "sourceLineId": "135330",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਓਜ ਸੈਨ ਇਕ ਅਨਤ ਨ੍ਰਿਪਤਿ ਬਰ ॥",
      "transliteration": "oj sain ik anat nirapat bar ||",
      "translation": "",
      "punjabiViakhya": "ਓਜ ਸੈਨ ਨਾ ਦਾ ਇਕ ਹੋਰ ਸ੍ਰੇਸ਼ਠ ਰਾਜਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "ओज सैन इक अनत नृपति बर ॥",
      "sourceLineId": "135331",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਨੁ ਕਰਿ ਮੈਨ ਪ੍ਰਗਟਿਯੋ ਬਪੁ ਧਰਿ ॥",
      "transliteration": "jan kar main pragaTiyo bap dhar ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਮ ਦੇਵ ਹੀ ਸ਼ਰੀਰ ਧਾਰਨ ਕਰ ਕੇ ਪ੍ਰਗਟਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "जनु करि मैन प्रगटियो बपु धरि ॥",
      "sourceLineId": "135332",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੋ ਨ੍ਰਿਪ ਖੇਲਨ ਚੜਾ ਸਿਕਾਰਾ ॥",
      "transliteration": "so nirap khelan chaRaa sikaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜਾ ਸ਼ਿਕਾਰ ਖੇਡਣ ਲਈ ਚੜ੍ਰਹਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "सो नृप खेलन चड़ा सिकारा ॥",
      "sourceLineId": "135333",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰੋਝ ਰੀਛ ਮਾਰੇ ਝੰਖਾਰਾ ॥੪॥",
      "transliteration": "rojh reechh maare jha(n)khaaraa ||4||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰੋਜ਼, ਰਿਛ ਅਤੇ ਬਾਰਾਸਿੰਗੇ ਮਾਰੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "रोझ रीछ मारे झंखारा ॥४॥",
      "sourceLineId": "135334",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਿਕਸਿਯੋ ਤਹਾ ਏਕ ਝੰਖਾਰਾ ॥",
      "transliteration": "nikasiyo tahaa ek jha(n)khaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਬਾਰਾਸਿੰਗਾ ਨਿਕਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "निकसियो तहा एक झंखारा ॥",
      "sourceLineId": "135335",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦ੍ਵਾਦਸ ਜਾ ਕੇ ਸੀਗ ਅਪਾਰਾ ॥",
      "transliteration": "dhavaiaadhas jaa ke seeg apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਬਾਰ੍ਰਹਾ ਲੰਬੇ ਸਿੰਗ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "द्वादस जा के सीग अपारा ॥",
      "sourceLineId": "135336",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨ੍ਰਿਪ ਤਿਹ ਨਿਰਖਿ ਤੁਰੰਗ ਧਵਾਵਾ ॥",
      "transliteration": "nirap teh nirakh tura(n)g dhavaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਰਾਜੇ ਨੇ ਘੋੜਾ ਭਜਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "नृप तिह निरखि तुरंग धवावा ॥",
      "sourceLineId": "135337",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਾਛੇ ਚਲਾ ਕੋਸ ਬਹੁ ਆਵਾ ॥੫॥",
      "transliteration": "paachhe chalaa kos bahu aavaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਪਿਛੇ ਕਈ ਕੋਹ ਚਲ ਕੇ ਆ ਗਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "पाछे चला कोस बहु आवा ॥५॥",
      "sourceLineId": "135338",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਹੁਤ ਕੋਸ ਤਿਹ ਮ੍ਰਿਗਹਿ ਦਖੇਰਾ ॥",
      "transliteration": "bahut kos teh mirageh dhakheraa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਕੋਹਾ ਤਕ ਉਹ ਮਿਰਗ ਦਿਖਦਾ ਰਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "बहुत कोस तिह मृगहि दखेरा ॥",
      "sourceLineId": "135339",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚਾਕਰ ਏਕ ਨ ਪਹੁਚਾ ਨੇਰਾ ॥",
      "transliteration": "chaakar ek na pahuchaa neraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤਕ ਕੋਈ ਸੇਵਕ ਨਾ ਪਹੁੰਚ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "चाकर एक न पहुचा नेरा ॥",
      "sourceLineId": "135340",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਯੋ ਦੇਸ ਸੋਰਠੀ ਕੇ ਮਹਿ ॥",
      "transliteration": "aayo dhes soraThee ke meh ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸੋਰਠੀ ਦੇਸ਼ ਵਿਚ (ਉਥੇ) ਆ ਪਹੁੰਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "आयो देस सोरठी के महि ॥",
      "sourceLineId": "135341",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੀ ਸੁਤਾ ਅਨਾਤ ਹੁਤੀ ਜਹਿ ॥੬॥",
      "transliteration": "nirap kee sutaa anaat hutee jeh ||6||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਜੇ ਦੀਆਂ ਪੁੱਤਰੀਆਂ ਇਸ਼ਨਾਨ ਕਰ ਰਹੀਆਂ ਸਨ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "नृप की सुता अनात हुती जहि ॥६॥",
      "sourceLineId": "135342",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਨਿ ਤਹੀ ਝੰਖਾਰ ਨਿਕਾਰਾ ॥",
      "transliteration": "aan tahee jha(n)khaar nikaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਰਾਸਿੰਗਾ ਉਥੇ ਆ ਨਿਕਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "आनि तही झंखार निकारा ॥",
      "sourceLineId": "135343",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਬਲਾ ਦੁਹੂੰ ਨਿਹਾਰਤਿ ਮਾਰਾ ॥",
      "transliteration": "abalaa dhuhoo(n) nihaarat maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੋਹਾ ਰਾਜ ਕੁਮਾਰੀਆਂ ਦੇ ਵੇਖਦੇ ਹੋਇਆਂ (ਬਾਰਾਸਿੰਗੇ ਨੂੰ) ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "अबला दुहूँ निहारति मारा ॥",
      "sourceLineId": "135344",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਐਸਾ ਬਾਨ ਤਵਨ ਕਹ ਲਾਗਾ ॥",
      "transliteration": "aaisaa baan tavan keh laagaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਅਜਿਹਾ ਤੀਰ ਵਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "ऐसा बान तवन कह लागा ॥",
      "sourceLineId": "135345",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1295_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਠੌਰ ਰਹਾ ਪਗ ਦ੍ਵੈਕ ਨ ਭਾਗਾ ॥੭॥",
      "transliteration": "Thauar rahaa pag dhavaik na bhaagaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਉਹ ਥਾ ਹੀ ਰਿਹਾ, ਦੋ ਕਦਮ ਵੀ ਨਾ ਭਜ ਸਕਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1295,
      "hindi": "",
      "hindiTransliteration": "ठौर रहा पग द्वैक न भागा ॥७॥",
      "sourceLineId": "135346",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
