{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1296,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1296_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਜ ਕੁਆਰੀ ਦੁਹੂੰ ਨਿਹਾਰੋ ॥",
      "transliteration": "raaj kuaaree dhuhoo(n) nihaaro ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੋਹਾ ਰਾਜ ਕੁਮਾਰੀਆਂ ਨੇ (ਉਸ ਰਾਜੇ ਨੂੰ) ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "राज कुआरी दुहूँ निहारो ॥",
      "sourceLineId": "135347",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੁਹੂੰ ਹ੍ਰਿਦੈ ਇਹ ਭਾਤਿ ਬਿਚਾਰੋ ॥",
      "transliteration": "dhuhoo(n) hiradhai ieh bhaat bichaaro ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਦੋਹਾ ਨੇ ਮਨ ਵਿਚ ਇਸ ਪ੍ਰਕਾਰ ਸੋਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "दुहूँ हृदै इह भाति बिचारो ॥",
      "sourceLineId": "135348",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਨੁ ਪੂਛੇ ਪਿਤੁ ਇਹ ਹਮ ਬਰਿ ਹੈ ॥",
      "transliteration": "bin poochhe pit ieh ham bar hai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਬਿਨਾ ਪਿਤਾ ਦੇ ਪੁਛਿਆਂ ਹੀ ਇਸ ਨੂੰ ਅਸੀਂ ਵਰਾਗੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "बिनु पूछे पितु इह हम बरि है ॥",
      "sourceLineId": "135349",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਤਰ ਮਾਰਿ ਕਟਾਰੀ ਮਰਿ ਹੈ ॥੮॥",
      "transliteration": "naatar maar kaTaaree mar hai ||8||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਕਟਾਰੀ ਮਾਰ ਕੇ ਮਰ ਜਾਵਾਗੀਆਂ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "नातर मारि कटारी मरि है ॥८॥",
      "sourceLineId": "135350",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਬ ਲਗੁ ਭੂਪ ਤ੍ਰਿਖਾਤੁਰ ਭਯੋ ॥",
      "transliteration": "tab lag bhoop tirakhaatur bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਰਾਜੇ ਨੂੰ ਪਿਆਸ ਨੇ ਸਤਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "तब लगु भूप तृखातुर भयो ॥",
      "sourceLineId": "135351",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮ੍ਰਿਗ ਕੇ ਸਹਿਤ ਤਹਾ ਚਲਿ ਗਯੋ ॥",
      "transliteration": "mirag ke sahit tahaa chal gayo ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਰਾਸਿੰਗੇ ਸਹਿਤ ਉਥੇ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "मृग के सहित तहा चलि गयो ॥",
      "sourceLineId": "135352",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੋ ਮ੍ਰਿਗ ਰਾਜ ਸੁ ਤਨ ਕਹ ਦੀਯੋ ॥",
      "transliteration": "so mirag raaj su tan keh dheeyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਉਹ ਬਾਰਾਸਿੰਗਾ ਉਨ੍ਰਹਾ ਨੂੰ ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "सो मृग राज सु तन कह दीयो ॥",
      "sourceLineId": "135353",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਿਨ ਕੋ ਸੀਤ ਬਾਰਿ ਲੈ ਪੀਯੋ ॥੯॥",
      "transliteration": "tin ko seet baar lai peeyo ||9||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਠੰਡਾ ਪਾਣੀ ਲੈ ਕੇ ਪੀਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "तिन को सीत बारि लै पीयो ॥९॥",
      "sourceLineId": "135354",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਾਧਾ ਬਾਜ ਏਕ ਦ੍ਰੁਮ ਕੇ ਤਰ ॥",
      "transliteration": "baadhaa baaj ek dhrum ke tar ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜੇ ਨੂੰ ਇਕ ਬ੍ਰਿਛ ਹੇਠਾ ਬੰਨ੍ਰਹ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "बाधा बाज एक द्रुम के तर ॥",
      "sourceLineId": "135355",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੋਵਤ ਭਯੋ ਹ੍ਵੈ ਭੂਪ ਸ੍ਰਮਾਤੁਰ ॥",
      "transliteration": "sovat bhayo havai bhoop sramaatur ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜਾ ਥਕਿਆ ਹੋਣ ਕਰ ਕੇ ਸੌਂ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "सोवत भयो ह्वै भूप स्रमातुर ॥",
      "sourceLineId": "135356",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਜ ਕੁਆਰਨ ਘਾਤ ਪਛਾਨਾ ॥",
      "transliteration": "raaj kuaaran ghaat pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀਆਂ ਨੇ ਮੌਕਾ ਤਾੜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "राज कुआरन घात पछाना ॥",
      "sourceLineId": "135357",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਖਿਯਨ ਸੋ ਅਸ ਕਿਯਾ ਬਖਾਨਾ ॥੧੦॥",
      "transliteration": "sakhiyan so as kiyaa bakhaanaa ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਖੀਆਂ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਦਸਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "सखियन सो अस किया बखाना ॥१०॥",
      "sourceLineId": "135358",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਦਰਾ ਬਹੁ ਦੁਹੂੰ ਕੁਅਰਿ ਮੰਗਾਯੋ ॥",
      "transliteration": "madharaa bahu dhuhoo(n) kuar ma(n)gaayo ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਰਾਜ ਕੁਮਾਰੀਆਂ ਨੇ ਬਹੁਤ ਸਾਰੀ ਸ਼ਰਾਬ ਮੰਗਾ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "मदरा बहु दुहूँ कुअरि मंगायो ॥",
      "sourceLineId": "135359",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਾਤ ਬਾਰ ਜੋ ਹੁਤੋ ਚੁਆਯੋ ॥",
      "transliteration": "saat baar jo huto chuaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੀ ਸੱਤ ਵਾਰ ਕੱਢੀ ਗਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "सात बार जो हुतो चुआयो ॥",
      "sourceLineId": "135360",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਪਨ ਸਹਿਤ ਸਖਿਯਨ ਕੌ ਪ੍ਰਯਾਇ ॥",
      "transliteration": "apan sahit sakhiyan kau prayai ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਸਹਿਤ ਸਖੀਆਂ ਨੂੰ ਪਿਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "अपन सहित सखियन कौ प्रयाइ ॥",
      "sourceLineId": "135361",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਧਿਕ ਮਤ ਕਰਿ ਦਈ ਸੁਵਾਇ ॥੧੧॥",
      "transliteration": "adhik mat kar dhiee suvai ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਰਹਾ ਨੂੰ) ਬਹੁਤ ਮਦ-ਮਸਤ ਕਰ ਕੇ ਸੰਵਾ ਦਿੱਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "अधिक मत करि दई सुवाइ ॥११॥",
      "sourceLineId": "135362",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਬ ਜਾਨਾ ਤੇ ਭਈ ਦਿਵਾਨੀ ॥",
      "transliteration": "jab jaanaa te bhiee dhivaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਨ੍ਰਹਾ ਨੇ ਜਾਣ ਲਿਆ ਕਿ (ਸਾਰੀਆਂ ਸਖੀਆਂ) ਬੇਸੁੱਧ ਹੋ ਗਈਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "जब जाना ते भई दिवानी ॥",
      "sourceLineId": "135363",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੋਏ ਸਕਲ ਪਹਰੂਆ ਜਾਨੀ ॥",
      "transliteration": "soe sakal paharooaa jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਹ ਵੀ ਸਮਝ ਲਿਆ ਕਿ ਸਾਰੇ ਪਹਿਰੇਦਾਰ ਵੀ ਸੌਂ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "सोए सकल पहरूआ जानी ॥",
      "sourceLineId": "135364",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੁਹੂੰ ਸਨਾਹੀ ਲਈ ਮੰਗਾਇ ॥",
      "transliteration": "dhuhoo(n) sanaahee liee ma(n)gai ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਉਨ੍ਰਹਾ) ਦੋਹਾ ਨੇ ਤਰਨ ਵਾਲੀਆਂ ਮਸ਼ਕਾ ਮੰਗਵਾ ਲਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "दुहूँ सनाही लई मंगाइ ॥",
      "sourceLineId": "135365",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਹਿਰਿ ਨਦੀ ਮੈ ਧਸੀ ਬਨਾਇ ॥੧੨॥",
      "transliteration": "pahir nadhee mai dhasee banai ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੈ ਕੇ ਨਦੀ ਵਿਚ ਧਸ ਗਈਆਂ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "पहिरि नदी मै धसी बनाइ ॥१२॥",
      "sourceLineId": "135366",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਰਤ ਤਰਤ ਆਈ ਤੇ ਤਹਾ ॥",
      "transliteration": "tarat tarat aaiee te tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਤਰਦੀਆਂ ਤਰਦੀਆਂ ਉਥੇ ਆ ਗਈਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "तरत तरत आई ते तहा ॥",
      "sourceLineId": "135367",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੋਵਤ ਸੁਤੋ ਨਰਾਧਿਪ ਜਹਾ ॥",
      "transliteration": "sovat suto naraadhip jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਜਾ ਸੁੱਤਾ ਪਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "सोवत सुतो नराधिप जहा ॥",
      "sourceLineId": "135368",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਕਰਿ ਪਾਵ ਤਿਹ ਦਿਯਾ ਜਗਾਇ ॥",
      "transliteration": "pakar paav teh dhiyaa jagai ||",
      "translation": "",
      "punjabiViakhya": "ਪੈਰੋਂ ਪਕੜ ਕੇ ਉਸ ਨੂੰ ਜਗਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "पकरि पाव तिह दिया जगाइ ॥",
      "sourceLineId": "135369",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਜਾ ਚਰਮ ਪਰ ਲਿਯਾ ਚੜਾਇ ॥੧੩॥",
      "transliteration": "ajaa charam par liyaa chaRai ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਬਕਰੀ ਦੇ ਚਮੜੇ (ਦੀ ਬਣੀ ਮਸ਼ਕ) ਉਪਰ ਚੜ੍ਰਹਾ ਲਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "अजा चरम पर लिया चड़ाइ ॥१३॥",
      "sourceLineId": "135370",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭੂਪਤਿ ਲਿਯਾ ਚੜਾਇ ਸਨਾਈ ॥",
      "transliteration": "bhoopat liyaa chaRai sanaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਮਸ਼ਕ ਉਪਰ ਚੜ੍ਰਹਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "भूपति लिया चड़ाइ सनाई ॥",
      "sourceLineId": "135371",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਰਿਤਾ ਬੀਚ ਪਰੀ ਪੁਨਿ ਜਾਈ ॥",
      "transliteration": "saritaa beech paree pun jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਦੀ ਵਿਚ ਫਿਰ ਠਿਲ੍ਰਹ ਪਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "सरिता बीच परी पुनि जाई ॥",
      "sourceLineId": "135372",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਰਤ ਤਰਤ ਅਪਨੋ ਤਜਿ ਦੇਸਾ ॥",
      "transliteration": "tarat tarat apano taj dhesaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਰਦਿਆਂ ਤਰਦਿਆਂ ਆਪਣਾ ਦੇਸ ਛਡ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "तरत तरत अपनो तजि देसा ॥",
      "sourceLineId": "135373",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪ੍ਰਾਪਤ ਭੀ ਤਿਹ ਦੇਸ ਨਰੇਸਾ ॥੧੪॥",
      "transliteration": "praapat bhee teh dhes naresaa ||14||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਜੇ ਦੇ ਦੇਸ ਜਾ ਪਹੁੰਚੀਆਂ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "प्रापत भी तिह देस नरेसा ॥१४॥",
      "sourceLineId": "135374",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਬ ਕਛੁ ਸੁਧਿ ਸਖਿਯਨ ਤਿਨ ਪਾਈ ॥",
      "transliteration": "jab kachh sudh sakhiyan tin paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਨ੍ਰਹਾ ਸਖੀਆਂ ਨੂੰ ਕੁਝ ਹੋਸ਼ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "जब कछु सुधि सखियन तिन पाई ॥",
      "sourceLineId": "135375",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨ੍ਰਿਸੰਦੇਹ ਯੌ ਹੀ ਠਹਰਾਈ ॥",
      "transliteration": "nirasa(n)dheh yau hee Thaharaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਨਿਰਸੰਦੇਹ ਇਹ ਧਾਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "नृसंदेह यौ ही ठहराई ॥",
      "sourceLineId": "135376",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਦ ਸੌ ਭਈ ਜਾਨੁ ਮਤਵਾਰੀ ॥",
      "transliteration": "madh sau bhiee jaan matavaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਸ਼ਰਾਬ ਨਾਲ ਬੇਹੋਸ਼ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "मद सौ भई जानु मतवारी ॥",
      "sourceLineId": "135377",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਡੂਬਿ ਮੁਈ ਦੋਊ ਰਾਜ ਦੁਲਾਰੀ ॥੧੫॥",
      "transliteration": "ddoob muiee dhouoo raaj dhulaaree ||15||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਰਾਜ ਕੁਮਾਰੀਆਂ (ਨਦੀ ਵਿਚ) ਡੁਬ ਮੋਈਆਂ ਹਨ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "डूबि मुई दोऊ राज दुलारी ॥१५॥",
      "sourceLineId": "135378",
      "sourceShabadId": "12620",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "135379",
      "sourceShabadId": "12621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਵੈ ਦੋਊ ਨ੍ਰਿਪ ਸੰਗ ਗਈ ਅਨਿਕ ਹਿਯੇ ਹਰਖਾਤ ॥",
      "transliteration": "vai dhouoo nirap sa(n)g giee anik hiye harakhaat ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੋਵੇਾਂ ਹਿਰਦੇ ਵਿਚ ਬਹੁਤ ਪ੍ਰਸੰਨਤਾ ਸਹਿਤ ਰਾਜੇ ਨਾਲ ਚਲੀਆਂ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "वै दोऊ नृप संग गई अनिक हिये हरखात ॥",
      "sourceLineId": "135380",
      "sourceShabadId": "12621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਜਾ ਚਰਮ ਪਰ ਭੂਪ ਬਰ ਦੁਹੂੰਅਨ ਚਲਾ ਬਜਾਤ ॥੧੬॥",
      "transliteration": "ajaa charam par bhoop bar dhuhoo(n)an chalaa bajaat ||16||",
      "translation": "",
      "punjabiViakhya": "ਬਕਰੀ ਦੇ ਚਮੜੇ (ਦੀ ਬਣੀ ਮਸ਼ਕ) ਉਤੇ ਚੜ ਕੇ ਰਾਜਾ ਵੀ ਉਨ੍ਰਹਾ ਨਾਲ ਰਮਣ ਕਰਦਾ ਹੋਇਆ ਚਲਾ ਗਿਆ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "अजा चरम पर भूप बर दुहूँअन चला बजात ॥१६॥",
      "sourceLineId": "135381",
      "sourceShabadId": "12621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤ੍ਰਿਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੩॥੬੩੮੭॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau tirataalees charitr samaapatam sat subham sat ||343||6387||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੪੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੪੩॥੬੩੮੭॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ तृतालीस चरित्र समापतम सतु सुभम सतु ॥३४३॥६३८७॥अफजूँ॥",
      "sourceLineId": "135382",
      "sourceShabadId": "12621",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135383",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਰਿਦ੍ਵਾਰ ਇਕ ਸੁਨ ਨ੍ਰਿਪਾਲਾ ॥",
      "transliteration": "haridhavaiaar ik sun nirapaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਹਰਿਦੁਆਰ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "हरिद्वार इक सुन नृपाला ॥",
      "sourceLineId": "135384",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੇਜਿਮਾਨ ਦੁਤਿਮਾਨ ਛਿਤਾਲਾ ॥",
      "transliteration": "tejimaan dhutimaan chhitaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਤੇਜਸਵੀ, ਸੁੰਦਰ ਅਤੇ ਸੂਝਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "तेजिमान दुतिमान छिताला ॥",
      "sourceLineId": "135385",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸ੍ਰੀ ਰਸਰੰਗ ਮਤੀ ਤਿਹ ਜਾਈ ॥",
      "transliteration": "sree rasara(n)g matee teh jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪੁੱਤਰੀ ਰਸ ਰੰਗ ਮਤੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "स्री रसरंग मती तिह जाई ॥",
      "sourceLineId": "135386",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਿਹ ਸਮ ਦੂਸਰਿ ਬਿਧਿ ਨ ਬਨਾਈ ॥੧॥",
      "transliteration": "jeh sam dhoosar bidh na banaiee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਵਿਧਾਤਾ ਨੇ ਦੂਜੀ ਨਹੀਂ ਬਣਾਈ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "जिह सम दूसरि बिधि न बनाई ॥१॥",
      "sourceLineId": "135387",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਬ ਵਹੁ ਤਰੁਨਿ ਤਰੁਨ ਅਤਿ ਭਈ ॥",
      "transliteration": "jab vahu tarun tarun at bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਰਾਜ ਕੁਮਾਰੀ ਭਰ ਜਵਾਨ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "जब वहु तरुनि तरुन अति भई ॥",
      "sourceLineId": "135388",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੂਪ ਸੈਨ ਨ੍ਰਿਪ ਕਹਿ ਪਿਤ ਦਈ ॥",
      "transliteration": "bhoop sain nirap keh pit dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪਿਤਾ ਨੇ ਉਹ ਭੂਪ ਸੈਨ ਰਾਜੇ ਨੂੰ ਦੇ ਦਿੱਤੀ (ਭਾਵ-ਵਿਆਹ ਦਿੱਤੀ)।",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "भूप सैन नृप कहि पित दई ॥",
      "sourceLineId": "135389",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਿਰੀ ਨਗਰ ਭੀਤਰ ਜਬ ਆਈ ॥",
      "transliteration": "siree nagar bheetar jab aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਰਾਜ ਕੁਮਾਰੀ) ਸਿਰੀ ਨਗਰ ਵਿਚ ਆਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "सिरी नगर भीतर जब आई ॥",
      "sourceLineId": "135390",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਲਖਿ ਚੰਡਾਲਿਕ ਅਧਿਕ ਲੁਭਾਈ ॥੨॥",
      "transliteration": "lakh cha(n)ddaalik adhik lubhaiee ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਕ ਚੰਡਾਲ ਨੂੰ ਵੇਖ ਕੇ ਬਹੁਤ ਲਲਚਾ ਗਈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "लखि चंडालिक अधिक लुभाई ॥२॥",
      "sourceLineId": "135391",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਲਿਯਾ ਬੁਲਾਈ ॥",
      "transliteration": "paThai sahacharee liyaa bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਹੇਲੀ ਨੂੰ ਭੇਜ ਕੇ (ਉਸ ਨੂੰ) ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी लिया बुलाई ॥",
      "sourceLineId": "135392",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੌ ਭੋਗ ਕਥਾ ਬਿਸਰਾਈ ॥",
      "transliteration": "nirap sau bhog kathaa bisaraiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਨ ਦੀ ਗੱਲ ਭੁਲਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "नृप सौ भोग कथा बिसराई ॥",
      "sourceLineId": "135393",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1296_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰੈਨਿ ਦਿਵਸ ਤਿਹ ਲੇਤ ਬੁਲਾਈ ॥",
      "transliteration": "rain dhivas teh let bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਉਸ ਨੂੰ ਬੁਲਾ ਲੈਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1296,
      "hindi": "",
      "hindiTransliteration": "रैनि दिवस तिह लेत बुलाई ॥",
      "sourceLineId": "135394",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
