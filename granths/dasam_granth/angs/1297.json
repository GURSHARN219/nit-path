{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1297,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1297_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਤਿ ਅਤਿ ਨਿਤਪ੍ਰਤਿ ਕਰਤ ਬਨਾਈ ॥੩॥",
      "transliteration": "rat at nitaprat karat banaiee ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਹਰ ਰੋਜ਼ ਕਾਮ-ਲੀਲ੍ਰਹਾ ਰਚਾਉਾਂਦੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "रति अति नितप्रति करत बनाई ॥३॥",
      "sourceLineId": "135395",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਸਤ ਰਸਤ ਐਸੀ ਰਸਿ ਗਈ ॥",
      "transliteration": "rasat rasat aaisee ras giee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਵਿਚ) ਮਗਨ ਹੁੰਦਿਆਂ ਹੁੰਦਿਆਂ ਅਜਿਹੀ ਲੀਨ ਹੋ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "रसत रसत ऐसी रसि गई ॥",
      "sourceLineId": "135396",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਨੁ ਕਰ ਨਾਰਿ ਤਵਨ ਕੀ ਭਈ ॥",
      "transliteration": "jan kar naar tavan kee bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਉਸ ਦੀ ਹੀ ਇਸਤਰੀ ਹੋ ਗਈ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "जनु कर नारि तवन की भई ॥",
      "sourceLineId": "135397",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਭ ਬ੍ਰਿਤਾਤ ਕਹਿ ਤਾਹਿ ਸਿਖਾਯੋ ॥",
      "transliteration": "sabh birataat keh taeh sikhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਾਰਾ ਬ੍ਰਿੱਤਾਤ ਉਸ (ਯਾਰ) ਨੂੰ ਸਿਖਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "सभ बृतात कहि ताहि सिखायो ॥",
      "sourceLineId": "135398",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੋਵਤਿ ਸਮੈ ਭੂਪ ਕਹ ਘਾਯੋ ॥੪॥",
      "transliteration": "sovat samai bhoop keh ghaayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੁੱਤੇ ਹੋਇਆਂ ਰਾਜੇ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "सोवति समै भूप कह घायो ॥४॥",
      "sourceLineId": "135399",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪ੍ਰਾਤ ਜਰਨ ਕੇ ਕਾਜ ਸਿਧਾਈ ॥",
      "transliteration": "praat jaran ke kaaj sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਹੁੰਦਿਆਂ ਹੀ (ਉਹ) ਸਤੀ ਹੋਣ ਲਈ ਚਲ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "प्रात जरन के काज सिधाई ॥",
      "sourceLineId": "135400",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਗੇ ਰਾਖਿ ਲਏ ਨਿਜੁ ਰਾਈ ॥",
      "transliteration": "aage raakh le nij raiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਅਗੇ ਰਾਜੇ (ਦੀ ਲੋਥ) ਨੂੰ ਰਖ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "आगे राखि लए निजु राई ॥",
      "sourceLineId": "135401",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਬੈ ਚਿਤਾ ਪਰ ਬੈਠੀ ਜਾਇ ॥",
      "transliteration": "jabai chitaa par baiThee jai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਉਹ) ਜਾ ਕੇ ਚਿੱਤਾ ਉਤੇ ਬੈਠ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "जबै चिता पर बैठी जाइ ॥",
      "sourceLineId": "135402",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚਹੂੰ ਓਰ ਦਿਯ ਆਗਿ ਲਗਾਇ ॥੫॥",
      "transliteration": "chahoo(n) or dhiy aag lagai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਅੱਗ ਲਗਾ ਦਿੱਤੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओर दिय आगि लगाइ ॥५॥",
      "sourceLineId": "135403",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਾਰੋ ਦਿਸਾ ਅਗਨਿ ਜਬ ਲਾਗੀ ॥",
      "transliteration": "chaaro dhisaa agan jab laagee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਅੱਗ ਲਗ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "चारो दिसा अगनि जब लागी ॥",
      "sourceLineId": "135404",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਬ ਹੀ ਉਤਰਿ ਚਿਤਾ ਤੈ ਭਾਗੀ ॥",
      "transliteration": "tab hee utar chitaa tai bhaagee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਚਿੱਤਾ ਤੋਂ ਉਤਰ ਕੇ ਭਜ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "तब ही उतरि चिता तै भागी ॥",
      "sourceLineId": "135405",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਲੋਗਨ ਚਰਿਤ ਕ੍ਰਿਯਾ ਨਹਿ ਜਾਨੀ ॥",
      "transliteration": "logan charit kirayaa neh jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਲੋਕਾ ਨੇ ਉਸ ਦੇ ਚਰਿਤ੍ਰ ਦੀ ਕਾਰਵਾਈ ਨੂੰ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "लोगन चरित कृया नहि जानी ॥",
      "sourceLineId": "135406",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੀਨੀ ਤਿਸੀ ਚੰਡਾਰਹਿ ਰਾਨੀ ॥੬॥",
      "transliteration": "dheenee tisee cha(n)ddaareh raanee ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਮਰਯਾਦਾ ਨੂੰ ਤੋੜਨ ਕਰ ਕੇ) ਰਾਣੀ ਨੂੰ ਉਸੇ ਚੰਡਾਲ ਦੇ ਹਵਾਲੇ ਕਰ ਦਿੱਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "दीनी तिसी चंडारहि रानी ॥६॥",
      "sourceLineId": "135407",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਯੌ ਛਲਿ ਛੈਲ ਚਿਕਨਿਸਨ ਗਈ ॥",
      "transliteration": "yau chhal chhail chikanisan giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਬਾਕੇ ਸ਼ਰੀਰ ਵਾਲੀ ਕੁਮਾਰੀ ਛਲ ਕੇ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "यौ छलि छैल चिकनिसन गई ॥",
      "sourceLineId": "135408",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿਨੂੰ ਨ ਬਾਤ ਤਾਹਿ ਲਖਿ ਲਈ ॥",
      "transliteration": "kinoo(n) na baat taeh lakh liee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ ਉਸ ਦੀ ਗੱਲ ਨੂੰ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "किनूँ न बात ताहि लखि लई ॥",
      "sourceLineId": "135409",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਰਿ ਅਧਿਕ ਮਨ ਹਰਖ ਬਢਾਯੋ ॥",
      "transliteration": "naar adhik man harakh baddaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਾਜ ਕੁਮਾਰੀ ਮਨ ਵਿਚ ਬਹੁਤ ਪ੍ਰਸੰਨ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "नारि अधिक मन हरख बढायो ॥",
      "sourceLineId": "135410",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚਾਹਤ ਹੁਤੀ ਸੋਇ ਪਤਿ ਪਾਯੋ ॥੭॥",
      "transliteration": "chaahat hutee soi pat paayo ||7||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ) ਚਾਹੁੰਦੀ ਸੀ, ਉਸੇ ਨੂੰ ਪਤੀ ਵਜੋਂ ਪ੍ਰਾਪਤ ਕੀਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "चाहत हुती सोइ पति पायो ॥७॥",
      "sourceLineId": "135411",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਬ ਤੇ ਆਜੁ ਲਗੇ ਉਹ ਦੇਸਾ ॥",
      "transliteration": "tab te aaj lage uh dhesaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਦੋਂ ਤੋਂ ਹੁਣ ਤਕ ਉਸ ਦੇਸ ਵਿਚ,",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "तब ते आजु लगे उह देसा ॥",
      "sourceLineId": "135412",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਾਰਤ ਤ੍ਰਿਯ ਕੌ ਪ੍ਰਥਮ ਨਰੇਸਾ ॥",
      "transliteration": "maarat tiray kau pratham naresaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੇ ਮਰਨ ਤੋਂ ਪਹਿਲਾ ਇਸਤਰੀ ਨੂੰ ਮਾਰ ਦਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "मारत तृय कौ प्रथम नरेसा ॥",
      "sourceLineId": "135413",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਠ ਤਰੇ ਕਰਿ ਜਾਹਿ ਜਰਾਵਤ ॥",
      "transliteration": "kaTh tare kar jaeh jaraavat ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਹੇਠਾ ਲਕੜ ਧਰ ਕੇ ਸਾੜ ਦਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "कठ तरे करि जाहि जरावत ॥",
      "sourceLineId": "135414",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭਾਖਿ ਸਕਤਿ ਨਹਿ ਬਾਤ ਲਜਾਵਤ ॥੮॥",
      "transliteration": "bhaakh sakat neh baat lajaavat ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਗੱਲ ਕਹਿ ਨਹੀਂ ਸਕਦੇ (ਕਿ ਸਾਡੀ ਰਾਣੀ ਚੰਡਾਲ ਦੇ ਜਾ ਵਸੀ ਸੀ) (ਇਸ ਲਈ) ਲਜਾਉਾਂਦੇ ਹਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "भाखि सकति नहि बात लजावत ॥८॥",
      "sourceLineId": "135415",
      "sourceShabadId": "12622",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "135416",
      "sourceShabadId": "12623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਿਹ ਰਾਨੀ ਕੇ ਪੁਤ੍ਰ ਤਬ ਰਾਜ ਕਰਾ ਤਿਹ ਠਾਵ ॥",
      "transliteration": "teh raanee ke putr tab raaj karaa teh Thaav ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਣੀ ਦੇ ਪੁੱਤਰ ਨੇ ਤਦ ਉਥੇ ਰਾਜ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "तिह रानी के पुत्र तब राज करा तिह ठाव ॥",
      "sourceLineId": "135417",
      "sourceShabadId": "12623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਜੁ ਲਗੇ ਚੰਡਾਲਿਯੈ ਭਾਖਤ ਤਿਨ ਕੋ ਨਾਵ ॥੯॥",
      "transliteration": "aaj lage cha(n)ddaaliyai bhaakhat tin ko naav ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਜ ਤਕ ਉਨ੍ਰਹਾ ਦਾ ਨਾ ਚੰਡਾਲੀਏ ਕਿਹਾ ਜਾਦਾ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "आजु लगे चंडालियै भाखत तिन को नाव ॥९॥",
      "sourceLineId": "135418",
      "sourceShabadId": "12623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚੌਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੪॥੬੩੯੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chauataalees charitr samaapatam sat subham sat ||344||6396||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੪੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੪੪॥੬੩੯੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ चौतालीस चरित्र समापतम सतु सुभम सतु ॥३४४॥६३९६॥अफजूँ॥",
      "sourceLineId": "135419",
      "sourceShabadId": "12623",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135420",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੌਲਾ ਕੀ ਗੁਜਰਾਤਿ ਬਸਤ ਜਹ ॥",
      "transliteration": "dhaualaa kee gujaraat basat jeh ||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ਾਹ) ਦੌਲਾ ਦੀ ਗੁਜਰਾਤ ਜਿਥੇ ਵਸਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "दौला की गुजराति बसत जह ॥",
      "sourceLineId": "135421",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਮਰ ਸਿੰਘ ਇਕ ਹੁਤਾ ਨ੍ਰਿਪਤਿ ਤਹ ॥",
      "transliteration": "amar si(n)gh ik hutaa nirapat teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਦਾ ਇਕ ਅਮਰ ਸਿੰਘ ਨਾ ਦਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "अमर सिंघ इक हुता नृपति तह ॥",
      "sourceLineId": "135422",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅੰਗਨਾ ਦੇ ਰਾਨੀ ਤਿਹ ਰਾਜੈ ॥",
      "transliteration": "a(n)ganaa dhe raanee teh raajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਰਾਣੀ ਦਾ ਨਾ ਅੰਗਨਾ ਦੇ (ਦੇਈ) ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "अंगना दे रानी तिह राजै ॥",
      "sourceLineId": "135423",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਿਰਖਿ ਦਿਵੰਗਨਨ ਕੋ ਮਨ ਲਾਜੈ ॥੧॥",
      "transliteration": "nirakh dhiva(n)ganan ko man laajai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਦੇਵਇਸ ਤਰੀਆਂ ਦਾ ਮਨ ਲਜਿਤ ਹੁੰਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "निरखि दिवंगनन को मन लाजै ॥१॥",
      "sourceLineId": "135424",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਜਾ ਅਧਿਕ ਪੀਰ ਕਹ ਮਾਨੈ ॥",
      "transliteration": "raajaa adhik peer keh maanai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਪੀਰ ਨੂੰ ਬਹੁਤ ਮੰਨਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "राजा अधिक पीर कह मानै ॥",
      "sourceLineId": "135425",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਲੀ ਬੁਰੀ ਜੜ ਬਾਤ ਨ ਜਾਨੈ ॥",
      "transliteration": "bhalee buree jaR baat na jaanai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮੂਰਖ ਮਾੜੇ ਚੰਗੇ ਦੀ ਪਛਾਣ ਨਹੀਂ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "भली बुरी जड़ बात न जानै ॥",
      "sourceLineId": "135426",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਹਾ ਸੁਬਰਨ ਸਿੰਘ ਇਕ ਛਤ੍ਰੀ ॥",
      "transliteration": "tahaa subaran si(n)gh ik chhatree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸੁਬਰਨ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਛਤ੍ਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "तहा सुबरन सिंघ इक छत्री ॥",
      "sourceLineId": "135427",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰੂਪਵਾਨ ਧਨਵਾਨ ਧਰਤ੍ਰੀ ॥੨॥",
      "transliteration": "roopavaan dhanavaan dharatree ||2||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਰੂਪਵਾਨ, ਧਨਵਾਨ ਅਤੇ ਅਸਤ੍ਰ ਚਲਾਉਣ ਵਿਚ ਪ੍ਰਬੀਨ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "रूपवान धनवान धरत्री ॥२॥",
      "sourceLineId": "135428",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੁੰਦਰ ਅਧਿਕ ਹੁਤੋ ਖਤਿਰੇਟਾ ॥",
      "transliteration": "su(n)dhar adhik huto khatireTaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਛਤ੍ਰੀ-ਪੁੱਤਰ ਬਹੁਤ ਸੁੰਦਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "सुँदर अधिक हुतो खतिरेटा ॥",
      "sourceLineId": "135429",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਨੁਕ ਰੂਪ ਸੌ ਸਕਲ ਲਪੇਟਾ ॥",
      "transliteration": "januk roop sau sakal lapeTaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸੁੰਦਰਤਾ ਨਾਲ ਸਾਰਾ ਲਪੇਟਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "जनुक रूप सौ सकल लपेटा ॥",
      "sourceLineId": "135430",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਬ ਤੇ ਨਿਰਖਿ ਨਾਰਿ ਤਿਹ ਗਈ ॥",
      "transliteration": "jab te nirakh naar teh giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਰਾਣੀ ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "जब ते निरखि नारि तिह गई ॥",
      "sourceLineId": "135431",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੁਧਿ ਬੁਧਿ ਛਾਡਿ ਦਿਵਾਨੀ ਭਈ ॥੩॥",
      "transliteration": "sudh budh chhaadd dhivaanee bhiee ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸੁੱਧ ਬੁੱਧ ਤਿਆਗ ਕੇ ਦੀਵਾਨੀ ਹੋ ਗਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "सुधि बुधि छाडि दिवानी भई ॥३॥",
      "sourceLineId": "135432",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਾ ਸੰਗ ਨੇਹ ਸਜਾ ਰੁਚਿ ਮਾਨ ॥",
      "transliteration": "taa sa(n)g neh sajaa ruch maan ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੇ ਰੁਚੀ ਪੂਰਵਕ ਉਸ ਨਾਲ ਪ੍ਰੇਮ ਲਗਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "ता संग नेह सजा रुचि मान ॥",
      "sourceLineId": "135433",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾਨਿ ਬੂਝਿ ਹ੍ਵੈ ਗਈ ਅਜਾਨ ॥",
      "transliteration": "jaan boojh havai giee ajaan ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਆਪਣੇ ਆਪ ਨੂੰ) ਜਾਣ ਬੁਝ ਕੇ ਅਣਜਾਣ ਦਸਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "जानि बूझि ह्वै गई अजान ॥",
      "sourceLineId": "135434",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦਈ ਸਹਚਰੀ ਤਹਿਕ ਪਠਾਇ ॥",
      "transliteration": "dhiee sahacharee tahik paThai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਸਹੇਲੀ ਨੂੰ ਉਸ ਕੋਲ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "दई सहचरी तहिक पठाइ ॥",
      "sourceLineId": "135435",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਤਿਹ ਗ੍ਰਿਹ ਲਿਯਾ ਮੰਗਾਇ ॥੪॥",
      "transliteration": "jayo(n) tayo(n) teh gireh liyaa ma(n)gai ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨੂੰ ਘਰ ਬੁਲਾ ਲਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "ज्यों त्यों तिह गृह लिया मंगाइ ॥४॥",
      "sourceLineId": "135436",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਈ ॥",
      "transliteration": "posat bhaag afeem ma(n)gaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪੋਸਤ, ਭੰਗ ਅਤੇ ਅਫ਼ੀਮ ਮੰਗਵਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "पोसत भाग अफीम मंगाई ॥",
      "sourceLineId": "135437",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਾਨਿ ਡਾਰਿ ਕਰਿ ਭਾਗ ਘੁਟਾਈ ॥",
      "transliteration": "paan ddaar kar bhaag ghuTaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਾਣੀ ਪਾ ਕੇ ਭੰਗ ਘੁਟਵਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "पानि डारि करि भाग घुटाई ॥",
      "sourceLineId": "135438",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪਾਨ ਕਿਯਾ ਦੁਹੂੰ ਬੈਠਿ ਪ੍ਰਜੰਕਹਿ ॥",
      "transliteration": "paan kiyaa dhuhoo(n) baiTh praja(n)keh ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਪਲੰਘ ਉਤੇ ਬੈਠ ਕੇ ਪੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "पान किया दुहूँ बैठि प्रजंकहि ॥",
      "sourceLineId": "135439",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰਤਿ ਮਾਨੀ ਭਰਿ ਭਰਿ ਦ੍ਰਿੜ ਅੰਕਹਿ ॥੫॥",
      "transliteration": "rat maanee bhar bhar dhiraR a(n)keh ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗਲਵਕੜੀਆਂ ਪਾ ਪਾ ਕੇ ਰਤੀ ਮਨਾਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "रति मानी भरि भरि दृड़ अंकहि ॥५॥",
      "sourceLineId": "135440",
      "sourceShabadId": "12624",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "135441",
      "sourceShabadId": "12625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1297_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਬੈ ਟਨਾਨੇ ਕੈਫ ਕੇ ਆਏ ਅਖਿਯਨ ਮਾਹਿ ॥",
      "transliteration": "jabai Tanaane kaif ke aae akhiyan maeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਨਸ਼ੇ ਕਰ ਕੇ ਅੱਖਾ ਵਿਚ ਭੰਬਰ ਤਾਰੇ ਆਣ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1297,
      "hindi": "",
      "hindiTransliteration": "जबै टनाने कैफ के आए अखियन माहि ॥",
      "sourceLineId": "135442",
      "sourceShabadId": "12625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
