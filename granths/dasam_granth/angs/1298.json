{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1298,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1298_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਰਹਿ ਬਿਲਾਸ ਪ੍ਰਜੰਕ ਚੜਿ ਹਸਿ ਹਸਿ ਨਾਰਿ ਔ ਨਾਹਿ ॥੬॥",
      "transliteration": "kareh bilaas praja(n)k chaR has has naar aau naeh ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪਲੰਘ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਰਾਜ ਕੁਮਾਰੀ ਅਤੇ ਰਾਜਾ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰਨ ਲਗੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "करहि बिलास प्रजंक चड़ि हसि हसि नारि औ नाहि ॥६॥",
      "sourceLineId": "135443",
      "sourceShabadId": "12625",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135444",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਆਸਨ ਲੈ ਕੈ ॥",
      "transliteration": "bhaat bhaat ke aasan lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਆਸਣ ਬਣਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के आसन लै कै ॥",
      "sourceLineId": "135445",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਬਲਾ ਕਹ ਬਹੁ ਭਾਤਿ ਰਿਝੈ ਕੈ ॥",
      "transliteration": "abalaa keh bahu bhaat rijhai kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਰਿਝਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "अबला कह बहु भाति रिझै कै ॥",
      "sourceLineId": "135446",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਆਪਨ ਪਰ ਘਾਯਲ ਕਰਿ ਮਾਰੀ ॥",
      "transliteration": "aapan par ghaayal kar maaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਮ ਵਿਚ ਲੀਨ (ਉਸ) ਰਾਜ ਦੁਲਾਰੀ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "आपन पर घायल करि मारी ॥",
      "sourceLineId": "135447",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਦਨ ਮੋਹਨੀ ਰਾਜ ਦੁਲਾਰੀ ॥੭॥",
      "transliteration": "madhan mohanee raaj dhulaaree ||7||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਉਤੇ ਘਾਇਲ ਕਰ ਲਿਆ (ਅਰਥਾਤ ਫ਼ਿਦਾ ਕਰ ਲਿੱਤਾ) ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "मदन मोहनी राज दुलारी ॥७॥",
      "sourceLineId": "135448",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਧਿਕ ਬਢਾਇ ਨਾਰਿ ਸੌ ਹੇਤਾ ॥",
      "transliteration": "adhik baddai naar sau hetaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਕੁਮਾਰੀ ਨਾਲ ਬਹੁਤ ਪ੍ਰੇਮ ਵਧਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "अधिक बढाइ नारि सौ हेता ॥",
      "sourceLineId": "135449",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਹਿ ਬਿਧਿ ਬਾਧਤ ਭਏ ਸੰਕੇਤਾ ॥",
      "transliteration": "eeh bidh baadhat bhe sa(n)ketaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਸ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਵਿਉਾਂਤ (ਸੰਕੇਤ) ਬਣਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "इहि बिधि बाधत भए संकेता ॥",
      "sourceLineId": "135450",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਧੂੰਈ ਕਾਲਿ ਪੀਰ ਕੀ ਐਯਹੁ ॥",
      "transliteration": "dhoo(n)iee kaal peer kee aaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਪੀਰ ਦੀ ਧੂਣੀ ਵਾਲੇ ਸਮੇਾਂ ਆਉਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "धूँई कालि पीर की ऐयहु ॥",
      "sourceLineId": "135451",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਡਾਰਿ ਭਾਗ ਹਲਵਾ ਮਹਿ ਜੈਯਹੁ ॥੮॥",
      "transliteration": "ddaar bhaag halavaa meh jaiyahu ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਲਵੇ ਵਿਚ ਭੰਗ ਪਾ ਜਾਣਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "डारि भाग हलवा महि जैयहु ॥८॥",
      "sourceLineId": "135452",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੋਫੀ ਜਬੈ ਚੂਰਮਾ ਖੈ ਹੈ ॥",
      "transliteration": "sofee jabai chooramaa khai hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸੋਫ਼ੀ (ਪਰਹੇਜ਼ਗਾਰ) ਚੂਰਮਾ ਖਾਣਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "सोफी जबै चूरमा खै है ॥",
      "sourceLineId": "135453",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੀਯਤ ਮ੍ਰਿਤਕ ਸਭੈ ਹ੍ਵੈ ਜੈ ਹੈ ॥",
      "transliteration": "jeeyat mritak sabhai havai jai hai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਾਰੇ ਜੀਉਾਂਦਿਆਂ ਹੋਇਆਂ ਮਰ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "जीयत मृतक सभै ह्वै जै है ॥",
      "sourceLineId": "135454",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਹੀ ਕ੍ਰਿਪਾ ਕਰਿ ਤੁਮਹੂੰ ਐਯਹੁ ॥",
      "transliteration": "tahee kirapaa kar tumahoo(n) aaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਕ੍ਰਿਪਾ ਕਰ ਕੇ ਤੁਸੀਂ ਆਉਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "तही कृपा करि तुमहूँ ऐयहु ॥",
      "sourceLineId": "135455",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੁਹਿ ਲੈ ਸੰਗ ਦਰਬ ਜੁਤ ਜੈਯਹੁ ॥੯॥",
      "transliteration": "muh lai sa(n)g dharab jut jaiyahu ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਧਨ ਸਹਿਤ ਨਾਲ ਲੈ ਜਾਣਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "मुहि लै संग दरब जुत जैयहु ॥९॥",
      "sourceLineId": "135456",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਬ ਹੀ ਦਿਨ ਧੂੰਈ ਕੋ ਆਯੋ ॥",
      "transliteration": "jab hee dhin dhoo(n)iee ko aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਧੂੰਣੀ ਦਾ ਦਿਨ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "जब ही दिन धूँई को आयो ॥",
      "sourceLineId": "135457",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਾਗਿ ਡਾਰਿ ਚੂਰਮਾ ਪਕਾਯੋ ॥",
      "transliteration": "bhaag ddaar chooramaa pakaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਭੰਗ ਪਾ ਕੇ ਚੂਰਮਾ ਪਕਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "भागि डारि चूरमा पकायो ॥",
      "sourceLineId": "135458",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਕਲ ਮੁਰੀਦਨ ਗਈ ਖਵਾਇ ॥",
      "transliteration": "sakal mureedhan giee khavai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਮੁਰੀਦਾ ਨੂੰ (ਰਾਜ ਕੁਮਾਰੀ) ਖਵਾ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "सकल मुरीदन गई खवाइ ॥",
      "sourceLineId": "135459",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਾਖੇ ਮੂੜ ਮਤ ਕਰਿ ਸ੍ਵਾਇ ॥੧੦॥",
      "transliteration": "raakhe mooR mat kar savaiai ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੂਰਖ (ਚੇਲਿਆਂ) ਨੂੰ ਬੇਹੋਸ਼ ਕਰ ਕੇ ਸੰਵਾ ਦਿੱਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "राखे मूड़ मत करि स्वाइ ॥१०॥",
      "sourceLineId": "135460",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋਫੀ ਭਏ ਜਬੈ ਮਤਵਾਰੇ ॥",
      "transliteration": "sofee bhe jabai matavaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸੋਫ਼ੀ ਲੋਕ ਮਸਤ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "सोफी भए जबै मतवारे ॥",
      "sourceLineId": "135461",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪ੍ਰਿਥਮ ਦਰਬ ਹਰਿ ਬਸਤ੍ਰ ਉਤਾਰੇ ॥",
      "transliteration": "piratham dharab har basatr utaare ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਧਨ ਹਰ ਕੇ ਫਿਰ ਬਸਤ੍ਰ ਉਤਾਰ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "पृथम दरब हरि बसत्र उतारे ॥",
      "sourceLineId": "135462",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਲਿਯਾ ਦੇਸ ਕੋ ਪੰਥਾ ॥",
      "transliteration": "dhuhoo(n)an liyaa dhes ko pa(n)thaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਆਪਣੇ ਦੇਸ ਦਾ ਰਾਹ ਫੜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन लिया देस को पंथा ॥",
      "sourceLineId": "135463",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਦੈ ਸਾਜਨ ਕਹ ਸੰਥਾ ॥੧੧॥",
      "transliteration": "eeh bidh dhai saajan keh sa(n)thaa ||11||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਆਪਣੇ ਮਿਤਰ ਨੂੰ ਸਹਿਜ ਸਿਖਿਆ ਦਿੱਤੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "इह बिधि दै साजन कह संथा ॥११॥",
      "sourceLineId": "135464",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਯਾ ਪ੍ਰਾਤ ਸੋਫੀ ਸਭ ਜਾਗੇ ॥",
      "transliteration": "bhayaa praat sofee sabh jaage ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰ ਹੋਣ ਤੇ ਸਾਰੇ ਸੋਫ਼ੀ ਜਾਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "भया प्रात सोफी सभ जागे ॥",
      "sourceLineId": "135465",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪਗਰੀ ਬਸਤ੍ਰ ਬਿਲੋਕਨ ਲਾਗੇ ॥",
      "transliteration": "pagaree basatr bilokan laage ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਆਪਣੇ) ਬਸਤ੍ਰ ਅਤੇ ਪਗੜੀਆਂ ਲਭਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "पगरी बसत्र बिलोकन लागे ॥",
      "sourceLineId": "135466",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਰਵਰ ਕਹੈ ਕ੍ਰੋਧ ਕਿਯ ਭਾਰਾ ॥",
      "transliteration": "saravar kahai krodh kiy bhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿਣ ਲਗੇ ਕਿ ਪੀਰ ('ਸਰਵਰ') ਨੇ ਸਾਡੇ ਉਤੇ ਬਹੁਤ ਕ੍ਰੋਧ ਕੀਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "सरवर कहै क्रोध किय भारा ॥",
      "sourceLineId": "135467",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਭਹਿਨ ਕੌ ਅਸ ਚਰਿਤ ਦਿਖਾਰਾ ॥੧੨॥",
      "transliteration": "sabhahin kau as charit dhikhaaraa ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਨੂੰ ਇਹ ਚਰਿਤ੍ਰ ਵਿਖਾਇਆ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "सभहिन कौ अस चरित दिखारा ॥१२॥",
      "sourceLineId": "135468",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਭ ਜੜ ਰਹੋ ਤਹਾ ਮੁਖ ਬਾਈ ॥",
      "transliteration": "sabh jaR raho tahaa mukh baiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਮੂਰਖ ਉਥੇ ਮੂੰਹ ਅੱਡੀ ਖੜੋਤੇ ਰਹੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "सभ जड़ रहो तहा मुख बाई ॥",
      "sourceLineId": "135469",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਲਜਾ ਮਾਨ ਮੂੰਡ ਨਿਹੁਰਾਈ ॥",
      "transliteration": "lajaa maan moo(n)dd nihuraiee ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਰਮ ਦੇ ਮਾਰਿਆਂ ਨੇ ਸਿਰ ਨੀਵਾ ਕਰੀ ਰਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "लजा मान मूँड निहुराई ॥",
      "sourceLineId": "135470",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂੰ ਪਛਾਨਾ ॥",
      "transliteration": "bhedh abhedh na kinoo(n) pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न किनूँ पछाना ॥",
      "sourceLineId": "135471",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਰਵਰ ਕਿਯਾ ਸੁ ਸਿਰ ਪਰ ਮਾਨਾ ॥੧੩॥",
      "transliteration": "saravar kiyaa su sir par maanaa ||13||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੀਰ ਨੇ ਕੀਤਾ, ਉਸ ਨੂੰ ਸਿਰ ਮੱਥੇ ਮੰਨਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "सरवर किया सु सिर पर माना ॥१३॥",
      "sourceLineId": "135472",
      "sourceShabadId": "12626",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "135473",
      "sourceShabadId": "12627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਤ੍ਰਿਯਾਨ ਕੋ ਸਕਤ ਨ ਕੋਊ ਪਾਇ ॥",
      "transliteration": "bhedh abhedh tirayaan ko sakat na kouoo pai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਦਾ ਭੇਦ ਅਭੇਦ ਕੋਈ ਨਹੀਂ ਪਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद तृयान को सकत न कोऊ पाइ ॥",
      "sourceLineId": "135474",
      "sourceShabadId": "12627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਭਨ ਲਖੋ ਕੈਸੇ ਛਲਾ ਕਸ ਕਰਿ ਗਈ ਉਪਾਇ ॥੧੪॥",
      "transliteration": "sabhan lakho kaise chhalaa kas kar giee upai ||14||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਦੇ ਵੇਖਦਿਆਂ ਕਿਵੇਾਂ ਛਲ ਲਿਆ ਅਤੇ ਕਿਸ ਤਰ੍ਰਹਾ ਚਰਿਤ੍ਰ ਖੇਡ ਗਈ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "सभन लखो कैसे छला कस करि गई उपाइ ॥१४॥",
      "sourceLineId": "135475",
      "sourceShabadId": "12627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪੈਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੫॥੬੪੧੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau paitaalees charitr samaapatam sat subham sat ||345||6410||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੪੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੪੫॥੬੪੧੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ पैतालीस चरित्र समापतम सतु सुभम सतु ॥३४५॥६४१०॥अफजूँ॥",
      "sourceLineId": "135476",
      "sourceShabadId": "12627",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135477",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਕਹੌ ਕਬਿਤ ॥",
      "transliteration": "sun raajaa ik kahau kabit ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਸੁਣੋ, ਮੈਂ ਇਕ ਕਬਿੱਤ ਕਹਿੰਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा इक कहौ कबित ॥",
      "sourceLineId": "135478",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਅਬਲਾ ਕਿਯਾ ਚਰਿਤ ॥",
      "transliteration": "jeh bidh abalaa kiyaa charit ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਇਕ ਇਸਤਰੀ ਨੇ ਚਰਿਤ੍ਰ ਖੇਡਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि अबला किया चरित ॥",
      "sourceLineId": "135479",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭਹਿਨ ਕੌ ਦਿਨ ਹੀ ਮਹਿ ਛਲਾ ॥",
      "transliteration": "sabhahin kau dhin hee meh chhalaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਦਿਨ ਵਿਚ ਹੀ ਛਲ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "सभहिन कौ दिन ही महि छला ॥",
      "sourceLineId": "135480",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਿਰਖਹੁ ਯਾ ਸੁੰਦਰਿ ਕੀ ਕਲਾ ॥੧॥",
      "transliteration": "nirakhahu yaa su(n)dhar kee kalaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸੁੰਦਰੀ ਦੀ ਚਾਲਾਕੀ ਵੇਖੋ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "निरखहु या सुँदरि की कला ॥१॥",
      "sourceLineId": "135481",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਇਸਕਾਵਤੀ ਨਗਰ ਇਕ ਸੋਹੈ ॥",
      "transliteration": "eisakaavatee nagar ik sohai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਕਾਵਤੀ ਨਾ ਦਾ ਇਕ ਨਗਰ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "इसकावती नगर इक सोहै ॥",
      "sourceLineId": "135482",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਸਕ ਸੈਨ ਰਾਜਾ ਤਹ ਕੋ ਹੈ ॥",
      "transliteration": "eisak sain raajaa teh ko hai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਦਾ ਇਸਕ ਸੈਨ ਨਾ ਦਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "इसक सैन राजा तह को है ॥",
      "sourceLineId": "135483",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸ੍ਰੀ ਗਜਗਾਹ ਮਤੀ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "sree gajagaeh matee teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਗਜਗਾਹ ਮਤੀ ਨਾ ਦੀ ਰਾਣੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "स्री गजगाह मती तिह नारी ॥",
      "sourceLineId": "135484",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾ ਸਮ ਕਹੂੰ ਨ ਰਾਜ ਕੁਮਾਰੀ ॥੨॥",
      "transliteration": "jaa sam kahoo(n) na raaj kumaaree ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ (ਸੁੰਦਰ) ਹੋਰ ਕੋਈ ਰਾਜ ਕੁਮਾਰੀ ਨਹੀਂ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "जा सम कहूँ न राज कुमारी ॥२॥",
      "sourceLineId": "135485",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਕ ਰਣਦੂਲਹ ਸੈਨ ਨ੍ਰਿਪਤਿ ਤਿਹ ॥",
      "transliteration": "eik ranadhooleh sain nirapat teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਰਣਦੂਲਹ ਸੈਨ ਨਾ ਦਾ ਇਕ (ਹੋਰ) ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "इक रणदूलह सैन नृपति तिह ॥",
      "sourceLineId": "135486",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਾ ਸਮ ਉਪਜਾ ਦੁਤਿਯ ਨ ਮਹਿ ਮਹਿ ॥",
      "transliteration": "jaa sam upajaa dhutiy na meh meh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਕੋਈ ਹੋਰ ਦੂਜਾ ਧਰਤੀ ਉਤੇ ਪੈਦਾ ਨਹੀਂ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "जा सम उपजा दुतिय न महि महि ॥",
      "sourceLineId": "135487",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਹਾ ਸੂਰ ਅਰੁ ਸੁੰਦਰ ਘਨੋ ॥",
      "transliteration": "mahaa soor ar su(n)dhar ghano ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵੱਡਾ ਸੂਰਮਾ ਅਤੇ ਅਤਿ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "महा सूर अरु सुँदर घनो ॥",
      "sourceLineId": "135488",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਨੁ ਅਵਤਾਰ ਮਦਨ ਕੋ ਬਨੋ ॥੩॥",
      "transliteration": "jan avataar madhan ko bano ||3||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਕਾਮ ਦੇਵ ਦਾ ਅਵਤਾਰ ਹੋਵੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "जनु अवतार मदन को बनो ॥३॥",
      "sourceLineId": "135489",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1298_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੋ ਨ੍ਰਿਪ ਇਕ ਦਿਨ ਚੜਾ ਸਿਕਾਰਾ ॥",
      "transliteration": "so nirap ik dhin chaRaa sikaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜਾ ਇਕ ਦਿਨ ਸ਼ਿਕਾਰ ਚੜ੍ਰਹਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1298,
      "hindi": "",
      "hindiTransliteration": "सो नृप इक दिन चड़ा सिकारा ॥",
      "sourceLineId": "135490",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
