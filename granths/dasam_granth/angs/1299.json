{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1299,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1299_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਾਰਤ ਰੀਝ ਰੋਝ ਝੰਖਾਰਾ ॥",
      "transliteration": "maarat reejh rojh jha(n)khaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਬਹੁਤ ਸਾਰੇ) ਰੋਝ, ਰਿਛ ਅਤੇ ਬਾਰਾਸਿੰਗੇ ਮਾਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "मारत रीझ रोझ झंखारा ॥",
      "sourceLineId": "135491",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਸਕਾਵਤੀ ਨਗਰ ਤਰ ਨਿਕਸਾ ॥",
      "transliteration": "eisakaavatee nagar tar nikasaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਸਕਾਵਤੀ ਨਗਰ ਦੇ ਨੇੜੇ ਜਾ ਨਿਕਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "इसकावती नगर तर निकसा ॥",
      "sourceLineId": "135492",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਭਾ ਬਿਲੋਕਿ ਨਗਰ ਕੀ ਬਿਗਸਾ ॥੪॥",
      "transliteration": "prabhaa bilok nagar kee bigasaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਨਗਰ ਦੀ ਸੁੰਦਰਤਾ ਵੇਖ ਕੇ ਪ੍ਰਸੰਨ ਹੋਇਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "प्रभा बिलोकि नगर की बिगसा ॥४॥",
      "sourceLineId": "135493",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਸ ਸੁੰਦਰਿ ਜਿਹ ਨ੍ਰਿਪ ਕੀ ਨਗਰੀ ॥",
      "transliteration": "as su(n)dhar jeh nirap kee nagaree ||",
      "translation": "",
      "punjabiViakhya": "(ਮਨ ਵਿਚ ਸੋਚਣ ਲਗਾ) ਜਿਸ ਰਾਜੇ ਦੀ ਨਗਰੀ ਇਤਨੀ ਸੁੰਦਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "अस सुँदरि जिह नृप की नगरी ॥",
      "sourceLineId": "135494",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਸ ਹ੍ਵੈ ਹੈ ਤਿਹ ਨਾਰਿ ਉਜਗਰੀ ॥",
      "transliteration": "kas havai hai teh naar ujagaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਇਸਤਰੀ (ਭਾਵ-ਰਾਣੀ) ਕਿਤਨੀ ਖ਼ੂਬਸੂਰਤ ਹੋਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "कस ह्वै है तिह नारि उजगरी ॥",
      "sourceLineId": "135495",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਿਹ ਕਿਹ ਬਿਧਿ ਤਿਹ ਰੂਪ ਨਿਹਰਿਯੈ ॥",
      "transliteration": "jeh keh bidh teh roop nihariyai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖੀਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "जिह किह बिधि तिह रूप निहरियै ॥",
      "sourceLineId": "135496",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਤਰ ਅਤਿਥ ਇਹੀ ਹ੍ਵੈ ਮਰਿਯੈ ॥੫॥",
      "transliteration": "naatar atith ihee havai mariyai ||5||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਇਥੇ ਹੀ ਸਾਧ ਬਣ ਕੇ ਮਰ ਜਾਈਏ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "नातर अतिथ इही ह्वै मरियै ॥५॥",
      "sourceLineId": "135497",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਸਤ੍ਰ ਉਤਾਰਿ ਮੇਖਲਾ ਡਾਰੀ ॥",
      "transliteration": "basatr utaar mekhalaa ddaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਸਤ੍ਰ ਉਤਾਰ ਕੇ ਗੋਦੜੀ ਧਾਰਨ ਕਰ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "बसत्र उतारि मेखला डारी ॥",
      "sourceLineId": "135498",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭੂਖਨ ਛੋਰਿ ਭਿਭੂਤਿ ਸਵਾਰੀ ॥",
      "transliteration": "bhookhan chhor bhibhoot savaaree ||",
      "translation": "",
      "punjabiViakhya": "ਗਹਿਣੇ ਲਾਹ ਕੇ ਬਿਭੂਤੀ (ਸੁਆਹ) ਮਲ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "भूखन छोरि भिभूति सवारी ॥",
      "sourceLineId": "135499",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਭ ਤਨ ਭੇਖ ਅਤਿਥ ਕਾ ਧਾਰਾ ॥",
      "transliteration": "sabh tan bhekh atith kaa dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸ਼ਰੀਰ ਉਤੇ ਸਾਧ ਦਾ ਭੇਸ ਬਣਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "सभ तन भेख अतिथ का धारा ॥",
      "sourceLineId": "135500",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਸਨ ਆਨ ਦ੍ਵਾਰ ਤਿਹ ਮਾਰਾ ॥੬॥",
      "transliteration": "aasan aan dhavaiaar teh maaraa ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਦੁਆਰ ਉਤੇ ਆਸਣ ਜਮਾ ਦਿੱਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "आसन आन द्वार तिह मारा ॥६॥",
      "sourceLineId": "135501",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕੇਤਕ ਬਰਸ ਤਹਾ ਬਿਤਾਏ ॥",
      "transliteration": "ketak baras tahaa bitaae ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕਿਤਨੇ ਵਰ੍ਰਹੇ (ਉਥੇ ਬੈਠਿਆਂ) ਬਿਤਾ ਦਿੱਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "केतक बरस तहा बिताए ॥",
      "sourceLineId": "135502",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਜ ਤਰੁਨਿ ਕੇ ਦਰਸ ਨ ਪਾਏ ॥",
      "transliteration": "raaj tarun ke dharas na paae ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਰਾਣੀ ਦਾ ਦੀਦਾਰ ਨਾ ਕਰ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "राज तरुनि के दरस न पाए ॥",
      "sourceLineId": "135503",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿਤਕ ਦਿਨਨ ਪ੍ਰਤਿਬਿੰਬੁ ਨਿਹਾਰਾ ॥",
      "transliteration": "kitak dhinan pratibi(n)b nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਦਿਨਾ ਬਾਦ (ਰਾਣੀ ਦੀ) ਪਰਛਾਈ ਵੇਖੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "कितक दिनन प्रतिबिंबु निहारा ॥",
      "sourceLineId": "135504",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚਤੁਰ ਭੇਦ ਸਭ ਗਯੋ ਬਿਚਾਰਾ ॥੭॥",
      "transliteration": "chatur bhedh sabh gayo bichaaraa ||7||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ) ਚਤੁਰ ਸੀ (ਇਸ ਲਈ) ਸਾਰਾ ਭੇਦ ਵਿਚਾਰ ਲਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "चतुर भेद सभ गयो बिचारा ॥७॥",
      "sourceLineId": "135505",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਰੁਨੀ ਖਰੀ ਸਦਨ ਆਨੰਦ ਭਰਿ ॥",
      "transliteration": "tarunee kharee sadhan aana(n)dh bhar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਆਨੰਦ ਪੂਰਵਕ (ਆਪਣੇ) ਘਰ ਵਿਚ ਖੜੋਤੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "तरुनी खरी सदन आनंद भरि ॥",
      "sourceLineId": "135506",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਲ ਪ੍ਰਤਿਬਿੰਬ ਪਰਾ ਤਿਹ ਸੁੰਦਰਿ ॥",
      "transliteration": "jal pratibi(n)b paraa teh su(n)dhar ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਸੁੰਦਰੀ ਦੀ ਪਰਛਾਈ ਪਾਣੀ ਵਿਚ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "जल प्रतिबिंब परा तिह सुँदरि ॥",
      "sourceLineId": "135507",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਹੀ ਸੁਘਰ ਤਿਹ ਠਾਢ ਨਿਹਾਰਾ ॥",
      "transliteration": "tahee sughar teh Thaadd nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਖੜੋਤਿਆਂ ਹੀ ਉਸ ਸੁਘੜ (ਰਾਜੇ) ਨੇ ਉਸ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "तही सुघर तिह ठाढ निहारा ॥",
      "sourceLineId": "135508",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਾਨਿ ਗਯੋ ਸਭ ਭੇਦ ਸੁਧਾਰਾ ॥੮॥",
      "transliteration": "jaan gayo sabh bhedh sudhaaraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਭੇਦ ਨੂੰ ਸਮਝ ਗਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "जानि गयो सभ भेद सुधारा ॥८॥",
      "sourceLineId": "135509",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤ੍ਰਿਯਹੁ ਤਾਹਿ ਪ੍ਰਤਿਬਿੰਬੁ ਲਖਾ ਜਬ ॥",
      "transliteration": "tirayahu taeh pratibi(n)b lakhaa jab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਸਤਰੀ ਨੇ ਵੀ ਉਸ ਦੀ ਪਰਛਾਈ (ਪਾਣੀ ਵਿਚ) ਵੇਖੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "तृयहु ताहि प्रतिबिंबु लखा जब ॥",
      "sourceLineId": "135510",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਕਹਾ ਚਿਤ ਭੀਤਰ ਤਬ ॥",
      "transliteration": "eeh bidh kahaa chit bheetar tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮਨ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਸੋਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "इह बिधि कहा चित भीतर तब ॥",
      "sourceLineId": "135511",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਹੁ ਜਨਿਯਤ ਕੋਈ ਰਾਜ ਕੁਮਾਰਾ ॥",
      "transliteration": "eih janiyat koiee raaj kumaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਹ ਕੋਈ ਰਾਜ ਕੁਮਾਰ ਲਗਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "इहु जनियत कोई राज कुमारा ॥",
      "sourceLineId": "135512",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਾਰਬਤੀਸ ਅਰਿ ਕੋ ਅਵਤਾਰਾ ॥੯॥",
      "transliteration": "paarabatees ar ko avataaraa ||9||",
      "translation": "",
      "punjabiViakhya": "(ਜਾ) ਕਾਮ ਦੇਵ ਦਾ ਅਵਤਾਰ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "पारबतीस अरि को अवतारा ॥९॥",
      "sourceLineId": "135513",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਾਨੀ ਬੋਲਿ ਸੁਰੰਗਿਯਾ ਲੀਨਾ ॥",
      "transliteration": "raanee bol sura(n)giyaa leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਇਕ ਸੁਰੰਗ ਬੁਣਾਉਣ ਵਾਲੇ ਨੂੰ ਬੁਲਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "रानी बोलि सुरंगिया लीना ॥",
      "sourceLineId": "135514",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਤਿ ਹੀ ਦਰਬ ਗੁਪਤ ਤਿਹ ਦੀਨਾ ॥",
      "transliteration": "at hee dharab gupat teh dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਗੁਪਤ ਤੌਰ ਤੇ ਬਹੁਤ ਧਨ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "अति ही दरब गुपत तिह दीना ॥",
      "sourceLineId": "135515",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਿਜੁ ਗ੍ਰਿਹ ਭੀਤਰਿ ਸੁਰੰਗਿ ਦਿਵਾਈ ॥",
      "transliteration": "nij gireh bheetar sura(n)g dhivaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਆਪਣੇ ਘਰ ਵਿਚ ਇਕ ਸੁਰੰਗ ਬਣਵਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "निजु गृह भीतरि सुरंगि दिवाई ॥",
      "sourceLineId": "135516",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਾਢੀ ਤਹੀ ਨ ਕਿਨਹੂੰ ਪਾਈ ॥੧੦॥",
      "transliteration": "kaaddee tahee na kinahoo(n) paiee ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਥੇ ਜਾ ਕਢੀ, ਪਰ ਕਿਸੇ ਨੂੰ ਪਤਾ ਨਾ ਲਗਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "काढी तही न किनहूँ पाई ॥१०॥",
      "sourceLineId": "135517",
      "sourceShabadId": "12628",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "135518",
      "sourceShabadId": "12629",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਖੀ ਤਿਸੀ ਮਾਰਗ ਪਠੀ ਤਹੀ ਪਹੂੰਚੀ ਜਾਇ ॥",
      "transliteration": "sakhee tisee maarag paThee tahee pahoo(n)chee jai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਸੇ ਮਾਰਗ ਰਾਹੀਂ ਸਖੀ ਨੂੰ ਭੇਜਿਆ, (ਜੋ) ਉਥੇ ਜਾ ਪਹੁੰਚੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "सखी तिसी मारग पठी तही पहूँची जाइ ॥",
      "sourceLineId": "135519",
      "sourceShabadId": "12629",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗਹਿ ਜਾਘਨ ਤੇ ਲੈ ਗਈ ਚਲਾ ਨ ਭੂਪ ਉਪਾਇ ॥੧੧॥",
      "transliteration": "geh jaaghan te lai giee chalaa na bhoop upai ||11||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਟੰਗੋਂ ਪਕੜ ਕੇ ਲੈ ਗਈ ਪਰ ਉਸ (ਰਾਜੇ) ਦਾ ਕੋਈ ਉਪਾ ਨਾ ਚਲ ਸਕਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "गहि जाघन ते लै गई चला न भूप उपाइ ॥११॥",
      "sourceLineId": "135520",
      "sourceShabadId": "12629",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135521",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗਹਿ ਨ੍ਰਿਪ ਕੋ ਲੈ ਗਈ ਸਖੀ ਤਹ ॥",
      "transliteration": "geh nirap ko lai giee sakhee teh ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਪਕੜ ਕੇ ਸਖੀ ਉਥੇ ਲੈ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "गहि नृप को लै गई सखी तह ॥",
      "sourceLineId": "135522",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰਾਨੀ ਹੁਤੀ ਬਿਲੋਕਤਿ ਮਗ ਜਹ ॥",
      "transliteration": "raanee hutee bilokat mag jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਣੀ ਉਸ ਦਾ ਰਾਹ ਵੇਖ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "रानी हुती बिलोकति मग जह ॥",
      "sourceLineId": "135523",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦਿਯਾ ਮਿਲਾਇ ਮਿਤ੍ਰ ਤਾ ਕੋ ਇਨ ॥",
      "transliteration": "dhiyaa milai mitr taa ko in ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ (ਸਖੀ) ਨੇ ਉਸ ਨੂੰ ਮਿਤਰ ਮਿਲਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "दिया मिलाइ मित्र ता को इन ॥",
      "sourceLineId": "135524",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਨ ਮਾਨਤ ਰਤਿ ਕਰੀ ਦੁਹੂ ਤਿਨ ॥੧੨॥",
      "transliteration": "man maanat rat karee dhuhoo tin ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦੋਹਾ ਨੇ ਮਨਮਰਜ਼ੀ ਅਨੁਸਾਰ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "मन मानत रति करी दुहू तिन ॥१२॥",
      "sourceLineId": "135525",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਚੁੰਬਨ ਦੁਹੂੰ ਲੀਨੋ ॥",
      "transliteration": "bhaat bhaat chu(n)ban dhuhoo(n) leeno ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਕਈ ਪ੍ਰਕਾਰ ਦੇ ਚੁੰਬਨ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "भाति भाति चुँबन दुहूँ लीनो ॥",
      "sourceLineId": "135526",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਨਿਕ ਅਨਿਕ ਆਸਨ ਤ੍ਰਿਯ ਦੀਨੇ ॥",
      "transliteration": "anik anik aasan tiray dheene ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ ਨੇ ਕਈ ਪ੍ਰਕਾਰ ਦੇ ਆਸਣ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "अनिक अनिक आसन तृय दीने ॥",
      "sourceLineId": "135527",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਸ ਲੁਭਧਾ ਰਾਜਾ ਕੋ ਚਿਤਾ ॥",
      "transliteration": "as lubhadhaa raajaa ko chitaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਾਜੇ ਦਾ ਚਿਤ ਇਸ ਤਰ੍ਰਹਾ ਲੁਭਾ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "अस लुभधा राजा को चिता ॥",
      "sourceLineId": "135528",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਸ ਗੁਨਿ ਜਨ ਸੁਨਿ ਸ੍ਰਵਨ ਕਬਿਤਾ ॥੧੩॥",
      "transliteration": "jas gun jan sun sravan kabitaa ||13||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਗੁਣੀ ਜਨ ਕੰਨਾ ਨਾਲ ਕਵਿਤਾ ਸੁਣ ਕੇ ਮੋਹੇ ਜਾਦੇ ਹਨ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "जस गुनि जन सुनि स्रवन कबिता ॥१३॥",
      "sourceLineId": "135529",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਾਨੀ ਕਹਤ ਬਚਨ ਸੁਨੁ ਮੀਤਾ ॥",
      "transliteration": "raanee kahat bachan sun meetaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਕਿਹਾ, ਹੇ ਮੇਰੇ ਮਿਤਰ! ਮੇਰੇ ਬਚਨ ਸੁਣ!",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "रानी कहत बचन सुनु मीता ॥",
      "sourceLineId": "135530",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੌ ਸੌ ਬਧਾ ਹਮਾਰਾ ਚੀਤਾ ॥",
      "transliteration": "tau sau badhaa hamaaraa cheetaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰਾ ਚਿਤ ਤੁਹਾਡੇ ਨਾਲ ਬੰਨ੍ਰਹਿਆ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "तौ सौ बधा हमारा चीता ॥",
      "sourceLineId": "135531",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਬ ਤੇ ਤਵ ਪ੍ਰਤਿਬਿੰਬੁ ਨਿਹਾਰਾ ॥",
      "transliteration": "jab te tav pratibi(n)b nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੀ ਮੈਂ ਤੁਹਾਡੀ ਪਰਛਾਈ ਵੇਖੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "जब ते तव प्रतिबिंबु निहारा ॥",
      "sourceLineId": "135532",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਬ ਤੇ ਮਨ ਹਠ ਪਰਿਯੋ ਹਮਾਰਾ ॥੧੪॥",
      "transliteration": "tab te man haTh pariyo hamaaraa ||14||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੋਂ ਮੇਰਾ ਮਨ ਹਠ ਪੂਰਵਕ (ਤੁਹਾਡੇ ਵਸ ਵਿਚ) ਹੋ ਗਿਆ ਹੈ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "तब ते मन हठ परियो हमारा ॥१४॥",
      "sourceLineId": "135533",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਿਤਿਪ੍ਰਤਿ ਚਹੈ ਤੁਮੀ ਸੰਗ ਜਾਊ ॥",
      "transliteration": "nitiprat chahai tumee sa(n)g jaauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਮੇਰਾ ਮਨ ਇਹ) ਚਾਹੁੰਦਾ ਹੈ ਕਿ ਸਦਾ ਤੁਹਾਡੇ ਨਾਲ ਵਿਚਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "नितिप्रति चहै तुमी संग जाऊ ॥",
      "sourceLineId": "135534",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਕੀ ਕਾਨਿ ਨ ਲ੍ਯਾਊ ॥",
      "transliteration": "maat pitaa kee kaan na layaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਾਤਾ ਪਿਤਾ ਦੀ ਪਰਵਾਹ ਨਾ ਕਰਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "मात पिता की कानि न ल्याऊ ॥",
      "sourceLineId": "135535",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਬ ਕਿਛੁ ਅਸ ਪਿਯ ਚਰਿਤ ਬਨੈਯੈ ॥",
      "transliteration": "ab kichh as piy charit banaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪ੍ਰੀਤਮ! ਹੁਣ ਕੋਈ ਅਜਿਹਾ ਚਰਿਤ੍ਰ ਕਰੀਏ ਕਿ ਲਾਜ ਵੀ ਰਹਿ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "अब किछु अस पिय चरित बनैयै ॥",
      "sourceLineId": "135536",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਲਾਜ ਰਹੈ ਤੋਹਿ ਪਤਿ ਪੈਯੈ ॥੧੫॥",
      "transliteration": "laaj rahai toh pat paiyai ||15||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਹਾਨੂੰ ਪਤੀ ਵਜੋਂ ਪ੍ਰਾਪਤ ਕਰ ਲਵਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "लाज रहै तोहि पति पैयै ॥१५॥",
      "sourceLineId": "135537",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1299_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਛੋਰਿ ਕਥਾ ਤਿਹ ਭੂਪ ਸੁਨਾਈ ॥",
      "transliteration": "chhor kathaa teh bhoop sunaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਰਾਜੇ ਨੇ (ਆਪਣੀ) ਸਾਰੀ ਕਹਾਣੀ ਸੁਣਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1299,
      "hindi": "",
      "hindiTransliteration": "छोरि कथा तिह भूप सुनाई ॥",
      "sourceLineId": "135538",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
