{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1300,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1300_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਿਜੁ ਨ੍ਰਿਪ ਤਾ ਕੀ ਕਥਾ ਜਤਾਈ ॥",
      "transliteration": "nij nirap taa kee kathaa jataiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਰਾਜਾ ਹੋਣ ਦੀ ਗੱਲ ਦਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "निजु नृप ता की कथा जताई ॥",
      "sourceLineId": "135539",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮੈ ਹੌ ਰਾਸਟ੍ਰ ਦੇਸ ਕੋ ਰਾਜਾ ॥",
      "transliteration": "mai hau raasaTr dhes ko raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਰਾਸਟ੍ਰ ਦੇਸ ਦਾ ਰਾਜਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "मै हौ रासट्र देस को राजा ॥",
      "sourceLineId": "135540",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਵ ਹਿਤ ਭੇਸ ਅਤਿਥ ਕੋ ਸਾਜਾ ॥੧੬॥",
      "transliteration": "tav hit bhes atith ko saajaa ||16||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੇ ਲਈ ਸਾਧ ਦਾ ਭੇਸ ਧਾਰਿਆ ਹੈ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "तव हित भेस अतिथ को साजा ॥१६॥",
      "sourceLineId": "135541",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨੇਤ੍ਰ ਲਗੇ ਤੁਮ ਸੌ ਹਮਰੇ ਤਬ ॥",
      "transliteration": "netr lage tum sau hamare tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੋਂ ਮੇਰੀਆਂ ਅੱਖਾ ਤੇਰੇ ਨਾਲ ਲਗ ਗਈਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "नेत्र लगे तुम सौ हमरे तब ॥",
      "sourceLineId": "135542",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਵ ਪ੍ਰਤਿਬਿੰਬੁ ਲਖੇ ਜਲ ਮਹਿ ਜਬ ॥",
      "transliteration": "tav pratibi(n)b lakhe jal meh jab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੀ ਮੈਂ ਤੇਰੀ ਪਰਛਾਈ ਜਲ ਵਿਚ ਵੇਖੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "तव प्रतिबिंबु लखे जल महि जब ॥",
      "sourceLineId": "135543",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਵ ਮੁਰਿ ਜਬ ਪ੍ਰਤਿਬਿੰਬੁ ਨਿਹਾਰਾ ॥",
      "transliteration": "tav mur jab pratibi(n)b nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਵੀ ਜਦ (ਜਲ ਵਿਚ) ਮੇਰੀ ਪਰਛਾਈ ਵੇਖੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "तव मुरि जब प्रतिबिंबु निहारा ॥",
      "sourceLineId": "135544",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗਯੋ ਮਾਰਿ ਤੁਹਿ ਮਦਨ ਕਟਾਰਾ ॥੧੭॥",
      "transliteration": "gayo maar tuh madhan kaTaaraa ||17||",
      "translation": "",
      "punjabiViakhya": "ਤੈਨੂੰ ਵੀ ਤਦ ਦਾ ਕਾਮ ਦੇਵ ਕਟਾਰ ਮਾਰ ਗਿਆ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "गयो मारि तुहि मदन कटारा ॥१७॥",
      "sourceLineId": "135545",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮੁਹਿ ਲਖਿ ਧੀਰਜ ਨ ਤੁਮਰਾ ਰਹਾ ॥",
      "transliteration": "muh lakh dheeraj na tumaraa rahaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਵੇਖ ਕੇ ਤੇਰਾ ਧੀਰਜ ਨਾ ਰਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "मुहि लखि धीरज न तुमरा रहा ॥",
      "sourceLineId": "135546",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੁਰੰਗਿ ਖੋਦਿ ਸਖਿਯਨ ਅਸ ਕਹਾ ॥",
      "transliteration": "sura(n)g khodh sakhiyan as kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੁਰੰਗ ਪੁਟਵਾ ਕੇ ਸਖੀ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "सुरंगि खोदि सखियन अस कहा ॥",
      "sourceLineId": "135547",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੋ ਗਹਿ ਮੁਹਿ ਗੀ ਤੀਰ ਤਿਹਾਰੀ ॥",
      "transliteration": "so geh muh gee teer tihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੈਨੂੰ ਪਕੜ ਕੇ ਤੇਰੇ ਕੋਲ ਲੈ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "सो गहि मुहि गी तीर तिहारी ॥",
      "sourceLineId": "135548",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚਹਤ ਜੋ ਥੋ ਸੋ ਭਈ ਪਿਯਾਰੀ ॥੧੮॥",
      "transliteration": "chahat jo tho so bhiee piyaaree ||18||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਆਰੀ! ਜੋ ਤੂੰ ਚਾਹੁੰਦੀ ਸੀ, ਉਹੀ ਕੁਝ ਹੋਇਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "चहत जो थो सो भई पियारी ॥१८॥",
      "sourceLineId": "135549",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੁਹੂੰ ਬੈਠ ਇਕ ਮੰਤ੍ਰ ਬਿਚਾਰਾ ॥",
      "transliteration": "dhuhoo(n) baiTh ik ma(n)tr bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਬੈਠ ਕੇ ਇਕ ਸਲਾਹ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "दुहूँ बैठ इक मंत्र बिचारा ॥",
      "sourceLineId": "135550",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮੈ ਰਾਜਾ ਲਖਿ ਗਯੋ ਰਖਵਾਰਾ ॥",
      "transliteration": "mai raajaa lakh gayo rakhavaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਰਾਜੇ ਦਾ ਚੌਕੀਦਾਰ ਵੇਖ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "मै राजा लखि गयो रखवारा ॥",
      "sourceLineId": "135551",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਿਯ ਪਠਾਇ ਗ੍ਰਿਹ ਐਸ ਉਚਾਰੀ ॥",
      "transliteration": "piy paThai gireh aais uchaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਯਾਰ ਨੂੰ ਘਰ ਭੇਜ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "पिय पठाइ गृह ऐस उचारी ॥",
      "sourceLineId": "135552",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਲੋਨ ਲੇਤ ਨ੍ਰਿਪ ਨਾਰ ਤਿਹਾਰੀ ॥੧੯॥",
      "transliteration": "lon let nirap naar tihaaree ||19||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਤੁਹਾਡੀ ਰਾਣੀ ਲੂਣ ਲੈ ਕੇ (ਗਲ ਜਾਣਾ) ਚਾਹੁੰਦੀ ਹੈ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "लोन लेत नृप नार तिहारी ॥१९॥",
      "sourceLineId": "135553",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਨਤ ਸ੍ਰਵਨ ਸਭ ਜਨ ਮਿਲਿ ਆਏ ॥",
      "transliteration": "sunat sravan sabh jan mil aae ||",
      "translation": "",
      "punjabiViakhya": "ਕੰਨਾ ਨਾਲ ਸੁਣ ਕੇ ਸਾਰੇ ਵਿਅਕਤੀ ਮਿਲ ਕੇ ਆ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "सुनत स्रवन सभ जन मिलि आए ॥",
      "sourceLineId": "135554",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਨਿ ਤਵਨ ਕਹ ਬਚਨ ਸੁਨਾਏ ॥",
      "transliteration": "aan tavan keh bachan sunaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆ ਕੇ ਉਸ ਨੂੰ ਕਹਿਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "आनि तवन कह बचन सुनाए ॥",
      "sourceLineId": "135555",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿਹ ਨਿਮਿਤ ਛਾਡਤ ਹੈ ਦੇਹੀ ॥",
      "transliteration": "keh nimit chhaaddat hai dhehee ||",
      "translation": "",
      "punjabiViakhya": "ਤੂੰ ਕਿਸ ਲਈ ਸ਼ਰੀਰ ਛਡ ਰਹੀ ਹੈਂ?",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "किह निमित छाडत है देही ॥",
      "sourceLineId": "135556",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੁਨਿ ਰਾਜਾ ਕੀ ਨਾਰਿ ਸਨੇਹੀ ॥੨੦॥",
      "transliteration": "sun raajaa kee naar sanehee ||20||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜੇ ਦੀ ਪਿਆਰੀ ਰਾਣੀ! ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "सुनि राजा की नारि सनेही ॥२०॥",
      "sourceLineId": "135557",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਦਿਜ ਮਾਰਿਯੋ ਮੁਹਿ ॥",
      "transliteration": "sun raajaa ik dhij maariyo muh ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ ਕਿਹਾ) ਹੇ ਰਾਜਨ! ਸੁਣੋ, ਮੈਂ ਇਕ ਬ੍ਰਾਹਮਣ ਨੂੰ ਮਾਰਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा इक दिज मारियो मुहि ॥",
      "sourceLineId": "135558",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਲੋਨ ਲੇਊਗੀ ਸਾਚ ਕਹੂੰ ਤੁਹਿ ॥",
      "transliteration": "lon leuoogee saach kahoo(n) tuh ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਂ ਸਚ ਕਹਿੰਦੀ ਹਾ, ਲੂਣ ਲੈ ਕੇ (ਗਲ ਜਾਵਾਗੀ)।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "लोन लेऊगी साच कहूँ तुहि ॥",
      "sourceLineId": "135559",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੋ ਧਨ ਹਮਰੇ ਧਾਮ ਨਿਹਾਰਹੁ ॥",
      "transliteration": "jo dhan hamare dhaam nihaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਧਨ ਤੁਸੀਂ ਮੇਰੇ ਘਰ ਵਿਚ ਵੇਖੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "जो धन हमरे धाम निहारहु ॥",
      "sourceLineId": "135560",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋ ਸਭ ਗਾਡਿ ਗੋਰਿ ਮਹਿ ਡਾਰਹੁ ॥੨੧॥",
      "transliteration": "so sabh gaadd gor meh ddaarahu ||21||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸਾਰੇ ਨੂੰ ਕਬਰ ਵਿਚ ਦਬ ਦਿਓ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "सो सभ गाडि गोरि महि डारहु ॥२१॥",
      "sourceLineId": "135561",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹੋਰਿ ਰਹੇ ਸਭ ਏਕ ਨ ਮਾਨੀ ॥",
      "transliteration": "hor rahe sabh ek na maanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਹੋੜਦੇ ਰਹੇ, (ਪਰ ਉਸ ਨੇ) ਇਕ ਨਾ ਮੰਨੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "होरि रहे सभ एक न मानी ॥",
      "sourceLineId": "135562",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪਰੀ ਭੋਹਰਾ ਭੀਤਰ ਰਾਨੀ ॥",
      "transliteration": "paree bhoharaa bheetar raanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਭੋਰੇ ਵਿਚ ਪੈ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "परी भोहरा भीतर रानी ॥",
      "sourceLineId": "135563",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਸ ਪਾਸ ਲੈ ਲੋਨ ਬਿਥਾਰੋ ॥",
      "transliteration": "aas paas lai lon bithaaro ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਆਲੇ ਦੁਆਲੇ ਲੂਣ ਖਿਲਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "आस पास लै लोन बिथारो ॥",
      "sourceLineId": "135564",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੋ ਧਨ ਹੁਤੋ ਗਾਡਿ ਸਭ ਡਾਰੋ ॥੨੨॥",
      "transliteration": "jo dhan huto gaadd sabh ddaaro ||22||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੋ ਧਨ ਸੀ, ਉਸ ਸਾਰੇ ਨੂੰ ਗਡ ਦਿੱਤਾ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "जो धन हुतो गाडि सभ डारो ॥२२॥",
      "sourceLineId": "135565",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੁਰੰਗਿ ਸੁਰੰਗਿ ਰਾਨੀ ਤਹ ਆਈ ॥",
      "transliteration": "sura(n)g sura(n)g raanee teh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਰੰਗ ਰਾਹੀਂ ਰਾਣੀ ਉਥੇ ਆ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "सुरंगि सुरंगि रानी तह आई ॥",
      "sourceLineId": "135566",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬੈਠੇ ਜਹਾ ਮੀਤ ਸੁਖਦਾਈ ॥",
      "transliteration": "baiThe jahaa meet sukhadhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਸੁਖਦਾਇਕ ਮਿਤਰ ਬੈਠਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "बैठे जहा मीत सुखदाई ॥",
      "sourceLineId": "135567",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਾ ਕੋ ਸੰਗ ਲੌ ਤਹੀ ਸਿਧਾਰੀ ॥",
      "transliteration": "taa ko sa(n)g lau tahee sidhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਉਥੋਂ ਚਲ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "ता को संग लौ तही सिधारी ॥",
      "sourceLineId": "135568",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੂੜ ਲੋਗ ਕਛੁ ਗਤਿ ਨ ਬਿਚਾਰੀ ॥੨੩॥",
      "transliteration": "mooR log kachh gat na bichaaree ||23||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਲੋਕਾ ਨੇ (ਉਸ ਦੀ) ਚਾਲ ਨੂੰ ਨਾ ਸਮਝਿਆ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "मूड़ लोग कछु गति न बिचारी ॥२३॥",
      "sourceLineId": "135569",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਿਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੬॥੬੪੩੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chhitaalees charitr samaapatam sat subham sat ||346||6433||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੪੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੪੬॥੬੪੩੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ छितालीस चरित्र समापतम सतु सुभम सतु ॥३४६॥६४३३॥अफजूँ॥",
      "sourceLineId": "135570",
      "sourceShabadId": "12630",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135571",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਹ ਹਮ ਦਿਸਾ ਉਤਰਾ ਸੁਨੀ ॥",
      "transliteration": "jeh ham dhisaa utaraa sunee ||",
      "translation": "",
      "punjabiViakhya": "ਅਸੀਂ ਜਿਧਰ ਨੂੰ ਉੱਤਰ ਦਿਸ਼ਾ ਸੁਣੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "जह हम दिसा उतरा सुनी ॥",
      "sourceLineId": "135572",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਾਜਾ ਤਹਿਕ ਬਸਤ ਥੋ ਗੁਨੀ ॥",
      "transliteration": "raajaa tahik basat tho gunee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਗੁਣਵਾਨ ਰਾਜਾ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "राजा तहिक बसत थो गुनी ॥",
      "sourceLineId": "135573",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਲਗੀ ਰਾਇ ਜਾਹਿ ਜਗ ਭਾਖਤ ॥",
      "transliteration": "kalagee rai jaeh jag bhaakhat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਗਤ ਕਲਗੀ ਰਾਇ ਕਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "कलगी राइ जाहि जग भाखत ॥",
      "sourceLineId": "135574",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਾ ਦੇਸ ਕਾਨਿ ਤਿਹ ਰਾਖਤ ॥੧॥",
      "transliteration": "naanaa dhes kaan teh raakhat ||1||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕ ਦੇਸ਼ ਉਸ ਦੀ ਈਨ ਮੰਨਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "नाना देस कानि तिह राखत ॥१॥",
      "sourceLineId": "135575",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੀਤ ਮਤੀ ਤਿਹ ਨਾਰਿ ਬਿਰਾਜੈ ॥",
      "transliteration": "meet matee teh naar biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਰਾਣੀ ਦਾ ਨਾ ਮੀਤ ਮਤੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "मीत मती तिह नारि बिराजै ॥",
      "sourceLineId": "135576",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾਹਿ ਬਿਲੋਕਿ ਚੰਦ੍ਰਮਾ ਲਾਜੈ ॥",
      "transliteration": "jaeh bilok cha(n)dhramaa laajai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਚੰਦ੍ਰਮਾ ਵੀ ਸ਼ਰਮਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "जाहि बिलोकि चंद्रमा लाजै ॥",
      "sourceLineId": "135577",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਾ ਕੀ ਏਕ ਲਛਿਮਿਨਿ ਦਾਸੀ ॥",
      "transliteration": "taa kee ek lachhimin dhaasee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਲਛਮਨੀ ਨਾ ਦੀ ਇਕ ਦਾਸੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "ता की एक लछिमिनि दासी ॥",
      "sourceLineId": "135578",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੁਰਬਲ ਦੇਹ ਘੜੀ ਅਬਿਨਾਸੀ ॥੨॥",
      "transliteration": "dhurabal dheh ghaRee abinaasee ||2||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮਾਤਮਾ ਨੇ ਉਸ ਦੇ ਸ਼ਰੀਰ ਨੂੰ ਬਹੁਤ ਦੁਰਬਲ ਬਣਾਇਆ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "दुरबल देह घड़ी अबिनासी ॥२॥",
      "sourceLineId": "135579",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਾ ਸੌ ਨਾਰਿ ਹੇਤੁ ਅਤਿ ਮਾਨੈ ॥",
      "transliteration": "taa sau naar het at maanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਸਤਰੀ ਰਾਣੀ ਨੂੰ ਬਹੁਤ ਪਿਆਰ ਕਰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "ता सौ नारि हेतु अति मानै ॥",
      "sourceLineId": "135580",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮੂੜ ਨ ਰਾਨੀ ਕ੍ਰਿਆ ਪਛਾਨੈ ॥",
      "transliteration": "mooR na raanee kriaa pachhaanai ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਰਾਣੀ ਉਸ ਦੇ ਕਾਰਜ ਨੂੰ ਨਹੀਂ ਸਮਝਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "मूड़ न रानी कृआ पछानै ॥",
      "sourceLineId": "135581",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਪਤ ਲੇਤ ਦਾਸੀ ਸੁ ਛਿਮਾਹੀ ॥",
      "transliteration": "gupat let dhaasee su chhimaahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦਾਸੀ (ਰਾਜੇ ਪਾਸੋਂ) ਗੁਪਤ ਰੂਪ ਵਿਚ ਛੇਮਾਹੀ (ਤਨਖ਼ਾਹ) ਲੈਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "गुपत लेत दासी सु छिमाही ॥",
      "sourceLineId": "135582",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬੁਰੀ ਬੁਰੀ ਤਿਹ ਦੇਤ ਉਗਾਹੀ ॥੩॥",
      "transliteration": "buree buree teh dhet ugaahee ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੈੜੀ ਭੈੜੀ ਗੱਲ ਉਸ (ਰਾਜੇ) ਨੂੰ ਦਸਦੀ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "बुरी बुरी तिह देत उगाही ॥३॥",
      "sourceLineId": "135583",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਿਹ ਰਾਨੀ ਅਪਨੀ ਕਰਿ ਮਾਨੈ ॥",
      "transliteration": "teh raanee apanee kar maanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਰਾਣੀ ਆਪਣਾ ਕਰ ਕੇ ਜਾਣਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "तिह रानी अपनी करि मानै ॥",
      "sourceLineId": "135584",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੂਰਖ ਤਾਹਿ ਜਸੂਸ ਨ ਜਾਨੈ ॥",
      "transliteration": "moorakh taeh jasoos na jaanai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ (ਰਾਜੇ ਦੀ) ਜਾਸੂਸ ਨਹੀਂ ਸਮਝਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "मूरख ताहि जसूस न जानै ॥",
      "sourceLineId": "135585",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਰੈ ਬਾਤ ਤਾ ਕਹ ਜੇ ਸ੍ਰਵਨਨ ॥",
      "transliteration": "parai baat taa keh je sravanan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਕੰਨ ਵਿਚ ਜੋ ਗੱਲ ਪੈਂਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "परै बात ता कह जे स्रवनन ॥",
      "sourceLineId": "135586",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਲਿਖਿ ਪਠਵੈ ਤਤਛਿਨ ਰਾਜਾ ਤਨ ॥੪॥",
      "transliteration": "likh paThavai tatachhin raajaa tan ||4||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉਸੇ ਵੇਲੇ ਲਿਖ ਕੇ ਰਾਜੇ ਨੂੰ ਭੇਜ ਦਿੰਦੀ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "लिखि पठवै ततछिन राजा तन ॥४॥",
      "sourceLineId": "135587",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਹੁਤੇ ਦੋਇ ਦਾਸੀ ਕੇ ਭਾਈ ॥",
      "transliteration": "hute dhoi dhaasee ke bhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾਸੀ ਦੇ ਦੋ ਭਰਾ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "हुते दोइ दासी के भाई ॥",
      "sourceLineId": "135588",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬਿਰਧ ਦੰਤ ਕਛੁ ਕਹਾ ਨ ਜਾਈ ॥",
      "transliteration": "biradh dha(n)t kachh kahaa na jaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ) ਵੱਡਿਆਂ ਦੰਦਾ ਵਾਲਿਆਂ ਬਾਰੇ ਕੁਝ ਕਿਹਾ ਨਹੀਂ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "बिरध दंत कछु कहा न जाई ॥",
      "sourceLineId": "135589",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸ੍ਯਾਮ ਬਰਨ ਇਕ ਦੁਤਿਯ ਕੁਰੂਪਾ ॥",
      "transliteration": "sayaam baran ik dhutiy kuroopaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਾ ਰੰਗ ਕਾਲਾ ਸੀ ਅਤੇ ਦੂਜਾ ਕੁਰੂਪ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "स्याम बरन इक दुतिय कुरूपा ॥",
      "sourceLineId": "135590",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਆਂਖੈ ਜਾਨੁ ਸੁਰਨ ਕੇ ਕੂਪਾ ॥੫॥",
      "transliteration": "aa(n)khai jaan suran ke koopaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਅੱਖਾ ਮਾਨੋ (ਲਾਲ ਰੰਗ ਦੀ) ਸ਼ਰਾਬ ਦੇ ਖੂਹ ਵਰਗੀਆਂ ਸਨ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "आँखै जानु सुरन के कूपा ॥५॥",
      "sourceLineId": "135591",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਬਗਲ ਗੰਧਿ ਤਿਨ ਤੇ ਅਤਿ ਆਵੈ ॥",
      "transliteration": "bagal ga(n)dh tin te at aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀਆਂ ਬਗਲਾ (ਕੱਛਾ) ਵਿਚੋਂ ਬਹੁਤ ਦੁਰਗੰਧ ਆਉਾਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "बगल गंधि तिन ते अति आवै ॥",
      "sourceLineId": "135592",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਬੈਠਨ ਨਿਕਟ ਨ ਕੋਈ ਪਾਵੈ ॥",
      "transliteration": "baiThan nikaT na koiee paavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਨੇੜੇ ਕੋਈ ਬੈਠ ਨਹੀਂ ਸਕਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "बैठन निकट न कोई पावै ॥",
      "sourceLineId": "135593",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਚੇਰੀ ਭ੍ਰਾਤ ਜਾਨਿ ਹਿਤ ਮਾਨੈ ॥",
      "transliteration": "cheree bhraat jaan hit maanai ||",
      "translation": "",
      "punjabiViakhya": "ਦਾਸੀ ਭਰਾ ਸਮਝ ਕੇ (ਉਨ੍ਰਹਾ ਨਾਲ) ਹਿਤ ਕਰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "चेरी भ्रात जानि हित मानै ॥",
      "sourceLineId": "135594",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮੂੜ ਨਾਰਿ ਕਛੁ ਕ੍ਰਿਯਾ ਨ ਜਾਨੈ ॥੬॥",
      "transliteration": "mooR naar kachh kirayaa na jaanai ||6||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੂਰਖ ਇਸਤਰੀ ਕੁਝ ਭੇਦ ਨਹੀਂ ਸਮਝਦੀ ਸੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "मूड़ नारि कछु कृया न जानै ॥६॥",
      "sourceLineId": "135595",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤਹ ਇਕ ਹੁਤੀ ਜਾਟਿ ਕੀ ਨਾਰ ॥",
      "transliteration": "teh ik hutee jaaT kee naar ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਜਟ ਦੀ ਇਸਤਰੀ ਹੁੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "तह इक हुती जाटि की नार ॥",
      "sourceLineId": "135596",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਮੈਨ ਕਹਤ ਤਿਹ ਨਾਮ ਉਚਾਰ ॥",
      "transliteration": "main kahat teh naam uchaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ (ਸਭ) 'ਮੈਨਾ' ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "मैन कहत तिह नाम उचार ॥",
      "sourceLineId": "135597",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜਉ ਤਿਹ ਨਾਮ ਚੇਰਿ ਸੁਨਿ ਪਾਵੇ ॥",
      "transliteration": "jau teh naam cher sun paave ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਦਾ ਨਾ ਦਾਸੀ ਸੁਣ ਲੈਂਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "जउ तिह नाम चेरि सुनि पावे ॥",
      "sourceLineId": "135598",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਤਹ ਤੇ ਤਾਹਿ ਟੂਕਰਾ ਜਾਵੇ ॥੭॥",
      "transliteration": "teh te taeh Tookaraa jaave ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਟੁਕੜਾ (ਖਾਣ ਨੂੰ) ਦਿੰਦੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "तह ते ताहि टूकरा जावे ॥७॥",
      "sourceLineId": "135599",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਤਿਨ ਇਸਤ੍ਰੀ ਇਹ ਭਾਤਿ ਬਿਚਾਰੀ ॥",
      "transliteration": "tin isatree ieh bhaat bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "तिन इसत्री इह भाति बिचारी ॥",
      "sourceLineId": "135600",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਦਾਸੀ ਮੂੜ ਹ੍ਰਿਦੈ ਮਹਿ ਧਾਰੀ ॥",
      "transliteration": "dhaasee mooR hiradhai meh dhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਦੀ ਗੱਲ ਨੂੰ) ਮੂਰਖ ਦਾਸੀ ਨੇ ਮਨ ਵਿਚ ਧਾਰਨ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "दासी मूड़ हृदै महि धारी ॥",
      "sourceLineId": "135601",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਭਾਇ ਖਰਚੁ ਕਛੁ ਮਾਗਤ ਤੇਰੇ ॥",
      "transliteration": "bhai kharach kachh maagat tere ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੇਰੇ ਭਰਾ ਕੁਝ ਖਰਚ ਮੰਗਣ",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "भाइ खरचु कछु मागत तेरे ॥",
      "sourceLineId": "135602",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਗੁਹਜ ਪਠੈਯੈ ਕਰਿ ਕਰਿ ਮੇਰੇ ॥੮॥",
      "transliteration": "guhaj paThaiyai kar kar mere ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੇਰੇ ਹੱਥ ਗੁਪਤ ਢੰਗ ਨਾਲ ਭੇਜ ਦਿਆ ਕਰ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "गुहज पठैयै करि करि मेरे ॥८॥",
      "sourceLineId": "135603",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਤਬ ਚੇਰੀ ਐਸੋ ਤਨ ਕਿਯੋ ॥",
      "transliteration": "tab cheree aaiso tan kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦਾਸੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਹੀ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "तब चेरी ऐसो तन कियो ॥",
      "sourceLineId": "135604",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਡਾਰਿ ਦਰਬ ਭੋਜਨ ਮਹਿ ਦਿਯੋ ॥",
      "transliteration": "ddaar dharab bhojan meh dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੋਜਨ ਵਿਚ ਧਨ ਨੂੰ ਪਾ ਦਿੱਤਾ (ਅਰਥਾਤ-ਭੋਜਨ ਵਿਚ ਲੁਕਾ ਦਿੱਤਾ)।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "डारि दरब भोजन महि दियो ॥",
      "sourceLineId": "135605",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਭਾਇ ਨਿਮਿਤ ਖਰਚੀ ਪਠ ਦਈ ॥",
      "transliteration": "bhai nimit kharachee paTh dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਭਰਾਵਾ ਲਈ (ਉਸ ਨੇ) ਖਰਚਾ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "भाइ निमित खरची पठ दई ॥",
      "sourceLineId": "135606",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸੋ ਲੈ ਨਾਰਿ ਦਰਬੁ ਘਰ ਗਈ ॥੯॥",
      "transliteration": "so lai naar dharab ghar giee ||9||",
      "translation": "",
      "punjabiViakhya": "ਧਨ ਲੈ ਕੇ ਉਹ ਨਾਰੀ (ਜਟ-ਇਸਤਰੀ) ਘਰ ਨੂੰ ਚਲੀ ਗਈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "सो लै नारि दरबु घर गई ॥९॥",
      "sourceLineId": "135607",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਆਧੋ ਧਨ ਤਿਹ ਭ੍ਰਾਤਨ ਦੀਨਾ ॥",
      "transliteration": "aadho dhan teh bhraatan dheenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਅੱਧਾ ਧਨ ਉਸ ਦੇ ਭਰਾਵਾ ਨੂੰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "आधो धन तिह भ्रातन दीना ॥",
      "sourceLineId": "135608",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਆਧੋ ਕਾਢਿ ਆਪਿ ਤ੍ਰਿਯ ਲੀਨਾ ॥",
      "transliteration": "aadho kaadd aap tiray leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੱਧਾ ਇਸਤਰੀ ਨੇ ਆਪ ਕਢ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "आधो काढि आपि तृय लीना ॥",
      "sourceLineId": "135609",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1300_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਮੂਰਖ ਚੇਰੀ ਭੇਦ ਨ ਪਾਵੈ ॥",
      "transliteration": "moorakh cheree bhedh na paavai ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਦਾਸੀ ਨੇ ਭੇਦ ਨਾ ਪਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1300,
      "hindi": "",
      "hindiTransliteration": "मूरख चेरी भेद न पावै ॥",
      "sourceLineId": "135610",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
