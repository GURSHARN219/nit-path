{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1301,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1301_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਤਨ ਮੂੰਡ ਮੁੰਡਾਵੈ ॥੧੦॥",
      "transliteration": "eeh charitr tan moo(n)dd mu(n)ddaavai ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਚਰਿਤ੍ਰ ਰਾਹੀਂ ਆਪਣੇ ਆਪ ਨੂੰ ਠਗਵਾਉਾਂਦੀ ਰਹੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र तन मूँड मुँडावै ॥१०॥",
      "sourceLineId": "135611",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸੰਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੭॥੬੪੪੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau sa(n)taalees charitr samaapatam sat subham sat ||347||6443||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੪੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੪੭॥੬੪੪੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ संतालीस चरित्र समापतम सतु सुभम सतु ॥३४७॥६४४३॥अफजूँ॥",
      "sourceLineId": "135612",
      "sourceShabadId": "12631",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135613",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੌਰਿਪਾਲ ਇਕ ਸੁਨਾ ਨਰੇਸਾ ॥",
      "transliteration": "gauaripaal ik sunaa naresaa ||",
      "translation": "",
      "punjabiViakhya": "ਗੌਰਿਪਾਲ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "गौरिपाल इक सुना नरेसा ॥",
      "sourceLineId": "135614",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਾਨਤ ਆਨਿ ਸਕਲ ਤਿਹ ਦੇਸਾ ॥",
      "transliteration": "maanat aan sakal teh dhesaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਸਾਰੇ ਦੇਸ ਈਨ ਮੰਨਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "मानत आनि सकल तिह देसा ॥",
      "sourceLineId": "135615",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੌਰਾ ਦੇਈ ਨਾਰਿ ਤਿਹ ਸੋਹੈ ॥",
      "transliteration": "gauaraa dheiee naar teh sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਗੌਰਾ ਦੇਈ ਨਾ ਦੀ ਇਸਤਰੀ ਸ਼ੋਭਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "गौरा देई नारि तिह सोहै ॥",
      "sourceLineId": "135616",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੌਰਾਵਤੀ ਨਗਰ ਤਿਹ ਕੋ ਹੈ ॥੧॥",
      "transliteration": "gauaraavatee nagar teh ko hai ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਗਰ ਗੌਰਾਵਤੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "गौरावती नगर तिह को है ॥१॥",
      "sourceLineId": "135617",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਾ ਕੀ ਤ੍ਰਿਯਾ ਨੀਚ ਸੇਤੀ ਰਤਿ ॥",
      "transliteration": "taa kee tirayaa neech setee rat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਇਸਤਰੀ ਇਕ ਨੀਚ ਨਾਲ ਫਸੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "ता की तृया नीच सेती रति ॥",
      "sourceLineId": "135618",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਲੀ ਬੁਰੀ ਜਾਨਤ ਨ ਮੂੜ ਮਤਿ ॥",
      "transliteration": "bhalee buree jaanat na mooR mat ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੂਰਖ ਚੰਗਾ ਮੰਦਾ ਨਹੀਂ ਜਾਣਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "भली बुरी जानत न मूड़ मति ॥",
      "sourceLineId": "135619",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਕ ਦਿਨ ਭੇਦ ਭੂਪ ਲਖਿ ਲਯੋ ॥",
      "transliteration": "eik dhin bhedh bhoop lakh layo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜੇ ਨੇ ਇਹ ਭੇਦ ਪਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "इक दिन भेद भूप लखि लयो ॥",
      "sourceLineId": "135620",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤ੍ਰਾਸਿਤ ਜਾਰੁ ਤੁਰਤੁ ਭਜਿ ਗਯੋ ॥੨॥",
      "transliteration": "traasit jaar turat bhaj gayo ||2||",
      "translation": "",
      "punjabiViakhya": "ਡਰ ਦਾ ਮਾਰਿਆ ਯਾਰ ਤੁਰਤ ਭਜ ਗਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "त्रासित जारु तुरतु भजि गयो ॥२॥",
      "sourceLineId": "135621",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੌਰਾ ਦੇ ਇਕ ਚਰਿਤ ਬਨਾਯੋ ॥",
      "transliteration": "gauaraa dhe ik charit banaayo ||",
      "translation": "",
      "punjabiViakhya": "ਗੌਰਾ ਦੇਈ ਨੇ ਇਕ ਚਰਿਤ੍ਰ ਖੇਡਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "गौरा दे इक चरित बनायो ॥",
      "sourceLineId": "135622",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲਿਖਾ ਏਕ ਲਿਖਿ ਤਹਾ ਪਠਾਯੋ ॥",
      "transliteration": "likhaa ek likh tahaa paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਪੱਤਰ ਲਿਖ ਕੇ ਉਸ ਨੂੰ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "लिखा एक लिखि तहा पठायो ॥",
      "sourceLineId": "135623",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਕ ਰਾਜਾ ਕੀ ਜਾਨ ਸੁਰੀਤਾ ॥",
      "transliteration": "eik raajaa kee jaan sureetaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਆਪਣੇ ਆਪ ਨੂੰ) ਇਕ ਰਾਜੇ ਦੀ ਦਾਸੀ ਦਸ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "इक राजा की जान सुरीता ॥",
      "sourceLineId": "135624",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੋ ਤਾ ਕੌ ਠਹਰਾਯੋ ਮੀਤਾ ॥੩॥",
      "transliteration": "so taa kau Thaharaayo meetaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮਿਤਰ ਠਹਿਰਾਇਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "सो ता कौ ठहरायो मीता ॥३॥",
      "sourceLineId": "135625",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਿਸੁ ਮੁਖ ਤੇ ਲਿਖਿ ਲਿਖਾ ਪਠਾਈ ॥",
      "transliteration": "tis mukh te likh likhaa paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦਾਸੀ ਵਲੋਂ (ਉਥੇ) ਲਿਖਵਾ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "तिसु मुख ते लिखि लिखा पठाई ॥",
      "sourceLineId": "135626",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਹਾ ਹੁਤੇ ਅਪਨੇ ਸੁਖਦਾਈ ॥",
      "transliteration": "jahaa hute apane sukhadhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਉਸ ਦਾ ਮਿਤਰ ਠਹਿਰਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "जहा हुते अपने सुखदाई ॥",
      "sourceLineId": "135627",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕੋ ਦਿਨ ਰਮਤ ਈਹਾ ਤੇ ਰਹਨਾ ॥",
      "transliteration": "ko dhin ramat ieehaa te rahanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਝ ਦਿਨ ਇਥੇ ਹੀ ਘੁੰਮਦਿਆਂ ਰਹਿਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "को दिन रमत ईहा ते रहना ॥",
      "sourceLineId": "135628",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੈ ਕਰਿ ਪਠਿਵਹੁ ਹਮਰਾ ਲਹਨਾ ॥੪॥",
      "transliteration": "dhai kar paThivahu hamaraa lahanaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਹੱਥ ਮੇਰਾ ਲਹਿਣਾ ਭੇਜ ਦੇਣਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "दै करि पठिवहु हमरा लहना ॥४॥",
      "sourceLineId": "135629",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋ ਪਤ੍ਰੀ ਨ੍ਰਿਪ ਕੇ ਕਰ ਆਈ ॥",
      "transliteration": "so patree nirap ke kar aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਚਿੱਠੀ ਰਾਜੇ ਦੇ ਹੱਥ ਆ ਗਈ। (ਉਸ ਨੇ) ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "सो पत्री नृप के कर आई ॥",
      "sourceLineId": "135630",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾਨੀ ਮੋਰਿ ਸੁਰੀਤਿ ਪਠਾਈ ॥",
      "transliteration": "jaanee mor sureet paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਹ ਮੇਰੀ ਦਾਸੀ ਨੇ ਭੇਜੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "जानी मोरि सुरीति पठाई ॥",
      "sourceLineId": "135631",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੜ ਨਿਜੁ ਤ੍ਰਿਯ ਕੋ ਭੇਦ ਨ ਪਾਯੋ ॥",
      "transliteration": "jaR nij tiray ko bhedh na paayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੇ ਇਸਤਰੀ ਦਾ ਭੇਦ ਨਾ ਪਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "जड़ निजु तृय को भेद न पायो ॥",
      "sourceLineId": "135632",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨੇਹ ਤ੍ਯਾਗ ਤਿਹ ਸਾਥ ਗਵਾਯੋ ॥੫॥",
      "transliteration": "neh tayaag teh saath gavaayo ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ (ਦਾਸੀ ਨਾਲੋਂ) ਆਪਣਾ ਸਨੇਹ ਖ਼ਤਮ ਕਰ ਲਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "नेह त्याग तिह साथ गवायो ॥५॥",
      "sourceLineId": "135633",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁਘਰ ਹੁਤੌ ਤੌ ਭੇਵ ਪਛਾਨਤ ॥",
      "transliteration": "sughar hutau tau bhev pachhaanat ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਸਿਆਣਾ ਹੁੰਦਾ ਤਾ ਭੇਦ ਨੂੰ ਪਛਾਣਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "सुघर हुतौ तौ भेव पछानत ॥",
      "sourceLineId": "135634",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤ੍ਰਿਯ ਕੀ ਘਾਤ ਸਤਿ ਕਰਿ ਜਾਨਤ ॥",
      "transliteration": "tiray kee ghaat sat kar jaanat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਸਤਰੀ ਦੀ ਘਾਤ ਨੂੰ ਸਚ ਕਰ ਕੇ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "तृय की घात सति करि जानत ॥",
      "sourceLineId": "135635",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੂੜ ਰਾਵ ਕਛੁ ਕ੍ਰਿਯਾ ਨ ਜਾਨੀ ॥",
      "transliteration": "mooR raav kachh kirayaa na jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਰਾਜੇ ਨੇ ਕੁਝ ਕ੍ਰਿਆ ਨਾ ਸਮਝੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "मूड़ राव कछु कृया न जानी ॥",
      "sourceLineId": "135636",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਮੂੰਡ ਮੂੰਡਿ ਗੀ ਰਾਨੀ ॥੬॥",
      "transliteration": "eeh bidh moo(n)dd moo(n)dd gee raanee ||6||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਨੂੰ ਰਾਣੀ ਛਲ ਗਈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "इह बिधि मूँड मूँडि गी रानी ॥६॥",
      "sourceLineId": "135637",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਤਾਲੀਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੮॥੬੪੪੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau aThataalees charitr samaapatam sat subham sat ||348||6449||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੪੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੪੮॥੬੪੪੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ अठतालीस चरित्र समापतम सतु सुभम सतु ॥३४८॥६४४९॥अफजूँ॥",
      "sourceLineId": "135638",
      "sourceShabadId": "12632",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135639",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਕਥਾ ਪ੍ਰਕਾਸੌ ॥",
      "transliteration": "sun raajaa ik kathaa prakaasau ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਸੁਣੋ, ਮੈਂ ਇਕ ਕਥਾ ਦਸਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा इक कथा प्रकासौ ॥",
      "sourceLineId": "135640",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤੁਮਰੇ ਜਿਯ ਕਾ ਭਰਮ ਬਿਨਾਸੌ ॥",
      "transliteration": "tumare jiy kaa bharam binaasau ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਹਾਡੇ ਮਨ ਦਾ ਭਰਮ ਦੂਰ ਕਰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "तुमरे जिय का भरम बिनासौ ॥",
      "sourceLineId": "135641",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਉਗ੍ਰਦਤ ਇਕ ਸੁਨਿਯਤ ਰਾਜਾ ॥",
      "transliteration": "augradhat ik suniyat raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਗ੍ਰਦੱਤ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "उग्रदत इक सुनियत राजा ॥",
      "sourceLineId": "135642",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਉਗ੍ਰਾਵਤੀ ਨਗਰ ਜਿਹ ਛਾਜਾ ॥੧॥",
      "transliteration": "augraavatee nagar jeh chhaajaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਉਗ੍ਰਾਵਤੀ ਨਗਰ ਵਿਚ ਸੁਸ਼ੋਭਿਤ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "उग्रावती नगर जिह छाजा ॥१॥",
      "sourceLineId": "135643",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਉਗ੍ਰ ਦੇਇ ਤਿਹ ਧਾਮ ਦੁਲਾਰੀ ॥",
      "transliteration": "augr dhei teh dhaam dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਉਗ੍ਰ ਦੇਈ ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "उग्र देइ तिह धाम दुलारी ॥",
      "sourceLineId": "135644",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਬਿਸਨ ਸਿਵ ਤਿਹੂੰ ਸਵਾਰੀ ॥",
      "transliteration": "brahamaa bisan siv tihoo(n) savaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ (ਮਾਨੋ) ਬ੍ਰਹਮਾ, ਵਿਸ਼ਣੂ ਅਤੇ ਸ਼ਿਵ ਤਿੰਨਾ ਨੂੰ (ਆਪ) ਸੰਵਾਰਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "ब्रहमा बिसन सिव तिहूँ सवारी ॥",
      "sourceLineId": "135645",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਵਰਿ ਨ ਅਸਿ ਕੋਈ ਨਾਰਿ ਬਨਾਈ ॥",
      "transliteration": "avar na as koiee naar banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਕੋਈ ਹੋਰ ਇਸਤਰੀ ਨਹੀਂ ਬਣਾਈ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "अवरि न असि कोई नारि बनाई ॥",
      "sourceLineId": "135646",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੈਸੀ ਯਹ ਰਾਜਾ ਕੀ ਜਾਈ ॥੨॥",
      "transliteration": "jaisee yeh raajaa kee jaiee ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਦੀ ਇਹ ਰਾਜ ਕੁਮਾਰੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "जैसी यह राजा की जाई ॥२॥",
      "sourceLineId": "135647",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਜਬ ਰਾਇ ਇਕ ਤਹ ਖਤਿਰੇਟਾ ॥",
      "transliteration": "ajab rai ik teh khatireTaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਅਜਬ ਰਾਇ ਨਾ ਦਾ ਛਤ੍ਰੀ (ਰਹਿੰਦਾ) ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "अजब राइ इक तह खतिरेटा ॥",
      "sourceLineId": "135648",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਸਕ ਮੁਸਕ ਕੇ ਸਾਥ ਲਪੇਟਾ ॥",
      "transliteration": "eisak musak ke saath lapeTaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਸ਼ਕ ਮੁਸ਼ਕ ਦੇ ਰੰਗ ਵਿਚ (ਪੂਰੀ ਤਰ੍ਰਹਾ) ਰੰਗਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "इसक मुसक के साथ लपेटा ॥",
      "sourceLineId": "135649",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਜਬ ਤਿਹ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "raaj sutaa jab teh lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਜਦ ਉਸ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "राज सुता जब तिह लखि पायो ॥",
      "sourceLineId": "135650",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਪਕਰਿ ਮੰਗਾਯੋ ॥੩॥",
      "transliteration": "paThai sahacharee pakar ma(n)gaayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਖੀ ਭੇਜ ਕੇ ਪਕੜ ਕੇ ਮੰਗਵਾ ਲਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी पकरि मंगायो ॥३॥",
      "sourceLineId": "135651",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਮਾਨਾ ਤਿਹ ਸੰਗਾ ॥",
      "transliteration": "kaam bhog maanaa teh sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਸ਼ਰੀਰ ਹੇਠਾ ਲਿਪਟ ਲਿਪਟ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "काम भोग माना तिह संगा ॥",
      "sourceLineId": "135652",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਲਪਟਿ ਲਪਟਿ ਤਾ ਕੇ ਤਰ ਅੰਗਾ ॥",
      "transliteration": "lapaT lapaT taa ke tar a(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਕਾਮ ਭੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "लपटि लपटि ता के तर अंगा ॥",
      "sourceLineId": "135653",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਕ ਛਿਨ ਛੈਲ ਨ ਛੋਰਾ ਭਾਵੈ ॥",
      "transliteration": "eik chhin chhail na chhoraa bhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਛਿਣ ਲਈ ਵੀ ਉਹ ਉਸ ਜਵਾਨ ਨੂੰ ਛਡਣਾ ਨਹੀਂ ਸੀ ਚਾਹੁੰਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "इक छिन छैल न छोरा भावै ॥",
      "sourceLineId": "135654",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਤੇ ਅਧਿਕ ਡਰਾਵੈ ॥੪॥",
      "transliteration": "maat pitaa te adhik ddaraavai ||4||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮਾਤਾ ਪਿਤਾ ਤੋਂ ਬਹੁਤ ਡਰਦੀ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "मात पिता ते अधिक डरावै ॥४॥",
      "sourceLineId": "135655",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਇਕ ਦਿਨ ਕਰੀ ਸਭਨ ਮਿਜਮਾਨੀ ॥",
      "transliteration": "eik dhin karee sabhan mijamaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਦਿਨ ਸਭ ਦਾ ਪ੍ਰੀਤੀ ਭੋਜਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "इक दिन करी सभन मिजमानी ॥",
      "sourceLineId": "135656",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੰਬਲ ਖਾਰ ਡਾਰਿ ਕਰਿ ਸ੍ਯਾਨੀ ॥",
      "transliteration": "sa(n)bal khaar ddaar kar sayaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਚਤੁਰ ਨੇ (ਖਾਣੇ ਵਿਚ) ਜ਼ਹਿਰ ('ਸੰਬਲ ਖਾਰ') ਪਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "संबल खार डारि करि स्यानी ॥",
      "sourceLineId": "135657",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1301_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਜਾ ਰਾਨੀ ਸਹਿਤ ਬੁਲਾਏ ॥",
      "transliteration": "raajaa raanee sahit bulaae ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਰਾਣੀ ਸਹਿਤ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1301,
      "hindi": "",
      "hindiTransliteration": "राजा रानी सहित बुलाए ॥",
