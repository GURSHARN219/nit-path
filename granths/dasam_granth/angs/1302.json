{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1302,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1302_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੇ ਦੋਊ ਬਿਖਿ ਸ੍ਵਰਗ ਪਠਾਏ ॥੫॥",
      "transliteration": "dhe dhouoo bikh savairag paThaae ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਨੂੰ ਜ਼ਹਿਰ (ਮਿਲਿਆ ਭੋਜਨ ਖਵਾ ਕੇ) ਸਵਰਗ ਨੂੰ ਭੇਜ ਦਿੱਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "दे दोऊ बिखि स्वरग पठाए ॥५॥",
      "sourceLineId": "135659",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਪੁ ਸਭਨ ਪ੍ਰਤਿ ਐਸ ਉਚਾਰਾ ॥",
      "transliteration": "aap sabhan prat aais uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਆਪ ਸਾਰਿਆਂ ਪ੍ਰਤਿ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "आपु सभन प्रति ऐस उचारा ॥",
      "sourceLineId": "135660",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਰ ਦੀਨਾ ਮੁਹਿ ਕਹ ਤ੍ਰਿਪੁਰਾਰਾ ॥",
      "transliteration": "bar dheenaa muh keh tirapuraaraa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਸ਼ਿਵ ਨੇ ਵਰ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "बर दीना मुहि कह तृपुरारा ॥",
      "sourceLineId": "135661",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਾਨੀ ਸਹਿਤ ਨਰਾਧਿਪ ਘਾਏ ॥",
      "transliteration": "raanee sahit naraadhip ghaae ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਾਣੀ ਸਮੇਤ ਰਾਜੇ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "रानी सहित नराधिप घाए ॥",
      "sourceLineId": "135662",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮੁਰ ਨਰ ਕੇ ਸਭ ਅੰਗ ਬਨਾਏ ॥੬॥",
      "transliteration": "mur nar ke sabh a(n)g banaae ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਸਾਰੇ ਅੰਗ ਪੁਰਸ਼ ਵਾਲੇ ਬਣਾ ਦਿੱਤੇ ਹਨ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "मुर नर के सभ अंग बनाए ॥६॥",
      "sourceLineId": "135663",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਧਿਕ ਮਯਾ ਮੋ ਪਰ ਸਿਵ ਕੀਨੀ ॥",
      "transliteration": "adhik mayaa mo par siv keenee ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਨੇ ਮੇਰੇ ਉਤੇ ਬਹੁਤ ਕ੍ਰਿਪਾ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "अधिक मया मो पर सिव कीनी ॥",
      "sourceLineId": "135664",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਾਜ ਸਮਗ੍ਰੀ ਸਭ ਮੁਹਿ ਦੀਨੀ ॥",
      "transliteration": "raaj samagree sabh muh dheenee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਸਾਰੀ ਰਾਜ ਸਾਮਗ੍ਰੀ ਦੇ ਦਿੱਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "राज समग्री सभ मुहि दीनी ॥",
      "sourceLineId": "135665",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਾਹੂ ਪਾਯੋ ॥",
      "transliteration": "bhedh abhedh na kaahoo paayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ (ਇਸ ਗੱਲ ਦਾ) ਭੇਦ ਅਭੇਦ ਨਾ ਪਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न काहू पायो ॥",
      "sourceLineId": "135666",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੀਸ ਸੁਤਾ ਕੇ ਛਤ੍ਰ ਫਿਰਾਯੋ ॥੭॥",
      "transliteration": "sees sutaa ke chhatr firaayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਕੁਮਾਰੀ ਦੇ ਸਿਰ ਉਤੇ ਛਤ੍ਰ ਝੁਲਾ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "सीस सुता के छत्र फिरायो ॥७॥",
      "sourceLineId": "135667",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿਤਕ ਦਿਵਸ ਇਹ ਭਾਤਿ ਬਿਤਾਈ ॥",
      "transliteration": "kitak dhivas ieh bhaat bitaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਝ ਸਮਾ ਇਸ ਤਰ੍ਰਹਾ ਗੁਜ਼ਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "कितक दिवस इह भाति बिताई ॥",
      "sourceLineId": "135668",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰੋਮ ਮਿਤ੍ਰ ਕੇ ਦੂਰ ਕਰਾਈ ॥",
      "transliteration": "rom mitr ke dhoor karaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਮਿਤਰ ਦੇ ਵਾਲ ਸਾਫ਼ ਕਰਵਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "रोम मित्र के दूर कराई ॥",
      "sourceLineId": "135669",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤ੍ਰਿਯ ਕੇ ਬਸਤ੍ਰ ਸਗਲ ਦੈ ਵਾ ਕੌ ॥",
      "transliteration": "tiray ke basatr sagal dhai vaa kau ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਾਰੇ ਇਸਤਰੀ ਦੇ ਕਪੜੇ ਪਵਾ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "तृय के बसत्र सगल दै वा कौ ॥",
      "sourceLineId": "135670",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਰ ਆਨ੍ਰਯੋ ਇਸਤ੍ਰੀ ਕਰਿ ਤਾ ਕੌ ॥੮॥",
      "transliteration": "bar aanrayo isatree kar taa kau ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਇਸਤਰੀ ਵਜੋਂ ਵਿਆਹ ਕੇ ਲੈ ਆਈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "बर आन्रयो इसत्री करि ता कौ ॥८॥",
      "sourceLineId": "135671",
      "sourceShabadId": "12633",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "135672",
      "sourceShabadId": "12634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਹਨਿ ਪੁਰਖ ਬਨ ਬਰਿਯੋ ਮਿਤ੍ਰ ਤ੍ਰਿਯ ਸੋਇ ॥",
      "transliteration": "maat pitaa han purakh ban bariyo mitr tiray soi ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਤਾ ਪਿਤਾ ਨੂੰ ਮਾਰ ਕੇ, (ਆਪ) ਪੁਰਸ਼ ਬਣ ਕੇ ਉਸ ਇਸਤਰੀ ਨੇ ਮਿਤਰ ਨਾਲ ਵਿਆਹ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "मात पिता हनि पुरख बन बरियो मित्र तृय सोइ ॥",
      "sourceLineId": "135673",
      "sourceShabadId": "12634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਾਜ ਕਰਾ ਇਹ ਛਲ ਭਏ ਭੇਦ ਨ ਪਾਵਤ ਕੋਇ ॥੯॥",
      "transliteration": "raaj karaa ieh chhal bhe bhedh na paavat koi ||9||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਰਾਜ ਕੀਤਾ, ਪਰ ਕੋਈ ਵੀ ਭੇਦ ਪ੍ਰਾਪਤ ਨਾ ਕਰ ਸਕਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "राज करा इह छल भए भेद न पावत कोइ ॥९॥",
      "sourceLineId": "135674",
      "sourceShabadId": "12634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਉਨਚਾਸ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੪੯॥੬੪੫੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau unachaas charitr samaapatam sat subham sat ||349||6458||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੪੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੪੯॥੬੪੫੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ उनचास चरित्र समापतम सतु सुभम सतु ॥३४९॥६४५८॥अफजूँ॥",
      "sourceLineId": "135675",
      "sourceShabadId": "12634",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135676",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੁਜਨਾਵਤੀ ਨਗਰ ਇਕ ਪੂਰਬ ॥",
      "transliteration": "sujanaavatee nagar ik poorab ||",
      "translation": "",
      "punjabiViakhya": "ਪੂਰਬ ਵਲ ਸੁਜਾਨਵਤੀ ਨਾ ਦਾ ਇਕ ਨਗਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "सुजनावती नगर इक पूरब ॥",
      "sourceLineId": "135677",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਭ ਸਹਿਰਨ ਤੇ ਹੁਤੋ ਅਪੂਰਬ ॥",
      "transliteration": "sabh sahiran te huto apoorab ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਾਰਿਆਂ ਸ਼ਹਿਰਾ ਨਾਲੋਂ ਅਦੁੱਤੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "सभ सहिरन ते हुतो अपूरब ॥",
      "sourceLineId": "135678",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਿੰਘ ਸੁਜਾਨ ਤਹਾ ਕੋ ਰਾਜਾ ॥",
      "transliteration": "si(n)gh sujaan tahaa ko raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਜਾਨ ਸਿੰਘ ਉਥੋਂ ਦਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "सिंघ सुजान तहा को राजा ॥",
      "sourceLineId": "135679",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਹ ਸਮ ਬਿਧ ਨੈ ਔਰ ਨ ਸਾਜਾ ॥੧॥",
      "transliteration": "jeh sam bidh nai aauar na saajaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਵਿਧਾਤਾ ਨੇ ਹੋਰ ਕੋਈ ਨਹੀਂ ਬਣਾਇਆ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "जिह सम बिध नै और न साजा ॥१॥",
      "sourceLineId": "135680",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸ੍ਰੀ ਨਵਜੋਬਨ ਦੇ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "sree navajoban dhe teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਨਵਜੋਬਨ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "स्री नवजोबन दे तिह नारी ॥",
      "sourceLineId": "135681",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਘੜੀ ਨ ਜਿਹ ਸੀ ਬ੍ਰਹਮ ਕੁਮਾਰੀ ॥",
      "transliteration": "ghaRee na jeh see braham kumaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਬ੍ਰਹਮਾ ਨੇ (ਕੋਈ ਹੋਰ) ਕੁਮਾਰੀ ਨਹੀਂ ਬਣਾਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "घड़ी न जिह सी ब्रहम कुमारी ॥",
      "sourceLineId": "135682",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੋ ਅਬਲਾ ਤਿਹ ਰੂਪ ਨਿਹਾਰੈ ॥",
      "transliteration": "jo abalaa teh roop nihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਉਸ ਅਬਲਾ ਦਾ ਰੂਪ ਵੇਖਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "जो अबला तिह रूप निहारै ॥",
      "sourceLineId": "135683",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨ ਕ੍ਰਮ ਬਚ ਇਹ ਭਾਤਿ ਉਚਾਰੈ ॥੨॥",
      "transliteration": "man kram bach ieh bhaat uchaarai ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਨ, ਬਚ, ਕਰਮ ਕਰ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿੰਦਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "मन क्रम बच इह भाति उचारै ॥२॥",
      "sourceLineId": "135684",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇੰਦ੍ਰ ਧਾਮ ਹੈ ਐਸ ਨ ਨਾਰੀ ॥",
      "transliteration": "ei(n)dhr dhaam hai aais na naaree ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦਰ ਦੇ ਘਰ ਵੀ ਇਸ ਤਰ੍ਰਹਾ ਦੀ ਨਾਰੀ ਨਹੀਂ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "इंद्र धाम है ऐस न नारी ॥",
      "sourceLineId": "135685",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੈਸੀ ਨ੍ਰਿਪ ਕੀ ਨਾਰਿ ਨਿਹਾਰੀ ॥",
      "transliteration": "jaisee nirap kee naar nihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੋ ਜਿਹੀ ਅਸੀਂ ਰਾਜੇ ਦੀ ਇਸਤਰੀ ਵੇਖੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "जैसी नृप की नारि निहारी ॥",
      "sourceLineId": "135686",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਸ ਸੁੰਦਰ ਇਕ ਸਾਹ ਸਪੂਤਾ ॥",
      "transliteration": "as su(n)dhar ik saeh sapootaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਇਕ ਸ਼ਾਹ ਦਾ ਇਹੋ ਜਿਹਾ ਸੁੰਦਰ ਪੁੱਤਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "अस सुँदर इक साह सपूता ॥",
      "sourceLineId": "135687",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਹ ਲਖਿ ਪ੍ਰਭਾ ਲਜਤ ਪੁਰਹੂਤਾ ॥੩॥",
      "transliteration": "jeh lakh prabhaa lajat purahootaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ ਇੰਦਰ ਵੀ ਸ਼ਰਮਾਉਾਂਦਾ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "जिह लखि प्रभा लजत पुरहूता ॥३॥",
      "sourceLineId": "135688",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਯਹ ਧੁਨਿ ਪਰੀ ਤਰੁਨਿ ਕੇ ਕਾਨਨ ॥",
      "transliteration": "yeh dhun paree tarun ke kaanan ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਹ ਭਿਣਕ ਰਾਣੀ ਦੇ ਕੰਨਾ ਵਿਚ ਪਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "यह धुनि परी तरुनि के कानन ॥",
      "sourceLineId": "135689",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਬ ਤੇ ਲਗੀ ਚਟਪਟੀ ਭਾਮਨਿ ॥",
      "transliteration": "tab te lagee chaTapaTee bhaaman ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੋਂ ਉਹ ਇਸਤਰੀ ਛਟਪਟਾਉਣ ਲਗ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "तब ते लगी चटपटी भामनि ॥",
      "sourceLineId": "135690",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਤਨ ਕਵਨ ਮੈ ਆਜੁ ਸੁ ਧਾਰੂੰ ॥",
      "transliteration": "jatan kavan mai aaju su dhaaroo(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚਣ ਲਗੀ ਕਿ) ਅਜ ਮੈਂ ਕਿਹੜਾ ਯਤਨ ਕਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "जतन कवन मै आजु सु धारूँ ॥",
      "sourceLineId": "135691",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਉਹਿ ਸੁੰਦਰ ਕਹ ਨੈਨ ਨਿਹਾਰੂੰ ॥੪॥",
      "transliteration": "auh su(n)dhar keh nain nihaaroo(n) ||4||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਉਸ ਸੁੰਦਰ ਨੂੰ ਆਪਣੇ ਨੈਣਾ ਨਾਲ ਵੇਖਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "उहि सुँदर कह नैन निहारूँ ॥४॥",
      "sourceLineId": "135692",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਗਰ ਢੰਢੋਰਾ ਨਾਰਿ ਫਿਰਾਯੋ ॥",
      "transliteration": "nagar dda(n)ddoraa naar firaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਨੇ ਨਗਰ ਵਿਚ ਢੰਡੋਰਾ ਪਿਟਵਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "नगर ढंढोरा नारि फिरायो ॥",
      "sourceLineId": "135693",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਭਹਿਨ ਕਹ ਇਹ ਭਾਤਿ ਸੁਨਾਯੋ ॥",
      "transliteration": "sabhahin keh ieh bhaat sunaayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "सभहिन कह इह भाति सुनायो ॥",
      "sourceLineId": "135694",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਊਚ ਨੀਚ ਕੋਈ ਰਹੈ ਨ ਪਾਵੈ ॥",
      "transliteration": "uooch neech koiee rahai na paavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਕੋਈ ਉੱਚਾ ਨੀਵਾ (ਅਮੀਰ ਗ਼ਰੀਬ) ਨਾ ਰਹੇ",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच कोई रहै न पावै ॥",
      "sourceLineId": "135695",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਾਤਕਾਲ ਭੋਜਨ ਸਭ ਖਾਵੈ ॥੫॥",
      "transliteration": "praatakaal bhojan sabh khaavai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਭ (ਆ ਕੇ ਮੇਰੇ ਘਰ) ਕਲ ਸਵੇਰੇ ਪ੍ਰੀਤੀ ਭੋਜਨ ਕਰਨ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "प्रातकाल भोजन सभ खावै ॥५॥",
      "sourceLineId": "135696",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਜਹਿ ਬਾਤ ਕਛੂ ਨਹਿ ਜਾਨੀ ॥",
      "transliteration": "raajeh baat kachhoo neh jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਇਸ ਗੱਲ ਦਾ ਭੇਦ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "राजहि बात कछू नहि जानी ॥",
      "sourceLineId": "135697",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਿਵਤਾ ਦਿਯੋ ਲਖਿਯੋ ਤ੍ਰਿਯ ਮਾਨੀ ॥",
      "transliteration": "nivataa dhiyo lakhiyo tiray maanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਤਾ ਇਹੀ ਸੋਚਿਆ ਕਿ) ਰਾਣੀ ਨੇ (ਆਮ ਜਿਹਾ) ਨਿਉਤਾ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "निवता दियो लखियो तृय मानी ॥",
      "sourceLineId": "135698",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਪਕਵਾਨ ਪਕਾਏ ॥",
      "transliteration": "bhaat bhaat pakavaan pakaae ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਪਕਵਾਨ ਪਕਵਾਏ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "भाति भाति पकवान पकाए ॥",
      "sourceLineId": "135699",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਊਚ ਨੀਚ ਸਭ ਨਿਵਤਿ ਬੁਲਾਏ ॥੬॥",
      "transliteration": "uooch neech sabh nivat bulaae ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਮੀਰ ਗ਼ਰੀਬ ਸਭ ਨੂੰ ਸਦ ਬੁਲਾਇਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच सभ निवति बुलाए ॥६॥",
      "sourceLineId": "135700",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੋਜਨ ਖਾਨ ਜਨਾਵਹਿ ਬਿਗਸਹਿ ॥",
      "transliteration": "bhojan khaan janaaveh bigaseh ||",
      "translation": "",
      "punjabiViakhya": "ਭੋਜਨ ਖਾਣ ਲਈ ਲੋਕੀਂ ਖ਼ੁਸ਼ੀ ਖ਼ੁਸ਼ੀ ਆ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "भोजन खान जनावहि बिगसहि ॥",
      "sourceLineId": "135701",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤ੍ਰਿਯ ਕੀ ਦ੍ਰਿਸਟਿ ਤਰੇ ਹ੍ਵੈ ਨਿਕਸਹਿ ॥",
      "transliteration": "tiray kee dhirasaT tare havai nikaseh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਝਰੋਖੇ ਵਿਚ ਬੈਠੀ) ਇਸਤਰੀ ਦੀ ਨਜ਼ਰ ਹੇਠੋਂ ਲੰਘਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "तृय की दृसटि तरे ह्वै निकसहि ॥",
      "sourceLineId": "135702",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਐਂਠੀ ਰਾਇ ਜਬਾਯੋ ਤਹਾ ॥",
      "transliteration": "aai(n)Thee rai jabaayo tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਐਠੀ ਰਾਇ ਉਥੇ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "ऐंठी राइ जबायो तहा ॥",
      "sourceLineId": "135703",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬੈਠਿ ਝਰੋਖੇ ਰਾਨੀ ਜਹਾ ॥੭॥",
      "transliteration": "baiTh jharokhe raanee jahaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਣੀ ਝਰੋਖੇ ਵਿਚ ਬੈਠੀ ਸੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "बैठि झरोखे रानी जहा ॥७॥",
      "sourceLineId": "135704",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਾਨੀ ਨਿਰਖਿ ਚੀਨ ਤਿਹ ਗਈ ॥",
      "transliteration": "raanee nirakh cheen teh giee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਪਛਾਣ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "रानी निरखि चीन तिह गई ॥",
      "sourceLineId": "135705",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1302_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਤਾਹਿ ਸਰਾਹਤ ਭਈ ॥",
      "transliteration": "bahu bidh taeh saraahat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਸ਼ਲਾਘਾ ਕਰਨ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1302,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि ताहि सराहत भई ॥",
      "sourceLineId": "135706",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
