{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1303,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1303_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਧੰਨਿ ਧੰਨਿ ਮੁਖ ਤੇ ਬਹੁਰਿ ਉਚਾਰਾ ॥",
      "transliteration": "dha(n)n dha(n)n mukh te bahur uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਫਿਰ ਮੂੰਹ ਤੋਂ 'ਧੰਨ ਧੰਨ' ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "धंनि धंनि मुख ते बहुरि उचारा ॥",
      "sourceLineId": "135707",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਨ ਕਰਤੈ ਇਹ ਕੁਅਰ ਸਵਾਰਾ ॥੮॥",
      "transliteration": "jin karatai ieh kuar savaaraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰਤਾ ਨੇ ਇਹ ਰਾਜ ਕੁਮਾਰ ਬਣਾਇਆ ਸੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "जिन करतै इह कुअर सवारा ॥८॥",
      "sourceLineId": "135708",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਲੀਨਾ ਸਖੀ ਪਠਾਇ ਤਿਸੈ ਘਰਿ ॥",
      "transliteration": "leenaa sakhee paThai tisai ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸਖੀ ਭੇਜ ਕੇ ਘਰ ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "लीना सखी पठाइ तिसै घरि ॥",
      "sourceLineId": "135709",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਕਿਯ ਲਪਟਿ ਲਪਟਿ ਕਰਿ ॥",
      "transliteration": "kaam bhog kiy lapaT lapaT kar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਲਿਪਟ ਲਿਪਟ ਕੇ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "काम भोग किय लपटि लपटि करि ॥",
      "sourceLineId": "135710",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਏਕ ਤਰੁਨ ਅਰੁ ਭਾਗ ਚੜਾਈ ॥",
      "transliteration": "ek tarun ar bhaag chaRaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਜਵਾਨ ਅਤੇ ਦੂਜੇ ਭੰਗ ਪੀਤੀ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "एक तरुन अरु भाग चड़ाई ॥",
      "sourceLineId": "135711",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਾਰ ਪਹਰਿ ਨਿਸਿ ਨਾਰਿ ਬਜਾਈ ॥੯॥",
      "transliteration": "chaar pahar nis naar bajaiee ||9||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਚਾਰ ਪਹਿਰ ਰਾਤ ਇਸਤਰੀ ਨਾਲ ਸੰਯੋਗ ਕੀਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "चार पहरि निसि नारि बजाई ॥९॥",
      "sourceLineId": "135712",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਐਂਠੀ ਸੌ ਬਧਿ ਗਯੋ ਸਨੇਹਾ ॥",
      "transliteration": "aai(n)Thee sau badh gayo sanehaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਐਠੀ ਰਾਇ ਨਾਲ ਪ੍ਰੇਮ ਵੱਧ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "ऐंठी सौ बधि गयो सनेहा ॥",
      "sourceLineId": "135713",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੋ ਮੁਹਿ ਕਹੇ ਨ ਆਵਤ ਨੇਹਾ ॥",
      "transliteration": "jo muh kahe na aavat nehaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਪ੍ਰੇਮ ਦਾ ਮੇਰੇ ਕੋਲੋਂ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "जो मुहि कहे न आवत नेहा ॥",
      "sourceLineId": "135714",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭੇਦ ਸਿਖੈ ਤਿਹ ਧਾਮ ਪਠਾਯੋ ॥",
      "transliteration": "bhedh sikhai teh dhaam paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਭੇਦ ਦੀ ਗੱਲ ਸਮਝਾ ਕੇ ਘਰ ਭੇਜ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "भेद सिखै तिह धाम पठायो ॥",
      "sourceLineId": "135715",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਧੀ ਰੈਨਿ ਨਰੇਸਹਿ ਘਾਯੋ ॥੧੦॥",
      "transliteration": "aadhee rain nareseh ghaayo ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੱਧੀ ਰਾਤ ਨੂੰ ਰਾਜੇ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "आधी रैनि नरेसहि घायो ॥१०॥",
      "sourceLineId": "135716",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪ੍ਰਾਤਿ ਚਲੀ ਜਰਬੇ ਕੇ ਕਾਜਾ ॥",
      "transliteration": "praat chalee jarabe ke kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਨਿਰਲਜ ਇਸਤਰੀ ਸਵੇਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "प्राति चली जरबे के काजा ॥",
      "sourceLineId": "135717",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦਰਬੁ ਲੁਟਾਵਤ ਨਾਰਿ ਨ੍ਰਿਲਾਜਾ ॥",
      "transliteration": "dharab luTaavat naar niralaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਾ ਧਨ ਲੁਟਾ ਕੇ ਸਤੀ ਹੋਣ ਲਈ ਚਲ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "दरबु लुटावत नारि नृलाजा ॥",
      "sourceLineId": "135718",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦ੍ਰਿਸਟ ਬੰਧੁ ਸਭ ਕੀ ਅਸਿ ਕਰੀ ॥",
      "transliteration": "dhirasaT ba(n)dh sabh kee as karee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਾਰਿਆਂ ਦੀ ਨਜ਼ਰ ਇਸ ਤਰ੍ਰਹਾ ਬੰਦ ਕਰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "दृसट बंधु सभ की असि करी ॥",
      "sourceLineId": "135719",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਭਹੂੰ ਲਖਾ ਅਬਲਾ ਜਰਿ ਮਰੀ ॥੧੧॥",
      "transliteration": "sabhahoo(n) lakhaa abalaa jar maree ||11||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਸਭ ਨੇ ਸਮਝਿਆ ਕਿ ਇਸਤਰੀ ਸੜ ਮੋਈ ਹੈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "सभहूँ लखा अबला जरि मरी ॥११॥",
      "sourceLineId": "135720",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਿਕਸਿ ਜਾਰਿ ਸੰਗ ਆਪੁ ਸਿਧਾਰੀ ॥",
      "transliteration": "nikas jaar sa(n)g aap sidhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਆਪ ਯਾਰ ਨਾਲ ਨਿਕਲ ਕੇ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "निकसि जारि संग आपु सिधारी ॥",
      "sourceLineId": "135721",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭੇਦ ਨ ਲਖੈ ਪੁਰਖ ਅਰੁ ਨਾਰੀ ॥",
      "transliteration": "bhedh na lakhai purakh ar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਪੁਰਸ਼ ਅਤੇ ਨਾਰੀ ਇਸ ਭੇਦ ਨੂੰ ਨਾ ਸਮਝ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "भेद न लखै पुरख अरु नारी ॥",
      "sourceLineId": "135722",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦ੍ਰਿਸਟਿ ਬੰਦ ਕਰਤ ਅਸ ਭਈ ॥",
      "transliteration": "dhirasaT ba(n)dh karat as bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਨੇ ਦ੍ਰਿਸ਼ਟੀ ਬੰਦ ਕਰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "दृसटि बंद करत अस भई ॥",
      "sourceLineId": "135723",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮੂੰਡਿ ਮੂੰਡਿ ਸਭਹਿਨ ਕੋ ਗਈ ॥੧੨॥",
      "transliteration": "moo(n)dd moo(n)dd sabhahin ko giee ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਨੂੰ ਛਲ ਕੇ ਚਲੀ ਗਈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "मूँडि मूँडि सभहिन को गई ॥१२॥",
      "sourceLineId": "135724",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪਚਾਸਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੦॥੬੪੭੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau pachaasavo charitr samaapatam sat subham sat ||350||6470||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੫੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੫੦॥੬੪੭੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ पचासवो चरित्र समापतम सतु सुभम सतु ॥३५०॥६४७०॥अफजूँ॥",
      "sourceLineId": "135725",
      "sourceShabadId": "12635",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135726",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੁਨੋ ਭੂਪ ਇਕ ਕਹੌ ਕਹਾਨੀ ॥",
      "transliteration": "suno bhoop ik kahau kahaanee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਸੁਣੋ, ਮੈਂ ਇਕ ਕਹਾਣੀ ਕਹਿੰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "सुनो भूप इक कहौ कहानी ॥",
      "sourceLineId": "135727",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਿਨਹੂੰ ਸੁਨੀ ਨ ਆਗੇ ਜਾਨੀ ॥",
      "transliteration": "kinahoo(n) sunee na aage jaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਪ੍ਰਕਾਰ ਦੀ ਕਹਾਣੀ) ਨਾ ਕਿਸੇ ਨੇ ਪਹਿਲਾ ਸੁਣੀ ਹੈ, ਨਾ ਹੀ ਜਾਣੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "किनहूँ सुनी न आगे जानी ॥",
      "sourceLineId": "135728",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭੂਪ ਸੁ ਬਸਤ੍ਰ ਸੈਨ ਇਕ ਸੋਹੈ ॥",
      "transliteration": "bhoop su basatr sain ik sohai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਬਸਤ੍ਰ ਸੈਨ ਨਾ ਦਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "भूप सु बसत्र सैन इक सोहै ॥",
      "sourceLineId": "135729",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਾ ਕੇ ਸਮ ਨ ਨਰਾਧਿਪ ਕੋ ਹੈ ॥੧॥",
      "transliteration": "taa ke sam na naraadhip ko hai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਕੋਈ ਰਾਜਾ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "ता के सम न नराधिप को है ॥१॥",
      "sourceLineId": "135730",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਧਾਮ ਸੁ ਬਸਤ੍ਰ ਮਤੀ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "dhaam su basatr matee teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਬਸਤ੍ਰ ਮਤੀ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "धाम सु बसत्र मती तिह नारी ॥",
      "sourceLineId": "135731",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਸਤ੍ਰਾਵਤੀ ਨਗਰ ਉਜਿਯਾਰੀ ॥",
      "transliteration": "basatraavatee nagar ujiyaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਬਸਤ੍ਰਾਵਤੀ ਨਾ ਦੀ ਨਗਰੀ ਬਹੁਤ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "बसत्रावती नगर उजियारी ॥",
      "sourceLineId": "135732",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਵਲ ਚੰਦ ਤਿਹ ਠਾ ਇਕ ਰਾਵਤ ॥",
      "transliteration": "aval cha(n)dh teh Thaa ik raavat ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਅਵਲ ਚੰਦ ਨਾ ਦਾ ਇਕ ਰਾਵਤ (ਰਾਜਪੂਤ) ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "अवल चंद तिह ठा इक रावत ॥",
      "sourceLineId": "135733",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਾਨੀ ਸੁਨਾ ਏਕ ਦਿਨ ਗਾਵਤ ॥੨॥",
      "transliteration": "raanee sunaa ek dhin gaavat ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਰਾਣੀ ਨੇ ਇਕ ਦਿਨ ਗਾਉਾਂਦਿਆਂ ਸੁਣਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "रानी सुना एक दिन गावत ॥२॥",
      "sourceLineId": "135734",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਧਿ ਗਯੋ ਤਾ ਸੌ ਐਸ ਸਨੇਹਾ ॥",
      "transliteration": "badh gayo taa sau aais sanehaa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਦਾ) ਉਸ ਨਾਲ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਸਨੇਹ ਵੱਧ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "बधि गयो ता सौ ऐस सनेहा ॥",
      "sourceLineId": "135735",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਸ ਸਾਵਨ ਕੋ ਬਰਸਤ ਮੇਹਾ ॥",
      "transliteration": "jas saavan ko barasat mehaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਸਾਵਣ ਦੇ ਮਹੀਨੇ ਵਿਚ ਮੀਂਹ ਪੈਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "जस सावन को बरसत मेहा ॥",
      "sourceLineId": "135736",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਏਕ ਜਤਨ ਤਿਨ ਨਾਰਿ ਬਨਾਯੋ ॥",
      "transliteration": "ek jatan tin naar banaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਣੀ ਨੇ ਇਕ ਚਰਿਤ੍ਰ ਖੇਡਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "एक जतन तिन नारि बनायो ॥",
      "sourceLineId": "135737",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪਠੈ ਸਖੀ ਤਿਹ ਬੋਲਿ ਪਠਾਯੋ ॥੩॥",
      "transliteration": "paThai sakhee teh bol paThaayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਬੁਲਾ ਲਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "पठै सखी तिह बोलि पठायो ॥३॥",
      "sourceLineId": "135738",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਾ ਸੌ ਦ੍ਰਿੜ ਕੀਨਾ ॥",
      "transliteration": "kaam bhog taa sau dhiraR keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਕਾਮ-ਭੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "काम भोग ता सौ दृड़ कीना ॥",
      "sourceLineId": "135739",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਪਿਯ ਕੋ ਰਸ ਲੀਨਾ ॥",
      "transliteration": "bhaat bhaat piy ko ras leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਰ੍ਰਹਾ ਤਰ੍ਰਹਾ ਨਾਲ ਪ੍ਰੀਤਮ ਦਾ ਰਸ ਮਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "भाति भाति पिय को रस लीना ॥",
      "sourceLineId": "135740",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਾਜ ਪਾਟ ਸਭ ਹੀ ਸੁ ਬਿਸਾਰਿਯੋ ॥",
      "transliteration": "raaj paaT sabh hee su bisaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਰਾਜ-ਪਾਟ ਸਭ ਕੁਝ ਭੁਲਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "राज पाट सभ ही सु बिसारियो ॥",
      "sourceLineId": "135741",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾ ਕੇ ਹਾਥ ਬੇਚਿ ਜੀਯ ਡਾਰਿਯੋ ॥੪॥",
      "transliteration": "taa ke haath bech jeey ddaariyo ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਹੱਥ ਆਪਣਾ ਹਿਰਦਾ ਹੀ ਵੇਚ ਦਿੱਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "ता के हाथ बेचि जीय डारियो ॥४॥",
      "sourceLineId": "135742",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਭ ਅਤੀਤ ਗ੍ਰਿਹਿ ਨਿਵਤਿ ਪਠਾਏ ॥",
      "transliteration": "sabh ateet gireh nivat paThaae ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਾਰਿਆਂ ਸਾਧਾ ਨੂੰ ਆਪਣੇ ਘਰ ਆਉਣ ਦਾ ਨਿਉਤਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "सभ अतीत गृहि निवति पठाए ॥",
      "sourceLineId": "135743",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਸਤ੍ਰ ਭਗੌਹੈ ਤਿਸ ਪਹਿਰਾਏ ॥",
      "transliteration": "basatr bhagauahai tis pahiraae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਆਪਣੇ ਪ੍ਰੇਮੀ) ਨੂੰ ਵੀ ਭਗਵੇ ਬਸਤ੍ਰ ਪਵਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "बसत्र भगौहै तिस पहिराए ॥",
      "sourceLineId": "135744",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਪਹੁ ਬਸਤ੍ਰ ਭਗੌਹੇ ਧਰਿ ਕੈ ॥",
      "transliteration": "aapahu basatr bhagauahe dhar kai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਪ ਵੀ ਭਗਵੇ ਬਸਤ੍ਰ ਧਾਰਨ ਕਰ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "आपहु बसत्र भगौहे धरि कै ॥",
      "sourceLineId": "135745",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾਤ ਭਈ ਤਿਹ ਸਾਥ ਨਿਕਰਿ ਕੈ ॥੫॥",
      "transliteration": "jaat bhiee teh saath nikar kai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਨਾਲ ਹੀ ਨਿਕਲ ਗਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "जात भई तिह साथ निकरि कै ॥५॥",
      "sourceLineId": "135746",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੋਬਦਾਰ ਕਿਨਹੂੰ ਨ ਹਟਾਈ ॥",
      "transliteration": "chobadhaar kinahoo(n) na haTaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਚੋਬਦਾਰ ਨੇ (ਉਸ ਨੂੰ) ਨਾ ਰੋਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "चोबदार किनहूँ न हटाई ॥",
      "sourceLineId": "135747",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਭਹਿਨ ਕਰਿ ਜੋਗੀ ਠਹਰਾਈ ॥",
      "transliteration": "sabhahin kar jogee Thaharaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੇ (ਉਸ ਨੂੰ) ਜੋਗੀ ਹੀ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "सभहिन करि जोगी ठहराई ॥",
      "sourceLineId": "135748",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਬ ਵਹੁ ਜਾਤ ਕੋਸ ਬਹੁ ਭਈ ॥",
      "transliteration": "jab vahu jaat kos bahu bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਬਹੁਤ ਕੋਹ ਦੂਰ ਨਿਕਲ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "जब वहु जात कोस बहु भई ॥",
      "sourceLineId": "135749",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਬ ਰਾਜੈ ਪਾਛੇ ਸੁਧ ਲਈ ॥੬॥",
      "transliteration": "tab raajai paachhe sudh liee ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪਿਛੋਂ ਰਾਜੇ ਨੂੰ ਪਤਾ ਲਗਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "तब राजै पाछे सुध लई ॥६॥",
      "sourceLineId": "135750",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕ੍ਰਯਾਵਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੧॥੬੪੭੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau ikrayaavan charitr samaapatam sat subham sat ||351||6476||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੫੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੫੧॥੬੪੭੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ इक्रयावन चरित्र समापतम सतु सुभम सतु ॥३५१॥६४७६॥अफजूँ॥",
      "sourceLineId": "135751",
      "sourceShabadId": "12636",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135752",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਇਸਕ ਤੰਬੋਲ ਸਹਿਰ ਜਹ ਸੋਹੈ ॥",
      "transliteration": "eisak ta(n)bol sahir jeh sohai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਕ ਤੰਬੋਲ ਨਾ ਦਾ ਸ਼ਹਿਰ ਜਿਥੇ ਸ਼ੋਭਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1303,
      "hindi": "",
      "hindiTransliteration": "इसक तंबोल सहिर जह सोहै ॥",
      "sourceLineId": "135753",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1303_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਸਕ ਤੰਬੋਲ ਨਰਿਸ ਤਹ ਕੋ ਹੈ ॥",
      "transliteration": "eisak ta(n)bol naris teh ko hai ||",
      "translation": "",
