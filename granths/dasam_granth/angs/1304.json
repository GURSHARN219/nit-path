{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1304,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1304_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਸਕਪੇਚ ਦੇ ਤਾ ਕੀ ਰਾਨੀ ॥",
      "transliteration": "eisakapech dhe taa kee raanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਰਾਣੀ ਇਸਕਪੇਚ ਦੇ (ਦੇਈ) ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "इसकपेच दे ता की रानी ॥",
      "sourceLineId": "135755",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁੰਦਰਿ ਦੇਸ ਦੇਸ ਮਹਿ ਜਾਨੀ ॥੧॥",
      "transliteration": "su(n)dhar dhes dhes meh jaanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦੇਸ ਦੇਸਾਤਰਾ ਵਿਚ ਸੁੰਦਰ ਮੰਨੀ ਜਾਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "सुँदरि देस देस महि जानी ॥१॥",
      "sourceLineId": "135756",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਾਜੀ ਬਸਤ ਏਕ ਤਹ ਭਾਰੋ ॥",
      "transliteration": "kaajee basat ek teh bhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਵੱਡਾ ਕਾਜ਼ੀ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "काजी बसत एक तह भारो ॥",
      "sourceLineId": "135757",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਰਫ ਦੀਨ ਨਾਮ ਉਜਿਯਾਰੋ ॥",
      "transliteration": "aaraf dheen naam ujiyaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਉਜਲਾ ਨਾਮ ਆਰਫ਼ ਦੀਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "आरफ दीन नाम उजियारो ॥",
      "sourceLineId": "135758",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੁਤਾ ਜੇਬਤੁਲ ਨਿਸਾ ਤਵਨ ਕੀ ॥",
      "transliteration": "sutaa jebatul nisaa tavan kee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਜ਼ੇਬਤੁਲ ਨਿਸਾ ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "सुता जेबतुल निसा तवन की ॥",
      "sourceLineId": "135759",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਸਿ ਕੀ ਸੀ ਦੁਤਿ ਲਗਤ ਜਵਨ ਕੀ ॥੨॥",
      "transliteration": "sas kee see dhut lagat javan kee ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਛਬੀ ਚੰਦ੍ਰਮਾ ਵਰਗੀ ਲਗਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "ससि की सी दुति लगत जवन की ॥२॥",
      "sourceLineId": "135760",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਹ ਗੁਲਜਾਰ ਰਾਇ ਇਕ ਨਾਮਾ ॥",
      "transliteration": "teh gulajaar rai ik naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਗੁਲਜ਼ਾਰ ਰਾਇ ਨਾ ਦਾ ਇਕ (ਵਿਅਕਤੀ) ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "तह गुलजार राइ इक नामा ॥",
      "sourceLineId": "135761",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਥਕਿਤ ਰਹਤ ਨਿਰਖਤ ਜਿਹ ਬਾਮਾ ॥",
      "transliteration": "thakit rahat nirakhat jeh baamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਇਸਤਰੀਆਂ ਥਕੀਆਂ ਰਹਿ ਜਾਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "थकित रहत निरखत जिह बामा ॥",
      "sourceLineId": "135762",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੋ ਕਾਜੀ ਕੀ ਸੁਤਾ ਨਿਹਾਰਾ ॥",
      "transliteration": "so kaajee kee sutaa nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਉਸ ਨੂੰ ਕਾਜ਼ੀ ਦੀ ਪੁੱਤਰੀ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "सो काजी की सुता निहारा ॥",
      "sourceLineId": "135763",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਦਨ ਬਾਨ ਤਹ ਤਾਹਿ ਪ੍ਰਹਾਰਾ ॥੩॥",
      "transliteration": "madhan baan teh taeh prahaaraa ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਕਾਮ ਨੇ ਬਾਣ ਮਾਰਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "मदन बान तह ताहि प्रहारा ॥३॥",
      "sourceLineId": "135764",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਿਤੂ ਜਾਨਿ ਇਕ ਸਖੀ ਬੁਲਾਈ ॥",
      "transliteration": "hitoo jaan ik sakhee bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਤੂ ਜਾਣ ਕੇ (ਉਸ ਨੇ) ਇਕ ਸਖੀ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "हितू जानि इक सखी बुलाई ॥",
      "sourceLineId": "135765",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਾ ਕਹ ਕਹਾ ਭੇਦ ਸਮਝਾਈ ॥",
      "transliteration": "taa keh kahaa bhedh samajhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ (ਸਾਰਾ) ਭੇਦ ਕਹਿ ਕੇ ਸਮਝਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "ता कह कहा भेद समझाई ॥",
      "sourceLineId": "135766",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੌ ਤਾ ਕਹ ਤੈ ਮੋਹਿ ਮਿਲਾਵੈਂ ॥",
      "transliteration": "jau taa keh tai moh milaavai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੂੰ ਉਸ ਨੂੰ ਮੈਨੂੰ ਮਿਲਾ ਦੇਵੇਾਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "जौ ता कह तै मोहि मिलावैं ॥",
      "sourceLineId": "135767",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੁਖ ਮਾਗੈ ਸੋਈ ਬਰੁ ਪਾਵੈਂ ॥੪॥",
      "transliteration": "mukh maagai soiee bar paavai(n) ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੂੰਹ ਮੰਗਿਆ ਵਰ (ਇਨਾਮ) ਪ੍ਰਾਪਤ ਕਰੇਾਂ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "मुख मागै सोई बरु पावैं ॥४॥",
      "sourceLineId": "135768",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਖੀ ਗਈ ਤਬ ਹੀ ਤਾ ਕੇ ਪ੍ਰਤਿ ॥",
      "transliteration": "sakhee giee tab hee taa ke prat ||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀ ਤਦ ਹੀ ਉਸ ਕੋਲ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "सखी गई तब ही ता के प्रति ॥",
      "sourceLineId": "135769",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਆਨਿ ਮਿਲਾਇ ਦਯੌ ਤਿਨ ਸੁਭ ਮਤਿ ॥",
      "transliteration": "aan milai dhayau tin subh mat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਸ਼ੁਭ ਮਤਿ ਵਾਲੇ (ਪ੍ਰੇਮੀ) ਨੂੰ ਆਣ ਕੇ ਮਿਲਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "आनि मिलाइ दयौ तिन सुभ मति ॥",
      "sourceLineId": "135770",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਦੁਹੂੰ ਕਰੇ ਬਿਲਾਸਾ ॥",
      "transliteration": "bhaat bhaat dhuhoo(n) kare bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਮਾਤਾ ਪਿਤਾ ਦਾ ਡਰ ਤਿਆਗ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "भाति भाति दुहूँ करे बिलासा ॥",
      "sourceLineId": "135771",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਜਿ ਕਰਿ ਮਾਤ ਪਿਤਾ ਕੋ ਤ੍ਰਾਸਾ ॥੫॥",
      "transliteration": "taj kar maat pitaa ko traasaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਬਿਲਾਸ ਕੀਤੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "तजि करि मात पिता को त्रासा ॥५॥",
      "sourceLineId": "135772",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਸ ਗੀ ਅਟਕਿ ਤਵਨ ਪਰ ਤਰੁਨੀ ॥",
      "transliteration": "as gee aTak tavan par tarunee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਹ ਇਸਤਰੀ ਉਸ (ਯੁਵਕ) ਉਤੇ ਮੋਹਿਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "अस गी अटकि तवन पर तरुनी ॥",
      "sourceLineId": "135773",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੋਰਿ ਨ ਸਕਤ ਪਲਕ ਸੌ ਬਰਨੀ ॥",
      "transliteration": "jor na sakat palak sau baranee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਉਸ ਨੂੰ ਵੇਖਦਿਆਂ) ਪਲਕ ਨਾਲ ਪਲਕ ('ਬਰਨੀ') ਨਹੀਂ ਜੋੜ ਸਕਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "जोरि न सकत पलक सौ बरनी ॥",
      "sourceLineId": "135774",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰੈਨਿ ਦਿਵਸ ਤਿਹ ਪ੍ਰਭਾ ਨਿਹਾਰੈ ॥",
      "transliteration": "rain dhivas teh prabhaa nihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਉਸ ਦੀ ਛਬੀ ਨੂੰ ਵੇਖਦੀ ਰਹਿੰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "रैनि दिवस तिह प्रभा निहारै ॥",
      "sourceLineId": "135775",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਧੰਨ੍ਯ ਜਨਮ ਕਰਿ ਅਪਨ ਬਿਚਾਰੈ ॥੬॥",
      "transliteration": "dha(n)nay janam kar apan bichaarai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਜਨਮ ਨੂੰ ਧੰਨ ਸਮਝਦੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "धंन्य जनम करि अपन बिचारै ॥६॥",
      "sourceLineId": "135776",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਧੰਨਿ ਧੰਨਿ ਤਵਨ ਦਿਵਸ ਬਡਭਾਗੀ ॥",
      "transliteration": "dha(n)n dha(n)n tavan dhivas baddabhaagee ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿੰਦੀ) ਉਹ ਵੱਡਭਾਗੀ ਦਿਨ ਧੰਨ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "धंनि धंनि तवन दिवस बडभागी ॥",
      "sourceLineId": "135777",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਿਹ ਦਿਨ ਲਗਨ ਤੁਮਾਰੀ ਲਾਗੀ ॥",
      "transliteration": "jeh dhin lagan tumaaree laagee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਿਨ ਤੁਹਾਡੀ ਲਗਨ ਲਗੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "जिह दिन लगन तुमारी लागी ॥",
      "sourceLineId": "135778",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਬ ਕਛੁ ਐਸ ਉਪਾਵ ਬਨੈਯੈ ॥",
      "transliteration": "ab kachh aais upaav banaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਕੋਈ ਅਜਿਹਾ ਉਪਾ ਕੀਤਾ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "अब कछु ऐस उपाव बनैयै ॥",
      "sourceLineId": "135779",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਿਹ ਛਲ ਪਿਯ ਕੇ ਸੰਗ ਸਿਧੈਯੈ ॥੭॥",
      "transliteration": "jeh chhal piy ke sa(n)g sidhaiyai ||7||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਛਲ ਕਰ ਕੇ ਪ੍ਰੀਤਮ ਨਾਲ ਜਾਇਆ ਜਾ ਸਕੇ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "जिह छल पिय के संग सिधैयै ॥७॥",
      "sourceLineId": "135780",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬੋਲਿ ਭੇਦ ਸਭ ਪਿਯਹਿ ਸਿਖਾਯੋ ॥",
      "transliteration": "bol bhedh sabh piyeh sikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਪ੍ਰੀਤਮ ਨੂੰ ਸਾਰਾ ਭੇਦ ਬੋਲ ਕੇ ਸਮਝਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "बोलि भेद सभ पियहि सिखायो ॥",
      "sourceLineId": "135781",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰੋਮਨਾਸ ਤਿਹ ਬਦਨ ਲਗਾਯੋ ॥",
      "transliteration": "romanaas teh badhan lagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰੋਮਨਾਸਨੀ ਉਸ ਦੇ ਮੂੰਹ ਉਤੇ ਲਗਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "रोमनास तिह बदन लगायो ॥",
      "sourceLineId": "135782",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਭ ਹੀ ਕੇਸ ਦੂਰ ਕਰਿ ਡਾਰੇ ॥",
      "transliteration": "sabh hee kes dhoor kar ddaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਸਾਰੇ ਵਾਲ ਸਾਫ਼ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "सभ ही केस दूर करि डारे ॥",
      "sourceLineId": "135783",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪੁਰਖ ਨਾਰਿ ਨਹਿ ਜਾਤ ਬਿਚਾਰੇ ॥੮॥",
      "transliteration": "purakh naar neh jaat bichaare ||8||",
      "translation": "",
      "punjabiViakhya": "(ਹੁਣ ਉਹ) ਪੁਰਸ਼ ਨਹੀਂ ਵਿਚਾਰਿਆ ਜਾ ਸਕਦਾ ਸੀ, ਇਸਤਰੀ (ਹੀ ਲਗਦੀ ਸੀ) ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "पुरख नारि नहि जात बिचारे ॥८॥",
      "sourceLineId": "135784",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਭ ਤ੍ਰਿਯ ਭੇਸ ਧਰਾ ਪ੍ਰੀਤਮ ਜਬ ॥",
      "transliteration": "sabh tiray bhes dharaa preetam jab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਪ੍ਰੀਤਮ ਨੇ ਇਸਤਰੀ ਦਾ ਸਾਰਾ ਭੇਸ ਧਾਰਨ ਕਰ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "सभ तृय भेस धरा प्रीतम जब ॥",
      "sourceLineId": "135785",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਠਾਢਾ ਭਯੋ ਅਦਾਲਤਿ ਮੈ ਤਬ ॥",
      "transliteration": "Thaaddaa bhayo adhaalat mai tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਹ ਅਦਾਲਤ ਵਿਚ ਜਾ ਖੜੋਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "ठाढा भयो अदालति मै तब ॥",
      "sourceLineId": "135786",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਹਿ ਮੁਰ ਚਿਤ ਕਾਜੀ ਸੁਤ ਲੀਨਾ ॥",
      "transliteration": "keh mur chit kaajee sut leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿਣ ਲਗਾ ਕਿ ਮੇਰਾ ਚਿਤ ਕਾਜ਼ੀ ਦੇ ਪੁੱਤਰ (ਅਸਲੋਂ ਪੁੱਤਰੀ) ਨੇ ਜਿਤ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "कहि मुर चित काजी सुत लीना ॥",
      "sourceLineId": "135787",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮੈ ਚਾਹਤ ਤਾ ਕੌ ਪਤਿ ਕੀਨਾ ॥੯॥",
      "transliteration": "mai chaahat taa kau pat keenaa ||9||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਉਸ ਨੂੰ (ਆਪਣਾ) ਪਤੀ ਬਣਾਉਣਾ ਚਾਹੁੰਦੀ ਹਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "मै चाहत ता कौ पति कीना ॥९॥",
      "sourceLineId": "135788",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਾਜੀ ਕਾਢਿ ਕਿਤਾਬ ਨਿਹਾਰੀ ॥",
      "transliteration": "kaajee kaadd kitaab nihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਜ਼ੀ ਨੇ ਕਿਤਾਬ ਖੋਲ੍ਰਹ ਕੇ ਵੇਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "काजी काढि किताब निहारी ॥",
      "sourceLineId": "135789",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੇਖਿ ਦੇਖਿ ਕਰਿ ਇਹੈ ਉਚਾਰੀ ॥",
      "transliteration": "dhekh dhekh kar ihai uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੇਖ ਵੇਖ ਕੇ ਇਹੀ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "देखि देखि करि इहै उचारी ॥",
      "sourceLineId": "135790",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੋ ਆਵੈ ਆਪਨ ਹ੍ਵੈ ਰਾਜੀ ॥",
      "transliteration": "jo aavai aapan havai raajee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਆਪ ਰਜ਼ਾਮੰਦੀ ਨਾਲ ਆਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "जो आवै आपन ह्वै राजी ॥",
      "sourceLineId": "135791",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਾ ਕਹ ਕਹਿ ਨ ਸਕਤ ਕਛੁ ਕਾਜੀ ॥੧੦॥",
      "transliteration": "taa keh keh na sakat kachh kaajee ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਾਜ਼ੀ ਕੁਝ ਨਹੀਂ ਕਹਿ ਸਕਦਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "ता कह कहि न सकत कछु काजी ॥१०॥",
      "sourceLineId": "135792",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਯਹ ਹਮਰੇ ਸੁਤ ਕੀ ਭੀ ਦਾਰਾ ॥",
      "transliteration": "yeh hamare sut kee bhee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਮੇਰੇ ਪੁੱਤਰ ਦੀ ਪਤਨੀ ਬਣ ਗਈ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "यह हमरे सुत की भी दारा ॥",
      "sourceLineId": "135793",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਮ ਯਾ ਕੀ ਕਰਿ ਹੈ ਪ੍ਰਤਿਪਾਰਾ ॥",
      "transliteration": "ham yaa kee kar hai pratipaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਇਸ ਦੀ ਪਾਲਣਾ ਕਰਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "हम या की करि है प्रतिपारा ॥",
      "sourceLineId": "135794",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਜੜ ਕਛੂ ਨ ਚੀਨੀ ॥",
      "transliteration": "bhedh abhedh jaR kachhoo na cheenee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੇ ਕੋਈ ਭੇਦ ਅਭੇਦ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद जड़ कछू न चीनी ॥",
      "sourceLineId": "135795",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਿਰਖਿਤ ਸਾਹ ਮੁਹਰ ਕਰਿ ਦੀਨੀ ॥੧੧॥",
      "transliteration": "nirakhit saeh muhar kar dheenee ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਾਦਸ਼ਾਹ ਦੇ ਵੇਖਦੇ ਹੋਇਆਂ (ਪ੍ਰਵਾਨਗੀ ਦੀ) ਮੋਹਰ ਲਗਾ ਦਿੱਤੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "निरखित साह मुहर करि दीनी ॥११॥",
      "sourceLineId": "135796",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮੁਹਰ ਕਰਾਇ ਧਾਮ ਵਹ ਗਯੋ ॥",
      "transliteration": "muhar karai dhaam veh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੋਹਰ ਲਗਵਾ ਕੇ ਉਹ ਘਰ ਚਲਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "मुहर कराइ धाम वह गयो ॥",
      "sourceLineId": "135797",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪੁਰਸ ਭੇਸ ਧਰਿ ਆਵਤ ਭਯੋ ॥",
      "transliteration": "puras bhes dhar aavat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੁਰਸ਼ ਭੇਸ ਧਾਰ ਕੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "पुरस भेस धरि आवत भयो ॥",
      "sourceLineId": "135798",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਬ ਦਿਨ ਦੁਤਿਯ ਕਚਹਿਰੀ ਲਾਗੀ ॥",
      "transliteration": "jab dhin dhutiy kachahiree laagee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੂਜੇ ਦਿਨ ਕਚਹਿਰੀ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "जब दिन दुतिय कचहिरी लागी ॥",
      "sourceLineId": "135799",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪਾਤਸਾਹ ਬੈਠੇ ਬਡਭਾਗੀ ॥੧੨॥",
      "transliteration": "paatasaeh baiThe baddabhaagee ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵਡਿਆਂ ਭਾਗਾ ਵਾਲਾ ਬਾਦਸ਼ਾਹ (ਆ ਕੇ) ਬੈਠਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "पातसाह बैठे बडभागी ॥१२॥",
      "sourceLineId": "135800",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਾਜੀ ਕੋਟਵਾਰ ਥੋ ਜਹਾ ॥",
      "transliteration": "kaajee koTavaar tho jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਾਜ਼ੀ ਅਤੇ ਕੋਤਵਾਲ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "काजी कोटवार थो जहा ॥",
      "sourceLineId": "135801",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1304_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪੁਰਖ ਭੇਸ ਧਰਿ ਆਯੋ ਤਹਾ ॥",
      "transliteration": "purakh bhes dhar aayo tahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪੁਰਸ਼ ਦਾ ਭੇਸ ਧਾਰ ਕੇ ਉਥੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1304,
      "hindi": "",
      "hindiTransliteration": "पुरख भेस धरि आयो तहा ॥",
      "sourceLineId": "135802",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
