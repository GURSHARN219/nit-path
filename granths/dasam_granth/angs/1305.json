{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1305,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1305_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੰਗ ਸੁਤਾ ਕਾਜੀ ਕੀ ਆਨੀ ॥",
      "transliteration": "sa(n)g sutaa kaajee kee aanee ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਲ ਹੀ ਕਾਜ਼ੀ ਦੀ ਪੁੱਤਰੀ ਨੂੰ ਲੈ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "संग सुता काजी की आनी ॥",
      "sourceLineId": "135803",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਹ ਸੁਨਤ ਇਹ ਭਾਤਿ ਬਖਾਨੀ ॥੧੩॥",
      "transliteration": "saeh sunat ieh bhaat bakhaanee ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਾਦਸ਼ਾਹ ਦੇ ਸੁਣਦੇ ਹੋਇਆਂ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "साह सुनत इह भाति बखानी ॥१३॥",
      "sourceLineId": "135804",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਿਰਖਹੁ ਕਾਜਿ ਸੁਤਾ ਮੁਹਿ ਬਰਾ ॥",
      "transliteration": "nirakhahu kaaj sutaa muh baraa ||",
      "translation": "",
      "punjabiViakhya": "ਵੇਖੋ ਜੀ, ਕਾਜ਼ੀ ਦੀ ਧੀ ਨੇ ਮੇਰੇ ਨਾਲ ਵਿਆਹ ਕੀਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "निरखहु काजि सुता मुहि बरा ॥",
      "sourceLineId": "135805",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਪਹਿ ਰੀਝਿ ਮਦਨਪਤਿ ਕਰਾ ॥",
      "transliteration": "aapeh reejh madhanapat karaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਹੀ ਰੀਝ ਕੇ ਕਾਮ ਦੇਵ ਵਰਗਾ ਪਤੀ ਪ੍ਰਾਪਤ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "आपहि रीझि मदनपति करा ॥",
      "sourceLineId": "135806",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਵਹੈ ਮੁਹਰ ਹਜਰਤਿਹਿ ਦਿਖਾਈ ॥",
      "transliteration": "vahai muhar hajarateh dhikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਮੋਹਰ ਬਾਦਸ਼ਾਹ ਨੂੰ ਵਿਖਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "वहै मुहर हजरतिहि दिखाई ॥",
      "sourceLineId": "135807",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੋ ਇਸਤ੍ਰੀ ਹ੍ਵੈ ਆਪੁ ਕਰਾਈ ॥੧੪॥",
      "transliteration": "jo isatree havai aap karaiee ||14||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਸਤਰੀ ਹੋ ਕੇ ਆਪ ਲਗਵਾਈ ਸੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "जो इसत्री ह्वै आपु कराई ॥१४॥",
      "sourceLineId": "135808",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਿਰਖਤ ਮੁਹਰ ਸਭਾ ਸਭ ਹਸੀ ॥",
      "transliteration": "nirakhat muhar sabhaa sabh hasee ||",
      "translation": "",
      "punjabiViakhya": "ਮੋਹਰ ਨੂੰ ਵੇਖ ਕੇ ਸਾਰੀ ਸਭਾ ਹਸਣ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "निरखत मुहर सभा सभ हसी ॥",
      "sourceLineId": "135809",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਾਜਿ ਸੁਤਾ ਮਿਤਵਾ ਗ੍ਰਿਹ ਬਸੀ ॥",
      "transliteration": "kaaj sutaa mitavaa gireh basee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਕਾਜ਼ੀ ਦੀ ਪੁੱਤਰੀ ਮਿਤਰ ਦੇ ਘਰ ਜਾ ਵਸੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "काजि सुता मितवा गृह बसी ॥",
      "sourceLineId": "135810",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਾਜੀ ਹੂੰ ਚੁਪ ਹ੍ਵੈ ਕਰਿ ਰਹਾ ॥",
      "transliteration": "kaajee hoo(n) chup havai kar rahaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਜ਼ੀ ਵੀ ਚੁਪ ਹੋ ਕੇ ਰਹਿ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "काजी हूँ चुप ह्वै करि रहा ॥",
      "sourceLineId": "135811",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨ੍ਯਾਇ ਕਿਯਾ ਤੈਸਾ ਫਲ ਲਹਾ ॥੧੫॥",
      "transliteration": "nayai kiyaa taisaa fal lahaa ||15||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਜਿਹੋ ਜਿਹਾ) ਨਿਆਂ ਕੀਤਾ ਸੀ, ਉਸੇ ਤਰ੍ਰਹਾ ਦਾ ਫਲ ਪ੍ਰਾਪਤ ਕਰ ਲਿਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "न्याइ किया तैसा फल लहा ॥१५॥",
      "sourceLineId": "135812",
      "sourceShabadId": "12637",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "135813",
      "sourceShabadId": "12638",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇਹ ਛਲ ਸੌ ਕਾਜੀ ਛਲਾ ਬਸੀ ਮਿਤ੍ਰ ਕੇ ਧਾਮ ॥",
      "transliteration": "eeh chhal sau kaajee chhalaa basee mitr ke dhaam ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਕਾਜ਼ੀ ਨੂੰ ਛਲ ਕੇ ਮਿਤਰ ਦੇ ਘਰ ਜਾ ਵਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "इह छल सौ काजी छला बसी मित्र के धाम ॥",
      "sourceLineId": "135814",
      "sourceShabadId": "12638",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲਖਨ ਚਰਿਤ ਚਤੁਰਾਨ ਕੋ ਹੈ ਨ ਕਿਸੀ ਕੋ ਕਾਮ ॥੧੬॥",
      "transliteration": "lakhan charit chaturaan ko hai na kisee ko kaam ||16||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਦੇ ਚਰਿਤ੍ਰ ਨੂੰ ਵੇਖਣਾ (ਸਮਝਣਾ) ਕਿਸੇ ਦੇ ਵਸ ਦੀ ਗੱਲ ਨਹੀਂ ਹੈ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "लखन चरित चतुरान को है न किसी को काम ॥१६॥",
      "sourceLineId": "135815",
      "sourceShabadId": "12638",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਬਾਵਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੨॥੬੪੯੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau baavan charitr samaapatam sat subham sat ||352||6492||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੫੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੫੨॥੬੪੯੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ बावन चरित्र समापतम सतु सुभम सतु ॥३५२॥६४९२॥अफजूँ॥",
      "sourceLineId": "135816",
      "sourceShabadId": "12638",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135817",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਨਹੁ ਰਾਜ ਇਕ ਕਥਾ ਉਚਾਰੋ ॥",
      "transliteration": "sunahu raaj ik kathaa uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਸੁਣੋ, ਇਕ ਕਥਾ ਦਾ ਵਰਣਨ ਕਰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "सुनहु राज इक कथा उचारो ॥",
      "sourceLineId": "135818",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਯ ਤੁਮਰੇ ਕੋ ਭਰਮ ਨਿਵਾਰੋ ॥",
      "transliteration": "jiy tumare ko bharam nivaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨਾਲ) ਤੁਹਾਡੇ ਮਨ ਦਾ ਭਰਮ ਦੂਰ ਕਰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "जिय तुमरे को भरम निवारो ॥",
      "sourceLineId": "135819",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਿਸਨਾਵਤੀ ਨਗਰ ਇਕ ਦਛਿਨ ॥",
      "transliteration": "bisanaavatee nagar ik dhachhin ||",
      "translation": "",
      "punjabiViakhya": "ਦੱਖਣ ਦਿਸ਼ਾ ਵਿਚ ਇਕ ਬਿਸਨਾਵਤੀ ਨਾ ਦਾ ਨਗਰ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "बिसनावती नगर इक दछिन ॥",
      "sourceLineId": "135820",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਿਸਨ ਚੰਦ ਤਹ ਭੂਪ ਬਿਚਛਨ ॥੧॥",
      "transliteration": "bisan cha(n)dh teh bhoop bichachhan ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਦਾ ਬਿਸਨ ਚੰਦ ਨਾ ਦਾ ਬੁੱਧੀਮਾਨ ਰਾਜਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "बिसन चंद तह भूप बिचछन ॥१॥",
      "sourceLineId": "135821",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਉਗ੍ਰ ਸਿੰਘ ਤਹ ਸਾਹੁ ਭਨਿਜੈ ॥",
      "transliteration": "augr si(n)gh teh saahu bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਦੇ ਸ਼ਾਹ ਦਾ ਨਾ ਉਗ੍ਰ ਸਿੰਘ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "उग्र सिंघ तह साहु भनिजै ॥",
      "sourceLineId": "135822",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਵਨ ਭੂਪ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥",
      "transliteration": "kavan bhoop paTatar teh dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਦੀ ਤੁਲਨਾ ਕਿਸ ਨਾਲ ਦੇਈਏ (ਭਾਵ ਕਿਸੇ ਨਾਲ ਨਹੀਂ ਦਿੱਤੀ ਜਾ ਸਕਦੀ)।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "कवन भूप पटतर तिह दिजै ॥",
      "sourceLineId": "135823",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸ੍ਰੀ ਰਨਝੂਮਕ ਦੇ ਤਿਹਾ ਬਾਲਾ ॥",
      "transliteration": "sree ranajhoomak dhe tihaa baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਰਨਝੂਮਕ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "स्री रनझूमक दे तिहा बाला ॥",
      "sourceLineId": "135824",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੰਦ੍ਰ ਲਯੋ ਜਾ ਤੇ ਉਜਿਯਾਲਾ ॥੨॥",
      "transliteration": "cha(n)dhr layo jaa te ujiyaalaa ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ ਚੰਦ੍ਰਮਾ ਨੇ ਰੌਸ਼ਨੀ ਲਈ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "चंद्र लयो जा ते उजियाला ॥२॥",
      "sourceLineId": "135825",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁੰਭ ਕਰਨ ਕਹ ਹੁਤੀ ਬਿਵਾਹੀ ॥",
      "transliteration": "su(n)bh karan keh hutee bivaahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸੁੰਭ ਕਰਨ ਨਾਲ ਵਿਆਹੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "सुँभ करन कह हुती बिवाही ॥",
      "sourceLineId": "135826",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੋ ਦਿਨ ਏਕ ਨਿਰਖ ਨ੍ਰਿਪ ਚਾਹੀ ॥",
      "transliteration": "so dhin ek nirakh nirap chaahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਇਕ ਦਿਨ ਰਾਜੇ ਨੇ ਵੇਖਣਾ ਚਾਹਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "सो दिन एक निरख नृप चाही ॥",
      "sourceLineId": "135827",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਤਨ ਥਕਿਯੋ ਕਰਿ ਹਾਥ ਨ ਆਈ ॥",
      "transliteration": "jatan thakiyo kar haath na aaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ) ਯਤਨ ਕਰ ਕੇ ਥਕ ਗਿਆ, ਪਰ ਉਹ ਹੱਥ ਵਿਚ ਨਾ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "जतन थकियो करि हाथ न आई ॥",
      "sourceLineId": "135828",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕੋਪ ਬਢਾ ਅਤਿ ਹੀ ਨਰ ਰਾਈ ॥੩॥",
      "transliteration": "kop baddaa at hee nar raiee ||3||",
      "translation": "",
      "punjabiViakhya": "(ਫਲਸਰੂਪ) ਰਾਜੇ ਦਾ ਕ੍ਰੋਧ ਬਹੁਤ ਵੱਧ ਗਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "कोप बढा अति ही नर राई ॥३॥",
      "sourceLineId": "135829",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੇਖਹੁ ਇਹੁ ਅਬਲਾ ਕਾ ਹੀਯਾ ॥",
      "transliteration": "dhekhahu ih abalaa kaa heeyaa ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗਾ) ਇਸ ਅਬਲਾ ਦਾ ਜਿਗਰਾ ਵੇਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "देखहु इहु अबला का हीया ॥",
      "sourceLineId": "135830",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਹ ਕਾਰਨ ਹਮ ਅਸ ਛਲ ਕੀਯਾ ॥",
      "transliteration": "jeh kaaran ham as chhal keeyaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਾਸਤੇ ਮੈਂ ਇਤਨਾ ਛਲ (ਯਤਨ) ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "जिह कारन हम अस छल कीया ॥",
      "sourceLineId": "135831",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰੰਕ ਛੋਰਿ ਕਰਿ ਰਾਵ ਨ ਭਾਯੋ ॥",
      "transliteration": "ra(n)k chhor kar raav na bhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ (ਉਸ ਨੂੰ) ਰੰਕ ਛਡ ਕੇ ਰਾਜਾ ਚੰਗਾ ਨਹੀਂ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "रंक छोरि करि राव न भायो ॥",
      "sourceLineId": "135832",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਹੁ ਭ੍ਰਿਤਨ ਕਹ ਤਹਾ ਪਠਾਯੋ ॥੪॥",
      "transliteration": "bahu bhiratan keh tahaa paThaayo ||4||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਉਸ ਪਾਸ ਕਈ ਸੇਵਕਾ ਨੂੰ ਭੇਜਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "बहु भृतन कह तहा पठायो ॥४॥",
      "sourceLineId": "135833",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਚਾਕਰ ਤਹ ਗਏ ॥",
      "transliteration": "sunat bachan chaakar teh ge ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਦੀ) ਗੱਲ ਸੁਣ ਕੇ ਸੇਵਕ ਉਸ ਕੋਲ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन चाकर तह गए ॥",
      "sourceLineId": "135834",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਘੇਰ ਲੇਤ ਤਾ ਕੋ ਘਰ ਭਏ ॥",
      "transliteration": "gher let taa ko ghar bhe ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਉਸ ਦਾ ਘਰ ਘੇਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "घेर लेत ता को घर भए ॥",
      "sourceLineId": "135835",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾ ਕੇ ਪਤਿ ਕਹ ਹਨਾ ਰਿਸਾਈ ॥",
      "transliteration": "taa ke pat keh hanaa risaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਪਤੀ ਨੂੰ ਗੁੱਸੇ ਵਿਚ ਆ ਕੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "ता के पति कह हना रिसाई ॥",
      "sourceLineId": "135836",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਾਜਿ ਗਈ ਤ੍ਰਿਯ ਹਾਥ ਨ ਆਈ ॥੫॥",
      "transliteration": "bhaaj giee tiray haath na aaiee ||5||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ) ਇਸਤਰੀ ਭਜ ਗਈ, (ਉਨ੍ਰਹਾ ਦੇ) ਹੱਥ ਨਾ ਆਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "भाजि गई तृय हाथ न आई ॥५॥",
      "sourceLineId": "135837",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮ੍ਰਿਤਕ ਨਾਥ ਜਬ ਨਾਰਿ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "mritak naath jab naar nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਇਸਤਰੀ ਨੇ ਪਤੀ ਨੂੰ ਮਰਿਆ ਹੋਇਆ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "मृतक नाथ जब नारि निहारियो ॥",
      "sourceLineId": "135838",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਹੈ ਚੰਚਲਾ ਚਰਿਤ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "eihai cha(n)chalaa charit bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਉਸ) ਇਸਤਰੀ ਨੇ ਇਹ ਚਰਿਤ੍ਰ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "इहै चंचला चरित बिचारियो ॥",
      "sourceLineId": "135839",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਵਨ ਜਤਨ ਰਾਜਾ ਕਹ ਮਰਿਯੈ ॥",
      "transliteration": "kavan jatan raajaa keh mariyai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸ ਯਤਨ ਨਾਲ ਰਾਜੇ ਨੂੰ ਮਾਰਿਆ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "कवन जतन राजा कह मरियै ॥",
      "sourceLineId": "135840",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਪਨੇ ਪਤਿ ਕੋ ਬੈਰ ਉਤਰਿਯੈ ॥੬॥",
      "transliteration": "apane pat ko bair utariyai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਪਤੀ ਦਾ ਵੈਰ ਉਤਾਰਿਆ ਜਾਏ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "अपने पति को बैर उतरियै ॥६॥",
      "sourceLineId": "135841",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲਿਖ ਪਤਿਯਾ ਪਠਈ ਇਕ ਤਹਾ ॥",
      "transliteration": "likh patiyaa paThiee ik tahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਚਿੱਠੀ ਲਿਖ ਕੇ ਉਥੇ ਭੇਜੀ",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "लिख पतिया पठई इक तहा ॥",
      "sourceLineId": "135842",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬੈਠੋ ਹੁਤੋ ਨਰਾਧਿਪ ਜਹਾ ॥",
      "transliteration": "baiTho huto naraadhip jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਜਾ ਬੈਠਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "बैठो हुतो नराधिप जहा ॥",
      "sourceLineId": "135843",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੋ ਮੋ ਕਹ ਰਾਨੀ ਤੁਮ ਕਰਹੁ ॥",
      "transliteration": "jo mo keh raanee tum karahu ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਜੇ ਤੁਸੀਂ ਮੈਨੂੰ ਆਪਣੀ ਰਾਣੀ ਬਣਾਉਣਾ ਚਾਹੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "जो मो कह रानी तुम करहु ॥",
      "sourceLineId": "135844",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੋ ਮੁਹਿ ਭੂਪ ਆਜੁ ਹੀ ਬਰਹੁ ॥੭॥",
      "transliteration": "to muh bhoop aaj hee barahu ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੈਨੂੰ ਅਜ ਹੀ ਆ ਕੇ ਵਰ ਲਵੋ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "तो मुहि भूप आजु ही बरहु ॥७॥",
      "sourceLineId": "135845",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਨ੍ਰਿਪ ਬੋਲਿ ਪਠਾਈ ॥",
      "transliteration": "sunat bachan nirap bol paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਰਾਜੇ ਨੇ ਬੁਲਵਾ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन नृप बोलि पठाई ॥",
      "sourceLineId": "135846",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪਰ ਕੀ ਤ੍ਰਿਯ ਰਾਨੀ ਠਹਰਾਈ ॥",
      "transliteration": "par kee tiray raanee Thaharaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਾਈ ਇਸਤਰੀ ਨੂੰ ਰਾਣੀ ਬਣਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "पर की तृय रानी ठहराई ॥",
      "sourceLineId": "135847",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਤਾ ਕੋ ਗ੍ਰਿਹਿ ਆਨੋ ॥",
      "transliteration": "jeh teh bidh taa ko gireh aano ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨੂੰ ਘਰ ਲੈ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "जिह तिह बिधि ता को गृहि आनो ॥",
      "sourceLineId": "135848",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਜੜ ਕਛੁ ਨ ਪਛਾਨੋ ॥੮॥",
      "transliteration": "bhedh abhedh jaR kachh na pachhaano ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੇ ਭੇਦ ਅਭੇਦ ਕੁਝ ਵੀ ਨਾ ਸਮਝਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद जड़ कछु न पछानो ॥८॥",
      "sourceLineId": "135849",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1305_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੰਗ ਅਪਨੇ ਤਾ ਕੌ ਲੈ ਸੋਯੋ ॥",
      "transliteration": "sa(n)g apane taa kau lai soyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਆਪਣੇ ਨਾਲ ਲੈ ਕੇ ਸੁੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1305,
      "hindi": "",
      "hindiTransliteration": "संग अपने ता कौ लै सोयो ॥",
      "sourceLineId": "135850",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
