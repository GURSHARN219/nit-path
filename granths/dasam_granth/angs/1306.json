{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1306,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1306_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਿਤ ਕੋ ਭਰਮੁ ਸਕਲ ਹੀ ਖੋਯੋ ॥",
      "transliteration": "chit ko bharam sakal hee khoyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਦਾ ਸਾਰਾ ਭਰਮ ਖ਼ਤਮ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "चित को भरमु सकल ही खोयो ॥",
      "sourceLineId": "135851",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਾਮਾਤੁਰ ਹ੍ਵੈ ਹਾਥ ਚਲਾਯੋ ॥",
      "transliteration": "kaamaatur havai haath chalaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਕਾਮ ਪੀੜਿਤ ਹੋ ਕੇ ਉਸ ਨੇ ਹੱਥ ਵਧਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "कामातुर ह्वै हाथ चलायो ॥",
      "sourceLineId": "135852",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਨਾਰਿ ਤਿਨ ਘਾਯੋ ॥੯॥",
      "transliteration": "kaadd kirapaan naar tin ghaayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸਤਰੀ ਨੇ ਕ੍ਰਿਪਾਨ ਕਢ ਕੇ ਉਸ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "काढि कृपान नारि तिन घायो ॥९॥",
      "sourceLineId": "135853",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨ੍ਰਿਪ ਕਹ ਮਾਰਿ ਵੈਸਹੀ ਡਾਰੀ ॥",
      "transliteration": "nirap keh maar vaisahee ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਮਾਰ ਕੇ ਉਸੇ ਤਰ੍ਰਹਾ ਸੁਟ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "नृप कह मारि वैसही डारी ॥",
      "sourceLineId": "135854",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਾ ਪਰ ਤ੍ਰਯੋ ਹੀ ਬਸਤ੍ਰ ਸਵਾਰੀ ॥",
      "transliteration": "taa par trayo hee basatr savaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਉਤੇ ਉਸੇ ਤਰ੍ਰਹਾ ਬਸਤ੍ਰ ਸੰਵਾਰ ਕੇ ਪਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "ता पर त्रयो ही बसत्र सवारी ॥",
      "sourceLineId": "135855",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਪੁ ਜਾਇ ਨਿਜੁ ਪਤਿ ਤਨ ਜਲੀ ॥",
      "transliteration": "aap jai nij pat tan jalee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਆਪ ਜਾ ਕੇ ਆਪਣੇ ਪਤੀ ਨਾਲ ਸੜ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "आपु जाइ निजु पति तन जली ॥",
      "sourceLineId": "135856",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਿਰਖਹੁ ਚਤੁਰਿ ਨਾਰਿ ਕੀ ਭਲੀ ॥੧੦॥",
      "transliteration": "nirakhahu chatur naar kee bhalee ||10||",
      "translation": "",
      "punjabiViakhya": "ਵੇਖੋ, ਉਸ ਚਤੁਰ ਇਸਤਰੀ ਨੇ ਚੰਗਾ ਕੰਮ ਕੀਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "निरखहु चतुरि नारि की भली ॥१०॥",
      "sourceLineId": "135857",
      "sourceShabadId": "12639",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "135858",
      "sourceShabadId": "12640",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬੈਰ ਲਿਯਾ ਨਿਜੁ ਨਾਹਿ ਕੋ ਨ੍ਰਿਪ ਕਹ ਦਿਯਾ ਸੰਘਾਰਿ ॥",
      "transliteration": "bair liyaa nij naeh ko nirap keh dhiyaa sa(n)ghaar ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਪਤੀ ਦਾ ਬਦਲਾ ਲਿਆ ਅਤੇ ਰਾਜੇ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "बैर लिया निजु नाहि को नृप कह दिया संघारि ॥",
      "sourceLineId": "135859",
      "sourceShabadId": "12640",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਹੁਰਿ ਜਰੀ ਨਿਜੁ ਨਾਥ ਸੌ ਲੋਗਨ ਚਰਿਤ ਦਿਖਾਰਿ ॥੧੧॥",
      "transliteration": "bahur jaree nij naath sau logan charit dhikhaar ||11||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਆਪਣੇ ਪਤੀ ਨਾਲ ਸੜ ਗਈ ਅਤੇ ਲੋਕਾ ਨੂੰ ਆਪਣਾ ਚਰਿਤ੍ਰ ਵਿਖਾ ਦਿੱਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "बहुरि जरी निजु नाथ सौ लोगन चरित दिखारि ॥११॥",
      "sourceLineId": "135860",
      "sourceShabadId": "12640",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤ੍ਰਿਪਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੩॥੬੫੦੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau tirapan charitr samaapatam sat subham sat ||353||6503||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੫੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੫੩॥੬੫੦੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ तृपन चरित्र समापतम सतु सुभम सतु ॥३५३॥६५०३॥अफजूँ॥",
      "sourceLineId": "135861",
      "sourceShabadId": "12640",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135862",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁਨਹੁ ਭੂਪ ਇਕ ਕਥਾ ਨਵੀਨੀ ॥",
      "transliteration": "sunahu bhoop ik kathaa naveenee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਨਵੀਂ ਕਥਾ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "सुनहु भूप इक कथा नवीनी ॥",
      "sourceLineId": "135863",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿਨਹੂੰ ਲਖੀ ਨ ਆਗੇ ਚੀਨੀ ॥",
      "transliteration": "kinahoo(n) lakhee na aage cheenee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਿਸੇ ਨੇ ਨਾ (ਪਹਿਲਾ) ਵੇਖੀ ਹੈ ਅਤੇ ਨਾ ਹੀ ਅਗੇ ਸੋਚੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "किनहूँ लखी न आगे चीनी ॥",
      "sourceLineId": "135864",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਾਧਾ ਨਗਰ ਪੂਰਬ ਮੈ ਜਹਾ ॥",
      "transliteration": "raadhaa nagar poorab mai jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਪੂਰਬ ਵਿਚ ਰਾਧਾ ਨਗਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "राधा नगर पूरब मै जहा ॥",
      "sourceLineId": "135865",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰੁਕਮ ਸੈਨ ਰਾਜਾ ਇਕ ਤਹਾ ॥੧॥",
      "transliteration": "rukam sain raajaa ik tahaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਰੁਕਮ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "रुकम सैन राजा इक तहा ॥१॥",
      "sourceLineId": "135866",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸ੍ਰੀ ਦਲਗਾਹ ਮਤੀ ਤ੍ਰਿਯ ਤਾ ਕੀ ॥",
      "transliteration": "sree dhalagaeh matee tiray taa kee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪਤਨੀ ਦਾ ਨਾ ਦਲਗਾਹ ਮਤੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "स्री दलगाह मती तृय ता की ॥",
      "sourceLineId": "135867",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਰੀ ਨਾਗਨੀ ਤੁਲਿ ਨ ਵਾ ਕੀ ॥",
      "transliteration": "naree naaganee tul na vaa kee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਬਰਾਬਰ ਨਰੀ ਅਤੇ ਨਾਗਨੀ (ਕੋਈ ਵੀ) ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "नरी नागनी तुलि न वा की ॥",
      "sourceLineId": "135868",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੁਤਾ ਸਿੰਧੁਲਾ ਦੇਇ ਭਨਿਜੈ ॥",
      "transliteration": "sutaa si(n)dhulaa dhei bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸਿੰਧੁਲਾ ਦੇਈ ਨਾ ਦੀ ਪੁੱਤਰੀ ਦਸੀ ਜਾਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "सुता सिंधुला देइ भनिजै ॥",
      "sourceLineId": "135869",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਰੀ ਪਦਮਨੀ ਪ੍ਰਕ੍ਰਿਤ ਕਹਿਜੈ ॥੨॥",
      "transliteration": "paree padhamanee prakirat kahijai ||2||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪਰੀ ਜਾ ਪਦਮਨੀ ਦੇ ਸਭਾ ਵਾਲੀ ਮੰਨੀ ਜਾਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "परी पदमनी प्रकृत कहिजै ॥२॥",
      "sourceLineId": "135870",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਹਿਕ ਭਵਾਨੀ ਭਵਨ ਭਨੀਜੈ ॥",
      "transliteration": "tahik bhavaanee bhavan bhaneejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਭਵਾਨੀ ਦਾ ਭਵਨ (ਮੰਦਿਰ) ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "तहिक भवानी भवन भनीजै ॥",
      "sourceLineId": "135871",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕੋ ਦੂਸਰ ਪਟਤਰ ਤਿਹਿ ਦੀਜੈ ॥",
      "transliteration": "ko dhoosar paTatar teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਕਿਸੇ ਹੋਰ ਨਾਲ ਕੀਹ ਤੁਲਨਾ ਕੀਤੀ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "को दूसर पटतर तिहि दीजै ॥",
      "sourceLineId": "135872",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੇਸ ਦੇਸ ਏਸ੍ਵਰ ਤਹ ਆਵਤ ॥",
      "transliteration": "dhes dhes esavair teh aavat ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਦੇਸ ਦੇਸ ਦੇ ਰਾਜੇ ਆਉਾਂਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "देस देस एस्वर तह आवत ॥",
      "sourceLineId": "135873",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਨਿ ਗਵਰਿ ਕਹ ਸੀਸ ਝੁਕਾਵਤ ॥੩॥",
      "transliteration": "aan gavar keh sees jhukaavat ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆ ਕੇ ਗੌਰੀ ਨੂੰ ਸਿਰ ਨਿਵਾਉਾਂਦੇ ਸਨ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "आनि गवरि कह सीस झुकावत ॥३॥",
      "sourceLineId": "135874",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭੁਜਬਲ ਸਿੰਘ ਤਹਾ ਨ੍ਰਿਪ ਆਯੋ ॥",
      "transliteration": "bhujabal si(n)gh tahaa nirap aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਭੁਜਬਲ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "भुजबल सिंघ तहा नृप आयो ॥",
      "sourceLineId": "135875",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭੋਜ ਰਾਜ ਤੇ ਜਨੁਕ ਸਵਾਯੋ ॥",
      "transliteration": "bhoj raaj te januk savaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਮਾਨੋ ਭੋਜ ਰਾਜ ਤੋਂ ਵੀ ਸਵਾਈ ਪ੍ਰਭੁਤਾ ਵਾਲਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "भोज राज ते जनुक सवायो ॥",
      "sourceLineId": "135876",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਿਰਖਿ ਸਿੰਧੁਲਾ ਦੇ ਦੁਤਿ ਤਾ ਕੀ ॥",
      "transliteration": "nirakh si(n)dhulaa dhe dhut taa kee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ ਸਿੰਧੁਲਾ ਦੇਈ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "निरखि सिंधुला दे दुति ता की ॥",
      "sourceLineId": "135877",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਨ ਬਚ ਕ੍ਰਮ ਚੇਰੀ ਭੀ ਵਾ ਕੀ ॥੪॥",
      "transliteration": "man bach kram cheree bhee vaa kee ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਮਨ, ਬਚਨ ਅਤੇ ਕਰਮ ਕਰ ਕੇ ਦਾਸੀ ਹੋ ਗਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "मन बच क्रम चेरी भी वा की ॥४॥",
      "sourceLineId": "135878",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਗੇ ਹੁਤੀ ਔਰ ਸੋ ਪਰਨੀ ॥",
      "transliteration": "aage hutee aauar so paranee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪਹਿਲਾ ਕਿਸੇ ਹੋਰ ਨਾਲ ਵਿਆਹੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "आगे हुती और सो परनी ॥",
      "sourceLineId": "135879",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਬ ਇਹ ਸਾਥ ਜਾਤ ਨਹਿ ਬਰਨੀ ॥",
      "transliteration": "ab ieh saath jaat neh baranee ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਇਸ (ਰਾਜੇ) ਨਾਲ ਵਿਆਹੀ ਨਹੀਂ ਜਾ ਸਕਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "अब इह साथ जात नहि बरनी ॥",
      "sourceLineId": "135880",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚਿਤ ਮਹਿ ਅਧਿਕ ਬਿਚਾਰ ਬਿਚਾਰਤ ॥",
      "transliteration": "chit meh adhik bichaar bichaarat ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਚਿਤ ਵਿਚ ਅਧਿਕ ਵਿਚਾਰ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "चित महि अधिक बिचार बिचारत ॥",
      "sourceLineId": "135881",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਹਚਰਿ ਪਠੀ ਤਹਾ ਹ੍ਵੈ ਆਰਤਿ ॥੫॥",
      "transliteration": "sahachar paThee tahaa havai aarat ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਦੁਖੀ ਹੋ ਕੇ ਇਕ ਸਖੀ ਉਸ ਪਾਸ ਭੇਜੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "सहचरि पठी तहा ह्वै आरति ॥५॥",
      "sourceLineId": "135882",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਤੈ ਪਰ ਮੈ ਅਟਕੀ ॥",
      "transliteration": "sun raajaa tai par mai aTakee ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਹੇ ਰਾਜਨ! ਸੁਣੋ, ਮੈਂ ਤੁਹਾਡੇ ਉਤੇ ਮੋਹਿਤ ਹੋ ਗਈ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा तै पर मै अटकी ॥",
      "sourceLineId": "135883",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭੂਲਿ ਗਈ ਸਭ ਹੀ ਸੁਧਿ ਘਟ ਕੀ ॥",
      "transliteration": "bhool giee sabh hee sudh ghaT kee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਸ਼ਰੀਰ ਦੀ ਸਾਰੀ ਸੁੱਧ ਬੁੱਧ ਭੁਲ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "भूलि गई सभ ही सुधि घट की ॥",
      "sourceLineId": "135884",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜੌ ਮੁਹਿ ਅਬ ਤੁਮ ਦਰਸ ਦਿਖਾਵੋ ॥",
      "transliteration": "jau muh ab tum dharas dhikhaavo ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੁਸੀਂ ਮੈਨੂੰ ਆਪਣਾ ਦੀਦਾਰ ਕਰਾਓ (ਤਾ ਇੰਜ ਪ੍ਰਤੀਤ ਹੋਵੇਗਾ)",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "जौ मुहि अब तुम दरस दिखावो ॥",
      "sourceLineId": "135885",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਮ੍ਰਿਤ ਡਾਰਿ ਜਨੁ ਮ੍ਰਿਤਕ ਜਿਯਾਵੋ ॥੬॥",
      "transliteration": "amirat ddaar jan mritak jiyaavo ||6||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਅੰਮ੍ਰਿਤ ਛਿੜਕ ਕੇ ਮੁਰਦੇ ਨੂੰ ਜਿਵਾਇਆ ਹੋਵੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "अमृत डारि जनु मृतक जियावो ॥६॥",
      "sourceLineId": "135886",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਨਿ ਸਖੀ ਬਚਨ ਕੁਅਰਿ ਕੇ ਆਤੁਰ ॥",
      "transliteration": "sun sakhee bachan kuar ke aatur ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਮਾਰੀ ਦੇ ਦੁਖ ਭਰੇ ਬੋਲ ਸੁਣ ਕੇ ਸਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "सुनि सखी बचन कुअरि के आतुर ॥",
      "sourceLineId": "135887",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾਤ ਭਈ ਰਾਜਾ ਤਹਿ ਸਾਤਿਰ ॥",
      "transliteration": "jaat bhiee raajaa teh saatir ||",
      "translation": "",
      "punjabiViakhya": "ਜਲਦੀ ('ਸਾਤਿਰ') ਨਾਲ ਰਾਜੇ ਕੋਲ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "जात भई राजा तहि सातिर ॥",
      "sourceLineId": "135888",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੁ ਕਛੁ ਕਹਿਯੋ ਕਹਿ ਤਾਹਿ ਸੁਨਾਯੋ ॥",
      "transliteration": "j kachh kahiyo keh taeh sunaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕੁਝ (ਕੁਮਾਰੀ ਨੇ) ਕਿਹਾ ਸੀ, (ਉਹ) ਉਸ ਨੂੰ ਕਹਿ ਸੁਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "जु कछु कहियो कहि ताहि सुनायो ॥",
      "sourceLineId": "135889",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੁਨਿ ਬਚ ਭੂਪ ਅਧਿਕ ਲਲਚਾਯੋ ॥੭॥",
      "transliteration": "sun bach bhoop adhik lalachaayo ||7||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਸਖੀ ਦੇ) ਬਚਨ ਸੁਣ ਕੇ ਰਾਜਾ ਬਹੁਤ ਲਲਚਾਇਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "सुनि बच भूप अधिक ललचायो ॥७॥",
      "sourceLineId": "135890",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਿੰਤ ਕਰੀ ਕਿਹ ਬਿਧਿ ਤਹ ਜੈਯੈ ॥",
      "transliteration": "chi(n)t karee keh bidh teh jaiyai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਮਨ ਵਿਚ) ਸੋਚਿਆ ਕਿ ਉਥੇ ਕਿਸ ਤਰ੍ਰਹਾ ਜਾਇਆ ਜਾਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "चिंत करी किह बिधि तह जैयै ॥",
      "sourceLineId": "135891",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਿਹ ਛਲ ਸੌ ਤਾ ਕੌ ਹਰਿ ਲਯੈਯੈ ॥",
      "transliteration": "keh chhal sau taa kau har layaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸ ਛਲ ਨਾਲ ਉਸ ਨੂੰ ਕਢ ਕੇ ਲਿਆਂਦਾ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "किह छल सौ ता कौ हरि लयैयै ॥",
      "sourceLineId": "135892",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁਨਿ ਬਚ ਭੂਖਿ ਭੂਪ ਕੀ ਭਾਗੀ ॥",
      "transliteration": "sun bach bhookh bhoop kee bhaagee ||",
      "translation": "",
      "punjabiViakhya": "(ਸਖੀ ਦੇ) ਬੋਲ ਸੁਣ ਕੇ ਰਾਜੇ ਦੀ ਭੁਖ ਚਲੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "सुनि बच भूखि भूप की भागी ॥",
      "sourceLineId": "135893",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਬ ਤੇ ਅਧਿਕ ਚਟਪਟੀ ਲਾਗੀ ॥੮॥",
      "transliteration": "tab te adhik chaTapaTee laagee ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਦ ਤੋਂ ਬਹੁਤ ਕਾਹਲ ਹੋਣ ਲਗ ਗਈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "तब ते अधिक चटपटी लागी ॥८॥",
      "sourceLineId": "135894",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭੂਪ ਸਖੀ ਤਬ ਤਹੀ ਪਠਾਈ ॥",
      "transliteration": "bhoop sakhee tab tahee paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਸਖੀ ਨੂੰ ਉਥੇ (ਭੇਜਿਆ)",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "भूप सखी तब तही पठाई ॥",
      "sourceLineId": "135895",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਇਸਥਿਤ ਹੁਤੀ ਜਹਾ ਸੁਖਦਾਈ ॥",
      "transliteration": "eisathit hutee jahaa sukhadhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਉਹ ਸੁਖ ਦੇਣ ਵਾਲੀ ਪ੍ਰਿਯਾ ਬੈਠੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "इसथित हुती जहा सुखदाई ॥",
      "sourceLineId": "135896",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਹਾ ਚਰਿਤ ਕਛੁ ਤੁਮਹਿ ਬਨਾਵਹੁ ॥",
      "transliteration": "kahaa charit kachh tumeh banaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿ ਭੇਜਿਆ ਕਿ ਕੋਈ ਚਰਿਤ੍ਰ ਖੇਡ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "कहा चरित कछु तुमहि बनावहु ॥",
      "sourceLineId": "135897",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਿਹ ਛਲ ਸਦਨ ਹਮਾਰੇ ਆਵਹੁ ॥੯॥",
      "transliteration": "jeh chhal sadhan hamaare aavahu ||9||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਛਲ ਨਾਲ (ਤੂੰ) ਮੇਰੇ ਘਰ ਆ ਜਾਏਾਂ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "जिह छल सदन हमारे आवहु ॥९॥",
      "sourceLineId": "135898",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਏਕ ਢੋਲ ਤ੍ਰਿਯ ਕੋਰ ਮੰਗਾਵਾ ॥",
      "transliteration": "ek ddol tiray kor ma(n)gaavaa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਸੁਣ ਕੇ) ਇਸਤਰੀ ਨੇ ਇਕ ਅਣਲੱਗ ('ਕੋਰ') ਢੋਲ ਮੰਗਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "एक ढोल तृय कोर मंगावा ॥",
      "sourceLineId": "135899",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬੈਠਿ ਚਰਮ ਸੋ ਬੀਚ ਮੜਾਵਾ ॥",
      "transliteration": "baiTh charam so beech maRaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਿਚ ਬੈਠ ਕੇ ਚਮੜੇ ਨਾਲ ਮੜ੍ਰਹਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "बैठि चरम सो बीच मड़ावा ॥",
      "sourceLineId": "135900",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਇਸਥਿਤ ਆਪੁ ਤਵਨ ਮਹਿ ਭਈ ॥",
      "transliteration": "eisathit aap tavan meh bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਿਚ ਆਪ ਸਥਿਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "इसथित आपु तवन महि भई ॥",
      "sourceLineId": "135901",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਇਹ ਛਲ ਧਾਮ ਮਿਤ੍ਰ ਕੇ ਗਈ ॥੧੦॥",
      "transliteration": "eeh chhal dhaam mitr ke giee ||10||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਮਿਤਰ ਦੇ ਘਰ ਪਹੁੰਚ ਗਈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "इह छल धाम मित्र के गई ॥१०॥",
      "sourceLineId": "135902",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਇਹ ਛਲ ਢੋਲ ਬਜਾਵਤ ਚਲੀ ॥",
      "transliteration": "eeh chhal ddol bajaavat chalee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਢੋਲ ਵਜਾਉਾਂਦੀ ਹੋਈ ਉਹ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "इह छल ढोल बजावत चली ॥",
      "sourceLineId": "135903",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਸਭ ਨਿਰਖਤ ਅਲੀ ॥",
      "transliteration": "maat pitaa sabh nirakhat alee ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਤਾ ਪਿਤਾ ਅਤੇ ਸਖੀਆਂ ਵੇਖਦੀਆਂ ਰਹਿ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "मात पिता सभ निरखत अली ॥",
      "sourceLineId": "135904",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਭੇਵ ਅਭੇਵ ਨ ਕਿਨਹੂੰ ਪਾਯੋ ॥",
      "transliteration": "bhev abhev na kinahoo(n) paayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "भेव अभेव न किनहूँ पायो ॥",
      "sourceLineId": "135905",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਭ ਹੀ ਇਹ ਬਿਧਿ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥੧੧॥",
      "transliteration": "sabh hee ieh bidh moo(n)dd mu(n)ddaayo ||11||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਹੀ ਇਸ ਤਰ੍ਰਹਾ ਠਗੇ ਗਏ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "सभ ही इह बिधि मूँड मुँडायो ॥११॥",
      "sourceLineId": "135906",
      "sourceShabadId": "12641",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "135907",
      "sourceShabadId": "12642",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਤਨ ਚੰਚਲਾ ਗਈ ਮਿਤ੍ਰ ਕੇ ਧਾਮ ॥",
      "transliteration": "eeh charitr tan cha(n)chalaa giee mitr ke dhaam ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਉਹ ਇਸਤਰੀ ਮਿਤਰ ਦੇ ਘਰ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र तन चंचला गई मित्र के धाम ॥",
      "sourceLineId": "135908",
      "sourceShabadId": "12642",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਢੋਲ ਢਮਾਕੋ ਦੈ ਗਈ ਕਿਨਹੂੰ ਲਖਾ ਨ ਬਾਮ ॥੧੨॥",
      "transliteration": "ddol ddamaako dhai giee kinahoo(n) lakhaa na baam ||12||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ ਨੂੰ ਡਗੇ ਮਾਰ ਕੇ ਚਲੀ ਗਈ, ਕੋਈ ਵੀ (ਉਸ) ਇਸਤਰੀ ਨੂੰ ਵੇਖ ਨਾ ਸਕਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "ढोल ढमाको दै गई किनहूँ लखा न बाम ॥१२॥",
      "sourceLineId": "135909",
      "sourceShabadId": "12642",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚੌਵਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੪॥੬੫੧੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chauavan charitr samaapatam sat subham sat ||354||6515||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੫੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੫੪॥੬੫੧੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ चौवन चरित्र समापतम सतु सुभम सतु ॥३५४॥६५१५॥अफजूँ॥",
      "sourceLineId": "135910",
      "sourceShabadId": "12642",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135911",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਕਥਾ ਅਪੂਰਬ ॥",
      "transliteration": "sun raajaa ik kathaa apoorab ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਅਦੁੱਤੀ ਕਥਾ ਸੁਣੋ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा इक कथा अपूरब ॥",
      "sourceLineId": "135912",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਜੋ ਛਲ ਕਿਯਾ ਸੁਤਾ ਨ੍ਰਿਪ ਪੂਰਬ ॥",
      "transliteration": "jo chhal kiyaa sutaa nirap poorab ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਛਲ ਪਹਿਲਾ ਕਦੇ ਰਾਜੇ ਦੀ ਪੁੱਤਰੀ ਨੇ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "जो छल किया सुता नृप पूरब ॥",
      "sourceLineId": "135913",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਭੁਜੰਗ ਧੁਜਾ ਇਕ ਭੂਪ ਕਹਾਵਤ ॥",
      "transliteration": "bhuja(n)g dhujaa ik bhoop kahaavat ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਰਾਜਾ ਭੁਜੰਗ ਧੁਜਾ ਨਾ ਨਾਲ ਜਾਣਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "भुजंग धुजा इक भूप कहावत ॥",
      "sourceLineId": "135914",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਅਮਿਤ ਦਰਬ ਬਿਪਨ ਪਹ ਦ੍ਰਯਾਵਤ ॥੧॥",
      "transliteration": "amit dharab bipan peh dhrayaavat ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਬਹੁਤ ਧਨ ਦਾਨ ਦਿੰਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "अमित दरब बिपन पह द्रयावत ॥१॥",
      "sourceLineId": "135915",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਅਜਿਤਾਵਤੀ ਨਗਰ ਤਿਹ ਰਾਜਤ ॥",
      "transliteration": "ajitaavatee nagar teh raajat ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਅਜਿਤਾਵਤੀ ਨਗਰੀ ਵਿਚ ਰਹਿੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "अजितावती नगर तिह राजत ॥",
      "sourceLineId": "135916",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਅਮਰਾਵਤੀ ਨਿਰਖਿ ਜਿਹ ਲਾਜਤ ॥",
      "transliteration": "amaraavatee nirakh jeh laajat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਇੰਦਰਪੁਰੀ ਵੀ ਸ਼ਰਮਾਉਾਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "अमरावती निरखि जिह लाजत ॥",
      "sourceLineId": "135917",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਬਿਮਲ ਮਤੀ ਤਾ ਕੇ ਗ੍ਰਿਹ ਰਾਨੀ ॥",
      "transliteration": "bimal matee taa ke gireh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਬਿਮਲ ਮਤੀ ਨਾ ਦੀ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "बिमल मती ता के गृह रानी ॥",
      "sourceLineId": "135918",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸੁਤਾ ਬਿਲਾਸ ਦੇਇ ਪਹਿਚਾਨੀ ॥੨॥",
      "transliteration": "sutaa bilaas dhei pahichaanee ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪੁੱਤਰੀ ਬਿਲਾਸ ਦੇਈ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "सुता बिलास देइ पहिचानी ॥२॥",
      "sourceLineId": "135919",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਮੰਤ੍ਰ ਜੰਤ੍ਰ ਤਿਨ ਪੜੇ ਅਪਾਰਾ ॥",
      "transliteration": "ma(n)tr ja(n)tr tin paRe apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮੰਤ੍ਰ ਜੰਤ੍ਰ ਬਹੁਤ ਅਧਿਕ ਪੜ੍ਰਹੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "मंत्र जंत्र तिन पड़े अपारा ॥",
      "sourceLineId": "135920",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਜਿਹ ਸਮ ਪੜੇ ਨ ਦੂਸਰਿ ਨਾਰਾ ॥",
      "transliteration": "jeh sam paRe na dhoosar naaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੇ ਕਿਸੇ ਹੋਰ ਇਸਤਰੀ ਨੇ ਨਹੀਂ ਪੜ੍ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1306,
      "hindi": "",
      "hindiTransliteration": "जिह सम पड़े न दूसरि नारा ॥",
      "sourceLineId": "135921",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1306_line_0072",
      "lineIndex": 72,
