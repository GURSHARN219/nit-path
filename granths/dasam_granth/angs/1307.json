{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1307,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1307_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਹੀ ਹੁਤੀ ਤਿਨ ਕੀ ਰਾਜਧਾਨੀ ॥੩॥",
      "transliteration": "tahee hutee tin kee raajadhaanee ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਉਸ ਦੀ ਰਾਜਧਾਨੀ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "तही हुती तिन की राजधानी ॥३॥",
      "sourceLineId": "135923",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਿਰਖਿ ਪ੍ਰਭਾ ਤਿਹ ਜਾਤ ਨ ਕਹੀ ॥",
      "transliteration": "nirakh prabhaa teh jaat na kahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਨਗਰੀ) ਦੀ ਪ੍ਰਭਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "निरखि प्रभा तिह जात न कही ॥",
      "sourceLineId": "135924",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਜਧਾਨੀ ਐਸੀ ਤਿਹ ਅਹੀ ॥",
      "transliteration": "rajadhaanee aaisee teh ahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਅਜਿਹੀ ਰਾਜਧਾਨੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "रजधानी ऐसी तिह अही ॥",
      "sourceLineId": "135925",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਊਚ ਧੌਲਹਰ ਤਹਾ ਸੁਧਾਰੇ ॥",
      "transliteration": "uooch dhaualahar tahaa sudhaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਇਤਨੇ) ਉੱਚੇ ਮਹੱਲ ਬਣੇ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "ऊच धौलहर तहा सुधारे ॥",
      "sourceLineId": "135926",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਨ ਪਰ ਬੈਠਿ ਪਕਰਿਯਤ ਤਾਰੇ ॥੪॥",
      "transliteration": "jin par baiTh pakariyat taare ||4||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਉਤੇ ਬੈਠ ਕੇ ਤਾਰੇ ਵੀ ਪਕੜੇ ਜਾ ਸਕਦੇ ਸਨ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "जिन पर बैठि पकरियत तारे ॥४॥",
      "sourceLineId": "135927",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਜਨ ਹੇਤ ਤਹਾ ਨ੍ਰਿਪ ਆਵਤ ॥",
      "transliteration": "majan het tahaa nirap aavat ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਸ਼ਨਾਨ ਕਰਨ ਲਈ ਰਾਜਾ ਆਉਾਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "मजन हेत तहा नृप आवत ॥",
      "sourceLineId": "135928",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਇ ਪੂਰਬਲੇ ਪਾਪ ਗਵਾਵਤ ॥",
      "transliteration": "nai poorabale paap gavaavat ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ਼ਨਾਨ ਕਰ ਕੇ (ਉਹ) ਆਪਣੇ ਪਿਛਲੇ ਪਾਪਾ ਨੂੰ ਖ਼ਤਮ ਕਰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "नाइ पूरबले पाप गवावत ॥",
      "sourceLineId": "135929",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਹ ਇਕ ਨ੍ਰਹਾਨ ਨਰਾਧਿਪ ਚਲੋ ॥",
      "transliteration": "teh ik nrahaan naraadhip chalo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਰਾਜਾ ਇਸ਼ਨਾਨ ਕਰਨ ਆਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "तह इक न्रहान नराधिप चलो ॥",
      "sourceLineId": "135930",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੋਬਨਵਾਨ ਸਿਪਾਹੀ ਭਲੋ ॥੫॥",
      "transliteration": "jobanavaan sipaahee bhalo ||5||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜਵਾਨ ਅਤੇ ਚੰਗਾ ਸਿਪਾਹੀ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "जोबनवान सिपाही भलो ॥५॥",
      "sourceLineId": "135931",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੋ ਬਿਲਾਸ ਦੇ ਨੈਨ ਨਿਹਾਰਾ ॥",
      "transliteration": "so bilaas dhe nain nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬਿਲਾਸ ਦੇਈ ਨੇ ਅੱਖਾ ਨਾਲ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "सो बिलास दे नैन निहारा ॥",
      "sourceLineId": "135932",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਨ ਕ੍ਰਮ ਬਚ ਇਹ ਭਾਤਿ ਬਿਚਾਰਾ ॥",
      "transliteration": "man kram bach ieh bhaat bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਨ, ਬਚ, ਕਰਮ ਕਰ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਸੋਚਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "मन क्रम बच इह भाति बिचारा ॥",
      "sourceLineId": "135933",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕੈ ਮੈ ਅਬ ਯਾਹੀ ਕਹ ਬਰਿਹੌ ॥",
      "transliteration": "kai mai ab yaahee keh barihau ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਤਾ ਮੈਂ ਇਸ ਨੂੰ ਹੁਣੇ ਵਰਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "कै मै अब याही कह बरिहौ ॥",
      "sourceLineId": "135934",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਤਰ ਬੂਡਿ ਗੰਗ ਮਹਿ ਮਰਿਹੌ ॥੬॥",
      "transliteration": "naatar boodd ga(n)g meh marihau ||6||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਗੰਗਾ ਵਿਚ ਡੁਬ ਮਰਾਗੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "नातर बूडि गंग महि मरिहौ ॥६॥",
      "sourceLineId": "135935",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਕ ਸਖੀ ਲਖਿ ਹਿਤੂ ਸਿਯਾਨੀ ॥",
      "transliteration": "ek sakhee lakh hitoo siyaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਹਿਤੂ ਅਤੇ ਸਿਆਣੀ ਸਖੀ ਨੂੰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "एक सखी लखि हितू सियानी ॥",
      "sourceLineId": "135936",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਾ ਸੌ ਚਿਤ ਕੀ ਬਾਤ ਬਖਾਨੀ ॥",
      "transliteration": "taa sau chit kee baat bakhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਆਪਣੇ ਚਿਤ ਦੀ ਗੱਲ ਸਾਝੀ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "ता सौ चित की बात बखानी ॥",
      "sourceLineId": "135937",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੋ ਤਾ ਕੌ ਤੂੰ ਮੁਝੈ ਮਿਲਾਵੈ ॥",
      "transliteration": "jo taa kau too(n) mujhai milaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੂੰ ਉਸ ਨੂੰ ਮੈਨੂੰ ਮਿਲਾ ਦੇਏਾਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "जो ता कौ तूँ मुझै मिलावै ॥",
      "sourceLineId": "135938",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੁਖ ਮਾਗੈ ਜੇਤੋ ਧਨ ਪਾਵੈ ॥੭॥",
      "transliteration": "mukh maagai jeto dhan paavai ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੂੰਹ ਮੰਗਿਆ ਧਨ ਪ੍ਰਾਪਤ ਕਰ ਲਏਾਂ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "मुख मागै जेतो धन पावै ॥७॥",
      "sourceLineId": "135939",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਬ ਸਖਿ ਗਈ ਤਵਨ ਕੇ ਗ੍ਰੇਹਾ ॥",
      "transliteration": "tab sakh giee tavan ke grehaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਹ) ਸਖੀ ਉਸ ਦੇ ਘਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "तब सखि गई तवन के ग्रेहा ॥",
      "sourceLineId": "135940",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪਰ ਪਾਇਨ ਅਸਿ ਦਿਯੋ ਸੰਦੇਹਾ ॥",
      "transliteration": "par pain as dhiyo sa(n)dhehaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੈਰੀਂ ਪੈ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਨੇਹਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "पर पाइन असि दियो संदेहा ॥",
      "sourceLineId": "135941",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਤੁਮਰੈ ਪਰ ਅਟਕੀ ॥",
      "transliteration": "raaj sutaa tumarai par aTakee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਜ ਕੁਮਾਰੀ ਤੇਰੇ ਉਤੇ ਮੋਹਿਤ ਹੋ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "राज सुता तुमरै पर अटकी ॥",
      "sourceLineId": "135942",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੂਲਿ ਗਈ ਤਾ ਕਹਿ ਸੁਧਿ ਘਟ ਕੀ ॥੮॥",
      "transliteration": "bhool giee taa keh sudh ghaT kee ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਆਪਣੇ ਸ਼ਰੀਰ ਦੀ ਸੁੱਧ ਵੀ ਭੁਲ ਗਈ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "भूलि गई ता कहि सुधि घट की ॥८॥",
      "sourceLineId": "135943",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੁਨਿ ਨ੍ਰਿਪ ਬਚਨ ਭਯੋ ਬਿਸਮੈ ਮਨ ॥",
      "transliteration": "sun nirap bachan bhayo bisamai man ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਮਨ ਵਿਚ ਹੈਰਾਨ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "सुनि नृप बचन भयो बिसमै मन ॥",
      "sourceLineId": "135944",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਤਾਹਿ ਬਖਾਨੇ ਬੈਨਨ ॥",
      "transliteration": "eeh bidh taeh bakhaane bainan ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਨੂੰ ਕਹਿਣ ਲਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "इह बिधि ताहि बखाने बैनन ॥",
      "sourceLineId": "135945",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਸ ਕਿਛੁ ਕਰਿਯੈ ਬਚਨ ਸ੍ਯਾਨੀ ॥",
      "transliteration": "as kichh kariyai bachan sayaanee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸਿਆਣੀਏ! ਕੁਝ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਉਪਾ ਕਰੀਏ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "अस किछु करियै बचन स्यानी ॥",
      "sourceLineId": "135946",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸ੍ਰੀ ਬਿਲਾਸ ਦੇ ਹ੍ਵੈ ਮੁਰ ਰਾਨੀ ॥੯॥",
      "transliteration": "sree bilaas dhe havai mur raanee ||9||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਬਿਲਾਸ ਦੇਈ ਮੇਰੀ ਰਾਣੀ ਬਣ ਜਾਵੇ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "स्री बिलास दे ह्वै मुर रानी ॥९॥",
      "sourceLineId": "135947",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤੁਮ ਨ੍ਰਿਪ ਭੇਸ ਨਾਰਿ ਕੋ ਧਾਰਹੁ ॥",
      "transliteration": "tum nirap bhes naar ko dhaarahu ||",
      "translation": "",
      "punjabiViakhya": "(ਸਖੀ ਨੇ ਕਿਹਾ) ਹੇ ਰਾਜਨ! ਤੁਸੀਂ ਇਸਤਰੀ ਦਾ ਭੇਸ ਧਾਰਨ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "तुम नृप भेस नारि को धारहु ॥",
      "sourceLineId": "135948",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭੂਖਨ ਬਸਤਰ ਅੰਗ ਸੁਧਾਰਹੁ ॥",
      "transliteration": "bhookhan basatar a(n)g sudhaarahu ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਰੀਰ ਉਤੇ ਗਹਿਣੇ ਅਤੇ ਬਸਤ੍ਰ ਧਾਰਨ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "भूखन बसतर अंग सुधारहु ॥",
      "sourceLineId": "135949",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭੁਜੰਗ ਧੁਜ ਕਹ ਦੈ ਦਿਖਰਾਈ ॥",
      "transliteration": "bhuja(n)g dhuj keh dhai dhikharaiee ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਧੁਜ ਨੂੰ (ਇਕ ਵਾਰ) ਵਿਖਾਲੀ ਦੇ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "भुजंग धुज कह दै दिखराई ॥",
      "sourceLineId": "135950",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਫੁਨਿ ਅੰਗਨਾ ਮਹਿ ਜਾਹੁ ਛਪਾਈ ॥੧੦॥",
      "transliteration": "fun a(n)ganaa meh jaahu chhapaiee ||10||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਵੇਹੜੇ ਵਿਚ ਛੁਪ ਜਾਣਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "फुनि अंगना महि जाहु छपाई ॥१०॥",
      "sourceLineId": "135951",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭੂਪਤਿ ਬਸਤ੍ਰ ਨਾਰਿ ਕੇ ਧਾਰੇ ॥",
      "transliteration": "bhoopat basatr naar ke dhaare ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਇਸਤਰੀ ਦੇ ਬਸਤ੍ਰ ਧਾਰਨ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "भूपति बसत्र नारि के धारे ॥",
      "sourceLineId": "135952",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅੰਗ ਅੰਗ ਗਹਿਨਾ ਗੁਹਿ ਡਾਰੇ ॥",
      "transliteration": "a(n)g a(n)g gahinaa guh ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੰਗ ਅੰਗ ਉਤੇ ਗਹਿਣੇ ਪਾ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "अंग अंग गहिना गुहि डारे ॥",
      "sourceLineId": "135953",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭੁਜੰਗ ਧੁਜ ਕਹ ਦਈ ਦਿਖਾਈ ॥",
      "transliteration": "bhuja(n)g dhuj keh dhiee dhikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਧੁਜਾ ਨੂੰ ਵਿਖਾਲੀ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "भुजंग धुज कह दई दिखाई ॥",
      "sourceLineId": "135954",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਿਜੁ ਅੰਗਨਾ ਮਹਿ ਗਯੋ ਲੁਕਾਈ ॥੧੧॥",
      "transliteration": "nij a(n)ganaa meh gayo lukaiee ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਵੇਹੜੇ ਵਿਚ ਲੁਕ ਗਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "निजु अंगना महि गयो लुकाई ॥११॥",
      "sourceLineId": "135955",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਿਰਖਿ ਭੂਪ ਤਿਹ ਰਹਾ ਲੁਭਾਇ ॥",
      "transliteration": "nirakh bhoop teh rahaa lubhai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਉਸ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ ਲਲਚਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "निरखि भूप तिह रहा लुभाइ ॥",
      "sourceLineId": "135956",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਵਹੈ ਸਖੀ ਤਹ ਦੇਇ ਪਠਾਇ ॥",
      "transliteration": "vahai sakhee teh dhei paThai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਸਖੀ ਨੂੰ ਉਥੇ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "वहै सखी तह देइ पठाइ ॥",
      "sourceLineId": "135957",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰਿਥਮੇ ਨਿਰਖਿ ਤਾਹਿ ਤੁਮ ਆਵਹੋ ॥",
      "transliteration": "pirathame nirakh taeh tum aavaho ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਪਹਿਲਾ ਤੂੰ ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਆ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "पृथमे निरखि ताहि तुम आवहो ॥",
      "sourceLineId": "135958",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਹੁਰਿ ਬਿਯਾਹ ਕੋ ਬ੍ਯੋਤ ਬਨਾਵਹੁ ॥੧੨॥",
      "transliteration": "bahur biyaeh ko bayot banaavahu ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਵਿਆਹ ਦੀ ਵਿਉਾਂਤ ਬਣਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "बहुरि बियाह को ब्योत बनावहु ॥१२॥",
      "sourceLineId": "135959",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਸਹਚਰਿ ਤਹ ਗਈ ॥",
      "transliteration": "sunat bachan sahachar teh giee ||",
      "translation": "",
      "punjabiViakhya": "ਬਚਨ ਸੁਣ ਕੇ ਸਖੀ ਉਥੇ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन सहचरि तह गई ॥",
      "sourceLineId": "135960",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਟਾਰਿ ਘਰੀ ਦ੍ਵੈ ਆਵਤ ਭਈ ॥",
      "transliteration": "Taar gharee dhavai aavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋ ਘੜੀਆਂ ਟਾਲ ਕੇ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "टारि घरी द्वै आवत भई ॥",
      "sourceLineId": "135961",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਿਹ ਮੁਖ ਤੇ ਹ੍ਵੈ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "teh mukh te havai bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਉਸ ਵਲੋਂ ਹੋ ਕੇ ਬੋਲ ਕਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "तिह मुख ते ह्वै बचन उचारे ॥",
      "sourceLineId": "135962",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੁਨਹੁ ਸ੍ਰਵਨ ਦੈ ਭੂਪ ਹਮਾਰੇ ॥੧੩॥",
      "transliteration": "sunahu sravan dhai bhoop hamaare ||13||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਕੰਨ ਦੇ ਕੇ ਮੇਰੀ (ਗੱਲ) ਸੁਣੋ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "सुनहु स्रवन दै भूप हमारे ॥१३॥",
      "sourceLineId": "135963",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪ੍ਰਥਮ ਸੁਤਾ ਅਪਨੀ ਤਿਹ ਦੀਜੈ ॥",
      "transliteration": "pratham sutaa apanee teh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਆਪਣੀ ਧੀ ਉਸ ਨਾਲ ਵਿਆਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "प्रथम सुता अपनी तिह दीजै ॥",
      "sourceLineId": "135964",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਹੁਰੌ ਬਹਿਨਿ ਤਵਨ ਕੀ ਲੀਜੈ ॥",
      "transliteration": "bahurau bahin tavan kee leejai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਦੀ ਭੈਣ (ਪਤਨੀ ਵਜੋਂ) ਪ੍ਰਾਪਤ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "बहुरौ बहिनि तवन की लीजै ॥",
      "sourceLineId": "135965",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੁਨਤ ਬੈਨ ਨ੍ਰਿਪ ਫੇਰ ਨ ਕੀਨੋ ॥",
      "transliteration": "sunat bain nirap fer na keeno ||",
      "translation": "",
      "punjabiViakhya": "ਗੱਲ ਸੁਣਦਿਆਂ ਹੀ ਰਾਜੇ ਨੇ ਢਿਲ ਨਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "सुनत बैन नृप फेर न कीनो ॥",
      "sourceLineId": "135966",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦੁਹਿਤਹਿ ਕਾਢਿ ਤਵਨ ਕਹ ਦੀਨੋ ॥੧੪॥",
      "transliteration": "dhuhiteh kaadd tavan keh dheeno ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੁੱਤਰੀ ਕਢ ਕੇ ਉਸ ਨੂੰ ਦੇ ਦਿੱਤੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "दुहितहि काढि तवन कह दीनो ॥१४॥",
      "sourceLineId": "135967",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੁਤਾ ਪ੍ਰਥਮ ਦੈ ਬ੍ਯਾਹ ਰਚਾਯੋ ॥",
      "transliteration": "sutaa pratham dhai bayaeh rachaayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਪੁੱਤਰੀ ਦੇ ਕੇ ਵਿਆਹ ਰਚਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "सुता प्रथम दै ब्याह रचायो ॥",
      "sourceLineId": "135968",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੌ ਬ੍ਯਾਹ ਨਾਰਿ ਕਰ ਲ੍ਯਾਯੋ ॥",
      "transliteration": "nirap kau bayaeh naar kar layaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨਾਲ ਵਿਆਹ ਕਰ ਕੇ ਉਸ ਨੂੰ ਇਸਤਰੀ ਬਣਾ ਕੇ ਲੈ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "नृप कौ ब्याह नारि कर ल्यायो ॥",
      "sourceLineId": "135969",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1307_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਬ ਤਿਨ ਬਧਿ ਤਿਹ ਜੜ ਕੋ ਕਿਯੋ ॥",
      "transliteration": "tab tin badh teh jaR ko kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੇ ਉਸ ਮੂਰਖ ਦਾ ਕਤਲ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1307,
      "hindi": "",
      "hindiTransliteration": "तब तिन बधि तिह जड़ को कियो ॥",
      "sourceLineId": "135970",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
