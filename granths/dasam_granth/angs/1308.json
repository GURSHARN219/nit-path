{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1308,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1308_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੁਹਿਤਾ ਸਹਿਤ ਰਾਜ ਹਰ ਲਿਯੋ ॥੧੫॥",
      "transliteration": "dhuhitaa sahit raaj har liyo ||15||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੁੱਤਰੀ ਸਮੇਤ ਉਸ ਦਾ ਰਾਜ ਹਰ ਲਿਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "दुहिता सहित राज हर लियो ॥१५॥",
      "sourceLineId": "135971",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪ੍ਰਥਮ ਸੁਤਾ ਰਾਜਾ ਕੀ ਹਰੀ ॥",
      "transliteration": "pratham sutaa raajaa kee haree ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਰਾਜੇ ਦੀ ਧੀ ਨੂੰ ਹਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "प्रथम सुता राजा की हरी ॥",
      "sourceLineId": "135972",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਹੁਰਿ ਨਾਸ ਤਿਹ ਤਨ ਕੀ ਕਰੀ ॥",
      "transliteration": "bahur naas teh tan kee karee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਦੇ ਸ਼ਰੀਰ ਦਾ ਨਾਸ਼ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "बहुरि नास तिह तन की करी ॥",
      "sourceLineId": "135973",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਹੁਰੌ ਛੀਨਿ ਰਾਜ ਤਿਨ ਲੀਨਾ ॥",
      "transliteration": "bahurau chheen raaj tin leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਦਾ ਰਾਜ ਖੋਹ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "बहुरौ छीनि राज तिन लीना ॥",
      "sourceLineId": "135974",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਰਿ ਬਿਲਾਸ ਦੇਈ ਕਹ ਕੀਨਾ ॥੧੬॥",
      "transliteration": "bar bilaas dheiee keh keenaa ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਿਲਾਸ ਦੇਈ ਨੂੰ ਵਿਆਹ ਲਿਆ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "बरि बिलास देई कह कीना ॥१६॥",
      "sourceLineId": "135975",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪਚਪਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੫॥੬੫੩੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau pachapan charitr samaapatam sat subham sat ||355||6531||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੫੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੫੫॥੬੫੩੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ पचपन चरित्र समापतम सतु सुभम सतु ॥३५५॥६५३१॥अफजूँ॥",
      "sourceLineId": "135976",
      "sourceShabadId": "12643",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "135977",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁਨੁ ਨ੍ਰਿਪ ਕਥਾ ਬਖਾਨੈ ਔਰੈ ॥",
      "transliteration": "sun nirap kathaa bakhaanai aauarai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਸੁਣੋ, (ਮੈਂ ਇਕ) ਹੋਰ ਕਥਾ ਬਖਾਨ ਕਰਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "सुनु नृप कथा बखानै औरै ॥",
      "sourceLineId": "135978",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੋ ਭਈ ਏਕ ਰਾਜ ਕੀ ਠੌਰੈ ॥",
      "transliteration": "jo bhiee ek raaj kee Thauarai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਕ ਰਾਜੇ ਦੇ ਘਰ ਵਿਚ ਵਾਪਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "जो भई एक राज की ठौरै ॥",
      "sourceLineId": "135979",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਹਿਰ ਸੁ ਨਾਰ ਗਾਵ ਹੈ ਜਹਾ ॥",
      "transliteration": "sahir su naar gaav hai jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ 'ਨਾਰ ਗਾਵ' ਨਾ ਦਾ ਸ਼ਹਿਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "सहिर सु नार गाव है जहा ॥",
      "sourceLineId": "135980",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਬਲ ਸਿੰਘ ਰਾਜਾ ਇਕ ਤਹਾ ॥੧॥",
      "transliteration": "sabal si(n)gh raajaa ik tahaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸਬਲ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "सबल सिंघ राजा इक तहा ॥१॥",
      "sourceLineId": "135981",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦਲ ਥੰਭਨ ਦੇਈ ਤਿਹ ਨਾਰਿ ॥",
      "transliteration": "dhal tha(n)bhan dheiee teh naar ||",
      "translation": "",
      "punjabiViakhya": "ਦਲ ਥੰਭਨ ਦੇਈ ਨਾ ਦੀ ਉਸ ਦੀ ਪਤਨੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "दल थंभन देई तिह नारि ॥",
      "sourceLineId": "135982",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੰਤ੍ਰ ਮੰਤ੍ਰ ਜਿਹ ਪੜੇ ਸੁਧਾਰਿ ॥",
      "transliteration": "ja(n)tr ma(n)tr jeh paRe sudhaar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ (ਸਭ) ਜੰਤ੍ਰ ਮੰਤ੍ਰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਪੜ੍ਰਹੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "जंत्र मंत्र जिह पड़े सुधारि ॥",
      "sourceLineId": "135983",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜੋਗੀ ਇਕ ਸੁੰਦਰ ਤਹ ਆਯੋ ॥",
      "transliteration": "jogee ik su(n)dhar teh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸੁੰਦਰ ਜੋਗੀ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "जोगी इक सुँदर तह आयो ॥",
      "sourceLineId": "135984",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਹ ਸਮ ਸੁੰਦਰ ਬਿਧ ਨ ਬਨਾਯੋ ॥੨॥",
      "transliteration": "jeh sam su(n)dhar bidh na banaayo ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਸੁੰਦਰ ਵਿਧਾਤਾ ਨੇ (ਹੋਰ ਕੋਈ) ਨਹੀਂ ਬਣਾਇਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "जिह सम सुँदर बिध न बनायो ॥२॥",
      "sourceLineId": "135985",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਾਨੀ ਨਿਰਖਿ ਰੀਝਿ ਤਿਹ ਰਹੀ ॥",
      "transliteration": "raanee nirakh reejh teh rahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਰਾਣੀ ਮੋਹਿਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "रानी निरखि रीझि तिह रही ॥",
      "sourceLineId": "135986",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਨ ਬਚ ਕ੍ਰਮ ਐਸੀ ਬਿਧਿ ਕਹੀ ॥",
      "transliteration": "man bach kram aaisee bidh kahee ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ, ਬਚਨ ਅਤੇ ਕਰਮ ਕਰ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "मन बच क्रम ऐसी बिधि कही ॥",
      "sourceLineId": "135987",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਹ ਚਰਿਤ੍ਰ ਜੁਗਿਯਾ ਕਹ ਪੈਯੈ ॥",
      "transliteration": "jeh charitr jugiyaa keh paiyai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਿਸ ਚਰਿਤ੍ਰ ਨਾਲ ਜੋਗੀ ਨੂੰ ਪ੍ਰਾਪਤ ਕੀਤਾ ਜਾ ਸਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "जिह चरित्र जुगिया कह पैयै ॥",
      "sourceLineId": "135988",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਉਸੀ ਚਰਿਤ੍ਰ ਕੌ ਆਜੁ ਬਨੈਯੈ ॥੩॥",
      "transliteration": "ausee charitr kau aaj banaiyai ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਹੋ ਜਿਹਾ ਚਰਿਤ੍ਰ ਹੀ ਅਜ ਖੇਡਿਆ ਜਾਏ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "उसी चरित्र कौ आजु बनैयै ॥३॥",
      "sourceLineId": "135989",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬ੍ਰਿਸਟਿ ਬਿਨਾ ਬਦਰਾ ਗਰਜਾਏ ॥",
      "transliteration": "birasaT binaa badharaa garajaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮੰਤ੍ਰਾ ਦੀ ਸ਼ਕਤੀ ਨਾਲ ਮੀਂਹ ਤੋਂ ਬਿਨਾ ਬਦਲਾ ਨੂੰ ਗਰਜਵਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "बृसटि बिना बदरा गरजाए ॥",
      "sourceLineId": "135990",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮੰਤ੍ਰ ਸਕਤਿ ਅੰਗਰਾ ਬਰਖਾਏ ॥",
      "transliteration": "ma(n)tr sakat a(n)garaa barakhaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੰਗਾਰਿਆਂ ਦੀ ਬਰਖਾ ਕਰਵਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "मंत्र सकति अंगरा बरखाए ॥",
      "sourceLineId": "135991",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸ੍ਰੋਨ ਅਸਥਿ ਪ੍ਰਿਥਮੀ ਪਰ ਪਰੈ ॥",
      "transliteration": "sron asath pirathamee par parai ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਅਤੇ ਅਸਥੀਆਂ ਪ੍ਰਿਥਵੀ ਉਤੇ ਡਿਗਣ ਲਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "स्रोन असथि पृथमी पर परै ॥",
      "sourceLineId": "135992",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਿਰਖਿ ਲੋਗ ਸਭ ਹੀ ਜਿਯ ਡਰੈ ॥੪॥",
      "transliteration": "nirakh log sabh hee jiy ddarai ||4||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਵੇਖ ਕੇ ਸਾਰੇ ਲੋਕ ਮਨ ਵਿਚ ਬਹੁਤ ਡਰ ਗਏ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "निरखि लोग सभ ही जिय डरै ॥४॥",
      "sourceLineId": "135993",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭੂਪ ਮੰਤ੍ਰਿਯਨ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "transliteration": "bhoop ma(n)tirayan bol paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਮੰਤ੍ਰੀਆਂ ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "भूप मंतृयन बोलि पठायो ॥",
      "sourceLineId": "135994",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬੋਲਿ ਬਿਪ੍ਰ ਪੁਸਤਕਨ ਦਿਖਾਯੋ ॥",
      "transliteration": "bol bipr pusatakan dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਕਹਿ ਕੇ ਪੁਸਤਕਾ ਨੂੰ ਵਿਖਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "बोलि बिप्र पुसतकन दिखायो ॥",
      "sourceLineId": "135995",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਨ ਬਿਘਨਨ ਕੋ ਕਹ ਉਪਚਾਰਾ ॥",
      "transliteration": "ein bighanan ko keh upachaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ ਉਨ੍ਰਹਾ ਨੂੰ ਸੰਬੋਧਿਤ ਹੋ ਕੇ ਕਹਿਣ ਲਗਾ ਕਿ) ਤੁਸੀਂ ਸਾਰੇ ਮਿਲ ਕੇ ਵਿਚਾਰ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "इन बिघनन को कह उपचारा ॥",
      "sourceLineId": "135996",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੁਮ ਸਭ ਹੀ ਮਿਲਿ ਕਰਹੁ ਬਿਚਾਰਾ ॥੫॥",
      "transliteration": "tum sabh hee mil karahu bichaaraa ||5||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਦਸੋ ਕਿ) ਇਨ੍ਰਹਾ ਵਿਘਨਾ ਦਾ ਕੀ ਉਪਾ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "तुम सभ ही मिलि करहु बिचारा ॥५॥",
      "sourceLineId": "135997",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਬ ਲਗਿ ਬੀਰ ਹਾਕਿ ਤਿਹ ਰਾਨੀ ॥",
      "transliteration": "tab lag beer haak teh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਰਾਣੀ ਨੇ (ਬਵੰਜਾ ਬੀਰਾ ਵਿਚੋਂ) ਇਕ ਬੀਰ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "तब लगि बीर हाकि तिह रानी ॥",
      "sourceLineId": "135998",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸੌ ਕਹਵਾਈ ਬਾਨੀ ॥",
      "transliteration": "eeh bidh sau kahavaiee baanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਤੋਂ) ਇਸ ਤਰ੍ਰਹਾ ਦੀ ਆਕਾਸ਼ ਬਾਣੀ ਕਰਵਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "इह बिधि सौ कहवाई बानी ॥",
      "sourceLineId": "135999",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਏਕ ਕਾਜ ਉਬਰੇ ਜੋ ਕਰੈ ॥",
      "transliteration": "ek kaaj ubare jo karai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜੇ (ਰਾਜਾ) ਇਕ ਕੰਮ ਕਰੇ, ਤਾ (ਇਸ ਸੰਕਟ ਤੋਂ) ਬਚ ਸਕਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "एक काज उबरे जो करै ॥",
      "sourceLineId": "136000",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾਤਰ ਪ੍ਰਜਾ ਸਹਿਤ ਨ੍ਰਿਪ ਮਰੈ ॥੬॥",
      "transliteration": "naatar prajaa sahit nirap marai ||6||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਪ੍ਰਜਾ ਸਮੇਤ ਰਾਜਾ ਮਰ ਜਾਵੇਗਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "नातर प्रजा सहित नृप मरै ॥६॥",
      "sourceLineId": "136001",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਭਹਿਨ ਲਖੀ ਗਗਨ ਕੀ ਬਾਨੀ ॥",
      "transliteration": "sabhahin lakhee gagan kee baanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੇ ਉਸ ਨੂੰ ਆਕਾਸ਼ ਬਾਣੀ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "सभहिन लखी गगन की बानी ॥",
      "sourceLineId": "136002",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬੀਰ ਬਾਕ੍ਰਯ ਕਿਨਹੂੰ ਨ ਪਛਾਨੀ ॥",
      "transliteration": "beer baakray kinahoo(n) na pachhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਨੇ ਵੀ 'ਬੀਰ' ਦੇ ਬੋਲ ਵਜੋਂ ਨਾ ਪਛਾਣਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "बीर बाक्रय किनहूँ न पछानी ॥",
      "sourceLineId": "136003",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਹੁਰਿ ਬੀਰ ਤਿਨ ਐਸ ਉਚਾਰੋ ॥",
      "transliteration": "bahur beer tin aais uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਬੀਰ ਨੇ ਉਨ੍ਰਹਾ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "बहुरि बीर तिन ऐस उचारो ॥",
      "sourceLineId": "136004",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੁ ਮੈ ਕਹਤ ਹੌ ਸੁਨਹੁ ਪ੍ਯਾਰੋ ॥੭॥",
      "transliteration": "s mai kahat hau sunahu payaaro ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੈਂ ਕਹਿੰਦਾ ਹਾ, ਹੇ ਪਿਆਰੇ! ਉਸ ਨੂੰ ਸੁਣੋ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "सु मै कहत हौ सुनहु प्यारो ॥७॥",
      "sourceLineId": "136005",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੌ ਰਾਜਾ ਅਪਨੀ ਲੈ ਨਾਰੀ ॥",
      "transliteration": "jau raajaa apanee lai naaree ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਇਹ ਰਾਜਾ ਆਪਣੀ ਰਾਣੀ",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "जौ राजा अपनी लै नारी ॥",
      "sourceLineId": "136006",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੁਗਿਯਨ ਦੈ ਧਨ ਸਹਿਤ ਸੁਧਾਰੀ ॥",
      "transliteration": "jugiyan dhai dhan sahit sudhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਧਨ ਸਮੇਤ ਜੋਗੀ ਨੂੰ ਦੇ ਦੇਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "जुगियन दै धन सहित सुधारी ॥",
      "sourceLineId": "136007",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਬ ਇਹ ਪ੍ਰਜਾ ਸਹਿਤ ਨਹਿ ਮਰੈ ॥",
      "transliteration": "tab ieh prajaa sahit neh marai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਹ ਪ੍ਰਜਾ ਸਮੇਤ ਨਹੀਂ ਮਰੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "तब इह प्रजा सहित नहि मरै ॥",
      "sourceLineId": "136008",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਬਿਚਲ ਰਾਜ ਪ੍ਰਿਥੀ ਪਰ ਕਰੈ ॥੮॥",
      "transliteration": "abichal raaj pirathee par karai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰਿਥਵੀ ਉਤੇ ਸਥਿਰ ਰਾਜ ਕਰੇਗਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "अबिचल राज पृथी पर करै ॥८॥",
      "sourceLineId": "136009",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪ੍ਰਜਾ ਲੋਕ ਸੁਨਿ ਬਚ ਅਕੁਲਾਏ ॥",
      "transliteration": "prajaa lok sun bach akulaae ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਜਾ ਦੇ ਲੋਕ ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਬਹੁਤ ਵਿਆਕੁਲ ਹੋਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "प्रजा लोक सुनि बच अकुलाए ॥",
      "sourceLineId": "136010",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਤਹਾ ਨ੍ਰਿਪਹਿ ਲੈ ਆਏ ॥",
      "transliteration": "jayo(n) tayo(n) tahaa nirapeh lai aae ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਰਾਜੇ ਨੂੰ ਉਥੇ ਲੈ ਆਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "ज्यों त्यों तहा नृपहि लै आए ॥",
      "sourceLineId": "136011",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੁਗਿਯਹਿ ਦੇਹਿ ਦਰਬੁ ਜੁਤ ਨਾਰੀ ॥",
      "transliteration": "jugiyeh dheh dharab jut naaree ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਧਨ ਸਹਿਤ ਇਸਤਰੀ ਨੂੰ ਜੋਗੀ ਦੇ ਹਵਾਲੇ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "जुगियहि देहि दरबु जुत नारी ॥",
      "sourceLineId": "136012",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕੀ ਗਤਿ ਨ ਬਿਚਾਰੀ ॥੯॥",
      "transliteration": "bhedh abhedh kee gat na bichaaree ||9||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਨੇ ਭੇਦ ਅਭੇਦ ਦੀ ਗਤਿ ਨੂੰ ਨਾ ਪਛਾਣਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद की गति न बिचारी ॥९॥",
      "sourceLineId": "136013",
      "sourceShabadId": "12644",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "136014",
      "sourceShabadId": "12645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪ੍ਰਜਾ ਸਹਿਤ ਰਾਜਾ ਛਲਾ ਗਈ ਮਿਤ੍ਰ ਕੇ ਨਾਰਿ ॥",
      "transliteration": "prajaa sahit raajaa chhalaa giee mitr ke naar ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਜਾ ਸਮੇਤ ਰਾਜੇ ਨੂੰ ਛਲ ਕੇ (ਰਾਣੀ) ਮਿਤਰ ਨਾਲ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "प्रजा सहित राजा छला गई मित्र के नारि ॥",
      "sourceLineId": "136015",
      "sourceShabadId": "12645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਭਲਾ ਬੁਰਾ ਸਕਾ ਨ ਕੋਈ ਬਿਚਾਰਿ ॥੧੦॥",
      "transliteration": "bhedh abhedh bhalaa buraa sakaa na koiee bichaar ||10||",
      "translation": "",
      "punjabiViakhya": "ਭੇਦ ਅਭੇਦ ਜਾ ਚੰਗਾ ਮਾੜਾ ਕੋਈ ਵੀ ਵਿਚਾਰ ਨਾ ਸਕਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद भला बुरा सका न कोई बिचारि ॥१०॥",
      "sourceLineId": "136016",
      "sourceShabadId": "12645",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1308_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਪਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੬॥੬੫੪੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chhapan charitr samaapatam sat subham sat ||356||6541||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੫੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੫੬॥੬੫੪੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1308,
      "hindi": "",
