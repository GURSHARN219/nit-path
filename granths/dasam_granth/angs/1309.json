{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1309,
  "lineCount": 47,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1309_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਔਰ ਪ੍ਰਸੰਗਾ ॥",
      "transliteration": "sun raajaa ik aauar prasa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਹੋਰ ਪ੍ਰਸੰਗ ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा इक और प्रसंगा ॥",
      "sourceLineId": "136019",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭਾਖਿ ਸੁਨਾਵਤ ਤੁਮਰੇ ਸੰਗਾ ॥",
      "transliteration": "bhaakh sunaavat tumare sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਤੁਹਾਡੇ ਪਾਸ ਸੁਣਾਉਾਂਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "भाखि सुनावत तुमरे संगा ॥",
      "sourceLineId": "136020",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਚਲਾਵਤੀ ਨਗਰ ਇਕ ਰਾਜਤ ॥",
      "transliteration": "achalaavatee nagar ik raajat ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਅਚਲਾਵਤੀ ਨਾ ਦਾ ਨਗਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "अचलावती नगर इक राजत ॥",
      "sourceLineId": "136021",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੂਰ ਸਿੰਘ ਤਹ ਭੂਪ ਬਿਰਾਜਤ ॥੧॥",
      "transliteration": "soor si(n)gh teh bhoop biraajat ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸੂਰ ਸਿੰਘ (ਨਾ ਦਾ ਰਾਜਾ) ਰਾਜ ਕਰਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "सूर सिंघ तह भूप बिराजत ॥१॥",
      "sourceLineId": "136022",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅੰਜਨ ਦੇਇ ਤਵਨ ਕੀ ਰਾਨੀ ॥",
      "transliteration": "a(n)jan dhei tavan kee raanee ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਜਨ ਦੇਈ ਉਸ ਦੀ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "अंजन देइ तवन की रानी ॥",
      "sourceLineId": "136023",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਖੰਜਨ ਦੇ ਦੁਹਿਤਾ ਤਿਹ ਜਾਨੀ ॥",
      "transliteration": "kha(n)jan dhe dhuhitaa teh jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪੁੱਤਰੀ ਦਾ ਨਾ ਖੰਜਨ ਦੇਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "खंजन दे दुहिता तिह जानी ॥",
      "sourceLineId": "136024",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਧਿਕ ਦੁਹੂੰ ਕੀ ਪ੍ਰਭਾ ਬਿਰਾਜੈ ॥",
      "transliteration": "adhik dhuhoo(n) kee prabhaa biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਦੀ ਸੁੰਦਰਤਾ ਬਹੁਤ ਅਧਿਕ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "अधिक दुहूँ की प्रभा बिराजै ॥",
      "sourceLineId": "136025",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਿਰਖਿ ਨਰੀ ਨਾਗਿਨਿ ਮਨ ਲਾਜੈ ॥੨॥",
      "transliteration": "nirakh naree naagin man laajai ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਵੇਖ ਕੇ ਮਨੁੱਖ ਅਤੇ ਨਾਗ ਇਸਤਰੀਆਂ ਲਜਾਉਾਂਦੀਆਂ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "निरखि नरी नागिनि मन लाजै ॥२॥",
      "sourceLineId": "136026",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਹਾ ਏਕ ਆਯੋ ਸੌਦਾਗਰ ॥",
      "transliteration": "tahaa ek aayo sauadhaagar ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸੌਦਾਗਰ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "तहा एक आयो सौदागर ॥",
      "sourceLineId": "136027",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰੂਪਵੰਤੁ ਜਨੁ ਦੁਤਿਯ ਨਿਸਾਕਰ ॥",
      "transliteration": "roopava(n)t jan dhutiy nisaakar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਬਹੁਤ) ਸੁੰਦਰ ਸੀ, ਮਾਨੋ ਦੂਜਾ ਚੰਦ੍ਰਮਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "रूपवंतु जनु दुतिय निसाकर ॥",
      "sourceLineId": "136028",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੋ ਅਬਲਾ ਤਿਹ ਰੂਪ ਨਿਹਾਰੈ ॥",
      "transliteration": "jo abalaa teh roop nihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਸਤਰੀ ਉਸ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "जो अबला तिह रूप निहारै ॥",
      "sourceLineId": "136029",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਜ ਪਾਟ ਤਜਿ ਸਾਥ ਸਿਧਾਰੈ ॥੩॥",
      "transliteration": "raaj paaT taj saath sidhaarai ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜ-ਪਾਟ ਛਡ ਕੇ ਉਸ ਨਾਲ ਤੁਰ ਪੈਂਦੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "राज पाट तजि साथ सिधारै ॥३॥",
      "sourceLineId": "136030",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੋ ਆਯੋ ਨ੍ਰਿਪ ਤ੍ਰਿਯ ਕੇ ਘਰ ਤਰ ॥",
      "transliteration": "so aayo nirap tiray ke ghar tar ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜਾ (ਇਕ ਦਿਨ) ਰਾਣੀ ਦੇ ਮੱਹਲ ਦੇ ਹੇਠਾ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "सो आयो नृप तृय के घर तर ॥",
      "sourceLineId": "136031",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਨਿਰਖਾ ਤਿਹ ਦ੍ਰਿਗ ਭਰਿ ॥",
      "transliteration": "raaj sutaa nirakhaa teh dhirag bhar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਸ ਨੂੰ ਅੱਖਾ ਭਰ ਕੇ (ਭਾਵ ਚੰਗੀ ਤਰ੍ਰਹਾ) ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "राज सुता निरखा तिह दृग भरि ॥",
      "sourceLineId": "136032",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਨ ਬਚ ਕ੍ਰਮ ਇਹ ਉਪਰ ਭੂਲੀ ॥",
      "transliteration": "man bach kram ieh upar bhoolee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮਨ, ਬਚ ਅਤੇ ਕਰਮ ਕਰ ਕੇ ਉਸ ਉਤੇ ਡੁਲ੍ਰਹ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "मन बच क्रम इह उपर भूली ॥",
      "sourceLineId": "136033",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਨੁ ਮਦ ਪੀ ਮਤਵਾਰੀ ਝੂਲੀ ॥੪॥",
      "transliteration": "jan madh pee matavaaree jhoolee ||4||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸ਼ਰਾਬ ਪੀ ਕੇ ਮਤਵਾਲੀ ਹੋਈ ਝੁਲ ਰਹੀ ਹੋਵੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "जनु मद पी मतवारी झूली ॥४॥",
      "sourceLineId": "136034",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਿੰਘ ਪ੍ਰਚੰਡ ਨਾਮ ਤਿਹ ਨਰ ਕੋ ॥",
      "transliteration": "si(n)gh pracha(n)dd naam teh nar ko ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪੁਰਸ਼ ਦਾ ਨਾ ਪ੍ਰਚੰਡ ਸਿੰਘ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "सिंघ प्रचंड नाम तिह नर को ॥",
      "sourceLineId": "136035",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਨੁ ਕਰਿ ਮੁਕਟ ਕਾਮ ਕੇ ਸਿਰ ਕੋ ॥",
      "transliteration": "jan kar mukaT kaam ke sir ko ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਤਨਾ ਸੁੰਦਰ ਸੀ) ਮਾਨੋ ਕਾਮ ਦੇਵ ਦੇ ਸਿਰ ਦਾ ਮੁਕਟ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "जनु करि मुकट काम के सिर को ॥",
      "sourceLineId": "136036",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਖੀ ਏਕ ਤਹ ਕੁਅਰਿ ਪਠਾਈ ॥",
      "transliteration": "sakhee ek teh kuar paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਇਕ ਸਖੀ ਨੂੰ (ਉਸ ਪੁਰਸ਼ ਪਾਸ) ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "सखी एक तह कुअरि पठाई ॥",
      "sourceLineId": "136037",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਹਿਯਹੁ ਬ੍ਰਿਥਾ ਸਜਨ ਸੌ ਜਾਈ ॥੫॥",
      "transliteration": "kahiyahu birathaa sajan sau jaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਾ ਕੇ ਮਿਤਰ ਨੂੰ (ਸਾਰੀ) ਗੱਲ ਦਸੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "कहियहु बृथा सजन सौ जाई ॥५॥",
      "sourceLineId": "136038",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਖੀ ਤੁਰਤ ਤਿਨ ਤਹ ਪਹੁਚਾਯੋ ॥",
      "transliteration": "sakhee turat tin teh pahuchaayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀ ਨੇ ਤੁਰਤ ਉਸ ਦਾ (ਸੁਨੇਹਾ) ਉਸ ਕੋਲ ਪਹੁੰਚਾ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "सखी तुरत तिन तह पहुचायो ॥",
      "sourceLineId": "136039",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਸ ਨਾਵਕ ਕੋ ਤੀਰ ਚਲਾਯੋ ॥",
      "transliteration": "jas naavak ko teer chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਨਾਵਕ (ਨਲਕੀ) ਵਿਚੋਂ ਤੀਰ ਚਲਾਈਦਾ ਹੈ (ਕਿਉਾਂਕਿ ਇਸ ਤਰ੍ਰਹਾ ਤੀਰ ਸਿੱਧੀ ਮਾਰ ਕਰਦਾ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "जस नावक को तीर चलायो ॥",
      "sourceLineId": "136040",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਕਲ ਕੁਅਰਿ ਤਿਨ ਬ੍ਰਿਥਾ ਸੁਨਾਈ ॥",
      "transliteration": "sakal kuar tin birathaa sunaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਸਖੀ) ਨੇ ਰਾਜ ਕੁਮਾਰੀ ਦੀ ਸਾਰੀ ਬਿਰਥਾ ਸੁਣਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "सकल कुअरि तिन बृथा सुनाई ॥",
      "sourceLineId": "136041",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਨ ਬਚ ਰੀਝਿ ਰਹਾ ਸੁਖਦਾਈ ॥੬॥",
      "transliteration": "man bach reejh rahaa sukhadhaiee ||6||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਸੁਣ ਕੇ) ਮਿਤਰ ਮਨ, ਬਚ ਕਰਮ ਕਰ ਕੇ ਪ੍ਰਸੰਨ ਹੋ ਗਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "मन बच रीझि रहा सुखदाई ॥६॥",
      "sourceLineId": "136042",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਦੀ ਬਹਤ ਨ੍ਰਿਪ ਗ੍ਰਿਹਿ ਤਰ ਜਹਾ ॥",
      "transliteration": "nadhee bahat nirap gireh tar jahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਕਹਿਲਵਾ ਭੇਜਿਆ ਕਿ) ਜਿਥੇ ਰਾਜੇ ਦੇ ਮਹੱਲ ਹੇਠਾ ਨਦੀ ਵਗਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "नदी बहत नृप गृहि तर जहा ॥",
      "sourceLineId": "136043",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਠਾਢ ਹੂਜਿਯਹੁ ਨਿਸਿ ਕਹ ਤਹਾ ॥",
      "transliteration": "Thaadd hoojiyahu nis keh tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਨੂੰ ਉਥੇ ਖੜੋਤੇ ਹੋਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "ठाढ हूजियहु निसि कह तहा ॥",
      "sourceLineId": "136044",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਡਾਰਿ ਦੇਗ ਮੈ ਕੁਅਰਿ ਬਹੈ ਹੈਂ ॥",
      "transliteration": "ddaar dheg mai kuar bahai hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਦੇਗ ਵਿਚ ਪਾ ਕੇ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਰੋੜ੍ਰਹ ਦਿਆਂਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "डारि देग मै कुअरि बहै हैं ॥",
      "sourceLineId": "136045",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਛਿਦ੍ਰ ਮੂੰਦਿ ਤਾ ਕੋ ਸਭ ਲੈ ਹੈਂ ॥੭॥",
      "transliteration": "chhidhr moo(n)dh taa ko sabh lai hai(n) ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀਆਂ ਸਾਰੀਆਂ ਮੋਰੀਆਂ ਬੰਦ ਕਰ ਦਿਆਂਗੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "छिद्र मूँदि ता को सभ लै हैं ॥७॥",
      "sourceLineId": "136046",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਊਪਰ ਬਾਧਿ ਤੰਬੂਰਾ ਦੈ ਹੈਂ ॥",
      "transliteration": "uoopar baadh ta(n)booraa dhai hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਉਤੇ (ਮੈਂ) ਤੰਬੂਰਾ ਬੰਨ੍ਰਹ ਦਿਆਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "ऊपर बाधि तंबूरा दै हैं ॥",
      "sourceLineId": "136047",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਮੁਹਿ ਤਾਹਿ ਮਿਲੈ ਹੈਂ ॥",
      "transliteration": "eeh charitr muh taeh milai hai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਮੈਂ (ਤੁਹਾਨੂੰ) ਉਸ ਨਾਲ ਮਿਲਾ ਦਿਆਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र मुहि ताहि मिलै हैं ॥",
      "sourceLineId": "136048",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਬ ਤੁਬਰੀ ਲਖਿਯਹੁ ਢਿਗ ਆਈ ॥",
      "transliteration": "jab tubaree lakhiyahu ddig aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸੁਖ ਦੇਣ ਵਾਲੇ ਮਿਤਰ! ਜਦ ਤੂੰਬੀ ਨੂੰ ਨੇੜੇ ਆਇਆ ਵੇਖਣਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "जब तुबरी लखियहु ढिग आई ॥",
      "sourceLineId": "136049",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਾਢਿ ਭੋਗ ਦੀਜਹੁ ਸੁਖਦਾਈ ॥੮॥",
      "transliteration": "kaadd bhog dheejahu sukhadhaiee ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਾ (ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ) ਕਢ ਕੇ ਖ਼ੂਬ ਸੰਯੋਗ ਕਰਨਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "काढि भोग दीजहु सुखदाई ॥८॥",
      "sourceLineId": "136050",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਬਦਿ ਤਾ ਸੌ ਸੰਕੇਤਾ ॥",
      "transliteration": "eeh bidh badh taa sau sa(n)ketaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਸੰਕੇਤ ਦਸ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "इह बिधि बदि ता सौ संकेता ॥",
      "sourceLineId": "136051",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੂਤੀ ਗੀ ਨ੍ਰਿਪ ਤ੍ਰਿਯਜ ਨਿਕੇਤਾ ॥",
      "transliteration": "dhootee gee nirap tirayaj niketaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਤੀ ਰਾਜ ਕੁਮਾਰੀ ਦੇ ਘਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "दूती गी नृप तृयज निकेता ॥",
      "sourceLineId": "136052",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਡਾਰਿ ਦੇਗ ਮੈ ਕੁਅਰਿ ਬਹਾਈ ॥",
      "transliteration": "ddaar dheg mai kuar bahaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਦੇਗ ਵਿਚ ਪਾ ਕੇ ਰੋੜ੍ਰਹ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "डारि देग मै कुअरि बहाई ॥",
      "sourceLineId": "136053",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਾਧਿ ਤੂੰਬਰੀ ਤਹ ਪਹੁਚਾਈ ॥੯॥",
      "transliteration": "baadh too(n)baree teh pahuchaiee ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੂੰਬੀ ਬੰਨ੍ਰਹ ਕੇ ਉਥੇ ਪਹੁੰਚਾ ਦਿੱਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "बाधि तूँबरी तह पहुचाई ॥९॥",
      "sourceLineId": "136054",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਬ ਬਹਤੀ ਤੁਬਰੀ ਤਹ ਆਈ ॥",
      "transliteration": "jab bahatee tubaree teh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਤੂੰਬੀ ਵਹਿੰਦੀ ਹੋਈ ਉਥੇ ਆਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "जब बहती तुबरी तह आई ॥",
      "sourceLineId": "136055",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਵਤ ਕੁਅਰਿ ਲਖਾ ਸੁਖਦਾਈ ॥",
      "transliteration": "aavat kuar lakhaa sukhadhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਸੁਖਦਾਇਕ (ਮਿਤਰ) ਨੇ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਆਉਾਂਦਿਆਂ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "आवत कुअरि लखा सुखदाई ॥",
      "sourceLineId": "136056",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਐਂਚਿ ਤਹਾ ਤੇ ਦੇਗ ਨਿਕਾਰੀ ॥",
      "transliteration": "aai(n)ch tahaa te dheg nikaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦੇਗ ਨੂੰ ਖਿਚ ਕੇ ਕਢ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "ऐंचि तहा ते देग निकारी ॥",
      "sourceLineId": "136057",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲੈ ਪਲਕਾ ਊਪਰ ਬੈਠਾਰੀ ॥੧੦॥",
      "transliteration": "lai palakaa uoopar baiThaaree ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਕਢ ਕੇ) ਮੰਜੀ (ਪਲੰਘ) ਉਪਰ ਬਿਠਾਇਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "लै पलका ऊपर बैठारी ॥१०॥",
      "sourceLineId": "136058",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਈ ॥",
      "transliteration": "posat bhaag afeem ma(n)gaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪੋਸਤ, ਭੰਗ ਅਤੇ ਅਫ਼ੀਮ ਮੰਗਵਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "पोसत भाग अफीम मंगाई ॥",
      "sourceLineId": "136059",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੁਹੂੰ ਖਾਟ ਪਰ ਬੈਠਿ ਚੜਾਈ ॥",
      "transliteration": "dhuhoo(n) khaaT par baiTh chaRaiee ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਮੰਜੀ ਉਪਰ ਬੈਠ ਕੇ ਚੜ੍ਰਹਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "दुहूँ खाट पर बैठि चड़ाई ॥",
      "sourceLineId": "136060",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚਾਰਿ ਪਹਰ ਤਾ ਸੌ ਕਰਿ ਭੋਗਾ ॥",
      "transliteration": "chaar pahar taa sau kar bhogaa ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਰ ਪਹਿਰ ਤਕ ਉਸ ਨਾਲ ਸੰਯੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "चारि पहर ता सौ करि भोगा ॥",
      "sourceLineId": "136061",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭੇਦ ਨ ਲਖਾ ਦੂਸਰੇ ਲੋਗਾ ॥੧੧॥",
      "transliteration": "bhedh na lakhaa dhoosare logaa ||11||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਦੂਜਾ ਵਿਅਕਤੀ ਇਸ ਭੇਦ ਨੂੰ ਨਾ ਪਾ ਸਕਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "भेद न लखा दूसरे लोगा ॥११॥",
      "sourceLineId": "136062",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਤਾ ਸੌ ਰੋਜ ਬੁਲਾਵੈ ॥",
      "transliteration": "eeh bidh taa sau roj bulaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਨੂੰ ਰੋਜ਼ ਬੁਲਾਉਾਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "इह बिधि ता सौ रोज बुलावै ॥",
      "sourceLineId": "136063",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਕਰਿ ਤਾਹਿ ਪਠਾਵੈ ॥",
      "transliteration": "kaam bhog kar taeh paThaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਮ-ਭੋਗ ਕਰ ਕਰ ਕੇ ਉਸ ਨੂੰ ਪਰਤਾ ਦਿੰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "काम भोग करि ताहि पठावै ॥",
      "sourceLineId": "136064",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1309_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭੂਪ ਸਹਿਤ ਕੋਈ ਭੇਦ ਨ ਪਾਵੈ ॥",
      "transliteration": "bhoop sahit koiee bhedh na paavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਸਮੇਤ ਕੋਈ ਵੀ ਭੇਦ ਨਾ ਪਾ ਸਕਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1309,
      "hindi": "",
      "hindiTransliteration": "भूप सहित कोई भेद न पावै ॥",
      "sourceLineId": "136065",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
