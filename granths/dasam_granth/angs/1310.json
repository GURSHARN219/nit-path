{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1310,
  "lineCount": 50,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1310_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਿਤਪ੍ਰਤਿ ਅਪਨੋ ਮੂੰਡ ਮੁੰਡਾਵੈ ॥੧੨॥",
      "transliteration": "nitaprat apano moo(n)dd mu(n)ddaavai ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਿੱਤ ਛਲਿਆ ਜਾਦਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "नितप्रति अपनो मूँड मुँडावै ॥१२॥",
      "sourceLineId": "136066",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਾਵਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੭॥੬੫੫੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau sataavan charitr samaapatam sat subham sat ||357||6553||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੫੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੫੭॥੬੫੫੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ सतावन चरित्र समापतम सतु सुभम सतु ॥३५७॥६५५३॥अफजूँ॥",
      "sourceLineId": "136067",
      "sourceShabadId": "12646",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136068",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੁਨੁ ਭੂਪਤਿ ਇਕ ਕਥਾ ਨਵੀਨੀ ॥",
      "transliteration": "sun bhoopat ik kathaa naveenee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਨਵੀਂ ਕਥਾ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "सुनु भूपति इक कथा नवीनी ॥",
      "sourceLineId": "136069",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿਨਹੂੰ ਲਖੀ ਨ ਆਗੇ ਚੀਨੀ ॥",
      "transliteration": "kinahoo(n) lakhee na aage cheenee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਕਿਸੇ ਨੇ ਨਾ (ਪਹਿਲਾ) ਵੇਖਿਆ ਹੈ? ਅਤੇ ਨਾ ਅਗੇ ਜਾਣਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "किनहूँ लखी न आगे चीनी ॥",
      "sourceLineId": "136070",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੁੰਦ੍ਰਾਵਤੀ ਨਗਰ ਇਕ ਸੋਹੈ ॥",
      "transliteration": "su(n)dhraavatee nagar ik sohai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸੁੰਦ੍ਰਵਾਤੀ ਨਾ ਦਾ ਨਗਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "सुँद्रावती नगर इक सोहै ॥",
      "sourceLineId": "136071",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁੰਦਰ ਸਿੰਘ ਰਾਜਾ ਤਹ ਕੋ ਹੈ ॥੧॥",
      "transliteration": "su(n)dhar si(n)gh raajaa teh ko hai ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਦਾ ਰਾਜਾ ਸੁੰਦਰ ਸਿੰਘ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "सुँदर सिंघ राजा तह को है ॥१॥",
      "sourceLineId": "136072",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁੰਦਰ ਦੇ ਰਾਜਾ ਕੀ ਨਾਰੀ ॥",
      "transliteration": "su(n)dhar dhe raajaa kee naaree ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਦੇ (ਦੇਈ) ਰਾਜੇ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "सुँदर दे राजा की नारी ॥",
      "sourceLineId": "136073",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਪੁ ਜਨਕੁ ਜਗਦੀਸ ਸਵਾਰੀ ॥",
      "transliteration": "aap janak jagadhees savaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਉਸ ਨੂੰ ਆਪ ਜਗਦੀਸ਼ ਨੇ ਬਣਾਇਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "आपु जनकु जगदीस सवारी ॥",
      "sourceLineId": "136074",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਾ ਕੀ ਜਾਤ ਨ ਪ੍ਰਭਾ ਬਖਾਨੀ ॥",
      "transliteration": "taa kee jaat na prabhaa bakhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪ੍ਰਭਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "ता की जात न प्रभा बखानी ॥",
      "sourceLineId": "136075",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਐਸੀ ਹੁਤੀ ਰਾਇ ਕੀ ਰਾਨੀ ॥੨॥",
      "transliteration": "aaisee hutee rai kee raanee ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹੀ ਹੁੰਦੀ ਸੀ ਰਾਜੇ ਦੀ ਰਾਣੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "ऐसी हुती राइ की रानी ॥२॥",
      "sourceLineId": "136076",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਹਿਕ ਸਾਹ ਕੋ ਪੂਤ ਅਪਾਰਾ ॥",
      "transliteration": "tahik saeh ko poot apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਹ ਸ਼ਾਹ ਦਾ ਅਪਾਰ (ਸੁੰਦਰਤਾ ਵਾਲਾ) ਪੁੱਤਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "तहिक साह को पूत अपारा ॥",
      "sourceLineId": "136077",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨੁ ਢਾਰਾ ॥",
      "transliteration": "kanak avaT saache jan ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸੋਨੇ ਨੂੰ ਪੰਘਾਰ ਕੇ ਸੰਚੇ ਵਿਚ ਢਾਲਿਆ ਗਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "कनक अवटि साचे जनु ढारा ॥",
      "sourceLineId": "136078",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਿਰਖਿ ਨਾਕ ਜਿਹ ਸੂਆ ਰਿਸਾਨੋ ॥",
      "transliteration": "nirakh naak jeh sooaa risaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਨੱਕ ਨੂੰ ਵੇਖ ਕੇ ਤੋਤਾ ਗੁੱਸਾ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "निरखि नाक जिह सूआ रिसानो ॥",
      "sourceLineId": "136079",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕੰਜ ਜਾਨਿ ਦ੍ਰਿਗ ਭਵਰ ਭੁਲਾਨੋ ॥੩॥",
      "transliteration": "ka(n)j jaan dhirag bhavar bhulaano ||3||",
      "translation": "",
      "punjabiViakhya": "ਨੇਤਰਾ ਨੂੰ ਕਮਲ (ਦੇ ਫੁਲ) ਸਮਝ ਕੇ ਭੌਰੇ ਭੁਲ ਜਾਦੇ ਸਨ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "कंज जानि दृग भवर भुलानो ॥३॥",
      "sourceLineId": "136080",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਟਿ ਕੇਹਰਿ ਲਖਿ ਅਧਿਕ ਰਿਸਾਵਤ ॥",
      "transliteration": "kaT kehar lakh adhik risaavat ||",
      "translation": "",
      "punjabiViakhya": "ਕਮਰ ਨੂੰ ਵੇਖ ਕੇ ਸ਼ੇਰ ਕ੍ਰੋਧਿਤ ਹੁੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "कटि केहरि लखि अधिक रिसावत ॥",
      "sourceLineId": "136081",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾ ਤੇ ਫਿਰਤ ਮ੍ਰਿਗਨ ਕਹ ਘਾਵਤ ॥",
      "transliteration": "taa te firat miragan keh ghaavat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸੇ ਕਰ ਕੇ ਜੰਗਲੀ ਪਸ਼ੂਆਂ ('ਮ੍ਰਿਗਨ') ਨੂੰ ਮਾਰਦਾ ਫਿਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "ता ते फिरत मृगन कह घावत ॥",
      "sourceLineId": "136082",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੁਨਿ ਬਾਨੀ ਕੋਕਿਲ ਕੁਕਰਈ ॥",
      "transliteration": "sun baanee kokil kukariee ||",
      "translation": "",
      "punjabiViakhya": "ਬੋਲ ਸੁਣ ਕੇ ਕੋਇਲ ਕੁੜਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "सुनि बानी कोकिल कुकरई ॥",
      "sourceLineId": "136083",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕ੍ਰੋਧ ਜਰਤ ਕਾਰੀ ਹ੍ਵੈ ਗਈ ॥੪॥",
      "transliteration": "krodh jarat kaaree havai giee ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰੋਧ ਨਾਲ ਸੜ ਕੇ ਕਾਲੀ ਹੋ ਗਈ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "क्रोध जरत कारी ह्वै गई ॥४॥",
      "sourceLineId": "136084",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨੈਨ ਨਿਰਖਿ ਕਰਿ ਜਲਜ ਲਜਾਨਾ ॥",
      "transliteration": "nain nirakh kar jalaj lajaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਨੈਣਾ ਨੂੰ ਵੇਖ ਕੇ ਕਮਲ ਲਜਾਉਾਂਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "नैन निरखि करि जलज लजाना ॥",
      "sourceLineId": "136085",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਾ ਤੇ ਜਲ ਮਹਿ ਕਿਯਾ ਪਯਾਨਾ ॥",
      "transliteration": "taa te jal meh kiyaa payaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸੇ ਕਰ ਕੇ (ਉਨ੍ਰਹਾ ਨੇ) ਜਲ ਵਿਚ ਪ੍ਰਵੇਸ਼ ਕਰ ਲਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "ता ते जल महि किया पयाना ॥",
      "sourceLineId": "136086",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਲਕ ਹੇਰਿ ਨਾਗਿਨਿ ਰਿਸਿ ਭਰੀ ॥",
      "transliteration": "alak her naagin ris bharee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀਆਂ) ਜ਼ੁਲਫ਼ਾ ਨੂੰ ਵੇਖ ਕੇ ਨਾਗਣਾ ਰੋਹ ਨਾਲ ਭਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "अलक हेरि नागिनि रिसि भरी ॥",
      "sourceLineId": "136087",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਿਤ ਮਹਿ ਲਜਤ ਪਤਾਰਹਿ ਬਰੀ ॥੫॥",
      "transliteration": "chit meh lajat pataareh baree ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਵਿਚ ਸ਼ਰਮਿੰਦੀਆਂ ਹੋ ਕੇ ਪਾਤਾਲ ਲੋਕ ਵਿਚ ਜਾ ਵੜੀਆਂ ਹਨ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "चित महि लजत पतारहि बरी ॥५॥",
      "sourceLineId": "136088",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੋ ਆਯੋ ਰਾਜਾ ਕੇ ਪਾਸਾ ॥",
      "transliteration": "so aayo raajaa ke paasaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ (ਸ਼ਾਹ-ਪੁੱਤਰ ਵਪਾਰ ਲਈ) ਰਾਜੇ ਕੋਲ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "सो आयो राजा के पासा ॥",
      "sourceLineId": "136089",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੌਦਾ ਕੀ ਜਿਯ ਮੈ ਧਰਿ ਆਸਾ ॥",
      "transliteration": "sauadhaa kee jiy mai dhar aasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਮਨ ਵਿਚ ਸੌਦਾ ਕਰਨ ਦੀ ਆਸ ਰਖੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "सौदा की जिय मै धरि आसा ॥",
      "sourceLineId": "136090",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੁੰਦਰਿ ਦੇ ਨਿਰਖਤ ਤਿਹ ਭਈ ॥",
      "transliteration": "su(n)dhar dhe nirakhat teh bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਦੇਈ ਨੇ ਉਸ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "सुँदरि दे निरखत तिह भई ॥",
      "sourceLineId": "136091",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੁਧਿ ਬੁਧਿ ਤਜਿ ਬੌਰੀ ਹ੍ਵੈ ਗਈ ॥੬॥",
      "transliteration": "sudh budh taj bauaree havai giee ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸੁੱਧ ਬੁੱਧ ਨੂੰ ਛਡ ਕੇ ਦੀਵਾਨੀ ਹੋ ਗਈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "सुधि बुधि तजि बौरी ह्वै गई ॥६॥",
      "sourceLineId": "136092",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਤਾਹਿ ਬੁਲਾਵਾ ॥",
      "transliteration": "paThai sahacharee taeh bulaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਹੇਲੀ ਨੂੰ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी ताहि बुलावा ॥",
      "sourceLineId": "136093",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਕਿਯ ਜਸ ਮਨ ਭਾਵਾ ॥",
      "transliteration": "kaam bhog kiy jas man bhaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਮਨ ਭਾਉਾਂਦੇ ਢੰਗ ਨਾਲ ਸੰਯੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "काम भोग किय जस मन भावा ॥",
      "sourceLineId": "136094",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਹ ਇਕ ਹੁਤੀ ਨ੍ਰਿਪਤਿ ਕੀ ਚੇਰੀ ॥",
      "transliteration": "teh ik hutee nirapat kee cheree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਰਾਜੇ ਦੀ ਦਾਸੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "तह इक हुती नृपति की चेरी ॥",
      "sourceLineId": "136095",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹੇਰਿ ਗਈ ਜਸ ਹੇਰਿ ਅਹੇਰੀ ॥੭॥",
      "transliteration": "her giee jas her aheree ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਹ (ਇਹ ਸਭ ਕੁਝ) ਇਸ ਤਰ੍ਰਹਾ ਵੇਖ ਗਈ ਜਿਵੇਾਂ ਸ਼ਿਕਾਰੀ (ਸ਼ਿਕਾਰ ਨੂੰ) ਵੇਖਦਾ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "हेरि गई जस हेरि अहेरी ॥७॥",
      "sourceLineId": "136096",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪਾਵ ਦਾਬਿ ਨ੍ਰਿਪ ਜਾਇ ਜਗਾਯੋ ॥",
      "transliteration": "paav dhaab nirap jai jagaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਪੈਰ ਦਬਾ ਕੇ ਰਾਜੇ ਨੂੰ ਜਗਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "पाव दाबि नृप जाइ जगायो ॥",
      "sourceLineId": "136097",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਧਾਮ ਤੋਰ ਤਸਕਰਿ ਇਕ ਆਯੋ ॥",
      "transliteration": "dhaam tor tasakar ik aayo ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ ਕਿ) ਤੁਹਾਡੇ ਘਰ ਇਕ ਚੋਰ ਆਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "धाम तोर तसकरि इक आयो ॥",
      "sourceLineId": "136098",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਨੀ ਕੇ ਸੰਗ ਕਰਤ ਬਿਲਾਸਾ ॥",
      "transliteration": "raanee ke sa(n)g karat bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਾਣੀ ਨਾਲ ਵਿਲਾਸ ਕਰ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "रानी के संग करत बिलासा ॥",
      "sourceLineId": "136099",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚਲਿ ਦੇਖਹੁ ਤਿਹ ਭੂਪ ਤਮਾਸਾ ॥੮॥",
      "transliteration": "chal dhekhahu teh bhoop tamaasaa ||8||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਚਲ ਕੇ (ਆਪਣੀਆਂ ਅੱਖਾ ਨਾਲ ਸਾਰਾ) ਤਮਾਸ਼ਾ ਵੇਖ ਲਵੋ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "चलि देखहु तिह भूप तमासा ॥८॥",
      "sourceLineId": "136100",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਨ੍ਰਿਪ ਅਧਿਕ ਰਿਸਾਯੋ ॥",
      "transliteration": "sunat bachan nirap adhik risaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਬਚਨ ਸੁਣ ਕੇ ਬਹੁਤ ਗੁੱਸੇ ਵਿਚ ਆਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन नृप अधिक रिसायो ॥",
      "sourceLineId": "136101",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਖੜਗ ਹਾਥ ਲੈ ਤਹਾ ਸਿਧਾਯੋ ॥",
      "transliteration": "khaRag haath lai tahaa sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਲਵਾਰ ਹੱਥ ਵਿਚ ਪਕੜ ਕੇ ਉਥੇ ਪਹੁੰਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "खड़ग हाथ लै तहा सिधायो ॥",
      "sourceLineId": "136102",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਬ ਅਬਲਾ ਪਤਿ ਕੀ ਸੁਧਿ ਪਾਈ ॥",
      "transliteration": "jab abalaa pat kee sudh paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੂੰ ਪਤੀ ਦੇ ਆਣ ਦਾ ਪਤਾ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "जब अबला पति की सुधि पाई ॥",
      "sourceLineId": "136103",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਧਿਕ ਧੂੰਮ ਤਹ ਦਿਯਾ ਜਗਾਈ ॥੯॥",
      "transliteration": "adhik dhoo(n)m teh dhiyaa jagaiee ||9||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਉਸ ਨੇ ਬਹੁਤ ਅਧਿਕ ਧੂੰਆਂ ਧੁਖਾ ਦਿੱਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "अधिक धूँम तह दिया जगाई ॥९॥",
      "sourceLineId": "136104",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਭ ਕੇ ਨੈਨ ਧੂਮ੍ਰ ਸੌ ਭਰੇ ॥",
      "transliteration": "sabh ke nain dhoomr sau bhare ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਦੀਆਂ ਅੱਖਾ ਧੂੰਏਾਂ ਨਾਲ ਭਰ ਗਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "सभ के नैन धूम्र सौ भरे ॥",
      "sourceLineId": "136105",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਸੁਆ ਟੂਟਿ ਬਦਨ ਪਰ ਪਰੇ ॥",
      "transliteration": "asuaa TooT badhan par pare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੰਝੂ ਨਿਕਲ ਕੇ ਮੂੰਹ ਉਤੇ ਪੈਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "असुआ टूटि बदन पर परे ॥",
      "sourceLineId": "136106",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਬ ਰਾਨੀ ਇਹ ਘਾਤ ਪਛਾਨੀ ॥",
      "transliteration": "jab raanee ieh ghaat pachhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਣੀ ਨੇ ਇਹ ਮੌਕਾ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "जब रानी इह घात पछानी ॥",
      "sourceLineId": "136107",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਿਤ੍ਰ ਲੰਘਾਇ ਹਿਯੇ ਹਰਖਾਨੀ ॥੧੦॥",
      "transliteration": "mitr la(n)ghai hiye harakhaanee ||10||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਮਿਤਰ ਨੂੰ (ਉਥੋਂ) ਲੰਘਾ ਕੇ (ਭਾਵ ਕਢ ਕੇ) ਮਨ ਵਿਚ ਪ੍ਰਸੰਨ ਹੋ ਗਈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "मित्र लंघाइ हिये हरखानी ॥१०॥",
      "sourceLineId": "136108",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਆਗੇ ਸੌ ਕਰਿ ਕਾਢਾ ਜਾਰਾ ॥",
      "transliteration": "aage sau kar kaaddaa jaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ (ਸਭ ਦੇ) ਅਗੋਂ (ਸਾਹਮਣਿਓਾਂ) ਯਾਰ ਨੂੰ ਕਢ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "आगे सौ करि काढा जारा ॥",
      "sourceLineId": "136109",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਧੂਮ੍ਰ ਭਰੇ ਦ੍ਰਿਗ ਨ੍ਰਿਪਨ ਨਿਹਾਰਾ ॥",
      "transliteration": "dhoomr bhare dhirag nirapan nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧੂੰਏਾਂ ਨਾਲ ਭਰੀਆਂ ਹੋਈਆਂ ਅੱਖਾ ਨਾਲ ਰਾਜੇ ਨੇ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "धूम्र भरे दृग नृपन निहारा ॥",
      "sourceLineId": "136110",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪੌਛ ਨੇਤ੍ਰ ਜਬ ਹੀ ਗਯੋ ਤਹਾ ॥",
      "transliteration": "pauachh netr jab hee gayo tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਜਦ ਅੱਖਾ ਪੂੰਝ ਕੇ ਉਥੇ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "पौछ नेत्र जब ही गयो तहा ॥",
      "sourceLineId": "136111",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕੋਊ ਨ ਪੁਰਖ ਨਿਹਾਰਾ ਉਹਾ ॥੧੧॥",
      "transliteration": "kouoo na purakh nihaaraa uhaa ||11||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਥੇ ਕੋਈ ਵੀ ਪੁਰਸ਼ ਨਾ ਵੇਖਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
      "hindiTransliteration": "कोऊ न पुरख निहारा उहा ॥११॥",
      "sourceLineId": "136112",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1310_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਉਲਟਿ ਤਿਸੀ ਚੇਰੀ ਕਹ ਘਾਯੋ ॥",
      "transliteration": "aulaT tisee cheree keh ghaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ ਗੁੱਸੇ ਵਿਚ ਆ ਕੇ) ਉਲਟਾ ਉਸ ਦਾਸੀ ਨੂੰ ਹੀ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1310,
      "hindi": "",
