{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1311,
  "lineCount": 47,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1311_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਗੇ ਕਰਿ ਤ੍ਰਿਯ ਮਿਤ੍ਰ ਨਿਕਾਰਾ ॥੧੨॥",
      "transliteration": "aage kar tiray mitr nikaaraa ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ ਨੇ ਸਭ ਦੇ ਅਗੋਂ ਮਿਤਰ ਨੂੰ ਕਢ ਦਿੱਤਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "आगे करि तृय मित्र निकारा ॥१२॥",
      "sourceLineId": "136116",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਾਵਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੮॥੬੫੬੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau aThaavan charitr samaapatam sat subham sat ||358||6565||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੫੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੫੮॥੬੫੬੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ अठावन चरित्र समापतम सतु सुभम सतु ॥३५८॥६५६५॥अफजूँ॥",
      "sourceLineId": "136117",
      "sourceShabadId": "12647",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136118",
      "sourceShabadId": "12648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਔਰ ਚਰਿਤ੍ਰ ॥",
      "transliteration": "sun raajaa ik aauar charitr ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਹੋਰ ਚਰਿਤ੍ਰ ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा इक और चरित्र ॥",
      "sourceLineId": "136119",
      "sourceShabadId": "12648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਹ ਛਲ ਨਾਰਿ ਨਿਕਾਰਾ ਮਿਤ੍ਰ ॥",
      "transliteration": "jeh chhal naar nikaaraa mitr ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਛਲ ਨਾਲ ਇਸਤਰੀ ਨੇ ਯਾਰ ਨੂੰ ਕਢ ਦਿੱਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "जिह छल नारि निकारा मित्र ॥",
      "sourceLineId": "136120",
      "sourceShabadId": "12648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪੂਰਬ ਦੇਸ ਅਪੂਰਬ ਨਗਰੀ ॥",
      "transliteration": "poorab dhes apoorab nagaree ||",
      "translation": "",
      "punjabiViakhya": "ਪੂਰਬ ਦੇਸ ਵਿਚ ਇਕ ਅਦੁੱਤੀ ਨਗਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "पूरब देस अपूरब नगरी ॥",
      "sourceLineId": "136121",
      "sourceShabadId": "12648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਿਹੂੰ ਭਵਨ ਕੇ ਬੀਚ ਉਜਗਰੀ ॥੧॥",
      "transliteration": "tihoo(n) bhavan ke beech ujagaree ||1||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਤਿੰਨਾ ਲੋਕਾ ਵਿਚ ਪ੍ਰਸਿੱਧ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "तिहूँ भवन के बीच उजगरी ॥१॥",
      "sourceLineId": "136122",
      "sourceShabadId": "12648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਿਵ ਪ੍ਰਸਾਦ ਰਾਜਾ ਤਹ ਕੋ ਹੈ ॥",
      "transliteration": "siv prasaadh raajaa teh ko hai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਦਾ ਰਾਜਾ ਸ਼ਿਵ ਪ੍ਰਸਾਦ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "सिव प्रसाद राजा तह को है ॥",
      "sourceLineId": "136123",
      "sourceShabadId": "12648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਦਾ ਸਰਬਦਾ ਸਿਵ ਰਤ ਸੋਹੈ ॥",
      "transliteration": "sadhaa sarabadhaa siv rat sohai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸਦਾ ਕੇਵਲ ਸ਼ਿਵ (ਦੀ ਉਪਾਸਨਾ) ਵਿਚ ਮਗਨ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "सदा सरबदा सिव रत सोहै ॥",
      "sourceLineId": "136124",
      "sourceShabadId": "12648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭਾਵਨ ਦੇ ਤਿਹ ਨਾਰਿ ਭਣਿਜੈ ॥",
      "transliteration": "bhaavan dhe teh naar bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪਤਨੀ ਦਾ ਨਾ ਭਾਵਨ ਦੇ (ਦੇਈ) ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "भावन दे तिह नारि भणिजै ॥",
      "sourceLineId": "136125",
      "sourceShabadId": "12648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਨ ਮੋਹਨਿ ਦੇ ਸੁਤਾ ਕਹਿਜੈ ॥੨॥",
      "transliteration": "man mohan dhe sutaa kahijai ||2||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਮੋਹਨੀ ਨਾ ਦੀ ਉਸ ਦੀ ਪੁੱਤਰੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "मन मोहनि दे सुता कहिजै ॥२॥",
      "sourceLineId": "136126",
      "sourceShabadId": "12648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਾਹ ਮਦਾਰ ਪੀਰ ਤਹ ਜਾਹਿਰ ॥",
      "transliteration": "saeh madhaar peer teh jaahir ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸ਼ਾਹ ਮਦਾਰ ਜ਼ਾਹਿਰਾ ਪੀਰ ਹੁੰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "साह मदार पीर तह जाहिर ॥",
      "sourceLineId": "136127",
      "sourceShabadId": "12648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੇਵਤ ਜਾਹਿ ਭੂਪ ਨਰ ਨਾਹਰ ॥",
      "transliteration": "sevat jaeh bhoop nar naahar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਪੁਰਸਾ ਦਾ ਸੁਆਮੀ ਰਾਜਾ ਪੂਜਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "सेवत जाहि भूप नर नाहर ॥",
      "sourceLineId": "136128",
      "sourceShabadId": "12648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਨ੍ਰਿਪ ਤਹਾ ਸਿਧਾਰਾ ॥",
      "transliteration": "ek dhivas nirap tahaa sidhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜਾ ਉਥੇ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "एक दिवस नृप तहा सिधारा ॥",
      "sourceLineId": "136129",
      "sourceShabadId": "12648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੁਹਿਤਾ ਸਹਿਤ ਲਏ ਸੰਗ ਦਾਰਾ ॥੩॥",
      "transliteration": "dhuhitaa sahit le sa(n)g dhaaraa ||3||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰੀ ਅਤੇ ਇਸਤਰੀ (ਦੋਹਾ ਨੂੰ) ਨਾਲ ਲੈ ਲਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "दुहिता सहित लए संग दारा ॥३॥",
      "sourceLineId": "136130",
      "sourceShabadId": "12648",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "136131",
      "sourceShabadId": "12649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਏਕ ਪੁਰਖ ਨ੍ਰਿਪ ਕੀ ਦੁਹਿਤਾ ਕਹਿ ਭਾਇਯੋ ॥",
      "transliteration": "ek purakh nirap kee dhuhitaa keh bhaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੀ ਪੁੱਤਰੀ ਨੂੰ ਇਕ ਬੰਦਾ ਚੰਗਾ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "एक पुरख नृप की दुहिता कहि भाइयो ॥",
      "sourceLineId": "136132",
      "sourceShabadId": "12649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਤਾ ਕਹ ਤਹੀ ਬੁਲਾਇਯੋ ॥",
      "transliteration": "paThai sahacharee taa keh tahee bulaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਉਥੇ ਹੀ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी ता कह तही बुलाइयो ॥",
      "sourceLineId": "136133",
      "sourceShabadId": "12649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਹੀ ਕਾਮ ਕੇ ਕੇਲ ਤਰੁਨਿ ਤਾ ਸੌ ਕਿਯੋ ॥",
      "transliteration": "tahee kaam ke kel tarun taa sau kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਸ ਨਾਲ ਉਥੇ ਹੀ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "तही काम के केल तरुनि ता सौ कियो ॥",
      "sourceLineId": "136134",
      "sourceShabadId": "12649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹੋ ਹਸਿ ਹਸਿ ਕਰਿ ਆਸਨ ਤਾ ਕੋ ਕਸਿ ਕਸਿ ਲਿਯੋ ॥੪॥",
      "transliteration": "ho has has kar aasan taa ko kas kas liyo ||4||",
      "translation": "",
      "punjabiViakhya": "ਹਸ ਹਸ ਕੇ ਉਸ ਨਾਲ ਕਸ ਕਸ ਕੇ ਆਸਣ ਲਏ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "हो हसि हसि करि आसन ता को कसि कसि लियो ॥४॥",
      "sourceLineId": "136135",
      "sourceShabadId": "12649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪੀਰ ਚੂਰਮਾ ਹੇਤ ਜੁ ਭੂਪ ਬਨਾਇਯੋ ॥",
      "transliteration": "peer chooramaa het ju bhoop banaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਪੀਰ ਲਈ ਜੋ ਚੂਰਮਾ ਬਣਾਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "पीर चूरमा हेत जु भूप बनाइयो ॥",
      "sourceLineId": "136136",
      "sourceShabadId": "12649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਧਿਕ ਭਾਗ ਕੌ ਤਾ ਮਹਿ ਤਰੁਨਿ ਮਿਲਾਇਯੋ ॥",
      "transliteration": "adhik bhaag kau taa meh tarun milaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਿਚ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਬਹੁਤ ਸਾਰੀ ਭੰਗ ਮਿਲਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "अधिक भाग कौ ता महि तरुनि मिलाइयो ॥",
      "sourceLineId": "136137",
      "sourceShabadId": "12649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਭ ਸੋਫੀ ਤਿਹ ਖਾਇ ਦਿਵਾਨੇ ਹ੍ਵੈ ਪਰੇ ॥",
      "transliteration": "sabh sofee teh khai dhivaane havai pare ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸੋਫ਼ੀ (ਪਰਹੇਜ਼ਗਾਰ) ਉਸ ਨੂੰ ਖਾ ਕੇ ਦੀਵਾਨੇ ਹੋ ਕੇ ਡਿਗ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "सभ सोफी तिह खाइ दिवाने ह्वै परे ॥",
      "sourceLineId": "136138",
      "sourceShabadId": "12649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹੋ ਜਾਨੁ ਪ੍ਰਹਾਰ ਬਿਨਾ ਸਗਰੇ ਆਪੇ ਮਰੇ ॥੫॥",
      "transliteration": "ho jaan prahaar binaa sagare aape mare ||5||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਸਟ ਵਜਣ ਤੋਂ ਬਿਨਾ ਹੀ ਸਾਰੇ ਮਰ ਗਏ ਹੋਣ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "हो जानु प्रहार बिना सगरे आपे मरे ॥५॥",
      "sourceLineId": "136139",
      "sourceShabadId": "12649",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136140",
      "sourceShabadId": "12650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੋਫੀ ਭਏ ਸਭੇ ਮਤਵਾਰੇ ॥",
      "transliteration": "sofee bhe sabhe matavaare ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਸੋਫ਼ੀ ਮਤਵਾਲੇ ਹੋ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "सोफी भए सभे मतवारे ॥",
      "sourceLineId": "136141",
      "sourceShabadId": "12650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਨੁ ਕਰ ਪਰੇ ਬੀਰ ਰਨ ਮਾਰੇ ॥",
      "transliteration": "jan kar pare beer ran maare ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਸੂਰਮੇ ਮਾਰੇ ਹੋਏ ਪਏ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "जनु कर परे बीर रन मारे ॥",
      "sourceLineId": "136142",
      "sourceShabadId": "12650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਇਤ ਘਾਤ ਪਛਾਨਾ ॥",
      "transliteration": "raaj sutaa it ghaat pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਇਹ ਮੌਕਾ ਤਾੜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "राज सुता इत घात पछाना ॥",
      "sourceLineId": "136143",
      "sourceShabadId": "12650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਉਠ ਪ੍ਰੀਤਮ ਸੰਗ ਕਿਯਾ ਪਯਾਨਾ ॥੬॥",
      "transliteration": "auTh preetam sa(n)g kiyaa payaanaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਠ ਕੇ ਪ੍ਰੀਤਮ ਨਾਲ ਚਲੀ ਗਈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "उठ प्रीतम संग किया पयाना ॥६॥",
      "sourceLineId": "136144",
      "sourceShabadId": "12650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੋਫੀ ਕਿਨੂੰ ਨ ਆਂਖਿ ਉਘਾਰੀ ॥",
      "transliteration": "sofee kinoo(n) na aa(n)kh ughaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਸੋਫ਼ੀ ਨੇ ਅੱਖ ਨਾ ਖੋਲ੍ਰਹੀ। (ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "सोफी किनूँ न आँखि उघारी ॥",
      "sourceLineId": "136145",
      "sourceShabadId": "12650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਲਾਤ ਜਾਨੁ ਸੈਤਾਨ ਪ੍ਰਹਾਰੀ ॥",
      "transliteration": "laat jaan saitaan prahaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸ਼ੈਤਾਨ ਨੇ ਲਤ ਮਾਰ ਕੇ (ਸਭ ਨੂੰ ਸੰਵਾ ਦਿੱਤਾ ਹੋਵੇ)",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "लात जानु सैतान प्रहारी ॥",
      "sourceLineId": "136146",
      "sourceShabadId": "12650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨਹੂੰ ਪਾਯੋ ॥",
      "transliteration": "bhedh abhedh na kinahoo(n) paayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न किनहूँ पायो ॥",
      "sourceLineId": "136147",
      "sourceShabadId": "12650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰਾਜ ਕੁਅਰਿ ਲੈ ਮੀਤ ਸਿਧਾਯੋ ॥੭॥",
      "transliteration": "raaj kuar lai meet sidhaayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਲੈ ਕੇ ਚਲਾ ਗਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "राज कुअरि लै मीत सिधायो ॥७॥",
      "sourceLineId": "136148",
      "sourceShabadId": "12650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਉਨਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੫੯॥੬੫੭੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau unasaTh charitr samaapatam sat subham sat ||359||6572||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੫੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੫੯॥੬੫੭੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ उनसठि चरित्र समापतम सतु सुभम सतु ॥३५९॥६५७२॥अफजूँ॥",
      "sourceLineId": "136149",
      "sourceShabadId": "12650",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136150",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਔਰ ਪ੍ਰਸੰਗਾ ॥",
      "transliteration": "sun raajaa ik aauar prasa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਹੋਰ (ਛਲ ਵਾਲਾ) ਪ੍ਰਸੰਗ ਸੁਣੋ",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा इक और प्रसंगा ॥",
      "sourceLineId": "136151",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਸ ਕਿਯ ਸੁਤਾ ਪਿਤਾ ਕੇ ਸੰਗਾ ॥",
      "transliteration": "jas kiy sutaa pitaa ke sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਪੁੱਤਰੀ ਨੇ ਪਿਤਾ ਨਾਲ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "जस किय सुता पिता के संगा ॥",
      "sourceLineId": "136152",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਬਲ ਸਿੰਘ ਰਾਜਾ ਇਕ ਅਤਿ ਬਲ ॥",
      "transliteration": "prabal si(n)gh raajaa ik at bal ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਬਲ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਬਹੁਤ ਬਲਵਾਨ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "प्रबल सिंघ राजा इक अति बल ॥",
      "sourceLineId": "136153",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਰਿ ਕਾਪਤ ਜਾ ਕੇ ਡਰ ਜਲ ਥਲ ॥੧॥",
      "transliteration": "ar kaapat jaa ke ddar jal thal ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਡਰ ਕਰ ਕੇ ਜਲ ਥਲ ਵਿਚ ਵੈਰੀ ਕੰਬਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "अरि कापत जा के डर जल थल ॥१॥",
      "sourceLineId": "136154",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸ੍ਰੀ ਝਕਝੂਮਕ ਦੇ ਤਿਹ ਬਾਰਿ ॥",
      "transliteration": "sree jhakajhoomak dhe teh baar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਝਕਝੂਮਕ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਬਾਲਿਕਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "स्री झकझूमक दे तिह बारि ॥",
      "sourceLineId": "136155",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਘੜੀ ਆਪੁ ਜਨੁ ਬ੍ਰਹਮ ਸੁ ਨਾਰ ॥",
      "transliteration": "ghaRee aap jan braham su naar ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਬ੍ਰਹਮਾ ਨੇ ਉਸ ਇਸਤਰੀ ਨੂੰ ਆਪ ਘੜਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "घड़ी आपु जनु ब्रहम सु नार ॥",
      "sourceLineId": "136156",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਹ ਥੋ ਸੁਘਰ ਸੈਨ ਖਤਿਰੇਟਾ ॥",
      "transliteration": "teh tho sughar sain khatireTaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸੁਘਰ ਸੈਨ ਨਾ ਦਾ ਖਤਰੀ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "तह थो सुघर सैन खतिरेटा ॥",
      "sourceLineId": "136157",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਸਕ ਮੁਸਕ ਕੇ ਸਾਥ ਲਪੇਟਾ ॥੨॥",
      "transliteration": "eisak musak ke saath lapeTaa ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸ਼ਕ ਮੁਸ਼ਕ ਵਿਚ ਲਿਪਟਿਆ ਹੋਇਆ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "इसक मुसक के साथ लपेटा ॥२॥",
      "sourceLineId": "136158",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਗੰਨਾਥ ਕਹ ਭੂਪ ਸਿਧਾਯੋ ॥",
      "transliteration": "jaga(n)naath keh bhoop sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਰਾਜਾ ਜਗਨ ਨਾਥ (ਮੰਦਿਰ ਦੀ ਯਾਤ੍ਰਾ) ਨੂੰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "जगंनाथ कह भूप सिधायो ॥",
      "sourceLineId": "136159",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪੁਤ੍ਰ ਕਲਤ੍ਰ ਸੰਗ ਲੈ ਆਯੋ ॥",
      "transliteration": "putr kalatr sa(n)g lai aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪੁੱਤਰ ਅਤੇ ਇਸਤਰੀਆਂ ਨੂੰ ਨਾਲ ਲੈ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "पुत्र कलत्र संग लै आयो ॥",
      "sourceLineId": "136160",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਗੰਨਾਥ ਕੋ ਨਿਰਖ ਦਿਵਾਲਾ ॥",
      "transliteration": "jaga(n)naath ko nirakh dhivaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਨ ਨਾਥ ਦਾ ਮੰਦਿਰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "जगंनाथ को निरख दिवाला ॥",
      "sourceLineId": "136161",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1311_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਚਨ ਬਖਾਨਾ ਭੂਪ ਉਤਾਲਾ ॥੩॥",
      "transliteration": "bachan bakhaanaa bhoop utaalaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਝਟਪਟ ਬਚਨ ਕਿਹਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1311,
      "hindi": "",
      "hindiTransliteration": "बचन बखाना भूप उताला ॥३॥",
      "sourceLineId": "136162",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
