{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1312,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1312_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਮਰੋ ਪਾਪ ਪੁਰਾਤਨ ਗਯੋ ॥",
      "transliteration": "hamaro paap puraatan gayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਪੁਰਾਤਨ ਪਾਪ ਖ਼ਤਮ ਹੋ ਗਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "हमरो पाप पुरातन गयो ॥",
      "sourceLineId": "136163",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਫਲ ਜਨਮ ਹਮਰੋ ਅਬ ਭਯੋ ॥",
      "transliteration": "safal janam hamaro ab bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰਾ ਜਨਮ ਹੁਣ ਸਫਲ ਹੋ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "सफल जनम हमरो अब भयो ॥",
      "sourceLineId": "136164",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਗੰਨਾਥ ਕੋ ਪਾਯੋ ਦਰਸਨ ॥",
      "transliteration": "jaga(n)naath ko paayo dharasan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਜਗਨ ਨਾਥ ਦਾ ਦਰਸ਼ਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "जगंनाथ को पायो दरसन ॥",
      "sourceLineId": "136165",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਔਰ ਕਰਾ ਹਾਥਨ ਪਗ ਪਰਸਨ ॥੪॥",
      "transliteration": "aauar karaa haathan pag parasan ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੱਥਾ ਨਾਲ ਪੈਰਾ ਨੂੰ ਛੋਹਿਆ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "और करा हाथन पग परसन ॥४॥",
      "sourceLineId": "136166",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਬ ਲਗ ਭੂਪ ਸੁਤਾ ਤਹ ਆਈ ॥",
      "transliteration": "tab lag bhoop sutaa teh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਰਾਜੇ ਦੀ ਪੁੱਤਰੀ ਉਥੇ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "तब लग भूप सुता तह आई ॥",
      "sourceLineId": "136167",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਿਤਾ ਸੁਨਤ ਅਸ ਕਹਾ ਸੁਨਾਈ ॥",
      "transliteration": "pitaa sunat as kahaa sunaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਪਿਤਾ ਨੂੰ ਸੁਣਾਉਾਂਦੇ ਹੋਇਆਂ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "पिता सुनत अस कहा सुनाई ॥",
      "sourceLineId": "136168",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਨਿ ਮੈ ਸੈਨ ਆਜੁ ਹਿਯਾ ਕਰਿ ਹੋ ॥",
      "transliteration": "sun mai sain aaj hiyaa kar ho ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਣੋ! ਮੈਂ ਅਜ ਇਥੇ ਹੀ ਸੰਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "सुनि मै सैन आजु हिया करि हो ॥",
      "sourceLineId": "136169",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਹ ਏ ਕਹੈ ਤਿਸੀ ਕਹ ਬਰਿ ਹੋ ॥੫॥",
      "transliteration": "jeh e kahai tisee keh bar ho ||5||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਜਗਨ ਨਾਥ ਕਹਿਣ ਗੇ, ਉਸੇ ਨਾਲ ਵਿਆਹ ਕਰਾਗੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "जिह ए कहै तिसी कह बरि हो ॥५॥",
      "sourceLineId": "136170",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪ੍ਰਾਤ ਉਠੀ ਤਹ ਤੇ ਸੋਈ ਜਬ ॥",
      "transliteration": "praat uThee teh te soiee jab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਥੇ ਸੁੱਤੀ ਹੋਈ (ਉਹ) ਸਵੇਰੇ ਜਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "प्रात उठी तह ते सोई जब ॥",
      "sourceLineId": "136171",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਚਨ ਕਹਾ ਪਿਤ ਸੰਗ ਇਹ ਬਿਧਿ ਤਬ ॥",
      "transliteration": "bachan kahaa pit sa(n)g ieh bidh tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਪਿਤਾ ਨਾਲ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "बचन कहा पित संग इह बिधि तब ॥",
      "sourceLineId": "136172",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੁਘਰ ਸੈਨ ਖਤ੍ਰੀ ਜੋ ਆਹੀ ॥",
      "transliteration": "sughar sain khatree jo aahee ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਘਰ ਸੈਨ ਨਾ ਦਾ ਜੋ ਛਤ੍ਰੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "सुघर सैन खत्री जो आही ॥",
      "sourceLineId": "136173",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਗੰਨਾਥ ਦੀਨੀ ਮੈ ਤਾਹੀ ॥੬॥",
      "transliteration": "jaga(n)naath dheenee mai taahee ||6||",
      "translation": "",
      "punjabiViakhya": "ਜਗਨ ਨਾਥ ਨੇ ਮੈਨੂੰ ਉਸ ਨੂੰ ਦੇ ਦਿੱਤਾ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "जगंनाथ दीनी मै ताही ॥६॥",
      "sourceLineId": "136174",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਜੈ ਬਚਨ ਸੁਨਾ ਇਹ ਬਿਧਿ ਜਬ ॥",
      "transliteration": "raajai bachan sunaa ieh bidh jab ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਜਦ ਇਸ ਤਰ੍ਰਹਾ ਬਚਨ ਸੁਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "राजै बचन सुना इह बिधि जब ॥",
      "sourceLineId": "136175",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਐਸ ਕਹਾ ਦੁਹਿਤਾ ਕੇ ਸੰਗ ਤਬ ॥",
      "transliteration": "aais kahaa dhuhitaa ke sa(n)g tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਪੁੱਤਰੀ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "ऐस कहा दुहिता के संग तब ॥",
      "sourceLineId": "136176",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਗੰਨਾਥ ਜਾ ਕਹ ਤੂ ਦੀਨੀ ॥",
      "transliteration": "jaga(n)naath jaa keh too dheenee ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਨ ਨਾਥ ਨੇ ਜਿਸ ਨੂੰ ਤੂੰ ਦਿੱਤੀ ਹੈਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "जगंनाथ जा कह तू दीनी ॥",
      "sourceLineId": "136177",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਮ ਸੌ ਜਾਤ ਨ ਤਾ ਸੌ ਲੀਨੀ ॥੭॥",
      "transliteration": "ham sau jaat na taa sau leenee ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਕੋਲੋਂ ਮੈਂ ਵਾਪਸ ਨਹੀਂ ਲੈ ਸਕਦਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "हम सौ जात न ता सौ लीनी ॥७॥",
      "sourceLineId": "136178",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਛੁ ਜੜ ਪਾਯੋ ॥",
      "transliteration": "bhedh abhedh na kachh jaR paayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੇ ਕੁਝ ਭੇਦ ਅਭੇਦ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न कछु जड़ पायो ॥",
      "sourceLineId": "136179",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਹ ਛਲ ਅਪਨਾ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥",
      "transliteration": "eeh chhal apanaa moo(n)dd mu(n)ddaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਆਪਣਾ ਸਿਰ ਮੁੰਨਵਾ ਲਿਆ (ਭਾਵ ਠਗਿਆ ਗਿਆ)।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "इह छल अपना मूँड मुँडायो ॥",
      "sourceLineId": "136180",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਗੰਨਾਥ ਕੋ ਬਚਨ ਪਛਾਨਾ ॥",
      "transliteration": "jaga(n)naath ko bachan pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ) ਜਗਨ ਨਾਥ ਦਾ ਬਚਨ ਮੰਨਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "जगंनाथ को बचन पछाना ॥",
      "sourceLineId": "136181",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਲੈ ਮੀਤ ਸਿਧਾਨਾ ॥੮॥",
      "transliteration": "raaj sutaa lai meet sidhaanaa ||8||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ (ਸੁਘਰ ਸੈਨ) ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਲੈ ਕੇ ਚਲਾ ਗਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "राज सुता लै मीत सिधाना ॥८॥",
      "sourceLineId": "136182",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਾਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੦॥੬੫੮੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau saaTh charitr samaapatam sat subham sat ||360||6580||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੬੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੬੦॥੬੫੮੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ साठ चरित्र समापतम सतु सुभम सतु ॥३६०॥६५८०॥अफजूँ॥",
      "sourceLineId": "136183",
      "sourceShabadId": "12651",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136184",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਕਥਾ ਪੁਰਾਤਨ ॥",
      "transliteration": "sun raajaa ik kathaa puraatan ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! (ਤੁਹਾਨੂੰ) ਇਕ ਪੁਰਾਤਨ ਕਥਾ ਸੁਣਾਉਾਂਦਾ ਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा इक कथा पुरातन ॥",
      "sourceLineId": "136185",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਪੰਡਿਤ ਕਹਤ ਮਹਾ ਮੁਨਿ ॥",
      "transliteration": "jeh bidh pa(n)ddit kahat mahaa mun ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਪੰਡਿਤਾ ਅਤੇ ਮਹਾ ਮੁਨੀਆਂ ਨੇ ਕਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि पंडित कहत महा मुनि ॥",
      "sourceLineId": "136186",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਏਕ ਮਹੇਸ੍ਰ ਸਿੰਘ ਰਾਜਾਨਾ ॥",
      "transliteration": "ek mahesr si(n)gh raajaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਮਹੇਸ੍ਰ ਸਿੰਘ ਨਾ ਦਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "एक महेस्र सिंघ राजाना ॥",
      "sourceLineId": "136187",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਡੰਡ ਦੇਤ ਜਾ ਕੋ ਨ੍ਰਿਪ ਨਾਨਾ ॥੧॥",
      "transliteration": "dda(n)dd dhet jaa ko nirap naanaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਅਗੇ ਅਨੇਕ ਰਾਜੇ ਕਰ ਭਰਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "डंड देत जा को नृप नाना ॥१॥",
      "sourceLineId": "136188",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਗਰ ਮਹੇਸ੍ਰਾਵਤਿ ਤਹ ਰਾਜਤ ॥",
      "transliteration": "nagar mahesraavat teh raajat ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਮਹੇਸ੍ਰਾਵਤੀ ਨਾ ਦਾ ਇਕ ਨਗਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "नगर महेस्रावति तह राजत ॥",
      "sourceLineId": "136189",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਮਰਾਵਤਿ ਜਹ ਦੁਤਿਯ ਬਿਰਾਜਤ ॥",
      "transliteration": "amaraavat jeh dhutiy biraajat ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਨਗਰ ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਦੂਜੀ ਅਮਰਾਵਤੀ ਸੁਸ਼ੋਭਿਤ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "अमरावति जह दुतिय बिराजत ॥",
      "sourceLineId": "136190",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾ ਕੀ ਜਾਤ ਨ ਉਪਮਾ ਕਹੀ ॥",
      "transliteration": "taa kee jaat na upamaa kahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਉਪਮਾ ਦਾ ਬਿਆਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "ता की जात न उपमा कही ॥",
      "sourceLineId": "136191",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਲਕਾ ਨਿਰਖਿ ਥਕਿਤ ਤਿਹ ਰਹੀ ॥੨॥",
      "transliteration": "alakaa nirakh thakit teh rahee ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਅਲਕਾ (ਕੁਬੇਰ ਦੀ ਪੁਰੀ) ਵੀ ਵੇਖ ਵੇਖ ਕੇ ਥਕ ਜਾਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "अलका निरखि थकित तिह रही ॥२॥",
      "sourceLineId": "136192",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗਜ ਗਾਮਿਨਿ ਦੇ ਸੁਤਾ ਭਨਿਜੈ ॥",
      "transliteration": "gaj gaamin dhe sutaa bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪੁੱਤਰੀ ਨੂੰ ਗਜ ਗਾਮਿਨੀ ਦੇ (ਦੇਈ) ਕਿਹਾ ਜਾਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "गज गामिनि दे सुता भनिजै ॥",
      "sourceLineId": "136193",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੰਦ੍ਰ ਸੂਰ ਪਟਤਰ ਮੁਖ ਦਿਜੈ ॥",
      "transliteration": "cha(n)dhr soor paTatar mukh dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਮੁਖ ਦੀ ਉਪਮਾ ਚੰਦ੍ਰਮਾ ਅਤੇ ਸੂਰਜ ਨਾਲ ਦਿੱਤੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "चंद्र सूर पटतर मुख दिजै ॥",
      "sourceLineId": "136194",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਕੀ ਜਾਤ ਨ ਪ੍ਰਭਾ ਬਖਾਨੀ ॥",
      "transliteration": "taa kee jaat na prabhaa bakhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਬਖਾਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "ता की जात न प्रभा बखानी ॥",
      "sourceLineId": "136195",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਥਕਿਤ ਰਹਤ ਰਾਜਾ ਅਰੁ ਰਾਨੀ ॥੩॥",
      "transliteration": "thakit rahat raajaa ar raanee ||3||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਅਤੇ ਰਾਣੀ ਵੀ (ਉਸ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ) ਥਕ ਜਾਦੇ ਸਨ (ਅਰਥਾਤ-ਉਸ ਤੋਂ ਵਾਰਨੇ ਜਾਦੇ ਸਨ) ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "थकित रहत राजा अरु रानी ॥३॥",
      "sourceLineId": "136196",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਾ ਕੀ ਲਗਨ ਏਕ ਸੋ ਲਾਗੀ ॥",
      "transliteration": "taa kee lagan ek so laagee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਪ੍ਰੇਮ ਇਕ (ਵਿਅਕਤੀ) ਨਾਲ ਹੋ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "ता की लगन एक सो लागी ॥",
      "sourceLineId": "136197",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨੀਂਦ ਭੂਖਿ ਜਾ ਤੇ ਸਭ ਭਾਗੀ ॥",
      "transliteration": "nee(n)dh bhookh jaa te sabh bhaagee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਉਸ ਦੀ ਨੀਂਦਰ ਅਤੇ ਭੁਖ ਖ਼ਤਮ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "नींद भूखि जा ते सभ भागी ॥",
      "sourceLineId": "136198",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗਾਜੀ ਰਾਇ ਤਵਨ ਕੋ ਨਾਮਾ ॥",
      "transliteration": "gaajee rai tavan ko naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਵਿਅਕਤੀ) ਦਾ ਨਾ ਗਾਜੀ ਰਾਇ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "गाजी राइ तवन को नामा ॥",
      "sourceLineId": "136199",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਥਕਿਤ ਰਹਤ ਜਾ ਕੌ ਲਿਖ ਬਾਮਾ ॥੪॥",
      "transliteration": "thakit rahat jaa kau likh baamaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਇਸਤਰੀਆਂ ਥਕੀਆਂ ਰਹਿ ਜਾਦੀਆਂ ਸਨ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "थकित रहत जा कौ लिख बामा ॥४॥",
      "sourceLineId": "136200",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਔਰ ਘਾਤ ਜਬ ਹਾਥ ਨ ਆਈ ॥",
      "transliteration": "aauar ghaat jab haath na aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਹੋਰ ਕੋਈ ਦਾਓ ਨਾ ਲਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "और घात जब हाथ न आई ॥",
      "sourceLineId": "136201",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਏਕ ਨਾਵ ਤਵ ਨਿਕਟ ਮੰਗਾਈ ॥",
      "transliteration": "ek naav tav nikaT ma(n)gaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ (ਗਾਜੀ ਰਾਇ ਨੇ) ਆਪਣੇ ਪਾਸ ਇਕ ਬੇੜੀ ਮੰਗਵਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "एक नाव तव निकट मंगाई ॥",
      "sourceLineId": "136202",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਾਜ ਕੁਅਰਿ ਤਿਹ ਰਾਖਾ ਨਾਮਾ ॥",
      "transliteration": "raaj kuar teh raakhaa naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਬੇੜੀ) ਦਾ ਨਾ 'ਰਾਜ ਕੁਮਾਰੀ' ਰਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "राज कुअरि तिह राखा नामा ॥",
      "sourceLineId": "136203",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਾਨਤ ਸਕਲ ਪੁਰਖ ਅਰੁ ਬਾਮਾ ॥੫॥",
      "transliteration": "jaanat sakal purakh ar baamaa ||5||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਗੱਲ) ਸਾਰੀਆਂ ਇਸਤਰੀਆਂ ਅਤੇ ਪੁਰਸ਼ ਜਾਣਨ ਲਗੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "जानत सकल पुरख अरु बामा ॥५॥",
      "sourceLineId": "136204",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗਾਜੀ ਰਾਇ ਬੈਠਿ ਤਿਹ ਊਪਰ ॥",
      "transliteration": "gaajee rai baiTh teh uoopar ||",
      "translation": "",
      "punjabiViakhya": "ਗਾਜੀ ਰਾਇ ਉਸ (ਬੇੜੀ) ਉਰ ਬੈਠ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "गाजी राइ बैठि तिह ऊपर ॥",
      "sourceLineId": "136205",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਿਕਸਾ ਆਇ ਭੂਪ ਮਹਲਨ ਤਰ ॥",
      "transliteration": "nikasaa aai bhoop mahalan tar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਤਰਦਾ ਤਰਦਾ) ਰਾਜੇ ਦੇ ਮੱਹਲਾ ਦੇ ਹੇਠਾ ਆ ਪਹੁੰਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "निकसा आइ भूप महलन तर ॥",
      "sourceLineId": "136206",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਲੈਨੀ ਹੋਇ ਨਾਵ ਤੌ ਲੀਜੈ ॥",
      "transliteration": "lainee hoi naav tau leejai ||",
      "translation": "",
      "punjabiViakhya": "(ਆ ਕੇ ਕਹਿਣ ਲਗਾ ਕਿ) ਜੇ ਬੇੜੀ ਲੈਣੀ ਹੋਵੇ ਤਾ ਲੈ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "लैनी होइ नाव तौ लीजै ॥",
      "sourceLineId": "136207",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਤਰੁ ਮੋਹਿ ਉਤਰ ਕਛੁ ਦੀਜੈ ॥੬॥",
      "transliteration": "naatar moh utar kachh dheejai ||6||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਮੈਨੂੰ ਕੁਝ ਉੱਤਰ ਦਿਓ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "नातरु मोहि उतर कछु दीजै ॥६॥",
      "sourceLineId": "136208",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੈ ਲੈ ਰਾਜ ਕੁਅਰਿ ਕੌ ਜਾਊ ॥",
      "transliteration": "mai lai raaj kuar kau jaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਰਾਜ ਕੁਮਾਰੀ (ਭਾਵ ਬੇੜੀ) ਨੂੰ ਲੈ ਜਾਵਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "मै लै राज कुअरि कौ जाऊ ॥",
      "sourceLineId": "136209",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬੇਚੌ ਜਾਇ ਔਰ ਹੀ ਗਾਊ ॥",
      "transliteration": "bechau jai aauar hee gaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਹੋਰ ਪਿੰਡ ਵਿਚ ਜਾ ਵੇਚਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "बेचौ जाइ और ही गाऊ ॥",
      "sourceLineId": "136210",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਲੈਨੀ ਹੋਇ ਨਾਵ ਤਬ ਲੀਜੈ ॥",
      "transliteration": "lainee hoi naav tab leejai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਬੇੜੀ ਲੈਣੀ ਹੋਵੇ ਤਦ ਲਵੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "लैनी होइ नाव तब लीजै ॥",
      "sourceLineId": "136211",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਤਰ ਹਮੈ ਬਿਦਾ ਕਰਿ ਦੀਜੈ ॥੭॥",
      "transliteration": "naatar hamai bidhaa kar dheejai ||7||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਮੈਨੂੰ ਵਿਦਾ ਕਰ ਦਿਓ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "नातर हमै बिदा करि दीजै ॥७॥",
      "sourceLineId": "136212",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮੂਰਖ ਭੂਪ ਬਾਤ ਨਹਿ ਪਾਈ ॥",
      "transliteration": "moorakh bhoop baat neh paiee ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜੇ ਨੇ ਗੱਲ ਨਾ ਸਮਝੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "मूरख भूप बात नहि पाई ॥",
      "sourceLineId": "136213",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਬੀਤਾ ਦਿਨ ਰਜਨੀ ਹ੍ਵੈ ਆਈ ॥",
      "transliteration": "beetaa dhin rajanee havai aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਨ ਬੀਤ ਗਿਆ ਅਤੇ ਰਾਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "बीता दिन रजनी ह्वै आई ॥",
      "sourceLineId": "136214",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਤਬ ਦੇਗ ਮੰਗਾਇ ॥",
      "transliteration": "raaj sutaa tab dheg ma(n)gai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਤਦ ਦੇਗ ਮੰਗਵਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "राज सुता तब देग मंगाइ ॥",
      "sourceLineId": "136215",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਬੈਠੀ ਬੀਚ ਤਵਨ ਕੇ ਜਾਇ ॥੮॥",
      "transliteration": "baiThee beech tavan ke jai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਵਿਚ ਜਾ ਕੇ ਬੈਠ ਗਈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "बैठी बीच तवन के जाइ ॥८॥",
      "sourceLineId": "136216",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਛਿਦ੍ਰ ਮੂੰਦਿ ਨੌਕਾ ਤਰ ਬਾਧੀ ॥",
      "transliteration": "chhidhr moo(n)dh nauakaa tar baadhee ||",
      "translation": "",
      "punjabiViakhya": "(ਦੇਗ ਦਾ) ਮੂੰਹ ਬੰਦ ਕਰ ਕੇ ਬੇੜੀ ਨਾਲ ਬੰਨ੍ਰਹ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "छिद्र मूँदि नौका तर बाधी ॥",
      "sourceLineId": "136217",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਛੋਰੀ ਤਬੈ ਬਹੀ ਜਬ ਆਂਧੀ ॥",
      "transliteration": "chhoree tabai bahee jab aa(n)dhee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਬੇੜੀ ਨੂੰ) ਤਦ ਛਡਿਆ ਜਦ ਅੱਧ ਵਿਚਾਲੇ ਪਹੁੰਚ ਗਈ (ਅਰਥਾਤਰ- ਜਦ ਹਨੇਰੀ ਵਗਣ ਲਗ ਗਈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "छोरी तबै बही जब आँधी ॥",
      "sourceLineId": "136218",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਬ ਨ੍ਰਿਪ ਪ੍ਰਾਤ ਦਿਵਾਨ ਲਗਾਯੋ ॥",
      "transliteration": "jab nirap praat dhivaan lagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਸਵੇਰੇ ਦੀਵਾਨ ਲਗਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "जब नृप प्रात दिवान लगायो ॥",
      "sourceLineId": "136219",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤਬ ਤਿਨ ਤਹ ਇਕ ਮਨੁਖ ਪਠਾਯੋ ॥੯॥",
      "transliteration": "tab tin teh ik manukh paThaayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ (ਬੇੜੀ ਵਾਲੇ) ਨੇ ਉਥੇ ਇਕ ਬੰਦਾ ਭੇਜਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "तब तिन तह इक मनुख पठायो ॥९॥",
      "sourceLineId": "136220",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜੌ ਤੁਮ ਨਾਵ ਨ ਮੋਲ ਚੁਕਾਵਤ ॥",
      "transliteration": "jau tum naav na mol chukaavat ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੁਸੀਂ ਬੇੜੀ ਦਾ ਮੁੱਲ ਨਹੀਂ ਚੁਕਾਓਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "जौ तुम नाव न मोल चुकावत ॥",
      "sourceLineId": "136221",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਰਾਜ ਕੁਅਰਿ ਲੈ ਬਨਿਕ ਸਿਧਾਵਤ ॥",
      "transliteration": "raaj kuar lai banik sidhaavat ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੈਂ ਰਾਜ ਕੁਮਾਰੀ (ਬੇੜੀ) ਨੂੰ ਲੈ ਕੇ ਇਕ ਬਨ ਵਿਚ ਚਲਾ ਜਾਵਾਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "राज कुअरि लै बनिक सिधावत ॥",
      "sourceLineId": "136222",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਜਾਨਿ ਦੇਹੁ ਜੋ ਮੋਲ ਨ ਬਨੀ ॥",
      "transliteration": "jaan dheh jo mol na banee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ ਕਿਹਾ) ਜਾਣ ਦਿਓ, (ਸਾਡਾ) ਉਸ ਨਾਲ ਮੁੱਲ ਨਹੀਂ ਬਣਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "जानि देहु जो मोल न बनी ॥",
      "sourceLineId": "136223",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਮੇਰੇ ਘਰ ਨਵਕਾ ਹੈ ਘਨੀ ॥੧੦॥",
      "transliteration": "mere ghar navakaa hai ghanee ||10||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਪਾਸ (ਅਗੇ ਹੀ) ਬਹੁਤ ਬੇੜੀਆਂ ਹਨ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "मेरे घर नवका है घनी ॥१०॥",
      "sourceLineId": "136224",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਹਰੀ ਕੁਅਰਿ ਰਾਜਾ ਕੌ ਕਹਿ ਕੈ ॥",
      "transliteration": "haree kuar raajaa kau keh kai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਦਸ ਕੇ ਉਸ ਦੀ ਕੁਮਾਰੀ ਨੂੰ ਕਢ ਕੇ ਲੈ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "हरी कुअरि राजा कौ कहि कै ॥",
      "sourceLineId": "136225",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਮੂਰਖ ਸਕਾ ਭੇਦ ਨਹਿ ਲਹਿ ਕੈ ॥",
      "transliteration": "moorakh sakaa bhedh neh leh kai ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ (ਰਾਜਾ) ਭੇਦ ਨੂੰ ਸਮਝ ਨਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "मूरख सका भेद नहि लहि कै ॥",
      "sourceLineId": "136226",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਪ੍ਰਾਤ ਸੁਤਾ ਕੀ ਜਬ ਸੁਧਿ ਪਾਈ ॥",
      "transliteration": "praat sutaa kee jab sudh paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸਵੇਰੇ ਪੁੱਤਰੀ ਬਾਰੇ ਪਤਾ ਲਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "प्रात सुता की जब सुधि पाई ॥",
      "sourceLineId": "136227",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਬੈਠਿ ਰਹਾ ਮੂੰਡੀ ਨਿਹੁਰਾਈ ॥੧੧॥",
      "transliteration": "baiTh rahaa moo(n)ddee nihuraiee ||11||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਿਰ ਨੀਵਾ ਕਰ ਕੇ ਬੈਠ ਰਿਹਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "बैठि रहा मूँडी निहुराई ॥११॥",
      "sourceLineId": "136228",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕਸਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੧॥੬੫੯੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau ikasaTh charitr samaapatam sat subham sat ||361||6591||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੬੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੬੧॥੬੫੯੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ इकसठ चरित्र समापतम सतु सुभम सतु ॥३६१॥६५९१॥अफजूँ॥",
      "sourceLineId": "136229",
      "sourceShabadId": "12652",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136230",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸੁਨੁ ਭੂਪਤਿ ਇਕ ਕਥਾ ਬਚਿਤ੍ਰ ॥",
      "transliteration": "sun bhoopat ik kathaa bachitr ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਵਿਚਿਤ੍ਰ ਕਥਾ ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "सुनु भूपति इक कथा बचित्र ॥",
      "sourceLineId": "136231",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਕਿਯ ਇਕ ਨਾਰਿ ਚਰਿਤ੍ਰ ॥",
      "transliteration": "jeh bidh kiy ik naar charitr ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਇਕ ਨਾਰੀ ਨੇ ਚਰਿਤ੍ਰ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि किय इक नारि चरित्र ॥",
      "sourceLineId": "136232",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਗੁਲੋ ਇਕ ਖਤ੍ਰਾਨੀ ਆਹੀ ॥",
      "transliteration": "gulo ik khatraanee aahee ||",
      "translation": "",
      "punjabiViakhya": "ਗੁਲੋ ਨਾ ਦੀ ਇਕ ਖਤਰਾਣੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "गुलो इक खत्रानी आही ॥",
      "sourceLineId": "136233",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1312_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਜੇਠ ਮਲ ਛਤ੍ਰੀ ਕਹ ਬ੍ਯਾਹੀ ॥੧॥",
      "transliteration": "jeTh mal chhatree keh bayaahee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਜੇਠ ਮੱਲ ਨਾ ਦੇ ਛਤ੍ਰੀ ਨੂੰ ਵਿਆਹੀ ਹੋਈ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1312,
      "hindi": "",
      "hindiTransliteration": "जेठ मल छत्री कह ब्याही ॥१॥",
      "sourceLineId": "136234",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
