{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1313,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1313_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਾ ਕੌ ਔਰ ਪੁਰਖ ਇਕ ਭਾਯੋ ॥",
      "transliteration": "taa kau aauar purakh ik bhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਇਕ ਹੋਰ ਪੁਰਸ਼ ਚੰਗਾ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "ता कौ और पुरख इक भायो ॥",
      "sourceLineId": "136235",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਿਜੁ ਪਤਿ ਸੇਤੀ ਹੇਤੁ ਭੁਲਾਯੋ ॥",
      "transliteration": "nij pat setee het bhulaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਪਣੇ ਪਤੀ ਨਾਲ ਪ੍ਰੇਮ ਭੁਲਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "निजु पति सेती हेतु भुलायो ॥",
      "sourceLineId": "136236",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰੈਨਿ ਦਿਵਸ ਤਿਹ ਧਾਮ ਬੁਲਾਵੈ ॥",
      "transliteration": "rain dhivas teh dhaam bulaavai ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਨ ਰਾਤ ਉਸ ਨੂੰ ਘਰ ਵਿਚ ਬੁਲਾਉਾਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "रैनि दिवस तिह धाम बुलावै ॥",
      "sourceLineId": "136237",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਨ ਸਾਥ ਕਮਾਵੈ ॥੨॥",
      "transliteration": "kaam bhog tin saath kamaavai ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਕਾਮ-ਭੋਗ ਕਰਦੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिन साथ कमावै ॥२॥",
      "sourceLineId": "136238",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਕ ਦਿਨ ਸੁਧਿ ਤਾ ਕੇ ਪਤਿ ਪਾਈ ॥",
      "transliteration": "eik dhin sudh taa ke pat paiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਉਸ ਦੇ ਪਤੀ ਨੂੰ ਪਤਾ ਲਗ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "इक दिन सुधि ता के पति पाई ॥",
      "sourceLineId": "136239",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਤਾ ਸੰਗ ਕਰੀ ਲਰਾਈ ॥",
      "transliteration": "bahu bidh taa sa(n)g karee laraiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਸ ਨਾਲ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਲੜਾਈ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि ता संग करी लराई ॥",
      "sourceLineId": "136240",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਨਿਕ ਕਰੀ ਜੂਤਿਨ ਕੀ ਮਾਰਾ ॥",
      "transliteration": "anik karee jootin kee maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜੁਤੀਆਂ ਦੀ ਬਹੁਤ ਮਾਰ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "अनिक करी जूतिन की मारा ॥",
      "sourceLineId": "136241",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਬ ਤਿਨ ਇਹ ਬਿਧਿ ਚਰਿਤ ਬਿਚਾਰਾ ॥੩॥",
      "transliteration": "tab tin ieh bidh charit bichaaraa ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ (ਇਸਤਰੀ) ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਚਰਿਤ੍ਰ ਵਿਚਾਰਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "तब तिन इह बिधि चरित बिचारा ॥३॥",
      "sourceLineId": "136242",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾ ਦਿਨ ਤੇ ਨਿਜੁ ਪਤਿ ਕੌ ਤ੍ਯਾਗੀ ॥",
      "transliteration": "taa dhin te nij pat kau tayaagee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਿਨ ਤੋਂ ਉਸ ਨੇ ਪਤੀ ਨੂੰ ਤਿਆਗ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "ता दिन ते निजु पति कौ त्यागी ॥",
      "sourceLineId": "136243",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਾਥ ਫਕੀਰਨ ਕੇ ਅਨੁਰਾਗੀ ॥",
      "transliteration": "saath fakeeran ke anuraagee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫ਼ਕੀਰਾ ਨਾਲ ਪ੍ਰੇਮ-ਸੰਪਰਕ ਕਾਇਮ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "साथ फकीरन के अनुरागी ॥",
      "sourceLineId": "136244",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਵਾਹਿ ਅਤਿਥ ਕਰਿ ਕੈ ਸੰਗ ਲੀਨਾ ॥",
      "transliteration": "vaeh atith kar kai sa(n)g leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਿਅਕਤੀ ਨੂੰ ਸਾਧ ਬਣਾ ਕੇ ਨਾਲ ਲੈ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "वाहि अतिथ करि कै संग लीना ॥",
      "sourceLineId": "136245",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਔਰੈ ਦੇਸ ਪਯਾਨਾ ਕੀਨਾ ॥੪॥",
      "transliteration": "aauarai dhes payaanaa keenaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਦੋਵੇਾਂ) ਹੋਰ ਦੇਸ ਨੂੰ ਚਲੇ ਗਏ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "औरै देस पयाना कीना ॥४॥",
      "sourceLineId": "136246",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਹ ਜਿਹ ਦੇਸ ਆਪੁ ਪਗੁ ਧਾਰੈ ॥",
      "transliteration": "jeh jeh dhes aap pag dhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਜਿਥੇ (ਉਹ) ਵਿਅਕਤੀ ਆਪ ਪੈਰ ਧਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "जिह जिह देस आपु पगु धारै ॥",
      "sourceLineId": "136247",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਹੀ ਤਹੀ ਵਹੁ ਸੰਗ ਸਿਧਾਰੈ ॥",
      "transliteration": "tahee tahee vahu sa(n)g sidhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਉਥੇ ਹੀ ਉਹ ਨਾਲ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "तही तही वहु संग सिधारै ॥",
      "sourceLineId": "136248",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਔਰ ਪੁਰਖੁ ਤਿਹ ਅਤਿਥ ਪਛਾਨੈ ॥",
      "transliteration": "aauar purakh teh atith pachhaanai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਉਸ ਨੂੰ ਸਾਧ ਸਮਝਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "और पुरखु तिह अतिथ पछानै ॥",
      "sourceLineId": "136249",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰ ਨ ਕੋਈ ਜਾਨੈ ॥੫॥",
      "transliteration": "tirayaa charitr na koiee jaanai ||5||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਕੋਈ ਵੀ ਇਸਤਰੀ ਦੇ ਚਰਿਤ੍ਰ ਨੂੰ ਨਹੀਂ ਸਮਝਦਾ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "तृया चरित्र न कोई जानै ॥५॥",
      "sourceLineId": "136250",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਬਾਸਿਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੨॥੬੫੯੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau baasiTh charitr samaapatam sat subham sat ||362||6596||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੬੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੬੨॥੬੫੯੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ बासिठ चरित्र समापतम सतु सुभम सतु ॥३६२॥६५९६॥अफजूँ॥",
      "sourceLineId": "136251",
      "sourceShabadId": "12653",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136252",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੁਨ ਰਾਜਾ ਇਕ ਕਥਾ ਨਵੀਨ ॥",
      "transliteration": "sun raajaa ik kathaa naveen ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਨਵੀਂ ਕਥਾ ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "सुन राजा इक कथा नवीन ॥",
      "sourceLineId": "136253",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਸ ਚਰਿਤ੍ਰ ਕਿਯ ਨਾਰਿ ਪ੍ਰਬੀਨ ॥",
      "transliteration": "jas charitr kiy naar prabeen ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਇਕ ਪ੍ਰਬੀਨ ਇਸਤਰੀ ਨੇ ਚਰਿਤ੍ਰ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "जस चरित्र किय नारि प्रबीन ॥",
      "sourceLineId": "136254",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਿੰਘ ਮਹੇਸ੍ਰ ਸੁਨਾ ਇਕ ਰਾਜਾ ॥",
      "transliteration": "si(n)gh mahesr sunaa ik raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਹੇਸ੍ਰ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "सिंघ महेस्र सुना इक राजा ॥",
      "sourceLineId": "136255",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਹ ਸਮ ਔਰ ਨ ਬਿਧਨਾ ਸਾਜਾ ॥੧॥",
      "transliteration": "jeh sam aauar na bidhanaa saajaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਵਿਧਾਤਾ ਨੇ ਕੋਈ ਹੋਰ ਨਹੀਂ ਸਾਜਿਆ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "जिह सम और न बिधना साजा ॥१॥",
      "sourceLineId": "136256",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਗਰ ਮਹੇਸ੍ਰਾਵਤਿ ਤਿਹ ਰਾਜਤ ॥",
      "transliteration": "nagar mahesraavat teh raajat ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਮਹੇਸ੍ਰਾਵਤੀ ਨਾ ਦੀ ਨਗਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "नगर महेस्रावति तिह राजत ॥",
      "sourceLineId": "136257",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੇਵਪੁਰੀ ਜਾ ਕੌ ਲਖਿ ਲਾਜਤ ॥",
      "transliteration": "dhevapuree jaa kau lakh laajat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਦੇਵਪੁਰੀ ਵੀ ਸ਼ਰਮਾਉਾਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "देवपुरी जा कौ लखि लाजत ॥",
      "sourceLineId": "136258",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਿਮਲ ਮਤੀ ਰਾਨੀ ਤਿਹ ਐਨ ॥",
      "transliteration": "bimal matee raanee teh aain ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ('ਐਨ') ਬਿਮਲ ਮਤੀ ਨਾ ਦੀ ਰਾਣੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "बिमल मती रानी तिह ऐन ॥",
      "sourceLineId": "136259",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾ ਸਮ ਸੁਨੀ ਨ ਨਿਰਖੀ ਨੈਨ ॥੨॥",
      "transliteration": "jaa sam sunee na nirakhee nain ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਨਾ ਕੋਈ ਸੁਣੀ ਹੈ ਅਤੇ ਨਾ ਹੀ ਅੱਖਾ ਨਾਲ ਵੇਖੀ ਹੈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "जा सम सुनी न निरखी नैन ॥२॥",
      "sourceLineId": "136260",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸ੍ਰੀ ਪੰਜਾਬ ਦੇਇ ਤਿਹ ਬੇਟੀ ॥",
      "transliteration": "sree pa(n)jaab dhei teh beTee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਪੰਜਾਬ ਦੇਈ ਨਾ ਦੀ ਬੇਟੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "स्री पंजाब देइ तिह बेटी ॥",
      "sourceLineId": "136261",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾ ਸਮ ਇੰਦ੍ਰ ਚੰਦ੍ਰ ਨਹਿ ਭੇਟੀ ॥",
      "transliteration": "jaa sam i(n)dhr cha(n)dhr neh bheTee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ (ਪੁੱਤਰੀ) ਇੰਦਰ ਅਤੇ ਚੰਦ੍ਰਮਾ ਨੂੰ ਵੀ ਨਹੀਂ ਮਿਲੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "जा सम इंद्र चंद्र नहि भेटी ॥",
      "sourceLineId": "136262",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਧਿਕ ਤਵਨ ਕੀ ਪ੍ਰਭਾ ਬਿਰਾਜੈ ॥",
      "transliteration": "adhik tavan kee prabhaa biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਬਹੁਤ ਸ਼ੋਭਦੀ ਰਹਿੰਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "अधिक तवन की प्रभा बिराजै ॥",
      "sourceLineId": "136263",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਹ ਦੁਤਿ ਨਿਰਖਿ ਚੰਦ੍ਰਮਾ ਲਾਜੈ ॥੩॥",
      "transliteration": "jeh dhut nirakh cha(n)dhramaa laajai ||3||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਚਮਕ ਨੂੰ ਵੇਖ ਕੇ ਚੰਦ੍ਰਮਾ ਵੀ ਲਜਾਉਾਂਦਾ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "जिह दुति निरखि चंद्रमा लाजै ॥३॥",
      "sourceLineId": "136264",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਬ ਜੋਬਨ ਤਾ ਕੇ ਤਨ ਭਯੋ ॥",
      "transliteration": "jab joban taa ke tan bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਜਵਾਨੀ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "जब जोबन ता के तन भयो ॥",
      "sourceLineId": "136265",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅੰਗ ਅੰਗ ਮਦਨ ਦਮਾਮੋ ਦਯੋ ॥",
      "transliteration": "a(n)g a(n)g madhan dhamaamo dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਅੰਗ ਅੰਗ ਵਿਚ ਕਾਮ ਦੇਵ ਨੇ ਨਗਾਰਾ ਵਜਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "अंग अंग मदन दमामो दयो ॥",
      "sourceLineId": "136266",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭੂਪ ਬ੍ਯਾਹ ਕੋ ਬਿਵਤ ਬਨਾਇ ॥",
      "transliteration": "bhoop bayaeh ko bivat banai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ (ਉਸ ਦੇ) ਵਿਆਹ ਦੀ ਵਿਉਾਂਤ ਬਣਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "भूप ब्याह को बिवत बनाइ ॥",
      "sourceLineId": "136267",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਕਲ ਪ੍ਰੋਹਿਤਨ ਲਿਯਾ ਬੁਲਾਇ ॥੪॥",
      "transliteration": "sakal prohitan liyaa bulai ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਪਰੋਹਿਤਾ ਨੂੰ ਬੁਲਾ ਲਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "सकल प्रोहितन लिया बुलाइ ॥४॥",
      "sourceLineId": "136268",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਿੰਘ ਸੁਰੇਸ੍ਰ ਭੂਪ ਤਬ ਚੀਨਾ ॥",
      "transliteration": "si(n)gh suresr bhoop tab cheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਰਾਜੇ ਨੇ) ਸੁਰੇਸ੍ਰ ਸਿੰਘ ਨੂੰ (ਪੁੱਤਰੀ ਲਈ ਵਰ ਵਜੋਂ) ਚੁਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "सिंघ सुरेस्र भूप तब चीना ॥",
      "sourceLineId": "136269",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਹ ਸਸਿ ਜਾਤ ਨ ਪਟਤਰ ਦੀਨਾ ॥",
      "transliteration": "jeh sas jaat na paTatar dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਤੁਲਨਾ ਚੰਦ੍ਰਮਾ ਨਾਲ ਵੀ ਨਹੀਂ ਦਿੱਤੀ ਜਾ ਸਕਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "जिह ससि जात न पटतर दीना ॥",
      "sourceLineId": "136270",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਰੀ ਤਵਨ ਕੇ ਸਾਥ ਸਗਾਈ ॥",
      "transliteration": "karee tavan ke saath sagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ (ਪੁੱਤਰੀ ਦੀ) ਕੁੜਮਾਈ ਕਰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "करी तवन के साथ सगाई ॥",
      "sourceLineId": "136271",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੈ ਸਨਮਾਨ ਬਰਾਤ ਬੁਲਾਈ ॥੫॥",
      "transliteration": "dhai sanamaan baraat bulaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਨਮਾਨ ਸਹਿਤ ਬਰਾਤ ਨੂੰ ਬੁਲਾਇਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "दै सनमान बरात बुलाई ॥५॥",
      "sourceLineId": "136272",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੋਰਿ ਸੈਨ ਆਯੋ ਰਾਜਾ ਤਹ ॥",
      "transliteration": "jor sain aayo raajaa teh ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਸੈਨਾ ਇਕੱਠੀ ਕਰ ਕੇ ਉਥੇ ਆ ਪਹੁੰਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "जोरि सैन आयो राजा तह ॥",
      "sourceLineId": "136273",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਚਾ ਬ੍ਯਾਹ ਕੋ ਬਿਵਤਾਰਾ ਜਹ ॥",
      "transliteration": "rachaa bayaeh ko bivataaraa jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਵਿਆਹ ਦੀ ਵਿਵਸਥਾ ਕੀਤੀ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "रचा ब्याह को बिवतारा जह ॥",
      "sourceLineId": "136274",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਹੀ ਬਰਾਤ ਆਇ ਕਰਿ ਨਿਕਸੀ ॥",
      "transliteration": "tahee baraat aai kar nikasee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਰਾਤ ਆ ਪਹੁੰਚੀ",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "तही बरात आइ करि निकसी ॥",
      "sourceLineId": "136275",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਾਨੀ ਕੰਜ ਕਲੀ ਜਿਮਿ ਬਿਗਸੀ ॥੬॥",
      "transliteration": "raanee ka(n)j kalee jim bigasee ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਕਮਲ ਦੀ ਕਲੀ ਵਾਗ ਖਿੜ ਗਈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "रानी कंज कली जिमि बिगसी ॥६॥",
      "sourceLineId": "136276",
      "sourceShabadId": "12654",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "136277",
      "sourceShabadId": "12655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਸੁੰਦਰ ਹੁਤੀ ਤਿਹ ਬਰ ਹੋਤ ਕੁਰੂਪ ॥",
      "transliteration": "raaj sutaa su(n)dhar hutee teh bar hot kuroop ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਬਹੁਤ ਸੁੰਦਰ ਸੀ, ਪਰ ਉਸ ਦਾ ਵਰ ਕੁਰੂਪ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "राज सुता सुँदर हुती तिह बर होत कुरूप ॥",
      "sourceLineId": "136278",
      "sourceShabadId": "12655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਮਨ ਭਈ ਅਬਲਾ ਨਿਰਖਿ ਜਨੁ ਜਿਯ ਹਾਰਾ ਜੂਪ ॥੭॥",
      "transliteration": "biman bhiee abalaa nirakh jan jiy haaraa joop ||7||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਵੇਖ ਕੇ ਕੁਮਾਰੀ ਬਹੁਤ ਉਦਾਸ ਹੋ ਗਈ, ਮਾਨੋ ਉਸ ਦਾ ਮਨ ਜੂਏ ਵਿਚ ਹਾਰ ਗਿਆ ਹੋਵੇ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "बिमन भई अबला निरखि जनु जिय हारा जूप ॥७॥",
      "sourceLineId": "136279",
      "sourceShabadId": "12655",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136280",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਏਕ ਸਾਹੁ ਕੋ ਪੂਤ ਹੁਤੋ ਸੰਗ ॥",
      "transliteration": "ek saahu ko poot huto sa(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਰਾਜੇ ਦੇ) ਨਾਲ ਇਕ ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "एक साहु को पूत हुतो संग ॥",
      "sourceLineId": "136281",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1313_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੁੰਦਰ ਹੁਤੇ ਸਕਲ ਜਾ ਕੇ ਅੰਗ ॥",
      "transliteration": "su(n)dhar hute sakal jaa ke a(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸਾਰੇ ਅੰਗ ਬਹੁਤ ਸੁੰਦਰ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1313,
      "hindi": "",
      "hindiTransliteration": "सुँदर हुते सकल जा के अंग ॥",
      "sourceLineId": "136282",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
