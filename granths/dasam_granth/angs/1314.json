{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1314,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1314_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਲਖ ਤਾਹਿ ਲੁਭਾਈ ॥",
      "transliteration": "raaj sutaa lakh taeh lubhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਮੋਹਿਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "राज सुता लख ताहि लुभाई ॥",
      "sourceLineId": "136283",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗਿਰੀ ਧਰਨਿ ਜਨੁ ਨਾਗ ਚਬਾਈ ॥੮॥",
      "transliteration": "giree dharan jan naag chabaiee ||8||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਤੇ ਇਸ ਤਰ੍ਰਹਾ ਡਿਗ ਪਈ, ਮਾਨੋ ਸੱਪ ਨੇ ਡੰਗ ਲਈ ਹੋਵੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "गिरी धरनि जनु नाग चबाई ॥८॥",
      "sourceLineId": "136284",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੁਤਾ ਗਿਰੀ ਮਇਯਾ ਤਹ ਆਈ ॥",
      "transliteration": "sutaa giree miyaa teh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਧੀ ਦੇ ਡਿਗਣ ਕਰ ਕੇ ਮਾ ਉਥੇ ਆ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "सुता गिरी मइया तह आई ॥",
      "sourceLineId": "136285",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੀਚਿ ਬਾਰਿ ਬਹੁ ਚਿਰੈ ਜਗਾਈ ॥",
      "transliteration": "seech baar bahu chirai jagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਾਣੀ ਛਿੜਕ ਕੇ ਬਹੁਤ ਚਿਰ ਬਾਦ ਹੋਸ਼ ਵਿਚ ਲਿਆਂਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "सीचि बारि बहु चिरै जगाई ॥",
      "sourceLineId": "136286",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਬ ਤਾ ਕੋ ਬਹੁਰੌ ਸੁਧਿ ਆਈ ॥",
      "transliteration": "jab taa ko bahurau sudh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੂੰ ਫਿਰ ਹੋਸ਼ ਆਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "जब ता को बहुरौ सुधि आई ॥",
      "sourceLineId": "136287",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਉਲਟਿ ਗਿਰੀ ਜਨ ਲਗੀ ਹਵਾਈ ॥੯॥",
      "transliteration": "aulaT giree jan lagee havaiee ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਫਿਰ ਉਲਟ ਕੇ ਡਿਗ ਪਈ ਮਾਨੋ ਹਵਾਈ (ਗੋਲੀ) ਲਗੀ ਹੋਵੇ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "उलटि गिरी जन लगी हवाई ॥९॥",
      "sourceLineId": "136288",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਹਰਿਕ ਬਿਤੇ ਬਹੁਰਿ ਸੁਧਿ ਆਈ ॥",
      "transliteration": "paharik bite bahur sudh aaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਇਕ ਪਹਿਰ ਬੀਤ ਗਿਆ, (ਤਦ) ਫਿਰ ਹੋਸ਼ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "पहरिक बिते बहुरि सुधि आई ॥",
      "sourceLineId": "136289",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰੋਇ ਮਾਤ ਸੌ ਬਾਤ ਜਨਾਈ ॥",
      "transliteration": "roi maat sau baat janaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰੋ ਕੇ ਮਾਤਾ ਨੂੰ ਕਹਿਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "रोइ मात सौ बात जनाई ॥",
      "sourceLineId": "136290",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਗਨਿ ਜਾਰਿ ਮੁਹਿ ਅਬੈ ਜਰਾਵੌ ॥",
      "transliteration": "agan jaar muh abai jaraavau ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਗ ਬਾਲ ਕੇ ਮੈਨੂੰ ਹੁਣੇ ਸਾੜ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "अगनि जारि मुहि अबै जरावौ ॥",
      "sourceLineId": "136291",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਹੁ ਕੁਰੂਪ ਕੇ ਧਾਮ ਨ ਦ੍ਰਯਾਵੌ ॥੧੦॥",
      "transliteration": "eih kuroop ke dhaam na dhrayaavau ||10||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਇਸ ਕੁਰੂਪ ਦੇ ਘਰ ਨਾ ਭੇਜੋ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "इहु कुरूप के धाम न द्रयावौ ॥१०॥",
      "sourceLineId": "136292",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਾਤਹਿ ਹੁਤੀ ਸੁਤਾ ਅਤਿ ਪ੍ਯਾਰੀ ॥",
      "transliteration": "maateh hutee sutaa at payaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਤਾ ਨੂੰ ਪੁੱਤਰੀ ਬਹੁਤ ਪਿਆਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "मातहि हुती सुता अति प्यारी ॥",
      "sourceLineId": "136293",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚਿੰਤਾ ਕਰੀ ਚਿਤ ਮਹਿ ਭਾਰੀ ॥",
      "transliteration": "chi(n)taa karee chit meh bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮਨ ਵਿਚ ਬਹੁਤ ਚਿੰਤਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "चिंता करी चित महि भारी ॥",
      "sourceLineId": "136294",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਨਿ ਇਹ ਰਾਜ ਸੁਤਾ ਮਰਿ ਜਾਇ ॥",
      "transliteration": "jin ieh raaj sutaa mar jai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕਿਤੇ ਇਹ ਰਾਜ ਕੁਮਾਰੀ ਮਰ ਜਾਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "जिनि इह राज सुता मरि जाइ ॥",
      "sourceLineId": "136295",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਹਾ ਕਰੈ ਤਾ ਕੀ ਤਬ ਮਾਇ ॥੧੧॥",
      "transliteration": "kahaa karai taa kee tab mai ||11||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸ ਦੀ ਮਾਤਾ ਕੀ ਕਰੇਗੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "कहा करै ता की तब माइ ॥११॥",
      "sourceLineId": "136296",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਬ ਨ੍ਰਿਪ ਸੁਤਾ ਕਛੂ ਸੁਧਿ ਪਾਈ ॥",
      "transliteration": "jab nirap sutaa kachhoo sudh paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਕੁਝ ਹੋਸ਼ ਆਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "जब नृप सुता कछू सुधि पाई ॥",
      "sourceLineId": "136297",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰੋਇ ਮਾਤ ਸੌ ਬਾਤ ਸੁਨਾਈ ॥",
      "transliteration": "roi maat sau baat sunaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰੋ ਕੇ ਮਾਤਾ ਨੂੰ ਗੱਲ ਸੁਣਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "रोइ मात सौ बात सुनाई ॥",
      "sourceLineId": "136298",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਧ੍ਰਿਗ ਮੁਹਿ ਰਾਜ ਸੁਤਾ ਕ੍ਯੋ ਭਈ ॥",
      "transliteration": "dhirag muh raaj sutaa kayo bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਧਿੱਕਾਰ ਹੈ ਕਿ ਮੈਂ ਰਾਜ ਕੁਮਾਰੀ ਕਿਉਾਂ ਬਣੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "धृग मुहि राज सुता क्यो भई ॥",
      "sourceLineId": "136299",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿਸੀ ਸਾਹ ਕੇ ਧਾਮ ਨ ਗਈ ॥੧੨॥",
      "transliteration": "kisee saeh ke dhaam na giee ||12||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਸ਼ਾਹ ਦੇ ਘਰ ਕਿਉਾਂ ਨਾ ਜੰਮੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "किसी साह के धाम न गई ॥१२॥",
      "sourceLineId": "136300",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੋਰੋ ਭਾਗ ਲੋਪ ਹ੍ਵੈ ਗਯੋ ॥",
      "transliteration": "moro bhaag lop havai gayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਭਾਗ ਲੋਪ ਹੋ ਗਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "मोरो भाग लोप ह्वै गयो ॥",
      "sourceLineId": "136301",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਤੇ ਜਨਮ ਭੂਪ ਕੋ ਲਯੋ ॥",
      "transliteration": "taa te janam bhoop ko layo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਤਾ ਰਾਜੇ ਦੇ ਘਰ ਜੰਮੀ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "ता ते जनम भूप को लयो ॥",
      "sourceLineId": "136302",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਬ ਐਸੇ ਕੁਰੂਪ ਕੇ ਜੈ ਹੌ ॥",
      "transliteration": "ab aaise kuroop ke jai hau ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਅਜਿਹੇ ਕੁਰੂਪ ਦੇ ਘਰ ਜਾਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "अब ऐसे कुरूप के जै हौ ॥",
      "sourceLineId": "136303",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰੈਨਿ ਦਿਵਸ ਸਭ ਰੋਤ ਬਿਤੈ ਹੌ ॥੧੩॥",
      "transliteration": "rain dhivas sabh rot bitai hau ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਤ ਦਿਨ ਰੋਂਦੇ ਹੋਇਆਂ ਬਿਤਾਵਾਗੀ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "रैनि दिवस सभ रोत बितै हौ ॥१३॥",
      "sourceLineId": "136304",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਧ੍ਰਿਗ ਮੁਹਿ ਨਾਰਿ ਜੋਨਿ ਕਸ ਧਰੀ ॥",
      "transliteration": "dhirag muh naar jon kas dharee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਧਿੱਕਾਰ ਹੈ ਕਿ (ਮੈਂ) ਨਾਰੀ ਦੀ ਜੂਨ ਕਿਉਾਂ ਧਾਰਨ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "धृग मुहि नारि जोनि कस धरी ॥",
      "sourceLineId": "136305",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕ੍ਯੋਨ ਭੂਪਤਿ ਕੇ ਧਾਮੌਤਰੀ ॥",
      "transliteration": "kayon bhoopat ke dhaamauataree ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਰਾਜੇ ਦੇ ਘਰ ਕਿਉਾਂ ਪ੍ਰਗਟ ਹੋਈ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "क्योन भूपति के धामौतरी ॥",
      "sourceLineId": "136306",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਾਗੀ ਦੇਤ ਨ ਮ੍ਰਿਤੁ ਬਿਧਾਤਾ ॥",
      "transliteration": "maagee dhet na mrit bidhaataa ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਧਾਤਾ ਮੰਗਣ ਤੇ ਮੌਤ ਵੀ ਨਹੀਂ ਦਿੰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "मागी देत न मृतु बिधाता ॥",
      "sourceLineId": "136307",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਬ ਹੀ ਕਰੌ ਦੇਹਿ ਕੋ ਘਾਤਾ ॥੧੪॥",
      "transliteration": "ab hee karau dheh ko ghaataa ||14||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਹੁਣੇ ਹੀ (ਆਪਣੇ) ਸ਼ਰੀਰ ਨੂੰ ਖ਼ਤਮ ਕਰ ਦਿਆਂਗੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "अब ही करौ देहि को घाता ॥१४॥",
      "sourceLineId": "136308",
      "sourceShabadId": "12656",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "136309",
      "sourceShabadId": "12657",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੁਖ ਮਾਗੇ ਜੋ ਪੁਰਖ ਕੋ ਭਲੋ ਬੁਰੋ ਕੁਛ ਹੋਇ ॥",
      "transliteration": "mukh maage jo purakh ko bhalo buro kuchh hoi ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਮੂੰਹ ਮੰਗੇ ਕਿਸੇ ਬੰਦੇ ਦਾ ਮਾੜਾ ਜਾ ਚੰਗਾ ਹੋ ਜਾਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "मुख मागे जो पुरख को भलो बुरो कुछ होइ ॥",
      "sourceLineId": "136310",
      "sourceShabadId": "12657",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੌ ਦੁਖਿਯਾ ਇਹ ਜਗਤ ਮੈ ਜਿਯਤ ਨ ਉਬਰੈ ਕੋਇ ॥੧੫॥",
      "transliteration": "tau dhukhiyaa ieh jagat mai jiyat na ubarai koi ||15||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਸ ਸੰਸਾਰ ਵਿਚ ਕੋਈ ਵੀ ਦੁਖੀ ਜੀਉਾਂਦਾ ਨਾ ਬਚਦਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "तौ दुखिया इह जगत मै जियत न उबरै कोइ ॥१५॥",
      "sourceLineId": "136311",
      "sourceShabadId": "12657",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136312",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਬ ਮੈ ਮਾਰਿ ਕਟਾਰੀ ਮਰਿਹੌ ॥",
      "transliteration": "ab mai maar kaTaaree marihau ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਫਿਰ ਕਿਹਾ) ਹੁਣ ਮੈਂ ਕਟਾਰੀ ਮਾਰ ਕੇ ਮਰ ਜਾਵਾਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "अब मै मारि कटारी मरिहौ ॥",
      "sourceLineId": "136313",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਤਰ ਬਸਤ੍ਰ ਭਗੌਹੇ ਧਰਿਹੌ ॥",
      "transliteration": "naatar basatr bhagauahe dharihau ||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਭਗਵੇ ਬਸਤ੍ਰ ਧਾਰਨ ਕਰ ਲਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "नातर बसत्र भगौहे धरिहौ ॥",
      "sourceLineId": "136314",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਰੌ ਤ ਪੂਤ ਸਾਹ ਕੋ ਬਰੌ ॥",
      "transliteration": "barau ta poot saeh ko barau ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਵਿਆਹ ਕਰਾਗੀ ਤਾ ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਨਾਲ,",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "बरौ त पूत साह को बरौ ॥",
      "sourceLineId": "136315",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਤਰ ਆਜੁ ਖਾਇ ਬਿਖੁ ਮਰੌ ॥੧੬॥",
      "transliteration": "naatar aaj khai bikh marau ||16||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਅਜ ਵਿਸ਼ ਖਾ ਕੇ ਮਰ ਜਾਵਾਗੀ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "नातर आजु खाइ बिखु मरौ ॥१६॥",
      "sourceLineId": "136316",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਾਨੀ ਕੋ ਦੁਹਿਤਾ ਥੀ ਪ੍ਯਾਰੀ ॥",
      "transliteration": "raanee ko dhuhitaa thee payaaree ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੂੰ ਪੁੱਤਰੀ ਬਹੁਤ ਹੀ ਪਿਆਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "रानी को दुहिता थी प्यारी ॥",
      "sourceLineId": "136317",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੋਈ ਕਰੀ ਜੁ ਤਾਹਿ ਉਚਾਰੀ ॥",
      "transliteration": "soiee karee ju taeh uchaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਹੀ ਕੀਤਾ, ਜੋ ਉਸ ਨੇ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "सोई करी जु ताहि उचारी ॥",
      "sourceLineId": "136318",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚੇਰੀ ਕਾਢਿ ਤਵਨ ਕਹ ਦੀਨੀ ॥",
      "transliteration": "cheree kaadd tavan keh dheenee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ) ਦਾਸੀ ਕਢ ਕੇ ਉਸ (ਰਾਜ ਕੁਮਾਰ) ਨੂੰ ਦੇ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "चेरी काढि तवन कह दीनी ॥",
      "sourceLineId": "136319",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭੂਪ ਸੁਤਾ ਕਰਿ ਤਿਨ ਜੜ ਚੀਨੀ ॥੧੭॥",
      "transliteration": "bhoop sutaa kar tin jaR cheenee ||17||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੇ ਉਸ ਨੂੰ ਰਾਜ ਪੁੱਤਰੀ ਕਰ ਕੇ ਸਮਝਿਆ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "भूप सुता करि तिन जड़ चीनी ॥१७॥",
      "sourceLineId": "136320",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਾਹ ਪੁਤ੍ਰ ਕਹ ਦਈ ਕੁਮਾਰੀ ॥",
      "transliteration": "saeh putr keh dhiee kumaaree ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਨੂੰ ਰਾਜ ਕੁਮਾਰੀ ਦੇ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "साह पुत्र कह दई कुमारी ॥",
      "sourceLineId": "136321",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੁਤਿਯ ਪੁਰਖ ਨਹਿ ਕ੍ਰਿਯਾ ਬਿਚਾਰੀ ॥",
      "transliteration": "dhutiy purakh neh kirayaa bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕ੍ਰਿਆ ਬਾਰੇ ਕਿਸੇ ਹੋਰ ਪੁਰਸ਼ ਨੇ ਕੁਝ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "दुतिय पुरख नहि कृया बिचारी ॥",
      "sourceLineId": "136322",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਲੈ ਚੇਰੀ ਵਹੁ ਭੂਪ ਸਿਧਾਯੋ ॥",
      "transliteration": "lai cheree vahu bhoop sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਦਾਸੀ ਲੈ ਕੇ ਉਹ ਰਾਜਾ ਚਲਾ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "लै चेरी वहु भूप सिधायो ॥",
      "sourceLineId": "136323",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਾਨ੍ਯੋ ਰਾਜ ਸੁਤਾ ਬਰਿ ਲ੍ਯਾਯੋ ॥੧੮॥",
      "transliteration": "jaanayo raaj sutaa bar layaayo ||18||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਜਾਣ ਕੇ ਕਿ (ਉਸ ਨੇ) ਰਾਜ ਕੁਮਾਰੀ ਵਿਆਹ ਲਿਆਂਦੀ ਹੈ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "जान्यो राज सुता बरि ल्यायो ॥१८॥",
      "sourceLineId": "136324",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤ੍ਰੈਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੩॥੬੬੧੪॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau traisaTh charitr samaapatam sat subham sat ||363||6614||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੬੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੬੩॥੬੬੧੪॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ त्रैसठि चरित्र समापतम सतु सुभम सतु ॥३६३॥६६१४॥अफजूँ॥",
      "sourceLineId": "136325",
      "sourceShabadId": "12658",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136326",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਨਪਤਿ ਸਿੰਘ ਏਕ ਰਾਜਾ ਬਰ ॥",
      "transliteration": "ganapat si(n)gh ek raajaa bar ||",
      "translation": "",
      "punjabiViakhya": "ਗਨਪਤਿ ਨਾ ਦਾ ਇਕ ਚੰਗਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "गनपति सिंघ एक राजा बर ॥",
      "sourceLineId": "136327",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗਨਪਾਵਤੀ ਹੁਤੋ ਜਾ ਕੇ ਘਰ ॥",
      "transliteration": "ganapaavatee huto jaa ke ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਘਰ ਗਨਪਾਵਤੀ (ਨਗਰੀ) ਵਿਚ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "गनपावती हुतो जा के घर ॥",
      "sourceLineId": "136328",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸ੍ਰੀ ਮਹਤਾਬ ਪ੍ਰਭਾ ਤਿਹ ਰਾਨੀ ॥",
      "transliteration": "sree mahataab prabhaa teh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਤਾਬ ਪ੍ਰਭਾ ਉਸ ਦੀ ਰਾਣੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "स्री महताब प्रभा तिह रानी ॥",
      "sourceLineId": "136329",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1314_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਾਹਿ ਨਿਰਖਿ ਕਰਿ ਨਾਰਿ ਲਜਾਨੀ ॥੧॥",
      "transliteration": "jaeh nirakh kar naar lajaanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ (ਦੀ ਸੁੰਦਰਤਾ) ਨੂੰ ਵੇਖ ਕੇ ਇਸਤਰੀਆਂ ਵੀ ਲਜਾਉਾਂਦੀਆਂ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1314,
      "hindi": "",
      "hindiTransliteration": "जाहि निरखि करि नारि लजानी ॥१॥",
      "sourceLineId": "136330",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
