{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1315,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1315_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮੁਹਕਮ ਸਿੰਘ ਏਕ ਛਤ੍ਰੀ ਜਹ ॥",
      "transliteration": "muhakam si(n)gh ek chhatree jeh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਮੁਹਕਮ ਨਾ ਦਾ ਇਕ ਛਤ੍ਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "मुहकम सिंघ एक छत्री जह ॥",
      "sourceLineId": "136331",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਹ ਸਮ ਉਪਜਾ ਦੁਤਿਯ ਨ ਮਹਿ ਮਹ ॥",
      "transliteration": "jeh sam upajaa dhutiy na meh meh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਧਰਤੀ ਉਤੇ ਹੋਰ ਕੋਈ ਪੈਦਾ ਨਹੀਂ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "जिह सम उपजा दुतिय न महि मह ॥",
      "sourceLineId": "136332",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਾਨੀ ਜਬ ਤਾ ਕੋ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "raanee jab taa ko lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਜਦ ਉਸ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "रानी जब ता को लखि पायो ॥",
      "sourceLineId": "136333",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਗ੍ਰਿਹ ਬੋਲਿ ਕਮਾਯੋ ॥੨॥",
      "transliteration": "kaam bhog gireh bol kamaayo ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਘਰ ਬੁਲਾ ਕੇ (ਉਸ ਨਾਲ) ਸੰਯੋਗ ਕੀਤਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "काम भोग गृह बोलि कमायो ॥२॥",
      "sourceLineId": "136334",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਬ ਲਗਿ ਆਇ ਗਯੋ ਰਾਜਾ ਤਹ ॥",
      "transliteration": "tab lag aai gayo raajaa teh ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਰਾਜਾ ਉਥੇ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "तब लगि आइ गयो राजा तह ॥",
      "sourceLineId": "136335",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਾਰ ਹੁਤੋ ਭੋਗਤ ਤਾ ਕੌ ਜਹ ॥",
      "transliteration": "jaar huto bhogat taa kau jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਉਸ ਨਾਲ ਯਾਰ ਸੰਯੋਗ ਕਰ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "जार हुतो भोगत ता कौ जह ॥",
      "sourceLineId": "136336",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਿਰਖ ਨਾਥ ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਬਿਚਾਰਾ ॥",
      "transliteration": "nirakh naath tiray charitr bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਨੂੰ ਵੇਖ ਕੇ ਇਸਤਰੀ ਨੇ (ਮਨ ਵਿਚ) ਚਰਿਤ੍ਰ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "निरख नाथ तृय चरित्र बिचारा ॥",
      "sourceLineId": "136337",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਾਰ ਤੋਰਿ ਅੰਗਨਾ ਮਹਿ ਡਾਰਾ ॥੩॥",
      "transliteration": "haar tor a(n)ganaa meh ddaaraa ||3||",
      "translation": "",
      "punjabiViakhya": "(ਗਲ ਦਾ) ਹਾਰ ਤੋੜ ਕੇ ਵੇਹੜੇ ਵਿਚ ਸੁਟ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "हार तोरि अंगना महि डारा ॥३॥",
      "sourceLineId": "136338",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਹਸਿ ਬਚਨ ਨ੍ਰਿਪ ਸੰਗ ਉਚਾਰਾ ॥",
      "transliteration": "bihas bachan nirap sa(n)g uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਹਸ ਕੇ ਰਾਜੇ ਨੂੰ ਕਹਿਣ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "बिहसि बचन नृप संग उचारा ॥",
      "sourceLineId": "136339",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਖੋਜਿ ਹਾਰ ਤੁਮ ਦੇਹੁ ਹਮਾਰਾ ॥",
      "transliteration": "khoj haar tum dheh hamaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੁਸੀਂ ਮੇਰਾ ਹਾਰ ਲਭ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "खोजि हार तुम देहु हमारा ॥",
      "sourceLineId": "136340",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਨ ਪੁਰਖ ਜੌ ਹਾਥ ਲਗੈ ਹੈ ॥",
      "transliteration": "aan purakh jau haath lagai hai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਉਸ (ਨੂੰ ਲਭਣ ਲਈ) ਕੋਈ ਹੋਰ ਪੁਰਸ਼ ਹੱਥ ਲਗਾਵੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "आन पुरख जौ हाथ लगै है ॥",
      "sourceLineId": "136341",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੌ ਹਮਰੇ ਪਹਿਰਨ ਤੇ ਜੈ ਹੈ ॥੪॥",
      "transliteration": "tau hamare pahiran te jai hai ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਮੇਰੇ ਪਾਣ ਜੋਗਾ ਨਹੀਂ ਰਹੇਗਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "तौ हमरे पहिरन ते जै है ॥४॥",
      "sourceLineId": "136342",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਖੋਜਤ ਭਯੋ ਜੜ ਹਾਰ ਅਯਾਨੋ ॥",
      "transliteration": "khojat bhayo jaR haar ayaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਆਣਾ ਮੂਰਖ ਹਾਰ ਲਭਣ ਲਗ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "खोजत भयो जड़ हार अयानो ॥",
      "sourceLineId": "136343",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨੇਤ੍ਰ ਨੀਚ ਕਰਿ ਭੇਦ ਨ ਜਾਨੋ ॥",
      "transliteration": "netr neech kar bhedh na jaano ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਖਾ ਨੂੰ ਹੇਠਾ ਵਲ ਕਰ ਕੇ, ਪਰ ਉਸ ਨੇ ਭੇਦ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "नेत्र नीच करि भेद न जानो ॥",
      "sourceLineId": "136344",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਰਿ ਆਗੇ ਹ੍ਵੈ ਮੀਤ ਨਿਕਾਰਾ ॥",
      "transliteration": "naar aage havai meet nikaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਅਗੇ ਹੋ ਕੇ ਮਿਤਰ ਨੂੰ ਕਢ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "नारि आगे ह्वै मीत निकारा ॥",
      "sourceLineId": "136345",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਿਰ ਨੀਚੇ ਪਸੁ ਤਿਹ ਨ ਨਿਹਾਰਾ ॥੫॥",
      "transliteration": "sir neeche pas teh na nihaaraa ||5||",
      "translation": "",
      "punjabiViakhya": "ਸਿਰ ਨੂੰ ਹੇਠਾ ਕਰਨ ਕਰ ਕੇ ਮੂਰਖ ਉਸ ਨੂੰ ਵੇਖ ਨਾ ਸਕਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "सिर नीचे पसु तिह न निहारा ॥५॥",
      "sourceLineId": "136346",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪਹਰਿਕ ਲਗੇ ਖੋਜਿ ਜੜ ਹਾਰੋ ॥",
      "transliteration": "paharik lage khoj jaR haaro ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਰ ਨੂੰ ਲਭਦਿਆਂ ਇਕ ਪਹਿਰ ਲਗ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "पहरिक लगे खोजि जड़ हारो ॥",
      "sourceLineId": "136347",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਲੈ ਰਾਨੀ ਕਹ ਦਯੋ ਸੁਧਾਰੋ ॥",
      "transliteration": "lai raanee keh dhayo sudhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਅੰਤ ਵਿਚ) ਲਭ ਕੇ ਰਾਣੀ ਨੂੰ ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "लै रानी कह दयो सुधारो ॥",
      "sourceLineId": "136348",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਤਿ ਪਤਿਬ੍ਰਤਾ ਤਾਹਿ ਠਹਰਾਯੋ ॥",
      "transliteration": "at patibrataa taeh Thaharaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਉਸ ਨੂੰ ਅਤਿ ਪਤਿਬ੍ਰਤਾ ਮੰਨਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "अति पतिब्रता ताहि ठहरायो ॥",
      "sourceLineId": "136349",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੁਤਿਯ ਪੁਰਖ ਜਿਨ ਕਰ ਨ ਛੁਆਯੋ ॥੬॥",
      "transliteration": "dhutiy purakh jin kar na chhuaayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਦੂਜੇ ਪੁਰਸ਼ ਨੂੰ (ਹਾਰ ਤਕ) ਨਾ ਛੋਹਣ ਦਿੱਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "दुतिय पुरख जिन कर न छुआयो ॥६॥",
      "sourceLineId": "136350",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚੌਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੪॥੬੬੨੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chauasaTh charitr samaapatam sat subham sat ||364||6620||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੬੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੬੪॥੬੬੨੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ चौसठि चरित्र समापतम सतु सुभम सतु ॥३६४॥६६२०॥अफजूँ॥",
      "sourceLineId": "136351",
      "sourceShabadId": "12659",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136352",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨ੍ਰਿਪਬਰ ਸਿੰਘ ਏਕ ਰਾਜਾਨਾ ॥",
      "transliteration": "nirapabar si(n)gh ek raajaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਨ੍ਰਿਪਬਰ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "नृपबर सिंघ एक राजाना ॥",
      "sourceLineId": "136353",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਾਨਤ ਆਨਿ ਦੇਸ ਜਿਹ ਨਾਨਾ ॥",
      "transliteration": "maanat aan dhes jeh naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਈਨ ਬਹੁਤ ਦੇਸ ਮੰਨਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "मानत आनि देस जिह नाना ॥",
      "sourceLineId": "136354",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸ੍ਰੀ ਕਿਲਕੰਚਿਤ ਦੇ ਤਿਹ ਰਾਨੀ ॥",
      "transliteration": "sree kilaka(n)chit dhe teh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਲਕੰਚਿਤ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਉਸ ਦੀ ਰਾਣੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "स्री किलकंचित दे तिह रानी ॥",
      "sourceLineId": "136355",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾਹਿ ਨਿਰਖਿ ਪੁਰ ਨਾਰਿ ਰਿਸਾਨੀ ॥੧॥",
      "transliteration": "jaeh nirakh pur naar risaanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਨਗਰ ਦੀਆਂ ਇਸਤਰੀਆਂ ਖਿਝਦੀਆਂ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "जाहि निरखि पुर नारि रिसानी ॥१॥",
      "sourceLineId": "136356",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨ੍ਰਿਪਬਰਵਤੀ ਨਗਰ ਤਿਹ ਰਾਜਤ ॥",
      "transliteration": "nirapabaravatee nagar teh raajat ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਨ੍ਰਿਪਬਰਵਤੀ ਨਾ ਦਾ ਨਗਰ ਹੁੰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "नृपबरवती नगर तिह राजत ॥",
      "sourceLineId": "136357",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੁਤਿਯ ਪ੍ਰਿਥੀ ਜਨੁ ਸੁਰਗ ਬਿਰਾਜਤ ॥",
      "transliteration": "dhutiy pirathee jan surag biraajat ||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਧਰਤੀ ਉਤੇ ਮਾਨੋ ਦੂਜਾ ਸਵਰਗ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "दुतिय पृथी जनु सुरग बिराजत ॥",
      "sourceLineId": "136358",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਗਰ ਪ੍ਰਭਾ ਨਹਿ ਜਾਤ ਬਖਾਨੀ ॥",
      "transliteration": "nagar prabhaa neh jaat bakhaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਨਗਰ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਬਖਾਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "नगर प्रभा नहि जात बखानी ॥",
      "sourceLineId": "136359",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਥਕਿਤ ਰਹਤ ਰਾਜਾ ਅਰੁ ਰਾਨੀ ॥੨॥",
      "transliteration": "thakit rahat raajaa ar raanee ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਵੇਖ ਕੇ ਰਾਜਾ ਅਤੇ ਰਾਣੀ ਥਕ ਜਾਦੇ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "थकित रहत राजा अरु रानी ॥२॥",
      "sourceLineId": "136360",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸ੍ਰੀ ਚਿਤਚੌਪ ਮਤੀ ਤਿਹ ਕੰਨ੍ਯਾ ॥",
      "transliteration": "sree chitachauap matee teh ka(n)nayaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਧੀ ਦਾ ਨਾ ਚਿਤਚੌਪ ਮਤੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "स्री चितचौप मती तिह कंन्या ॥",
      "sourceLineId": "136361",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਹ ਸਮ ਨਾਰਿ ਨ ਉਪਜੀ ਅੰਨ੍ਰਯਾ ॥",
      "transliteration": "jeh sam naar na upajee a(n)nrayaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਕੋਈ ਹੋਰ ਇਸਤਰੀ ਪੈਦਾ ਨਹੀਂ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "जिह सम नारि न उपजी अंन्रया ॥",
      "sourceLineId": "136362",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਕੀ ਜਾਤ ਨ ਉਪਮਾ ਕਰੀ ॥",
      "transliteration": "taa kee jaat na upamaa karee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ (ਸੁੰਦਰਤਾ ਦੀ) ਉਪਮਾ ਹੀ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "ता की जात न उपमा करी ॥",
      "sourceLineId": "136363",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰੂਪ ਰਾਸ ਜੋਬਨ ਤਨ ਭਰੀ ॥੩॥",
      "transliteration": "roop raas joban tan bharee ||3||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰੂਪ ਦੀ ਰਾਸ ਸੀ (ਅਤੇ ਉਸ ਦਾ) ਸ਼ਰੀਰ ਜੋਬਨ ਨਾਲ ਭਰਿਆ ਹੋਇਆ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "रूप रास जोबन तन भरी ॥३॥",
      "sourceLineId": "136364",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਇਕ ਹੁਤੋ ਅਪਾਰਾ ॥",
      "transliteration": "raaj kuar ik huto apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਵੱਡਾ ਰਾਜ ਕੁਮਾਰ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "राज कुअर इक हुतो अपारा ॥",
      "sourceLineId": "136365",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਕ ਦਿਨ ਨਿਕਸਾ ਨਿਮਿਤਿ ਸਿਕਾਰਾ ॥",
      "transliteration": "eik dhin nikasaa nimit sikaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਕ ਦਿਨ ਸ਼ਿਕਾਰ ਖੇਡਣ ਲਈ ਨਿਕਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "इक दिन निकसा निमिति सिकारा ॥",
      "sourceLineId": "136366",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮ੍ਰਿਗ ਹਿਤ ਧਯੋ ਨ ਪਹੁਚਾ ਕੋਈ ॥",
      "transliteration": "mirag hit dhayo na pahuchaa koiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਹਿਰਨ ਲਈ ਭਜਿਆ, ਪਰ ਕੋਈ ਸਾਥੀ ਨਾ ਪਹੁੰਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "मृग हित धयो न पहुचा कोई ॥",
      "sourceLineId": "136367",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਵਤ ਭਯੋ ਨਗਰ ਤਿਹ ਸੋਈ ॥੪॥",
      "transliteration": "aavat bhayo nagar teh soiee ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਹ ਉਸ ਨਗਰ ਵਿਚ ਆ ਪਹੁੰਚਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "आवत भयो नगर तिह सोई ॥४॥",
      "sourceLineId": "136368",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਤਿਹ ਰੂਪ ਨਿਹਾਰੋ ॥",
      "transliteration": "raaj sutaa teh roop nihaaro ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਸ ਦਾ ਰੂਪ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "राज सुता तिह रूप निहारो ॥",
      "sourceLineId": "136369",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਨ ਕ੍ਰਮ ਬਚ ਅਸ ਕਰਾ ਬਿਚਾਰੋ ॥",
      "transliteration": "man kram bach as karaa bichaaro ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਨ ਬਚ ਕਰਮ ਕਰ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "मन क्रम बच अस करा बिचारो ॥",
      "sourceLineId": "136370",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਐਸੋ ਛੈਲ ਏਕ ਦਿਨ ਪੈਯੈ ॥",
      "transliteration": "aaiso chhail ek dhin paiyai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਅਜਿਹਾ ਸੁੰਦਰ ਪੁਰਸ਼ ਕਿਸੇ ਦਿਨ ਪ੍ਰਾਪਤ ਹੋ ਜਾਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "ऐसो छैल एक दिन पैयै ॥",
      "sourceLineId": "136371",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਪਲ ਪਲ ਬਲਿ ਜੈਯੈ ॥੫॥",
      "transliteration": "janam janam pal pal bal jaiyai ||5||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਜਨਮ ਜਨਮਾਤਰਾ ਤਕ ਪਲ ਪਲ (ਇਸ ਤੋਂ) ਵਾਰਨੇ ਜਾਵਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "जनम जनम पल पल बलि जैयै ॥५॥",
      "sourceLineId": "136372",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਟਿਕ ਸਿੰਘ ਲਖਿ ਤੇਜ ਸਵਾਯਾ ॥",
      "transliteration": "aTik si(n)gh lakh tej savaayaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਟਿਕ ਸਿੰਘ (ਰਾਜੇ ਦਾ) ਅਧਿਕ ਤੇਜ ਵੇਖ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "अटिक सिंघ लखि तेज सवाया ॥",
      "sourceLineId": "136373",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਥਕਿਤ ਰਹੀ ਰਾਜਾ ਕੀ ਜਾਯਾ ॥",
      "transliteration": "thakit rahee raajaa kee jaayaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੀ ਪੁੱਤਰੀ ਥਕੀ ਰਹਿ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "थकित रही राजा की जाया ॥",
      "sourceLineId": "136374",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਲਿਯੋ ਮਗਾਇ ॥",
      "transliteration": "paThai sahacharee liyo magai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਖੀ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਮੰਗਵਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी लियो मगाइ ॥",
      "sourceLineId": "136375",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਰੁਚਿ ਮਾਨੁਪਜਾਇ ॥੬॥",
      "transliteration": "kaam bhog ruch maanupajai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰੁਚੀ ਪੂਰਵਕ ਉਸ ਨਾਲ ਕਾਮ-ਕੇਲਿ ਕੀਤੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "काम भोग रुचि मानुपजाइ ॥६॥",
      "sourceLineId": "136376",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚਾਰਿ ਪਹਰ ਨਿਸੁ ਕਿਯਾ ਬਿਲਾਸਾ ॥",
      "transliteration": "chaar pahar nis kiyaa bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਤਾ ਪਿਤਾ ਦਾ ਡਰ ਛਡ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "चारि पहर निसु किया बिलासा ॥",
      "sourceLineId": "136377",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1315_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਜਿ ਕਰਿ ਮਾਤ ਪਿਤਾ ਕੋ ਤ੍ਰਾਸਾ ॥",
      "transliteration": "taj kar maat pitaa ko traasaa ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਰ ਪਹਿਰ ਰਾਤ ਤਕ ਬਿਲਾਸ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1315,
      "hindi": "",
      "hindiTransliteration": "तजि करि मात पिता को त्रासा ॥",
      "sourceLineId": "136378",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
