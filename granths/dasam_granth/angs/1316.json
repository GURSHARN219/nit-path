{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1316,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1316_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪੋਸਤ ਭਾਗਿ ਅਫੀਮ ਮੰਗਾਵਹਿ ॥",
      "transliteration": "posat bhaag afeem ma(n)gaaveh ||",
      "translation": "",
      "punjabiViakhya": "ਪੋਸਤ, ਭੰਗ ਅਤੇ ਅਫ਼ੀਮ ਮੰਗਵਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "पोसत भागि अफीम मंगावहि ॥",
      "sourceLineId": "136379",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਏਕ ਸੇਜ ਦੋਊ ਬੈਠ ਚੜਾਵਹਿ ॥੭॥",
      "transliteration": "ek sej dhouoo baiTh chaRaaveh ||7||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਇਕ ਮੰਜੀ ਉਤੇ ਬੈਠ ਕੇ ਖਾਈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "एक सेज दोऊ बैठ चड़ावहि ॥७॥",
      "sourceLineId": "136380",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕੈਫਹਿ ਹੋਤ ਰਸਮਸੇ ਜਬ ਹੀ ॥",
      "transliteration": "kaifeh hot rasamase jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਹੀ ਨਸ਼ੇ ਵਿਚ ਬਹਤੁ ਮਸਤ ਹੋਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "कैफहि होत रसमसे जब ही ॥",
      "sourceLineId": "136381",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕ੍ਰੀੜਾ ਕਰਤ ਦੋਊ ਮਿਲ ਤਬ ਹੀ ॥",
      "transliteration": "kreeRaa karat dhouoo mil tab hee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਦੋਹਾ ਨੇ ਮਿਲ ਕੇ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "क्रीड़ा करत दोऊ मिल तब ही ॥",
      "sourceLineId": "136382",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਆਸਨ ਲੈ ਕੈ ॥",
      "transliteration": "bhaat bhaat tan aasan lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਆਸਣ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन आसन लै कै ॥",
      "sourceLineId": "136383",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੁੰਬਨ ਔਰ ਅਲਿੰਗਨ ਕੈ ਕੈ ॥੮॥",
      "transliteration": "chu(n)ban aauar ali(n)gan kai kai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੁੰਬਨ ਤੇ ਆਲਿੰਗਨ ਲੈ ਕੇ (ਸੰਯੋਗ ਮਾਣਿਆ) ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "चुँबन और अलिंगन कै कै ॥८॥",
      "sourceLineId": "136384",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸ੍ਰਮਿਤ ਭਏ ਅਰੁ ਭੇ ਮਤਵਾਰੇ ॥",
      "transliteration": "sramit bhe ar bhe matavaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਥਕ ਗਏ ਅਤੇ ਨਸ਼ੇ ਵਿਚ ਮਤਵਾਲੇ ਹੋ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "स्रमित भए अरु भे मतवारे ॥",
      "sourceLineId": "136385",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੋਇ ਰਹੈ ਨਹਿ ਨੈਨ ਉਘਾਰੇ ॥",
      "transliteration": "soi rahai neh nain ughaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸੌਂ ਗਏ ਅਤੇ ਅੱਖਾ ਨਾ ਖੋਲ੍ਰਹੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "सोइ रहै नहि नैन उघारे ॥",
      "sourceLineId": "136386",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪ੍ਰਾਤਿ ਪਿਤਾ ਤਾ ਕੌ ਤਹ ਆਯੋ ॥",
      "transliteration": "praat pitaa taa kau teh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰੇ ਉਸ ਦਾ ਪਿਤਾ ਉਥੇ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "प्राति पिता ता कौ तह आयो ॥",
      "sourceLineId": "136387",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾਇ ਸਹਚਰੀ ਤਿਨੈ ਜਗਾਯੋ ॥੯॥",
      "transliteration": "jai sahacharee tinai jagaayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀ ਨੇ ਜਾ ਕੇ ਉਨ੍ਰਹਾ ਨੂੰ ਜਗਾ ਦਿੱਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "जाइ सहचरी तिनै जगायो ॥९॥",
      "sourceLineId": "136388",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਵਹੈ ਸਖੀ ਤਿਹ ਬਹੁਰਿ ਪਠਾਈ ॥",
      "transliteration": "vahai sakhee teh bahur paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸਖੀ ਨੂੰ ਫਿਰ ਉਥੇ (ਵਾਪਸ) ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "वहै सखी तिह बहुरि पठाई ॥",
      "sourceLineId": "136389",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਯੌ ਕਹਿਯਹੁ ਰਾਜਾ ਸੌ ਜਾਈ ॥",
      "transliteration": "yau kahiyahu raajaa sau jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਜੇ ਨੂੰ ਇਹ ਕਹਿਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "यौ कहियहु राजा सौ जाई ॥",
      "sourceLineId": "136390",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੌਕਾ ਪਰਾ ਭੋਜ ਦਿਜ ਕਾਰਨ ॥",
      "transliteration": "chauakaa paraa bhoj dhij kaaran ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਬ੍ਰਾਹਮਣਾ ਦੇ ਭੋਜ ਲਈ ਚੌਕਾ ਕੀਤਾ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "चौका परा भोज दिज कारन ॥",
      "sourceLineId": "136391",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਿਨੁ ਨ੍ਰਹਾਏ ਨ੍ਰਿਪ ਤਹ ਨ ਸਿਧਾਰਨ ॥੧੦॥",
      "transliteration": "bin nrahaae nirap teh na sidhaaran ||10||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਬਿਨਾ ਇਸ਼ਨਾਨ ਕੀਤੇ ਰਾਜਾ ਅੰਦਰ ਨਾ ਆਏ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "बिनु न्रहाए नृप तह न सिधारन ॥१०॥",
      "sourceLineId": "136392",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਸਤ੍ਰੁਤਾਰਿ ਕਰ ਇਹੀ ਅਨਾਵਹੁ ॥",
      "transliteration": "basatrutaar kar ihee anaavahu ||",
      "translation": "",
      "punjabiViakhya": "(ਸਖੀ ਨੇ ਕਿਹਾ) ਕਪੜੇ ਉਤਾਰ ਕੇ ਇਥੇ ਹੀ ਇਸ਼ਨਾਨ ਕਰ ਲਵੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "बसत्रुतारि कर इही अनावहु ॥",
      "sourceLineId": "136393",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁਰ ਸੁਤਾ ਕੇ ਧਾਮ ਸਿਧਾਵਹੁ ॥",
      "transliteration": "bahur sutaa ke dhaam sidhaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਲੜਕੀ ਦੇ ਘਰ ਵਲ ਜਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "बहुर सुता के धाम सिधावहु ॥",
      "sourceLineId": "136394",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭੂਪ ਬਚਨ ਸੁਨਿ ਬਸਤ੍ਰ ਉਤਾਰੇ ॥",
      "transliteration": "bhoop bachan sun basatr utaare ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਬਸਤ੍ਰ ਉਤਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "भूप बचन सुनि बसत्र उतारे ॥",
      "sourceLineId": "136395",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਹਬਚਾ ਮਹਿ ਨ੍ਰਹਾਨ ਸਿਧਾਰੇ ॥੧੧॥",
      "transliteration": "chahabachaa meh nrahaan sidhaare ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੌਬੱਚੇ ਵਿਚ ਇਸ਼ਨਾਨ ਕਰਨ ਲਈ ਚਲ ਪਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "चहबचा महि न्रहान सिधारे ॥११॥",
      "sourceLineId": "136396",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਬ ਡੁਬਿਆ ਕਹ ਭੂਪਤ ਲੀਨਾ ॥",
      "transliteration": "jab ddubiaa keh bhoopat leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਡੁਬਕੀ ਮਾਰੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "जब डुबिआ कह भूपत लीना ॥",
      "sourceLineId": "136397",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਬ ਹੀ ਕਾਢਿ ਮਿਤ੍ਰ ਕਹ ਦੀਨਾ ॥",
      "transliteration": "tab hee kaadd mitr keh dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ (ਰਾਜ ਕੁਮਾਰੀ ਨੇ) ਮਿਤਰ ਨੂੰ ਕਢ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "तब ही काढि मित्र कह दीना ॥",
      "sourceLineId": "136398",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਸਤ੍ਰ ਪਹਿਰਿ ਫਿਰਿ ਤਹਾ ਸਿਧਾਯੋ ॥",
      "transliteration": "basatr pahir fir tahaa sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਬਸਤ੍ਰ ਪਾ ਕੇ (ਰਾਜਾ) ਫਿਰ ਉਥੇ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "बसत्र पहिरि फिरि तहा सिधायो ॥",
      "sourceLineId": "136399",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਛੁ ਜੜ ਪਾਯੋ ॥੧੨॥",
      "transliteration": "bhedh abhedh na kachh jaR paayo ||12||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਨੇ ਭੇਦ ਅਭੇਦ ਕੁਝ ਨਾ ਸਮਝਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न कछु जड़ पायो ॥१२॥",
      "sourceLineId": "136400",
      "sourceShabadId": "12660",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "136401",
      "sourceShabadId": "12661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸ੍ਯਾਨੋ ਭੂਪ ਕਹਾਤ ਥੋ ਭਾਗ ਨ ਭੂਲ ਚਬਾਇ ॥",
      "transliteration": "sayaano bhoop kahaat tho bhaag na bhool chabai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜਾ ਆਪਣੇ ਆਪ ਨੂੰ ਸਿਆਣਾ ਕਹਿੰਦਾ ਸੀ ਅਤੇ ਭੰਗ ਦਾ ਸੇਵਨ ਭੁਲ ਕੇ ਵੀ ਨਹੀਂ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "स्यानो भूप कहात थो भाग न भूल चबाइ ॥",
      "sourceLineId": "136402",
      "sourceShabadId": "12661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਹ ਛਲ ਛਲਿ ਅਮਲੀ ਗਯੋ ਪਨਹੀ ਮੂੰਡ ਲਗਾਇ ॥੧੩॥",
      "transliteration": "eeh chhal chhal amalee gayo panahee moo(n)dd lagai ||13||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਉਹ ਅਮਲੀ ਛਲ ਕੇ ਚਲਾ ਗਿਆ ਅਤੇ (ਉਸ ਰਾਜੇ) ਦੇ ਸਿਰ ਉਤੇ ਜੁਤੀ ਮਾਰ ਗਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "इह छल छलि अमली गयो पनही मूँड लगाइ ॥१३॥",
      "sourceLineId": "136403",
      "sourceShabadId": "12661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪੈਸਠਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੫॥੬੬੩੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau paisaTh charitr samaapatam sat subham sat ||365||6633||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੬੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੬੫॥੬੬੩੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ पैसठि चरित्र समापतम सतु सुभम सतु ॥३६५॥६६३३॥अफजूँ॥",
      "sourceLineId": "136404",
      "sourceShabadId": "12661",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136405",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਔਰ ਪ੍ਰਸੰਗਾ ॥",
      "transliteration": "sun raajaa ik aauar prasa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਹੋਰ ਪ੍ਰਸੰਗ ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा इक और प्रसंगा ॥",
      "sourceLineId": "136406",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਸ ਛਲ ਕੀਨਾ ਨਾਰਿ ਸੁਰੰਗਾ ॥",
      "transliteration": "jas chhal keenaa naar sura(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ (ਇਕ) ਸੁੰਦਰ ਅੰਗਾ ਵਾਲੀ ਨੇ ਛਲ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "जस छल कीना नारि सुरंगा ॥",
      "sourceLineId": "136407",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਛਿਤਪਤਿ ਸਿੰਘ ਇਕ ਭੂਪਤ ਬਰ ॥",
      "transliteration": "chhitapat si(n)gh ik bhoopat bar ||",
      "translation": "",
      "punjabiViakhya": "ਛਿਤਪਤਿ ਨਾ ਦਾ ਇਕ ਚੰਗਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "छितपति सिंघ इक भूपत बर ॥",
      "sourceLineId": "136408",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਬਲਾ ਦੇ ਰਾਨੀ ਜਾ ਕੇ ਘਰ ॥੧॥",
      "transliteration": "abalaa dhe raanee jaa ke ghar ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਅਬਲਾ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "अबला दे रानी जा के घर ॥१॥",
      "sourceLineId": "136409",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਭ ਮਤੀ ਦੁਹਿਤਾ ਤਿਹ ਸੋਹੈ ॥",
      "transliteration": "naabh matee dhuhitaa teh sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਪੁੱਤਰੀ ਦਾ ਨਾ ਨਾਭ ਮਤੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "नाभ मती दुहिता तिह सोहै ॥",
      "sourceLineId": "136410",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁਰ ਨਰ ਨਾਗ ਅਸੁਰ ਮਨ ਮੋਹੈ ॥",
      "transliteration": "sur nar naag asur man mohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੇਵਤਿਆਂ, ਮਨੁੱਖਾ, ਨਾਗਾ ਅਤੇ ਦੈਂਤਾ ਦੇ ਮਨ ਮੋਹ ਲੈਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "सुर नर नाग असुर मन मोहै ॥",
      "sourceLineId": "136411",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਦੁਮਾਵਤੀ ਨਗਰ ਤਿਹ ਰਾਜਤ ॥",
      "transliteration": "padhumaavatee nagar teh raajat ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਇਕ) ਪਦੁਮਾਵਤੀ ਨਗਰ ਵਸਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "पदुमावती नगर तिह राजत ॥",
      "sourceLineId": "136412",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇੰਦ੍ਰਾਵਤੀ ਨਿਰਖਿ ਤਿਹ ਲਾਜਤ ॥੨॥",
      "transliteration": "ei(n)dhraavatee nirakh teh laajat ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਇੰਦ੍ਰਾਵਤੀ (ਨਗਰ) ਵੀ ਸ਼ਰਮਿੰਦਾ ਹੁੰਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "इंद्रावती निरखि तिह लाजत ॥२॥",
      "sourceLineId": "136413",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬੀਰ ਕਰਨ ਰਾਜਾ ਇਕ ਔਰੈ ॥",
      "transliteration": "beer karan raajaa ik aauarai ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰ ਕਰਨ ਨਾ ਦਾ ਇਕ ਹੋਰ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "बीर करन राजा इक औरै ॥",
      "sourceLineId": "136414",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭਦ੍ਰਾਵਤੀ ਬਸਤ ਥੋ ਠੌਰੈ ॥",
      "transliteration": "bhadhraavatee basat tho Thauarai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਭਦ੍ਰਾਵਤੀ ਨਗਰੀ ਵਿਚ ਰਹਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "भद्रावती बसत थो ठौरै ॥",
      "sourceLineId": "136415",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਐਂਠੀ ਸਿੰਘ ਪੂਤ ਤਿਹ ਜਾਯੋ ॥",
      "transliteration": "aai(n)Thee si(n)gh poot teh jaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ (ਘਰ) ਐਠੀ ਸਿੰਘ ਨਾ ਦੇ ਪੁੱਤਰ ਨੇ ਜਨਮ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "ऐंठी सिंघ पूत तिह जायो ॥",
      "sourceLineId": "136416",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਿਰਖਿ ਮਦਨ ਜਿਹ ਰੂਪ ਬਿਕਾਯੋ ॥੩॥",
      "transliteration": "nirakh madhan jeh roop bikaayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ ਕਾਮ ਦੇਵ ਵੀ ਵਿਕ ਜਾਦਾ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "निरखि मदन जिह रूप बिकायो ॥३॥",
      "sourceLineId": "136417",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੁਤ ਖੇਲਨ ਚੜਾ ਸਿਕਾਰਾ ॥",
      "transliteration": "nirap sut khelan chaRaa sikaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਾਜ ਕੁਮਾਰ ਸ਼ਿਕਾਰ ਖੇਡਣ ਚੜ੍ਰਹਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "नृप सुत खेलन चड़ा सिकारा ॥",
      "sourceLineId": "136418",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਵਤ ਭਯੋ ਤਿਹ ਨਗਰ ਮਝਾਰਾ ॥",
      "transliteration": "aavat bhayo teh nagar majhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਗਰੀ ਵਿਚ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "आवत भयो तिह नगर मझारा ॥",
      "sourceLineId": "136419",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨ੍ਰਹਾਵਤ ਹੁਤੀ ਜਹਾ ਨ੍ਰਿਪ ਬਾਰਿ ॥",
      "transliteration": "nrahaavat hutee jahaa nirap baar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਜੇ ਦੀ ਪੁੱਤਰੀ ਨਹਾ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "न्रहावत हुती जहा नृप बारि ॥",
      "sourceLineId": "136420",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਥਕਤਿ ਰਹਾ ਤਿਹ ਰੂਪ ਨਿਹਾਰਿ ॥੪॥",
      "transliteration": "thakat rahaa teh roop nihaar ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਰੂਪ ਨੂੰ ਵੇਖ ਕੇ ਸਿਥਲ ਹੋ ਗਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "थकति रहा तिह रूप निहारि ॥४॥",
      "sourceLineId": "136421",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਤਿਹ ਊਪਰ ਅਟਕੀ ॥",
      "transliteration": "raaj sutaa teh uoopar aTakee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ (ਵੀ ਉਸ ਨੂੰ ਵੇਖ ਕੇ) ਉਸ ਉਤੇ ਮੋਹਿਤ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "राज सुता तिह ऊपर अटकी ॥",
      "sourceLineId": "136422",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਸਰਿ ਗਈ ਉਤ ਤਿਹ ਸੁਧਿ ਘਟ ਕੀ ॥",
      "transliteration": "bisar giee ut teh sudh ghaT kee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਵੇਲੇ ਉਸ ਨੂੰ ਸ਼ਰੀਰ ਦੀ ਸੁੱਧ ਬੁੱਧ ਭੁਲ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "बिसरि गई उत तिह सुधि घट की ॥",
      "sourceLineId": "136423",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰੀਝ ਰਹੇ ਦੋਨੋ ਮਨ ਮਾਹੀ ॥",
      "transliteration": "reejh rahe dhono man maahee ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਮਨ ਵਿਚ (ਇਕ ਦੂਜੇ ਉਤੇ) ਰੀਝ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "रीझ रहे दोनो मन माही ॥",
      "sourceLineId": "136424",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਛੂ ਰਹੀ ਦੁਹੂੰਅਨਿ ਸੁਧਿ ਨਾਹੀ ॥੫॥",
      "transliteration": "kachhoo rahee dhuhoo(n)an sudh naahee ||5||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੂੰ ਕੋਈ ਸੁੱਧ ਬੁੱਧ ਨਾ ਰਹੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "कछू रही दुहूँअनि सुधि नाही ॥५॥",
      "sourceLineId": "136425",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1316_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਰੁਨਿ ਗਿਰਾ ਜਬ ਚਤੁਰ ਨਿਹਰਾ ॥",
      "transliteration": "tarun giraa jab chatur niharaa ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਮਾਰੀ ਨੇ ਜਦ ਉਸ ਚਤੁਰ ਪੁਰਸ਼ ਨੂੰ ਡਿਗਿਆ ਹੋਇਆ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1316,
      "hindi": "",
      "hindiTransliteration": "तरुनि गिरा जब चतुर निहरा ॥",
      "sourceLineId": "136426",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
