{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1317,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1317_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਾ ਕੀ ਹਾਥ ਨਾਭਿ ਪਰ ਧਰਾ ॥",
      "transliteration": "taa kee haath naabh par dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਦੀ ਨਾਭੀ ਉਤੇ ਆਪਣਾ ਹੱਥ ਰਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "ता की हाथ नाभि पर धरा ॥",
      "sourceLineId": "136427",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਰੁ ਪਦ ਪੰਕਜ ਹਾਥ ਲਗਾਈ ॥",
      "transliteration": "ar padh pa(n)kaj haath lagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ 'ਪਦ ਪੰਕਜ' (ਚਰਨ ਕਮਲਾ) ਨੂੰ ਹੱਥ ਲਗਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "अरु पद पंकज हाथ लगाई ॥",
      "sourceLineId": "136428",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੁਖ ਨ ਕਹਾ ਕਛੁ ਧਾਮ ਸਿਧਾਈ ॥੬॥",
      "transliteration": "mukh na kahaa kachh dhaam sidhaiee ||6||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹੋਂ ਕੁਝ ਨਾ ਕਿਹਾ ਅਤੇ ਘਰ ਨੂੰ ਚਲੀ ਗਈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "मुख न कहा कछु धाम सिधाई ॥६॥",
      "sourceLineId": "136429",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦ੍ਵੈਕ ਘਰੀ ਤਿਨ ਪਰੇ ਬਿਤਾਈ ॥",
      "transliteration": "dhavaik gharee tin pare bitaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਦੋ ਘੜੀਆਂ ਪਏ ਹੋਏ ਬਿਤਾਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "द्वैक घरी तिन परे बिताई ॥",
      "sourceLineId": "136430",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਕਹ ਪੁਨਿ ਸੁਧਿ ਆਈ ॥",
      "transliteration": "raaj kuar keh pun sudh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਫਿਰ ਹੋਸ਼ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "राज कुअर कह पुनि सुधि आई ॥",
      "sourceLineId": "136431",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਾਹਾ ਸਬਦ ਰਟਤ ਘਰ ਗਯੋ ॥",
      "transliteration": "haahaa sabadh raTat ghar gayo ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਇ ਹਾਇ' ਸ਼ਬਦ ਰਟਦਾ ਹੋਇਆ ਘਰ ਨੂੰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "हाहा सबद रटत घर गयो ॥",
      "sourceLineId": "136432",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਖਾਨ ਪਾਨ ਤਬ ਤੇ ਤਜਿ ਦਯੋ ॥੭॥",
      "transliteration": "khaan paan tab te taj dhayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਖਾਣਾ ਪੀਣਾ ਉਦੋਂ ਤੋਂ ਛਡ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "खान पान तब ते तजि दयो ॥७॥",
      "sourceLineId": "136433",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਿਰਹੀ ਭਏ ਦੋਊ ਨਰ ਨਾਰੀ ॥",
      "transliteration": "birahee bhe dhouoo nar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜ ਕੁਮਾਰੀ ਅਤੇ ਰਾਜ ਕੁਮਾਰ",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "बिरही भए दोऊ नर नारी ॥",
      "sourceLineId": "136434",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਅਰੁ ਰਾਜ ਕੁਮਾਰੀ ॥",
      "transliteration": "raaj kuar ar raaj kumaaree ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਨਰ-ਨਾਰੀ ਵਿਯੋਗੀ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "राज कुअर अरु राज कुमारी ॥",
      "sourceLineId": "136435",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਾਵ ਪਰਸਪਰ ਦੁਹੂਅਨ ਭਯੋ ॥",
      "transliteration": "haav parasapar dhuhooan bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਹਾਵ ਭਾਵ ਦੋਹਾ ਵਿਚ ਹੋਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "हाव परसपर दुहूअन भयो ॥",
      "sourceLineId": "136436",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੋ ਮੈ ਕਬਿਤਨ ਮਾਝ ਕਹਿਯੋ ॥੮॥",
      "transliteration": "so mai kabitan maajh kahiyo ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੈਂ ਕਵਿਤਾ ਵਿਚ ਕਹੇ ਹਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "सो मै कबितन माझ कहियो ॥८॥",
      "sourceLineId": "136437",
      "sourceShabadId": "12662",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "136438",
      "sourceShabadId": "12663",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਉਨ ਕੁੰਕਮ ਟੀਕੋ ਦਯੋ ਨ ਉਤੈ ਇਤ ਤੇਹੂੰ ਨ ਸੇਾਂਦੁਰ ਮਾਗ ਸਵਾਰੀ ॥",
      "transliteration": "aun ku(n)kam Teeko dhayo na utai it tehoo(n) na seaa(n)dhur maag savaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰ ਉਸ ਨੇ ਕੇਸਰ ਦਾ ਟਿਕਾ ਨਾ ਲਗਾਇਆ ਅਤੇ ਇਧਰ ਉਸ ਨੇ ਮਾਗ ਵਿਚ ਸੰਧੂਰ ਨਾ ਭਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "उन कुँकम टीको दयो न उतै इत तेहूँ न सेाँदुर माग सवारी ॥",
      "sourceLineId": "136439",
      "sourceShabadId": "12663",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤ੍ਯਾਗਿ ਦਯੋ ਸਭ ਕੋ ਡਰਵਾ ਸਭ ਹੂੰ ਕੀ ਇਤੈ ਤਿਹ ਲਾਜ ਬਿਸਾਰੀ ॥",
      "transliteration": "tayaag dhayo sabh ko ddaravaa sabh hoo(n) kee itai teh laaj bisaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਭ ਦਾ ਡਰ ਛਡ ਦਿੱਤਾ ਅਤੇ ਇਧਰ ਇਸ ਨੇ ਸਭ ਦੀ ਲਾਜ ਮਰਯਾਦਾ ਭੁਲਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "त्यागि दयो सभ को डरवा सभ हूँ की इतै तिह लाज बिसारी ॥",
      "sourceLineId": "136440",
      "sourceShabadId": "12663",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹਾਰ ਤਜੇ ਤਿਨ ਹੇਰਬ ਤੇ ਸਜਨੀ ਲਖਿ ਕੋਟਿ ਹਹਾ ਕਰਿ ਹਾਰੀ ॥",
      "transliteration": "haar taje tin herab te sajanee lakh koT hahaa kar haaree ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਉਸ ਨੂੰ ਵੇਖਣ ਨਾਲ ਹੀ ਹਾਰ ਪਾਣੇ ਛਡ ਦਿੱਤੇ ਅਤੇ ਇਸਤਰੀ ਬਹੁਤ ਵਾਰ 'ਹਾਇ ਹਾਇ' ਕਰ ਕੇ ਥਕ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "हार तजे तिन हेरब ते सजनी लखि कोटि हहा करि हारी ॥",
      "sourceLineId": "136441",
      "sourceShabadId": "12663",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਾਨ ਤਜੇ ਤੁਮ ਤਾ ਹਿਤ ਪ੍ਰੀਤਮ ਪ੍ਰਾਨ ਤਜੇ ਤੁਮਰੇ ਹਿਤ ਪ੍ਯਾਰੀ ॥੯॥",
      "transliteration": "paan taje tum taa hit preetam praan taje tumare hit payaaree ||9||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪ੍ਰੀਤਮ! ਤੁਸੀਂ ਉਸ ਲਈ ਖਾਣਾ ਪੀਣਾ ਛਡ ਦਿੱਤਾ ਹੈ ਅਤੇ (ਉਸ) ਪਿਆਰੀ ਨੇ ਤੁਹਾਡੇ ਲਈ ਪ੍ਰਾਣ ਤਿਆਗ ਦੇਣ (ਦਾ ਮਨ ਬਣਾ ਲਿਆ ਹੈ) ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "पान तजे तुम ता हित प्रीतम प्रान तजे तुमरे हित प्यारी ॥९॥",
      "sourceLineId": "136442",
      "sourceShabadId": "12663",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136443",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਉਤੈ ਕੁਅਰਿ ਕਹ ਕਛੂ ਨ ਭਾਵੈ ॥",
      "transliteration": "autai kuar keh kachhoo na bhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਕੁਝ ਚੰਗਾ ਨਾ ਲਗਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "उतै कुअरि कह कछू न भावै ॥",
      "sourceLineId": "136444",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਹਾ ਸਬਦ ਦਿਨ ਕਹਤ ਬਿਤਾਵੈ ॥",
      "transliteration": "hahaa sabadh dhin kahat bitaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ 'ਹਾਇ ਹਾਇ' ਕਰਦਾ ਦਿਨ ਬਿਤਾ ਦਿੰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "हहा सबद दिन कहत बितावै ॥",
      "sourceLineId": "136445",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅੰਨ ਨ ਖਾਤ ਪਿਯਤ ਨਹਿ ਪਾਨੀ ॥",
      "transliteration": "a(n)n na khaat piyat neh paanee ||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਅੰਨ ਖਾਦਾ ਅਤੇ ਨਾ ਪਾਣੀ ਪੀਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "अंन न खात पियत नहि पानी ॥",
      "sourceLineId": "136446",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਿਤ੍ਰ ਹੁਤੋ ਤਿਹ ਤਿਨ ਪਹਿਚਾਨੀ ॥੧੦॥",
      "transliteration": "mitr huto teh tin pahichaanee ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਇਕ ਮਿਤਰ ਸੀ ਜਿਸ ਨੇ ਇਹ ਗੱਲ ਸਮਝ ਲਈ ਸੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "मित्र हुतो तिह तिन पहिचानी ॥१०॥",
      "sourceLineId": "136447",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕੁਅਰ ਬ੍ਰਿਥਾ ਜਿਯ ਕੀ ਤਿਹ ਦਈ ॥",
      "transliteration": "kuar birathaa jiy kee teh dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਨੇ ਮਨ ਦੀ ਸਾਰੀ ਬਿਰਥਾ ਉਸ ਨੂੰ ਦਸ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "कुअर बृथा जिय की तिह दई ॥",
      "sourceLineId": "136448",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਕ ਤ੍ਰਿਯ ਮੋਹਿ ਦਰਸ ਦੈ ਗਈ ॥",
      "transliteration": "eik tiray moh dharas dhai giee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਕ ਇਸਤਰੀ ਮੈਨੂੰ ਦੀਦਾਰ ਦੇ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "इक तृय मोहि दरस दै गई ॥",
      "sourceLineId": "136449",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਭ ਪਾਵ ਪਰ ਹਾਥ ਲਗਾਇ ॥",
      "transliteration": "naabh paav par haath lagai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਮੇਰੀ ਨਾਭੀ (ਧੁੰਨੀ) ਅਤੇ ਪੈਰਾ ਉਤੇ ਹੱਥ ਲਗਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "नाभ पाव पर हाथ लगाइ ॥",
      "sourceLineId": "136450",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਫਿਰਿ ਨ ਲਖਾ ਕਹ ਗਈ ਸੁ ਕਾਇ ॥੧੧॥",
      "transliteration": "fir na lakhaa keh giee su kai ||11||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਪਤਾ ਨਾ ਲਗਾ ਕਿ ਉਹ ਕਿਥੇ ਗਈ ਅਤੇ ਕੌਣ ਸੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "फिरि न लखा कह गई सु काइ ॥११॥",
      "sourceLineId": "136451",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਾ ਕੀ ਬਾਤ ਨ ਤਾਹਿ ਪਛਾਨੀ ॥",
      "transliteration": "taa kee baat na taeh pachhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਰਾਜ ਕੁਮਾਰ) ਦੀ ਗੱਲ ਉਸ (ਮਿਤਰ) ਨੇ ਨਾ ਸਮਝੀ",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "ता की बात न ताहि पछानी ॥",
      "sourceLineId": "136452",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਹਾ ਕੁਅਰ ਇਨ ਮੁਝੈ ਬਖਾਨੀ ॥",
      "transliteration": "kahaa kuar in mujhai bakhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਕੁੰਵਰ ਨੇ ਮੈਨੂੰ ਕੀ ਕਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "कहा कुअर इन मुझै बखानी ॥",
      "sourceLineId": "136453",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪੂਛਿ ਪੂਛਿ ਸਭ ਹੀ ਤਿਹ ਜਾਵੈ ॥",
      "transliteration": "poochh poochh sabh hee teh jaavai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਬੰਦੇ ਉਸ ਨੂੰ ਪੁਛ ਪੁਛ ਕੇ ਜਾਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "पूछि पूछि सभ ही तिह जावै ॥",
      "sourceLineId": "136454",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾ ਕੋ ਮਰਮੁ ਨ ਕੋਈ ਪਾਵੈ ॥੧੨॥",
      "transliteration": "taa ko maram na koiee paavai ||12||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਦੇ ਭੇਦ ਨੂੰ ਕੋਈ ਵੀ ਸਮਝ ਨਾ ਸਕਦਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "ता को मरमु न कोई पावै ॥१२॥",
      "sourceLineId": "136455",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਾ ਕੋ ਮਿਤ੍ਰ ਹੁਤੋ ਖਤਰੇਟਾ ॥",
      "transliteration": "taa ko mitr huto khatareTaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਇਕ ਛਤ੍ਰੀ ('ਖਤਰੇਟਾ') ਮਿਤਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "ता को मित्र हुतो खतरेटा ॥",
      "sourceLineId": "136456",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਸਕ ਮੁਸਕ ਕੇ ਸਾਥ ਲਪੇਟਾ ॥",
      "transliteration": "eisak musak ke saath lapeTaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਸ਼ਕ ਮੁਸ਼ਕ ਵਿਚ ਭਿਜਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "इसक मुसक के साथ लपेटा ॥",
      "sourceLineId": "136457",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕੁਅਰ ਤਵਨ ਪਹਿ ਬ੍ਰਿਥਾ ਸੁਨਾਈ ॥",
      "transliteration": "kuar tavan peh birathaa sunaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕੁੰਵਰ ਨੇ ਉਸ ਨੂੰ ਆਪਣੀ ਬਿਰਥਾ ਸੁਣਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "कुअर तवन पहि बृथा सुनाई ॥",
      "sourceLineId": "136458",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁਨਤ ਬਾਤ ਸਭ ਹੀ ਤਿਨ ਪਾਈ ॥੧੩॥",
      "transliteration": "sunat baat sabh hee tin paiee ||13||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਗੱਲ ਸੁਣਦਿਆਂ ਹੀ ਸਭ ਕੁਝ ਸਮਝ ਗਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "सुनत बात सभ ही तिन पाई ॥१३॥",
      "sourceLineId": "136459",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਭ ਮਤੀ ਤਿਹ ਨਾਮ ਪਛਾਨਾ ॥",
      "transliteration": "naabh matee teh naam pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਉਸ ਇਸਤਰੀ ਦਾ ਨਾ ਨਾਭ ਮਤੀ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "नाभ मती तिह नाम पछाना ॥",
      "sourceLineId": "136460",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਹ ਨਾਭੀ ਕਹ ਹਾਥ ਛੁਆਨਾ ॥",
      "transliteration": "jeh naabhee keh haath chhuaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਉਸ ਦੀ ਨਾਭੀ ਨੂੰ ਛੋਹਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "जिह नाभी कह हाथ छुआना ॥",
      "sourceLineId": "136461",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪਦੁਮਾਵਤੀ ਨਗਰ ਠਹਰਾਯੌ ॥",
      "transliteration": "padhumaavatee nagar Thaharaayau ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਨਗਰ ਦਾ ਨਾ ਪਦਮਾਵਤੀ ਸਮਝਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "पदुमावती नगर ठहरायौ ॥",
      "sourceLineId": "136462",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਾ ਤੇ ਪਦ ਪੰਕਜ ਕਰ ਲਾਯੋ ॥੧੪॥",
      "transliteration": "taa te padh pa(n)kaj kar laayo ||14||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਕਿ ਉਸ ਨੇ ਪਦ ਪੰਕਜ (ਚਰਨ ਕਮਲਾ) ਨੂੰ ਹੱਥ ਲਾਇਆ ਸੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "ता ते पद पंकज कर लायो ॥१४॥",
      "sourceLineId": "136463",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੋਊ ਚਲੇ ਤਹ ਤੇ ਉਠਿ ਸੋਊ ॥",
      "transliteration": "dhouoo chale teh te uTh souoo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੋਵੇਾਂ ਉਥੋਂ ਉਠ ਕੇ ਚਲ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "दोऊ चले तह ते उठि सोऊ ॥",
      "sourceLineId": "136464",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੀਸਰ ਤਹਾ ਨ ਪਹੂਚਾ ਕੋਊ ॥",
      "transliteration": "teesar tahaa na pahoochaa kouoo ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਹੋਰ ਤੀਜਾ ਕੋਈ ਨਾ ਪਹੁੰਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "तीसर तहा न पहूचा कोऊ ॥",
      "sourceLineId": "136465",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਦੁਮਾਵਤੀ ਨਗਰ ਥਾ ਜਹਾ ॥",
      "transliteration": "padhumaavatee nagar thaa jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਪਦਮਾਵਤੀ ਨਗਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "पदुमावती नगर था जहा ॥",
      "sourceLineId": "136466",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਭ ਮਤੀ ਸੁੰਦਰਿ ਥੀ ਤਹਾ ॥੧੫॥",
      "transliteration": "naabh matee su(n)dhar thee tahaa ||15||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਨਾਭ ਮਤੀ ਨਾ ਦੀ ਸੁੰਦਰੀ ਸੀ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "नाभ मती सुँदरि थी तहा ॥१५॥",
      "sourceLineId": "136467",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪੂਛਤ ਚਲੇ ਤਿਸੀ ਪੁਰ ਆਏ ॥",
      "transliteration": "poochhat chale tisee pur aae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਨਗਰ ਨੂੰ ਪੁਛਦੇ ਪੁਛਾਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "पूछत चले तिसी पुर आए ॥",
      "sourceLineId": "136468",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪਦੁਮਾਵਤੀ ਨਗਰ ਨਿਯਰਾਏ ॥",
      "transliteration": "padhumaavatee nagar niyaraae ||",
      "translation": "",
      "punjabiViakhya": "ਪਦਮਾਵਤੀ ਨਗਰ ਦੇ ਨੇੜੇ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "पदुमावती नगर नियराए ॥",
      "sourceLineId": "136469",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮਾਲਿਨਿ ਹਾਰ ਗੁਹਤ ਥੀ ਜਹਾ ॥",
      "transliteration": "maalin haar guhat thee jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਇਕ ਮਾਲਣ ਹਾਰ ਗੁੰਦ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "मालिनि हार गुहत थी जहा ॥",
      "sourceLineId": "136470",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪ੍ਰਾਪਤਿ ਭਏ ਕੁਅਰ ਜੁਤ ਤਹਾ ॥੧੬॥",
      "transliteration": "praapat bhe kuar jut tahaa ||16||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਕੁੰਵਰ ਸਹਿਤ ਆ ਪਹੁੰਚੇ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "प्रापति भए कुअर जुत तहा ॥१६॥",
      "sourceLineId": "136471",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਏਕ ਮੁਹਰ ਮਾਲਨਿ ਕਹ ਦਿਯੋ ॥",
      "transliteration": "ek muhar maalan keh dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਮੋਹਰ ਮਾਲਣ ਨੂੰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "एक मुहर मालनि कह दियो ॥",
      "sourceLineId": "136472",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਾਰ ਗੁਹਨ ਤਿਹ ਨ੍ਰਿਪ ਸੁਤ ਲਿਯੋ ॥",
      "transliteration": "haar guhan teh nirap sut liyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਤੋਂ ਰਾਜ ਕੁਮਾਰ ਨੇ ਹਾਰ ਗੁੰਦਣ ਲਈ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "हार गुहन तिह नृप सुत लियो ॥",
      "sourceLineId": "136473",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1317_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਲਿਖਿ ਪਤ੍ਰੀ ਤਾ ਮਹਿ ਗੁਹਿ ਡਾਰੀ ॥",
      "transliteration": "likh patree taa meh guh ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਚਿੱਠੀ ਲਿਖ ਕੇ ਉਸ ਵਿਚ ਗੁੰਦ ਦਿੱਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1317,
      "hindi": "",
      "hindiTransliteration": "लिखि पत्री ता महि गुहि डारी ॥",
      "sourceLineId": "136474",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
