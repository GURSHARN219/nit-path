{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1318,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1318_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਸ ਹਾਥਨ ਲੈ ਪੜੇ ਪ੍ਯਾਰੀ ॥੧੭॥",
      "transliteration": "jis haathan lai paRe payaaree ||17||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਪਿਆਰੀ ਹੱਥਾ ਵਿਚ ਲੈ ਕੇ ਪੜ੍ਰਹੇ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "जिस हाथन लै पड़े प्यारी ॥१७॥",
      "sourceLineId": "136475",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤੈ ਜਿਹ ਹਾਥ ਨਾਭਿ ਕਹ ਲਾਯੋ ॥",
      "transliteration": "tai jeh haath naabh keh laayo ||",
      "translation": "",
      "punjabiViakhya": "(ਪੱਤਰ ਵਿਚ ਲਿਖ ਦਿੱਤਾ ਕਿ) ਤੂੰ ਜਿਸ ਦੀ ਨਾਭੀ ਨੂੰ ਹੱਥ ਲਗਾਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "तै जिह हाथ नाभि कह लायो ॥",
      "sourceLineId": "136476",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਔਰ ਦੁਹੂੰ ਪਦ ਹਾਥ ਛੁਹਾਯੋ ॥",
      "transliteration": "aauar dhuhoo(n) padh haath chhuhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਪੈਰਾ ਨਾਲ ਹੱਥ ਛੋਹਾਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "और दुहूँ पद हाथ छुहायो ॥",
      "sourceLineId": "136477",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤੇ ਜਨ ਆਜੁ ਨਗਰ ਮਹਿ ਆਏ ॥",
      "transliteration": "te jan aaj nagar meh aae ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵਿਅਕਤੀ ਅਜ ਨਗਰ ਵਿਚ ਆਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "ते जन आजु नगर महि आए ॥",
      "sourceLineId": "136478",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੁਮ ਸੌ ਚਾਹਤ ਨੈਨ ਮਿਲਾਏ ॥੧੮॥",
      "transliteration": "tum sau chaahat nain milaae ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੇਰੇ ਨਾਲ ਨੈਣ ਮਿਲਾਣਾ ਚਾਹੁੰਦਾ ਹੈ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "तुम सौ चाहत नैन मिलाए ॥१८॥",
      "sourceLineId": "136479",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਪਤਿਯਾ ਜਬ ਚੀਨੀ ॥",
      "transliteration": "raaj sutaa patiyaa jab cheenee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਚਿੱਠੀ ਵੇਖੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "राज सुता पतिया जब चीनी ॥",
      "sourceLineId": "136480",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਛੋਰਿ ਲਈ ਕਰ ਕਿਸੂ ਨ ਦੀਨੀ ॥",
      "transliteration": "chhor liee kar kisoo na dheenee ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਹਾਰ ਨਾਲੋਂ) ਖੋਲ੍ਰਹ ਲਈ ਅਤੇ ਕਿਸੇ ਦੇ ਹੱਥ ਵਿਚ ਨਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "छोरि लई कर किसू न दीनी ॥",
      "sourceLineId": "136481",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਹੁ ਧਨ ਦੈ ਮਾਲਿਨੀ ਬੁਲਾਈ ॥",
      "transliteration": "bahu dhan dhai maalinee bulaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਧਨ ਦੇ ਕੇ ਮਾਲਣ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "बहु धन दै मालिनी बुलाई ॥",
      "sourceLineId": "136482",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਲਿਖਿ ਪਤ੍ਰੀ ਫਿਰਿ ਤਿਨੈ ਪਠਾਈ ॥੧੯॥",
      "transliteration": "likh patree fir tinai paThaiee ||19||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ (ਆਪ) ਪੱਤਰ ਲਿਖ ਕੇ ਉਸ ਨੂੰ ਭੇਜਿਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "लिखि पत्री फिरि तिनै पठाई ॥१९॥",
      "sourceLineId": "136483",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਿਵ ਕੌ ਦਿਪਤ ਦੇਹਰੋ ਜਹਾ ॥",
      "transliteration": "siv kau dhipat dheharo jahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਪੱਤਰ ਵਿਚ ਸੰਕੇਤ ਕੀਤਾ) ਜਿਥੇ ਸ਼ਿਵ ਦਾ ਮੰਦਿਰ ਸੁਸ਼ੋਭਿਤ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "सिव कौ दिपत देहरो जहा ॥",
      "sourceLineId": "136484",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੈ ਐਹੋ ਆਧੀ ਨਿਸਿ ਤਹਾ ॥",
      "transliteration": "mai aaiho aadhee nis tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਉਥੇ ਅੱਧੀ ਰਾਤ ਨੂੰ ਆਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "मै ऐहो आधी निसि तहा ॥",
      "sourceLineId": "136485",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕੁਅਰ ਤਹਾ ਤੁਮਹੂੰ ਚਲਿ ਐਯਹੁ ॥",
      "transliteration": "kuar tahaa tumahoo(n) chal aaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਕੁੰਵਰ! ਤੂੰ ਉਥੇ ਚਲ ਕੇ ਆ ਜਾਈਂ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "कुअर तहा तुमहूँ चलि ऐयहु ॥",
      "sourceLineId": "136486",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਨ ਭਾਵਤ ਕੋ ਭੋਗ ਕਮੈਯਹੁ ॥੨੦॥",
      "transliteration": "man bhaavat ko bhog kamaiyahu ||20||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਨਾਲ ਮਨ ਭਾਉਾਂਦਾ ਰਮਣ ਕਰੀਂ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "मन भावत को भोग कमैयहु ॥२०॥",
      "sourceLineId": "136487",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੁਅਰ ਨਿਸਾ ਆਧੀ ਤਹ ਜਾਈ ॥",
      "transliteration": "kuar nisaa aadhee teh jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਮਾਰ ਅੱਧੀ ਰਾਤ ਵੇਲੇ ਉਥੇ ਪਹੁੰਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "कुअर निसा आधी तह जाई ॥",
      "sourceLineId": "136488",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਆਗੇ ਤਹ ਆਈ ॥",
      "transliteration": "raaj sutaa aage teh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਰਾਜ ਕੁਮਾਰੀ ਪਹਿਲਾ ਹੀ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "राज सुता आगे तह आई ॥",
      "sourceLineId": "136489",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਕੀ ਜੇਤਿਕ ਪ੍ਯਾਸਾ ॥",
      "transliteration": "kaam bhog kee jetik payaasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਵਿਚ) ਕਾਮ ਭੋਗ ਦੀ ਜਿਤਨੀ ਪਿਆਸ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "काम भोग की जेतिक प्यासा ॥",
      "sourceLineId": "136490",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪੂਰਨਿ ਭਈ ਦੁਹੂੰ ਕੀ ਆਸਾ ॥੨੧॥",
      "transliteration": "pooran bhiee dhuhoo(n) kee aasaa ||21||",
      "translation": "",
      "punjabiViakhya": "(ਮਿਲਣ ਤੇ) ਦੋਹਾ ਨੇ ਬੁਝਾ ਲਈ (ਅਰਥਾਤ ਇੱਛਾ ਪੂਰੀ ਹੋ ਗਈ) ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "पूरनि भई दुहूँ की आसा ॥२१॥",
      "sourceLineId": "136491",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਾਲਿਨਿ ਕੀ ਦੁਹਿਤਾ ਕਹਿ ਬਾਮਾ ॥",
      "transliteration": "maalin kee dhuhitaa keh baamaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਮਾਲਣ ਦੀ ਧੀ ਕਹਿ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "मालिनि की दुहिता कहि बामा ॥",
      "sourceLineId": "136492",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਕਹ ਲ੍ਯਾਈ ਧਾਮਾ ॥",
      "transliteration": "raaj kuar keh layaiee dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਆਪਣੇ ਘਰ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "राज कुअर कह ल्याई धामा ॥",
      "sourceLineId": "136493",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਤਿ ਦਿਵਸ ਦੋਊ ਕਰਤ ਬਿਲਾਸਾ ॥",
      "transliteration": "raat dhivas dhouoo karat bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦਾ ਡਰ ਭੁਲਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "राति दिवस दोऊ करत बिलासा ॥",
      "sourceLineId": "136494",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੂਪਤਿ ਕੀ ਤਜਿ ਕਰਿ ਕਰਿ ਤ੍ਰਾਸਾ ॥੨੨॥",
      "transliteration": "bhoopat kee taj kar kar traasaa ||22||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਦੋਵੇਾਂ ਬਿਲਾਸ ਕਰਦੇ ਸਨ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "भूपति की तजि करि करि त्रासा ॥२२॥",
      "sourceLineId": "136495",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਿਤਕ ਦਿਨਨ ਤਾ ਕੋ ਪਤਿ ਆਯੋ ॥",
      "transliteration": "kitak dhinan taa ko pat aayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਦਿਨਾ ਬਾਦ ਉਸ ਦਾ ਪਤੀ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "कितक दिनन ता को पति आयो ॥",
      "sourceLineId": "136496",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਤਿ ਕੁਰੂਪ ਨਹਿ ਜਾਤ ਬਤਾਯੋ ॥",
      "transliteration": "at kuroop neh jaat bataayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਹੁਤ ਕੁਰੂਪ ਸੀ, (ਜਿਸ ਦਾ) ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "अति कुरूप नहि जात बतायो ॥",
      "sourceLineId": "136497",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੂਕਰ ਕੇ ਸੇ ਦਾਤਿ ਬਿਰਾਜੈ ॥",
      "transliteration": "sookar ke se dhaat biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰ ਵਰਗੇ (ਉਸ ਦੇ) ਦੰਦ ਲਗਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "सूकर के से दाति बिराजै ॥",
      "sourceLineId": "136498",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਿਰਖਤ ਕਰੀ ਰਦਨ ਦ੍ਵੈ ਭਾਜੈ ॥੨੩॥",
      "transliteration": "nirakhat karee radhan dhavai bhaajai ||23||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ ਹਾਥੀ ਦੇ ਦੋਵੇਾਂ ਦੰਦ ਭਜ ਜਾਦੇ ਸਨ (ਭਾਵ-ਤੁੱਛ ਲਗਦੇ ਸਨ) ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "निरखत करी रदन द्वै भाजै ॥२३॥",
      "sourceLineId": "136499",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਤ੍ਰਿਯ ਭੇਸ ਸੁ ਧਾਰੇ ॥",
      "transliteration": "raaj kuar tiray bhes su dhaare ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਨੇ ਇਸਤਰੀ ਦਾ ਭੇਸ ਧਾਰਨ ਕੀਤਾ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "राज कुअर तृय भेस सु धारे ॥",
      "sourceLineId": "136500",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਆਵਤ ਭਯੋ ਤਿਹ ਨਿਕਟ ਸਵਾਰੇ ॥",
      "transliteration": "aavat bhayo teh nikaT savaare ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਦਾ ਪਤੀ) ਸਵੇਰੇ ('ਸਵਾਰੇ') ਉਸ ਕੋਲ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "आवत भयो तिह निकट सवारे ॥",
      "sourceLineId": "136501",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਪਹਿ ਨਿਰਖਿ ਲੁਭਾਯੋ ॥",
      "transliteration": "raaj sutaa peh nirakh lubhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਰਾਜ ਕੁਮਾਰੀ (ਇਸਤਰੀ ਬਣਿਆ ਰਾਜ ਕੁਮਾਰ) ਨੂੰ ਵੇਖ ਕੇ ਲੁਭਾਇਮਾਨ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "राज सुता पहि निरखि लुभायो ॥",
      "sourceLineId": "136502",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭੋਗ ਕਰਨ ਹਿਤ ਹਾਥ ਚਲਾਯੋ ॥੨੪॥",
      "transliteration": "bhog karan hit haath chalaayo ||24||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਸੰਯੋਗ ਕਰਨ ਲਈ ਹੱਥ ਵਧਾਇਆ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "भोग करन हित हाथ चलायो ॥२४॥",
      "sourceLineId": "136503",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਤਬ ਛੁਰੀ ਸੰਭਾਰੀ ॥",
      "transliteration": "raaj kuar tab chhuree sa(n)bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਨੇ ਤਦ ਛੁਰੀ ਸੰਭਾਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "राज कुअर तब छुरी संभारी ॥",
      "sourceLineId": "136504",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾਕ ਕਾਟਿ ਨ੍ਰਿਪ ਸੁਤ ਕੀ ਡਾਰੀ ॥",
      "transliteration": "naak kaaT nirap sut kee ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੇ ਪੁੱਤਰ ਦਾ ਨੱਕ ਕਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "नाक काटि नृप सुत की डारी ॥",
      "sourceLineId": "136505",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਕ ਕਟੈ ਜੜ ਅਧਿਕ ਖਿਸਾਯੋ ॥",
      "transliteration": "naak kaTai jaR adhik khisaayo ||",
      "translation": "",
      "punjabiViakhya": "ਨੱਕ ਕਟੇ ਜਾਣ ਕਰ ਕੇ ਮੂਰਖ ਬਹੁਤ ਖਿਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "नाक कटै जड़ अधिक खिसायो ॥",
      "sourceLineId": "136506",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਦਨ ਛਾਡਿ ਕਾਨਨਹਿ ਸਿਧਾਯੋ ॥੨੫॥",
      "transliteration": "sadhan chhaadd kaananeh sidhaayo ||25||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਰ ਛਡ ਕੇ ਜੰਗਲ ਨੂੰ ਚਲਿਆ ਗਿਆ ॥੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "सदन छाडि काननहि सिधायो ॥२५॥",
      "sourceLineId": "136507",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਕ ਕਟਾਇ ਜਬੈ ਜੜ ਗਯੋ ॥",
      "transliteration": "naak kaTai jabai jaR gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਮੂਰਖ ਨੱਕ ਕਟਾ ਕੇ ਚਲਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "नाक कटाइ जबै जड़ गयो ॥",
      "sourceLineId": "136508",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਨ ਪਥ ਸਿਵ ਦੇਵਲ ਕੋ ਲਯੋ ॥",
      "transliteration": "ein path siv dheval ko layo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਨ੍ਰਹਾ ਨੇ ਸ਼ਿਵ ਮੰਦਿਰ ਦਾ ਰਸਤਾ ਪਕੜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "इन पथ सिव देवल को लयो ॥",
      "sourceLineId": "136509",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੁਤ ਮ੍ਰਿਗਿਕ ਹਿਤੂ ਹਨਿ ਲ੍ਯਾਯੋ ॥",
      "transliteration": "nirap sut miragik hitoo han layaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਇਕ ਹਿਰਨ ਮਾਰ ਕੇ ਲੈ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "नृप सुत मृगिक हितू हनि ल्यायो ॥",
      "sourceLineId": "136510",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਬੈਠਿ ਤਿਹੀ ਠਾ ਖਾਯੋ ॥੨੬॥",
      "transliteration": "dhuhoo(n)an baiTh tihee Thaa khaayo ||26||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਦੋਹਾ ਨੇ ਉਸੇ ਥਾ ਤੇ ਬੈਠ ਕੇ ਖਾਇਆ ॥੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन बैठि तिही ठा खायो ॥२६॥",
      "sourceLineId": "136511",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਹੀ ਬੈਠਿ ਦੁਹੂੰ ਕਰੇ ਬਿਲਾਸਾ ॥",
      "transliteration": "tahee baiTh dhuhoo(n) kare bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬੈਠ ਕੇ ਦੋਹਾ ਨੇ ਬਿਲਾਸ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "तही बैठि दुहूँ करे बिलासा ॥",
      "sourceLineId": "136512",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤ੍ਰਿਯਹਿ ਨ ਰਹੀ ਭੋਗ ਕੀ ਆਸਾ ॥",
      "transliteration": "tirayeh na rahee bhog kee aasaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਦੀ ਭੋਗ ਲਈ ਕੋਈ ਇੱਛਾ ਬਾਕੀ ਨਾ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "तृयहि न रही भोग की आसा ॥",
      "sourceLineId": "136513",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲੈ ਤਾ ਕੇ ਸੰਗ ਦੇਸ ਸਿਧਾਯੋ ॥",
      "transliteration": "lai taa ke sa(n)g dhes sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰ) ਉਸ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਦੇਸ ਨੂੰ ਚਲਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "लै ता के संग देस सिधायो ॥",
      "sourceLineId": "136514",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਕ ਸਹਚਰਿ ਕਹ ਤਹਾ ਪਠਾਯੋ ॥੨੭॥",
      "transliteration": "eik sahachar keh tahaa paThaayo ||27||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਸਖੀ ਨੂੰ ਉਸ ਥਾ ਉਤੇ ਭੇਜਿਆ ॥੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "इक सहचरि कह तहा पठायो ॥२७॥",
      "sourceLineId": "136515",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਡਿਵਢੀ ਸਾਤ ਸਖੀ ਤਿਨ ਨਾਖੀ ॥",
      "transliteration": "ddivaddee saat sakhee tin naakhee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸਖੀ ਨੇ ਸੱਤ ਡਿਉਢੀਆਂ ਪਾਰ ਕੀਤੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "डिवढी सात सखी तिन नाखी ॥",
      "sourceLineId": "136516",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਮਿ ਬਤੀਆ ਭੂਪਤਿ ਸੰਗ ਭਾਖੀ ॥",
      "transliteration": "eim bateeaa bhoopat sa(n)g bhaakhee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਜਾ ਕੇ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "इमि बतीआ भूपति संग भाखी ॥",
      "sourceLineId": "136517",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਤਿ ਤ੍ਰਿਯ ਗਏ ਦੋਊ ਨਿਸਿ ਕਹ ਤਹ ॥",
      "transliteration": "pat tiray ge dhouoo nis keh teh ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਡੀ ਪੁੱਤਰੀ ਅਤੇ ਉਸ ਦਾ ਪਤੀ ਦੋਵੇਾਂ ਰਾਤ ਨੂੰ ਉਥੇ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "पति तृय गए दोऊ निसि कह तह ॥",
      "sourceLineId": "136518",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਗੇ ਹੁਤੇ ਸਦਾ ਸਿਵ ਜੂ ਜਹ ॥੨੮॥",
      "transliteration": "aage hute sadhaa siv joo jeh ||28||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਅਗੇ ਸਦਾ ਸ਼ਿਵ (ਦਾ ਮੰਦਿਰ) ਸੀ ॥੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "आगे हुते सदा सिव जू जह ॥२८॥",
      "sourceLineId": "136519",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੁਹੂੰ ਜਾਇ ਤਹ ਕੀਏ ਪ੍ਰਯੋਗਾ ॥",
      "transliteration": "dhuhoo(n) jai teh ke'ee prayogaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੋਹਾ ਨੇ ਉਥੇ (ਮੰਦਿਰ ਵਿਚ) ਜਾ ਕੇ ਮੰਤ੍ਰ ਸਿੱਧ ਕਰਨ ਦਾ ਯਤਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "दुहूँ जाइ तह कीए प्रयोगा ॥",
      "sourceLineId": "136520",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤੀਸਰ ਕੋਈ ਨ ਜਾਨਤ ਲੋਗਾ ॥",
      "transliteration": "teesar koiee na jaanat logaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਕੋਈ ਤੀਜਾ ਬੰਦਾ ਇਸ ਨੂੰ ਨਹੀਂ ਜਾਣਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "तीसर कोई न जानत लोगा ॥",
      "sourceLineId": "136521",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਉਲਟਿ ਪਰਾ ਸਿਵ ਜੂ ਰਿਸਿ ਭਰਿਯੌ ॥",
      "transliteration": "aulaT paraa siv joo ris bhariyau ||",
      "translation": "",
      "punjabiViakhya": "(ਮੰਤ੍ਰ ਸਿੱਧੀ ਦਾ ਉਹ ਯਤਨ) ਉਲਟਾ ਪਿਆ ਅਤੇ ਸ਼ਿਵ ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "उलटि परा सिव जू रिसि भरियौ ॥",
      "sourceLineId": "136522",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਭਸਮੀ ਭੂਤ ਦੁਹੂੰ ਕਹ ਕਰਿਯੌ ॥੨੯॥",
      "transliteration": "bhasamee bhoot dhuhoo(n) keh kariyau ||29||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦੋਹਾ ਨੂੰ ਭਸਮ ਕਰ ਦਿੱਤਾ ॥੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "भसमी भूत दुहूँ कह करियौ ॥२९॥",
      "sourceLineId": "136523",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਵਹੈ ਭਸਮ ਲੈ ਤਿਨੈ ਦਿਖਾਈ ॥",
      "transliteration": "vahai bhasam lai tinai dhikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਭਸਮ ਉਸ (ਰਾਜੇ) ਨੂੰ ਵਿਖਾ ਦਿੱਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "वहै भसम लै तिनै दिखाई ॥",
      "sourceLineId": "136524",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮ੍ਰਿਗ ਭਛਨ ਤਿਹ ਤਿਨੈ ਜਗਾਈ ॥",
      "transliteration": "mirag bhachhan teh tinai jagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਹਿਰਨ ਨੂੰ ਖਾਣ ਵੇਲੇ ਉਨ੍ਰਹਾ ਨੇ ਬਾਲੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "मृग भछन तिह तिनै जगाई ॥",
      "sourceLineId": "136525",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਭਸਮ ਲਹੇ ਸਭ ਹੀ ਜਿਯ ਜਾਨਾ ॥",
      "transliteration": "bhasam lahe sabh hee jiy jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਭਸਮ ਵੇਖ ਕੇ ਸਭ ਨੇ ਜਾਣ ਲਿਆ (ਕਿ ਉਹ ਸੜ ਗਏ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "भसम लहे सभ ही जिय जाना ॥",
      "sourceLineId": "136526",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਲੈ ਪ੍ਰੀਤਮ ਘਰ ਨਾਰਿ ਸਿਧਾਨਾ ॥੩੦॥",
      "transliteration": "lai preetam ghar naar sidhaanaa ||30||",
      "translation": "",
      "punjabiViakhya": "(ਉਧਰ) ਪ੍ਰੀਤਮ ਇਸਤਰੀ ਨੂੰ ਲੈ ਕੇ ਘਰ ਚਲਾ ਗਿਆ ॥੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "लै प्रीतम घर नारि सिधाना ॥३०॥",
      "sourceLineId": "136527",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਿਆਸਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੬॥੬੬੬੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chhiaasaTh charitr samaapatam sat subham sat ||366||6663||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੬੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੬੬॥੬੬੬੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ छिआसठ चरित्र समापतम सतु सुभम सतु ॥३६६॥६६६३॥अफजूँ॥",
      "sourceLineId": "136528",
      "sourceShabadId": "12664",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136529",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਅੰਧਾਵਤੀ ਨਗਰ ਇਕ ਸੋਹੈ ॥",
      "transliteration": "a(n)dhaavatee nagar ik sohai ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਧਾਵਤੀ ਨਾ ਦਾ ਇਕ ਨਗਰ ਸ਼ੋਭਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "अंधावती नगर इक सोहै ॥",
      "sourceLineId": "136530",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸੈਨ ਬਿਦਾਦ ਭੂਪ ਤਿਹ ਕੋ ਹੈ ॥",
      "transliteration": "sain bidhaadh bhoop teh ko hai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਦਾ ਰਾਜਾ ਬਿਦਾਦ ਸੈਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "सैन बिदाद भूप तिह को है ॥",
      "sourceLineId": "136531",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਮੂਰਖਿ ਮਤਿ ਤਾ ਕੀ ਬਰ ਨਾਰੀ ॥",
      "transliteration": "moorakh mat taa kee bar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਰਾਣੀ ਦਾ ਨਾ ਮੂਰਖ ਮਤੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "मूरखि मति ता की बर नारी ॥",
      "sourceLineId": "136532",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜਿਹਸੀ ਮੂੜ ਨ ਕਹੂੰ ਨਿਹਾਰੀ ॥੧॥",
      "transliteration": "jihasee mooR na kahoo(n) nihaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਮੂਰਖ ਕਿਸੇ ਨੇ ਨਹੀਂ ਵੇਖੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "जिहसी मूड़ न कहूँ निहारी ॥१॥",
      "sourceLineId": "136533",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਪ੍ਰਜਾ ਲੋਗ ਅਤਿ ਹੀ ਅਕੁਲਾਏ ॥",
      "transliteration": "prajaa log at hee akulaae ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਜਾ ਦੇ ਲੋਗ ਬਹੁਤ ਵਿਆਕੁਲ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "प्रजा लोग अति ही अकुलाए ॥",
      "sourceLineId": "136534",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਦੇਸ ਛੋਡਿ ਪਰਦੇਸ ਸਿਧਾਏ ॥",
      "transliteration": "dhes chhodd paradhes sidhaae ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਸ ਛਡ ਕੇ ਪਰਦੇਸ ਚਲੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "देस छोडि परदेस सिधाए ॥",
      "sourceLineId": "136535",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਔਰ ਭੂਪ ਪਹਿ ਕਰੀ ਪੁਕਾਰਾ ॥",
      "transliteration": "aauar bhoop peh karee pukaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰਨਾ ਨੇ ਰਾਜੇ ਅਗੇ ਪੁਕਾਰ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "और भूप पहि करी पुकारा ॥",
      "sourceLineId": "136536",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਨ੍ਯਾਇ ਕਰਤ ਤੈਂ ਨਹੀ ਹਮਾਰਾ ॥੨॥",
      "transliteration": "nayai karat tai(n) nahee hamaaraa ||2||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੂੰ ਸਾਡੇ ਨਾਲ ਨਿਆਂ ਨਹੀਂ ਕਰ ਰਿਹਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "न्याइ करत तैं नही हमारा ॥२॥",
      "sourceLineId": "136537",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਤਾ ਤੇ ਤੁਮ ਕੁਛ ਕਰਹੁ ਉਪਾਇ ॥",
      "transliteration": "taa te tum kuchh karahu upai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਤੁਸੀਂ ਕੁਝ ਉਪਾ ਕਰੋ ਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "ता ते तुम कुछ करहु उपाइ ॥",
      "sourceLineId": "136538",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਜਾ ਤੇ ਦੇਸ ਬਸੈ ਫਿਰਿ ਆਇ ॥",
      "transliteration": "jaa te dhes basai fir aai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਫਿਰ ਦੇਸ ਵਿਚ ਆ ਵਸੀਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "जा ते देस बसै फिरि आइ ॥",
      "sourceLineId": "136539",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਚਾਰਿ ਨਾਰਿ ਤਬ ਕਹਿਯੋ ਪੁਕਾਰਿ ॥",
      "transliteration": "chaar naar tab kahiyo pukaar ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਚਾਰ ਇਸਤਰੀਆਂ ਨੇ ਪੁਕਾਰ ਕੇ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "चारि नारि तब कहियो पुकारि ॥",
      "sourceLineId": "136540",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਹਮ ਐਹੈ ਜੜ ਨ੍ਰਿਪਹਿ ਸੰਘਾਰਿ ॥੩॥",
      "transliteration": "ham aaihai jaR nirapeh sa(n)ghaar ||3||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਅਸੀਂ ਮੂਰਖ ਰਾਜੇ ਨੂੰ ਮਾਰ ਕੇ ਆਵਾਗੀਆਂ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "हम ऐहै जड़ नृपहि संघारि ॥३॥",
      "sourceLineId": "136541",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਦ੍ਵੈ ਤ੍ਰਿਯ ਭੇਸ ਪੁਰਖ ਕੇ ਧਾਰੀ ॥",
      "transliteration": "dhavai tiray bhes purakh ke dhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਦੋ ਇਸਤਰੀਆਂ ਨੇ ਪੁਰਸ਼ਾ ਦਾ ਭੇਸ ਧਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "द्वै तृय भेस पुरख के धारी ॥",
      "sourceLineId": "136542",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਪੈਠਿ ਗਈ ਤਿਹ ਨਗਰ ਮੰਝਾਰੀ ॥",
      "transliteration": "paiTh giee teh nagar ma(n)jhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਗਰ ਵਿਚ ਜਾ ਕੇ ਡਟ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "पैठि गई तिह नगर मंझारी ॥",
      "sourceLineId": "136543",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਦ੍ਵੈ ਤ੍ਰਿਯ ਭੇਸ ਜੋਗ੍ਰਯ ਕੇ ਧਾਰੋ ॥",
      "transliteration": "dhavai tiray bhes jogray ke dhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਦੋ ਇਸਤਰੀਆਂ ਨੇ ਜੋਗੀਆਂ ਦਾ ਰੂਪ ਧਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "द्वै तृय भेस जोग्रय के धारो ॥",
      "sourceLineId": "136544",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਪ੍ਰਾਪਤਿ ਭੀ ਤਿਹ ਨਗਰ ਮਝਾਰੋ ॥੪॥",
      "transliteration": "praapat bhee teh nagar majhaaro ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਗਰ ਵਿਚ ਪਹੁੰਚ ਗਈਆਂ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "प्रापति भी तिह नगर मझारो ॥४॥",
      "sourceLineId": "136545",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1318_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਇਕ ਤ੍ਰਿਯ ਚੋਰੀ ਕਰੀ ਬਨਾਇ ॥",
      "transliteration": "eik tiray choree karee banai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਇਸਤਰੀ ਨੇ ਚੋਰੀ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1318,
      "hindi": "",
      "hindiTransliteration": "इक तृय चोरी करी बनाइ ॥",
      "sourceLineId": "136546",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
