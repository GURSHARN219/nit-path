{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1319,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1319_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਕਰਿ ਲਈ ਦੂਸਰਿ ਤ੍ਰਿਯ ਜਾਇ ॥",
      "transliteration": "pakar liee dhoosar tiray jai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੂਜੀ ਨੇ ਜਾ ਕੇ ਉਸ ਨੂੰ ਪਕੜ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "पकरि लई दूसरि तृय जाइ ॥",
      "sourceLineId": "136547",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦ੍ਵੈ ਤ੍ਰਿਯ ਜੋਗ ਭੇਸ ਕੌ ਧਰਿ ਕੈ ॥",
      "transliteration": "dhavai tiray jog bhes kau dhar kai ||",
      "translation": "",
      "punjabiViakhya": "ਦੋ ਇਸਤਰੀਆਂ ਜੋਗ ਦਾ ਭੇਸ ਧਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "द्वै तृय जोग भेस कौ धरि कै ॥",
      "sourceLineId": "136548",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗਈ ਭੂਪ ਕੋ ਚਰਿਤ ਬਿਚਰਿ ਕੈ ॥੫॥",
      "transliteration": "giee bhoop ko charit bichar kai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਰਿਤ੍ਰ ਕਰਨਾ ਸੋਚ ਕੇ ਰਾਜੇ ਕੋਲ ਗਈਆਂ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "गई भूप को चरित बिचरि कै ॥५॥",
      "sourceLineId": "136549",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭੂਪ ਕਹਾ ਸੂਰੀ ਇਹ ਦੀਜੈ ॥",
      "transliteration": "bhoop kahaa sooree ieh dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਕਿਹਾ ਇਸ ਨੂੰ ਸੂਲੀ ਦੇ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "भूप कहा सूरी इह दीजै ॥",
      "sourceLineId": "136550",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੀਨੋ ਹੁਕਮ ਹਮਾਰੇ ਲੀਜੈ ॥",
      "transliteration": "teeno hukam hamaare leejai ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਨੋਂ ਮੇਰੇ ਹੁਕਮ ਦੀ ਪਾਲਨਾ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "तीनो हुकम हमारे लीजै ॥",
      "sourceLineId": "136551",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਨਨਨਾਤ ਲੈ ਤਾਹੀ ਸਿਧਾਰੇ ॥",
      "transliteration": "hanananaat lai taahee sidhaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਸ ਨੂੰ ਮਾਰਨ ਵਾਸਤੇ ('ਹਨਨਨਾਤ' ਹਨਨ ਅਰਥ) ਲੈ ਕੇ ਚਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "हनननात लै ताही सिधारे ॥",
      "sourceLineId": "136552",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦ੍ਵੈ ਇਸਤ੍ਰੀ ਹ੍ਵੈ ਅਤਿਥ ਪਧਾਰੇ ॥੬॥",
      "transliteration": "dhavai isatree havai atith padhaare ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਜੋਗੀ ਬਣੀਆਂ ਦੋਵੇਾਂ ਇਸਤਰੀਆਂ ਉਥੇ ਆ ਗਈਆਂ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "द्वै इसत्री ह्वै अतिथ पधारे ॥६॥",
      "sourceLineId": "136553",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੋਗਿਨਿ ਨਾਰਿ ਕਹਾ ਅਸ ਕੀਜੈ ॥",
      "transliteration": "jogin naar kahaa as keejai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋਗੀ ਬਣੀਆਂ ਇਸਤਰੀਆਂ ਨੇ ਕਿਹਾ ਕਿ ਇਸ ਤਰ੍ਰਹਾ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "जोगिनि नारि कहा अस कीजै ॥",
      "sourceLineId": "136554",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦ੍ਵੈ ਮਹਿ ਇਕ ਜੋਗੀ ਕਹ ਦੀਜੈ ॥",
      "transliteration": "dhavai meh ik jogee keh dheejai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਾਸੀ ਅਸਾ) ਦੋਹਾ ਜੋਗੀਆਂ ਵਿਚੋਂ ਇਕ ਨੂੰ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "द्वै महि इक जोगी कह दीजै ॥",
      "sourceLineId": "136555",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਐਹੈ ਇਹਾ ਅਰਸ ਕੀ ਬਾਤਾ ॥",
      "transliteration": "aaihai ihaa aras kee baataa ||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਅਰਸ਼ (ਸਵਰਗ) ਦੀਆਂ ਗੱਲਾ ਹੁੰਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "ऐहै इहा अरस की बाता ॥",
      "sourceLineId": "136556",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਾਨਤ ਕੋਈ ਨ ਤਾ ਕੀ ਘਾਤਾ ॥੭॥",
      "transliteration": "jaanat koiee na taa kee ghaataa ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਛਲ ਨੂੰ ਕੋਈ ਵੀ ਸਮਝ ਨਹੀਂ ਰਿਹਾ ਸੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "जानत कोई न ता की घाता ॥७॥",
      "sourceLineId": "136557",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੁਤਿਯ ਨਾਰ ਇਮਿ ਬਚਨ ਉਚਾਰੇ ॥",
      "transliteration": "dhutiy naar im bachan uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜੀ ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "दुतिय नार इमि बचन उचारे ॥",
      "sourceLineId": "136558",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਯਾਹਿ ਨ ਸੂਰੀ ਦੇਹੁ ਕਹਾਰੇ ॥",
      "transliteration": "yaeh na sooree dheh kahaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹੇ ਕਹਾਰ (ਜਲਾਦ)! ਇਸ ਨੂੰ ਸੂਲੀ ਨਾ ਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "याहि न सूरी देहु कहारे ॥",
      "sourceLineId": "136559",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੂਰੀ ਏਕ ਅਤਿਥ ਕੋ ਦੀਜੈ ॥",
      "transliteration": "sooree ek atith ko dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਲੀ ਇਕ ਸਾਧ ਨੂੰ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "सूरी एक अतिथ को दीजै ॥",
      "sourceLineId": "136560",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਸਕਰ ਦੂਰ ਇਹਾ ਤੇ ਕੀਜੈ ॥੮॥",
      "transliteration": "tasakar dhoor ihaa te keejai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੋਰ ਨੂੰ ਇਥੋਂ ਕਢ ਦਿਓ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "तसकर दूर इहा ते कीजै ॥८॥",
      "sourceLineId": "136561",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚਲੀ ਖਬਰਿ ਆਵੈ ਇਹ ਕਹਾ ॥",
      "transliteration": "chalee khabar aavai ieh kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਖ਼ਬਰ ਉਥੇ ਜਾ ਪਹੁੰਚੀ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "चली खबरि आवै इह कहा ॥",
      "sourceLineId": "136562",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬੈਠਿ ਬਿਦਾਦ ਨਰਾਧਿਪ ਜਹਾ ॥",
      "transliteration": "baiTh bidhaadh naraadhip jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਬਿਦਾਦ ਸੈਨ ਰਾਜਾ ਬੈਠਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "बैठि बिदाद नराधिप जहा ॥",
      "sourceLineId": "136563",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅੰਧ ਨਗਰ ਕੇ ਤੀਰ ਲੋਗ ਸਭ ॥",
      "transliteration": "a(n)dh nagar ke teer log sabh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਅੰਧ ਨਗਰ ਦੇ ਨੇੜੇ ਦੇ ਸਾਰੇ ਲੋਕਾ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "अंध नगर के तीर लोग सभ ॥",
      "sourceLineId": "136564",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਛਰ ਕਛੁ ਨ ਪੜੈ ਤਿਨ ਗਰਧਭ ॥੯॥",
      "transliteration": "achhar kachh na paRai tin garadhabh ||9||",
      "translation": "",
      "punjabiViakhya": "ਖੋਤਿਆਂ ਵਾਗ ਕੋਈ ਅੱਖਰ ਨਹੀਂ ਪੜ੍ਰਹਿਆ ਹੋਇਆ ਸੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "अछर कछु न पड़ै तिन गरधभ ॥९॥",
      "sourceLineId": "136565",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਔਰ ਕਛੂ ਜਾਨੈ ਨਹਿ ਬਾਤਾ ॥",
      "transliteration": "aauar kachhoo jaanai neh baataa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਹੋਰ ਕੋਈ ਗੱਲ ਨਹੀਂ ਸਮਝਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "और कछू जानै नहि बाता ॥",
      "sourceLineId": "136566",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਹਾ ਪਸੂ ਮੂਰਖ ਬਿਖ੍ਯਾਤਾ ॥",
      "transliteration": "mahaa pasoo moorakh bikhayaataa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਹਾ ਪਸ਼ੂ ਅਤੇ ਮੂਰਖ ਵਜੋਂ ਪ੍ਰਸਿੱਧ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "महा पसू मूरख बिख्याता ॥",
      "sourceLineId": "136567",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਹ ਧੁਨਿ ਪਰੀ ਕਾਨ ਪ੍ਰਭ ਕੇ ਜਬ ॥",
      "transliteration": "eeh dhun paree kaan prabh ke jab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਦੇ ਕੰਨ ਵਿਚ ਇਹ ਖ਼ਬਰ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "इह धुनि परी कान प्रभ के जब ॥",
      "sourceLineId": "136568",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਿਰਖਨ ਚਲਾ ਅਤਿਥਹਿ ਦ੍ਵੈ ਤਬ ॥੧੦॥",
      "transliteration": "nirakhan chalaa atitheh dhavai tab ||10||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਦੋਹਾ ਸਾਧਾ ਨੂੰ ਵੇਖਣ ਲਈ ਚਲਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "निरखन चला अतिथहि द्वै तब ॥१०॥",
      "sourceLineId": "136569",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦਰਸ ਕਿਯਾ ਤਿਨ ਕੋ ਜਬ ਜਾਈ ॥",
      "transliteration": "dharas kiyaa tin ko jab jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਜਾ ਕੇ ਉਨ੍ਰਹਾ ਦਾ ਦਰਸ਼ਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "दरस किया तिन को जब जाई ॥",
      "sourceLineId": "136570",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਚਨ ਕਿਯਾ ਭੂਪਤਿ ਮੁਸਕਾਈ ॥",
      "transliteration": "bachan kiyaa bhoopat musakaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਜੇ ਨੇ ਹਸ ਕੇ ਬਚਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "बचन किया भूपति मुसकाई ॥",
      "sourceLineId": "136571",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤੁਮ ਸੂਰੀ ਕਾਰਨ ਕਿਹ ਲੇਹੁ ॥",
      "transliteration": "tum sooree kaaran keh leh ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਕਿਸ ਕਾਰਨ ਸੂਲੀ ਲੈਂਦੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "तुम सूरी कारन किह लेहु ॥",
      "sourceLineId": "136572",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੋ ਮੁਹਿ ਭੇਦ ਕ੍ਰਿਪਾ ਕਰਿ ਦੇਹੁ ॥੧੧॥",
      "transliteration": "so muh bhedh kirapaa kar dheh ||11||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਭੇਦ ਮੈਨੂੰ ਕ੍ਰਿਪਾ ਕਰ ਕੇ ਦਸੋ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "सो मुहि भेद कृपा करि देहु ॥११॥",
      "sourceLineId": "136573",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹੋ ਹਮ ਜਨਮ ਜਨਮ ਕਿਯ ਪਾਤਾ ॥",
      "transliteration": "ho ham janam janam kiy paataa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ ਉੱਤਰ ਦਿੱਤਾ) ਅਸੀਂ ਜਨਮ ਜਨਮਾਤਰਾ ਦੇ ਪਾਪ ਕੀਤੇ ਹੋਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "हो हम जनम जनम किय पाता ॥",
      "sourceLineId": "136574",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਯਾ ਪਰ ਚੜਤ ਹੋਹਿ ਸਭ ਘਾਤਾ ॥",
      "transliteration": "yaa par chaRat hoh sabh ghaataa ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਲੀ ਉਤੇ ਚੜ੍ਰਹਨ ਨਾਲ ਸਭ (ਪਾਪ) ਨਸ਼ਟ ਹੋ ਜਾਣਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "या पर चड़त होहि सभ घाता ॥",
      "sourceLineId": "136575",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਯਾ ਪਰ ਬਾਤ ਸ੍ਵਰਗ ਕੀ ਐਹੈ ॥",
      "transliteration": "yaa par baat savairag kee aaihai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤੇ ਸਵਰਗ ਦੀ ਪ੍ਰਾਪਤੀ ਹੋਵੇਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "या पर बात स्वरग की ऐहै ॥",
      "sourceLineId": "136576",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਵਾ ਗਵਨ ਤੁਰਤ ਮਿਟਿ ਜੈਹੈ ॥੧੨॥",
      "transliteration": "aavaa gavan turat miT jaihai ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਵਾਗਵਣ ਤੁਰਤ ਮਿਟ ਜਾਵੇਗਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "आवा गवन तुरत मिटि जैहै ॥१२॥",
      "sourceLineId": "136577",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਬ ਰਾਜੈ ਐਸੋ ਸੁਨਿ ਪਾਈ ॥",
      "transliteration": "jab raajai aaiso sun paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "जब राजै ऐसो सुनि पाई ॥",
      "sourceLineId": "136578",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚਿਤ ਚੜਬੇ ਕੀ ਬਿਵਤ ਬਨਾਈ ॥",
      "transliteration": "chit chaRabe kee bivat banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਚਿਤ ਵਿਚ (ਖ਼ੁਦ ਸੂਲੀ) ਚੜ੍ਰਹਨ ਦੀ ਵਿਉਾਂਤ ਬਣਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "चित चड़बे की बिवत बनाई ॥",
      "sourceLineId": "136579",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਵਰ ਲੋਗ ਸਭ ਦਏ ਹਟਾਇ ॥",
      "transliteration": "avar log sabh dhe haTai ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਸਾਰੇ ਲੋਗ ਹਟਾ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "अवर लोग सभ दए हटाइ ॥",
      "sourceLineId": "136580",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਪੁ ਚੜਾ ਸੂਰੀ ਪਰ ਜਾਇ ॥੧੩॥",
      "transliteration": "aap chaRaa sooree par jai ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਸੂਲੀ ਉਤੇ ਜਾ ਚੜ੍ਰਹਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "आपु चड़ा सूरी पर जाइ ॥१३॥",
      "sourceLineId": "136581",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭੂਪ ਚੜਤ ਜੋਗੀ ਭਜਿ ਗਏ ॥",
      "transliteration": "bhoop chaRat jogee bhaj ge ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੇ ਸੂਲੀ ਚੜ੍ਰਹਦਿਆਂ ਹੀ ਜੋਗੀ ਭਜ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "भूप चड़त जोगी भजि गए ॥",
      "sourceLineId": "136582",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਹੂੰ ਦੁਰੇ ਜਨਿਯਤ ਨਹਿ ਭਏ ॥",
      "transliteration": "kahoo(n) dhure janiyat neh bhe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਥੇ ਜਾ ਲੁਕੇ, ਕਿਸੇ ਨੂੰ ਪਤਾ ਨਾ ਲਗ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "कहूँ दुरे जनियत नहि भए ॥",
      "sourceLineId": "136583",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਧਰਿ ਇਸਤ੍ਰਿਨ ਕੇ ਰੂਪ ਅਪਾਰਾ ॥",
      "transliteration": "dhar isatiran ke roop apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਇਸਤਰੀਆਂ ਦਾ ਪੂਰਾ ਰੂਪ ਧਾਰਨ ਕਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "धरि इसतृन के रूप अपारा ॥",
      "sourceLineId": "136584",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਿਲਗੇ ਤਾ ਹੀ ਨਗਰ ਮੰਝਾਰਾ ॥੧੪॥",
      "transliteration": "milage taa hee nagar ma(n)jhaaraa ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਥੇ ਹੀ ਨਗਰ ਵਿਚ ਮਿਲ ਗਏ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "मिलगे ता ही नगर मंझारा ॥१४॥",
      "sourceLineId": "136585",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਇਹ ਛਲ ਅਨ੍ਰਯਾਈ ਨ੍ਰਿਪ ਮਾਰਿ ॥",
      "transliteration": "eeh chhal anrayaiee nirap maar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਅਨਿਆਈ ਰਾਜੇ ਨੂੰ ਮਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "इह छल अन्रयाई नृप मारि ॥",
      "sourceLineId": "136586",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੇਸ ਬਸਾਯੋ ਬਹੁਰਿ ਸੁਧਾਰਿ ॥",
      "transliteration": "dhes basaayo bahur sudhaar ||",
      "translation": "",
      "punjabiViakhya": "ਦੇਸ ਨੂੰ ਫਿਰ ਤੋਂ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ ਵਸਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "देस बसायो बहुरि सुधारि ॥",
      "sourceLineId": "136587",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅੰਧ ਨਗਰ ਕਛੁ ਬਾਤ ਨ ਪਾਈ ॥",
      "transliteration": "a(n)dh nagar kachh baat na paiee ||",
      "translation": "",
      "punjabiViakhya": "ਅੰਧ ਨਗਰ ਦੇ ਲੋਕਾ ਨੇ ਕੁਝ ਭੇਦ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "अंध नगर कछु बात न पाई ॥",
      "sourceLineId": "136588",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਹ ਛਲ ਹਨਾ ਹਮਾਰਾ ਰਾਈ ॥੧੫॥",
      "transliteration": "eeh chhal hanaa hamaaraa raiee ||15||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਸਾਡਾ ਰਾਜਾ ਮਾਰ ਦਿੱਤਾ ਗਿਆ ਹੈ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "इह छल हना हमारा राई ॥१५॥",
      "sourceLineId": "136589",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਸਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੭॥੬੬੭੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau satasaTh charitr samaapatam sat subham sat ||367||6678||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੬੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੬੭॥੬੬੭੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ सतसठ चरित्र समापतम सतु सुभम सतु ॥३६७॥६६७८॥अफजूँ॥",
      "sourceLineId": "136590",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136591",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੜ ਕਨੌਜ ਕੌ ਜਹਾ ਕਹਿਜੈ ॥",
      "transliteration": "gaR kanauaj kau jahaa kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਨੌਜ ਦਾ ਕਿਲਾ ਦਸਿਆ ਜਾਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "गड़ कनौज कौ जहा कहिजै ॥",
      "sourceLineId": "136592",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਭੈ ਸਿੰਘ ਤਹ ਭੂਪ ਭਨਿਜੈ ॥",
      "transliteration": "abhai si(n)gh teh bhoop bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਅਭੈ ਸਿੰਘ ਨਾ ਦਾ ਰਾਜਾ ਰਾਜ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "अभै सिंघ तह भूप भनिजै ॥",
      "sourceLineId": "136593",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1319_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸ੍ਰੀ ਚਖੁ ਚਾਰ ਮਤੀ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "sree chakh chaar matee teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਚਖੁਚਾਰ ਮਤੀ ਉਸ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1319,
      "hindi": "",
      "hindiTransliteration": "स्री चखु चार मती तिह नारी ॥",
      "sourceLineId": "136594",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
