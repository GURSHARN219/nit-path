{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1320,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1320_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਹ ਸਮ ਤੁਲ ਨ ਬ੍ਰਹਮ ਸਵਾਰੀ ॥੧॥",
      "transliteration": "jeh sam tul na braham savaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਬ੍ਰਹਮਾ ਨੇ ਹੋਰ ਕੋਈ ਨਹੀਂ ਬਣਾਈ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "जिह सम तुल न ब्रहम सवारी ॥१॥",
      "sourceLineId": "136595",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਾ ਕੋ ਨੇਹ ਏਕ ਸੌ ਲਾਗੋ ॥",
      "transliteration": "taa ko neh ek sau laago ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਪ੍ਰੇਮ ਇਕ ਵਿਅਕਤੀ ਨਾਲ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "ता को नेह एक सौ लागो ॥",
      "sourceLineId": "136596",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਾ ਤੇ ਲਾਜ ਛਾਡ ਤਨ ਭਾਗੋ ॥",
      "transliteration": "jaa te laaj chhaadd tan bhaago ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਸ਼ਰੀਰ ਨੂੰ ਲਾਜ ਛਡ ਕੇ ਭਜ ਗਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "जा ते लाज छाड तन भागो ॥",
      "sourceLineId": "136597",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਘਟ ਸਿੰਘ ਤਿਹ ਨਾਮ ਭਨਿਜੈ ॥",
      "transliteration": "aghaT si(n)gh teh naam bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਅਘਟ ਸਿੰਘ ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "अघट सिंघ तिह नाम भनिजै ॥",
      "sourceLineId": "136598",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕੋ ਦੂਜਾ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥੨॥",
      "transliteration": "ko dhoojaa paTatar teh dhijai ||2||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਹੋਰ ਦੂਜਾ ਅਜਿਹਾ ਨਹੀਂ ਸੀ, ਜਿਸ ਨਾਲ (ਉਸ ਦੀ) ਉਪਮਾ ਦਿੱਤੀ ਜਾ ਸਕੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "को दूजा पटतर तिह दिजै ॥२॥",
      "sourceLineId": "136599",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਿਤਿਪ੍ਰਤਿ ਤਿਹ ਤ੍ਰਿਯ ਬੋਲਿ ਪਠਾਵਤ ॥",
      "transliteration": "nitiprat teh tiray bol paThaavat ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਸਤਰੀ ਉਸ ਨੂੰ ਰੋਜ਼ ਬੁਲਾ ਲੈਂਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "नितिप्रति तिह तृय बोलि पठावत ॥",
      "sourceLineId": "136600",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਿਹ ਸਾਥ ਕਮਾਵਤ ॥",
      "transliteration": "kaam bhog teh saath kamaavat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਰਤੀ-ਕੇਲਿ ਕਰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "काम भोग तिह साथ कमावत ॥",
      "sourceLineId": "136601",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਬ ਲੌ ਤਹਾ ਨਰਾਧਿਪ ਆਯੋ ॥",
      "transliteration": "tab lau tahaa naraadhip aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਉਥੇ ਰਾਜਾ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "तब लौ तहा नराधिप आयो ॥",
      "sourceLineId": "136602",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤ੍ਰਿਯ ਚਰਿਤ੍ਰ ਇਹ ਭਾਤਿ ਬਨਾਯੋ ॥੩॥",
      "transliteration": "tiray charitr ieh bhaat banaayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਚਰਿਤ੍ਰ ਖੇਡਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "तृय चरित्र इह भाति बनायो ॥३॥",
      "sourceLineId": "136603",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤੁਮਰੇ ਕੇਸ ਭੂਪ ਬਿਕਰਾਰਾ ॥",
      "transliteration": "tumare kes bhoop bikaraaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਤੁਹਾਡੇ ਵਾਲ ਬਹੁਤ ਡਰਾਉਣੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "तुमरे केस भूप बिकरारा ॥",
      "sourceLineId": "136604",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਹੇ ਨ ਮੋ ਤੇ ਜਾਤ ਸੁਧਾਰਾ ॥",
      "transliteration": "sahe na mo te jaat sudhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਤੋਂ ਸਹੇ ਨਹੀਂ ਜਾਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "सहे न मो ते जात सुधारा ॥",
      "sourceLineId": "136605",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪ੍ਰਥਮਹਿ ਰੋਮ ਮੂੰਡਿ ਤੁਮ ਆਵਹੁ ॥",
      "transliteration": "prathameh rom moo(n)dd tum aavahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਤੁਸੀਂ ਵਾਲ ਸਾਫ਼ ਕਰ ਕੇ ਆਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "प्रथमहि रोम मूँडि तुम आवहु ॥",
      "sourceLineId": "136606",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਹੁਰਿ ਹਮਾਰੀ ਸੇਜ ਸੁਹਾਵਹੁ ॥੪॥",
      "transliteration": "bahur hamaaree sej suhaavahu ||4||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਆ ਕੇ ਮੇਰੀ ਸੇਜ ਉਤੇ ਸੁਸ਼ੋਭਿਤ ਹੋਵੋ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "बहुरि हमारी सेज सुहावहु ॥४॥",
      "sourceLineId": "136607",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਬ ਨ੍ਰਿਪ ਗਯੋ ਰੋਮ ਮੂੰਡਿਨ ਹਿਤ ॥",
      "transliteration": "jab nirap gayo rom moo(n)ddin hit ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਵਾਲ ਮੁੰਨਣ ਲਈ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "जब नृप गयो रोम मूँडिन हित ॥",
      "sourceLineId": "136608",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਾਨੀ ਅਧਿਕ ਪ੍ਰਸੰਨ੍ਯ ਭਈ ਚਿਤ ॥",
      "transliteration": "raanee adhik prasa(n)nay bhiee chit ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਣੀ ਮਨ ਵਿਚ ਬਹੁਤ ਪ੍ਰਸੰਨ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "रानी अधिक प्रसंन्य भई चित ॥",
      "sourceLineId": "136609",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਛਿਦ੍ਰ ਤਾਕਿ ਨਿਜੁ ਮੀਤ ਲੁਕਾਯੋ ॥",
      "transliteration": "chhidhr taak nij meet lukaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਕੋਈ) ਮਘੋਰਾ ਵੇਖ ਕੇ ਆਪਣੇ ਮਿਤਰ ਨੂੰ ਲੁਕਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "छिद्र ताकि निजु मीत लुकायो ॥",
      "sourceLineId": "136610",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੂਰਖ ਭੂਪ ਭੇਦ ਨਹਿ ਪਾਯੋ ॥੫॥",
      "transliteration": "moorakh bhoop bhedh neh paayo ||5||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜਾ ਭੇਦ ਨਾ ਪਾ ਸਕਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "मूरख भूप भेद नहि पायो ॥५॥",
      "sourceLineId": "136611",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਸਠ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੮॥੬੬੮੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau aThasaTh charitr samaapatam sat subham sat ||368||6683||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੬੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੬੮॥੬੬੮੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ अठसठ चरित्र समापतम सतु सुभम सतु ॥३६८॥६६८३॥अफजूँ॥",
      "sourceLineId": "136612",
      "sourceShabadId": "12665",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136613",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਔਰ ਕਹਾਨੀ ॥",
      "transliteration": "sun raajaa ik aauar kahaanee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਹੋਰ (ਚਰਿਤ੍ਰ) ਕਥਾ ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा इक और कहानी ॥",
      "sourceLineId": "136614",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਕਿਯਾ ਰਾਵ ਸੰਗ ਰਾਨੀ ॥",
      "transliteration": "jeh bidh kiyaa raav sa(n)g raanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਰਾਜੇ ਨਾਲ ਰਾਣੀ ਨੇ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि किया राव संग रानी ॥",
      "sourceLineId": "136615",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗਨਪਤਿ ਸਿੰਘ ਏਕ ਰਾਜਾ ਬਰ ॥",
      "transliteration": "ganapat si(n)gh ek raajaa bar ||",
      "translation": "",
      "punjabiViakhya": "ਗਨਪਤਿ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਚੰਗਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "गनपति सिंघ एक राजा बर ॥",
      "sourceLineId": "136616",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਤ੍ਰੁ ਕੰਪਤ ਤਾ ਕੇ ਡਰ ਘਰ ਘਰ ॥੧॥",
      "transliteration": "satr ka(n)pat taa ke ddar ghar ghar ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਡਰ ਕਰ ਕੇ ਘਰ ਘਰ ਵੈਰੀ ਕੰਬਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "सत्रु कंपत ता के डर घर घर ॥१॥",
      "sourceLineId": "136617",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੰਚਲ ਦੇ ਰਾਜਾ ਕੀ ਨਾਰੀ ॥",
      "transliteration": "cha(n)chal dhe raajaa kee naaree ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਚਲ ਦੇ (ਦੇਈ) ਰਾਜੇ ਦੀ ਰਾਣੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "चंचल दे राजा की नारी ॥",
      "sourceLineId": "136618",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਿਸੁ ਸਮ ਦੁਤਿਯ ਨ ਕਹੂੰ ਹਮਾਰੀ ॥",
      "transliteration": "jis sam dhutiy na kahoo(n) hamaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਸਾਡੇ ਕੋਈ ਹੋਰ ਇਸਤਰੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "जिसु सम दुतिय न कहूँ हमारी ॥",
      "sourceLineId": "136619",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਵਰ ਰਾਨਿਯਨ ਕੇ ਘਰ ਆਵੈ ॥",
      "transliteration": "avar raaniyan ke ghar aavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ (ਰਾਜਾ) ਹੋਰਨਾ ਰਾਣੀਆਂ ਦੇ ਘਰ ਆਉਾਂਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "अवर रानियन के घर आवै ॥",
      "sourceLineId": "136620",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾ ਕੌ ਕਬ ਹੀ ਮੁਖ ਨ ਦਿਖਾਵੈ ॥੨॥",
      "transliteration": "taa kau kab hee mukh na dhikhaavai ||2||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਨੂੰ ਕਦੇ ਮੂੰਹ ਨਹੀਂ ਵਿਖਾਉਾਂਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "ता कौ कब ही मुख न दिखावै ॥२॥",
      "sourceLineId": "136621",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਾਨੀ ਇਨ ਬਾਤਨ ਤੇ ਜਰੀ ॥",
      "transliteration": "raanee in baatan te jaree ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਇਸ ਗੱਲ ਕਰ ਕੇ ਸੜੀ ਹੋਈ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "रानी इन बातन ते जरी ॥",
      "sourceLineId": "136622",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪਤਿ ਬਧ ਕੀ ਇਛਾ ਜਿਯ ਧਰੀ ॥",
      "transliteration": "pat badh kee ichhaa jiy dharee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਤੀ ਨੂੰ ਮਾਰਨ ਦੀ ਇੱਛਾ ਮਨ ਵਿਚ ਧਾਰਨ ਕਰ ਰਖੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "पति बध की इछा जिय धरी ॥",
      "sourceLineId": "136623",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਔਰ ਨਾਰਿ ਕੋ ਧਰਿ ਕਰਿ ਭੇਸਾ ॥",
      "transliteration": "aauar naar ko dhar kar bhesaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਹੋਰ ਇਸਤਰੀ ਦਾ ਭੇਸ ਧਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "और नारि को धरि करि भेसा ॥",
      "sourceLineId": "136624",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਿਜੁ ਪਤਿ ਕੇ ਗ੍ਰਿਹ ਕਿਯਾ ਪ੍ਰਵੇਸਾ ॥੩॥",
      "transliteration": "nij pat ke gireh kiyaa pravesaa ||3||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਰਾਜੇ ਦੇ ਘਰ ਵਿਚ ਪ੍ਰਵੇਸ਼ ਕੀਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "निजु पति के गृह किया प्रवेसा ॥३॥",
      "sourceLineId": "136625",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਪਨੀ ਨਾਰਿ ਨ ਨ੍ਰਿਪਤਿਹ ਜਾਨਾ ॥",
      "transliteration": "apanee naar na nirapateh jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ ਆਪਣੀ ਇਸਤਰੀ ਵਜੋਂ ਨਾ ਪਛਾਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "अपनी नारि न नृपतिह जाना ॥",
      "sourceLineId": "136626",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਧਿਕ ਰੂਪ ਲਖਿ ਤਾਹਿ ਲੁਭਾਨਾ ॥",
      "transliteration": "adhik roop lakh taeh lubhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦਾ ਸੁੰਦਰ ਰੂਪ ਵੇਖ ਕੇ ਲਲਚਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "अधिक रूप लखि ताहि लुभाना ॥",
      "sourceLineId": "136627",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਈ ਰੈਨਿ ਤਬ ਲਈ ਬੁਲਾਇ ॥",
      "transliteration": "bhiee rain tab liee bulai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਤ ਪਈ, ਤਾ ਉਸ ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "भई रैनि तब लई बुलाइ ॥",
      "sourceLineId": "136628",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭੋਗ ਕੀਯਾ ਤਾ ਸੌ ਲਪਟਾਇ ॥੪॥",
      "transliteration": "bhog keeyaa taa sau lapaTai ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਲਿਪਟ ਕੇ ਸੰਯੋਗ ਮਾਣਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "भोग कीया ता सौ लपटाइ ॥४॥",
      "sourceLineId": "136629",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਯੌ ਬਤਿਯਾ ਤਿਹ ਸਾਥ ਉਚਾਰੀ ॥",
      "transliteration": "yau batiyaa teh saath uchaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਰਾਜੇ ਨਾਲ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "यौ बतिया तिह साथ उचारी ॥",
      "sourceLineId": "136630",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹੈ ਛਿਨਾਰ ਨ੍ਰਿਪ ਨਾਰ ਤਿਹਾਰੀ ॥",
      "transliteration": "hai chhinaar nirap naar tihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੇਰੀ ਇਸਤਰੀ ਬਹੁਤ ਵਿਭਚਾਰਨ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "है छिनार नृप नार तिहारी ॥",
      "sourceLineId": "136631",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਏਕ ਪੁਰਖ ਕੋ ਧਾਮ ਬੁਲਾਵਤ ॥",
      "transliteration": "ek purakh ko dhaam bulaavat ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਪੁਰਸ਼ ਨੂੰ ਘਰ ਬੁਲਾਉਾਂਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "एक पुरख को धाम बुलावत ॥",
      "sourceLineId": "136632",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੁਹਿ ਨਿਰਖਤ ਤਾ ਸੌ ਲਪਟਾਵਤ ॥੫॥",
      "transliteration": "muh nirakhat taa sau lapaTaavat ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਵਖਦਿਆਂ ਵੇਖਦਿਆਂ ਉਸ ਨਾਲ ਲਿਪਟ ਜਾਦੀ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "मुहि निरखत ता सौ लपटावत ॥५॥",
      "sourceLineId": "136633",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਯੌ ਨ੍ਰਿਪ ਸੋ ਤਿਨ ਕਹੀ ਬਨਾਇ ॥",
      "transliteration": "yau nirap so tin kahee banai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਸ ਤਰ੍ਰਹਾ (ਗੱਲ) ਬਣਾ ਕੇ ਰਾਜੇ ਨੂੰ ਕਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "यौ नृप सो तिन कही बनाइ ॥",
      "sourceLineId": "136634",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਤਿ ਨਿਜੁ ਪਤਿ ਕਹ ਰਿਸਿ ਉਪਜਾਇ ॥",
      "transliteration": "at nij pat keh ris upajai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਪਤੀ (ਦੇ ਮਨ) ਵਿਚ ਬਹੁਤ ਰੋਹ ਭਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "अति निजु पति कह रिसि उपजाइ ॥",
      "sourceLineId": "136635",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਲਖਿਨ ਚਲਾ ਭੂਪਤ ਤਿਹ ਧਾਈ ॥",
      "transliteration": "lakhin chalaa bhoopat teh dhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਉਸ ਨੂੰ ਵੇਖਣ ਲਈ ਭਜ ਕੇ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "लखिन चला भूपत तिह धाई ॥",
      "sourceLineId": "136636",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਧਾਮ ਆਪਨਾਗਮ ਤ੍ਰਿਯ ਆਈ ॥੬॥",
      "transliteration": "dhaam aapanaagam tiray aaiee ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਧਰ) ਇਸਤਰੀ ਵੀ ਆਪਣੇ ਘਰ ਪਹਿਲਾ ਹੀ ਪਹੁੰਚ ਗਈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "धाम आपनागम तृय आई ॥६॥",
      "sourceLineId": "136637",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਿਜੁ ਤਨੁ ਭੇਸ ਪੁਰਖ ਕੋ ਧਾਰੀ ॥",
      "transliteration": "nij tan bhes purakh ko dhaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਘਰ ਆ ਕੇ) ਉਸ ਨੇ ਪੁਰਸ਼ ਦੇ ਬਸਤ੍ਰ ਪਾ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "निजु तनु भेस पुरख को धारी ॥",
      "sourceLineId": "136638",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਈ ਸਵਤਿ ਕੇ ਧਾਮ ਸੁਧਾਰੀ ॥",
      "transliteration": "giee savat ke dhaam sudhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੌਂਕਣ ਦੇ ਘਰ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "गई सवति के धाम सुधारी ॥",
      "sourceLineId": "136639",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਗੇ ਪ੍ਰੀਤਿ ਹੁਤੀ ਸੰਗ ਜਾ ਕੇ ॥",
      "transliteration": "aage preet hutee sa(n)g jaa ke ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਦੀ) ਜਿਸ ਨਾਲ ਅਗਲੇਰੀ ਪ੍ਰੀਤ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "आगे प्रीति हुती संग जा के ॥",
      "sourceLineId": "136640",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬੈਠੀ ਜਾਇ ਸੇਜ ਚੜਿ ਤਾ ਕੇ ॥੭॥",
      "transliteration": "baiThee jai sej chaR taa ke ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੇਜ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਬੈਠ ਗਈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "बैठी जाइ सेज चड़ि ता के ॥७॥",
      "sourceLineId": "136641",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1320_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਬਿ ਲਗਿ ਤਹਾ ਨਰਾਧਿਪ ਆਯੋ ॥",
      "transliteration": "tab lag tahaa naraadhip aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਉਥੇ ਰਾਜਾ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1320,
      "hindi": "",
      "hindiTransliteration": "तबि लगि तहा नराधिप आयो ॥",
      "sourceLineId": "136642",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
