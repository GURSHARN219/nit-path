{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1321,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1321_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪੁਰਖ ਭੇਸ ਲਖਿ ਨਾਰਿ ਰਿਸਾਯੋ ॥",
      "transliteration": "purakh bhes lakh naar risaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਾਰੀ ਨੂੰ ਪੁਰਸ਼ ਭੇਸ ਵਿਚ ਵੇਖ ਕੇ ਬਹੁਤ ਗੁੱਸੇ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "पुरख भेस लखि नारि रिसायो ॥",
      "sourceLineId": "136643",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜੋ ਬਾਤੈਂ ਮੁਹਿ ਯਾਰ ਉਚਾਰੀ ॥",
      "transliteration": "jo baatai(n) muh yaar uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਗੱਲਾ ਮੈਨੂੰ ਪ੍ਰੇਮਿਕਾ ਨੇ ਦਸੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "जो बातैं मुहि यार उचारी ॥",
      "sourceLineId": "136644",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੋ ਅਖਿਯਨ ਹਮ ਆਜੁ ਨਿਹਾਰੀ ॥੮॥",
      "transliteration": "so akhiyan ham aaj nihaaree ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਅੱਖਾ ਨਾਲ ਮੈਂ ਅਜ ਵੇਖ ਲਈਆਂ ਹਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "सो अखियन हम आजु निहारी ॥८॥",
      "sourceLineId": "136645",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਹਨਨਿ ਤਿਹ ਧਯੋ ॥",
      "transliteration": "kaadd kirapaan hanan teh dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰਿਪਾਨ ਕਢ ਕੇ ਉਸ ਨੂੰ ਮਾਰਨ ਲਈ ਅਗੇ ਵਧਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "काढि कृपान हननि तिह धयो ॥",
      "sourceLineId": "136646",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਾਨੀ ਹਾਥ ਨਾਥ ਗਹਿ ਲਯੋ ॥",
      "transliteration": "raanee haath naath geh layo ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਰਾਣੀ ਨੇ ਪਤੀ ਦਾ ਹੱਥ ਪਕੜ ਲਿਆ (ਅਤੇ ਕਿਹਾ)",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "रानी हाथ नाथ गहि लयो ॥",
      "sourceLineId": "136647",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਵ ਤ੍ਰਿਯ ਭੇਸ ਤਹਾ ਨਰ ਧਾਰਾ ॥",
      "transliteration": "tav tiray bhes tahaa nar dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤੇਰੀ ਹੀ ਇਸਤਰੀ ਨੇ ਉਸ ਆਦਮੀ ਦਾ ਭੇਸ ਧਾਰਨ ਕੀਤਾ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "तव तृय भेस तहा नर धारा ॥",
      "sourceLineId": "136648",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੈ ਜੜ ਯਾ ਕਹ ਜਾਰ ਬਿਚਾਰਾ ॥੯॥",
      "transliteration": "tai jaR yaa keh jaar bichaaraa ||9||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮੂਰਖ! ਤੂੰ ਇਸ ਨੂੰ ਯਾਰ ਸਮਝਿਆ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "तै जड़ या कह जार बिचारा ॥९॥",
      "sourceLineId": "136649",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਬ ਤਿਹ ਨ੍ਰਿਪ ਨਿਜੁ ਨਾਰਿ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "jab teh nirap nij naar bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ ਆਪਣੀ ਇਸਤਰੀ ਸਮਝ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "जब तिह नृप निजु नारि बिचारियो ॥",
      "sourceLineId": "136650",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਉਤਰਾ ਕੋਪ ਹਿਯੈ ਥੋ ਧਾਰਿਯੋ ॥",
      "transliteration": "autaraa kop hiyai tho dhaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਦਾ ਮਨ ਵਿਚ ਧਾਰਿਆ ਹੋਇਆ ਕ੍ਰੋਧ ਉਤਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "उतरा कोप हियै थो धारियो ॥",
      "sourceLineId": "136651",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਿਨ ਇਸਤ੍ਰੀ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "transliteration": "tin isatree ieh bhaat uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "तिन इसत्री इह भाति उचारी ॥",
      "sourceLineId": "136652",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੁਨੁ ਮੂਰਖ ਨ੍ਰਿਪ ਬਾਤ ਹਮਾਰੀ ॥੧੦॥",
      "transliteration": "sun moorakh nirap baat hamaaree ||10||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮੂਰਖ ਰਾਜੇ! ਮੇਰੀ ਗੱਲ ਸੁਣੋ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "सुनु मूरख नृप बात हमारी ॥१०॥",
      "sourceLineId": "136653",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਸਤ ਏਕ ਦਿਜਬਰ ਇਹ ਗਾਵੈ ॥",
      "transliteration": "basat ek dhijabar ieh gaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਪਿੰਡ ਵਿਚ ਇਕ ਬ੍ਰਾਹਮਣ ਰਹਿੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "बसत एक दिजबर इह गावै ॥",
      "sourceLineId": "136654",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੰਦ੍ਰ ਚੂੜ ਓਝਾ ਤਿਹ ਨਾਵੈ ॥",
      "transliteration": "cha(n)dhr chooR ojhaa teh naavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਚੰਦ੍ਰ ਚੂੜ ਓਝਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "चंद्र चूड़ ओझा तिह नावै ॥",
      "sourceLineId": "136655",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬ੍ਰਹਮ ਡੰਡ ਤਿਹ ਪੂਛਿ ਕਰਾਵਹੁ ॥",
      "transliteration": "braham dda(n)dd teh poochh karaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਉਸ ਨੂੰ ਪੁਛ ਕੇ ਬ੍ਰਹਮ ਦੰਡ ਭਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "ब्रहम डंड तिह पूछि करावहु ॥",
      "sourceLineId": "136656",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਬ ਅਪਨੋ ਮੁਖ ਹਮੈ ਦਿਖਾਵਹੁ ॥੧੧॥",
      "transliteration": "tab apano mukh hamai dhikhaavahu ||11||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਆਪਣਾ ਮੁਖ ਸਾਨੂੰ ਵਿਖਾਓ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "तब अपनो मुख हमै दिखावहु ॥११॥",
      "sourceLineId": "136657",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਬ ਰਾਜਾ ਤਿਹ ਓਰ ਸਿਧਾਯੋ ॥",
      "transliteration": "jab raajaa teh or sidhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਉਸ ਪਾਸੇ ਵਲ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "जब राजा तिह ओर सिधायो ॥",
      "sourceLineId": "136658",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਬ ਦਿਜ ਕੋ ਤ੍ਰਿਯ ਭੇਖ ਬਨਾਯੋ ॥",
      "transliteration": "tab dhij ko tiray bhekh banaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ ਬ੍ਰਾਹਮਣ ਦਾ ਭੇਸ ਬਣਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "तब दिज को तृय भेख बनायो ॥",
      "sourceLineId": "136659",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚੰਦ੍ਰ ਚੂੜ ਧਰਿ ਅਪਨਾ ਨਾਮ ॥",
      "transliteration": "cha(n)dhr chooR dhar apanaa naam ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਆਪਣਾ ਨਾ ਚੰਦ੍ਰ ਚੂੜ ਰਖ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "चंद्र चूड़ धरि अपना नाम ॥",
      "sourceLineId": "136660",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪ੍ਰਾਪਤਿ ਭਈ ਨ੍ਰਿਪਤਿ ਕੇ ਧਾਮ ॥੧੨॥",
      "transliteration": "praapat bhiee nirapat ke dhaam ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੇ ਘਰ ਪਹੁੰਚ ਗਈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "प्रापति भई नृपति के धाम ॥१२॥",
      "sourceLineId": "136661",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਿਹ ਨ੍ਰਿਪ ਨਾਮ ਪੂਛ ਹਰਖਾਨਾ ॥",
      "transliteration": "teh nirap naam poochh harakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਉਸ ਦਾ ਨਾਮ ਸੁਣ ਕੇ ਪ੍ਰਸੰਨ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "तिह नृप नाम पूछ हरखाना ॥",
      "sourceLineId": "136662",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚੰਦ੍ਰ ਚੂੜ ਤਿਹ ਕੌ ਪਹਿਚਾਨਾ ॥",
      "transliteration": "cha(n)dhr chooR teh kau pahichaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਚੰਦ੍ਰ ਚੂੜ ਸਮਝਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "चंद्र चूड़ तिह कौ पहिचाना ॥",
      "sourceLineId": "136663",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਹ ਹਿਤ ਜਾਤ ਕਹੋ ਪਰਦੇਸਾ ॥",
      "transliteration": "jeh hit jaat kaho paradhesaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਲਈ ਮੈਂ ਪਰਦੇਸ ਜਾਣਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "जिह हित जात कहो परदेसा ॥",
      "sourceLineId": "136664",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਲੀ ਭਈ ਆਯੋ ਵਹੁ ਦੇਸਾ ॥੧੩॥",
      "transliteration": "bhalee bhiee aayo vahu dhesaa ||13||",
      "translation": "",
      "punjabiViakhya": "ਚੰਗਾ ਹੋਇਆ ਉਹ ਸਾਡੇ ਦੇਸ ਆ ਗਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "भली भई आयो वहु देसा ॥१३॥",
      "sourceLineId": "136665",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਬ ਪੂਛਾ ਰਾਜੈ ਤਿਹ ਜਾਈ ॥",
      "transliteration": "jab poochhaa raajai teh jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਉਸ ਨੂੰ ਜਾ ਕੇ ਪੁਛਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "जब पूछा राजै तिह जाई ॥",
      "sourceLineId": "136666",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤ੍ਰਿਯ ਦਿਜ ਹ੍ਵੈ ਇਹ ਬਾਤ ਬਤਾਈ ॥",
      "transliteration": "tiray dhij havai ieh baat bataiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬ੍ਰਾਹਮਣ ਬਣੀ ਇਸਤਰੀ ਨੇ ਇਹ ਗੱਲ ਦਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "तृय दिज ह्वै इह बात बताई ॥",
      "sourceLineId": "136667",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੋ ਨ੍ਰਿਦੋਖ ਕਹ ਦੋਖ ਲਗਾਵੈ ॥",
      "transliteration": "jo niradhokh keh dhokh lagaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਨਿਰਦੋਸ਼ ਉਤੇ ਦੋਸ਼ ਮੜ੍ਰਹਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "जो नृदोख कह दोख लगावै ॥",
      "sourceLineId": "136668",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਮਪੁਰ ਅਧਿਕ ਜਾਤਨਾ ਪਾਵੈ ॥੧੪॥",
      "transliteration": "jamapur adhik jaatanaa paavai ||14||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਜਮ-ਪੁਰੀ ਵਿਚ ਬਹੁਤ ਦੁਖ ਪਾਉਾਂਦਾ ਹੈ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "जमपुर अधिक जातना पावै ॥१४॥",
      "sourceLineId": "136669",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਹ ਤਿਹ ਬਾਧਿ ਥੰਭ ਕੈ ਸੰਗ ॥",
      "transliteration": "teh teh baadh tha(n)bh kai sa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਉਥੇ ਥੰਮ ਨਾਲ ਬੰਨ੍ਰਹਿਆਂ ਜਾਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "तह तिह बाधि थंभ कै संग ॥",
      "sourceLineId": "136670",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਪਤ ਤੇਲ ਡਾਰਤ ਤਿਹ ਅੰਗ ॥",
      "transliteration": "tapat tel ddaarat teh a(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਤਪਦਾ ਤੇਲ ਪਾਇਆ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "तपत तेल डारत तिह अंग ॥",
      "sourceLineId": "136671",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਛੁਰਿਯਨ ਸਾਥ ਮਾਸੁ ਕਟਿ ਡਾਰੈ ॥",
      "transliteration": "chhuriyan saath maas kaT ddaarai ||",
      "translation": "",
      "punjabiViakhya": "ਛੁਰੀਆਂ ਨਾਲ ਉਸ ਦਾ ਮਾਸ ਕਟ ਦਿੱਤਾ ਜਾਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "छुरियन साथ मासु कटि डारै ॥",
      "sourceLineId": "136672",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਰਕ ਕੁੰਡ ਕੇ ਬੀਚ ਪਛਾਰੈ ॥੧੫॥",
      "transliteration": "narak ku(n)dd ke beech pachhaarai ||15||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਰਕ ਕੁੰਡ ਵਿਚ ਸੁਟ ਦਿੱਤਾ ਜਾਦਾ ਹੈ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "नरक कुँड के बीच पछारै ॥१५॥",
      "sourceLineId": "136673",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗਾਵਾ ਗੋਬਰ ਲੇਹੁ ਮਗਾਇ ॥",
      "transliteration": "gaavaa gobar leh magai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਹੇ ਰਾਜਨ! ਗਾ ਦਾ ਗੋਬਰ (ਪਾਥੀਆਂ) ਮੰਗਵਾ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "गावा गोबर लेहु मगाइ ॥",
      "sourceLineId": "136674",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਕੀ ਚਿਤਾ ਬਨਾਵਹੁ ਰਾਇ ॥",
      "transliteration": "taa kee chitaa banaavahu rai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਚਿੱਤਾ ਬਣਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "ता की चिता बनावहु राइ ॥",
      "sourceLineId": "136675",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾ ਮੌ ਬੈਠਿ ਜਰੈ ਜੇ ਕੋਊ ॥",
      "transliteration": "taa mau baiTh jarai je kouoo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਿਚ ਬੈਠ ਕੇ ਜੇ ਕੋਈ ਸੜਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "ता मौ बैठि जरै जे कोऊ ॥",
      "sourceLineId": "136676",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਮ ਪੁਰ ਬਿਖੈ ਨ ਟੰਗਿਯੈ ਸੋਊ ॥੧੬॥",
      "transliteration": "jam pur bikhai na Ta(n)giyai souoo ||16||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਜਮ ਪੁਰੀ ਵਿਚ ਟੰਗਿਆ ਨਹੀਂ ਜਾਦਾ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "जम पुर बिखै न टंगियै सोऊ ॥१६॥",
      "sourceLineId": "136677",
      "sourceShabadId": "12666",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "136678",
      "sourceShabadId": "12667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਦਿਜ ਨਾਰਿ ਨ੍ਰਿਪ ਗੋਬਰ ਲਿਯਾ ਮੰਗਾਇ ॥",
      "transliteration": "sunat bachan dhij naar nirap gobar liyaa ma(n)gai ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣ ਬਣੀ ਇਸਤਰੀ ਦੇ ਬਚਨ ਸੁਣ ਕੇ ਰਾਜੇ ਨੇ ਗੋਬਰ (ਦੀਆਂ ਪਾਥੀਆਂ) ਮੰਗਵਾ ਲਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन दिज नारि नृप गोबर लिया मंगाइ ॥",
      "sourceLineId": "136679",
      "sourceShabadId": "12667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬੈਠਿ ਆਪੁ ਤਾ ਮਹਿ ਜਰਾ ਸਕਾ ਨ ਤ੍ਰਿਯ ਛਲ ਪਾਇ ॥੧੭॥",
      "transliteration": "baiTh aap taa meh jaraa sakaa na tiray chhal pai ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਵਿਚ ਆਪ ਬੈਠ ਕੇ ਸੜ ਗਿਆ। ਪਰ ਇਸਤਰੀ ਦੇ ਚਰਿਤ੍ਰ ਨੂੰ ਸਮਝ ਨਾ ਸਕਿਆ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "बैठि आपु ता महि जरा सका न तृय छल पाइ ॥१७॥",
      "sourceLineId": "136680",
      "sourceShabadId": "12667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਉਨਹਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੬੯॥੬੭੦੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau unahatar charitr samaapatam sat subham sat ||369||6700||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੬੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੬੯॥੬੭੦੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ उनहतर चरित्र समापतम सतु सुभम सतु ॥३६९॥६७००॥अफजूँ॥",
      "sourceLineId": "136681",
      "sourceShabadId": "12667",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136682",
      "sourceShabadId": "12668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬ੍ਰਯਾਘ੍ਰ ਕੇਤੁ ਸੁਨਿਯਤ ਇਕ ਰਾਜਾ ॥",
      "transliteration": "brayaaghr ket suniyat ik raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਯਾਘ੍ਰ ਕੇਤੁ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "ब्रयाघ्र केतु सुनियत इक राजा ॥",
      "sourceLineId": "136683",
      "sourceShabadId": "12668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਹ ਸਮ ਦੁਤਿਯ ਨ ਬਿਧਨਾ ਸਾਜਾ ॥",
      "transliteration": "jeh sam dhutiy na bidhanaa saajaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗਾ ਵਿਧਾਤਾ ਨੇ ਦੂਜਾ ਨਹੀਂ ਸਾਜਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "जिह सम दुतिय न बिधना साजा ॥",
      "sourceLineId": "136684",
      "sourceShabadId": "12668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬ੍ਰਯਾਘ੍ਰਵਤੀ ਨਗਰ ਤਿਹ ਸੋਹੈ ॥",
      "transliteration": "brayaaghravatee nagar teh sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬ੍ਰਯਾਘ੍ਰਵਤੀ ਨਾ ਦਾ ਨਗਰ ਵਸਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "ब्रयाघ्रवती नगर तिह सोहै ॥",
      "sourceLineId": "136685",
      "sourceShabadId": "12668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇੰਦ੍ਰਾਵਤੀ ਨਗਰ ਕੋ ਮੋਹੈ ॥੧॥",
      "transliteration": "ei(n)dhraavatee nagar ko mohai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇੰਦਰਪੁਰੀ ਨੂੰ ਵੀ ਮੋਹੰਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "इंद्रावती नगर को मोहै ॥१॥",
      "sourceLineId": "136686",
      "sourceShabadId": "12668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸ੍ਰੀ ਅਬਦਾਲ ਮਤੀ ਤ੍ਰਿਯ ਤਾ ਕੀ ॥",
      "transliteration": "sree abadhaal matee tiray taa kee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪਤਨੀ ਅਬਦਾਲ ਮਤੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "स्री अबदाल मती तृय ता की ॥",
      "sourceLineId": "136687",
      "sourceShabadId": "12668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਰੀ ਨਾਗਨੀ ਤੁਲਿ ਨ ਵਾ ਕੀ ॥",
      "transliteration": "naree naaganee tul na vaa kee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਬਰਾਬਰ ਕੋਈ ਮਨੁੱਖ ਜਾ ਨਾਗ ਇਸਤਰੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "नरी नागनी तुलि न वा की ॥",
      "sourceLineId": "136688",
      "sourceShabadId": "12668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਹ ਇਕ ਹੁਤੋ ਸਾਹੁ ਸੁਤ ਆਛੋ ॥",
      "transliteration": "teh ik huto saahu sut aachho ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸ਼ਾਹ ਦਾ ਸੁੰਦਰ ਪੁੱਤਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "तह इक हुतो साहु सुत आछो ॥",
      "sourceLineId": "136689",
      "sourceShabadId": "12668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1321_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਨੁ ਅਲਿ ਪਨਚ ਕਾਛ ਤਨ ਕਾਛੋ ॥੨॥",
      "transliteration": "jan al panach kaachh tan kaachho ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਭੌਰਿਆਂ ਦੇ ਚਿਲੇ ਵਾਲਾ (ਕਾਮ ਦੇਵ) ਹੀ ਸਜਿਆ ਹੋਇਆ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1321,
      "hindi": "",
      "hindiTransliteration": "जनु अलि पनच काछ तन काछो ॥२॥",
      "sourceLineId": "136690",
      "sourceShabadId": "12668",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
