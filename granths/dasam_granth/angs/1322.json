{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1322,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1322_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "136691",
      "sourceShabadId": "12669",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸ੍ਰੀ ਜਸ ਤਿਲਕ ਸਿੰਘ ਤਿਹ ਨਾਮ ਪਛਾਨਿਯੈ ॥",
      "transliteration": "sree jas tilak si(n)gh teh naam pachhaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਜਸ ਤਿਲਕ ਸਿੰਘ ਪਛਾਣਨਾ ਚਾਹੀਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "स्री जस तिलक सिंघ तिह नाम पछानियै ॥",
      "sourceLineId": "136692",
      "sourceShabadId": "12669",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰੂਪਵਾਨ ਧਨਵਾਨ ਚਤੁਰ ਪਹਿਚਾਨਿਯੈ ॥",
      "transliteration": "roopavaan dhanavaan chatur pahichaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਰੂਪਵਾਨ, ਧਨਵਾਨ ਅਤੇ ਚਤੁਰ ਸਮਝਣਾ ਚਾਹੀਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "रूपवान धनवान चतुर पहिचानियै ॥",
      "sourceLineId": "136693",
      "sourceShabadId": "12669",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੋ ਇਸਤ੍ਰੀ ਤਾ ਕੋ ਛਿਨ ਰੂਪ ਨਿਹਾਰਈ ॥",
      "transliteration": "jo isatree taa ko chhin roop nihaariee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਸਤਰੀ ਉਸ ਨੂੰ ਛਿਣ ਭਰ ਲਈ ਵੀ ਵੇਖ ਲੈਂਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "जो इसत्री ता को छिन रूप निहारई ॥",
      "sourceLineId": "136694",
      "sourceShabadId": "12669",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹੋ ਲੋਕ ਲਾਜ ਕੁਲਿ ਕਾਨਿ ਸਭੈ ਤਜਿ ਡਾਰਈ ॥੩॥",
      "transliteration": "ho lok laaj kul kaan sabhai taj ddaariee ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਲੋਕ ਲਾਜ ਅਤੇ ਕੁਲ ਦੀ ਮਰਯਾਦਾ ਤੁਰਤ ਛਡ ਦਿੰਦੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "हो लोक लाज कुलि कानि सभै तजि डारई ॥३॥",
      "sourceLineId": "136695",
      "sourceShabadId": "12669",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136696",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਏਕ ਸਖੀ ਤਾ ਕੌ ਲਖਿ ਪਾਈ ॥",
      "transliteration": "ek sakhee taa kau lakh paiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸਖੀ ਨੇ ਉਸ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "एक सखी ता कौ लखि पाई ॥",
      "sourceLineId": "136697",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬੈਠਿ ਸਖਿਨ ਮਹਿ ਬਾਤ ਚਲਾਈ ॥",
      "transliteration": "baiTh sakhin meh baat chalaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਹੋਰਨਾ) ਸਖੀਆਂ ਵਿਚ ਬੈਠ ਕੇ ਗੱਲ ਤੋਰੀ",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "बैठि सखिन महि बात चलाई ॥",
      "sourceLineId": "136698",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਸ ਸੁੰਦਰ ਇਕ ਇਹ ਪੁਰ ਮਾਹੀ ॥",
      "transliteration": "jas su(n)dhar ik ieh pur maahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਨਗਰ ਵਿਚ ਇਕ ਅਜਿਹਾ ਸੁੰਦਰ (ਵਿਅਕਤੀ) ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "जस सुँदर इक इह पुर माही ॥",
      "sourceLineId": "136699",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤੈਸੌ ਚੰਦ੍ਰ ਸੂਰ ਭੀ ਨਾਹੀ ॥੪॥",
      "transliteration": "taisau cha(n)dhr soor bhee naahee ||4||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਚੰਦ੍ਰਮਾ ਅਤੇ ਸੂਰਜ ਵੀ ਨਹੀਂ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "तैसौ चंद्र सूर भी नाही ॥४॥",
      "sourceLineId": "136700",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੁਨਿ ਬਤਿਯਾ ਰਾਨੀ ਜਿਯ ਰਾਖੀ ॥",
      "transliteration": "sun batiyaa raanee jiy raakhee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ (ਇਹ) ਗੱਲ ਸੁਣ ਕੇ ਮਨ ਵਿਚ ਰਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "सुनि बतिया रानी जिय राखी ॥",
      "sourceLineId": "136701",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਔਰ ਨਾਰਿ ਸੌ ਪ੍ਰਗਟ ਨ ਭਾਖੀ ॥",
      "transliteration": "aauar naar sau pragaT na bhaakhee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰਾ ਇਸਤਰੀਆਂ ਪ੍ਰਤਿ ਜ਼ਾਹਿਰ ਨਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "और नारि सौ प्रगट न भाखी ॥",
      "sourceLineId": "136702",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੋ ਸਹਚਰਿ ਤਾ ਕੌ ਲਖਿ ਆਈ ॥",
      "transliteration": "jo sahachar taa kau lakh aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੜੀ ਦਾਸੀ ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਆਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "जो सहचरि ता कौ लखि आई ॥",
      "sourceLineId": "136703",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰੈਨਿ ਭਈ ਤਬ ਵਹੈ ਬੁਲਾਈ ॥੫॥",
      "transliteration": "rain bhiee tab vahai bulaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਹੋਈ, ਤਦ ਉਸ ਨੂੰ ਬੁਲਾਇਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "रैनि भई तब वहै बुलाई ॥५॥",
      "sourceLineId": "136704",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਧਿਕ ਦਰਬੁ ਤਾ ਕੌ ਦੈ ਰਾਨੀ ॥",
      "transliteration": "adhik dharab taa kau dhai raanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਉਸ ਨੂੰ ਬਹੁਤ ਧਨ ਦੇ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "अधिक दरबु ता कौ दै रानी ॥",
      "sourceLineId": "136705",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪੂਛੀ ਤਾਹਿ ਦੀਨ ਹ੍ਵੈ ਬਾਨੀ ॥",
      "transliteration": "poochhee taeh dheen havai baanee ||",
      "translation": "",
      "punjabiViakhya": "ਬੜੀ ਅਧੀਨਗੀ ਨਾਲ ਪੁਛਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "पूछी ताहि दीन ह्वै बानी ॥",
      "sourceLineId": "136706",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁ ਕਹੁ ਕਹਾ ਮੁਹਿ ਜੁ ਤੈ ਨਿਹਾਰਾ ॥",
      "transliteration": "s kahu kahaa muh ju tai nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਵਿਅਕਤੀ) ਤੂੰ ਵੇਖਿਆ ਹੈ, ਉਸ ਬਾਰੇ ਮੈਨੂੰ ਦਸ ਕਿ ਉਹ ਕਿਥੇ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "सु कहु कहा मुहि जु तै निहारा ॥",
      "sourceLineId": "136707",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿਯਾ ਚਾਹਤ ਤਿਹ ਦਰਸ ਅਪਾਰਾ ॥੬॥",
      "transliteration": "kiyaa chaahat teh dharas apaaraa ||6||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਉਸ ਦਾ ਦੀਦਾਰ ਕਰਨਾ ਚਾਹੁੰਦੀ ਹਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "किया चाहत तिह दरस अपारा ॥६॥",
      "sourceLineId": "136708",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਬ ਚੇਰੀ ਇਮਿ ਬਚਨ ਉਚਾਰੋ ॥",
      "transliteration": "tab cheree im bachan uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦਾਸੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "तब चेरी इमि बचन उचारो ॥",
      "sourceLineId": "136709",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਨੁ ਰਾਨੀ ਜੂ ਕਹਾ ਹਮਾਰੋ ॥",
      "transliteration": "sun raanee joo kahaa hamaaro ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਣੀ ਜੀ! ਤੁਸੀਂ ਮੇਰੀ ਗੱਲ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "सुनु रानी जू कहा हमारो ॥",
      "sourceLineId": "136710",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸ੍ਰੀ ਜਸ ਤਿਲਕ ਰਾਇ ਤਿਹ ਜਾਨੋ ॥",
      "transliteration": "sree jas tilak rai teh jaano ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਜਸ ਤਿਲਕ ਰਾਇ ਸਮਝ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "स्री जस तिलक राइ तिह जानो ॥",
      "sourceLineId": "136711",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾਹ ਪੂਤ ਤਾ ਕਹ ਪਹਿਚਾਨੋ ॥੭॥",
      "transliteration": "saeh poot taa keh pahichaano ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਵਜੋਂ ਪਛਾਣ ਲਵੋ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "साह पूत ता कह पहिचानो ॥७॥",
      "sourceLineId": "136712",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੁ ਤੁਮ ਕਹੌ ਤਿਹ ਤੁਮੈ ਮਿਲਾਊ ॥",
      "transliteration": "j tum kahau teh tumai milaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੁਸੀਂ ਕਹੋ ਤਾ ਉਹ ਤੁਹਾਨੂੰ ਮਿਲਾ ਦਿਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "जु तुम कहौ तिह तुमै मिलाऊ ॥",
      "sourceLineId": "136713",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਦਨ ਤਾਪ ਸਭ ਤੋਰ ਮਿਟਾਊ ॥",
      "transliteration": "madhan taap sabh tor miTaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਹਾਡੀ ਕਾਮ-ਅਗਨੀ ਨੂੰ ਸ਼ਾਤ ਕਰ ਦਿਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "मदन ताप सभ तोर मिटाऊ ॥",
      "sourceLineId": "136714",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਰਾਨੀ ਪਗ ਪਰੀ ॥",
      "transliteration": "sunat bachan raanee pag paree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਬਚਨ ਸੁਣ ਕੇ ਰਾਣੀ ਪੈਰੀਂ ਪੈ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन रानी पग परी ॥",
      "sourceLineId": "136715",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪੁਨਿ ਤਾ ਸੌ ਬਿਨਤੀ ਇਮਿ ਕਰੀ ॥੮॥",
      "transliteration": "pun taa sau binatee im karee ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਉਸ ਅਗੇ ਇਸ ਤਰ੍ਰਹਾ ਬੇਨਤੀ ਕੀਤੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "पुनि ता सौ बिनती इमि करी ॥८॥",
      "sourceLineId": "136716",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੇ ਤਾ ਕੋ ਤੈਂ ਮੁਝੈ ਮਿਲਾਵੈਂ ॥",
      "transliteration": "je taa ko tai(n) mujhai milaavai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਉਸ ਨੂੰ ਤੂੰ ਮੈਨੂੰ ਮਿਲਾ ਦੇਵੇਾਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "जे ता को तैं मुझै मिलावैं ॥",
      "sourceLineId": "136717",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੋ ਧਨ ਮੁਖ ਮਾਗੈ ਸੋ ਪਾਵੈਂ ॥",
      "transliteration": "jo dhan mukh maagai so paavai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਧਨ ਤੂੰ ਮੂੰਹੋਂ ਮੰਗੇਗੀ, ਉਹੀ ਪ੍ਰਾਪਤ ਕਰੇਾਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "जो धन मुख मागै सो पावैं ॥",
      "sourceLineId": "136718",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਹ ਸਖੀ ਗਈ ਬਾਰ ਨਹਿ ਲਾਗੀ ॥",
      "transliteration": "teh sakhee giee baar neh laagee ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਉਹ ਸਖੀ ਬਿਨਾ ਦੇਰ ਕੀਤੇ ਉਥੇ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "तह सखी गई बार नहि लागी ॥",
      "sourceLineId": "136719",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਨਿ ਦਿਯੋ ਤਾ ਕੌ ਬਡਭਾਗੀ ॥੯॥",
      "transliteration": "aan dhiyo taa kau baddabhaagee ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਵਡਭਾਗੀ ਨੂੰ (ਉਸ ਨਾਲ) ਆਣ ਮਿਲਾਇਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "आनि दियो ता कौ बडभागी ॥९॥",
      "sourceLineId": "136720",
      "sourceShabadId": "12670",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "136721",
      "sourceShabadId": "12671",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰਾਨੀ ਤਾ ਕੌ ਪਾਇ ਤਿਹ ਦਾਰਿਦ ਦਿਯਾ ਮਿਟਾਇ ॥",
      "transliteration": "raanee taa kau pai teh dhaaridh dhiyaa miTai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਉਸ ਨੂੰ ਪ੍ਰਾਪਤ ਕਰ ਕੇ ਉਸ (ਦਾਸੀ) ਦੀ ਗ਼ਰੀਬੀ ਦੂਰ ਕਰ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "रानी ता कौ पाइ तिह दारिद दिया मिटाइ ॥",
      "sourceLineId": "136722",
      "sourceShabadId": "12671",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨ੍ਰਿਪ ਕੀ ਆਖ ਬਚਾਇ ਉਹਿ ਲਿਯੇ ਗਰੇ ਸੌ ਲਾਇ ॥੧੦॥",
      "transliteration": "nirap kee aakh bachai uh liye gare sau lai ||10||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਰਾਜੇ ਦੀ ਅੱਖ ਬਚਾ ਕੇ ਉਸ ਨੂੰ ਗਲੇ ਨਾਲ ਲਗਾ ਲਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "नृप की आख बचाइ उहि लिये गरे सौ लाइ ॥१०॥",
      "sourceLineId": "136723",
      "sourceShabadId": "12671",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136724",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੋਊ ਧਨੀ ਔ ਜੋਬਨਵੰਤ ॥",
      "transliteration": "dhouoo dhanee aau jobanava(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਧਨੀ ਅਤੇ ਜੋਬਨਵਾਨ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "दोऊ धनी औ जोबनवंत ॥",
      "sourceLineId": "136725",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਰਤ ਕਾਮ ਕ੍ਰੀੜਾ ਬਿਗਸੰਤ ॥",
      "transliteration": "karat kaam kreeRaa bigasa(n)t ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ ਪ੍ਰਸੰਨ ਹੁੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "करत काम क्रीड़ा बिगसंत ॥",
      "sourceLineId": "136726",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਕ ਕਾਮੀ ਅਰੁ ਕੈਫ ਚੜਾਈ ॥",
      "transliteration": "eik kaamee ar kaif chaRaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਉਹ ਕਾਮੀ ਸਨ ਅਤੇ (ਦੂਜੇ) ਸ਼ਰਾਬ ਪੀ ਰਖੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "इक कामी अरु कैफ चड़ाई ॥",
      "sourceLineId": "136727",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰੈਨਿ ਸਕਲ ਰਤਿ ਕਰਤ ਬਿਤਾਈ ॥੧੧॥",
      "transliteration": "rain sakal rat karat bitaiee ||11||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਰਾਤ ਕਾਮ-ਕੇਲਿ ਕਰਦਿਆਂ ਬਿਤਾ ਦਿੱਤੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "रैनि सकल रति करत बिताई ॥११॥",
      "sourceLineId": "136728",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਲਪਟਿ ਲਪਟਿ ਆਸਨ ਵੇ ਲੇਹੀ ॥",
      "transliteration": "lapaT lapaT aasan ve lehee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਲਿਪਟ ਲਿਪਟ ਕੇ ਆਸਣ ਲੈਂਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "लपटि लपटि आसन वे लेही ॥",
      "sourceLineId": "136729",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਪੁ ਬੀਚਿ ਸੁਖੁ ਬਹੁ ਬਿਧਿ ਦੇਹੀ ॥",
      "transliteration": "aap beech sukh bahu bidh dhehee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਸ ਵਿਚ ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੇ ਸੁਖ ਦਿੰਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "आपु बीचि सुखु बहु बिधि देही ॥",
      "sourceLineId": "136730",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੁੰਬਨ ਕਰਤ ਨਖਨ ਕੇ ਘਾਤਾ ॥",
      "transliteration": "chu(n)ban karat nakhan ke ghaataa ||",
      "translation": "",
      "punjabiViakhya": "ਚੁੰਬਨ ਲੈਂਦੇ ਅਤੇ ਨਹੁੰਆਂ ਦੇ ਨਿਸ਼ਾਣ ਲਗਾਉਾਂਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "चुँबन करत नखन के घाता ॥",
      "sourceLineId": "136731",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰੈਨਿ ਬਿਤੀ ਆਯੋ ਹ੍ਵੈ ਪ੍ਰਾਤਾ ॥੧੨॥",
      "transliteration": "rain bitee aayo havai praataa ||12||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਰਾਤ ਬੀਤ ਗਈ ਅਤੇ ਦਿਨ ਚੜ੍ਰਹ ਆਇਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "रैनि बिती आयो ह्वै प्राता ॥१२॥",
      "sourceLineId": "136732",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰਾਨੀ ਗਈ ਪ੍ਰਾਤ ਪਤਿ ਪਾਸ ॥",
      "transliteration": "raanee giee praat pat paas ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਸਵੇਰੇ ਪਤੀ ਕੋਲ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "रानी गई प्रात पति पास ॥",
      "sourceLineId": "136733",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਲਗੀ ਰਹੀ ਜਾ ਕੀ ਜਿਯ ਆਸ ॥",
      "transliteration": "lagee rahee jaa kee jiy aas ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਦੇ ਮਨ ਵਿਚ ਉਸ (ਯਾਰ) ਦੀ ਆਸ ਲਗੀ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "लगी रही जा की जिय आस ॥",
      "sourceLineId": "136734",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਥਵਤ ਦਿਨਨ ਹੋਤ ਅੰਧਯਾਰੋ ॥",
      "transliteration": "athavat dhinan hot a(n)dhayaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਮਨ ਵਿਚ ਸੋਚਦੀ ਰਹੀ) ਕਿ ਕਿਸ ਵੇਲੇ ਦਿਨ ਮੁਕੇਗਾ ਅਤੇ ਹਨੇਰਾ ਹੋਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "अथवत दिनन होत अंधयारो ॥",
      "sourceLineId": "136735",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਹੁਰਿ ਭਜੈ ਮੁਹਿ ਆਨਿ ਪ੍ਯਾਰੋ ॥੧੩॥",
      "transliteration": "bahur bhajai muh aan payaaro ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਮੈਨੂੰ ਪਿਆਰਾ ਆ ਕੇ ਸੰਯੋਗ ਸੁਖ ਦੇਵੇਗਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "बहुरि भजै मुहि आनि प्यारो ॥१३॥",
      "sourceLineId": "136736",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੌ ਰਹਿ ਹੌ ਰਾਜਾ ਕੈ ਪਾਸ ॥",
      "transliteration": "jau reh hau raajaa kai paas ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਮੈਂ ਰਾਜੇ ਕੋਲ ਰਹਿੰਦੀ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "जौ रहि हौ राजा कै पास ॥",
      "sourceLineId": "136737",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1322_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੋਹਿ ਰਾਖਿ ਹੈ ਬਿਰਧ ਨਿਰਾਸ ॥",
      "transliteration": "moh raakh hai biradh niraas ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਹ ਬਿਰਧ ਮੈਨੂੰ ਨਿਰਾਸ਼ ਹੀ ਰਖੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1322,
      "hindi": "",
      "hindiTransliteration": "मोहि राखि है बिरध निरास ॥",
      "sourceLineId": "136738",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
