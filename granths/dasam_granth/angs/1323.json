{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1323,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1323_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੰਗ ਕਹਾ ਯਾ ਕੇ ਸ੍ਵੈ ਲੈਹੌ ॥",
      "transliteration": "sa(n)g kahaa yaa ke savai laihau ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਦੇ ਨਾਲ ਸੌਂ ਕੇ ਮੈਂ ਕੀ ਪ੍ਰਾਪਤ ਕਰਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "संग कहा या के स्वै लैहौ ॥",
      "sourceLineId": "136739",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਿਤ੍ਰ ਭੋਗ ਭੋਗਨ ਤੇ ਜੈਹੌ ॥੧੪॥",
      "transliteration": "mitr bhog bhogan te jaihau ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਿਤਰ ਨਾਲ ਭੋਗ ਬਿਲਾਸ ਕਰਨੋਂ ਵੀ ਜਾਵਾਗੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "मित्र भोग भोगन ते जैहौ ॥१४॥",
      "sourceLineId": "136740",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿਹ ਛਲ ਸੇਜ ਸਜਨ ਕੀ ਜਾਊ ॥",
      "transliteration": "keh chhal sej sajan kee jaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਹੜੇ ਛਲ ਨਾਲ ਸੱਜਨ ਦੀ ਸੇਜ ਉਤੇ ਜਾਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "किह छल सेज सजन की जाऊ ॥",
      "sourceLineId": "136741",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਖ ਘਾਤਨ ਕਿਹ ਭਾਤਿ ਛਪਾਊ ॥",
      "transliteration": "nakh ghaatan keh bhaat chhapaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਹੁੰਆਂ ਦੇ ਚਿੰਨ੍ਰਹਾ ਨੂੰ ਕਿਵੇਾਂ ਲੁਕਾਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "नख घातन किह भाति छपाऊ ॥",
      "sourceLineId": "136742",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਿਰਧ ਭੂਪ ਤਨ ਸੋਤ ਨ ਜੈਯੈ ॥",
      "transliteration": "biradh bhoop tan sot na jaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਰਧ ਰਾਜੇ ਨਾਲ ਸੌਣਾ ਨਾ ਪਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "बिरध भूप तन सोत न जैयै ॥",
      "sourceLineId": "136743",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਐਸੋ ਕਵਨ ਚਰਿਤ੍ਰ ਦਿਖੈਯੈ ॥੧੫॥",
      "transliteration": "aaiso kavan charitr dhikhaiyai ||15||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਅਜਿਹਾ ਚਰਿਤ੍ਰ ਖੇਡਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "ऐसो कवन चरित्र दिखैयै ॥१५॥",
      "sourceLineId": "136744",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਾਇ ਕਹੀ ਨ੍ਰਿਪ ਸੰਗ ਅਸ ਗਾਥਾ ॥",
      "transliteration": "jai kahee nirap sa(n)g as gaathaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਕੋਲ ਜਾ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਗਾਥਾ ਕਹੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "जाइ कही नृप संग अस गाथा ॥",
      "sourceLineId": "136745",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਾਤ ਸੁਨਹੁ ਹਮਰੀ ਤੁਮ ਨਾਥਾ ॥",
      "transliteration": "baat sunahu hamaree tum naathaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਨਾਥ! ਤੁਸੀਂ ਮੇਰੀ ਗੱਲ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "बात सुनहु हमरी तुम नाथा ॥",
      "sourceLineId": "136746",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਿਯੈ ਬਿਲਾਰਿ ਮੋਰ ਨਖ ਲਾਏ ॥",
      "transliteration": "hiyai bilaar mor nakh laae ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਬਿਲੇ ਨੇ ਮੇਰੀ ਛਾਤੀ ਉਤੇ ਨਹੁੰ ਮਾਰੇ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "हियै बिलारि मोर नख लाए ॥",
      "sourceLineId": "136747",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਢਿ ਭੂਪ ਕੌ ਪ੍ਰਗਟ ਦਿਖਾਏ ॥੧੬॥",
      "transliteration": "kaadd bhoop kau pragaT dhikhaae ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਾਹਰ ਕਰ ਕੇ ਰਾਜੇ ਨੂੰ ਵਿਖਾ ਦਿੱਤੇ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "काढि भूप कौ प्रगट दिखाए ॥१६॥",
      "sourceLineId": "136748",
      "sourceShabadId": "12672",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "136749",
      "sourceShabadId": "12673",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਮੈ ਆਜੁ ਨ ਤੁਮ ਸੰਗ ਸੋਇ ਹੌ ॥",
      "transliteration": "sun raajaa mai aaj na tum sa(n)g soi hau ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਕਹਿਣ ਲਗੀ) ਹੇ ਰਾਜਨ! ਮੈਂ ਅਜ ਤੁਹਾਡੇ ਨਾਲ ਨਹੀਂ ਸੌਂਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा मै आजु न तुम संग सोइ हौ ॥",
      "sourceLineId": "136750",
      "sourceShabadId": "12673",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਿਜੁ ਪਲਕਾ ਪਰ ਪਰੀ ਸਕਲ ਨਿਸੁ ਖੋਇ ਹੌ ॥",
      "transliteration": "nij palakaa par paree sakal nis khoi hau ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਪਲੰਘ ਉਤੇ ਪਈ ਪਈ ਸਾਰੀ ਰਾਤ ਬਿਤਾਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "निजु पलका पर परी सकल निसु खोइ हौ ॥",
      "sourceLineId": "136751",
      "sourceShabadId": "12673",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਹਾ ਬਿਲਾਰਿ ਮੋਹਿ ਨਖ ਘਾਤ ਲਗਾਤ ਹੈ ॥",
      "transliteration": "eihaa bilaar moh nakh ghaat lagaat hai ||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਬਿਲਾ ਮੈਨੂੰ ਨਹੁੰ ਮਾਰਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "इहा बिलारि मोहि नख घात लगात है ॥",
      "sourceLineId": "136752",
      "sourceShabadId": "12673",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹੋ ਤੁਹਿ ਮੂਰਖ ਰਾਜਾ ਤੇ ਕਛੁ ਨ ਬਸਾਤ ਹੈ ॥੧੭॥",
      "transliteration": "ho tuh moorakh raajaa te kachh na basaat hai ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੇ ਮੂਰਖ ਰਾਜੇ! ਤੇਰੇ ਵਸ ਦੀ ਕੋਈ ਗੱਲ ਨਹੀਂ ਹੈ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "हो तुहि मूरख राजा ते कछु न बसात है ॥१७॥",
      "sourceLineId": "136753",
      "sourceShabadId": "12673",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136754",
      "sourceShabadId": "12674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਹ ਛਲ ਤਜਿ ਸ੍ਵੈਬੋ ਨ੍ਰਿਪ ਪਾਸਾ ॥",
      "transliteration": "eeh chhal taj savaibo nirap paasaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਉਸ ਨੇ ਰਾਜੇ ਕੋਲ ਸੌਣਾ ਛਡ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "इह छल तजि स्वैबो नृप पासा ॥",
      "sourceLineId": "136755",
      "sourceShabadId": "12674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿਯਾ ਮਿਤ੍ਰ ਸੌ ਕਾਮ ਬਿਲਾਸਾ ॥",
      "transliteration": "kiyaa mitr sau kaam bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਆਪਣੇ) ਮਿਤਰ ਨਾਲ ਕਾਮ ਬਿਲਾਸ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "किया मित्र सौ काम बिलासा ॥",
      "sourceLineId": "136756",
      "sourceShabadId": "12674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਘਾਤ ਨਖਨ ਕੀ ਨਾਹ ਦਿਖਾਈ ॥",
      "transliteration": "ghaat nakhan kee naeh dhikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਨਹੁੰਆਂ ਦੇ ਨਿਸ਼ਾਣ ਰਾਜੇ ਨੂੰ ਵਿਖਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "घात नखन की नाह दिखाई ॥",
      "sourceLineId": "136757",
      "sourceShabadId": "12674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਰਧ ਮੂੜ ਨ੍ਰਿਪ ਬਾਤ ਨ ਪਾਈ ॥੧੮॥",
      "transliteration": "biradh mooR nirap baat na paiee ||18||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਬਿਰਧ ਰਾਜਾ ਗੱਲ ਨੂੰ ਸਮਝ ਨਾ ਸਕਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "बिरध मूड़ नृप बात न पाई ॥१८॥",
      "sourceLineId": "136758",
      "sourceShabadId": "12674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੦॥੬੭੧੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau satar charitr samaapatam sat subham sat ||370||6718||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੭੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੭੦॥੬੭੧੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ सतर चरित्र समापतम सतु सुभम सतु ॥३७०॥६७१८॥अफजूँ॥",
      "sourceLineId": "136759",
      "sourceShabadId": "12674",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136760",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਛਲ ਸੈਨ ਇਕ ਭੂਪ ਭਨਿਜੈ ॥",
      "transliteration": "achhal sain ik bhoop bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਅਛਲ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "अछल सैन इक भूप भनिजै ॥",
      "sourceLineId": "136761",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੰਦ੍ਰ ਸੂਰ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥",
      "transliteration": "cha(n)dhr soor paTatar teh dhijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਉਪਮਾ ਚੰਦ੍ਰਮਾ ਅਤੇ ਸੂਰਜ ਨਾਲ ਦਿੱਤੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "चंद्र सूर पटतर तिह दिजै ॥",
      "sourceLineId": "136762",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕੰਚਨ ਦੇ ਤਾ ਕੇ ਘਰ ਨਾਰੀ ॥",
      "transliteration": "ka(n)chan dhe taa ke ghar naaree ||",
      "translation": "",
      "punjabiViakhya": "ਕੰਚਨ ਦੇ (ਦੇਈ) ਉਸ ਦੇ ਘਰ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "कंचन दे ता के घर नारी ॥",
      "sourceLineId": "136763",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਪੁ ਹਾਥ ਲੈ ਈਸ ਸਵਾਰੀ ॥੧॥",
      "transliteration": "aap haath lai iees savaaree ||1||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ ਮਾਨੋ) ਪ੍ਰਭੂ ਨੇ ਆਪਣੇ ਹੱਥਾ ਨਾਲ ਬਣਾਇਆ ਹੋਵੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "आपु हाथ लै ईस सवारी ॥१॥",
      "sourceLineId": "136764",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕੰਚਨ ਪੁਰ ਕੋ ਰਾਜ ਕਮਾਵੈ ॥",
      "transliteration": "ka(n)chan pur ko raaj kamaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕੰਚਨ ਪੁਰ ਵਿਚ ਰਾਜ ਕਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "कंचन पुर को राज कमावै ॥",
      "sourceLineId": "136765",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੂਰਬੀਰ ਬਲਵਾਨ ਕਹਾਵੈ ॥",
      "transliteration": "soorabeer balavaan kahaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸ਼ੂਰਵੀਰ ਅਤੇ ਬਲਵਾਨ ਅਖਵਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "सूरबीर बलवान कहावै ॥",
      "sourceLineId": "136766",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਰਿ ਅਨੇਕ ਜੀਤੇ ਬਹੁ ਭਾਤਾ ॥",
      "transliteration": "ar anek jeete bahu bhaataa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਢੰਗਾ ਨਾਲ ਅਨੇਕ ਵੈਰੀ ਜਿਤੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "अरि अनेक जीते बहु भाता ॥",
      "sourceLineId": "136767",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੇਜ ਤ੍ਰਸਤ ਜਾ ਕੇ ਪੁਰ ਸਾਤਾ ॥੨॥",
      "transliteration": "tej trasat jaa ke pur saataa ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਤੇਜ ਤੋਂ ਸੱਤੇ ਪੁਰੀਆਂ ਡਰਦੀਆਂ ਸਨ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "तेज त्रसत जा के पुर साता ॥२॥",
      "sourceLineId": "136768",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਹਾ ਪ੍ਰਭਾਕਰ ਸੈਨਿਕ ਸਾਹ ॥",
      "transliteration": "tahaa prabhaakar sainik saeh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਪ੍ਰਭਾਕਰ ਸੈਨ ਨਾ ਦਾ ਇਕ ਸ਼ਾਹ ਹੁੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "तहा प्रभाकर सैनिक साह ॥",
      "sourceLineId": "136769",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਿਰਖ ਲਜਤ ਜਾ ਕੋ ਮੁਖ ਮਾਹ ॥",
      "transliteration": "nirakh lajat jaa ko mukh maeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਚੰਦ੍ਰਮਾ ('ਮਾਹ') ਦਾ ਮੁਖ ਲਜਿਤ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "निरख लजत जा को मुख माह ॥",
      "sourceLineId": "136770",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਬ ਰਾਨੀ ਤਾ ਕਹ ਲਖਿ ਪਾਯੋ ॥",
      "transliteration": "jab raanee taa keh lakh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਰਾਣੀ ਨੇ ਉਸ ਨੂੰ ਵੇਖ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "जब रानी ता कह लखि पायो ॥",
      "sourceLineId": "136771",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਹੈ ਚਿਤ ਭੀਤਰ ਠਹਰਾਯੋ ॥੩॥",
      "transliteration": "eihai chit bheetar Thaharaayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਾ (ਆਪਣੇ) ਮਨ ਵਿਚ ਇਹ ਵਿਚਾਰ ਬਣਾਇਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "इहै चित भीतर ठहरायो ॥३॥",
      "sourceLineId": "136772",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਯਾ ਕਹ ਜਤਨ ਕਵਨ ਕਰਿ ਪਇਯੈ ॥",
      "transliteration": "yaa keh jatan kavan kar piyai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੂੰ ਕਿਹੜੇ ਯਤਨ ਨਾਲ ਪ੍ਰਾਪਤ ਕੀਤਾ ਜਾਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "या कह जतन कवन करि पइयै ॥",
      "sourceLineId": "136773",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਵਨ ਸਹਚਰੀ ਪਠੈ ਮੰਗਇਯੈ ॥",
      "transliteration": "kavan sahacharee paThai ma(n)giyai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਹੜੀ ਦਾਸੀ ਨੂੰ ਭੇਜ ਕੇ ਮੰਗਵਾਇਆ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "कवन सहचरी पठै मंगइयै ॥",
      "sourceLineId": "136774",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਯਾਹਿ ਭਜੈ ਬਿਨੁ ਧਾਮ ਨ ਜੈਹੌ ॥",
      "transliteration": "yaeh bhajai bin dhaam na jaihau ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨਾਲ ਸੰਯੋਗ ਪ੍ਰਾਪਤ ਕੀਤੇ ਬਿਨਾ ਘਰ ਨਹੀਂ ਜਾਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "याहि भजै बिनु धाम न जैहौ ॥",
      "sourceLineId": "136775",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਭਾਤਿ ਯਾਹਿ ਬਸਿ ਕੈਹੌ ॥੪॥",
      "transliteration": "jeh teh bhaat yaeh bas kaihau ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਇਸ ਨੂੰ ਵਸ ਵਿਚ ਕਰਾਗੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "जिह तिह भाति याहि बसि कैहौ ॥४॥",
      "sourceLineId": "136776",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਨਕ ਪਿੰਜਰੀ ਪਰੀ ਹੁਤੀ ਤਹ ॥",
      "transliteration": "kanak pi(n)jaree paree hutee teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਕਨਕ ਪਿੰਜਰੀ ਨਾ ਦੀ ਪਰੀ ਹੁੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "कनक पिंजरी परी हुती तह ॥",
      "sourceLineId": "136777",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਰਮ ਕੇਤੁ ਰਾਨੀ ਕੇ ਬਸਿ ਮਹ ॥",
      "transliteration": "maram ket raanee ke bas meh ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮਰਮ ਕੇਤੁ ਰਾਣੀ ਦੇ ਵਸ ਵਿਚ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "मरम केतु रानी के बसि मह ॥",
      "sourceLineId": "136778",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬੀਰ ਰਾਧਿ ਤਿਹ ਤਹੀ ਪਠਾਈ ॥",
      "transliteration": "beer raadh teh tahee paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਰਾਣੀ) ਨੇ ਬੀਰ (ਬਵੰਜਾ ਵਿਚੋਂ ਇਕ) ਦੀ ਅਰਾਧਨਾ ਕਰ ਕੇ ਉਸ (ਪਰੀ) ਨੂੰ ਉਥੇ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "बीर राधि तिह तही पठाई ॥",
      "sourceLineId": "136779",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੇਜ ਉਠਾਇ ਜਾਇ ਲੈ ਆਈ ॥੫॥",
      "transliteration": "sej uThai jai lai aaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੰਜੇ ਸਹਿਤ ਉਸ ਨੂੰ ਚੁਕਵਾ ਲਿਆਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "सेज उठाइ जाइ लै आई ॥५॥",
      "sourceLineId": "136780",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਤਾ ਸੌ ਜਬ ਮਾਨਾ ॥",
      "transliteration": "kaam bhog taa sau jab maanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨਾਲ ਕਾਮ-ਲੀਲ੍ਰਹਾ ਕੀਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "काम भोग ता सौ जब माना ॥",
      "sourceLineId": "136781",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦ੍ਵੈ ਪ੍ਰਾਨਨ ਤੇ ਇਕ ਜਿਯ ਜਾਨਾ ॥",
      "transliteration": "dhavai praanan te ik jiy jaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਦੋ ਪ੍ਰਾਣਾ ਤੋਂ ਇਕ ਪ੍ਰਾਣ ਹੋ ਗਈ (ਅਰਥਾਤ ਉਸ ਵਿਚ ਪੂਰੀ ਤਰ੍ਰਹਾ ਸਮਾ ਗਈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "द्वै प्रानन ते इक जिय जाना ॥",
      "sourceLineId": "136782",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਿਜੁ ਨਾਇਕ ਸੇਤੀ ਹਿਤ ਛੋਰੋ ॥",
      "transliteration": "nij naik setee hit chhoro ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਪਣੇ ਪਤੀ ਨਾਲ ਪਿਆਰ ਕਰਨਾ ਛਡ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "निजु नाइक सेती हित छोरो ॥",
      "sourceLineId": "136783",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਾ ਸੌ ਚਤੁਰਿ ਚੌਗੁਨੋ ਜੋਰੋ ॥੬॥",
      "transliteration": "taa sau chatur chauaguno joro ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ (ਸ਼ਾਹ) ਨਾਲ ਚਾਰ ਗੁਣਾ (ਪ੍ਰੇਮ) ਵਧਾ ਲਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "ता सौ चतुरि चौगुनो जोरो ॥६॥",
      "sourceLineId": "136784",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਾਇ ਰਾਵ ਸੌ ਬਾਤ ਜਨਾਈ ॥",
      "transliteration": "jai raav sau baat janaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਕ ਦਿਨ) ਰਾਣੀ ਨੇ ਰਾਜੇ ਨੂੰ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "जाइ राव सौ बात जनाई ॥",
      "sourceLineId": "136785",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1323_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੋਰੋ ਸਾਹ ਪੂਰਬਲੋ ਭਾਈ ॥",
      "transliteration": "moro saeh poorabalo bhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਸ਼ਾਹ ਮੇਰੇ ਪਿਛਲੇ ਜਨਮ ਦਾ ਭਰਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1323,
      "hindi": "",
      "hindiTransliteration": "मोरो साह पूरबलो भाई ॥",
      "sourceLineId": "136786",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
