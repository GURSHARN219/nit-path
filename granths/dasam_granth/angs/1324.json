{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1324,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1324_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਮ ਕੋ ਸ੍ਰਾਪ ਏਕ ਰਿਖ ਦਿਯਾ ॥",
      "transliteration": "ham ko sraap ek rikh dhiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਨੂੰ ਇਕ ਰਿਸ਼ੀ ਨੇ ਸ੍ਰਾਪ ਦਿੱਤਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "हम को स्राप एक रिख दिया ॥",
      "sourceLineId": "136787",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਾ ਤੇ ਜਨਮ ਦੁਹੂੰ ਹ੍ਯਾਂ ਲਿਯਾ ॥੭॥",
      "transliteration": "taa te janam dhuhoo(n) hayaa(n) liyaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ (ਅਸਾ) ਇਥੇ ਆ ਕੇ ਜਨਮ ਲਿਆ ਹੈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "ता ते जनम दुहूँ ह्याँ लिया ॥७॥",
      "sourceLineId": "136788",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪੁਨਿ ਹਮ ਸੌ ਰਿਖਿ ਐਸ ਉਚਾਰਾ ॥",
      "transliteration": "pun ham sau rikh aais uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਰਿਖੀ ਨੇ ਸਾਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "पुनि हम सौ रिखि ऐस उचारा ॥",
      "sourceLineId": "136789",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹ੍ਵੈ ਹੈ ਬਹੁਰਿ ਉਧਾਰ ਤੁਹਾਰਾ ॥",
      "transliteration": "havai hai bahur udhaar tuhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸਾ ਦੋਹਾ ਦਾ ਫਿਰ ਉੱਧਾਰ ਹੋਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "ह्वै है बहुरि उधार तुहारा ॥",
      "sourceLineId": "136790",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਾਤ ਲੋਕ ਬਹੁ ਬਰਿਸ ਬਿਤੈਹੌ ॥",
      "transliteration": "maat lok bahu baris bitaihau ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਮਾਤ ਲੋਕ ਵਿਚ ਬਹੁਤ ਸਾਲ ਬਤੀਤ ਕਰੋਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "मात लोक बहु बरिस बितैहौ ॥",
      "sourceLineId": "136791",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਹੁਰੌ ਦੋਊ ਸ੍ਵਰਗ ਮਹਿ ਐਹੌ ॥੮॥",
      "transliteration": "bahurau dhouoo savairag meh aaihau ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਦੋਵੇਾਂ ਸਵਰਗ ਵਿਚ ਆ ਜਾਓਗੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "बहुरौ दोऊ स्वरग महि ऐहौ ॥८॥",
      "sourceLineId": "136792",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਮ ਤੁਮਰੋ ਘਰ ਬਸ ਸੁਖੁ ਪਾਯੋ ॥",
      "transliteration": "ham tumaro ghar bas sukh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੁਹਾਡੇ ਘਰ ਵਸ ਕੇ (ਬਹੁਤ) ਸੁਖ ਪ੍ਰਾਪਤ ਕੀਤਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "हम तुमरो घर बस सुखु पायो ॥",
      "sourceLineId": "136793",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਬ ਰਿਖਿ ਸ੍ਰਾਪ ਅਵਧਿ ਹ੍ਵੈ ਆਯੋ ॥",
      "transliteration": "ab rikh sraap avadh havai aayo ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਰਿਖੀ ਦੇ ਸ੍ਰਾਪ ਦੀ ਅਵਧੀ ਮੁਕਣ ਤੇ ਆਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "अब रिखि स्राप अवधि ह्वै आयो ॥",
      "sourceLineId": "136794",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਏ ਬਚ ਭਾਖਿ ਨ੍ਰਿਪਹਿ ਘਰ ਆਈ ॥",
      "transliteration": "e bach bhaakh nirapeh ghar aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਗੱਲ ਕਹਿ ਕੇ ਰਾਜ-ਮਹੱਲ ਵਿਚ ਆ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "ए बच भाखि नृपहि घर आई ॥",
      "sourceLineId": "136795",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਾਹ ਪਰੀ ਜੁਤ ਲਿਯਾ ਬੁਲਾਈ ॥੯॥",
      "transliteration": "saeh paree jut liyaa bulaiee ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਰੀ ਸਮੇਤ ਸ਼ਾਹ ਨੂੰ ਬੁਲਾ ਲਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "साह परी जुत लिया बुलाई ॥९॥",
      "sourceLineId": "136796",
      "sourceShabadId": "12675",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136797",
      "sourceShabadId": "12676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਈ ਇਹ ਗਈ ਧੁੰਨਿ ਤੁਮ ਕਰਿਯਹੁ ॥",
      "transliteration": "giee ieh giee dhu(n)n tum kariyahu ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ ਪਰੀ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਸਮਝਾ ਦਿੱਤਾ ਕਿ) 'ਗਈ ਗਈ' ਦੀ ਧੁਨ (ਆਵਾਜ਼) ਕਰਨੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "गई इह गई धुँनि तुम करियहु ॥",
      "sourceLineId": "136798",
      "sourceShabadId": "12676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭੂਪ ਸੁਨਤ ਨਭ ਬਿਖੈ ਉਚਰਿਯਹੁ ॥",
      "transliteration": "bhoop sunat nabh bikhai uchariyahu ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਵਿਚ ਜਾ ਕੇ, ਤਾ ਜੋ ਰਾਜਾ ਸੁਣ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "भूप सुनत नभ बिखै उचरियहु ॥",
      "sourceLineId": "136799",
      "sourceShabadId": "12676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਬ ਤਿਨ ਬਾਤ ਭੇਦ ਕੀ ਜਾਨੀ ॥",
      "transliteration": "jab tin baat bhedh kee jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਪਰੀ ਨੇ ਭੇਦ ਦੀ ਗੱਲ ਸਮਝ ਲਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "जब तिन बात भेद की जानी ॥",
      "sourceLineId": "136800",
      "sourceShabadId": "12676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਲਾ ਕਹੌਗੀ ਪਰੀ ਬਖਾਨੀ ॥੧੦॥",
      "transliteration": "bhalaa kahauagee paree bakhaanee ||10||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਪਰੀ ਨੇ ਕਿਹਾ ਕਿ ਚੰਗੀ ਤਰ੍ਰਹਾ ਨਾਲ (ਇਹੀ) ਕਹਾਗੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "भला कहौगी परी बखानी ॥१०॥",
      "sourceLineId": "136801",
      "sourceShabadId": "12676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਾਹ ਸਹਿਤ ਭੂਪਤਿ ਪਹਿ ਜਾਇ ॥",
      "transliteration": "saeh sahit bhoopat peh jai ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਸਮੇਤ ਰਾਣੀ ਨੇ ਰਾਜੇ ਪਾਸ ਜਾ ਕੇ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "साह सहित भूपति पहि जाइ ॥",
      "sourceLineId": "136802",
      "sourceShabadId": "12676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੀ ਜਾਤ ਹੈ ਰਾਨੀ ਰਾਇ ॥",
      "transliteration": "kahee jaat hai raanee rai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਰਾਣੀ ਜਾ ਰਹੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "कही जात है रानी राइ ॥",
      "sourceLineId": "136803",
      "sourceShabadId": "12676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਭਾਖਿ ਲੋਪ ਹ੍ਵੈ ਗਈ ॥",
      "transliteration": "eeh bidh bhaakh lop havai giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਕਹਿ ਕੇ (ਰਾਣੀ) ਲੋਪ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "इह बिधि भाखि लोप ह्वै गई ॥",
      "sourceLineId": "136804",
      "sourceShabadId": "12676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗਈ ਗਈ ਬਾਨੀ ਨਭ ਭਈ ॥੧੧॥",
      "transliteration": "giee giee baanee nabh bhiee ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ 'ਗਈ ਗਈ' ਦੀ ਆਕਾਸ਼ ਬਾਣੀ ਹੋਈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "गई गई बानी नभ भई ॥११॥",
      "sourceLineId": "136805",
      "sourceShabadId": "12676",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "136806",
      "sourceShabadId": "12677",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗਈ ਇਹ ਗਈ ਚਿਰ ਲੌ ਨਭ ਬਾਨੀ ਭਈ ॥",
      "transliteration": "giee ieh giee chir lau nabh baanee bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਗਈ ਗਈ' ਦੀ ਆਕਾਸ਼ ਬਾਣੀ ਚਿਰ ਤਕ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "गई इह गई चिर लौ नभ बानी भई ॥",
      "sourceLineId": "136807",
      "sourceShabadId": "12677",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਜਾ ਸਹਿਤ ਤਿਨ ਭੂਪ ਯਹੈ ਜਿਯ ਮੈ ਠਈ ॥",
      "transliteration": "prajaa sahit tin bhoop yahai jiy mai Thiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰਜਾ ਸਮੇਤ ਰਾਜੇ ਨੇ ਮਨ ਵਿਚ ਇਹੀ ਸਮਝ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "प्रजा सहित तिन भूप यहै जिय मै ठई ॥",
      "sourceLineId": "136808",
      "sourceShabadId": "12677",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਾਨੀ ਸੁਰ ਪੁਰ ਗਈ ਭ੍ਰਾਤ ਕੋ ਸਾਥ ਲੈ ॥",
      "transliteration": "raanee sur pur giee bhraat ko saath lai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਣੀ ਭਰਾ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਸਵਰਗ ਵਿਚ ਚਲੀ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "रानी सुर पुर गई भ्रात को साथ लै ॥",
      "sourceLineId": "136809",
      "sourceShabadId": "12677",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹੋ ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਨ ਸਕਾ ਬਿਚਾਰਿ ਕੈ ॥੧੨॥",
      "transliteration": "ho moorakh bhedh abhedh na sakaa bichaar kai ||12||",
      "translation": "",
      "punjabiViakhya": "(ਕੋਈ ਵੀ) ਮੂਰਖ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਹੀਂ ਵਿਚਾਰ ਸਕਿਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "हो मूरख भेद अभेद न सका बिचारि कै ॥१२॥",
      "sourceLineId": "136810",
      "sourceShabadId": "12677",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136811",
      "sourceShabadId": "12678",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਿਲਿ ਸਭਹਿਨ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥",
      "transliteration": "mil sabhahin ieh bhaat uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੇ ਮਿਲ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "मिलि सभहिन इह भाति उचारी ॥",
      "sourceLineId": "136812",
      "sourceShabadId": "12678",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਈ ਸੁਰਗ ਨ੍ਰਿਪ ਨਾਰਿ ਤੁਮਾਰੀ ॥",
      "transliteration": "giee surag nirap naar tumaaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਤੁਹਾਡੀ ਇਸਤਰੀ ਸਵਰਗ ਵਿਚ ਚਲੀ ਗਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "गई सुरग नृप नारि तुमारी ॥",
      "sourceLineId": "136813",
      "sourceShabadId": "12678",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੁਮ ਚਿੰਤਾ ਚਿਤ ਮੈ ਨਹਿ ਕਰੋ ॥",
      "transliteration": "tum chi(n)taa chit mai neh karo ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਆਪਣੇ ਚਿਤ ਵਿਚ ਚਿੰਤਾ ਨਾ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "तुम चिंता चित मै नहि करो ॥",
      "sourceLineId": "136814",
      "sourceShabadId": "12678",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੁੰਦਰ ਸੁਘਰ ਅਵਰ ਤ੍ਰਿਯ ਬਰੋ ॥੧੩॥",
      "transliteration": "su(n)dhar sughar avar tiray baro ||13||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਹੋਰ ਸੁੰਦਰ ਸੁਘੜ ਇਸਤਰੀ ਨਾਲ ਵਿਆਹ ਕਰ ਲਵੋ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "सुँदर सुघर अवर तृय बरो ॥१३॥",
      "sourceLineId": "136815",
      "sourceShabadId": "12678",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੧॥੬੭੩੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau ikahatar charitr samaapatam sat subham sat ||371||6731||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੭੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੭੧॥੬੭੩੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ इकहतरि चरित्र समापतम सतु सुभम सतु ॥३७१॥६७३१॥अफजूँ॥",
      "sourceLineId": "136816",
      "sourceShabadId": "12678",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136817",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਇਕ ਅਵਰ ਪ੍ਰਸੰਗਾ ॥",
      "transliteration": "sun raajaa ik avar prasa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਹੋਰ ਪ੍ਰਸੰਗ (ਚਰਿਤ੍ਰ) ਸੁਣੋ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा इक अवर प्रसंगा ॥",
      "sourceLineId": "136818",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਕਿਯਾ ਨਾਰਿ ਨ੍ਰਿਪ ਸੰਗਾ ॥",
      "transliteration": "jeh bidh kiyaa naar nirap sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਕਿ ਇਕ ਇਸਤਰੀ ਨੇ ਰਾਜੇ ਨਾਲ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि किया नारि नृप संगा ॥",
      "sourceLineId": "136819",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਲਜ ਸੈਨ ਇਕ ਭੂਮ ਭਨਿਜੈ ॥",
      "transliteration": "jalaj sain ik bhoom bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਜਲਜ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "जलज सैन इक भूम भनिजै ॥",
      "sourceLineId": "136820",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੁਛਬਿ ਮਤੀ ਤਿਹ ਨਾਰਿ ਕਹਿਜੈ ॥੧॥",
      "transliteration": "suchhab matee teh naar kahijai ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਰਾਣੀ ਦਾ ਨਾ ਸੁਛਬਿ ਮਤੀ ਕਿਹਾ ਜਾਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "सुछबि मती तिह नारि कहिजै ॥१॥",
      "sourceLineId": "136821",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਛਬਿਵਤੀ ਤਿਹ ਨਗਰ ਕਹੀਜਤ ॥",
      "transliteration": "suchhabivatee teh nagar kaheejat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਨਗਰ ਦਾ ਨਾ ਸੁਛਬਿਵਤੀ ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "सुछबिवती तिह नगर कहीजत ॥",
      "sourceLineId": "136822",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਮਰ ਪੁਰੀ ਪਟਤਰ ਤਿਹ ਦੀਜਤ ॥",
      "transliteration": "amar puree paTatar teh dheejat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਉਪਮਾ ਅਮਰ ਪੁਰੀ ਨਾਲ ਦਿੱਤੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "अमर पुरी पटतर तिह दीजत ॥",
      "sourceLineId": "136823",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਜਾ ਕੋ ਤ੍ਰਿਯ ਹੁਤੀ ਨ ਪ੍ਯਾਰੀ ॥",
      "transliteration": "raajaa ko tiray hutee na payaaree ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਰਾਣੀ ਨਾਲ ਪ੍ਰੇਮ ਨਹੀਂ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "राजा को तृय हुती न प्यारी ॥",
      "sourceLineId": "136824",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਯਾ ਤੇ ਰਾਨੀ ਰਹਤ ਦੁਖਾਰੀ ॥੨॥",
      "transliteration": "yaa te raanee rahat dhukhaaree ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਰਾਣੀ ਦੁਖੀ ਰਹਿੰਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "या ते रानी रहत दुखारी ॥२॥",
      "sourceLineId": "136825",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਾਨੀ ਰੂਪ ਬੈਦ ਕੋ ਠਾਨਿ ॥",
      "transliteration": "raanee roop baidh ko Thaan ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਵੈਦ ਦਾ ਰੂਪ ਧਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "रानी रूप बैद को ठानि ॥",
      "sourceLineId": "136826",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਾਜਾ ਕੇ ਘਰ ਕਿਯਾ ਪਯਾਨ ॥",
      "transliteration": "raajaa ke ghar kiyaa payaan ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੇ ਘਰ ਚਲੀ ਗਈ। (ਜਾ ਕੇ) ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "राजा के घर किया पयान ॥",
      "sourceLineId": "136827",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਹਾ ਅਸਾਧ ਭਯਾ ਹੈ ਤੋਹਿ ॥",
      "transliteration": "kahaa asaadh bhayaa hai toh ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਨੂੰ ਅਸਾਧ (ਰੋਗ) ਹੋ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "कहा असाध भया है तोहि ॥",
      "sourceLineId": "136828",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬੋਲਿ ਚਕਿਤਸਾ ਕੀਜੈ ਮੋਹਿ ॥੩॥",
      "transliteration": "bol chakitasaa keejai moh ||3||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਬੁਲਾ ਕੇ (ਆਪਣਾ) ਇਲਾਜ ਕਰਾਓ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "बोलि चकितसा कीजै मोहि ॥३॥",
      "sourceLineId": "136829",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਧਾਵਤ ਤੁਮੈ ਪਸੀਨੋ ਆਵਤ ॥",
      "transliteration": "dhaavat tumai paseeno aavat ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਨੂੰ ਤੇਜ਼ ਚਲਣ ਨਾਲ ਪਸੀਨਾ ਆ ਜਾਦਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "धावत तुमै पसीनो आवत ॥",
      "sourceLineId": "136830",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਵਿ ਦੇਖਤ ਦ੍ਰਿਗ ਧੁੰਧ ਜਨਾਵਤ ॥",
      "transliteration": "rav dhekhat dhirag dhu(n)dh janaavat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਜ ਵਲ ਵੇਖਦਿਆਂ ਅੱਖਾ ਵਿਚ ਧੁੰਧਲਾਪਨ ਮਹਿਸੂਸ ਹੁੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "रवि देखत दृग धुँध जनावत ॥",
      "sourceLineId": "136831",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰਾਜਾ ਬਾਤ ਸਤ੍ਯ ਕਰਿ ਮਾਨੀ ॥",
      "transliteration": "raajaa baat satay kar maanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਉਸ ਦੀ ਗੱਲ ਸਚ ਮੰਨ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "राजा बात सत्य करि मानी ॥",
      "sourceLineId": "136832",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੂੜ ਭੇਦ ਕੀ ਕ੍ਰਿਯਾ ਨ ਜਾਨੀ ॥੪॥",
      "transliteration": "mooR bhedh kee kirayaa na jaanee ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੂਰਖ ਨੇ ਭੇਦ ਦੀ ਕ੍ਰਿਆ ਨੂੰ ਨਾ ਸਮਝਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "मूड़ भेद की कृया न जानी ॥४॥",
      "sourceLineId": "136833",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੂਰਖ ਭੂਪ ਭੇਦ ਨਹਿ ਪਾਯੋ ॥",
      "transliteration": "moorakh bhoop bhedh neh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜੇ ਨੇ ਭੇਦ ਨੂੰ ਨਹੀਂ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "मूरख भूप भेद नहि पायो ॥",
      "sourceLineId": "136834",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤ੍ਰਿਯ ਤੇ ਬੋਲਿ ਉਪਾਇ ਕਰਾਯੋ ॥",
      "transliteration": "tiray te bol upai karaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਵੈਦ ਬਣੀ) ਇਸਤਰੀ ਨੂੰ ਬੁਲਾ ਕੇ ਉਪਚਾਰ ਕਰਵਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "तृय ते बोलि उपाइ करायो ॥",
      "sourceLineId": "136835",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਿਨ ਬਿਖ ਡਾਰਿ ਔਖਧੀ ਬੀਚਾ ॥",
      "transliteration": "tin bikh ddaar aauakhadhee beechaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਇਸਤਰੀ) ਨੇ ਦਵਾਈ ਵਿਚ ਵਿਸ਼ ਪਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "तिन बिख डारि औखधी बीचा ॥",
      "sourceLineId": "136836",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਛਿਨ ਮਹਿ ਕਰੀ ਭੂਪ ਕੀ ਮੀਚਾ ॥੫॥",
      "transliteration": "chhin meh karee bhoop kee meechaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਛਿਣ ਭਰ ਵਿਚ ਰਾਜੇ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "छिन महि करी भूप की मीचा ॥५॥",
      "sourceLineId": "136837",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਬਹਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੨॥੬੭੩੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau bahatar charitr samaapatam sat subham sat ||372||6736||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੭੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੭੨॥੬੭੩੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ बहतर चरित्र समापतम सतु सुभम सतु ॥३७२॥६७३६॥अफजूँ॥",
      "sourceLineId": "136838",
      "sourceShabadId": "12679",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136839",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਹਿਰ ਦੌਲਤਾਬਾਦ ਬਸਤ ਜਹ ॥",
      "transliteration": "sahir dhaualataabaadh basat jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਦੌਲਤਾਬਾਦ ਸ਼ਹਿਰ ਵਸਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "सहिर दौलताबाद बसत जह ॥",
      "sourceLineId": "136840",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਬਿਕਟ ਸਿੰਘ ਇਕ ਭੂਪ ਹੁਤੋ ਤਹ ॥",
      "transliteration": "bikaT si(n)gh ik bhoop huto teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਿਕਟ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "बिकट सिंघ इक भूप हुतो तह ॥",
      "sourceLineId": "136841",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਭਾਨ ਮੰਜਰੀ ਤਾ ਕੀ ਦਾਰਾ ॥",
      "transliteration": "bhaan ma(n)jaree taa kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਨ ਮੰਜਰੀ ਉਸ ਦੀ ਇਸਤਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "भान मंजरी ता की दारा ॥",
      "sourceLineId": "136842",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਿਹ ਸਮ ਕਰੀ ਨ ਪੁਨਿ ਕਰਤਾਰਾ ॥੧॥",
      "transliteration": "jeh sam karee na pun karataaraa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਪਰਮਾਤਮਾ ਨੇ ਫਿਰ ਪੈਦਾ ਨਹੀਂ ਕੀਤੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "जिह सम करी न पुनि करतारा ॥१॥",
      "sourceLineId": "136843",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਭੀਮ ਸੈਨ ਇਕ ਤਹ ਥੋ ਸਾਹਾ ॥",
      "transliteration": "bheem sain ik teh tho saahaa ||",
      "translation": "",
      "punjabiViakhya": "ਭੀਮ ਸੈਨ ਨਾ ਦਾ ਉਥੇ ਇਕ ਸ਼ਾਹ ਸੀ। (ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "भीम सैन इक तह थो साहा ॥",
      "sourceLineId": "136844",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਪ੍ਰਗਟ ਭਯੋ ਜਨੁ ਦੂਸਰ ਮਾਹਾ ॥",
      "transliteration": "pragaT bhayo jan dhoosar maahaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਦੂਜਾ ਚੰਦ੍ਰਮਾ ਪੈਦਾ ਹੋ ਗਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "प्रगट भयो जनु दूसर माहा ॥",
      "sourceLineId": "136845",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸ੍ਰੀ ਅਫਤਾਬ ਦੇਇ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "sree afataab dhei teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪਤਨੀ ਦਾ ਨਾ ਅਫਤਾਬ ਦੇਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "स्री अफताब देइ तिह नारी ॥",
      "sourceLineId": "136846",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨੁ ਢਾਰੀ ॥੨॥",
      "transliteration": "kanak avaT saache jan ddaaree ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਸੋਨਾ ਪੰਘਾਰ ਕੇ ਸੰਚੇ ਵਿਚ ਢਾਲੀ ਗਈ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "कनक अवटि साचे जनु ढारी ॥२॥",
      "sourceLineId": "136847",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਤਿਨ ਮਨ ਮੈ ਇਹ ਬਾਤ ਬਖਾਨੀ ॥",
      "transliteration": "tin man mai ieh baat bakhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਇਸਤਰੀ) ਨੇ ਮਨ ਵਿਚ ਸੋਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "तिन मन मै इह बात बखानी ॥",
      "sourceLineId": "136848",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕਿਹ ਬਿਧਿ ਕੈ ਹੂਜਿਯੈ ਭਵਾਨੀ ॥",
      "transliteration": "keh bidh kai hoojiyai bhavaanee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਕਿਵੇਾਂ (ਮੈਂ ਆਪ) ਭਵਾਨੀ ਹੋ ਜਾਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "किह बिधि कै हूजियै भवानी ॥",
      "sourceLineId": "136849",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਸੋਇ ਰਹੀ ਸਭ ਜਗਹਿ ਦਿਖਾਇ ॥",
      "transliteration": "soi rahee sabh jageh dhikhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਹੋਰ ਸਾਰੇ ਜਾਗਦੇ ਦਿਖਾਈ ਦੇ ਰਹੇ ਸਨ, ਤਾ ਉਹ ਸੁਤੀ ਪਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "सोइ रही सभ जगहि दिखाइ ॥",
      "sourceLineId": "136850",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਚਮਕਿ ਉਠੀ ਸੁਪਨੇ ਕਹ ਪਾਇ ॥੩॥",
      "transliteration": "chamak uThee supane keh pai ||3||",
      "translation": "",
      "punjabiViakhya": "(ਪਰ ਇਕ ਦਮ) ਭੁੜਕ ਕੇ ਉਠ ਖੜੋਤੀ, (ਜਿਵੇਾਂ) ਸੁਪਨਾ ਵੇਖਿਆ ਹੋਵੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "चमकि उठी सुपने कह पाइ ॥३॥",
      "sourceLineId": "136851",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਕਹਾ ਦਰਸ ਮੁਹਿ ਦਿਯਾ ਭਵਾਨੀ ॥",
      "transliteration": "kahaa dharas muh dhiyaa bhavaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕਿਹਾ ਕਿ ਮੈਨੂੰ ਭਵਾਨੀ ਨੇ ਦਰਸ਼ਨ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "कहा दरस मुहि दिया भवानी ॥",
      "sourceLineId": "136852",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਸਭਹਿਨ ਸੌ ਭਾਖੀ ਇਮਿ ਬਾਨੀ ॥",
      "transliteration": "sabhahin sau bhaakhee im baanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "सभहिन सौ भाखी इमि बानी ॥",
      "sourceLineId": "136853",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਜਿਹ ਬਰਦਾਨ ਦੇਉ ਤਿਹ ਹੋਈ ॥",
      "transliteration": "jeh baradhaan dheau teh hoiee ||",
      "translation": "",
      "punjabiViakhya": "(ਹੁਣ) ਜੋ ਵਰਦਾਨ (ਮੈਂ) ਦਿਆਂਗੀ, ਉਹੀ ਹੋਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "जिह बरदान देउ तिह होई ॥",
      "sourceLineId": "136854",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਯਾ ਮਹਿ ਪਰੈ ਫੇਰਿ ਨਹਿ ਕੋਈ ॥੪॥",
      "transliteration": "yaa meh parai fer neh koiee ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਵਿਚ ਕੋਈ ਅਦਲਾ ਬਦਲੀ ਨਹੀਂ ਹੋ ਵੇਗੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "या महि परै फेरि नहि कोई ॥४॥",
      "sourceLineId": "136855",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਲੋਗ ਬਚਨ ਸੁਨਿ ਕਰਿ ਪਗ ਲਾਗੇ ॥",
      "transliteration": "log bachan sun kar pag laage ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਬੋਲ ਸੁਣ ਕੇ ਲੋਕੀਂ ਚਰਨੀਂ ਲਗ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "लोग बचन सुनि करि पग लागे ॥",
      "sourceLineId": "136856",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਬਰੁ ਮਾਗਨ ਤਾ ਤੇ ਅਨੁਰਾਗੇ ॥",
      "transliteration": "bar maagan taa te anuraage ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰੇਮ ਸਹਿਤ ਵਰ ਮੰਗਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "बरु मागन ता ते अनुरागे ॥",
      "sourceLineId": "136857",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1324_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਹ੍ਵੈ ਬੈਠੀ ਸਭਹਿਨ ਕੀ ਮਾਈ ॥",
      "transliteration": "havai baiThee sabhahin kee maiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਦੀ 'ਮਾਈ' (ਦੇਵੀ ਮਾਤਾ) ਬਣ ਬੈਠੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1324,
      "hindi": "",
      "hindiTransliteration": "ह्वै बैठी सभहिन की माई ॥",
      "sourceLineId": "136858",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
