{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1325,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1325_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਯਹ ਸੁਨਿ ਖਬਰ ਨਰਾਧਿਪ ਪਾਈ ॥੫॥",
      "transliteration": "yeh sun khabar naraadhip paiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਖ਼ਬਰ ਰਾਜੇ ਨੇ ਵੀ ਸੁਣ ਲਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "यह सुनि खबर नराधिप पाई ॥५॥",
      "sourceLineId": "136859",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਏਕ ਨਾਰਿ ਇਹ ਨਗਰ ਭਨਿਜੈ ॥",
      "transliteration": "ek naar ieh nagar bhanijai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੂੰ ਦਸਿਆ ਗਿਆ ਕਿ) ਇਸ ਨਗਰ ਵਿਚ ਇਕ ਇਸਤਰੀ ਦਸੀ ਜਾਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "एक नारि इह नगर भनिजै ॥",
      "sourceLineId": "136860",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਮ ਹਿੰਗੁਲਾ ਦੇਇ ਕਹਿਜੈ ॥",
      "transliteration": "naam hi(n)gulaa dhei kahijai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਨਾ ਹਿੰਗੁਲਾ ਦੇਵੀ ਕਿਹਾ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "नाम हिंगुला देइ कहिजै ॥",
      "sourceLineId": "136861",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਗਤ ਮਾਤ ਕੌ ਆਪੁ ਕਹਾਵੈ ॥",
      "transliteration": "jagat maat kau aap kahaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਆਪਣੇ ਆਪ ਨੂੰ ਜਗਤ ਮਾਤਾ ਅਖਵਾਉਾਂਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "जगत मात कौ आपु कहावै ॥",
      "sourceLineId": "136862",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਊਚ ਨੀਚ ਕਹ ਪਾਇ ਲਗਾਵੈ ॥੬॥",
      "transliteration": "uooch neech keh pai lagaavai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉੱਚੇ ਨੀਵੇਾਂ ਨੂੰ ਆਪਣੇ ਚਰਨੀਂ ਲਗਾਉਾਂਦੀ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच कह पाइ लगावै ॥६॥",
      "sourceLineId": "136863",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਜੀ ਔਰ ਮੁਲਾਨੇ ਜੇਤੇ ॥",
      "transliteration": "kaajee aauar mulaane jete ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਜਿਤਨੇ ਕਾਜ਼ੀ ਅਤੇ ਮੌਲਾਣੇ",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "काजी और मुलाने जेते ॥",
      "sourceLineId": "136864",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੋਗੀ ਮੁੰਡਿਯਾ ਅਰੁ ਦਿਜ ਕੇਤੇ ॥",
      "transliteration": "jogee mu(n)ddiyaa ar dhij kete ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਜੋਗੀ, ਸੰਨਿਆਸੀ ਅਤੇ ਬ੍ਰਾਹਮਣ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "जोगी मुँडिया अरु दिज केते ॥",
      "sourceLineId": "136865",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਭ ਕੀ ਘਟਿ ਪੂਜਾ ਹ੍ਵੈ ਗਈ ॥",
      "transliteration": "sabh kee ghaT poojaa havai giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਸਾਰਿਆਂ ਦੀ ਪੂਜਾ ਘਟ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "सभ की घटि पूजा ह्वै गई ॥",
      "sourceLineId": "136866",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਰਚਾ ਅਧਿਕ ਤਵਨ ਕੀ ਭਈ ॥੭॥",
      "transliteration": "parachaa adhik tavan kee bhiee ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਮਾਨਤਾ ਜ਼ਿਆਦਾ ਵਧ ਗਈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "परचा अधिक तवन की भई ॥७॥",
      "sourceLineId": "136867",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਭ ਭੇਖੀ ਯਾ ਤੇ ਰਿਸਿ ਭਰੇ ॥",
      "transliteration": "sabh bhekhee yaa te ris bhare ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਭੇਖੀ ਲੋਗ ਉਸ ਨਾਲ ਖਾਰ ਖਾਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "सभ भेखी या ते रिसि भरे ॥",
      "sourceLineId": "136868",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਹੁ ਧਨ ਚੜਤ ਨਿਰਖਿ ਤਿਹ ਜਰੇ ॥",
      "transliteration": "bahu dhan chaRat nirakh teh jare ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬਹੁਤ ਧਨ ਦਾ ਚੜ੍ਰਹਾਵਾ ਚੜ੍ਰਹਦਾ ਵੇਖ ਕੇ (ਮਨ ਵਿਚ ਬਹੁਤ) ਸੜਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "बहु धन चड़त निरखि तिह जरे ॥",
      "sourceLineId": "136869",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਹਿ ਲੈ ਗਏ ਤਾਹਿ ਨ੍ਰਿਪ ਪਾਸਾ ॥",
      "transliteration": "geh lai ge taeh nirap paasaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪਕੜ ਕੇ ਰਾਜੇ ਪਾਸ ਲੈ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "गहि लै गए ताहि नृप पासा ॥",
      "sourceLineId": "136870",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਹਤ ਭਏ ਇਹ ਬਿਧਿ ਉਪਹਾਸਾ ॥੮॥",
      "transliteration": "kahat bhe ieh bidh upahaasaa ||8||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਉਸ ਦਾ) ਮਜ਼ਾਕ ਉਡਾਦੇ ਹੋਇਆਂ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "कहत भए इह बिधि उपहासा ॥८॥",
      "sourceLineId": "136871",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰਾਮਾਤ ਕਛੁ ਹਮਹਿ ਦਿਖਾਇ ॥",
      "transliteration": "karaamaat kachh hameh dhikhai ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਨੂੰ ਵੀ (ਇਹ) ਆਪਣੀ ਕੁਝ ਕਰਾਮਾਤ ਵਿਖਾਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "करामात कछु हमहि दिखाइ ॥",
      "sourceLineId": "136872",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕੈ ਨ ਭਵਾਨੀ ਨਾਮੁ ਕਹਾਇ ॥",
      "transliteration": "kai na bhavaanee naam kahai ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਆਪਣਾ ਨਾਮ ਭਵਾਨੀ ਨਾ ਅਖਵਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "कै न भवानी नामु कहाइ ॥",
      "sourceLineId": "136873",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਬ ਅਬਲਾ ਅਸ ਮੰਤ੍ਰ ਬਿਚਾਰਾ ॥",
      "transliteration": "tab abalaa as ma(n)tr bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "तब अबला अस मंत्र बिचारा ॥",
      "sourceLineId": "136874",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਨੁ ਰਾਜਾ ਕਹਿਯੋ ਬਚਨ ਹਮਾਰਾ ॥੯॥",
      "transliteration": "sun raajaa kahiyo bachan hamaaraa ||9||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਮੇਰਾ ਕਿਹਾ ਬਚਨ ਸੁਣੋ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "सुनु राजा कहियो बचन हमारा ॥९॥",
      "sourceLineId": "136875",
      "sourceShabadId": "12680",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "136876",
      "sourceShabadId": "12681",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੁਸਲਮਾਨ ਮਸਜਦਿਹਿ ਅਲਹਿ ਘਰ ਭਾਖਹੀ ॥",
      "transliteration": "musalamaan masajadheh aleh ghar bhaakhahee ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਸਲਮਾਨ ਮਸਜਿਦ ਨੂੰ ਰੱਬ ਦਾ ਘਰ ਕਹਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "मुसलमान मसजदिहि अलहि घर भाखही ॥",
      "sourceLineId": "136877",
      "sourceShabadId": "12681",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਪ੍ਰ ਲੋਗ ਪਾਹਨ ਕੌ ਹਰਿ ਕਰਿ ਰਾਖਹੀ ॥",
      "transliteration": "bipr log paahan kau har kar raakhahee ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਾਹਮਣ ਲੋਗ ਪੱਥਰ ਨੂੰ ਪਰਮਾਤਮਾ ਕਰ ਕੇ ਮੰਨਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "बिप्र लोग पाहन कौ हरि करि राखही ॥",
      "sourceLineId": "136878",
      "sourceShabadId": "12681",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਰਾਮਾਤ ਜੌ ਤੁਹਿ ਏ ਪ੍ਰਥਮ ਬਤਾਇ ਹੈ ॥",
      "transliteration": "karaamaat jau tuh e pratham batai hai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਇਹ ਲੋਗ ਪਹਿਲਾ ਤੁਹਾਨੂੰ (ਕੋਈ) ਕਰਾਮਾਤ ਕਰ ਕੇ ਵਿਖਾ ਦੇਣ,",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "करामात जौ तुहि ए प्रथम बताइ है ॥",
      "sourceLineId": "136879",
      "sourceShabadId": "12681",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹੋ ਤਿਹ ਪਾਛੇ ਕਛੁ ਹਮਹੂੰ ਇਨੈ ਦਿਖਾਇ ਹੈ ॥੧੦॥",
      "transliteration": "ho teh paachhe kachh hamahoo(n) inai dhikhai hai ||10||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਨ੍ਰਹਾ ਤੋਂ ਪਿਛੋਂ ਮੈਂ ਵੀ ਇਨ੍ਰਹਾ ਨੂੰ ਕਰਾਮਾਤ ਵਿਖਾ ਦਿਆਂਗੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "हो तिह पाछे कछु हमहूँ इनै दिखाइ है ॥१०॥",
      "sourceLineId": "136880",
      "sourceShabadId": "12681",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136881",
      "sourceShabadId": "12682",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਚਨ ਸੁਨਤ ਰਾਜਾ ਮੁਸਕਾਏ ॥",
      "transliteration": "bachan sunat raajaa musakaae ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ) ਗੱਲ ਸੁਣ ਕੇ ਰਾਜਾ ਹਸਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "बचन सुनत राजा मुसकाए ॥",
      "sourceLineId": "136882",
      "sourceShabadId": "12682",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦਿਜਬਰ ਮੁਲਾ ਪਕਰਿ ਮੰਗਾਏ ॥",
      "transliteration": "dhijabar mulaa pakar ma(n)gaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸਾਰੇ ਬ੍ਰਾਹਮਣਾ, ਮੌਲਾਣਿਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "दिजबर मुला पकरि मंगाए ॥",
      "sourceLineId": "136883",
      "sourceShabadId": "12682",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੁੰਡਿਯਾ ਔਰ ਸੰਨ੍ਯਾਸੀ ਘਨੇ ॥",
      "transliteration": "mu(n)ddiyaa aauar sa(n)nayaasee ghane ||",
      "translation": "",
      "punjabiViakhya": "ਜੋਗੀਆਂ, ਮੁੰਡੀਆਂ, ਜੰਗਮਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "मुँडिया और संन्यासी घने ॥",
      "sourceLineId": "136884",
      "sourceShabadId": "12682",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੋਗੀ ਜੰਗਮ ਜਾਤ ਨ ਗਨੇ ॥੧੧॥",
      "transliteration": "jogee ja(n)gam jaat na gane ||11||",
      "translation": "",
      "punjabiViakhya": "ਸੰਨਿਆਸੀਆਂ ਨੂੰ ਪਕੜਵਾ ਕੇ ਬੁਲਵਾ ਲਿਆ ਜਿਨ੍ਰਹਾ ਦੀ ਗਿਣਤੀ ਨਹੀਂ ਕੀਤੀ ਜਾ ਸਕਦੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "जोगी जंगम जात न गने ॥११॥",
      "sourceLineId": "136885",
      "sourceShabadId": "12682",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "136886",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭੂਪ ਬਚਨ ਮੁਖ ਤੇ ਇਹ ਭਾਤਿ ਉਚਾਰਿਯੋ ॥",
      "transliteration": "bhoop bachan mukh te ieh bhaat uchaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ (ਆਪਣੇ) ਮੂੰਹ ਤੋਂ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "भूप बचन मुख ते इह भाति उचारियो ॥",
      "sourceLineId": "136887",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਭਾ ਬਿਖੈ ਸਭਹਿਨ ਤਿਨ ਸੁਨਤ ਪਚਾਰਿਯੋ ॥",
      "transliteration": "sabhaa bikhai sabhahin tin sunat pachaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਭਾ ਵਿਚ ਬੈਠਿਆਂ ਨੂੰ ਸੁਣਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "सभा बिखै सभहिन तिन सुनत पचारियो ॥",
      "sourceLineId": "136888",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਰਾਮਾਤ ਅਪੁ ਅਪਨੀ ਹਮੈ ਦਿਖਾਇਯੈ ॥",
      "transliteration": "karaamaat ap apanee hamai dhikhaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ (ਪਹਿਲਾ ਤੁਸੀਂ) ਆਪੋ ਆਪਣੀ ਕਰਾਮਾਤ ਮੈਨੂੰ ਵਿਖਾਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "करामात अपु अपनी हमै दिखाइयै ॥",
      "sourceLineId": "136889",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹੋ ਨਾਤਰ ਅਬ ਹੀ ਧਾਮ ਮ੍ਰਿਤੁ ਕੇ ਜਾਇਯੈ ॥੧੨॥",
      "transliteration": "ho naatar ab hee dhaam mrit ke jaiyai ||12||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਹੁਣੇ ਹੀ ਸਾਰੇ ਮ੍ਰਿਤੂ ਦੇ ਘਰ ਨੂੰ ਜਾਓਗੇ (ਅਰਥਾਤ ਮਾਰੇ ਜਾਓਗੇ) ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "हो नातर अब ही धाम मृतु के जाइयै ॥१२॥",
      "sourceLineId": "136890",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁਨਿ ਰਾਜਾ ਕੇ ਬਚਨ ਸਭੈ ਬ੍ਯਾਕੁਲ ਭਏ ॥",
      "transliteration": "sun raajaa ke bachan sabhai bayaakul bhe ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੇ ਬੋਲ ਸੁਣ ਕੇ ਸਾਰੇ ਵਿਆਕੁਲ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "सुनि राजा के बचन सभै ब्याकुल भए ॥",
      "sourceLineId": "136891",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੋਕ ਸਮੁੰਦ ਕੇ ਬੀਚ ਬੂਡਿ ਸਭ ਹੀ ਗਏ ॥",
      "transliteration": "sok samu(n)dh ke beech boodd sabh hee ge ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਹੀ ਦੁਖ ਦੇ ਸਮੁੰਦਰ ਵਿਚ ਡੁਬ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "सोक समुँद के बीच बूडि सभ ही गए ॥",
      "sourceLineId": "136892",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਿਰਖਿ ਨ੍ਰਿਪਤਿ ਕੀ ਓਰ ਰਹੇ ਸਿਰ ਨ੍ਯਾਇ ਕੈ ॥",
      "transliteration": "nirakh nirapat kee or rahe sir nayai kai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਵਲ ਵੇਖ ਕੇ ਸਿਰ ਨੀਵੇਾਂ ਪਾ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "निरखि नृपति की ओर रहे सिर न्याइ कै ॥",
      "sourceLineId": "136893",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹੋ ਕਰਾਮਾਤ ਕੋਈ ਸਕੈ ਨ ਤਾਹਿ ਦਿਖਾਇ ਕੈ ॥੧੩॥",
      "transliteration": "ho karaamaat koiee sakai na taeh dhikhai kai ||13||",
      "translation": "",
      "punjabiViakhya": "ਕਿਉਾਂਕਿ ਉਸ ਨੂੰ ਕੋਈ ਵੀ ਕਰਾਮਾਤ ਨਹੀਂ ਵਿਖਾ ਸਕਦਾ ਸੀ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "हो करामात कोई सकै न ताहि दिखाइ कै ॥१३॥",
      "sourceLineId": "136894",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਰਾਮਾਤ ਨਹਿ ਲਖੀ ਕ੍ਰੋਧ ਰਾਜਾ ਭਰਿਯੋ ॥",
      "transliteration": "karaamaat neh lakhee krodh raajaa bhariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਸੇ ਪਾਸੋਂ) ਕਰਾਮਾਤ ਨਾ ਵੇਖ ਕੇ ਰਾਜਾ ਰੋਹ ਨਾਲ ਭਰ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "करामात नहि लखी क्रोध राजा भरियो ॥",
      "sourceLineId": "136895",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਾਤ ਸਾਤ ਸੈ ਚਾਬੁਕ ਤਿਨ ਕੇ ਤਨ ਝਰਿਯੋ ॥",
      "transliteration": "saat saat sai chaabuk tin ke tan jhariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਨ੍ਰਹਾ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਸੱਤ ਸੱਤ ਸੌ ਚਾਬੁਕ ਮਰਵਾਏ (ਅਤੇ ਕਿਹਾ)",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "सात सात सै चाबुक तिन के तन झरियो ॥",
      "sourceLineId": "136896",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਰਾਮਾਤ ਅਪੁ ਅਪੁਨੀ ਕਛੁਕ ਦਿਖਾਇਯੈ ॥",
      "transliteration": "karaamaat ap apunee kachhuk dhikhaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਆਪੋ ਆਪਣੀ ਕੁਝ ਕੁ ਕਰਾਮਾਤ ਵਿਖਾਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "करामात अपु अपुनी कछुक दिखाइयै ॥",
      "sourceLineId": "136897",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹੋ ਨਾਤਰ ਤ੍ਰਿਯ ਕੇ ਪਾਇਨ ਸੀਸ ਝੁਕਾਇਯੈ ॥੧੪॥",
      "transliteration": "ho naatar tiray ke pain sees jhukaiyai ||14||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ (ਇਸ) ਇਸਤਰੀ ਦੇ ਪੈਰਾ ਉਤੇ ਸੀਸ ਝੁਕਾਓ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "हो नातर तृय के पाइन सीस झुकाइयै ॥१४॥",
      "sourceLineId": "136898",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗ੍ਰਿਹ ਖੁਦਾਇ ਕੈ ਤੇ ਕਛੁ ਹਮਹਿ ਦਿਖਾਇਯੈ ॥",
      "transliteration": "gireh khudhai kai te kachh hameh dhikhaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ੁਦਾ ਦੇ ਘਰ ਤੋਂ ਸਾਨੂੰ ਕੁਝ ਵਿਖਾਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "गृह खुदाइ कै ते कछु हमहि दिखाइयै ॥",
      "sourceLineId": "136899",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਤਰ ਇਨ ਸੇਖਨ ਕੋ ਮੂੰਡ ਮੁੰਡਾਇਯੈ ॥",
      "transliteration": "naatar in sekhan ko moo(n)dd mu(n)ddaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਇਨ੍ਰਹਾ ਸ਼ੇਖਾ ਦੇ ਸਿਰ ਮੁੰਨ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "नातर इन सेखन को मूँड मुँडाइयै ॥",
      "sourceLineId": "136900",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਰਾਮਾਤ ਬਿਨੁ ਲਖੇ ਨ ਮਿਸ੍ਰਨ ਛੋਰਿ ਹੋ ॥",
      "transliteration": "karaamaat bin lakhe na misran chhor ho ||",
      "translation": "",
      "punjabiViakhya": "ਕਰਾਮਾਤ ਵੇਖੇ ਬਿਨਾ ਹੇ ਮਿਸ਼ਰੋ (ਤੁਹਾਨੂੰ ਵੀ) ਨਹੀਂ ਛਡਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "करामात बिनु लखे न मिस्रन छोरि हो ॥",
      "sourceLineId": "136901",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹੋ ਨਾਤਰ ਤੁਮਰੇ ਠਾਕੁਰ ਨਦਿ ਮਹਿ ਬੋਰਿ ਹੋ ॥੧੫॥",
      "transliteration": "ho naatar tumare Thaakur nadh meh bor ho ||15||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਤੁਹਾਡੇ ਠਾਕੁਰ ਨਦੀ ਵਿਚ ਡਬੋ ਦਿਆਂਗਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "हो नातर तुमरे ठाकुर नदि महि बोरि हो ॥१५॥",
      "sourceLineId": "136902",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਰਾਮਾਤ ਕਛੁ ਹਮਹਿ ਸੰਨ੍ਯਾਸੀ ਦੀਜਿਯੈ ॥",
      "transliteration": "karaamaat kachh hameh sa(n)nayaasee dheejiyai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸੰਨਿਆਸੀਓ! ਮੈਨੂੰ ਕੋਈ ਕਰਮਾਤ ਵਿਖਾਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "करामात कछु हमहि संन्यासी दीजियै ॥",
      "sourceLineId": "136903",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਤਰ ਅਪਨੀ ਦੂਰਿ ਜਟਨ ਕੋ ਕੀਜਿਯੈ ॥",
      "transliteration": "naatar apanee dhoor jaTan ko keejiyai ||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਆਪਣੀਆਂ ਜਟਾਵਾ ਨੂੰ ਦੂਰ ਕਰ ਦਿਓ (ਭਾਵ ਮੁੰਨ ਦਿਓ)।",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "नातर अपनी दूरि जटन को कीजियै ॥",
      "sourceLineId": "136904",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚਮਤਕਾਰ ਮੁੰਡਿਯੋ ਅਬ ਹਮਹਿ ਦਿਖਾਇਯੈ ॥",
      "transliteration": "chamatakaar mu(n)ddiyo ab hameh dhikhaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮੁੰਡੀਓ! ਹੁਣ ਮੈਨੂੰ ਚਮਤਕਾਰ ਵਿਖਾਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1325,
      "hindi": "",
      "hindiTransliteration": "चमतकार मुँडियो अब हमहि दिखाइयै ॥",
      "sourceLineId": "136905",
      "sourceShabadId": "12683",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1325_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹੋ ਨਾਤਰ ਅਪਨੀ ਕੰਠੀ ਨਦੀ ਬਹਾਇਯੈ ॥੧੬॥",
      "transliteration": "ho naatar apanee ka(n)Thee nadhee bahaiyai ||16||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਆਪਣੀਆਂ ਕੰਠੀਆਂ ਨਦੀ ਵਿਚ ਰੋੜ੍ਰਹ ਦਿਓ ॥੧੬॥",
      "source": "DASAM_GRANTH",
