{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1326,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1326_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "136907",
      "sourceShabadId": "12684",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰੋਦਨ ਵੈ ਕਰਤੇ ਭਏ ਕਿਸੂ ਨ ਆਈ ਬਾਤ ॥",
      "transliteration": "rodhan vai karate bhe kisoo na aaiee baat ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ (ਸਾਰੇ) ਰੋਣ ਲਗੇ ਅਤੇ ਕਿਸੇ ਦੇ (ਮੂੰਹ ਵਿਚੋਂ) ਕੋਈ ਗੱਲ ਨਾ ਨਿਕਲੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "रोदन वै करते भए किसू न आई बात ॥",
      "sourceLineId": "136908",
      "sourceShabadId": "12684",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਬ ਰਾਜੈ ਤਿਹ ਨਾਰਿ ਕੌ ਬਚਨ ਕਹਾ ਮੁਸਕਾਤ ॥੧੭॥",
      "transliteration": "tab raajai teh naar kau bachan kahaa musakaat ||17||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਉਸ ਇਸਤਰੀ ਨੂੰ ਹਸਦੇ ਹੋਇਆਂ (ਇਹ) ਗੱਲ ਕਹੀ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "तब राजै तिह नारि कौ बचन कहा मुसकात ॥१७॥",
      "sourceLineId": "136909",
      "sourceShabadId": "12684",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136910",
      "sourceShabadId": "12685",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਰਾਮਾਤ ਇਨ ਕਛੁ ਨ ਦਿਖਾਈ ॥",
      "transliteration": "karaamaat in kachh na dhikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਲੋਕਾ ਨੇ ਕੁਝ ਵੀ ਕਰਾਮਾਤ ਨਹੀਂ ਵਿਖਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "करामात इन कछु न दिखाई ॥",
      "sourceLineId": "136911",
      "sourceShabadId": "12685",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਬ ਚਾਹਤ ਹੈ ਤੁਮ ਤੇ ਪਾਈ ॥",
      "transliteration": "ab chaahat hai tum te paiee ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ (ਮੈਂ) ਚਾਹੁੰਦਾ ਹਾ, ਤੇਰੇ ਤੋਂ ਕੁਝ (ਕਰਾਮਾਤ) ਪ੍ਰਾਪਤ ਕਰਾ (ਅਰਥਾਤ-ਵੇਖਾ)",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "अब चाहत है तुम ते पाई ॥",
      "sourceLineId": "136912",
      "sourceShabadId": "12685",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਚਨ ਹਿੰਗੁਲਾ ਦੇਇ ਉਚਾਰੇ ॥",
      "transliteration": "bachan hi(n)gulaa dhei uchaare ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਹਿੰਗਲਾ ਦੇਵੀ ਨੇ ਕਿਹਾ ਕਿ",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "बचन हिंगुला देइ उचारे ॥",
      "sourceLineId": "136913",
      "sourceShabadId": "12685",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁਨੋ ਨਰਾਧਿਪ ਬੈਨ ਹਮਾਰੇ ॥੧੮॥",
      "transliteration": "suno naraadhip bain hamaare ||18||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਮੇਰੀ ਗੱਲ ਸੁਣੋ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "सुनो नराधिप बैन हमारे ॥१८॥",
      "sourceLineId": "136914",
      "sourceShabadId": "12685",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "136915",
      "sourceShabadId": "12686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਰਾਮਾਤਿ ਇਕ ਅਸਿ ਮੌ ਪ੍ਰਥਮ ਪਛਾਨਿਯੈ ॥",
      "transliteration": "karaamaat ik as mau pratham pachhaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਇਕ ਕਰਾਮਾਤ ਤਾ ਤਲਵਾਰ ਵਿਚ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "करामाति इक असि मौ प्रथम पछानियै ॥",
      "sourceLineId": "136916",
      "sourceShabadId": "12686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਾ ਕੌ ਤੇਜੁ ਅਰੁ ਤ੍ਰਾਸ ਜਗਤ ਮੌ ਮਾਨਿਯੈ ॥",
      "transliteration": "jaa kau tej ar traas jagat mau maaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਤੇਜ ਅਤੇ ਭੈ ਸਾਰੇ ਸੰਸਾਰ ਵਿਚ ਮੰਨਿਆ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "जा कौ तेजु अरु त्रास जगत मौ मानियै ॥",
      "sourceLineId": "136917",
      "sourceShabadId": "12686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੀਤ ਹਾਰ ਅਰੁ ਮ੍ਰਿਤੁ ਧਾਰ ਜਾ ਕੀ ਬਸਤ ॥",
      "transliteration": "jeet haar ar mrit dhaar jaa kee basat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤ, ਹਾਰ ਅਤੇ ਮ੍ਰਿਤੂ ਜਿਸ ਦੀ ਧਾਰ ਵਿਚ ਵਸਦੀਆਂ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "जीत हार अरु मृतु धार जा की बसत ॥",
      "sourceLineId": "136918",
      "sourceShabadId": "12686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹੋ ਮੇਰੇ ਮਨ ਪਰਮੇਸੁਰ ਤਾਹੀ ਕੌ ਕਹਤ ॥੧੯॥",
      "transliteration": "ho mere man paramesur taahee kau kahat ||19||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰਾ ਮਨ ਉਸੇ ਨੂੰ ਪਰਮੇਸਰ ਕਹਿੰਦਾ ਹੈ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "हो मेरे मन परमेसुर ताही कौ कहत ॥१९॥",
      "sourceLineId": "136919",
      "sourceShabadId": "12686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੁਤਿਯ ਕਾਲ ਮੌ ਕਰਾਮਾਤਿ ਪਹਿਚਾਨਿਯਤ ॥",
      "transliteration": "dhutiy kaal mau karaamaat pahichaaniyat ||",
      "translation": "",
      "punjabiViakhya": "(ਸੰਸਾਰ ਵਿਚ) ਦੂਜੀ ਕਰਾਮਾਤ ਕਾਲ ਵਿਚ ਸਮਝੋ",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "दुतिय काल मौ करामाति पहिचानियत ॥",
      "sourceLineId": "136920",
      "sourceShabadId": "12686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਨ ਕੋ ਚੌਦਹ ਲੋਕ ਚਕ੍ਰ ਕਰ ਮਾਨਿਯਤ ॥",
      "transliteration": "jin ko chauadheh lok chakr kar maaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਚਕ੍ਰ ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਚਲਦਾ ਮੰਨਿਆ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "जिन को चौदह लोक चक्र कर मानियत ॥",
      "sourceLineId": "136921",
      "sourceShabadId": "12686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਾਲ ਪਾਇ ਜਗ ਹੋਤ ਕਾਲ ਮਿਟ ਜਾਵਈ ॥",
      "transliteration": "kaal pai jag hot kaal miT jaaviee ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਕਰ ਕੇ ਜਗਤ ਹੋਂਦ ਵਿਚ ਆਉਾਂਦਾ ਹੈ ਕਾਲ ਕਰ ਕੇ ਖ਼ਤਮ ਹੋ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "काल पाइ जग होत काल मिट जावई ॥",
      "sourceLineId": "136922",
      "sourceShabadId": "12686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹੋ ਯਾ ਤੇ ਮੁਰ ਮਨ ਤਾਹਿ ਗੁਰੂ ਠਹਰਾਵਈ ॥੨੦॥",
      "transliteration": "ho yaa te mur man taeh guroo Thaharaaviee ||20||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੇਰਾ ਮਨ ਕਾਲ ਨੂੰ ਹੀ ਗੁਰੂ ਮੰਨਦਾ ਹੈ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "हो या ते मुर मन ताहि गुरू ठहरावई ॥२०॥",
      "sourceLineId": "136923",
      "sourceShabadId": "12686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਰਾਮਾਤ ਰਾਜਾ ਰਸਨਾਗ੍ਰਜ ਜਾਨਿਯਤ ॥",
      "transliteration": "karaamaat raajaa rasanaagraj jaaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! (ਤੀਜੀ) ਕਰਾਮਾਤ ਜ਼ਬਾਨ ਦਾ ਅਗਲਾ ਭਾਗ ਜਾਣੋ",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "करामात राजा रसनाग्रज जानियत ॥",
      "sourceLineId": "136924",
      "sourceShabadId": "12686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਲੋ ਬਰੋ ਜਾ ਤੇ ਜਗ ਹੋਤ ਪਛਾਨਿਯਤ ॥",
      "transliteration": "bhalo baro jaa te jag hot pachhaaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ ਜਗਤ ਵਿਚ ਚੰਗਾ ਮਾੜਾ ਹੋਣਾ ਸੰਭਵ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "भलो बरो जा ते जग होत पछानियत ॥",
      "sourceLineId": "136925",
      "sourceShabadId": "12686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਰਾਮਾਤਿ ਚੌਥੀ ਧਨ ਭੀਤਰ ਜਾਨਿਯੈ ॥",
      "transliteration": "karaamaat chauathee dhan bheetar jaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਥੀ ਕਰਾਮਾਤ ਧਨ ਵਿਚ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "करामाति चौथी धन भीतर जानियै ॥",
      "sourceLineId": "136926",
      "sourceShabadId": "12686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹੋ ਹੋਤ ਰੰਕ ਤੇ ਰਾਵ ਧਰੋ ਤਿਹ ਮਾਨਿਯੈ ॥੨੧॥",
      "transliteration": "ho hot ra(n)k te raav dharo teh maaniyai ||21||",
      "translation": "",
      "punjabiViakhya": "ਕਿਉਾਂਕਿ ਉਸ ਦੇ ਧਾਰਨ ਕਰਨ ਨਾਲ ਰੰਕ ਰਾਜਾ ਬਣ ਜਾਦਾ ਹੈ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "हो होत रंक ते राव धरो तिह मानियै ॥२१॥",
      "sourceLineId": "136927",
      "sourceShabadId": "12686",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136928",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਰਾਮਾਤ ਇਨ ਮਹਿ ਨਹਿ ਜਾਨਹੁ ॥",
      "transliteration": "karaamaat in meh neh jaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ (ਵਿਅਕਤੀਆਂ) ਵਿਚ ਕੋਈ ਕਰਾਮਾਤ ਨਾ ਮੰਨੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "करामात इन महि नहि जानहु ॥",
      "sourceLineId": "136929",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਏ ਸਭ ਧਨ ਉਪਾਇ ਪਹਿਚਾਨਹੁ ॥",
      "transliteration": "e sabh dhan upai pahichaanahu ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਸਾਰੇ ਧਨ ਦੇ ਉਪਾ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "ए सभ धन उपाइ पहिचानहु ॥",
      "sourceLineId": "136930",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚਮਤਕਾਰ ਇਨ ਮਹਿ ਜੌ ਹੋਈ ॥",
      "transliteration": "chamatakaar in meh jau hoiee ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਇਨ੍ਰਹਾ ਵਿਚ ਚਮਤਕਾਰ ਹੁੰਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "चमतकार इन महि जौ होई ॥",
      "sourceLineId": "136931",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦਰ ਦਰ ਭੀਖ ਨ ਮਾਗੈ ਕੋਈ ॥੨੨॥",
      "transliteration": "dhar dhar bheekh na maagai koiee ||22||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕੋਈ ਵੀ ਦਰ ਦਰ ਭਿਖ ਨਾ ਮੰਗਦਾ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "दर दर भीख न मागै कोई ॥२२॥",
      "sourceLineId": "136932",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੌ ਇਨ ਸਭਹੂੰ ਪ੍ਰਥਮ ਸੰਘਾਰੋ ॥",
      "transliteration": "jau in sabhahoo(n) pratham sa(n)ghaaro ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਇਨ੍ਰਹਾ ਸਾਰਿਆਂ ਨੂੰ ਪਹਿਲਾ ਮਾਰ ਦਿਓ,",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "जौ इन सभहूँ प्रथम संघारो ॥",
      "sourceLineId": "136933",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਿਹ ਪਾਛੇ ਕਛੁ ਮੋਹਿ ਉਚਾਰੋ ॥",
      "transliteration": "teh paachhe kachh moh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਮੈਨੂੰ ਕੁਝ ਕਹਿਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "तिह पाछे कछु मोहि उचारो ॥",
      "sourceLineId": "136934",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਤਿ ਬਾਤ ਹਮ ਤੁਮਹਿ ਸੁਨਾਈ ॥",
      "transliteration": "sat baat ham tumeh sunaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੁਹਾਨੂੰ ਸੱਚੀ ਗੱਲ ਸੁਣਾਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "सति बात हम तुमहि सुनाई ॥",
      "sourceLineId": "136935",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਬ ਸੁ ਕਰੌ ਜੋ ਤੁਮਹਿ ਸੁਹਾਈ ॥੨੩॥",
      "transliteration": "ab su karau jo tumeh suhaiee ||23||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਉਹੀ ਕਰੋ ਜੋ ਤੁਹਾਨੂੰ ਚੰਗੀ ਲਗੇ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "अब सु करौ जो तुमहि सुहाई ॥२३॥",
      "sourceLineId": "136936",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਚਨ ਸੁਨਤ ਰਾਜਾ ਹਰਖਾਨਾ ॥",
      "transliteration": "bachan sunat raajaa harakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀ ਦੇ) ਬੋਲ ਸੁਣ ਕੇ ਰਾਜਾ ਬਹੁਤ ਪ੍ਰਸੰਨ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "बचन सुनत राजा हरखाना ॥",
      "sourceLineId": "136937",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਧਿਕ ਦਿਯੋ ਤਿਹ ਤ੍ਰਿਯ ਕੇ ਦਾਨਾ ॥",
      "transliteration": "adhik dhiyo teh tiray ke dhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਇਸਤਰੀ ਨੂੰ ਬਹੁਤ ਦਾਨ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "अधिक दियो तिह तृय के दाना ॥",
      "sourceLineId": "136938",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਗਤ ਮਾਤ ਤਿਨ ਤ੍ਰਿਯ ਜੁ ਕਹਾਯੋ ॥",
      "transliteration": "jagat maat tin tiray ju kahaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ (ਆਪਣੇ ਆਪ ਨੂੰ) ਜੋ ਜਗਤ ਮਾਤਾ ਅਖਵਾਇਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "जगत मात तिन तृय जु कहायो ॥",
      "sourceLineId": "136939",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਿਹ ਪ੍ਰਸਾਦਿ ਨਿਜ ਪ੍ਰਾਨ ਬਚਾਯੋ ॥੨੪॥",
      "transliteration": "teh prasaadh nij praan bachaayo ||24||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਮਾਤਾ ਦੀ) ਕ੍ਰਿਪਾ ਕਰ ਕੇ ਆਪਣੇ ਪ੍ਰਾਣ ਬਚਾ ਲਏ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "तिह प्रसादि निज प्रान बचायो ॥२४॥",
      "sourceLineId": "136940",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤਿਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੩॥੬੭੬੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau tihatar charitr samaapatam sat subham sat ||373||6760||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦ ਦੇ ੩੭੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੭੩॥੬੭੬੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ तिहतरि चरित्र समापतम सतु सुभम सतु ॥३७३॥६७६०॥अफजूँ॥",
      "sourceLineId": "136941",
      "sourceShabadId": "12687",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "136942",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬੀਜਾ ਪੁਰ ਜਹ ਸਹਿਰ ਭਨਿਜੈ ॥",
      "transliteration": "beejaa pur jeh sahir bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਬੀਜਾ ਪੁਰ ਸ਼ਹਿਰ ਕਿਹਾ ਜਾਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "बीजा पुर जह सहिर भनिजै ॥",
      "sourceLineId": "136943",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਏਦਿਲ ਸਾਹ ਤਹ ਸਾਹ ਕਹਿਜੈ ॥",
      "transliteration": "edhil saeh teh saeh kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਦਾ ਬਾਦਸ਼ਾਹ ਏਦਿਲਸ਼ਾਹ ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "एदिल साह तह साह कहिजै ॥",
      "sourceLineId": "136944",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸ੍ਰੀ ਮਹਤਾਬ ਮਤੀ ਤਿਹ ਕੰਨ੍ਯਾ ॥",
      "transliteration": "sree mahataab matee teh ka(n)nayaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪੁੱਤਰੀ ਦਾ ਨਾ ਮਹਤਾਬ ਮਤੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "स्री महताब मती तिह कंन्या ॥",
      "sourceLineId": "136945",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਿਹ ਸਮ ਉਪਜੀ ਨਾਰਿ ਨ ਅੰਨ੍ਰਯਾ ॥੧॥",
      "transliteration": "jeh sam upajee naar na a(n)nrayaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਕੋਈ ਹੋਰ ਇਸਤਰੀ ਪੈਦਾ ਨਹੀਂ ਹੋਈ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "जिह सम उपजी नारि न अंन्रया ॥१॥",
      "sourceLineId": "136946",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੋਬਨਵੰਤ ਭਈ ਜਬ ਬਾਲਾ ॥",
      "transliteration": "jobanava(n)t bhiee jab baalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬਾਲਿਕਾ ਜਵਾਨ ਹੋ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "जोबनवंत भई जब बाला ॥",
      "sourceLineId": "136947",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਹਾ ਸੁੰਦਰੀ ਨੈਨ ਬਿਸਾਲਾ ॥",
      "transliteration": "mahaa su(n)dharee nain bisaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਵੱਡੀਆਂ ਅੱਖਾ ਵਾਲੀ ਅਤਿ ਸੁੰਦਰ (ਬਣ ਗਈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "महा सुँदरी नैन बिसाला ॥",
      "sourceLineId": "136948",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੋਬਨ ਜੇਬ ਅਧਿਕ ਤਿਹ ਬਾਢੀ ॥",
      "transliteration": "joban jeb adhik teh baaddee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਜੋਬਨ ਅਤੇ ਸੁੰਦਰਤਾ ਇਤਨੀ ਨਿਖਰੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "जोबन जेब अधिक तिह बाढी ॥",
      "sourceLineId": "136949",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਾਨੁਕ ਚੰਦ੍ਰ ਸੂਰ ਮਥਿ ਕਾਢੀ ॥੨॥",
      "transliteration": "jaanuk cha(n)dhr soor math kaaddee ||2||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸੂਰਜ ਅਤੇ ਚੰਦ੍ਰਮਾ ਨੂੰ ਰਿੜਕ ਕੇ ਕਢੀ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "जानुक चंद्र सूर मथि काढी ॥२॥",
      "sourceLineId": "136950",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਹ ਇਕ ਹੁਤੋ ਸਾਹੁ ਕੋ ਪੂਤ ॥",
      "transliteration": "teh ik huto saahu ko poot ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ ਹੁੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "तह इक हुतो साहु को पूत ॥",
      "sourceLineId": "136951",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੂਰਤਿ ਸੀਰਤਿ ਬਿਖੈ ਸਪੂਤ ॥",
      "transliteration": "soorat seerat bikhai sapoot ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸ਼ਕਲ ਅਤੇ ਸੁਭਾ ਵਜੋਂ ਸੁਪੁੱਤਰ ਲਗਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "सूरति सीरति बिखै सपूत ॥",
      "sourceLineId": "136952",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਧੂਮ੍ਰ ਕੇਤੁ ਤਿਹ ਨਾਮ ਭਨਿਜੈ ॥",
      "transliteration": "dhoomr ket teh naam bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਧੂਮ੍ਰ ਕੇਤੁ ਕਿਹਾ ਜਾਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "धूम्र केतु तिह नाम भनिजै ॥",
      "sourceLineId": "136953",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1326_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇੰਦ੍ਰ ਚੰਦ੍ਰ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥੩॥",
      "transliteration": "ei(n)dhr cha(n)dhr paTatar teh dhijai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਉਪਮਾ ਇੰਦਰ ਅਤੇ ਚੰਦ੍ਰਮਾ ਨਾਲ ਦਿੱਤੀ ਜਾਦੀ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1326,
      "hindi": "",
      "hindiTransliteration": "इंद्र चंद्र पटतर तिह दिजै ॥३॥",
      "sourceLineId": "136954",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
