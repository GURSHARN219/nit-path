{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1327,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1327_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬੇਗਮ ਕੀ ਤਾ ਸੌ ਰੁਚਿ ਲਾਗੀ ॥",
      "transliteration": "begam kee taa sau ruch laagee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਲ ਬੇਗਮ ਦੀ ਰੁਚੀ ਲਗ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "बेगम की ता सौ रुचि लागी ॥",
      "sourceLineId": "136955",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾ ਤੇ ਨੀਂਦ ਭੂਖ ਸਭ ਭਾਗੀ ॥",
      "transliteration": "jaa te nee(n)dh bhookh sabh bhaagee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ (ਉਸ ਦੀ) ਨੀਂਦਰ ਅਤੇ ਭੁਖ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "जा ते नींद भूख सभ भागी ॥",
      "sourceLineId": "136956",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੇਖਿ ਗਈ ਜਬ ਤੇ ਤਿਹ ਧਾਮਾ ॥",
      "transliteration": "dhekh giee jab te teh dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਤੋਂ (ਉਹ) ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਘਰ ਗਈ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "देखि गई जब ते तिह धामा ॥",
      "sourceLineId": "136957",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਬ ਤੇ ਔਰ ਸੁਹਾਤ ਨ ਬਾਮਾ ॥੪॥",
      "transliteration": "tab te aauar suhaat na baamaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਦੋਂ ਤੋਂ ਉਸ ਇਸਤਰੀ ਨੂੰ ਹੋਰ ਕੁਝ ਵੀ ਚੰਗਾ ਨਹੀਂ ਲਗ ਰਿਹਾ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "तब ते और सुहात न बामा ॥४॥",
      "sourceLineId": "136958",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਿਤੂ ਜਾਨ ਸਹਚਰੀ ਬੁਲਾਈ ॥",
      "transliteration": "hitoo jaan sahacharee bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਵਿਸ਼ਵਸਤ ਜਾਣ ਕੇ ਦਾਸੀ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "हितू जान सहचरी बुलाई ॥",
      "sourceLineId": "136959",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭੇਦ ਭਾਖਿ ਸਭ ਤਹਾ ਪਠਾਈ ॥",
      "transliteration": "bhedh bhaakh sabh tahaa paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਉਸ ਨੂੰ) ਭੇਦ ਦੀ ਸਾਰੀ ਗੱਲ ਦਸ ਕੇ ਉਥੇ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "भेद भाखि सभ तहा पठाई ॥",
      "sourceLineId": "136960",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਮੈ ਸਾਹ ਸੁਤ ਜੁ ਤੈ ਮਿਲੈ ਹੈ ॥",
      "transliteration": "hamai saeh sut ju tai milai hai ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਇਹ ਵੀ ਕਿਹਾ) ਜੇ ਤੂੰ ਮੈਨੂੰ ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ ਮਿਲਾ ਦੇਵੇਾਂਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "हमै साह सुत जु तै मिलै है ॥",
      "sourceLineId": "136961",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੋ ਧਨ ਮੁਖ ਮੰਗਿ ਹੈਂ ਸੋ ਪੈ ਹੈਂ ॥੫॥",
      "transliteration": "jo dhan mukh ma(n)g hai(n) so pai hai(n) ||5||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਜੋ ਧਨ ਮੁਖੋਂ ਮੰਗੇਾਂਗੀ, ਉਹੀ ਪ੍ਰਾਪਤ ਕਰੇਾਂਗੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "जो धन मुख मंगि हैं सो पै हैं ॥५॥",
      "sourceLineId": "136962",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਖੀ ਪਵਨ ਕੇ ਭੇਸ ਸਿਧਾਈ ॥",
      "transliteration": "sakhee pavan ke bhes sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀ ਪੌਣ ਦੀ ਗਤੀ ਨਾਲ ਚਲੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "सखी पवन के भेस सिधाई ॥",
      "sourceLineId": "136963",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਲਕ ਨ ਬਿਤੀ ਸਾਹ ਕੇ ਆਈ ॥",
      "transliteration": "palak na bitee saeh ke aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਲ ਭਰ ਵੀ ਨਾ ਬੀਤਿਆ ਕਿ ਸ਼ਾਹ ਕੋਲ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "पलक न बिती साह के आई ॥",
      "sourceLineId": "136964",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਾਹ ਪੂਤ ਕਹ ਕਿਯਾ ਪ੍ਰਨਾਮਾ ॥",
      "transliteration": "saeh poot keh kiyaa pranaamaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਨੂੰ ਪ੍ਰਨਾਮ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "साह पूत कह किया प्रनामा ॥",
      "sourceLineId": "136965",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬੈਠੀ ਜਾਇ ਸੁਘਰਿ ਤਿਹ ਧਾਮਾ ॥੬॥",
      "transliteration": "baiThee jai sughar teh dhaamaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਹ ਸੁਘੜ ਉਸ (ਸ਼ਾਹ) ਦੇ ਘਰ ਵਿਚ ਜਾ ਬੈਠੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "बैठी जाइ सुघरि तिह धामा ॥६॥",
      "sourceLineId": "136966",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੁਮਰੋ ਨਾਮ ਕਹਾ ਪਹਿਚਨਿਯਤ ॥",
      "transliteration": "tumaro naam kahaa pahichaniyat ||",
      "translation": "",
      "punjabiViakhya": "(ਪੁੱਛਣ ਲਗੀ) ਤੁਹਾਡਾ ਕੀ ਨਾ ਪਛਾਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "तुमरो नाम कहा पहिचनियत ॥",
      "sourceLineId": "136967",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਵਨ ਦੇਸ ਕੇ ਬਾਸੀ ਜਨਿਯਤ ॥",
      "transliteration": "kavan dhes ke baasee janiyat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਤੁਹਾਨੂੰ) ਕਿਹੜੇ ਦੇਸ ਦੇ ਰਹਿਣ ਵਾਲਾ ਸਮਝਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "कवन देस के बासी जनियत ॥",
      "sourceLineId": "136968",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਕਲ ਬ੍ਰਿਥਾ ਨਿਜ ਪ੍ਰਥਮ ਸੁਨਾਵਹੁ ॥",
      "transliteration": "sakal birathaa nij pratham sunaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਆਪਣੀ ਸਾਰੀ ਬਿਰਥਾ ਦਸੋ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "सकल बृथा निज प्रथम सुनावहु ॥",
      "sourceLineId": "136969",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁਰਿ ਕੁਅਰਿ ਕੀ ਸੇਜ ਸੁਹਾਵਹੁ ॥੭॥",
      "transliteration": "bahur kuar kee sej suhaavahu ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਕੁਮਾਰੀ ਦੀ ਸੇਜ ਦੀ ਸ਼ੋਭਾ ਨੂੰ ਵਧਾਓ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "बहुरि कुअरि की सेज सुहावहु ॥७॥",
      "sourceLineId": "136970",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਨੀ ਸਖੀ ਮਦ੍ਰ ਦੇਸ ਹਮ ਰਹਹੀ ॥",
      "transliteration": "sunee sakhee madhr dhes ham rahahee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਕਹਿਣ ਲਗਾ) ਹੇ ਸਖੀ! ਸੁਣੋ, ਮੈਂ ਮਦ੍ਰ ਦੇਸ ਵਿਚ ਰਹਿੰਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "सुनी सखी मद्र देस हम रहही ॥",
      "sourceLineId": "136971",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਧੂਮ੍ਰ ਕੇਤੁ ਹਮ ਕੌ ਜਨ ਕਹਹੀ ॥",
      "transliteration": "dhoomr ket ham kau jan kahahee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੋਕੀਂ ਮੈਨੂੰ ਧੂਮ੍ਰ ਕੇਤੁ ਕਹਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "धूम्र केतु हम कौ जन कहही ॥",
      "sourceLineId": "136972",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੌਦਾ ਹਿਤ ਆਏ ਇਹ ਦੇਸਾ ॥",
      "transliteration": "sauadhaa hit aae ieh dhesaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੌਦਾਗਰੀ ਕਰਨ ਲਈ (ਮੈਂ) ਇਸ ਦੇਸ ਵਿਚ ਆਇਆ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "सौदा हित आए इह देसा ॥",
      "sourceLineId": "136973",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੇਸ ਦੇਸ ਕੋ ਨਿਰਖਿ ਨਰੇਸਾ ॥੮॥",
      "transliteration": "dhes dhes ko nirakh naresaa ||8||",
      "translation": "",
      "punjabiViakhya": "ਦੇਸ ਦੇਸ ਦੇ ਰਾਜਿਆਂ ਨੂੰ ਵੇਖ ਕੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "देस देस को निरखि नरेसा ॥८॥",
      "sourceLineId": "136974",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਤਿਯਨ ਪ੍ਰਥਮ ਤਾਹਿ ਬਿਰਮਾਇ ॥",
      "transliteration": "batiyan pratham taeh biramai ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਉਸ ਨੂੰ ਗੱਲਾ ਨਾਲ ਰਿਝਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "बतियन प्रथम ताहि बिरमाइ ॥",
      "sourceLineId": "136975",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਿਨ ਲੋਭ ਦਿਖਾਇ ॥",
      "transliteration": "bhaat bhaat tin lobh dhikhai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਭਾਤ ਭਾਤ ਦੇ ਲੋਭ ਦਿਖਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तिन लोभ दिखाइ ॥",
      "sourceLineId": "136976",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜ੍ਯੋਂ ਤ੍ਯੋਂ ਲੈ ਆਈ ਤਿਹ ਤਹਾ ॥",
      "transliteration": "jayo(n) tayo(n) lai aaiee teh tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨੂੰ ਉਥੇ ਲੈ ਆਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "ज्यों त्यों लै आई तिह तहा ॥",
      "sourceLineId": "136977",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਾਰਗ ਕੁਅਰਿ ਬਿਲੋਕਤ ਜਹਾ ॥੯॥",
      "transliteration": "maarag kuar bilokat jahaa ||9||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕੁਮਾਰੀ (ਉਸ ਦਾ) ਰਾਹ ਵੇਖ ਰਹੀ ਸੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "मारग कुअरि बिलोकत जहा ॥९॥",
      "sourceLineId": "136978",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੋ ਧਨ ਕਹਾ ਸੁੰਦ੍ਰ ਤਿਹ ਦੀਨਾ ॥",
      "transliteration": "jo dhan kahaa su(n)dhr teh dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰੀ ਨੇ ਜੋ ਧਨ ਕਿਹਾ ਸੀ, ਦਾਸੀ ਨੂੰ ਦੇ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "जो धन कहा सुँद्र तिह दीना ॥",
      "sourceLineId": "136979",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕੰਠ ਲਗਾਇ ਮਿਤ੍ਰ ਸੋ ਲੀਨਾ ॥",
      "transliteration": "ka(n)Th lagai mitr so leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਮਿਤਰ ਨੂੰ ਗਲੇ ਨਾਲ ਲਗਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "कंठ लगाइ मित्र सो लीना ॥",
      "sourceLineId": "136980",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੀ ਕੈਫ ਮੰਗਾਈ ॥",
      "transliteration": "bhaat bhaat kee kaif ma(n)gaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕਈ ਤਰ੍ਰਹਾ ਦੀ ਸ਼ਰਾਬ ਮੰਗਵਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "भाति भाति की कैफ मंगाई ॥",
      "sourceLineId": "136981",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਏਕ ਖਾਟ ਚੜਿ ਦੁਹੂੰ ਚੜਾਈ ॥੧੦॥",
      "transliteration": "ek khaaT chaR dhuhoo(n) chaRaiee ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਮੰਜੇ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਦੋਹਾ ਨੇ ਪੀਤੀ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "एक खाट चड़ि दुहूँ चड़ाई ॥१०॥",
      "sourceLineId": "136982",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਕੈਫ ਚੜਾਵਹਿ ॥",
      "transliteration": "bhaat bhaat tan kaif chaRaaveh ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੀ ਸ਼ਰਾਬ ਪੀਣ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन कैफ चड़ावहि ॥",
      "sourceLineId": "136983",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਿਲਿ ਮਿਲਿ ਗੀਤ ਮਧੁਰ ਧੁਨਿ ਗਾਵਹਿ ॥",
      "transliteration": "mil mil geet madhur dhun gaaveh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਿਲ ਕੇ ਮਠੀ ਮਠੀ ਧੁੰਨ ਵਿਚ ਗੀਤ ਗਾਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "मिलि मिलि गीत मधुर धुनि गावहि ॥",
      "sourceLineId": "136984",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਿਬਿਧ ਬਿਧਿਨ ਤਨ ਕਰਤ ਬਿਲਾਸਾ ॥",
      "transliteration": "bibidh bidhin tan karat bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕਈ ਤਰ੍ਰਹਾ ਦੀ ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਨ ਲਗ ਗਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "बिबिध बिधिन तन करत बिलासा ॥",
      "sourceLineId": "136985",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨੈਕੁ ਨ ਕਰੈ ਨ੍ਰਿਪਤਿ ਕੋ ਤ੍ਰਾਸਾ ॥੧੧॥",
      "transliteration": "naik na karai nirapat ko traasaa ||11||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਾਜੇ ਦਾ ਡਰ ਬਿਲਕੁਲ ਨਹੀਂ ਮੰਨ ਰਹੇ ਸਨ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "नैकु न करै नृपति को त्रासा ॥११॥",
      "sourceLineId": "136986",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਛੈਲਿਹਿ ਛੈਲ ਨ ਛੋਰਾ ਜਾਈ ॥",
      "transliteration": "chhaileh chhail na chhoraa jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਨੌਜਵਾਨ (ਕੁਮਾਰੀ) ਤੋਂ ਛਬੀਲਾ (ਸ਼ਾਹ) ਛਡਿਆ ਨਹੀਂ ਜਾਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "छैलिहि छैल न छोरा जाई ॥",
      "sourceLineId": "136987",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਿਸੁ ਦਿਨ ਰਾਖਤ ਕੰਠ ਲਗਾਈ ॥",
      "transliteration": "nis dhin raakhat ka(n)Th lagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਤ ਦਿਨ ਉਸ ਨੂੰ ਗਲੇ ਨਾਲ ਲਗਾਈ ਰਖਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "निसु दिन राखत कंठ लगाई ॥",
      "sourceLineId": "136988",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਬ ਕਬਹੂੰ ਆਖੇਟ ਸਿਧਾਵੈ ॥",
      "transliteration": "jab kabahoo(n) aakheT sidhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕਦੇ ਸ਼ਿਕਾਰ ਨੂੰ ਜਾਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "जब कबहूँ आखेट सिधावै ॥",
      "sourceLineId": "136989",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਏਕ ਅੰਬਾਰੀ ਤਾਹਿ ਚੜਾਵੈ ॥੧੨॥",
      "transliteration": "ek a(n)baaree taeh chaRaavai ||12||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਕੋ ਅੰਬਾਰੀ ਵਿਚ ਉਸ ਨੂੰ ਵੀ ਚੜ੍ਰਹਾ ਲੈਂਦੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "एक अंबारी ताहि चड़ावै ॥१२॥",
      "sourceLineId": "136990",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਹੀ ਕਾਮ ਕ੍ਰੀੜਾ ਕਹ ਕਰੈ ॥",
      "transliteration": "tahee kaam kreeRaa keh karai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ (ਬੈਠੇ ਹੋਏ) ਕਾਮ-ਕ੍ਰੀੜਾ ਕਰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "तही काम क्रीड़ा कह करै ॥",
      "sourceLineId": "136991",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਤੇ ਨੈਕੁ ਨ ਡਰੈ ॥",
      "transliteration": "maat pitaa te naik na ddarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਾਤਾ ਪਿਤਾ ਤੋਂ ਜ਼ਰਾ ਜਿੰਨੇ ਵੀ ਨਹੀਂ ਡਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "मात पिता ते नैकु न डरै ॥",
      "sourceLineId": "136992",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਕ ਦਿਨ ਰਾਜਾ ਚੜਾ ਸਿਕਾਰਾ ॥",
      "transliteration": "eik dhin raajaa chaRaa sikaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜਾ ਸ਼ਿਕਾਰ ਚੜ੍ਰਹਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "इक दिन राजा चड़ा सिकारा ॥",
      "sourceLineId": "136993",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੰਗ ਲਏ ਮਿਹਰਿਯੈ ਅਪਾਰਾ ॥੧੩॥",
      "transliteration": "sa(n)g le mihariyai apaaraa ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਾਲ ਬਹੁਤ ਸਾਰੀਆਂ ਦਾਸੀਆਂ ਨੂੰ ਲੈ ਲਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "संग लए मिहरियै अपारा ॥१३॥",
      "sourceLineId": "136994",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬੇਗਮ ਸੋਊ ਸਿਕਾਰ ਸਿਧਾਈ ॥",
      "transliteration": "begam souoo sikaar sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬੇਗਮ ਵੀ ਸ਼ਿਕਾਰ ਖੇਡਣ ਲਈ ਚਲ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "बेगम सोऊ सिकार सिधाई ॥",
      "sourceLineId": "136995",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਏਕ ਅੰਬਾਰੀ ਤਾਹਿ ਚੜਾਈ ॥",
      "transliteration": "ek a(n)baaree taeh chaRaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕੋ ਅੰਬਾਰੀ ਵਿਚ ਉਸ (ਪ੍ਰੇਮੀ) ਨੂੰ ਵੀ ਚੜ੍ਰਹਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "एक अंबारी ताहि चड़ाई ॥",
      "sourceLineId": "136996",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਏਕ ਸਖੀ ਤਿਹ ਚੜਤ ਨਿਹਾਰਾ ॥",
      "transliteration": "ek sakhee teh chaRat nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸਖੀ ਨੇ ਉਸ ਨੂੰ ਚੜ੍ਰਹਦੇ ਹੋਇਆਂ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "एक सखी तिह चड़त निहारा ॥",
      "sourceLineId": "136997",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਾਇ ਭੂਪ ਸੋ ਭੇਦ ਉਚਾਰਾ ॥੧੪॥",
      "transliteration": "jai bhoop so bhedh uchaaraa ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਾ ਕੇ ਰਾਜੇ ਨੂੰ ਸਾਰਾ ਭੇਦ ਦਸਿਆ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "जाइ भूप सो भेद उचारा ॥१४॥",
      "sourceLineId": "136998",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੁਨਿ ਨ੍ਰਿਪ ਬਾਤ ਚਿਤ ਮੋ ਰਾਖੀ ॥",
      "transliteration": "sun nirap baat chit mo raakhee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਗੱਲ ਸੁਣ ਕੇ ਮਨ ਵਿਚ ਰਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "सुनि नृप बात चित मो राखी ॥",
      "sourceLineId": "136999",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਔਰਿ ਨਾਰਿ ਸੋ ਪ੍ਰਗਟ ਨ ਭਾਖੀ ॥",
      "transliteration": "aauar naar so pragaT na bhaakhee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਕਿਸੇ ਇਸਤਰੀ ਨੂੰ ਨਾ ਦਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "औरि नारि सो प्रगट न भाखी ॥",
      "sourceLineId": "137000",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੁਹਿਤਾ ਕੋ ਜਬ ਗਜ ਨਿਕਟਾਯੋ ॥",
      "transliteration": "dhuhitaa ko jab gaj nikaTaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਪੁੱਤਰੀ ਦਾ ਹਾਥੀ ਨੇੜੇ ਆਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "दुहिता को जब गज निकटायो ॥",
      "sourceLineId": "137001",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1327_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਬ ਤਾ ਕੋ ਪਿਤੁ ਨਿਕਟ ਬੁਲਾਯੌ ॥੧੫॥",
      "transliteration": "tab taa ko pit nikaT bulaayau ||15||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਪਿਤਾ ਨੇ ਉਸ ਨੂੰ ਨੇੜੇ ਬੁਲਾਇਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1327,
      "hindi": "",
      "hindiTransliteration": "तब ता को पितु निकट बुलायौ ॥१५॥",
      "sourceLineId": "137002",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
