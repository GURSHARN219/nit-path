{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1328,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1328_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁਨਤ ਬੈਨ ਬੇਗਮ ਡਰਪਾਨੀ ॥",
      "transliteration": "sunat bain begam ddarapaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਦੀ) ਗੱਲ ਸੁਣ ਕੇ ਬੇਗਮ ਡਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "सुनत बैन बेगम डरपानी ॥",
      "sourceLineId": "137003",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਥਰਹਰ ਕੰਪਾ ਮਿਤ੍ਰ ਤਿਹ ਮਾਨੀ ॥",
      "transliteration": "tharahar ka(n)paa mitr teh maanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦਾ ਮਾਣ ਮਤਾ ਮਿਤਰ ਵੀ ਥਰਥਰ ਕੰਬਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "थरहर कंपा मित्र तिह मानी ॥",
      "sourceLineId": "137004",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਬ ਹੀ ਮੁਝੈ ਭੂਪ ਗਹਿ ਲੈ ਹੈ ॥",
      "transliteration": "ab hee mujhai bhoop geh lai hai ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗਾ) ਮੈਨੂੰ ਹੁਣੇ ਰਾਜਾ ਪਕੜ ਲਵੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "अब ही मुझै भूप गहि लै है ॥",
      "sourceLineId": "137005",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਸੀ ਬਨ ਬਿਖੈ ਮਾਰਿ ਚੁਕੈ ਹੈ ॥੧੬॥",
      "transliteration": "eisee ban bikhai maar chukai hai ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸੇ ਜੰਗਲ ਵਿਚ ਮਾਰ ਮੁਕਾਏਗਾ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "इसी बन बिखै मारि चुकै है ॥१६॥",
      "sourceLineId": "137006",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਰਿ ਕਹੀ ਪਿਯ ਜਿਨ ਜਿਯ ਡਰੋ ॥",
      "transliteration": "naar kahee piy jin jiy ddaro ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਪ੍ਰੇਮੀ ਨੂੰ ਕਿਹਾ, (ਤੁਸੀਂ) ਮਨ ਵਿਚ ਨਾ ਡਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "नारि कही पिय जिन जिय डरो ॥",
      "sourceLineId": "137007",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਹੌ ਚਰਿਤ੍ਰ ਤੁਮੈ ਸੋ ਕਰੋ ॥",
      "transliteration": "kahau charitr tumai so karo ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਚਰਿਤ੍ਰ (ਮੈਂ) ਤੁਹਾਨੂੰ ਕਹਿੰਦੀ ਹਾ, ਉਹੀ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "कहौ चरित्र तुमै सो करो ॥",
      "sourceLineId": "137008",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਰੀ ਰੂਖ ਕੇ ਤਰੈ ਨਿਕਾਰਾ ॥",
      "transliteration": "karee rookh ke tarai nikaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਹਾਥੀ ਨੂੰ ਇਕ ਬ੍ਰਿਛ ਦੇ ਹੇਠੋਂ ਕਢਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "करी रूख के तरै निकारा ॥",
      "sourceLineId": "137009",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਲਪਟਿ ਰਹਾ ਤਾ ਸੌ ਤਹ ਯਾਰਾ ॥੧੭॥",
      "transliteration": "lapaT rahaa taa sau teh yaaraa ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦਾ ਯਾਰ ਉਸ (ਬ੍ਰਿਛ) ਨਾਲ ਲਿਪਟ ਗਿਆ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "लपटि रहा ता सौ तह यारा ॥१७॥",
      "sourceLineId": "137010",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਪੁ ਪਿਤਾ ਪ੍ਰਤਿ ਕਿਯਾ ਪਯਾਨਾ ॥",
      "transliteration": "aap pitaa prat kiyaa payaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਪ ਪਿਤਾ ਕੋਲ ਆ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "आपु पिता प्रति किया पयाना ॥",
      "sourceLineId": "137011",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਾਰੇ ਰੀਛ ਰੋਝ ਮ੍ਰਿਗ ਨਾਨਾ ॥",
      "transliteration": "maare reechh rojh mirag naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਸ਼ਿਕਾਰ ਵਿਚ) ਬਹੁਤ ਸਾਰੇ ਰਿਛ, ਰੋਝ ਅਤੇ ਹਿਰਨ ਮਾਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "मारे रीछ रोझ मृग नाना ॥",
      "sourceLineId": "137012",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾਹਿ ਬਿਲੋਕਿ ਪਿਤਾ ਚੁਪ ਰਹਾ ॥",
      "transliteration": "taeh bilok pitaa chup rahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਰਾਜਾ ਚੁਪ ਰਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "ताहि बिलोकि पिता चुप रहा ॥",
      "sourceLineId": "137013",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਝੂਠ ਲਖਾ ਤਿਹ ਤ੍ਰਿਯ ਮੁਹਿ ਕਹਾ ॥੧੮॥",
      "transliteration": "jhooTh lakhaa teh tiray muh kahaa ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦਾਸੀ ਨੇ ਜੋ ਮੈਨੂੰ ਕਿਹਾ ਸੀ, ਉਸ ਨੂੰ ਝੂਠ ਸਮਝਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "झूठ लखा तिह तृय मुहि कहा ॥१८॥",
      "sourceLineId": "137014",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਉਸੀ ਸਖੀ ਕੋ ਪਲਟਿ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "ausee sakhee ko palaT prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਲਟਾ ਉਸੇ ਸਖੀ ਨੂੰ (ਰਾਜੇ ਨੇ) ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "उसी सखी को पलटि प्रहारा ॥",
      "sourceLineId": "137015",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਝੂਠ ਬਚਨ ਇਨ ਮੁਝੈ ਉਚਾਰਾ ॥",
      "transliteration": "jhooTh bachan in mujhai uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਨੇ ਮੈਨੂੰ ਝੂਠੀ ਗੱਲ ਕਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "झूठ बचन इन मुझै उचारा ॥",
      "sourceLineId": "137016",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਖੇਲਿ ਅਖੇਟ ਭੂਪ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "transliteration": "khel akheT bhoop gireh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਸ਼ਿਕਾਰ ਖੇਡ ਕੇ ਘਰ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "खेलि अखेट भूप गृह आयो ॥",
      "sourceLineId": "137017",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਿਸੀ ਬਿਰਛ ਤਰ ਕਰੀ ਲਖਾਯੋ ॥੧੯॥",
      "transliteration": "tisee birachh tar karee lakhaayo ||19||",
      "translation": "",
      "punjabiViakhya": "(ਕੁਮਾਰੀ ਨੇ) ਉਸੇ ਬ੍ਰਿਛ ਹੇਠੋਂ ਹਾਥੀ ਨੂੰ ਲੰਘਾਇਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "तिसी बिरछ तर करी लखायो ॥१९॥",
      "sourceLineId": "137018",
      "sourceShabadId": "12688",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "137019",
      "sourceShabadId": "12689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਕਰਿ ਭੁਜਾ ਗਜ ਪਰ ਪਿਯ ਲਯੋ ਚੜਾਇ ਕੈ ॥",
      "transliteration": "pakar bhujaa gaj par piy layo chaRai kai ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਹ ਪਕੜ ਕੇ ਉਸ ਨੇ ਪ੍ਰੀਤਮ ਨੂੰ ਹਾਥੀ ਉਤੇ ਚੜ੍ਰਹਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "पकरि भुजा गज पर पिय लयो चड़ाइ कै ॥",
      "sourceLineId": "137020",
      "sourceShabadId": "12689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭੋਗ ਅੰਬਾਰੀ ਬੀਚ ਕਰੇ ਸੁਖ ਪਾਇ ਕੈ ॥",
      "transliteration": "bhog a(n)baaree beech kare sukh pai kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੰਬਾਰੀ ਵਿਚ ਸੁਖ ਪੂਰਵਕ ਸੰਯੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "भोग अंबारी बीच करे सुख पाइ कै ॥",
      "sourceLineId": "137021",
      "sourceShabadId": "12689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਲਪਟਿ ਲਪਟਿ ਦੋਊ ਕੇਲ ਕਰਤ ਮੁਸਕਾਇ ਕਰਿ ॥",
      "transliteration": "lapaT lapaT dhouoo kel karat musakai kar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦੋਵੇਾਂ ਲਿਪਟ ਲਿਪਟ ਕੇ ਮੁਸਕਰਾਉਾਂਦੇ ਹੋਏ ਰਤੀਕ੍ਰੀੜਾ ਕਰ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "लपटि लपटि दोऊ केल करत मुसकाइ करि ॥",
      "sourceLineId": "137022",
      "sourceShabadId": "12689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹੋ ਹਮਰੌ ਭੂਪਤਿ ਭੇਦ ਨ ਸਕਿਯੋ ਪਾਇ ਕਰਿ ॥੨੦॥",
      "transliteration": "ho hamarau bhoopat bhedh na sakiyo pai kar ||20||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਸੋਚ ਰਹੇ ਸਨ ਕਿ) ਰਾਜਾ ਸਾਡੇ ਭੇਦ ਨੂੰ ਨਹੀਂ ਪਾ ਸਕਿਆ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "हो हमरौ भूपति भेद न सकियो पाइ करि ॥२०॥",
      "sourceLineId": "137023",
      "sourceShabadId": "12689",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137024",
      "sourceShabadId": "12690",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਹਿਲੇ ਰੂਖ ਚੜਾਇ ਤਿਹ ਲੈ ਆਈ ਫਿਰਿ ਧਾਮ ॥",
      "transliteration": "pahile rookh chaRai teh lai aaiee fir dhaam ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਉਸ ਨੂੰ ਬ੍ਰਿਛ ਉਤੇ ਚੜ੍ਰਹਾਇਆ ਅਤੇ ਫਿਰ ਘਰ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "पहिले रूख चड़ाइ तिह लै आई फिरि धाम ॥",
      "sourceLineId": "137025",
      "sourceShabadId": "12690",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਉਲਟਾ ਤਿਹ ਝੂਠਾ ਕਿਯਾ ਭੇਦ ਦਿਯਾ ਜਿਹ ਬਾਮ ॥੨੧॥",
      "transliteration": "aulaTaa teh jhooThaa kiyaa bhedh dhiyaa jeh baam ||21||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾਸੀ ਨੇ ਭੇਦ ਦਸਿਆ, ਉਸੇ ਨੂੰ ਉਲਟਾ ਝੂਠਾ ਠਹਿਰਾਇਆ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "उलटा तिह झूठा किया भेद दिया जिह बाम ॥२१॥",
      "sourceLineId": "137026",
      "sourceShabadId": "12690",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚੁਹਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੪॥੬੭੮੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chuhatar charitr samaapatam sat subham sat ||374||6781||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੭੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੭੪॥੬੭੮੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ चुहतर चरित्र समापतम सतु सुभम सतु ॥३७४॥६७८१॥अफजूँ॥",
      "sourceLineId": "137027",
      "sourceShabadId": "12690",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137028",
      "sourceShabadId": "12691",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਸਕ ਤੰਬੋਲ ਸਹਿਰ ਹੈ ਜਹਾ ॥",
      "transliteration": "eisak ta(n)bol sahir hai jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਇਸਕ ਤੰਬੋਲ ਨਾ ਦਾ ਨਗਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "इसक तंबोल सहिर है जहा ॥",
      "sourceLineId": "137029",
      "sourceShabadId": "12691",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਸਕ ਤੰਬੋਲ ਨਰਾਧਿਪ ਤਹਾ ॥",
      "transliteration": "eisak ta(n)bol naraadhip tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਸਕ ਤੰਬੋਲ ਨਾ ਦਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "इसक तंबोल नराधिप तहा ॥",
      "sourceLineId": "137030",
      "sourceShabadId": "12691",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸ੍ਰੀ ਸਿੰਗਾਰ ਮਤੀ ਤਿਹ ਦਾਰਾ ॥",
      "transliteration": "sree si(n)gaar matee teh dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸ਼ਿਗਾਰ ਮਤੀ ਨਾ ਦੀ ਪਤਨੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "स्री सिंगार मती तिह दारा ॥",
      "sourceLineId": "137031",
      "sourceShabadId": "12691",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਾ ਸੀ ਘੜੀ ਨ ਬ੍ਰਹਮੁ ਸੁ ਨਾਰਾ ॥੧॥",
      "transliteration": "jaa see ghaRee na brahamu su naaraa ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਸੁੰਦਰ ਬ੍ਰਹਮਾ ਨੇ ਹੋਰ ਕੋਈ ਇਸਤਰੀ ਨਹੀਂ ਬਣਾਈ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "जा सी घड़ी न ब्रहमु सु नारा ॥१॥",
      "sourceLineId": "137032",
      "sourceShabadId": "12691",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "137033",
      "sourceShabadId": "12692",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸ੍ਰੀ ਜਗ ਜੋਬਨ ਦੇ ਤਿਹ ਸੁਤਾ ਬਖਾਨਿਯੈ ॥",
      "transliteration": "sree jag joban dhe teh sutaa bakhaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪੁੱਤਰੀ ਨੂੰ ਜਗ ਜੋਬਨ ਦੇ (ਦੇਈ) ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "स्री जग जोबन दे तिह सुता बखानियै ॥",
      "sourceLineId": "137034",
      "sourceShabadId": "12692",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੁਤਿਯ ਰੂਪ ਕੀ ਰਾਸ ਜਗਤ ਮਹਿ ਜਾਨਿਯੈ ॥",
      "transliteration": "dhutiy roop kee raas jagat meh jaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਗਤ ਵਿਚ ਰੂਪ ਦੀ ਦੂਜੀ ਰਾਸ ਜਾਣਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "दुतिय रूप की रास जगत महि जानियै ॥",
      "sourceLineId": "137035",
      "sourceShabadId": "12692",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਧਿਕ ਪ੍ਰਭਾ ਜਲ ਥਲ ਮਹਿ ਜਾ ਕੀ ਜਾਨਿਯਤ ॥",
      "transliteration": "adhik prabhaa jal thal meh jaa kee jaaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਜਲ ਥਲ ਵਿਚ ਬਹੁਤ ਪ੍ਰਭਾ ਜਾਣੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "अधिक प्रभा जल थल महि जा की जानियत ॥",
      "sourceLineId": "137036",
      "sourceShabadId": "12692",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹੋ ਨਰੀ ਨਾਗਨੀ ਨਾਰਿ ਨ ਵੈਸੀ ਮਾਨਿਯਤ ॥੨॥",
      "transliteration": "ho naree naaganee naar na vaisee maaniyat ||2||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਨਰੀ ਜਾ ਨਾਗਣ ਉਸ ਵਰਗੀ ਨਹੀਂ ਮੰਨੀ ਜਾਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "हो नरी नागनी नारि न वैसी मानियत ॥२॥",
      "sourceLineId": "137037",
      "sourceShabadId": "12692",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137038",
      "sourceShabadId": "12693",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਹ ਇਕ ਪੂਤ ਸਰਾਫ ਕੋ ਤਾ ਕੋ ਰੂਪ ਅਪਾਰ ॥",
      "transliteration": "teh ik poot saraaf ko taa ko roop apaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸਰਾਫ਼ ਦਾ ਪੁੱਤਰ ਸੀ ਜੋ ਬਹੁਤ ਹੀ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "तह इक पूत सराफ को ता को रूप अपार ॥",
      "sourceLineId": "137039",
      "sourceShabadId": "12693",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੋਰਿ ਨੈਨਿ ਨਾਰੀ ਰਹੈ ਜਾਨਿ ਨ ਗ੍ਰਿਹ ਬਿਸੰਭਾਰ ॥੩॥",
      "transliteration": "jor nain naaree rahai jaan na gireh bisa(n)bhaar ||3||",
      "translation": "",
      "punjabiViakhya": "ਜੇ (ਉਸ ਨਾਲ) ਕੋਈ ਇਸਤਰੀ ਨੈਣ ਜੋੜ ਲੈਂਦੀ ਤਾ ਬੇਸੁਧ ਹੋ ਕੇ ਘਰ ਜਾਣ ਯੋਗ ਨਾ ਰਹਿੰਦੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "जोरि नैनि नारी रहै जानि न गृह बिसंभार ॥३॥",
      "sourceLineId": "137040",
      "sourceShabadId": "12693",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137041",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਤਾ ਕੀ ਛਬਿ ਲਹੀ ॥",
      "transliteration": "raaj sutaa taa kee chhab lahee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ (ਇਕ ਵਾਰ) ਉਸ ਦੀ ਛਬੀ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "राज सुता ता की छबि लही ॥",
      "sourceLineId": "137042",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਨ ਬਚ ਕ੍ਰਮ ਮਨ ਮੈ ਅਸ ਕਹੀ ॥",
      "transliteration": "man bach kram man mai as kahee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਨ, ਬਚਨ ਤੇ ਕਰਮ ਕਰ ਕੇ ਮਨ ਵਿਚ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "मन बच क्रम मन मै अस कही ॥",
      "sourceLineId": "137043",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਏਕ ਬਾਰ ਗਹਿ ਯਾਹਿ ਮੰਗਾਊ ॥",
      "transliteration": "ek baar geh yaeh ma(n)gaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਇਸ ਨੂੰ ਇਕ ਵਾਰ ਪਕੜ ਕੇ ਘਰ ਮੰਗਵਾ ਲਵਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "एक बार गहि याहि मंगाऊ ॥",
      "sourceLineId": "137044",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਰੁਚਿ ਮਾਨ ਮਚਾਊ ॥੪॥",
      "transliteration": "kaam bhog ruch maan machaauoo ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰੁਚੀ ਪੂਰਵਕ ਇਸ ਨਾਲ ਰਮਣ ਕਰਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "काम भोग रुचि मान मचाऊ ॥४॥",
      "sourceLineId": "137045",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਦਈ ਤਹਾ ਇਕ ॥",
      "transliteration": "paThai sahacharee dhiee tahaa ik ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਇਕ ਦਾਸੀ ਨੂੰ ਸਾਰੀ ਗੱਲ",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी दई तहा इक ॥",
      "sourceLineId": "137046",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਾਹਿ ਬਾਤ ਸਮੁਝਾਇ ਅਨਿਕ ਨਿਕ ॥",
      "transliteration": "taeh baat samujhai anik nik ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਸਮਝਾ ਕੇ ਉਸ ਪਾਸ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "ताहि बात समुझाइ अनिक निक ॥",
      "sourceLineId": "137047",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਮਿਤ ਦਰਬ ਦੈ ਤਾਹਿ ਭੁਲਾਈ ॥",
      "transliteration": "amit dharab dhai taeh bhulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬਹੁਤ ਧਨ ਦੇ ਕੇ (ਨਿਰਧਨਤਾ) ਭੁਲਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "अमित दरब दै ताहि भुलाई ॥",
      "sourceLineId": "137048",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਭਾਤਿ ਕੁਅਰਿ ਕੌ ਲਿਆਈ ॥੫॥",
      "transliteration": "jeh teh bhaat kuar kau liaaiee ||5||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਕੁਮਾਰ ਨੂੰ ਲੈ ਆਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "जिह तिह भाति कुअरि कौ लिआई ॥५॥",
      "sourceLineId": "137049",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1328_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਕਰਤ ਬਿਲਾਸਾ ॥",
      "transliteration": "bhaat bhaat ke karat bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਵੀ ਬੰਦੇ ਦਾ ਡਰ ਮੰਨੇ ਬਿਨਾ",
      "source": "DASAM_GRANTH",
      "ang": 1328,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के करत बिलासा ॥",
