{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1329,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1329_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਾਨਤ ਕਿਸੀ ਨ ਨਰ ਕੋ ਤ੍ਰਾਸਾ ॥",
      "transliteration": "maanat kisee na nar ko traasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਉਸ ਨਾਲ) ਭਾਤ ਭਾਤ ਦੀ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "मानत किसी न नर को त्रासा ॥",
      "sourceLineId": "137051",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਬ ਲਗ ਆਇ ਪਿਤਾ ਤਹ ਗਯੋ ॥",
      "transliteration": "tab lag aai pitaa teh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਉਸ ਦਾ ਪਿਤਾ ਉਥੇ ਆ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "तब लग आइ पिता तह गयो ॥",
      "sourceLineId": "137052",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਧਿਕ ਬਿਮਨ ਤਾ ਕੋ ਮਨ ਭਯੋ ॥੬॥",
      "transliteration": "adhik biman taa ko man bhayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ (ਕੁਮਾਰੀ) ਦਾ ਮਨ ਬਹੁਤ ਉਦਾਸ ਹੋ ਗਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "अधिक बिमन ता को मन भयो ॥६॥",
      "sourceLineId": "137053",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਵਰ ਘਾਤ ਤਬ ਹਾਥ ਨ ਆਈ ॥",
      "transliteration": "avar ghaat tab haath na aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਦੋਂ ਉਸ ਨੂੰ ਹੋਰ ਕੋਈ ਦਾਓ ਨਾ ਸੁਝਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "अवर घात तब हाथ न आई ॥",
      "sourceLineId": "137054",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਏਕ ਬਾਤ ਤਬ ਤਾਹਿ ਬਨਾਈ ॥",
      "transliteration": "ek baat tab taeh banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਨੂੰ ਇਕ ਗੱਲ ਸੁਝੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "एक बात तब ताहि बनाई ॥",
      "sourceLineId": "137055",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬੀਚ ਸਮ੍ਰਯਾਨਾ ਕੇ ਤਿਹ ਸੀਆ ॥",
      "transliteration": "beech samrayaanaa ke teh seeaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸ਼ਾਮਿਆਨੇ ਵਿਚ ਸੀ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "बीच सम्रयाना के तिह सीआ ॥",
      "sourceLineId": "137056",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਐਚਿਤ ਨਾਵ ਠਾਢ ਕਰ ਦੀਆ ॥੭॥",
      "transliteration": "aaichit naav Thaadd kar dheeaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੜਾਵਾ ('ਨਾਵ') ਖਿਚ ਕੇ ਖੜਾ ਕਰ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "ऐचित नाव ठाढ कर दीआ ॥७॥",
      "sourceLineId": "137057",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਉਪਰ ਅਵਰ ਸਮ੍ਰਯਾਨਾ ਡਾਰਾ ॥",
      "transliteration": "aupar avar samrayaanaa ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਉਪਰ ਇਕ ਹੋਰ ਸ਼ਾਮਿਆਨਾ ਪਾ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "उपर अवर सम्रयाना डारा ॥",
      "sourceLineId": "137058",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਵਾ ਕੋ ਜਾਇ ਨ ਅੰਗ ਨਿਹਾਰਾ ॥",
      "transliteration": "vaa ko jai na a(n)g nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਜੋ) ਉਸ ਦਾ ਕੋਈ ਅੰਗ ਵੇਖਿਆ ਨਾ ਜਾ ਸਕੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "वा को जाइ न अंग निहारा ॥",
      "sourceLineId": "137059",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਗੇ ਜਾਇ ਪਿਤਾ ਚਲਿ ਲੀਨਾ ॥",
      "transliteration": "aage jai pitaa chal leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਤਾ ਨੂੰ ਅਗੋਂ ਚਲ ਕੇ ਮਿਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "आगे जाइ पिता चलि लीना ॥",
      "sourceLineId": "137060",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੋਰਿ ਪ੍ਰਨਾਮ ਦੋਊ ਕਰ ਦੀਨਾ ॥੮॥",
      "transliteration": "jor pranaam dhouoo kar dheenaa ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਵੇਾਂ ਹੱਥ ਜੋੜ ਕੇ ਪ੍ਰਨਾਮ ਕੀਤਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "जोरि प्रनाम दोऊ कर दीना ॥८॥",
      "sourceLineId": "137061",
      "sourceShabadId": "12694",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "137062",
      "sourceShabadId": "12695",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਸ ਸਮ੍ਰਯਾਨਾ ਕੇ ਤਰ ਪਿਤੁ ਬੈਠਾਇਯੋ ॥",
      "transliteration": "tis samrayaanaa ke tar pit baiThaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸ਼ਾਮਿਆਨੇ ਹੇਠਾ ਪਿਤਾ ਨੂੰ ਬਿਠਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "तिस सम्रयाना के तर पितु बैठाइयो ॥",
      "sourceLineId": "137063",
      "sourceShabadId": "12695",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਕ ਏਕ ਕਰਿ ਤਾ ਕੌ ਪੁਹਪ ਦਿਖਾਇਯੋ ॥",
      "transliteration": "ek ek kar taa kau puhap dhikhaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਇਕ ਕਰ ਕੇ ਰਾਜੇ ਨੂੰ ਫੁਲ ਵਿਖਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "एक एक करि ता कौ पुहप दिखाइयो ॥",
      "sourceLineId": "137064",
      "sourceShabadId": "12695",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭੂਪ ਬਿਦਾ ਹ੍ਵੈ ਜਬੈ ਆਪੁਨੇ ਗ੍ਰਿਹ ਅਯੋ ॥",
      "transliteration": "bhoop bidhaa havai jabai aapune gireh ayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਵਿਦਾ ਹੋ ਕੇ ਆਪਣੇ ਘਰ ਆਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "भूप बिदा ह्वै जबै आपुने गृह अयो ॥",
      "sourceLineId": "137065",
      "sourceShabadId": "12695",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹੋ ਕਾਢਿ ਤਹਾ ਤੇ ਮਿਤ੍ਰ ਸੇਜ ਊਪਰ ਲਯੋ ॥੯॥",
      "transliteration": "ho kaadd tahaa te mitr sej uoopar layo ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ (ਸ਼ਾਮਿਆਨੇ) ਵਿਚੋਂ ਮਿਤਰ ਨੂੰ ਕਢ ਕੇ ਸੇਜ ਉਤੇ ਲੈ ਲਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "हो काढि तहा ते मित्र सेज ऊपर लयो ॥९॥",
      "sourceLineId": "137066",
      "sourceShabadId": "12695",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137067",
      "sourceShabadId": "12696",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਹ ਛਲ ਸੌ ਰਾਜਾ ਛਲਾ ਸਕਾ ਭੇਦ ਨਹਿ ਪਾਇ ॥",
      "transliteration": "eeh chhal sau raajaa chhalaa sakaa bhedh neh pai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਰਾਜਾ ਛਲਿਆ ਗਿਆ ਅਤੇ ਭੇਦ ਨੂੰ ਨਾ ਪਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "इह छल सौ राजा छला सका भेद नहि पाइ ॥",
      "sourceLineId": "137068",
      "sourceShabadId": "12696",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੁਹਿਤਾ ਕੇ ਗ੍ਰਿਹ ਜਾਇ ਸਿਰ ਆਯੋ ਕੋਰ ਮੁੰਡਾਇ ॥੧੦॥",
      "transliteration": "dhuhitaa ke gireh jai sir aayo kor mu(n)ddai ||10||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰੀ ਦੇ ਘਰ ਜਾ ਕੇ ਸੁਕਾ ਸਿਰ ਮੁੰਨਵਾ ਆਇਆ (ਅਰਥਾਤ ਛਲਿਆ ਗਿਆ) ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "दुहिता के गृह जाइ सिर आयो कोर मुँडाइ ॥१०॥",
      "sourceLineId": "137069",
      "sourceShabadId": "12696",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪੰਝਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੫॥੬੭੯੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau pa(n)jhatar charitr samaapatam sat subham sat ||375||6791||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੭੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੭੫॥੬੭੯੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ पंझतरि चरित्र समापतम सतु सुभम सतु ॥३७५॥६७९१॥अफजूँ॥",
      "sourceLineId": "137070",
      "sourceShabadId": "12696",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137071",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੁਨ ਰਾਜਾ ਇਕ ਔਰ ਕਹਾਨੀ ॥",
      "transliteration": "sun raajaa ik aauar kahaanee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਹੋਰ ਕਹਾਣੀ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "सुन राजा इक और कहानी ॥",
      "sourceLineId": "137072",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿਨਹੂੰ ਲਖੀ ਨ ਕਿਨਹੂੰ ਜਾਨੀ ॥",
      "transliteration": "kinahoo(n) lakhee na kinahoo(n) jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕਿਸੇ ਨੇ ਨਾ ਵੇਖੀ ਅਤੇ ਨਾ ਹੀ ਸੁਣੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "किनहूँ लखी न किनहूँ जानी ॥",
      "sourceLineId": "137073",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਹਿਰ ਹੈਦਰਾਬਾਦ ਬਸਤ ਜਹ ॥",
      "transliteration": "sahir haidharaabaadh basat jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਹੈਦਰਾਬਾਦ ਸ਼ਹਿਰ ਵਸਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "सहिर हैदराबाद बसत जह ॥",
      "sourceLineId": "137074",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸ੍ਰੀ ਹਰਿਜਛ ਕੇਤੁ ਰਾਜਾ ਤਹ ॥੧॥",
      "transliteration": "sree harijachh ket raajaa teh ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਹਰਿਜਛ ਕੇਤੁ ਨਾ ਦਾ ਰਾਜਾ (ਰਾਜ ਕਰਦਾ) ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "स्री हरिजछ केतु राजा तह ॥१॥",
      "sourceLineId": "137075",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗ੍ਰਿਹ ਮਦਮਤ ਮਤੀ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "gireh madhamat matee teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਮਦਮਤ ਮਤੀ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "गृह मदमत मती तिह नारी ॥",
      "sourceLineId": "137076",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸ੍ਰੀ ਪ੍ਰਬੀਨ ਦੇ ਧਾਮ ਦੁਲਾਰੀ ॥",
      "transliteration": "sree prabeen dhe dhaam dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਘਰ ਪ੍ਰਬੀਨ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "स्री प्रबीन दे धाम दुलारी ॥",
      "sourceLineId": "137077",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਪਮਾਨ ਦੁਤਿ ਜਾਤ ਨ ਕਹੀ ॥",
      "transliteration": "apamaan dhut jaat na kahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਬੇਮਿਸਾਲ ਸੁੰਦਰਤਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "अपमान दुति जात न कही ॥",
      "sourceLineId": "137078",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾਨੁਕ ਫੂਲ ਚੰਬੇਲੀ ਰਹੀ ॥੨॥",
      "transliteration": "jaanuk fool cha(n)belee rahee ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਚੰਬੇਲੀ ਦਾ ਫੁਲ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "जानुक फूल चंबेली रही ॥२॥",
      "sourceLineId": "137079",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਿਹਚਲ ਸਿੰਘ ਤਹਾ ਇਕ ਛਤ੍ਰੀ ॥",
      "transliteration": "nihachal si(n)gh tahaa ik chhatree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਨਿਹਚਲ ਸਿੰਘ ਨਾ ਦਾ ਛਤ੍ਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "निहचल सिंघ तहा इक छत्री ॥",
      "sourceLineId": "137080",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੂਰਬੀਰ ਬਲਵਾਨ ਤਿਅਤ੍ਰੀ ॥",
      "transliteration": "soorabeer balavaan tiatree ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਸ਼ੂਰਵੀਰ, ਬਲਵਾਨ ਅਤੇ ਅਸਤ੍ਰਧਾਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "सूरबीर बलवान तिअत्री ॥",
      "sourceLineId": "137081",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਿਹ ਪ੍ਰਬੀਨ ਦੇ ਨੈਨ ਨਿਹਾਰਾ ॥",
      "transliteration": "teh prabeen dhe nain nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪ੍ਰਬੀਨ ਦੇਈ ਨੇ ਅੱਖਾ ਨਾਲ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "तिह प्रबीन दे नैन निहारा ॥",
      "sourceLineId": "137082",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਦਨ ਕ੍ਰਿਪਾਨ ਘਾਇ ਜਨੁ ਮਾਰਾ ॥੩॥",
      "transliteration": "madhan kirapaan ghai jan maaraa ||3||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਇੰਜ ਲਗੀ) ਮਾਨੋ ਕਾਮ ਦੇਵ ਨੇ ਤਲਵਾਰ ਨਾਲ ਮਾਰ ਦਿੱਤੀ ਹੋਵੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "मदन कृपान घाइ जनु मारा ॥३॥",
      "sourceLineId": "137083",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਲਿਯਾ ਬੁਲਾਇ ॥",
      "transliteration": "paThai sahacharee liyaa bulai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦਾਸੀ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी लिया बुलाइ ॥",
      "sourceLineId": "137084",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭੋਗ ਕਿਯਾ ਰੁਚਿ ਦੁਹੂੰ ਬਢਾਇ ॥",
      "transliteration": "bhog kiyaa ruch dhuhoo(n) baddai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਨੇ ਰੁਚੀ ਪੂਰਵਕ ਭੋਗ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "भोग किया रुचि दुहूँ बढाइ ॥",
      "sourceLineId": "137085",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਚੁੰਬਨ ਕਰੈ ॥",
      "transliteration": "bhaat bhaat tan chu(n)ban karai ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਨਾਲ ਚੁੰਬਨ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन चुँबन करै ॥",
      "sourceLineId": "137086",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਿਬਿਧ ਪ੍ਰਕਾਰ ਆਸਨਨ ਧਰੈ ॥੪॥",
      "transliteration": "bibidh prakaar aasanan dharai ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਪ੍ਰਕਾਰ ਦੇ ਆਸਣ ਮਾਣੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "बिबिध प्रकार आसनन धरै ॥४॥",
      "sourceLineId": "137087",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਬ ਤਹ ਆਇ ਗਯੋ ਪਿਤੁ ਵਾ ਕੋ ॥",
      "transliteration": "tab teh aai gayo pit vaa ko ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਦਾ ਪਿਤਾ ਉਥੇ ਆ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "तब तह आइ गयो पितु वा को ॥",
      "sourceLineId": "137088",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭੋਗਤ ਹੁਤੋ ਜਹਾ ਪਿਯ ਤਾ ਕੋ ॥",
      "transliteration": "bhogat huto jahaa piy taa ko ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਉਸ ਦਾ ਪ੍ਰੀਤਮ ਉਸ ਨਾਲ ਰਤੀਲੀਲ੍ਰਹਾ ਮਚਾ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "भोगत हुतो जहा पिय ता को ॥",
      "sourceLineId": "137089",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਮਕਿ ਚਰਿਤ੍ਰ ਚੰਚਲਾ ਕੀਨਾ ॥",
      "transliteration": "chamak charitr cha(n)chalaa keenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਇਸਤਰੀ ਨੇ ਤੀਬ੍ਰਤਾ ਨਾਲ ਇਕ ਚਰਿਤ੍ਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "चमकि चरित्र चंचला कीना ॥",
      "sourceLineId": "137090",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਰਦਨ ਬੀਚ ਲਪਟਿ ਤਿਹ ਲੀਨਾ ॥੫॥",
      "transliteration": "paradhan beech lapaT teh leenaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ (ਪ੍ਰੀਤਮ) ਨੂੰ ਪਰਦਿਆਂ ਵਿਚ ਲਪੇਟ ਲਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "परदन बीच लपटि तिह लीना ॥५॥",
      "sourceLineId": "137091",
      "sourceShabadId": "12697",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137092",
      "sourceShabadId": "12698",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪਰਦਨ ਬੀਚ ਲਪੇਟਿ ਤਿਹ ਦਿਯਾ ਧਾਮ ਪਹੁਚਾਇ ॥",
      "transliteration": "paradhan beech lapeT teh dhiyaa dhaam pahuchai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪਰਦਿਆਂ ਵਿਚ ਲਪੇਟ ਕੇ ਘਰ ਪਹੁੰਚਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "परदन बीच लपेटि तिह दिया धाम पहुचाइ ॥",
      "sourceLineId": "137093",
      "sourceShabadId": "12698",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮੁਖ ਬਾਏ ਰਾਜਾ ਰਹਾ ਸਕਾ ਚਰਿਤ੍ਰ ਨ ਪਾਇ ॥੬॥",
      "transliteration": "mukh baae raajaa rahaa sakaa charitr na pai ||6||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਮੂੰਹ ਅੱਡੀ ਰਹਿ ਗਿਆ ਅਤੇ ਚਰਿਤ੍ਰ ਨੂੰ ਸਮਝ ਨਾ ਸਕਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "मुख बाए राजा रहा सका चरित्र न पाइ ॥६॥",
      "sourceLineId": "137094",
      "sourceShabadId": "12698",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਿਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੬॥੬੭੯੭॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chhihatar charitr samaapatam sat subham sat ||376||6797||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੭੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੭੬॥੬੭੯੭॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ छिहतरि चरित्र समापतम सतु सुभम सतु ॥३७६॥६७९७॥अफजूँ॥",
      "sourceLineId": "137095",
      "sourceShabadId": "12698",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137096",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਵਤਨ ਸੁਨਹੁ ਨਰਾਧਿਪ ਕਥਾ ॥",
      "transliteration": "navatan sunahu naraadhip kathaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਨਵੀਂ ਕਥਾ ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1329,
      "hindi": "",
      "hindiTransliteration": "नवतन सुनहु नराधिप कथा ॥",
      "sourceLineId": "137097",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1329_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿਯਾ ਚਰਿਤ੍ਰ ਚੰਚਲਾ ਜਥਾ ॥",
      "transliteration": "kiyaa charitr cha(n)chalaa jathaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਦਾ (ਇਕ) ਇਸਤਰੀ ਨੇ ਚਰਿਤ੍ਰ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
