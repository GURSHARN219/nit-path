{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1330,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1330_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤ੍ਰਿੰਬਕ ਮਹਾ ਰੁਦ੍ਰ ਹੈ ਜਹਾ ॥",
      "transliteration": "tira(n)bak mahaa rudhr hai jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਤ੍ਰਿੰਬਕ ਮਹਾ ਰੁਦ੍ਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "तृंबक महा रुद्र है जहा ॥",
      "sourceLineId": "137099",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤ੍ਰਿੰਬਕ ਦਤ ਨਰਾਧਪ ਤਹਾ ॥੧॥",
      "transliteration": "tira(n)bak dhat naraadhap tahaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਤ੍ਰਿੰਬਕ ਦੱਤ ਨਾ ਦਾ ਰਾਜਾ (ਰਾਜ ਕਰਦਾ) ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "तृंबक दत नराधप तहा ॥१॥",
      "sourceLineId": "137100",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤ੍ਰਿਬੰਕ ਪੁਰ ਤਾ ਕੋ ਬਹੁ ਸੋਹੈ ॥",
      "transliteration": "tiraba(n)k pur taa ko bahu sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਤ੍ਰਿੰਬਕ ਪੁਰ ਬਹੁਤ ਹੀ ਸ਼ੋਭਾਸ਼ਾਲੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "तृबंक पुर ता को बहु सोहै ॥",
      "sourceLineId": "137101",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇੰਦ੍ਰ ਚੰਦ੍ਰ ਲੋਕ ਕਹ ਮੋਹੈ ॥",
      "transliteration": "ei(n)dhr cha(n)dhr lok keh mohai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇੰਦਰ ਅਤੇ ਚੰਦ੍ਰ ਲੋਕਾ ਨੂੰ ਵੀ ਮੋਹ ਲੈਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "इंद्र चंद्र लोक कह मोहै ॥",
      "sourceLineId": "137102",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸ੍ਰੀ ਰਸਰੀਤਿ ਮਤੀ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "sree rasareet matee teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਰਸਰੀਤ ਮਤੀ ਉਸ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "स्री रसरीति मती तिह नारी ॥",
      "sourceLineId": "137103",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕੰਚਨ ਅਵਟਿ ਸਾਚੇ ਜਨੁ ਢਾਰੀ ॥੨॥",
      "transliteration": "ka(n)chan avaT saache jan ddaaree ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦੀ ਸੀ) ਮਾਨੋ ਸੋਨੇ ਨੂੰ ਪੰਘਾਰ ਕੇ ਸੰਚੇ ਵਿਚ ਢਾਲੀ ਗਈ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "कंचन अवटि साचे जनु ढारी ॥२॥",
      "sourceLineId": "137104",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸ੍ਰੀ ਸੁਹਾਸ ਦੇ ਤਾ ਕੀ ਕੰਨ੍ਯਾ ॥",
      "transliteration": "sree suhaas dhe taa kee ka(n)nayaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਕੰਨਿਆ ਦਾ ਨਾ ਸੁਹਾਸ ਦੇ (ਦੇਈ) ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "स्री सुहास दे ता की कंन्या ॥",
      "sourceLineId": "137105",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਹ ਸਮ ਉਪਜੀ ਨਾਰਿ ਨ ਅੰਨ੍ਰਯਾ ॥",
      "transliteration": "jeh sam upajee naar na a(n)nrayaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਕੋਈ ਹੋਰ ਨਾਰ ਪੈਦਾ ਨਹੀਂ ਹੋਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "जिह सम उपजी नारि न अंन्रया ॥",
      "sourceLineId": "137106",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਏਕ ਚਤੁਰਿ ਅਰੁ ਸੁੰਦਰਿ ਘਨੀ ॥",
      "transliteration": "ek chatur ar su(n)dhar ghanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਕ ਸਿਆਣੀ ਅਤੇ ਦੂਜੇ ਬਹੁਤ ਸੁੰਦਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "एक चतुरि अरु सुँदरि घनी ॥",
      "sourceLineId": "137107",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਹ ਸਮਾਨ ਕੋਈ ਨਹਿ ਬਨੀ ॥੩॥",
      "transliteration": "jeh samaan koiee neh banee ||3||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ (ਸੁੰਦਰ) ਕੋਈ ਹੋਰ ਨਹੀਂ ਬਣੀ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "जिह समान कोई नहि बनी ॥३॥",
      "sourceLineId": "137108",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਕ ਦਿਨ ਕੁਅਰਿ ਬਾਗ ਕੋ ਚਲੀ ॥",
      "transliteration": "eik dhin kuar baag ko chalee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਰਾਜ ਕੁਮਾਰੀ ਵੀਹ ਪੰਜਾਹ",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "इक दिन कुअरि बाग को चली ॥",
      "sourceLineId": "137109",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬੀਸ ਪਚਾਸ ਲਏ ਸੰਗ ਅਲੀ ॥",
      "transliteration": "bees pachaas le sa(n)g alee ||",
      "translation": "",
      "punjabiViakhya": "ਸਖੀਆਂ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਬਾਗ਼ ਨੂੰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "बीस पचास लए संग अली ॥",
      "sourceLineId": "137110",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਾਤ ਹੁਤੀ ਮਾਰਗ ਕੇ ਮਾਹੀ ॥",
      "transliteration": "jaat hutee maarag ke maahee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ) ਰਾਹ ਵਿਚ ਜਾ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "जात हुती मारग के माही ॥",
      "sourceLineId": "137111",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੁੰਦਰ ਨਿਰਖਾ ਏਕ ਤਹਾ ਹੀ ॥੪॥",
      "transliteration": "su(n)dhar nirakhaa ek tahaa hee ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਥੇ ਇਕ ਸੁੰਦਰ (ਆਦਮੀ) ਵੇਖਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "सुँदर निरखा एक तहा ही ॥४॥",
      "sourceLineId": "137112",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੇਰ ਸਿੰਘ ਤਿਹ ਨਾਮ ਬਿਰਾਜਤ ॥",
      "transliteration": "ser si(n)gh teh naam biraajat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾਮ ਸ਼ੇਰ ਸਿੰਘ ਸੀ। (ਉਹ ਇਤਨਾ ਸੁੰਦਰ ਸੀ ਕਿ)",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "सेर सिंघ तिह नाम बिराजत ॥",
      "sourceLineId": "137113",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾਹਿ ਨਿਰਖਿ ਰਤਿ ਕੋ ਮਨ ਲਾਜਤ ॥",
      "transliteration": "jaeh nirakh rat ko man laajat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ (ਕਾਮ ਦੇਵ ਦੀ ਇਸਤਰੀ) ਰਤੀ ਵੀ ਲਜਿਤ ਹੁੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "जाहि निरखि रति को मन लाजत ॥",
      "sourceLineId": "137114",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹ ਲਗਿ ਤਿਹ ਛਬਿ ਭਾਖਿ ਸੁਨਾਊ ॥",
      "transliteration": "keh lag teh chhab bhaakh sunaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਕਿਥੋਂ ਤਕ ਵਰਣਨ ਕਰਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "कह लगि तिह छबि भाखि सुनाऊ ॥",
      "sourceLineId": "137115",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪ੍ਰਭਾ ਕੇਰ ਸੁਭ ਗ੍ਰੰਥ ਬਨਾਊ ॥੫॥",
      "transliteration": "prabhaa ker subh gra(n)th banaauoo ||5||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਸੁੰਦਰਤਾ ਲਈ (ਇਕ) ਸ਼ੁਭ ਗ੍ਰੰਥ ਬਣਾ ਦਿਆਂ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "प्रभा केर सुभ ग्रंथ बनाऊ ॥५॥",
      "sourceLineId": "137116",
      "sourceShabadId": "12699",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "137117",
      "sourceShabadId": "12700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਜਬ ਤੇ ਤਿਹ ਗਈ ਨਿਹਾਰਿ ਕਰਿ ॥",
      "transliteration": "raaj sutaa jab te teh giee nihaar kar ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੀ ਰਾਜ ਕੁਮਾਰੀ ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਗਈ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "राज सुता जब ते तिह गई निहारि करि ॥",
      "sourceLineId": "137118",
      "sourceShabadId": "12700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਹੀ ਮਤ ਹ੍ਵੈ ਮਨ ਇਹ ਬਾਤ ਬਿਚਾਰਿ ਕਰਿ ॥",
      "transliteration": "rahee mat havai man ieh baat bichaar kar ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ (ਉਹ) ਇਹ ਗੱਲ ਵਿਚਾਰ ਕੇ ਮਨ ਵਿਚ ਮਸਤ ਹੋ ਰਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "रही मत ह्वै मन इह बात बिचारि करि ॥",
      "sourceLineId": "137119",
      "sourceShabadId": "12700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕੋਟਿ ਜਤਨ ਕਰਿ ਕਰਿ ਕਰਿ ਯਾਹਿ ਬੁਲਾਇਯੈ ॥",
      "transliteration": "koT jatan kar kar kar yaeh bulaiyai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਕਰੋੜਾ ਯਤਨ ਕਰ ਕਰ ਕੇ ਉਸ ਨੂੰ ਬੁਲਾਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "कोटि जतन करि करि करि याहि बुलाइयै ॥",
      "sourceLineId": "137120",
      "sourceShabadId": "12700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹੋ ਕਾਮ ਕੇਲ ਕਰਿ ਯਾ ਸੌ ਹਰਖ ਕਮਾਇਯੈ ॥੬॥",
      "transliteration": "ho kaam kel kar yaa sau harakh kamaiyai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ ਸੁਖ ਪ੍ਰਾਪਤ ਕਰਾਗੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "हो काम केल करि या सौ हरख कमाइयै ॥६॥",
      "sourceLineId": "137121",
      "sourceShabadId": "12700",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137122",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਖੀ ਏਕ ਤਹ ਦਈ ਪਠਾਇ ॥",
      "transliteration": "sakhee ek teh dhiee paThai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਨੇ) ਉਸ ਪਾਸ ਇਕ ਸਖੀ ਨੂੰ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "सखी एक तह दई पठाइ ॥",
      "sourceLineId": "137123",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਤਿਹ ਲਯੋ ਬੁਲਾਇ ॥",
      "transliteration": "jeh teh bidh teh layo bulai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨੂੰ ਬੁਲਾ ਲਿਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "जिह तिह बिधि तिह लयो बुलाइ ॥",
      "sourceLineId": "137124",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੜਿ ਪੜਿ ਦੋਹਾ ਛੰਦ ਬਿਹਾਰਹਿ ॥",
      "transliteration": "paR paR dhohaa chha(n)dh bihaareh ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੋਹਰਾ ਛੰਦ (ਗੀਤ) ਪੜ੍ਰਹ ਕੇ ਰਮਣ ਕਰ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "पड़ि पड़ि दोहा छंद बिहारहि ॥",
      "sourceLineId": "137125",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਕਲ ਮਦਨ ਕੋ ਤਾਪ ਨਿਵਾਰਹਿ ॥੭॥",
      "transliteration": "sakal madhan ko taap nivaareh ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਮ ਦਾ ਸਾਰਾ ਤਾਪ ਦੂਰ ਕਰ ਰਹੇ ਸਨ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "सकल मदन को ताप निवारहि ॥७॥",
      "sourceLineId": "137126",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਵਤ ਨੈਨ ਨਿਰਖਿ ਕਰਿ ਰਾਜਾ ॥",
      "transliteration": "aavat nain nirakh kar raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ (ਰਾਜ ਕੁਮਾਰੀ) ਨੇ ਰਾਜੇ ਨੂੰ ਆਉਾਂਦਿਆਂ ਅੱਖਾ ਨਾਲ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "आवत नैन निरखि करि राजा ॥",
      "sourceLineId": "137127",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਚਰਿਤ ਚੰਚਲਾ ਸਾਜਾ ॥",
      "transliteration": "eeh bidh charit cha(n)chalaa saajaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਚਰਿਤ੍ਰ ਖੇਡਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "इह बिधि चरित चंचला साजा ॥",
      "sourceLineId": "137128",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰੋਮ ਨਾਸ ਤਿਹ ਬਦਨ ਲਗਾਯੋ ॥",
      "transliteration": "rom naas teh badhan lagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਰੋਮਨਾਸਨੀ ਲਗਾ ਕੇ (ਵਾਲ ਦੂਰ ਕਰ ਦਿੱਤੇ ਅਤੇ)",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "रोम नास तिह बदन लगायो ॥",
      "sourceLineId": "137129",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਰਿ ਭੇਸ ਤਾ ਕਹ ਪਹਿਰਾਯੋ ॥੮॥",
      "transliteration": "naar bhes taa keh pahiraayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਇਸਤਰੀ ਦੇ ਬਸਤ੍ਰ ਪਵਾ ਦਿੱਤੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "नारि भेस ता कह पहिरायो ॥८॥",
      "sourceLineId": "137130",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਝਾਰੂ ਏਕ ਹਾਥ ਤਿਹ ਲਿਯੋ ॥",
      "transliteration": "jhaaroo ek haath teh liyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਹੱਥ ਵਿਚ ਝਾੜੂ ਪਕੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "झारू एक हाथ तिह लियो ॥",
      "sourceLineId": "137131",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੂਜੇ ਹਾਥ ਟੋਕਰਾ ਦਿਯੋ ॥",
      "transliteration": "dhooje haath Tokaraa dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੂਜੇ ਵਿਚ ਟੋਕਰਾ ਥਮਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "दूजे हाथ टोकरा दियो ॥",
      "sourceLineId": "137132",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮੁਹਰਨ ਔਰ ਰਪੈਯਨ ਭਰੋ ॥",
      "transliteration": "muharan aauar rapaiyan bharo ||",
      "translation": "",
      "punjabiViakhya": "(ਟੋਕਰਾ) ਮੋਹਰਾ ਅਤੇ ਰੁਪੈਯਾ ਨਾਲ ਭਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "मुहरन और रपैयन भरो ॥",
      "sourceLineId": "137133",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾਹਿ ਚੰਡਾਰੀ ਭਾਖਿਨਿ ਕਰੋ ॥੯॥",
      "transliteration": "taeh cha(n)ddaaree bhaakhin karo ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਚੂਹੜੀ ਕਹਿ ਦਿੱਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "ताहि चंडारी भाखिनि करो ॥९॥",
      "sourceLineId": "137134",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨ੍ਰਿਪ ਆਗੇ ਕਰਿ ਤਾਹਿ ਨਿਕਾਰਿਯੋ ॥",
      "transliteration": "nirap aage kar taeh nikaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦੇ ਸਾਹਮਣਿਓਾਂ ਉਸ ਨੂੰ ਕਢ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "नृप आगे करि ताहि निकारियो ॥",
      "sourceLineId": "137135",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੂੜ ਭੂਪ ਨਹਿ ਭੇਦ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "mooR bhoop neh bhedh bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੂਰਖ ਰਾਜੇ ਨੇ ਕੁਝ ਵੀ ਭੇਦ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "मूड़ भूप नहि भेद बिचारियो ॥",
      "sourceLineId": "137136",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਾਢਿ ਖੜਗ ਤਿਹ ਹਨਤ ਨ ਭਯੋ ॥",
      "transliteration": "kaadd khaRag teh hanat na bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਲਵਾਰ ਕਢ ਕੇ ਉਸ ਨੂੰ ਨਾ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "काढि खड़ग तिह हनत न भयो ॥",
      "sourceLineId": "137137",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾਨਿ ਚੰਡਾਰ ਤਾਹਿ ਨ੍ਰਿਪ ਗਯੋ ॥੧੦॥",
      "transliteration": "jaan cha(n)ddaar taeh nirap gayo ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਚੂਹੜੀ ਸਮਝ ਕੇ ਰਾਜਾ ਚਲਾ ਗਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "जानि चंडार ताहि नृप गयो ॥१०॥",
      "sourceLineId": "137138",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਿਨ ਇਹ ਮੋਰ ਅੰਗ ਛੁਹਿ ਜਾਇ ॥",
      "transliteration": "jin ieh mor a(n)g chhuh jai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜਾ ਇਹ ਸੋਚਦਾ ਸੀ) ਮਤਾ ਮੇਰੇ ਸ਼ਰੀਰ ਨੂੰ ਛੋਹ ਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "जिन इह मोर अंग छुहि जाइ ॥",
      "sourceLineId": "137139",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮੁਝੈ ਕਰੈ ਅਪਵਿਤ੍ਰ ਬਨਾਇ ॥",
      "transliteration": "mujhai karai apavitr banai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਅਪਵਿਤ੍ਰ ਕਰ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "मुझै करै अपवित्र बनाइ ॥",
      "sourceLineId": "137140",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਾਹਿ ਪਛਾਨਿ ਪਕਰਿ ਨਹਿ ਲਯੋ ॥",
      "transliteration": "taeh pachhaan pakar neh layo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਪਛਾਣ ਕੇ ਪਕੜ ਨਾ ਸਕਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "ताहि पछानि पकरि नहि लयो ॥",
      "sourceLineId": "137141",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਲੈ ਮੁਹਰੈ ਸੁੰਦਰ ਘਰ ਗਯੋ ॥੧੧॥",
      "transliteration": "lai muharai su(n)dhar ghar gayo ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੋਹਰਾ ਲੈ ਕੇ ਉਹ ਸੁੰਦਰ (ਆਦਮੀ) ਘਰ ਨੂੰ ਚਲਾ ਗਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "लै मुहरै सुँदर घर गयो ॥११॥",
      "sourceLineId": "137142",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਤਰ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੭॥੬੮੦੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau satatar charitr samaapatam sat subham sat ||377||6808||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੭੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੭੭॥੬੮੦੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ सततर चरित्र समापतम सतु सुभम सतु ॥३७७॥६८०८॥अफजूँ॥",
      "sourceLineId": "137143",
      "sourceShabadId": "12701",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137144",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭੂਪ ਤ੍ਰਿਹਾਟਕ ਸੈਨ ਭਨਿਜੈ ॥",
      "transliteration": "bhoop tirahaaTak sain bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਤ੍ਰਿਹਾਟਕ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "भूप तृहाटक सैन भनिजै ॥",
      "sourceLineId": "137145",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1330_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਗਰ ਤਿਹਾੜੋ ਜਾਹਿ ਕਹਿਜੈ ॥",
      "transliteration": "nagar tihaaRo jaeh kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਨਗਰ ਨੂੰ ਤਿਹਾੜ ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1330,
      "hindi": "",
      "hindiTransliteration": "नगर तिहाड़ो जाहि कहिजै ॥",
      "sourceLineId": "137146",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
