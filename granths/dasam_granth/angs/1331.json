{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1331,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1331_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਾਹਿ ਤ੍ਰਿਹਾਟਕ ਪੁਰੀ ਬਖਾਨੈ ॥",
      "transliteration": "jaeh tirahaaTak puree bakhaanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਤ੍ਰਿਹਾਟਕ ਪੁਰੀ ਵੀ ਕਹਿੰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "जाहि तृहाटक पुरी बखानै ॥",
      "sourceLineId": "137147",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦਾਨਵ ਦੇਵ ਜਛ ਸਭ ਜਾਨੈ ॥੧॥",
      "transliteration": "dhaanav dhev jachh sabh jaanai ||1||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੈਂਤ, ਦੇਵਤੇ ਅਤੇ ਯਕਸ਼ ਸਭ ਜਾਣਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "दानव देव जछ सभ जानै ॥१॥",
      "sourceLineId": "137148",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸ੍ਰੀ ਮਹਬੂਬ ਮਤੀ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "sree mahaboob matee teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਬੂਬ ਮਤੀ ਉਸ ਦੀ ਇਸਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "स्री महबूब मती तिह नारी ॥",
      "sourceLineId": "137149",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਿਹ ਸਮ ਸੁੰਦਰਿ ਕਹੂੰ ਨ ਕੁਮਾਰੀ ॥",
      "transliteration": "jeh sam su(n)dhar kahoo(n) na kumaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਸੁੰਦਰ ਕੋਈ ਹੋਰ ਕੁਮਾਰੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "जिह सम सुँदरि कहूँ न कुमारी ॥",
      "sourceLineId": "137150",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੁਤਿਯ ਨਾਰਿ ਮ੍ਰਿਦੁਹਾਸ ਮਤੀ ਤਿਹ ॥",
      "transliteration": "dhutiy naar miradhuhaas matee teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਦੂਜੀ ਇਸਤਰੀ ਮ੍ਰਿਦੁਹਾਸ ਮਤੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "दुतिय नारि मृदुहास मती तिह ॥",
      "sourceLineId": "137151",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਹਿ ਸਸਿ ਸਮ ਕਹਿਯਤ ਆਨਨ ਜਿਹ ॥੨॥",
      "transliteration": "neh sas sam kahiyat aanan jeh ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਮੁਖ ਦੇ ਸਮਾਨ ਚੰਦ੍ਰਮਾ ਵੀ ਨਹੀਂ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "नहि ससि सम कहियत आनन जिह ॥२॥",
      "sourceLineId": "137152",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸ੍ਰੀ ਮਹਬੂਬ ਮਤੀ ਤਨ ਨ੍ਰਿਪ ਰਤਿ ॥",
      "transliteration": "sree mahaboob matee tan nirap rat ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਬੂਬ ਮਤੀ ਨਾਲ ਰਾਜੇ ਦਾ ਪ੍ਰੇਮ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "स्री महबूब मती तन नृप रति ॥",
      "sourceLineId": "137153",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੁਤਿਯ ਨਾਰਿ ਪਰ ਨਹਿ ਆਨਨ ਮਤਿ ॥",
      "transliteration": "dhutiy naar par neh aanan mat ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਦੂਜੀ ਇਸਤਰੀ ਵਲ ਮੂੰਹ ਨਹੀਂ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "दुतिय नारि पर नहि आनन मति ॥",
      "sourceLineId": "137154",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਧਿਕ ਭੋਗ ਤਿਹ ਸਾਥ ਕਮਾਯੋ ॥",
      "transliteration": "adhik bhog teh saath kamaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਸ (ਮਹਬੂਬ ਮਤੀ) ਨਾਲ ਬਹੁਤ ਭੋਗ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "अधिक भोग तिह साथ कमायो ॥",
      "sourceLineId": "137155",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਏਕ ਪੁਤ੍ਰ ਤਾ ਤੇ ਉਪਜਾਯੋ ॥੩॥",
      "transliteration": "ek putr taa te upajaayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਤੋਂ ਇਕ ਪੁੱਤਰ ਪੈਦਾ ਕੀਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "एक पुत्र ता ते उपजायो ॥३॥",
      "sourceLineId": "137156",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੁਤਿਯ ਨਾਰਿ ਤੇ ਸਾਥ ਨ ਪ੍ਰੀਤਾ ॥",
      "transliteration": "dhutiy naar te saath na preetaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਦੂਜੀ ਇਸਤਰੀ ਨਾਲ ਪ੍ਰੀਤ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "दुतिय नारि ते साथ न प्रीता ॥",
      "sourceLineId": "137157",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਾਹਿ ਨ ਬੀਚ ਲ੍ਯਾਵਤ ਚੀਤਾ ॥",
      "transliteration": "taeh na beech layaavat cheetaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਚਿਤ ਵਿਚ ਨਹੀਂ ਲਿਆਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "ताहि न बीच ल्यावत चीता ॥",
      "sourceLineId": "137158",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁਤਵੰਤੀ ਇਕ ਪੁਨਿ ਪਤਿ ਪ੍ਰੀਤ ॥",
      "transliteration": "sutava(n)tee ik pun pat preet ||",
      "translation": "",
      "punjabiViakhya": "(ਮਹਬੂਬ ਮਤੀ) ਇਕ ਪੁੱਤਰਵਤੀ ਸੀ ਅਤੇ ਦੂਜੀ ਪਤੀ ਨਾਲ ਪ੍ਰੀਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "सुतवंती इक पुनि पति प्रीत ॥",
      "sourceLineId": "137159",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਵਰ ਤ੍ਰਿਯਹਿ ਲ੍ਯਾਵਤ ਨਹਿ ਚੀਤ ॥੪॥",
      "transliteration": "avar tirayeh layaavat neh cheet ||4||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਉਹ ਹੋਰ ਕਿਸੇ ਇਸਤਰੀ ਨੂੰ ਚਿਤ ਵਿਚ ਨਹੀਂ ਲਿਆਉਾਂਦੀ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "अवर तृयहि ल्यावत नहि चीत ॥४॥",
      "sourceLineId": "137160",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੁਤਿਯ ਨਾਰਿ ਤਬ ਅਧਿਕ ਰਿਸਾਈ ॥",
      "transliteration": "dhutiy naar tab adhik risaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਦੇ ਇਸ ਸਲੂਕ ਕਰ ਕੇ) ਦੂਜੀ ਇਸਤਰੀ ਤਦ ਬਹੁਤ ਕ੍ਰੋਧਿਤ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "दुतिय नारि तब अधिक रिसाई ॥",
      "sourceLineId": "137161",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਏਕ ਘਾਤ ਕੀ ਬਾਤ ਬਨਾਈ ॥",
      "transliteration": "ek ghaat kee baat banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਛਲ ਕਰਨ ਦਾ ਮਨ ਬਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "एक घात की बात बनाई ॥",
      "sourceLineId": "137162",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਿਸ ਕੀ ਗੁਦਾ ਗੋਖਰੂ ਦਿਯਾ ॥",
      "transliteration": "sis kee gudhaa gokharoo dhiyaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬੱਚੇ ਦੀ ਗੁਦਾ ਵਿਚ ਭਖੜਾ ('ਗੋਖਰੂ') ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "सिस की गुदा गोखरू दिया ॥",
      "sourceLineId": "137163",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਤੇ ਅਧਿਕ ਦੁਖਿਤ ਤਿਹ ਕਿਯਾ ॥੫॥",
      "transliteration": "taa te adhik dhukhit teh kiyaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨਾਲ ਉਸ ਨੂੰ ਬਹੁਤ ਦੁਖੀ ਕੀਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "ता ते अधिक दुखित तिह किया ॥५॥",
      "sourceLineId": "137164",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਾਲਕ ਅਧਿਕ ਦੁਖਾਤੁਰ ਭਯੋ ॥",
      "transliteration": "baalak adhik dhukhaatur bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਲਕ ਦੁਖ ਨਾਲ ਬਹੁਤ ਆਤੁਰ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "बालक अधिक दुखातुर भयो ॥",
      "sourceLineId": "137165",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰੋਵਤ ਧਾਮ ਮਾਤ ਕੇ ਗਯੋ ॥",
      "transliteration": "rovat dhaam maat ke gayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰੋਂਦਾ ਹੋਇਆ ਮਾ ਦੇ ਘਰ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "रोवत धाम मात के गयो ॥",
      "sourceLineId": "137166",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਿਰਖਿ ਤਾਤ ਮਾਤਾ ਦੁਖ ਪਾਯੋ ॥",
      "transliteration": "nirakh taat maataa dhukh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰ ('ਤਾਤ') ਨੂੰ ਵੇਖ ਕੇ ਮਾਤਾ ਬਹੁਤ ਦੁਖੀ ਹੋਈ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "निरखि तात माता दुख पायो ॥",
      "sourceLineId": "137167",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭਲੀ ਭਲੀ ਧਾਯਾਨ ਮੰਗਾਯੋ ॥੬॥",
      "transliteration": "bhalee bhalee dhaayaan ma(n)gaayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੰਗੀਆਂ ਚੰਗੀਆਂ ਦਾਈਆਂ ਮੰਗਵਾਈਆਂ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "भली भली धायान मंगायो ॥६॥",
      "sourceLineId": "137168",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਬਾਲਹਿ ਦੁਖ ਦਿਯੋ ॥",
      "transliteration": "eeh charitr baaleh dhukh dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ (ਬੱਚੇ ਦੀ) ਮਾਤਾ ਨੂੰ ਦੁਖ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र बालहि दुख दियो ॥",
      "sourceLineId": "137169",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਪਨ ਭੇਸ ਧਾਇ ਕੋ ਕਿਯੋ ॥",
      "transliteration": "aapan bhes dhai ko kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਦਾਈ ਦਾ ਭੇਸ ਵਟਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "आपन भेस धाइ को कियो ॥",
      "sourceLineId": "137170",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਿਯਾ ਸਵਤਿ ਕੇ ਧਾਮ ਪਯਾਨਾ ॥",
      "transliteration": "kiyaa savat ke dhaam payaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਸੌਂਕਣ ਦੇ ਘਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "किया सवति के धाम पयाना ॥",
      "sourceLineId": "137171",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭੇਦ ਨਾਰਿ ਕਿਨਹੂੰ ਨ ਪਛਾਨਾ ॥੭॥",
      "transliteration": "bhedh naar kinahoo(n) na pachhaanaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਇਸਤਰੀ ਦਾ ਭੇਦ ਕਿਸੇ ਨਾ ਸਮਝਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "भेद नारि किनहूँ न पछाना ॥७॥",
      "sourceLineId": "137172",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਔਖਧ ਏਕ ਹਾਥ ਮੈ ਲਈ ॥",
      "transliteration": "aauakhadh ek haath mai liee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਦਵਾਈ ਹੱਥ ਵਿਚ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "औखध एक हाथ मै लई ॥",
      "sourceLineId": "137173",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਿਸੁ ਕੀ ਪ੍ਰਥਮ ਮਾਤ ਕੌ ਦਈ ॥",
      "transliteration": "sis kee pratham maat kau dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਬੱਚੇ ਦੀ ਮਾਤਾ ਨੂੰ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "सिसु की प्रथम मात कौ दई ॥",
      "sourceLineId": "137174",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਰੀ ਖਾਤ ਰਾਨੀ ਮਰਿ ਗਈ ॥",
      "transliteration": "baree khaat raanee mar giee ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਲੀ ('ਬਰੀ') ਖਾਦਿਆਂ ਹੀ ਰਾਣੀ ਮਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "बरी खात रानी मरि गई ॥",
      "sourceLineId": "137175",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸ੍ਵਛ ਸੁਘਰਿ ਰਾਨੀ ਫਿਰਿ ਅਈ ॥੮॥",
      "transliteration": "savaichh sughar raanee fir iee ||8||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸਵੱਛ ਅਤੇ ਸੁਘੜ ਰਾਣੀ ਫਿਰ ਘਰ ਆ ਗਈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "स्वछ सुघरि रानी फिरि अई ॥८॥",
      "sourceLineId": "137176",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਿਜੁ ਗ੍ਰਿਹ ਆਇ ਭੇਸ ਨ੍ਰਿਪ ਤ੍ਰਿਯ ਧਰਿ ॥",
      "transliteration": "nij gireh aai bhes nirap tiray dhar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਘਰ ਆ ਕੇ ਰਾਣੀ ਦਾ ਭੇਸ ਧਾਰਨ ਕਰ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "निजु गृह आइ भेस नृप तृय धरि ॥",
      "sourceLineId": "137177",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾਤਿ ਭਈ ਅਪਨੀ ਸਵਿਤਨ ਘਰ ॥",
      "transliteration": "jaat bhiee apanee savitan ghar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਸੌਂਕਣ ਦੇ ਘਰ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "जाति भई अपनी सवितन घर ॥",
      "sourceLineId": "137178",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਿਸੁ ਕੋ ਕਾਢਿ ਗੋਖਰੂ ਡਾਰੋ ॥",
      "transliteration": "sis ko kaadd gokharoo ddaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਬੱਚੇ ਦਾ ਭਖੜਾ ਕਢ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "सिसु को काढि गोखरू डारो ॥",
      "sourceLineId": "137179",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾਹਿ ਸੁਘਰਿ ਤਿਹ ਸੁਤ ਕਰਿ ਪਾਰੋ ॥੯॥",
      "transliteration": "taeh sughar teh sut kar paaro ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਬੱਚੇ ਨੂੰ ਉਸ ਸੁਘੜ ਇਸਤਰੀ ਨੇ ਪੁੱਤਰ ਕਰ ਕੇ ਪਾਲਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "ताहि सुघरि तिह सुत करि पारो ॥९॥",
      "sourceLineId": "137180",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਹ ਛਲ ਸੋ ਸਵਤਿਨ ਕਹ ਮਾਰਾ ॥",
      "transliteration": "eeh chhal so savatin keh maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ (ਉਸ ਨੇ) ਸੌਂਕਣ ਨੂੰ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "इह छल सो सवतिन कह मारा ॥",
      "sourceLineId": "137181",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਿਸਹੁ ਜਾਨਿ ਸੁਤ ਲਿਯੋ ਉਬਾਰਾ ॥",
      "transliteration": "sisahu jaan sut liyo ubaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬੱਚੇ ਨੂੰ ਪੁੱਤਰ ਜਾਣ ਕੇ ਪਾਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "सिसहु जानि सुत लियो उबारा ॥",
      "sourceLineId": "137182",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨ੍ਰਿਪਹ ਸੰਗ ਪੁਨਿ ਕਰਿ ਲਿਯ ਪ੍ਯਾਰਾ ॥",
      "transliteration": "nirapeh sa(n)g pun kar liy payaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਾਜੇ ਨਾਲ ਫਿਰ ਪ੍ਰੇਮ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "नृपह संग पुनि करि लिय प्यारा ॥",
      "sourceLineId": "137183",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂੰ ਬਿਚਾਰਾ ॥੧੦॥",
      "transliteration": "bhedh abhedh na kinoo(n) bichaaraa ||10||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਇਸ ਭੇਦ ਅਭੇਦ ਨੂੰ ਕੋਈ ਨਾ ਸਮਝ ਸਕਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न किनूँ बिचारा ॥१०॥",
      "sourceLineId": "137184",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਹਤਰਿ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੮॥੬੮੧੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau aThahatar charitr samaapatam sat subham sat ||378||6818||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੭੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੭੮॥੬੮੧੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ अठहतरि चरित्र समापतम सतु सुभम सतु ॥३७८॥६८१८॥अफजूँ॥",
      "sourceLineId": "137185",
      "sourceShabadId": "12702",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137186",
      "sourceShabadId": "12703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੁਨ ਰਾਜਾ ਇਕ ਔਰ ਪ੍ਰਸੰਗਾ ॥",
      "transliteration": "sun raajaa ik aauar prasa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਹੋਰ ਪ੍ਰਸੰਗ ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "सुन राजा इक और प्रसंगा ॥",
      "sourceLineId": "137187",
      "sourceShabadId": "12703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਭਯੋ ਨਰੇਸੁਰ ਸੰਗਾ ॥",
      "transliteration": "jeh bidh bhayo naresur sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਦਾ ਰਾਜੇ ਨਾਲ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि भयो नरेसुर संगा ॥",
      "sourceLineId": "137188",
      "sourceShabadId": "12703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮ੍ਰਿਦੁਲਾ ਦੇ ਤਿਹ ਨਾਰਿ ਭਨਿਜੈ ॥",
      "transliteration": "miradhulaa dhe teh naar bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮ੍ਰਿਦੁਲਾ ਦੇ (ਦੇਈ) ਉਸ ਦੀ ਇਸਤਰੀ ਅਖਵਾਉਾਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "मृदुला दे तिह नारि भनिजै ॥",
      "sourceLineId": "137189",
      "sourceShabadId": "12703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇੰਦ੍ਰ ਚੰਦ੍ਰ ਪਟਤਰ ਤਿਹ ਦਿਜੈ ॥੧॥",
      "transliteration": "ei(n)dhr cha(n)dhr paTatar teh dhijai ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਉਪਮਾ ਇੰਦਰ ਅਤੇ ਚੰਦ੍ਰਮਾ ਨਾਲ ਦਿੱਤੀ ਜਾਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "इंद्र चंद्र पटतर तिह दिजै ॥१॥",
      "sourceLineId": "137190",
      "sourceShabadId": "12703",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "137191",
      "sourceShabadId": "12704",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸ੍ਰੀ ਸੁਪ੍ਰਭਾ ਦੇ ਤਾ ਕੀ ਸੁਤਾ ਬਖਾਨਿਯੈ ॥",
      "transliteration": "sree suprabhaa dhe taa kee sutaa bakhaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪੁੱਤਰੀ ਦਾ ਨਾ ਸੁਪ੍ਰਭਾ ਦੇ (ਦੇਈ) ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "स्री सुप्रभा दे ता की सुता बखानियै ॥",
      "sourceLineId": "137192",
      "sourceShabadId": "12704",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਹਾ ਸੁੰਦਰੀ ਲੋਕ ਚਤੁਰਦਸ ਜਾਨਿਯੈ ॥",
      "transliteration": "mahaa su(n)dharee lok chaturadhas jaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਮਹਾਨ ਸੁੰਦਰੀ ਮੰਨਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "महा सुँदरी लोक चतुरदस जानियै ॥",
      "sourceLineId": "137193",
      "sourceShabadId": "12704",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜੋ ਸਹਚਰਿ ਤਾ ਕੌ ਭਰਿ ਨੈਨ ਨਿਹਾਰਹੀ ॥",
      "transliteration": "jo sahachar taa kau bhar nain nihaarahee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਖੀ ਵੀ ਉਸ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਅੱਖਾ ਨਾਲ ਵੇਖਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "जो सहचरि ता कौ भरि नैन निहारही ॥",
      "sourceLineId": "137194",
      "sourceShabadId": "12704",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹੋ ਪਰੀ ਪਦੁਮਨੀ ਪ੍ਰਕ੍ਰਿਤ ਸੁ ਵਾਹਿ ਬਿਚਾਰਹੀ ॥੨॥",
      "transliteration": "ho paree padhumanee prakirat su vaeh bichaarahee ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਉਸ ਨੂੰ ਪਰੀ ਜਾ ਪਦਮਨੀ ਦੇ ਸਰੂਪ ਵਰਗਾ ਸਮਝਦੀ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "हो परी पदुमनी प्रकृत सु वाहि बिचारही ॥२॥",
      "sourceLineId": "137195",
      "sourceShabadId": "12704",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137196",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਾਟਕਪੁਰ ਤਿਨ ਕੋ ਦਿਸਿ ਦਛਿਨ ॥",
      "transliteration": "haaTakapur tin ko dhis dhachhin ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਹਾਟਕਪੁਰ (ਨਗਰ) ਦੱਖਣ ਵਾਲੇ ਪਾਸੇ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "हाटकपुर तिन को दिसि दछिन ॥",
      "sourceLineId": "137197",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਰਾਜ ਕਰਤ ਤੇ ਤਹਾ ਬਿਚਛਨ ॥",
      "transliteration": "raaj karat te tahaa bichachhan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਉਹ ਸਿਆਣਾ (ਰਾਜਾ) ਰਾਜ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "राज करत ते तहा बिचछन ॥",
      "sourceLineId": "137198",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਿਹ ਪੁਰ ਏਕ ਸਾਹ ਕੋ ਪੁਤ੍ਰ ॥",
      "transliteration": "teh pur ek saeh ko putr ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਗਰ ਵਿਚ ਇਕ ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ (ਰਹਿੰਦਾ) ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "तिह पुर एक साह को पुत्र ॥",
      "sourceLineId": "137199",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਨੁ ਕਰਿ ਬਿਧਨਾ ਠਟਾ ਚਰਿਤ੍ਰ ॥੩॥",
      "transliteration": "jan kar bidhanaa ThaTaa charitr ||3||",
      "translation": "",
      "punjabiViakhya": "(ਇਤਨਾ ਸੁੰਦਰ ਸੀ) ਮਾਨੋ ਵਿਧਾਤਾ ਨੇ ਇਕ ਛਲ-ਚਰਿਤ੍ਰ ਹੀ ਬਣਾਇਆ ਹੋਵੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "जनु करि बिधना ठटा चरित्र ॥३॥",
      "sourceLineId": "137200",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਬ੍ਰਯਾਘ੍ਰ ਕੇਤੁ ਤਿਹ ਨਾਮ ਕਹਿਜੈ ॥",
      "transliteration": "brayaaghr ket teh naam kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਬ੍ਰਯਾਘ੍ਰ ਕੇਤੁ ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "ब्रयाघ्र केतु तिह नाम कहिजै ॥",
      "sourceLineId": "137201",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਛਤ੍ਰ ਜਾਤਿ ਰਘੁਬੰਸ ਭਨਿਜੈ ॥",
      "transliteration": "chhatr jaat raghuba(n)s bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਰਘੁਬੰਸ ਜਾਤਿ ਦਾ ਛਤ੍ਰ ਸਮਝਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "छत्र जाति रघुबंस भनिजै ॥",
      "sourceLineId": "137202",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਪ੍ਰਗਟ ਜਾਨੁ ਅਵਤਾਰ ਅਨੰਗਾ ॥",
      "transliteration": "pragaT jaan avataar ana(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਦਾ ਅਜਿਹਾ (ਸੁੰਦਰ) ਸ਼ਰੀਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "प्रगट जानु अवतार अनंगा ॥",
      "sourceLineId": "137203",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਐਸੋ ਸਾਹ ਪੁਤ੍ਰ ਕੋ ਅੰਗਾ ॥੪॥",
      "transliteration": "aaiso saeh putr ko a(n)gaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਮ ਦੇਵ ਦਾ ਅਵਤਾਰ ਪ੍ਰਗਟ ਹੋਇਆ ਹੋਵੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "ऐसो साह पुत्र को अंगा ॥४॥",
      "sourceLineId": "137204",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਲਾਗੀ ਲਗਨ ਤਵਨ ਪਰ ਬਾਲਾ ॥",
      "transliteration": "laagee lagan tavan par baalaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਰਾਜ ਕੁਮਾਰੀ ਦੀ ਲਗਨ ਉਸ ਨਾਲ ਲਗ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "लागी लगन तवन पर बाला ॥",
      "sourceLineId": "137205",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸਖੀ ਪਠੀ ਇਕ ਤਹਾ ਰਿਸਾਲਾ ॥",
      "transliteration": "sakhee paThee ik tahaa risaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਸਿਆਣੀ ਸਖੀ ਨੂੰ ਉਥੇ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "सखी पठी इक तहा रिसाला ॥",
      "sourceLineId": "137206",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸੋ ਚਲਿ ਗਈ ਕੁਅਰ ਕੇ ਧਾਮਾ ॥",
      "transliteration": "so chal giee kuar ke dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਚਲ ਕੇ ਸ਼ਾਹ ਦੇ ਪੁੱਤਰ ਦੇ ਘਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "सो चलि गई कुअर के धामा ॥",
      "sourceLineId": "137207",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਜਿਮਿ ਤਿਮਿ ਤਾਹਿ ਪ੍ਰਬੋਧ੍ਰਯੋ ਬਾਮਾ ॥੫॥",
      "transliteration": "jim tim taeh prabodhrayo baamaa ||5||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਉਸ) ਇਸਤਰੀ ਨੇ ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨੂੰ ਸਮਝਾਇਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "जिमि तिमि ताहि प्रबोध्रयो बामा ॥५॥",
      "sourceLineId": "137208",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਜਾਤ ਭਈ ਤਾ ਕਹ ਲੈ ਤਹਾ ॥",
      "transliteration": "jaat bhiee taa keh lai tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਲੈ ਕੇ ਉਥੇ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "जात भई ता कह लै तहा ॥",
      "sourceLineId": "137209",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਮਾਰਗ ਕੁਅਰਿ ਬਿਲੋਕਤ ਜਹਾ ॥",
      "transliteration": "maarag kuar bilokat jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਰਾਜ ਕੁਮਾਰੀ ਉਸ ਦਾ ਰਾਹ ਵੇਖ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "मारग कुअरि बिलोकत जहा ॥",
      "sourceLineId": "137210",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਨਿਰਖਤ ਨੈਨ ਗਰੇ ਲਪਟਾਈ ॥",
      "transliteration": "nirakhat nain gare lapaTaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਅੱਖਾ ਨਾਲ ਵੇਖਦਿਆਂ ਹੀ ਗਲੇ ਨਾਲ ਲਗਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "निरखत नैन गरे लपटाई ॥",
      "sourceLineId": "137211",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਸੇਜਾਸਨ ਪਰ ਲਿਯੋ ਚੜਾਈ ॥੬॥",
      "transliteration": "sejaasan par liyo chaRaiee ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੇਜ ਦੇ ਆਸਣ ਉਪਰ ਚੜ੍ਰਹਾ ਲਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "सेजासन पर लियो चड़ाई ॥६॥",
      "sourceLineId": "137212",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਕਰੀ ਤਵਨ ਸੌ ਕ੍ਰੀੜਾ ॥",
      "transliteration": "bahu bidh karee tavan sau kreeRaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਲੀਲ੍ਰਹਾ ਰਚਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि करी तवन सौ क्रीड़ा ॥",
      "sourceLineId": "137213",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਕਾਮਨਿ ਕਾਮ ਨਿਵਾਰੀ ਪੀੜਾ ॥",
      "transliteration": "kaaman kaam nivaaree peeRaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਆਪਣੀ ਕਾਮਪੀੜ ਨੂੰ ਦੂਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "कामनि काम निवारी पीड़ा ॥",
      "sourceLineId": "137214",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਨਿਸੁ ਦਿਨ ਧਾਮ ਬਾਮ ਤਿਹ ਰਾਖਾ ॥",
      "transliteration": "nis dhin dhaam baam teh raakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਰਾਤ ਦਿਨ ਉਸ ਨੂੰ ਘਰ ਹੀ ਰਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "निसु दिन धाम बाम तिह राखा ॥",
      "sourceLineId": "137215",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਤਨ ਭੇਦ ਨ ਭਾਖਾ ॥੭॥",
      "transliteration": "maat pitaa tan bhedh na bhaakhaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਾਤਾ ਪਿਤਾ ਤਕ ਕੋਈ ਭੇਦ ਨਾ ਦਸਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "मात पिता तन भेद न भाखा ॥७॥",
      "sourceLineId": "137216",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਤਬ ਲੌ ਬ੍ਯਾਹਿ ਦਯੋ ਤਿਹ ਤਾਤੈ ॥",
      "transliteration": "tab lau bayaeh dhayo teh taatai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਪਿਤਾ ਨੇ ਉਸ ਦਾ ਵਿਆਹ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "तब लौ ब्याहि दयो तिह तातै ॥",
      "sourceLineId": "137217",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1331_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਭੂਲਿ ਗਈ ਵਾ ਕੌ ਵੈ ਬਾਤੈ ॥",
      "transliteration": "bhool giee vaa kau vai baatai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਉਹ ਸਾਰੀਆਂ ਗੱਲਾ ਭੁਲ ਗਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1331,
      "hindi": "",
      "hindiTransliteration": "भूलि गई वा कौ वै बातै ॥",
      "sourceLineId": "137218",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
