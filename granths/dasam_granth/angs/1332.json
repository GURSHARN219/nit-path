{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1332,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1332_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਿਜੁ ਪ੍ਯਾਰੇ ਬਿਨ ਰਹਿਯੋ ਨ ਗਯੋ ॥",
      "transliteration": "nij payaare bin rahiyo na gayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਤੋਂ) ਆਪਣੇ ਪ੍ਰੀਤਮ ਤੋਂ ਬਿਨਾ ਰਿਹਾ ਨਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "निजु प्यारे बिन रहियो न गयो ॥",
      "sourceLineId": "137219",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਘਾਲਿ ਸੰਦੂਕਹਿ ਸਾਥ ਚਲਯੋ ॥੮॥",
      "transliteration": "ghaal sa(n)dhookeh saath chalayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਸੰਦੂਕ ਵਿਚ ਪਾ ਕੇ ਨਾਲ ਹੀ ਲੈ ਲਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "घालि संदूकहि साथ चलयो ॥८॥",
      "sourceLineId": "137220",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਿਸੁ ਦਿਨ ਤਾ ਸੌ ਭੋਗ ਕਮਾਵੈ ॥",
      "transliteration": "nis dhin taa sau bhog kamaavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਤ ਦਿਨ ਉਸ ਨਾਲ ਸੰਯੋਗ ਕਰਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "निसु दिन ता सौ भोग कमावै ॥",
      "sourceLineId": "137221",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੋਵਤ ਰਹੈ ਨ ਭੂਪਤਿ ਪਾਵੈ ॥",
      "transliteration": "sovat rahai na bhoopat paavai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਸੁੱਤਾ ਰਹਿੰਦਾ ਅਤੇ ਭੇਦ ਨਾ ਪਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "सोवत रहै न भूपति पावै ॥",
      "sourceLineId": "137222",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਜਬ ਹੀ ਨ੍ਰਿਪ ਜਾਗਾ ॥",
      "transliteration": "ek dhivas jab hee nirap jaagaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਜਦ ਰਾਜਾ ਜਾਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "एक दिवस जब ही नृप जागा ॥",
      "sourceLineId": "137223",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਨਿਯਹਿ ਛੋਰਿ ਜਾਰ ਉਠਿ ਭਾਗਾ ॥੯॥",
      "transliteration": "raniyeh chhor jaar uTh bhaagaa ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਣੀ ਨੂੰ ਛਡ ਕੇ ਯਾਰ ਭਜ ਪਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "रनियहि छोरि जार उठि भागा ॥९॥",
      "sourceLineId": "137224",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤ੍ਰਿਯ ਸੌ ਬਚਨ ਕੋਪ ਕਰਿ ਭਾਖਿਯੋ ॥",
      "transliteration": "tiray sau bachan kop kar bhaakhiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ) ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਰਾਣੀ ਨੂੰ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "तृय सौ बचन कोप करि भाखियो ॥",
      "sourceLineId": "137225",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੈ ਲੈ ਜਾਰ ਧਾਮ ਕਿਮਿ ਰਾਖਿਯੋ ॥",
      "transliteration": "tai lai jaar dhaam kim raakhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੂੰ ਘਰ ਵਿਚ ਯਾਰ ਨੂੰ ਕਿਵੇਾਂ ਰਖਿਆ ਹੋਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "तै लै जार धाम किमि राखियो ॥",
      "sourceLineId": "137226",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕੈ ਅਬ ਹੀ ਮੁਹਿ ਬਾਤ ਬਤਾਵੌ ॥",
      "transliteration": "kai ab hee muh baat bataavau ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਤਾ ਮੈਨੂੰ ਹੁਣ ਹੀ (ਸਾਰੀ) ਗੱਲ ਦਸ,",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "कै अब ही मुहि बात बतावौ ॥",
      "sourceLineId": "137227",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕੈ ਪ੍ਰਾਨਨ ਕੀ ਆਸ ਚੁਕਾਵੌ ॥੧੦॥",
      "transliteration": "kai praanan kee aas chukaavau ||10||",
      "translation": "",
      "punjabiViakhya": "ਨਹੀਂ ਤਾ ਪ੍ਰਾਣਾ ਦੀ ਆਸ ਖ਼ਤਮ ਕਰ ਦੇ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "कै प्रानन की आस चुकावौ ॥१०॥",
      "sourceLineId": "137228",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਾਤ ਸਤ੍ਯ ਜਾਨੀ ਜਿਯ ਰਾਨੀ ॥",
      "transliteration": "baat satay jaanee jiy raanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਮਨ ਵਿਚ ਸਚ ਜਾਣ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "बात सत्य जानी जिय रानी ॥",
      "sourceLineId": "137229",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮੁਝੈ ਨ ਨ੍ਰਿਪ ਛਾਡਤ ਅਭਿਮਾਨੀ ॥",
      "transliteration": "mujhai na nirap chhaaddat abhimaanee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ (ਹੁਣ) ਅਭਿਮਾਨੀ ਰਾਜਾ ਮੈਨੂੰ ਨਹੀਂ ਛਡੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "मुझै न नृप छाडत अभिमानी ॥",
      "sourceLineId": "137230",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਾਗ ਘੋਟਨਾ ਹਾਥ ਸੰਭਾਰਾ ॥",
      "transliteration": "bhaag ghoTanaa haath sa(n)bhaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਭੰਗ ਘੋਟਣ ਵਾਲਾ ਸੋਟਾ ਹੱਥ ਵਿਚ ਫੜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "भाग घोटना हाथ संभारा ॥",
      "sourceLineId": "137231",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਫੋਰਿ ਨਰਾਧਿਪ ਕੇ ਸਿਰ ਡਾਰਾ ॥੧੧॥",
      "transliteration": "for naraadhip ke sir ddaaraa ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਮਾਰ ਕੇ ਸਿਰ ਪਾੜ ਦਿੱਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "फोरि नराधिप के सिर डारा ॥११॥",
      "sourceLineId": "137232",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਹੁਰਿ ਸਭਨ ਇਹ ਭਾਤਿ ਸੁਨਾਈ ॥",
      "transliteration": "bahur sabhan ieh bhaat sunaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਫਿਰ ਸਾਰੀ ਪ੍ਰਜਾ ਦੇ ਲੋਕਾ ਨੂੰ ਬੁਲਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "बहुरि सभन इह भाति सुनाई ॥",
      "sourceLineId": "137233",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪ੍ਰਜਾ ਲੋਗ ਜਬ ਲਏ ਬੁਲਾਈ ॥",
      "transliteration": "prajaa log jab le bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "प्रजा लोग जब लए बुलाई ॥",
      "sourceLineId": "137234",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਦ ਕਰਿ ਭੂਪ ਭਯੋ ਮਤਵਾਰਾ ॥",
      "transliteration": "madh kar bhoop bhayo matavaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਰਾਬ ਪੀਣ ਕਰ ਕੇ ਰਾਜਾ ਮਤਵਾਲਾ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "मद करि भूप भयो मतवारा ॥",
      "sourceLineId": "137235",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਹਿਲ ਪੁਤ੍ਰ ਕੋ ਨਾਮ ਉਚਾਰਾ ॥੧੨॥",
      "transliteration": "pahil putr ko naam uchaaraa ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਹਿਲੇ ਪੁੱਤਰ ਦਾ ਨਾ ਲੈਣ ਲਗਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "पहिल पुत्र को नाम उचारा ॥१२॥",
      "sourceLineId": "137236",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮ੍ਰਿਤਕ ਪੁਤ੍ਰ ਕੋ ਨਾਮਹਿ ਲਯੋ ॥",
      "transliteration": "mritak putr ko naameh layo ||",
      "translation": "",
      "punjabiViakhya": "ਮਰੇ ਹੋਏ ਪੁੱਤਰ ਦਾ ਨਾ ਲੈ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "मृतक पुत्र को नामहि लयो ॥",
      "sourceLineId": "137237",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਤੇ ਅਧਿਕ ਦੁਖਾਤੁਰ ਭਯੋ ॥",
      "transliteration": "taa te adhik dhukhaatur bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦੁਖ ਨਾਲ ਆਤੁਰ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "ता ते अधिक दुखातुर भयो ॥",
      "sourceLineId": "137238",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੋਕ ਤਾਪ ਕੋ ਅਧਿਕ ਬਿਚਾਰਾ ॥",
      "transliteration": "sok taap ko adhik bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਗ ਦੇ ਦੁਖ ਨੂੰ ਅਧਿਕ ਵਿਚਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "सोक ताप को अधिक बिचारा ॥",
      "sourceLineId": "137239",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੂੰਡ ਫੋਰਿ ਭੀਤਨ ਸੌ ਡਾਰਾ ॥੧੩॥",
      "transliteration": "moo(n)dd for bheetan sau ddaaraa ||13||",
      "translation": "",
      "punjabiViakhya": "ਸਿਰ ਨੂੰ ਦੀਵਾਰਾ ਨਾਲ ਮਾਰ ਮਾਰ ਕੇ ਪਾੜ ਲਿਆ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "मूँड फोरि भीतन सौ डारा ॥१३॥",
      "sourceLineId": "137240",
      "sourceShabadId": "12705",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137241",
      "sourceShabadId": "12706",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਹ ਛਲ ਨਿਜੁ ਨਾਯਕ ਹਨਾ ਲੀਨਾ ਮਿਤ੍ਰ ਬਚਾਇ ॥",
      "transliteration": "eeh chhal nij naayak hanaa leenaa mitr bachai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਆਪਣੇ ਪਤੀ ਨੂੰ ਮਾਰ ਕੇ ਯਾਰ ਨੂੰ ਬਚਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "इह छल निजु नायक हना लीना मित्र बचाइ ॥",
      "sourceLineId": "137242",
      "sourceShabadId": "12706",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਹੁਰਿ ਭੋਗ ਤਾ ਸੌ ਕਰੋ ਕੋ ਨ ਸਕਾ ਛਲ ਪਾਇ ॥੧੪॥",
      "transliteration": "bahur bhog taa sau karo ko na sakaa chhal pai ||14||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਨਾਲ ਭੋਗ ਕੀਤਾ, ਪਰ ਉਸ ਦੇ ਛਲ ਨੂੰ ਕੋਈ ਵੀ ਨਾ ਪਾ ਸਕਿਆ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "बहुरि भोग ता सौ करो को न सका छल पाइ ॥१४॥",
      "sourceLineId": "137243",
      "sourceShabadId": "12706",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਉਨਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੭੯॥੬੮੩੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau unaasee charitr samaapatam sat subham sat ||379||6832||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੭੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੭੯॥੬੮੩੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ उनासी चरित्र समापतम सतु सुभम सतु ॥३७९॥६८३२॥अफजूँ॥",
      "sourceLineId": "137244",
      "sourceShabadId": "12706",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137245",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਏਕ ਚਰਿਤ੍ਰ ਸੈਨ ਰਾਜਾ ਬਰ ॥",
      "transliteration": "ek charitr sain raajaa bar ||",
      "translation": "",
      "punjabiViakhya": "ਚਰਿਤ੍ਰ ਸੈਨਾ ਨਾ ਦਾ ਇਕ ਚੰਗਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "एक चरित्र सैन राजा बर ॥",
      "sourceLineId": "137246",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਰਿ ਚਰਿਤ੍ਰ ਮਤੀ ਤਾ ਕੇ ਘਰ ॥",
      "transliteration": "naar charitr matee taa ke ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਚਰਿਤ੍ਰ ਮਤੀ ਨਾ ਦੀ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "नारि चरित्र मती ता के घर ॥",
      "sourceLineId": "137247",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਵਤੀ ਚਰਿਤ੍ਰਾ ਤਾ ਕੀ ਨਗਰੀ ॥",
      "transliteration": "vatee charitraa taa kee nagaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਚਰਿਤ੍ਰਾਵਤੀ ਨਗਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "वती चरित्रा ता की नगरी ॥",
      "sourceLineId": "137248",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਿਹੂੰ ਭਵਨ ਕੇ ਬੀਚ ਉਜਗਰੀ ॥੧॥",
      "transliteration": "tihoo(n) bhavan ke beech ujagaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਤਿੰਨਾ ਲੋਕਾ ਵਿਚ ਪ੍ਰਸਿੱਧ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "तिहूँ भवन के बीच उजगरी ॥१॥",
      "sourceLineId": "137249",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੋਪੀ ਰਾਇ ਸਾਹ ਸੁਤ ਇਕ ਤਹ ॥",
      "transliteration": "gopee rai saeh sut ik teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਗੋਪੀ ਰਾਇ ਸ਼ਾਹ ਦਾ ਇਕ ਪੁੱਤਰ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "गोपी राइ साह सुत इक तह ॥",
      "sourceLineId": "137250",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਹ ਸਮ ਸੁੰਦਰ ਦੁਤਿਯ ਨ ਜਗ ਮਹ ॥",
      "transliteration": "jeh sam su(n)dhar dhutiy na jag meh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਸੁੰਦਰ ਜਗਤ ਵਿਚ ਹੋਰ ਕੋਈ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "जिह सम सुँदर दुतिय न जग मह ॥",
      "sourceLineId": "137251",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਿਹ ਚਰਿਤ੍ਰ ਦੇ ਨੈਨ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "teh charitr dhe nain nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਚਰਿਤ੍ਰ ਦੇ (ਦੇਈ) ਨੇ ਅੱਖਾ ਨਾਲ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "तिह चरित्र दे नैन निहारियो ॥",
      "sourceLineId": "137252",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅੰਗ ਅੰਗ ਤਿਹ ਮਦਨ ਪ੍ਰਜਾਰਿਯੋ ॥੨॥",
      "transliteration": "a(n)g a(n)g teh madhan prajaariyo ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕਾਮ ਦੇਵ ਨੇ ਉਸ ਦਾ ਅੰਗ ਅੰਗ ਸਾੜ ਦਿੱਤਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "अंग अंग तिह मदन प्रजारियो ॥२॥",
      "sourceLineId": "137253",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਤਿਹ ਲਯੋ ਬੁਲਾਇ ॥",
      "transliteration": "jeh teh bidh teh layo bulai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "जिह तिह बिधि तिह लयो बुलाइ ॥",
      "sourceLineId": "137254",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਉਠਤ ਲਯੋ ਛਤਿਯਾ ਸੌ ਲਾਇ ॥",
      "transliteration": "auThat layo chhatiyaa sau lai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਠ ਕੇ ਛਾਤੀ ਨਾਲ ਲਗਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "उठत लयो छतिया सौ लाइ ॥",
      "sourceLineId": "137255",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਾਮ ਕੇਲ ਕੀਨੋ ਰੁਚਿ ਠਾਨੀ ॥",
      "transliteration": "kaam kel keeno ruch Thaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਰੁਚੀ ਪੂਰਵਕ ਕਾਮ-ਕੇਲਿ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "काम केल कीनो रुचि ठानी ॥",
      "sourceLineId": "137256",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕੇਲ ਕਰਤ ਸਭ ਰੈਨਿ ਬਿਹਾਨੀ ॥੩॥",
      "transliteration": "kel karat sabh rain bihaanee ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰਦਿਆਂ ਸਾਰੀ ਰਾਤ ਬੀਤ ਗਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "केल करत सभ रैनि बिहानी ॥३॥",
      "sourceLineId": "137257",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਈ ॥",
      "transliteration": "posat bhaag afeem ma(n)gaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪੋਸਤ, ਭੰਗ ਅਤੇ ਅਫ਼ੀਮ ਮੰਗਵਾ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "पोसत भाग अफीम मंगाई ॥",
      "sourceLineId": "137258",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਏਕ ਸੇਜ ਚੜਿ ਦੁਹੂੰ ਚੜਾਈ ॥",
      "transliteration": "ek sej chaR dhuhoo(n) chaRaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕੋ ਸੇਜ ਉਪਰ ਬੈਠ ਕੇ ਦੋਹਾ ਨੇ ਚੜ੍ਰਹਾ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "एक सेज चड़ि दुहूँ चड़ाई ॥",
      "sourceLineId": "137259",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਾਤਿ ਅਨਿਕ ਤਨ ਕਿਯੇ ਬਿਲਾਸਾ ॥",
      "transliteration": "bhaat anik tan kiye bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਤਾ ਪਿਤਾ ਦਾ ਡਰ ਮਨ ਵਿਚੋਂ (ਕਢ ਕੇ)",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "भाति अनिक तन किये बिलासा ॥",
      "sourceLineId": "137260",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਕੋ ਮਨ ਨ ਤ੍ਰਾਸਾ ॥੪॥",
      "transliteration": "maat pitaa ko man na traasaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਭੋਗ ਵਿਲਾਸ ਕੀਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "मात पिता को मन न त्रासा ॥४॥",
      "sourceLineId": "137261",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਬ ਲਗਿ ਆਇ ਗਯੋ ਤਾ ਕੌ ਪਤਿ ॥",
      "transliteration": "tab lag aai gayo taa kau pat ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਉਸ ਦਾ ਪਤੀ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "तब लगि आइ गयो ता कौ पति ॥",
      "sourceLineId": "137262",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਡਾਰਿ ਦਯੋ ਸੇਜਾ ਤਰ ਉਪ ਪਤਿ ॥",
      "transliteration": "ddaar dhayo sejaa tar up pat ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀ ਨੇ) ਉਪ-ਪਤੀ (ਭਾਵ ਯਾਰ) ਨੂੰ ਸੇਜ ਹੇਠਾ ਲੰਬਾ ਪਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "डारि दयो सेजा तर उप पति ॥",
      "sourceLineId": "137263",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੁਪਟਾ ਡਾਰਿ ਦਯੋ ਤਿਹ ਮੁਖ ਪਰ ॥",
      "transliteration": "dhupaTaa ddaar dhayo teh mukh par ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਮੂੰਹ ਉਤੇ ਦੁਪੱਟਾ ਪਾ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "दुपटा डारि दयो तिह मुख पर ॥",
      "sourceLineId": "137264",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਾਨ੍ਯੋ ਜਾਇ ਨ ਤਾ ਤੇ ਤ੍ਰਿਯ ਨਰ ॥੫॥",
      "transliteration": "jaanayo jai na taa te tiray nar ||5||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਕਰ ਕੇ ਇਹ) ਜਾਣਿਆ ਨਹੀਂ ਸੀ ਜਾ ਸਕਦਾ (ਕਿ ਉਹ) ਇਸਤਰੀ ਹੈ ਜਾ ਮਰਦ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "जान्यो जाइ न ता ते तृय नर ॥५॥",
      "sourceLineId": "137265",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1332_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੋਵਤ ਕਵਨ ਸੇਜ ਪਰ ਤੋਰੀ ॥",
      "transliteration": "sovat kavan sej par toree ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੇ ਆ ਕੇ ਪੁਛਿਆ) ਤੇਰੀ ਸੇਜ ਉਤੇ ਕੌਣ ਸੌਂ ਰਿਹਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1332,
      "hindi": "",
      "hindiTransliteration": "सोवत कवन सेज पर तोरी ॥",
      "sourceLineId": "137266",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
