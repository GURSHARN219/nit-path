{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1333,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1333_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਾਖੀ ਨਾਥ ਮਾਤ ਹੈ ਮੋਰੀ ॥",
      "transliteration": "bhaakhee naath maat hai moree ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀ ਨੇ) ਕਿਹਾ, ਹੇ ਨਾਥ! ਮੇਰੀ ਮਾਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "भाखी नाथ मात है मोरी ॥",
      "sourceLineId": "137267",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਮ ਪਹਿ ਤੋ ਨਹਿ ਜਾਤ ਜਗਾਈ ॥",
      "transliteration": "ham peh to neh jaat jagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਕੋਲੋਂ (ਇਸ ਨੂੰ) ਜਗਾਇਆ ਨਹੀਂ ਜਾ ਸਕਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "हम पहि तो नहि जात जगाई ॥",
      "sourceLineId": "137268",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤੁਮੈ ਕਹਤ ਹੌ ਬਾਧਿ ਢਿਠਾਈ ॥੬॥",
      "transliteration": "tumai kahat hau baadh ddiThaiee ||6||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੁਹਾਨੂੰ ਪੂਰੀ ਢੀਠਤਾਈ ਨਾਲ ਕਹਿ ਰਹੀ ਹਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "तुमै कहत हौ बाधि ढिठाई ॥६॥",
      "sourceLineId": "137269",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦ੍ਵੈਕ ਘਰੀ ਤੁਮ ਅਨਤ ਸਿਧਾਵਹੁ ॥",
      "transliteration": "dhavaik gharee tum anat sidhaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਦੋ ਕੁ ਘੜੀਆਂ ਕਿਤੇ ਹੋਰ ਬਿਤਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "द्वैक घरी तुम अनत सिधावहु ॥",
      "sourceLineId": "137270",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਹ ਉਠਿ ਗਏ ਬਹੁਰਿ ਹ੍ਯਾਂ ਆਵਹੁ ॥",
      "transliteration": "eeh uTh ge bahur hayaa(n) aavahu ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਇਹ ਉਠ ਜਾਏਗੀ ਤਾ ਫਿਰ ਇਥੇ ਆ ਜਾਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "इह उठि गए बहुरि ह्याँ आवहु ॥",
      "sourceLineId": "137271",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਬ ਜਾਗੈ ਤੇ ਅਧਿਕ ਰਿਸੈਹੈ ॥",
      "transliteration": "jab jaagai te adhik risaihai ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਜਾਗੇਗੀ ਤਾ ਬਹੁਤ ਗੁੱਸੇ ਵਿਚ ਹੋਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "जब जागै ते अधिक रिसैहै ॥",
      "sourceLineId": "137272",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਮ ਤੁਮ ਲਖਿ ਇਕਤ੍ਰ ਚੁਪ ਹ੍ਵੈਹੈ ॥੭॥",
      "transliteration": "ham tum lakh ikatr chup havaihai ||7||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਅਤੇ ਤੈਨੂੰ ਇਕੱਠਿਆਂ ਵੇਖ ਕੇ ਚੁਪ ਹੋ ਜਾਵੇਗੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "हम तुम लखि इकत्र चुप ह्वैहै ॥७॥",
      "sourceLineId": "137273",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਿਨਿ ਇਹ ਬਾਤ ਸਤ੍ਯ ਕਰਿ ਮਾਨੀ ॥",
      "transliteration": "tin ieh baat satay kar maanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ (ਪਤਨੀ ਦੀ) ਇਹ ਗੱਲ ਸਚ ਮੰਨ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "तिनि इह बात सत्य करि मानी ॥",
      "sourceLineId": "137274",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਾਤ ਭਯੋ ਉਠਿ ਕ੍ਰਿਯਾ ਨ ਜਾਨੀ ॥",
      "transliteration": "jaat bhayo uTh kirayaa na jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਿਨਾ (ਇਸ) ਖੇਲ ਨੂੰ ਸਮਝੇ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "जात भयो उठि कृया न जानी ॥",
      "sourceLineId": "137275",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਬ ਉਠਿ ਮਾਤ ਗਈ ਲਖਿ ਲੈਯਹੁ ॥",
      "transliteration": "jab uTh maat giee lakh laiyahu ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿ ਗਿਆ ਕਿ) ਜਦੋਂ ਮਾਤਾ ਨੂੰ ਉਠਿਆ ਵੇਖ ਲਈਂ",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "जब उठि मात गई लखि लैयहु ॥",
      "sourceLineId": "137276",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਬ ਹਮ ਕੌ ਤੁਮ ਬਹੁਰਿ ਬੁਲੈਯਹੁ ॥੮॥",
      "transliteration": "tab ham kau tum bahur bulaiyahu ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੈਨੂੰ ਫਿਰ ਬੁਲਾ ਲਈਂ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "तब हम कौ तुम बहुरि बुलैयहु ॥८॥",
      "sourceLineId": "137277",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇਮਿ ਕਹਿ ਬਾਤ ਜਾਤ ਜੜ ਭਯੋ ॥",
      "transliteration": "eim keh baat jaat jaR bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕਹਿ ਕੇ ਮੂਰਖ ਚਲਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "इमि कहि बात जात जड़ भयो ॥",
      "sourceLineId": "137278",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾਹਿ ਚੜਾਇ ਖਾਟ ਪਰ ਲਯੋ ॥",
      "transliteration": "taeh chaRai khaaT par layo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨੇ) ਉਸ (ਯਾਰ) ਨੂੰ ਮੰਜੇ ਉਤੇ ਚੜ੍ਰਹਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "ताहि चड़ाइ खाट पर लयो ॥",
      "sourceLineId": "137279",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭਾਤਿ ਅਨਿਕ ਤਨ ਕਰੈ ਬਿਲਾਸਾ ॥",
      "transliteration": "bhaat anik tan karai bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਅਨੇਕ ਢੰਗਾ ਨਾਲ ਵਿਲਾਸ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "भाति अनिक तन करै बिलासा ॥",
      "sourceLineId": "137280",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਆਵਤ ਭਯੋ ਤਿਹ ਪਿਤਾ ਨਿਵਾਸਾ ॥੯॥",
      "transliteration": "aavat bhayo teh pitaa nivaasaa ||9||",
      "translation": "",
      "punjabiViakhya": "(ਤਦੋਂ ਹੀ) ਉਸ ਦਾ ਪਿਤਾ ਘਰ ਆ ਗਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "आवत भयो तिह पिता निवासा ॥९॥",
      "sourceLineId": "137281",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਿਸੀ ਭਾਤਿ ਤਨ ਤਾਹਿ ਸੁਵਾਯੋ ॥",
      "transliteration": "tisee bhaat tan taeh suvaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਸੇ ਤਰ੍ਰਹਾ ਉਸ (ਪ੍ਰੇਮੀ) ਨੂੰ ਸੰਵਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "तिसी भाति तन ताहि सुवायो ॥",
      "sourceLineId": "137282",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾਤ ਭਏ ਇਹ ਭਾਤਿ ਜਤਾਯੋ ॥",
      "transliteration": "taat bhe ieh bhaat jataayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਿਤਾ ਦੇ ਆਣ ਤੇ ਇਸ ਤਰ੍ਰਹਾ ਦਸਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "तात भए इह भाति जतायो ॥",
      "sourceLineId": "137283",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੁਨਹੁ ਪਿਤਾ ਇਹ ਨਾਰਿ ਤਿਹਾਰੀ ॥",
      "transliteration": "sunahu pitaa ieh naar tihaaree ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪਿਤਾ ਜੀ! ਸੁਣੋ, ਇਹ ਤੁਹਾਡੀ ਇਸਤਰੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "सुनहु पिता इह नारि तिहारी ॥",
      "sourceLineId": "137284",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤੁਮ ਸੇ ਛਪੀ ਲਾਜ ਕੀ ਮਾਰੀ ॥੧੦॥",
      "transliteration": "tum se chhapee laaj kee maaree ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੁਹਾਡੇ ਤੋਂ ਲਾਜ ਦੀ ਮਾਰੀ ਲੁਕੀ ਹੋਈ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "तुम से छपी लाज की मारी ॥१०॥",
      "sourceLineId": "137285",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਨ੍ਰਿਪ ਧਾਮ ਸਿਧਾਨਾ ॥",
      "transliteration": "sunat bachan nirap dhaam sidhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਘਰ ਨੂੰ ਚਲਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन नृप धाम सिधाना ॥",
      "sourceLineId": "137286",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕਛੂ ਨ ਪਛਾਨਾ ॥",
      "transliteration": "bhedh abhedh kachhoo na pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਭੇਦ ਅਭੇਦ ਨੂੰ ਕੋਈ ਵੀ ਪਛਾਣ ਨਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद कछू न पछाना ॥",
      "sourceLineId": "137287",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਕੌ ਕਾਢਿ ਸੇਜ ਪਰ ਲੀਨਾ ॥",
      "transliteration": "taa kau kaadd sej par leenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਸ (ਯਾਰ) ਨੂੰ ਕਢ ਕੇ ਸੇਜ ਉਤੇ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "ता कौ काढि सेज पर लीना ॥",
      "sourceLineId": "137288",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਾ ਕੀ ਮਾਤ ਗਵਨ ਤਹ ਕੀਨਾ ॥੧੧॥",
      "transliteration": "taa kee maat gavan teh keenaa ||11||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਉਸ ਦੀ ਮਾਤਾ ਉਥੇ ਆ ਗਈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "ता की मात गवन तह कीना ॥११॥",
      "sourceLineId": "137289",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਵੈਸਹਿ ਤਾ ਕਹ ਦਿਯਾ ਸੁਵਾਇ ॥",
      "transliteration": "vaiseh taa keh dhiyaa suvai ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਉਸ ਨੇ) ਉਸ (ਯਾਰ) ਨੂੰ ਉਸੇ ਤਰ੍ਰਹਾ ਸੰਵਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "वैसहि ता कह दिया सुवाइ ॥",
      "sourceLineId": "137290",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਹੀ ਮਾਤ ਸੈ ਬਾਤ ਬਨਾਇ ॥",
      "transliteration": "kahee maat sai baat banai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਾਤਾ ਨੂੰ ਗੱਲ ਬਣਾ ਕੇ (ਇਸ ਤਰ੍ਰਹਾ) ਕਹੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "कही मात सै बात बनाइ ॥",
      "sourceLineId": "137291",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੁਨਹੁ ਮਾਤ ਜਾਮਾਤ ਤਿਹਾਰੋ ॥",
      "transliteration": "sunahu maat jaamaat tihaaro ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਮਾਤਾ! ਸੁਣੋ, ਤੁਹਾਡਾ ਜਵਾਈ ਸੁੱਤਾ ਪਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "सुनहु मात जामात तिहारो ॥",
      "sourceLineId": "137292",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮੋ ਕੋ ਅਧਿਕ ਪ੍ਰਾਨ ਤੇ ਪ੍ਯਾਰੋ ॥੧੨॥",
      "transliteration": "mo ko adhik praan te payaaro ||12||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਮੈਨੂੰ ਪ੍ਰਾਣਾ ਨਾਲੋਂ ਵੀ ਜ਼ਿਆਦਾ ਪਿਆਰਾ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "मो को अधिक प्रान ते प्यारो ॥१२॥",
      "sourceLineId": "137293",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਯਾ ਕੋ ਨੈਨ ਨੀਦ ਦੁਖ ਦਿਯੋ ॥",
      "transliteration": "yaa ko nain needh dhukh dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀਆਂ ਅੱਖਾ ਨੀਂਦਰ ਕਰ ਕੇ ਦੁਖ ਰਹੀਆਂ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "या को नैन नीद दुख दियो ॥",
      "sourceLineId": "137294",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾ ਤੇ ਸੈਨ ਸ੍ਰਮਿਤ ਹ੍ਵੈ ਕਿਯੋ ॥",
      "transliteration": "taa te sain sramit havai kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਥਕਿਆ ਹੋਇਆ ਸੌਂ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "ता ते सैन स्रमित ह्वै कियो ॥",
      "sourceLineId": "137295",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮੈ ਯਾ ਕੋ ਨਹਿ ਸਕਤ ਜਗਾਈ ॥",
      "transliteration": "mai yaa ko neh sakat jagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਇਸ ਨੂੰ ਜਗਾ ਨਹੀਂ ਸਕਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "मै या को नहि सकत जगाई ॥",
      "sourceLineId": "137296",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਬ ਹੀ ਸੋਇ ਗਯੋ ਸੁਖਦਾਈ ॥੧੩॥",
      "transliteration": "ab hee soi gayo sukhadhaiee ||13||",
      "translation": "",
      "punjabiViakhya": "ਕਿਉਾਂਕਿ ਹੁਣੇ ਹੀ (ਮੈਨੂੰ) ਸੁਖ ਦੇਣ ਵਾਲਾ ਸੌਂ ਗਿਆ ਹੈ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "अब ही सोइ गयो सुखदाई ॥१३॥",
      "sourceLineId": "137297",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੁਨਿ ਬਚ ਮਾਤ ਜਾਤ ਭੀ ਉਠ ਘਰ ॥",
      "transliteration": "sun bach maat jaat bhee uTh ghar ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਬੋਲ ਸੁਣ ਕੇ ਮਾਤਾ ਉਠ ਕੇ ਘਰ ਚਲੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "सुनि बच मात जात भी उठ घर ॥",
      "sourceLineId": "137298",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਲਯੋ ਸੇਜ ਪਰ ਤ੍ਰਿਯ ਪਿਯ ਭੁਜ ਭਰ ॥",
      "transliteration": "layo sej par tiray piy bhuj bhar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ ਨੇ ਪ੍ਰੀਤਮ ਨੂੰ ਬਾਹਵਾ ਨਾਲ ਜਫ਼ੀ ਮਾਰ ਕੇ ਸੇਜ ਉਤੇ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "लयो सेज पर तृय पिय भुज भर ॥",
      "sourceLineId": "137299",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਭੋਗ ਕਮਾਏ ॥",
      "transliteration": "bhaat bhaat tan bhog kamaae ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਭਾਤ ਭਾਤ ਦਾ ਰਮਣ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन भोग कमाए ॥",
      "sourceLineId": "137300",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਹੁਰਿ ਧਾਮ ਕੌ ਤਾਹਿ ਪਠਾਏ ॥੧੪॥",
      "transliteration": "bahur dhaam kau taeh paThaae ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਉਸ ਨੂੰ ਘਰ ਭੇਜ ਦਿੱਤਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "बहुरि धाम कौ ताहि पठाए ॥१४॥",
      "sourceLineId": "137301",
      "sourceShabadId": "12707",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137302",
      "sourceShabadId": "12708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਤਿਹ ਚੰਚਲਾਮ ਪਿਯਹਿ ਦਯੋ ਪਹੁਚਾਇ ॥",
      "transliteration": "eeh charitr teh cha(n)chalaam piyeh dhayo pahuchai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਨਾਲ ਉਸ ਇਤਸਰੀ ਨੇ ਪ੍ਰੀਤਮ ਨੂੰ (ਘਰ) ਪਹੁੰਚਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र तिह चंचलाम पियहि दयो पहुचाइ ॥",
      "sourceLineId": "137303",
      "sourceShabadId": "12708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਤ੍ਰਿਯਾਨ ਕੇ ਸਕਿਯੋ ਨ ਕੋਈ ਪਾਇ ॥੧੫॥",
      "transliteration": "bhedh abhedh tirayaan ke sakiyo na koiee pai ||15||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਦੇ ਭੇਦ ਅਭੇਦ ਨੂੰ ਕੋਈ ਵੀ ਪਾ ਨਹੀਂ ਸਕਿਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद तृयान के सकियो न कोई पाइ ॥१५॥",
      "sourceLineId": "137304",
      "sourceShabadId": "12708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੦॥੬੮੪੭॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau asee charitr samaapatam sat subham sat ||380||6847||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੮੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੮੦॥੬੮੪੭॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ असी चरित्र समापतम सतु सुभम सतु ॥३८०॥६८४७॥अफजूँ॥",
      "sourceLineId": "137305",
      "sourceShabadId": "12708",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137306",
      "sourceShabadId": "12709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੁਨਹੁ ਰਾਵ ਇਕ ਕਥਾ ਸ੍ਰਵਨ ਧਰਿ ॥",
      "transliteration": "sunahu raav ik kathaa sravan dhar ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਇਕ ਕਥਾ ਕੰਨ ਧਰ ਕੇ ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "सुनहु राव इक कथा स्रवन धरि ॥",
      "sourceLineId": "137307",
      "sourceShabadId": "12709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਹ ਬਿਧ ਕਿਯਾ ਚਰਿਤ੍ਰ ਤ੍ਰਿਯਾ ਬਰ ॥",
      "transliteration": "jeh bidh kiyaa charitr tirayaa bar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਦਾ ਇਕ ਸੁੰਦਰ ਇਸਤਰੀ ਨੇ ਚਰਿਤ੍ਰ ਕੀਤਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "जिह बिध किया चरित्र तृया बर ॥",
      "sourceLineId": "137308",
      "sourceShabadId": "12709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪੀਰ ਏਕ ਮੁਲਤਾਨ ਭਨਿਜੈ ॥",
      "transliteration": "peer ek mulataan bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਲਤਾਨ ਵਿਚ ਇਕ ਪੀਰ ਦਸੀਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "पीर एक मुलतान भनिजै ॥",
      "sourceLineId": "137309",
      "sourceShabadId": "12709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰੂਪਵੰਤ ਤਿਹ ਅਧਿਕ ਕਹਿਜੈ ॥੧॥",
      "transliteration": "roopava(n)t teh adhik kahijai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਬਹੁਤ ਰੂਪਵਾਨ ਕਿਹਾ ਜਾਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "रूपवंत तिह अधिक कहिजै ॥१॥",
      "sourceLineId": "137310",
      "sourceShabadId": "12709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰੋਸਨ ਕਦਰ ਤਵਨ ਕੋ ਨਾਮਾ ॥",
      "transliteration": "rosan kadhar tavan ko naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਰੌਸ਼ਨ ਕਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "रोसन कदर तवन को नामा ॥",
      "sourceLineId": "137311",
      "sourceShabadId": "12709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਥਕਿਤ ਰਹਿਤ ਜਿਹ ਨਿਰਖਤ ਬਾਮਾ ॥",
      "transliteration": "thakit rahit jeh nirakhat baamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਇਸਤਰੀ ਉਸ ਨੂੰ ਵੇਖਦੀ, ਸ਼ਿਥਲ ਹੋ ਜਾਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "थकित रहित जिह निरखत बामा ॥",
      "sourceLineId": "137312",
      "sourceShabadId": "12709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੋ ਨਿਰਖਤਿ ਤਿਯ ਪਤਿਹਿ ਨਿਹਾਰੈ ॥",
      "transliteration": "jo nirakhat tiy pateh nihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਇਸਤਰੀ ਉਸ) ਇਸਤਰੀ ਦੇ ਪਤੀ ਨੂੰ ਵੇਖਦੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "जो निरखति तिय पतिहि निहारै ॥",
      "sourceLineId": "137313",
      "sourceShabadId": "12709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1333_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਾ ਕੌ ਐਂਚ ਜੂਤਯਨ ਮਾਰੈ ॥੨॥",
      "transliteration": "taa kau aai(n)ch jootayan maarai ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੂੰ ਕਸ ਕੇ ਜੁਤੀਆਂ ਮਾਰਦੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1333,
      "hindi": "",
      "hindiTransliteration": "ता कौ ऐंच जूतयन मारै ॥२॥",
      "sourceLineId": "137314",
      "sourceShabadId": "12709",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
