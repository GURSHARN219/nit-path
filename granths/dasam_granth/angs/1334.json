{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1334,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1334_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "137315",
      "sourceShabadId": "12710",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਏਕ ਨਾਰ ਤਿਹ ਪਤਿ ਕੋ ਰੂਪ ਨਿਹਾਰਿ ਬਰ ॥",
      "transliteration": "ek naar teh pat ko roop nihaar bar ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਇਸਤਰੀ ਉਸ ਦੇ ਪਤੀ ਨੂੰ ਵੇਖ ਕੇ, ਉਸ ਨਾਲ ਫਸ ਗਈ (ਭਾਵ ਮੋਹਿਤ ਹੋ ਗਈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "एक नार तिह पति को रूप निहारि बर ॥",
      "sourceLineId": "137316",
      "sourceShabadId": "12710",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਹੀ ਮੁਬਤਲਾ ਹ੍ਵੈ ਇਮਿ ਚਰਿਤ ਬਿਚਾਰਿ ਕਰਿ ॥",
      "transliteration": "rahee mubatalaa havai im charit bichaar kar ||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚਣ ਲਗੀ ਕਿ) ਕੋਈ ਵਿਚਾਰ ਪੂਰਵਕ ਚਰਿਤ੍ਰ ਕੀਤਾ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "रही मुबतला ह्वै इमि चरित बिचारि करि ॥",
      "sourceLineId": "137317",
      "sourceShabadId": "12710",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਹ ਨਿਰਖੇ ਬਿਨੁ ਚੈਨ ਨ ਮੋ ਕੌ ਪਲ ਪਰੈ ॥",
      "transliteration": "eeh nirakhe bin chain na mo kau pal parai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਉਾਂਕਿ ਇਸ (ਪੀਰ) ਨੂੰ ਵੇਖੇ ਬਿਨਾ ਮੈਨੂੰ ਪਲ ਭਰ ਲਈ ਵੀ ਚੈਨ ਨਹੀਂ ਪੈਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "इह निरखे बिनु चैन न मो कौ पल परै ॥",
      "sourceLineId": "137318",
      "sourceShabadId": "12710",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹੋ ਜੌ ਨਿਰਖਤ ਹੌ ਤਾਹਿ ਤੁ ਰਾਰਹਿ ਤ੍ਰਿਯ ਕਰੈ ॥੩॥",
      "transliteration": "ho jau nirakhat hau taeh ta raareh tiray karai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੇ ਵੇਖਦੀ ਹਾ ਤਾ ਉਸ ਦੀ ਇਸਤਰੀ ਝਗੜਾ ਕਰਦੀ ਹੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "हो जौ निरखत हौ ताहि तु रारहि तृय करै ॥३॥",
      "sourceLineId": "137319",
      "sourceShabadId": "12710",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137320",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਿਸੀ ਤ੍ਰਿਯਾ ਕੇ ਧਾਮ ਸਿਧਾਈ ॥",
      "transliteration": "tisee tirayaa ke dhaam sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਆਖਿਰ ਸੋਚ ਵਿਚਾਰ ਕੇ ਉਹ) ਉਸ ਇਸਤਰੀ ਦੇ ਘਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "तिसी तृया के धाम सिधाई ॥",
      "sourceLineId": "137321",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਹੁਤਕ ਭੇਟ ਅਸਰਫੀ ਲ੍ਯਾਈ ॥",
      "transliteration": "bahutak bheT asarafee layaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੇਟਾ ਕਰਨ ਲਈ ਬਹੁਤ ਸਾਰੀਆਂ ਅਸ਼ਰਫ਼ੀਆਂ ਨਾਲ ਲਿਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "बहुतक भेट असरफी ल्याई ॥",
      "sourceLineId": "137322",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੇਵਰ ਦੀਨੇ ਜਰੇ ਜਰਾਇਨ ॥",
      "transliteration": "jevar dheene jare jarain ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਸੋਨੇ ਦੇ ਜੜਾਊ ਜ਼ੇਵਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "जेवर दीने जरे जराइन ॥",
      "sourceLineId": "137323",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਨ ਕੋ ਸਕਤ ਅੰਤ ਕੋਈ ਪਾਇਨ ॥੪॥",
      "transliteration": "jin ko sakat a(n)t koiee pain ||4||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦਾ ਅੰਤ ਕੌਣ ਪਾ ਸਕਦਾ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "जिन को सकत अंत कोई पाइन ॥४॥",
      "sourceLineId": "137324",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੁ ਸਭ ਦਈ ਤਿਹ ਸਾਥਿ ਕਹਾ ਇਮਿ ॥",
      "transliteration": "s sabh dhiee teh saath kahaa im ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸਭ ਕੁਝ ਉਸ ਦੇ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "सु सभ दई तिह साथि कहा इमि ॥",
      "sourceLineId": "137325",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਾਥ ਖਾਦਿਮਾ ਬਾਨੋ ਕੇ ਤਿਮਿ ॥",
      "transliteration": "saath khaadhimaa baano ke tim ||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ਾਦਮਾ ਬਾਨੋ ਨੂੰ,",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "साथ खादिमा बानो के तिमि ॥",
      "sourceLineId": "137326",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਏਕਹਿ ਆਸ ਹ੍ਯਾਂ ਮੈ ਆਈ ॥",
      "transliteration": "ekeh aas hayaa(n) mai aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਇਕ ਆਸ ਲੈ ਕੇ ਇਥੇ ਆਈ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "एकहि आस ह्याँ मै आई ॥",
      "sourceLineId": "137327",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੁ ਮੈ ਕਹਤ ਹੌ ਤੁਮੈ ਸੁਨਾਈ ॥੫॥",
      "transliteration": "s mai kahat hau tumai sunaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਉਹ ਤੁਹਾਨੂੰ ਕਹਿ ਕੇ ਸੁਣਾਦੀ ਹਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "सु मै कहत हौ तुमै सुनाई ॥५॥",
      "sourceLineId": "137328",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗ੍ਰਿਹ ਅਪਨੇ ਹੀ ਮਦਰੋ ਚ੍ਵਾਇ ॥",
      "transliteration": "gireh apane hee madharo chavaiai ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਆਪਣੇ ਘਰ ਦੀ ਕਢੀ ਹੋਈ ਸ਼ਰਾਬ",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "गृह अपने ही मदरो च्वाइ ॥",
      "sourceLineId": "137329",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਖਾਨਾ ਅਨਿਕ ਭਾਤਿ ਕੇ ਲ੍ਯਾਇ ॥",
      "transliteration": "khaanaa anik bhaat ke layai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਪ੍ਰਕਾਰ ਦੇ ਖਾਣੇ ਲਿਆਉਾਂਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "खाना अनिक भाति के ल्याइ ॥",
      "sourceLineId": "137330",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਿਜੁ ਹਾਥਨ ਲੈ ਦੁਹੂੰ ਪਯਾਊ ॥",
      "transliteration": "nij haathan lai dhuhoo(n) payaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਹੱਥਾ ਨਾਲ (ਤੁਹਾਨੂੰ) ਦੋਹਾ ਨੂੰ ਪਿਆਵਾ (ਖੁਆਵਾ) ਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "निजु हाथन लै दुहूँ पयाऊ ॥",
      "sourceLineId": "137331",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭੇਟ ਚੜਾਇ ਘਰਹਿ ਉਠਿ ਜਾਊ ॥੬॥",
      "transliteration": "bheT chaRai ghareh uTh jaauoo ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੇਟ ਚੜਾ ਕੇ ਘਰ ਨੂੰ ਚਲੀ ਜਾਵਾਗੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "भेट चड़ाइ घरहि उठि जाऊ ॥६॥",
      "sourceLineId": "137332",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋਈ ਮਦ ਲੈ ਤਹਾ ਸਿਧਾਈ ॥",
      "transliteration": "soiee madh lai tahaa sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸ਼ਰਾਬ ਉਸ ਨੇ ਸੱਤ ਵਾਰ ਕਈ ਢੰਗਾ ਨਾਲ ਕਢੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "सोई मद लै तहा सिधाई ॥",
      "sourceLineId": "137333",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਤ ਬਾਰ ਬਹੁ ਭਾਤਿ ਚੁਆਈ ॥",
      "transliteration": "saat baar bahu bhaat chuaaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਲੈ ਕੇ ਉਥੇ ਗਈ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "सात बार बहु भाति चुआई ॥",
      "sourceLineId": "137334",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਿਜੁ ਹਾਥਨ ਲੈ ਦੁਹੂੰ ਪਿਯਾਯੋ ॥",
      "transliteration": "nij haathan lai dhuhoo(n) piyaayo ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਹੱਥਾ ਨਾਲ ਦੋਹਾ ਨੂੰ ਪਿਲਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "निजु हाथन लै दुहूँ पियायो ॥",
      "sourceLineId": "137335",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਧਿਕ ਮਤ ਕਰਿ ਸੇਜ ਸੁਆਯੋ ॥੭॥",
      "transliteration": "adhik mat kar sej suaayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਨਸ਼ਿਆ ਕੇ ਸੇਜ ਉਤੇ ਸੰਵਾ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "अधिक मत करि सेज सुआयो ॥७॥",
      "sourceLineId": "137336",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋਈ ਲਖੀ ਪੀਰ ਤ੍ਰਿਯ ਜਬ ਹੀ ॥",
      "transliteration": "soiee lakhee peer tiray jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਪੀਰ ਦੀ ਇਸਤਰੀ ਨੂੰ ਸੁੱਤਾ ਹੋਇਆ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "सोई लखी पीर तृय जब ही ॥",
      "sourceLineId": "137337",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨੈਨ ਸੈਨ ਦੈ ਤਿਹ ਪ੍ਰਤਿ ਤਬ ਹੀ ॥",
      "transliteration": "nain sain dhai teh prat tab hee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ (ਪੀਰ) ਨੂੰ ਅੱਖ ਦਾ ਇਸ਼ਾਰਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "नैन सैन दै तिह प्रति तब ही ॥",
      "sourceLineId": "137338",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਾ ਕੇ ਧਰਿ ਛਤਿਯਾ ਪਰੁ ਚੂਤ੍ਰਨ ॥",
      "transliteration": "taa ke dhar chhatiyaa par chootran ||",
      "translation": "",
      "punjabiViakhya": "(ਪੀਰ ਦੀ) ਇਸਤਰੀ ਦੀ ਛਾਤੀ ਉਤੇ ਨਿਤੰਬ ਟਿਕਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "ता के धरि छतिया परु चूत्रन ॥",
      "sourceLineId": "137339",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਕੀਨਾ ਤਿਹ ਪਤਿ ਤਨ ॥੮॥",
      "transliteration": "kaam bhog keenaa teh pat tan ||8||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਪਤੀ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "काम भोग कीना तिह पति तन ॥८॥",
      "sourceLineId": "137340",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੋਵਤ ਰਹੀ ਚੜੇ ਮਦ ਨਾਰੀ ॥",
      "transliteration": "sovat rahee chaRe madh naaree ||",
      "translation": "",
      "punjabiViakhya": "(ਪੀਰ ਦੀ) ਇਸਤਰੀ (ਸ਼ਰਾਬ ਦੇ) ਨਸ਼ੇ ਵਿਚ ਬੇਹੋਸ਼ ਸੁਤੀ ਰਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "सोवत रही चड़े मद नारी ॥",
      "sourceLineId": "137341",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਕੀ ਗਤਿ ਨ ਬਿਚਾਰੀ ॥",
      "transliteration": "bhedh abhedh kee gat na bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੇਦ ਅਭੇਦ ਦੀ ਗਤਿ ਨੂੰ ਵਿਚਾਰ ਨਾ ਸਕੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद की गति न बिचारी ॥",
      "sourceLineId": "137342",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੀਠੀ ਏਕ ਲਿਖੀ ਨਿਜ ਅੰਗਾ ॥",
      "transliteration": "cheeThee ek likhee nij a(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਇਸਤਰੀ) ਨੇ ਆਪਣੇ ਹੱਥ ਨਾਲ ਚਿੱਠੀ ਲਿਖੀ",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "चीठी एक लिखी निज अंगा ॥",
      "sourceLineId": "137343",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਾਧਿ ਗਈ ਤਾ ਕੇ ਸਿਰ ਸੰਗਾ ॥੯॥",
      "transliteration": "baadh giee taa ke sir sa(n)gaa ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੀਰ ਦੀ ਇਸਤਰੀ ਦੇ ਸਿਰ ਨਾਲ ਬੰਨ੍ਰਹ ਕੇ ਚਲੀ ਗਈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "बाधि गई ता के सिर संगा ॥९॥",
      "sourceLineId": "137344",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੋ ਤ੍ਰਿਯ ਖ੍ਯਾਲ ਤ੍ਰਿਯਨ ਕੇ ਪਰਿ ਹੈ ॥",
      "transliteration": "jo tiray khayaal tirayan ke par hai ||",
      "translation": "",
      "punjabiViakhya": "(ਚਿੱਠੀ ਵਿਚ ਲਿਖ ਗਈ) ਜੋ ਇਸਤਰੀ (ਹੋਰਨਾ) ਇਸਤਰੀਆਂ ਦੇ ਖ਼ਿਆਲ ਪੈ ਜਾਦੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "जो तृय ख्याल तृयन के परि है ॥",
      "sourceLineId": "137345",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਕੀ ਬਿਧਿ ਐਸੀ ਗਤਿ ਕਰਿ ਹੈ ॥",
      "transliteration": "taa kee bidh aaisee gat kar hai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਵਿਧਾਤਾ ਉਨ੍ਰਹਾ ਦੀ ਇਸੇ ਤਰ੍ਰਹਾ ਦੀ ਹਾਲਤ ਕਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "ता की बिधि ऐसी गति करि है ॥",
      "sourceLineId": "137346",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਤੇ ਤੁਮ ਤ੍ਰਿਯ ਐਸ ਨ ਕੀਜੈ ॥",
      "transliteration": "taa te tum tiray aais na keejai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਹੇ ਇਸਤਰੀ! ਤੂੰ ਇਸ ਤਰ੍ਰਹਾ ਨਾ ਕਰਿਆ ਕਰ",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "ता ते तुम तृय ऐस न कीजै ॥",
      "sourceLineId": "137347",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬੁਰੋ ਸੁਭਾਇ ਸਕਲ ਤਜਿ ਦੀਜੈ ॥੧੦॥",
      "transliteration": "buro subhai sakal taj dheejai ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣਾ ਸਾਰਾ ਭੈੜਾ ਸੁਭਾ ਛਡ ਦੇ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "बुरो सुभाइ सकल तजि दीजै ॥१०॥",
      "sourceLineId": "137348",
      "sourceShabadId": "12711",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137349",
      "sourceShabadId": "12712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕੇਸ ਪਾਸ ਤੇ ਛੋਰਿ ਕੈ ਬਾਚਤ ਪਤਿਯਾ ਅੰਗ ॥",
      "transliteration": "kes paas te chhor kai baachat patiyaa a(n)g ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਇਸਤਰੀ ਨੇ) ਵਾਲਾ ਦੀਆਂ ਜ਼ੁਲਫ਼ਾ ਨਾਲੋਂ ਖੋਲ੍ਰਹ ਕੇ ਚਿੱਠੀ ਪੜ੍ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "केस पास ते छोरि कै बाचत पतिया अंग ॥",
      "sourceLineId": "137350",
      "sourceShabadId": "12712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਾ ਦਿਨ ਤੇ ਤ੍ਰਿਯ ਤਜਿ ਦਿਯਾ ਬਾਦ ਤ੍ਰਿਯਨ ਕੇ ਸੰਗ ॥੧੧॥",
      "transliteration": "taa dhin te tiray taj dhiyaa baadh tirayan ke sa(n)g ||11||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਦਿਨ ਤੋਂ ਉਸ ਇਸਤਰੀ ਨੇ ਹੋਰਨਾ ਇਸਤਰੀਆਂ ਨਾਲ ਝਗੜਾ ਕਰਨਾ ਛਡ ਦਿੱਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "ता दिन ते तृय तजि दिया बाद तृयन के संग ॥११॥",
      "sourceLineId": "137351",
      "sourceShabadId": "12712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕਆਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੧॥੬੮੫੮॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau ikaasee charitr samaapatam sat subham sat ||381||6858||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੮੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੮੧॥੬੮੫੮॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ इकआसी चरित्र समापतम सतु सुभम सतु ॥३८१॥६८५८॥अफजूँ॥",
      "sourceLineId": "137352",
      "sourceShabadId": "12712",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137353",
      "sourceShabadId": "12713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਸਨ ਧੁਜਾ ਇਕ ਭੂਪ ਸੁਲਛਨ ॥",
      "transliteration": "bisan dhujaa ik bhoop sulachhan ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਸ਼ਨ ਧੁਜਾ ਨਾ ਦਾ ਇਕ ਸੁਲਖਣਾ ਰਾਜਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "बिसन धुजा इक भूप सुलछन ॥",
      "sourceLineId": "137354",
      "sourceShabadId": "12713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਿਸਨਪੁਰੀ ਜਾ ਕੀ ਦਿਸਿ ਦਛਿਨ ॥",
      "transliteration": "bisanapuree jaa kee dhis dhachhin ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਬਿਸ਼ਨਪੁਰੀ (ਨਗਰੀ) ਦੱਖਣ ਦਿਸ਼ਾ ਵਿਚ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "बिसनपुरी जा की दिसि दछिन ॥",
      "sourceLineId": "137355",
      "sourceShabadId": "12713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸ੍ਰੀ ਮਨਿ ਨੀਲ ਮਤੀ ਤਿਹ ਰਾਨੀ ॥",
      "transliteration": "sree man neel matee teh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਨੀਲ ਮਨਿ ਮਤੀ ਉਸ ਦੀ ਰਾਣੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "स्री मनि नील मती तिह रानी ॥",
      "sourceLineId": "137356",
      "sourceShabadId": "12713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁੰਦਰਿ ਸਕਲ ਭਵਨ ਮੌ ਜਾਨੀ ॥੧॥",
      "transliteration": "su(n)dhar sakal bhavan mau jaanee ||1||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸਾਰਿਆਂ ਲੋਕਾ ਵਿਚ ਸੁੰਦਰ ਮੰਨੀ ਜਾਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "सुँदरि सकल भवन मौ जानी ॥१॥",
      "sourceLineId": "137357",
      "sourceShabadId": "12713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਛਲੀ ਰਾਇ ਏਕ ਤਹ ਛਤ੍ਰੀ ॥",
      "transliteration": "achhalee rai ek teh chhatree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਅਛਲੀ ਰਾਇ ਨਾ ਦਾ ਇਕ ਛਤ੍ਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "अछली राइ एक तह छत्री ॥",
      "sourceLineId": "137358",
      "sourceShabadId": "12713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੂਰਬੀਰ ਬਲਵਾਨ ਨਿਛਤ੍ਰੀ ॥",
      "transliteration": "soorabeer balavaan nichhatree ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਸ਼ੂਰਵੀਰ, ਬਲਵਾਨ ਅਤੇ 'ਨਿਛਤ੍ਰੀ' (ਸ਼ਸਤ੍ਰ ਸਹਿਤ ਅਥਵਾ ਛਤ੍ਰ ਤੋਂ ਰਹਿਤ) ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "सूरबीर बलवान निछत्री ॥",
      "sourceLineId": "137359",
      "sourceShabadId": "12713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਦਨ ਪ੍ਰਭਾ ਤਿਹ ਜਾਤ ਨ ਭਾਖੀ ॥",
      "transliteration": "badhan prabhaa teh jaat na bhaakhee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਮੁਖ ਦੀ ਸੁੰਦਰਤਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "बदन प्रभा तिह जात न भाखी ॥",
      "sourceLineId": "137360",
      "sourceShabadId": "12713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਨੁ ਮੁਖ ਚੀਰ ਚਾਦ ਕੀ ਰਾਖੀ ॥੨॥",
      "transliteration": "jan mukh cheer chaadh kee raakhee ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਚੰਦ੍ਰਮਾ (ਦੀ ਕਲਾ) ਨੂੰ ਚੀਰ ਕੇ ਮੁਖ ਵਿਚ ਰਖ ਦਿੱਤਾ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1334,
      "hindi": "",
      "hindiTransliteration": "जनु मुख चीर चाद की राखी ॥२॥",
      "sourceLineId": "137361",
      "sourceShabadId": "12713",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1334_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤ੍ਰਿਯ ਕੀ ਪ੍ਰੀਤਿ ਤਵਨ ਸੌ ਲਾਗੀ ॥",
      "transliteration": "tiray kee preet tavan sau laagee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਦੀ ਪ੍ਰੀਤ ਉਸ ਨਾਲ ਲਗ ਗਈ,",
      "source": "DASAM_GRANTH",
