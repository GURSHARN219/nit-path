{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1336,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1336_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਤੀਬ੍ਰਤਾ ਨਾਰੀ ਕਹ ਜਾਨ੍ਯੋ ॥",
      "transliteration": "pateebrataa naaree keh jaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਇਸਤਰੀ ਨੂੰ ਪਤਿਬ੍ਰਤਾ ਸਮਝਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "पतीब्रता नारी कह जान्यो ॥",
      "sourceLineId": "137411",
      "sourceShabadId": "12716",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਿਰ ਪਰ ਧਰਿ ਪਲਕਾ ਪਰ ਨਚਾ ॥",
      "transliteration": "sir par dhar palakaa par nachaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਿਰ ਉਤੇ ਮੰਜੀ ਨੂੰ ਚੁਕ ਕੇ ਨਚਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "सिर पर धरि पलका पर नचा ॥",
      "sourceLineId": "137412",
      "sourceShabadId": "12716",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਜਾਰਿ ਨਾਰਿ ਜੁਤ ਬਚਾ ॥੯॥",
      "transliteration": "eeh bidh jaar naar jut bachaa ||9||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਯਾਰ ਨਾਰੀ ਸਮੇਤ ਬਚ ਗਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "इह बिधि जारि नारि जुत बचा ॥९॥",
      "sourceLineId": "137413",
      "sourceShabadId": "12716",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤਿਰਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੩॥੬੮੭੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau tiraasee charitr samaapatam sat subham sat ||383||6872||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੮੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੮੩॥੬੮੭੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ तिरासी चरित्र समापतम सतु सुभम सतु ॥३८३॥६८७२॥अफजूँ॥",
      "sourceLineId": "137414",
      "sourceShabadId": "12716",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137415",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਦਾ ਸਿੰਘ ਇਕ ਭੂਪ ਮਹਾ ਮਨਿ ॥",
      "transliteration": "sadhaa si(n)gh ik bhoop mahaa man ||",
      "translation": "",
      "punjabiViakhya": "ਸਦਾ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਉਦਾਰ ਮਨ ਵਾਲਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "सदा सिंघ इक भूप महा मनि ॥",
      "sourceLineId": "137416",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਦਾਪੁਰੀ ਜਾ ਕੀ ਪਛਿਮ ਭਨਿ ॥",
      "transliteration": "sadhaapuree jaa kee pachhim bhan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸਦਾਪੁਰੀ (ਨਾ ਦੀ ਨਗਰੀ) ਪੱਛਮ ਵਿਚ ਦਸੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "सदापुरी जा की पछिम भनि ॥",
      "sourceLineId": "137417",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸ੍ਰੀ ਸੁਲੰਕ ਦੇ ਤਾ ਕੀ ਨਾਰੀ ॥",
      "transliteration": "sree sula(n)k dhe taa kee naaree ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਲੰਕ ਦੇ (ਦੇਈ) ਉਸ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "स्री सुलंक दे ता की नारी ॥",
      "sourceLineId": "137418",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਨੁਕ ਚੰਦ੍ਰ ਤੇ ਚੀਰਿ ਨਿਕਾਰੀ ॥੧॥",
      "transliteration": "januk cha(n)dhr te cheer nikaaree ||1||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਤਨੀ ਸੁੰਦਰ ਸੀ) ਮਾਨੋ ਚੰਦ੍ਰਮਾ ਨੂੰ ਚੀਰ ਕੇ ਕਢੀ ਹੋਵੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "जनुक चंद्र ते चीरि निकारी ॥१॥",
      "sourceLineId": "137419",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਹ ਇਕ ਹੋਤ ਸਾਹ ਧਨਵਾਨਾ ॥",
      "transliteration": "teh ik hot saeh dhanavaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਧਨਵਾਨ ਸ਼ਾਹ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "तह इक होत साह धनवाना ॥",
      "sourceLineId": "137420",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਿਰਧਨ ਕਰਿ ਡਾਰਿਯੋ ਭਗਵਾਨਾ ॥",
      "transliteration": "niradhan kar ddaariyo bhagavaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਪਰਮਾਤਮਾ ਨੇ ਗ਼ਰੀਬ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "निरधन करि डारियो भगवाना ॥",
      "sourceLineId": "137421",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਧਿਕ ਚਤੁਰਿ ਤਾ ਕੀ ਇਕ ਨਾਰੀ ॥",
      "transliteration": "adhik chatur taa kee ik naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਇਕ ਬਹੁਤ ਚਾਲਾਕ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "अधिक चतुरि ता की इक नारी ॥",
      "sourceLineId": "137422",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਨ ਤਾ ਸੌ ਇਹ ਭਾਤਿ ਉਚਾਰੀ ॥੨॥",
      "transliteration": "tin taa sau ieh bhaat uchaaree ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸ਼ਾਹ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "तिन ता सौ इह भाति उचारी ॥२॥",
      "sourceLineId": "137423",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰਿ ਹੌ ਬਹੁਰਿ ਤੁਮੈ ਧਨਵੰਤਾ ॥",
      "transliteration": "kar hau bahur tumai dhanava(n)taa ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਪਰਮਾਤਮਾ ਨੇ ਕ੍ਰਿਪਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "करि हौ बहुरि तुमै धनवंता ॥",
      "sourceLineId": "137424",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਕਰੈ ਜੋ ਸ੍ਰੀ ਭਗਵੰਤਾ ॥",
      "transliteration": "kirapaa karai jo sree bhagava(n)taa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਤੈਨੂੰ ਫਿਰ ਧਨਵਾਨ ਬਣਾ ਦਿਆਂਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "कृपा करै जो स्री भगवंता ॥",
      "sourceLineId": "137425",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਆਪਨ ਭੇਸ ਪੁਰਖ ਕੋ ਧਾਰੋ ॥",
      "transliteration": "aapan bhes purakh ko dhaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਪਣਾ ਭੇਸ ਪੁਰਸ਼ ਦਾ ਧਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "आपन भेस पुरख को धारो ॥",
      "sourceLineId": "137426",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਜ ਬਾਟ ਪਰ ਹਾਟ ਉਸਾਰੋ ॥੩॥",
      "transliteration": "raaj baaT par haaT usaaro ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ-ਮਾਰਗ ਉਤੇ ਦੁਕਾਨ ਬਣਾ ਲਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "राज बाट पर हाट उसारो ॥३॥",
      "sourceLineId": "137427",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਏਕਨ ਦਰਬ ਉਧਾਰੋ ਦਿਯੋ ॥",
      "transliteration": "ekan dharab udhaaro dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਕਨਾ ਨੂੰ ਧਨ ਉਧਾਰ ਦਿੰਦੀ",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "एकन दरब उधारो दियो ॥",
      "sourceLineId": "137428",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਏਕਨ ਤੇ ਰਾਖਨ ਹਿਤ ਲਿਯੋ ॥",
      "transliteration": "ekan te raakhan hit liyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕਨਾ ਤੋਂ ਰਖਣ ਲਈ ਲੈਂਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "एकन ते राखन हित लियो ॥",
      "sourceLineId": "137429",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਧਿਕ ਆਪਨੀ ਪਤਿਹਿ ਚਲਾਯੋ ॥",
      "transliteration": "adhik aapanee pateh chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਆਪਣੀ ਬਹੁਤ ਪਤਿ (ਪ੍ਰਤਿਸ਼ਠਾ, ਸਾਖ) ਬਣਾ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "अधिक आपनी पतिहि चलायो ॥",
      "sourceLineId": "137430",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਹ ਤਹ ਸਕਲ ਧਨਿਨ ਸੁਨਿ ਪਾਯੋ ॥੪॥",
      "transliteration": "jeh teh sakal dhanin sun paayo ||4||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਗੱਲ) ਜਿਥੇ ਕਿਥੇ ਧਨਵਾਨਾ ਨੇ ਸੁਣ ਲਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "जह तह सकल धनिन सुनि पायो ॥४॥",
      "sourceLineId": "137431",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੋਫੀ ਸੂਮ ਸਾਹ ਇਕ ਤਹਾ ॥",
      "transliteration": "sofee soom saeh ik tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਕੰਜੂਸ ਸੋਫ਼ੀ (ਪਰਹੇਜ਼ਗਾਰ) ਸ਼ਾਹ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "सोफी सूम साह इक तहा ॥",
      "sourceLineId": "137432",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾ ਕੇ ਘਰ ਸੁਨਿਯਤ ਧਨ ਮਹਾ ॥",
      "transliteration": "jaa ke ghar suniyat dhan mahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਘਰ ਬਹੁਤ ਅਧਿਕ ਧਨ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "जा के घर सुनियत धन महा ॥",
      "sourceLineId": "137433",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁਤ ਤ੍ਰਿਯ ਕੋ ਨਹਿ ਕਰਤ ਬਿਸ੍ਵਾਸਾ ॥",
      "transliteration": "sut tiray ko neh karat bisavaiaasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪੁੱਤਰ, ਇਸਤਰੀ ਆਦਿ ਕਿਸੇ ਉਤੇ ਵੀ ਵਿਸ਼ਵਾਸ ਨਹੀਂ ਕਰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "सुत तृय को नहि करत बिस्वासा ॥",
      "sourceLineId": "137434",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਾਖਤ ਦਰਬ ਆਪਨੇ ਪਾਸਾ ॥੫॥",
      "transliteration": "raakhat dharab aapane paasaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧਨ ਨੂੰ ਆਪਣੇ ਕੋਲ ਹੀ ਰਖਦਾ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "राखत दरब आपने पासा ॥५॥",
      "sourceLineId": "137435",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਾਹ ਸੁਈ ਤਿਹ ਨਾਰਿ ਤਕਾਯੋ ॥",
      "transliteration": "saeh suiee teh naar takaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸ਼ਾਹ ਨੂੰ ਉਸ ਇਸਤਰੀ ਨੇ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "साह सुई तिह नारि तकायो ॥",
      "sourceLineId": "137436",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਧਿਕ ਪ੍ਰੀਤ ਕਰਿ ਤਾਹਿ ਬੁਲਾਯੋ ॥",
      "transliteration": "adhik preet kar taeh bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਪ੍ਰੇਮ ਜਤਾ ਕੇ ਉਸ ਨੂੰ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "अधिक प्रीत करि ताहि बुलायो ॥",
      "sourceLineId": "137437",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤ੍ਰਿਯ ਸੁਤ ਮਾਲ ਕਹਾ ਤਵ ਖੈ ਹੈ ॥",
      "transliteration": "tiray sut maal kahaa tav khai hai ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿਣ ਲਗੀ ਕਿ ਤੇਰੀ ਇਸਤਰੀ ਅਤੇ ਪੁੱਤਰ ਹੀ (ਸਾਰਾ) ਮਾਲ ਖਾ ਜਾਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "तृय सुत माल कहा तव खै है ॥",
      "sourceLineId": "137438",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਏਕ ਦਾਮ ਫਿਰਿ ਤੁਮੈ ਨ ਦੈ ਹੈ ॥੬॥",
      "transliteration": "ek dhaam fir tumai na dhai hai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੈਨੂੰ ਫਿਰ ਇਕ ਦਾਮ ਵੀ ਨਹੀਂ ਦੇਣਗੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "एक दाम फिरि तुमै न दै है ॥६॥",
      "sourceLineId": "137439",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਹ ਮਾਲ ਕਹੂੰ ਅਨਤ ਰਖਾਇ ॥",
      "transliteration": "saeh maal kahoo(n) anat rakhai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਹੇ ਸ਼ਾਹ ਜੀ! (ਤੁਸੀਂ ਆਪਣਾ) ਮਾਲ ਕਿਤੇ ਹੋਰ ਰਖ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "साह माल कहूँ अनत रखाइ ॥",
      "sourceLineId": "137440",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਰਖਤ ਤਾ ਤੇ ਲੇਹੁ ਲਿਖਾਇ ॥",
      "transliteration": "sarakhat taa te leh likhai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਤੋਂ ਰਸੀਦ ('ਸਰਖਤ') ਲਿਖਵਾ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "सरखत ता ते लेहु लिखाइ ॥",
      "sourceLineId": "137441",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਾਤ ਪੂਤ ਕੋਈ ਭੇਦ ਨ ਪਾਵੈ ॥",
      "transliteration": "maat poot koiee bhedh na paavai ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਤਾ ਅਤੇ ਪੁੱਤਰ ਨੂੰ ਬਿਲਕੁਲ ਪਤਾ ਨਾ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "मात पूत कोई भेद न पावै ॥",
      "sourceLineId": "137442",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤੁਮ ਹੀ ਚਹਹੁ ਤਬੈ ਧਨ ਆਵੈ ॥੭॥",
      "transliteration": "tum hee chahahu tabai dhan aavai ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਦੋਂ ਤੁਸੀਂ ਚਾਹੋ, ਤਦੋਂ ਧਨ ਆ ਜਾਵੇ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "तुम ही चहहु तबै धन आवै ॥७॥",
      "sourceLineId": "137443",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਚਨ ਬਹੁਰਿ ਤਿਨ ਸਾਹ ਬਖਾਨੋ ॥",
      "transliteration": "bachan bahur tin saeh bakhaano ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸ਼ਾਹ ਨੇ ਬਚਨ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "बचन बहुरि तिन साह बखानो ॥",
      "sourceLineId": "137444",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੁਮ ਤੇ ਔਰ ਭਲੋ ਨਹਿ ਜਾਨੋ ॥",
      "transliteration": "tum te aauar bhalo neh jaano ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੁਹਾਡੇ ਵਰਗਾ ਭਲਾ (ਮਨੁੱਖ) ਹੋਰ ਕੋਈ ਨਹੀਂ ਜਾਣਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "तुम ते और भलो नहि जानो ॥",
      "sourceLineId": "137445",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੇਰੋ ਸਕਲ ਦਰਬੁ ਤੈ ਲੇਹਿ ॥",
      "transliteration": "mero sakal dharab tai leh ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਮੇਰਾ ਸਾਰਾ ਧਨ ਲੈ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "मेरो सकल दरबु तै लेहि ॥",
      "sourceLineId": "137446",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਰਖਤ ਗੁਪਤ ਮੁਝੈ ਲਿਖਿ ਦੇਹਿ ॥੮॥",
      "transliteration": "sarakhat gupat mujhai likh dheh ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਗੁਪਤ ਰੂਪ ਵਿਚ ਰਸੀਦ ਲਿਖ ਦਿਓ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "सरखत गुपत मुझै लिखि देहि ॥८॥",
      "sourceLineId": "137447",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬੀਸ ਲਾਖ ਤਾ ਤੇ ਧਨ ਲਿਯਾ ॥",
      "transliteration": "bees laakh taa te dhan liyaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਵੀਹ ਲੱਖ (ਰੁਪੈਯੇ) ਧਨ ਵਜੋਂ ਲੈ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "बीस लाख ता ते धन लिया ॥",
      "sourceLineId": "137448",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਰਖਤ ਏਕ ਤਾਹਿ ਲਿਖਿ ਦਿਯਾ ॥",
      "transliteration": "sarakhat ek taeh likh dhiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਇਕ ਰਸੀਦ ਲਿਖੀ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "सरखत एक ताहि लिखि दिया ॥",
      "sourceLineId": "137449",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਾਜੂ ਬੰਦ ਬੀਚ ਇਹ ਰਖਿਯਹੁ ॥",
      "transliteration": "baajoo ba(n)dh beech ieh rakhiyahu ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਇਸਤਰੀ ਨੇ ਸਮਝਾਇਆ ਕਿ) ਇਸ (ਰਸੀਦ) ਨੂੰ ਬਾਜੂਬੰਦ ਵਿਚ ਰਖਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "बाजू बंद बीच इह रखियहु ॥",
      "sourceLineId": "137450",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਵਰ ਪੁਰਖ ਸੌ ਭੇਵ ਨ ਭਖਿਯਹੁ ॥੯॥",
      "transliteration": "avar purakh sau bhev na bhakhiyahu ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਕਿਸੇ ਪੁਰਸ਼ ਨੂੰ ਭੇਦ ਨਾ ਦਸਣਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "अवर पुरख सौ भेव न भखियहु ॥९॥",
      "sourceLineId": "137451",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੈ ਧਨ ਸਾਹ ਜਬੈ ਘਰ ਗਯੋ ॥",
      "transliteration": "dhai dhan saeh jabai ghar gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸ਼ਾਹ ਧਨ ਦੇ ਕੇ ਘਰ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "दै धन साह जबै घर गयो ॥",
      "sourceLineId": "137452",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੇਖ ਮਜੂਰਨ ਕੋ ਤਿਨ ਲਯੋ ॥",
      "transliteration": "bhekh majooran ko tin layo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ (ਇਸਤਰੀ) ਨੇ ਮਜ਼ਦੂਰਨ ਦਾ ਭੇਸ ਧਾਰਨ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "भेख मजूरन को तिन लयो ॥",
      "sourceLineId": "137453",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਧਾਮ ਤਿਸੀ ਕੇ ਕਿਯਾ ਪਯਾਨਾ ॥",
      "transliteration": "dhaam tisee ke kiyaa payaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਵਲ ਹੀ ਚਲ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "धाम तिसी के किया पयाना ॥",
      "sourceLineId": "137454",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਤਿਨ ਮੂੜ ਨ ਜਾਨਾ ॥੧੦॥",
      "transliteration": "bhedh abhedh tin mooR na jaanaa ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ (ਸ਼ਾਹ) ਨੇ ਭੇਦ ਅਭੇਦ ਨਾ ਸਮਝਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद तिन मूड़ न जाना ॥१०॥",
      "sourceLineId": "137455",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਹੀ ਕਿ ਏਕ ਟੂਕ ਮੁਹਿ ਦੇਹੁ ॥",
      "transliteration": "kahee k ek Took muh dheh ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਸ਼ਾਹ ਨੂੰ) ਕਿਹਾ ਕਿ ਮੈਨੂੰ ਰੋਟੀ ਦਾ ਇਕ ਟੁਕੜਾ ਦੇਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "कही कि एक टूक मुहि देहु ॥",
      "sourceLineId": "137456",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪਾਨ ਭਰਾਇਸ ਗਰਦਨਿ ਲੇਹੁ ॥",
      "transliteration": "paan bharais garadhan leh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗਰਦਨ ਉਪਰ ਪਾਣੀ ਭਰਵਾਉਣ (ਦਾ ਕੰਮ) ਲੈਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "पान भराइस गरदनि लेहु ॥",
      "sourceLineId": "137457",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1336_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਖਰਚ ਜਾਨਿ ਥੋਰੋ ਤਿਨ ਕਰੋ ॥",
      "transliteration": "kharach jaan thoro tin karo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਆਪਣਾ ਥੋੜਾ ਖਰਚ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1336,
      "hindi": "",
      "hindiTransliteration": "खरच जानि थोरो तिन करो ॥",
      "sourceLineId": "137458",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
