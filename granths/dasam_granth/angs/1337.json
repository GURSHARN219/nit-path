{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1337,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1337_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨਹਿ ਨੈਕੁ ਬਿਚਰੋ ॥੧੧॥",
      "transliteration": "bhedh abhedh neh naik bicharo ||11||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਵਿਚ) ਕਿਸੇ ਪ੍ਰਕਾਰ ਦਾ ਕੋਈ ਭੇਦ ਅਭੇਦ ਨਾ ਵਿਚਾਰੋ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद नहि नैकु बिचरो ॥११॥",
      "sourceLineId": "137459",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਬ ਹੀ ਘਾਤ ਨਾਰਿ ਤਿਨ ਪਾਈ ॥",
      "transliteration": "jab hee ghaat naar tin paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਇਸਤਰੀ ਨੂੰ ਮੌਕਾ ਲਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "जब ही घात नारि तिन पाई ॥",
      "sourceLineId": "137460",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਾਜੂ ਬੰਦ ਲਯੋ ਸਰਕਾਈ ॥",
      "transliteration": "baajoo ba(n)dh layo sarakaiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਾਜੂਬੰਦ ਨੂੰ ਖਿਸਕਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "बाजू बंद लयो सरकाई ॥",
      "sourceLineId": "137461",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਪਨੀ ਕਬਜ ਕਾਢਿ ਕਰਿ ਲਈ ॥",
      "transliteration": "apanee kabaj kaadd kar liee ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੀ ਰਸੀਦ ('ਕਬਜ') ਕਢ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "अपनी कबज काढि करि लई ॥",
      "sourceLineId": "137462",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਤ ਕੀ ਡਾਰਿ ਤਵਨ ਮੈ ਗਈ ॥੧੨॥",
      "transliteration": "sat kee ddaar tavan mai giee ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੌ (ਰੁਪੈਏ ਦੀ ਲਿਖ ਕੇ) ਉਸ ਵਿਚ ਪਾ ਚਲੀ ਗਈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "सत की डारि तवन मै गई ॥१२॥",
      "sourceLineId": "137463",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿਤਕ ਦਿਨਨ ਕਹਿ ਦੇਹ ਰੁਪਇਯਾ ॥",
      "transliteration": "kitak dhinan keh dheh rupiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਦਿਨਾ ਬਾਦ (ਸ਼ਾਹ ਨੇ) ਰੁਪੈਯਾ ਦੇਣ ਲਈ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "कितक दिनन कहि देह रुपइया ॥",
      "sourceLineId": "137464",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਠੈ ਦਯੋ ਇਕ ਤਾਹਿ ਮਨਇਯਾ ॥",
      "transliteration": "paThai dhayo ik taeh maniyaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਥੇ ਇਕ ਬੰਦਾ ('ਮਨਇਯਾ' ਮਨੁੱਖ) ਭੇਜ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "पठै दयो इक ताहि मनइया ॥",
      "sourceLineId": "137465",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਏਕ ਹਜਾਰ ਤਹਾ ਤੋ ਲ੍ਯਾਵਹੁ ॥",
      "transliteration": "ek hajaar tahaa to layaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ (ਉਹ) ਉਥੋਂ ਇਕ ਹਜ਼ਾਰ ਰੁਪੈਯਾ ਲੈ ਆਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "एक हजार तहा तो ल्यावहु ॥",
      "sourceLineId": "137466",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਨਿ ਬਨਿਜ ਕੋ ਕਾਜ ਚਲਾਵਹੁ ॥੧੩॥",
      "transliteration": "aan banij ko kaaj chalaavahu ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਿਆ ਕੇ ਵਪਾਰ ਦਾ ਕੰਮ ਚਲਾਵੇ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "आनि बनिज को काज चलावहु ॥१३॥",
      "sourceLineId": "137467",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਿਨਕ ਹਜਾਰ ਨ ਤਾ ਕੌ ਦਿਯਾ ॥",
      "transliteration": "tinak hajaar na taa kau dhiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਇਸਤਰੀ) ਨੇ ਉਸ ਨੂੰ ਇਕ ਹਜ਼ਾਰ ਰੁਪੈਯਾ ਨਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "तिनक हजार न ता कौ दिया ॥",
      "sourceLineId": "137468",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਯ ਮੈ ਕੋਪ ਸਾਹ ਤਬ ਕਿਯਾ ॥",
      "transliteration": "jiy mai kop saeh tab kiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸ਼ਾਹ ਨੇ ਮਨ ਵਿਚ ਗੁੱਸਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "जिय मै कोप साह तब किया ॥",
      "sourceLineId": "137469",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਾਧਿ ਲੈ ਗਯੋ ਤਾ ਕਹ ਤਹਾ ॥",
      "transliteration": "baadh lai gayo taa keh tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬੰਨ੍ਰਹ ਕੇ ਉਥੇ ਲੈ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "बाधि लै गयो ता कह तहा ॥",
      "sourceLineId": "137470",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਾਜੀ ਕੋਟਵਾਰ ਥੋ ਜਹਾ ॥੧੪॥",
      "transliteration": "kaajee koTavaar tho jahaa ||14||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਾਜ਼ੀ ਅਤੇ ਕੋਤਵਾਲ ਸਨ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "काजी कोटवार थो जहा ॥१४॥",
      "sourceLineId": "137471",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੋ ਤੇ ਬੀਸ ਲਾਖ ਇਨ ਲਿਯਾ ॥",
      "transliteration": "mo te bees laakh in liyaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਨੇ ਮੇਰੇ ਕੋਲੋਂ ਵੀਹ ਲੱਖ (ਰੁਪੈਯਾ) ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "मो ते बीस लाख इन लिया ॥",
      "sourceLineId": "137472",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਬ ਇਨ ਮੁਝੈ ਹਜਾਰ ਨ ਦਿਯਾ ॥",
      "transliteration": "ab in mujhai hajaar na dhiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਇਸ ਨੇ ਮੈਨੂੰ ਇਕ ਹਜ਼ਾਰ ਵੀ ਨਹੀਂ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "अब इन मुझै हजार न दिया ॥",
      "sourceLineId": "137473",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਹੀ ਸਭੋ ਸਰਖਤ ਤਿਹ ਹੇਰੋ ॥",
      "transliteration": "kahee sabho sarakhat teh hero ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੇ ਕਿਹਾ, ਇਸ ਦੀ ਰਸੀਦ ਵੇਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "कही सभो सरखत तिह हेरो ॥",
      "sourceLineId": "137474",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਨ ਕੋ ਅਬ ਹੀ ਨ੍ਯਾਇ ਨਿਬੇਰੋ ॥੧੫॥",
      "transliteration": "ein ko ab hee nayai nibero ||15||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਨਾਲ ਹੁਣ ਹੀ ਇਨਸਾਫ਼ ਦਾ ਨਿਬੇੜਾ ਕਰੋ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "इन को अब ही न्याइ निबेरो ॥१५॥",
      "sourceLineId": "137475",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਛੋਰਿ ਸਰਖਤਹਿ ਸਭਨ ਨਿਹਾਰੋ ॥",
      "transliteration": "chhor sarakhateh sabhan nihaaro ||",
      "translation": "",
      "punjabiViakhya": "ਰਸੀਦ ਨੂੰ ਖੋਲ੍ਰਹ ਕੇ ਸਾਰਿਆਂ ਨੇ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "छोरि सरखतहि सभन निहारो ॥",
      "sourceLineId": "137476",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰੁਪਯਾ ਸੌ ਇਕ ਤਹਾ ਬਿਚਾਰੋ ॥",
      "transliteration": "rupayaa sau ik tahaa bichaaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਕੇਵਲ ਇਕ ਸੌ ਰੁਪੈਯਾ (ਲਿਖਿਆ) ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "रुपया सौ इक तहा बिचारो ॥",
      "sourceLineId": "137477",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਚਾ ਤੇ ਝੂਠਾ ਤਿਹ ਕਿਯਾ ॥",
      "transliteration": "saachaa te jhooThaa teh kiyaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸੱਚੇ ਨੂੰ ਝੂਠਾ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "साचा ते झूठा तिह किया ॥",
      "sourceLineId": "137478",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਭ ਧਨੁ ਹਰੋ ਕਾਢਿ ਤਿਹ ਦਿਯਾ ॥੧੬॥",
      "transliteration": "sabh dhan haro kaadd teh dhiyaa ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਹ) ਸਾਰਾ ਧਨ ਹਰ ਲਿਆ (ਜੋ ਉਸ ਨੇ) ਕਢ ਕੇ ਉਸ ਨੂੰ ਦਿੱਤਾ ਸੀ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "सभ धनु हरो काढि तिह दिया ॥१६॥",
      "sourceLineId": "137479",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਹੁਰਿ ਬਚਨ ਤਿਨ ਨਾਰਿ ਉਚਾਰੇ ॥",
      "transliteration": "bahur bachan tin naar uchaare ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਇਸਤਰੀ ਨੇ ਸ਼ਾਹ ਨੂੰ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "बहुरि बचन तिन नारि उचारे ॥",
      "sourceLineId": "137480",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੈ ਨ ਰਹਤ ਹੌ ਗਾਵ ਤਿਹਾਰੇ ॥",
      "transliteration": "mai na rahat hau gaav tihaare ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਹੁਣ ਤੁਹਾਡੇ ਪਿੰਡ ਵਿਚ ਨਹੀਂ ਰਹਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "मै न रहत हौ गाव तिहारे ॥",
      "sourceLineId": "137481",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਯੌ ਕਹਿ ਜਾਤ ਤਹਾ ਤੇ ਭਈ ॥",
      "transliteration": "yau keh jaat tahaa te bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ ਉਥੋਂ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "यौ कहि जात तहा ते भई ॥",
      "sourceLineId": "137482",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੋਫੀ ਯਹਿ ਕੂਟਿ ਭੰਗੇਰੀ ਗਈ ॥੧੭॥",
      "transliteration": "sofee yeh kooT bha(n)geree giee ||17||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਭੰਗ ਪੀਣ ਵਾਲੀ ਸੋਫ਼ੀ ਨੂੰ ਲੁਟ ਕੇ ਲੈ ਗਈ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "सोफी यहि कूटि भंगेरी गई ॥१७॥",
      "sourceLineId": "137483",
      "sourceShabadId": "12717",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137484",
      "sourceShabadId": "12718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਿਰਧਨ ਤੇ ਧਨਵੰਤ ਭੀ ਕਰਿ ਤਿਹ ਧਨ ਕੀ ਹਾਨਿ ॥",
      "transliteration": "niradhan te dhanava(n)t bhee kar teh dhan kee haan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਧਨ ਦੀ ਹਾਨੀ ਕਰ ਕੇ (ਭਾਵ ਲੁਟ ਕੇ) ਉਹ ਨਿਰਧਨ ਤੋਂ ਧਨਵਾਨ ਬਣ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "निरधन ते धनवंत भी करि तिह धन की हानि ॥",
      "sourceLineId": "137485",
      "sourceShabadId": "12718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੋਫੀ ਕਹ ਅਮਲਿਨ ਛਰਾ ਦੇਖਤ ਸਕਲ ਜਹਾਨ ॥੧੮॥",
      "transliteration": "sofee keh amalin chharaa dhekhat sakal jahaan ||18||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਜਹਾਨ ਦੇ ਵੇਖਦੇ ਹੋਇਆਂ (ਉਸ) ਸੋਫ਼ੀ ਨੂੰ ਅਮਲ ਕਰਨ ਵਾਲੀ ਨੇ ਛਲ ਲਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "सोफी कह अमलिन छरा देखत सकल जहान ॥१८॥",
      "sourceLineId": "137486",
      "sourceShabadId": "12718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚਉਰਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੪॥੬੮੯੦॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chauraasee charitr samaapatam sat subham sat ||384||6890||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੮੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੮੪॥੬੮੯੦॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ चउरासी चरित्र समापतम सतु सुभम सतु ॥३८४॥६८९०॥अफजूँ॥",
      "sourceLineId": "137487",
      "sourceShabadId": "12718",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137488",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚਿਤ੍ਰ ਕੇਤੁ ਰਾਜਾ ਇਕ ਪੂਰਬ ॥",
      "transliteration": "chitr ket raajaa ik poorab ||",
      "translation": "",
      "punjabiViakhya": "ਪੂਰਬ ਵਿਚ ਇਕ ਚਿਤ੍ਰ ਕੇਤੁ ਨਾ ਦਾ ਰਾਜਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "चित्र केतु राजा इक पूरब ॥",
      "sourceLineId": "137489",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਹ ਬਚਿਤ੍ਰ ਰਥ ਪੁਤ੍ਰ ਅਪੂਰਬ ॥",
      "transliteration": "jeh bachitr rath putr apoorab ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਬਚਿਤ੍ਰ ਰਥ ਨਾ ਦਾ ਅਦੁੱਤੀ ਪੁੱਤਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "जिह बचित्र रथ पुत्र अपूरब ॥",
      "sourceLineId": "137490",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚਿਤ੍ਰਾਪੁਰ ਨਗਰ ਤਿਹ ਸੋਹੈ ॥",
      "transliteration": "chitraapur nagar teh sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਚਿਤ੍ਰਾਪੁਰ ਨਗਰ ਸ਼ੋਭਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "चित्रापुर नगर तिह सोहै ॥",
      "sourceLineId": "137491",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਿਹ ਢਿਗ ਦੇਵ ਦੈਤ ਪੁਰ ਕੋ ਹੈ ॥੧॥",
      "transliteration": "jeh ddig dhev dhait pur ko hai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸਾਹਮਣੇ ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਦੀਆਂ ਪੁਰੀਆਂ ਕੀ ਸਨ (ਭਾਵ ਕੁਝ ਵੀ ਨਹੀਂ ਸਨ) ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "जिह ढिग देव दैत पुर को है ॥१॥",
      "sourceLineId": "137492",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸ੍ਰੀ ਕਟਿ ਉਤਿਮ ਦੇ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "sree kaT utim dhe teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਕਟਿ ਉਤਿਮ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "स्री कटि उतिम दे तिह नारी ॥",
      "sourceLineId": "137493",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੂਰਜ ਵਤ ਤਿਹ ਧਾਮ ਦੁਲਾਰੀ ॥",
      "transliteration": "sooraj vat teh dhaam dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਸੂਰਜ ਵਰਗੀ ਪੁੱਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "सूरज वत तिह धाम दुलारी ॥",
      "sourceLineId": "137494",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਹ ਸਮ ਸੁੰਦਰਿ ਨਾਰਿ ਨ ਕੋਈ ॥",
      "transliteration": "jeh sam su(n)dhar naar na koiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਹੋਰ ਕੋਈ ਸੁੰਦਰ ਇਸਤਰੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "जिह सम सुँदरि नारि न कोई ॥",
      "sourceLineId": "137495",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਗੇ ਭਈ ਨ ਪਾਛੇ ਹੋਈ ॥੨॥",
      "transliteration": "aage bhiee na paachhe hoiee ||2||",
      "translation": "",
      "punjabiViakhya": "(ਉਹੋ ਜਿਹੀ) ਨਾ ਅਗੇ ਹੋਈ ਹੈ ਅਤੇ ਨਾ ਬਾਦ ਵਿਚ ਹੋਵੇਗੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "आगे भई न पाछे होई ॥२॥",
      "sourceLineId": "137496",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਾਨੀ ਰਾਇ ਤਹਾ ਇਕ ਸਾਹਾ ॥",
      "transliteration": "baanee rai tahaa ik saahaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਨੀ ਰਾਇ ਨਾ ਦਾ ਉਥੇ ਇਕ ਸ਼ਾਹ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "बानी राइ तहा इक साहा ॥",
      "sourceLineId": "137497",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਿਹ ਮੁਖੁ ਸਮ ਸੁੰਦਰਿ ਨਹਿ ਮਾਹਾ ॥",
      "transliteration": "jeh mukh sam su(n)dhar neh maahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਮੁਖ ਵਰਗਾ ਸੁੰਦਰ ਚੰਦ੍ਰਮਾ ('ਮਾਹਾ') ਵੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "जिह मुखु सम सुँदरि नहि माहा ॥",
      "sourceLineId": "137498",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸ੍ਰੀ ਗੁਲਜਾਰ ਰਾਇ ਸੁਤ ਤਾ ਕੇ ॥",
      "transliteration": "sree gulajaar rai sut taa ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ (ਘਰ) ਗੁਲਜ਼ਾਰ ਰਾਇ ਨਾ ਦਾ ਪੁੱਤਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "स्री गुलजार राइ सुत ता के ॥",
      "sourceLineId": "137499",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੇਵ ਦੈਤ ਕੋਇ ਤੁਲਿ ਨ ਵਾ ਕੇ ॥੩॥",
      "transliteration": "dhev dhait koi tul na vaa ke ||3||",
      "translation": "",
      "punjabiViakhya": "ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਵਿਚੋਂ ਕੋਈ ਵੀ ਉਸ ਦੇ ਬਰਾਬਰ ਨਹੀਂ ਸੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "देव दैत कोइ तुलि न वा के ॥३॥",
      "sourceLineId": "137500",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰਾਜ ਸੁਤਾ ਤਾ ਕੋ ਲਖਿ ਰੂਪਾ ॥",
      "transliteration": "raaj sutaa taa ko lakh roopaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਸ ਦਾ ਰੂਪ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "राज सुता ता को लखि रूपा ॥",
      "sourceLineId": "137501",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮੋਹਿ ਰਹੀ ਮਨ ਮਾਹਿ ਅਨੂਪਾ ॥",
      "transliteration": "moh rahee man maeh anoopaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਵਿਚ (ਉਸ) ਅਨੂਪ ਉਤੇ ਮੋਹਿਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "मोहि रही मन माहि अनूपा ॥",
      "sourceLineId": "137502",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਏਕ ਸਹਚਰੀ ਤਹਾ ਪਠਾਈ ॥",
      "transliteration": "ek sahacharee tahaa paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਸਹੇਲੀ ਉਥੇ ਭੇਜੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "एक सहचरी तहा पठाई ॥",
      "sourceLineId": "137503",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਭਾਤਿ ਤਹਾ ਲੈ ਆਈ ॥੪॥",
      "transliteration": "jeh teh bhaat tahaa lai aaiee ||4||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਜਾ ਕੇ) ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨੂੰ ਉਥੇ ਲੈ ਆਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "जिह तिह भाति तहा लै आई ॥४॥",
      "sourceLineId": "137504",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਿਲਤ ਕੁਅਰਿ ਤਾ ਸੌ ਸੁਖੁ ਪਾਯੋ ॥",
      "transliteration": "milat kuar taa sau sukh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਸ ਨੂੰ ਮਿਲ ਕੇ ਬਹੁਤ ਸੁਖ ਪ੍ਰਾਪਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "मिलत कुअरि ता सौ सुखु पायो ॥",
      "sourceLineId": "137505",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਮਿਲਿ ਭੋਗ ਕਮਾਯੋ ॥",
      "transliteration": "bhaat bhaat mil bhog kamaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨਾਲ) ਮਿਲ ਕੇ ਭਾਤ ਭਾਤ ਦਾ ਰਮਣ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "भाति भाति मिलि भोग कमायो ॥",
      "sourceLineId": "137506",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਚੁੰਬਨ ਭਾਤਿ ਭਾਤਿ ਕੇ ਲੀਏ ॥",
      "transliteration": "chu(n)ban bhaat bhaat ke le'ee ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਤਰ੍ਰਹਾ ਦੇ ਚੁੰਬਨ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "चुँबन भाति भाति के लीए ॥",
      "sourceLineId": "137507",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਭਾਤਿ ਅਨਿਕ ਕੇ ਆਸਨ ਕੀਏ ॥੫॥",
      "transliteration": "bhaat anik ke aasan ke'ee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕ ਢੰਗਾ ਦੇ ਆਸਣ ਕੀਤੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "भाति अनिक के आसन कीए ॥५॥",
      "sourceLineId": "137508",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤਬ ਲਗਿ ਮਾਤ ਪਿਤਾ ਤਹ ਆਯੋ ॥",
      "transliteration": "tab lag maat pitaa teh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਉਸ ਦੇ ਮਾਤਾ ਪਿਤਾ ਉਥੇ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "तब लगि मात पिता तह आयो ॥",
      "sourceLineId": "137509",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਿਰਖਿ ਸੁਤਾ ਚਿਤ ਮੈ ਦੁਖ ਪਾਯੋ ॥",
      "transliteration": "nirakh sutaa chit mai dhukh paayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਵੇਖ ਕੇ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਮਨ ਵਿਚ ਦੁਖ ਮਹਿਸੂਸ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "निरखि सुता चित मै दुख पायो ॥",
      "sourceLineId": "137510",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਿਹ ਛਲ ਸੌ ਇਹ ਦੁਹੂੰ ਸੰਘਾਰੋ ॥",
      "transliteration": "keh chhal sau ieh dhuhoo(n) sa(n)ghaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚਣਾ ਲਗੀ ਕਿ) ਕਿਸੇ ਛਲ ਨਾਲ ਇਨ੍ਰਹਾ ਦੋਹਾ ਨੂੰ ਮਾਰ ਦਿਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "किह छल सौ इह दुहूँ संघारो ॥",
      "sourceLineId": "137511",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਛਤ੍ਰ ਜਾਰ ਕੇ ਸਿਰ ਪਰ ਢਾਰੋ ॥੬॥",
      "transliteration": "chhatr jaar ke sir par ddaaro ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਯਾਰ ਦੇ ਸਿਰ ਉਤੇ ਛਤ੍ਰ ਝੁਲਾ ਦਿਆਂ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "छत्र जार के सिर पर ढारो ॥६॥",
      "sourceLineId": "137512",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਦੁਹੂੰਅਨ ਕੇ ਫਾਸੀ ਗਰੁ ਡਾਰੀ ॥",
      "transliteration": "dhuhoo(n)an ke faasee gar ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ (ਮਾਤਾ ਪਿਤਾ) ਦੇ ਗੱਲ ਵਿਚ ਫਾਹੀ ਪਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "दुहूँअन के फासी गरु डारी ॥",
      "sourceLineId": "137513",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਪਿਤਾ ਸਹਿਤ ਮਾਤਾ ਹਨਿ ਡਾਰੀ ॥",
      "transliteration": "pitaa sahit maataa han ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਿਤਾ ਸਮੇਤ ਮਾਤਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "पिता सहित माता हनि डारी ॥",
      "sourceLineId": "137514",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਫਾਸ ਕੰਠ ਤੇ ਲਈ ਨਕਾਰੀ ॥",
      "transliteration": "faas ka(n)Th te liee nakaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਉਨ੍ਰਹਾ ਦੇ) ਗਲਿਆਂ ਵਿਚ ਫਾਹੀ ਕਢ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "फास कंठ ते लई नकारी ॥",
      "sourceLineId": "137515",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਬੋਲਿ ਲੋਗ ਸਭ ਐਸ ਉਚਾਰੀ ॥੭॥",
      "transliteration": "bol log sabh aais uchaaree ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੋਕਾ ਨੂੰ ਬੁਲਾ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "बोलि लोग सभ ऐस उचारी ॥७॥",
      "sourceLineId": "137516",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਇਨ ਦੁਹੂੰ ਜੋਗ ਸਾਧਨਾ ਸਾਧੀ ॥",
      "transliteration": "ein dhuhoo(n) jog saadhanaa saadhee ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਦੋਹਾ ਨੇ ਯੋਗ ਸਾਧਨਾ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "इन दुहूँ जोग साधना साधी ॥",
      "sourceLineId": "137517",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਨ੍ਰਿਪ ਰਾਨੀ ਜੁਤ ਪਵਨ ਅਰਾਧੀ ॥",
      "transliteration": "nirap raanee jut pavan araadhee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਰਾਣੀ ਸਮੇਤ ਪ੍ਰਾਣਾਯਾਮ ਕੀਤਾ ਹੈ (ਅਰਥਾਤ ਪ੍ਰਾਣਾ ਨੂੰ ਦਸਮ ਦੁਆਰ ਚੜ੍ਰਹਾ ਲਿਆ ਹੈ)।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "नृप रानी जुत पवन अराधी ॥",
      "sourceLineId": "137518",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਬਾਰਹ ਬਰਿਸ ਬੀਤ ਹੈ ਜਬ ਹੀ ॥",
      "transliteration": "baareh baris beet hai jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਬਾਰ੍ਰਹਾ ਸਾਲ ਬੀਤ ਜਾਣਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "बारह बरिस बीत है जब ही ॥",
      "sourceLineId": "137519",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਜਗਿ ਹੈ ਛਾਡਿ ਤਾਰਿਯਹਿ ਤਬ ਹੀ ॥੮॥",
      "transliteration": "jag hai chhaadd taariyeh tab hee ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਹ ਸਮਾਧੀ ਛਡ ਕੇ (ਭਾਵ-ਖੋਲ੍ਰਹ ਕੇ) ਜਾਗ ਜਾਣਗੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "जगि है छाडि तारियहि तब ही ॥८॥",
      "sourceLineId": "137520",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਤਬ ਲਗਿ ਤਾਤ ਦਿਯਾ ਮੁਹਿ ਰਾਜਾ ॥",
      "transliteration": "tab lag taat dhiyaa muh raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਪਿਤਾ ਜੀ ਨੇ ਮੈਨੂੰ ਰਾਜ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "तब लगि तात दिया मुहि राजा ॥",
      "sourceLineId": "137521",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਰਾਜ ਸਾਜ ਕਾ ਸਕਲ ਸਮਾਜਾ ॥",
      "transliteration": "raaj saaj kaa sakal samaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਦਾ ਹੋਰ ਸਾਰਾ ਠਾਠ-ਬਾਠ (ਵੀ ਸੌਂਪਿਆ) ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "राज साज का सकल समाजा ॥",
      "sourceLineId": "137522",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਤਬ ਲਗਿ ਤਾ ਕੋ ਰਾਜ ਕਮੈ ਹੋ ॥",
      "transliteration": "tab lag taa ko raaj kamai ho ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ (ਮੈਂ) ਉਨ੍ਰਹਾ ਦਾ ਰਾਜ ਚਲਾਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "तब लगि ता को राज कमै हो ॥",
      "sourceLineId": "137523",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਜਬ ਜਗ ਹੈ ਤਾ ਕੌ ਤਬ ਦੈ ਹੋ ॥੯॥",
      "transliteration": "jab jag hai taa kau tab dhai ho ||9||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਹ ਜਾਗਣਗੇ ਤਾ ਉਨ੍ਰਹਾ ਨੂੰ ਦੇ ਦਿਆਂਗੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "जब जग है ता कौ तब दै हो ॥९॥",
      "sourceLineId": "137524",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਇਹ ਛਲ ਤਾਤ ਮਾਤ ਕਹ ਘਾਈ ॥",
      "transliteration": "eeh chhal taat maat keh ghaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਮਾਤਾ ਪਿਤਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "इह छल तात मात कह घाई ॥",
      "sourceLineId": "137525",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਲੋਗਨ ਸੌ ਇਹ ਭਾਤਿ ਜਨਾਈ ॥",
      "transliteration": "logan sau ieh bhaat janaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੋਕਾ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਦਸ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "लोगन सौ इह भाति जनाई ॥",
      "sourceLineId": "137526",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਜਬ ਅਪਨੋ ਦ੍ਰਿੜ ਰਾਜ ਪਕਾਯੋ ॥",
      "transliteration": "jab apano dhiraR raaj pakaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੇ ਆਪਣਾ ਰਾਜ ਪੱਕਾ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "जब अपनो दृड़ राज पकायो ॥",
      "sourceLineId": "137527",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਛਤ੍ਰ ਮਿਤ੍ਰ ਕੇ ਸੀਸ ਫਿਰਾਯੋ ॥੧੦॥",
      "transliteration": "chhatr mitr ke sees firaayo ||10||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ ਫਿਰ) ਰਾਜ-ਛਤ੍ਰ ਮਿਤਰ ਦੇ ਸਿਰ ਉਤੇ ਝੁਲਾ ਦਿੱਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "छत्र मित्र के सीस फिरायो ॥१०॥",
      "sourceLineId": "137528",
      "sourceShabadId": "12719",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137529",
      "sourceShabadId": "12720",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1337_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਤਾਤ ਮਾਤ ਇਹ ਭਾਤਿ ਹਨਿ ਦਿਯੋ ਮਿਤ੍ਰ ਕੌ ਰਾਜ ॥",
      "transliteration": "taat maat ieh bhaat han dhiyo mitr kau raaj ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਤਾ ਪਿਤਾ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਮਾਰ ਦਿੱਤਾ ਮਿਤਰ ਨੂੰ ਰਾਜ ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1337,
      "hindi": "",
      "hindiTransliteration": "तात मात इह भाति हनि दियो मित्र कौ राज ॥",
      "sourceLineId": "137530",
      "sourceShabadId": "12720",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
