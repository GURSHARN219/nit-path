{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1338,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1338_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਕਤ ਨ ਕੋਈ ਪਛਾਨਿ ਕਰਿ ਚੰਚਲਾਨ ਕੇ ਕਾਜ ॥੧੧॥",
      "transliteration": "sakat na koiee pachhaan kar cha(n)chalaan ke kaaj ||11||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਦੇ ਕੰਮਾ ਨੂੰ ਕੋਈ ਵੀ ਪਛਾਣ ਨਹੀਂ ਸਕਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "सकत न कोई पछानि करि चंचलान के काज ॥११॥",
      "sourceLineId": "137531",
      "sourceShabadId": "12720",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪਚਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੫॥੬੯੦੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau pachaasee charitr samaapatam sat subham sat ||385||6901||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੮੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੮੫॥੬੯੦੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ पचासी चरित्र समापतम सतु सुभम सतु ॥३८५॥६९०१॥अफजूँ॥",
      "sourceLineId": "137532",
      "sourceShabadId": "12720",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137533",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬੀਰ ਕੇਤੁ ਇਕ ਭੂਪ ਭਨਿਜੈ ॥",
      "transliteration": "beer ket ik bhoop bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਬੀਰ ਕੇਤੁ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "बीर केतु इक भूप भनिजै ॥",
      "sourceLineId": "137534",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬੀਰਪੁਰੀ ਤਿਹ ਨਗਰ ਕਹਿਜੈ ॥",
      "transliteration": "beerapuree teh nagar kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਨਗਰ ਦਾ ਨਾ ਬੀਰਪੁਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "बीरपुरी तिह नगर कहिजै ॥",
      "sourceLineId": "137535",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸ੍ਰੀ ਦਿਨ ਦੀਪਕ ਦੇ ਤਿਹ ਰਾਨੀ ॥",
      "transliteration": "sree dhin dheepak dhe teh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਨ ਦੀਪਕ ਦੇ (ਦੇਈ) ਉਸ ਦੀ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "स्री दिन दीपक दे तिह रानी ॥",
      "sourceLineId": "137536",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁੰਦਰਿ ਭਵਨ ਚਤੁਰਦਸ ਜਾਨੀ ॥੧॥",
      "transliteration": "su(n)dhar bhavan chaturadhas jaanee ||1||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਸੁੰਦਰ ਮੰਨੀ ਜਾਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "सुँदरि भवन चतुरदस जानी ॥१॥",
      "sourceLineId": "137537",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਇ ਗੁਮਾਨੀ ਤਹ ਇਕ ਛਤ੍ਰੀ ॥",
      "transliteration": "rai gumaanee teh ik chhatree ||",
      "translation": "",
      "punjabiViakhya": "ਗੁਮਾਨੀ ਰਾਇ ਨਾ ਦਾ ਉਥੇ ਇਕ ਛਤ੍ਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "राइ गुमानी तह इक छत्री ॥",
      "sourceLineId": "137538",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੂਰਬੀਰ ਬਲਵਾਨ ਧਰਤ੍ਰੀ ॥",
      "transliteration": "soorabeer balavaan dharatree ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸ਼ੂਰਬੀਰ, ਬਲਵਾਨ ਅਤੇ ਅਸ੍ਰਧਾਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "सूरबीर बलवान धरत्री ॥",
      "sourceLineId": "137539",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਕ ਸੁੰਦਰ ਅਰ ਚਤੁਰਾ ਮਹਾ ॥",
      "transliteration": "eik su(n)dhar ar chaturaa mahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਕ ਸੁੰਦਰ ਅਤੇ ਦੂਜਾ ਚਤੁਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "इक सुँदर अर चतुरा महा ॥",
      "sourceLineId": "137540",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਹ ਸਮ ਉਪਜਾ ਕੋਈ ਨ ਕਹਾ ॥੨॥",
      "transliteration": "jeh sam upajaa koiee na kahaa ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਕੋਈ ਕਿਤੇ ਨਹੀਂ ਪੈਦਾ ਹੋਇਆ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "जिह सम उपजा कोई न कहा ॥२॥",
      "sourceLineId": "137541",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਜ ਤਰੁਨਿ ਜਬ ਤਾਹਿ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "raaj tarun jab taeh nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਜਦ ਉਸ ਨੂੰ ਵੇਖਿਆ (ਤਾ ਉਸ)",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "राज तरुनि जब ताहि निहारियो ॥",
      "sourceLineId": "137542",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਇਹੈ ਚੰਚਲਾ ਚਿਤ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "eihai cha(n)chalaa chit bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਮਨ ਵਿਚ ਵਿਚਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "इहै चंचला चित बिचारियो ॥",
      "sourceLineId": "137543",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਹੋ ਚਰਿਤ੍ਰ ਕਵਨ ਸੋ ਕੀਜੈ ॥",
      "transliteration": "kaho charitr kavan so keejai ||",
      "translation": "",
      "punjabiViakhya": "ਦਸੋ, ਕਿਹੜਾ ਚਰਿਤ੍ਰ ਕੀਤਾ ਜਾਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "कहो चरित्र कवन सो कीजै ॥",
      "sourceLineId": "137544",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਪਿਯ ਸੌ ਭੋਗ ਕਰੀਜੈ ॥੩॥",
      "transliteration": "jeh bidh piy sau bhog kareejai ||3||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਢੰਗ ਨਾਲ ਪ੍ਰਿਯ ਦਾ ਸੰਯੋਗ ਸੁਖ ਪ੍ਰਾਪਤ ਕੀਤਾ ਜਾ ਸਕੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि पिय सौ भोग करीजै ॥३॥",
      "sourceLineId": "137545",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬੀਰ ਮਤੀ ਇਕ ਸਖੀ ਸ੍ਯਾਨੀ ॥",
      "transliteration": "beer matee ik sakhee sayaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਬੀਰ ਮਤੀ ਨਾ ਦੀ ਇਕ ਸਿਆਣੀ ਸਖੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "बीर मती इक सखी स्यानी ॥",
      "sourceLineId": "137546",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਾਨਿ ਲਾਗਿ ਭਾਖ੍ਯੋ ਤਿਹ ਰਾਨੀ ॥",
      "transliteration": "kaan laag bhaakhayo teh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਰਾਣੀ ਨੇ ਕੰਨ ਦੇ ਨੇੜੇ ਕਰ ਕੇ ਕਿਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "कानि लागि भाख्यो तिह रानी ॥",
      "sourceLineId": "137547",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਾਇ ਗੁਮਾਨੀ ਕੌ ਲੈ ਕੈ ਆਇ ॥",
      "transliteration": "rai gumaanee kau lai kai aai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਗੁਮਾਨੀ ਰਾਇ ਨੂੰ ਲੈ ਕੇ ਆ",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "राइ गुमानी कौ लै कै आइ ॥",
      "sourceLineId": "137548",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਮੁਹਿ ਦੇਹੁ ਮਿਲਾਇ ॥੪॥",
      "transliteration": "jeh teh bidh muh dheh milai ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਕਰ ਕੇ (ਉਹ) ਮੈਨੂੰ ਮਿਲਾ ਦੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "जिह तिह बिधि मुहि देहु मिलाइ ॥४॥",
      "sourceLineId": "137549",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਖੀ ਬ੍ਰਿਥਾ ਸਭ ਭਾਖਿ ਸੁਨਾਈ ॥",
      "transliteration": "sakhee birathaa sabh bhaakh sunaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਸਖੀ ਨੇ (ਜਾ ਕੇ ਗੁਮਾਨੀ ਰਾਇ ਨੂੰ) ਸਾਰੀ ਬਿਰਥਾ ਕਹਿ ਕੇ ਸੁਣਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "सखी बृथा सभ भाखि सुनाई ॥",
      "sourceLineId": "137550",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜ੍ਯੋਂ ਰਾਨੀ ਕਹਿ ਤਾਹਿ ਸੁਨਾਈ ॥",
      "transliteration": "jayo(n) raanee keh taeh sunaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਰਾਣੀ (ਨੇ ਕਹੀ ਸੀ, ਉਵੇਾਂ) ਉਸ ਨੂੰ ਕਹਿ ਕੇ ਸੁਣਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "ज्यों रानी कहि ताहि सुनाई ॥",
      "sourceLineId": "137551",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਤਾ ਕਹ ਉਰਝਾਈ ॥",
      "transliteration": "jeh teh bidh taa keh urajhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਕਰ ਕੇ ਉਸ ਨੂੰ ਉਲਝਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "जिह तिह बिधि ता कह उरझाई ॥",
      "sourceLineId": "137552",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਨਿ ਕੁਅਰ ਕੌ ਦਯੋ ਮਿਲਾਈ ॥੫॥",
      "transliteration": "aan kuar kau dhayo milaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਿਆ ਕੇ ਰਾਣੀ ਨੂੰ ਮਿਲਾ ਦਿੱਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "आनि कुअर कौ दयो मिलाई ॥५॥",
      "sourceLineId": "137553",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਿਹ ਸਾਥ ਬਿਹਾਰੀ ॥",
      "transliteration": "bhaat bhaat teh saath bihaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਭਾਤ ਭਾਤ ਦਾ ਉਸ ਨਾਲ ਰਮਣ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तिह साथ बिहारी ॥",
      "sourceLineId": "137554",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭੋਗ ਕਰਤ ਬੀਤੀ ਨਿਸੁ ਸਾਰੀ ॥",
      "transliteration": "bhog karat beetee nis saaree ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਯੋਗ ਕਰਦਿਆਂ ਸਾਰੀ ਰਾਤ ਬੀਤ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "भोग करत बीती निसु सारी ॥",
      "sourceLineId": "137555",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਬ ਲਗਿ ਆਇ ਗਯੋ ਤਹ ਰਾਜਾ ॥",
      "transliteration": "tab lag aai gayo teh raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤਕ ਉਥੇ ਰਾਜਾ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "तब लगि आइ गयो तह राजा ॥",
      "sourceLineId": "137556",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਚਰਿਤ ਚੰਚਲਾ ਸਾਜਾ ॥੬॥",
      "transliteration": "eeh bidh charit cha(n)chalaa saajaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ (ਉਸ) ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਚਰਿਤ੍ਰ ਖੇਡਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "इह बिधि चरित चंचला साजा ॥६॥",
      "sourceLineId": "137557",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੀਛਨ ਖੜਗ ਹਾਥ ਮਹਿ ਲਯੋ ॥",
      "transliteration": "teechhan khaRag haath meh layo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਹੱਥ ਵਿਚ ਤਿਖੀ ਤਲਵਾਰ ਲੈ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "तीछन खड़ग हाथ महि लयो ॥",
      "sourceLineId": "137558",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਲੈ ਮਿਤਹਿ ਕੇ ਸਿਰ ਮਹਿ ਦਯੋ ॥",
      "transliteration": "lai miteh ke sir meh dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲੈ ਕੇ ਮਿਤਰ ਦੇ ਸਿਰ ਵਿਚ ਮਾਰੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "लै मितहि के सिर महि दयो ॥",
      "sourceLineId": "137559",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਟੂਕ ਟੂਕ ਕਰਿ ਤਾ ਕੇ ਅੰਗਾ ॥",
      "transliteration": "Took Took kar taa ke a(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਅੰਗਾ ਨੂੰ ਟੋਟੇ ਟੋਟੇ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "टूक टूक करि ता के अंगा ॥",
      "sourceLineId": "137560",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਚਨ ਕਹਾ ਰਾਜਾ ਕੇ ਸੰਗਾ ॥੭॥",
      "transliteration": "bachan kahaa raajaa ke sa(n)gaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ (ਇਸ ਤਰ੍ਰਹਾ) ਕਿਹਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "बचन कहा राजा के संगा ॥७॥",
      "sourceLineId": "137561",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਲੋ ਭੂਪ ਇਕ ਚਰਿਤ ਦਿਖਾਊ ॥",
      "transliteration": "chalo bhoop ik charit dhikhaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਚਲੋ, ਤੁਹਾਨੂੰ ਇਕ ਚਰਿਤ੍ਰ ਵਿਖਾਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "चलो भूप इक चरित दिखाऊ ॥",
      "sourceLineId": "137562",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੌਸ ਮਰਾਤਿਬ ਤੁਮੈ ਲਖਾਊ ॥",
      "transliteration": "gauas maraatib tumai lakhaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗੌਂਸ ਦਾ ਦਰਜਾ ਪ੍ਰਾਪਤ ਕਰਨ ਵਾਲਾ (ਪੀਰ) ਦਿਖਾਵਾ। (ਵਿਸ਼ੇਸ਼: ਅਜਿਹੇ ਪੀਰ ਜੋ ਧਿਆਨ-ਮਗਨ ਅਵਸਥਾ ਵਿਚ ਆਪਣੇ ਸ਼ਰੀਰ ਦੇ ਅੰਗ ਵੱਖ ਵੱਖ ਕਰ ਦਿੰਦੇ ਦਸੇ ਜਾਦੇ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "गौस मरातिब तुमै लखाऊ ॥",
      "sourceLineId": "137563",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਇ ਚਰਿਤ ਕਛਹੂੰ ਨ ਬਿਚਾਰਿਯੋ ॥",
      "transliteration": "rai charit kachhahoo(n) na bichaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਚਰਿਤ੍ਰ ਬਾਰੇ ਕੁਝ ਨਾ ਵਿਚਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "राइ चरित कछहूँ न बिचारियो ॥",
      "sourceLineId": "137564",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮ੍ਰਿਤਕ ਪਰਾ ਤਿਹ ਮਿਤ੍ਰ ਨਿਹਾਰਿਯੋ ॥੮॥",
      "transliteration": "mritak paraa teh mitr nihaariyo ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਥੇ) ਉਸ ਦੇ ਮਰੇ ਪਏ ਮਿਤਰ ਨੂੰ ਵੇਖਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "मृतक परा तिह मित्र निहारियो ॥८॥",
      "sourceLineId": "137565",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾ ਕੌ ਗੌਸ ਕੁਤੁਬ ਕਰਿ ਮਾਨਾ ॥",
      "transliteration": "taa kau gauas kutub kar maanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ (ਰਾਜੇ ਨੇ) ਗੌਂਸ ਕੁਤੁਬ ਪੀਰ ਕਰ ਕੇ ਮੰਨ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "ता कौ गौस कुतुब करि माना ॥",
      "sourceLineId": "137566",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਮੂੜ ਪਛਾਨਾ ॥",
      "transliteration": "bhedh abhedh na mooR pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਮੂਰਖ ਨੇ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਹੀਂ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न मूड़ पछाना ॥",
      "sourceLineId": "137567",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤ੍ਰਸਤ ਹਾਥ ਤਾ ਕੌ ਨ ਲਗਾਯੋ ॥",
      "transliteration": "trasat haath taa kau na lagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਡਰਦੇ ਹੋਇਆਂ ਉਸ ਨੂੰ ਹੱਥ ਨਾ ਲਗਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "त्रसत हाथ ता कौ न लगायो ॥",
      "sourceLineId": "137568",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪੀਰ ਪਛਾਨਿ ਜਾਰ ਫਿਰ ਆਯੋ ॥੯॥",
      "transliteration": "peer pachhaan jaar fir aayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਯਾਰ ਨੂੰ ਪੀਰ ਸਮਝ ਕੇ ਪਰਤ ਆਇਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "पीर पछानि जार फिर आयो ॥९॥",
      "sourceLineId": "137569",
      "sourceShabadId": "12721",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137570",
      "sourceShabadId": "12722",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰਥਮ ਭੋਗ ਤਾ ਸੌ ਕਿਯਾ ਬਹੁਰੋ ਦਿਯਾ ਸੰਘਾਰਿ ॥",
      "transliteration": "pratham bhog taa sau kiyaa bahuro dhiyaa sa(n)ghaar ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਉਸ ਨਾਲ ਸੰਯੋਗ ਕੀਤਾ ਅਤੇ ਫਿਰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "प्रथम भोग ता सौ किया बहुरो दिया संघारि ॥",
      "sourceLineId": "137571",
      "sourceShabadId": "12722",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮੂੜ ਭੂਪ ਇਹ ਛਲ ਛਲਾ ਸਕਾ ਨ ਭੇਦ ਬਿਚਾਰ ॥੧੦॥",
      "transliteration": "mooR bhoop ieh chhal chhalaa sakaa na bhedh bichaar ||10||",
      "translation": "",
      "punjabiViakhya": "ਮੂਰਖ ਰਾਜਾ ਇਸ ਛਲ ਨਾਲ ਛਲਿਆ ਗਿਆ ਅਤੇ ਭੇਦ ਨੂੰ ਵਿਚਾਰ ਨਾ ਸਕਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "मूड़ भूप इह छल छला सका न भेद बिचार ॥१०॥",
      "sourceLineId": "137572",
      "sourceShabadId": "12722",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਿਆਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੬॥੬੯੧੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chhiaasee charitr samaapatam sat subham sat ||386||6911||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੮੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੮੬॥੬੯੧੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ छिआसी चरित्र समापतम सतु सुभम सतु ॥३८६॥६९११॥अफजूँ॥",
      "sourceLineId": "137573",
      "sourceShabadId": "12722",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137574",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਾਰਵਾਰ ਇਕ ਭੂਪ ਭਨਿਜੈ ॥",
      "transliteration": "maaravaar ik bhoop bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰਵਾੜ ਵਿਚ ਇਕ ਰਾਜਾ ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "मारवार इक भूप भनिजै ॥",
      "sourceLineId": "137575",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੰਦ੍ਰ ਸੈਨ ਤਿਹ ਨਾਮ ਕਹਿਜੈ ॥",
      "transliteration": "cha(n)dhr sain teh naam kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਚੰਦ੍ਰ ਸੈਨ ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": "चंद्र सैन तिह नाम कहिजै ॥",
      "sourceLineId": "137576",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1338_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸ੍ਰੀ ਜਗ ਮੋਹਨ ਦੇ ਤਿਹ ਨਾਰਿ ॥",
      "transliteration": "sree jag mohan dhe teh naar ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਮੋਹਨ ਦੇ (ਦੇਈ) ਉਸ ਦੀ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1338,
      "hindi": "",
