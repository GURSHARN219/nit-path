{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1339,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1339_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚੰਦ੍ਰਵਤੀ ਇਹ ਪੁਰੀ ਬਿਰਾਜੈ ॥",
      "transliteration": "cha(n)dhravatee ieh puree biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਦੀ ਚੰਦ੍ਰਵਤੀ ਨਗਰੀ ਹੁੰਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "चंद्रवती इह पुरी बिराजै ॥",
      "sourceLineId": "137579",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਗ ਲੋਕ ਜਾ ਕੌ ਲਖਿ ਲਾਜੈ ॥",
      "transliteration": "naag lok jaa kau lakh laajai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ (ਸੁੰਦਰਤਾ ਨੂੰ) ਵੇਖ ਕੇ ਨਾਗ ਲੋਕ ਵੀ ਸ਼ਰਮਾਉਾਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "नाग लोक जा कौ लखि लाजै ॥",
      "sourceLineId": "137580",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹੋਡ ਪਰੀ ਇਕ ਦਿਨ ਤਿਨ ਮਾਹ ॥",
      "transliteration": "hodd paree ik dhin tin maeh ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ (ਰਾਜੇ ਅਤੇ ਰਾਣੀ) ਵਿਚ ਇਕ ਦਿਨ ਸ਼ਰਤ ਲਗ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "होड परी इक दिन तिन माह ॥",
      "sourceLineId": "137581",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਚਨ ਕਹਾ ਤ੍ਰਿਯ ਸੌ ਲਰ ਨਾਹ ॥੨॥",
      "transliteration": "bachan kahaa tiray sau lar naeh ||2||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਲੜ ਕੇ ਰਾਣੀ ਨੂੰ ਬਚਨ ਕਿਹਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "बचन कहा तृय सौ लर नाह ॥२॥",
      "sourceLineId": "137582",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਐਸੀ ਕਵਨ ਜਗਤ ਮੈ ਨਾਰੀ ॥",
      "transliteration": "aaisee kavan jagat mai naaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਗਤ ਵਿਚ ਅਜਿਹੀ ਕਿਹੜੀ ਇਸਤਰੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "ऐसी कवन जगत मै नारी ॥",
      "sourceLineId": "137583",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਨ ਨ ਸੁਨੀ ਨ ਨੈਨ ਨਿਹਾਰੀ ॥",
      "transliteration": "kaan na sunee na nain nihaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਬਾਰੇ) ਕੰਨਾ ਨਾਲ ਸੁਣਿਆ ਨਾ ਹੋਵੇ, ਜਾ ਅੱਖਾ ਨਾਲ ਵੇਖਿਆ ਨਾ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "कान न सुनी न नैन निहारी ॥",
      "sourceLineId": "137584",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਤਿਹਿ ਢੋਲ ਕੀ ਢਮਕ ਸੁਨਾਵੈ ॥",
      "transliteration": "pateh ddol kee ddamak sunaavai ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਨੂੰ ਢੋਲ ਦੀ ਢਮਕ ਸੁਣਾਵੇ (ਅਰਥਾਤ ਖ਼ੁਸ਼ ਕਰੇ)",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "पतिहि ढोल की ढमक सुनावै ॥",
      "sourceLineId": "137585",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਹੁਰਿ ਜਾਰ ਸੌ ਭੋਗ ਕਮਾਵੈ ॥੩॥",
      "transliteration": "bahur jaar sau bhog kamaavai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਯਾਰ ਨਾਲ ਰਮਣ ਕਰੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "बहुरि जार सौ भोग कमावै ॥३॥",
      "sourceLineId": "137586",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕੇਤਕ ਦਿਨ ਬੀਤਤ ਜਬ ਭਏ ॥",
      "transliteration": "ketak dhin beetat jab bhe ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਕਈ ਦਿਨ ਬੀਤ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "केतक दिन बीतत जब भए ॥",
      "sourceLineId": "137587",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਿਯ ਕੌ ਬਚ ਸਿਮਰਨ ਹ੍ਵੈ ਗਏ ॥",
      "transliteration": "tiy kau bach simaran havai ge ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਸਤਰੀ ਨੂੰ (ਰਾਜੇ ਦੇ) ਬੋਲ ਯਾਦ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "तिय कौ बच सिमरन ह्वै गए ॥",
      "sourceLineId": "137588",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਸ ਚਰਿਤ੍ਰ ਕਰਿ ਪਤਿਹਿ ਦਿਖਾਊਾਂ ॥",
      "transliteration": "as charitr kar pateh dhikhaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚਣ ਲਗੀ ਕਿ) ਅਜਿਹਾ ਚਰਿਤ੍ਰ ਕਰ ਕੇ ਪਤੀ ਨੂੰ ਵਿਖਾਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "अस चरित्र करि पतिहि दिखाऊाँ ॥",
      "sourceLineId": "137589",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਜੌ ਜਾਰ ਅਰ ਢੋਲ ਬਜਾਊਾਂ ॥੪॥",
      "transliteration": "bhajau jaar ar ddol bajaauooaa(n) ||4||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ ਵੀ ਵਜਾਵਾ ਅਤੇ ਯਾਰ ਨਾਲ ਰਮਣ ਵੀ ਕਰਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "भजौ जार अर ढोल बजाऊाँ ॥४॥",
      "sourceLineId": "137590",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਬ ਤੇ ਇਹੈ ਟੇਵ ਤਿਨ ਡਾਰੀ ॥",
      "transliteration": "tab te ihai Tev tin ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਦੋਂ ਤੋਂ ਉਸ ਨੇ ਇਹੋ ਆਦਤ ('ਟੇਵ') ਬਣਾ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "तब ते इहै टेव तिन डारी ॥",
      "sourceLineId": "137591",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਔਰਨ ਤ੍ਰਿਯ ਸੌ ਪ੍ਰਗਟ ਉਚਾਰੀ ॥",
      "transliteration": "aauaran tiray sau pragaT uchaaree ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰਨਾ ਇਸਤਰੀਆਂ ਨੂੰ ਵੀ ਸਾਫ਼ ਦਸ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "औरन तृय सौ प्रगट उचारी ॥",
      "sourceLineId": "137592",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮੈ ਧਰਿ ਸੀਸ ਪਾਨਿ ਕੋ ਸਾਜਾ ॥",
      "transliteration": "mai dhar sees paan ko saajaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮੈਂ ਸਿਰ ਉਤੇ ਪਾਣੀ ਦੀ ਗਾਗਰ ('ਪਾਨਿ ਕੋ ਸਾਜਾ') ਧਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "मै धरि सीस पानि को साजा ॥",
      "sourceLineId": "137593",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਰਿ ਲ੍ਯੈਹੌ ਜਲ ਨ੍ਰਿਪ ਕੇ ਕਾਜਾ ॥੫॥",
      "transliteration": "bhar layaihau jal nirap ke kaajaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਲਈ ਪਾਣੀ ਭਰ ਕੇ ਲਿਆਵਾਗੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "भरि ल्यैहौ जल नृप के काजा ॥५॥",
      "sourceLineId": "137594",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਚਨ ਸੁਨਤ ਰਾਜਾ ਹਰਖਾਨੋ ॥",
      "transliteration": "bachan sunat raajaa harakhaano ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ) ਗੱਲ ਸੁਣ ਕੇ ਰਾਜਾ ਬਹੁਤ ਪ੍ਰਸੰਨ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "बचन सुनत राजा हरखानो ॥",
      "sourceLineId": "137595",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਕੌ ਅਤਿ ਪਤਿਬ੍ਰਤਾ ਜਾਨੋ ॥",
      "transliteration": "taa kau at patibrataa jaano ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਅਤਿ ਅਧਿਕ ਪਤਿਬ੍ਰਤਾ ਸਮਝਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "ता कौ अति पतिब्रता जानो ॥",
      "sourceLineId": "137596",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਿਜੁ ਸਿਰ ਕੈ ਰਾਨੀ ਘਟ ਲ੍ਯਾਵੈ ॥",
      "transliteration": "nij sir kai raanee ghaT layaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚਣ ਲਗਿਆ ਕਿ) ਰਾਣੀ ਆਪਣੇ ਸਿਰ ਉਤੇ ਘੜਾ ਚੁਕ ਕੇ ਲਿਆਉਾਂਦੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "निजु सिर कै रानी घट ल्यावै ॥",
      "sourceLineId": "137597",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਨਿ ਪਾਨਿ ਪੁਨਿ ਮੁਝੈ ਪਿਲਾਵੈ ॥੬॥",
      "transliteration": "aan paan pun mujhai pilaavai ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਾਣੀ ਲਿਆ ਕੇ ਫਿਰ ਮੈਨੂੰ ਪਿਲਾਉਾਂਦੀ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "आनि पानि पुनि मुझै पिलावै ॥६॥",
      "sourceLineId": "137598",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਕ ਦਿਨ ਤ੍ਰਿਯ ਪਿਯ ਸੋਤ ਜਗਾਈ ॥",
      "transliteration": "eik dhin tiray piy sot jagaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਇਸਤਰੀ ਨੇ ਰਾਜੇ ਨੂੰ ਸੁੱਤੇ ਹੋਇਆਂ ਜਗਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "इक दिन तृय पिय सोत जगाई ॥",
      "sourceLineId": "137599",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਲੈ ਘਟ ਕੌ ਕਰ ਚਲੀ ਬਨਾਈ ॥",
      "transliteration": "lai ghaT kau kar chalee banaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੱਥ ਵਿਚ ਘੜਾ ਲੈ ਕੇ ਚਲ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "लै घट कौ कर चली बनाई ॥",
      "sourceLineId": "137600",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਬ ਤੁਮ ਢੋਲ ਢਮਕ ਸੁਨਿ ਲੀਜੋ ॥",
      "transliteration": "jab tum ddol ddamak sun leejo ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨੂੰ ਕਹਿ ਗਈ ਕਿ) ਜਦ ਤੁਸੀਂ ਢੋਲ ਦੀ ਢਮਕ ਸੁਣ ਲਵੋ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "जब तुम ढोल ढमक सुनि लीजो ॥",
      "sourceLineId": "137601",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਬ ਇਮਿ ਕਾਜ ਰਾਜ ਤੁਮ ਕੀਜੋ ॥੭॥",
      "transliteration": "tab im kaaj raaj tum keejo ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਹੇ ਰਾਜਨ! ਤੁਸੀਂ ਇਸ ਤਰ੍ਰਹਾ ਕੰਮ ਕਰਨਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "तब इमि काज राज तुम कीजो ॥७॥",
      "sourceLineId": "137602",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰਥਮ ਸੁਨ੍ਯੋ ਸਭ ਢੋਲ ਬਜਾਯੋ ॥",
      "transliteration": "pratham sunayo sabh ddol bajaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਤੁਸੀਂ) ਢੋਲ ਦੀ ਸਭ ਤੋਂ ਪਹਿਲੀ ਧਮਕ ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "प्रथम सुन्यो सभ ढोल बजायो ॥",
      "sourceLineId": "137603",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਨਿਯਹੁ ਰਾਨੀ ਡੋਲ ਧਸਾਯੋ ॥",
      "transliteration": "janiyahu raanee ddol dhasaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਇਹ) ਸਮਝਣਾ ਕਿ ਰਾਣੀ ਨੇ ਡੋਲ ਨੂੰ (ਖੂਹ ਵਿਚ) ਲਟਕਾ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "जनियहु रानी डोल धसायो ॥",
      "sourceLineId": "137604",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੁਤਿਯ ਢਮਾਕ ਸੁਨੋ ਜਬ ਗਾਢਾ ॥",
      "transliteration": "dhutiy ddamaak suno jab gaaddaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਤੁਸੀਂ) ਦੂਜੀ ਭਾਰੀ ਢਮਕ ਸੁਣੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "दुतिय ढमाक सुनो जब गाढा ॥",
      "sourceLineId": "137605",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਨਿਯਹੁ ਤਰੁਨਿ ਕੂਪ ਤੇ ਕਾਢਾ ॥੮॥",
      "transliteration": "janiyahu tarun koop te kaaddaa ||8||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਸਮਝਣਾ ਕਿ ਰਾਣੀ ਨੇ (ਡੋਲ) ਖੂਹ ਵਿਚੋਂ ਕਢਿਆ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "जनियहु तरुनि कूप ते काढा ॥८॥",
      "sourceLineId": "137606",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਹਿਕ ਲਹੌਰੀ ਰਾਇ ਭਨਿਜੈ ॥",
      "transliteration": "tahik lahauaree rai bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਲਹੌਰੀ ਰਾਇ (ਨਾ ਦਾ ਵਿਅਕਤੀ) ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "तहिक लहौरी राइ भनिजै ॥",
      "sourceLineId": "137607",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਾ ਸੰਗ ਤ੍ਰਿਯ ਕੋ ਹੇਤੁ ਕਹਿਜੈ ॥",
      "transliteration": "jaa sa(n)g tiray ko het kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਰਾਣੀ ਦਾ ਪ੍ਰੇਮ-ਸੰਬੰਧ ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "जा संग तृय को हेतु कहिजै ॥",
      "sourceLineId": "137608",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਲਯੋ ਤਿਸੀ ਕੋ ਤੁਰਤ ਮੰਗਾਇ ॥",
      "transliteration": "layo tisee ko turat ma(n)gai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਣੀ ਨੇ) ਉਸ ਨੂੰ ਤੁਰਤ ਬੁਲਵਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "लयो तिसी को तुरत मंगाइ ॥",
      "sourceLineId": "137609",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭੋਗ ਕਿਯਾ ਅਤਿ ਰੁਚਿ ਉਪਜਾਇ ॥੯॥",
      "transliteration": "bhog kiyaa at ruch upajai ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰੁਚੀ ਪੂਰਵਕ ਉਸ ਨਾਲ ਭੋਗ ਕੀਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "भोग किया अति रुचि उपजाइ ॥९॥",
      "sourceLineId": "137610",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪ੍ਰਥਮ ਜਾਰ ਜਬ ਧਕਾ ਲਗਾਯੋ ॥",
      "transliteration": "pratham jaar jab dhakaa lagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਯਾਰ ਨੇ ਪਹਿਲਾ ਜ਼ੋਰ ਲਗਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "प्रथम जार जब धका लगायो ॥",
      "sourceLineId": "137611",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਬ ਰਾਨੀ ਲੈ ਢੋਲ ਬਜਾਯੋ ॥",
      "transliteration": "tab raanee lai ddol bajaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਣੀ ਨੇ (ਡੱਗਾ) ਲੈ ਕੇ ਢੋਲ ਵਜਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "तब रानी लै ढोल बजायो ॥",
      "sourceLineId": "137612",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਬ ਤਿਹ ਲਿੰਗ ਸੁ ਭਗ ਤੇ ਕਾਢਾ ॥",
      "transliteration": "jab teh li(n)g su bhag te kaaddaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਪੁਰਸ਼ ਨੇ ਇੰਦਰੀ ਨੂੰ ਯੋਨੀ ਤੋਂ ਬਾਹਰ ਕਢਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "जब तिह लिंग सु भग ते काढा ॥",
      "sourceLineId": "137613",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤ੍ਰਿਯ ਦਿਯ ਢੋਲ ਢਮਾਕਾ ਗਾਢਾ ॥੧੦॥",
      "transliteration": "tiray dhiy ddol ddamaakaa gaaddaa ||10||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਰਾਣੀ ਨੇ ਤਕੜੀ ਤਰ੍ਰਹਾ ਨਾਲ ਢੋਲ ਢਮਕਾਇਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "तृय दिय ढोल ढमाका गाढा ॥१०॥",
      "sourceLineId": "137614",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਬ ਰਾਜੈ ਇਹ ਭਾਤਿ ਬਿਚਾਰੀ ॥",
      "transliteration": "tab raajai ieh bhaat bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੋਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "तब राजै इह भाति बिचारी ॥",
      "sourceLineId": "137615",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਡੋਰਿ ਕੂਪ ਤੇ ਨਾਰਿ ਨਿਕਾਰੀ ॥",
      "transliteration": "ddor koop te naar nikaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਣੀ ਨੇ ਰੱਸੀ ਖੂਹ ਵਿਚੋਂ ਕਢੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "डोरि कूप ते नारि निकारी ॥",
      "sourceLineId": "137616",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਿਨ ਤ੍ਰਿਯ ਭੋਗ ਜਾਰ ਸੌ ਕੀਨਾ ॥",
      "transliteration": "tin tiray bhog jaar sau keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਨੇ ਯਾਰ ਨਾਲ ਰਮਣ ਵੀ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "तिन तृय भोग जार सौ कीना ॥",
      "sourceLineId": "137617",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਾਜਾ ਸੁਨਤ ਦਮਾਮੋ ਦੀਨਾ ॥੧੧॥",
      "transliteration": "raajaa sunat dhamaamo dheenaa ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦੇ ਸੁਣਨ ਲਈ ਢੋਲ ਵੀ ਵਜਾ ਦਿੱਤਾ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "राजा सुनत दमामो दीना ॥११॥",
      "sourceLineId": "137618",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰਥਮ ਜਾਰ ਸੌ ਭੋਗ ਕਮਾਯੋ ॥",
      "transliteration": "pratham jaar sau bhog kamaayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਹਿਲਾ ਯਾਰ ਨਾਲ ਰਮਣ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "प्रथम जार सौ भोग कमायो ॥",
      "sourceLineId": "137619",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਹੁਰੋ ਢੋਲ ਢਮਾਕ ਸੁਨਾਯੋ ॥",
      "transliteration": "bahuro ddol ddamaak sunaayo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ (ਰਾਜੇ ਨੂੰ) ਢੋਲ ਦੀ ਢਮਕ ਵੀ ਸੁਣਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "बहुरो ढोल ढमाक सुनायो ॥",
      "sourceLineId": "137620",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੂਪ ਕ੍ਰਿਯਾ ਕਬਹੂੰ ਨ ਬਿਚਾਰੀ ॥",
      "transliteration": "bhoop kirayaa kabahoo(n) na bichaaree ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਇਸ ਕ੍ਰਿਆ ਨੂੰ ਬਿਲਕੁਲ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "भूप कृया कबहूँ न बिचारी ॥",
      "sourceLineId": "137621",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਹਾ ਚਰਿਤ੍ਰ ਕਿਯਾ ਇਮ ਨਾਰੀ ॥੧੨॥",
      "transliteration": "kahaa charitr kiyaa im naaree ||12||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰਾਣੀ ਨੇ ਕੀ ਚਰਿਤ੍ਰ ਕੀਤਾ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "कहा चरित्र किया इम नारी ॥१२॥",
      "sourceLineId": "137622",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੭॥੬੯੨੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau sataasee charitr samaapatam sat subham sat ||387||6923||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੮੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੮੭॥੬੯੨੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ सतासी चरित्र समापतम सतु सुभम सतु ॥३८७॥६९२३॥अफजूँ॥",
      "sourceLineId": "137623",
      "sourceShabadId": "12723",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137624",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਿੰਘ ਨਰਿੰਦਰ ਭੂਪ ਇਕ ਨ੍ਰਿਪ ਬਰ ॥",
      "transliteration": "si(n)gh nari(n)dhar bhoop ik nirap bar ||",
      "translation": "",
      "punjabiViakhya": "ਨਰਿੰਦ੍ਰ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਉੱਤਮ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "सिंघ नरिंदर भूप इक नृप बर ॥",
      "sourceLineId": "137625",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1339_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨ੍ਰਿਪਬਰਵਤੀ ਨਗਰ ਜਾ ਕੋ ਘਰ ॥",
      "transliteration": "nirapabaravatee nagar jaa ko ghar ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦਾ ਨ੍ਰਿਪਬਰਵਤੀ ਨਗਰ ਵਿਚ ਘਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": "नृपबरवती नगर जा को घर ॥",
      "sourceLineId": "137626",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
