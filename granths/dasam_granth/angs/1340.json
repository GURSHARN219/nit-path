{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1340,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1340_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸ੍ਰੀ ਮਦ ਮੋਕਲ ਦੇ ਤਿਹ ਨਾਰੀ ॥",
      "transliteration": "sree madh mokal dhe teh naaree ||",
      "translation": "",
      "punjabiViakhya": "ਮੋਕਲ ਦੇ (ਦੇਈ) ਉਸ ਦੀ ਰਾਣੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "स्री मद मोकल दे तिह नारी ॥",
      "sourceLineId": "137627",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਧਿ ਸੁ ਨਾਰ ਸਾਚੇ ਜਨੁ ਢਾਰੀ ॥੧॥",
      "transliteration": "bidh su naar saache jan ddaaree ||1||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਤਨੀ ਸੁੰਦਰ ਸੀ) ਮਾਨੋ ਵਿਧਾਤਾ ਨੇ ਉਸ ਇਸਤਰੀ ਨੂੰ ਸੰਚੇ ਵਿਚ ਢਾਲਿਆ ਹੋਵੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "बिधि सु नार साचे जनु ढारी ॥१॥",
      "sourceLineId": "137628",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੇਹ ਕੁਰੂਪ ਭੂਪ ਕੌ ਭਾਰਾ ॥",
      "transliteration": "dheh kuroop bhoop kau bhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਦਾ ਸ਼ਰੀਰ ਭਾਰੀ ਅਤੇ ਕੁਰੂਪ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "देह कुरूप भूप कौ भारा ॥",
      "sourceLineId": "137629",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਿਜੁ ਤ੍ਰਿਯ ਸਾਥ ਨ ਰਾਖਤ ਪ੍ਯਾਰਾ ॥",
      "transliteration": "nij tiray saath na raakhat payaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਇਸਤਰੀ ਨਾਲ ਪ੍ਰੇਮ ਨਹੀਂ ਕਰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "निजु तृय साथ न राखत प्यारा ॥",
      "sourceLineId": "137630",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰੈਨਿ ਦਿਵਸ ਜੋਗਿਯਨ ਬੁਲਾਵੈ ॥",
      "transliteration": "rain dhivas jogiyan bulaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਾਤ ਦਿਨ ਜੋਗੀਆਂ ਨੂੰ ਬੁਲਾਉਾਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "रैनि दिवस जोगियन बुलावै ॥",
      "sourceLineId": "137631",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੋਗ ਸਾਧਨਾ ਚਹੈ ਕਿ ਆਵੈ ॥੨॥",
      "transliteration": "jog saadhanaa chahai k aavai ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਾਹੁੰਦਾ ਸੀ (ਕਿ ਉਸ ਨੂੰ) ਜੋਗ ਸਾਧਨਾ ਆ ਜਾਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "जोग साधना चहै कि आवै ॥२॥",
      "sourceLineId": "137632",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਯਾ ਤੇ ਨਾਰਿ ਅਧਿਕ ਰਿਸਿ ਠਾਨੀ ॥",
      "transliteration": "yaa te naar adhik ris Thaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋਗੀਆਂ ਦੀਆਂ ਇਸ ਤਰ੍ਰਹਾ ਦੀਆਂ ਗੱਲਾ ਸੁਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "या ते नारि अधिक रिसि ठानी ॥",
      "sourceLineId": "137633",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁਨਤ ਜੋਗਿਯਨ ਕੀ ਅਸਿ ਬਾਨੀ ॥",
      "transliteration": "sunat jogiyan kee as baanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਨੇ ਬਹੁਤ ਗੁੱਸੇ ਵਿਚ ਆ ਕੇ (ਇਹ ਧਾਰ ਲਿਆ ਕਿ)",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "सुनत जोगियन की असि बानी ॥",
      "sourceLineId": "137634",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਐਸਾ ਕਛੂ ਉਪਾਇ ਬਨਾਊ ॥",
      "transliteration": "aaisaa kachhoo upai banaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਝ ਅਜਿਹਾ ਉਪਾ ਕਰਾ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "ऐसा कछू उपाइ बनाऊ ॥",
      "sourceLineId": "137635",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭੂਪਤਿ ਸਹਿਤ ਅਜੁ ਇਨ ਘਾਊ ॥੩॥",
      "transliteration": "bhoopat sahit aj in ghaauoo ||3||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਅਜ ਰਾਜੇ ਸਮੇਤ ਇਨ੍ਰਹਾ (ਜੋਗੀਆਂ) ਨੂੰ ਮਾਰ ਮੁਕਾਵਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "भूपति सहित अजु इन घाऊ ॥३॥",
      "sourceLineId": "137636",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੇਉਾਂ ਆਪਨੋ ਮਿਤ੍ਰਹਿ ਰਾਜਾ ॥",
      "transliteration": "dheauaa(n) aapano mitreh raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਮਿਤਰ ਨੂੰ ਰਾਜ-ਪਾਟ ਦਿਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "देउाँ आपनो मित्रहि राजा ॥",
      "sourceLineId": "137637",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੋਗੀ ਹਨੌ ਭੂਪ ਜੁਤ ਆਜਾ ॥",
      "transliteration": "jogee hanau bhoop jut aajaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਸਮੇਤ ਜੋਗੀਆਂ ਨੂੰ ਅਜ ਮਾਰ ਮੁਕਾਵਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "जोगी हनौ भूप जुत आजा ॥",
      "sourceLineId": "137638",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਕਲ ਪ੍ਰਜਹਿ ਇਨ ਮਾਰਿ ਦਿਖਾਊਾਂ ॥",
      "transliteration": "sakal prajeh in maar dhikhaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਨੂੰ ਮਾਰ ਕੇ ਸਾਰੀ ਪ੍ਰਜਾ ਨੂੰ ਵਿਖਾਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "सकल प्रजहि इन मारि दिखाऊाँ ॥",
      "sourceLineId": "137639",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਿਤ੍ਰ ਸੀਸ ਪਰ ਛਤ੍ਰ ਫਿਰਾਊਾਂ ॥੪॥",
      "transliteration": "mitr sees par chhatr firaauooaa(n) ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਿਤਰ ਦੇ ਸਿਰ ਉਤੇ ਛਤ੍ਰ ਝੁਲਾਵਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "मित्र सीस पर छत्र फिराऊाँ ॥४॥",
      "sourceLineId": "137640",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਬ ਰਾਜਾ ਨਿਸ ਕੌ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "transliteration": "jab raajaa nis kau gireh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਰਾਤ ਨੂੰ ਘਰ ਆਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "जब राजा निस कौ गृह आयो ॥",
      "sourceLineId": "137641",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁਰਿ ਜੋਗਿਯਨ ਬੋਲਿ ਪਠਾਯੋ ॥",
      "transliteration": "bahur jogiyan bol paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਜੋਗੀਆਂ ਨੂੰ ਫਿਰ ਬੁਲਵਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "बहुरि जोगियन बोलि पठायो ॥",
      "sourceLineId": "137642",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਿਮਿ ਤਿਮਿ ਨਾਰਿ ਫਾਸ ਗਰ ਡਾਰਿ ॥",
      "transliteration": "tim tim naar faas gar ddaar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਜੋਗੀ ਜਿਵੇਾਂ ਜਿਵੇਾਂ ਆਉਾਂਦੇ ਗਏ) ਤਿਵੇਾਂ ਤਿਵੇਾਂ ਇਸਤਰੀ ਨੇ ਉਨ੍ਰਹਾ ਦੇ ਗੱਲੇ ਵਿਚ ਫਾਹੀ ਪਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "तिमि तिमि नारि फास गर डारि ॥",
      "sourceLineId": "137643",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭੂਪ ਸਹਿਤ ਸਭ ਦਏ ਸੰਘਾਰ ॥੫॥",
      "transliteration": "bhoop sahit sabh dhe sa(n)ghaar ||5||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਸਮੇਤ ਸਭ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "भूप सहित सभ दए संघार ॥५॥",
      "sourceLineId": "137644",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭੂਪਤਿ ਮਾਰਿ ਖਾਟ ਤਰ ਪਾਯੋ ॥",
      "transliteration": "bhoopat maar khaaT tar paayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਮਾਰ ਕੇ ਮੰਜੇ ਹੇਠਾ ਲੰਮਾ ਪਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "भूपति मारि खाट तर पायो ॥",
      "sourceLineId": "137645",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੁਹੂੰ ਅਤੀਤਨ ਤਰੇ ਡਸਾਯੋ ॥",
      "transliteration": "dhuhoo(n) ateetan tare ddasaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਜੋਗੀਆਂ ਨੂੰ ਥਲੇ ਸੁਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "दुहूँ अतीतन तरे डसायो ॥",
      "sourceLineId": "137646",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਿੰਘਾਸਨ ਪਰ ਮਿਤ੍ਰਹਿ ਰਾਖਾ ॥",
      "transliteration": "si(n)ghaasan par mitreh raakhaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਿੰਘਾਸਨ ਉਤੇ ਮਿਤਰ ਨੂੰ ਬਿਠਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "सिंघासन पर मित्रहि राखा ॥",
      "sourceLineId": "137647",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬੋਲਿ ਪ੍ਰਜਾ ਸਭ ਸੋ ਇਮਿ ਭਾਖਾ ॥੬॥",
      "transliteration": "bol prajaa sabh so im bhaakhaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੀ ਪ੍ਰਜਾ ਨੂੰ ਬੁਲਾ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "बोलि प्रजा सभ सो इमि भाखा ॥६॥",
      "sourceLineId": "137648",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਬ ਰਾਜਾ ਨਿਸੁ ਕੌ ਗ੍ਰਿਹ ਆਯੋ ॥",
      "transliteration": "jab raajaa nis kau gireh aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜਾ ਰਾਤ ਨੂੰ ਘਰ ਆਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "जब राजा निसु कौ गृह आयो ॥",
      "sourceLineId": "137649",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੁਹੂੰ ਜੋਗਿਯਨ ਨਿਕਟ ਬੁਲਾਯੋ ॥",
      "transliteration": "dhuhoo(n) jogiyan nikaT bulaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ ਉਸ ਨੇ) ਦੋਹਾ ਜੋਗੀਆਂ ਨੂੰ ਕੋਲ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "दुहूँ जोगियन निकट बुलायो ॥",
      "sourceLineId": "137650",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਤਭੁਤ ਨਾਗਾ ਤਹਾ ਇਕ ਨਿਕਸਾ ॥",
      "transliteration": "atabhut naagaa tahaa ik nikasaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਅਜੀਬ ਨਾਗ ਨਿਕਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "अतभुत नागा तहा इक निकसा ॥",
      "sourceLineId": "137651",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਵਲ ਹੇਰਿ ਤਵਨ ਕੌ ਬਿਗਸਾ ॥੭॥",
      "transliteration": "raaval her tavan kau bigasaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਜੋਗੀ ਖ਼ੁਸ਼ ਹੋ ਗਏ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "रावल हेरि तवन कौ बिगसा ॥७॥",
      "sourceLineId": "137652",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਾਪਹਿ ਮਾਰਿ ਤਬੈ ਤਿਨ ਲਿਯੋ ॥",
      "transliteration": "saapeh maar tabai tin liyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਉਸੇ ਵੇਲੇ ਸੱਪ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "सापहि मारि तबै तिन लियो ॥",
      "sourceLineId": "137653",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਫਰੂਆ ਬੀਚ ਡਾਰਿ ਕਰਿ ਦਿਯੋ ॥",
      "transliteration": "farooaa beech ddaar kar dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਠੌਤੇ ਵਿਚ ਪਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "फरूआ बीच डारि करि दियो ॥",
      "sourceLineId": "137654",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਘੋਟਿ ਭਾਗ ਜਿਮਿ ਦੁਹੂੰਅਨ ਪੀਯੋ ॥",
      "transliteration": "ghoT bhaag jim dhuhoo(n)an peeyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੋਹਾ ਨੇ ਉਸ ਨੂੰ ਭੰਗ ਵਾਗ ਘੋਟ ਕੇ ਪੀ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "घोटि भाग जिमि दुहूँअन पीयो ॥",
      "sourceLineId": "137655",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਤਿ ਅਸਥੂਲ ਦੇਹ ਕਹ ਕੀਯੋ ॥੮॥",
      "transliteration": "at asathool dheh keh keeyo ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਦੇਹ ਨੂੰ ਬਹੁਤ ਵਧਾ ਲਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "अति असथूल देह कह कीयो ॥८॥",
      "sourceLineId": "137656",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਾ ਤੇ ਅਧਿਕ ਫੂਲਿ ਜਬ ਗਏ ॥",
      "transliteration": "taa te adhik fool jab ge ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ ਜਦ (ਉਹ) ਬਹੁਤ ਫੁਲ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "ता ते अधिक फूलि जब गए ॥",
      "sourceLineId": "137657",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕੁੰਜਰ ਸੋ ਧਾਰਤ ਬਪੁ ਭਏ ॥",
      "transliteration": "ku(n)jar so dhaarat bap bhe ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਨ੍ਰਹਾ ਦੇ ਸ਼ਰੀਰ ਹਾਥੀ ਵਰਗੇ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "कुँजर सो धारत बपु भए ॥",
      "sourceLineId": "137658",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦ੍ਵੈ ਘਟਿਕਾ ਬੀਤੀ ਤਬ ਫੂਟੇ ॥",
      "transliteration": "dhavai ghaTikaa beetee tab fooTe ||",
      "translation": "",
      "punjabiViakhya": "ਦੋ ਘੜੀਆਂ ਬੀਤਣ ਉਪਰੰਤ (ਉਹ) ਸ਼ਰੀਰ ਪਾਟ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "द्वै घटिका बीती तब फूटे ॥",
      "sourceLineId": "137659",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਵਨ ਜਾਨ ਜਗਤ ਤੇ ਛੂਟੇ ॥੯॥",
      "transliteration": "aavan jaan jagat te chhooTe ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਹ) ਜਗਤ ਦੇ ਆਵਾਗਵਣ ਤੋਂ ਖ਼ਲਾਸ ਹੋ ਗਏ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "आवन जान जगत ते छूटे ॥९॥",
      "sourceLineId": "137660",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਰਖ ਬਾਰਹਨ ਕੇ ਹ੍ਵੈ ਗਏ ॥",
      "transliteration": "barakh baarahan ke havai ge ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਹੁਣ ਬਾਰ੍ਰਹਾ ਬਰਸਾ ਦੇ ਹੋ ਗਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "बरख बारहन के ह्वै गए ॥",
      "sourceLineId": "137661",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤ੍ਯਾਗਤ ਦੇਹ ਪੁਰਾਤਨ ਭਏ ॥",
      "transliteration": "tayaagat dheh puraatan bhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੁਰਾਤਨ ਸ਼ਰੀਰ ਤਿਆਗ ਦਿੱਤੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "त्यागत देह पुरातन भए ॥",
      "sourceLineId": "137662",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸ੍ਵਰਗ ਲੋਕ ਕਹ ਕਿਯਾ ਪਯਾਨ ॥",
      "transliteration": "savairag lok keh kiyaa payaan ||",
      "translation": "",
      "punjabiViakhya": "ਸਵਰਗ ਲੋਕ ਨੂੰ ਚਲੇ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "स्वरग लोक कह किया पयान ॥",
      "sourceLineId": "137663",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤ੍ਯਾਗਿ ਆਪੁਨੀ ਦੇਹ ਪੁਰਾਨਿ ॥੧੦॥",
      "transliteration": "tayaag aapunee dheh puraan ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਆਪਣੀਆਂ ਪੁਰਾਣੀਆਂ ਦੇਹਾ ਨੂੰ ਤਿਆਗ ਕੇ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "त्यागि आपुनी देह पुरानि ॥१०॥",
      "sourceLineId": "137664",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭੂਪ ਨਿਰਖਿ ਚਕ੍ਰਿਤ ਚਿਤ ਰਹਾ ॥",
      "transliteration": "bhoop nirakh chakirat chit rahaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ (ਇਹ ਸਭ ਕੁਝ) ਵੇਖ ਕੇ ਚਿੱਤ ਵਿਚ ਹੈਰਾਨ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "भूप निरखि चकृत चित रहा ॥",
      "sourceLineId": "137665",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮੁਹਿ ਸੇਤੀ ਐਸੀ ਬਿਧਿ ਕਹਾ ॥",
      "transliteration": "muh setee aaisee bidh kahaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿਣ ਲਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "मुहि सेती ऐसी बिधि कहा ॥",
      "sourceLineId": "137666",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਮ ਤੁਮ ਆਵ ਸਾਪ ਦੋਊ ਖਾਹਿ ॥",
      "transliteration": "ham tum aav saap dhouoo khaeh ||",
      "translation": "",
      "punjabiViakhya": "ਆ! ਮੈਂ ਤੇ ਤੂੰ ਦੋਵੇਾਂ ਸੱਪ ਖਾਈਏ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "हम तुम आव साप दोऊ खाहि ॥",
      "sourceLineId": "137667",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੇਹ ਧਰੇ ਸੁਰਪੁਰ ਕੋ ਜਾਹਿ ॥੧੧॥",
      "transliteration": "dheh dhare surapur ko jaeh ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੇਹ ਛਡ ਕੇ ਸਵਰਗ ਨੂੰ ਜਾਈਏ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "देह धरे सुरपुर को जाहि ॥११॥",
      "sourceLineId": "137668",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਯੌ ਕਹਿ ਕੈ ਨ੍ਰਿਪ ਸਾਪ ਚਬਾਯੋ ॥",
      "transliteration": "yau keh kai nirap saap chabaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਕਹਿ ਕੇ ਰਾਜੇ ਨੇ ਸੱਪ ਖਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "यौ कहि कै नृप साप चबायो ॥",
      "sourceLineId": "137669",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮੈ ਡਰਤੇ ਨਹਿ ਤਾਹਿ ਹਟਾਯੋ ॥",
      "transliteration": "mai ddarate neh taeh haTaayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਡਰਦੀ ਨੇ ਉਸ ਨੂੰ ਨਹੀਂ ਰੋਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "मै डरते नहि ताहि हटायो ॥",
      "sourceLineId": "137670",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਥੋਰਾ ਭਖ੍ਰਯੋ ਉਡਾ ਨਹਿ ਗਯੋ ॥",
      "transliteration": "thoraa bhakhrayo uddaa neh gayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਥੋੜਾ ਜਿੰਨਾ ਖਾਇਆ, ਇਸ ਲਈ ਉਡਿਆ ਨਹੀਂ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "थोरा भख्रयो उडा नहि गयो ॥",
      "sourceLineId": "137671",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਾ ਤੇ ਤਨ ਸੁੰਦਰ ਇਹ ਭਯੋ ॥੧੨॥",
      "transliteration": "taa te tan su(n)dhar ieh bhayo ||12||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ ਇਸ ਦਾ ਸ਼ਰੀਰ ਸੁੰਦਰ ਹੋ ਗਿਆ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "ता ते तन सुँदर इह भयो ॥१२॥",
      "sourceLineId": "137672",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੇਹ ਪੁਰਾਤਨ ਤ੍ਯਾਗਨ ਕਰੀ ॥",
      "transliteration": "dheh puraatan tayaagan karee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਪੁਰਾਤਨ ਸ਼ਰੀਰ ਤਿਆਗ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "देह पुरातन त्यागन करी ॥",
      "sourceLineId": "137673",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1340_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਔਖਧ ਬਲ ਨੌਤਨ ਤਨ ਧਰੀ ॥",
      "transliteration": "aauakhadh bal nauatan tan dharee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਔਸ਼ਧੀ ਦੇ ਬਲ ਨਾਲ ਨਵਾ ਸ਼ਰੀਰ ਧਾਰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": "औखध बल नौतन तन धरी ॥",
      "sourceLineId": "137674",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
