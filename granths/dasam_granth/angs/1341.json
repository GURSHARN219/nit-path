{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1341,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1341_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੇਹ ਭੂਪ ਕੀ ਠੌਰ ਜਰਾਵਹੁ ॥",
      "transliteration": "dheh bhoop kee Thauar jaraavahu ||",
      "translation": "",
      "punjabiViakhya": "(ਹੁਣ) ਰਾਜੇ ਦੇ (ਪੁਰਾਣੇ) ਸ਼ਰੀਰ ਇਥੇ ਸਾੜ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "देह भूप की ठौर जरावहु ॥",
      "sourceLineId": "137675",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਯਾ ਕੇ ਸਿਰ ਪਰ ਛਤ੍ਰ ਫਿਰਾਵਹੁ ॥੧੩॥",
      "transliteration": "yaa ke sir par chhatr firaavahu ||13||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ (ਯਾਰ) ਦੇ ਸਿਰ ਉਤੇ ਰਾਜ-ਛਤ੍ਰ ਝੁਲਾਓ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "या के सिर पर छत्र फिरावहु ॥१३॥",
      "sourceLineId": "137676",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਇਹ ਛਲ ਸਾਥ ਜੋਗਿਯਨ ਘਾਯੋ ॥",
      "transliteration": "eeh chhal saath jogiyan ghaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ (ਉਸ ਨੇ) ਜੋਗੀਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "इह छल साथ जोगियन घायो ॥",
      "sourceLineId": "137677",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭੂਪਤਿ ਕੋ ਸੁਰ ਲੋਕ ਪਠਾਯੋ ॥",
      "transliteration": "bhoopat ko sur lok paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਸਵਰਗ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "भूपति को सुर लोक पठायो ॥",
      "sourceLineId": "137678",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਕਲ ਪ੍ਰਜਾ ਕੋ ਲੋਥਿ ਦਿਖਾਈ ॥",
      "transliteration": "sakal prajaa ko loth dhikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਪ੍ਰਜਾ ਨੂੰ (ਰਾਜੇ ਦੀ) ਲੋਥ ਵਿਖਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "सकल प्रजा को लोथि दिखाई ॥",
      "sourceLineId": "137679",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦੇਸ ਮਿਤ੍ਰ ਕੀ ਫੇਰਿ ਦੁਹਾਈ ॥੧੪॥",
      "transliteration": "dhes mitr kee fer dhuhaiee ||14||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੇਸ ਵਿਚ ਮਿਤਰ ਦੀ ਦੁਹਾਈ ਫਿਰਾ ਦਿੱਤੀ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "देस मित्र की फेरि दुहाई ॥१४॥",
      "sourceLineId": "137680",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭੇਵ ਪ੍ਰਜਾ ਕਿਨਹੂੰ ਨ ਪਛਾਨਾ ॥",
      "transliteration": "bhev prajaa kinahoo(n) na pachhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਜਾ ਨੇ ਕਿਸੇ ਤਰ੍ਰਹਾ ਵੀ ਭੇਦ ਨੂੰ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "भेव प्रजा किनहूँ न पछाना ॥",
      "sourceLineId": "137681",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿਹ ਬਿਧਿ ਹਨਾ ਹਮਾਰਾ ਰਾਨਾ ॥",
      "transliteration": "keh bidh hanaa hamaaraa raanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਕਿਵੇਾਂ ਸਾਡਾ ਰਾਜਾ ਮਾਰਿਆ ਗਿਆ ਹੈ?",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "किह बिधि हना हमारा राना ॥",
      "sourceLineId": "137682",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਿਹ ਛਲ ਸੋ ਜੁਗਿਯਨ ਕੋ ਘਾਯੋ ॥",
      "transliteration": "keh chhal so jugiyan ko ghaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸ ਛਲ ਨਾਲ ਜੋਗੀਆਂ ਨੂੰ ਖ਼ਤਮ ਕੀਤਾ ਗਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "किह छल सो जुगियन को घायो ॥",
      "sourceLineId": "137683",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਿਤ੍ਰ ਸੀਸ ਪਰ ਛਤ੍ਰ ਫਿਰਾਯੋ ॥੧੫॥",
      "transliteration": "mitr sees par chhatr firaayo ||15||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਕਿਵੇਾਂ) ਮਿਤਰ ਦੇ ਸਿਰ ਉਤੇ ਛਤ੍ਰ ਝੁਲਾਇਆ ਗਿਆ ਹੈ? ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "मित्र सीस पर छत्र फिरायो ॥१५॥",
      "sourceLineId": "137684",
      "sourceShabadId": "12724",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137685",
      "sourceShabadId": "12725",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਰਬੀ ਰਾਇ ਸੁ ਮਿਤ੍ਰ ਕੋ ਦਿਯਾ ਆਪਨਾ ਰਾਜ ॥",
      "transliteration": "garabee rai su mitr ko dhiyaa aapanaa raaj ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਪਣੇ ਮਿਤਰ ਗਰਬੀ ਰਾਇ ਨੂੰ ਆਪਣਾ ਰਾਜ ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "गरबी राइ सु मित्र को दिया आपना राज ॥",
      "sourceLineId": "137686",
      "sourceShabadId": "12725",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੋਗਨ ਜੁਤ ਰਾਜਾ ਹਨਾ ਕਿਯਾ ਆਪਨਾ ਕਾਜ ॥੧੬॥",
      "transliteration": "jogan jut raajaa hanaa kiyaa aapanaa kaaj ||16||",
      "translation": "",
      "punjabiViakhya": "ਜੋਗੀਆਂ ਸਮੇਤ ਰਾਜੇ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਅਤੇ ਆਪਣਾ ਕੰਮ ਸੰਵਾਰ ਲਿਆ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "जोगन जुत राजा हना किया आपना काज ॥१६॥",
      "sourceLineId": "137687",
      "sourceShabadId": "12725",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਾਸੀ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੮॥੬੯੩੯॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau aThaasee charitr samaapatam sat subham sat ||388||6939||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੮੮ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੮੮॥੬੯੩੯॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ अठासी चरित्र समापतम सतु सुभम सतु ॥३८८॥६९३९॥अफजूँ॥",
      "sourceLineId": "137688",
      "sourceShabadId": "12725",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137689",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭੂਪ ਸੁਬਾਹੁ ਸੈਨ ਇਕ ਸੁਨਾ ॥",
      "transliteration": "bhoop subaahu sain ik sunaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੁਬਾਹੁ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "भूप सुबाहु सैन इक सुना ॥",
      "sourceLineId": "137690",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰੂਪਵਾਨ ਸੁੰਦਰਿ ਬਹੁ ਗੁਨਾ ॥",
      "transliteration": "roopavaan su(n)dhar bahu gunaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਰੂਪਵਾਨ, ਸੁੰਦਰ ਅਤੇ ਗੁਣਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "रूपवान सुँदरि बहु गुना ॥",
      "sourceLineId": "137691",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸ੍ਰੀ ਸੁਬਾਹਪੁਰ ਤਾ ਕੋ ਸੋਹੈ ॥",
      "transliteration": "sree subaahapur taa ko sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸੁਬਾਹੁਪੁਰ (ਨਗਰ) ਸ਼ੋਭਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "स्री सुबाहपुर ता को सोहै ॥",
      "sourceLineId": "137692",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਹ ਸਮ ਔਰ ਨਗਰ ਨਹਿ ਕੋ ਹੈ ॥੧॥",
      "transliteration": "jeh sam aauar nagar neh ko hai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਕੋਈ ਹੋਰ ਨਗਰ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "जिह सम और नगर नहि को है ॥१॥",
      "sourceLineId": "137693",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸ੍ਰੀ ਮਕਰਧੁਜ ਦੇ ਤਿਹ ਰਾਨੀ ॥",
      "transliteration": "sree makaradhuj dhe teh raanee ||",
      "translation": "",
      "punjabiViakhya": "ਮਕਰਧੁਜ ਦੇ (ਦੇਈ) ਉਸ ਦੀ ਰਾਣੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "स्री मकरधुज दे तिह रानी ॥",
      "sourceLineId": "137694",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੁੰਦਰਿ ਦੇਸ ਦੇਸ ਮੌ ਜਾਨੀ ॥",
      "transliteration": "su(n)dhar dhes dhes mau jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦੇਸ ਦੇਸਾਤਰਾ ਵਿਚ ਸੁੰਦਰ ਮੰਨੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "सुँदरि देस देस मौ जानी ॥",
      "sourceLineId": "137695",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਿਹ ਸਮਾਨ ਨਾਰੀ ਨਹਿ ਕੋਊ ॥",
      "transliteration": "teh samaan naaree neh kouoo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗੀ ਕੋਈ ਹੋਰ ਨਾਰੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "तिह समान नारी नहि कोऊ ॥",
      "sourceLineId": "137696",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਾਛੇ ਭਈ ਨ ਆਗੈ ਹੋਊ ॥੨॥",
      "transliteration": "paachhe bhiee na aagai houoo ||2||",
      "translation": "",
      "punjabiViakhya": "ਨਾ ਪਹਿਲਾ ਹੋਈ ਹੈ ਅਤੇ ਨਾ ਅਗੇ ਹੋਵੇਗੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "पाछे भई न आगै होऊ ॥२॥",
      "sourceLineId": "137697",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਨ ਦੇਖਾ ਦਿਲੀ ਕੋ ਏਸਾ ॥",
      "transliteration": "tin dhekhaa dhilee ko esaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਦਿੱਲੀ ਦੇ ਬਾਦਸ਼ਾਹ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "तिन देखा दिली को एसा ॥",
      "sourceLineId": "137698",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਤੇ ਲਿਖਿ ਪਠਿਯੋ ਸੰਦੇਸਾ ॥",
      "transliteration": "eeh bidh te likh paThiyo sa(n)dhesaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਤਰ੍ਰਹਾ ਸੰਦੇਸਾ ਲਿਖ ਕੇ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "इह बिधि ते लिखि पठियो संदेसा ॥",
      "sourceLineId": "137699",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤੁਮ ਇਹ ਠੌਰ ਆਪੁ ਚੜਿ ਆਵਹੁ ॥",
      "transliteration": "tum ieh Thauar aap chaR aavahu ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਆਪ ਇਸ ਥਾ ਉਤੇ ਚੜ੍ਰਹਾਈ ਕਰ ਕੇ ਆ ਜਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "तुम इह ठौर आपु चड़ि आवहु ॥",
      "sourceLineId": "137700",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭੂਪਤਿ ਜੀਤਿ ਮੁਝੈ ਲੈ ਜਾਵਹੁ ॥੩॥",
      "transliteration": "bhoopat jeet mujhai lai jaavahu ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਨੂੰ ਜਿਤ ਕੇ ਮੈਨੂੰ ਲੈ ਜਾਓ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "भूपति जीति मुझै लै जावहु ॥३॥",
      "sourceLineId": "137701",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਕਬਰ ਸੁਨਤ ਬੈਨ ਉਠਿ ਧਯੋ ॥",
      "transliteration": "akabar sunat bain uTh dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਕਬਰ (ਬਾਦਸ਼ਾਹ) ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਉਠ ਤੁਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "अकबर सुनत बैन उठि धयो ॥",
      "sourceLineId": "137702",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪਵਨ ਹੁਤੇ ਆਗੇ ਬਢਿ ਗਯੋ ॥",
      "transliteration": "pavan hute aage badd gayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੌਣ ਦੇ ਵੇਗ ਨਾਲ ਅਗੇ ਵੱਧ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "पवन हुते आगे बढि गयो ॥",
      "sourceLineId": "137703",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਹ ਸੁਨਾ ਆਯੋ ਨ੍ਰਿਪੁ ਜਬ ਹੀ ॥",
      "transliteration": "saeh sunaa aayo nirap jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜੇ ਨੇ ਬਾਦਸ਼ਾਹ ਦੇ ਚੜ੍ਰਹ ਆਉਣ (ਦੀ ਗੱਲ) ਸੁਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "साह सुना आयो नृपु जब ही ॥",
      "sourceLineId": "137704",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪਤਿ ਸੌ ਬਚਨ ਬਖਾਨਾ ਤਬ ਹੀ ॥੪॥",
      "transliteration": "pat sau bachan bakhaanaa tab hee ||4||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਰਾਣੀ ਨੇ) ਪਤੀ ਨੂੰ ਕਿਹਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "पति सौ बचन बखाना तब ही ॥४॥",
      "sourceLineId": "137705",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤੁਮ ਹ੍ਯਾਂ ਤੇ ਨ੍ਰਿਪ ਭਾਜਿ ਨ ਜੈਯਹੁ ॥",
      "transliteration": "tum hayaa(n) te nirap bhaaj na jaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਤੁਸੀਂ ਇਥੋਂ ਭਜ ਕੇ ਨਾ ਜਾਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "तुम ह्याँ ते नृप भाजि न जैयहु ॥",
      "sourceLineId": "137706",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰਨ ਸਾਮੁਹਿ ਹ੍ਵੈ ਜੁਧ ਮਚੈਯਹੁ ॥",
      "transliteration": "ran saamuh havai judh machaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਵਿਚ ਸਾਹਮਣੇ ਹੋ ਕੇ ਯੁੱਧ ਮਚਾਉਣਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "रन सामुहि ह्वै जुध मचैयहु ॥",
      "sourceLineId": "137707",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮੈ ਨ ਤਜੌਗੀ ਤੁਮਰਾ ਸਾਥਾ ॥",
      "transliteration": "mai na tajauagee tumaraa saathaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੇਰਾ ਸਾਥ ਨਹੀਂ ਛਡਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "मै न तजौगी तुमरा साथा ॥",
      "sourceLineId": "137708",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਰੇ ਜਰੋਗੀ ਤੁਮ ਸੌ ਨਾਥਾ ॥੫॥",
      "transliteration": "mare jarogee tum sau naathaa ||5||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਨਾਥ! ਜੇ ਮਰ ਗਏ, ਤਾ ਤੁਹਾਡੇ ਨਾਲ ਸੜਾਗੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "मरे जरोगी तुम सौ नाथा ॥५॥",
      "sourceLineId": "137709",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਤ ਭੂਪਤਿ ਕਹ ਧੀਰ ਬੰਧਾਯੋ ॥",
      "transliteration": "eit bhoopat keh dheer ba(n)dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰ ਰਾਜੇ ਨੂੰ ਧੀਰਜ ਬੰਨ੍ਰਹਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "इत भूपति कह धीर बंधायो ॥",
      "sourceLineId": "137710",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਉਤੈ ਲਿਖਾ ਲਿਖਿ ਤਹਾ ਪਠਾਯੋ ॥",
      "transliteration": "autai likhaa likh tahaa paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਧਰ ਪੱਤਰ ('ਲਿਖਾ') ਲਿਖ ਕੇ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "उतै लिखा लिखि तहा पठायो ॥",
      "sourceLineId": "137711",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਈ ਸੈਨ ਸਾਹ ਕੀ ਜਬ ਹੀ ॥",
      "transliteration": "aaiee sain saeh kee jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਬਾਦਸ਼ਾਹ ਦੀ ਸੈਨਾ ਆ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "आई सैन साह की जब ही ॥",
      "sourceLineId": "137712",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਹਾ ਉਪਾਇ ਕਛੂ ਨਹਿ ਤਬ ਹੀ ॥੬॥",
      "transliteration": "rahaa upai kachhoo neh tab hee ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਕੋਈ ਵੀ ਉਪਾ ਬਾਕੀ ਨਹੀਂ ਰਿਹਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "रहा उपाइ कछू नहि तब ही ॥६॥",
      "sourceLineId": "137713",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਾਜਾ ਜੂਝਿ ਮਰਤ ਭਯੋ ਜਬੈ ॥",
      "transliteration": "raajaa joojh marat bhayo jabai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਜਦੋਂ ਜੂਝ ਮਰਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "राजा जूझि मरत भयो जबै ॥",
      "sourceLineId": "137714",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭਾਜ ਚਲਤ ਭੀ ਪਰਜਾ ਤਬੈ ॥",
      "transliteration": "bhaaj chalat bhee parajaa tabai ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਪ੍ਰਜਾ ਭਜ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "भाज चलत भी परजा तबै ॥",
      "sourceLineId": "137715",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਾਨੀ ਬਾਧਿ ਤਬੈ ਤਿਨ ਲਈ ॥",
      "transliteration": "raanee baadh tabai tin liee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬਾਦਸ਼ਾਹ ਨੇ ਰਾਣੀ ਨੂੰ ਬੰਨ੍ਰਹ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "रानी बाधि तबै तिन लई ॥",
      "sourceLineId": "137716",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਹ ਛਲ ਧਾਮ ਮਿਤ੍ਰ ਕੇ ਗਈ ॥੭॥",
      "transliteration": "eeh chhal dhaam mitr ke giee ||7||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਉਹ ਮਿਤਰ ਦੇ ਘਰ ਚਲੀ ਗਈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "इह छल धाम मित्र के गई ॥७॥",
      "sourceLineId": "137717",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਨਿਨਾਨਵੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੮੯॥੬੯੪੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau ninaanave charitr samaapatam sat subham sat ||389||6946||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੮੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੮੯॥੬੯੪੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ निनानवे चरित्र समापतम सतु सुभम सतु ॥३८९॥६९४६॥अफजूँ॥",
      "sourceLineId": "137718",
      "sourceShabadId": "12726",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137719",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਾਹੁਲੀਕ ਸੁਨਿਯਤ ਰਾਜਾ ਜਹ ॥",
      "transliteration": "baahuleek suniyat raajaa jeh ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਹੁਲੀਕ ਨਾ ਦਾ ਜੋ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "बाहुलीक सुनियत राजा जह ॥",
      "sourceLineId": "137720",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਿਹ ਸਮਾਨ ਕੋਈ ਭਯੋ ਦੁਤਿਯ ਨਹ ॥",
      "transliteration": "jeh samaan koiee bhayo dhutiy neh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗਾ ਕੋਈ ਦੂਜਾ ਨਹੀਂ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "जिह समान कोई भयो दुतिय नह ॥",
      "sourceLineId": "137721",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1341_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਧਾਮ ਗੌਹਰਾ ਰਾਇ ਦੁਲਾਰੀ ॥",
      "transliteration": "dhaam gauaharaa rai dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਘਰ ਗੌਹਰਾ ਰਾਇ ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1341,
      "hindi": "",
      "hindiTransliteration": "धाम गौहरा राइ दुलारी ॥",
      "sourceLineId": "137722",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
