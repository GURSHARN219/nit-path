{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1342,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1342_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਹ ਸਮਾਨ ਨਹਿ ਦੇਵ ਕੁਮਾਰੀ ॥੧॥",
      "transliteration": "jeh samaan neh dhev kumaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਕੋਈ ਦੇਵ ਕੰਨਿਆ ਵੀ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "जिह समान नहि देव कुमारी ॥१॥",
      "sourceLineId": "137723",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਹ ਇਕ ਹੁਤਾ ਸਾਹ ਕਾ ਬੇਟਾ ॥",
      "transliteration": "teh ik hutaa saeh kaa beTaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "तह इक हुता साह का बेटा ॥",
      "sourceLineId": "137724",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਿਹ ਸਮਾਨ ਕੋ ਭਯੋ ਨ ਭੇਟਾ ॥",
      "transliteration": "jeh samaan ko bhayo na bheTaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਕਿਤੇ ਕੋਈ ਮਿਲਿਆ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "जिह समान को भयो न भेटा ॥",
      "sourceLineId": "137725",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਏਕ ਸੁਘਰ ਅਰੁ ਸੁੰਦਰ ਘਨੋ ॥",
      "transliteration": "ek sughar ar su(n)dhar ghano ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਕ ਸੁਘੜ ਸੀ ਅਤੇ (ਦੂਜੇ) ਬਹੁਤ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "एक सुघर अरु सुँदर घनो ॥",
      "sourceLineId": "137726",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਨੁ ਅਵਤਾਰ ਮਦਨ ਕੋ ਬਨੋ ॥੨॥",
      "transliteration": "jan avataar madhan ko bano ||2||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਮ ਦੇਵ ਦਾ ਅਵਤਾਰ ਬਣਿਆ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "जनु अवतार मदन को बनो ॥२॥",
      "sourceLineId": "137727",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭੂਪ ਸੁਤਾ ਤਿਹ ਨਿਰਖਿ ਲੁਭਾਈ ॥",
      "transliteration": "bhoop sutaa teh nirakh lubhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਮੋਹਿਤ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "भूप सुता तिह निरखि लुभाई ॥",
      "sourceLineId": "137728",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗਿਰੀ ਭੂਮਿ ਜਨੁ ਨਾਗ ਚਬਾਈ ॥",
      "transliteration": "giree bhoom jan naag chabaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਈ, ਮਾਨੋ ਸੱਪ ਨੇ ਡੰਗੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "गिरी भूमि जनु नाग चबाई ॥",
      "sourceLineId": "137729",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਖੀ ਏਕ ਤਿਹ ਤੀਰ ਪਠਾਈ ॥",
      "transliteration": "sakhee ek teh teer paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਸਖੀ ਨੂੰ ਉਸ ਕੋਲ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "सखी एक तिह तीर पठाई ॥",
      "sourceLineId": "137730",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਾਜਿ ਰਾਇ ਕਹ ਲਿਯਾ ਬੁਲਾਈ ॥੩॥",
      "transliteration": "gaaj rai keh liyaa bulaiee ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗਾਜਿ ਰਾਇ ਨੂੰ ਬੁਲਾ ਲਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "गाजि राइ कह लिया बुलाई ॥३॥",
      "sourceLineId": "137731",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਬ ਤਿਹ ਲਖਾ ਸਜਨ ਘਰ ਆਯੋ ॥",
      "transliteration": "jab teh lakhaa sajan ghar aayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ ਨੇ ਸੱਜਨ ਨੂੰ ਘਰ ਆਇਆ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "जब तिह लखा सजन घर आयो ॥",
      "sourceLineId": "137732",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕੰਠ ਗੌਹਰਾ ਰਾਇ ਲਗਾਯੋ ॥",
      "transliteration": "ka(n)Th gauaharaa rai lagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਗੌਹਰਾ ਰਾਇ ਨੇ (ਉਸ ਨੂੰ) ਗਲੇ ਨਾਲ ਲਗਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "कंठ गौहरा राइ लगायो ॥",
      "sourceLineId": "137733",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਕਰੇ ਤਵਨ ਸੌ ਭੋਗਾ ॥",
      "transliteration": "bahu bidh kare tavan sau bhogaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਬਹੁਤ ਤਰ੍ਰਹਾ ਦਾ ਰਮਣ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि करे तवन सौ भोगा ॥",
      "sourceLineId": "137734",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੂਰਿ ਕਰਾ ਜਿਯ ਕਾ ਸਭ ਸੋਗਾ ॥੪॥",
      "transliteration": "dhoor karaa jiy kaa sabh sogaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਨ ਦਾ ਸਾਰਾ ਗ਼ਮ ਦੂਰ ਕਰ ਦਿੱਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "दूरि करा जिय का सभ सोगा ॥४॥",
      "sourceLineId": "137735",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭੋਗ ਕਰਤ ਭਾਯੋ ਅਤਿ ਪ੍ਯਾਰੋ ॥",
      "transliteration": "bhog karat bhaayo at payaaro ||",
      "translation": "",
      "punjabiViakhya": "ਰਮਣ ਕਰਨ ਦੌਰਾਨ ਉਹ ਪਿਆਰਾ ਬਹੁਤ ਚੰਗਾ ਲਗਣ ਲਗ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "भोग करत भायो अति प्यारो ॥",
      "sourceLineId": "137736",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਛਿਨ ਨ ਕਰਤ ਆਪਨ ਤੇ ਨ੍ਯਾਰੋ ॥",
      "transliteration": "chhin na karat aapan te nayaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਛਿਣ ਭਰ ਲਈ ਵੀ ਆਪਣੇ ਤੋਂ ਦੂਰ ਨਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "छिन न करत आपन ते न्यारो ॥",
      "sourceLineId": "137737",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੀ ਕੈਫ ਪਿਲਾਵੈ ॥",
      "transliteration": "bhaat bhaat kee kaif pilaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਤਰ੍ਰਹਾ ਤਰ੍ਰਹਾ ਦੀ ਸ਼ਰਾਬ ਪਿਲਾਉਾਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "भाति भाति की कैफ पिलावै ॥",
      "sourceLineId": "137738",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਭ੍ਰ ਸੇਜ ਚੜਿ ਭੋਗ ਕਮਾਵੈ ॥੫॥",
      "transliteration": "subhr sej chaR bhog kamaavai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੁੰਦਰ ਸੇਜ ਉਤੇ ਚੜ੍ਰਹ ਕੇ ਸੰਯੋਗ ਕਰਦੀ ਸੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "सुभ्र सेज चड़ि भोग कमावै ॥५॥",
      "sourceLineId": "137739",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਬ ਤਹ ਤਾਤ ਤਵਨ ਕਾ ਆਯੋ ॥",
      "transliteration": "tab teh taat tavan kaa aayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ ਦਾ ਪਿਤਾ ਉਥੇ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "तब तह तात तवन का आयो ॥",
      "sourceLineId": "137740",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤ੍ਰਸਤ ਦੇਗ ਮਹਿ ਤਾਹਿ ਛਪਾਯੋ ॥",
      "transliteration": "trasat dheg meh taeh chhapaayo ||",
      "translation": "",
      "punjabiViakhya": "ਡਰ ਦੇ ਮਾਰੇ ਉਸ (ਯਾਰ) ਨੂੰ ਦੇਗ ਵਿਚ ਲੁਕਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "त्रसत देग महि ताहि छपायो ॥",
      "sourceLineId": "137741",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰੌਜਨ ਮੂੰਦਿ ਹੌਜ ਮਹਿ ਧਰਾ ॥",
      "transliteration": "rauajan moo(n)dh hauaj meh dharaa ||",
      "translation": "",
      "punjabiViakhya": "(ਦੇਗ ਦਾ) ਮੂੰਹ ਬੰਦ ਕਰ ਕੇ ਹੌਜ਼ (ਤਾਲਾਬ) ਵਿਚ ਰਖ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "रौजन मूँदि हौज महि धरा ॥",
      "sourceLineId": "137742",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਏਕ ਬੂੰਦ ਜਲ ਬੀਚ ਨ ਪਰਾ ॥੬॥",
      "transliteration": "ek boo(n)dh jal beech na paraa ||6||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਅੰਦਰ) ਪਾਣੀ ਦੀ ਇਕ ਬੂੰਦ ਵੀ ਨਾ ਜਾਣ ਦਿੱਤੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "एक बूँद जल बीच न परा ॥६॥",
      "sourceLineId": "137743",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਿਤਹਿ ਤਾਲ ਤਤਕਾਲ ਦਿਖਾਯੋ ॥",
      "transliteration": "piteh taal tatakaal dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਪਿਤਾ ਨੂੰ ਉਸੇ ਵੇਲੇ ਹੌਜ਼ ('ਤਾਲ') ਵਿਖਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "पितहि ताल ततकाल दिखायो ॥",
      "sourceLineId": "137744",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬੀਚ ਬੇਰੀਯਨ ਡਾਰਿ ਫਿਰਾਯੋ ॥",
      "transliteration": "beech bereeyan ddaar firaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬੇੜੀ ਵਿਚ ਪਾ ਕੇ (ਸਾਰੇ ਤਾਲਾਬ) ਵਿਚ ਫਿਰਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "बीच बेरीयन डारि फिरायो ॥",
      "sourceLineId": "137745",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੀਏ ਜਰਾਇ ਬੀਚ ਤਿਹ ਡਾਰੇ ॥",
      "transliteration": "dhe'ee jarai beech teh ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਿਚ ਦੀਵੇ ਜਗਾ ਕੇ ਰਖ ਦਿੱਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "दीए जराइ बीच तिह डारे ॥",
      "sourceLineId": "137746",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਨੁ ਕਰਿ ਚੜੇ ਰੈਨਿ ਕੇ ਤਾਰੇ ॥੭॥",
      "transliteration": "jan kar chaRe rain ke taare ||7||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਰਾਤ ਨੂੰ ਤਾਰੇ ਨਿਕਲ ਆਏ ਹੋਣ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "जनु करि चड़े रैनि के तारे ॥७॥",
      "sourceLineId": "137747",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਿਤਹਿ ਅਚੰਭਵ ਐਸ ਦਿਖਾਯੋ ॥",
      "transliteration": "piteh acha(n)bhav aais dhikhaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਪਿਤਾ ਨੂੰ ਅਜਿਹਾ ਅਚਰਜ ਦ੍ਰਿਸ਼ ਵਿਖਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "पितहि अचंभव ऐस दिखायो ॥",
      "sourceLineId": "137748",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਮਾਧਾਨ ਕਰਿ ਧਾਮ ਪਠਾਯੋ ॥",
      "transliteration": "samaadhaan kar dhaam paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਸੱਲੀ ਕਰਾ ਕੇ ਘਰ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "समाधान करि धाम पठायो ॥",
      "sourceLineId": "137749",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਿਤ੍ਰਹਿ ਕਾਢ ਸੇਜ ਪਰ ਲੀਨਾ ॥",
      "transliteration": "mitreh kaadd sej par leenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਮਿਤਰ ਨੂੰ (ਦੇਗ ਵਿਚੋਂ) ਕਢ ਕੇ ਸੇਜ ਉਤੇ ਲੈ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "मित्रहि काढ सेज पर लीना ॥",
      "sourceLineId": "137750",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਬਹੁ ਬਿਧਿ ਤਨ ਕੀਨਾ ॥੮॥",
      "transliteration": "kaam bhog bahu bidh tan keenaa ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨਾਲ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "काम भोग बहु बिधि तन कीना ॥८॥",
      "sourceLineId": "137751",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਨਬੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੦॥੬੯੫੪॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau nabe charitr samaapatam sat subham sat ||390||6954||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੯੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੯੦॥੬੯੫੪॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ नबे चरित्र समापतम सतु सुभम सतु ॥३९०॥६९५४॥अफजूँ॥",
      "sourceLineId": "137752",
      "sourceShabadId": "12727",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137753",
      "sourceShabadId": "12728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਰਬਰੀਨ ਕੋ ਦੇਸ ਬਸਤ ਜਹ ॥",
      "transliteration": "barabareen ko dhes basat jeh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਬਰਬਰੀਨ ਨਾ ਦਾ ਦੇਸ ਆਬਾਦ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "बरबरीन को देस बसत जह ॥",
      "sourceLineId": "137754",
      "sourceShabadId": "12728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਰਬਰ ਪੁਰ ਇਕ ਨਗਰ ਹੁਤੋ ਤਹ ॥",
      "transliteration": "barabar pur ik nagar huto teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਰਬਰ ਪੁਰ ਨਾ ਦਾ ਨਗਰ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "बरबर पुर इक नगर हुतो तह ॥",
      "sourceLineId": "137755",
      "sourceShabadId": "12728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਫਕਨ ਸੇਰ ਤਹਾ ਕਾ ਰਾਜਾ ॥",
      "transliteration": "afakan ser tahaa kaa raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਫਕਨ (ਅਫ਼ਗ਼ਨ) ਸ਼ੇਰ ਨਾ ਦਾ ਉਥੋਂ ਦਾ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "अफकन सेर तहा का राजा ॥",
      "sourceLineId": "137756",
      "sourceShabadId": "12728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਹ ਸਮਾਨ ਬਿਧਿ ਦੁਤਿਯ ਨ ਸਾਜਾ ॥੧॥",
      "transliteration": "jeh samaan bidh dhutiy na saajaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗਾ ਵਿਧਾਤਾ ਨੇ ਹੋਰ ਕੋਈ ਨਹੀਂ ਬਣਾਇਆ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "जिह समान बिधि दुतिय न साजा ॥१॥",
      "sourceLineId": "137757",
      "sourceShabadId": "12728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪੀਰ ਮੁਹੰਮਦ ਤਹ ਇਕ ਕਾਜੀ ॥",
      "transliteration": "peer muha(n)madh teh ik kaajee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਪੀਰ ਮੁਹੰਮਦ ਨਾ ਦਾ ਕਾਜ਼ੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "पीर मुहंमद तह इक काजी ॥",
      "sourceLineId": "137758",
      "sourceShabadId": "12728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੇਹ ਕੁਰੂਪ ਨਾਥ ਜਿਹ ਸਾਜੀ ॥",
      "transliteration": "dheh kuroop naath jeh saajee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਸ਼ਰੀਰ ਵਿਧਾਤਾ ਨੇ ਬਹੁਤ ਕੁਰੂਪ ਬਣਾਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "देह कुरूप नाथ जिह साजी ॥",
      "sourceLineId": "137759",
      "sourceShabadId": "12728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਧਾਮ ਖਾਤਿਮਾ ਬਾਨੋ ਨਾਰੀ ॥",
      "transliteration": "dhaam khaatimaa baano naaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਖ਼ਾਤਿਮਾ ਬਾਨੋ ਨਾ ਦੀ ਇਸਤਰੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "धाम खातिमा बानो नारी ॥",
      "sourceLineId": "137760",
      "sourceShabadId": "12728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਿਹ ਸਮਾਨ ਨਹਿ ਰਾਜ ਦੁਲਾਰੀ ॥੨॥",
      "transliteration": "jeh samaan neh raaj dhulaaree ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਕੋਈ ਰਾਜ ਕੁਮਾਰੀ ਵੀ ਨਹੀਂ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "जिह समान नहि राज दुलारी ॥२॥",
      "sourceLineId": "137761",
      "sourceShabadId": "12728",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੋਰਠਾ ॥",
      "transliteration": "soraThaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਰਠਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "सोरठा ॥",
      "sourceLineId": "137762",
      "sourceShabadId": "12729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੁੰਦਰ ਤਾ ਕੀ ਨਾਰਿ ਅਤਿ ਕੁਰੂਪ ਕਾਜੀ ਰਹੈ ॥",
      "transliteration": "su(n)dhar taa kee naar at kuroop kaajee rahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਇਸਤਰੀ ਬਹੁਤ ਸੁੰਦਰ ਸੀ ਪਰ ਕਾਜ਼ੀ (ਆਪ) ਬਹੁਤ ਕੁਰੂਪ ਹੁੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "सुँदर ता की नारि अति कुरूप काजी रहै ॥",
      "sourceLineId": "137763",
      "sourceShabadId": "12729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਬ ਤਿਨ ਕਿਯਾ ਬਿਚਾਰਿ ਕਿਹ ਬਿਧਿ ਬਧ ਯਾ ਕੌ ਕਰੋ ॥੩॥",
      "transliteration": "tab tin kiyaa bichaar keh bidh badh yaa kau karo ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਸ (ਇਸਤਰੀ) ਨੇ ਵਿਚਾਰ ਕੀਤਾ ਕਿ ਇਸ ਦਾ ਕਿਵੇਾਂ ਬਧ ਕੀਤਾ ਜਾਏ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "तब तिन किया बिचारि किह बिधि बध या कौ करो ॥३॥",
      "sourceLineId": "137764",
      "sourceShabadId": "12729",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137765",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਾਹ ਪੁਤ੍ਰ ਤਿਹ ਪੁਰ ਇਕ ਆਯੋ ॥",
      "transliteration": "saeh putr teh pur ik aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਗਰ ਵਿਚ ਇਕ ਸ਼ਾਹ ਦਾ ਪੁੱਤਰ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "साह पुत्र तिह पुर इक आयो ॥",
      "sourceLineId": "137766",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਾਕੇ ਰਾਇ ਸਰੂਪ ਸਵਾਯੋ ॥",
      "transliteration": "baake rai saroop savaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਬਾਕੇ ਰਾਇ ਦਾ ਸਰੂਪ ਬਹੁਤ ਅਧਿਕ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "बाके राइ सरूप सवायो ॥",
      "sourceLineId": "137767",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਾਜੀ ਕੀ ਇਸਤ੍ਰੀ ਤਿਹ ਲਹਾ ॥",
      "transliteration": "kaajee kee isatree teh lahaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਜ਼ੀ ਦੀ ਪਤਨੀ ਨੇ ਉਸ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "काजी की इसत्री तिह लहा ॥",
      "sourceLineId": "137768",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਰੌ ਇਸੀ ਕਹ ਚਿਤ ਯੌ ਕਹਾ ॥੪॥",
      "transliteration": "barau isee keh chit yau kahaa ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਿਤ ਵਿਚ ਸੋਚਿਆ ਕਿ ਇਸੇ ਨਾਲ ਵਿਆਹ ਕੀਤਾ ਜਾਏ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "बरौ इसी कह चित यौ कहा ॥४॥",
      "sourceLineId": "137769",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1342_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੁਸਲਮਾਨ ਬਹੁ ਧਾਮ ਬੁਲਾਵਤ ॥",
      "transliteration": "musalamaan bahu dhaam bulaavat ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਹੁਤ ਮੁਸਲਮਾਨਾ ਨੂੰ ਘਰ ਬੁਲਾਉਾਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": "मुसलमान बहु धाम बुलावत ॥",
      "sourceLineId": "137770",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
