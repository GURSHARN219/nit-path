{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1343,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1343_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਦਰਬ ਲੁਟਾਵਤ ॥",
      "transliteration": "bhaat bhaat tan dharab luTaavat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਨਾਲ ਧਨ ਨੂੰ ਲੁਟਾਉਾਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन दरब लुटावत ॥",
      "sourceLineId": "137771",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਯੌ ਕਹਿ ਸਭਹੂੰ ਸੀਸ ਝੁਕਾਵੈ ॥",
      "transliteration": "yau keh sabhahoo(n) sees jhukaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਹ ਕਹਿ ਕੇ ਸਾਰਿਆਂ ਅਗੇ ਸੀਸ ਝੁਕਾਉਾਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "यौ कहि सभहूँ सीस झुकावै ॥",
      "sourceLineId": "137772",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਯਹ ਕਾਜੀ ਸੁੰਦਰ ਹ੍ਵੈ ਜਾਵੈ ॥੫॥",
      "transliteration": "yeh kaajee su(n)dhar havai jaavai ||5||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਹ ਕਾਜ਼ੀ ਸੁੰਦਰ ਹੋ ਜਾਵੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "यह काजी सुँदर ह्वै जावै ॥५॥",
      "sourceLineId": "137773",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਉਪ ਪਤਿਹਿ ਬੁਲਾਈ ॥",
      "transliteration": "ek dhivas up pateh bulaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਦਿਨ ਉਪ-ਪਤੀ (ਯਾਰ) ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "एक दिवस उप पतिहि बुलाई ॥",
      "sourceLineId": "137774",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਾਨ ਲਾਗਿ ਸਭ ਬਾਤ ਸਿਖਾਈ ॥",
      "transliteration": "kaan laag sabh baat sikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕੰਨ ਨਾਲ ਲਗ ਕੇ ਸਾਰੀ ਗੱਲ ਸਮਝਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "कान लागि सभ बात सिखाई ॥",
      "sourceLineId": "137775",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬੀਚ ਛਪਾਇ ਸਦਨ ਕੇ ਰਾਖਾ ॥",
      "transliteration": "beech chhapai sadhan ke raakhaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਲੁਕਾ ਕੇ ਘਰ ਵਿਚ ਰਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "बीच छपाइ सदन के राखा ॥",
      "sourceLineId": "137776",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਔਰ ਨਾਰਿ ਸੌ ਭੇਵ ਨ ਭਾਖਾ ॥੬॥",
      "transliteration": "aauar naar sau bhev na bhaakhaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਕਿਸੇ ਇਸਤਰੀ ਨੂੰ ਭੇਦ ਨਾ ਦਸਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "और नारि सौ भेव न भाखा ॥६॥",
      "sourceLineId": "137777",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਭ ਮਲੇਛ ਉਠਿ ਫਜਿਰ ਬੁਲਾਏ ॥",
      "transliteration": "sabh malechh uTh fajir bulaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸਵੇਰ ('ਫਜਿਰ') ਹੋਣ ਤੇ ਸਾਰਿਆਂ ਮੁਸਲਮਾਨਾ ('ਮਲੇਛ') ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "सभ मलेछ उठि फजिर बुलाए ॥",
      "sourceLineId": "137778",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੇ ਸਾਥ ਜਿਵਾਏ ॥",
      "transliteration": "bhaat bhaat ke saath jivaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤਰ੍ਰਹਾ ਤਰ੍ਰਹਾ ਦੇ ਭੋਜਨ ਕਰਵਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "भाति भाति के साथ जिवाए ॥",
      "sourceLineId": "137779",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਹਿਯੋ ਸਭੈ ਮਿਲਿ ਦੇਹੁ ਦੁਆਇ ॥",
      "transliteration": "kahiyo sabhai mil dheh dhuaai ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੀ ਕਿ) ਸਾਰੇ ਮਿਲ ਕੇ ਦੁਆ ਦਿਓ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "कहियो सभै मिलि देहु दुआइ ॥",
      "sourceLineId": "137780",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਮ ਪਤਿ ਸੁੰਦਰਿ ਕਰੈ ਖੁਦਾਇ ॥੭॥",
      "transliteration": "mam pat su(n)dhar karai khudhai ||7||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਰੱਬ ਮੇਰੇ ਪਤੀ ਨੂੰ ਸੁੰਦਰ ਕਰ ਦੇਵੇ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "मम पति सुँदरि करै खुदाइ ॥७॥",
      "sourceLineId": "137781",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਭਹੂੰ ਹਾਥ ਤਸਬਿਯੈ ਲੀਨੀ ॥",
      "transliteration": "sabhahoo(n) haath tasabiyai leenee ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੇ ਹੱਥਾ ਵਿਚ ਤਸਬੀਆਂ (ਮਾਲਾਵਾ) ਪਕੜ ਲਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "सभहूँ हाथ तसबियै लीनी ॥",
      "sourceLineId": "137782",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਦੁਆਇ ਤਵਨ ਕਹ ਦੀਨੀ ॥",
      "transliteration": "bahu bidh dhuaai tavan keh dheenee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਦੁਆਵਾ ਦਿੱਤੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि दुआइ तवन कह दीनी ॥",
      "sourceLineId": "137783",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਕਰੀ ਸੁਨਾਇ ॥",
      "transliteration": "bhaat bhaat tan karee sunai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਸੁਣਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन करी सुनाइ ॥",
      "sourceLineId": "137784",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਵ ਪਤਿ ਸੁੰਦਰ ਕਰੈ ਖੁਦਾਇ ॥੮॥",
      "transliteration": "tav pat su(n)dhar karai khudhai ||8||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੇਰੇ ਪਤੀ ਨੂੰ ਖ਼ੁਦਾ ਸੁੰਦਰ ਕਰ ਦੇਵੇ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "तव पति सुँदर करै खुदाइ ॥८॥",
      "sourceLineId": "137785",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਲੈ ਦੁਆਇ ਤ੍ਰਿਯ ਧਾਮ ਸਿਧਾਈ ॥",
      "transliteration": "lai dhuaai tiray dhaam sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਦੁਆ ਲੈ ਕੇ ਇਸਤਰੀ ਘਰ ਨੂੰ ਆ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "लै दुआइ तृय धाम सिधाई ॥",
      "sourceLineId": "137786",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਾਰਿ ਕਾਜਿਯਹਿ ਦਿਯੋ ਦਬਾਈ ॥",
      "transliteration": "maar kaajiyeh dhiyo dhabaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਜ਼ੀ ਨੂੰ ਮਾਰ ਕੇ ਦਬਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "मारि काजियहि दियो दबाई ॥",
      "sourceLineId": "137787",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਰਿ ਕਾਜੀ ਲੈਗੀ ਤਿਹ ਤਹਾ ॥",
      "transliteration": "kar kaajee laigee teh tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਯਾਰ) ਨੂੰ ਕਾਜ਼ੀ ਬਣਾ ਕੇ ਉਥੇ ਲੈ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "करि काजी लैगी तिह तहा ॥",
      "sourceLineId": "137788",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪੜਤ ਕਿਤਾਬ ਮੁਲਾਨੇ ਜਹਾ ॥੯॥",
      "transliteration": "paRat kitaab mulaane jahaa ||9||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਮੌਲਾਣੇ ਕਿਤਾਬ ('ਕੁਰਾਨ') ਪੜ੍ਰਹ ਰਹੇ ਸਨ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "पड़त किताब मुलाने जहा ॥९॥",
      "sourceLineId": "137789",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪ੍ਰਜਾ ਨਿਰਖਿ ਤਾ ਕਹ ਹਰਖਾਨੀ ॥",
      "transliteration": "prajaa nirakh taa keh harakhaanee ||",
      "translation": "",
      "punjabiViakhya": "(ਸਾਰੀ) ਪ੍ਰਜਾ ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਪ੍ਰਸੰਨ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "प्रजा निरखि ता कह हरखानी ॥",
      "sourceLineId": "137790",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਾਚੁ ਕਿਤਾਬ ਆਪਨੀ ਜਾਨੀ ॥",
      "transliteration": "saach kitaab aapanee jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੀ ਕਿਤਾਬ ਨੂੰ ਸੱਚਾ ਮੰਨਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "साचु किताब आपनी जानी ॥",
      "sourceLineId": "137791",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹਮ ਜੋ ਯਾ ਕਹ ਦਈ ਦੁਆਇ ॥",
      "transliteration": "ham jo yaa keh dhiee dhuaai ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੇ) ਅਸੀਂ ਜੋ ਇਸ ਨੂੰ ਦੁਆ ਦਿੱਤੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "हम जो या कह दई दुआइ ॥",
      "sourceLineId": "137792",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਯਾ ਤੇ ਸੁੰਦਰ ਕਰਾ ਖੁਦਾਇ ॥੧੦॥",
      "transliteration": "yaa te su(n)dhar karaa khudhai ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਕਰ ਕੇ ਰੱਬ ਨੇ (ਇਸ ਨੂੰ) ਸੁੰਦਰ ਕਰ ਦਿੱਤਾ ਹੈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "या ते सुँदर करा खुदाइ ॥१०॥",
      "sourceLineId": "137793",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਪ੍ਰਥਮ ਕਾਜਿਯਹਿ ਘਾਈ ॥",
      "transliteration": "eeh bidh pratham kaajiyeh ghaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਨੇ ਪਹਿਲਾ ਕਾਜ਼ੀ ਨੂੰ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "इह बिधि प्रथम काजियहि घाई ॥",
      "sourceLineId": "137794",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਰਤ ਭਈ ਅਪਨਾ ਸੁਖਦਾਈ ॥",
      "transliteration": "barat bhiee apanaa sukhadhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਮਿਤਰ ਨਾਲ ਵਿਆਹ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "बरत भई अपना सुखदाई ॥",
      "sourceLineId": "137795",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂੰ ਬਿਚਾਰਾ ॥",
      "transliteration": "bhedh abhedh na kinoo(n) bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न किनूँ बिचारा ॥",
      "sourceLineId": "137796",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਹ ਛਲ ਬਰਾ ਅਪਨਾ ਪ੍ਯਾਰਾ ॥੧੧॥",
      "transliteration": "eeh chhal baraa apanaa payaaraa ||11||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਆਪਣੇ ਯਾਰ ਨਾਲ ਵਿਆਹ ਕਰ ਲਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "इह छल बरा अपना प्यारा ॥११॥",
      "sourceLineId": "137797",
      "sourceShabadId": "12730",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137798",
      "sourceShabadId": "12731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੁਮ ਸਭ ਹੀ ਅਤਿ ਕ੍ਰਿਪਾ ਕਰ ਦੀਨੀ ਹਮੈ ਦੁਆਇ ॥",
      "transliteration": "tum sabh hee at kirapaa kar dheenee hamai dhuaai ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀ ਕਹਿਣ ਲਗੀ) ਤੁਸਾ ਸਾਰਿਆਂ ਨੇ ਬਹੁਤ ਮਿਹਰਬਾਨੀ ਕਰ ਕੇ ਮੈਨੂੰ ਦੁਆ ਦਿੱਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "तुम सभ ही अति कृपा कर दीनी हमै दुआइ ॥",
      "sourceLineId": "137799",
      "sourceShabadId": "12731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਾ ਤੇ ਪਤਿ ਸੁੰਦਰ ਭਯੋ ਕੀਨੀ ਮਯਾ ਖੁਦਾਇ ॥੧੨॥",
      "transliteration": "taa te pat su(n)dhar bhayo keenee mayaa khudhai ||12||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਰੱਬ ਨੇ ਮਿਹਰ ਕੀਤੀ ਅਤੇ ਮੇਰਾ ਪਤੀ ਸੁੰਦਰ ਬਣਾ ਦਿੱਤਾ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "ता ते पति सुँदर भयो कीनी मया खुदाइ ॥१२॥",
      "sourceLineId": "137800",
      "sourceShabadId": "12731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਇਕ੍ਯਾਨਵੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੧॥੬੯੬੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau ikayaanave charitr samaapatam sat subham sat ||391||6966||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੯੧ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੯੧॥੬੯੬੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ इक्यानवे चरित्र समापतम सतु सुभम सतु ॥३९१॥६९६६॥अफजूँ॥",
      "sourceLineId": "137801",
      "sourceShabadId": "12731",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137802",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭੂਪ ਸੁ ਧਰਮ ਸੈਨ ਇਕ ਸੁਨਿਯਤ ॥",
      "transliteration": "bhoop su dharam sain ik suniyat ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਮ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "भूप सु धरम सैन इक सुनियत ॥",
      "sourceLineId": "137803",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਿਹ ਸਮਾਨ ਜਗ ਦੁਤਿਯ ਨ ਗੁਨਿਯਤ ॥",
      "transliteration": "jeh samaan jag dhutiy na guniyat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਜਗਤ ਵਿਚ ਕੋਈ ਹੋਰ ਨਹੀਂ ਸਮਝਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "जिह समान जग दुतिय न गुनियत ॥",
      "sourceLineId": "137804",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੰਦਨ ਦੇ ਤਿਹ ਨਾਰਿ ਭਨਿਜੈ ॥",
      "transliteration": "cha(n)dhan dhe teh naar bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਨਾਰੀ ਦਾ ਨਾ ਚੰਦਨ ਦੇ (ਦੇਈ) ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "चंदन दे तिह नारि भनिजै ॥",
      "sourceLineId": "137805",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਹ ਮੁਖ ਛਬਿ ਨਿਸਕਰ ਕਹ ਦਿਜੈ ॥੧॥",
      "transliteration": "jeh mukh chhab nisakar keh dhijai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਮੂੰਹ ਦੀ (ਉਪਮਾ) ਚੰਦ੍ਰਮਾ ਨਾਲ ਦਿੱਤੀ ਜਾਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "जिह मुख छबि निसकर कह दिजै ॥१॥",
      "sourceLineId": "137806",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੰਦਲ ਦੇ ਦੁਹਿਤਾ ਤਿਹ ਸੁਹੈ ॥",
      "transliteration": "sa(n)dhal dhe dhuhitaa teh suhai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸੰਦਲ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "संदल दे दुहिता तिह सुहै ॥",
      "sourceLineId": "137807",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਖਗ ਮ੍ਰਿਗ ਜਛ ਭੁਜੰਗਨ ਮੋਹੈ ॥",
      "transliteration": "khag mirag jachh bhuja(n)gan mohai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪੰਛੀਆਂ, ਮਿਰਗਾ, ਯਕਸ਼ਾ, ਸੱਪਾ ਆਦਿ (ਸਭ ਨੂੰ) ਮੋਹੰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "खग मृग जछ भुजंगन मोहै ॥",
      "sourceLineId": "137808",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਧਿਕ ਪ੍ਰਭਾ ਤਨ ਮੋ ਤਿਨ ਧਰੀ ॥",
      "transliteration": "adhik prabhaa tan mo tin dharee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸ਼ਰੀਰ ਵਿਚ ਬਹੁਤ ਪ੍ਰਭਾ ਧਾਰੀ ਹੋਈ ਸੀ। (ਇੰਜ ਲਗਦਾ ਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "अधिक प्रभा तन मो तिन धरी ॥",
      "sourceLineId": "137809",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਦਨ ਸੁ ਨਾਰ ਭਰਤ ਜਨੁ ਭਰੀ ॥੨॥",
      "transliteration": "madhan su naar bharat jan bharee ||2||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਕਾਮ ਦੇਵ ਨੇ (ਆਪ ਉਸ ਦੀ) ਭਰਤ ਭਰੀ ਹੋਵੇ (ਭਾਵ ਬਣਾਈ ਹੋਵੇ) ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "मदन सु नार भरत जनु भरी ॥२॥",
      "sourceLineId": "137810",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੁਤ ਏਕ ਸੁਘਰ ਤਿਨ ਹੇਰਿਯੋ ॥",
      "transliteration": "nirap sut ek sughar tin heriyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਸੁਘੜ ਰਾਜ ਕੁਮਾਰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "नृप सुत एक सुघर तिन हेरियो ॥",
      "sourceLineId": "137811",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਦਨ ਆਨਿ ਤਾ ਕਾ ਤਨ ਘੇਰਿਯੋ ॥",
      "transliteration": "madhan aan taa kaa tan gheriyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਮ ਦੇਵ ਨੇ ਉਸ ਦੇ ਸ਼ਰੀਰ ਨੂੰ ਆ ਘੇਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "मदन आनि ता का तन घेरियो ॥",
      "sourceLineId": "137812",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਖੀ ਏਕ ਤਹ ਦਈ ਪਠਾਈ ॥",
      "transliteration": "sakhee ek teh dhiee paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਉਸ ਕੋਲ ਇਕ ਸਖੀ ਨੂੰ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "सखी एक तह दई पठाई ॥",
      "sourceLineId": "137813",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਨਿਕ ਜਤਨ ਕਰਿ ਕੈ ਤਿਹ ਲ੍ਯਾਈ ॥੩॥",
      "transliteration": "anik jatan kar kai teh layaiee ||3||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਅਨੇਕ ਯਤਨ ਕਰ ਕੇ ਉਸ ਨੂੰ ਲੈ ਆਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "अनिक जतन करि कै तिह ल्याई ॥३॥",
      "sourceLineId": "137814",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਨਿ ਸਜਨ ਤਿਨ ਦਯੋ ਮਿਲਾਇ ॥",
      "transliteration": "aan sajan tin dhayo milai ||",
      "translation": "",
      "punjabiViakhya": "(ਸਖੀ ਨੇ) ਮਿਤਰ ਨੂੰ ਲਿਆ ਕੇ ਰਾਜ ਕੁਮਾਰੀ ਨਾਲ ਮਿਲਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "आनि सजन तिन दयो मिलाइ ॥",
      "sourceLineId": "137815",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰਮੀ ਕੁਅਰਿ ਤਾ ਸੌ ਲਪਟਾਇ ॥",
      "transliteration": "ramee kuar taa sau lapaTai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਸ ਨਾਲ ਲਿਪਟ ਕੇ ਰਮਣ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "रमी कुअरि ता सौ लपटाइ ॥",
      "sourceLineId": "137816",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਟਕ ਗਯੋ ਜਿਯ ਤਜਾ ਨ ਜਾਈ ॥",
      "transliteration": "aTak gayo jiy tajaa na jaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਮਨ (ਰਾਜ ਕੁਮਾਰ) ਨਾਲ ਅਟਕ ਗਿਆ, (ਅਤੇ ਹੁਣ ਉਸ ਨੂੰ) ਛਡਿਆ ਨਹੀਂ ਸੀ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "अटक गयो जिय तजा न जाई ॥",
      "sourceLineId": "137817",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਤਿਨ ਕੀਨੀ ਚਤੁਰਾਈ ॥੪॥",
      "transliteration": "eeh bidh tin keenee chaturaiee ||4||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ ਸਦਾ ਲਈ ਪ੍ਰਾਪਤ ਕਰਨ ਨਿਮਿਤ) ਉਸ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਦੀ ਚਾਲਾਕੀ ਕੀਤੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "इह बिधि तिन कीनी चतुराई ॥४॥",
      "sourceLineId": "137818",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤੋਪ ਬਡੀ ਇਕ ਲਈ ਮੰਗਾਇ ॥",
      "transliteration": "top baddee ik liee ma(n)gai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਵੱਡੀ ਤੋਪ ਮੰਗਵਾਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "तोप बडी इक लई मंगाइ ॥",
      "sourceLineId": "137819",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਹ ਮਹਿ ਬੈਠਿ ਮਨੁਛ ਤੇ ਜਾਇ ॥",
      "transliteration": "jeh meh baiTh manuchh te jai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਮਨੁੱਖ ਦੇ ਬੈਠਣ ਦੀ ਥਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "जिह महि बैठि मनुछ ते जाइ ॥",
      "sourceLineId": "137820",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮੰਤ੍ਰ ਸਕਤਿ ਕਰਿ ਤਾ ਮੋ ਬਰੀ ॥",
      "transliteration": "ma(n)tr sakat kar taa mo baree ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੰਤਰ ਦੀ ਸ਼ਕਤੀ ਨਾਲ ਉਸ ਵਿਚ ਵੜੀ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "मंत्र सकति करि ता मो बरी ॥",
      "sourceLineId": "137821",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਿਤ੍ਰ ਭਏ ਇਹ ਭਾਤਿ ਉਚਰੀ ॥੫॥",
      "transliteration": "mitr bhe ieh bhaat ucharee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਿਤਰ ਨਾਲ ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕੀਤੀ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "मित्र भए इह भाति उचरी ॥५॥",
      "sourceLineId": "137822",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਿਤ੍ਰ ਬਿਦਾ ਕਰਿ ਸਖੀ ਬੁਲਾਈ ॥",
      "transliteration": "mitr bidhaa kar sakhee bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਨੂੰ ਵਿਦਾ ਕਰ ਕੇ ਸਖੀ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "मित्र बिदा करि सखी बुलाई ॥",
      "sourceLineId": "137823",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਤਾਹਿ ਕਹਾ ਸਮੁਝਾਈ ॥",
      "transliteration": "eeh bidh taeh kahaa samujhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਨੂੰ ਸਮਝਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "इह बिधि ताहि कहा समुझाई ॥",
      "sourceLineId": "137824",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤੋਪ ਬਿਖੈ ਮੁਹਿ ਡਾਰਿ ਚਲੈਯਹੁ ॥",
      "transliteration": "top bikhai muh ddaar chalaiyahu ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੋਪ ਵਿਚ ਮੈਨੂੰ ਪਾ ਕੇ ਚਲਾਣਾ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "तोप बिखै मुहि डारि चलैयहु ॥",
      "sourceLineId": "137825",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਇਹ ਨ੍ਰਿਪ ਸੁਤ ਕੇ ਗ੍ਰਿਹ ਪਹੁਚੈਯਹੁ ॥੬॥",
      "transliteration": "eeh nirap sut ke gireh pahuchaiyahu ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਰਾਜ ਕੁਮਾਰ ਦੇ ਘਰ ਪਹੁੰਚਾ ਦੇਣਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "इह नृप सुत के गृह पहुचैयहु ॥६॥",
      "sourceLineId": "137826",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਬ ਸਹਚਰਿ ਐਸੇ ਸੁਨਿ ਲਈ ॥",
      "transliteration": "jab sahachar aaise sun liee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸਖੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "जब सहचरि ऐसे सुनि लई ॥",
      "sourceLineId": "137827",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਦਾਰੂ ਡਾਰਿ ਆਗਿ ਤਿਹ ਦਈ ॥",
      "transliteration": "dhaaroo ddaar aag teh dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ (ਤੋਪ ਵਿਚ) ਬਾਰੂਦ ('ਦਾਰੂ') ਪਾ ਕੇ ਉਸ ਨੂੰ ਅੱਗ ਦੇ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "दारू डारि आगि तिह दई ॥",
      "sourceLineId": "137828",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਗੋਰਾ ਜਿਮਿ ਲੈ ਕੁਅਰਿ ਚਲਾਯੋ ॥",
      "transliteration": "goraa jim lai kuar chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਲੇ ਵਾਗ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਚਲਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "गोरा जिमि लै कुअरि चलायो ॥",
      "sourceLineId": "137829",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਮੰਤ੍ਰ ਸਕਤਿ ਜਮ ਨਿਕਟ ਨ ਆਯੋ ॥੭॥",
      "transliteration": "ma(n)tr sakat jam nikaT na aayo ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੰਤਰ ਦੀ ਸ਼ਕਤੀ ਕਾਰਨ ਜਮ ਨੇੜੇ ਨਾ ਆਇਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "मंत्र सकति जम निकट न आयो ॥७॥",
      "sourceLineId": "137830",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਜਾਇ ਪਰੀ ਨਿਜੁ ਪ੍ਰੀਤਮ ਕੇ ਘਰ ॥",
      "transliteration": "jai paree nij preetam ke ghar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪ੍ਰੀਤਮ ਦੇ ਘਰ ਜਾ ਡਿਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "जाइ परी निजु प्रीतम के घर ॥",
      "sourceLineId": "137831",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਪਾਹਨ ਜੈਸ ਹਨਾ ਗੋਫਨ ਕਰਿ ॥",
      "transliteration": "paahan jais hanaa gofan kar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਘੁਬਾਣੀ ਵਿਚੋਂ ਪੱਥਰ ਵਗਾਇਆ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "पाहन जैस हना गोफन करि ॥",
      "sourceLineId": "137832",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਨਿਰਖਿ ਮੀਤ ਤਿਹ ਲਿਯਾ ਉਠਾਈ ॥",
      "transliteration": "nirakh meet teh liyaa uThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਨੇ ਵੇਖ ਕੇ ਉਸ ਨੂੰ ਉਠਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "निरखि मीत तिह लिया उठाई ॥",
      "sourceLineId": "137833",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਪੋਛਿ ਅੰਗਿ ਉਰ ਸਾਥ ਲਗਾਈ ॥੮॥",
      "transliteration": "pochh a(n)g ur saath lagaiee ||8||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਸ਼ਰੀਰ ਪੂੰਝ ਕੇ ਛਾਤੀ ਨਾਲ ਲਗਾ ਲਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "पोछि अंगि उर साथ लगाई ॥८॥",
      "sourceLineId": "137834",
      "sourceShabadId": "12732",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137835",
      "sourceShabadId": "12733",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਮੀਤ ਅਧਿਕ ਉਪਮਾ ਕਰੀ ਧੰਨ੍ਯ ਕੁਅਰਿ ਕਾ ਨੇਹ ॥",
      "transliteration": "meet adhik upamaa karee dha(n)nay kuar kaa neh ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਤਰ ਨੇ ਉਸ ਦੀ ਬਹੁਤ ਉਪਮਾ ਕਰ ਕੇ, ਰਾਜ ਕੁਮਾਰੀ ਦੇ ਪ੍ਰੇਮ ਨੂੰ ਧੰਨ ਕਿਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "मीत अधिक उपमा करी धंन्य कुअरि का नेह ॥",
      "sourceLineId": "137836",
      "sourceShabadId": "12733",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਗੋਲਾ ਹ੍ਵੈ ਤੋਪਹਿ ਉਡੀ ਚਿੰਤਾ ਕਰੀ ਨ ਦੇਹਿ ॥੯॥",
      "transliteration": "golaa havai topeh uddee chi(n)taa karee na dheh ||9||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਗੋਲਾ ਬਣ ਕੇ ਤੋਪ ਰਾਹੀਂ ਉਡੀ ਅਤੇ ਆਪਣੀ ਦੇਹ ਦੀ ਚਿੰਤਾ ਤਕ ਨਾ ਕੀਤੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "गोला ह्वै तोपहि उडी चिंता करी न देहि ॥९॥",
      "sourceLineId": "137837",
      "sourceShabadId": "12733",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137838",
      "sourceShabadId": "12734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਇਤੈ ਕੁਅਰਿ ਮਿਤਵਾ ਕੇ ਗਈ ॥",
      "transliteration": "eitai kuar mitavaa ke giee ||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰ ਰਾਜ ਕੁਮਾਰੀ ਮਿਤਰ ਪਾਸ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "इतै कुअरि मितवा के गई ॥",
      "sourceLineId": "137839",
      "sourceShabadId": "12734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਉਤੈ ਸਖਿਨ ਭੂਪਹਿ ਸੁਧਿ ਦਈ ॥",
      "transliteration": "autai sakhin bhoopeh sudh dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਧਰ ਸਖੀ ਨੇ ਜਾ ਕੇ ਰਾਜੇ ਨੂੰ ਖ਼ਬਰ ਕਰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "उतै सखिन भूपहि सुधि दई ॥",
      "sourceLineId": "137840",
      "sourceShabadId": "12734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਦਾਰੂ ਡਾਰਿ ਅਨਲ ਹਮ ਦਈ ॥",
      "transliteration": "dhaaroo ddaar anal ham dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਬਾਰੂਦ ਪਾ ਕੇ ਮੈਂ ਅੱਗ ਲਗਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "दारू डारि अनल हम दई ॥",
      "sourceLineId": "137841",
      "sourceShabadId": "12734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1343_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਤੋਪ ਬਿਖੈ ਤਰੁਨੀ ਉਡਿ ਗਈ ॥੧੦॥",
      "transliteration": "top bikhai tarunee udd giee ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੋਪ ਵਿਚੋਂ ਰਾਜ ਕੁਮਾਰੀ ਉਡ ਗਈ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": "तोप बिखै तरुनी उडि गई ॥१०॥",
      "sourceLineId": "137842",
      "sourceShabadId": "12734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
