{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1344,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1344_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਨੀ ਭੂਪਤ ਸਹਿਤ ਪੁਕਾਰੀ ॥",
      "transliteration": "raanee bhoopat sahit pukaaree ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਰਾਣੀ ਸਹਿਤ ਪੁਕਾਰਨ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "रानी भूपत सहित पुकारी ॥",
      "sourceLineId": "137843",
      "sourceShabadId": "12734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਵਨ ਦੈਵ ਗਤਿ ਕਰੀ ਹਮਾਰੀ ॥",
      "transliteration": "kavan dhaiv gat karee hamaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹੇ ਦੈਵ! (ਤੂੰ) ਸਾਡੀ ਕੀ ਹਾਲਤ ਕਰ ਦਿੱਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "कवन दैव गति करी हमारी ॥",
      "sourceLineId": "137844",
      "sourceShabadId": "12734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਖੇਲਤ ਅਗਿ ਕੁਅਰਿ ਇਨ ਦਈ ॥",
      "transliteration": "khelat ag kuar in dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਖੇਡ ਖੇਡ ਵਿਚ ਹੀ ਇਸ ਨੇ (ਤੋਪ ਨੂੰ) ਅੱਗ ਲਗਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "खेलत अगि कुअरि इन दई ॥",
      "sourceLineId": "137845",
      "sourceShabadId": "12734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤੋਪ ਬਿਖੈ ਤਾ ਤੇ ਉਡਿ ਗਈ ॥੧੧॥",
      "transliteration": "top bikhai taa te udd giee ||11||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ ਤੋਪ ਵਿਚੋਂ ਰਾਜ ਕੁਮਾਰੀ ਉਡ ਗਈ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "तोप बिखै ता ते उडि गई ॥११॥",
      "sourceLineId": "137846",
      "sourceShabadId": "12734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਬਾਨਵੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੨॥੬੯੭੭॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau baanave charitr samaapatam sat subham sat ||392||6977||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੯੨ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੯੨॥੬੯੭੭॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ बानवे चरित्र समापतम सतु सुभम सतु ॥३९२॥६९७७॥अफजूँ॥",
      "sourceLineId": "137847",
      "sourceShabadId": "12734",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137848",
      "sourceShabadId": "12735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਛਲਾਪੁਰ ਇਕ ਭੂਪ ਭਨਿਜੈ ॥",
      "transliteration": "achhalaapur ik bhoop bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਅਛਲਾਪੁਰ ਦਾ ਇਕ ਰਾਜਾ ਦਸੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "अछलापुर इक भूप भनिजै ॥",
      "sourceLineId": "137849",
      "sourceShabadId": "12735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਛਲ ਸੈਨ ਤਿਹ ਨਾਮ ਕਹਿਜੈ ॥",
      "transliteration": "achhal sain teh naam kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਾ ਅਛਲ ਸੈਨ ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "अछल सैन तिह नाम कहिजै ॥",
      "sourceLineId": "137850",
      "sourceShabadId": "12735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਹਿਕ ਸੁਧਰਮੀ ਰਾਇ ਸਾਹ ਭਨਿ ॥",
      "transliteration": "tahik sudharamee rai saeh bhan ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸੁਧਰਮੀ ਰਾਇ ਨਾ ਦਾ ਸ਼ਾਹ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "तहिक सुधरमी राइ साह भनि ॥",
      "sourceLineId": "137851",
      "sourceShabadId": "12735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾਨੁਕ ਸਭ ਸਾਹਨ ਕੀ ਥੋ ਮਨਿ ॥੧॥",
      "transliteration": "jaanuk sabh saahan kee tho man ||1||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਤਨਾ ਸ੍ਰੇਸ਼ਠ ਸੀ) ਮਾਨੋ ਸਾਰਿਆਂ ਸ਼ਾਹਾ ਦੀ ਮਣੀ ਹੋਵੇ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "जानुक सभ साहन की थो मनि ॥१॥",
      "sourceLineId": "137852",
      "sourceShabadId": "12735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੰਪਾ ਦੇ ਤਿਹ ਸੁਤਾ ਭਨਿਜੈ ॥",
      "transliteration": "cha(n)paa dhe teh sutaa bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਪਾ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਉਸ ਦੀ ਪੁੱਤਰੀ ਦਸੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "चंपा दे तिह सुता भनिजै ॥",
      "sourceLineId": "137853",
      "sourceShabadId": "12735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਕਹਿਜੈ ॥",
      "transliteration": "roopavaan gunavaan kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰੂਪਵਾਨ ਅਤੇ ਗੁਣਵਾਨ ਕਹੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "रूपवान गुनवान कहिजै ॥",
      "sourceLineId": "137854",
      "sourceShabadId": "12735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਨ ਰਾਜਾ ਕੋ ਪੁਤ੍ਰ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "tin raajaa ko putr nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "तिन राजा को पुत्र निहारियो ॥",
      "sourceLineId": "137855",
      "sourceShabadId": "12735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੁਛਬਿ ਰਾਇ ਜਿਹ ਨਾਮ ਬਿਚਾਰਿਯੋ ॥੨॥",
      "transliteration": "suchhab rai jeh naam bichaariyo ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਨਾ ਸੁਛਬਿ ਰਾਇ ਦਸਿਆ ਜਾਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "सुछबि राइ जिह नाम बिचारियो ॥२॥",
      "sourceLineId": "137856",
      "sourceShabadId": "12735",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "137857",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਿਤੂ ਜਾਨਿ ਇਕ ਸਹਚਰਿ ਲਈ ਬੁਲਾਇ ਕੈ ॥",
      "transliteration": "hitoo jaan ik sahachar liee bulai kai ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੀ ਇਕ ਹਮਰਾਜ਼ ਸਖੀ ਨੂੰ (ਰਾਜ ਕੁਮਾਰੀ ਨੇ) ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "हितू जानि इक सहचरि लई बुलाइ कै ॥",
      "sourceLineId": "137858",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਛਬਿ ਰਾਇ ਕੇ ਦੀਨੋ ਤਾਹਿ ਪਠਾਇ ਕੈ ॥",
      "transliteration": "suchhab rai ke dheeno taeh paThai kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਸੁਛਬਿ ਰਾਇ ਪਾਸ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "सुछबि राइ के दीनो ताहि पठाइ कै ॥",
      "sourceLineId": "137859",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹਾ ਕ੍ਰੋਰਿ ਕਰਿ ਜਤਨ ਤਿਸੈ ਹ੍ਯਾਂ ਲ੍ਰਯਾਇਯੋ ॥",
      "transliteration": "kahaa kror kar jatan tisai hayaa(n) lrayaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਹਾ, ਬਹੁਤ ਯਤਨ ਕਰ ਕੇ ਉਸ ਨੂੰ ਇਥੇ ਲੈ ਕੇ ਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "कहा क्रोरि करि जतन तिसै ह्याँ ल्रयाइयो ॥",
      "sourceLineId": "137860",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹੋ ਜਿਤਕ ਚਹੌਗੀ ਦਰਬੁ ਤਿਤਕ ਲੈ ਜਾਇਯੋ ॥੩॥",
      "transliteration": "ho jitak chahauagee dharab titak lai jaiyo ||3||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨਾ ਧਨ ਚਾਹੇਾਂਗੀ, ਉਤਨਾ ਹੀ ਲੈ ਜਾਈਂ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "हो जितक चहौगी दरबु तितक लै जाइयो ॥३॥",
      "sourceLineId": "137861",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਨਤ ਸਹਚਰੀ ਬਚਨ ਸਜਨ ਕੇ ਗ੍ਰਿਹ ਗਈ ॥",
      "transliteration": "sunat sahacharee bachan sajan ke gireh giee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਦੇ) ਬੋਲ ਸੁਣ ਕੇ ਸਖੀ ਮਿਤਰ ਦੇ ਘਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "सुनत सहचरी बचन सजन के गृह गई ॥",
      "sourceLineId": "137862",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਮਿ ਤਿਮਿ ਤਾਹਿ ਪ੍ਰਬੋਧ ਤਹਾ ਲ੍ਯਾਵਤ ਭਈ ॥",
      "transliteration": "jim tim taeh prabodh tahaa layaavat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨੂੰ ਸਮਝਾ ਕੇ ਉਥੇ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "जिमि तिमि ताहि प्रबोध तहा ल्यावत भई ॥",
      "sourceLineId": "137863",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਿਲਤ ਛੈਲਨੀ ਛੈਲ ਅਧਿਕ ਸੁਖੁ ਪਾਇਯੋ ॥",
      "transliteration": "milat chhailanee chhail adhik sukh paiyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਮਿਲ ਕੇ ਮੁਟਿਆਰ ਨੇ ਬਹੁਤ ਸੁਖ ਪਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "मिलत छैलनी छैल अधिक सुखु पाइयो ॥",
      "sourceLineId": "137864",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹੋ ਭਾਤਿ ਭਾਤਿ ਕੀ ਕੈਫਨ ਨਿਕਟ ਮੰਗਾਇਯੋ ॥੪॥",
      "transliteration": "ho bhaat bhaat kee kaifan nikaT ma(n)gaiyo ||4||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੀ ਸ਼ਰਾਬ ਆਪਣੇ ਕੋਲ ਮੰਗਵਾ ਲਈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "हो भाति भाति की कैफन निकट मंगाइयो ॥४॥",
      "sourceLineId": "137865",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿਯਾ ਕੈਫ ਕੌ ਪਾਨ ਸੁ ਦੁਹੂੰ ਪ੍ਰਜੰਕ ਪਰ ॥",
      "transliteration": "kiyaa kaif kau paan su dhuhoo(n) praja(n)k par ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੋਹਾ ਨੇ ਪਲੰਘ ਉਤੇ (ਬੈਠ ਕੇ) ਸ਼ਰਾਬ ਪੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "किया कैफ कौ पान सु दुहूँ प्रजंक पर ॥",
      "sourceLineId": "137866",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਰਮੇ ਬਿਹਸਿ ਕਰਿ ਨਾਰਿ ਨਰ ॥",
      "transliteration": "bhaat bhaat tan rame bihas kar naar nar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ ਤੇ ਪੁਰਸ਼ ਨੇ ਖ਼ੁਸ਼ ਹੋ ਕੇ ਭਾਤ ਭਾਤ ਨਾਲ ਰਮਣ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन रमे बिहसि करि नारि नर ॥",
      "sourceLineId": "137867",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕੋਕ ਸਾਸਤ੍ਰ ਤੇ ਮਤ ਕੌ ਬਿਹਸਿ ਉਚਾਰਿ ਕੈ ॥",
      "transliteration": "kok saasatr te mat kau bihas uchaar kai ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਕ ਸ਼ਾਸਤ੍ਰ ਦੇ ਮਤ ਨੂੰ ਪ੍ਰਸੰਨਤਾ ਪੂਰਵਕ ਉਚਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "कोक सासत्र ते मत कौ बिहसि उचारि कै ॥",
      "sourceLineId": "137868",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੋ ਆਪੁ ਬੀਚ ਕੰਧਨ ਪਰ ਹਾਥਨ ਡਾਰਿ ਕੈ ॥੫॥",
      "transliteration": "ho aap beech ka(n)dhan par haathan ddaar kai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਸ ਵਿਚ ਇਕ ਦੂਜੇ ਦੇ ਮੋਢਿਆਂ ਉਤੇ ਹੱਥ ਰਖ ਕੇ (ਸੰਯੋਗ ਕੀਤਾ) ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "हो आपु बीच कंधन पर हाथन डारि कै ॥५॥",
      "sourceLineId": "137869",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਧਿਕ ਜੋਰ ਤਨ ਦੋਊ ਤਹਾ ਕ੍ਰੀੜਾ ਕਰੈਂ ॥",
      "transliteration": "adhik jor tan dhouoo tahaa kreeRaa karai(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦੋਵੇਾਂ ਪੂਰੇ ਜ਼ੋਰ ਨਾਲ ਕੇਲ-ਕ੍ਰੀੜਾ ਕਰਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "अधिक जोर तन दोऊ तहा क्रीड़ा करैं ॥",
      "sourceLineId": "137870",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਨ ਮੈ ਭਏ ਅਨੰਦ ਨ ਕਾਹੂੰ ਤੇ ਡਰੈਂ ॥",
      "transliteration": "man mai bhe ana(n)dh na kaahoo(n) te ddarai(n) ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਿਨਾ ਕਿਸੇ ਤੋਂ ਡਰੇ ਮਨ ਵਿਚ ਆਨੰਦ ਮਾਣਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "मन मै भए अनंद न काहूँ ते डरैं ॥",
      "sourceLineId": "137871",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਲਪਟਿ ਲਪਟਿ ਕਰ ਜਾਹਿ ਸੁ ਛਿਨਿਕ ਨ ਛੋਰਹੀ ॥",
      "transliteration": "lapaT lapaT kar jaeh su chhinik na chhorahee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਕ ਦੂਜੇ ਨਾਲ) ਲਿਪਟ ਰਹੇ ਸਨ ਅਤੇ ਇਕ ਛਿਣ ਲਈ ਵੀ ਛਡ ਨਹੀਂ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "लपटि लपटि कर जाहि सु छिनिक न छोरही ॥",
      "sourceLineId": "137872",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹੋ ਸਕਲ ਦ੍ਰਪ ਕੰਦ੍ਰਪ ਕੋ ਤਹਾ ਮਰੋਰਹੀ ॥੬॥",
      "transliteration": "ho sakal dhrap ka(n)dhrap ko tahaa marorahee ||6||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉਥੇ ਕਾਮ ਦੇਵ ਦਾ ਸਾਰਾ ਹੰਕਾਰ ਤੋੜ ਰਹੇ ਸਨ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "हो सकल द्रप कंद्रप को तहा मरोरही ॥६॥",
      "sourceLineId": "137873",
      "sourceShabadId": "12736",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137874",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭੋਗ ਕਰਤ ਤਰੁਨੀ ਸੁਖ ਪਾਯੋ ॥",
      "transliteration": "bhog karat tarunee sukh paayo ||",
      "translation": "",
      "punjabiViakhya": "ਸੰਯੋਗ ਕਰ ਕੇ ਇਸਤਰੀ ਨੇ ਸੁਖ ਪ੍ਰਾਪਤ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "भोग करत तरुनी सुख पायो ॥",
      "sourceLineId": "137875",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਰਤ ਕੇਲ ਰਜਨਿਯਹਿ ਬਿਤਾਯੋ ॥",
      "transliteration": "karat kel rajaniyeh bitaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਮ-ਲੀਲ੍ਰਹਾ ਕਰਦਿਆਂ (ਸਾਰੀ) ਰਾਤ ਬਿਤਾ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "करत केल रजनियहि बितायो ॥",
      "sourceLineId": "137876",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪਹਿਲੀ ਰਾਤਿ ਬੀਤ ਜਬ ਗਈ ॥",
      "transliteration": "pahilee raat beet jab giee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਪਹਿਲੀ (ਅੱਧੀ) ਰਾਤ ਬੀਤ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "पहिली राति बीत जब गई ॥",
      "sourceLineId": "137877",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪਾਛਿਲ ਰੈਨਿ ਰਹਤ ਸੁਧਿ ਲਈ ॥੭॥",
      "transliteration": "paachhil rain rahat sudh liee ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਪਿਛਲੀ ਰਾਤ ਵੇਲੇ (ਉਨ੍ਰਹਾ ਨੂੰ) ਹੋਸ਼ ਆਈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "पाछिल रैनि रहत सुधि लई ॥७॥",
      "sourceLineId": "137878",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਹਾ ਕੁਅਰਿ ਉਠਿ ਰਾਜ ਕੁਅਰ ਸੰਗ ॥",
      "transliteration": "kahaa kuar uTh raaj kuar sa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਮਾਰ ਨੇ ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "कहा कुअरि उठि राज कुअर संग ॥",
      "sourceLineId": "137879",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਬਹੂੰ ਛਾਡ ਹਮਾਰਾ ਤੈ ਅੰਗ ॥",
      "transliteration": "kabahoo(n) chhaadd hamaaraa tai a(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਤੂੰ ਮੇਰਾ ਸ਼ਰੀਰ ਛਡ ਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "कबहूँ छाड हमारा तै अंग ॥",
      "sourceLineId": "137880",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੋ ਕੋਈ ਪੁਰਖ ਹਮੈ ਲਹਿ ਜੈਹੈ ॥",
      "transliteration": "jo koiee purakh hamai leh jaihai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕੋਈ ਬੰਦਾ ਸਾਨੂੰ ਵੇਖ ਲਵੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "जो कोई पुरख हमै लहि जैहै ॥",
      "sourceLineId": "137881",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾਇ ਰਾਵ ਤਨ ਭੇਦ ਬਤੈਹੈ ॥੮॥",
      "transliteration": "jai raav tan bhedh bataihai ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਰਾਜੇ ਪਾਸ ਜਾ ਕੇ ਭੇਦ ਦਸ ਦੇਵੇਗਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "जाइ राव तन भेद बतैहै ॥८॥",
      "sourceLineId": "137882",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਾਹੁ ਸੁਤਾ ਇਹ ਭਾਤਿ ਉਚਾਰਾ ॥",
      "transliteration": "saahu sutaa ieh bhaat uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨੇ (ਅਗੋਂ) ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "साहु सुता इह भाति उचारा ॥",
      "sourceLineId": "137883",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬੈਨ ਸੁਨੋ ਮਮ ਰਾਜ ਕੁਮਾਰਾ ॥",
      "transliteration": "bain suno mam raaj kumaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜ ਕੁਮਾਰ! ਮੇਰੀ ਗੱਲ ਸੁਣੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "बैन सुनो मम राज कुमारा ॥",
      "sourceLineId": "137884",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਭਨ ਲਖਤ ਤੁਹਿ ਕੈਫ ਪਿਲਾਊਾਂ ॥",
      "transliteration": "sabhan lakhat tuh kaif pilaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਦੇ ਵੇਖਦਿਆਂ (ਮੈਂ) ਤੁਹਾਨੂੰ ਸ਼ਰਾਬ ਪਿਲਾਵਾਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "सभन लखत तुहि कैफ पिलाऊाँ ॥",
      "sourceLineId": "137885",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਬੈ ਸਾਹ ਕੀ ਸੁਤਾ ਕਹਾਊਾਂ ॥੯॥",
      "transliteration": "tabai saeh kee sutaa kahaauooaa(n) ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਅਖਵਾਵਾਗੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "तबै साह की सुता कहाऊाँ ॥९॥",
      "sourceLineId": "137886",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਹ ਹੀ ਰਮੋ ਤਿਹਾਰੇ ਸੰਗਾ ॥",
      "transliteration": "teh hee ramo tihaare sa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਆਪਣੇ ਅੰਗ ਨੂੰ (ਤੁਹਾਡੇ) ਅੰਗ ਨਾਲ ਜੋੜ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "तह ही रमो तिहारे संगा ॥",
      "sourceLineId": "137887",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਪਨੇ ਜੋਰਿ ਅੰਗ ਸੌ ਅੰਗਾ ॥",
      "transliteration": "apane jor a(n)g sau a(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਡੇ ਨਾਲ ਸੰਗ ਕਰਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "अपने जोरि अंग सौ अंगा ॥",
      "sourceLineId": "137888",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਮੈ ਤੁਮੈ ਸਭ ਲੋਗ ਨਿਹਾਰੈ ॥",
      "transliteration": "hamai tumai sabh log nihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਤੈਨੂੰ ਸਭ ਲੋਕ ਵੇਖਣਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1344,
      "hindi": "",
      "hindiTransliteration": "हमै तुमै सभ लोग निहारै ॥",
      "sourceLineId": "137889",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1344_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭਲੋ ਬੁਰੋ ਨਹਿ ਭੇਦ ਬਿਚਾਰੈ ॥੧੦॥",
