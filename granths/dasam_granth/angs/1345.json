{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1345,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1345_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਯੌ ਕਹਿ ਕੁਅਰਿ ਬਿਦਾ ਕਰਿ ਦੀਨਾ ॥",
      "transliteration": "yau keh kuar bidhaa kar dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਵਿਦਾ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "यौ कहि कुअरि बिदा करि दीना ॥",
      "sourceLineId": "137891",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪ੍ਰਾਤ ਭੇਸ ਨਰ ਕੋ ਧਰਿ ਲੀਨਾ ॥",
      "transliteration": "praat bhes nar ko dhar leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੇਰੇ ਮਰਦ ਦਾ ਭੇਸ ਧਾਰਨ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "प्रात भेस नर को धरि लीना ॥",
      "sourceLineId": "137892",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕੀਅਸ ਕੁਅਰ ਕੇ ਧਾਮ ਪਯਾਨਾ ॥",
      "transliteration": "keeas kuar ke dhaam payaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਦੇ ਘਰ ਵਲ ਪ੍ਰਸਥਾਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "कीअस कुअर के धाम पयाना ॥",
      "sourceLineId": "137893",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੀ ਪਛਾਨਾ ॥੧੧॥",
      "transliteration": "bhedh abhedh na kinee pachhaanaa ||11||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਭੇਦ ਅਭੇਦ ਨੂੰ ਨਾ ਸਮਝਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न किनी पछाना ॥११॥",
      "sourceLineId": "137894",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚਾਕਰ ਰਾਖਿ ਕੁਅਰ ਤਿਹ ਲਿਯੋ ॥",
      "transliteration": "chaakar raakh kuar teh liyo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ-ਕੁਮਾਰ ਨੇ ਉਸ ਨੂੰ ਨੌਕਰ ਰਖ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "चाकर राखि कुअर तिह लियो ॥",
      "sourceLineId": "137895",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬੀਚ ਮੁਸਾਹਿਬ ਕੋ ਤਿਹ ਕਿਯੋ ॥",
      "transliteration": "beech musaahib ko teh kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਆਪਣੇ) ਮੁਸਾਹਿਬਾ (ਸਾਥੀਆਂ) ਵਿਚ ਸਥਾਨ ਦੇ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "बीच मुसाहिब को तिह कियो ॥",
      "sourceLineId": "137896",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਖਾਨ ਪਾਨ ਸਭ ਸੋਈ ਪਿਲਾਵੈ ॥",
      "transliteration": "khaan paan sabh soiee pilaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ (ਰਾਜ ਕੁਮਾਰ) ਦੇ ਖਾਣ ਪੀਣ ਦੀ ਵਿਵਸਥਾ ਕਰਨ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "खान पान सभ सोई पिलावै ॥",
      "sourceLineId": "137897",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਰ ਨਾਰੀ ਕੋਈ ਜਾਨਿ ਨ ਜਾਵੈ ॥੧੨॥",
      "transliteration": "nar naaree koiee jaan na jaavai ||12||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਕੋਈ ਨਰ ਨਾਰੀ ਜਾ ਨਹੀਂ ਸਕਦਾ ਸੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "नर नारी कोई जानि न जावै ॥१२॥",
      "sourceLineId": "137898",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਕ ਦਿਨ ਪਿਯ ਲੈ ਗਈ ਸਿਕਾਰਾ ॥",
      "transliteration": "eik dhin piy lai giee sikaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਕ ਦਿਨ ਪ੍ਰੀਤਮ ਨੂੰ ਸ਼ਿਕਾਰ ਖੇਡਣ ਲਈ ਲੈ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "इक दिन पिय लै गई सिकारा ॥",
      "sourceLineId": "137899",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬੀਚ ਸਰਾਹੀ ਕੇ ਮਦ ਡਾਰਾ ॥",
      "transliteration": "beech saraahee ke madh ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੁਰਾਹੀ ਵਿਚ ਸ਼ਰਾਬ ਭਰ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "बीच सराही के मद डारा ॥",
      "sourceLineId": "137900",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਲ ਕੈ ਸਾਥ ਭਿਗਾਇ ਉਛਾਰਾ ॥",
      "transliteration": "jal kai saath bhigai uchhaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸੁਰਾਹੀ ਨੂੰ ਜਲ ਨਾਲ ਭਿਗੋ ਕੇ ਉਛਾਲਿਆ (ਜਾ ਉੱਚਾ ਟੰਗਿਆ)।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "जल कै साथ भिगाइ उछारा ॥",
      "sourceLineId": "137901",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚੋਵਤ ਜਾਤ ਜਵਨ ਤੇ ਬਾਰਾ ॥੧੩॥",
      "transliteration": "chovat jaat javan te baaraa ||13||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਿਚੋਂ ਪਾਣੀ ਚੋਂਦਾ ਰਿਹਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "चोवत जात जवन ते बारा ॥१३॥",
      "sourceLineId": "137902",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਭ ਕੋਈ ਲਖੈ ਤਵਨ ਕਹ ਪਾਨੀ ॥",
      "transliteration": "sabh koiee lakhai tavan keh paanee ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਉਸ ਨੂੰ ਪਾਣੀ ਸਮਝ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "सभ कोई लखै तवन कह पानी ॥",
      "sourceLineId": "137903",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੋਈ ਨ ਸਮੁਝਿ ਸਕੈ ਮਦ ਗ੍ਯਾਨੀ ॥",
      "transliteration": "koiee na samujh sakai madh gayaanee ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਵੀ ਬੁੱਧੀਮਾਨ ਉਸ ਨੂੰ ਸ਼ਰਾਬ ਨਹੀਂ ਸਮਝ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "कोई न समुझि सकै मद ग्यानी ॥",
      "sourceLineId": "137904",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਬ ਕਾਨਨ ਕੇ ਗਏ ਮੰਝਾਰਾ ॥",
      "transliteration": "jab kaanan ke ge ma(n)jhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਉਹ) ਬਨ ਦੇ ਵਿਚਕਾਰ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "जब कानन के गए मंझारा ॥",
      "sourceLineId": "137905",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਸੌ ਬਾਲ ਉਚਾਰਾ ॥੧੪॥",
      "transliteration": "raaj kuar sau baal uchaaraa ||14||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਾਲਿਕਾ ਨੇ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਕਿਹਾ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "राज कुअर सौ बाल उचारा ॥१४॥",
      "sourceLineId": "137906",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤੁਮ ਕੋ ਲਗੀ ਤ੍ਰਿਖਾ ਅਭਿਮਾਨੀ ॥",
      "transliteration": "tum ko lagee tirakhaa abhimaanee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਗੌਰਵਸ਼ਾਲੀ (ਰਾਜ ਕੁਮਾਰ)! ਤੁਹਾਨੂੰ ਪਿਆਸ ਲਗੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "तुम को लगी तृखा अभिमानी ॥",
      "sourceLineId": "137907",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੀਤਲ ਲੇਹੁ ਪਿਯਹੁ ਇਹ ਪਾਨੀ ॥",
      "transliteration": "seetal leh piyahu ieh paanee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਲਈ) ਇਹ ਠੰਡਾ ਪਾਣੀ ਪੀ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "सीतल लेहु पियहु इह पानी ॥",
      "sourceLineId": "137908",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਰਿ ਪ੍ਯਾਲਾ ਲੈ ਤਾਹਿ ਪਿਯਾਰਾ ॥",
      "transliteration": "bhar payaalaa lai taeh piyaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸਤਰੀ ਨੇ) ਪਿਆਲਾ ਭਰ ਕੇ ਉਸ ਨੂੰ ਪਿਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "भरि प्याला लै ताहि पियारा ॥",
      "sourceLineId": "137909",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਭਹਿਨ ਕਰਿ ਜਲ ਤਾਹਿ ਬਿਚਾਰਾ ॥੧੫॥",
      "transliteration": "sabhahin kar jal taeh bichaaraa ||15||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੇ ਉਸ ਨੂੰ ਜਲ ਕਰ ਕੇ ਹੀ ਸਮਝਿਆ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "सभहिन करि जल ताहि बिचारा ॥१५॥",
      "sourceLineId": "137910",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪੁਨਿ ਤ੍ਰਿਯ ਲਿਯਾ ਕਬਾਬ ਹਾਥਿ ਕਰਿ ॥",
      "transliteration": "pun tiray liyaa kabaab haath kar ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਇਸਤਰੀ ਨੇ ਹੱਥ ਵਿਚ ਕਬਾਬ ਲੈ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "पुनि तृय लिया कबाब हाथि करि ॥",
      "sourceLineId": "137911",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹਿਯੋ ਕਿ ਖਾਹੁ ਰਾਜ ਸੁਤ ਬਨ ਫਰ ॥",
      "transliteration": "kahiyo k khaahu raaj sut ban far ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਹਿਣ ਲਗੀ, ਹੇ ਰਾਜ ਕੁਮਾਰ! ਬਨ ਦੇ ਫਲ ਖਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "कहियो कि खाहु राज सुत बन फर ॥",
      "sourceLineId": "137912",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤੁਮਰੇ ਨਿਮਿਤਿ ਤੋਰਿ ਇਨ ਆਨਾ ॥",
      "transliteration": "tumare nimit tor in aanaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਨੂੰ ਤੁਹਾਡੇ ਲਈ ਹੀ ਤੋੜ ਕੇ ਲਿਆਂਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "तुमरे निमिति तोरि इन आना ॥",
      "sourceLineId": "137913",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਛਨ ਕਰਹੁ ਸ੍ਵਾਦ ਅਬ ਨਾਨਾ ॥੧੬॥",
      "transliteration": "bhachhan karahu savaiaadh ab naanaa ||16||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ (ਤੁਸੀਂ) ਕਈ ਪ੍ਰਕਾਰ ਦੇ ਸੁਆਦ (ਵਾਲੇ ਫਲਾ ਨੂੰ) ਖਾਓ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "भछन करहु स्वाद अब नाना ॥१६॥",
      "sourceLineId": "137914",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਬ ਮਧ੍ਰਯਾਨ ਸਮੋ ਭਯੋ ਜਾਨ੍ਯੋ ॥",
      "transliteration": "jab madhrayaan samo bhayo jaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੁਪਹਿਰ ('ਮਧ੍ਰਯਾਨ') ਦਾ ਸਮਾ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "जब मध्रयान समो भयो जान्यो ॥",
      "sourceLineId": "137915",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਭ ਲੋਗਨ ਇਹ ਭਾਤਿ ਬਖਾਨ੍ਯੋ ॥",
      "transliteration": "sabh logan ieh bhaat bakhaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਭ ਲੋਕਾ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "सभ लोगन इह भाति बखान्यो ॥",
      "sourceLineId": "137916",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੁਮ ਸਭ ਚਲੋ ਭੂਪ ਕੇ ਸਾਥਾ ॥",
      "transliteration": "tum sabh chalo bhoop ke saathaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਸਾਰੇ ਰਾਜੇ ਨਾਲ ਚਲੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "तुम सभ चलो भूप के साथा ॥",
      "sourceLineId": "137917",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹਮ ਸੇਵਾ ਕਰਿ ਹੈ ਜਗਨਾਥਾ ॥੧੭॥",
      "transliteration": "ham sevaa kar hai jaganaathaa ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਸੀਂ ਜਗਨ ਨਾਥ ਦੀ ਪੂਜਾ ਕਰਾਗੇ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "हम सेवा करि है जगनाथा ॥१७॥",
      "sourceLineId": "137918",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਭ ਜਨ ਪਠੈ ਭੂਪ ਕੇ ਸਾਥਾ ॥",
      "transliteration": "sabh jan paThai bhoop ke saathaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਲੋਕਾ ਨੂੰ ਰਾਜੇ ਨਾਲ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "सभ जन पठै भूप के साथा ॥",
      "sourceLineId": "137919",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੋਈ ਰਹੇ ਨਾਰਿ ਅਰ ਨਾਥਾ ॥",
      "transliteration": "dhoiee rahe naar ar naathaa ||",
      "translation": "",
      "punjabiViakhya": "(ਪਿਛੇ) ਦੋਵੇਾਂ ਇਸਤਰੀ ਅਤੇ ਪੁਰਸ਼ ਰਹਿ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "दोई रहे नारि अर नाथा ॥",
      "sourceLineId": "137920",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪਰਦਾ ਐਚਿ ਦਸੌ ਦਿਸਿ ਲਿਯਾ ॥",
      "transliteration": "paradhaa aaich dhasau dhis liyaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਦਸਾ ਦਿਸ਼ਾਵਾ ਵਿਚ (ਭਾਵ-ਸਭ ਪਾਸੇ) ਪਰਦਾ ਤਾਣ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "परदा ऐचि दसौ दिसि लिया ॥",
      "sourceLineId": "137921",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਹਸਿ ਹਸਿ ਰਸਿ ਕਿਯਾ ॥੧੮॥",
      "transliteration": "kaam bhog has has ras kiyaa ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਸ ਹਸ ਕੇ ਮੌਜ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "काम भोग हसि हसि रसि किया ॥१८॥",
      "sourceLineId": "137922",
      "sourceShabadId": "12737",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "137923",
      "sourceShabadId": "12738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਹ ਚਰਿਤ੍ਰ ਦੋਈ ਬਿਹਸਿ ਰਮਤ ਭਏ ਨਰ ਨਾਰਿ ॥",
      "transliteration": "eeh charitr dhoiee bihas ramat bhe nar naar ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਚਰਿਤ੍ਰ ਦੁਆਰਾ ਦੋਵੇਾਂ ਇਸਤਰੀ ਪੁਰਸ਼ ਹਸ ਹਸ ਕੇ ਰਮਣ ਕਰਦੇ ਰਹੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "इह चरित्र दोई बिहसि रमत भए नर नारि ॥",
      "sourceLineId": "137924",
      "sourceShabadId": "12738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪ੍ਰਜਾ ਸਹਿਤ ਰਾਜਾ ਛਲਾ ਸਕਾ ਨ ਭੂਪ ਬਿਚਾਰਿ ॥੧੯॥",
      "transliteration": "prajaa sahit raajaa chhalaa sakaa na bhoop bichaar ||19||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਪ੍ਰਜਾ ਸਮੇਤ ਰਾਜੇ ਨੂੰ ਛਲ ਲਿਆ, ਪਰ ਰਾਜਾ (ਕੁਝ ਵੀ) ਵਿਚਾਰ ਨਾ ਸਕਿਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "प्रजा सहित राजा छला सका न भूप बिचारि ॥१९॥",
      "sourceLineId": "137925",
      "sourceShabadId": "12738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਤਿਰਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੩॥੬੯੯੬॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau tiraanavo charitr samaapatam sat subham sat ||393||6996||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੯੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੯੩॥੬੯੯੬॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ तिरानवो चरित्र समापतम सतु सुभम सतु ॥३९३॥६९९६॥अफजूँ॥",
      "sourceLineId": "137926",
      "sourceShabadId": "12738",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "137927",
      "sourceShabadId": "12739",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੇਵ ਛਤ੍ਰ ਇਕ ਭੂਪ ਬਖਨਿਯਤਿ ॥",
      "transliteration": "dhev chhatr ik bhoop bakhaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰ ਦੇਵ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "देव छत्र इक भूप बखनियति ॥",
      "sourceLineId": "137928",
      "sourceShabadId": "12739",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸ੍ਰੀ ਸੁਰਰਾਜਵਤੀ ਪੁਰ ਜਨਿਯਤ ॥",
      "transliteration": "sree suraraajavatee pur janiyat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਨਗਰ ਸੁਰਰਾਜਵਤੀ ਕਰ ਕੇ ਜਾਣਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "स्री सुरराजवती पुर जनियत ॥",
      "sourceLineId": "137929",
      "sourceShabadId": "12739",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਿਹੁ ਸੰਗ ਚੜਤ ਅਮਿਤਿ ਚਤੁਰੰਗਾ ॥",
      "transliteration": "tih sa(n)g chaRat amit chatura(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਅਮਿਤ ਚਤੁਰੰਗਣੀ ਸੈਨਾ",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "तिहु संग चड़त अमिति चतुरंगा ॥",
      "sourceLineId": "137930",
      "sourceShabadId": "12739",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਉਮਡਿ ਚਲਤ ਜਿਹ ਬਿਧਿ ਕਰਿ ਗੰਗਾ ॥੧॥",
      "transliteration": "aumadd chalat jeh bidh kar ga(n)gaa ||1||",
      "translation": "",
      "punjabiViakhya": "ਗੰਗਾ ਦੀਆਂ ਲਹਿਰਾ ਵਾਗ ਉਮਡ ਕੇ ਚਲਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "उमडि चलत जिह बिधि करि गंगा ॥१॥",
      "sourceLineId": "137931",
      "sourceShabadId": "12739",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "137932",
      "sourceShabadId": "12740",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸ੍ਰੀ ਅਲਕੇਸ ਮਤੀ ਤਿਹ ਸੁਤਾ ਬਖਾਨਿਯੈ ॥",
      "transliteration": "sree alakes matee teh sutaa bakhaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਅਲਕੇਸ ਮਤੀ ਉਸ ਦੀ ਪੁੱਤਰੀ ਦਸੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "स्री अलकेस मती तिह सुता बखानियै ॥",
      "sourceLineId": "137933",
      "sourceShabadId": "12740",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਰੀ ਪਦੁਮਨੀ ਪ੍ਰਾਤ ਕਿ ਪ੍ਰਕ੍ਰਿਤਿ ਪ੍ਰਮਾਨਿਯੈ ॥",
      "transliteration": "paree padhumanee praat k prakirat pramaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਾ ਤਾ ਪਰੀ, ਪਦਮਨੀ, ਉਸ਼ਾ ('ਪ੍ਰਾਤ') ਜਾ ਪ੍ਰਕ੍ਰਿਤੀ ਵਰਗੀ ਸਮਝੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "परी पदुमनी प्रात कि प्रकृति प्रमानियै ॥",
      "sourceLineId": "137934",
      "sourceShabadId": "12740",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕੈ ਨਿਸੁਪਤਿ ਸੁਰ ਜਾਇ ਕਿ ਦਿਨਕਰ ਜੂਝਈ ॥",
      "transliteration": "kai nisupat sur jai k dhinakar joojhiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਉਹ ਚੰਦ੍ਰਮਾ, ਦੇਵਤਿਆਂ ਜਾ ਸੂਰਜ ਦੀ ਧੀ ਮੰਨ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "कै निसुपति सुर जाइ कि दिनकर जूझई ॥",
      "sourceLineId": "137935",
      "sourceShabadId": "12740",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹੋ ਜਿਹ ਸਮ ਹ੍ਵੈ ਹੈ ਨਾਰਿ ਨ ਪਾਛੈ ਹੈ ਭਈ ॥੨॥",
      "transliteration": "ho jeh sam havai hai naar na paachhai hai bhiee ||2||",
      "translation": "",
      "punjabiViakhya": "(ਅਸਲ ਵਿਚ) ਉਸ ਵਰਗੀ ਇਸਤਰੀ ਨਾ ਪਹਿਲਾ ਹੋਈ ਹੈ ਅਤੇ ਨਾ ਪਿਛੋਂ ਹੋਏਗੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "हो जिह सम ह्वै है नारि न पाछै है भई ॥२॥",
      "sourceLineId": "137936",
      "sourceShabadId": "12740",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਹ ਇਕ ਰਾਇ ਜੁਲਫ ਸੁ ਛਤ੍ਰੀ ਜਾਨਿਯੈ ॥",
      "transliteration": "teh ik rai julaf su chhatree jaaniyai ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਜ਼ੁਲਫ਼ ਰਾਇ ਨਾ ਦਾ ਛਤ੍ਰੀ ਹੁੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1345,
      "hindi": "",
      "hindiTransliteration": "तह इक राइ जुलफ सु छत्री जानियै ॥",
      "sourceLineId": "137937",
      "sourceShabadId": "12740",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1345_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਸੁਘਰ ਪਹਿਚਾਨਿਯੈ ॥",
      "transliteration": "roopavaan gunavaan sughar pahichaaniyai ||",
      "translation": "",
