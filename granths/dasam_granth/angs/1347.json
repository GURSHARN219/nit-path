{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1347,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1347_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਥਹੁ ਜਾਨਵੀ ਹੋਤ ਸਵਾਰੇ ॥",
      "transliteration": "mathahu jaanavee hot savaare ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਚਲੋ ਅਤੇ ਸਵੇਰ ('ਸਵਾਰੇ') ਹੋਣ ਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "मथहु जानवी होत सवारे ॥",
      "sourceLineId": "137987",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਹ ਤੇ ਜੁ ਨਰ ਨਿਕਸਿ ਹੈ ਕੋਈ ॥",
      "transliteration": "teh te ju nar nikas hai koiee ||",
      "translation": "",
      "punjabiViakhya": "ਗੰਗਾ ('ਜਾਨ੍ਰਹਵੀ') ਦਾ ਮੰਥਨ ਕਰੋ। ਉਸ ਵਿਚੋਂ ਜੋ ਕੋਈ ਵੀ ਪੁਰਸ਼ ਨਿਕਲੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "तह ते जु नर निकसि है कोई ॥",
      "sourceLineId": "137988",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭਰਤਾ ਹੋਇ ਹਮਾਰੋ ਸੋਈ ॥੧੫॥",
      "transliteration": "bharataa hoi hamaaro soiee ||15||",
      "translation": "",
      "punjabiViakhya": "ਉਹੀ ਮੇਰਾ ਪਤੀ ਹੋਵੇਗਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "भरता होइ हमारो सोई ॥१५॥",
      "sourceLineId": "137989",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਚਨ ਸੁਨਤ ਰਾਜਾ ਹਰਖਾਨੋ ॥",
      "transliteration": "bachan sunat raajaa harakhaano ||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ) ਗੱਲ ਸੁਣ ਕੇ ਰਾਜਾ ਪ੍ਰਸੰਨ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "बचन सुनत राजा हरखानो ॥",
      "sourceLineId": "137990",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਚੁ ਝੂਠੁ ਜੜ ਕਛੁ ਨ ਪਛਾਨੋ ॥",
      "transliteration": "saach jhooTh jaR kachh na pachhaano ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਮੂਰਖ ਨੇ ਸੱਚ ਝੂਠ ਕੁਝ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "साचु झूठु जड़ कछु न पछानो ॥",
      "sourceLineId": "137991",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੋਰਿ ਪ੍ਰਜਾ ਦੈ ਢੋਲ ਨਗਾਰੇ ॥",
      "transliteration": "jor prajaa dhai ddol nagaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਪ੍ਰਜਾ ਨੂੰ ਇਕੱਠਾ ਕਰ ਕੇ ਢੋਲ ਨਗਾਰੇ ਵਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "जोरि प्रजा दै ढोल नगारे ॥",
      "sourceLineId": "137992",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚਲੇ ਸੁਰਸੁਰੀ ਮਥਨ ਸਕਾਰੇ ॥੧੬॥",
      "transliteration": "chale surasuree mathan sakaare ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੜਕਸਾਰ ਗੰਗਾ ਦਾ ਮੰਥਣ ਕਰਨ ਲਈ ਚਲ ਪਿਆ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "चले सुरसुरी मथन सकारे ॥१६॥",
      "sourceLineId": "137993",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਡੇ ਦ੍ਰੁਮਨ ਕੀ ਮਥਨਿ ਸੁਧਾਰਿ ॥",
      "transliteration": "badde dhruman kee mathan sudhaar ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਬ੍ਰਿਛਾ ਦੀਆਂ ਮਧਾਣੀਆਂ ਧਾਰਨ ਕੀਤੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "बडे द्रुमन की मथनि सुधारि ॥",
      "sourceLineId": "137994",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਥਤ ਭਏ ਸੁਰਸਰਿ ਮੋ ਡਾਰਿ ॥",
      "transliteration": "mathat bhe surasar mo ddaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗੰਗਾ ਵਿਚ ਪਾ ਕੇ ਰਿੜਕਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "मथत भए सुरसरि मो डारि ॥",
      "sourceLineId": "137995",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਨਿਕ ਬਾਰਿ ਕਹ ਜਬੈ ਡੁਲਾਯੋ ॥",
      "transliteration": "tanik baar keh jabai ddulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਜਲ ਨੂੰ ਥੋੜਾ ਜਿੰਨਾ ਹਿਲਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "तनिक बारि कह जबै डुलायो ॥",
      "sourceLineId": "137996",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਿਕਸਿ ਪੁਰਖ ਤਹ ਤੇ ਇਕ ਆਯੋ ॥੧੭॥",
      "transliteration": "nikas purakh teh te ik aayo ||17||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਵਿਚੋਂ ਇਕ ਪੁਰਸ਼ ਨਿਕਲ ਆਇਆ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "निकसि पुरख तह ते इक आयो ॥१७॥",
      "sourceLineId": "137997",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਿਰਖਿ ਸਜਨ ਕੋ ਰੂਪ ਅਪਾਰਾ ॥",
      "transliteration": "nirakh sajan ko roop apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਸੱਜਨ ਦਾ ਅਪਾਰ ਰੂਪ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "निरखि सजन को रूप अपारा ॥",
      "sourceLineId": "137998",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਰਤ ਭਈ ਤਿਹ ਰਾਜ ਕੁਮਾਰਾ ॥",
      "transliteration": "barat bhiee teh raaj kumaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਨੇ) ਉਸ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਵਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "बरत भई तिह राज कुमारा ॥",
      "sourceLineId": "137999",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਪਸੁ ਕਛੁ ਨ ਬਿਚਰਿਯੋ ॥",
      "transliteration": "bhedh abhedh pas kachh na bichariyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਮੂਰਖ ਨੇ ਭੇਦ ਅਭੇਦ ਕੁਝ ਵੀ ਨਾ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद पसु कछु न बिचरियो ॥",
      "sourceLineId": "138000",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਹ ਛਲ ਨਾਰਿ ਜਾਰ ਕਹ ਬਰਿਯੋ ॥੧੮॥",
      "transliteration": "eeh chhal naar jaar keh bariyo ||18||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਇਸਤਰੀ ਨੇ ਯਾਰ ਨੂੰ ਵਰ ਲਿਆ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "इह छल नारि जार कह बरियो ॥१८॥",
      "sourceLineId": "138001",
      "sourceShabadId": "12741",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "138002",
      "sourceShabadId": "12742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਤੇ ਮਥਿ ਨੀਰਧਹਿ ਲਛਮੀ ਬਰੀ ਮੁਰਾਰਿ ॥",
      "transliteration": "jeh bidh te math neeradheh lachhamee baree muraar ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਵਿਸ਼ਣੂ ਨੇ ਸਮੁੰਦਰ ਨੂੰ ਮੱਥ ਕੇ ਲੱਛਮੀ ਨਾਲ ਵਿਆਹ ਕੀਤਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि ते मथि नीरधहि लछमी बरी मुरारि ॥",
      "sourceLineId": "138003",
      "sourceShabadId": "12742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਸਹਿ ਮਥਿ ਗੰਗਾ ਬਰਾ ਯਾ ਕਹ ਰਾਜ ਕੁਮਾਰਿ ॥੧੯॥",
      "transliteration": "taseh math ga(n)gaa baraa yaa keh raaj kumaar ||19||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਤਰ੍ਰਹਾ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਗੰਗਾ ਨੂੰ ਮੱਥ ਕੇ ਆਪਣੇ ਯਾਰ ਨਾਲ ਵਿਆਹ ਕਰ ਲਿਆ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "तसहि मथि गंगा बरा या कह राज कुमारि ॥१९॥",
      "sourceLineId": "138004",
      "sourceShabadId": "12742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਚੌਰਾਨਵੇ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੪॥੭੦੧੫॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chauaraanave charitr samaapatam sat subham sat ||394||7015||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੯੪ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੯੪॥੭੦੧੫॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ चौरानवे चरित्र समापतम सतु सुभम सतु ॥३९४॥७०१५॥अफजूँ॥",
      "sourceLineId": "138005",
      "sourceShabadId": "12742",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "138006",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਰਬ ਸਿੰਘ ਰਾਜਾ ਇਕ ਸੋਹੈ ॥",
      "transliteration": "sarab si(n)gh raajaa ik sohai ||",
      "translation": "",
      "punjabiViakhya": "ਸਰਬ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਸ਼ੋਭਿਤ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "सरब सिंघ राजा इक सोहै ॥",
      "sourceLineId": "138007",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਰਬ ਸਿੰਧੁ ਪੁਰ ਗੜ ਜਿਹ ਕੋ ਹੈ ॥",
      "transliteration": "sarab si(n)dh pur gaR jeh ko hai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿੱਥੇ ਸਰਬ ਸਿੰਧ ਪੁਰ ਨਾ ਦਾ ਜੋ ਗੜ੍ਰਹ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "सरब सिंधु पुर गड़ जिह को है ॥",
      "sourceLineId": "138008",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸ੍ਰੀ ਦਲ ਥੰਭੁ ਸੁਜਾਨ ਪੁਤ੍ਰ ਤਿਹ ॥",
      "transliteration": "sree dhal tha(n)bh sujaan putr teh ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਦਲ ਥੰਭੁ ਨਾ ਦਾ ਇਕ ਸੂਝਵਾਨ ਪੁੱਤਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "स्री दल थंभु सुजान पुत्र तिह ॥",
      "sourceLineId": "138009",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁੰਦਰ ਅਵਰ ਨ ਭਯੋ ਤੁਲਿ ਜਿਹ ॥੧॥",
      "transliteration": "su(n)dhar avar na bhayo tul jeh ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਕੋਈ ਹੋਰ ਸੁੰਦਰ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "सुँदर अवर न भयो तुलि जिह ॥१॥",
      "sourceLineId": "138010",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੁਸਟ ਸਿੰਘ ਤਾ ਕੌ ਭ੍ਰਾਤਾ ਭਨਿ ॥",
      "transliteration": "dhusaT si(n)gh taa kau bhraataa bhan ||",
      "translation": "",
      "punjabiViakhya": "ਦੁਸਟ ਸਿੰਘ ਉਸ ਦਾ ਭਰਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "दुसट सिंघ ता कौ भ्राता भनि ॥",
      "sourceLineId": "138011",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੁਤਿਯ ਚੰਦ੍ਰ ਜਾਨਾ ਸਭ ਲੋਗਨ ॥",
      "transliteration": "dhutiy cha(n)dhr jaanaa sabh logan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਸਾਰੇ ਲੋਕ ਦੂਜਾ ਚੰਦ੍ਰਮਾ ਸਮਝਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "दुतिय चंद्र जाना सभ लोगन ॥",
      "sourceLineId": "138012",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਭਨਿਜੈ ॥",
      "transliteration": "roopavaan gunavaan bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰੂਪਵਾਨ ਅਤੇ ਗੁਣਵਾਨ ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "रूपवान गुनवान भनिजै ॥",
      "sourceLineId": "138013",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਵਨ ਸੁਘਰ ਸਮ ਤਾਹਿ ਕਹਿਜੈ ॥੨॥",
      "transliteration": "kavan sughar sam taeh kahijai ||2||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵਰਗਾ ਸੁਘੜ ਹੋਰ ਕਿਸ ਨੂੰ ਕਿਹਾ ਜਾ ਸਕਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "कवन सुघर सम ताहि कहिजै ॥२॥",
      "sourceLineId": "138014",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸ੍ਰੀ ਸੁਜੁਲਫ ਦੇ ਸਾਹ ਦੁਲਾਰੀ ॥",
      "transliteration": "sree sujulaf dhe saeh dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਸੁਜ਼ੁਲਫ਼ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ (ਰਹਿੰਦੀ ਸੀ)",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "स्री सुजुलफ दे साह दुलारी ॥",
      "sourceLineId": "138015",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਹ ਸਮਾਨ ਨਹਿ ਦੇਵ ਕੁਮਾਰੀ ॥",
      "transliteration": "jeh samaan neh dhev kumaaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਕੋਈ ਦੇਵ ਇਸਤਰੀ ਵੀ ਨਹੀਂ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "जिह समान नहि देव कुमारी ॥",
      "sourceLineId": "138016",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਜ ਕੁਅਰਿ ਨਿਰਖਾ ਤਿਹ ਜਬ ਹੀ ॥",
      "transliteration": "raaj kuar nirakhaa teh jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਸ ਨੇ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "राज कुअरि निरखा तिह जब ही ॥",
      "sourceLineId": "138017",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਲਗਗੀ ਲਗਨ ਨਿਗੌਡੀ ਤਬ ਹੀ ॥੩॥",
      "transliteration": "lagagee lagan nigauaddee tab hee ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਹੀ (ਉਸ ਨੂੰ) ਭੈੜੀ ਲਗਨ ਲਗ ਗਈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "लगगी लगन निगौडी तब ही ॥३॥",
      "sourceLineId": "138018",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਿਤੂ ਜਾਨਿ ਸਹਚਰੀ ਬੁਲਾਈ ॥",
      "transliteration": "hitoo jaan sahacharee bulaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ ਇਕ) ਹਿਤੈਸ਼ਣ ਸਖੀ ਨੂੰ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "हितू जानि सहचरी बुलाई ॥",
      "sourceLineId": "138019",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭੇਦ ਭਾਖਿ ਤਿਹ ਠੌਰ ਪਠਾਈ ॥",
      "transliteration": "bhedh bhaakh teh Thauar paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਾ ਭੇਦ ਦਸ ਕੇ ਉਸ ਦੀ ਥਾ ਵਲ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "भेद भाखि तिह ठौर पठाई ॥",
      "sourceLineId": "138020",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਤਿਹ ਹਾਥ ਨ ਆਯੋ ॥",
      "transliteration": "raaj kuar teh haath na aayo ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਰਾਜ ਕੁਮਾਰ ਉਸ ਦੇ ਕਾਬੂ ਨਾ ਆਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "राज कुअर तिह हाथ न आयो ॥",
      "sourceLineId": "138021",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਉਹਿ ਇਹ ਆਨਿ ਸੁਨਾਯੋ ॥੪॥",
      "transliteration": "eeh bidh uh ieh aan sunaayo ||4||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਨੇ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨੂੰ ਆ ਕੇ ਦਸ ਦਿੱਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "इह बिधि उहि इह आनि सुनायो ॥४॥",
      "sourceLineId": "138022",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਾਹੁ ਸੁਤਾ ਬਹੁ ਜਤਨ ਥਕੀ ਕਰਿ ॥",
      "transliteration": "saahu sutaa bahu jatan thakee kar ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਬਹੁਤ ਯਤਨ ਕਰ ਕੇ ਥਕ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "साहु सुता बहु जतन थकी करि ॥",
      "sourceLineId": "138023",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗਯੋ ਨ ਮੀਤ ਕੈਸੇਹੂੰ ਤਿਹ ਘਰ ॥",
      "transliteration": "gayo na meet kaisehoo(n) teh ghar ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਰਾਜ ਕੁਮਾਰ ਕਿਸੇ ਤਰ੍ਰਹਾ ਵੀ ਉਸ ਦੇ ਘਰ ਨਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "गयो न मीत कैसेहूँ तिह घर ॥",
      "sourceLineId": "138024",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬੀਰ ਹਾਕਿ ਇਕ ਤਹਾ ਪਠਾਯੋ ॥",
      "transliteration": "beer haak ik tahaa paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ (ਬਵੰਜਾ ਬੀਰਾ ਵਿਚੋਂ) ਇਕ ਬੀਰ ਨੂੰ ਬੁਲਾ ਕੇ ਉਥੇ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "बीर हाकि इक तहा पठायो ॥",
      "sourceLineId": "138025",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੋਤ ਸੇਜ ਤੇ ਗਹਿ ਪਟਕਾਯੋ ॥੫॥",
      "transliteration": "sot sej te geh paTakaayo ||5||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸੇਜ ਉਤੇ ਸੁਤੇ ਹੋਏ (ਰਾਜ ਕੁਮਾਰ) ਨੂੰ ਪਕੜ ਕੇ ਪਟਕਾ ਮਾਰਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "सोत सेज ते गहि पटकायो ॥५॥",
      "sourceLineId": "138026",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਟੰਗਰੀ ਭੂਤ ਕਬੈ ਗਹਿ ਲੇਈ ॥",
      "transliteration": "Ta(n)garee bhoot kabai geh leiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਦੇ ਭੂਤ (ਬੀਰ) ਉਸ ਦੀ ਟੰਗ ਫੜ ਲੈਂਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "टंगरी भूत कबै गहि लेई ॥",
      "sourceLineId": "138027",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਬਹੂੰ ਡਾਰਿ ਸੇਜ ਪਰ ਦੇਈ ॥",
      "transliteration": "kabahoo(n) ddaar sej par dheiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਦੇ ਸੇਜ ਉਤੇ ਸੁਟ ਦਿੰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "कबहूँ डारि सेज पर देई ॥",
      "sourceLineId": "138028",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਧਿਕ ਤ੍ਰਾਸ ਦੇ ਤਾਹਿ ਪਛਾਰਾ ॥",
      "transliteration": "adhik traas dhe taeh pachhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਬਹੁਤ ਭੈ ਭੀਤ ਕਰ ਕੇ ਪਛਾੜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "अधिक त्रास दे ताहि पछारा ॥",
      "sourceLineId": "138029",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਉਹਿ ਡਰਿ ਜਿਯ ਤੇ ਮਾਰਿ ਨ ਡਾਰਾ ॥੬॥",
      "transliteration": "auh ddar jiy te maar na ddaaraa ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ (ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ) ਦੇ ਡਰ ਕਰ ਕੇ ਜਾਨੋ ਨਾ ਮਾਰਿਆ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "उहि डरि जिय ते मारि न डारा ॥६॥",
      "sourceLineId": "138030",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰੈਨਿ ਸਿਗਰ ਤਿਹ ਸੋਨ ਨ ਦਿਯੋ ॥",
      "transliteration": "rain sigar teh son na dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੀ ਰਾਤ ਉਸ ਨੂੰ ਸੌਣ ਨਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "रैनि सिगर तिह सोन न दियो ॥",
      "sourceLineId": "138031",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨ੍ਰਿਪ ਸੁਤ ਕਹ ਤ੍ਰਾਸਿਤ ਬਹੁ ਕਿਯੋ ॥",
      "transliteration": "nirap sut keh traasit bahu kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਬਹੁਤ ਡਰਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "नृप सुत कह त्रासित बहु कियो ॥",
      "sourceLineId": "138032",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚਲੀ ਖਬਰਿ ਰਾਜਾ ਪ੍ਰਤਿ ਆਈ ॥",
      "transliteration": "chalee khabar raajaa prat aaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਸਭ ਦੀ) ਖ਼ਬਰ ਰਾਜੇ ਪਾਸ ਵੀ ਪਹੁੰਚ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": "चली खबरि राजा प्रति आई ॥",
      "sourceLineId": "138033",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1347_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭੂਤ ਨਾਸ ਕਰ ਲਏ ਬੁਲਾਈ ॥੭॥",
      "transliteration": "bhoot naas kar le bulaiee ||7||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਭੂਤ (ਦੇ ਪ੍ਰਭਾਵ ਨੂੰ) ਨਸ਼ਟ ਕਰਨ ਵਾਲੇ ਨੂੰ ਬੁਲਾ ਲਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
