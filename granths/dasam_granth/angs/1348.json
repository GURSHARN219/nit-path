{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1348,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1348_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭੂਤ ਹਤਾ ਇਕ ਮੰਤ੍ਰ ਉਚਾਰੈ ॥",
      "transliteration": "bhoot hataa ik ma(n)tr uchaarai ||",
      "translation": "",
      "punjabiViakhya": "ਭੂਤ ਨੂੰ ਖ਼ਤਮ ਕਰਨ ਵਾਲਾ ਇਕ ਮੰਤਰ ਉਚਾਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "भूत हता इक मंत्र उचारै ॥",
      "sourceLineId": "138035",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬੀਸ ਮੰਤ੍ਰ ਪੜਿ ਬੀਰ ਪੁਕਾਰੈ ॥",
      "transliteration": "bees ma(n)tr paR beer pukaarai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ 'ਬੀਰ' ਵੀਹ ਮੰਤਰ ਪੜ੍ਰਹ ਦਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "बीस मंत्र पड़ि बीर पुकारै ॥",
      "sourceLineId": "138036",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿਸਹੂੰ ਪਕਰਿ ਚੀਰਿ ਕਰਿ ਦੇਈ ॥",
      "transliteration": "kisahoo(n) pakar cheer kar dheiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਕਿਸੇ ਨੂੰ ਪਕੜ ਕੇ ਚੀਰ ਦਿੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "किसहूँ पकरि चीरि करि देई ॥",
      "sourceLineId": "138037",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਾਹੂੰ ਪਕਰਿ ਰਾਨ ਤਰ ਲੇਈ ॥੮॥",
      "transliteration": "kaahoo(n) pakar raan tar leiee ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਨੂੰ ਪਕੜ ਕੇ ਪੱਟ ਹੇਠਾ ਦਬ ਲੈਂਦਾ ਸੀ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "काहूँ पकरि रान तर लेई ॥८॥",
      "sourceLineId": "138038",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਬ ਸਭ ਸਕਲ ਮੰਤ੍ਰ ਕਰਿ ਹਾਰੇ ॥",
      "transliteration": "jab sabh sakal ma(n)tr kar haare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸਭ ਸਾਰੇ ਮੰਤਰ ਕਰ ਕੇ ਹਾਰ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "जब सभ सकल मंत्र करि हारे ॥",
      "sourceLineId": "138039",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਬ ਇਹ ਬਿਧਿ ਤਨ ਬੀਰ ਪੁਕਾਰੇ ॥",
      "transliteration": "tab ieh bidh tan beer pukaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਉਨ੍ਰਹਾ ਪ੍ਰਤਿ 'ਬੀਰ' ਇਸ ਤਰ੍ਰਹਾ ਬੋਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "तब इह बिधि तन बीर पुकारे ॥",
      "sourceLineId": "138040",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੇ ਗੁਰ ਮੋਰ ਇਹਾ ਚਲਿ ਆਵੈ ॥",
      "transliteration": "je gur mor ihaa chal aavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਮੇਰਾ ਗੁਰੂ ਇਥੇ ਚਲ ਕੇ ਆਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "जे गुर मोर इहा चलि आवै ॥",
      "sourceLineId": "138041",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਤਬ ਹੀ ਸੁਖ ਪਾਵੈ ॥੯॥",
      "transliteration": "raaj kuar tab hee sukh paavai ||9||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਰਾਜ ਕੁਮਾਰ ਸੁਖ ਪ੍ਰਾਪਤ ਕਰੇਗਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "राज कुअर तब ही सुख पावै ॥९॥",
      "sourceLineId": "138042",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਰਾਜਾ ਪਗ ਪਰੇ ॥",
      "transliteration": "sunat bachan raajaa pag pare ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਬਚਨ ਸੁਣ ਕੇ ਰਾਜਾ ਪੈਰੀਂ ਪੈ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन राजा पग परे ॥",
      "sourceLineId": "138043",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਹੁ ਉਸਤਤਿ ਕਰਿ ਬਚਨ ਉਚਰੇ ॥",
      "transliteration": "bahu usatat kar bachan uchare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਬੀਰ ਦੀ) ਬਹੁਤ ਉਸਤਤ ਕਰ ਕੇ ਕਹਿਣ ਲਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "बहु उसतति करि बचन उचरे ॥",
      "sourceLineId": "138044",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਹਾ ਤੋਰ ਗੁਰ ਮੋਹਿ ਬਤੈਯੈ ॥",
      "transliteration": "kahaa tor gur moh bataiyai ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਹਾਡਾ ਗੁਰੂ ਕਿਥੇ ਹੈ, ਮੈਨੂੰ ਦਸੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "कहा तोर गुर मोहि बतैयै ॥",
      "sourceLineId": "138045",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਭਾਤਿ ਤਾਹਿ ਹ੍ਯਾਂ ਲ੍ਯੈਯੈ ॥੧੦॥",
      "transliteration": "jeh teh bhaat taeh hayaa(n) layaiyai ||10||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨੂੰ ਇਥੇ ਲੈ ਕੇ ਆਈਏ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "जिह तिह भाति ताहि ह्याँ ल्यैयै ॥१०॥",
      "sourceLineId": "138046",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਵਨ ਪੁਰਖ ਕਾ ਨਾਮ ਬਤਾਯੋ ॥",
      "transliteration": "javan purakh kaa naam bataayo ||",
      "translation": "",
      "punjabiViakhya": "(ਬੀਰ ਨੇ) ਜਿਸ ਪੁਰਸ਼ ਦਾ ਨਾ ਦਸਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "जवन पुरख का नाम बतायो ॥",
      "sourceLineId": "138047",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਰਿ ਤਿਸੀ ਕਾ ਭੇਸ ਬਨਾਯੋ ॥",
      "transliteration": "naar tisee kaa bhes banaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਉਸੇ ਦਾ ਭੇਸ ਬਣਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "नारि तिसी का भेस बनायो ॥",
      "sourceLineId": "138048",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨ੍ਰਿਪਹਿ ਠੌਰ ਭਾਖਤ ਭਯੋ ਜਹਾ ॥",
      "transliteration": "nirapeh Thauar bhaakhat bhayo jahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਬੀਰ ਨੇ) ਰਾਜੇ ਨੂੰ ਜਿਥੇ (ਉਸ ਦਾ ਠਿਕਾਣਾ) ਦਸਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "नृपहि ठौर भाखत भयो जहा ॥",
      "sourceLineId": "138049",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬੈਠੀ ਜਾਹਿ ਚੰਚਲਾ ਤਹਾ ॥੧੧॥",
      "transliteration": "baiThee jaeh cha(n)chalaa tahaa ||11||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਇਸਤਰੀ ਉਥੇ ਜਾ ਬੈਠੀ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "बैठी जाहि चंचला तहा ॥११॥",
      "sourceLineId": "138050",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਚਨ ਸੁਨਤ ਤਹ ਭੂਪ ਸਿਧਾਰਿਯੋ ॥",
      "transliteration": "bachan sunat teh bhoop sidhaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਗੱਲ ਸੁਣ ਕੇ ਰਾਜਾ ਉਥੇ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "बचन सुनत तह भूप सिधारियो ॥",
      "sourceLineId": "138051",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਿਹੀ ਰੂਪ ਤਰ ਪੁਰਖ ਨਿਹਾਰਿਯੋ ॥",
      "transliteration": "tihee roop tar purakh nihaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਸਰੂਪ ਵਾਲਾ ਪੁਰਸ਼ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "तिही रूप तर पुरख निहारियो ॥",
      "sourceLineId": "138052",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਬਿਧ ਤਾ ਕੌ ਬਿਰਮਾਯੋ ॥",
      "transliteration": "jeh teh bidh taa kau biramaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਉਸ ਨੂੰ ਸਮਝਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "जिह तिह बिध ता कौ बिरमायो ॥",
      "sourceLineId": "138053",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਪੁਨੇ ਧਾਮ ਤਾਹਿ ਲੈ ਆਯੋ ॥੧੨॥",
      "transliteration": "apune dhaam taeh lai aayo ||12||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਆਪਣੇ ਘਰ ਲੈ ਆਇਆ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "अपुने धाम ताहि लै आयो ॥१२॥",
      "sourceLineId": "138054",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਤਾ ਕਹ ਦਰਸਾਯੋ ॥",
      "transliteration": "raaj kuar taa keh dharasaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਰਾਜ ਕੁਮਾਰ ਵਿਖਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "राज कुअर ता कह दरसायो ॥",
      "sourceLineId": "138055",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਚਨ ਤਾਹਿ ਇਹ ਭਾਤਿ ਸੁਨਾਯੋ ॥",
      "transliteration": "bachan taeh ieh bhaat sunaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ (ਇਸਤਰੀ ਨੇ ਵੇਖ ਕੇ) ਇਸ ਤਰ੍ਰਹਾ ਗੱਲ ਕਹੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "बचन ताहि इह भाति सुनायो ॥",
      "sourceLineId": "138056",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਯੌ ਇਹ ਤ੍ਰਿਯ ਪਤਿਬ੍ਰਤਾ ਬਰੈ ॥",
      "transliteration": "yau ieh tiray patibrataa barai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਇਹ (ਕਿਸੇ) ਪਤਿਬ੍ਰਤਾ ਇਸਤਰੀ ਨਾਲ ਵਿਆਹ ਕਰੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "यौ इह तृय पतिब्रता बरै ॥",
      "sourceLineId": "138057",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਊ ਬਚੈ ਯਹ ਯੌ ਨ ਉਬਰੈ ॥੧੩॥",
      "transliteration": "tuoo bachai yeh yau na ubarai ||13||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਹੀ ਇਹ ਬਚੇਗਾ, ਉਾਂਜ (ਇਸ ਦਾ) ਉੱਧਾਰ ਨਹੀਂ ਹੋ ਸਕੇਗਾ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "तऊ बचै यह यौ न उबरै ॥१३॥",
      "sourceLineId": "138058",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਰਤ ਕਰਤ ਬਹੁ ਬਚਨ ਬਤਾਯੋ ॥",
      "transliteration": "karat karat bahu bachan bataayo ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਗੱਲਾ ਕਰਦਿਆਂ ਕਰਦਿਆਂ (ਇਸਤਰੀ ਨੇ)",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "करत करत बहु बचन बतायो ॥",
      "sourceLineId": "138059",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਾਹੁ ਸੁਤਾ ਕੇ ਨਾਮੁ ਜਤਾਯੋ ॥",
      "transliteration": "saahu sutaa ke naam jataayo ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਾਹ ਦੀ ਧੀ ਦਾ ਨਾ ਦਸਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "साहु सुता के नामु जतायो ॥",
      "sourceLineId": "138060",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੋ ਪਤਿਬ੍ਰਤਾ ਤਾਹਿ ਬਿਵਾਵਹੁ ॥",
      "transliteration": "so patibrataa taeh bivaavahu ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪਤਿਬ੍ਰਤਾ ਹੈ, ਉਸ (ਰਾਜ ਕੁਮਾਰ) ਦਾ ਵਿਆਹ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "सो पतिब्रता ताहि बिवावहु ॥",
      "sourceLineId": "138061",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੌ ਨ੍ਰਿਪ ਸੁਤਹਿ ਜਿਯਾਯੋ ਚਾਹਹੁ ॥੧੪॥",
      "transliteration": "jau nirap suteh jiyaayo chaahahu ||14||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਤੁਸੀਂ ਰਾਜੇ ਦੇ ਪੁੱਤਰ ਨੂੰ ਜੀਵਾਉਣਾ ਚਾਹੁੰਦੇ ਹੋ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "जौ नृप सुतहि जियायो चाहहु ॥१४॥",
      "sourceLineId": "138062",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜੌ ਯਹ ਤਾਹਿ ਬ੍ਯਾਹਿ ਲ੍ਯਾਵੈ ॥",
      "transliteration": "jau yeh taeh bayaeh layaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਇਹ ਉਸ ਨੂੰ ਵਿਆਹ ਲਿਆਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "जौ यह ताहि ब्याहि ल्यावै ॥",
      "sourceLineId": "138063",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰੈਨਿ ਦਿਵਸ ਤਾ ਸੋ ਲਪਟਾਵੈ ॥",
      "transliteration": "rain dhivas taa so lapaTaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਤ ਦਿਨ ਉਸ ਨਾਲ ਲਿਪਟਿਆ ਰਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "रैनि दिवस ता सो लपटावै ॥",
      "sourceLineId": "138064",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਵਰ ਨਾਰਿ ਕੇ ਨਿਕਟ ਨ ਜਾਇ ॥",
      "transliteration": "avar naar ke nikaT na jai ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਕਿਸੇ ਇਸਤਰੀ ਦੇ ਨੇੜੇ ਨਾ ਜਾਵੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "अवर नारि के निकट न जाइ ॥",
      "sourceLineId": "138065",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਬ ਯਹ ਜਿਯੈ ਕੁਅਰ ਸੁਭ ਕਾਇ ॥੧੫॥",
      "transliteration": "tab yeh jiyai kuar subh kai ||15||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਇਹ ਸ਼ੁਭ ਕਾਇਆ ਵਾਲਾ ਰਾਜ ਕੁਮਾਰ ਜੀਉਾਂਦਾ ਰਹਿ ਸਕੇਗਾ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "तब यह जियै कुअर सुभ काइ ॥१५॥",
      "sourceLineId": "138066",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਯਹੈ ਕਾਰ ਰਾਜਾ ਤੁਮ ਕੀਜੈ ॥",
      "transliteration": "yahai kaar raajaa tum keejai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਰਾਜਨ! ਤੁਸੀਂ ਇਹੀ ਕਾਰਜ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "यहै कार राजा तुम कीजै ॥",
      "sourceLineId": "138067",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਬ ਹੀ ਹਮਹਿ ਬਿਦਾ ਕਰਿ ਦੀਜੈ ॥",
      "transliteration": "ab hee hameh bidhaa kar dheejai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੈਨੂੰ ਹੁਣੇ ਵਿਦਾ ਕਰ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "अब ही हमहि बिदा करि दीजै ॥",
      "sourceLineId": "138068",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲੈ ਆਗ੍ਯਾ ਤਿਹ ਆਸ੍ਰਮ ਗਈ ॥",
      "transliteration": "lai aagayaa teh aasram giee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ (ਇਸਤਰੀ) ਆਗਿਆ ਲੈ ਕੇ ਆਸ਼੍ਰਮ ਵਿਚ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "लै आग्या तिह आस्रम गई ॥",
      "sourceLineId": "138069",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਧਾਰਤ ਭੇਸ ਨਾਰਿ ਕਾ ਭਈ ॥੧੬॥",
      "transliteration": "dhaarat bhes naar kaa bhiee ||16||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸਤਰੀ ਦਾ ਭੇਸ ਧਾਰ ਲਿਆ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "धारत भेस नारि का भई ॥१६॥",
      "sourceLineId": "138070",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰਾਜ ਸਾਜ ਬ੍ਯਾਹ ਕੌ ਬਨਾਯੋ ॥",
      "transliteration": "raaj saaj bayaeh kau banaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਵਿਆਹ ਦਾ ਸਾਜ ਬਣਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "राज साज ब्याह कौ बनायो ॥",
      "sourceLineId": "138071",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਾਹ ਸੁਤਾ ਹਿਤ ਪੂਤ ਪਠਾਯੋ ॥",
      "transliteration": "saeh sutaa hit poot paThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਆਪਣੇ) ਪੁੱਤਰ ਨੂੰ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ (ਨਾਲ ਵਿਆਹ ਕਰਨ) ਲਈ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "साह सुता हित पूत पठायो ॥",
      "sourceLineId": "138072",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਬ ਹੀ ਬ੍ਯਾਹ ਤਵਨ ਸੌ ਭਯੋ ॥",
      "transliteration": "jab hee bayaeh tavan sau bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਹੀ (ਉਸ ਦਾ) ਉਸ ਨਾਲ ਵਿਆਹ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "जब ही ब्याह तवन सौ भयो ॥",
      "sourceLineId": "138073",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਬ ਹੀ ਤਾਹਿ ਭੂਤ ਤਜਿ ਗਯੋ ॥੧੭॥",
      "transliteration": "tab hee taeh bhoot taj gayo ||17||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਹੀ ਉਸ ਨੂੰ ਭੂਤ ਛਡ ਗਿਆ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "तब ही ताहि भूत तजि गयो ॥१७॥",
      "sourceLineId": "138074",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਇਹ ਛਲ ਸੌ ਪਾਯੋ ॥",
      "transliteration": "raaj kuar ieh chhal sau paayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨੇ) ਇਸ ਛਲ ਨਾਲ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਪ੍ਰਾਪਤ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "राज कुअर इह छल सौ पायो ॥",
      "sourceLineId": "138075",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਸੀ ਬਤਾਯੋ ॥",
      "transliteration": "bhedh abhedh na kisee bataayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੇਦ ਅਭੇਦ ਕਿਸੇ ਨੂੰ ਨਾ ਦਸਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न किसी बतायो ॥",
      "sourceLineId": "138076",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚੰਚਲਾਨ ਕੇ ਚਰਿਤ ਅਪਾਰਾ ॥",
      "transliteration": "cha(n)chalaan ke charit apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀਆਂ ਦੇ ਚਰਿਤ੍ਰ ਅਪਾਰ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "चंचलान के चरित अपारा ॥",
      "sourceLineId": "138077",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚਕ੍ਰਿਤ ਰਹਾ ਕਰਿ ਕਰਿ ਕਰਤਾਰਾ ॥੧੮॥",
      "transliteration": "chakirat rahaa kar kar karataaraa ||18||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਨੂੰ) ਸਿਰਜ ਸਿਰਜ ਕੇ ਵਿਧਾਤਾ ਵੀ ਹੈਰਾਨ ਹੋ ਰਿਹਾ ਹੈ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "चकृत रहा करि करि करतारा ॥१८॥",
      "sourceLineId": "138078",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਪਚਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੫॥੭੦੩੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau pachaanavo charitr samaapatam sat subham sat ||395||7033||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੯੫ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੯੫॥੭੦੩੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ पचानवो चरित्र समापतम सतु सुभम सतु ॥३९५॥७०३३॥अफजूँ॥",
      "sourceLineId": "138079",
      "sourceShabadId": "12743",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "138080",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰਿਥੀ ਸਿੰਘ ਇਕ ਭੂਪ ਬਖਨਿਯਤ ॥",
      "transliteration": "pirathee si(n)gh ik bhoop bakhaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਿਥੀ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "पृथी सिंघ इक भूप बखनियत ॥",
      "sourceLineId": "138081",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1348_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਿਰਥੀ ਪੁਰ ਤਿਹ ਨਗਰ ਪ੍ਰਮਨਿਯਤ ॥",
      "transliteration": "pirathee pur teh nagar pramaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਨਗਰ ਦਾ ਨਾ ਪ੍ਰਿਥੀ ਪੁਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": "पिरथी पुर तिह नगर प्रमनियत ॥",
      "sourceLineId": "138082",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
