{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1349,
  "lineCount": 71,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1349_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਲਾਲ ਮਤੀ ਰਾਨੀ ਤਿਹ ਸੋਹੈ ॥",
      "transliteration": "laal matee raanee teh sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਰਾਣੀ ਦਾ ਨਾ ਲਾਲ ਮਤੀ ਸ਼ੋਭਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "लाल मती रानी तिह सोहै ॥",
      "sourceLineId": "138083",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁਰ ਨਰ ਨਾਰਿ ਭੁਜੰਗਨ ਮੋਹੈ ॥੧॥",
      "transliteration": "sur nar naar bhuja(n)gan mohai ||1||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ) ਦੇਵਤੇ, ਮਰਦ, ਇਸਤਰੀਆਂ ਅਤੇ ਨਾਗ-ਕੁਮਾਰੀਆਂ ਮੋਹਿਤ ਹੋ ਜਾਦੀਆਂ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "सुर नर नारि भुजंगन मोहै ॥१॥",
      "sourceLineId": "138084",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਿੰਘ ਮੇਦਨੀ ਸੁਤ ਕਾ ਨਾਮਾ ॥",
      "transliteration": "si(n)gh medhanee sut kaa naamaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਪੁੱਤਰ ਦਾ ਨਾਮ ਮੇਦਨੀ ਸਿੰਘ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "सिंघ मेदनी सुत का नामा ॥",
      "sourceLineId": "138085",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਥਕਿਤ ਰਹਤ ਜਾ ਕੌ ਲਖਿ ਬਾਮਾ ॥",
      "transliteration": "thakit rahat jaa kau lakh baamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਇਸਤਰੀਆਂ ਸ਼ਿਥਲ ਹੋ ਜਾਦੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "थकित रहत जा कौ लखि बामा ॥",
      "sourceLineId": "138086",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਧਿਕ ਰੂਪ ਤਾ ਕੋ ਬਿਧਿ ਕਰਿਯੋ ॥",
      "transliteration": "adhik roop taa ko bidh kariyo ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਧਾਤਾ ਨੇ ਉਸ ਨੂੰ (ਕੁਝ) ਜ਼ਿਆਦਾ ਹੀ ਰੂਪਵਾਨ ਬਣਾਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "अधिक रूप ता को बिधि करियो ॥",
      "sourceLineId": "138087",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਨੁ ਕਰਿ ਕਾਮ ਦੇਵ ਅਵਤਰਿਯੋ ॥੨॥",
      "transliteration": "jan kar kaam dhev avatariyo ||2||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਕਾਮ ਦੇਵ ਹੀ ਅਵਤਰਿਤ ਹੋਇਆ ਹੋਵੇ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "जनु करि काम देव अवतरियो ॥२॥",
      "sourceLineId": "138088",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚਪਲਾ ਦੇ ਤਹ ਸਾਹ ਦੁਲਾਰੀ ॥",
      "transliteration": "chapalaa dhe teh saeh dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਚਪਲਾ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "चपला दे तह साह दुलारी ॥",
      "sourceLineId": "138089",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਨਕ ਅਵਟਿ ਸਾਚੇ ਜਨੁ ਢਾਰੀ ॥",
      "transliteration": "kanak avaT saache jan ddaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਸੋਨੇ ਨੂੰ ਪੰਘਾਰ ਕੇ ਸੰਚੇ ਵਿਚ ਢਾਲੀ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "कनक अवटि साचे जनु ढारी ॥",
      "sourceLineId": "138090",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਾਜ ਪੁਤ੍ਰ ਜਬ ਤਾਹਿ ਨਿਹਾਰਾ ॥",
      "transliteration": "raaj putr jab taeh nihaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਨੇ ਜਦ ਉਸ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "राज पुत्र जब ताहि निहारा ॥",
      "sourceLineId": "138091",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਿਰਖਿ ਤਰੁਨਿ ਹ੍ਵੈ ਗਯੋ ਮਤਵਾਰਾ ॥੩॥",
      "transliteration": "nirakh tarun havai gayo matavaaraa ||3||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮੁਟਿਆਰ ਨੂੰ ਵੇਖ ਕੇ ਮਤਵਾਲਾ ਹੋ ਗਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "निरखि तरुनि ह्वै गयो मतवारा ॥३॥",
      "sourceLineId": "138092",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਏਕ ਸਹਚਰੀ ਨਿਕਟਿ ਬੁਲਾਈ ॥",
      "transliteration": "ek sahacharee nikaT bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਦਾਸੀ ਨੂੰ ਕੋਲ ਬੁਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "एक सहचरी निकटि बुलाई ॥",
      "sourceLineId": "138093",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਮਿਤ ਦਰਬ ਦੈ ਤਹਾ ਪਠਾਈ ॥",
      "transliteration": "amit dharab dhai tahaa paThaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਬੇਹਿਸਾਬ ਧਨ ਦੇ ਕੇ ਉਥੇ ਭੇਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "अमित दरब दै तहा पठाई ॥",
      "sourceLineId": "138094",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਬ ਤੈ ਚਪਲ ਮਤੀ ਕੌ ਲ੍ਰਯੈ ਹੈਂ ॥",
      "transliteration": "jab tai chapal matee kau lrayai hai(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਜਦ ਤੂੰ ਚਪਲ ਮਤੀ ਨੂੰ ਲੈ ਕੇ ਆਵੇਾਂਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "जब तै चपल मती कौ ल्रयै हैं ॥",
      "sourceLineId": "138095",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੁਖਿ ਮੰਗ ਹੈ ਜੋ ਕਛੁ ਸੋ ਪੈ ਹੈਂ ॥੪॥",
      "transliteration": "mukh ma(n)g hai jo kachh so pai hai(n) ||4||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਜੋ ਕੁਝ ਵੀ ਮੂਹੋਂ ਮੰਗੇਾਂਗੀ, ਉਹੀ ਪ੍ਰਾਪਤ ਕਰੇਾਂਗੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "मुखि मंग है जो कछु सो पै हैं ॥४॥",
      "sourceLineId": "138096",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਚਨ ਸੁਨਤ ਸਹਚਰਿ ਤਹ ਗਈ ॥",
      "transliteration": "bachan sunat sahachar teh giee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰ ਦਾ) ਬਚਨ ਸੁਣ ਕੇ ਦਾਸੀ ਉਥੇ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "बचन सुनत सहचरि तह गई ॥",
      "sourceLineId": "138097",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਤਾਹਿ ਪ੍ਰਬੋਧਤ ਭਈ ॥",
      "transliteration": "bahu bidh taeh prabodhat bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਬਹੁਤ ਤਰ੍ਰਹਾ ਨਾਲ ਸਮਝਾਉਣ ਲਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "बहु बिधि ताहि प्रबोधत भई ॥",
      "sourceLineId": "138098",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਾਹ ਸੁਤਾ ਜਬ ਹਾਥ ਨ ਆਈ ॥",
      "transliteration": "saeh sutaa jab haath na aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਕਾਬੂ ਨਾ ਆਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "साह सुता जब हाथ न आई ॥",
      "sourceLineId": "138099",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਬ ਦੂਤੀ ਇਹ ਘਾਤ ਬਨਾਈ ॥੫॥",
      "transliteration": "tab dhootee ieh ghaat banaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੂਤੀ ਨੇ ਇਹ ਦਾਓ ਵਰਤਿਆ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "तब दूती इह घात बनाई ॥५॥",
      "sourceLineId": "138100",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਵ ਪਿਤਿ ਧਾਮ ਜੁ ਨਏ ਉਸਾਰੇ ॥",
      "transliteration": "tav pit dhaam ju ne usaare ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੀ) ਤੇਰੇ ਪਿਤਾ ਨੇ ਜੋ ਨਵੇਾਂ ਮਹੱਲ ਉਸਾਰੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "तव पिति धाम जु नए उसारे ॥",
      "sourceLineId": "138101",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਲਹੁ ਜਾਇ ਤਿਹ ਲਖੌ ਸਵਾਰੇ ॥",
      "transliteration": "chalahu jai teh lakhau savaare ||",
      "translation": "",
      "punjabiViakhya": "ਚਲੋ ਅਤੇ ਜਾ ਕੇ ਉਨ੍ਰਹਾ ਨੂੰ ਚੰਗੀ ਤਰ੍ਰਹਾ ਵੇਖੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "चलहु जाइ तिह लखौ सवारे ॥",
      "sourceLineId": "138102",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਯੌ ਕਹਿ ਡਾਰਿ ਡੋਰਿਯਹਿ ਲਿਯੋ ॥",
      "transliteration": "yau keh ddaar ddoriyeh liyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਕਹਿ ਕੇ (ਉਸ ਸ਼ਾਹ-ਪੁੱਤਰੀ ਨੂੰ) ਡੋਲੀ (ਪਾਲਕੀ) ਵਿਚ ਬਿਠਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "यौ कहि डारि डोरियहि लियो ॥",
      "sourceLineId": "138103",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਰਦਨ ਡਾਰਿ ਚਹੂੰ ਦਿਸਿ ਦਿਯੋ ॥੬॥",
      "transliteration": "paradhan ddaar chahoo(n) dhis dhiyo ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੌਹਾ ਪਾਸੇ ਪਰਦੇ ਕਰ ਦਿੱਤੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "परदन डारि चहूँ दिसि दियो ॥६॥",
      "sourceLineId": "138104",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਹ ਛਲ ਸਾਹ ਸੁਤਾ ਡਹਕਾਈ ॥",
      "transliteration": "eeh chhal saeh sutaa ddahakaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਨੂੰ ਭਰਮਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "इह छल साह सुता डहकाई ॥",
      "sourceLineId": "138105",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੰਗ ਲਏ ਨ੍ਰਿਪ ਸੁਤ ਘਰ ਆਈ ॥",
      "transliteration": "sa(n)g le nirap sut ghar aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਨਾਲ ਲੈ ਕੇ ਰਾਜ ਕੁਮਾਰ ਦੇ ਘਰ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "संग लए नृप सुत घर आई ॥",
      "sourceLineId": "138106",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਹੀ ਆਨਿ ਪਰਦਾਨ ਉਘਾਰ ॥",
      "transliteration": "tahee aan paradhaan ughaar ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਆ ਕੇ ਪਰਦਿਆਂ ਨੂੰ ਚੁਕਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "तही आनि परदान उघार ॥",
      "sourceLineId": "138107",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਰਿ ਲਖਾ ਤਹ ਰਾਜ ਕੁਮਾਰਾ ॥੭॥",
      "transliteration": "naar lakhaa teh raaj kumaaraa ||7||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਇਸਤਰੀ ਨੇ ਉਸ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਵੇਖਿਆ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "नारि लखा तह राज कुमारा ॥७॥",
      "sourceLineId": "138108",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾਤ ਮਾਤ ਇਹ ਠੌਰ ਨ ਭਾਈ ॥",
      "transliteration": "taat maat ieh Thauar na bhaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਸੋਚਣ ਲਗੀ) ਇਥੇ ਨਾ ਮੇਰੀ ਮਾਤਾ, ਪਿਤਾ ਜਾ ਭਰਾ (ਕੋਈ ਵੀ) ਨਹੀਂ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "तात मात इह ठौर न भाई ॥",
      "sourceLineId": "138109",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਨ ਦੂਤੀ ਹੌ ਆਨਿ ਫਸਾਈ ॥",
      "transliteration": "ein dhootee hau aan fasaiee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਦੂਤੀ ਨੇ (ਮੈਨੂੰ) ਲਿਆ ਕੇ ਫਸਾ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "इन दूती हौ आनि फसाई ॥",
      "sourceLineId": "138110",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਜੌ ਮੁਝੈ ਨ ਪੈ ਹੈ ॥",
      "transliteration": "raaj kuar jau mujhai na pai hai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਹੁਣ ਮੈਨੂੰ ਰਾਜ ਕੁਮਾਰ ਪ੍ਰਾਪਤ ਨਹੀਂ ਕਰ ਸਕੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "राज कुअर जौ मुझै न पै है ॥",
      "sourceLineId": "138111",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਾਕ ਕਾਨ ਕਟਿ ਲੀਕ ਲਗੈ ਹੈ ॥੮॥",
      "transliteration": "naak kaan kaT leek lagai hai ||8||",
      "translation": "",
      "punjabiViakhya": "ਤਾ (ਮੇਰਾ) ਨੱਕ ਅਤੇ ਕੰਨ ਕਟ ਕੇ ਲੀਕ ਲਗਾ ਦੇਏਗਾ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "नाक कान कटि लीक लगै है ॥८॥",
      "sourceLineId": "138112",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਕਰਿ ਗਿਰੀ ਧਰਨਿ ਪਰ ॥",
      "transliteration": "hai hai kar giree dharan par ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) 'ਹਾਇ ਹਾਇ' ਕਰਦੀ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਈ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ करि गिरी धरनि पर ॥",
      "sourceLineId": "138113",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਟੀ ਕਹਾ ਕਰ ਯਾਹਿ ਬਿਛੂ ਬਰ ॥",
      "transliteration": "kaTee kahaa kar yaeh bichhoo bar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਹਿਣ ਲਗੀ ਕਿ ਮੈਨੂੰ ਬਿਛੂ ਨੇ ਕਟ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "कटी कहा कर याहि बिछू बर ॥",
      "sourceLineId": "138114",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਧ੍ਰਿਗ ਬਿਧਿ ਕੋ ਮੋ ਸੌ ਕਸ ਕੀਯਾ ॥",
      "transliteration": "dhirag bidh ko mo sau kas keeyaa ||",
      "translation": "",
      "punjabiViakhya": "ਧਿੱਕਾਰ ਹੈ ਕਿ ਮੇਰੇ ਨਾਲ ਵਿਧਾਤਾ ਨੇ ਕੀ (ਜ਼ੁਲਮ) ਕੀਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "धृग बिधि को मो सौ कस कीया ॥",
      "sourceLineId": "138115",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਜ ਕੁਅਰ ਨਹਿ ਭੇਟਨ ਦੀਯਾ ॥੯॥",
      "transliteration": "raaj kuar neh bheTan dheeyaa ||9||",
      "translation": "",
      "punjabiViakhya": "ਕਿ (ਮੈਨੂੰ) ਅਜ ਰਾਜ ਕੁਮਾਰ ਨੂੰ ਮਿਲਣ ਤਕ ਨਹੀਂ ਦਿੱਤਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "राज कुअर नहि भेटन दीया ॥९॥",
      "sourceLineId": "138116",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਬ ਮੈ ਨਿਜੁ ਘਰ ਕੌ ਫਿਰਿ ਜੈ ਹੌ ॥",
      "transliteration": "ab mai nij ghar kau fir jai hau ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਆਪਣੇ ਘਰ ਨੂੰ ਪਰਤਦੀ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "अब मै निजु घर कौ फिरि जै हौ ॥",
      "sourceLineId": "138117",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦ੍ਵੈ ਦਿਨ ਕੌ ਤੁਮਰੇ ਫਿਰਿ ਐ ਹੌ ॥",
      "transliteration": "dhavai dhin kau tumare fir aai hau ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋ ਕੁ ਦਿਨਾ ਬਾਦ ਤੁਹਾਡੇ ਕੋਲ ਆਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "द्वै दिन कौ तुमरे फिरि ऐ हौ ॥",
      "sourceLineId": "138118",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰਾਜ ਪੁਤ੍ਰ ਲਖਿ ਕ੍ਰਿਯਾ ਨ ਲਈ ॥",
      "transliteration": "raaj putr lakh kirayaa na liee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰ ਉਸ ਦੇ ਚਰਿਤ੍ਰ ਨੂੰ ਨਾ ਸਮਝਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "राज पुत्र लखि कृया न लई ॥",
      "sourceLineId": "138119",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਹ ਛਲ ਮੂੰਡ ਮੂੰਡ ਤਿਹ ਗਈ ॥੧੦॥",
      "transliteration": "eeh chhal moo(n)dd moo(n)dd teh giee ||10||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਛਲ ਨਾਲ (ਉਹ) ਉਸ ਦਾ ਸਿਰ ਮੁੰਨ ਕੇ ਚਲੀ ਗਈ (ਅਰਥਾਤ ਛਲ ਕੇ ਚਲੀ ਗਈ) ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "इह छल मूँड मूँड तिह गई ॥१०॥",
      "sourceLineId": "138120",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਛਿਆਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੬॥੭੦੪੩॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau chhiaanavo charitr samaapatam sat subham sat ||396||7043||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੯੬ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੯੬॥੭੦੪੩॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ छिआनवो चरित्र समापतम सतु सुभम सतु ॥३९६॥७०४३॥अफजूँ॥",
      "sourceLineId": "138121",
      "sourceShabadId": "12744",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "138122",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਗਰ ਦੇਸ ਸੁਨਿਯਤ ਹੈ ਜਹਾ ॥",
      "transliteration": "sagar dhes suniyat hai jahaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਸਗਰ ਨਾ ਦਾ ਦੇਸ਼ ਸੁਣੀਂਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "सगर देस सुनियत है जहा ॥",
      "sourceLineId": "138123",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਗਰ ਸੈਨ ਰਾਜਾ ਇਕ ਤਹਾ ॥",
      "transliteration": "sagar sain raajaa ik tahaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਸਗਰ ਸੈਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "सगर सैन राजा इक तहा ॥",
      "sourceLineId": "138124",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਗਰ ਦੇਇ ਤਿਹ ਸੁਤਾ ਭਨਿਜੈ ॥",
      "transliteration": "sagar dhei teh sutaa bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪੁੱਤਰੀ ਦਾ ਨਾ ਸਗਰ ਦੇਈ ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "सगर देइ तिह सुता भनिजै ॥",
      "sourceLineId": "138125",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੰਦ ਸੂਰ ਲਖਿ ਤਾਹਿ ਜੁ ਲੱਜੈ ॥੧॥",
      "transliteration": "cha(n)dh soor lakh taeh ju la'jai ||1||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਵੇਖ ਕੇ ਸੂਰਜ ਅਤੇ ਚੰਦ੍ਰਮਾ ਵੀ ਸ਼ਰਮਾਉਾਂਦੇ ਸਨ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "चंद सूर लखि ताहि जु लज्जै ॥१॥",
      "sourceLineId": "138126",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਜਨੀ ਰਾਇ ਤਵਨ ਜਹ ਲਹਿਯੋ ॥",
      "transliteration": "gajanee rai tavan jeh lahiyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਜਦ ਗਜ਼ਨੀ ਰਾਇ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "गजनी राइ तवन जह लहियो ॥",
      "sourceLineId": "138127",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਨ ਕ੍ਰਮ ਬਚਨ ਕੁਅਰਿ ਅਸ ਕਹਿਯੋ ॥",
      "transliteration": "man kram bachan kuar as kahiyo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਮਨ, ਬਚਨ ਅਤੇ ਕਰਮ ਕਰ ਕੇ ਕੁੰਵਰੀ ਨੇ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "मन क्रम बचन कुअरि अस कहियो ॥",
      "sourceLineId": "138128",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਐਸੋ ਛੈਲ ਏਕ ਦਿਨ ਪੈਯੈ ॥",
      "transliteration": "aaiso chhail ek dhin paiyai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਅਜਿਹਾ ਸੁੰਦਰ ਛੈਲ ਇਕ ਦਿਨ ਲਈ ਹੀ ਪ੍ਰਾਪਤ ਕਰ ਲਵਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "ऐसो छैल एक दिन पैयै ॥",
      "sourceLineId": "138129",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਪਲ ਪਲ ਬਲਿ ਜੈਯੈ ॥੨॥",
      "transliteration": "janam janam pal pal bal jaiyai ||2||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਜਨਮ ਜਨਮਾਤਰਾ ਤਕ ਪਲ ਪਲ (ਇਸ ਉਪਰੋਂ) ਬਲਿਹਾਰ ਜਾਵਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "जनम जनम पल पल बलि जैयै ॥२॥",
      "sourceLineId": "138130",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਖੀ ਏਕ ਤਿਹ ਤੀਰ ਪਠਾਇ ॥",
      "transliteration": "sakhee ek teh teer paThai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਸਖੀ ਨੂੰ ਉਸ ਕੋਲ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "सखी एक तिह तीर पठाइ ॥",
      "sourceLineId": "138131",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਕਰਿ ਲਿਯਾ ਬੁਲਾਇ ॥",
      "transliteration": "jeh teh bidh kar liyaa bulai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਕਰ ਕੇ (ਉਸ ਨੂੰ) ਬੁਲਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "जिह तिह बिधि करि लिया बुलाइ ॥",
      "sourceLineId": "138132",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਪਨ ਸੇਜ ਪਰ ਤਿਹ ਬੈਠਾਰਾ ॥",
      "transliteration": "apan sej par teh baiThaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਆਪਣੀ ਸੇਜ ਉਤੇ ਬਿਠਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "अपन सेज पर तिह बैठारा ॥",
      "sourceLineId": "138133",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਕਾ ਰਚਾ ਅਖਾਰਾ ॥੩॥",
      "transliteration": "kaam bhog kaa rachaa akhaaraa ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਸੇਜ ਨੂੰ) ਕਾਮ-ਕ੍ਰੀੜਾ ਦਾ ਅਖਾੜਾ ਬਣਾ ਦਿੱਤਾ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "काम भोग का रचा अखारा ॥३॥",
      "sourceLineId": "138134",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬੈਠ ਸੇਜ ਪਰ ਦੋਇ ਕਲੋਲਹਿ ॥",
      "transliteration": "baiTh sej par dhoi kaloleh ||",
      "translation": "",
      "punjabiViakhya": "ਸੇਜ ਉਤੇ ਬੈਠ ਕੇ ਦੋਵੇਾਂ ਕਲੋਲਾ ਕਰਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "बैठ सेज पर दोइ कलोलहि ॥",
      "sourceLineId": "138135",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮਧੁਰ ਮਧੁਰ ਧੁਨਿ ਮੁਖ ਤੇ ਬੋਲਹਿ ॥",
      "transliteration": "madhur madhur dhun mukh te boleh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੂੰਹ ਤੋਂ ਮਿੱਠੀਆਂ ਮਿੱਠੀਆਂ ਗੱਲਾ ਕਰਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "मधुर मधुर धुनि मुख ते बोलहि ॥",
      "sourceLineId": "138136",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਕਰਤ ਬਿਲਾਸਾ ॥",
      "transliteration": "bhaat bhaat tan karat bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਤਾ ਪਿਤਾ ਦਾ ਡਰ ਤਿਆਗ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन करत बिलासा ॥",
      "sourceLineId": "138137",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਤਾਤ ਮਾਤ ਕੋ ਤਜਿ ਕਰ ਤ੍ਰਾਸਾ ॥੪॥",
      "transliteration": "taat maat ko taj kar traasaa ||4||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਭਾਤ ਭਾਤ ਦਾ ਵਿਲਾਸ ਕਰਦੇ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "तात मात को तजि कर त्रासा ॥४॥",
      "sourceLineId": "138138",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਵਹਿ ॥",
      "transliteration": "posat bhaag afeem ma(n)gaaveh ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪੋਸਤ, ਭੰਗ ਅਤੇ ਅਫ਼ੀਮ ਮੰਗਵਾਉਾਂਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "पोसत भाग अफीम मंगावहि ॥",
      "sourceLineId": "138139",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਏਕ ਖਾਟ ਪਰ ਬੈਠ ਚੜਾਵਹਿ ॥",
      "transliteration": "ek khaaT par baiTh chaRaaveh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਮੰਜੇ ਉਤੇ ਬੈਠ ਕੇ ਸੇਵਨ ਕਰਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "एक खाट पर बैठ चड़ावहि ॥",
      "sourceLineId": "138140",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਤਰੁਨ ਤਰੁਨਿ ਉਰ ਸੌ ਉਰਝਾਈ ॥",
      "transliteration": "tarun tarun ur sau urajhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਇਕ ਨਾਇਕਾ (ਇਕ ਦੂਜੇ ਦੀ) ਛਾਤੀ ਨਾਲ ਲਗ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "तरुन तरुनि उर सौ उरझाई ॥",
      "sourceLineId": "138141",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਰਸਿ ਰਸਿ ਕਸਿ ਕਸਿ ਭੋਗ ਕਮਾਈ ॥੫॥",
      "transliteration": "ras ras kas kas bhog kamaiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਸ ਪੂਰਵਕ ਕਸ ਕਸ ਕੇ ਭੋਗ ਕਰਨ ਲਗੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "रसि रसि कसि कसि भोग कमाई ॥५॥",
      "sourceLineId": "138142",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਰਾਨੀ ਸਹਿਤ ਪਿਤਾ ਤਾ ਕੌ ਬਰ ॥",
      "transliteration": "raanee sahit pitaa taa kau bar ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਸਮੇਤ ਉਸ ਦਾ ਪਿਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "रानी सहित पिता ता कौ बर ॥",
      "sourceLineId": "138143",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਆਵਤ ਭਯੋ ਦੁਹਿਤਾਹੂੰ ਕੇ ਘਰ ॥",
      "transliteration": "aavat bhayo dhuhitaahoo(n) ke ghar ||",
      "translation": "",
      "punjabiViakhya": "ਪੁੱਤਰੀ ਦੇ ਘਰ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "आवत भयो दुहिताहूँ के घर ॥",
      "sourceLineId": "138144",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਅਵਰ ਘਾਤ ਤਿਹ ਹਾਥ ਨ ਆਈ ॥",
      "transliteration": "avar ghaat teh haath na aaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਨੂੰ) ਕੋਈ ਹੋਰ ਦਾਓ ਨਾ ਸੁਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "अवर घात तिह हाथ न आई ॥",
      "sourceLineId": "138145",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਤਾਤ ਮਾਤ ਹਨਿ ਦਏ ਦਬਾਈ ॥੬॥",
      "transliteration": "taat maat han dhe dhabaiee ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਾਤਾ ਪਿਤਾ ਨੂੰ ਮਾਰ ਕੇ ਦਬਾ ਦਿੱਤਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "तात मात हनि दए दबाई ॥६॥",
      "sourceLineId": "138146",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਨਿਜੁ ਆਲੈ ਕਹ ਆਗਿ ਲਗਾਇ ॥",
      "transliteration": "nij aalai keh aag lagai ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਘਰ ਨੂੰ ਅੱਗ ਲਗਾ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "निजु आलै कह आगि लगाइ ॥",
      "sourceLineId": "138147",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਰੋਇ ਉਠੀ ਨਿਜੁ ਪਿਯਹਿ ਦੁਰਾਇ ॥",
      "transliteration": "roi uThee nij piyeh dhurai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਯਾਰ ਨੂੰ ਲੁਕਾ ਕੇ ਰੋਣ ਲਗ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "रोइ उठी निजु पियहि दुराइ ॥",
      "sourceLineId": "138148",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਅਨਲ ਲਗਤ ਦਾਰੂ ਕਹ ਭਈ ॥",
      "transliteration": "anal lagat dhaaroo keh bhiee ||",
      "translation": "",
      "punjabiViakhya": "(ਕਹਿਣ ਲਗੀ) ਬਾਰੂਦ ਨੂੰ ਅੱਗ ('ਅਨਲ') ਲਗ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "अनल लगत दारू कह भई ॥",
      "sourceLineId": "138149",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਰਾਨੀ ਰਾਵ ਸਹਿਤ ਉਡ ਗਈ ॥੭॥",
      "transliteration": "raanee raav sahit udd giee ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਣੀ ਰਾਜੇ ਸਮੇਤ ਉਡ ਗਈ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "रानी राव सहित उड गई ॥७॥",
      "sourceLineId": "138150",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਅਵਰ ਪੁਰਖ ਕਛੁ ਭੇਦ ਨ ਭਾਯੋ ॥",
      "transliteration": "avar purakh kachh bhedh na bhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਕਿਸੇ ਪੁਰਸ਼ ਨੇ ਭੇਦ ਨਾ ਪਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "अवर पुरख कछु भेद न भायो ॥",
      "sourceLineId": "138151",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਕਹਾ ਚੰਚਲਾ ਕਾਜ ਕਮਾਯੋ ॥",
      "transliteration": "kahaa cha(n)chalaa kaaj kamaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸਤਰੀ ਨੇ ਕੀ ਚਰਿਤ੍ਰ ਖੇਡਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "कहा चंचला काज कमायो ॥",
      "sourceLineId": "138152",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1349_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਅਪਨ ਰਾਜ ਦੇਸ ਕਾ ਕਰਾ ॥",
      "transliteration": "apan raaj dhes kaa karaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਪ ਆਪਣੇ ਦੇਸ਼ ਦਾ ਰਾਜ ਕਰਨ ਲਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1349,
      "hindi": "",
      "hindiTransliteration": "अपन राज देस का करा ॥",
      "sourceLineId": "138153",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
