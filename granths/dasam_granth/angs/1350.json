{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1350,
  "lineCount": 49,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1350_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਹੁਰਿ ਸੁਯੰਬਰ ਸੌ ਤਿਹ ਬਰਾ ॥੮॥",
      "transliteration": "bahur suya(n)bar sau teh baraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਸੁਅੰਬਰ ਰਾਹੀਂ ਉਸ (ਪ੍ਰੀਤਮ) ਨੂੰ ਵਰ ਲਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "बहुरि सुयंबर सौ तिह बरा ॥८॥",
      "sourceLineId": "138154",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਸਤਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੭॥੭੦੫੧॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau sataanavo charitr samaapatam sat subham sat ||397||7051||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੯੭ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੯੭॥੭੦੫੧॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ सतानवो चरित्र समापतम सतु सुभम सतु ॥३९७॥७०५१॥अफजूँ॥",
      "sourceLineId": "138155",
      "sourceShabadId": "12745",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "138156",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਲਵਲ ਦੇਸ ਹੁਤਾ ਇਕ ਰਾਜਾ ॥",
      "transliteration": "palaval dhes hutaa ik raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਲਵਲ ਦੇਸ ਵਿਚ ਇਕ ਰਾਜਾ ਹੁੰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "पलवल देस हुता इक राजा ॥",
      "sourceLineId": "138157",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਹ ਸਮਾਨ ਬਿਧਿ ਅਵਰ ਨ ਸਾਜਾ ॥",
      "transliteration": "jeh samaan bidh avar na saajaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਵਿਧਾਤਾ ਨੇ ਕੋਈ ਹੋਰ ਨਹੀਂ ਸਾਜਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "जिह समान बिधि अवर न साजा ॥",
      "sourceLineId": "138158",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੜਿਤਾ ਦੇ ਤਿਹ ਨਾਰਿ ਭਨਿਜੈ ॥",
      "transliteration": "taRitaa dhe teh naar bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਤੜਿਤਾ ਦੇ (ਦੇਈ) ਉਸ ਦੀ ਇਸਤਰੀ ਦਸੀਂਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "तड़िता दे तिह नारि भनिजै ॥",
      "sourceLineId": "138159",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੰਦ੍ਰ ਸੂਰ ਜਿਹ ਸਮ ਨ ਕਹਿਜੈ ॥੧॥",
      "transliteration": "cha(n)dhr soor jeh sam na kahijai ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਸੂਰਜ ਅਤੇ ਚੰਦ੍ਰਮਾ ਵੀ ਨਹੀਂ ਕਿਹਾ ਜਾਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "चंद्र सूर जिह सम न कहिजै ॥१॥",
      "sourceLineId": "138160",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਲਿਕ੍ਰਿਤ ਦੇ ਤਿਹ ਸੁਤਾ ਬਖਨਿਯਤ ॥",
      "transliteration": "alikirat dhe teh sutaa bakhaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਪੁੱਤਰੀ ਦਾ ਨਾ ਅਲਿਕ੍ਰਿਤ ਦੇ (ਦੇਈ) ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "अलिकृत दे तिह सुता बखनियत ॥",
      "sourceLineId": "138161",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਮਿਤ ਰੂਪ ਵਾ ਕੇ ਪਹਿਚਨਿਯਤ ॥",
      "transliteration": "amit roop vaa ke pahichaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਰੂਪ ਬਹੁਤ ਅਧਿਕ ਸੁੰਦਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "अमित रूप वा के पहिचनियत ॥",
      "sourceLineId": "138162",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਿਹ ਠਾ ਇਕ ਸੌਦਾਗਰ ਆਯੋ ॥",
      "transliteration": "teh Thaa ik sauadhaagar aayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਥਾ ਤੇ ਇਕ ਸੌਦਾਗਰ ਆਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "तिह ठा इक सौदागर आयो ॥",
      "sourceLineId": "138163",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਹ ਸਮ ਬਿਧਿ ਦੂਜੋ ਨ ਬਨਾਯੋ ॥੨॥",
      "transliteration": "jeh sam bidh dhoojo na banaayo ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਵਿਧਾਤਾ ਨੇ ਦੂਜਾ ਨਹੀਂ ਬਣਾਇਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "जिह सम बिधि दूजो न बनायो ॥२॥",
      "sourceLineId": "138164",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਜ ਕੁਅਰਿ ਤਾ ਕੇ ਲਖਿ ਅੰਗਾ ॥",
      "transliteration": "raaj kuar taa ke lakh a(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜ ਕੁਮਾਰੀ ਉਸ ਦੇ ਸ਼ਰੀਰ ਨੂੰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "राज कुअरि ता के लखि अंगा ॥",
      "sourceLineId": "138165",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਨ ਕ੍ਰਮ ਬਚ ਰੀਝੀ ਸਰਬੰਗਾ ॥",
      "transliteration": "man kram bach reejhee saraba(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਨ, ਬਚ ਅਤੇ ਕਰਮ ਕਰ ਕੇ (ਉਸ) ਉਤੇ ਸਭ ਤਰ੍ਰਹਾ ਨਾਲ ਰੀਝ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "मन क्रम बच रीझी सरबंगा ॥",
      "sourceLineId": "138166",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਲੀਅਸਿ ਬੁਲਾਇ ॥",
      "transliteration": "paThai sahacharee leeas bulai ||",
      "translation": "",
      "punjabiViakhya": "(ਆਪਣੀ) ਸਖੀ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी लीअसि बुलाइ ॥",
      "sourceLineId": "138167",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਹਤ ਭਈ ਬਤਿਯਾ ਮੁਸਕਾਇ ॥੩॥",
      "transliteration": "kahat bhiee batiyaa musakai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਸ ਕੇ ਗੱਲਾ ਕਰਨ ਲਗੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "कहत भई बतिया मुसकाइ ॥३॥",
      "sourceLineId": "138168",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਧਿਕ ਭੋਗ ਤਿਹ ਸਾਥ ਮਚਾਯੋ ॥",
      "transliteration": "adhik bhog teh saath machaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ (ਉਸ ਨੇ) ਬਹੁਤ ਰਤੀ-ਕ੍ਰੀੜਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "अधिक भोग तिह साथ मचायो ॥",
      "sourceLineId": "138169",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭਾਤ ਭਾਤਿ ਰਸ ਕੇਲ ਕਮਾਯੋ ॥",
      "transliteration": "bhaat bhaat ras kel kamaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੀ ਕੇਲਿ ਰਚਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "भात भाति रस केल कमायो ॥",
      "sourceLineId": "138170",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚੁੰਬਨ ਔਰ ਅਲਿੰਗਨ ਲੀਨੋ ॥",
      "transliteration": "chu(n)ban aauar ali(n)gan leeno ||",
      "translation": "",
      "punjabiViakhya": "ਚੁੰਬਨ ਅਤੇ ਆਲਿੰਗਨ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "चुँबन और अलिंगन लीनो ॥",
      "sourceLineId": "138171",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਾਤਿ ਅਨਿਕ ਤ੍ਰਿਯ ਕੋ ਸੁਖ ਦੀਨੋ ॥੪॥",
      "transliteration": "bhaat anik tiray ko sukh dheeno ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਇਸਤਰੀ ਨੂੰ ਸੁਖ ਦਿੱਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "भाति अनिक तृय को सुख दीनो ॥४॥",
      "sourceLineId": "138172",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਬ ਤ੍ਰਿਯ ਚਿਤ ਤਵਨੈ ਹਰ ਲਿਯੋ ॥",
      "transliteration": "jab tiray chit tavanai har liyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਉਸ (ਸੌਦਾਗਰ) ਨੇ ਇਸਤਰੀ ਦਾ ਚਿਤ ਚੁਰਾ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "जब तृय चित तवनै हर लियो ॥",
      "sourceLineId": "138173",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਬ ਅਸ ਚਰਿਤ ਚੰਚਲਾ ਕਿਯੋ ॥",
      "transliteration": "tab as charit cha(n)chalaa kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਸਤਰੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਚਰਿਤ੍ਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "तब अस चरित चंचला कियो ॥",
      "sourceLineId": "138174",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾਤ ਮਾਤ ਦੋਇ ਬੋਲਿ ਪਠਾਏ ॥",
      "transliteration": "taat maat dhoi bol paThaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ (ਆਪਣੇ) ਮਾਤਾ ਪਿਤਾ ਦੋਹਾ ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "तात मात दोइ बोलि पठाए ॥",
      "sourceLineId": "138175",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਤਿਨ ਸੌ ਬਚਨ ਸੁਨਾਏ ॥੫॥",
      "transliteration": "eeh bidh tin sau bachan sunaae ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਬਚਨ ਕਹੇ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "इह बिधि तिन सौ बचन सुनाए ॥५॥",
      "sourceLineId": "138176",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮੈ ਅਬ ਲਗਿ ਨਹਿ ਤੀਰਥ ਅਨ੍ਰਹਾਈ ॥",
      "transliteration": "mai ab lag neh teerath anrahaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਹੁਣ ਤਕ ਤੀਰਥ ਇਸ਼ਨਾਨ ਨਹੀਂ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "मै अब लगि नहि तीरथ अन्रहाई ॥",
      "sourceLineId": "138177",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਬ ਤੀਰਥ ਕਰਿ ਹੌ ਤਹ ਜਾਈ ॥",
      "transliteration": "ab teerath kar hau teh jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੈਂ ਤੀਰਥਾ ਉਤੇ ਜਾ ਕੇ (ਇਸ਼ਨਾਨ) ਕਰਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "अब तीरथ करि हौ तह जाई ॥",
      "sourceLineId": "138178",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੌ ਆਇਸ ਤੁਮ ਤੇ ਮੈ ਪਾਊ ॥",
      "transliteration": "jau aais tum te mai paauoo ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਮੈਂ ਤੁਹਾਡੇ ਤੋਂ ਆਗਿਆ ਪ੍ਰਾਪਤ ਕਰ ਲਵਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "जौ आइस तुम ते मै पाऊ ॥",
      "sourceLineId": "138179",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੀਰਥ ਨ੍ਰਹਾਇ ਸਕਲ ਫਿਰਿ ਆਊ ॥੬॥",
      "transliteration": "teerath nrahai sakal fir aauoo ||6||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਾਰਿਆਂ ਤੀਰਥਾ ਉਤੇ ਇਸ਼ਨਾਨ ਕਰ ਕੇ ਪਰਤ ਆਵਾਗੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "तीरथ न्रहाइ सकल फिरि आऊ ॥६॥",
      "sourceLineId": "138180",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪਤਿ ਕੁਰੂਪ ਹਮ ਕਹ ਤੁਮ ਦਿਯੋ ॥",
      "transliteration": "pat kuroop ham keh tum dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਮੈਨੂੰ ਕੁਰੂਪ ਪਤੀ ਦਿੱਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "पति कुरूप हम कह तुम दियो ॥",
      "sourceLineId": "138181",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾ ਤੇ ਮੈ ਉਪਾਇ ਇਮਿ ਕਿਯੋ ॥",
      "transliteration": "taa te mai upai im kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ ਮੈਂ ਇਹ ਉਪਾ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "ता ते मै उपाइ इमि कियो ॥",
      "sourceLineId": "138182",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੌ ਮੁਰ ਪਤਿ ਸਭ ਤੀਰਥ ਅਨ੍ਰਹੈ ਹੈ ॥",
      "transliteration": "jau mur pat sabh teerath anrahai hai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਮੇਰਾ ਪਤੀ ਸਾਰਿਆਂ ਤੀਰਥਾ ਉਤੇ ਇਸ਼ਨਾਨ ਕਰੇਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "जौ मुर पति सभ तीरथ अन्रहै है ॥",
      "sourceLineId": "138183",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੁੰਦਰ ਅਧਿਕ ਕਾਇ ਹ੍ਵੈ ਜੈ ਹੈ ॥੭॥",
      "transliteration": "su(n)dhar adhik kai havai jai hai ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਦੀ ਕਾਇਆ ਅਧਿਕ ਸੁੰਦਰ ਹੋ ਜਾਵੇਗੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "सुँदर अधिक काइ ह्वै जै है ॥७॥",
      "sourceLineId": "138184",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਲੈ ਆਗ੍ਯਾ ਪਤਿ ਸਹਿਤ ਸਿਧਾਈ ॥",
      "transliteration": "lai aagayaa pat sahit sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਰਾਜ ਕੁਮਾਰੀ) ਆਗਿਆ ਲੈ ਕੇ ਪਤੀ ਨਾਲ ਚਲੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "लै आग्या पति सहित सिधाई ॥",
      "sourceLineId": "138185",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਾਤ ਭਾਤ ਤੀਰਥਨ ਅਨ੍ਰਹਾਈ ॥",
      "transliteration": "bhaat bhaat teerathan anrahaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਦੇ ਤੀਰਥਾ ਉਤੇ ਇਸ਼ਨਾਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "भात भात तीरथन अन्रहाई ॥",
      "sourceLineId": "138186",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਘਾਤ ਪਾਇ ਕਰਿ ਨਾਥ ਸੰਘਾਰਾ ॥",
      "transliteration": "ghaat pai kar naath sa(n)ghaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਮੌਕਾ ਤਾੜ ਕੇ ਪਤੀ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "घात पाइ करि नाथ संघारा ॥",
      "sourceLineId": "138187",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਾ ਕੀ ਠੌਰ ਮਿਤ੍ਰ ਬੈਠਾਰਾ ॥੮॥",
      "transliteration": "taa kee Thauar mitr baiThaaraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਥਾ (ਆਪਣੇ) ਯਾਰ ਨੂੰ ਬਿਠਾ ਲਿਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "ता की ठौर मित्र बैठारा ॥८॥",
      "sourceLineId": "138188",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਪਨੇ ਧਾਮ ਬਹੁਰਿ ਫਿਰਿ ਆਈ ॥",
      "transliteration": "apane dhaam bahur fir aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਆਪਣੇ ਘਰ ਪਰਤ ਆਈ",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "अपने धाम बहुरि फिरि आई ॥",
      "sourceLineId": "138189",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਾਤ ਪਿਤਹਿ ਇਹ ਭਾਤਿ ਜਤਾਈ ॥",
      "transliteration": "maat piteh ieh bhaat jataiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਾਤਾ ਪਿਤਾ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "मात पितहि इह भाति जताई ॥",
      "sourceLineId": "138190",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੁਰ ਪਤਿ ਅਤਿ ਤੀਰਥਨ ਅਨ੍ਰਹਯੋ ॥",
      "transliteration": "mur pat at teerathan anrahayo ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਪਤੀ ਨੇ ਅਨੇਕ ਤੀਰਥਾ ਉਤੇ ਇਸ਼ਨਾਨ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "मुर पति अति तीरथन अन्रहयो ॥",
      "sourceLineId": "138191",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਾ ਤੇ ਬਪੁ ਸੁੰਦਰ ਹ੍ਵੈ ਗਯੋ ॥੯॥",
      "transliteration": "taa te bap su(n)dhar havai gayo ||9||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ (ਉਸ ਦਾ) ਸ਼ਰੀਰ ਸੁੰਦਰ ਹੋ ਗਿਆ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "ता ते बपु सुँदर ह्वै गयो ॥९॥",
      "sourceLineId": "138192",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਹਮ ਤੀਰਥ ਅਨ੍ਰਹਾਏ ॥",
      "transliteration": "bhaat bhaat ham teerath anrahaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਾ ਅਨੇਕ ਤੀਰਥਾ ਉਤੇ ਇਸ਼ਨਾਨ ਕੀਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "भाति भाति हम तीरथ अन्रहाए ॥",
      "sourceLineId": "138193",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਨਿਕ ਬਿਧਵ ਤਨ ਬਿਪ੍ਰ ਜਿਵਾਏ ॥",
      "transliteration": "anik bidhav tan bipr jivaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਬ੍ਰਾਹਮਣਾ ਨੂੰ ਭੋਜਨ ਕਰਵਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "अनिक बिधव तन बिप्र जिवाए ॥",
      "sourceLineId": "138194",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਾ ਤੇ ਦੈਵ ਆਪੁ ਬਰ ਦਿਯੋ ॥",
      "transliteration": "taa te dhaiv aap bar dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ ਦੈਵ ਨੇ ਆਪ ਵਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "ता ते दैव आपु बर दियो ॥",
      "sourceLineId": "138195",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਮ ਪਤਿ ਕੋ ਸੁੰਦਰ ਬਪੁ ਕਿਯੋ ॥੧੦॥",
      "transliteration": "mam pat ko su(n)dhar bap kiyo ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਪਤੀ ਦਾ ਸ਼ਰੀਰ ਸੁੰਦਰ ਕਰ ਦਿੱਤਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "मम पति को सुँदर बपु कियो ॥१०॥",
      "sourceLineId": "138196",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਯਹ ਕਾਹੂ ਨਰ ਬਾਤ ਨ ਪਾਈ ॥",
      "transliteration": "yeh kaahoo nar baat na paiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਬੰਦੇ ਨੇ ਇਸ ਗੱਲ (ਦਾ ਭੇਦ) ਨਹੀਂ ਪਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "यह काहू नर बात न पाई ॥",
      "sourceLineId": "138197",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਹਾ ਕਰਮ ਕਰਿ ਕੈ ਤ੍ਰਿਯ ਆਈ ॥",
      "transliteration": "kahaa karam kar kai tiray aaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸਤਰੀ ਕੀ ਕਰਮ ਕਰ ਕੇ ਆਈ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "कहा करम करि कै तृय आई ॥",
      "sourceLineId": "138198",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤੀਰਥ ਮਹਾਤਮ ਸਭਹੂੰ ਜਾਨ੍ਯੋ ॥",
      "transliteration": "teerath mahaatam sabhahoo(n) jaanayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਨੇ (ਇਸ ਪਰਿਵਰਤਨ ਨੂੰ) ਤੀਰਥ ਦਾ ਮਹਾਤਮ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "तीरथ महातम सभहूँ जान्यो ॥",
      "sourceLineId": "138199",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨੂੰ ਪਛਾਨ੍ਯੋ ॥੧੧॥",
      "transliteration": "bhedh abhedh na kinoo(n) pachhaanayo ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੇਦ ਅਭੇਦ ਨੂੰ ਕਿਸੇ ਨੇ ਨਾ ਸਮਝਿਆ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1350,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न किनूँ पछान्यो ॥११॥",
      "sourceLineId": "138200",
      "sourceShabadId": "12746",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1350_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਅਠਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੮॥੭੦੬੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau aThaanavo charitr samaapatam sat subham sat ||398||7062||afajoo(n)||",
      "translation": "",
