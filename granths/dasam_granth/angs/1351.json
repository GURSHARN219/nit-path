{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1351,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1351_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਘਾਟਮ ਪੁਰ ਇਕ ਭੂਪ ਭਨਿਜੈ ॥",
      "transliteration": "ghaaTam pur ik bhoop bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਘਾਟਮ ਪੁਰ ਵਿਚ ਇਕ ਰਾਜਾ ਦਸੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "घाटम पुर इक भूप भनिजै ॥",
      "sourceLineId": "138203",
      "sourceShabadId": "12747",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਰਿ ਅਲੰਕ੍ਰਿਤ ਦੇਇ ਕਹਿਜੈ ॥",
      "transliteration": "naar ala(n)kirat dhei kahijai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੀ) ਇਸਤਰੀ ਨੂੰ ਅਲੰਕ੍ਰਿਤ ਦੇਈ ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "नारि अलंकृत देइ कहिजै ॥",
      "sourceLineId": "138204",
      "sourceShabadId": "12747",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੁਤਾ ਸੁ ਭੂਖਨ ਦੇ ਘਰ ਤਾ ਕੇ ॥",
      "transliteration": "sutaa su bhookhan dhe ghar taa ke ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਘਰ ਸੁਭੂਖਨ ਦੇ (ਦੇਈ) ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "सुता सु भूखन दे घर ता के ॥",
      "sourceLineId": "138205",
      "sourceShabadId": "12747",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਰੀ ਨਾਗਰੀ ਤੁਲਿ ਨ ਵਾ ਕੇ ॥੧॥",
      "transliteration": "naree naagaree tul na vaa ke ||1||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਇਤਨੀ ਸੁੰਦਰ ਸੀ ਕਿ) ਉਸ ਦੇ ਸਮਾਨ (ਕੋਈ) ਨਰੀ ਜਾ ਨਾਗਨੀ ਨਹੀਂ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "नरी नागरी तुलि न वा के ॥१॥",
      "sourceLineId": "138206",
      "sourceShabadId": "12747",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਤਿ ਕੁਰੂਪ ਤਿਹ ਨਾਥ ਪਛਨਿਯਤ ॥",
      "transliteration": "at kuroop teh naath pachhaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਪਤੀ ਬਹੁਤ ਕੁਰੂਪ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "अति कुरूप तिह नाथ पछनियत ॥",
      "sourceLineId": "138207",
      "sourceShabadId": "12747",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਤਿ ਸੁੰਦਰਿ ਜਿਹ ਨਾਰਿ ਬਖਨਿਯਤ ॥",
      "transliteration": "at su(n)dhar jeh naar bakhaniyat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਦੀ ਨਾਰੀ ਬਹੁਤ ਸੁੰਦਰ ਦਸੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "अति सुँदरि जिह नारि बखनियत ॥",
      "sourceLineId": "138208",
      "sourceShabadId": "12747",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁੰਦਰ ਅਵਰ ਹੁਤੋ ਤਹ ਛਤ੍ਰੀ ॥",
      "transliteration": "su(n)dhar avar huto teh chhatree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਹੋਰ ਸੁੰਦਰ ਛਤ੍ਰੀ ਹੁੰਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "सुँदर अवर हुतो तह छत्री ॥",
      "sourceLineId": "138209",
      "sourceShabadId": "12747",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਧਰਤ੍ਰੀ ॥੨॥",
      "transliteration": "roopavaan gunavaan dharatree ||2||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਬਹੁਤ ਰੂਪਵਾਨ, ਗੁਣਵਾਨ ਅਤੇ ਅਸਤ੍ਰ ਧਾਰਨ ਕਰਨ ਵਾਲਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "रूपवान गुनवान धरत्री ॥२॥",
      "sourceLineId": "138210",
      "sourceShabadId": "12747",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "138211",
      "sourceShabadId": "12748",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਬ ਮੁਲਤਾਨੀ ਰਾਇ ਕੁਅਰਿ ਲਖਿ ਪਾਇਯੋ ॥",
      "transliteration": "jab mulataanee rai kuar lakh paiyo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਮੁਲਤਾਨੀ ਰਾਇ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "जब मुलतानी राइ कुअरि लखि पाइयो ॥",
      "sourceLineId": "138212",
      "sourceShabadId": "12748",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਿਜੁ ਨਾਇਕ ਕਹ ਚਿਤ ਤੇ ਕੁਅਰਿ ਭੁਲਾਇਯੋ ॥",
      "transliteration": "nij naik keh chit te kuar bhulaiyo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਨੇ ਆਪਣੇ ਪਤੀ ਨੂੰ ਮਨੋ ਭੁਲਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "निजु नाइक कह चित ते कुअरि भुलाइयो ॥",
      "sourceLineId": "138213",
      "sourceShabadId": "12748",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਨਿਜੁ ਗ੍ਰਿਹ ਲਿਯੋ ਬੁਲਾਇ ਕੈ ॥",
      "transliteration": "paThai sahacharee nij gireh liyo bulai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਖੀ ਭੇਜ ਕੇ ਉਸ (ਮੁਲਤਾਨੀ ਰਾਇ) ਨੂੰ ਘਰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी निजु गृह लियो बुलाइ कै ॥",
      "sourceLineId": "138214",
      "sourceShabadId": "12748",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹੋ ਬਚਨ ਕਹੇ ਪੁਨਿ ਭਾਗਿ ਅਫੀਮ ਚੜਾਇ ਕੈ ॥੩॥",
      "transliteration": "ho bachan kahe pun bhaag afeem chaRai kai ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਫ਼ੀਮ ਅਤੇ ਭੰਗ ਚੜ੍ਰਹਾ ਕੇ ਫਿਰ ਬਚਨ ਕਹੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "हो बचन कहे पुनि भागि अफीम चड़ाइ कै ॥३॥",
      "sourceLineId": "138215",
      "sourceShabadId": "12748",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "138216",
      "sourceShabadId": "12749",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਬ ਲਪਟਹੁ ਮੁਹਿ ਆਨਿ ਪ੍ਯਾਰੇ ॥",
      "transliteration": "ab lapaTahu muh aan payaare ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪ੍ਰੀਤਮ! ਹੁਣ ਮੇਰੇ ਨਾਲ ਆ ਕੇ ਲਿਪਟ ਜਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "अब लपटहु मुहि आनि प्यारे ॥",
      "sourceLineId": "138217",
      "sourceShabadId": "12749",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਮ ਰੀਝੀ ਲਖਿ ਨੈਨ ਤਿਹਾਰੇ ॥",
      "transliteration": "ham reejhee lakh nain tihaare ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੁਹਾਡੇ ਨੈਣ ਵੇਖ ਕੇ ਰੀਝ ਗਈ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "हम रीझी लखि नैन तिहारे ॥",
      "sourceLineId": "138218",
      "sourceShabadId": "12749",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਹਿ ਨਾਹਿ ਤਿਨ ਦੁਬਿਰ ਬਖਾਨੀ ॥",
      "transliteration": "naeh naeh tin dhubir bakhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਦੋ ਵਾਰ 'ਨਾਹ ਨਾਹ' ਕਹੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "नाहि नाहि तिन दुबिर बखानी ॥",
      "sourceLineId": "138219",
      "sourceShabadId": "12749",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਖਰ ਕੁਅਰਿ ਕਹੀ ਸੋ ਮਾਨੀ ॥੪॥",
      "transliteration": "aakhar kuar kahee so maanee ||4||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਅੰਤ ਵਿਚ ਰਾਜ ਕੁਮਾਰੀ ਨੇ ਜੋ ਕਿਹਾ, ਉਹ ਮੰਨ ਲਿਆ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "आखर कुअरि कही सो मानी ॥४॥",
      "sourceLineId": "138220",
      "sourceShabadId": "12749",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "138221",
      "sourceShabadId": "12750",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਕੀ ਕੈਫ ਦਿਵਾਨੇ ਪੀ ਭਏ ॥",
      "transliteration": "bhaat bhaat kee kaif dhivaane pee bhe ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਦੋਵੇਾਂ) ਭਾਤ ਭਾਤ ਦੀ ਸ਼ਰਾਬ ਪੀ ਪੀ ਕੇ ਦੀਵਾਨੇ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "भाति भाति की कैफ दिवाने पी भए ॥",
      "sourceLineId": "138222",
      "sourceShabadId": "12750",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਅਬਲਾ ਕੇ ਆਸਨ ਲੇਤ ਭੇ ॥",
      "transliteration": "bhaat bhaat abalaa ke aasan let bhe ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਪ੍ਰੇਮੀ) ਭਾਤ ਭਾਤ ਦੇ ਅਬਲਾ ਦੇ ਆਸਣ ਲੈਣ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "भाति भाति अबला के आसन लेत भे ॥",
      "sourceLineId": "138223",
      "sourceShabadId": "12750",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਮਿਤ ਭੋਗ ਤ੍ਰਿਯ ਪਾਇ ਰਹੀ ਉਰਝਾਇ ਕੈ ॥",
      "transliteration": "amit bhog tiray pai rahee urajhai kai ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਮੋਹਿਤ ਹੋ ਕੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੀ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "अमित भोग तृय पाइ रही उरझाइ कै ॥",
      "sourceLineId": "138224",
      "sourceShabadId": "12750",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹੋ ਨਿਰਖਿ ਸਜਨ ਕੇ ਨੈਨਨ ਗਈ ਬਿਕਾਇ ਕੈ ॥੫॥",
      "transliteration": "ho nirakh sajan ke nainan giee bikai kai ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੱਜਨ ਦੇ ਨੈਣ ਵੇਖ ਕੇ ਵਿਕ ਗਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "हो निरखि सजन के नैनन गई बिकाइ कै ॥५॥",
      "sourceLineId": "138225",
      "sourceShabadId": "12750",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "138226",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਾ ਸੌ ਰਤਿ ਪਾਇ ॥",
      "transliteration": "bhaat bhaat taa sau rat pai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਭਾਤ ਭਾਤ ਦੀ ਰਤੀ-ਲੀਲ੍ਰਹਾ ਰਚਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "भाति भाति ता सौ रति पाइ ॥",
      "sourceLineId": "138227",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਸਨ ਸਾਥ ਗਈ ਲਪਟਾਇ ॥",
      "transliteration": "aasan saath giee lapaTai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਦੇ) ਆਸਣ ਨਾਲ ਲਿਪਟ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "आसन साथ गई लपटाइ ॥",
      "sourceLineId": "138228",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਸਿ ਗਯੋ ਮੀਤ ਨ ਛੋਰਾ ਜਾਈ ॥",
      "transliteration": "ras gayo meet na chhoraa jaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮਿਤਰ ਨਾਲ (ਇਤਨੀ) ਮਗਨ ਹੋ ਗਈ ਕਿ ਛਡਿਆ ਨਹੀਂ ਜਾ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "रसि गयो मीत न छोरा जाई ॥",
      "sourceLineId": "138229",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਾਤ ਭਾਖਿ ਤਿਹ ਘਾਤ ਬਨਾਈ ॥੬॥",
      "transliteration": "baat bhaakh teh ghaat banaiee ||6||",
      "translation": "",
      "punjabiViakhya": "ਮੌਕਾ ਤਾੜ ਕੇ ਉਸ ਨੇ ਗੱਲ ਕਹੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "बात भाखि तिह घात बनाई ॥६॥",
      "sourceLineId": "138230",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਾਜਨ ਆਜੁ ਤੁਝੈ ਮੈ ਬਰਿ ਹੌ ॥",
      "transliteration": "saajan aaj tujhai mai bar hau ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸਾਜਨ! ਅਜ ਮੈਂ ਤੇਰੇ ਨਾਲ ਵਿਆਹ ਕਰਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "साजन आजु तुझै मै बरि हौ ॥",
      "sourceLineId": "138231",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਿਜੁ ਪਤਿ ਕੋ ਨਿਜੁ ਕਰ ਬਧ ਕਰਿ ਹੌ ॥",
      "transliteration": "nij pat ko nij kar badh kar hau ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਪਤੀ ਦਾ ਆਪਣੇ ਹੱਥ ਨਾਲ ਬਧ ਕਰਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "निजु पति को निजु कर बध करि हौ ॥",
      "sourceLineId": "138232",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਪਨ ਸਾਥ ਪ੍ਰਗਟ ਤੁਹਿ ਲਿਐਹੌ ॥",
      "transliteration": "aapan saath pragaT tuh liaaihau ||",
      "translation": "",
      "punjabiViakhya": "(ਹੁਣ) ਮੈਂ ਤੁਹਾਨੂੰ ਪ੍ਰਗਟ ਤੌਰ ਤੇ ਆਪਣੇ ਨਾਲ ਲਿਆਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "आपन साथ प्रगट तुहि लिऐहौ ॥",
      "sourceLineId": "138233",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਤੁਹਿ ਲਖਤ ਹੰਢੈਹੌ ॥੭॥",
      "transliteration": "maat pitaa tuh lakhat ha(n)ddaihau ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਾਤਾ ਪਿਤਾ ਦੇ ਵੇਖਦਿਆਂ ਤੇਰੇ ਨਾਲ ਕਾਮ-ਕੇਲਿ ਕਰਾਗੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "मात पिता तुहि लखत हंढैहौ ॥७॥",
      "sourceLineId": "138234",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਿਜੁ ਪਤਿ ਲੈ ਸਿਵ ਭਵਨ ਸਿਧਾਈ ॥",
      "transliteration": "nij pat lai siv bhavan sidhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਆਪਣੇ ਪਤੀ ਨੂੰ ਲੈ ਕੇ ਸ਼ਿਵ-ਮੰਦਿਰ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "निजु पति लै सिव भवन सिधाई ॥",
      "sourceLineId": "138235",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਾਟਾ ਮੂੰਡ ਤਹਾ ਤਿਹ ਜਾਈ ॥",
      "transliteration": "kaaTaa moo(n)dd tahaa teh jaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਜਾ ਕੇ ਉਸ ਦਾ ਸਿਰ ਕਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "काटा मूँड तहा तिह जाई ॥",
      "sourceLineId": "138236",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲੋਗਨ ਕਹਿ ਸਿਵ ਨਾਮ ਸੁਨਾਯੋ ॥",
      "transliteration": "logan keh siv naam sunaayo ||",
      "translation": "",
      "punjabiViakhya": "ਲੋਕਾ ਨੂੰ ਸ਼ਿਵ ਦਾ ਨਾ ਕਹਿ ਕੇ ਸੁਣਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "लोगन कहि सिव नाम सुनायो ॥",
      "sourceLineId": "138237",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰੂਪ ਹੇਤੁ ਪਤਿ ਸੀਸ ਚੜਾਯੋ ॥੮॥",
      "transliteration": "roop het pat sees chaRaayo ||8||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਪਤੀ ਨੇ ਸੁੰਦਰਤਾ ਪ੍ਰਾਪਤ ਕਰਨ ਲਈ ਸੀਸ ਭੇਟ ਕੀਤਾ ਹੈ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "रूप हेतु पति सीस चड़ायो ॥८॥",
      "sourceLineId": "138238",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪੁਨਿ ਸਿਵ ਅਧਿਕ ਕ੍ਰਿਪਾ ਕਹ ਕਿਯੋ ॥",
      "transliteration": "pun siv adhik kirapaa keh kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸ਼ਿਵ ਨੇ ਬਹੁਤ ਕ੍ਰਿਪਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "पुनि सिव अधिक कृपा कह कियो ॥",
      "sourceLineId": "138239",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੁੰਦਰ ਮੋਰ ਪਤਿਹਿ ਕਰ ਦਿਯੋ ॥",
      "transliteration": "su(n)dhar mor pateh kar dhiyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਪਤੀ ਨੂੰ ਸੁੰਦਰ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "सुँदर मोर पतिहि कर दियो ॥",
      "sourceLineId": "138240",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕੌਤਕ ਲਖਾ ਕਹਾ ਤਿਨ ਕਰਾ ॥",
      "transliteration": "kauatak lakhaa kahaa tin karaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਜੋ ਕਿਹਾ ਸੀ, (ਸ਼ਿਵ ਨੇ) ਉਹੋ ਕੌਤਕ ਕਰ ਵਿਖਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "कौतक लखा कहा तिन करा ॥",
      "sourceLineId": "138241",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਿਵ ਪ੍ਰਤਾਪ ਹਮ ਆਜੁ ਬਿਚਰਾ ॥੯॥",
      "transliteration": "siv prataap ham aaj bicharaa ||9||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਿਵ ਦਾ ਪ੍ਰਤਾਪ ਮੈਂ ਅਜ ਹੀ ਵਿਚਾਰਿਆ ਹੈ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "सिव प्रताप हम आजु बिचरा ॥९॥",
      "sourceLineId": "138242",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੇਹ ਮ੍ਰਿਤਕ ਪਤਿ ਦਈ ਦਬਾਈ ॥",
      "transliteration": "dheh mritak pat dhiee dhabaiee ||",
      "translation": "",
      "punjabiViakhya": "ਪਤੀ ਦੀ ਲੋਥ ਨੂੰ ਦਬਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "देह मृतक पति दई दबाई ॥",
      "sourceLineId": "138243",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਾ ਕੌ ਨਾਥ ਭਾਖਿ ਗ੍ਰਿਹ ਲ੍ਯਾਈ ॥",
      "transliteration": "taa kau naath bhaakh gireh layaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ (ਪ੍ਰੀਤਮ) ਨੂੰ ਪਤੀ ਕਹਿ ਕੇ ਘਰ ਲੈ ਆਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "ता कौ नाथ भाखि गृह ल्याई ॥",
      "sourceLineId": "138244",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੇਦ ਅਭੇਦ ਨ ਕਿਨਹੂੰ ਪਾਯੋ ॥",
      "transliteration": "bhedh abhedh na kinahoo(n) paayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਨੇ ਵੀ ਭੇਦ ਅਭੇਦ ਨਾ ਸਮਝਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "भेद अभेद न किनहूँ पायो ॥",
      "sourceLineId": "138245",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਿਨੁ ਪਾਨੀ ਹੀ ਮੂੰਡ ਮੁੰਡਾਯੋ ॥੧੦॥",
      "transliteration": "bin paanee hee moo(n)dd mu(n)ddaayo ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਿਨਾ ਪਾਣੀ ਦੇ ਸਿਰ ਮੁੰਨਵਾ ਲਿਆ। (ਭਾਵ-ਠਗੇ ਗਏ) ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "बिनु पानी ही मूँड मुँडायो ॥१०॥",
      "sourceLineId": "138246",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਤੀਨ ਸੌ ਨਿਨ੍ਰਯਾਨਵੋ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੩੯੯॥੭੦੭੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe teen sau ninrayaanavo charitr samaapatam sat subham sat ||399||7072||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੩੯੯ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੩੯੯॥੭੦੭੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे तीन सौ निन्रयानवो चरित्र समापतम सतु सुभम सतु ॥३९९॥७०७२॥अफजूँ॥",
      "sourceLineId": "138247",
      "sourceShabadId": "12751",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "138248",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੂਰਜ ਕਿਰਨਿ ਇਕ ਭੂਪ ਭਨਿਜੈ ॥",
      "transliteration": "sooraj kiran ik bhoop bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਜ ਕਿਰਨ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਬਖਾਨਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "सूरज किरनि इक भूप भनिजै ॥",
      "sourceLineId": "138249",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1351_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚੰਦ ਕਿਰਨ ਪੁਰ ਨਗਰ ਕਹਿਜੈ ॥",
      "transliteration": "cha(n)dh kiran pur nagar kahijai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦੇ) ਨਗਰ ਨੂੰ ਚੰਦ ਕਿਰਨ ਪੁਰ ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": "चंद किरन पुर नगर कहिजै ॥",
      "sourceLineId": "138250",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
