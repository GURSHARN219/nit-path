{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1352,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1352_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਹਾ ਕੁਅਰਿ ਤਿਹ ਧਾਮ ਦੁਲਾਰੀ ॥",
      "transliteration": "mahaa kuar teh dhaam dhulaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਮਹਾ ਕੁਮਾਰੀ ਨਾ ਦੀ ਪੁੱਤਰੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "महा कुअरि तिह धाम दुलारी ॥",
      "sourceLineId": "138251",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਹ ਸਮਾਨ ਬਿਧਿ ਕਹੂੰ ਨ ਸਵਾਰੀ ॥੧॥",
      "transliteration": "jeh samaan bidh kahoo(n) na savaaree ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਵਿਧਾਤਾ ਨੇ ਕਿਸੇ ਨੂੰ ਨਹੀਂ ਬਣਾਇਆ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "जिह समान बिधि कहूँ न सवारी ॥१॥",
      "sourceLineId": "138252",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਹਿਕ ਸਾਹ ਕੋ ਪੂਤ ਸੁਜਾਨਾ ॥",
      "transliteration": "tahik saeh ko poot sujaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਇਕ ਸ਼ਾਹ ਦਾ ਸੁਜਾਨ ਪੁੱਤਰ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "तहिक साह को पूत सुजाना ॥",
      "sourceLineId": "138253",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੰਦ੍ਰ ਸੈਨ ਨਾਮਾ ਬਲਵਾਨਾ ॥",
      "transliteration": "cha(n)dhr sain naamaa balavaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਨਾ ਚੰਦ੍ਰ ਸੈਨ ਸੀ ਅਤੇ (ਉਹ) ਬਹੁਤ ਬਲਵਾਨ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "चंद्र सैन नामा बलवाना ॥",
      "sourceLineId": "138254",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਹਾ ਕੁਅਰਿ ਵਾ ਕੀ ਛਬਿ ਲਹੀ ॥",
      "transliteration": "mahaa kuar vaa kee chhab lahee ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕੁਮਾਰੀ ਨੇ ਉਸ ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "महा कुअरि वा की छबि लही ॥",
      "sourceLineId": "138255",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਨ ਕ੍ਰਮ ਬਚਨ ਥਕਿਤ ਹ੍ਵੈ ਰਹੀ ॥੨॥",
      "transliteration": "man kram bachan thakit havai rahee ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਨ, ਬਚਨ ਤੇ ਕਰਮ ਕਰ ਕੇ ਸ਼ਿਥਲ ਹੋ ਗਈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "मन क्रम बचन थकित ह्वै रही ॥२॥",
      "sourceLineId": "138256",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਠੈ ਸਹਚਰੀ ਲਿਯੋ ਬੁਲਾਇ ॥",
      "transliteration": "paThai sahacharee liyo bulai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦਾਸੀ ਭੇਜ ਕੇ ਉਸ ਨੂੰ ਬੁਲਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "पठै सहचरी लियो बुलाइ ॥",
      "sourceLineId": "138257",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪੋਸਤ ਭਾਗ ਅਫੀਮ ਮੰਗਾਇ ॥",
      "transliteration": "posat bhaag afeem ma(n)gai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪੋਸਤ, ਭੰਗ ਤੇ ਅਫ਼ੀਮ ਮੰਗਵਾ ਲਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "पोसत भाग अफीम मंगाइ ॥",
      "sourceLineId": "138258",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਤਾਹਿ ਪਿਵਾਯੋ ॥",
      "transliteration": "bhaat bhaat tan taeh pivaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ ਉਸ ਨੂੰ ਪਿਲਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन ताहि पिवायो ॥",
      "sourceLineId": "138259",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਧਿਕ ਮਤ ਕਰਿ ਗਰੈ ਲਗਾਯੋ ॥੩॥",
      "transliteration": "adhik mat kar garai lagaayo ||3||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਮਸਤ ਕਰ ਕੇ ਗਲੇ ਨਾਲ ਲਗਾ ਲਿਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "अधिक मत करि गरै लगायो ॥३॥",
      "sourceLineId": "138260",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਤ ਕਿਯਾ ਮਦ ਸਾਥ ਪ੍ਯਾਰੋ ॥",
      "transliteration": "mat kiyaa madh saath payaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਪਿਆਰੇ ਨੂੰ ਸ਼ਰਾਬ ਨਾਲ ਮਸਤ ਕਰ ਲਿਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "मत किया मद साथ प्यारो ॥",
      "sourceLineId": "138261",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਬਹੂੰ ਕਰਤ ਨ ਉਰ ਸੌ ਨ੍ਯਾਰੋ ॥",
      "transliteration": "kabahoo(n) karat na ur sau nayaaro ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਨੂੰ ਕਦੀ ਵੀ ਛਾਤੀ ਨਾਲੋਂ ਵਖ ਨਹੀਂ ਕਰਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "कबहूँ करत न उर सौ न्यारो ॥",
      "sourceLineId": "138262",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਉਰ ਸੌ ਲਪਟਾਵੈ ॥",
      "transliteration": "bhaat bhaat ur sau lapaTaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਅਨੇਕ ਢੰਗਾ ਨਾਲ ਜਫ਼ੀਆਂ ਪਾਉਾਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "भाति भाति उर सौ लपटावै ॥",
      "sourceLineId": "138263",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੂੰਬਿ ਕਪੋਲ ਦੋਊ ਬਲਿ ਜਾਵੈ ॥੪॥",
      "transliteration": "choo(n)b kapol dhouoo bal jaavai ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਗਲ੍ਰਹਾ ਨੂੰ ਚੁੰਮ ਕੇ ਬਲਿਹਾਰ ਜਾਦੀ ਸੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "चूँबि कपोल दोऊ बलि जावै ॥४॥",
      "sourceLineId": "138264",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਸਿ ਗਯੋ ਮੀਤ ਨ ਛੋਰਾ ਜਾਇ ॥",
      "transliteration": "ras gayo meet na chhoraa jai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮਿਤਰ ਵੀ ਪੂਰੀ ਤਰ੍ਰਹਾ ਮਗਨ ਹੋ ਗਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "रसि गयो मीत न छोरा जाइ ॥",
      "sourceLineId": "138265",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਭੋਗਤ ਲਪਟਾਇ ॥",
      "transliteration": "bhaat bhaat bhogat lapaTai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਛਡਿਆ ਨਹੀਂ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "भाति भाति भोगत लपटाइ ॥",
      "sourceLineId": "138266",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੁੰਬਨ ਔਰ ਅਲਿੰਗਨ ਲੇਈ ॥",
      "transliteration": "chu(n)ban aauar ali(n)gan leiee ||",
      "translation": "",
      "punjabiViakhya": "(ਦੋਵੇਾਂ) ਭਾਤ ਭਾਤ ਨਾਲ ਲਿਪਟ ਕੇ ਭੋਗ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "चुँबन और अलिंगन लेई ॥",
      "sourceLineId": "138267",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਨਿਕ ਭਾਤਿ ਤਨ ਆਸਨ ਦੇਈ ॥੫॥",
      "transliteration": "anik bhaat tan aasan dheiee ||5||",
      "translation": "",
      "punjabiViakhya": "ਚੁੰਬਨ ਅਤੇ ਆਲਿੰਗਨ ਲੈਂਦੇ ਸਨ ਅਤੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ ਆਸਣ ਦਿੰਦੇ ਸਨ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "अनिक भाति तन आसन देई ॥५॥",
      "sourceLineId": "138268",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਸਿ ਗਈ ਤਾ ਕੌ ਤਜਾ ਨ ਜਾਇ ॥",
      "transliteration": "ras giee taa kau tajaa na jai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਉਸ ਵਿਚ ਇਤਨੀ ਲੀਨ ਹੋ ਗਈ ਕਿ ਛਡਿਆ ਨਹੀਂ ਸੀ ਜਾਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "रसि गई ता कौ तजा न जाइ ॥",
      "sourceLineId": "138269",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਾਤਿ ਅਨਿਕ ਲਪਟਤ ਸੁਖ ਪਾਇ ॥",
      "transliteration": "bhaat anik lapaTat sukh pai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਅਨੇਕ ਪ੍ਰਕਾਰ ਨਾਲ ਲਿਪਟ ਕੇ ਸੁਖ ਪ੍ਰਾਪਤ ਕਰ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "भाति अनिक लपटत सुख पाइ ॥",
      "sourceLineId": "138270",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਯਾ ਸੰਗ ਕਹਾ ਕਵਨ ਬਿਧਿ ਜਾਊਾਂ ॥",
      "transliteration": "yaa sa(n)g kahaa kavan bidh jaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜ ਕੁਮਾਰੀ ਸੋਚਣ ਲਗੀ ਕਿ) ਇਸ ਨਾਲ ਕਿਵੇਾਂ ਅਤੇ ਕਿਹੜੇ ਢੰਗ ਨਾਲ ਜਾਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "या संग कहा कवन बिधि जाऊाँ ॥",
      "sourceLineId": "138271",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਬ ਅਸ ਕਵਨ ਉਪਾਇ ਬਨਾਊਾਂ ॥੬॥",
      "transliteration": "ab as kavan upai banaauooaa(n) ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਸ ਲਈ ਹੁਣ ਕੀ ਉਪਾ ਕਰਾ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "अब अस कवन उपाइ बनाऊाँ ॥६॥",
      "sourceLineId": "138272",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾਨਿ ਬੂਝਿ ਇਕ ਦਿਜ ਕਹ ਮਾਰਿ ॥",
      "transliteration": "jaan boojh ik dhij keh maar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਜਾਣ ਬੁਝ ਕੇ ਇਕ ਬ੍ਰਾਹਮਣ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "जानि बूझि इक दिज कह मारि ॥",
      "sourceLineId": "138273",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭੂਪ ਭਏ ਇਮਿ ਕਹਾ ਸੁਧਾਰਿ ॥",
      "transliteration": "bhoop bhe im kahaa sudhaar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਪਾਸ ਜਾ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ, (ਮੈਂਥੋਂ ਬਹੁਤ ਵੱਡਾ ਪਾਪ ਹੋਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "भूप भए इमि कहा सुधारि ॥",
      "sourceLineId": "138274",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਬ ਮੈ ਜਾਇ ਕਰਵਤਹਿ ਲੈ ਹੌ ॥",
      "transliteration": "ab mai jai karavateh lai hau ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਲਈ) ਹੁਣ ਮੈਂ ਜਾ ਕੇ (ਕਾਸ਼ੀ ਵਿਚ) ਕਲਵਤ੍ਰ ਲਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "अब मै जाइ करवतहि लै हौ ॥",
      "sourceLineId": "138275",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਲਟਿ ਦੇਹ ਸੁਰਪੁਰਹਿ ਸਿਧੈ ਹੌ ॥੭॥",
      "transliteration": "palaT dheh surapureh sidhai hau ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ ਨਾਲ ਆਪਣੇ ਆਪ ਨੂੰ ਚਿਰਵਾ ਕੇ) ਦੇਹ ਪਲਟ ਕੇ ਸਵਰਗ ਵਿਚ ਜਾਵਾਗੀ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "पलटि देह सुरपुरहि सिधै हौ ॥७॥",
      "sourceLineId": "138276",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੋਰਿ ਰਹਾ ਪਿਤੁ ਏਕ ਨ ਮਾਨੀ ॥",
      "transliteration": "hor rahaa pit ek na maanee ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਤਾ ਰੋਕਦਾ ਰਿਹਾ, ਪਰ ਉਸ ਨੇ ਇਕ ਨਾ ਮੰਨੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "होरि रहा पितु एक न मानी ॥",
      "sourceLineId": "138277",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਾਨੀਹੂੰ ਪਾਇਨ ਲਪਟਾਨੀ ॥",
      "transliteration": "raaneehoo(n) pain lapaTaanee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਣੀ ਵੀ (ਉਸ ਦੇ) ਪੈਰਾ ਨਾਲ ਲਿਪਟਦੀ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "रानीहूँ पाइन लपटानी ॥",
      "sourceLineId": "138278",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੰਤ੍ਰ ਸਕਤਿ ਕਰਵਤਿ ਸਿਰ ਧਰਾ ॥",
      "transliteration": "ma(n)tr sakat karavat sir dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੰਤਰ ਦੀ ਸ਼ਕਤੀ ਨਾਲ ਉਸ ਨੇ ਕਲਵਤ੍ਰ ਨੂੰ ਸਿਰ ਉਤੇ ਧਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "मंत्र सकति करवति सिर धरा ॥",
      "sourceLineId": "138279",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਏਕ ਰੋਮ ਤਿਹ ਤਾਹਿ ਨ ਹਰਾ ॥੮॥",
      "transliteration": "ek rom teh taeh na haraa ||8||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਨਾਲ ਉਸ ਦਾ ਇਕ ਵਾਲ ਵੀ ਵਿੰਗਾ ਨਾ ਹੋਇਆ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "एक रोम तिह ताहि न हरा ॥८॥",
      "sourceLineId": "138280",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਭਨ ਲਹਾ ਕਰਵਤਿ ਇਹ ਲਿਯੋ ॥",
      "transliteration": "sabhan lahaa karavat ieh liyo ||",
      "translation": "",
      "punjabiViakhya": "(ਅਜਿਹਾ ਕੌਤਕ ਰਚਿਆ ਕਿ) ਸਭ ਨੇ ਵੇਖ ਲਿਆ ਕਿ ਇਸ ਨੂੰ ਕਲਵਤ੍ਰ ਲਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "सभन लहा करवति इह लियो ॥",
      "sourceLineId": "138281",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦ੍ਰਿਸਟਿ ਬੰਦ ਐਸਾ ਤਿਨ ਕਿਯੋ ॥",
      "transliteration": "dhirasaT ba(n)dh aaisaa tin kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ (ਉਸ ਨੇ) ਉਨ੍ਰਹਾ ਦੀ ਦ੍ਰਿਸ਼ਟੀ-ਬੰਦ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "दृसटि बंद ऐसा तिन कियो ॥",
      "sourceLineId": "138282",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਪਨ ਗਈ ਮਿਤ੍ਰ ਕੇ ਧਾਮਾ ॥",
      "transliteration": "aapan giee mitr ke dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਪ ਮਿਤਰ ਦੇ ਘਰ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "आपन गई मित्र के धामा ॥",
      "sourceLineId": "138283",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭੇਦ ਨ ਲਖਾ ਕਿਸੂ ਕਿਹ ਬਾਮਾ ॥੯॥",
      "transliteration": "bhedh na lakhaa kisoo keh baamaa ||9||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਇਸਤਰੀ ਦਾ ਭੇਦ ਕਿਸੇ ਨੇ ਵੀ ਨਾ ਸਮਝਿਆ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "भेद न लखा किसू किह बामा ॥९॥",
      "sourceLineId": "138284",
      "sourceShabadId": "12752",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "138285",
      "sourceShabadId": "12753",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਛਲਿ ਪਿਤੁ ਮਾਤ ਕਹ ਗਈ ਮਿਤ੍ਰ ਕੇ ਸੰਗ ॥",
      "transliteration": "eeh bidh chhal pit maat keh giee mitr ke sa(n)g ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਮਾਤਾ ਪਿਤਾ ਨੂੰ ਛਲ ਕੇ ਮਿਤਰ ਦੇ ਨਾਲ ਚਲੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "इह बिधि छलि पितु मात कह गई मित्र के संग ॥",
      "sourceLineId": "138286",
      "sourceShabadId": "12753",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਬਿ ਸ੍ਯਾਮ ਪੂਰਨ ਭਯੋ ਤਬ ਹੀ ਕਥਾ ਪ੍ਰਸੰਗ ॥੧੦॥",
      "transliteration": "kab sayaam pooran bhayo tab hee kathaa prasa(n)g ||10||",
      "translation": "",
      "punjabiViakhya": "ਕਵੀ ਸ਼ਿਆਮ ਕਹਿੰਦੇ ਹਨ, ਤਦ ਹੀ ਕਥਾ ਪ੍ਰਸੰਗ ਸਮਾਪਤ ਹੋ ਗਿਆ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "कबि स्याम पूरन भयो तब ही कथा प्रसंग ॥१०॥",
      "sourceLineId": "138287",
      "sourceShabadId": "12753",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਚਾਰ ਸੌ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੪੦੦॥੭੦੮੨॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe chaar sau charitr samaapatam sat subham sat ||400||7082||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੪੦੦ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੪੦੦॥੭੦੮੨॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे चार सौ चरित्र समापतम सतु सुभम सतु ॥४००॥७०८२॥अफजूँ॥",
      "sourceLineId": "138288",
      "sourceShabadId": "12753",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "138289",
      "sourceShabadId": "12754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਾਤਿਸਾਹ ਕਾਰੂੰ ਇਕ ਸੁਨਿਯਤ ॥",
      "transliteration": "paatisaeh kaaroo(n) ik suniyat ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਰੂੰ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਸੁਣੀਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "पातिसाह कारूँ इक सुनियत ॥",
      "sourceLineId": "138290",
      "sourceShabadId": "12754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਮਿਤ ਤੇਜ ਜਾ ਕੋ ਜਗ ਗੁਨਿਯਤ ॥",
      "transliteration": "amit tej jaa ko jag guniyat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਜਗਤ ਵਿਚ ਅਮਿਤ ਤੇਜ ਮੰਨਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "अमित तेज जा को जग गुनियत ॥",
      "sourceLineId": "138291",
      "sourceShabadId": "12754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਹ ਧਨ ਭਰੇ ਚਿਹਲ ਭੰਡਾਰਾ ॥",
      "transliteration": "jeh dhan bhare chihal bha(n)ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਘਰ ਚਾਲੀ ('ਚਿਹਲ') ਖ਼ਜ਼ਾਨੇ ਭਰੇ ਹੁੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "जिह धन भरे चिहल भंडारा ॥",
      "sourceLineId": "138292",
      "sourceShabadId": "12754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਵਤ ਜਿਨ ਕਾ ਪਾਰ ਨ ਵਾਰਾ ॥੧॥",
      "transliteration": "aavat jin kaa paar na vaaraa ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦਾ ਅੰਤ ਨਹੀਂ ਪਾਇਆ ਜਾ ਸਕਦਾ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "आवत जिन का पार न वारा ॥१॥",
      "sourceLineId": "138293",
      "sourceShabadId": "12754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਹ ਪੁਰ ਸਾਹ ਸੁਤਾ ਇਕ ਸੁਨਿਯਤ ॥",
      "transliteration": "teh pur saeh sutaa ik suniyat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਗਰ ਵਿਚ ਇਕ ਸ਼ਾਹ ਦੀ ਪੁੱਤਰੀ ਸੁਣੀਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "तिह पुर साह सुता इक सुनियत ॥",
      "sourceLineId": "138294",
      "sourceShabadId": "12754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਾਨੁਕ ਚਿਤ੍ਰ ਪੁਤ੍ਰਕਾ ਗੁਨਿਯਤ ॥",
      "transliteration": "jaanuk chitr putrakaa guniyat ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਚਿਤਰ ਪੁਤਲੀ ਵਾਗ (ਬਹੁਤ ਹੀ ਸੁੰਦਰ) ਵਿਚਾਰੀ ਜਾਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "जानुक चित्र पुत्रका गुनियत ॥",
      "sourceLineId": "138295",
      "sourceShabadId": "12754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਿਰਖ ਭੂਪ ਕਾ ਰੂਪ ਲੁਭਾਈ ॥",
      "transliteration": "nirakh bhoop kaa roop lubhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰਾਜੇ ਦਾ ਰੂਪ ਵੇਖ ਕੇ ਮੋਹਿਤ ਹੋ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "निरख भूप का रूप लुभाई ॥",
      "sourceLineId": "138296",
      "sourceShabadId": "12754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਏਕ ਸਹਚਰੀ ਤਹਾ ਪਠਾਈ ॥੨॥",
      "transliteration": "ek sahacharee tahaa paThaiee ||2||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਾਸੀ ਨੂੰ ਉਸ ਪਾਸ ਭੇਜਿਆ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1352,
      "hindi": "",
      "hindiTransliteration": "एक सहचरी तहा पठाई ॥२॥",
      "sourceLineId": "138297",
      "sourceShabadId": "12754",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1352_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੁਅਰਿ ਬਸੰਤ ਤਵਨਿ ਕਾ ਨਾਮਾ ॥",
      "transliteration": "kuar basa(n)t tavan kaa naamaa ||",
      "translation": "",
