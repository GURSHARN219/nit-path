{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1354,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1354_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਹ ਸਮ ਸੁਰ ਪੁਰ ਨਾਰਿ ਨ ਲਹਿਯਤ ॥੧॥",
      "transliteration": "jeh sam sur pur naar na lahiyat ||1||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗੀ ਸਵਰਗ ਵਿਚ ਵੀ ਇਸਤਰੀ ਨਹੀਂ ਮਿਲਦੀ ਸੀ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "जिह सम सुर पुर नारि न लहियत ॥१॥",
      "sourceLineId": "138347",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਹਰ ਸੁਰੇਸ੍ਵਾਵਤੀ ਬਿਰਾਜੈ ॥",
      "transliteration": "sahar suresavaiaavatee biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਸੁਰੇਸ੍ਵਾਵਤੀ ਨਾ ਦੇ ਸ਼ਹਿਰ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "सहर सुरेस्वावती बिराजै ॥",
      "sourceLineId": "138348",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਾ ਕੌ ਨਿਰਖਿ ਇੰਦ੍ਰ ਪੁਰ ਲਾਜੈ ॥",
      "transliteration": "jaa kau nirakh i(n)dhr pur laajai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ (ਦੀ ਸੁੰਦਰਤਾ ਨੂੰ ਵੇਖ ਕੇ) ਇੰਦਰ ਪੁਰੀ ਵੀ ਲਜਾਉਾਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "जा कौ निरखि इंद्र पुर लाजै ॥",
      "sourceLineId": "138349",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਲਵੰਡ ਸਿੰਘ ਸਾਹ ਇਕ ਸੁਨਿਯਤ ॥",
      "transliteration": "balava(n)dd si(n)gh saeh ik suniyat ||",
      "translation": "",
      "punjabiViakhya": "ਬਲਵੰਡ ਸਿੰਘ ਨਾ ਦਾ ਇਕ ਸ਼ਾਹ ਸੁਣੀਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "बलवंड सिंघ साह इक सुनियत ॥",
      "sourceLineId": "138350",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਹ ਸਮਾਨ ਜਗ ਔਰ ਨ ਗੁਨਿਯਤ ॥੨॥",
      "transliteration": "jeh samaan jag aauar na guniyat ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਰਗਾ ਸੰਸਾਰ ਵਿਚ ਕੋਈ ਹੋਰ ਨਹੀਂ ਗਿਣਿਆ ਜਾਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "जिह समान जग और न गुनियत ॥२॥",
      "sourceLineId": "138351",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਦਾ ਕੁਅਰਿ ਤਿਹ ਸੁਤਾ ਭਨਿਜੈ ॥",
      "transliteration": "sadhaa kuar teh sutaa bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸਦਾ ਕੁਮਾਰੀ ਨਾ ਦੀ ਪੁੱਤਰੀ ਦਸੀ ਜਾਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "सदा कुअरि तिह सुता भनिजै ॥",
      "sourceLineId": "138352",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੰਦ੍ਰ ਸੂਰ ਲਖਿ ਜਾਹਿ ਅਰੁਝੈ ॥",
      "transliteration": "cha(n)dhr soor lakh jaeh arujhai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਸੂਰਜ ਅਤੇ ਚੰਦ੍ਰਮਾ ਵੀ ਉਲਝ ਜਾਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "चंद्र सूर लखि जाहि अरुझै ॥",
      "sourceLineId": "138353",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਪ੍ਰਮਾਨ ਦੁਤਿ ਜਾਤ ਨ ਕਹੀ ॥",
      "transliteration": "apramaan dhut jaat na kahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਅਸੀਮ ਸੁੰਦਰਤਾ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "अप्रमान दुति जात न कही ॥",
      "sourceLineId": "138354",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਾਨੁਕ ਫੂਲਿ ਚੰਬੇਲੀ ਰਹੀ ॥੩॥",
      "transliteration": "jaanuk fool cha(n)belee rahee ||3||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਚੰਬੇਲੀ ਦਾ ਫੁਲ ਹੋਵੇ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "जानुक फूलि चंबेली रही ॥३॥",
      "sourceLineId": "138355",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਦਾ ਕੁਅਰਿ ਨਿਰਖਾ ਜਬ ਰਾਜਾ ॥",
      "transliteration": "sadhaa kuar nirakhaa jab raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਦਾ ਕੁਮਾਰੀ ਨੇ ਜਦ ਰਾਜੇ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "सदा कुअरि निरखा जब राजा ॥",
      "sourceLineId": "138356",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਬ ਹੀ ਸੀਲ ਤਵਨ ਕਾ ਭਾਜਾ ॥",
      "transliteration": "tab hee seel tavan kaa bhaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਉਸ ਦਾ ਸ਼ੀਲ (ਸੰਜਮ) ਖ਼ਤਮ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "तब ही सील तवन का भाजा ॥",
      "sourceLineId": "138357",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਖੀ ਏਕ ਨ੍ਰਿਪ ਤੀਰ ਪਠਾਈ ॥",
      "transliteration": "sakhee ek nirap teer paThaiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਇਕ ਦਾਸੀ ਨੂੰ ਰਾਜੇ ਕੋਲ ਭੇਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "सखी एक नृप तीर पठाई ॥",
      "sourceLineId": "138358",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਯੌ ਰਾਜਾ ਤਨ ਕਹੁ ਤੈ ਜਾਈ ॥੪॥",
      "transliteration": "yau raajaa tan kahu tai jaiee ||4||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਉਸ ਨੂੰ ਸਮਝਾਇਆ ਕਿ) ਰਾਜੇ ਪਾਸ ਜਾ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਕਹੀਂ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "यौ राजा तन कहु तै जाई ॥४॥",
      "sourceLineId": "138359",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੈ ਤਵ ਰੂਪ ਨਿਰਖਿ ਉਰਝਾਨੀ ॥",
      "transliteration": "mai tav roop nirakh urajhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੇਰਾ ਰੂਪ ਵੇਖ ਕੇ ਮੋਹਿਤ ਹੋ ਗਈ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "मै तव रूप निरखि उरझानी ॥",
      "sourceLineId": "138360",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਦਨ ਤਾਪ ਤੇ ਭਈ ਦਿਵਾਨੀ ॥",
      "transliteration": "madhan taap te bhiee dhivaanee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਮ ਦੀ ਤਪਸ਼ ਨਾਲ ਦੀਵਾਨੀ ਹੋ ਗਈ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "मदन ताप ते भई दिवानी ॥",
      "sourceLineId": "138361",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਏਕ ਬਾਰ ਤੁਮ ਮੁਝੈ ਬੁਲਾਵੋ ॥",
      "transliteration": "ek baar tum mujhai bulaavo ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਵਾਰ ਤੁਸੀਂ ਮੈਨੂੰ (ਆਪਣੇ ਕੋਲ) ਬੁਲਾਓ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "एक बार तुम मुझै बुलावो ॥",
      "sourceLineId": "138362",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਾਮ ਤਪਤ ਕਰਿ ਕੇਲ ਮਿਟਾਵੋ ॥੫॥",
      "transliteration": "kaam tapat kar kel miTaavo ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਤੀ-ਕ੍ਰੀੜਾ ਕਰ ਕੇ ਕਾਮ ਦੀ ਤਪਸ਼ ਨੂੰ ਮਿਟਾਓ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "काम तपत करि केल मिटावो ॥५॥",
      "sourceLineId": "138363",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੌ ਆਪਨ ਗ੍ਰਿਹ ਮੁਹਿ ਨ ਬੁਲਾਵਹੁ ॥",
      "transliteration": "jau aapan gireh muh na bulaavahu ||",
      "translation": "",
      "punjabiViakhya": "(ਜੇ) ਆਪਣੇ ਘਰ ਨਹੀਂ ਬੁਲਾਉਾਂਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "जौ आपन गृह मुहि न बुलावहु ॥",
      "sourceLineId": "138364",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਏਕ ਬਾਰ ਮੋਰੇ ਗ੍ਰਿਹ ਆਵਹੁ ॥",
      "transliteration": "ek baar more gireh aavahu ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਇਕ ਵਾਰ ਮੇਰੇ ਘਰ ਹੀ ਆ ਜਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "एक बार मोरे गृह आवहु ॥",
      "sourceLineId": "138365",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮੋ ਸੰਗ ਕਰਿਯੈ ਮੈਨ ਬਿਲਾਸਾ ॥",
      "transliteration": "mo sa(n)g kariyai main bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੇ ਨਾਲ ਕਾਮੁਕ ਵਿਲਾਸ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "मो संग करियै मैन बिलासा ॥",
      "sourceLineId": "138366",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਮ ਕਹ ਤੋਰਿ ਮਿਲਨ ਕੀ ਆਸਾ ॥੬॥",
      "transliteration": "ham keh tor milan kee aasaa ||6||",
      "translation": "",
      "punjabiViakhya": "ਮੈਨੂੰ ਤੁਹਾਡੇ ਮਿਲਣ ਦੀ ਹੀ ਆਸ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "हम कह तोरि मिलन की आसा ॥६॥",
      "sourceLineId": "138367",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭੂਪ ਕੁਅਰਿ ਵਹੁ ਗ੍ਰਿਹ ਨ ਬੁਲਾਈ ॥",
      "transliteration": "bhoop kuar vahu gireh na bulaiee ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੇ ਕੁਮਾਰੀ ਨੂੰ (ਆਪਣੇ) ਘਰ ਨਾ ਬੁਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "भूप कुअरि वहु गृह न बुलाई ॥",
      "sourceLineId": "138368",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਪੁ ਜਾਇ ਤਿਹ ਸੇਜ ਸੁਹਾਈ ॥",
      "transliteration": "aap jai teh sej suhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪ ਜਾ ਕੇ ਉਸ ਦੀ ਸੇਜ ਨੂੰ ਸੁਸ਼ੋਭਿਤ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "आपु जाइ तिह सेज सुहाई ॥",
      "sourceLineId": "138369",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੀਪ ਦਾਨ ਤਰੁਨੀ ਤਿਨ ਕੀਨਾ ॥",
      "transliteration": "dheep dhaan tarunee tin keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸਤਰੀ ਨੇ ਰਾਜੇ ਦਾ ਦੀਪਕ ਜਲਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "दीप दान तरुनी तिन कीना ॥",
      "sourceLineId": "138370",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਰਘ ਧੂਪ ਰਾਜਾ ਕਹ ਦੀਨਾ ॥੭॥",
      "transliteration": "aragh dhoop raajaa keh dheenaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧੂਪ ਅਤੇ ਅਰਗ ਚੜ੍ਰਹਾ ਕੇ ਸੁਆਗਤ ਕੀਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "अरघ धूप राजा कह दीना ॥७॥",
      "sourceLineId": "138371",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੁਭਰ ਸੇਜ ਊਪਰ ਬੈਠਾਯੋ ॥",
      "transliteration": "subhar sej uoopar baiThaayo ||",
      "translation": "",
      "punjabiViakhya": "ਸੁੰਦਰ ਸੇਜ ਉਤੇ ਬਿਠਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "सुभर सेज ऊपर बैठायो ॥",
      "sourceLineId": "138372",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭਾਗ ਅਫੀਮ ਸਰਾਬ ਮੰਗਾਯੋ ॥",
      "transliteration": "bhaag afeem saraab ma(n)gaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੰਗ, ਅਫ਼ੀਮ ਤੇ ਸ਼ਰਾਬ ਮੰਗਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "भाग अफीम सराब मंगायो ॥",
      "sourceLineId": "138373",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪ੍ਰਥਮ ਕਹਾ ਨ੍ਰਿਪ ਸੌ ਇਨ ਪੀਜੈ ॥",
      "transliteration": "pratham kahaa nirap sau in peejai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜੇ ਨੂੰ ਕਿਹਾ ਕਿ ਪਹਿਲਾ ਇਨ੍ਰਹਾ ਨੂੰ ਪੀਓ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "प्रथम कहा नृप सौ इन पीजै ॥",
      "sourceLineId": "138374",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਹੁਰਿ ਮੁਝੈ ਮਦਨੰਕੁਸ ਦੀਜੈ ॥੮॥",
      "transliteration": "bahur mujhai madhana(n)kus dheejai ||8||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਮੈਨੂੰ ਮਦਨਾਕੁਸ਼ (ਪੁਰਸ਼ ਇੰਦਰੀ) ਦਿਓ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "बहुरि मुझै मदनंकुस दीजै ॥८॥",
      "sourceLineId": "138375",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁਨਤ ਬਚਨ ਇਹ ਭੂਪ ਨ ਮਾਨਾ ॥",
      "transliteration": "sunat bachan ieh bhoop na maanaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਹ ਗੱਲ ਸੁਣ ਕੇ ਰਾਜਾ ਨਾ ਮੰਨਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "सुनत बचन इह भूप न माना ॥",
      "sourceLineId": "138376",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਮ ਕੇ ਡੰਡ ਤ੍ਰਾਸ ਤਰਸਾਨਾ ॥",
      "transliteration": "jam ke dda(n)dd traas tarasaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਮ ਦੇ ਡੰਡੇ ਦੇ ਭੈ ਤੋਂ ਘਬਰਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "जम के डंड त्रास तरसाना ॥",
      "sourceLineId": "138377",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਹਿਯੋ ਨ ਮੈ ਤੌਸੌ ਰਤਿ ਕਰਿਹੋ ॥",
      "transliteration": "kahiyo na mai tauasau rat kariho ||",
      "translation": "",
      "punjabiViakhya": "ਕਹਿਣ ਲਗਾ ਕਿ ਮੈਂ ਤੇਰੇ ਨਾਲ ਸੰਯੋਗ ਨਹੀਂ ਕਰਾਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "कहियो न मै तौसौ रति करिहो ॥",
      "sourceLineId": "138378",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਘੋਰ ਨਰਕ ਮੋ ਭੂਲਿ ਨ ਪਰਿਹੌ ॥੯॥",
      "transliteration": "ghor narak mo bhool na parihau ||9||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੁਲ ਕੇ ਵੀ ਭਿਆਨਕ ਨਰਕ ਵਿਚ ਨਹੀਂ ਪਵਾਗਾ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "घोर नरक मो भूलि न परिहौ ॥९॥",
      "sourceLineId": "138379",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਿਮਿ ਤਿਮਿ ਤ੍ਰਿਯ ਅੰਚਰ ਗਰਿ ਡਾਰੈ ॥",
      "transliteration": "tim tim tiray a(n)char gar ddaarai ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਦੇ ਨਾਹ ਕਰਨ ਦੇ ਬਾਵਜੂਦ) ਤਿਵੇਾਂ ਤਿਵੇਾਂ (ਇਸਤਰੀ) ਗਲੇ ਵਿਚ ਪਲੂ ਪਾਉਾਂਦੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "तिमि तिमि तृय अंचर गरि डारै ॥",
      "sourceLineId": "138380",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜੋਰਿ ਜੋਰਿ ਦ੍ਰਿਗ ਨ੍ਰਿਪਹਿ ਨਿਹਾਰੈ ॥",
      "transliteration": "jor jor dhirag nirapeh nihaarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅੱਖਾ ਜੋੜ ਜੋੜ ਕੇ ਰਾਜੇ ਨੂੰ ਵੇਖਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "जोरि जोरि दृग नृपहि निहारै ॥",
      "sourceLineId": "138381",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਮੁਹਿ ਭੂਪਤਿ ਭਜਿਯੈ ॥",
      "transliteration": "hai hai muh bhoopat bhajiyai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) 'ਹਾਇ ਹਾਇ' (ਕਰ ਕੇ ਕਹਿੰਦੀ ਸੀ) ਹੇ ਰਾਜਨ! ਮੇਰੇ ਨਾਲ ਭੋਗ ਵਿਲਾਸ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ मुहि भूपति भजियै ॥",
      "sourceLineId": "138382",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਾਮ ਕ੍ਰਿਯਾ ਮੋਰੇ ਸੰਗ ਸਜਿਯੈ ॥੧੦॥",
      "transliteration": "kaam kirayaa more sa(n)g sajiyai ||10||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮੇਰੇ ਨਾਲ ਕਾਮ-ਲੀਲ੍ਰਹਾ ਰਚਾਓ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "काम कृया मोरे संग सजियै ॥१०॥",
      "sourceLineId": "138383",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਹਿ ਨਹਿ ਪੁਨਿ ਜਿਮਿ ਜਿਮਿ ਨ੍ਰਿਪ ਕਰੈ ॥",
      "transliteration": "neh neh pun jim jim nirap karai ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਫਿਰ ਜਿਵੇਾਂ ਜਿਵੇਾਂ 'ਨਾਹ ਨਾਹ' ਕਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "नहि नहि पुनि जिमि जिमि नृप करै ॥",
      "sourceLineId": "138384",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਿਮਿ ਤਿਮਿ ਚਰਨ ਚੰਚਲਾ ਪਰੈ ॥",
      "transliteration": "tim tim charan cha(n)chalaa parai ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਵੇਾਂ ਤਿਵੇਾਂ ਇਸਤਰੀ ਚਰਨੀਂ ਪੈਂਦੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "तिमि तिमि चरन चंचला परै ॥",
      "sourceLineId": "138385",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਹਾ ਨ੍ਰਿਪਤਿ ਮੁਹਿ ਕਰਹੁ ਬਿਲਾਸਾ ॥",
      "transliteration": "hahaa nirapat muh karahu bilaasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿੰਦੀ ਸੀ) ਹਾ ਹਾ ਰਾਜਨ! ਮੇਰੇ ਨਾਲ ਵਿਲਾਸ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "हहा नृपति मुहि करहु बिलासा ॥",
      "sourceLineId": "138386",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਾਮ ਭੋਗ ਕੀ ਪੁਰਵਹੁ ਆਸਾ ॥੧੧॥",
      "transliteration": "kaam bhog kee puravahu aasaa ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਮੇਰੀ) ਕਾਮ ਭੋਗ ਦੀ ਆਸ ਪੂਰੀ ਕਰੋ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "काम भोग की पुरवहु आसा ॥११॥",
      "sourceLineId": "138387",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਹਾ ਕਰੌ ਕਹੁ ਕਹਾ ਪਧਾਰੌ ॥",
      "transliteration": "kahaa karau kahu kahaa padhaarau ||",
      "translation": "",
      "punjabiViakhya": "ਦਸੋ, ਮੈਂ ਕੀ ਕਰਾ, ਕਿਥੇ ਜਾਵਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "कहा करौ कहु कहा पधारौ ॥",
      "sourceLineId": "138388",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਪ ਮਰੌ ਕੈ ਮੁਝੈ ਸੰਘਾਰੌ ॥",
      "transliteration": "aap marau kai mujhai sa(n)ghaarau ||",
      "translation": "",
      "punjabiViakhya": "ਆਪ ਮਰ ਜਾਵਾ ਜਾ (ਤੁਸੀਂ) ਮੈਨੂੰ ਮਾਰ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "आप मरौ कै मुझै संघारौ ॥",
      "sourceLineId": "138389",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਮੁਹਿ ਭੋਗ ਨ ਕਰਈ ॥",
      "transliteration": "hai hai muh bhog na kariee ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਇ ਹਾਇ' ਤੁਸੀਂ ਮੇਰੇ ਨਾਲ ਭੋਗ ਨਹੀਂ ਕਰ ਰਹੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ मुहि भोग न करई ॥",
      "sourceLineId": "138390",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਾ ਤੇ ਜੀਅ ਹਮਾਰਾ ਜਰਈ ॥੧੨॥",
      "transliteration": "taa te jeea hamaaraa jariee ||12||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਕਰ ਕੇ ਮੇਰਾ ਜੀ ਸੜ ਰਿਹਾ ਹੈ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "ता ते जीअ हमारा जरई ॥१२॥",
      "sourceLineId": "138391",
      "sourceShabadId": "12761",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਵੈਯਾ ॥",
      "transliteration": "savaiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਵੈਯਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "सवैया ॥",
      "sourceLineId": "138392",
      "sourceShabadId": "12762",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਸਨ ਔਰ ਅਲਿੰਗਨ ਚੁੰਬਨ ਆਜੁ ਭਲੇ ਤੁਮਰੇ ਕਸਿ ਲੈਹੌ ॥",
      "transliteration": "aasan aauar ali(n)gan chu(n)ban aaj bhale tumare kas laihau ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਅਜ ਤੁਹਾਡੇ ਨਾਲ ਆਸਣ, ਆਲਿੰਗਨ ਅਤੇ ਚੁੰਬਨ ਚੰਗੀ ਤਰ੍ਰਹਾ ਕਸ ਕੇ ਕਰਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "आसन और अलिंगन चुँबन आजु भले तुमरे कसि लैहौ ॥",
      "sourceLineId": "138393",
      "sourceShabadId": "12762",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1354_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰੀਝਿ ਹੈਂ ਜੌਨ ਉਪਾਇ ਗੁਮਾਨੀ ਤੈਂ ਤਾਹਿ ਉਪਾਇ ਸੋ ਤੋਹਿ ਰਿਝੈਹੌ ॥",
      "transliteration": "reejh hai(n) jauan upai gumaanee tai(n) taeh upai so toh rijhaihau ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਉਪਾ ਨਾਲ ਹੇ ਗੁਮਾਨੀ ਰਾਜਨ! ਤੁਸੀਂ ਰੀਝੋਗੇ, ਉਹੀ ਉਪਾ ਕਰ ਕੇ ਤੁਹਾਨੂੰ ਰਿਝਾਵਾਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1354,
      "hindi": "",
      "hindiTransliteration": "रीझि हैं जौन उपाइ गुमानी तैं ताहि उपाइ सो तोहि रिझैहौ ॥",
      "sourceLineId": "138394",
      "sourceShabadId": "12762",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
