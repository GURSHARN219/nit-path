{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1356,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1356_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਿਵਦੇਈ ਤਿਹ ਨਾਰਿ ਬਿਚਛਨ ॥",
      "transliteration": "sivadheiee teh naar bichachhan ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੀ ਸ਼ਿਵ ਦੇਈ ਨਾ ਦੀ ਸਿਆਣੀ ਇਸਤਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "सिवदेई तिह नारि बिचछन ॥",
      "sourceLineId": "138467",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰੂਪਵਾਨ ਗੁਨਵਾਨ ਸੁਲਛਨ ॥",
      "transliteration": "roopavaan gunavaan sulachhan ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਰੂਪਵਾਨ, ਗੁਣਵਾਨ ਅਤੇ ਚੰਗਿਆਂ ਲੱਛਣਾ ਵਾਲੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "रूपवान गुनवान सुलछन ॥",
      "sourceLineId": "138468",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਾਜਾ ਆਪੁ ਚਰਿਤ੍ਰ ਬਨਾਵਤ ॥",
      "transliteration": "raajaa aap charitr banaavat ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਜਾ ਆਪ ਚਰਿਤ੍ਰ ਬਣਾਉਾਂਦਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "राजा आपु चरित्र बनावत ॥",
      "sourceLineId": "138469",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲਿਖਿ ਲਿਖਿ ਪੜਿ ਇਸਤ੍ਰਿਯਨ ਸੁਨਾਵਤ ॥੨॥",
      "transliteration": "likh likh paR isatirayan sunaavat ||2||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਿਖ ਲਿਖ ਕੇ ਇਸਤਰੀਆਂ ਨੂੰ ਪੜ੍ਰਹ ਕੇ ਸੁਣਾਉਾਂਦਾ ਹੁੰਦਾ ਸੀ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "लिखि लिखि पड़ि इसतृयन सुनावत ॥२॥",
      "sourceLineId": "138470",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਿਵਾ ਮਤੀ ਇਹ ਬਿਧਿ ਜਬ ਸੁਨੀ ॥",
      "transliteration": "sivaa matee ieh bidh jab sunee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਸ਼ਿਵਾ ਮਤੀ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "सिवा मती इह बिधि जब सुनी ॥",
      "sourceLineId": "138471",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਧਿਕ ਬਿਹਸਿ ਕਰਿ ਮੂੰਡੀ ਧੁਨੀ ॥",
      "transliteration": "adhik bihas kar moo(n)ddee dhunee ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਬਹੁਤ ਹਸ ਕੇ ਸਿਰ ਹਿਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "अधिक बिहसि करि मूँडी धुनी ॥",
      "sourceLineId": "138472",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਸ ਕਰਿ ਇਸੈ ਚਰਿਤ੍ਰ ਦਿਖਾਊ ॥",
      "transliteration": "as kar isai charitr dhikhaauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਅਜਿਹਾ ਚਰਿਤ੍ਰ ਕਰ ਕੇ ਇਸ (ਰਾਜੇ) ਨੂੰ ਵਿਖਾਵਾਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "अस करि इसै चरित्र दिखाऊ ॥",
      "sourceLineId": "138473",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਯਾਹ ਭਜੋ ਯਾਹੀ ਤੇ ਲਿਖਾਊ ॥੩॥",
      "transliteration": "yaeh bhajo yaahee te likhaauoo ||3||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਸ ਨਾਲ ਰਮਣ ਕਰ ਕੇ ਇਸੇ ਤੋਂ ਲਿਖਵਾਵਾਗੀ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "याह भजो याही ते लिखाऊ ॥३॥",
      "sourceLineId": "138474",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਿਹ ਤਿਹ ਬਿਧਿ ਭੂਪਹਿ ਫੁਸਲਾਇ ॥",
      "transliteration": "jeh teh bidh bhoopeh fusalai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕਿਵੇਾਂ ਰਾਜੇ ਨੂੰ ਫੁਸਲਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "जिह तिह बिधि भूपहि फुसलाइ ॥",
      "sourceLineId": "138475",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਿਲਤ ਭਈ ਦਿਨ ਹੀ ਕਹ ਆਇ ॥",
      "transliteration": "milat bhiee dhin hee keh aai ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਨ ਨੂੰ ਹੀ ਆ ਕੇ ਮਿਲ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "मिलत भई दिन ही कह आइ ॥",
      "sourceLineId": "138476",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਨਿ ਗਰੇ ਤਾ ਕੇ ਲਪਟਾਈ ॥",
      "transliteration": "aan gare taa ke lapaTaiee ||",
      "translation": "",
      "punjabiViakhya": "ਆ ਕੇ ਉਸ ਦੇ ਗਲੇ ਨਾਲ ਲਿਪਟ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "आनि गरे ता के लपटाई ॥",
      "sourceLineId": "138477",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਿਨ ਕੇਲ ਰਚਾਈ ॥੪॥",
      "transliteration": "bhaat bhaat tin kel rachaiee ||4||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तिन केल रचाई ॥४॥",
      "sourceLineId": "138478",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਜਦ ਪਤਿਹ ਭਜਾ ॥",
      "transliteration": "bhaat bhaat jadh pateh bhajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਭਾਵੇਾਂ) ਪਤੀ ਨੇ ਉਸ ਨਾਲ ਕਈ ਤਰ੍ਰਹਾ ਦਾ ਰਮਣ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "भाति भाति जद पतिह भजा ॥",
      "sourceLineId": "138479",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਊ ਨ ਤ੍ਰਿਯ ਆਸਨ ਤਿਹ ਤਜਾ ॥",
      "transliteration": "tuoo na tiray aasan teh tajaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਵੀ ਇਸਤਰੀ ਨੇ ਉਸ ਦਾ ਆਸਣ ਨਾ ਛਡਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "तऊ न तृय आसन तिह तजा ॥",
      "sourceLineId": "138480",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਉਰ ਸੋ ਉਰਝਾਨੀ ॥",
      "transliteration": "bhaat bhaat ur so urajhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ (ਉਸ ਦੀ) ਛਾਤੀ ਨਾਲ ਲਗੀ ਰਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "भाति भाति उर सो उरझानी ॥",
      "sourceLineId": "138481",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਿਰਖਿ ਭੂਪ ਕਾ ਰੂਪ ਬਿਕਾਨੀ ॥੫॥",
      "transliteration": "nirakh bhoop kaa roop bikaanee ||5||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਾਜੇ ਦਾ ਰੂਪ ਵੇਖ ਕੇ ਵਿਕ ਗਈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "निरखि भूप का रूप बिकानी ॥५॥",
      "sourceLineId": "138482",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭੋਗ ਕਮਾਇ ਗਈ ਡੇਰੈ ਜਬ ॥",
      "transliteration": "bhog kamai giee dderai jab ||",
      "translation": "",
      "punjabiViakhya": "(ਰਾਜੇ ਨਾਲ) ਭੋਗ ਕਰ ਕੇ ਜਦ (ਆਪਣੇ) ਘਰ ਨੂੰ ਪਰਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "भोग कमाइ गई डेरै जब ॥",
      "sourceLineId": "138483",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਖਿਯਨ ਸਾਥ ਬਖਾਨੋ ਇਮ ਤਬ ॥",
      "transliteration": "sakhiyan saath bakhaano im tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਸਖੀਆਂ ਨਾਲ ਇਸ ਤਰ੍ਰਹਾ ਬਖਾਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "सखियन साथ बखानो इम तब ॥",
      "sourceLineId": "138484",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਹ ਰਾਜੈ ਮੁਹਿ ਆਜੁ ਬੁਲਾਯੋ ॥",
      "transliteration": "eeh raajai muh aaj bulaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਰਾਜੇ ਨੇ ਮੈਨੂੰ ਅਜ ਬੁਲਾਇਆ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "इह राजै मुहि आजु बुलायो ॥",
      "sourceLineId": "138485",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦਿਨ ਹੀ ਮੋ ਸੰਗ ਭੋਗ ਕਮਾਯੋ ॥੬॥",
      "transliteration": "dhin hee mo sa(n)g bhog kamaayo ||6||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਿਨ ਵੇਲੇ ਹੀ ਮੇਰੇ ਨਾਲ ਭੋਗ ਕੀਤਾ ਸੀ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "दिन ही मो संग भोग कमायो ॥६॥",
      "sourceLineId": "138486",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਾਸੁ ਸਸੁਰ ਜਬ ਹੀ ਸੁਨ ਪਾਈ ॥",
      "transliteration": "saas sasur jab hee sun paiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਸੱਸ ਸਹੁਰੇ ਨੇ ਸੁਣ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "सासु ससुर जब ही सुन पाई ॥",
      "sourceLineId": "138487",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਔਰ ਸੁਨਤ ਭੀ ਸਗਲ ਲੁਗਾਈ ॥",
      "transliteration": "aauar sunat bhee sagal lugaiee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਸਾਰੀਆਂ ਇਸਤਰੀਆਂ ਨੇ ਸੁਣ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "और सुनत भी सगल लुगाई ॥",
      "sourceLineId": "138488",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਜੁ ਰਾਜ ਯਾ ਸੋ ਰਤਿ ਮਾਨੀ ॥",
      "transliteration": "aaj raaj yaa so rat maanee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਅਜ ਰਾਜੇ ਨੇ ਇਸ ਨਾਲ ਕਾਮ-ਕ੍ਰੀੜਾ ਕੀਤੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "आजु राज या सो रति मानी ॥",
      "sourceLineId": "138489",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬੂਝਿ ਗਏ ਸਭ ਲੋਗ ਕਹਾਨੀ ॥੭॥",
      "transliteration": "boojh ge sabh log kahaanee ||7||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਸਾਰੇ ਲੋਕ ਕਹਾਣੀ ਸਮਝ ਗਏ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "बूझि गए सभ लोग कहानी ॥७॥",
      "sourceLineId": "138490",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪੁਨਿ ਸਿਵ ਦੇ ਇਹ ਭਾਤਿ ਉਚਾਰੋ ॥",
      "transliteration": "pun siv dhe ieh bhaat uchaaro ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸ਼ਿਵ ਦੇ (ਦੇਈ) ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਕਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "पुनि सिव दे इह भाति उचारो ॥",
      "sourceLineId": "138491",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੈ ਦੇਖਤ ਥੀ ਹਿਯਾ ਤਿਹਾਰੋ ॥",
      "transliteration": "mai dhekhat thee hiyaa tihaaro ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤੁਹਾਡਾ ਜਿਗਰਾ ਵੇਖ ਰਹੀ ਸਾ",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "मै देखत थी हिया तिहारो ॥",
      "sourceLineId": "138492",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਾਤ ਕਹੇ ਮੁਹਿ ਏ ਕ੍ਯਾ ਕਰਿਹੈ ॥",
      "transliteration": "baat kahe muh e kayaa karihai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਇਹ ਕੀ ਗੱਲ ਕਰਦੇ ਹਨ ਅਤੇ ਮੈਨੂੰ ਕੀ ਕਹਿੰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "बात कहे मुहि ए क्या करिहै ॥",
      "sourceLineId": "138493",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੁਪ ਕਰਿ ਹੈ ਕਿ ਕੋਪ ਕਰਿ ਲਰਿਹੈ ॥੮॥",
      "transliteration": "chup kar hai k kop kar larihai ||8||",
      "translation": "",
      "punjabiViakhya": "ਚੁਪ ਕਰਦੇ ਹਨ ਜਾ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਲੜਦੇ ਹਨ ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "चुप करि है कि कोप करि लरिहै ॥८॥",
      "sourceLineId": "138494",
      "sourceShabadId": "12765",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "138495",
      "sourceShabadId": "12766",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦਿਨ ਕੋ ਐਸੋ ਕੋ ਤ੍ਰਿਯ ਕਰਮ ਕਮਾਵਈ ॥",
      "transliteration": "dhin ko aaiso ko tiray karam kamaaviee ||",
      "translation": "",
      "punjabiViakhya": "ਦਿਨ ਵੇਲੇ ਅਜਿਹੀ ਕਿਹੜੀ ਇਸਤਰੀ ਹੈ, ਜੋ (ਇਹ) ਕਰਮ ਕਮਾਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "दिन को ऐसो को तृय करम कमावई ॥",
      "sourceLineId": "138496",
      "sourceShabadId": "12766",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦਿਖਤ ਜਾਰ ਕੋ ਧਾਮ ਨਾਰਿ ਕਿਮਿ ਜਾਵਈ ॥",
      "transliteration": "dhikhat jaar ko dhaam naar kim jaaviee ||",
      "translation": "",
      "punjabiViakhya": "(ਸਭ ਦੇ) ਵੇਖਦੇ ਹੋਇਆਂ ਇਸਤਰੀ ਕਿਵੇਾਂ ਯਾਰ ਦੇ ਘਰ ਜਾਵੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "दिखत जार को धाम नारि किमि जावई ॥",
      "sourceLineId": "138497",
      "sourceShabadId": "12766",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਐਸ ਕਾਜ ਕਰਿ ਕਵਨ ਕਹੋ ਕਿਮਿ ਭਾਖਿ ਹੈ ॥",
      "transliteration": "aais kaaj kar kavan kaho kim bhaakh hai ||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹਾ ਕੰਮ ਕਰ ਕੇ ਭਲਾ ਕੋਈ ਕਿਸੇ ਨੂੰ ਕਿਉਾਂ ਦਸੇਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "ऐस काज करि कवन कहो किमि भाखि है ॥",
      "sourceLineId": "138498",
      "sourceShabadId": "12766",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹੋ ਅਪਨੇ ਚਿਤ ਕੀ ਬਾਤ ਚਿਤ ਮੋ ਰਾਖਿ ਹੈ ॥੯॥",
      "transliteration": "ho apane chit kee baat chit mo raakh hai ||9||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਆਪਣੇ ਮਨ ਦੀ ਗੱਲ ਆਪਣੇ ਮਨ ਵਿਚ ਹੀ ਰਖੇਗੀ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "हो अपने चित की बात चित मो राखि है ॥९॥",
      "sourceLineId": "138499",
      "sourceShabadId": "12766",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "138500",
      "sourceShabadId": "12767",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬੈਨ ਸੁਨਤ ਸਭਹਿਨ ਸਚੁ ਆਯੋ ॥",
      "transliteration": "bain sunat sabhahin sach aayo ||",
      "translation": "",
      "punjabiViakhya": "ਗੱਲ ਸੁਣ ਕੇ ਸਾਰਿਆਂ ਨੇ ਸਚ ਮੰਨ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "बैन सुनत सभहिन सचु आयो ॥",
      "sourceLineId": "138501",
      "sourceShabadId": "12767",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਿਨੂੰ ਨ ਤਹ ਇਹ ਕਥਹਿ ਚਲਾਯੋ ॥",
      "transliteration": "kinoo(n) na teh ieh katheh chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਸੇ ਹੋਰ ਨਾਲ ਅਗੇ ਗੱਲ ਨਾ ਚਲਾਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "किनूँ न तह इह कथहि चलायो ॥",
      "sourceLineId": "138502",
      "sourceShabadId": "12767",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੋ ਕੋਈ ਐਸ ਕਰਮ ਕੌ ਕਰਿ ਹੈ ॥",
      "transliteration": "jo koiee aais karam kau kar hai ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਕੋਈ ਅਜਿਹਾ ਕਰਮ ਕਰਦਾ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "जो कोई ऐस करम कौ करि है ॥",
      "sourceLineId": "138503",
      "sourceShabadId": "12767",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭੂਲਿ ਨ ਕਾਹੂ ਪਾਸ ਉਚਿਰ ਹੈ ॥੧੦॥",
      "transliteration": "bhool na kaahoo paas uchir hai ||10||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਭੁਲ ਕੇ ਕਿਸੇ ਹੋਰ ਨੂੰ ਨਹੀਂ ਦਸਦਾ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "भूलि न काहू पास उचिर है ॥१०॥",
      "sourceLineId": "138504",
      "sourceShabadId": "12767",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਲੋਗਨ ਕਹਿ ਇਹ ਬਿਧਿ ਡਹਕਾਇ ॥",
      "transliteration": "logan keh ieh bidh ddahakai ||",
      "translation": "",
      "punjabiViakhya": "ਲੋਕਾ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਕਹਿ ਕੇ ਭਰਮਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "लोगन कहि इह बिधि डहकाइ ॥",
      "sourceLineId": "138505",
      "sourceShabadId": "12767",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਿਯ ਤਨ ਪਤ੍ਰੀ ਲਿਖੀ ਬਨਾਇ ॥",
      "transliteration": "piy tan patree likhee banai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰਿਯ ਨੂੰ (ਇਸ ਤਰ੍ਰਹਾ) ਚਿੱਠੀ ਲਿਖ ਭੇਜੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "पिय तन पत्री लिखी बनाइ ॥",
      "sourceLineId": "138506",
      "sourceShabadId": "12767",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮੋ ਪਰ ਯਾਰ ਅਨੁਗ੍ਰਹ ਕੀਜੇ ॥",
      "transliteration": "mo par yaar anugreh keeje ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪ੍ਰੀਤਮ! ਮੇਰੇ ਉਤੇ ਕ੍ਰਿਪਾ ਕਰੋ",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "मो पर यार अनुग्रह कीजे ॥",
      "sourceLineId": "138507",
      "sourceShabadId": "12767",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਹ ਭੀ ਚਰਿਤ ਗ੍ਰੰਥ ਲਿਖਿ ਲੀਜੇ ॥੧੧॥",
      "transliteration": "eeh bhee charit gra(n)th likh leeje ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਹ ਚਰਿਤ੍ਰ ਵੀ ਗ੍ਰੰਥ ਵਿਚ ਲਿਖ ਲਵੋ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "इह भी चरित ग्रंथ लिखि लीजे ॥११॥",
      "sourceLineId": "138508",
      "sourceShabadId": "12767",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਚਾਰ ਸੌ ਤੀਨ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੪੦੩॥੭੧੩੪॥ਅਫਜੂੰ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe chaar sau teen charitr samaapatam sat subham sat ||403||7134||afajoo(n)||",
      "translation": "",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੪੦੩ਵੇਾਂ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੪੦੩॥੭੧੩੪॥ ਚਲਦਾ॥",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे चार सौ तीन चरित्र समापतम सतु सुभम सतु ॥४०३॥७१३४॥अफजूँ॥",
      "sourceLineId": "138509",
      "sourceShabadId": "12767",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਬੁਧਿ ਬਾਚ ॥",
      "transliteration": "sabudh baach ||",
      "translation": "",
      "punjabiViakhya": "ਸਬੁਧਿ ਨੇ ਕਿਹਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "सबुधि बाच ॥",
      "sourceLineId": "138510",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "138511",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਤਿ ਸੰਧਿ ਇਕ ਭੂਪ ਭਨਿਜੈ ॥",
      "transliteration": "sat sa(n)dh ik bhoop bhanijai ||",
      "translation": "",
      "punjabiViakhya": "ਸਤਿ ਸੰਧਿ ਨਾ ਦਾ ਇਕ ਰਾਜਾ ਦਸਿਆ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "सति संधि इक भूप भनिजै ॥",
      "sourceLineId": "138512",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰਥਮੇ ਸਤਿਜੁਗ ਬੀਚ ਕਹਿਜੈ ॥",
      "transliteration": "prathame satijug beech kahijai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਪਹਿਲੇ (ਯੁਗ, ਅਰਥਾਤ) ਸਤਿਯੁਗ ਵਿਚ ਹੋਇਆ ਕਿਹਾ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "प्रथमे सतिजुग बीच कहिजै ॥",
      "sourceLineId": "138513",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1356_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਿਹ ਜਸ ਪੁਰੀ ਚੌਦਹੂੰ ਛਾਯੋ ॥",
      "transliteration": "jeh jas puree chauadhahoo(n) chhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਯਸ਼ ਚੌਦਾ ਲੋਕਾ ਵਿਚ ਪਸਰਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1356,
      "hindi": "",
      "hindiTransliteration": "जिह जस पुरी चौदहूँ छायो ॥",
      "sourceLineId": "138514",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
