{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1357,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1357_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਰਦ ਰਿਖਿ ਤਬ ਰਾਇ ਮੰਗਾਯੋ ॥੧॥",
      "transliteration": "naaradh rikh tab rai ma(n)gaayo ||1||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਰਾਜੇ ਨੇ ਨਾਰਦ ਰਿਸ਼ੀ ਨੂੰ ਆਪਣੇ ਕੋਲ ਬੁਲਾਇਆ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "नारद रिखि तब राइ मंगायो ॥१॥",
      "sourceLineId": "138515",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਭ ਦੇਵਨ ਕੋ ਰਾਜਾ ਭਯੋ ॥",
      "transliteration": "sabh dhevan ko raajaa bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸਾਰਿਆਂ ਦੇਵਤਿਆਂ ਦਾ ਰਾਜਾ ਬਣ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "सभ देवन को राजा भयो ॥",
      "sourceLineId": "138516",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਤਿਲਕ ਆਪੁ ਤਿਹ ਦਯੋ ॥",
      "transliteration": "brahamaa tilak aap teh dhayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬ੍ਰਹਮਾ ਨੇ ਆਪ ਉਸ ਨੂੰ ਤਿਲਕ ਲਗਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "ब्रहमा तिलक आपु तिह दयो ॥",
      "sourceLineId": "138517",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਿਹਕੰਟਕ ਸੁਰ ਕਟਕ ਕਿਯਾ ਸਬ ॥",
      "transliteration": "nihaka(n)Tak sur kaTak kiyaa sab ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਸਾਰੇ ਦੇਵਤਿਆਂ ਦੇ ਦਲ ਨੂੰ (ਵੈਰੀਆਂ ਦੇ ਡਰ ਤੋਂ) ਮੁਕਤ (ਨਿਹਕੰਟਕ) ਕਰ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "निहकंटक सुर कटक किया सब ॥",
      "sourceLineId": "138518",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦਾਨਵ ਮਾਰ ਨਿਕਾਰ ਦਏ ਜਬ ॥੨॥",
      "transliteration": "dhaanav maar nikaar dhe jab ||2||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਸਾਰਿਆਂ) ਦੈਂਤਾ ਨੂੰ ਮਾਰ ਕੇ ਕਢ ਦਿੱਤਾ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "दानव मार निकार दए जब ॥२॥",
      "sourceLineId": "138519",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਰਾਜ ਬਰਖ ਬਹੁ ਕਿਯਾ ॥",
      "transliteration": "eeh bidh raaj barakh bahu kiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਉਸ ਨੇ ਬਹੁਤ ਸਾਲਾ ਤਕ ਰਾਜ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "इह बिधि राज बरख बहु किया ॥",
      "sourceLineId": "138520",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੀਰਘ ਦਾੜ ਦੈਤ ਭਵ ਲਿਯਾ ॥",
      "transliteration": "dheeragh dhaaR dhait bhav liyaa ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਦੀਰਘ ਦਾੜ੍ਰਹ ਦੈਂਤ ਨੇ ਜਨਮ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "दीरघ दाड़ दैत भव लिया ॥",
      "sourceLineId": "138521",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦਸ ਸਹਸ ਛੂਹਨਿ ਦਲ ਲੈ ਕੈ ॥",
      "transliteration": "dhas sahas chhoohan dhal lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦਸ ਹਜ਼ਾਰ ਅਛੋਹਣੀ ਦਲ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "दस सहस छूहनि दल लै कै ॥",
      "sourceLineId": "138522",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੜਿ ਆਯੋ ਤਿਹ ਊਪਰ ਤੈ ਕੈ ॥੩॥",
      "transliteration": "chaR aayo teh uoopar tai kai ||3||",
      "translation": "",
      "punjabiViakhya": "ਰੋਹ ਨਾਲ ਉਸ (ਰਾਜੇ) ਉਤੇ ਚੜ੍ਰਹ ਆਇਆ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "चड़ि आयो तिह ऊपर तै कै ॥३॥",
      "sourceLineId": "138523",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਭ ਦੇਵਨ ਐਸੇ ਸੁਨਿ ਪਾਯੋ ॥",
      "transliteration": "sabh dhevan aaise sun paayo ||",
      "translation": "",
      "punjabiViakhya": "ਸਭ ਦੇਵਤਿਆਂ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਸੁਣ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "सभ देवन ऐसे सुनि पायो ॥",
      "sourceLineId": "138524",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੀਰਘ ਦਾੜ ਦੈਤ ਚੜਿ ਆਯੋ ॥",
      "transliteration": "dheeragh dhaaR dhait chaR aayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਦੀਰਘ ਦੈਂਤ ਚੜ੍ਰਹ ਕੇ ਆ ਗਿਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "दीरघ दाड़ दैत चड़ि आयो ॥",
      "sourceLineId": "138525",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬੀਸ ਸਹਸ ਛੋਹਨਿ ਦਲ ਲਿਯੋ ॥",
      "transliteration": "bees sahas chhohan dhal liyo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਵੀ ਵੀਹ ਹਜ਼ਾਰ ਅਛੋਹਣੀ ਦਲ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "बीस सहस छोहनि दल लियो ॥",
      "sourceLineId": "138526",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਵਾ ਸੌ ਜਾਇ ਸਮਾਗਮ ਕਿਯੋ ॥੪॥",
      "transliteration": "vaa sau jai samaagam kiyo ||4||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨਾਲ ਜਾ ਕੇ ਟਾਕਰਾ ਕੀਤਾ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "वा सौ जाइ समागम कियो ॥४॥",
      "sourceLineId": "138527",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੂਰਜ ਕਹ ਸੈਨਾਪਤਿ ਕੀਨਾ ॥",
      "transliteration": "sooraj keh sainaapat keenaa ||",
      "translation": "",
      "punjabiViakhya": "(ਦੇਵਤਿਆਂ ਨੇ) ਸੂਰਜ ਨੂੰ ਸੈਨਾ-ਪਤੀ ਬਣਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "सूरज कह सैनापति कीना ॥",
      "sourceLineId": "138528",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦਹਿਨੇ ਓਰ ਚੰਦ੍ਰ ਕਹ ਦੀਨਾ ॥",
      "transliteration": "dhahine or cha(n)dhr keh dheenaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਜਾ ਪਾਸਾ ਚੰਦ੍ਰਮਾ ਨੂੰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "दहिने ओर चंद्र कह दीना ॥",
      "sourceLineId": "138529",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਾਈ ਓਰ ਕਾਰਤਿਕੇ ਧਰਾ ॥",
      "transliteration": "baiee or kaaratike dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਖੱਬੇ ਪਾਸੇ ਕਾਰਤਿਕੇਯ ਨੂੰ ਰਖਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "बाई ओर कारतिके धरा ॥",
      "sourceLineId": "138530",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਹ ਪੌਰਖ ਕਿਨਹੂੰ ਨਹਿ ਹਰਾ ॥੫॥",
      "transliteration": "jeh pauarakh kinahoo(n) neh haraa ||5||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਬਲ ਨੂੰ ਕਿਸੇ ਨੇ (ਕਦੇ) ਨਸ਼ਟ ਨਹੀਂ ਕੀਤਾ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "जिह पौरख किनहूँ नहि हरा ॥५॥",
      "sourceLineId": "138531",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਹ ਦਿਸ ਸਕਲ ਦੇਵ ਚੜਿ ਧਾਏ ॥",
      "transliteration": "eeh dhis sakal dhev chaR dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਪਾਸਿਓਾਂ ਸਾਰੇ ਦੇਵਤੇ ਚੜ੍ਰਹ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "इह दिस सकल देव चड़ि धाए ॥",
      "sourceLineId": "138532",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਉਹਿ ਦਿਸਿ ਤੇ ਦਾਨਵ ਮਿਲਿ ਆਏ ॥",
      "transliteration": "auh dhis te dhaanav mil aae ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਪਾਸੇ ਵਲੋਂ ਸਾਰੇ ਦੈਂਤ ਮਿਲ ਕੇ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "उहि दिसि ते दानव मिलि आए ॥",
      "sourceLineId": "138533",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਾਜਨ ਭਾਤਿ ਭਾਤਿ ਤਨ ਬਾਜੇ ॥",
      "transliteration": "baajan bhaat bhaat tan baaje ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਤਰ੍ਰਹਾ ਦੇ ਵਾਜੇ ਵਜਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "बाजन भाति भाति तन बाजे ॥",
      "sourceLineId": "138534",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੋਊ ਦਿਸਿਨ ਸੂਰਮਾ ਗਾਜੇ ॥੬॥",
      "transliteration": "dhouoo dhisin sooramaa gaaje ||6||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਦਿਸ਼ਾਵਾ ਵਿਚ ਸੂਰਮੇ ਗਜਣ ਲਗੇ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "दोऊ दिसिन सूरमा गाजे ॥६॥",
      "sourceLineId": "138535",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੈ ਦੈ ਢੋਲ ਬਜਾਇ ਨਗਾਰੇ ॥",
      "transliteration": "dhai dhai ddol bajai nagaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) 'ਦੈ ਦੈ' ਕਰਦੇ ਢੋਲ ਅਤੇ ਨਗਾਰੇ ਵਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "दै दै ढोल बजाइ नगारे ॥",
      "sourceLineId": "138536",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪੀ ਪੀ ਭਏ ਕੈਫ ਮਤਵਾਰੇ ॥",
      "transliteration": "pee pee bhe kaif matavaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਰਾਬ ਪੀ ਪੀ ਕੇ ਮਤਵਾਲੇ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "पी पी भए कैफ मतवारे ॥",
      "sourceLineId": "138537",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੀਸ ਸਹਸ ਛੋਹਨਿ ਦਲ ਸਾਥਾ ॥",
      "transliteration": "tees sahas chhohan dhal saathaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੀਹ ਹਜ਼ਾਰ ਅਛੋਹਣੀ ਸੈਨਾ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "तीस सहस छोहनि दल साथा ॥",
      "sourceLineId": "138538",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਨ ਦਾਰੁਨੁ ਰਾਚਾ ਜਗਨਾਥਾ ॥੭॥",
      "transliteration": "ran dhaarun raachaa jaganaathaa ||7||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮਾਤਮਾ ਨੇ ਭਿਆਨਕ ਯੁੱਧ ਮਚਾ ਦਿੱਤਾ ॥੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "रन दारुनु राचा जगनाथा ॥७॥",
      "sourceLineId": "138539",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਮਾਰੂ ਜਬ ਬਾਜੋ ॥",
      "transliteration": "bhaat bhaat maaroo jab baajo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਭਾਤ ਭਾਤ ਦੇ ਮਾਰੂ ਵਾਜੇ ਵਜਣ ਲਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "भाति भाति मारू जब बाजो ॥",
      "sourceLineId": "138540",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੀਰਘ ਦਾੜ ਦੈਤ ਰਨ ਗਾਜੋ ॥",
      "transliteration": "dheeragh dhaaR dhait ran gaajo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਦੀਰਘ ਦਾੜ੍ਰਹ ਦੈਂਤ ਰਣ ਵਿਚ ਗਜਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "दीरघ दाड़ दैत रन गाजो ॥",
      "sourceLineId": "138541",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੀਛਨ ਬਾਨ ਦੋਊ ਦਿਸਿ ਬਹਹੀ ॥",
      "transliteration": "teechhan baan dhouoo dhis bahahee ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਓਾਂ ਤੋਂ ਤਿਖੇ ਬਾਣ ਚਲ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "तीछन बान दोऊ दिसि बहही ॥",
      "sourceLineId": "138542",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾਹਿ ਲਗਤ ਤਿਹ ਮਾਝ ਨ ਰਹਹੀ ॥੮॥",
      "transliteration": "jaeh lagat teh maajh na rahahee ||8||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਜਾ ਕੇ ਲਗਦੇ, ਉਸ ਦੇ ਵਿਚ ਰਹਿੰਦੇ ਨਹੀਂ ਸਨ (ਭਾਵ-ਪਾਰ ਹੋ ਜਾਦੇ ਸਨ) ॥੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "जाहि लगत तिह माझ न रहही ॥८॥",
      "sourceLineId": "138543",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਧਾਵਤ ਭਏ ਦੇਵਤਾ ਜਬ ਹੀ ॥",
      "transliteration": "dhaavat bhe dhevataa jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੇਵਤੇ ਚੜ੍ਰਹ ਕੇ ਆ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "धावत भए देवता जब ही ॥",
      "sourceLineId": "138544",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦਾਨਵ ਭਰੇ ਰੋਸ ਤਨ ਤਬ ਹੀ ॥",
      "transliteration": "dhaanav bhare ros tan tab hee ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਦੈਂਤ ਵੀ ਰੋਹ ਨਾਲ ਭਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "दानव भरे रोस तन तब ही ॥",
      "sourceLineId": "138545",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਬਾਦਿਤ੍ਰ ਬਜਾਇ ॥",
      "transliteration": "bhaat bhaat baadhitr bajai ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਵਾਜੇ ਵਜਾਏ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "भाति भाति बादित्र बजाइ ॥",
      "sourceLineId": "138546",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਖਤ੍ਰੀ ਉਠੇ ਖਿੰਗ ਖੁਨਸਾਇ ॥੯॥",
      "transliteration": "khatree uThe khi(n)g khunasai ||9||",
      "translation": "",
      "punjabiViakhya": "ਛਤ੍ਰੀ ਘੋੜਿਆਂ ਨੂੰ ਯੁੱਧ ਲਈ ਉਤੇਜਿਤ ਕਰਨ ਲਗੇ ॥੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "खत्री उठे खिंग खुनसाइ ॥९॥",
      "sourceLineId": "138547",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚਲੇ ਬਾਨ ਦੁਹੂੰ ਓਰ ਅਪਾਰਾ ॥",
      "transliteration": "chale baan dhuhoo(n) or apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ ਬੇਹਿਸਾਬ ਬਾਣ,",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "चले बान दुहूँ ओर अपारा ॥",
      "sourceLineId": "138548",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਿਛੂਆ ਬਰਛੀ ਬਜ੍ਰ ਹਜਾਰਾ ॥",
      "transliteration": "bichhooaa barachhee bajr hajaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਬਿਛੂਏ, ਬਰਛੀਆਂ ਅਤੇ ਹਜ਼ਾਰਾ ਬਜ੍ਰ ਚਲਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "बिछूआ बरछी बज्र हजारा ॥",
      "sourceLineId": "138549",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਦਾ ਗਰਿਸਟ ਜਵਨ ਪਰ ਝਰਹੀ ॥",
      "transliteration": "gadhaa garisaT javan par jharahee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਉਤੇ ਭਾਰੀ ਗਦਾਵਾ ਵਜਦੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "गदा गरिसट जवन पर झरही ॥",
      "sourceLineId": "138550",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸ੍ਯੰਦਨ ਸਹਿਤ ਚੂਰਨ ਤਿਹ ਕਰਹੀ ॥੧੦॥",
      "transliteration": "saya(n)dhan sahit chooran teh karahee ||10||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਰਥਾ ਸਮੇਤ ਚੂਰ ਚੂਰ ਕਰ ਦਿੰਦੀਆਂ ॥੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "स्यंदन सहित चूरन तिह करही ॥१०॥",
      "sourceLineId": "138551",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾ ਕੇ ਲਗੇ ਅੰਗ ਮੈ ਬਾਨਾ ॥",
      "transliteration": "jaa ke lage a(n)g mai baanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਬਣ ਲਗਦੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "जा के लगे अंग मै बाना ॥",
      "sourceLineId": "138552",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਰਾ ਬੀਰ ਤਿਹ ਸ੍ਵਰਗ ਪਯਾਨਾ ॥",
      "transliteration": "karaa beer teh savairag payaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸੂਰਮੇ ਸਵਰਗ ਨੂੰ ਚਲੇ ਜਾਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "करा बीर तिह स्वरग पयाना ॥",
      "sourceLineId": "138553",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਚ੍ਯੋ ਬੀਰ ਖੇਤ ਬਿਕਰਾਲਾ ॥",
      "transliteration": "machayo beer khet bikaraalaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਦਾ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਭਿਆਨਕ ਯੁੱਧ ਮਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "मच्यो बीर खेत बिकराला ॥",
      "sourceLineId": "138554",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਚਤ ਭੂਤ ਪ੍ਰੇਤ ਬੇਤਾਲਾ ॥੧੧॥",
      "transliteration": "naachat bhoot pret betaalaa ||11||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੂਤ, ਪ੍ਰੇਤ ਅਤੇ ਬੈਤਾਲ ਨਚਣ ਲਗੇ ॥੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "नाचत भूत प्रेत बेताला ॥११॥",
      "sourceLineId": "138555",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਝੂਮਿ ਝੂਮਿ ਕਹੀ ਗਿਰੇ ਧਰਿਨ ਭਟ ॥",
      "transliteration": "jhoom jhoom kahee gire dharin bhaT ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਧਰੇ ਝੂਮਦੇ ਹੋਏ ਸੂਰਮੇ ਧਰਤੀ ਉਤੇ ਡਿਗੇ ਪਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "झूमि झूमि कही गिरे धरिन भट ॥",
      "sourceLineId": "138556",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੁਦੇ ਜੁਦੇ ਕਹੀ ਅੰਗ ਪਰੇ ਕਟਿ ॥",
      "transliteration": "judhe judhe kahee a(n)g pare kaT ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਧਰੇ (ਕਈਆਂ ਦੇ) ਅੰਗ ਕਟੇ ਹੋਏ ਵਖਰੇ ਵਖਰੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "जुदे जुदे कही अंग परे कटि ॥",
      "sourceLineId": "138557",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚਲੀ ਸ੍ਰੋਨ ਕੀ ਨਦੀ ਬਿਰਾਜੈ ॥",
      "transliteration": "chalee sron kee nadhee biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਦੀ ਨਦੀ ਵਗ ਰਹੀ ਸੀ, ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਬੈਤਰੁਨੀ",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "चली स्रोन की नदी बिराजै ॥",
      "sourceLineId": "138558",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬੈਤਰੁਨੀ ਜਿਨ ਕੋ ਲਖਿ ਲਾਜੈ ॥੧੨॥",
      "transliteration": "baitarunee jin ko lakh laajai ||12||",
      "translation": "",
      "punjabiViakhya": "(ਵਿਸ਼ੇਸ਼: ਪੁਰਾਣਾ ਅਨੁਸਾਰ ਯਮ-ਲੋਕ ਤੋਂ ਉਰਲੇ ਪਾਸੇ ਵਗਣ ਵਾਲੀ, ਗੰਦਗੀ ਨਾਲ ਭਰੀ ਹੋਈ ਨਦੀ ਜੋ ਦੋ ਯੋਜਨ ਚੌੜੀ ਹੈ ਅਤੇ ਜੋ ਹਿੰਦੂ ਮਤ ਅਨੁਸਾਰ ਤਰ ਕੇ ਜਾਣੀ ਹੁੰਦੀ ਹੈ। ਅਜਿਹੇ ਸਮੇਾਂ ਦਾਨ ਕੀਤੀ ਗਊ ਸਹਾਇਤਾ ਕਰਦੀ ਹੈ) ਵੀ ਸ਼ਰਮਿੰਦੀ ਹੁੰਦੀ ਸੀ ॥੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "बैतरुनी जिन को लखि लाजै ॥१२॥",
      "sourceLineId": "138559",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਇਹ ਦਿਸਿ ਅਧਿਕ ਦੇਵਤਾ ਕੋਪੇ ॥",
      "transliteration": "eeh dhis adhik dhevataa kope ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਪਾਸੇ ਦੇਵਤੇ ਬਹੁਤ ਗੁੱਸੇ ਵਿਚ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "इह दिसि अधिक देवता कोपे ॥",
      "sourceLineId": "138560",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਉਹਿ ਦਿਸਿ ਪਾਵ ਦਾਨਵਨ ਰੋਪੇ ॥",
      "transliteration": "auh dhis paav dhaanavan rope ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਪਾਸੇ ਦੈਂਤਾ ਨੇ ਪੈਰ ਗਡ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "उहि दिसि पाव दानवन रोपे ॥",
      "sourceLineId": "138561",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1357_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੁਪਿ ਕੁਪਿ ਅਧਿਕ ਹ੍ਰਿਦਨ ਮੋ ਭਿਰੇ ॥",
      "transliteration": "kup kup adhik hiradhan mo bhire ||",
      "translation": "",
      "punjabiViakhya": "ਹਿਰਦਿਆਂ ਵਿਚ ਅਧਿਕ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1357,
      "hindi": "",
      "hindiTransliteration": "कुपि कुपि अधिक हृदन मो भिरे ॥",
      "sourceLineId": "138562",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
