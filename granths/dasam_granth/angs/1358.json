{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1358,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1358_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੂਝਿ ਜੂਝਿ ਗੇ ਬਹੁਰਿ ਨ ਫਿਰੇ ॥੧੩॥",
      "transliteration": "joojh joojh ge bahur na fire ||13||",
      "translation": "",
      "punjabiViakhya": "ਜੂਝ ਜੂਝ ਕੇ (ਮਰ) ਗਏ ਅਤੇ ਫਿਰ ਨਾ ਪਰਤੇ ॥੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "जूझि जूझि गे बहुरि न फिरे ॥१३॥",
      "sourceLineId": "138563",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੋਟਿਕ ਕਟਕ ਤਹਾ ਕਟਿ ਮਰੇ ॥",
      "transliteration": "koTik kaTak tahaa kaT mare ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੇ ਸੂਰਮੇ ਉਥੇ ਕਟ ਕੇ ਮਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "कोटिक कटक तहा कटि मरे ॥",
      "sourceLineId": "138564",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੂਝੇ ਗਿਰੇ ਬਰੰਗਨਿਨ ਬਰੇ ॥",
      "transliteration": "joojhe gire bara(n)ganin bare ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਜੂਝ ਕੇ ਡਿਗ ਪਏ ਅਤੇ (ਉਨ੍ਰਹਾ ਨਾਲ) ਪਰੀਆਂ ਨੇ ਵਿਆਹ ਕਰਵਾ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "जूझे गिरे बरंगनिन बरे ॥",
      "sourceLineId": "138565",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦੋਊ ਦਿਸਿ ਮਰੇ ਕਾਲ ਕੇ ਪ੍ਰੇਰੇ ॥",
      "transliteration": "dhouoo dhis mare kaal ke prere ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਦੇ ਪ੍ਰੇਰੇ ਹੋਏ ਸੂਰਮੇ ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ ਮਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "दोऊ दिसि मरे काल के प्रेरे ॥",
      "sourceLineId": "138566",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਿਰੇ ਭੂਮਿ ਰਨ ਫਿਰੇ ਨ ਫੇਰੇ ॥੧੪॥",
      "transliteration": "gire bhoom ran fire na fere ||14||",
      "translation": "",
      "punjabiViakhya": "(ਸ਼ੂਰਵੀਰ) ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਏ ਅਤੇ ਫਿਰ ਨਹੀਂ ਪਰਤੇ ॥੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "गिरे भूमि रन फिरे न फेरे ॥१४॥",
      "sourceLineId": "138567",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਤਿ ਸੰਧਿ ਦੇਵਿਸ ਇਤ ਧਾਯੋ ॥",
      "transliteration": "sat sa(n)dh dhevis it dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਪਾਸੇ ਤੋਂ ਦੇਵਤਿਆਂ ਦਾ ਸੁਆਮੀ ਸਤਿ ਸੰਧਿ ਚੜ੍ਰਹ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "सति संधि देविस इत धायो ॥",
      "sourceLineId": "138568",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੀਰਘ ਦਾੜ ਉਹ ਓਰ ਰਿਸਾਯੋ ॥",
      "transliteration": "dheeragh dhaaR uh or risaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਪਾਸੇ ਤੋਂ ਦੀਰਘ ਦਾੜ੍ਰਹ ਰੋਹ ਵਿਚ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "दीरघ दाड़ उह ओर रिसायो ॥",
      "sourceLineId": "138569",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਜ੍ਰ ਬਾਣ ਬਿਛੂਆ ਕੈ ਕੈ ਬ੍ਰਣ ॥",
      "transliteration": "bajr baan bichhooaa kai kai bran ||",
      "translation": "",
      "punjabiViakhya": "ਬਜ੍ਰ ਬਾਣਾ ਅਤੇ ਬਿਛੂਆਂ ਨਾਲ ਘਾਇਲ ਸ਼ੂਰਵੀਰ",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "बज्र बाण बिछूआ कै कै ब्रण ॥",
      "sourceLineId": "138570",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੂਝਿ ਜੂਝਿ ਭਟ ਗਿਰਤ ਭਏ ਰਣ ॥੧੫॥",
      "transliteration": "joojh joojh bhaT girat bhe ran ||15||",
      "translation": "",
      "punjabiViakhya": "ਜੂਝ ਜੂਝ ਕੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਡਿਗ ਰਹੇ ਸਨ ॥੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "जूझि जूझि भट गिरत भए रण ॥१५॥",
      "sourceLineId": "138571",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੋਗਿਨਿ ਜਛ ਕਹੂੰ ਹਰਖਏ ॥",
      "transliteration": "jogin jachh kahoo(n) harakhe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਜੋਗਣਾ ਅਤੇ ਯਕਸ਼ ਖ਼ੁਸ਼ ਹੋ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "जोगिनि जछ कहूँ हरखए ॥",
      "sourceLineId": "138572",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭੂਤ ਪ੍ਰੇਤ ਨਾਚਤ ਕਹੂੰ ਭਏ ॥",
      "transliteration": "bhoot pret naachat kahoo(n) bhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਭੂਤ-ਪ੍ਰੇਤ ਨਚ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "भूत प्रेत नाचत कहूँ भए ॥",
      "sourceLineId": "138573",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਹ ਕਹ ਕਹ ਕਲਿ ਹਾਸ ਸੁਨਾਵਤ ॥",
      "transliteration": "keh keh keh kal haas sunaavat ||",
      "translation": "",
      "punjabiViakhya": "ਕਲ ('ਕਲਿ') 'ਕਹ ਕਹ' ਕਰ ਕੇ ਕਿਲਕਾਰੀਆਂ ਸੁਣਾ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "कह कह कह कलि हास सुनावत ॥",
      "sourceLineId": "138574",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭੀਖਨ ਸੁਨੈ ਸਬਦ ਭੈ ਆਵਤ ॥੧੬॥",
      "transliteration": "bheekhan sunai sabadh bhai aavat ||16||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਭਿਆਨਕ ਆਵਾਜ਼ ਸੁਣ ਕੇ ਡਰ ਲਗਦਾ ਸੀ ॥੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "भीखन सुनै सबद भै आवत ॥१६॥",
      "sourceLineId": "138575",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਫਿਰੈਂ ਦੈਤ ਕਹੂੰ ਦਾਤ ਨਿਕਾਰੇ ॥",
      "transliteration": "firai(n) dhait kahoo(n) dhaat nikaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਦੈਂਤ ਦੰਦ ਕਢੀ ਫਿਰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "फिरैं दैत कहूँ दात निकारे ॥",
      "sourceLineId": "138576",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਮਤ ਸ੍ਰੋਨ ਕੇਤੇ ਰਨ ਮਾਰੇ ॥",
      "transliteration": "bamat sron kete ran maare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ (ਸੂਰਮੇ) ਰਣ ਵਿਚ ਮਾਰੇ ਹੋਏ ਲਹੂ ਦੀਆਂ ਉਲਟੀਆਂ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "बमत स्रोन केते रन मारे ॥",
      "sourceLineId": "138577",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਹੂੰ ਸਿਵਾ ਸਾਮੁਹਿ ਫਿਕਰਾਹੀ ॥",
      "transliteration": "kahoo(n) sivaa saamuh fikaraahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਗਿਦੜੀ ਸਾਹਮਣੇ ਹੋ ਕੇ ਬੋਲ ਰਹੀ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "कहूँ सिवा सामुहि फिकराही ॥",
      "sourceLineId": "138578",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭੂਤ ਪਿਸਾਚ ਮਾਸ ਕਹੂੰ ਖਾਹੀ ॥੧੭॥",
      "transliteration": "bhoot pisaach maas kahoo(n) khaahee ||17||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਭੂਤ ਤੇ ਪਿਸ਼ਾਚ ਮਾਸ ਨੂੰ ਖਾ ਰਹੇ ਸਨ ॥੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "भूत पिसाच मास कहूँ खाही ॥१७॥",
      "sourceLineId": "138579",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਕਟਾਬ੍ਰਯੂਹ ਰਚਾ ਸੁਰ ਪਤਿ ਤਬ ॥",
      "transliteration": "sakaTaabrayooh rachaa sur pat tab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੈਂਤਾ ਦੇ ਰਾਜੇ ਨੇ 'ਕ੍ਰੈਚਾਬ੍ਰਯੂਹ' (ਅਰਥਾਤ ਕ੍ਰੌਂਚ-ਸਾਰਸ ਦੀ ਸ਼ਕਲ ਦਾ ਫ਼ੌਜੀ ਘੇਰਾ) ਬਣਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "सकटाब्रयूह रचा सुर पति तब ॥",
      "sourceLineId": "138580",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕ੍ਰੌਚਾਬ੍ਰਯੂਹ ਕਿਯੋ ਅਸੁਰਿਸ ਜਬ ॥",
      "transliteration": "krauachaabrayooh kiyo asuris jab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੇਵਤਿਆਂ ਦੇ ਸੁਆਮੀ ਨੇ 'ਸਕਟਾਬ੍ਰਯੂਹ' (ਅਰਥਾਤ-ਯੁੱਧ ਵਿਚ ਗੱਡੇ ਦੇ ਸਰੂਪ ਵਰਗੀ ਆਯੋਜਿਤ ਸੈਨਿਕ ਟੁਕੜੀ) ਦੀ ਰਚਨਾ ਕੀਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "क्रौचाब्रयूह कियो असुरिस जब ॥",
      "sourceLineId": "138581",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਚਿਯੋ ਤੁਮਲ ਜੁਧ ਤਹ ਭਾਰੀ ॥",
      "transliteration": "machiyo tumal judh teh bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਹੁਤ ਘਮਸਾਨ ਯੁੱਧ ਮਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "मचियो तुमल जुध तह भारी ॥",
      "sourceLineId": "138582",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗਰਜਤ ਭਏ ਬੀਰ ਬਲ ਧਾਰੀ ॥੧੮॥",
      "transliteration": "garajat bhe beer bal dhaaree ||18||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਲਵਾਨ ਸੂਰਮੇ ਗਜਣ ਲਗੇ ॥੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "गरजत भए बीर बल धारी ॥१८॥",
      "sourceLineId": "138583",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੂਝਿ ਗਏ ਜੋਧਾ ਕਹੀ ਭਾਰੇ ॥",
      "transliteration": "joojh ge jodhaa kahee bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਵੱਡੇ ਵੱਡੇ ਯੋਧੇ ਜੂਝ ਮੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "जूझि गए जोधा कही भारे ॥",
      "sourceLineId": "138584",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੇਵ ਗਿਰੇ ਦਾਨਵ ਕਹੀ ਮਾਰੇ ॥",
      "transliteration": "dhev gire dhaanav kahee maare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਦੇਵਤੇ ਅਤੇ ਕਿਤੇ ਦੈਂਤ ਮਾਰੇ ਹੋਏ ਡਿਗੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "देव गिरे दानव कही मारे ॥",
      "sourceLineId": "138585",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬੀਰ ਖੇਤ ਐਸਾ ਤਹ ਪਰਾ ॥",
      "transliteration": "beer khet aaisaa teh paraa ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਇਤਨੇ ਸੂਰਮੇ ਡਿਗੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "बीर खेत ऐसा तह परा ॥",
      "sourceLineId": "138586",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੋਊ ਦਿਸਿ ਇਕ ਸੁਭਟ ਨ ਉਬਰਾ ॥੧੯॥",
      "transliteration": "dhouoo dhis ik subhaT na ubaraa ||19||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਦੋਹਾ ਪਾਸੇ ਇਕ ਵੀ ਸੂਰਮਾ ਨਹੀਂ ਬਚਿਆ ਸੀ ॥੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "दोऊ दिसि इक सुभट न उबरा ॥१९॥",
      "sourceLineId": "138587",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੌ ਕ੍ਰਮ ਕ੍ਰਮ ਕਰਿ ਕਥਾ ਸੁਨਾਊਾਂ ॥",
      "transliteration": "jau kram kram kar kathaa sunaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਮੈਂ ਸਿਲਸਿਲੇਵਾਰ ਕਥਾ ਸੁਣਾਵਾ",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "जौ क्रम क्रम करि कथा सुनाऊाँ ॥",
      "sourceLineId": "138588",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਅਧਿਕ ਡਰਾਊਾਂ ॥",
      "transliteration": "gra(n)th baddan te adhik ddaraauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਗ੍ਰੰਥ ਦੇ ਵੱਡੇ ਹੋ ਜਾਣ ਕਰ ਕੇ ਡਰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "ग्रंथ बढन ते अधिक डराऊाँ ॥",
      "sourceLineId": "138589",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੀਸ ਸਹਸ ਛੂਹਨਿ ਜਹ ਜੋਧਾ ॥",
      "transliteration": "tees sahas chhoohan jeh jodhaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਤੀਹ ਹਜ਼ਾਰ ਅਛੋਹਣੀ ਯੋਧੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "तीस सहस छूहनि जह जोधा ॥",
      "sourceLineId": "138590",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੰਡ੍ਰਯੋ ਬੀਰ ਖੇਤ ਕਰਿ ਕ੍ਰੋਧਾ ॥੨੦॥",
      "transliteration": "ma(n)ddrayo beer khet kar krodhaa ||20||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਸਾਰਿਆਂ ਨੇ) ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਯੁੱਧ ਮਚਾਇਆ ਸੀ ॥੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "मंड्रयो बीर खेत करि क्रोधा ॥२०॥",
      "sourceLineId": "138591",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਤਿਅਨ ਸੋ ਪਤੀਅਨ ਭਿਰਿ ਮਰੇ ॥",
      "transliteration": "patian so pateean bhir mare ||",
      "translation": "",
      "punjabiViakhya": "ਸੈਨਾਪਤੀਆਂ ਨਾਲ ਸੈਨਾਪਤੀ ਲੜ ਕੇ ਮਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "पतिअन सो पतीअन भिरि मरे ॥",
      "sourceLineId": "138592",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸ੍ਵਾਰਨ ਕੇ ਸ੍ਵਾਰਨ ਛੈ ਕਰੇ ॥",
      "transliteration": "savaiaaran ke savaiaaran chhai kare ||",
      "translation": "",
      "punjabiViakhya": "ਸਵਾਰਾ ਨੇ ਸਵਾਰਾ ਨੂੰ ਨਸ਼ਟ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "स्वारन के स्वारन छै करे ॥",
      "sourceLineId": "138593",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰਥਿਯਨ ਤਹ ਰਥਿਯਨ ਕੌ ਘਾਯੋ ॥",
      "transliteration": "rathiyan teh rathiyan kau ghaayo ||",
      "translation": "",
      "punjabiViakhya": "ਰਥਾ ਵਾਲਿਆਂ ਨੇ ਰਥਾ ਵਾਲਿਆਂ ਨੂੰ ਮਾਰ ਮੁਕਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "रथियन तह रथियन कौ घायो ॥",
      "sourceLineId": "138594",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਾਥਿਨ ਦੰਤੀ ਸ੍ਵਰਗ ਪਠਾਯੋ ॥੨੧॥",
      "transliteration": "haathin dha(n)tee savairag paThaayo ||21||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀਆਂ ਨੇ ਹਾਥੀਆਂ ਨੂੰ ਸਵਰਗ ਭੇਜ ਦਿੱਤਾ ॥੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "हाथिन दंती स्वरग पठायो ॥२१॥",
      "sourceLineId": "138595",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦਲਪਤਿ ਸੌ ਦਲਪਤਿ ਲਰਿ ਮੂਆ ॥",
      "transliteration": "dhalapat sau dhalapat lar mooaa ||",
      "translation": "",
      "punjabiViakhya": "ਦਲਪਤੀਆਂ ਨਾਲ ਦਲਪਤੀ ਲੜ ਮੋਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "दलपति सौ दलपति लरि मूआ ॥",
      "sourceLineId": "138596",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਨਾਸ ਕਟਕ ਕਾ ਹੂਆ ॥",
      "transliteration": "eeh bidh naas kaTak kaa hooaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ (ਸਾਰੀ) ਸੈਨਾ ਦਾ ਨਾਸ਼ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "इह बिधि नास कटक का हूआ ॥",
      "sourceLineId": "138597",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਚੇ ਭੂਪ ਤੇ ਕੋਪ ਬਡਾਈ ॥",
      "transliteration": "bache bhoop te kop baddaiee ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਹੜੇ) ਰਾਜੇ ਬਚੇ ਸਨ, ਉਨ੍ਰਹਾ ਨੇ ਕ੍ਰੋਧ ਵਧਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "बचे भूप ते कोप बडाई ॥",
      "sourceLineId": "138598",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਾਡਤ ਭੇ ਹਠ ਠਾਨਿ ਲਰਾਈ ॥੨੨॥",
      "transliteration": "maaddat bhe haTh Thaan laraiee ||22||",
      "translation": "",
      "punjabiViakhya": "ਹਠ ਪੂਰਵਕ ਲੜਾਈ ਕਰਨ ਲਗ ਗਏ ॥੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "माडत भे हठ ठानि लराई ॥२२॥",
      "sourceLineId": "138599",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਨ ਮਾਡਤ ਭੇ ਬਿਬਿਧ ਪ੍ਰਕਾਰਾ ॥",
      "transliteration": "ran maaddat bhe bibidh prakaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤਾ ਦਾ ਰਾਜਾ ਅਤੇ ਦੇਵਤਿਆਂ ਦਾ ਸੁਆਮੀ",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "रन माडत भे बिबिध प्रकारा ॥",
      "sourceLineId": "138600",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੈਤ ਰਾਟ ਅਰੁ ਦੇਵ ਨ੍ਰਿਪਾਰਾ ॥",
      "transliteration": "dhait raaT ar dhev nirapaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਤਰੀਕਿਆਂ ਨਾਲ ਯੁੱਧ ਕਰਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "दैत राट अरु देव नृपारा ॥",
      "sourceLineId": "138601",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਸਨਾ ਇਤੀ ਨ ਭਾਖ ਸੁਨਾਊਾਂ ॥",
      "transliteration": "rasanaa itee na bhaakh sunaauooaa(n) ||",
      "translation": "",
      "punjabiViakhya": "ਮੇਰੀ ਜੀਭ ਵਿਚ ਇਤਨੀ ਸਮਰਥ ਨਹੀਂ ਹੈ ਕਿ (ਸਭ ਦਾ) ਵਰਣਨ ਕਰ ਸਕਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "रसना इती न भाख सुनाऊाँ ॥",
      "sourceLineId": "138602",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਅਤਿ ਡਰਪਾਊਾਂ ॥੨੩॥",
      "transliteration": "gra(n)th baddan te at ddarapaauooaa(n) ||23||",
      "translation": "",
      "punjabiViakhya": "ਗ੍ਰੰਥ ਦੇ ਵੱਡਾ ਹੋ ਜਾਣ ਤੋਂ ਵੀ ਡਰਦਾ ਹਾ ॥੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "ग्रंथ बढन ते अति डरपाऊाँ ॥२३॥",
      "sourceLineId": "138603",
      "sourceShabadId": "12768",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g prayaat chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਪ੍ਰਯਾਤ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "भुजंग प्रयात छंद ॥",
      "sourceLineId": "138604",
      "sourceShabadId": "12769",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹਾ ਲੌ ਬਖਾਨੌ ਮਹਾ ਲੋਹ ਮਚਿਯੋ ॥",
      "transliteration": "kahaa lau bakhaanau mahaa loh machiyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਥੋਂ ਤਕ ਵਰਣਨ ਕਰਾ, (ਉਥੇ) ਬਹੁਤ ਘਮਸਾਨ ਯੁੱਧ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "कहा लौ बखानौ महा लोह मचियो ॥",
      "sourceLineId": "138605",
      "sourceShabadId": "12769",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੁਹੂੰ ਓਰ ਤੇ ਬੀਰ ਏਕੈ ਨ ਬਚਿਯੋ ॥",
      "transliteration": "dhuhoo(n) or te beer ekai na bachiyo ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ ਇਕ ਯੋਧਾ ਵੀ ਨਾ ਬਚਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "दुहूँ ओर ते बीर एकै न बचियो ॥",
      "sourceLineId": "138606",
      "sourceShabadId": "12769",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਬੈ ਆਨਿ ਜੂਟੇ ਦੋਊ ਛਤ੍ਰਧਾਰੀ ॥",
      "transliteration": "tabai aan jooTe dhouoo chhatradhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੋਵੇਾਂ ਛਤ੍ਰਧਾਰੀ ਆ ਕੇ (ਆਪਸ ਵਿਚ) ਜੁਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "तबै आनि जूटे दोऊ छत्रधारी ॥",
      "sourceLineId": "138607",
      "sourceShabadId": "12769",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪਰਾ ਲੋਹ ਗਾੜੋ ਕੰਪੀ ਭੂਮਿ ਸਾਰੀ ॥੨੪॥",
      "transliteration": "paraa loh gaaRo ka(n)pee bhoom saaree ||24||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਭਾਰਾ ਯੁੱਧ ਹੋਇਆ ਅਤੇ ਸਾਰੀ ਧਰਤੀ ਕੰਬਣ ਲਗ ਗਈ ॥੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "परा लोह गाड़ो कंपी भूमि सारी ॥२४॥",
      "sourceLineId": "138608",
      "sourceShabadId": "12769",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੁਟੇ ਰਾਵ ਦੋਊ ਉਠੀ ਧੂਰਿ ਐਸੀ ॥",
      "transliteration": "juTe raav dhouoo uThee dhoor aaisee ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਵੇਾਂ ਰਾਜੇ (ਆਪਸ ਵਿਚ) ਭਿੜ ਗਏ ਅਤੇ ਅਜਿਹੀ ਧੂੜ ਉਡੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "जुटे राव दोऊ उठी धूरि ऐसी ॥",
      "sourceLineId": "138609",
      "sourceShabadId": "12769",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1358_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪ੍ਰਲੈ ਕਾਲ ਕੀ ਅਗਨਿ ਕੀ ਧੂਮ੍ਰ ਜੈਸੀ ॥",
      "transliteration": "pralai kaal kee agan kee dhoomr jaisee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਹੋ ਜਿਹਾ ਪਰਲੋ ਦੇ ਸਮੇਾਂ ਦੀ ਅਗਨੀ ਦਾ ਧੂੰਆਂ ਹੁੰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1358,
      "hindi": "",
      "hindiTransliteration": "प्रलै काल की अगनि की धूम्र जैसी ॥",
