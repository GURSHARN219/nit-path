{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1360,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1360_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਾਜੇ ਸਸਤ੍ਰ ਚੰਚਲਾ ਤਬ ਹੀ ॥",
      "transliteration": "saaje sasatr cha(n)chalaa tab hee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਬਾਲਾ ਨੇ ਸ਼ਸਤ੍ਰ ਸਜਾ ਲਏ",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "साजे ससत्र चंचला तब ही ॥",
      "sourceLineId": "138659",
      "sourceShabadId": "12773",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਨ ਕੌ ਚਲੀ ਸਾਥ ਲੈ ਸਬ ਹੀ ॥੩੬॥",
      "transliteration": "ran kau chalee saath lai sab hee ||36||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਨੂੰ ਨਾਲ ਲੈ ਕੇ ਯੁੱਧ ਲਈ ਚਲ ਪਈ ॥੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "रन कौ चली साथ लै सब ही ॥३६॥",
      "sourceLineId": "138660",
      "sourceShabadId": "12773",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "138661",
      "sourceShabadId": "12774",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਹਾ ਸਤ੍ਰੁ ਕੋ ਪੁਰ ਹੁਤੋ ਤਿਤ ਕਹ ਕਿਯਾ ਪਯਾਨ ॥",
      "transliteration": "jahaa satr ko pur huto tit keh kiyaa payaan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਧਰ ਵੈਰੀ ਦਾ ਨਗਰ ਸੀ, ਉਧਰ ਨੂੰ ਚਲ ਪਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "जहा सत्रु को पुर हुतो तित कह किया पयान ॥",
      "sourceLineId": "138662",
      "sourceShabadId": "12774",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਿਕਟ ਅਸੁਰ ਕੋ ਬੇੜਿ ਗੜ ਦਹਦਿਸ ਦਿਯੋ ਨਿਸਾਨ ॥੩੭॥",
      "transliteration": "bikaT asur ko beR gaR dhahadhis dhiyo nisaan ||37||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦੈਂਤ ਦੇ ਦ੍ਰਿੜ੍ਰਹ ਕਿਲ੍ਰਹੇ ਨੂੰ ਘੇਰ ਕੇ ਦਸਾ ਦਿਸ਼ਾਵਾ ਤੋਂ ਨਗਾਰੇ ਵਜਾ ਦਿੱਤੇ ॥੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "बिकट असुर को बेड़ि गड़ दहदिस दियो निसान ॥३७॥",
      "sourceLineId": "138663",
      "sourceShabadId": "12774",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "138664",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੁੰਦਭਿ ਸੁਨਾ ਸ੍ਰਵਨ ਮਹਿ ਜਬ ਹੀ ॥",
      "transliteration": "dhu(n)dhabh sunaa sravan meh jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਦੈਂਤ ਨੇ ਨਗਾਰਿਆਂ ਦੀ ਆਵਾਜ਼ ਕੰਨਾ ਨਾਲ ਸੁਣੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "दुँदभि सुना स्रवन महि जब ही ॥",
      "sourceLineId": "138665",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਾਗਾ ਅਸੁਰ ਕੋਪ ਕਰਿ ਤਬ ਹੀ ॥",
      "transliteration": "jaagaa asur kop kar tab hee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਜਾਗ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "जागा असुर कोप करि तब ही ॥",
      "sourceLineId": "138666",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਐਸਾ ਕਵਨ ਜੁ ਹਮ ਪਰ ਆਯੋ ॥",
      "transliteration": "aaisaa kavan ju ham par aayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਜਿਹਾ ਕੌਣ ਹੈ ਜੋ ਮੇਰੇ ਉਤੇ ਚੜ੍ਰਹ ਆਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "ऐसा कवन जु हम पर आयो ॥",
      "sourceLineId": "138667",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਕਤ ਬਿੰਦ ਮੈ ਰਨਹਿ ਹਰਾਯੋ ॥੩੮॥",
      "transliteration": "rakat bi(n)dh mai raneh haraayo ||38||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਤਾ ਰਕਤ ਬਿੰਦ (ਰਕਤ ਬੀਜ) ਨੂੰ ਵੀ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਹਰਾ ਦਿੱਤਾ ਸੀ ॥੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "रकत बिंद मै रनहि हरायो ॥३८॥",
      "sourceLineId": "138668",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇੰਦ੍ਰ ਚੰਦ੍ਰ ਸੂਰਜ ਹਮ ਜੀਤਾ ॥",
      "transliteration": "ei(n)dhr cha(n)dhr sooraj ham jeetaa ||",
      "translation": "",
      "punjabiViakhya": "ਮੈਂ ਇੰਦਰ, ਚੰਦ੍ਰਮਾ ਅਤੇ ਸੂਰਜ ਨੂੰ ਜਿਤਿਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "इंद्र चंद्र सूरज हम जीता ॥",
      "sourceLineId": "138669",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਵਨ ਜਿਤਾ ਹਰੀ ਜਿਨ ਸੀਤਾ ॥",
      "transliteration": "raavan jitaa haree jin seetaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਸ) ਰਾਵਣ ਨੂੰ ਵੀ ਜਿਤਿਆ ਹੈ ਜਿਸ ਨੇ ਸੀਤਾ ਹਰੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "रावन जिता हरी जिन सीता ॥",
      "sourceLineId": "138670",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਏਕ ਦਿਵਸ ਮੋ ਸੌ ਸਿਵ ਲਰਾ ॥",
      "transliteration": "ek dhivas mo sau siv laraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਦਿਨ ਸ਼ਿਵ ਵੀ ਮੇਰੇ ਨਾਲ ਲੜਿਆ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "एक दिवस मो सौ सिव लरा ॥",
      "sourceLineId": "138671",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾਹਿ ਭਜਾਯੋ ਮੈ ਨਹਿ ਟਰਾ ॥੩੯॥",
      "transliteration": "taeh bhajaayo mai neh Taraa ||39||",
      "translation": "",
      "punjabiViakhya": "(ਤਾ) ਮੈਂ ਉਸ ਨੂੰ ਵੀ ਭਜਾ ਦਿੱਤਾ ਸੀ। (ਅਤੇ ਆਪ) ਟਲਿਆ ਨਹੀਂ ਸਾ ॥੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "ताहि भजायो मै नहि टरा ॥३९॥",
      "sourceLineId": "138672",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਸਤ੍ਰ ਸਾਜ ਦਾਨਵ ਰਨ ਆਵਾ ॥",
      "transliteration": "sasatr saaj dhaanav ran aavaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦੈਂਤ ਸ਼ਸਤ੍ਰ ਸਜਾ ਕੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "ससत्र साज दानव रन आवा ॥",
      "sourceLineId": "138673",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਮਿਤ ਕੋਪ ਕਰਿ ਸੰਖ ਬਜਾਵਾ ॥",
      "transliteration": "amit kop kar sa(n)kh bajaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਸੀਮ ਕ੍ਰੋਧ ਕਰ ਕੇ ਸੰਖ ਵਜਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "अमित कोप करि संख बजावा ॥",
      "sourceLineId": "138674",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਾਪੀ ਭੂਮ ਗਗਨ ਘਹਰਾਨਾ ॥",
      "transliteration": "kaapee bhoom gagan ghaharaanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਵੇਲੇ) ਧਰਤੀ ਕੰਬ ਗਈ ਅਤੇ ਆਕਾਸ਼ ਗਰਜਣ ਲਗ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "कापी भूम गगन घहराना ॥",
      "sourceLineId": "138675",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਤੁਲ ਬੀਰਜ ਕਿਹ ਓਰ ਰਿਸਾਨਾ ॥੪੦॥",
      "transliteration": "atul beeraj keh or risaanaa ||40||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਅਤੁਲ ਬੀਰਜ (ਸ੍ਵਾਸ ਬੀਰਜ) ਕਿਸ ਪਾਸੇ ਵਲ ਕ੍ਰੋਧਿਤ ਹੋਇਆ ਹੈ ॥੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "अतुल बीरज किह ओर रिसाना ॥४०॥",
      "sourceLineId": "138676",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਇਤਿ ਦਿਸਿ ਦੂਲਹ ਦੇਈ ਕੁਮਾਰੀ ॥",
      "transliteration": "eit dhis dhooleh dheiee kumaaree ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਪਾਸੇ ਤੋਂ ਕੁਮਾਰੀ ਦੂਲਹ ਦੇਈ",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "इति दिसि दूलह देई कुमारी ॥",
      "sourceLineId": "138677",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਸਤ੍ਰ ਸਾਜਿ ਰਥਿ ਕਰੀ ਸਵਾਰੀ ॥",
      "transliteration": "sasatr saaj rath karee savaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਬਾਲਾ) ਵੀ ਸ਼ਸਤ੍ਰ ਸਜਾ ਕੇ ਰਥ ਉਤੇ ਚੜ੍ਰਹ ਬੈਠੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "ससत्र साजि रथि करी सवारी ॥",
      "sourceLineId": "138678",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਸਤ੍ਰਨ ਕਰਿ ਪ੍ਰਨਾਮ ਤਿਹ ਕਾਲਾ ॥",
      "transliteration": "sasatran kar pranaam teh kaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਵੇਲੇ ਸ਼ਸਤ੍ਰਾ ਨੂੰ ਪ੍ਰਨਾਮ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "ससत्रन करि प्रनाम तिह काला ॥",
      "sourceLineId": "138679",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਛਾਡਤ ਭੀ ਰਨ ਬਿਸਿਖ ਕਰਾਲਾ ॥੪੧॥",
      "transliteration": "chhaaddat bhee ran bisikh karaalaa ||41||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਣ-ਭੂਮੀ ਵਿਚ ਵਿਕਰਾਲ ਬਾਣ ਛਡਣ ਲਗੀ ॥੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "छाडत भी रन बिसिख कराला ॥४१॥",
      "sourceLineId": "138680",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਲਗੇ ਬਿਸਿਖ ਜਬ ਅੰਗ ਕਰਾਰੇ ॥",
      "transliteration": "lage bisikh jab a(n)g karaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਦੈਂਤਾ ਦੇ) ਸ਼ਰੀਰ ਵਿਚ ਕਰੜੇ ਬਾਣ ਵਜੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "लगे बिसिख जब अंग करारे ॥",
      "sourceLineId": "138681",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦਾਨਵ ਭਰੇ ਕੋਪ ਤਬ ਭਾਰੇ ॥",
      "transliteration": "dhaanav bhare kop tab bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੈਂਤ ਰੋਹ ਨਾਲ ਭਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "दानव भरे कोप तब भारे ॥",
      "sourceLineId": "138682",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੁਖ ਤੇ ਸ੍ਵਾਸ ਸ੍ਰਮਿਤ ਹ੍ਵੈ ਕਾਢੇ ॥",
      "transliteration": "mukh te savaiaas sramit havai kaadde ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਉਹ ਥਕ ਕੇ ਮੂੰਹ ਤੋਂ ਸ੍ਵਾਸ ਕਢਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "मुख ते स्वास स्रमित ह्वै काढे ॥",
      "sourceLineId": "138683",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਿਨ ਤੇ ਅਮਿਤ ਅਸੁਰ ਰਨ ਬਾਢੇ ॥੪੨॥",
      "transliteration": "tin te amit asur ran baadde ||42||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਨ੍ਰਹਾ ਤੋਂ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਅਣਗਿਣਤ ਦੈਂਤ ਵੱਧ ਜਾਦੇ ॥੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "तिन ते अमित असुर रन बाढे ॥४२॥",
      "sourceLineId": "138684",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਿਨ ਕਾ ਬਾਲ ਬਹੁਰਿ ਬਧ ਕਰਾ ॥",
      "transliteration": "tin kaa baal bahur badh karaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬਾਲਾ ਨੇ ਉਨ੍ਰਹਾ ਦਾ ਬਧ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "तिन का बाल बहुरि बध करा ॥",
      "sourceLineId": "138685",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਉਨ ਕਾ ਸ੍ਰੋਨ ਪ੍ਰਿਥੀ ਪਰ ਪਰਾ ॥",
      "transliteration": "aun kaa sron pirathee par paraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦਾ ਲਹੂ ਧਰਤੀ ਉਤੇ ਡਿਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "उन का स्रोन पृथी पर परा ॥",
      "sourceLineId": "138686",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਗਨਿਤ ਬਢੇ ਤਬੈ ਤਹ ਦਾਨਵ ॥",
      "transliteration": "aganit badde tabai teh dhaanav ||",
      "translation": "",
      "punjabiViakhya": "ਤਦੋਂ ਉਥੇ ਹੋਰ ਬੇਸ਼ੁਮਾਰ ਦੈਂਤ ਵੱਧ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "अगनित बढे तबै तह दानव ॥",
      "sourceLineId": "138687",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਛਤ ਭਏ ਪਕਰਿ ਕਰਿ ਮਾਨਵ ॥੪੩॥",
      "transliteration": "bhachhat bhe pakar kar maanav ||43||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਮਨੁੱਖਾ ਨੂੰ ਪਕੜ ਪਕੜ ਕੇ ਖਾਣ ਲਗੇ ॥੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "भछत भए पकरि करि मानव ॥४३॥",
      "sourceLineId": "138688",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਬ ਅਬਲਾ ਕੇ ਸੁਭਟ ਚਬਾਏ ॥",
      "transliteration": "jab abalaa ke subhaT chabaae ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ (ਉਨ੍ਰਹਾ ਦੈਂਤਾ ਨੇ) ਅਬਲਾ ਦੇ ਸੂਰਮਿਆਂ ਨੂੰ ਚਬਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "जब अबला के सुभट चबाए ॥",
      "sourceLineId": "138689",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੂਲਹ ਦੇ ਤਿਹ ਬਿਸਿਖ ਲਗਾਏ ॥",
      "transliteration": "dhooleh dhe teh bisikh lagaae ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਦੂਲਹ ਦੇਈ ਨੇ ਉਨ੍ਰਹਾ ਨੂੰ ਬਾਣ ਮਾਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "दूलह दे तिह बिसिख लगाए ॥",
      "sourceLineId": "138690",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬੁੰਦਕਾ ਪਰਤ ਸ੍ਰੋਨ ਭੂਅ ਭਏ ॥",
      "transliteration": "bu(n)dhakaa parat sron bhooa bhe ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਲਹੂ ਦੀਆਂ ਬੂੰਦਾ ਧਰਤੀ ਉਤੇ ਪਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "बुँदका परत स्रोन भूअ भए ॥",
      "sourceLineId": "138691",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਉਪਜਿ ਅਸੁਰ ਸਾਮਹਿ ਉਠਿ ਧਏ ॥੪੪॥",
      "transliteration": "aupaj asur saameh uTh dhe ||44||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਵਿਚੋਂ) ਹੋਰ ਦੈਂਤ ਪੈਦਾ ਹੋ ਕੇ ਸਾਹਮਣੇ ਪਾਸਿਓਾਂ ਆ ਪਏ ॥੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "उपजि असुर सामहि उठि धए ॥४४॥",
      "sourceLineId": "138692",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪੁਨਿ ਅਬਲਾ ਤਿਨ ਬਿਸਿਖ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "pun abalaa tin bisikh prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਬਲਾ ਨੇ ਉਨ੍ਰਹਾ ਨੂੰ ਫਿਰ ਬਾਣ ਮਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "पुनि अबला तिन बिसिख प्रहारे ॥",
      "sourceLineId": "138693",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚਲੇ ਸ੍ਰੋਨ ਕੇ ਤਹਾ ਪਨਾਰੇ ॥",
      "transliteration": "chale sron ke tahaa panaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਥੇ ਲਹੂ ਦੇ ਪਰਨਾਲੇ ਚਲ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "चले स्रोन के तहा पनारे ॥",
      "sourceLineId": "138694",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਸੁਰ ਅਨੰਤ ਤਹਾ ਤੇ ਜਾਗੇ ॥",
      "transliteration": "asur ana(n)t tahaa te jaage ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੋਂ ਅਨੰਤ ਦੈਂਤ ਪੈਦਾ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "असुर अनंत तहा ते जागे ॥",
      "sourceLineId": "138695",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੂਝਤ ਭਏ ਪੈਗ ਨਹਿ ਭਾਗੇ ॥੪੫॥",
      "transliteration": "joojhat bhe paig neh bhaage ||45||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਜੂਝਦੇ ਰਹੇ ਪਰ (ਇਕ) ਕਦਮ ਵੀ ਨਹੀਂ ਭਜੇ ॥੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "जूझत भए पैग नहि भागे ॥४५॥",
      "sourceLineId": "138696",
      "sourceShabadId": "12775",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭੁਜੰਗ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "भुजंग छंद ॥",
      "sourceLineId": "138697",
      "sourceShabadId": "12776",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਬੈ ਓਰ ਚਾਰੌ ਉਠੇ ਦੈਤ ਬਾਨੀ ॥",
      "transliteration": "jabai or chaarau uThe dhait baanee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਦੈਂਤ ਦੀ ਆਵਾਜ਼ ਆਣ ਲਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "जबै ओर चारौ उठे दैत बानी ॥",
      "sourceLineId": "138698",
      "sourceShabadId": "12776",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਏ ਕੋਪ ਗਾੜੋ ਲਏ ਧੂਲਿਧਾਨੀ ॥",
      "transliteration": "ke kop gaaRo le dhoolidhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਨ੍ਰਹਾ ਨੇ ਬਹੁਤ ਕ੍ਰੋਧ ਕੀਤਾ ਅਤੇ (ਹੱਥਾ ਵਿਚ) ਗੁਰਜ ('ਧੂਲਿਧਾਨੀ') ਉਠਾ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "कए कोप गाड़ो लए धूलिधानी ॥",
      "sourceLineId": "138699",
      "sourceShabadId": "12776",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਿਤੇ ਮੂੰਡ ਮੁੰਡੇ ਕਿਤੇ ਅਰਧ ਮੁੰਡੇ ॥",
      "transliteration": "kite moo(n)dd mu(n)dde kite aradh mu(n)dde ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਦੇ ਸਿਰ ਮੁੰਨੇ ਹੋਏ ਸਨ ਅਤੇ ਕਿਤਨੇ ਅੱਧੇ ਮੁੰਨੇ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "किते मूँड मुँडे किते अरध मुँडे ॥",
      "sourceLineId": "138700",
      "sourceShabadId": "12776",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿਤੇ ਕੇਸ ਧਾਰੀ ਸਿਪਾਹੀ ਪ੍ਰਚੰਡੇ ॥੪੬॥",
      "transliteration": "kite kes dhaaree sipaahee pracha(n)dde ||46||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤਨੇ ਕੇਸ ਧਾਰੀ ਪ੍ਰਚੰਡ ਸਿਪਾਹੀ (ਡਟੇ ਹੋਏ ਸਨ) ॥੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "किते केस धारी सिपाही प्रचंडे ॥४६॥",
      "sourceLineId": "138701",
      "sourceShabadId": "12776",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਤੇ ਦੈਤ ਉਠੇ ਤਿਤੇ ਬਾਲ ਮਾਰੇ ॥",
      "transliteration": "jite dhait uThe tite baal maare ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਦੈਂਤ ਉਠੇ, ਉਤਨੇ ਹੀ ਬਾਲਾ ਨੇ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "जिते दैत उठे तिते बाल मारे ॥",
      "sourceLineId": "138702",
      "sourceShabadId": "12776",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਵੁਠੇ ਆਨਿ ਬਾਨਾਨਿ ਬਾਕੇ ਡਰਾਰੇ ॥",
      "transliteration": "vuThe aan baanaan baake ddaraare ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣਾ ਦੀ ਝੜੀ ਨਾਲ ਬਾਕੇ ਵੀਰ ਡਰਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "वुठे आनि बानानि बाके डरारे ॥",
      "sourceLineId": "138703",
      "sourceShabadId": "12776",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਤੇ ਸ੍ਵਾਸ ਛੋਰੈ ਉਠੈ ਦੈਤ ਭਾਰੇ ॥",
      "transliteration": "jite savaiaas chhorai uThai dhait bhaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਜਿਤਨੇ ਵੀ ਸੁਆਸ ਛਡਦੇ, (ਉਤਨੇ) ਬਹੁਤ ਵੱਡੇ ਦੈਂਤ ਉਠ ਖੜੋਂਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "जिते स्वास छोरै उठै दैत भारे ॥",
      "sourceLineId": "138704",
      "sourceShabadId": "12776",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਠੀ ਮਾਰ ਹੀ ਮਾਰਿ ਕੈ ਕੈ ਪਧਾਰੇ ॥੪੭॥",
      "transliteration": "haThee maar hee maar kai kai padhaare ||47||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਹਠੀ 'ਮਾਰੋ ਮਾਰੋ' ਕਰਦੇ ਟੁਟ ਕੇ ਪੈ ਜਾਦੇ ॥੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "हठी मार ही मारि कै कै पधारे ॥४७॥",
      "sourceLineId": "138705",
      "sourceShabadId": "12776",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1360_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿਤੇ ਕੋਪ ਕੈ ਬੀਰ ਬਾਲਾ ਸੰਘਾਰੇ ॥",
      "transliteration": "kite kop kai beer baalaa sa(n)ghaare ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਲਾ ਨੇ ਕ੍ਰੋਧ ਕਰ ਕੇ ਕਿਤਨੇ ਹੀ ਸੂਰਮੇ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1360,
      "hindi": "",
      "hindiTransliteration": "किते कोप कै बीर बाला संघारे ॥",
      "sourceLineId": "138706",
      "sourceShabadId": "12776",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
