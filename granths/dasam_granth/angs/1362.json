{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1362,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1362_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਦਿਸਿ ਦਸੌ ਪੁਕਾਰੈ ॥",
      "transliteration": "maar maar dhis dhasau pukaarai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦਸਾ ਦਿਸ਼ਾਵਾ ਤੋਂ 'ਮਾਰੋ ਮਾਰੋ' ਪੁਕਾਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "मारि मारि दिसि दसौ पुकारै ॥",
      "sourceLineId": "138755",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਿਨ ਤੇ ਅਮਿਤ ਅਸੁਰ ਤਨ ਧਾਰੈ ॥",
      "transliteration": "tin te amit asur tan dhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ (ਆਵਾਜ਼ ਅਥਵਾ ਸ੍ਵਾਸਾ ਤੋਂ) ਬੇਸ਼ੁਮਾਰ ਦੈਂਤ ਸ਼ਰੀਰ ਧਾਰਨ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तिन ते अमित असुर तन धारै ॥",
      "sourceLineId": "138756",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਾਰ ਚਲਤ ਤਿਨ ਤੇ ਜੇ ਦੌਰੈ ॥",
      "transliteration": "baar chalat tin te je dhauarai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਦੌੜਨ ਨਾਲ ਜੋ ਹਵਾ ਚਲਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "बार चलत तिन ते जे दौरै ॥",
      "sourceLineId": "138757",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਿਨ ਤੇ ਹੋਤ ਅਸੁਰ ਪ੍ਰਗਟੌਰੈ ॥੬੦॥",
      "transliteration": "tin te hot asur pragaTauarai ||60||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਵੀ ਦੈਂਤ ਪ੍ਰਗਟ ਹੁੰਦੇ ਜਾ ਰਹੇ ਸਨ ॥੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तिन ते होत असुर प्रगटौरै ॥६०॥",
      "sourceLineId": "138758",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਲਗੇ ਘਾਇ ਜੇ ਸ੍ਰੋਨ ਬਮਾਹੀ ॥",
      "transliteration": "lage ghai je sron bamaahee ||",
      "translation": "",
      "punjabiViakhya": "ਜ਼ਖ਼ਮ ਲਗਣ ਨਾਲ ਜੋ ਲਹੂ ਨਿਕਲਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "लगे घाइ जे स्रोन बमाही ॥",
      "sourceLineId": "138759",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਿਹ ਤੇ ਗਜ ਬਾਜੀ ਹ੍ਵੈ ਜਾਹੀ ॥",
      "transliteration": "teh te gaj baajee havai jaahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਹਾਥੀ ਅਤੇ ਘੋੜੇ ਬਣੀ ਜਾ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तिह ते गज बाजी ह्वै जाही ॥",
      "sourceLineId": "138760",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਿਹ ਤੇ ਚਲਿਤ ਅਮਿਤ ਜੋ ਸ੍ਵਾਸਾ ॥",
      "transliteration": "teh te chalit amit jo savaiaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਜੋ ਬੇਸ਼ੁਮਾਰ ਸ੍ਵਾਸ ਚਲਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तिह ते चलित अमित जो स्वासा ॥",
      "sourceLineId": "138761",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਿਨ ਤੇ ਅਸੁਰ ਕਰਤ ਪਰਗਾਸਾ ॥੬੧॥",
      "transliteration": "tin te asur karat paragaasaa ||61||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਦੈਂਤ ਪ੍ਰਗਟ ਹੋ ਰਹੇ ਸਨ ॥੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तिन ते असुर करत परगासा ॥६१॥",
      "sourceLineId": "138762",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਨਗਨ ਕਾਲ ਅਸੁਰ ਤਬ ਮਾਰੇ ॥",
      "transliteration": "anagan kaal asur tab maare ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਲ ਨੇ ਅਣਗਿਣਤ ਦੈਂਤਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "अनगन काल असुर तब मारे ॥",
      "sourceLineId": "138763",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਰੇ ਭੂਮਿ ਪਰ ਮਨਹੁ ਮੁਨਾਰੇ ॥",
      "transliteration": "pare bhoom par manahu munaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਧਰਤੀ ਉਤੇ ਇਸ ਤਰ੍ਰਹਾ ਪਏ ਸਨ, ਮਾਨੋ ਮੁਨਾਰੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "परे भूमि पर मनहु मुनारे ॥",
      "sourceLineId": "138764",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੇਧਾ ਤੇ ਗਜ ਬਾਜ ਉਠਾਹੀ ॥",
      "transliteration": "medhaa te gaj baaj uThaahee ||",
      "translation": "",
      "punjabiViakhya": "ਮਿਝ ਤੋਂ ਹਾਥੀ ਘੋੜੇ (ਬਣ ਕੇ) ਉਠਦੇ ਜਾ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "मेधा ते गज बाज उठाही ॥",
      "sourceLineId": "138765",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸ੍ਰੋਨਤ ਕੇ ਦਾਨਵ ਹ੍ਵੈ ਜਾਹੀ ॥੬੨॥",
      "transliteration": "sronat ke dhaanav havai jaahee ||62||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਹੂ ਦੇ ਦੈਂਤ ਬਣਦੇ ਜਾ ਰਹੇ ਸਨ ॥੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "स्रोनत के दानव ह्वै जाही ॥६२॥",
      "sourceLineId": "138766",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਾਨਨ ਕੀ ਬਰਖਾ ਉਠਿ ਕਰਹੀ ॥",
      "transliteration": "baanan kee barakhaa uTh karahee ||",
      "translation": "",
      "punjabiViakhya": "(ਦੈਂਤ) ਉਠ ਕੇ ਬਾਣਾ ਦੀ ਬਰਖਾ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "बानन की बरखा उठि करही ॥",
      "sourceLineId": "138767",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਕਰਿ ਕੋਪ ਉਚਰਹੀ ॥",
      "transliteration": "maar maar kar kop ucharahee ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਵਿਚ ਆ ਕੇ 'ਮਾਰੋ ਮਾਰੋ' ਕਹਿੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "मारि मारि करि कोप उचरही ॥",
      "sourceLineId": "138768",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਿਨ ਤੇ ਅਸੁਰਨ ਕਿਯਾ ਪਸਾਰਾ ॥",
      "transliteration": "tin te asuran kiyaa pasaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਦੈਂਤਾ ਨੇ ਹੋਰ ਪਸਾਰਾ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तिन ते असुरन किया पसारा ॥",
      "sourceLineId": "138769",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦਸੇ ਦਿਸਨ ਹੂੰ ਕਹ ਭਰਿ ਡਾਰਾ ॥੬੩॥",
      "transliteration": "dhase dhisan hoo(n) keh bhar ddaaraa ||63||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਸਾ ਦਿਸ਼ਾਵਾ ਨੂੰ ਭਰ ਦਿੱਤਾ ॥੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "दसे दिसन हूँ कह भरि डारा ॥६३॥",
      "sourceLineId": "138770",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਵਹੈ ਕਾਲਕਾ ਅਸੁਰ ਖਪਾਏ ॥",
      "transliteration": "vahai kaalakaa asur khapaae ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੈਂਤਾ ਨੂੰ ਕਾਲਕਾ ਨੇ ਖਪਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "वहै कालका असुर खपाए ॥",
      "sourceLineId": "138771",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਾਰਿ ਦੁਬਹਿਯਾ ਧੂਰਿ ਮਿਲਾਏ ॥",
      "transliteration": "maar dhubahiyaa dhoor milaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੋਹਾ ਬਾਹਵਾ ਨਾਲ ਸ਼ਸਤ੍ਰ ਚਲਾਣ ਵਾਲਿਆਂ (ਸੂਰਮਿਆਂ) ਨੂੰ ਮਾਰ ਕੇ ਧੂੜ ਵਿਚ ਮਿਲਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "मारि दुबहिया धूरि मिलाए ॥",
      "sourceLineId": "138772",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪੁਨਿ ਪੁਨਿ ਉਠੈ ਪ੍ਰਹਾਰੈ ਬਾਨਾ ॥",
      "transliteration": "pun pun uThai prahaarai baanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬਾਰ ਬਾਰ ਉਠ ਕੇ ਬਾਣ ਚਲਾਉਾਂਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "पुनि पुनि उठै प्रहारै बाना ॥",
      "sourceLineId": "138773",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਿਨ ਤੇ ਧਰਤ ਅਸੁਰ ਤਨ ਨਾਨਾ ॥੬੪॥",
      "transliteration": "tin te dharat asur tan naanaa ||64||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਤੋਂ ਨਾਨਾ ਪ੍ਰਕਾਰ ਦੇ ਦੈਂਤ ਸ਼ਰੀਰ ਧਾਰਨ ਕਰਦੇ ਜਾ ਰਹੇ ਸਨ ॥੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तिन ते धरत असुर तन नाना ॥६४॥",
      "sourceLineId": "138774",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਟੂਕ ਟੂਕ ਦਾਨਵ ਜੇ ਭਏ ॥",
      "transliteration": "Took Took dhaanav je bhe ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦੈਂਤ ਟੋਟੇ ਟੋਟੇ ਹੋ ਗਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "टूक टूक दानव जे भए ॥",
      "sourceLineId": "138775",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਿਨ ਤੇ ਅਨਿਕ ਅਸੁਰ ਹ੍ਵੈ ਗਏ ॥",
      "transliteration": "tin te anik asur havai ge ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਹੋਰ ਅਨੇਕ ਦੈਂਤ ਪੈਦਾ ਹੋ ਗਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तिन ते अनिक असुर ह्वै गए ॥",
      "sourceLineId": "138776",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਾਹੀ ਤੇ ਦਾਨਵ ਬਹੁ ਹ੍ਵੈ ਕਰਿ ॥",
      "transliteration": "taahee te dhaanav bahu havai kar ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਬਹੁਤ ਦੈਂਤ ਪੈਦਾ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "ताही ते दानव बहु ह्वै करि ॥",
      "sourceLineId": "138777",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੁਧ ਕਰੈ ਆਯੁਧ ਤੇ ਲੈ ਕਰਿ ॥੬੫॥",
      "transliteration": "judh karai aayudh te lai kar ||65||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ਸਤ੍ਰ ਲੈ ਕੇ ਯੁੱਧ ਕਰ ਰਹੇ ਸਨ ॥੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "जुध करै आयुध ते लै करि ॥६५॥",
      "sourceLineId": "138778",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਹੁਰਿ ਕਾਲ ਵੈ ਦੈਤ ਸੰਘਾਰੇ ॥",
      "transliteration": "bahur kaal vai dhait sa(n)ghaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਨੇ ਫਿਰ ਉਹ ਦੈਂਤ ਮਾਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "बहुरि काल वै दैत संघारे ॥",
      "sourceLineId": "138779",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਿਲ ਤਿਲ ਪਾਇ ਟੂਕ ਕਰਿ ਡਾਰੇ ॥",
      "transliteration": "til til pai Took kar ddaare ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਉਨ੍ਰਹਾ ਨੂੰ) ਤਿਲ ਤਿਲ ਕਰ ਕੇ ਟੁਕੜੇ ਟੁਕੜੇ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तिल तिल पाइ टूक करि डारे ॥",
      "sourceLineId": "138780",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੇਤਿਕ ਗਿਰੈ ਭੂਮਿ ਟੁਕ ਹ੍ਵੈ ਕੈ ॥",
      "transliteration": "jetik girai bhoom Tuk havai kai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਧਰਤੀ ਉਤੇ ਟੋਟੇ ਹੋ ਕੇ ਡਿਗਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "जेतिक गिरै भूमि टुक ह्वै कै ॥",
      "sourceLineId": "138781",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਿਤ ਹੀ ਉਠੈ ਆਯੁਧਨ ਲੈ ਕੈ ॥੬੬॥",
      "transliteration": "tit hee uThai aayudhan lai kai ||66||",
      "translation": "",
      "punjabiViakhya": "ਉਤਨੇ ਹੀ (ਹੋਰ) ਸ਼ਸਤ੍ਰ ਲੈ ਕੇ ਉਠ ਖੜੋਂਦੇ ਸਨ ॥੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तित ही उठै आयुधन लै कै ॥६६॥",
      "sourceLineId": "138782",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਲ ਤਿਲ ਕਰਿ ਭਟ ਜਿਤਕ ਉਡਾਏ ॥",
      "transliteration": "til til kar bhaT jitak uddaae ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਲ ਤਿਲ ਕਰ ਕੇ ਜਿਤਨੇ ਵੀ ਸੂਰਮੇ ਉਡਾਏ ਸਨ (ਭਾਵ ਮਾਰੇ ਸਨ)",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तिल तिल करि भट जितक उडाए ॥",
      "sourceLineId": "138783",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੇਤਕ ਤਹਾ ਅਸੁਰ ਬਨ ਆਏ ॥",
      "transliteration": "tetak tahaa asur ban aae ||",
      "translation": "",
      "punjabiViakhya": "ਉਤਨੇ ਹੀ ਉਥੇ ਦੈਂਤ ਬਣ ਕੇ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तेतक तहा असुर बन आए ॥",
      "sourceLineId": "138784",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਿਨ ਕੇ ਟੂਕ ਟੂਕ ਜੇ ਕੀਏ ॥",
      "transliteration": "tin ke Took Took je ke'ee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਜੋ ਟੋਟੇ ਟੋਟੇ ਕੀਤੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तिन के टूक टूक जे कीए ॥",
      "sourceLineId": "138785",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਿਨ ਤੇ ਬਹੁ ਦਾਨਵ ਭਵ ਲੀਏ ॥੬੭॥",
      "transliteration": "tin te bahu dhaanav bhav le'ee ||67||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਬਹੁਤ ਦੈਂਤ ਪੈਦਾ ਹੋ ਗਏ ॥੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "तिन ते बहु दानव भव लीए ॥६७॥",
      "sourceLineId": "138786",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੇਤਿਕ ਤਹਾ ਸੁਭੈ ਦੰਤੀ ਰਨ ॥",
      "transliteration": "ketik tahaa subhai dha(n)tee ran ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਕਿਤਨੇ ਹਾਥੀ ਸ਼ੋਭਾ ਪਾ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "केतिक तहा सुभै दंती रन ॥",
      "sourceLineId": "138787",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੀਚਹਿ ਸੁੰਡ ਬਾਰਿ ਤੇ ਸਭ ਤਨ ॥",
      "transliteration": "seecheh su(n)dd baar te sabh tan ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੁੰਡਾ ਤੋਂ ਪਾਣੀ ਸੁਟ ਕੇ ਸਭ ਨੂੰ ਸਿੰਜਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "सीचहि सुँड बारि ते सभ तन ॥",
      "sourceLineId": "138788",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦਾਤ ਦਿਖਾਇ ਤਜੈ ਚਿੰਘਾਰਾ ॥",
      "transliteration": "dhaat dhikhai tajai chi(n)ghaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦੰਦ ਵਿਖਾ ਕੇ ਚਿੰਘਾੜਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "दात दिखाइ तजै चिंघारा ॥",
      "sourceLineId": "138789",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਿਰਿ ਗਿਰਿ ਪਰੈ ਨਿਰਖਿ ਅਸਵਾਰਾ ॥੬੮॥",
      "transliteration": "gir gir parai nirakh asavaaraa ||68||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਵੇਖ ਵੇਖ ਕੇ ਸਵਾਰ ਡਿਗ ਡਿਗ ਪੈਂਦੇ ਸਨ ॥੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "गिरि गिरि परै निरखि असवारा ॥६८॥",
      "sourceLineId": "138790",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਹੂੰ ਭੇਰ ਭੀਖਨ ਭਭਕਾਰਹਿ ॥",
      "transliteration": "kahoo(n) bher bheekhan bhabhakaareh ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭਿਆਨਕ ਭੇਰੀਆਂ ਭਭਕਾਰ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "कहूँ भेर भीखन भभकारहि ॥",
      "sourceLineId": "138791",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਬਾਜੀ ਰਨ ਡਾਰਹਿ ॥",
      "transliteration": "kahoo(n) beer baajee ran ddaareh ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘੋੜੇ ਸੂਰਮਿਆਂ ਨੂੰ ਰਣਭੂਮੀ ਵਿਚ ਡਿਗਾਉਾਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर बाजी रन डारहि ॥",
      "sourceLineId": "138792",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਿਤਕ ਸੂਰ ਸੈਹਥੀ ਫਿਰਾਵਤ ॥",
      "transliteration": "kitak soor saihathee firaavat ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਸੂਰਮੇ ਸੈਹਥੀਆਂ (ਬਰਛੀਆਂ) ਨੂੰ ਘੁੰਮਾਉਾਂਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "कितक सूर सैहथी फिरावत ॥",
      "sourceLineId": "138793",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕੇ ਸਨਮੁਖ ਧਾਵਤ ॥੬੯॥",
      "transliteration": "mahaa kaal ke sanamukh dhaavat ||69||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਹਾ ਕਾਲ ਨੂੰ ਸਾਹਮਣਿਓਾਂ ਪੈਂਦੇ ਸਨ ॥੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "महा काल के सनमुख धावत ॥६९॥",
      "sourceLineId": "138794",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕੇਤਿਕ ਬਜ੍ਰ ਬਰਛਿਯਨ ਲੈ ਕੈ ॥",
      "transliteration": "ketik bajr barachhiyan lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਦੈਂਤ ਬਜ੍ਰ ਅਤੇ ਬਰਛੀਆਂ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "केतिक बज्र बरछियन लै कै ॥",
      "sourceLineId": "138795",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਧਾਵਤ ਅਸੁਰ ਕੋਪ ਤਨ ਤੈ ਕੈ ॥",
      "transliteration": "dhaavat asur kop tan tai kai ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧ ਨਾਲ ਧਾਵਾ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "धावत असुर कोप तन तै कै ॥",
      "sourceLineId": "138796",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੋਪਿ ਕਾਲ ਪਰ ਕਰਤ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "kop kaal par karat prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਕਾਲ ਉਤੇ ਵਾਰ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "कोपि काल पर करत प्रहारा ॥",
      "sourceLineId": "138797",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਾਨੁਕ ਸਲਭ ਦੀਪ ਅਨੁਹਾਰਾ ॥੭੦॥",
      "transliteration": "jaanuk salabh dheep anuhaaraa ||70||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਦੀਵੇ ਉਤੇ (ਸੜਨ ਵਾਲੇ) ਪਤੰਗਿਆਂ ਵਰਗੇ ਹੋਣ ॥੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "जानुक सलभ दीप अनुहारा ॥७०॥",
      "sourceLineId": "138798",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਰੇ ਗੁਮਾਨ ਬਡੇ ਗਰਬੀਲੇ ॥",
      "transliteration": "bhare gumaan badde garabeele ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਹੰਕਾਰ ਦੇ ਭਰੇ ਹੋਏ ਬਹੁਤ ਹੰਕਾਰੀ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "भरे गुमान बडे गरबीले ॥",
      "sourceLineId": "138799",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਧਾਵਤ ਚੌਪਿ ਚੜੇ ਚਟਕੀਲੇ ॥",
      "transliteration": "dhaavat chauap chaRe chaTakeele ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਮੰਗ ਭਰੇ ਬੜੀ ਫੁਰਤੀ ਨਾਲ ਜਾ ਪੈਂਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "धावत चौपि चड़े चटकीले ॥",
      "sourceLineId": "138800",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪੀਸਿ ਪੀਸਿ ਰਦਨਛਦ ਦੋਊ ॥",
      "transliteration": "pees pees radhanachhadh dhouoo ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਬੁਲ੍ਰਹਾ ਨੂੰ ਦੰਦਾ ਨਾਲ ਪੀਹ ਪੀਹ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "पीसि पीसि रदनछद दोऊ ॥",
      "sourceLineId": "138801",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਧਾਵਤ ਮਹਾ ਕਾਲ ਪਰ ਸੋਊ ॥੭੧॥",
      "transliteration": "dhaavat mahaa kaal par souoo ||71||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਉਤੇ ਧਾਵਾ ਕਰ ਰਹੇ ਸਨ ॥੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "धावत महा काल पर सोऊ ॥७१॥",
      "sourceLineId": "138802",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬਾਜਹਿ ਢੋਲਿ ਮ੍ਰਿਦੰਗ ਨਗਾਰਾ ॥",
      "transliteration": "baajeh ddol miradha(n)g nagaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ, ਮ੍ਰਿਦੰਗ ਅਤੇ ਨਗਾਰੇ ਵਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "बाजहि ढोलि मृदंग नगारा ॥",
      "sourceLineId": "138803",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਭੀਖਨ ਕਰਤ ਭੇਰ ਭਭਕਾਰਾ ॥",
      "transliteration": "bheekhan karat bher bhabhakaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੇਰੀਆਂ ਭਿਆਨਕ ਭਭਕਾਰ ਕਰ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "भीखन करत भेर भभकारा ॥",
      "sourceLineId": "138804",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜੰਗ ਮੁਚੰਗ ਉਪੰਗ ਬਜੇ ਰਨ ॥",
      "transliteration": "ja(n)g mucha(n)g upa(n)g baje ran ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਜੰਗ, ਮੁਚੰਗ, ਉਪੰਗ,",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "जंग मुचंग उपंग बजे रन ॥",
      "sourceLineId": "138805",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਝਾਲਰਿ ਤਾਲ ਨਫੀਰਨ ਕੇ ਗਨ ॥੭੨॥",
      "transliteration": "jhaalar taal nafeeran ke gan ||72||",
      "translation": "",
      "punjabiViakhya": "ਝਾਲਰ, ਤਾਲ ਅਤੇ ਨਫ਼ੀਰੀਆਂ ਦੇ ਸਮੂਹ ਵਜ ਰਹੇ ਸਨ ॥੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "झालरि ताल नफीरन के गन ॥७२॥",
      "sourceLineId": "138806",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮੁਰਲੀ ਮੁਰਜ ਕਹੀ ਰਨ ਬਾਜਤ ॥",
      "transliteration": "muralee muraj kahee ran baajat ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਧਰੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਮੁਰਲੀਆਂ, ਮੁਰਜ ਆਦਿ ਵਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "मुरली मुरज कही रन बाजत ॥",
      "sourceLineId": "138807",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਦਾਨਵ ਭਰੇ ਗੁਮਾਨਹਿ ਗਾਜਤ ॥",
      "transliteration": "dhaanav bhare gumaaneh gaajat ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤ ਗੁਮਾਨ ਨਾਲ ਭਰੇ ਹੋਏ ਗਰਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "दानव भरे गुमानहि गाजत ॥",
      "sourceLineId": "138808",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਢੋਲਨ ਪਰ ਦੈ ਦੈ ਢਮਕਾਰੇ ॥",
      "transliteration": "ddolan par dhai dhai ddamakaare ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲਾ ਉਤੇ ਡਗੇ ਮਾਰ ਮਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "ढोलन पर दै दै ढमकारे ॥",
      "sourceLineId": "138809",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਗਹਿ ਗਹਿ ਧਵਤ ਕ੍ਰਿਪਾਨ ਕਟਾਰੇ ॥੭੩॥",
      "transliteration": "geh geh dhavat kirapaan kaTaare ||73||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰਿਪਾਨਾ ਅਤੇ ਕਟਾਰਾ ਪਕੜ ਪਕੜ ਕੇ ਭਜੇ ਫਿਰਦੇ ਸਨ ॥੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "गहि गहि धवत कृपान कटारे ॥७३॥",
      "sourceLineId": "138810",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਦੀਰਘ ਦਾਤ ਕਾਢਿ ਕਈ ਕੋਸਾ ॥",
      "transliteration": "dheeragh dhaat kaadd kiee kosaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਕੋਹਾ ਜਿੰਨੇ ਲੰਬੇ ਦੰਦ ਕਢ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "दीरघ दात काढि कई कोसा ॥",
      "sourceLineId": "138811",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਧਾਵਤ ਅਸੁਰ ਹੀਏ ਕਰਿ ਜੋਸਾ ॥",
      "transliteration": "dhaavat asur he'ee kar josaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਿਰਦੇ ਵਿਚ ਜੋਸ਼ ਵਧਾ ਕੇ ਦੈਂਤ ਧਾਵਾ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "धावत असुर हीए करि जोसा ॥",
      "sourceLineId": "138812",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਮਾਰਨ ਮਹਾ ਕਾਲ ਕਹ ਧਾਵੈ ॥",
      "transliteration": "maaran mahaa kaal keh dhaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮਹਾ ਕਾਲ ਨੂੰ ਮਾਰਨ ਲਈ ਧਾਵਾ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "मारन महा काल कह धावै ॥",
      "sourceLineId": "138813",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਮਨੋ ਮਾਰਤ ਵੇਈ ਮਰਿ ਜਾਵੈ ॥੭੪॥",
      "transliteration": "mano maarat veiee mar jaavai ||74||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਮਾਰਦੇ ਹੋਏ ਉਹ ਆਪ ਹੀ ਮਰ ਜਾਦੇ ਹੋਣ ॥੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "मनो मारत वेई मरि जावै ॥७४॥",
      "sourceLineId": "138814",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਦਾਨਵ ਮਹਾ ਕੋਪ ਕਰਿ ਢੂਕੇ ॥",
      "transliteration": "dhaanav mahaa kop kar ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤ ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਆਣ ਢੁਕੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "दानव महा कोप करि ढूके ॥",
      "sourceLineId": "138815",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਮਾਰਹਿ ਮਾਰਿ ਦਸੋ ਦਿਸਿ ਕੂਕੇ ॥",
      "transliteration": "maareh maar dhaso dhis kooke ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਸਾ ਦਿਸ਼ਾਵਾ ਵਿਚ 'ਮਾਰੋ ਮਾਰੋ' ਕੂਕਣ ਲਗੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "मारहि मारि दसो दिसि कूके ॥",
      "sourceLineId": "138816",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਦੈ ਦੈ ਢੋਲਿ ਮ੍ਰਿਦੰਗ ਨਗਾਰੇ ॥",
      "transliteration": "dhai dhai ddol miradha(n)g nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ, ਮ੍ਰਿਦੰਗ ਅਤੇ ਨਗਾਰੇ ਦੈ ਦੈ (ਕਰ ਕੇ ਵਜਦੇ ਸਨ)",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "दै दै ढोलि मृदंग नगारे ॥",
      "sourceLineId": "138817",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਕਾਢਿ ਕਾਢਿ ਅਰਿ ਦਾਤਿ ਡਰਾਰੇ ॥੭੫॥",
      "transliteration": "kaadd kaadd ar dhaat ddaraare ||75||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੈਰੀ ਦੰਦ ਕਢ ਕੇ ਡਰਾਉਾਂਦੇ ਸਨ ॥੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "काढि काढि अरि दाति डरारे ॥७५॥",
      "sourceLineId": "138818",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਚਾਹਤ ਮਹਾ ਕਾਲ ਕਹ ਮਾਰੋ ॥",
      "transliteration": "chaahat mahaa kaal keh maaro ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮਹਾ ਕਾਲ ਨੂੰ ਮਾਰਨਾ ਚਾਹੁੰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "चाहत महा काल कह मारो ॥",
      "sourceLineId": "138819",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਮਹਾ ਪੁਰਖ ਨਹਿ ਕਰਤ ਬਿਚਾਰੋ ॥",
      "transliteration": "mahaa purakh neh karat bichaaro ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਹ ਮਹਾ ਮੂਰਖ ਵਿਚਾਰ ਨਹੀਂ ਕਰਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "महा पुरख नहि करत बिचारो ॥",
      "sourceLineId": "138820",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਜਿਨ ਸਭ ਜਗ ਕਾ ਕਰਾ ਪਸਾਰਾ ॥",
      "transliteration": "jin sabh jag kaa karaa pasaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜਿਸ ਨੇ ਸਾਰੇ ਜਗਤ ਦਾ ਪਸਾਰਾ ਕੀਤਾ ਹੋਇਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "जिन सभ जग का करा पसारा ॥",
      "sourceLineId": "138821",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਤਾਹਿ ਚਹਤ ਤੇ ਮੂੜ ਸੰਘਾਰਾ ॥੭੬॥",
      "transliteration": "taeh chahat te mooR sa(n)ghaaraa ||76||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮੂਰਖ ਉਸ ਨੂੰ ਮਾਰਨਾ ਚਾਹੁੰਦੇ ਸਨ ॥੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "ताहि चहत ते मूड़ संघारा ॥७६॥",
      "sourceLineId": "138822",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਠੋਕਿ ਠੋਕਿ ਭੁਜ ਦੰਡਨ ਜੋਧਾ ॥",
      "transliteration": "Thok Thok bhuj dha(n)ddan jodhaa ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧਿਆਂ ਨੇ ਭੁਜਾਵਾ ਨੂੰ ਠੋਕ ਠੋਕ ਕੇ ਅਤੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "ठोकि ठोकि भुज दंडन जोधा ॥",
      "sourceLineId": "138823",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਧਾਵਤ ਮਹਾ ਕਾਲ ਪਰ ਕ੍ਰੋਧਾ ॥",
      "transliteration": "dhaavat mahaa kaal par krodhaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਉਤੇ ਧਾਵਾ ਬੋਲ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "धावत महा काल पर क्रोधा ॥",
      "sourceLineId": "138824",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਬੀਸ ਪਦੁਮ ਦਾਨਵ ਤਵ ਭਯੋ ॥",
      "transliteration": "bees padhum dhaanav tav bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਵੀਹ ਪਦਮ ਦੈਂਤ ਸੈਨਾ ਉਥੇ ਇਕੱਠੀ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "बीस पदुम दानव तव भयो ॥",
      "sourceLineId": "138825",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1362_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਨਾਸ ਕਰਨ ਕਾਲੀ ਕੋ ਧਯੋ ॥੭੭॥",
      "transliteration": "naas karan kaalee ko dhayo ||77||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਾਲੀ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਲਈ ਚੜ੍ਰਹ ਪਈ ॥੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1362,
      "hindi": "",
      "hindiTransliteration": "नास करन काली को धयो ॥७७॥",
      "sourceLineId": "138826",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
