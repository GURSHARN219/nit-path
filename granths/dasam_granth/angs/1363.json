{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1363,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1363_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਛੂਹਨਿ ਸਹਸ ਅਸੁਰ ਕੀ ਸੈਨਾ ॥",
      "transliteration": "chhoohan sahas asur kee sainaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤਾ ਦੀ ਹਜ਼ਾਰ ਅਛੋਹਣੀ ਸੈਨਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "छूहनि सहस असुर की सैना ॥",
      "sourceLineId": "138827",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਧਾਵਤ ਭਈ ਅਰੁਨ ਕਰਿ ਨੈਨਾ ॥",
      "transliteration": "dhaavat bhiee arun kar nainaa ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਖਾ ਲਾਲ ਕਰ ਕੇ ਅਗੇ ਵੱਧ ਚਲੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "धावत भई अरुन करि नैना ॥",
      "sourceLineId": "138828",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਧਾਵਤ ਕੋਪ ਅਮਿਤ ਕਰਿ ਭਏ ॥",
      "transliteration": "dhaavat kop amit kar bhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਮਿਤ (ਸੈਨਾ ਦਲ) ਕ੍ਰੋਧ ਕਰ ਕੇ ਚੜ੍ਰਹ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "धावत कोप अमित करि भए ॥",
      "sourceLineId": "138829",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪ੍ਰਿਥਵੀ ਕੇ ਖਟ ਪਟ ਉਡਿ ਗਏ ॥੭੮॥",
      "transliteration": "pirathavee ke khaT paT udd ge ||78||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪ੍ਰਿਥਵੀ ਦੇ ਛੇ ਪਟ (ਧੂੜ ਬਣ ਕੇ) ਉਡ ਗਏ ॥੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "पृथवी के खट पट उडि गए ॥७८॥",
      "sourceLineId": "138830",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਏਕੈ ਪੁਰ ਪ੍ਰਿਥਵੀ ਰਹਿ ਗਈ ॥",
      "transliteration": "ekai pur pirathavee reh giee ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਕੇਵਲ ਇਕ ਪੁੜ ਰਹਿ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "एकै पुर पृथवी रहि गई ॥",
      "sourceLineId": "138831",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਖਟ ਪਟ ਹਯਨ ਪਗਨ ਉਡਿ ਗਈ ॥",
      "transliteration": "khaT paT hayan pagan udd giee ||",
      "translation": "",
      "punjabiViakhya": "ਛੇ ਪਟ ਘੋੜਿਆਂ ਦੇ ਖੁਰਾ ਨਾਲ ਹੀ ਉਡ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "खट पट हयन पगन उडि गई ॥",
      "sourceLineId": "138832",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਨੁ ਬਿਧਿ ਏਕੈ ਰਚਾ ਪਯਾਰਾ ॥",
      "transliteration": "jan bidh ekai rachaa payaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਵਿਧਾਤਾ ਨੇ ਇਕੋ ਪਾਤਾਲ ਹੀ ਰਚਿਆ ਹੋਵੇ",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "जनु बिधि एकै रचा पयारा ॥",
      "sourceLineId": "138833",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗਗਨ ਰਚੇ ਦਸ ਤੀਨਿ ਸੁਧਾਰਾ ॥੭੯॥",
      "transliteration": "gagan rache dhas teen sudhaaraa ||79||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਤੇਰ੍ਰਹਾ ਆਕਾਸ਼ਾ ਦੀ ਰਚਨਾ ਕੀਤੀ ਹੋਵੇ ॥੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "गगन रचे दस तीनि सुधारा ॥७९॥",
      "sourceLineId": "138834",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਹਾਦੇਵ ਆਸਨ ਤੇ ਟਰਾ ॥",
      "transliteration": "mahaadhev aasan te Taraa ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਦੇਵ ਆਸਣ ਤੋਂ ਡੋਲ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "महादेव आसन ते टरा ॥",
      "sourceLineId": "138835",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਤ੍ਰਸਤ ਬੂਟ ਮਹਿ ਦੁਰਾ ॥",
      "transliteration": "brahamaa trasat booT meh dhuraa ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਭੈ ਭੀਤ ਹੋ ਕੇ ਬੂਟੇ (ਭਾਵ ਕਮਲ ਨਾਭ) ਵਿਚ ਵੜ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "ब्रहमा त्रसत बूट महि दुरा ॥",
      "sourceLineId": "138836",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਿਰਖਿ ਬਿਸਨ ਰਨ ਅਧਿਕ ਡਰਾਨਾ ॥",
      "transliteration": "nirakh bisan ran adhik ddaraanaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਨੂੰ ਵੇਖ ਕੇ ਵਿਸ਼ਣੂ ਵੀ ਬਹੁਤ ਡਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "निरखि बिसन रन अधिक डराना ॥",
      "sourceLineId": "138837",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੁਰਾ ਸਿੰਧ ਕੇ ਬੀਚ ਲਜਾਨਾ ॥੮੦॥",
      "transliteration": "dhuraa si(n)dh ke beech lajaanaa ||80||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਾਜ ਦਾ ਮਾਰਿਆ ਸਮੁੰਦਰ ਵਿਚ ਜਾ ਛੁਪਿਆ ॥੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "दुरा सिंध के बीच लजाना ॥८०॥",
      "sourceLineId": "138838",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕੜਾ ਕੜੀ ਮਾਚਾ ਘਮਸਾਨਾ ॥",
      "transliteration": "kaRaa kaRee maachaa ghamasaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ੂਬ ਮਾਰ ਕਾਟ ਦਾ ਭਿਆਨਕ ਯੁੱਧ ਮਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "कड़ा कड़ी माचा घमसाना ॥",
      "sourceLineId": "138839",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਿਰਖਤ ਦੇਵ ਦੈਤ ਜਾ ਨਾਨਾ ॥",
      "transliteration": "nirakhat dhev dhait jaa naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਅਨੇਕ ਦੇਵਤੇ ਅਤੇ ਦੈਂਤ ਵੇਖ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "निरखत देव दैत जा नाना ॥",
      "sourceLineId": "138840",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਹਾ ਘੋਰ ਆਹਵ ਤਹ ਪਰਾ ॥",
      "transliteration": "mahaa ghor aahav teh paraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਹੁਤ ਭਿਅੰਕਰ ਯੁੱਧ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "महा घोर आहव तह परा ॥",
      "sourceLineId": "138841",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਾਪੀ ਭੂਮਿ ਗਗਨ ਥਰਹਰਾ ॥੮੧॥",
      "transliteration": "kaapee bhoom gagan tharaharaa ||81||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਕੰਬ ਗਈ ਅਤੇ ਆਕਾਸ਼ ਥਰਥਰਾ ਗਿਆ ॥੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "कापी भूमि गगन थरहरा ॥८१॥",
      "sourceLineId": "138842",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਿਰਖਿ ਜੁਧ ਕਾਪਾ ਕਮਲੇਸਾ ॥",
      "transliteration": "nirakh judh kaapaa kamalesaa ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਨੂੰ ਵੇਖ ਕੇ ਵਿਸ਼ਣੂ ('ਕਮਲੇਸਾ') ਕੰਬ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "निरखि जुध कापा कमलेसा ॥",
      "sourceLineId": "138843",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਤੇ ਧਰਾ ਨਾਰਿ ਕਾ ਭੇਸਾ ॥",
      "transliteration": "taa te dharaa naar kaa bhesaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਕਰ ਕੇ ਇਸਤਰੀ ਦਾ ਭੇਸ ਧਾਰਨ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "ता ते धरा नारि का भेसा ॥",
      "sourceLineId": "138844",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪਰਬਤੀਸ ਲਖਿ ਡਰਾ ਲਰਾਈ ॥",
      "transliteration": "parabatees lakh ddaraa laraiee ||",
      "translation": "",
      "punjabiViakhya": "ਲੜਾਈ ਨੂੰ ਵੇਖ ਕੇ ਸ਼ਿਵ ਵੀ ਡਰ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "परबतीस लखि डरा लराई ॥",
      "sourceLineId": "138845",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਾਸਾ ਬਨ ਬਿਖੈ ਅਤਿਥ ਕਹਾਈ ॥੮੨॥",
      "transliteration": "baasaa ban bikhai atith kahaiee ||82||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜੋਗੀ ਅਖਵਾ ਕੇ ਜੰਗਲ ਵਿਚ ਜਾ ਵਸਿਆ ॥੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "बासा बन बिखै अतिथ कहाई ॥८२॥",
      "sourceLineId": "138846",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਾਰਤਿਕੇਯ ਹ੍ਵੈ ਰਹਾ ਬਿਹੰਡਲ ॥",
      "transliteration": "kaaratikey havai rahaa biha(n)ddal ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਰਤਿਕੇਯ ਬਿਹੰਡਲ (ਨੜ ਅਥਵਾ ਨਪੁੰਸਕ) ਬਣ ਕੇ ਰਹਿ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "कारतिकेय ह्वै रहा बिहंडल ॥",
      "sourceLineId": "138847",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬ੍ਰਹਮ ਛਾਡਿ ਗ੍ਰਿਹ ਗਯੋ ਕਮੰਡਲ ॥",
      "transliteration": "braham chhaadd gireh gayo kama(n)ddal ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਘਰ ਛਡ ਕੇ ਕਮੰਡਲ ਵਿਚ ਜਾ ਲੁਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "ब्रहम छाडि गृह गयो कमंडल ॥",
      "sourceLineId": "138848",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਬ ਪਿਸਾਨ ਪਗਨ ਭੇ ਤਬ ਹੀ ॥",
      "transliteration": "pab pisaan pagan bhe tab hee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਤੋਂ ਹੀ ਪਹਾੜ ਪੈਰਾ ਨਾਲ ਪਿਸ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "पब पिसान पगन भे तब ही ॥",
      "sourceLineId": "138849",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਾਇ ਬਸੇ ਉਤਰ ਦਿਸਿ ਸਬ ਹੀ ॥੮੩॥",
      "transliteration": "jai base utar dhis sab hee ||83||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਉੱਤਰ ਦਿਸ਼ਾ ਵਿਚ ਜਾ ਵਸੇ ॥੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "जाइ बसे उतर दिसि सब ही ॥८३॥",
      "sourceLineId": "138850",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਡਗੀ ਧਰਨਿ ਅੰਬਰਿ ਘਹਰਾਨਾ ॥",
      "transliteration": "ddagee dharan a(n)bar ghaharaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਡਗਡੋਲ ਗਈ ਅਤੇ ਆਕਾਸ਼ ਗਰਜਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "डगी धरनि अंबरि घहराना ॥",
      "sourceLineId": "138851",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਾਜ ਖੁਰਨ ਤੇ ਪਬ ਪਿਸਾਨਾ ॥",
      "transliteration": "baaj khuran te pab pisaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜਿਆਂ ਦੇ ਖੁਰਾ ਨਾਲ ਪਰਬਤ ਪਿਸ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "बाज खुरन ते पब पिसाना ॥",
      "sourceLineId": "138852",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅੰਧ ਗੁਬਾਰ ਭਯੋ ਬਾਨਨ ਤਨ ॥",
      "transliteration": "a(n)dh gubaar bhayo baanan tan ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣਾ (ਦੇ ਅਧਿਕ ਛਾ ਜਾਣ ਨਾਲ) ਅੰਧ ਗ਼ੁਬਾਰ ਛਾ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "अंध गुबार भयो बानन तन ॥",
      "sourceLineId": "138853",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹਾਥ ਬਿਲੋਕ੍ਯੋ ਜਾਤ ਨ ਆਪਨ ॥੮੪॥",
      "transliteration": "haath bilokayo jaat na aapan ||84||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣਾ ਹੱਥ ਵੀ ਵੇਖਿਆ ਨਹੀਂ ਜਾ ਰਿਹਾ ॥੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "हाथ बिलोक्यो जात न आपन ॥८४॥",
      "sourceLineId": "138854",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਿਛੂਆ ਬਾਨ ਬਜ੍ਰ ਰਨ ਬਰਖਤ ॥",
      "transliteration": "bichhooaa baan bajr ran barakhat ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਵਿਚ ਬਿਛੂਏ, ਬਾਣ, ਬਜ੍ਰ ਆਦਿ ਵਰ੍ਰਹਨ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "बिछूआ बान बज्र रन बरखत ॥",
      "sourceLineId": "138855",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਿਸਿ ਰਿਸਿ ਸੁਭਟ ਧਨੁਖ ਕਹ ਕਰਖਤ ॥",
      "transliteration": "ris ris subhaT dhanukh keh karakhat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਮੇ ਰੋਹ ਵਿਚ ਆ ਆ ਕੇ ਧੁਨਸ਼ਾ ਨੂੰ ਤਣਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "रिसि रिसि सुभट धनुख कह करखत ॥",
      "sourceLineId": "138856",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਕਿ ਤਕਿ ਬਾਨ ਪ੍ਰਕੋਪ ਚਲਾਵੈ ॥",
      "transliteration": "tak tak baan prakop chalaavai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਨਿਸ਼ਾਣਾ ਬੰਨ੍ਰਹ ਬੰਨ੍ਰਹ ਕੇ ਅਤੇ ਰੋਹ ਨਾਲ ਭਰੇ ਹੋਏ ਤੀਰ ਚਲਾਉਾਂਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "तकि तकि बान प्रकोप चलावै ॥",
      "sourceLineId": "138857",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭੇਦਿ ਤ੍ਰਾਨ ਤਨ ਪਰੈ ਪਰਾਵੈ ॥੮੫॥",
      "transliteration": "bhedh traan tan parai paraavai ||85||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਕਵਚਾ ('ਤ੍ਰਾਨ ਤਨ') ਨੂੰ ਵਿੰਨ੍ਰਹ ਕੇ ਪਾਰ ਨਿਕਲ ਜਾਦੇ ਸਨ ॥੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "भेदि त्रान तन परै परावै ॥८५॥",
      "sourceLineId": "138858",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਬ ਹੀ ਭਏ ਅਮਿਤ ਰਣ ਜੋਧਾ ॥",
      "transliteration": "jab hee bhe amit ran jodhaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਬਹੁਤ ਅਧਿਕ ਯੋਧੇ (ਇਕਤ੍ਰ) ਹੋ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "जब ही भए अमित रण जोधा ॥",
      "sourceLineId": "138859",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਾਢ੍ਯੋ ਮਹਾ ਕਾਲ ਕੈ ਕ੍ਰੋਧਾ ॥",
      "transliteration": "baaddayo mahaa kaal kai krodhaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਹਾ ਕਾਲ ਦਾ ਕ੍ਰੋਧ ਵੱਧ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "बाढ्यो महा काल कै क्रोधा ॥",
      "sourceLineId": "138860",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਹਾ ਕੋਪ ਕਰਿ ਬਿਸਿਖ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "mahaa kop kar bisikh prahaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਬਹੁਤ ਅਧਿਕ ਕ੍ਰੋਧ ਕਰ ਕੇ ਬਾਣ ਚਲਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "महा कोप करि बिसिख प्रहारे ॥",
      "sourceLineId": "138861",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਧਿਕ ਸਤ੍ਰੁ ਛਿਨ ਮਾਝ ਸੰਘਾਰੇ ॥੮੬॥",
      "transliteration": "adhik satr chhin maajh sa(n)ghaare ||86||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਜ਼ਿਆਦਾ ਵੈਰੀ ਛਿਣ ਵਿਚ ਮਾਰ ਦਿੱਤੇ ॥੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "अधिक सत्रु छिन माझ संघारे ॥८६॥",
      "sourceLineId": "138862",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰਕਤ ਸੰਬੂਹ ਧਰਨਿ ਤਬ ਪਰਾ ॥",
      "transliteration": "rakat sa(n)booh dharan tab paraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਧਰਤੀ ਉਤੇ ਬਹੁਤ ਲਹੂ ਡਿਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "रकत संबूह धरनि तब परा ॥",
      "sourceLineId": "138863",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਾ ਤੇ ਬਹੁ ਦਾਨ੍ਵਨ ਬਪੁ ਧਰਾ ॥",
      "transliteration": "taa te bahu dhaanavain bap dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਬਹੁਤ ਸਾਰੇ ਦੈਂਤਾ ਨੇ ਸ਼ਰੀਰ ਧਾਰਨ ਕਰ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "ता ते बहु दान्वन बपु धरा ॥",
      "sourceLineId": "138864",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਏਕ ਏਕ ਸਰ ਸਭਹਿ ਚਲਾਏ ॥",
      "transliteration": "ek ek sar sabheh chalaae ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ) ਸਾਰਿਆਂ ਨੇ ਇਕ ਇਕ ਤੀਰ ਚਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "एक एक सर सभहि चलाए ॥",
      "sourceLineId": "138865",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਿਨ ਤੇ ਅਸੁਰ ਅਨਿਕ ਹ੍ਵੈ ਧਾਏ ॥੮੭॥",
      "transliteration": "tin te asur anik havai dhaae ||87||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਅਨੇਕ ਦੈਂਤ ਪੈਦਾ ਹੋ ਕੇ ਪੈ ਗਏ ॥੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "तिन ते असुर अनिक ह्वै धाए ॥८७॥",
      "sourceLineId": "138866",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਏ ਜਿਤਕ ਤਿਤਕ ਤਹ ਮਾਰੇ ॥",
      "transliteration": "aae jitak titak teh maare ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ (ਅਗੇ) ਆਏ, ਉਤਨੇ ਹੀ (ਮਹਾ ਕਾਲ ਨੇ) ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "आए जितक तितक तह मारे ॥",
      "sourceLineId": "138867",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਹੇ ਧਰਨਿ ਪਰ ਰਕਤ ਪਨਾਰੇ ॥",
      "transliteration": "bahe dharan par rakat panaare ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੇ ਲਹੂ ਦੇ ਪਰਨਾਲੇ ਵਗ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "बहे धरनि पर रकत पनारे ॥",
      "sourceLineId": "138868",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਿਨ ਤੇ ਅਮਿਤ ਅਸੁਰਨ ਬਪੁ ਧਰਾ ॥",
      "transliteration": "tin te amit asuran bap dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਬੇਸ਼ੁਮਾਰ ਦੈਂਤਾ ਨੇ ਸ਼ਰੀਰ ਧਾਰਨ ਕੀਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "तिन ते अमित असुरन बपु धरा ॥",
      "sourceLineId": "138869",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਮ ਤੇ ਜਾਤ ਬਿਚਾਰ ਨ ਕਰਾ ॥੮੮॥",
      "transliteration": "ham te jaat bichaar na karaa ||88||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦਾ ਮੇਰੇ ਤੋਂ ਵਿਚਾਰ ਨਹੀਂ ਕੀਤਾ ਜਾਦਾ ॥੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "हम ते जात बिचार न करा ॥८८॥",
      "sourceLineId": "138870",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਡਗਮਗ ਲੋਕ ਚਤੁਰਦਸ ਭਏ ॥",
      "transliteration": "ddagamag lok chaturadhas bhe ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਦਾ ਲੋਕ ਡਗਮਗਾ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "डगमग लोक चतुरदस भए ॥",
      "sourceLineId": "138871",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਸੁਰਨ ਸਾਥ ਸਕਲ ਭਰਿ ਗਏ ॥",
      "transliteration": "asuran saath sakal bhar ge ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੈਂਤਾ ਨਾਲ ਸਾਰੇ ਭਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "असुरन साथ सकल भरि गए ॥",
      "sourceLineId": "138872",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਬਿਸਨ ਸਭੈ ਡਰਪਾਨੇ ॥",
      "transliteration": "brahamaa bisan sabhai ddarapaane ||",
      "translation": "",
      "punjabiViakhya": "ਬ੍ਰਹਮਾ ਅਤੇ ਵਿਸ਼ਣੂ ਆਦਿ ਸਾਰੇ ਡਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "ब्रहमा बिसन सभै डरपाने ॥",
      "sourceLineId": "138873",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1363_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕੀ ਸਰਨਿ ਸਿਧਾਨੇ ॥੮੯॥",
      "transliteration": "mahaa kaal kee saran sidhaane ||89||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਹਾ ਕਾਲ ਦੀ ਸ਼ਰਨ (ਵਿਚ ਆਣ) ਲਈ ਚਲ ਪਏ ॥੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1363,
      "hindi": "",
      "hindiTransliteration": "महा काल की सरनि सिधाने ॥८९॥",
      "sourceLineId": "138874",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
