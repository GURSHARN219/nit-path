{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1364,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1364_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸਭੈ ਪੁਕਾਰਤ ਭਏ ॥",
      "transliteration": "eeh bidh sabhai pukaarat bhe ||",
      "translation": "",
      "punjabiViakhya": "(ਆ ਕੇ) ਸਾਰੇ ਇਸ ਤਰ੍ਰਹਾ ਪੁਕਾਰ ਕਰਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "इह बिधि सभै पुकारत भए ॥",
      "sourceLineId": "138875",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਨੁ ਕਰ ਲੂਟਿ ਬਨਿਕ ਸੇ ਲਏ ॥",
      "transliteration": "jan kar looT banik se le ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਕਿਸੇ ਬਨੀਏ ਵਾਗ ਲੁਟੇ ਗਏ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "जनु कर लूटि बनिक से लए ॥",
      "sourceLineId": "138876",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤ੍ਰਾਹਿ ਤ੍ਰਾਹਿ ਹਮ ਸਰਨ ਤਿਹਾਰੀ ॥",
      "transliteration": "traeh traeh ham saran tihaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਮਹਾ ਕਾਲ ਨੂੰ ਮੁਖ਼ਾਤਬ ਹੋ ਕੇ ਕਹਿਣ ਲਗੇ, ਹੇ ਮਹਾ ਕਾਲ! (ਸਾਨੂੰ) ਬਚਾ ਲਵੋ, ਬਚਾ ਲਵੋ, ਅਸੀਂ ਤੁਹਾਡੀ ਸ਼ਰਨ ਵਿਚ (ਆਏ ਹਾ)",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "त्राहि त्राहि हम सरन तिहारी ॥",
      "sourceLineId": "138877",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਭ ਭੈ ਤੇ ਹਮ ਲੇਹੁ ਉਬਾਰੀ ॥੯੦॥",
      "transliteration": "sabh bhai te ham leh ubaaree ||90||",
      "translation": "",
      "punjabiViakhya": "ਸਾਨੂੰ ਸਭ ਤਰ੍ਰਹਾ ਦੇ ਡਰ ਤੋਂ ਉਬਾਰ ਲਵੋ ॥੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "सभ भै ते हम लेहु उबारी ॥९०॥",
      "sourceLineId": "138878",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੁਮ ਹੋ ਸਕਲ ਲੋਕ ਸਿਰਤਾਜਾ ॥",
      "transliteration": "tum ho sakal lok sirataajaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਸਾਰਿਆਂ ਲੋਕਾ ਦੇ ਸਿਰਤਾਜ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "तुम हो सकल लोक सिरताजा ॥",
      "sourceLineId": "138879",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਰਬਨ ਗੰਜ ਗਰੀਬ ਨਿਵਾਜਾ ॥",
      "transliteration": "garaban ga(n)j gareeb nivaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਹੰਕਾਰੀਆਂ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੇ ਅਤੇ ਗ਼ਰੀਬਾ ਨੂੰ ਨਿਵਾਜਣ ਵਾਲੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "गरबन गंज गरीब निवाजा ॥",
      "sourceLineId": "138880",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਦਿ ਅਕਾਲ ਅਜੋਨਿ ਬਿਨਾ ਭੈ ॥",
      "transliteration": "aadh akaal ajon binaa bhai ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਜਗਤ ਵਿਚ ਆਦਿ (ਮੁਢ ਕਦੀਮ ਦੇ) ਅਕਾਲ, ਅਜੂਨੀ, ਨਿਰਭੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "आदि अकाल अजोनि बिना भै ॥",
      "sourceLineId": "138881",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਿਰਬਿਕਾਰ ਨਿਰਲੰਬ ਜਗਤ ਮੈ ॥੯੧॥",
      "transliteration": "nirabikaar nirala(n)b jagat mai ||91||",
      "translation": "",
      "punjabiViakhya": "ਨਿਰਵਿਕਾਰ, ਨਿਰਲੰਬ (ਬਿਨਾ ਸਹਾਰੇ ਦੇ) ਹੋ ॥੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "निरबिकार निरलंब जगत मै ॥९१॥",
      "sourceLineId": "138882",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਿਰਬਿਕਾਰ ਨਿਰਜੁਰ ਅਬਿਨਾਸੀ ॥",
      "transliteration": "nirabikaar nirajur abinaasee ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਰਵਿਕਾਰ, ਨਿਰਜੁਰ (ਨਿਰੋਗ) ਅਬਿਨਾਸ਼ੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "निरबिकार निरजुर अबिनासी ॥",
      "sourceLineId": "138883",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਰਮ ਜੋਗ ਕੇ ਤਤੁ ਪ੍ਰਕਾਸੀ ॥",
      "transliteration": "param jog ke tat prakaasee ||",
      "translation": "",
      "punjabiViakhya": "ਪਰਮ ਯੋਗ ਦੇ ਤੱਤ ਨੂੰ ਪ੍ਰਕਾਸ਼ ਕਰਨ ਵਾਲੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "परम जोग के ततु प्रकासी ॥",
      "sourceLineId": "138884",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਿਰੰਕਾਰ ਨਵ ਨਿਤ੍ਯ ਸੁਯੰਭਵ ॥",
      "transliteration": "nira(n)kaar nav nitay suya(n)bhav ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਰਾਕਾਰ, ਨਿੱਤ ਨਵੀਨ, ਆਪਣੇ ਆਪ ਹੋਣ ਵਾਲੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "निरंकार नव नित्य सुयंभव ॥",
      "sourceLineId": "138885",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਾਤ ਮਾਤ ਜਹ ਜਾਤ ਨ ਬੰਧਵ ॥੯੨॥",
      "transliteration": "taat maat jeh jaat na ba(n)dhav ||92||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਹਾਡਾ) ਨਾ ਕੋਈ ਪਿਤਾ ਹੈ, ਨਾ ਮਾਤਾ ਅਤੇ ਨਾ ਹੀ ਸੰਬੰਧੀ ॥੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "तात मात जह जात न बंधव ॥९२॥",
      "sourceLineId": "138886",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਤ੍ਰੁ ਬਿਹੰਡ ਸੁਰਿਦਿ ਸੁਖਦਾਇਕ ॥",
      "transliteration": "satr biha(n)dd suridh sukhadhaik ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਵੈਰੀਆਂ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੇ, ਭਗਤਾ ('ਸੁਰਿਦਿ') ਨੂੰ ਸੁਖ ਦੇਣ ਵਾਲੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "सत्रु बिहंड सुरिदि सुखदाइक ॥",
      "sourceLineId": "138887",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੰਡ ਮੁੰਡ ਦਾਨਵ ਕੇ ਘਾਇਕ ॥",
      "transliteration": "cha(n)dd mu(n)dd dhaanav ke ghaik ||",
      "translation": "",
      "punjabiViakhya": "ਚੰਡ ਅਤੇ ਮੁੰਡ ਦੈਂਤਾ ਨੂੰ ਮਾਰਨ ਵਾਲੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "चंड मुँड दानव के घाइक ॥",
      "sourceLineId": "138888",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਤਿ ਸੰਧਿ ਸਤਿਤਾ ਨਿਵਾਸਾ ॥",
      "transliteration": "sat sa(n)dh satitaa nivaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਚੀ ਪ੍ਰਤਿਗਿਆ ਕਰਨ ਵਾਲੇ, ਸਚਾਈ ਵਿਚ ਨਿਵਾਸ ਕਰਨ ਵਾਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "सति संधि सतिता निवासा ॥",
      "sourceLineId": "138889",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭੂਤ ਭਵਿਖ ਭਵਾਨ ਨਿਰਾਸਾ ॥੯੩॥",
      "transliteration": "bhoot bhavikh bhavaan niraasaa ||93||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੂਤ, ਭਵਿਖ ਤੇ ਵਰਤਮਾਨ ਦੇ ਪ੍ਰਭਾਵ ਤੋਂ ਮੁਕਤ ('ਨਿਰਾਸਾ' ਆਸ਼ਾਰਹਿਤ) ਹੋ ॥੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "भूत भविख भवान निरासा ॥९३॥",
      "sourceLineId": "138890",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਦਿ ਅਨੰਤ ਅਰੂਪ ਅਭੇਸਾ ॥",
      "transliteration": "aadh ana(n)t aroop abhesaa ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਆਦਿ (ਰੂਪ ਵਾਲੇ) ਅਨੰਤ, ਅਰੂਪ ਅਤੇ ਭੇਸ-ਰਹਿਤ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "आदि अनंत अरूप अभेसा ॥",
      "sourceLineId": "138891",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਘਟ ਘਟ ਭੀਤਰ ਕੀਯਾ ਪ੍ਰਵੇਸਾ ॥",
      "transliteration": "ghaT ghaT bheetar keeyaa pravesaa ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਘਟ ਘਟ (ਭਾਵ ਹਰ ਇਕ ਜੀਵ) ਵਿਚ ਪ੍ਰਵੇਸ਼ ਕੀਤਾ ਹੋਇਆ ਹੈ (ਅਰਥਾਤ ਸਭ ਵਿਚ ਆਤਮਾ ਹੋ ਕੇ ਵਸ ਰਹੇ ਹੋ)।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "घट घट भीतर कीया प्रवेसा ॥",
      "sourceLineId": "138892",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅੰਤਰ ਬਸਤ ਨਿਰੰਤਰ ਰਹਈ ॥",
      "transliteration": "a(n)tar basat nira(n)tar rahiee ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਹਰ ਇਕ ਦੇ ਅੰਦਰ ਨਿਰੰਤਰ ਵਸਦੇ ਰਹਿੰਦੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "अंतर बसत निरंतर रहई ॥",
      "sourceLineId": "138893",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਨਕ ਸਨੰਦ ਸਨਾਤਨ ਕਹਈ ॥੯੪॥",
      "transliteration": "sanak sana(n)dh sanaatan kahiee ||94||",
      "translation": "",
      "punjabiViakhya": "(ਇਹ ਵਿਚਾਰ) ਸਨਕ, ਸਨੰਦਨ, ਸਨਾਤਨ (ਅਤੇ ਸਨਤ ਕੁਮਾਰ) ਆਦਿ ਨੇ ਪ੍ਰਗਟ ਕੀਤਾ ਹੈ ॥੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "सनक सनंद सनातन कहई ॥९४॥",
      "sourceLineId": "138894",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਦਿ ਜੁਗਾਦਿ ਸਦਾ ਪ੍ਰਭੁ ਏਕੈ ॥",
      "transliteration": "aadh jugaadh sadhaa prabh ekai ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਪ੍ਰਭੂ! (ਤੁਸੀਂ) ਆਦਿ ਜੁਗਾਦਿ ਤੋਂ ਇਕ ਹੀ ਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "आदि जुगादि सदा प्रभु एकै ॥",
      "sourceLineId": "138895",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਧਰਿ ਧਰਿ ਮੂਰਤਿ ਫਿਰਤਿ ਅਨੇਕੈ ॥",
      "transliteration": "dhar dhar moorat firat anekai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਰੂਪ ਧਾਰ ਕੇ ਵਿਚਰ ਰਹੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "धरि धरि मूरति फिरति अनेकै ॥",
      "sourceLineId": "138896",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਭ ਜਗ ਕਹ ਇਹ ਬਿਧਿ ਭਰਮਾਯਾ ॥",
      "transliteration": "sabh jag keh ieh bidh bharamaayaa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਜਗਤ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਭਰਮਾਇਆ ਹੋਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "सभ जग कह इह बिधि भरमाया ॥",
      "sourceLineId": "138897",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਪੇ ਏਕ ਅਨੇਕ ਦਿਖਾਯਾ ॥੯੫॥",
      "transliteration": "aape ek anek dhikhaayaa ||95||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਆਪਣੇ ਆਪ ਨੂੰ ਇਕ ਤੋਂ ਅਨੇਕ ਕਰ ਕੇ ਵਿਖਾਇਆ ਹੋਇਆ ਹੈ ॥੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "आपे एक अनेक दिखाया ॥९५॥",
      "sourceLineId": "138898",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਘਟ ਘਟ ਮਹਿ ਸੋਇ ਪੁਰਖ ਬ੍ਯਾਪਕ ॥",
      "transliteration": "ghaT ghaT meh soi purakh bayaapak ||",
      "translation": "",
      "punjabiViakhya": "ਘਟ ਘਟ ਵਿਚ ਉਹ ਪੁਰਸ਼ (ਤੁਸੀਂ ਹੀ) ਵਿਆਪਤ ਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "घट घट महि सोइ पुरख ब्यापक ॥",
      "sourceLineId": "138899",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਕਲ ਜੀਵ ਜੰਤਨ ਕੇ ਥਾਪਕ ॥",
      "transliteration": "sakal jeev ja(n)tan ke thaapak ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਜੀਵ ਜੰਤੂਆਂ ਦੀ ਸਥਾਪਨਾ ਕਰਨ ਵਾਲੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "सकल जीव जंतन के थापक ॥",
      "sourceLineId": "138900",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਾ ਤੇ ਜੋਤਿ ਕਰਤ ਆਕਰਖਨ ॥",
      "transliteration": "jaa te jot karat aakarakhan ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ ਜੋਤਿ ਨੂੰ ਖਿਚ ਲੈਂਦੇ ਹੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "जा ते जोति करत आकरखन ॥",
      "sourceLineId": "138901",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਾ ਕਹ ਕਹਤ ਮ੍ਰਿਤਕ ਜਗ ਕੇ ਜਨ ॥੯੬॥",
      "transliteration": "taa keh kahat mritak jag ke jan ||96||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਜਗਤ ਵਾਲੇ ਲੋਗ ਮਰਿਆ ਹੋਇਆ ਕਹਿੰਦੇ ਹਨ ॥੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "ता कह कहत मृतक जग के जन ॥९६॥",
      "sourceLineId": "138902",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੁਮ ਜਗ ਕੇ ਕਾਰਨ ਕਰਤਾਰਾ ॥",
      "transliteration": "tum jag ke kaaran karataaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਹੀ ਜਗ ਦੇ ਕਾਰਨ ਅਤੇ ਕਰਤਾ ਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "तुम जग के कारन करतारा ॥",
      "sourceLineId": "138903",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਕੀ ਮਤਿ ਜਾਨਨਹਾਰਾ ॥",
      "transliteration": "ghaT ghaT kee mat jaananahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘਟ ਘਟ ਦੇ ਮਤ ਨੂੰ ਜਾਣਨ ਵਾਲੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "घटि घटि की मति जाननहारा ॥",
      "sourceLineId": "138904",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਿਰੰਕਾਰ ਨਿਰਵੈਰ ਨਿਰਾਲਮ ॥",
      "transliteration": "nira(n)kaar niravair niraalam ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਨਿਰਾਕਾਰ, ਨਿਰਵੈਰ, ਨਿਰਾਲੇ ਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "निरंकार निरवैर निरालम ॥",
      "sourceLineId": "138905",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਭ ਹੀ ਕੇ ਮਨ ਕੀ ਤੁਹਿ ਮਾਲਮ ॥੯੭॥",
      "transliteration": "sabh hee ke man kee tuh maalam ||97||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਭ ਦੇ ਮਨ ਦੀ (ਹਾਲਤ ਦਾ) ਤੁਹਾਨੂੰ ਪਤਾ ਹੈ ॥੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "सभ ही के मन की तुहि मालम ॥९७॥",
      "sourceLineId": "138906",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤੁਮ ਹੀ ਬ੍ਰਹਮਾ ਬਿਸਨ ਬਨਾਯੋ ॥",
      "transliteration": "tum hee brahamaa bisan banaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਹੀ ਬ੍ਰਹਮਾ ਅਤੇ ਵਿਸ਼ਣੂ ਬਣਾਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "तुम ही ब्रहमा बिसन बनायो ॥",
      "sourceLineId": "138907",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਹਾ ਰੁਦ੍ਰ ਤੁਮ ਹੀ ਉਪਜਾਯੋ ॥",
      "transliteration": "mahaa rudhr tum hee upajaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਹਾ ਰੁਦ੍ਰ ਨੂੰ ਵੀ ਤੁਸੀਂ ਹੀ ਉਤਪੰਨ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "महा रुद्र तुम ही उपजायो ॥",
      "sourceLineId": "138908",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੁਮ ਹੀ ਰਿਖਿ ਕਸਪਹਿ ਬਨਾਵਾ ॥",
      "transliteration": "tum hee rikh kasapeh banaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਤੁਸੀਂ ਹੀ ਕਸ਼੍ਰਯਪ ਰਿਸ਼ੀ ਨੂੰ ਬਣਾਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "तुम ही रिखि कसपहि बनावा ॥",
      "sourceLineId": "138909",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦਿਤ ਅਦਿਤ ਜਨ ਬੈਰ ਬਢਾਵਾ ॥੯੮॥",
      "transliteration": "dhit adhit jan bair baddaavaa ||98||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਿਤੀ ਤੇ ਅਦਿਤੀ ਦੀ ਸੰਤਾਨ ਵਿਚ ਵੈਰ ਵਧਾਇਆ ਹੈ ॥੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "दित अदित जन बैर बढावा ॥९८॥",
      "sourceLineId": "138910",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਗ ਕਾਰਨ ਕਰੁਨਾਨਿਧਿ ਸ੍ਵਾਮੀ ॥",
      "transliteration": "jag kaaran karunaanidh savaiaamee ||",
      "translation": "",
      "punjabiViakhya": "ਜਗ-ਕਾਰਨ, ਕਰੁਣਾ-ਨਿਧਾਨ, ਸੁਆਮੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "जग कारन करुनानिधि स्वामी ॥",
      "sourceLineId": "138911",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਮਲ ਨੈਨ ਅੰਤਰ ਕੇ ਜਾਮੀ ॥",
      "transliteration": "kamal nain a(n)tar ke jaamee ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਕਮਲ ਨੈਨ, ਅੰਤਰਯਾਮੀ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "कमल नैन अंतर के जामी ॥",
      "sourceLineId": "138912",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦਯਾ ਸਿੰਧੁ ਦੀਨਨ ਕੇ ਦਯਾਲਾ ॥",
      "transliteration": "dhayaa si(n)dh dheenan ke dhayaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਦਯਾ, ਦੇ ਸਮੁੰਦਰ, ਦੀਨ-ਦਿਆਲ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "दया सिंधु दीनन के दयाला ॥",
      "sourceLineId": "138913",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹੂਜੈ ਕ੍ਰਿਪਾਨਿਧਾਨ ਕ੍ਰਿਪਾਲਾ ॥੯੯॥",
      "transliteration": "hoojai kirapaanidhaan kirapaalaa ||99||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕ੍ਰਿਪਾ-ਨਿਧਾਨ! (ਤੁਸੀਂ ਸਾਡੇ ਉਤੇ) ਕ੍ਰਿਪਾ ਕਰੋ ॥੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "हूजै कृपानिधान कृपाला ॥९९॥",
      "sourceLineId": "138914",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਰਨ ਪਰੇ ਇਹ ਬਿਧਿ ਬਿਨਤੀ ਕਰਿ ॥",
      "transliteration": "charan pare ieh bidh binatee kar ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਹਾਡੇ) ਚਰਨਾ ਵਿਚ ਪਏ ਹੋਏ (ਅਸੀਂ) ਇਸ ਤਰ੍ਰਹਾ ਬੇਨਤੀ ਕਰਦੇ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "चरन परे इह बिधि बिनती करि ॥",
      "sourceLineId": "138915",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤ੍ਰਾਹਿ ਤ੍ਰਾਹਿ ਰਾਖਹੁ ਹਮ ਧੁਰਧਰ ॥",
      "transliteration": "traeh traeh raakhahu ham dhuradhar ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਹੇ ਧੁਰ ਤੋਂ ਹੀ ਮਰਯਾਦਾ ਨੂੰ ਧਾਰਨ ਕਰ ਵਾਲੇ! ਸਾਨੂੰ ਬਚਾ ਲਵੋ, ਬਚਾ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "त्राहि त्राहि राखहु हम धुरधर ॥",
      "sourceLineId": "138916",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹ ਕਹ ਹਸਾ ਬਚਨ ਸੁਨ ਕਾਲਾ ॥",
      "transliteration": "keh keh hasaa bachan sun kaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ (ਉਨ੍ਰਹਾ ਦੇ) ਬੋਲ ਸੁਣ ਕੇ 'ਕਹ ਕਹ' ਕਰ ਕੇ ਹਸਣ ਲਗਾ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "कह कह हसा बचन सुन काला ॥",
      "sourceLineId": "138917",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭਗਤ ਜਾਨ ਕਰ ਭਯੋ ਕ੍ਰਿਪਾਲਾ ॥੧੦੦॥",
      "transliteration": "bhagat jaan kar bhayo kirapaalaa ||100||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਗਤ ਜਾਣ ਕੇ ਕ੍ਰਿਪਾਲੂ ਹੋ ਗਿਆ ॥੧੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "भगत जान कर भयो कृपाला ॥१००॥",
      "sourceLineId": "138918",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਛ ਰਛ ਕਰਿ ਸਬਦ ਉਚਾਰੋ ॥",
      "transliteration": "rachh rachh kar sabadh uchaaro ||",
      "translation": "",
      "punjabiViakhya": "(ਮਹਾ ਕਾਲ ਨੇ ਅਗੋਂ) 'ਰਖਿਆ, ਰਖਿਆ' ਸ਼ਬਦਾ ਦਾ ਉਚਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "रछ रछ करि सबद उचारो ॥",
      "sourceLineId": "138919",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਭ ਦੇਵਨ ਕਾ ਸੋਕ ਨਿਵਾਰੋ ॥",
      "transliteration": "sabh dhevan kaa sok nivaaro ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਦੇਵਤਿਆਂ ਦਾ ਦੁਖ ਦੂਰ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "सभ देवन का सोक निवारो ॥",
      "sourceLineId": "138920",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਿਜੁ ਭਗਤਨ ਕਹ ਲਿਯੋ ਉਬਾਰਾ ॥",
      "transliteration": "nij bhagatan keh liyo ubaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਭਗਤਾ ਨੂੰ ਬਚਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1364,
      "hindi": "",
      "hindiTransliteration": "निजु भगतन कह लियो उबारा ॥",
      "sourceLineId": "138921",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1364_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੁਸਟਨ ਕੇ ਸੰਗ ਕਰਿਯੋ ਅਖਾਰਾ ॥੧੦੧॥",
      "transliteration": "dhusaTan ke sa(n)g kariyo akhaaraa ||101||",
      "translation": "",
