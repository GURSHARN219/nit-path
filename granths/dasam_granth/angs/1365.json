{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1365,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1365_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਰਿ ਕਰਿ ਕੋਪ ਕਾਲ ਸ੍ਰੀ ਤਬ ਹੀ ॥",
      "transliteration": "kar kar kop kaal sree tab hee ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਸ੍ਰੀ ਕਾਲ ਕ੍ਰੋਧ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "करि करि कोप काल स्री तब ही ॥",
      "sourceLineId": "138923",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਥ ਪਰ ਚੜਾ ਸਸਤ੍ਰ ਲੈ ਸਭ ਹੀ ॥",
      "transliteration": "rath par chaRaa sasatr lai sabh hee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਸ਼ਸਤ੍ਰਾ ਨੂੰ ਧਾਰਨ ਕਰ ਕੇ ਰਥ ਉਤੇ ਚੜ੍ਰਹ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "रथ पर चड़ा ससत्र लै सभ ही ॥",
      "sourceLineId": "138924",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਕਲ ਸਤ੍ਰੁਅਨ ਕੇ ਛੈ ਕਾਰਨ ॥",
      "transliteration": "sakal satruan ke chhai kaaran ||",
      "translation": "",
      "punjabiViakhya": "(ਅਜਿਹਾ ਕਰਨ ਦਾ ਉਸ ਦਾ ਮੂਲ ਮਨੋਰਥ ਸੀ) ਸਾਰਿਆਂ ਵੈਰੀਆਂ ਦਾ ਨਾਸ਼ ਕਰਨਾ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "सकल सत्रुअन के छै कारन ॥",
      "sourceLineId": "138925",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਭ ਸੰਤਨ ਕੇ ਪ੍ਰਾਨ ਉਬਾਰਨ ॥੧੦੨॥",
      "transliteration": "sabh sa(n)tan ke praan ubaaran ||102||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਸੰਤਾ ਦੇ ਪ੍ਰਾਣਾ ਦੀ ਰਖਿਆ ਕਰਨਾ ॥੧੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "सभ संतन के प्रान उबारन ॥१०२॥",
      "sourceLineId": "138926",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪ੍ਰਾਨ ਔਰ ਪਾਨਿਪ ਧਨੁ ਰਾਜਾ ॥",
      "transliteration": "praan aauar paanip dhan raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਾਣਾ ਅਤੇ ਸ਼ੋਭਾ ਰੂਪ ਧਨ ਦਾ ਸੁਆਮੀ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "प्रान और पानिप धनु राजा ॥",
      "sourceLineId": "138927",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਖਨ ਚੜਾ ਸੇਵਕਨ ਕਾਜਾ ॥",
      "transliteration": "raakhan chaRaa sevakan kaajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸੇਵਕਾ ਦੀ ਰਖਿਆ ਲਈ ਚੜ੍ਰਹ ਪਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "राखन चड़ा सेवकन काजा ॥",
      "sourceLineId": "138928",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਾ ਕੀ ਧੁਜਾ ਬਿਖੈ ਰਾਜਿਤ ਅਸਿ ॥",
      "transliteration": "jaa kee dhujaa bikhai raajit as ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਝੰਡੇ ਵਿਚ ਤਲਵਾਰ (ਦਾ ਚਿੰਨ੍ਰਹ) ਸ਼ੋਭ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "जा की धुजा बिखै राजित असि ॥",
      "sourceLineId": "138929",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਿਰਖਿ ਸਤ੍ਰੁ ਜਿਹ ਹੋਤ ਬਿਮਨ ਬਸਿ ॥੧੦੩॥",
      "transliteration": "nirakh satr jeh hot biman bas ||103||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਵੈਰੀ ਚਿੰਤਾ ਵਿਚ ਫਸ ਜਾਦੇ ਸਨ ॥੧੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "निरखि सत्रु जिह होत बिमन बसि ॥१०३॥",
      "sourceLineId": "138930",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਸਿਧੁਜ ਅਧਿਕ ਕੋਪ ਕਰਿ ਧਾਯੋ ॥",
      "transliteration": "asidhuj adhik kop kar dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਿਧੁਜ (ਜਿਸ ਦੀ ਧੁਜਾ ਉਪਰ ਤਲਵਾਰ ਦਾ ਚਿੰਨ੍ਰਹ ਹੈ, ਭਾਵ-ਮਹਾ ਕਾਲ) ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਚੜ੍ਰਹ ਪਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "असिधुज अधिक कोप करि धायो ॥",
      "sourceLineId": "138931",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬੈਰਿ ਬ੍ਰਿੰਦ ਦਲ ਪ੍ਰਗਟ ਖਪਾਯੋ ॥",
      "transliteration": "bair bira(n)dh dhal pragaT khapaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੈਰੀ ਦਲਾ ਦੇ ਸਮੂਹ ਨੂੰ ਜ਼ਾਹਿਰਾ ਤੌਰ ਤੇ ਖਪਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "बैरि बृंद दल प्रगट खपायो ॥",
      "sourceLineId": "138932",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਾਧੁਨ ਕੀ ਰਛਾ ਕਰਿ ਲੀਨੀ ॥",
      "transliteration": "saadhun kee rachhaa kar leenee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਸਾਧਾ ਦੀ ਰਖਿਆ ਕਰ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "साधुन की रछा करि लीनी ॥",
      "sourceLineId": "138933",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਤ੍ਰੁ ਸੈਨ ਤਿਲ ਤਿਲ ਖੈ ਕੀਨੀ ॥੧੦੪॥",
      "transliteration": "satr sain til til khai keenee ||104||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੈਰੀਆਂ ਦੀ ਸੈਨਾ ਨੂੰ ਤਿਲ ਤਿਲ ਕਰ ਕੇ ਨਸ਼ਟ ਕਰ ਦਿੱਤਾ ॥੧੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "सत्रु सैन तिल तिल खै कीनी ॥१०४॥",
      "sourceLineId": "138934",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਲ ਤਿਲ ਏਕ ਏਕ ਕਰਿ ਡਾਰਾ ॥",
      "transliteration": "til til ek ek kar ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਇਕ ਨੂੰ ਤਿਲ ਤਿਲ ਜਿੰਨਾ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "तिल तिल एक एक करि डारा ॥",
      "sourceLineId": "138935",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗਜੀ ਰਥੀ ਬਾਜਿਯਨ ਬਿਦਾਰਾ ॥",
      "transliteration": "gajee rathee baajiyan bidhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਾਥੀਆਂ, ਘੋੜਿਆਂ ਅਤੇ ਰਥਾ ਵਾਲਿਆਂ ਨੂੰ ਨਸ਼ਟ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "गजी रथी बाजियन बिदारा ॥",
      "sourceLineId": "138936",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਿਹ ਤੇ ਅਮਿਤ ਅਸੁਰ ਉਠਿ ਧਏ ॥",
      "transliteration": "teh te amit asur uTh dhe ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਅਣਗਿਣਤ ਦੈਂਤ ਉੱਠ ਕੇ ਦੌੜ ਪਏ ਅਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "तिह ते अमित असुर उठि धए ॥",
      "sourceLineId": "138937",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਘੇਰਤ ਮਹਾਕਾਲ ਕਹ ਭਏ ॥੧੦੫॥",
      "transliteration": "gherat mahaakaal keh bhe ||105||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਕਾਲ ਨੂੰ ਘੇਰ ਲਿਆ ॥੧੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "घेरत महाकाल कह भए ॥१०५॥",
      "sourceLineId": "138938",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਚਤ ਭਯੋ ਜਬ ਹੀ ਰਨ ਦਾਰੁਨ ॥",
      "transliteration": "machat bhayo jab hee ran dhaarun ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਭਿਆਨਕ ਯੁੱਧ ਸ਼ੁਰੂ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "मचत भयो जब ही रन दारुन ॥",
      "sourceLineId": "138939",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਟਿ ਕਟਿ ਗਏ ਬਾਜ ਅਰੁ ਬਾਰੁਨ ॥",
      "transliteration": "kaT kaT ge baaj ar baarun ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਹਾਥੀ ਅਤੇ ਘੋੜੇ ਕਟੇ ਜਾਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "कटि कटि गए बाज अरु बारुन ॥",
      "sourceLineId": "138940",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੰਬਕ ਗੀਧ ਮਾਸੁ ਲੈ ਗਏ ॥",
      "transliteration": "ja(n)bak geedh maas lai ge ||",
      "translation": "",
      "punjabiViakhya": "ਗਿਧਾ ਅਤੇ ਗਿਦੜ ਮਾਸ ਲੈ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "जंबक गीध मासु लै गए ॥",
      "sourceLineId": "138941",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਨ ਤਜਿ ਸੁਭਟਨ ਭਾਜਤ ਭਏ ॥੧੦੬॥",
      "transliteration": "ran taj subhaTan bhaajat bhe ||106||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਯੋਧੇ ਰਣ ਛਡ ਕੇ ਭਜ ਗਏ ॥੧੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "रन तजि सुभटन भाजत भए ॥१०६॥",
      "sourceLineId": "138942",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਸਤ੍ਰ ਸਾਜ ਕੋਪਾ ਤਬ ਕਾਲਾ ॥",
      "transliteration": "sasatr saaj kopaa tab kaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਮਹਾ ਕਾਲ ਸ਼ਸਤ੍ਰ ਸੰਭਾਲ ਕੇ ਬਹੁਤ ਰੋਹ ਵਿਚ ਆ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "ससत्र साज कोपा तब काला ॥",
      "sourceLineId": "138943",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਧਾਰਨ ਭਯੋ ਭੇਸ ਬਿਕਰਾਲਾ ॥",
      "transliteration": "dhaaran bhayo bhes bikaraalaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਿਆਨਕ ਭੇਸ ਧਾਰਨ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "धारन भयो भेस बिकराला ॥",
      "sourceLineId": "138944",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਾਨ ਅਨੇਕ ਕੋਪ ਕਰਿ ਛੋਰੇ ॥",
      "transliteration": "baan anek kop kar chhore ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਬਹੁਤ ਸਾਰੇ ਬਾਣ ਛਡੇ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "बान अनेक कोप करि छोरे ॥",
      "sourceLineId": "138945",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਤ੍ਰੁ ਅਨੇਕਨ ਕੇ ਸਿਰ ਫੋਰੇ ॥੧੦੭॥",
      "transliteration": "satr anekan ke sir fore ||107||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਵੈਰੀਆਂ ਦੇ ਸਿਰ ਫੋੜ ਦਿੱਤੇ ॥੧੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "सत्रु अनेकन के सिर फोरे ॥१०७॥",
      "sourceLineId": "138946",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਕਾਹਕੀ ਮਾਚਾ ਸੰਗ੍ਰਾਮਾ ॥",
      "transliteration": "hakaahakee maachaa sa(n)graamaa ||",
      "translation": "",
      "punjabiViakhya": "ਖਿਚੋਤਾਣੀ ਨਾਲ ਯੁੱਧ ਹੋਣ ਲਗ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "हकाहकी माचा संग्रामा ॥",
      "sourceLineId": "138947",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਠੈ ਦਏ ਬਹੁ ਅਰਿ ਮ੍ਰਿਤੁ ਧਾਮਾ ॥",
      "transliteration": "paThai dhe bahu ar mrit dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "(ਮਹਾ ਕਾਲ ਨੇ) ਬਹੁਤ ਸਾਰੇ ਵੈਰੀਆਂ ਨੂੰ ਯਮ-ਲੋਕ ਭੇਜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "पठै दए बहु अरि मृतु धामा ॥",
      "sourceLineId": "138948",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਾਜ ਖੁਰਨ ਭੂ ਆਕੁਲ ਭਈ ॥",
      "transliteration": "baaj khuran bhoo aakul bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਘੋੜਿਆਂ ਦੇ ਖੁਰਾ (ਦੇ ਵਜਣ ਨਾਲ) ਧਰਤੀ ਵਿਆਕੁਲ ਹੋ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "बाज खुरन भू आकुल भई ॥",
      "sourceLineId": "138949",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਖਟ ਪਟ ਭੂਮਿ ਗਗਨ ਉਡਿ ਗਈ ॥੧੦੮॥",
      "transliteration": "khaT paT bhoom gagan udd giee ||108||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੂਮੀ ਦੇ ਛੇ ਪੜਦੇ (ਪਟ, ਪੁੜ) ਆਕਾਸ਼ ਵਿਚ (ਧੂੜ ਬਣ ਕੇ) ਉਡ ਗਏ ॥੧੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "खट पट भूमि गगन उडि गई ॥१०८॥",
      "sourceLineId": "138950",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਏਕੈ ਰਹਿ ਗਯੋ ਜਬੈ ਪਯਾਲਾ ॥",
      "transliteration": "ekai reh gayo jabai payaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਕੇਵਲ ਇਕੋ ਪਾਤਾਲ ਰਹਿ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "एकै रहि गयो जबै पयाला ॥",
      "sourceLineId": "138951",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਐਸਾ ਮਚਾ ਜੁਧ ਬਿਕਰਾਲਾ ॥",
      "transliteration": "aaisaa machaa judh bikaraalaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਅਜਿਹਾ ਭਿਆਨਕ ਯੁੱਧ ਮਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "ऐसा मचा जुध बिकराला ॥",
      "sourceLineId": "138952",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕੈ ਭਯੋ ਪ੍ਰਸੇਤਾ ॥",
      "transliteration": "mahaa kaal kai bhayo prasetaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਮਹਾ ਕਾਲ ਨੂੰ ਪਸੀਨਾ ਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "महा काल कै भयो प्रसेता ॥",
      "sourceLineId": "138953",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਡਾਰਾ ਭੂਮਿ ਪੌਛਿ ਕਰਿ ਤੇਤਾ ॥੧੦੯॥",
      "transliteration": "ddaaraa bhoom pauachh kar tetaa ||109||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਉਹ ਸਾਰਾ ਪੂੰਝ ਕੇ ਧਰਤੀ ਉਤੇ ਸੁਟ ਦਿੱਤਾ ॥੧੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "डारा भूमि पौछि करि तेता ॥१०९॥",
      "sourceLineId": "138954",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਟਾਚਾਰਜ ਰੂਪ ਤਬ ਧਰਾ ॥",
      "transliteration": "bhaTaachaaraj roop tab dharaa ||",
      "translation": "",
      "punjabiViakhya": "(ਮਹਾ ਕਾਲ ਦੇ) ਮੁਖ ਦਾ ਜੋ ਪਸੀਨਾ ਧਰਤੀ ਉਤੇ ਡਿਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "भटाचारज रूप तब धरा ॥",
      "sourceLineId": "138955",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਦਨ ਪ੍ਰਸੇਤ ਧਰਨਿ ਜੋ ਪਰਾ ॥",
      "transliteration": "badhan praset dharan jo paraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਤਦ ਭਟਾਚਾਰਜ ਦਾ ਰੂਪ ਧਾਰਨ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "बदन प्रसेत धरनि जो परा ॥",
      "sourceLineId": "138956",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਢਾਢਿ ਸੈਨ ਢਾਢੀ ਬਪੁ ਲਯੋ ॥",
      "transliteration": "ddaadd sain ddaaddee bap layo ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਢਾਢਿ ਸੈਨ ਨੇ ਢਾਢੀ ਦਾ ਸ਼ਰੀਰ ('ਬਪੁ') ਧਾਰਨ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "ढाढि सैन ढाढी बपु लयो ॥",
      "sourceLineId": "138957",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਰਖਾ ਬਾਰ ਉਚਾਰਤ ਭਯੋ ॥੧੧੦॥",
      "transliteration": "karakhaa baar uchaarat bhayo ||110||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਰਖਾ ਛੰਦ ਵਿਚ (ਮਹਾ ਕਾਲ ਦੇ ਯਸ਼ ਦੀ) ਵਾਰ ਉਚਾਰਨ ਲਗਾ ॥੧੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "करखा बार उचारत भयो ॥११०॥",
      "sourceLineId": "138958",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਹ ਅਰਿ ਕਾਲ ਕ੍ਰਿਪਾਨ ਪ੍ਰਹਾਰੈ ॥",
      "transliteration": "jeh ar kaal kirapaan prahaarai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਉਤੇ ਕਾਲ ਨੇ ਕ੍ਰਿਪਾਨ ਦਾ ਵਾਰ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "जिह अरि काल कृपान प्रहारै ॥",
      "sourceLineId": "138959",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਕ ਤੇ ਦੋਇ ਪੁਰਖ ਕੈ ਡਾਰੈ ॥",
      "transliteration": "eik te dhoi purakh kai ddaarai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੂੰ) ਇਕ ਤੋਂ ਦੋ ਪੁਰਸ਼ ਬਣਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "इक ते दोइ पुरख कै डारै ॥",
      "sourceLineId": "138960",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦ੍ਵੈ ਮਨੁਖਨ ਪਰ ਕਰਤ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "dhavai manukhan par karat prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਉਨ੍ਰਹਾ) ਦੋ ਮਨੁੱਖਾ ਉਤੇ ਵਾਰ ਕਰਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "द्वै मनुखन पर करत प्रहारा ॥",
      "sourceLineId": "138961",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦ੍ਵੈ ਤੇ ਹੋਤ ਛਿਨਿਕ ਮੋ ਚਾਰਾ ॥੧੧੧॥",
      "transliteration": "dhavai te hot chhinik mo chaaraa ||111||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਛਿਣ ਭਰ ਵਿਚ ਦੋ ਤੋਂ ਚਾਰ ਹੋ ਜਾਦੇ ॥੧੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "द्वै ते होत छिनिक मो चारा ॥१११॥",
      "sourceLineId": "138962",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਹੁਰਿ ਕਾਲ ਕੀਨਾ ਘਮਸਾਨਾ ॥",
      "transliteration": "bahur kaal keenaa ghamasaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਨੇ ਫਿਰ ਘਮਸਾਨ ਯੁੱਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "बहुरि काल कीना घमसाना ॥",
      "sourceLineId": "138963",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਾਰਤ ਭਯੋ ਦੈਤ ਬਿਧਿ ਨਾਨਾ ॥",
      "transliteration": "maarat bhayo dhait bidh naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਤਰ੍ਰਹਾ ਨਾਲ ਦੈਂਤਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "मारत भयो दैत बिधि नाना ॥",
      "sourceLineId": "138964",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਧਿਕ ਪ੍ਰਸੇਤ ਧਰਨਿ ਪਰ ਪਰਿਯੋ ॥",
      "transliteration": "adhik praset dharan par pariyo ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ ਮਹਾ ਕਾਲ ਦਾ) ਹੋਰ ਪਸੀਨਾ ਧਰਤੀ ਉਤੇ ਪਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "अधिक प्रसेत धरनि पर परियो ॥",
      "sourceLineId": "138965",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭੂਮ ਸੈਨ ਤਾ ਤੇ ਬਪੁ ਧਰਿਯੋ ॥੧੧੨॥",
      "transliteration": "bhoom sain taa te bap dhariyo ||112||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਤੋਂ ਭੂਮ ਸੈਨ ਨੇ ਸ਼ਰੀਰ ਧਾਰਨ ਕੀਤਾ ॥੧੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "भूम सैन ता ते बपु धरियो ॥११२॥",
      "sourceLineId": "138966",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਧਸੌ ਹੁੰਕਾਰਾ ॥",
      "transliteration": "kaadd kirapaan dhasau hu(n)kaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਕ੍ਰਿਪਾਨ ਕਢ ਕੇ ਲਲਕਾਰਦਾ ਹੋਇਆ (ਵੈਰੀ ਸੈਨਾ ਵਿਚ) ਧਸ ਵੜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "काढि कृपान धसौ हुँकारा ॥",
      "sourceLineId": "138967",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਿਨ ਤੇ ਅਮਿਤ ਗਨਨ ਤਨ ਧਾਰਾ ॥",
      "transliteration": "tin te amit ganan tan dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਬੇਸ਼ੁਮਾਰ ਗਣਾ ਨੇ ਆਕਾਰ ਧਾਰਨ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "तिन ते अमित गनन तन धारा ॥",
      "sourceLineId": "138968",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਢੋਲ ਪਟਹਿ ਇਕ ਤਾਲ ਬਜਾਵੈ ॥",
      "transliteration": "ddol paTeh ik taal bajaavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਇਕ ਢੋਲ, ਪੱਟਾ ਅਤੇ ਤਾਲ ਵਜਾਉਾਂਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "ढोल पटहि इक ताल बजावै ॥",
      "sourceLineId": "138969",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1365_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜੰਗ ਮੁਚੰਗ ਉਪੰਗ ਸੁਨਾਵੈ ॥੧੧੩॥",
      "transliteration": "ja(n)g mucha(n)g upa(n)g sunaavai ||113||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੰਗ, ਮੁਚੰਗ ਤੇ ਉਪੰਗ (ਆਦਿ ਵਾਜੇ ਵਜਾ ਕੇ) ਸੁਣਾਉਾਂਦੇ ॥੧੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1365,
      "hindi": "",
      "hindiTransliteration": "जंग मुचंग उपंग सुनावै ॥११३॥",
      "sourceLineId": "138970",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
