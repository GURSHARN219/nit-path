{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1366,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1366_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੋਮੁਖ ਝਾਝਰ ਤੂਰ ਅਪਾਰਾ ॥",
      "transliteration": "gomukh jhaajhar toor apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਸ਼ੁਮਾਰ ਗੋਮੁਖ, ਝਾਝਰ, ਤੂਰ,",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "गोमुख झाझर तूर अपारा ॥",
      "sourceLineId": "138971",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਢੋਲ ਮ੍ਰਿਦੰਗ ਮੁਚੰਗ ਨਗਾਰਾ ॥",
      "transliteration": "ddol miradha(n)g mucha(n)g nagaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ, ਮ੍ਰਿਦੰਗ, ਮੁਚੰਗ, ਨਗਾਰੇ (ਆਦਿ ਵਜਣ ਲਗੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "ढोल मृदंग मुचंग नगारा ॥",
      "sourceLineId": "138972",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਾਜਤ ਭੇਰ ਭਭਾਕਹਿ ਭੀਖਨ ॥",
      "transliteration": "baajat bher bhabhaakeh bheekhan ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਭੇਰੀਆਂ 'ਭਭਾਕ ਭਭਾਕ' ਕਰ ਕੇ ਵਜਣ ਲਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "बाजत भेर भभाकहि भीखन ॥",
      "sourceLineId": "138973",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਸਿ ਧਨੁ ਤਜਤ ਸੁਭਟ ਸਰ ਤੀਛਨ ॥੧੧੪॥",
      "transliteration": "kas dhan tajat subhaT sar teechhan ||114||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਧਨੁਸ਼ਾ ਨੂੰ ਖਿਚ ਕੇ ਤੀਰ ਛਡਣ ਲਗੇ ॥੧੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "कसि धनु तजत सुभट सर तीछन ॥११४॥",
      "sourceLineId": "138974",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਰਿ ਗੇ ਕੁੰਡ ਤਹਾ ਸ੍ਰੋਨਤ ਤਨ ॥",
      "transliteration": "bhar ge ku(n)dd tahaa sronat tan ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਲਹੂ ਦੇ ਟੋਏ ਭਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "भरि गे कुँड तहा स्रोनत तन ॥",
      "sourceLineId": "138975",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪ੍ਰਗਟੇ ਅਸੁਰ ਤਵਨ ਤੇ ਅਨਗਨ ॥",
      "transliteration": "pragaTe asur tavan te anagan ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਵਿਚੋਂ ਅਣਗਿਣਤ ਦੈਂਤ ਪ੍ਰਗਟ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "प्रगटे असुर तवन ते अनगन ॥",
      "sourceLineId": "138976",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਮਿਲਿ ਕਰਤ ਪੁਕਾਰਾ ॥",
      "transliteration": "maar maar mil karat pukaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮਿਲ ਕੇ 'ਮਾਰੋ ਮਾਰੋ' ਪੁਕਾਰਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "मारि मारि मिलि करत पुकारा ॥",
      "sourceLineId": "138977",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਿਨ ਤੇ ਪ੍ਰਗਟਤ ਅਸੁਰ ਹਜਾਰਾ ॥੧੧੫॥",
      "transliteration": "tin te pragaTat asur hajaaraa ||115||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਹਜ਼ਾਰਾ ਦੈਂਤ ਪੈਦਾ ਹੋਣ ਲਗੇ ॥੧੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "तिन ते प्रगटत असुर हजारा ॥११५॥",
      "sourceLineId": "138978",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਿਨਹਿ ਕਾਲ ਜਬ ਧਰਨਿ ਗਿਰਾਵੈ ॥",
      "transliteration": "tineh kaal jab dharan giraavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ (ਮਾਰ ਕੇ) ਜਦ ਕਾਲ ਧਰਤੀ ਉਤੇ ਡਿਗਾਉਾਂਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "तिनहि काल जब धरनि गिरावै ॥",
      "sourceLineId": "138979",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸ੍ਰੋਨ ਪੁਲਿਤ ਹ੍ਵੈ ਭੂਮਿ ਸੁਹਾਵੈ ॥",
      "transliteration": "sron pulit havai bhoom suhaavai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਲਹੂ ਨਾਲ ਭਿਜੀ ਭੂਮੀ ਸੁਸ਼ੋਭਿਤ ਹੋ ਜਾਦੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "स्रोन पुलित ह्वै भूमि सुहावै ॥",
      "sourceLineId": "138980",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਤੇ ਅਮਿਤ ਅਸੁਰ ਉਠਿ ਭਜਹੀ ॥",
      "transliteration": "taa te amit asur uTh bhajahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਬੇਸ਼ੁਮਾਰ ਦੈਂਤ ਉਠ ਕੇ ਭਜ ਪੈਂਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "ता ते अमित असुर उठि भजही ॥",
      "sourceLineId": "138981",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਾਨ ਕ੍ਰਿਪਾਨ ਸੈਹਥੀ ਸਜਹੀ ॥੧੧੬॥",
      "transliteration": "baan kirapaan saihathee sajahee ||116||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਾਣ, ਕ੍ਰਿਪਾਨਾ ਤੇ ਬਰਛੀਆਂ ਸਜਾ ਲੈਂਦੇ ॥੧੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "बान कृपान सैहथी सजही ॥११६॥",
      "sourceLineId": "138982",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਧਿਕ ਕੋਪ ਕਰਿ ਸਮੁਹਿ ਸਿਧਾਰੇ ॥",
      "transliteration": "adhik kop kar samuh sidhaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਸਾਹਮਣੇ ਆ ਡਟਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "अधिक कोप करि समुहि सिधारे ॥",
      "sourceLineId": "138983",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਭੈ ਕਾਲ ਛਿਨ ਇਕ ਮੋ ਮਾਰੇ ॥",
      "transliteration": "sabhai kaal chhin ik mo maare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ) ਸਾਰਿਆਂ ਨੂੰ ਕਾਲ ਇਕ ਛਿਣ ਵਿਚ ਮਾਰ ਦਿੰਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "सभै काल छिन इक मो मारे ॥",
      "sourceLineId": "138984",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਿਨ ਤੇ ਸ੍ਰੋਨਤ ਪਰਾ ਸਬੂਹਾ ॥",
      "transliteration": "tin te sronat paraa saboohaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦਾ ਜੋ ਸਾਰਾ ਲਹੂ (ਧਰਤੀ ਉਤੇ) ਡਿਗਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "तिन ते स्रोनत परा सबूहा ॥",
      "sourceLineId": "138985",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਾਜਤ ਭਏ ਅਸੁਰ ਤਬ ਬਿਯੂਹਾ ॥੧੧੭॥",
      "transliteration": "saajat bhe asur tab biyoohaa ||117||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਉਸ ਤੋਂ) ਦੈਂਤ ਸੈਨਾ ਸਜਾ ਲੈਂਦੇ ॥੧੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "साजत भए असुर तब बियूहा ॥११७॥",
      "sourceLineId": "138986",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦਾਰੁਨ ਮਚਾ ਜੁਧ ਤਬ ਝਟ ਪਟ ॥",
      "transliteration": "dhaarun machaa judh tab jhaT paT ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਝਟ ਪਟ ਭਿਅੰਕਰ ਯੁੱਧ ਸ਼ੁਰੂ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "दारुन मचा जुध तब झट पट ॥",
      "sourceLineId": "138987",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਉਡਿਗੇ ਬਾਜ ਖੂਰਨ ਭੂ ਖਟ ਪਟ ॥",
      "transliteration": "auddige baaj khooran bhoo khaT paT ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਦੇ ਛੇ ਪੜਦੇ ਘੋੜਿਆਂ ਦੇ ਖੁਰਾ ਨਾਲ ਉਡ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "उडिगे बाज खूरन भू खट पट ॥",
      "sourceLineId": "138988",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹ੍ਵੈ ਗੇ ਤੇਰਹ ਗਗਨ ਅਪਾਰਾ ॥",
      "transliteration": "havai ge tereh gagan apaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ ਸੱਤ ਤੋਂ) ਤੇਰ੍ਰਹਾ ਆਕਾਸ਼ ਬਣ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "ह्वै गे तेरह गगन अपारा ॥",
      "sourceLineId": "138989",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਏਕੈ ਰਹਿ ਗਯੋ ਤਹਾ ਪਤਾਰਾ ॥੧੧੮॥",
      "transliteration": "ekai reh gayo tahaa pataaraa ||118||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਥੇ (ਬਸ) ਇਕੋ ਪਾਤਾਲ ਰਹਿ ਗਿਆ ॥੧੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "एकै रहि गयो तहा पतारा ॥११८॥",
      "sourceLineId": "138990",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭਟਾਚਾਰਜ ਇਤੈ ਜਸੁ ਗਾਵੈ ॥",
      "transliteration": "bhaTaachaaraj itai jas gaavai ||",
      "translation": "",
      "punjabiViakhya": "ਇਧਰ ਭਟਾਚਾਰਜ (ਮਹਾ ਕਾਲ ਦਾ) ਯਸ਼ ਗਾ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "भटाचारज इतै जसु गावै ॥",
      "sourceLineId": "138991",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਢਾਢਿ ਸੈਨ ਕਰਖਾਹੁ ਸੁਨਾਵੈ ॥",
      "transliteration": "ddaadd sain karakhaahu sunaavai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਢਾਢਿ ਸੈਨ ਕਰਖਾ (ਛੰਦ) ਸੁਣਾ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "ढाढि सैन करखाहु सुनावै ॥",
      "sourceLineId": "138992",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਿਮਿ ਤਿਮਿ ਕਾਲਹਿ ਬਢੈ ਗੁਮਾਨਾ ॥",
      "transliteration": "tim tim kaaleh baddai gumaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਿਵੇਾਂ ਤਿਵੇਾਂ ਕਾਲ ਦਾ ਗੁਮਾਨ ਵਧਦਾ ਜਾ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "तिमि तिमि कालहि बढै गुमाना ॥",
      "sourceLineId": "138993",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚਹਿ ਚਹਿ ਹਨੇ ਦੁਬਹਿਯਾ ਨਾਨਾ ॥੧੧੯॥",
      "transliteration": "cheh cheh hane dhubahiyaa naanaa ||119||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚਾਹ ਚਾਹ ਕੇ (ਮਨ ਪਸੰਦ ਅਨੁਸਾਰ) ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੇ 'ਦੁਬਹਿਯਾ' (ਦੋਹਾ ਬਾਹਵਾ ਨਾਲ ਹਥਿਆਰ ਚਲਾਉਣ ਵਾਲੇ) (ਵੈਰੀਆਂ ਨੂੰ) ਮਾਰ ਰਿਹਾ ਸੀ ॥੧੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "चहि चहि हने दुबहिया नाना ॥११९॥",
      "sourceLineId": "138994",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਨ ਤੇ ਮੇਦ ਮਾਸ ਜੋ ਪਰ ਹੀ ॥",
      "transliteration": "tin te medh maas jo par hee ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ (ਦੈਂਤਾ) ਦਾ ਜੋ ਮਾਸ ਅਤੇ ਮਿਝ (ਧਰਤੀ ਉਤੇ) ਪੈਂਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "तिन ते मेद मास जो पर ही ॥",
      "sourceLineId": "138995",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਥੀ ਗਜੀ ਬਾਜੀ ਤਨ ਧਰ ਹੀ ॥",
      "transliteration": "rathee gajee baajee tan dhar hee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਰਥਵਾਨਾ, ਹਾਥੀਆਂ ਅਤੇ ਘੋੜਿਆ ਦੇ ਸਵਾਰਾ ਦਾ ਰੂਪ ਧਾਰਨ ਕਰ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "रथी गजी बाजी तन धर ही ॥",
      "sourceLineId": "138996",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕੇਤਿਕ ਭਏ ਅਸੁਰ ਬਿਕਰਾਰਾ ॥",
      "transliteration": "ketik bhe asur bikaraaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਕਿਤਨੇ ਭਿਆਨਕ ਦੈਂਤ ਪੈਦਾ ਹੋਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "केतिक भए असुर बिकरारा ॥",
      "sourceLineId": "138997",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਿਨ ਕੇ ਬਰਨਨ ਕਰੌ ਸਿਧਾਰਾ ॥੧੨੦॥",
      "transliteration": "tin ke baranan karau sidhaaraa ||120||",
      "translation": "",
      "punjabiViakhya": "(ਹੁਣ) ਉਨ੍ਰਹਾ ਦਾ ਚੰਗੀ ਤਰ੍ਰਹਾ ਵਰਣਨ ਕਰਦਾ ਹਾ ॥੧੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "तिन के बरनन करौ सिधारा ॥१२०॥",
      "sourceLineId": "138998",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਏਕੈ ਚਰਨ ਆਖਿ ਏਕੈ ਜਿਨਿ ॥",
      "transliteration": "ekai charan aakh ekai jin ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੀ ਇਕ ਅੱਖ ਅਤੇ ਇਕ ਹੀ ਚਰਨ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "एकै चरन आखि एकै जिनि ॥",
      "sourceLineId": "138999",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭੁਜਾ ਅਮਿਤ ਸਹਸ ਦ੍ਵੈ ਕੈ ਤਿਨ ॥",
      "transliteration": "bhujaa amit sahas dhavai kai tin ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦੀਆਂ ਦੋ ਦੋ ਹਜ਼ਾਰ (ਭਾਵ) ਅਮਿਤ ਭੁਜਾਵਾ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "भुजा अमित सहस द्वै कै तिन ॥",
      "sourceLineId": "139000",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪਾਚ ਪਾਚ ਸੈ ਭੁਜ ਕੇ ਘਨੇ ॥",
      "transliteration": "paach paach sai bhuj ke ghane ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤਿਆਂ ਦੀਆਂ ਪੰਜ ਪੰਜ ਸੈ ਭੁਜਾਵਾ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "पाच पाच सै भुज के घने ॥",
      "sourceLineId": "139001",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਹਾਥਨ ਮੈ ਬਨੇ ॥੧੨੧॥",
      "transliteration": "sasatr asatr haathan mai bane ||121||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਰਹਾ ਨੇ) ਹੱਥਾ ਵਿਚ ਅਸਤ੍ਰ ਸ਼ਸਤ੍ਰ ਧਾਰਨ ਕੀਤੇ ਹੋਏ ਸਨ ॥੧੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "ससत्र असत्र हाथन मै बने ॥१२१॥",
      "sourceLineId": "139002",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਏਕ ਚਰਨ ਏਕੈ ਕੀ ਨਾਸਾ ॥",
      "transliteration": "ek charan ekai kee naasaa ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈਆਂ ਦੀ) ਇਕ ਨਾਸ, ਇਕ ਪੈਰ",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "एक चरन एकै की नासा ॥",
      "sourceLineId": "139003",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਏਕ ਏਕ ਭੁਜ ਭ੍ਰਮਤ ਅਕਾਸਾ ॥",
      "transliteration": "ek ek bhuj bhramat akaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਬਾਹ ਸੀ ਅਤੇ ਆਕਾਸ਼ ਵਿਚ ਭ੍ਰਮਣ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "एक एक भुज भ्रमत अकासा ॥",
      "sourceLineId": "139004",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਰਧ ਮੂੰਡ ਮੁੰਡਿਤ ਕੇਤੇ ਸਿਰ ॥",
      "transliteration": "aradh moo(n)dd mu(n)ddit kete sir ||",
      "translation": "",
      "punjabiViakhya": "ਕਈਆਂ ਦੇ ਅੱਧੇ ਅਤੇ ਕਈਆਂ ਦੇ ਸਾਰੇ ਸਿਰ ਮੁੰਨੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "अरध मूँड मुँडित केते सिर ॥",
      "sourceLineId": "139005",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕੇਸਨ ਧਰੇ ਕਿਤਕ ਧਾਏ ਫਿਰਿ ॥੧੨੨॥",
      "transliteration": "kesan dhare kitak dhaae fir ||122||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਨੇ ਕੇਸ ਧਰੇ ਹੋਏ ਸਨ ਅਤੇ (ਆਕਾਸ਼ ਵਿਚ) ਭਜੀ ਫਿਰਦੇ ਸਨ ॥੧੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "केसन धरे कितक धाए फिरि ॥१२२॥",
      "sourceLineId": "139006",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਏਕ ਏਕ ਮਦ ਕੋ ਸਰ ਪੀਯੈ ॥",
      "transliteration": "ek ek madh ko sar peeyai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਵਿਚੋਂ) ਇਕ ਇਕ ਸ਼ਰਾਬ ਦਾ ਸਰੋਵਰ ਪੀਣ ਵਾਲੇ",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "एक एक मद को सर पीयै ॥",
      "sourceLineId": "139007",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਾਨਵ ਖਾਇ ਜਗਤ ਕੇ ਜੀਯੈ ॥",
      "transliteration": "maanav khai jagat ke jeeyai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਗਤ ਵਿਚ ਮਨੁੱਖਾ ਨੂੰ ਖਾ ਕੇ ਜੀਉਾਂਦੇ ਰਹਿਣ ਵਾਲੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "मानव खाइ जगत के जीयै ॥",
      "sourceLineId": "139008",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦਸ ਸਹੰਸ ਭਾਗ ਕੇ ਭਰਿ ਘਟ ॥",
      "transliteration": "dhas saha(n)s bhaag ke bhar ghaT ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦੈਂਤ ਭੰਗ ਦੇ ਦਸ ਹਜ਼ਾਰ ਘੜੇ",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "दस सहंस भाग के भरि घट ॥",
      "sourceLineId": "139009",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪੀ ਪੀ ਭਿਰਤ ਅਸੁਰ ਰਨ ਚਟ ਪਟ ॥੧੨੩॥",
      "transliteration": "pee pee bhirat asur ran chaT paT ||123||",
      "translation": "",
      "punjabiViakhya": "ਪੀ ਪੀ ਕੇ ਝਟ ਪਟ ਯੁੱਧ ਵਿਚ ਆ ਭਿੜਦੇ ਸਨ ॥੧੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "पी पी भिरत असुर रन चट पट ॥१२३॥",
      "sourceLineId": "139010",
      "sourceShabadId": "12777",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "139011",
      "sourceShabadId": "12778",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਜ੍ਰ ਬਾਨ ਬਿਛੂਆ ਬਿਸਿਖ ਬਰਖੈ ਸਸਤ੍ਰ ਅਪਾਰ ॥",
      "transliteration": "bajr baan bichhooaa bisikh barakhai sasatr apaar ||",
      "translation": "",
      "punjabiViakhya": "ਬਜ੍ਰ ਬਾਣ, ਬਿਛੂਏ, ਤੀਰ ਅਤੇ (ਹੋਰ) ਅਪਾਰ ਸ਼ਸਤ੍ਰ ਵਰ੍ਰਹ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "बज्र बान बिछूआ बिसिख बरखै ससत्र अपार ॥",
      "sourceLineId": "139012",
      "sourceShabadId": "12778",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਊਚ ਨੀਚ ਕਾਤਰ ਸੁਭਟ ਸਭ ਕੀਨੇ ਇਕ ਸਾਰ ॥੧੨੪॥",
      "transliteration": "uooch neech kaatar subhaT sabh keene ik saar ||124||",
      "translation": "",
      "punjabiViakhya": "ਉੱਚੇ-ਨੀਵੇਾਂ, ਬਹਾਦਰ ਅਤੇ ਡਰਪੋਕ ਸਭ ਨੂੰ ਇਕ ਸਮਾਨ ਕਰ ਦਿੱਤਾ ਸੀ ॥੧੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "ऊच नीच कातर सुभट सभ कीने इक सार ॥१२४॥",
      "sourceLineId": "139013",
      "sourceShabadId": "12778",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "139014",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਭਯੋ ਘੋਰ ਸੰਗ੍ਰਾਮਾ ॥",
      "transliteration": "eeh bidh bhayo ghor sa(n)graamaa ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ ਦਾ ਅਮਿਤ ਸਾਮਾਨ ਲੈ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "इह बिधि भयो घोर संग्रामा ॥",
      "sourceLineId": "139015",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਲੈ ਲੈ ਅਮਿਤ ਜੁਧ ਕਾ ਸਾਮਾ ॥",
      "transliteration": "lai lai amit judh kaa saamaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਭਿਆਨਕ ਯੁੱਧ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "लै लै अमित जुध का सामा ॥",
      "sourceLineId": "139016",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕੋਪਤ ਭਯੋ ਜਬ ਹੀ ॥",
      "transliteration": "mahaa kaal kopat bhayo jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਹੀ ਮਹਾ ਕਾਲ ਕ੍ਰੋਧਿਤ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "महा काल कोपत भयो जब ही ॥",
      "sourceLineId": "139017",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1366_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਸੁਰ ਅਨੇਕ ਬਿਦਾਰੇ ਤਬ ਹੀ ॥੧੨੫॥",
      "transliteration": "asur anek bidhaare tab hee ||125||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਹੀ ਅਨੇਕ ਦੈਂਤ ਨਸ਼ਟ ਕਰ ਦਿੱਤੇ ॥੧੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1366,
      "hindi": "",
      "hindiTransliteration": "असुर अनेक बिदारे तब ही ॥१२५॥",
      "sourceLineId": "139018",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
