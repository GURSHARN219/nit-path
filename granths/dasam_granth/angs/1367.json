{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1367,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1367_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਜਬ ਹੀ ਰਿਸਿ ਭਰਾ ॥",
      "transliteration": "mahaa kaal jab hee ris bharaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਮਹਾ ਕਾਲ ਨੇ ਕ੍ਰੋਧ ਨਾਲ ਭਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "महा काल जब ही रिसि भरा ॥",
      "sourceLineId": "139019",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਘੋਰ ਭਯਾਨਕ ਆਹਵ ਕਰਾ ॥",
      "transliteration": "ghor bhayaanak aahav karaa ||",
      "translation": "",
      "punjabiViakhya": "ਘੋਰ ਭਿਆਨਕ ਯੁੱਧ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "घोर भयानक आहव करा ॥",
      "sourceLineId": "139020",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਾਰਤ ਭਯੋ ਅਸੁਰ ਬਿਕਰਾਲਾ ॥",
      "transliteration": "maarat bhayo asur bikaraalaa ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਅੰਕਰ ਦੈਂਤਾ ਨੂੰ ਮਾਰ ਮੁਕਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "मारत भयो असुर बिकराला ॥",
      "sourceLineId": "139021",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਿੰਘ ਨਾਦ ਕੀਨਾ ਤਤਕਾਲਾ ॥੧੨੬॥",
      "transliteration": "si(n)gh naadh keenaa tatakaalaa ||126||",
      "translation": "",
      "punjabiViakhya": "ਉਸੇ ਵੇਲੇ ਸਿੰਘ ਨਾਦ ਕਰ ਕੇ ॥੧੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "सिंघ नाद कीना ततकाला ॥१२६॥",
      "sourceLineId": "139022",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਹੂੰ ਮਸਾਨ ਕਿਲਕਟੀ ਮਾਰੈ ॥",
      "transliteration": "kahoo(n) masaan kilakaTee maarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭੂਤ ਪ੍ਰੇਤ ('ਮਸਾਨ') ਕਿਲਕਾਰੀਆਂ ਮਾਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "कहूँ मसान किलकटी मारै ॥",
      "sourceLineId": "139023",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭੈਰਵ ਕਹੂੰ ਠਾਢ ਭੁੰਕਾਰੈ ॥",
      "transliteration": "bhairav kahoo(n) Thaadd bhu(n)kaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭੈਰੋ (ਰੁਦ੍ਰ) ਖੜੋਤਾ ਹੋਇਆ ਭਭਕਾ ਮਾਰ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "भैरव कहूँ ठाढ भुँकारै ॥",
      "sourceLineId": "139024",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੋਗਨਿ ਦੈਤ ਅਧਿਕ ਹਰਖਾਨੇ ॥",
      "transliteration": "jogan dhait adhik harakhaane ||",
      "translation": "",
      "punjabiViakhya": "ਜੋਗਣਾ ਅਤੇ ਦੈਂਤ ਬਹੁਤ ਖ਼ੁਸ਼ ਹੋ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "जोगनि दैत अधिक हरखाने ॥",
      "sourceLineId": "139025",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੂਤ ਸਿਵਾ ਬੋਲੈ ਅਭਿਮਾਨੇ ॥੧੨੭॥",
      "transliteration": "bhoot sivaa bolai abhimaane ||127||",
      "translation": "",
      "punjabiViakhya": "ਭੂਤ ਅਤੇ ਗਿਦੜੀਆਂ ('ਸਿਵਾ') ਅਭਿਮਾਨ ਨਾਲ ਬੋਲਦੀਆਂ ਸਨ ॥੧੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "भूत सिवा बोलै अभिमाने ॥१२७॥",
      "sourceLineId": "139026",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਝਾਲਰਿ ਝਾਝਰ ਢੋਲ ਮ੍ਰਿਦੰਗਾ ॥",
      "transliteration": "jhaalar jhaajhar ddol miradha(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "(ਯੁੱਧ-ਭੂਮੀ ਵਿਚ) ਝਾਲਰ, ਝਾਝਰ, ਢੋਲ, ਮ੍ਰਿਦੰਗ,",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "झालरि झाझर ढोल मृदंगा ॥",
      "sourceLineId": "139027",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਟਹ ਨਗਾਰੇ ਮੁਰਜ ਮੁਚੰਗਾ ॥",
      "transliteration": "paTeh nagaare muraj mucha(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਪੱਟੇ, ਨਗਾਰੇ, ਮੁਰਜ, ਮੁਚੰਗ,",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "पटह नगारे मुरज मुचंगा ॥",
      "sourceLineId": "139028",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਡਵਰੂ ਗੁਡਗੁਡੀ ਕਹੂੰ ਉਪੰਗਾ ॥",
      "transliteration": "ddavaroo guddaguddee kahoo(n) upa(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਡੌਰੂ, ਗੁਡਗੁਡੀ, ਉਪੰਗ,",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "डवरू गुडगुडी कहूँ उपंगा ॥",
      "sourceLineId": "139029",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਇ ਨਫੀਰੀ ਬਜਤ ਸੁਰੰਗਾ ॥੧੨੮॥",
      "transliteration": "nai nafeeree bajat sura(n)gaa ||128||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਹਿਨਾਈ ਨਫ਼ੀਰੀ, ਸੁਰੰਗ (ਸੁਰਤਾਲ) ਆਦਿ ਵਜ ਰਹੇ ਸਨ ॥੧੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "नाइ नफीरी बजत सुरंगा ॥१२८॥",
      "sourceLineId": "139030",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮੁਰਲੀ ਕਹੂੰ ਬਾਸੁਰੀ ਬਾਜਤ ॥",
      "transliteration": "muralee kahoo(n) baasuree baajat ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਮੁਰਲੀ ਅਤੇ ਕਿਤੇ ਬੰਸਰੀ ਵਜ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "मुरली कहूँ बासुरी बाजत ॥",
      "sourceLineId": "139031",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਹੂੰ ਉਪੰਗ ਮ੍ਰਿਦੰਗ ਬਰਾਜਤ ॥",
      "transliteration": "kahoo(n) upa(n)g miradha(n)g baraajat ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਉਪੰਗ ਅਤੇ ਮ੍ਰਿਦੰਗ ਸ਼ੋਭ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "कहूँ उपंग मृदंग बराजत ॥",
      "sourceLineId": "139032",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੁੰਦਭਿ ਢੋਲ ਕਹੂੰ ਸਹਨਾਈ ॥",
      "transliteration": "dhu(n)dhabh ddol kahoo(n) sahanaiee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਦੁੰਦਭੀ, ਢੋਲ ਅਤੇ ਸ਼ਹਿਨਾਈਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "दुँदभि ढोल कहूँ सहनाई ॥",
      "sourceLineId": "139033",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਾਜਤ ਭੇ ਲਖਿ ਪਰੀ ਲਰਾਈ ॥੧੨੯॥",
      "transliteration": "baajat bhe lakh paree laraiee ||129||",
      "translation": "",
      "punjabiViakhya": "ਲੜਾਈ ਨੂੰ ਛਿੜਿਆ ਵੇਖ ਕੇ ਵਜਣ ਲਗ ਗਈਆਂ ਸਨ ॥੧੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "बाजत भे लखि परी लराई ॥१२९॥",
      "sourceLineId": "139034",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੁਰਜ ਮੁਚੰਗ ਬਜੈ ਤੁਰਹੀ ਰਨ ॥",
      "transliteration": "muraj mucha(n)g bajai turahee ran ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਰਜ, ਮੁਚੰਗ ਅਤੇ ਤੁਰਹੀ ਰਣ ਵਿਚ ਵਜ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "मुरज मुचंग बजै तुरही रन ॥",
      "sourceLineId": "139035",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭੇਰਨ ਕੇ ਭਭਕਾਰ ਕਰਤ ਗਨ ॥",
      "transliteration": "bheran ke bhabhakaar karat gan ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭੇਰੀਆਂ ਦੇ ਸਮੂਹ ਭਭਕਾਰ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "भेरन के भभकार करत गन ॥",
      "sourceLineId": "139036",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਾਥੀ ਘੋਰਨ ਕੇ ਦੁੰਦਭਿ ਰਨ ॥",
      "transliteration": "haathee ghoran ke dhu(n)dhabh ran ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਥੀਆਂ ਅਤੇ ਘੋੜਿਆਂ (ਉਤੇ ਲਦੇ ਹੋਏ) ਨਗਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "हाथी घोरन के दुँदभि रन ॥",
      "sourceLineId": "139037",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਉਸਟਨ ਕੇ ਬਾਜੇ ਰਨ ਮੂਰਧਨ ॥੧੩੦॥",
      "transliteration": "ausaTan ke baaje ran mooradhan ||130||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਊਠਾ ਉਤੇ ਬੰਨ੍ਰਹੇ ਹੋਏ ਵਾਜੇ ਰਣ ਵਿਚ ਅਗੇ ਹੋ ਕੇ ਵਜ ਰਹੇ ਸਨ ॥੧੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "उसटन के बाजे रन मूरधन ॥१३०॥",
      "sourceLineId": "139038",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕੇਤਿਕ ਸੁਭਟ ਸਰਨ ਕੇ ਮਾਰੇ ॥",
      "transliteration": "ketik subhaT saran ke maare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਸੂਰਮੇ ਮਾਰੇ ਹੋਏ ਸ਼ਰਨ ਵਿਚ ਆ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "केतिक सुभट सरन के मारे ॥",
      "sourceLineId": "139039",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗਿਰਤ ਭਏ ਰਨ ਡੀਲ ਡਿਲਾਰੇ ॥",
      "transliteration": "girat bhe ran ddeel ddilaare ||",
      "translation": "",
      "punjabiViakhya": "(ਕਈ) ਵਡਿਆਂ ਆਕਾਰਾ ਪ੍ਰਕਾਰਾ ਵਾਲੇ ਰਣ ਵਿਚ ਡਿਗੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "गिरत भए रन डील डिलारे ॥",
      "sourceLineId": "139040",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਦਪਿ ਪ੍ਰਾਨ ਸਮੁਹ ਹ੍ਵੈ ਦਏ ॥",
      "transliteration": "jadhap praan samuh havai dhe ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਵੇਾਂ ਉਹ ਸਾਹਮਣੇ ਹੋ ਕੇ ਪ੍ਰਾਣ ਦਿੰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "जदपि प्रान समुह ह्वै दए ॥",
      "sourceLineId": "139041",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਰ ਤੇ ਤਜਤ ਕ੍ਰਿਪਾਨਨ ਭਏ ॥੧੩੧॥",
      "transliteration": "kar te tajat kirapaanan bhe ||131||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਹੱਥਾ ਵਿਚੋਂ ਕ੍ਰਿਪਾਨਾ ਛਡ ਰਹੇ ਸਨ ॥੧੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "कर ते तजत कृपानन भए ॥१३१॥",
      "sourceLineId": "139042",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚਲਤ ਭਈ ਸਰਿਤਾ ਸ੍ਰੋਨਤ ਤਹ ॥",
      "transliteration": "chalat bhiee saritaa sronat teh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕਾਲੀ ਅਤੇ ਦੈਂਤਾ ਦਾ ਯੁੱਧ ਹੋ ਰਿਹਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "चलत भई सरिता स्रोनत तह ॥",
      "sourceLineId": "139043",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੁਧ ਭਯੋ ਕਾਲੀ ਅਸੁਰਨ ਜਹ ॥",
      "transliteration": "judh bhayo kaalee asuran jeh ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਲਹੂ ਦੀ ਨਦੀ ਵਗ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "जुध भयो काली असुरन जह ॥",
      "sourceLineId": "139044",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੀਸ ਕੇਸ ਜਹ ਭਏ ਸਿਵਾਰਾ ॥",
      "transliteration": "sees kes jeh bhe sivaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਸਿਰ ਦੇ ਕੇਸ ਕਾਈ ਵਰਗੇ ਲਗ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "सीस केस जह भए सिवारा ॥",
      "sourceLineId": "139045",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸ੍ਰੋਨ ਪ੍ਰਵਾਹ ਬਹਤ ਹਹਰਾਰਾ ॥੧੩੨॥",
      "transliteration": "sron pravaeh bahat haharaaraa ||132||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਹੂ ਦਾ ਭਿਆਨਕ ਪ੍ਰਵਾਹ ਵਗ ਰਿਹਾ ਸੀ ॥੧੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "स्रोन प्रवाह बहत हहरारा ॥१३२॥",
      "sourceLineId": "139046",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਾਜ ਬ੍ਰਿਛ ਜਹ ਬਹੇ ਅਨੇਕੈ ॥",
      "transliteration": "baaj birachh jeh bahe anekai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵਿਚ ਅਨੇਕ ਘੋੜੇ ਬ੍ਰਿਛਾ ਵਾਗ ਰੁੜ੍ਰਹ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "बाज बृछ जह बहे अनेकै ॥",
      "sourceLineId": "139047",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿਨ ਬ੍ਰਿਣ ਬੀਰ ਰਹਾ ਨਹਿ ਏਕੈ ॥",
      "transliteration": "bin biran beer rahaa neh ekai ||",
      "translation": "",
      "punjabiViakhya": "ਕੋਈ ਵੀ ਸੂਰਮਾ ਘਾਇਲ ਹੋਏ ਬਿਨਾ ਨਹੀਂ ਬਚਿਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "बिन बृण बीर रहा नहि एकै ॥",
      "sourceLineId": "139048",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸ੍ਰੋਨ ਭਰੇ ਪਟ ਅਧਿਕ ਸੁਹਾਏ ॥",
      "transliteration": "sron bhare paT adhik suhaae ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਨਾਲ ਭਿਜੇ ਹੋਏ ਬਸਤ੍ਰ ਬਹੁਤ ਸ਼ੋਭ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "स्रोन भरे पट अधिक सुहाए ॥",
      "sourceLineId": "139049",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਾਚਰਿ ਖੇਲਿ ਮਨੌ ਘਰ ਆਏ ॥੧੩੩॥",
      "transliteration": "chaachar khel manau ghar aae ||133||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਹੋਲੀ ਖੇਡ ਕੇ ਘਰ ਪਰਤੇ ਹੋਣ ॥੧੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "चाचरि खेलि मनौ घर आए ॥१३३॥",
      "sourceLineId": "139050",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੂਰਨ ਕੇ ਜਹ ਮੂੰਡ ਪਖਾਨਾ ॥",
      "transliteration": "sooran ke jeh moo(n)dd pakhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਸੂਰਮਿਆਂ ਦੇ ਅਨੇਕਾ ਸਿਰ",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "सूरन के जह मूँड पखाना ॥",
      "sourceLineId": "139051",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੋਭਿਤ ਰੰਗ ਭੂਮ ਮਹਿ ਨਾਨਾ ॥",
      "transliteration": "sobhit ra(n)g bhoom meh naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਪੱਥਰਾ ਵਰਗੇ ਸ਼ੋਭਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "सोभित रंग भूम महि नाना ॥",
      "sourceLineId": "139052",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਹੇ ਜਾਤ ਜਹ ਬ੍ਰਿਛ ਤੁਰੰਗਾ ॥",
      "transliteration": "bahe jaat jeh birachh tura(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬ੍ਰਿਛ ਅਤੇ ਘੋੜੇ ਰੁੜ੍ਰਹਦੇ ਜਾ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "बहे जात जह बृछ तुरंगा ॥",
      "sourceLineId": "139053",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਡੇ ਸੈਲ ਸੇ ਲਸਤ ਮਤੰਗਾ ॥੧੩੪॥",
      "transliteration": "badde sail se lasat mata(n)gaa ||134||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਾਥੀ ਵਡਿਆਂ ਪਰਬਤਾ ਵਰਗੇ ਸ਼ੁਭਾਇਮਾਨ ਸਨ ॥੧੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "बडे सैल से लसत मतंगा ॥१३४॥",
      "sourceLineId": "139054",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਛਰੀ ਤਨਕਿ ਅੰਗੁਰਿਯੈ ਸੋਹੈ ॥",
      "transliteration": "machharee tanak a(n)guriyai sohai ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀਆਂ ਉਾਂਗਲਾ ਮਛਲੀਆਂ ਵਰਗੀਆਂ ਲਗਦੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "मछरी तनकि अंगुरियै सोहै ॥",
      "sourceLineId": "139055",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭੁਜਾ ਭੁਜੰਗਨ ਸੀ ਮਨ ਮੋਹੈ ॥",
      "transliteration": "bhujaa bhuja(n)gan see man mohai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਾਹਵਾ ਸੱਪਾ ਜਿਹੀਆਂ ਮਨ ਨੂੰ ਮੋਹ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "भुजा भुजंगन सी मन मोहै ॥",
      "sourceLineId": "139056",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਹੂੰ ਗ੍ਰਾਹ ਸੇ ਖੜਗ ਝਮਕਹਿ ॥",
      "transliteration": "kahoo(n) graeh se khaRag jhamakeh ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਖੜਗ ਮਗਰ ਮੱਛਾ ਵਰਗੇ ਚਮਕਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "कहूँ ग्राह से खड़ग झमकहि ॥",
      "sourceLineId": "139057",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਕ ਭਕ ਕਰ ਕਹੂੰ ਘਾਇ ਭਭਕਹਿ ॥੧੩੫॥",
      "transliteration": "bhak bhak kar kahoo(n) ghai bhabhakeh ||135||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਜ਼ਖ਼ਮਾ ਵਿਚ ਭਕ ਭਕ ਕਰਦਾ (ਲਹੂ) ਵਗ ਰਿਹਾ ਸੀ ॥੧੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "भक भक कर कहूँ घाइ भभकहि ॥१३५॥",
      "sourceLineId": "139058",
      "sourceShabadId": "12779",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੁਜੰਗ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "भुजंग छंद ॥",
      "sourceLineId": "139059",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਹਾ ਬੀਰ ਬੈਰੀ ਬਡੇ ਘੇਰਿ ਮਾਰੇ ॥",
      "transliteration": "jahaa beer bairee badde gher maare ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਵੱਡੇ ਵੱਡੇ ਵੈਰੀ ਯੋਧੇ ਘੇਰ ਕੇ ਮਾਰੇ ਗਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "जहा बीर बैरी बडे घेरि मारे ॥",
      "sourceLineId": "139060",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਹਾ ਭੂਤ ਔ ਪ੍ਰੇਤ ਨਾਚੇ ਮਤਵਾਰੇ ॥",
      "transliteration": "tahaa bhoot aau pret naache matavaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਭੂਤ ਅਤੇ ਪ੍ਰੇਤ ਮਤਵਾਲੇ ਹੋ ਕੇ ਨਚ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "तहा भूत औ प्रेत नाचे मतवारे ॥",
      "sourceLineId": "139061",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਹੂੰ ਡਾਕਨੀ ਝਾਕਨੀ ਹਾਕ ਮਾਰੈ ॥",
      "transliteration": "kahoo(n) ddaakanee jhaakanee haak maarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਡਾਕਣੀਆਂ, ਗਿੱਧਾ ('ਝਾਕਨੀ') ਚੀਖਾ ਮਾਰ ਰਹੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "कहूँ डाकनी झाकनी हाक मारै ॥",
      "sourceLineId": "139062",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਉਠੈ ਨਾਦ ਭਾਰੇ ਛੁਟੇ ਚੀਤਕਾਰੈ ॥੧੩੬॥",
      "transliteration": "auThai naadh bhaare chhuTe cheetakaarai ||136||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਉੱਚੀ ਸੁਰ ਵਿਚ ਭਾਰੇ ਨਾਦ ਹੋ ਰਹੇ ਸਨ ਅਤੇ (ਕਿਤੇ) ਚੀਕ-ਚਹਾੜਾ ਮਚ ਰਿਹਾ ਸੀ ॥੧੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "उठै नाद भारे छुटे चीतकारै ॥१३६॥",
      "sourceLineId": "139063",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਹੂੰ ਅੰਗੁਲੈ ਤ੍ਰਾਣ ਕਾਟਾ ਬਿਰਾਜੈ ॥",
      "transliteration": "kahoo(n) a(n)gulai traan kaaTaa biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਲੋਹੇ ਦੇ ਦਸਤਾਨੇ ਕਟੇ ਪਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "कहूँ अंगुलै त्राण काटा बिराजै ॥",
      "sourceLineId": "139064",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਹੂੰ ਅੰਗੁਲਾ ਕਾਟਿ ਕੇ ਰਤਨ ਰਾਜੈ ॥",
      "transliteration": "kahoo(n) a(n)gulaa kaaT ke ratan raajai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਟੀਆਂ ਹੋਈਆਂ ਉਾਂਗਲਾ ਦੇ ਰਤਨ ਸ਼ੋਭ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "कहूँ अंगुला काटि के रतन राजै ॥",
      "sourceLineId": "139065",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1367_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਹੂੰ ਟੀਕ ਟਾਕੇ ਕਟੈ ਟੋਪ ਸੋਹੈ ॥",
      "transliteration": "kahoo(n) Teek Taake kaTai Top sohai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕਟੇ ਹੋਏ ਟੋਪਾ ਨਾਲ (ਮੱਥੇ ਉਤੇ ਲਗਾਉਣ ਵਾਲੇ ਲੋਹੇ ਦੇ) ਟਿੱਕੇ ਟੰਗੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1367,
      "hindi": "",
      "hindiTransliteration": "कहूँ टीक टाके कटै टोप सोहै ॥",
      "sourceLineId": "139066",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
