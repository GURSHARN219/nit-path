{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1368,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1368_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਮਾਰੇ ਗਿਰੇ ਭੂਮਿ ਮੋਹੈ ॥੧੩੭॥",
      "transliteration": "kahoo(n) beer maare gire bhoom mohai ||137||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਮਾਰੇ ਹੋਏ ਸੂਰਮੇ ਧਰਤੀ ਉਤੇ ਡਿਗੇ ਹੋਏ ਮੋਹ ਰਹੇ ਸਨ ॥੧੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर मारे गिरे भूमि मोहै ॥१३७॥",
      "sourceLineId": "139067",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਤੇ ਸ੍ਰੋਨ ਕੇ ਬੂੰਦ ਭੂ ਪੈ ਪਰੇ ਹੈ ॥",
      "transliteration": "jite sron ke boo(n)dh bhoo pai pare hai ||",
      "translation": "",
      "punjabiViakhya": "ਲਹੂ ਦੀਆਂ ਜਿਤਨੀਆਂ ਵੀ ਬੂੰਦਾ ਧਰਤੀ ਉਤੇ ਪਈਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "जिते स्रोन के बूँद भू पै परे है ॥",
      "sourceLineId": "139068",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਿਤੇ ਦਾਨਵੋ ਰੂਪ ਬਾਕੇ ਧਰੇ ਹੈ ॥",
      "transliteration": "tite dhaanavo roop baake dhare hai ||",
      "translation": "",
      "punjabiViakhya": "ਉਤਨੇ ਹੀ ਦੈਂਤਾ ਨੇ ਬਾਕੇ ਰੂਪ ਧਾਰ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "तिते दानवो रूप बाके धरे है ॥",
      "sourceLineId": "139069",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਠੀ ਓਰ ਚਾਰੌ ਬਿਖੈ ਆਨਿ ਢੂਕੇ ॥",
      "transliteration": "haThee or chaarau bikhai aan ddooke ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਹਠੀ ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਆ ਢੁਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "हठी ओर चारौ बिखै आनि ढूके ॥",
      "sourceLineId": "139070",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਹਾ ਕੋਪ ਕੈ ਮਾਰ ਹੀ ਮਾਰਿ ਕੂਕੈ ॥੧੩੮॥",
      "transliteration": "mahaa kop kai maar hee maar kookai ||138||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ 'ਮਾਰੋ ਮਾਰੋ' ਪੁਕਾਰਨ ਲਗੇ ॥੧੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "महा कोप कै मार ही मारि कूकै ॥१३८॥",
      "sourceLineId": "139071",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਿਤੇ ਦੈਤ ਆਏ ਤਿਤੇ ਕਾਲ ਮਾਰੇ ॥",
      "transliteration": "jite dhait aae tite kaal maare ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਦੈਂਤ ਆਏ, ਉਨ੍ਰਹਾ ਨੂੰ ਕਾਲ ਨੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "जिते दैत आए तिते काल मारे ॥",
      "sourceLineId": "139072",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਹੇ ਸ੍ਰੋਨ ਕੇ ਭੂਮ ਹੂੰ ਪੈ ਪਨਾਰੇ ॥",
      "transliteration": "bahe sron ke bhoom hoo(n) pai panaare ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੇ ਲਹੂ ਦੇ ਪਰਨਾਲੇ ਵਗਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "बहे स्रोन के भूम हूँ पै पनारे ॥",
      "sourceLineId": "139073",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਉਠ ਦੈਤ ਬਾਕੇ ਬਲੀ ਸਸਤ੍ਰ ਲੈ ਕੈ ॥",
      "transliteration": "auTh dhait baake balee sasatr lai kai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਲਹੂ ਤੋਂ) ਬਾਕੇ ਬਲਵਾਨ ਦੈਂਤ ਸ਼ਸਤ੍ਰ ਲੈ ਕੇ ਉਠ ਖੜੋਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "उठ दैत बाके बली ससत्र लै कै ॥",
      "sourceLineId": "139074",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੁਹੂੰ ਓਰ ਤੇ ਮਾਰ ਹੀ ਮਾਰਿ ਕੈ ਕੈ ॥੧੩੯॥",
      "transliteration": "dhuhoo(n) or te maar hee maar kai kai ||139||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਤੋਂ 'ਮਾਰੋ ਮਾਰੋ' ਦੀਆਂ ਆਵਾਜ਼ਾ ਆਣ ਲਗੀਆਂ ॥੧੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "दुहूँ ओर ते मार ही मारि कै कै ॥१३९॥",
      "sourceLineId": "139075",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਠੀ ਬਧਿ ਗੋਪਾ ਗੁਲਿਤ੍ਰਾਨ ਬਾਕੇ ॥",
      "transliteration": "haThee badh gopaa gulitraan baake ||",
      "translation": "",
      "punjabiViakhya": "ਹਠੀ ਬਾਕੇ ਸੂਰਮਿਆਂ ਨੇ ਗੋਪੇ ਅਤੇ ਲੋਹੇ ਦੇ ਦਸਤਾਨੇ ('ਗੁਲਿਤ੍ਰਾਨ') ਪਾਏ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "हठी बधि गोपा गुलित्रान बाके ॥",
      "sourceLineId": "139076",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਠੀਲੇ ਕਟੀਲੇ ਰਜੀਲੇ ਨਿਸਾਕੇ ॥",
      "transliteration": "haTheele kaTeele rajeele nisaake ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਬੜੇ ਹਠੀਲੇ, ਕਟੀਲੇ (ਕਟਣ ਵਲੇ) ਕਠੋਰ ('ਰਜੀਲੇ') ਅਤੇ ਨਿਡਰ ('ਨਿਸਾਕੇ') ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "हठीले कटीले रजीले निसाके ॥",
      "sourceLineId": "139077",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਦਾ ਹਾਥ ਲੈ ਕੇ ਕਿਤੇ ਬੀਰ ਗਾਜੇ ॥",
      "transliteration": "gadhaa haath lai ke kite beer gaaje ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਸ਼ੂਰਵੀਰ ਹੱਥ ਵਿਚ ਗਦਾਵਾ ਲੈ ਕੇ ਗਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "गदा हाथ लै के किते बीर गाजे ॥",
      "sourceLineId": "139078",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲਰੇ ਆਨਿ ਕੈ ਪੈਗ ਦ੍ਵੈ ਕੈ ਨ ਭਾਜੇ ॥੧੪੦॥",
      "transliteration": "lare aan kai paig dhavai kai na bhaaje ||140||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਆ ਕੇ ਯੁੱਧ ਵਿਚ ਲੜਦੇ ਸਨ ਅਤੇ ਦੋ ਪੈਰ ਵੀ ਪਿਛੇ ਹਟਾ ਕੇ ਭਜਦੇ ਨਹੀਂ ਸਨ ॥੧੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "लरे आनि कै पैग द्वै कै न भाजे ॥१४०॥",
      "sourceLineId": "139079",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਮਾਰੇ ਬਿਦਾਰੇ ਪਰੇ ਹੈ ॥",
      "transliteration": "kahoo(n) beer maare bidhaare pare hai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਮੇ ਮਾਰੇ ਅਤੇ ਚੀਰੇ ਪਾੜੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर मारे बिदारे परे है ॥",
      "sourceLineId": "139080",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਹੂੰ ਖੇਤ ਮੈ ਖਿੰਗ ਖਤ੍ਰੀ ਜਰੇ ਹੈ ॥",
      "transliteration": "kahoo(n) khet mai khi(n)g khatree jare hai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਯੁੱਧ-ਖੇਤਰ ਵਿਚ ਘੋੜੇ ਅਤੇ ਛਤ੍ਰੀ ਝੜੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "कहूँ खेत मै खिंग खत्री जरे है ॥",
      "sourceLineId": "139081",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਹੂੰ ਮਤ ਦੰਤੀ ਕਹੂੰ ਉਸਟ ਮਾਰੇ ॥",
      "transliteration": "kahoo(n) mat dha(n)tee kahoo(n) usaT maare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਮਸਤ ਹਾਥੀ ਅਤੇ ਕਿਤੇ ਊਠ ਮਾਰੇ ਹੋਏ ਪਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "कहूँ मत दंती कहूँ उसट मारे ॥",
      "sourceLineId": "139082",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਰਾਜੈ ਕਹੂੰ ਨਗਨ ਖੰਡੇ ਕਟਾਰੇ ॥੧੪੧॥",
      "transliteration": "biraajai kahoo(n) nagan kha(n)dde kaTaare ||141||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਨੰਗੇ ਖੰਡੇ ਅਤੇ ਕਟਾਰਾ ਪਈਆਂ ਸਨ ॥੧੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "बिराजै कहूँ नगन खंडे कटारे ॥१४१॥",
      "sourceLineId": "139083",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹੂੰ ਖੋਲ ਖਾਡੇ ਗਿਰੇ ਭੂਮਿ ਸੋਹੈ ॥",
      "transliteration": "kahoo(n) khol khaadde gire bhoom sohai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਤਲਵਾਰਾ ਦੇ ਮਿਆਨ ਭੂਮੀ ਉਤੇ ਡਿਗੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "कहूँ खोल खाडे गिरे भूमि सोहै ॥",
      "sourceLineId": "139084",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਬਾਨੀ ਪਰੇ ਭੂਮਿ ਮੋਹੈ ॥",
      "transliteration": "kahoo(n) beer baanee pare bhoom mohai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਪ੍ਰਮੁਖ ('ਬਾਨੀ') ਸੂਰਮੇ ਭੂਮੀ ਉਤੇ ਪਏ ਹੋਏ ਮੋਹ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर बानी परे भूमि मोहै ॥",
      "sourceLineId": "139085",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਹੂੰ ਸ੍ਵਾਰ ਮਾਰੇ ਫਿਰੈ ਬਾਜ ਛੂਟੈ ॥",
      "transliteration": "kahoo(n) savaiaar maare firai baaj chhooTai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸਵਾਰਾ ਦੇ ਮਾਰੇ ਜਾਣ ਕਰ ਕੇ ਘੋੜੇ ਖੁਲ੍ਰਹੇ ਫਿਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "कहूँ स्वार मारे फिरै बाज छूटै ॥",
      "sourceLineId": "139086",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿਤੇ ਛੈਲ ਛੋਰੇ ਕਿਤੇ ਦੁਸਟ ਲੂਟੈ ॥੧੪੨॥",
      "transliteration": "kite chhail chhore kite dhusaT looTai ||142||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਛੈਲ ਛਬੀਲੇ ਅਤੇ ਕਿਤੇ ਦੁਸ਼ਟ (ਵੈਰੀ) ਲੁਟੇ ਪੁਟੇ ਪਏ ਸਨ ॥੧੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "किते छैल छोरे किते दुसट लूटै ॥१४२॥",
      "sourceLineId": "139087",
      "sourceShabadId": "12780",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "139088",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਤਹਾ ਭਯੋ ਸੰਗ੍ਰਾਮਾ ॥",
      "transliteration": "eeh bidh tahaa bhayo sa(n)graamaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਉਥੇ ਘਮਸਾਨ ਯੁੱਧ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "इह बिधि तहा भयो संग्रामा ॥",
      "sourceLineId": "139089",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਿਰਖਤ ਦੇਵ ਦਾਨਵੀ ਬਾਮਾ ॥",
      "transliteration": "nirakhat dhev dhaanavee baamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਦੀਆਂ ਇਸਤਰੀਆਂ ਵੇਖ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "निरखत देव दानवी बामा ॥",
      "sourceLineId": "139090",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕੇਤਿਕ ਕਰੀ ਕਰਨ ਬਿਨੁ ਭਏ ॥",
      "transliteration": "ketik karee karan bin bhe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਹਾਥੀ ਬਿਨਾ ਕੰਨਾ ਦੇ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "केतिक करी करन बिनु भए ॥",
      "sourceLineId": "139091",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪ੍ਰਾਪਤ ਦੁਸਟ ਨਿਧਨ ਕਹ ਗਏ ॥੧੪੩॥",
      "transliteration": "praapat dhusaT nidhan keh ge ||143||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੁਸ਼ਟ ਲੋਗ ਮ੍ਰਿਤੂ ਨੂੰ ਪ੍ਰਾਪਤ ਹੋ ਗਏ ॥੧੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "प्रापत दुसट निधन कह गए ॥१४३॥",
      "sourceLineId": "139092",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਾਰਹਿ ਮਾਰਿ ਮਹਾ ਸੂਰ ਕੂਕਹਿ ॥",
      "transliteration": "maareh maar mahaa soor kookeh ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾਨ ਸੂਰਮੇ 'ਮਾਰੋ' 'ਮਾਰੋ' ਕੂਕ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "मारहि मारि महा सूर कूकहि ॥",
      "sourceLineId": "139093",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਾਢਿ ਕਾਢਿ ਦਾਤਨ ਕਹ ਢੂਕਹਿ ॥",
      "transliteration": "kaadd kaadd dhaatan keh ddookeh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੰਦ ਕਢ ਕਢ ਕੇ ਢੁਕ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "काढि काढि दातन कह ढूकहि ॥",
      "sourceLineId": "139094",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਾਜਹਿ ਢੋਲ ਮ੍ਰਿਦੰਗ ਨਗਾਰੇ ॥",
      "transliteration": "baajeh ddol miradha(n)g nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ, ਮ੍ਰਿਦੰਗ, ਜੰਗ,",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "बाजहि ढोल मृदंग नगारे ॥",
      "sourceLineId": "139095",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੰਗ ਮਚੰਗ ਉਪੰਗ ਜੁਝਾਰੇ ॥੧੪੪॥",
      "transliteration": "ja(n)g macha(n)g upa(n)g jujhaare ||144||",
      "translation": "",
      "punjabiViakhya": "ਮਚੰਗ, ਉਪੰਗ ਅਤੇ ਜੰਗੀ ਨਗਾਰੇ ਵਜ ਰਹੇ ਸਨ ॥੧੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "जंग मचंग उपंग जुझारे ॥१४४॥",
      "sourceLineId": "139096",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਹ ਤਨ ਕਾਲ ਬਿਸਿਖ ਕੀ ਮਾਰੈ ॥",
      "transliteration": "jeh tan kaal bisikh kee maarai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਕਾਲ ਬਾਣ ਮਾਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "जिह तन काल बिसिख की मारै ॥",
      "sourceLineId": "139097",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਕਹ ਤਹੀ ਚੂਰ ਕਰਿ ਡਾਰੈ ॥",
      "transliteration": "taa keh tahee choor kar ddaarai ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਉਥੇ ਹੀ ਚੂਰ ਚੂਰ ਕਰ ਦਿੰਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "ता कह तही चूर करि डारै ॥",
      "sourceLineId": "139098",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਾ ਕਰ ਕੋਪਿ ਕ੍ਰਿਪਾਨ ਪ੍ਰਹਾਰਤ ॥",
      "transliteration": "jaa kar kop kirapaan prahaarat ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਉਤੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਤਲਵਾਰ ਦਾ ਵਾਰ ਕਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "जा कर कोपि कृपान प्रहारत ॥",
      "sourceLineId": "139099",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਿਹ ਕਾ ਮੂੰਡ ਕਾਟਿ ਹੀ ਡਾਰਤ ॥੧੪੫॥",
      "transliteration": "teh kaa moo(n)dd kaaT hee ddaarat ||145||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਸਿਰ ਹੀ ਕਟ ਸੁਟਦਾ ਸੀ ॥੧੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "तिह का मूँड काटि ही डारत ॥१४५॥",
      "sourceLineId": "139100",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਭਯੋ ਭਯਾਨਕ ਜੁਧਾ ॥",
      "transliteration": "eeh bidh bhayo bhayaanak judhaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਭਿਆਨਕ ਯੁੱਧ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "इह बिधि भयो भयानक जुधा ॥",
      "sourceLineId": "139101",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਉਪਜਾ ਕਛੁਕ ਕਾਲ ਕੇ ਕ੍ਰਧਾ ॥",
      "transliteration": "aupajaa kachhuk kaal ke kradhaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਨੂੰ ਵੀ ਕੁਝ ਕੁ ਕ੍ਰੋਧ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "उपजा कछुक काल के क्रधा ॥",
      "sourceLineId": "139102",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕੇਸਨ ਤੇ ਗਹਿ ਅਸੁਰ ਪਛਾਰੇ ॥",
      "transliteration": "kesan te geh asur pachhaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਦੈਂਤਾ ਨੂੰ ਵਾਲਾ ਤੋਂ ਪਕੜ ਕੇ ਪਛਾੜ ਸੁਟਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "केसन ते गहि असुर पछारे ॥",
      "sourceLineId": "139103",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਾਢਿ ਕ੍ਰਿਪਾਨ ਏਕ ਹਨਿ ਡਾਰੇ ॥੧੪੬॥",
      "transliteration": "kaadd kirapaan ek han ddaare ||146||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈਆਂ ਨੂੰ ਕ੍ਰਿਪਾਨ ਕਢ ਕੇ ਮਾਰ ਸੁਟਿਆ ॥੧੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "काढि कृपान एक हनि डारे ॥१४६॥",
      "sourceLineId": "139104",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਾਰੇ ਅਧਿਕ ਤਾਹਿ ਦਾਨਵ ਰਨ ॥",
      "transliteration": "maare adhik taeh dhaanav ran ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਬਹੁਤ ਜ਼ਿਆਦਾ ਦੈਂਤ ਮਾਰੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "मारे अधिक ताहि दानव रन ॥",
      "sourceLineId": "139105",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਟੂਕ ਟੂਕ ਹ੍ਵੈਗੇ ਤਿਨ ਕੇ ਤਨ ॥",
      "transliteration": "Took Took havaige tin ke tan ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਤਨ ਟੁਕੜੇ ਟੁਕੜੇ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "टूक टूक ह्वैगे तिन के तन ॥",
      "sourceLineId": "139106",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਊ ਮਾਰ ਹੀ ਮਾਰਿ ਪੁਕਾਰਤ ॥",
      "transliteration": "tuoo maar hee maar pukaarat ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਵੀ ਉਹ 'ਮਾਰੋ ਮਾਰੋ' ਪੁਕਾਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "तऊ मार ही मारि पुकारत ॥",
      "sourceLineId": "139107",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਾਛੇ ਪਾਵ ਏਕ ਨਹਿ ਡਾਰਤ ॥੧੪੭॥",
      "transliteration": "paachhe paav ek neh ddaarat ||147||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਪੈਰ ਵੀ ਪਿਛੇ ਨਹੀਂ ਕਰਦੇ ਸਨ ॥੧੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "पाछे पाव एक नहि डारत ॥१४७॥",
      "sourceLineId": "139108",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੇਤਿਕ ਘੂਮਿ ਗਿਰਤ ਹੈ ਘਾਇਲ ॥",
      "transliteration": "ketik ghoom girat hai ghail ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਘਾਇਲ ਘੁਮੇਰੀ ਖਾ ਕੇ ਡਿਗ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "केतिक घूमि गिरत है घाइल ॥",
      "sourceLineId": "139109",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਰਤ ਭਏ ਭੂ ਤਰ ਹ੍ਵੈ ਹਾਇਲ ॥",
      "transliteration": "parat bhe bhoo tar havai hail ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਡਰਾਉਣੀਆਂ ਸ਼ਕਲਾ ਵਾਲੇ ('ਹਾਇਲ') ਬਣ ਕੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "परत भए भू तर ह्वै हाइल ॥",
      "sourceLineId": "139110",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਊ ਜੁਧ ਕੋ ਤ੍ਯਾਗਿ ਨ ਭਜਹੀ ॥",
      "transliteration": "tuoo judh ko tayaag na bhajahee ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ ਵੀ) ਉਹ ਯੁੱਧ ਨੂੰ ਤਿਆਗ ਕੇ ਤਦ ਤਕ ਨਾ ਭਜਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "तऊ जुध को त्यागि न भजही ॥",
      "sourceLineId": "139111",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਬ ਲਗਿ ਦੁਸਟ ਪ੍ਰਾਨ ਨਹਿ ਤਜਹੀ ॥੧੪੮॥",
      "transliteration": "jab lag dhusaT praan neh tajahee ||148||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਤਕ ਦੁਸ਼ਟ ਪ੍ਰਾਣ ਨਹੀਂ ਛਡਦੇ ਸਨ ॥੧੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "जब लगि दुसट प्रान नहि तजही ॥१४८॥",
      "sourceLineId": "139112",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਰਜ ਗੋਫਨੈ ਕਿਤਕ ਸੰਭਾਰੈ ॥",
      "transliteration": "guraj gofanai kitak sa(n)bhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਨੇ ਗੁਰਜ ਅਤੇ ਗੋਫਨੇ ਸੰਭਾਲੇ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "गुरज गोफनै कितक संभारै ॥",
      "sourceLineId": "139113",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੇਤਿਕ ਕਸਿ ਕਸਿ ਬਾਨ ਪ੍ਰਹਾਰੈ ॥",
      "transliteration": "ketik kas kas baan prahaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਕਸ ਕਸ ਕੇ ਬਾਣ ਚਲਾ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "केतिक कसि कसि बान प्रहारै ॥",
      "sourceLineId": "139114",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਿਤੇ ਤਮਕਿ ਰਨ ਤੁਰੀ ਨਚਾਵੈ ॥",
      "transliteration": "kite tamak ran turee nachaavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਆਕੜ ਕੇ ਰਣ ਵਿਚ ਘੋੜੇ ਨਚਾ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "किते तमकि रन तुरी नचावै ॥",
      "sourceLineId": "139115",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਚਟਪਟ ਸੁਭਟ ਜੂਝਿ ਰਨ ਜਾਵੈ ॥੧੪੯॥",
      "transliteration": "chaTapaT subhaT joojh ran jaavai ||149||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਸੂਰਮੇ ਝਟ ਪਟ ਰਣ-ਭੂਮੀ ਵਿਚ ਜੂਝ ਰਹੇ ਸਨ ॥੧੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "चटपट सुभट जूझि रन जावै ॥१४९॥",
      "sourceLineId": "139116",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਿਤਕ ਤਮਕਿ ਰਨ ਤੁਰੀ ਨਚਾਵਤ ॥",
      "transliteration": "kitak tamak ran turee nachaavat ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਐਂਠ ਕੇ ਰਣ-ਖੇਤਰ ਵਿਚ ਘੋੜੇ ਨਚਾ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "कितक तमकि रन तुरी नचावत ॥",
      "sourceLineId": "139117",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਧੁਨਿ ਕਿਤਕ ਉਘਾਵਤ ॥",
      "transliteration": "maar maar dhun kitak ughaavat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤਨੇ ਹੀ 'ਮਾਰੋ ਮਾਰੋ' ਦੀ ਧੁਨ ਨਾਲ ਗਰਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "मारि मारि धुनि कितक उघावत ॥",
      "sourceLineId": "139118",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮੰਡਹਿ ਮਹਾ ਕਾਲ ਸੌ ਜੁਧਾ ॥",
      "transliteration": "ma(n)ddeh mahaa kaal sau judhaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮਨ ਵਿਚ ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "मंडहि महा काल सौ जुधा ॥",
      "sourceLineId": "139119",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਹ੍ਵੈ ਹ੍ਵੈ ਅਧਿਕ ਚਿਤ ਮਹਿ ਕ੍ਰੁਧਾ ॥੧੫੦॥",
      "transliteration": "havai havai adhik chit meh krudhaa ||150||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨਾਲ ਯੁੱਧ ਕਰਦੇ ਸਨ ॥੧੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "ह्वै ह्वै अधिक चित महि क्रुधा ॥१५०॥",
      "sourceLineId": "139120",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜੇਤਿਕ ਸੁਭਟ ਕੋਪਿ ਕਰਿ ਆਏ ॥",
      "transliteration": "jetik subhaT kop kar aae ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ ਸੂਰਮੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ (ਅਗੇ) ਆਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "जेतिक सुभट कोपि करि आए ॥",
      "sourceLineId": "139121",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਤੇਤੇ ਈ ਖਪਾਏ ॥",
      "transliteration": "mahaa kaal tete iee khapaae ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨੇ ਉਤਨੇ ਹੀ ਖਪਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "महा काल तेते ई खपाए ॥",
      "sourceLineId": "139122",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਿਨ ਕੋ ਮੇਦ ਮਾਸ ਭੂਅ ਪਰਾ ॥",
      "transliteration": "tin ko medh maas bhooa paraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਮਿਝ ਅਤੇ ਮਾਸ ਧਰਤੀ ਉਤੇ ਡਿਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "तिन को मेद मास भूअ परा ॥",
      "sourceLineId": "139123",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਬਹੁ ਅਸੁਰਨ ਤਾ ਤੇ ਬਪੁ ਧਰਾ ॥੧੫੧॥",
      "transliteration": "bahu asuran taa te bap dharaa ||151||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਹੋਰ ਬਹੁਤ ਸਾਰੇ ਦੈਂਤਾ ਨੇ ਸ਼ਰੀਰ ਧਾਰਨ ਕਰ ਲਏ ॥੧੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "बहु असुरन ता ते बपु धरा ॥१५१॥",
      "sourceLineId": "139124",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਤੇ ਦਏ ਖਪਾਇ ॥",
      "transliteration": "mahaa kaal te dhe khapai ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨੇ ਉਨ੍ਰਹਾ ਨੂੰ ਖਪਾ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "महा काल ते दए खपाइ ॥",
      "sourceLineId": "139125",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸ੍ਰੋਨਤ ਸੋ ਪ੍ਰਿਥਵੀ ਰਹੀ ਛਾਇ ॥",
      "transliteration": "sronat so pirathavee rahee chhai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਲਹੂ ਨਾਲ ਧਰਤੀ ਰੰਗੀ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "स्रोनत सो पृथवी रही छाइ ॥",
      "sourceLineId": "139126",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਤਿਹ ਤੇ ਅਮਿਤ ਅਸੁਰ ਉਠਿ ਢੂਕੇ ॥",
      "transliteration": "teh te amit asur uTh ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਹੋਰ ਬੇਸ਼ੁਮਾਰ ਦੈਂਤ ਉਠ ਕੇ ਆ ਢੁਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "तिह ते अमित असुर उठि ढूके ॥",
      "sourceLineId": "139127",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਮਾਰਹਿ ਮਾਰਿ ਦਸੌ ਦਿਸਿ ਕੂਕੇ ॥੧੫੨॥",
      "transliteration": "maareh maar dhasau dhis kooke ||152||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਸਾ ਦਿਸ਼ਾਵਾ ਵਿਚ 'ਮਾਰੋ ਮਾਰੋ' ਕੂਕਣ ਲਗੇ ॥੧੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "मारहि मारि दसौ दिसि कूके ॥१५२॥",
      "sourceLineId": "139128",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਕੇਤਿਕ ਕੀ ਬਾਹਨ ਕਟਿ ਡਾਰਾ ॥",
      "transliteration": "ketik kee baahan kaT ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਦੀਆਂ ਬਾਹਵਾ ਕਟ ਦਿੱਤੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "केतिक की बाहन कटि डारा ॥",
      "sourceLineId": "139129",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਕਰੇ ਰੁੰਡ ਬਿਨੁ ਮੁੰਡ ਹਜਾਰਾ ॥",
      "transliteration": "kare ru(n)dd bin mu(n)dd hajaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਜ਼ਾਰਾ ਧੜ ਸਿਰਾ ਤੋਂ ਬਿਨਾ ਕਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "करे रुँड बिनु मुँड हजारा ॥",
      "sourceLineId": "139130",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਕੇਤਿਕ ਚੀਰ ਅਧੌ ਅਧ ਡਾਰੇ ॥",
      "transliteration": "ketik cheer adhau adh ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਅਧੋ ਅਧ ਚੀਰ ਸੁਟੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "केतिक चीर अधौ अध डारे ॥",
      "sourceLineId": "139131",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਨਾਚਤ ਭੂਤ ਪ੍ਰੇਤ ਮਤਵਾਰੇ ॥੧੫੩॥",
      "transliteration": "naachat bhoot pret matavaare ||153||",
      "translation": "",
      "punjabiViakhya": "ਭੂਤ ਅਤੇ ਪ੍ਰੇਤ ਮਤਵਾਲੇ ਹੋ ਕੇ ਨਚਣ ਲਗ ਗਏ ॥੧੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "नाचत भूत प्रेत मतवारे ॥१५३॥",
      "sourceLineId": "139132",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਜੇ ਤਿਨ ਕੇ ਸਿਰਿ ਬਹੀ ਕ੍ਰਿਪਾਨੈ ॥",
      "transliteration": "je tin ke sir bahee kirapaanai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨਿਆਂ ਦੇ ਸਿਰ ਉਤੇ ਕ੍ਰਿਪਾਨਾ ਚਲੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "जे तिन के सिरि बही कृपानै ॥",
      "sourceLineId": "139133",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਅਰਧ ਅਰਧ ਹ੍ਵੈ ਜੂਝੇ ਜ੍ਵਾਨੈ ॥",
      "transliteration": "aradh aradh havai joojhe javaiaanai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਜਵਾਨ ਅੱਧੇ ਅੱਧੇ ਹੋ ਕੇ ਮਾਰੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "अरध अरध ह्वै जूझे ज्वानै ॥",
      "sourceLineId": "139134",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਗਜ ਬਾਜੀ ਲੋਟਤ ਕਹੂੰ ਭੂ ਪਰ ॥",
      "transliteration": "gaj baajee loTat kahoo(n) bhoo par ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘੋੜੇ ਅਤੇ ਹਾਥੀ ਧਰਤੀ ਉਤੇ ਲੋਟ ਪੋਟ ਹੋ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "गज बाजी लोटत कहूँ भू पर ॥",
      "sourceLineId": "139135",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਸੁੰਭਨ ਸਬਦ ਸੁਨਾ ਅਵਨੀ ਤਰ ॥੧੫੪॥",
      "transliteration": "su(n)bhan sabadh sunaa avanee tar ||154||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੁੰਮਾ (ਖੁਰਾ) ਦੇ ਵਜਣ ਦੀ ਆਵਾਜ਼ ਧਰਤੀ ਦੇ ਹੇਠਾ ਸੁਣੀਂਦੀ ਸੀ ॥੧੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "सुँभन सबद सुना अवनी तर ॥१५४॥",
      "sourceLineId": "139136",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਗਿਰਿ ਗਿਰਿ ਪਰੇ ਕਹੂੰ ਘਾਯਲ ਰਨ ॥",
      "transliteration": "gir gir pare kahoo(n) ghaayal ran ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਕਿਤੇ (ਸੂਰਮੇ) ਘਾਇਲ ਹੋ ਕੇ ਡਿਗ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1368,
      "hindi": "",
      "hindiTransliteration": "गिरि गिरि परे कहूँ घायल रन ॥",
      "sourceLineId": "139137",
      "sourceShabadId": "12781",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1368_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਭਾਜਿ ਚਲੇ ਕਈ ਹੋਇ ਬਿਮਨ ਮਨ ॥",
      "transliteration": "bhaaj chale kiee hoi biman man ||",
      "translation": "",
