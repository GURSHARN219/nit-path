{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1372,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1372_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮੋਹਨਾਸਤ੍ਰ ਕੇਤੇ ਮੋਹਿਤ ਕਰਿ ॥",
      "transliteration": "mohanaasatr kete mohit kar ||",
      "translation": "",
      "punjabiViakhya": "ਮੋਹਨ ਅਸਤ੍ਰ ਨਾਲ ਕਈਆਂ ਨੂੰ ਮੋਹਿਤ (ਬੇਸੁੱਧ) ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "मोहनासत्र केते मोहित करि ॥",
      "sourceLineId": "139283",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਰੁਣਾਸਤ੍ਰ ਭੇ ਪ੍ਰਾਨ ਕਿਤਨ ਹਰਿ ॥",
      "transliteration": "barunaasatr bhe praan kitan har ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵਰੁਣ ਅਸਤ੍ਰ ਨਾਲ ਕਿਤਨਿਆਂ ਦੇ ਪ੍ਰਾਣ ਹਰ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "बरुणासत्र भे प्रान कितन हरि ॥",
      "sourceLineId": "139284",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪਾਵਕਾਸਤ੍ਰ ਭੇ ਅਧਿਕ ਜਰਾਏ ॥",
      "transliteration": "paavakaasatr bhe adhik jaraae ||",
      "translation": "",
      "punjabiViakhya": "ਅਗਨ ਅਸਤ੍ਰ ਛਡ ਕੇ ਬਹੁਤ ਸਾਰੇ (ਸੂਰਮਿਆਂ) ਨੂੰ ਸਾੜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "पावकासत्र भे अधिक जराए ॥",
      "sourceLineId": "139285",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਮਿਤ ਸੁਭਟ ਮ੍ਰਿਤ ਲੋਕ ਪਠਾਏ ॥੧੯੧॥",
      "transliteration": "amit subhaT mirat lok paThaae ||191||",
      "translation": "",
      "punjabiViakhya": "ਬੇਸ਼ੁਮਾਰ ਯੋਧਿਆਂ ਨੂੰ ਯਮ-ਲੋਕ ਪਹੁੰਚਾ ਦਿੱਤਾ ॥੧੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "अमित सुभट मृत लोक पठाए ॥१९१॥",
      "sourceLineId": "139286",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਾ ਪਰ ਮਹਾ ਕਾਲ ਅਸਿ ਝਾਰਾ ॥",
      "transliteration": "jaa par mahaa kaal as jhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਉਤੇ ਮਹਾ ਕਾਲ ਨੇ ਤਲਵਾਰ ਦਾ ਵਾਰ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "जा पर महा काल असि झारा ॥",
      "sourceLineId": "139287",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਏਕ ਸੁਭਟ ਤੇ ਦ੍ਵੈ ਕਰਿ ਡਾਰਾ ॥",
      "transliteration": "ek subhaT te dhavai kar ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ) ਯੋਧੇ ਨੂੰ ਇਕ ਤੋਂ ਦੋ ਕਰ ਦਿੱਤਾ (ਅਰਥਾਤ-ਦੋ ਟੋਟੇ ਕਰ ਦਿੱਤੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "एक सुभट ते द्वै करि डारा ॥",
      "sourceLineId": "139288",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੌ ਦ੍ਵੈ ਨਰ ਪਰ ਟੁਕ ਅਸਿ ਧਰਾ ॥",
      "transliteration": "jau dhavai nar par Tuk as dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਜੇ ਦੋ ਟੁਕੜੇ ਹੋਏ ਬੰਦਿਆਂ ਉਤੇ ਥੋੜੀ ਜਿੰਨੀ ਤਲਵਾਰ ਚਲਾਈ",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "जौ द्वै नर पर टुक असि धरा ॥",
      "sourceLineId": "139289",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚਾਰਿ ਟੂਕ ਤਿਨ ਦ੍ਵੈ ਕੈ ਕਰਾ ॥੧੯੨॥",
      "transliteration": "chaar Took tin dhavai kai karaa ||192||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਨ੍ਰਹਾ ਦੇ ਦੋ ਤੋਂ ਚਾਰ ਟੁਕੜੇ ਕਰ ਦਿੱਤੇ ॥੧੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "चारि टूक तिन द्वै कै करा ॥१९२॥",
      "sourceLineId": "139290",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕੇਤਿਕ ਪਰੇ ਸੁਭਟ ਬਿਲਲਾਹੀ ॥",
      "transliteration": "ketik pare subhaT bilalaahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਸੂਰਮੇ ਵਿਰਲਾਪ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "केतिक परे सुभट बिललाही ॥",
      "sourceLineId": "139291",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੰਬੁਕ ਗਿਧ ਮਾਸੁ ਲੈ ਜਾਹੀ ॥",
      "transliteration": "ja(n)buk gidh maas lai jaahee ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦਾ) ਮਾਸ ਗਿਦੜ ਅਤੇ ਗਿੱਧਾ ਲੈ ਜਾ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "जंबुक गिध मासु लै जाही ॥",
      "sourceLineId": "139292",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭੈਰਵ ਆਨਿ ਦੁਹੂੰ ਭਭਕਾਰੈ ॥",
      "transliteration": "bhairav aan dhuhoo(n) bhabhakaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭੈਰੋ ਆ ਕੇ ਭਭਕਾਰ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "भैरव आनि दुहूँ भभकारै ॥",
      "sourceLineId": "139293",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਹੂੰ ਮਸਾਨ ਕਿਲਕਟੀ ਮਾਰੈ ॥੧੯੩॥",
      "transliteration": "kahoo(n) masaan kilakaTee maarai ||193||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਮਸਾਨ (ਪ੍ਰੇਤ) ਕਿਲਕਾਰੀਆਂ ਮਾਰ ਰਹੇ ਸਨ ॥੧੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "कहूँ मसान किलकटी मारै ॥१९३॥",
      "sourceLineId": "139294",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕੇਤਿਕ ਸੁਭਟ ਆਨਿ ਹੀ ਢੂਕੈ ॥",
      "transliteration": "ketik subhaT aan hee ddookai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਸੂਰਮੇ ਫਿਰ ਆਣ ਢੁਕੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "केतिक सुभट आनि ही ढूकै ॥",
      "sourceLineId": "139295",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਾਰਹਿ ਮਾਰਿ ਦਸੋ ਦਿਸਿ ਕੂਕੈ ॥",
      "transliteration": "maareh maar dhaso dhis kookai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਸਾ ਦਿਸ਼ਾਵਾ ਵਿਚ 'ਮਾਰੋ ਮਾਰੋ' ਕੂਕ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "मारहि मारि दसो दिसि कूकै ॥",
      "sourceLineId": "139296",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਪਰ ਜੇ ਬ੍ਰਿਣ ਕਰਹੀ ॥",
      "transliteration": "mahaa kaal par je biran karahee ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਵੀ (ਹਥਿਆਰ) ਮਹਾ ਕਾਲ ਨੂੰ ਘਾਇਲ ਕਰਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "महा काल पर जे बृण करही ॥",
      "sourceLineId": "139297",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕੁੰਠਤ ਹੋਇ ਧਰਨਿ ਗਿਰ ਪਰਹੀ ॥੧੯੪॥",
      "transliteration": "ku(n)That hoi dharan gir parahee ||194||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਖੁੰਢਾ ਹੋ ਕੇ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪੈਂਦਾ ਸੀ ॥੧੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "कुँठत होइ धरनि गिर परही ॥१९४॥",
      "sourceLineId": "139298",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਹੁਰਿ ਕੋਪ ਕਰਿ ਅਸੁਰ ਅਪਾਰਾ ॥",
      "transliteration": "bahur kop kar asur apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਸ਼ੁਮਾਰ ਦੈਂਤ ਕ੍ਰੋਧ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "बहुरि कोप करि असुर अपारा ॥",
      "sourceLineId": "139299",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅ ਮਹਾ ਕਾਲ ਕਹ ਕਰਤ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "a mahaa kaal keh karat prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਮਹਾ ਕਾਲ ਉਤੇ ਵਾਰ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "अ महा काल कह करत प्रहारा ॥",
      "sourceLineId": "139300",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤੇ ਵੈ ਏਕ ਰੂਪ ਹ੍ਵੈ ਜਾਹੀ ॥",
      "transliteration": "te vai ek roop havai jaahee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਉਸ ਮਹਾ ਕਾਲ ਨਾਲ ਇਕ ਰੂਪ ਹੀ ਹੋ ਜਾਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "ते वै एक रूप ह्वै जाही ॥",
      "sourceLineId": "139301",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕੇ ਮਧ੍ਯ ਸਮਾਹੀ ॥੧੯੫॥",
      "transliteration": "mahaa kaal ke madhay samaahee ||195||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਸ ਵਿਚ ਸਮਾ ਜਾਦੇ ਸਨ ॥੧੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "महा काल के मध्य समाही ॥१९५॥",
      "sourceLineId": "139302",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਮਿ ਕੋਈ ਬਾਰਿ ਬਾਰਿ ਪਰ ਮਾਰੈ ॥",
      "transliteration": "jim koiee baar baar par maarai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕੋਈ ਪਾਣੀ ਉਤੇ ਪਾਣੀ ਮਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "जिमि कोई बारि बारि पर मारै ॥",
      "sourceLineId": "139303",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹੋਤ ਲੀਨ ਤਿਹ ਮਾਝ ਸੁਧਾਰੈ ॥",
      "transliteration": "hot leen teh maajh sudhaarai ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਹ ਉਸ ਵਿਚ ਹੀ ਸਮਾ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "होत लीन तिह माझ सुधारै ॥",
      "sourceLineId": "139304",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪੁਨਿ ਕੋਈ ਤਾਹਿ ਨ ਸਕਤ ਪਛਾਨੀ ॥",
      "transliteration": "pun koiee taeh na sakat pachhaanee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਕੋਈ ਉਸ ਨੂੰ ਪਛਾਣ ਨਹੀਂ ਸਕਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "पुनि कोई ताहि न सकत पछानी ॥",
      "sourceLineId": "139305",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਗਿਲ ਆਹਿ ਕਿ ਮੋਰਾ ਪਾਨੀ ॥੧੯੬॥",
      "transliteration": "aagil aaeh k moraa paanee ||196||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਪਹਿਲਾ ਪਾਣੀ ਕਿਹੜਾ ਸੀ ਅਤੇ ਮੇਰਾ ਪਾਣੀ ਕਿਹੜਾ ਹੈ ॥੧੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "आगिल आहि कि मोरा पानी ॥१९६॥",
      "sourceLineId": "139306",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਭਏ ਸਸਤ੍ਰ ਜਬ ਲੀਨਾ ॥",
      "transliteration": "eeh bidh bhe sasatr jab leenaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਜਦ ਸਾਰੇ ਸ਼ਸਤ੍ਰ (ਮਹਾ ਕਾਲ ਵਿਚ) ਲੀਨ ਹੋ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "इह बिधि भए ससत्र जब लीना ॥",
      "sourceLineId": "139307",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਸੁਰਨ ਕੋਪ ਅਮਿਤ ਤਬ ਕੀਨਾ ॥",
      "transliteration": "asuran kop amit tab keenaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੈਂਤਾ ਨੇ ਬਹੁਤ ਅਧਿਕ ਕ੍ਰੋਧ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "असुरन कोप अमित तब कीना ॥",
      "sourceLineId": "139308",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਾਪਤ ਅਧਿਕ ਚਿਤ ਮੋ ਗਏ ॥",
      "transliteration": "kaapat adhik chit mo ge ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮਨ ਵਿਚ ਬਹੁਤ ਡਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "कापत अधिक चित मो गए ॥",
      "sourceLineId": "139309",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਲੈ ਆਵਤ ਭਏ ॥੧੯੭॥",
      "transliteration": "sasatr asatr lai aavat bhe ||197||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਸਤ੍ਰ ਅਤੇ ਸ਼ਸਤ੍ਰ ਲੈ ਕੇ ਆ ਗਏ ॥੧੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "ससत्र असत्र लै आवत भए ॥१९७॥",
      "sourceLineId": "139310",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜ੍ਵਾਲ ਤਜੀ ਕਰਿ ਕੋਪ ਨਿਸਾਚਰ ॥",
      "transliteration": "javaiaal tajee kar kop nisaachar ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤਾ ਨੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ (ਮੂੰਹਾ ਵਿਚੋ) ਅਗਨੀ ਉਗਲੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "ज्वाल तजी करि कोप निसाचर ॥",
      "sourceLineId": "139311",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਿਨ ਤੇ ਭਏ ਪਠਾਨ ਧਨੁਖ ਧਰ ॥",
      "transliteration": "tin te bhe paThaan dhanukh dhar ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਧਨੁਸ਼ਧਾਰੀ ਪਠਾਨ ਪੈਦਾ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "तिन ते भए पठान धनुख धर ॥",
      "sourceLineId": "139312",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪੁਨਿ ਮੁਖ ਤੇ ਉਲਕਾ ਜੇ ਕਾਢੇ ॥",
      "transliteration": "pun mukh te ulakaa je kaadde ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਫਿਰ ਮੂੰਹ ਤੋਂ ਅੱਗ (ਅੰਗਾਰੇ) ਕਢੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "पुनि मुख ते उलका जे काढे ॥",
      "sourceLineId": "139313",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਤੇ ਮੁਗਲ ਉਪਜਿ ਭੇ ਠਾਢੇ ॥੧੯੮॥",
      "transliteration": "taa te mugal upaj bhe Thaadde ||198||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਮੁਗ਼ਲ ਪੈਦਾ ਹੋ ਕੇ ਡਟ ਗਏ ॥੧੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "ता ते मुगल उपजि भे ठाढे ॥१९८॥",
      "sourceLineId": "139314",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪੁਨਿ ਰਿਸਿ ਤਨ ਤਿਨ ਸ੍ਵਾਸ ਨਿਕਾਰੇ ॥",
      "transliteration": "pun ris tan tin savaiaas nikaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਫਿਰ ਰੋਹ ਵਿਚ ਆ ਕੇ ਸੁਆਸ ਕਢੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "पुनि रिसि तन तिन स्वास निकारे ॥",
      "sourceLineId": "139315",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੈਯਦ ਸੇਖ ਭਏ ਰਿਸ ਵਾਰੇ ॥",
      "transliteration": "saiyadh sekh bhe ris vaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਕ੍ਰੋਧੀ ਸੱਯਦ ਅਤੇ ਸ਼ੇਖ ਪੈਦਾ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "सैयद सेख भए रिस वारे ॥",
      "sourceLineId": "139316",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਧਾਏ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਕਰ ਲੈ ਕੈ ॥",
      "transliteration": "dhaae sasatr asatr kar lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਅਸਤ੍ਰ ਅਤੇ ਸ਼ਸਤ੍ਰ ਹੱਥਾ ਵਿਚ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "धाए ससत्र असत्र कर लै कै ॥",
      "sourceLineId": "139317",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਮਕਿ ਤੇਜ ਰਨ ਤੁਰੀ ਨਚੈ ਕੈ ॥੧੯੯॥",
      "transliteration": "tamak tej ran turee nachai kai ||199||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਘੋੜਿਆਂ ਨੂੰ ਉਕਸਾ ਕੇ ਨਚਾਉਾਂਦੇ ਹੋਏ ਰਣ-ਭੂਮੀ ਵਿਚ ਧਾ ਕੇ ਪੈ ਗਏ ॥੧੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "तमकि तेज रन तुरी नचै कै ॥१९९॥",
      "sourceLineId": "139318",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਖਾਨ ਪਠਾਨ ਢੁਕੇ ਰਿਸਿ ਕੈ ਕੈ ॥",
      "transliteration": "khaan paThaan dduke ris kai kai ||",
      "translation": "",
      "punjabiViakhya": "ਖ਼ਾਨ ਅਤੇ ਪਠਾਨ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "खान पठान ढुके रिसि कै कै ॥",
      "sourceLineId": "139319",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕੋਪਿ ਕ੍ਰਿਪਾਨ ਨਗਨ ਕਰ ਲੈ ਕੈ ॥",
      "transliteration": "kop kirapaan nagan kar lai kai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੱਥ ਵਿਚ ਨੰਗੀਆਂ ਤਲਵਾਰਾ ਲੈ ਕੇ ਆਣ ਢੁਕੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "कोपि कृपान नगन कर लै कै ॥",
      "sourceLineId": "139320",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕੌ ਕਰਤ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "mahaa kaal kau karat prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮਹਾ ਕਾਲ ਉਤੇ ਵਾਰ ਕਰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "महा काल कौ करत प्रहारा ॥",
      "sourceLineId": "139321",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਏਕ ਨ ਉਪਰਤ ਰੋਮ ਉਪਾਰਾ ॥੨੦੦॥",
      "transliteration": "ek na uparat rom upaaraa ||200||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਉਸ ਦਾ ਇਕ ਵਾਲ ਵੀ ਉਖਾੜ ਨਹੀਂ ਸਕਦੇ ਸਨ ॥੨੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "एक न उपरत रोम उपारा ॥२००॥",
      "sourceLineId": "139322",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਮਿਤ ਖਾਨ ਕਰਿ ਕੋਪ ਸਿਧਾਰੇ ॥",
      "transliteration": "amit khaan kar kop sidhaare ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਰਾਬ ਵਿਚ ਪੂਰੀ ਤਰ੍ਰਹਾ ਮਦਹੋਸ਼ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "अमित खान करि कोप सिधारे ॥",
      "sourceLineId": "139323",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਦ ਕਰਿ ਭਏ ਸਕਲ ਮਤਵਾਰੇ ॥",
      "transliteration": "madh kar bhe sakal matavaare ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਸ਼ੁਮਾਰ ਖ਼ਾਨ ਰੋਹ ਵਿਚ ਆ ਕੇ ਚਲ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "मद करि भए सकल मतवारे ॥",
      "sourceLineId": "139324",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਉਮਡੇ ਅਮਿਤ ਮਲੇਛਨ ਕੇ ਗਨ ॥",
      "transliteration": "aumadde amit malechhan ke gan ||",
      "translation": "",
      "punjabiViakhya": "ਮਲੇਛਾ ਦੇ ਅਣਗਿਣਤ (ਸੂਰਮਿਆਂ ਦੇ) ਦਲ ਉਮਡ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "उमडे अमित मलेछन के गन ॥",
      "sourceLineId": "139325",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਨ ਕੇ ਨਾਮ ਕਹਤ ਤੁਮ ਸੌ ਭਨਿ ॥੨੦੧॥",
      "transliteration": "tin ke naam kahat tum sau bhan ||201||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਨਾ ਤੁਹਾਨੂੰ ਦਸਦਾ ਹਾ ॥੨੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "तिन के नाम कहत तुम सौ भनि ॥२०१॥",
      "sourceLineId": "139326",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਹਰ ਖਾਨ ਝੜਾਝੜ ਖਾਨਾ ॥",
      "transliteration": "naahar khaan jhaRaajhaR khaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਹਰ ਖ਼ਾਨ, ਝੜਾਝੜ ਖ਼ਾਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "नाहर खान झड़ाझड़ खाना ॥",
      "sourceLineId": "139327",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਖਾਨ ਨਿਹੰਗ ਭੜੰਗ ਜੁਆਨਾ ॥",
      "transliteration": "khaan niha(n)g bhaRa(n)g juaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਨਿਹੰਗ ਖ਼ਾਨ, ਭੜੰਗ (ਖ਼ਾਨ)",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "खान निहंग भड़ंग जुआना ॥",
      "sourceLineId": "139328",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਔਰ ਝੜੰਗ ਖਾਨ ਰਨ ਧਾਯੋ ॥",
      "transliteration": "aauar jhaRa(n)g khaan ran dhaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਝੜੰਗ ਖ਼ਾਨ (ਆਦਿ ਲੜਾਕੇ ਯੋਧੇ)",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "और झड़ंग खान रन धायो ॥",
      "sourceLineId": "139329",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1372_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਮਿਤ ਸਸਤ੍ਰ ਕਰ ਲਏ ਸਿਧਾਯੋ ॥੨੦੨॥",
      "transliteration": "amit sasatr kar le sidhaayo ||202||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਹੱਥਾ ਵਿਚ ਬੇਹਿਸਾਬ ਸ਼ਸਤ੍ਰ ਲੈ ਕੇ ਰਣ-ਭੂਮੀ ਵਿਚ ਚੜ੍ਰਹ ਆਏ ॥੨੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1372,
      "hindi": "",
      "hindiTransliteration": "अमित ससत्र कर लए सिधायो ॥२०२॥",
      "sourceLineId": "139330",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
