{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1373,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1373_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬੈਰਮ ਖਾਨ ਬਹਾਦੁਰ ਖਾਨਾ ॥",
      "transliteration": "bairam khaan bahaadhur khaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬੈਰਮ ਖ਼ਾਨ, ਬਹਾਦੁਰ ਖ਼ਾਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "बैरम खान बहादुर खाना ॥",
      "sourceLineId": "139331",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਲਵੰਡ ਖਾਨ ਬਡੋ ਸੁਰ ਗ੍ਯਾਨਾ ॥",
      "transliteration": "balava(n)dd khaan baddo sur gayaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਲਵੰਡ ਖ਼ਾਨ ਅਤੇ ਰੁਸਤਮ ਖ਼ਾਨ ਆਦਿ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "बलवंड खान बडो सुर ग्याना ॥",
      "sourceLineId": "139332",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰੁਸਤਮ ਖਾਨ ਕੋਪ ਕਰਿ ਚਲੋ ॥",
      "transliteration": "rusatam khaan kop kar chalo ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਸਿਆਣੇ ਦੈਂਤ ਰੋਹ ਵਿਚ ਆ ਕੇ ਚਲ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "रुसतम खान कोप करि चलो ॥",
      "sourceLineId": "139333",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲੀਨੇ ਅਮਿਤ ਸੈਨ ਸੰਗ ਭਲੋ ॥੨੦੩॥",
      "transliteration": "leene amit sain sa(n)g bhalo ||203||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸਾਰੀ ਸੈਨਾ ਨਾਲ ਲੈ ਕੇ ॥੨੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "लीने अमित सैन संग भलो ॥२०३॥",
      "sourceLineId": "139334",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਸਨ ਖਾਨ ਹੁਸੈਨ ਖਾਨ ਭਨ ॥",
      "transliteration": "hasan khaan husain khaan bhan ||",
      "translation": "",
      "punjabiViakhya": "ਹਸਨ ਖ਼ਾਨ, ਹੁਸੈਨ ਖ਼ਾਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "हसन खान हुसैन खान भन ॥",
      "sourceLineId": "139335",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਖਾਨ ਮੁਹੰਮਦ ਲੈ ਮਲੇਛ ਗਨ ॥",
      "transliteration": "khaan muha(n)madh lai malechh gan ||",
      "translation": "",
      "punjabiViakhya": "ਮੁਹੰਮਦ ਖ਼ਾਨ ਬਹੁਤ ਸਾਰੀ ਸੈਨਾ ਨਾਲ ਲੈ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "खान मुहंमद लै मलेछ गन ॥",
      "sourceLineId": "139336",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਮਸ ਖਾਨ ਸਮਸਰੋ ਖਾਨਾ ॥",
      "transliteration": "samas khaan samasaro khaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਮਸ ਖ਼ਾਨ ਅਤੇ ਸਮਸਰੋ ਖ਼ਾਨ (ਸਮੇਤ)",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "समस खान समसरो खाना ॥",
      "sourceLineId": "139337",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚਲੇ ਪੀਸ ਕਰਿ ਦਾਤ ਜੁਆਨਾ ॥੨੦੪॥",
      "transliteration": "chale pees kar dhaat juaanaa ||204||",
      "translation": "",
      "punjabiViakhya": "ਦੰਦ ਪੀਂਹਦੇ ਹੋਏ ਚਲ ਪਏ ॥੨੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "चले पीस करि दात जुआना ॥२०४॥",
      "sourceLineId": "139338",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਵਤ ਹੀ ਕੀਏ ਬਾਨ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "aavat hee ke'ee baan prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਆਉਾਂਦਿਆਂ ਹੀ ਬਾਣਾ ਦੇ ਵਾਰ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "आवत ही कीए बान प्रहारा ॥",
      "sourceLineId": "139339",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕਰ ਚਹਤ ਸੰਘਾਰਾ ॥",
      "transliteration": "mahaa kaal kar chahat sa(n)ghaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮਹਾ ਕਾਲ ਨੂੰ ਮਾਰ ਦੇਣਾ ਚਾਹੁੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "महा काल कर चहत संघारा ॥",
      "sourceLineId": "139340",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਸਰ ਚਲਤ ਨਿਹਾਰੇ ॥",
      "transliteration": "mahaa kaal sar chalat nihaare ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਚਲਦੇ ਹੋਏ ਬਾਣਾ ਨੂੰ ਵੇਖਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "महा काल सर चलत निहारे ॥",
      "sourceLineId": "139341",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਟੂਕ ਸਹੰਸ੍ਰ ਪ੍ਰਿਥੀ ਕਰਿ ਡਾਰੇ ॥੨੦੫॥",
      "transliteration": "Took saha(n)sr pirathee kar ddaare ||205||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਉਨ੍ਰਹਾ ਦੇ) ਹਜ਼ਾਰਾ ਟੋਟੇ ਕਰ ਕੇ ਧਰਤੀ ਉਤੇ ਸੁਟ ਦਿੰਦਾ ॥੨੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "टूक सहंस्र पृथी करि डारे ॥२०५॥",
      "sourceLineId": "139342",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਡਾਰੇ ਸਤ ਸਤ ਟੂਕ ਪ੍ਰਿਥੀ ਕਰਿ ॥",
      "transliteration": "ddaare sat sat Took pirathee kar ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨੇ ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਬੇਸ਼ੁਮਾਰ ਬਾਣ ਚਲਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "डारे सत सत टूक पृथी करि ॥",
      "sourceLineId": "139343",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕਰਿ ਕੋਪ ਅਮਿਤ ਸਰ ॥",
      "transliteration": "mahaa kaal kar kop amit sar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਤੀਰਾ ਨੂੰ) ਸੌ ਸੌ ('ਸਤ, ਸਤ') ਟੋਟੇ ਕਰ ਕੇ ਧਰਤੀ ਉਤੇ ਸੁਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "महा काल करि कोप अमित सर ॥",
      "sourceLineId": "139344",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਕ ਇਕ ਸਰ ਤਨ ਬਹੁਰਿ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "eik ik sar tan bahur prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਮਹਾ ਕਾਲ) ਨੇ ਫਿਰ ਇਕ ਇਕ ਤੀਰ ਚਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "इक इक सर तन बहुरि प्रहारे ॥",
      "sourceLineId": "139345",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗਿਰੇ ਪਠਾਨ ਸੁ ਭੂਮਿ ਮੰਝਾਰੇ ॥੨੦੬॥",
      "transliteration": "gire paThaan su bhoom ma(n)jhaare ||206||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨਾਲ ਬਹੁਤ ਸਾਰੇ) ਪਠਾਨ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਏ ॥੨੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "गिरे पठान सु भूमि मंझारे ॥२०६॥",
      "sourceLineId": "139346",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਟਿ ਨਿਹੰਗਕ ਰਾਖਾ ਦ੍ਵੈ ਧਰ ॥",
      "transliteration": "kaT niha(n)gak raakhaa dhavai dhar ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਨਿਹੰਗ ਖ਼ਾਨ ਨੂੰ ਦੋ ਹਿੱਸਿਆਂ ਵਿਚ ਕਟ ਕੇ ਰਖ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "कटि निहंगक राखा द्वै धर ॥",
      "sourceLineId": "139347",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਾਰੇ ਅਮਿਤ ਝੜਾਝੜ ਖਾ ਸਰ ॥",
      "transliteration": "maare amit jhaRaajhaR khaa sar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਝੜਾਝੜ ਖ਼ਾਨ ਨੂੰ ਵੀ ਬਹੁਤ ਤੀਰ ਮਾਰੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "मारे अमित झड़ाझड़ खा सर ॥",
      "sourceLineId": "139348",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਖਾਨ ਭੜੰਗ ਬਹੁਰਿ ਰਨ ਮਾਰੇ ॥",
      "transliteration": "khaan bhaRa(n)g bahur ran maare ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਭੜੰਗ ਖ਼ਾਨ ਨੂੰ ਰਣ-ਖੇਤਰ ਵਿਚ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "खान भड़ंग बहुरि रन मारे ॥",
      "sourceLineId": "139349",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੇਖਤ ਚਾਰਣ ਸਿਧ ਹਜਾਰੇ ॥੨੦੭॥",
      "transliteration": "dhekhat chaaran sidh hajaare ||207||",
      "translation": "",
      "punjabiViakhya": "ਹਜ਼ਾਰਾ ਚਾਰਣਾ ਅਤੇ ਸਿੱਧਾ ਦੇ ਵੇਖਦੇ ਹੋਇਆਂ ॥੨੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "देखत चारण सिध हजारे ॥२०७॥",
      "sourceLineId": "139350",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਹਰ ਖਾ ਗੈਰਤ ਖਾ ਮਾਰਾ ॥",
      "transliteration": "naahar khaa gairat khaa maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਨਾਹਰ ਖ਼ਾਨ ਅਤੇ ਗੈਰਤ ਖ਼ਾਨ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "नाहर खा गैरत खा मारा ॥",
      "sourceLineId": "139351",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਲਵੰਡ ਖਾ ਕਾ ਸੀਸ ਉਤਾਰਾ ॥",
      "transliteration": "balava(n)dd khaa kaa sees utaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਲਵੰਡ ਖ਼ਾਨ ਦਾ ਸਿਰ ਉਤਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "बलवंड खा का सीस उतारा ॥",
      "sourceLineId": "139352",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੇਰ ਖਾਨ ਕਟਿ ਤੇ ਕਟਿ ਡਾਰਿਯੋ ॥",
      "transliteration": "ser khaan kaT te kaT ddaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੇਰ ਖ਼ਾਨ ਨੂੰ ਲਕ ('ਕਟਿ') ਤੋਂ ਕਟ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "सेर खान कटि ते कटि डारियो ॥",
      "sourceLineId": "139353",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬੈਰਮ ਖਾ ਗਹਿ ਕੇਸ ਪਛਾਰਿਯੋ ॥੨੦੮॥",
      "transliteration": "bairam khaa geh kes pachhaariyo ||208||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬੈਰਮ ਖ਼ਾਨ ਨੂੰ ਵਾਲਾ ਤੋਂ ਪਕੜ ਕੇ ਪਛਾੜ ਦਿੱਤਾ ॥੨੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "बैरम खा गहि केस पछारियो ॥२०८॥",
      "sourceLineId": "139354",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪੁਨਿ ਕਰਿ ਕੋਪ ਬਹਾਦੁਰ ਖਾਨਾ ॥",
      "transliteration": "pun kar kop bahaadhur khaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਬਹਾਦੁਰ ਖ਼ਾਨ ਨੇ ਕ੍ਰੋਧ ਕੀਤਾ ਅਤੇ ਰੋਹ ਵਿਚ ਆ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "पुनि करि कोप बहादुर खाना ॥",
      "sourceLineId": "139355",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਛਾਡੇ ਤਬੈ ਬਿਸਿਖ ਰਿਸਿ ਨਾਨਾ ॥",
      "transliteration": "chhaadde tabai bisikh ris naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਬਹੁਤ ਸਾਰੇ ਬਾਣ ਛਡੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "छाडे तबै बिसिख रिसि नाना ॥",
      "sourceLineId": "139356",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕੁਪ ਬਾਨ ਪ੍ਰਹਾਰੋ ॥",
      "transliteration": "mahaa kaal kup baan prahaaro ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨੇ ਕ੍ਰੋਧ ਵਿਚ ਆ ਕੇ ਤੀਰਾ ਦਾ ਪ੍ਰਹਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "महा काल कुप बान प्रहारो ॥",
      "sourceLineId": "139357",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਿਰਿਯੋ ਕਹਾ ਲੌ ਲਰੈ ਬਿਚਾਰੋ ॥੨੦੯॥",
      "transliteration": "giriyo kahaa lau larai bichaaro ||209||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਵਿਚਾਰਾ ਕਦੋਂ ਤਕ ਲੜਦਾ, (ਆਖਰ) ਡਿਗ ਪਿਆ ॥੨੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "गिरियो कहा लौ लरै बिचारो ॥२०९॥",
      "sourceLineId": "139358",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਹਨੀ ਪਠਾਨੀ ਸੈਨਾ ॥",
      "transliteration": "eeh bidh hanee paThaanee sainaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਪਠਾਨੀ ਸੈਨਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "इह बिधि हनी पठानी सैना ॥",
      "sourceLineId": "139359",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮੁਗਲਨ ਪਰਾ ਮਧਿ ਕਛੁ ਭੈ ਨਾ ॥",
      "transliteration": "mugalan paraa madh kachh bhai naa ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮੁਗ਼ਲ ਸੈਨਾ ਵਿਚ ਅਜੇ ਕੋਈ ਡਰ ਪੈਦਾ ਨਾ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "मुगलन परा मधि कछु भै ना ॥",
      "sourceLineId": "139360",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਛਿਨਕਿਕ ਮੋ ਬਹੁ ਸੁਭਟ ਗਿਰਾਏ ॥",
      "transliteration": "chhinakik mo bahu subhaT giraae ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਛਿਣ ਵਿਚ ਬਹੁਤ ਸਾਰੇ ਸੂਰਮੇ ਡਿਗਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "छिनकिक मो बहु सुभट गिराए ॥",
      "sourceLineId": "139361",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾਨੁ ਇੰਦ੍ਰ ਪਰਬਤ ਸੇ ਘਾਏ ॥੨੧੦॥",
      "transliteration": "jaan i(n)dhr parabat se ghaae ||210||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪਤੀਤ ਹੁੰਦਾ ਸੀ) ਮਾਨੋ ਇੰਦਰ ਨੇ ਪਰਬਤਾ ਵਰਗਿਆਂ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ਹੋਵੇ ॥੨੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "जानु इंद्र परबत से घाए ॥२१०॥",
      "sourceLineId": "139362",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬੈਰਮ ਬੇਗ ਮੁਗਲ ਕੌ ਮਾਰਾ ॥",
      "transliteration": "bairam beg mugal kau maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਬੈਰਮ ਬੇਗ ਮੁਗ਼ਲ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "बैरम बेग मुगल कौ मारा ॥",
      "sourceLineId": "139363",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਯੂਸਫ ਖਾ ਕਟਿ ਤੇ ਕਟਿ ਡਾਰਾ ॥",
      "transliteration": "yoosaf khaa kaT te kaT ddaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਯੂਸਫ਼ ਖ਼ਾਨ ਨੂੰ ਲਕ ਤੋਂ ਕਟ ਸੁਟਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "यूसफ खा कटि ते कटि डारा ॥",
      "sourceLineId": "139364",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਾਹਿਰ ਬੇਗ ਟਿਕਾ ਸੰਗ੍ਰਾਮਾ ॥",
      "transliteration": "taahir beg Tikaa sa(n)graamaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾਹਿਰ ਬੇਗ (ਕੁਝ ਸਮੇਾਂ ਲਈ) ਯੁੱਧ ਖੇਤਰ ਵਿਚ ਟਿਕਿਆ ਰਿਹਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "ताहिर बेग टिका संग्रामा ॥",
      "sourceLineId": "139365",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅੰਤ ਗਿਰਿਯੋ ਭਿਰਿ ਕੈ ਦ੍ਵੈ ਜਾਮਾ ॥੨੧੧॥",
      "transliteration": "a(n)t giriyo bhir kai dhavai jaamaa ||211||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਫਿਰ ਦੋ ਪਹਿਰ ਲੜ ਕੇ ਡਿਗ ਪਿਆ ॥੨੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "अंत गिरियो भिरि कै द्वै जामा ॥२११॥",
      "sourceLineId": "139366",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨੂਰਮ ਬੇਗ ਬਹੁਰਿ ਰਿਸਿ ਮਾਰਿਯੋ ॥",
      "transliteration": "nooram beg bahur ris maariyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਰੋਹ ਵਿਚ ਆ ਕੇ ਨੂਰਮ ਬੇਗ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "नूरम बेग बहुरि रिसि मारियो ॥",
      "sourceLineId": "139367",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਦਿਲ ਬੇਗਹਿ ਬਹੁਰਿ ਪ੍ਰਜਾਰਿਯੋ ॥",
      "transliteration": "aadhil begeh bahur prajaariyo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਗਰੋਂ ਆਦਿਲ ਬੇਗ ਨੂੰ ਸਾੜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "आदिल बेगहि बहुरि प्रजारियो ॥",
      "sourceLineId": "139368",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤ੍ਰਾਸਿਤ ਭਈ ਮਲੇਛੀ ਸੈਨਾ ॥",
      "transliteration": "traasit bhiee malechhee sainaa ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ) ਮਲੇਛ ਸੈਨਾ ਡਰ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "त्रासित भई मलेछी सैना ॥",
      "sourceLineId": "139369",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਯੁਧ ਸਕਾ ਹਾਥ ਕੋਈ ਲੈ ਨਾ ॥੨੧੨॥",
      "transliteration": "aayudh sakaa haath koiee lai naa ||212||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕੋਈ ਵੀ ਹੱਥ ਵਿਚ ਸ਼ਸਤ੍ਰ ਨਾ ਸੰਭਾਲ ਸਕਿਆ ॥੨੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "आयुध सका हाथ कोई लै ना ॥२१२॥",
      "sourceLineId": "139370",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭਜੇ ਪਠਾਨ ਮੁਗਲ ਹੂੰ ਭਾਜੇ ॥",
      "transliteration": "bhaje paThaan mugal hoo(n) bhaaje ||",
      "translation": "",
      "punjabiViakhya": "ਪਠਾਨ ਭਜ ਗਏ ਅਤੇ ਮੁਗ਼ਲ ਵੀ ਦੌੜ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "भजे पठान मुगल हूँ भाजे ॥",
      "sourceLineId": "139371",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੈਯਦ ਆਨਿ ਦਸੌ ਦਿਸਿ ਗਾਜੇ ॥",
      "transliteration": "saiyadh aan dhasau dhis gaaje ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਪਿਛੋਂ) ਦਸਾ ਪਾਸਿਆਂ ਤੋਂ ਸੱਯਦ ਆਣ ਗਜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "सैयद आनि दसौ दिसि गाजे ॥",
      "sourceLineId": "139372",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਫਿਰੇ ਪਠਾਨ ਬਿਮਨ ਜੇ ਭਏ ॥",
      "transliteration": "fire paThaan biman je bhe ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਉਦਾਸ ਹੋਏ ਪਠਾਨ ਪਰਤ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "फिरे पठान बिमन जे भए ॥",
      "sourceLineId": "139373",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਹੁਰਿ ਧਨੁਖ ਟੰਕੋਰਤ ਗਏ ॥੨੧੩॥",
      "transliteration": "bahur dhanukh Ta(n)korat ge ||213||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਧਨੁਸ਼ਾ ਨੂੰ ਟੰਕਾਰਨ ਲਗੇ ॥੨੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "बहुरि धनुख टंकोरत गए ॥२१३॥",
      "sourceLineId": "139374",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਵਤ ਹੀ ਹੁਸੈਨ ਖਾ ਜੂਝਾ ॥",
      "transliteration": "aavat hee husain khaa joojhaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਉਾਂਦਿਆਂ ਹੀ ਹੁਸੈਨ ਖ਼ਾਨ ਜੂਝ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "आवत ही हुसैन खा जूझा ॥",
      "sourceLineId": "139375",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਸਨ ਖਾਨ ਸਨਮੁਖ ਹ੍ਵੈ ਲੂਝਾ ॥",
      "transliteration": "hasan khaan sanamukh havai loojhaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਸਨ ਖ਼ਾਨ ਸਾਹਮਣੇ ਡਟ ਕੇ ਮਾਰਿਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "हसन खान सनमुख ह्वै लूझा ॥",
      "sourceLineId": "139376",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਹੁਰਿ ਮੁਹੰਮਦ ਖਾ ਲਰਿ ਮਰਿਯੋ ॥",
      "transliteration": "bahur muha(n)madh khaa lar mariyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਮੁਹੰਮਦ ਖ਼ਾਨ ਲੜ ਕੇ ਮਾਰਿਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "बहुरि मुहंमद खा लरि मरियो ॥",
      "sourceLineId": "139377",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1373_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਾਨਕ ਸਲਭ ਦੀਪ ਮਹਿ ਪਰਿਯੋ ॥੨੧੪॥",
      "transliteration": "jaanak salabh dheep meh pariyo ||214||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਪਤੰਗਾ ਦੀਪਕ ਉਪਰ ਡਿਗ ਪਿਆ ਹੋਵੇ ॥੨੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1373,
      "hindi": "",
      "hindiTransliteration": "जानक सलभ दीप महि परियो ॥२१४॥",
      "sourceLineId": "139378",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
