{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1374,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1374_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੈਦ ਹੁਸੈਨ ਕੋਪ ਕਰਿ ਗਰਜੋ ॥",
      "transliteration": "saidh husain kop kar garajo ||",
      "translation": "",
      "punjabiViakhya": "ਸੱਯਦ ਹੁਸੈਨ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਗਜਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "सैद हुसैन कोप करि गरजो ॥",
      "sourceLineId": "139379",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾਫਰ ਸੈਦ ਰਹਾ ਨਹਿ ਬਰਜੋ ॥",
      "transliteration": "jaafar saidh rahaa neh barajo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਾਫ਼ਰ ਸੱਯਦ ਵੀ ਰੋਕਿਆਂ ਰੁਕ ਨਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "जाफर सैद रहा नहि बरजो ॥",
      "sourceLineId": "139380",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਲੋਹ ਪ੍ਰਜੰਤ ਬਾਨ ਤਨਿ ਮਾਰੇ ॥",
      "transliteration": "loh praja(n)t baan tan maare ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਲੋਹੇ (ਦੇ ਕਵਚ) ਤਕ ਬਾਣ ਮਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "लोह प्रजंत बान तनि मारे ॥",
      "sourceLineId": "139381",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਏ ਲੀਨ ਨਹਿ ਬਹੁਰਿ ਨਿਹਾਰੇ ॥੨੧੫॥",
      "transliteration": "bhe leen neh bahur nihaare ||215||",
      "translation": "",
      "punjabiViakhya": "ਜੋ (ਉਨ੍ਰਹਾ ਦੇ ਸ਼ਰੀਰਾ ਵਿਚ) ਹੀ ਖੁਭ ਗਏ, ਫਿਰ ਵਿਖਾਈ ਨਾ ਦਿੱਤੇ ॥੨੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "भए लीन नहि बहुरि निहारे ॥२१५॥",
      "sourceLineId": "139382",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਹੁਰੋ ਅਮਿਤ ਕੋਪ ਕਹ ਕਰਿ ਕੈ ॥",
      "transliteration": "bahuro amit kop keh kar kai ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਬਹੁਤ ਅਧਿਕ ਕ੍ਰੋਧ ਕਰ ਕੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "बहुरो अमित कोप कह करि कै ॥",
      "sourceLineId": "139383",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਛਾਡੇ ਬਿਸਿਖ ਧਨੁਖ ਕੌ ਧਰਿ ਕੈ ॥",
      "transliteration": "chhaadde bisikh dhanukh kau dhar kai ||",
      "translation": "",
      "punjabiViakhya": "ਧਨੁਸ਼ ਉਤੇ ਚੜ੍ਰਹਾ ਕੇ ਬਾਣ ਛਡੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "छाडे बिसिख धनुख कौ धरि कै ॥",
      "sourceLineId": "139384",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਛੂਟਤ ਭਏ ਸਲਭ ਕੀ ਜਿਮਿ ਸਰ ॥",
      "transliteration": "chhooTat bhe salabh kee jim sar ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਤੀਰ ਪਤੰਗਿਆਂ ਵਾਗ ਛੂਟੇ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "छूटत भए सलभ की जिमि सर ॥",
      "sourceLineId": "139385",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਲੀਨ ਭਏ ਨਹਿ ਲਖੇ ਦ੍ਰਿਗਨ ਕਰਿ ॥੨੧੬॥",
      "transliteration": "leen bhe neh lakhe dhiragan kar ||216||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਅਜਿਹੇ ਖੁਭੇ ਕਿ ਅੱਖਾ ਨਾਲ ਵੇਖੇ ਨਾ ਜਾ ਸਕੇ ॥੨੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "लीन भए नहि लखे दृगन करि ॥२१६॥",
      "sourceLineId": "139386",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਮਾਰਿ ਸੈਯਦੀ ਸੈਨਾ ॥",
      "transliteration": "eeh bidh maar saiyadhee sainaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਸੱਯਦਾ ਦੀ ਫ਼ੌਜ ਮਾਰੀ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "इह बिधि मारि सैयदी सैना ॥",
      "sourceLineId": "139387",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੇਖ ਫੌਜ ਭਾਜੀ ਬਿਨੁ ਚੈਨਾ ॥",
      "transliteration": "sekh fauaj bhaajee bin chainaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ੇਖਾ ਦੀ ਸੈਨਾ ਬੇਚੈਨ ਹੋ ਕੇ ਭਜ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "सेख फौज भाजी बिनु चैना ॥",
      "sourceLineId": "139388",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਜਬ ਭਜੇ ਨਿਹਾਰੇ ॥",
      "transliteration": "mahaa kaal jab bhaje nihaare ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨੇ ਜਦ ਉਨ੍ਰਹਾ ਨੂੰ ਭਜਦਿਆਂ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "महा काल जब भजे निहारे ॥",
      "sourceLineId": "139389",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਿਸਿਖ ਕੋਪ ਨਹਿ ਤਾਹਿ ਪ੍ਰਹਾਰੇ ॥੨੧੭॥",
      "transliteration": "bisikh kop neh taeh prahaare ||217||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਰੋਹ ਵਿਚ ਆ ਕੇ ਉਨ੍ਰਹਾ ਉਤੇ ਬਾਣ ਨਾ ਚਲਾਏ ॥੨੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "बिसिख कोप नहि ताहि प्रहारे ॥२१७॥",
      "sourceLineId": "139390",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਹੁਰੌ ਭਿਰੇ ਸੇਖ ਭਰਿ ਲਾਜਾ ॥",
      "transliteration": "bahurau bhire sekh bhar laajaa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੇਖ ਸੈਨਿਕ ਲਾਜ ਦੇ ਮਾਰੇ ਫਿਰ ਲੜਨ ਲਗੇ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "बहुरौ भिरे सेख भरि लाजा ॥",
      "sourceLineId": "139391",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਲੈ ਲੈ ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਸਭ ਸਾਜਾ ॥",
      "transliteration": "lai lai sasatr asatr sabh saajaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਸਤ੍ਰਾ ਸ਼ਸਤ੍ਰਾ ਆਦਿ ਨੂੰ ਲੈ ਕੇ ਸੁਸਜਿਤ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "लै लै ससत्र असत्र सभ साजा ॥",
      "sourceLineId": "139392",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਮਿ ਮ੍ਰਿਗ ਬਧ ਮ੍ਰਿਗਪਤਿ ਕੌ ਤਕਹੀ ॥",
      "transliteration": "jim mirag badh miragapat kau takahee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਹਿਰਨ ਨੂੰ ਮਾਰਨ ਵਾਲਾ ਸ਼ੇਰ ਨੂੰ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "जिमि मृग बध मृगपति कौ तकही ॥",
      "sourceLineId": "139393",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਝਖਿ ਝਖਿ ਗਿਰਤ ਮਾਰਿ ਨਹਿ ਸਕਹੀ ॥੨੧੮॥",
      "transliteration": "jhakh jhakh girat maar neh sakahee ||218||",
      "translation": "",
      "punjabiViakhya": "ਝਖ ਮਾਰਦਾ ਹੋਇਆ ਡਿਗ ਪੈਂਦਾ ਹੈ ਅਤੇ ਮਾਰ ਨਹੀਂ ਸਕਦਾ ॥੨੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "झखि झखि गिरत मारि नहि सकही ॥२१८॥",
      "sourceLineId": "139394",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੇਖ ਫਰੀਦ ਹਨਾ ਤਤਕਾਲਾ ॥",
      "transliteration": "sekh fareedh hanaa tatakaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੇਖ ਫ਼ਰੀਦ ਨੂੰ ਉਸੇ ਵੇਲੇ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "सेख फरीद हना ततकाला ॥",
      "sourceLineId": "139395",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੇਖ ਉਜੈਨ ਹਨਾ ਬਿਕਰਾਲਾ ॥",
      "transliteration": "sekh ujain hanaa bikaraalaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਿਆਨਕ ਸ਼ੇਖ ਉਜੈਨ ਨੂੰ ਵੀ ਖ਼ਤਮ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "सेख उजैन हना बिकराला ॥",
      "sourceLineId": "139396",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੇਖ ਅਮਾਨੁਲਹ ਪੁਨਿ ਮਾਰਿਯੋ ॥",
      "transliteration": "sekh amaanuleh pun maariyo ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸ਼ੇਖ ਅਮਾਨੁੱਲਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "सेख अमानुलह पुनि मारियो ॥",
      "sourceLineId": "139397",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੇਖ ਵਲੀ ਕੋ ਸੈਨ ਸੰਘਾਰਿਯੋ ॥੨੧੯॥",
      "transliteration": "sekh valee ko sain sa(n)ghaariyo ||219||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸ਼ੇਖ ਵਲੀ ਦੀ ਸੈਨਾ ਨੂੰ ਨਸ਼ਟ ਕਰ ਦਿੱਤਾ ॥੨੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "सेख वली को सैन संघारियो ॥२१९॥",
      "sourceLineId": "139398",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਿਲ ਤਿਲ ਪਾਇ ਸੁਭਟ ਕਹੂੰ ਕਰੇ ॥",
      "transliteration": "til til pai subhaT kahoo(n) kare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਮਿਆਂ ਨੂੰ ਤਿਲ ਤਿਲ ਕਰ ਕੇ ਸੁਟ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "तिल तिल पाइ सुभट कहूँ करे ॥",
      "sourceLineId": "139399",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚਰਮ ਬਰਮ ਰਨ ਮੋ ਕਹੂੰ ਝਰੇ ॥",
      "transliteration": "charam baram ran mo kahoo(n) jhare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਢਾਲਾ ('ਚਰਮ') ਅਤੇ ਕਵਚ ('ਬਰਮ') ਰਣ ਵਿਚ ਖਿਲਰ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "चरम बरम रन मो कहूँ झरे ॥",
      "sourceLineId": "139400",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਖਿ ਭਖਿ ਉਠੈ ਸੁਭਟ ਕਹੂੰ ਕ੍ਰੁਧਾ ॥",
      "transliteration": "bhakh bhakh uThai subhaT kahoo(n) krudhaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਅਜਿਹਾ ਹੈਬਤਨਾਕ ਯੁੱਧ ਮਚਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "भखि भखि उठै सुभट कहूँ क्रुधा ॥",
      "sourceLineId": "139401",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦਾਰੁਣ ਮਚਿਯੋ ਐਸ ਤਹ ਜੁਧਾ ॥੨੨੦॥",
      "transliteration": "dhaarun machiyo aais teh judhaa ||220||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਸੂਰਮਿਆਂ ਨੂੰ ਕ੍ਰੋਧ ਭਖਾ ਭਖਾ ਕੇ ਉਠਾ ਦਿੰਦਾ ਸੀ ॥੨੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "दारुण मचियो ऐस तह जुधा ॥२२०॥",
      "sourceLineId": "139402",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਹੂੰ ਕਬੰਧ ਫਿਰਤ ਸਿਰ ਬਿਨਾ ॥",
      "transliteration": "kahoo(n) kaba(n)dh firat sir binaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸਿਰ ਤੋਂ ਬਿਨਾ ਧੜ ਘੁੰਮ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "कहूँ कबंध फिरत सिर बिना ॥",
      "sourceLineId": "139403",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਹੂੰ ਸੁਭਟ ਗਹਿ ਦਾਤਨ ਤ੍ਰਿਨਾ ॥",
      "transliteration": "kahoo(n) subhaT geh dhaatan tiranaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਸੂਰਮਿਆਂ ਨੇ ਦੰਦਾ ਵਿਚ ਘਾਹ ਪਕੜਿਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "कहूँ सुभट गहि दातन तृना ॥",
      "sourceLineId": "139404",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਛ ਰਛ ਕਹਿ ਤਾਹਿ ਪੁਕਾਰੈ ॥",
      "transliteration": "rachh rachh keh taeh pukaarai ||",
      "translation": "",
      "punjabiViakhya": "(ਅਰਥਾਤ-ਈਨ ਮੰਨ ਰਹੇ ਸਨ)। ਉਹ 'ਬਚਾ ਲਓ, ਬਚਾ ਲਓ' ਦੀ ਪੁਕਾਰ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "रछ रछ कहि ताहि पुकारै ॥",
      "sourceLineId": "139405",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਜਿਨਿ ਹਮੈ ਸੰਘਾਰੈ ॥੨੨੧॥",
      "transliteration": "mahaa kaal jin hamai sa(n)ghaarai ||221||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨੂੰ ਕਹਿ ਰਹੇ ਸਨ ਕਿ ਸਾਨੂੰ ਨਾ ਮਾਰਿਓ ॥੨੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "महा काल जिनि हमै संघारै ॥२२१॥",
      "sourceLineId": "139406",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਹੂੰ ਆਨਿ ਡਾਕਿਨਿ ਡਹਕਾਰੈ ॥",
      "transliteration": "kahoo(n) aan ddaakin ddahakaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਡਾਕਣੀਆਂ ਆ ਕੇ 'ਡਹ ਡਹ' ਕਰ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "कहूँ आनि डाकिनि डहकारै ॥",
      "sourceLineId": "139407",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹੂੰ ਮਸਾਨ ਕਿਲਕਟੀ ਮਾਰੈ ॥",
      "transliteration": "kahoo(n) masaan kilakaTee maarai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ 'ਮਸਾਨ' (ਪ੍ਰੇਤ) ਕਿਲਕਾਰੀਆਂ ਮਾਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "कहूँ मसान किलकटी मारै ॥",
      "sourceLineId": "139408",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭੂਤ ਪਿਸਾਚ ਨਚੇ ਬੈਤਾਲਾ ॥",
      "transliteration": "bhoot pisaach nache baitaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭੂਤ, ਪਿਸ਼ਾਚ ਅਤੇ ਬੈਤਾਲ ਨਚ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "भूत पिसाच नचे बैताला ॥",
      "sourceLineId": "139409",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਰਤ ਫਿਰਤ ਬੀਰਨ ਕਹ ਬਾਲਾ ॥੨੨੨॥",
      "transliteration": "barat firat beeran keh baalaa ||222||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਮਿਆਂ ਨੂੰ ਅਪੱਛਰਾਵਾ ਵਰ ਰਹੀਆਂ ਸਨ ॥੨੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "बरत फिरत बीरन कह बाला ॥२२२॥",
      "sourceLineId": "139410",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਏਕੈ ਅਛ ਏਕ ਹੀ ਬਾਹਾ ॥",
      "transliteration": "ekai achh ek hee baahaa ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਸੇ ਸੂਰਮੇ ਦੀ) ਇਕ ਅੱਖ ਸੀ ਅਤੇ ਕਿਸੇ ਦੀ ਇਕ ਹੀ ਬਾਹ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "एकै अछ एक ही बाहा ॥",
      "sourceLineId": "139411",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਏਕ ਚਰਨ ਅਰੁ ਅਰਧ ਸਨਾਹਾ ॥",
      "transliteration": "ek charan ar aradh sanaahaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਸੇ ਦਾ ਇਕ ਪੈਰ ਸੀ ਅਤੇ ਅੱਧਾ ਕਵਚ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "एक चरन अरु अरध सनाहा ॥",
      "sourceLineId": "139412",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸੁਭਟ ਬਿਕਟ ਹਨਿ ਡਾਰੇ ॥",
      "transliteration": "eeh bidh subhaT bikaT han ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਭਿਆਨਕ ਸੂਰਮੇ ਮਾਰ ਸੁਟੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "इह बिधि सुभट बिकट हनि डारे ॥",
      "sourceLineId": "139413",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪਵਨ ਬਲੀ ਜਨੁ ਰੂਖ ਉਖਾਰੇ ॥੨੨੩॥",
      "transliteration": "pavan balee jan rookh ukhaare ||223||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਤੇਜ਼ ਹਵਾ ਨੇ ਬ੍ਰਿਛ ਉਖਾੜ ਦਿੱਤੇ ਹੋਣ ॥੨੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "पवन बली जनु रूख उखारे ॥२२३॥",
      "sourceLineId": "139414",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਹ ਅਰਿ ਕਾਲ ਕ੍ਰਿਪਾਨ ਬਹੀ ਸਿਰ ॥",
      "transliteration": "jeh ar kaal kirapaan bahee sir ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵੈਰੀ ਦੇ ਸਿਰ ਉਤੇ ਕਾਲ ਦੀ ਕ੍ਰਿਪਾਨ ਵਜੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "जिह अरि काल कृपान बही सिर ॥",
      "sourceLineId": "139415",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਿਨ ਕੇ ਰਹੀ ਨ ਜੀਵ ਕਰਾ ਫਿਰਿ ॥",
      "transliteration": "tin ke rahee na jeev karaa fir ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਵਿਚ ਫਿਰ ਜੀਵਨ-ਸ਼ਕਤੀ ('ਜੀਵਕਰਾ' ਜੀਵਨ-ਕਲਾ) ਨਾ ਰਹੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "तिन के रही न जीव करा फिरि ॥",
      "sourceLineId": "139416",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾ ਕਹ ਕਾਲ ਖੜਗ ਛ੍ਵੈ ਗਯਾ ॥",
      "transliteration": "jaa keh kaal khaRag chhavai gayaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਕਾਲ ਦੀ ਤਲਵਾਰ ਛੋਹ ਵੀ ਗਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "जा कह काल खड़ग छ्वै गया ॥",
      "sourceLineId": "139417",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਰਧੈ ਅਰਧ ਛਿਨਿਕ ਮਹਿ ਭਯਾ ॥੨੨੪॥",
      "transliteration": "aradhai aradh chhinik meh bhayaa ||224||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਛਿਣ ਭਰ ਵਿਚ ਅਧੋ ਅੱਧ ਹੋ ਗਿਆ ॥੨੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "अरधै अरध छिनिक महि भया ॥२२४॥",
      "sourceLineId": "139418",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਹੀ ਜਾਹਿ ਸਿਰ ਸਰਕਿ ਸਰੋਹੀ ॥",
      "transliteration": "bahee jaeh sir sarak sarohee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸਿਰ ਉਤੇ 'ਸਰਕ' ਕਰਦੀ ਤਲਵਾਰ ਵਜ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "बही जाहि सिर सरकि सरोही ॥",
      "sourceLineId": "139419",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਾ ਕਾ ਰਹਾ ਸੀਸੁ ਹ੍ਵੈ ਦੋਹੀ ॥",
      "transliteration": "taa kaa rahaa sees havai dhohee ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਉਸ ਦਾ ਸਿਰ ਦੋ ਟੋਟੇ ਹੋ ਕੇ ਰਹਿ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "ता का रहा सीसु ह्वै दोही ॥",
      "sourceLineId": "139420",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾ ਕੌ ਬਾਨ ਕਾਲ ਕਾ ਲਾਗਾ ॥",
      "transliteration": "jaa kau baan kaal kaa laagaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਕਾਲ ਦਾ ਬਾਣ ਲਗ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "जा कौ बान काल का लागा ॥",
      "sourceLineId": "139421",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾ ਕੇ ਪ੍ਰਾਨ ਬਾਨ ਲੈ ਭਾਗਾ ॥੨੨੫॥",
      "transliteration": "taa ke praan baan lai bhaagaa ||225||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦੇ ਪ੍ਰਾਣ ਨੂੰ ਬਾਣ ਲੈ ਕੇ ਭਜ ਗਿਆ ॥੨੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "ता के प्रान बान लै भागा ॥२२५॥",
      "sourceLineId": "139422",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਾਰੂ ਬਜਤ ਦੋਊ ਦਿਸਿ ਐਸੋ ॥",
      "transliteration": "maaroo bajat dhouoo dhis aaiso ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਪਾਸਿਆਂ ਵਿਚ ਮਾਰੂ ਨਗਾਰੇ ਇਸ ਤਰ੍ਰਹਾ ਵਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "मारू बजत दोऊ दिसि ऐसो ॥",
      "sourceLineId": "139423",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਾਨੁਕ ਪ੍ਰਲੈ ਕਾਲ ਕੇ ਐਸੇ ॥",
      "transliteration": "jaanuk pralai kaal ke aaise ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਪਰਲੋ ਕਾਲ ਵਿਚ ਵਜਣ ਵਾਲਿਆਂ ਵਰਗੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "जानुक प्रलै काल के ऐसे ॥",
      "sourceLineId": "139424",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੋਮੁਖ ਝਾਝਰ ਤੂਰ ਅਪਾਰਾ ॥",
      "transliteration": "gomukh jhaajhar toor apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਗੋਮੁਖ, ਝਾਝਰ, ਤੁਰੀਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "गोमुख झाझर तूर अपारा ॥",
      "sourceLineId": "139425",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਢੋਲ ਮ੍ਰਿਦੰਗ ਮੁਚੰਗ ਹਜਾਰਾ ॥੨੨੬॥",
      "transliteration": "ddol miradha(n)g mucha(n)g hajaaraa ||226||",
      "translation": "",
      "punjabiViakhya": "ਢੋਲ, ਮ੍ਰਿਦੰਗ, ਮੁਚੰਗ ਆਦਿ ਹਜ਼ਾਰਾ ਦੀ ਗਿਣਤੀ ਵਿਚ (ਵਜ ਰਹੇ) ਸਨ ॥੨੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "ढोल मृदंग मुचंग हजारा ॥२२६॥",
      "sourceLineId": "139426",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਘੋਰ ਆਯੁਧਨ ਇਹ ਬਿਧਿ ਭਯੋ ॥",
      "transliteration": "ghor aayudhan ieh bidh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਘੋਰ ਯੁੱਧ ਹੋਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "घोर आयुधन इह बिधि भयो ॥",
      "sourceLineId": "139427",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਹ ਕੋ ਪਾਰ ਨ ਕਿਨਹੂੰ ਲਯੋ ॥",
      "transliteration": "jeh ko paar na kinahoo(n) layo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਕੋਈ ਵੀ ਅੰਤ ਨਾ ਪਾ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "जिह को पार न किनहूँ लयो ॥",
      "sourceLineId": "139428",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜੇਤਿਕ ਅਸੁਰ ਮਲੇਛੁਪਜਾਏ ॥",
      "transliteration": "jetik asur malechhupajaae ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤਾ ਨੇ ਜਿਤਨੇ ਵੀ ਮਲੇਛ (ਮੁਗ਼ਲ) ਪੈਦਾ ਕੀਤੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "जेतिक असुर मलेछुपजाए ॥",
      "sourceLineId": "139429",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਛਿਨ ਬੀਚ ਖਪਾਏ ॥੨੨੭॥",
      "transliteration": "mahaa kaal chhin beech khapaae ||227||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨੇ ਉਨ੍ਰਹਾ ਨੂੰ ਛਿਣ ਵਿਚ ਖਪਾ ਦਿੱਤਾ ॥੨੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "महा काल छिन बीच खपाए ॥२२७॥",
      "sourceLineId": "139430",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬਹੁਰਿ ਅਸੁਰ ਕ੍ਰੁਧਤ ਅਤਿ ਭਯੋ ॥",
      "transliteration": "bahur asur krudhat at bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤ ਫਿਰ ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "बहुरि असुर क्रुधत अति भयो ॥",
      "sourceLineId": "139431",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਅਮਿਤ ਅਸੁਰ ਉਪਰਾਜਿ ਸੁ ਲਯੋ ॥",
      "transliteration": "amit asur uparaaj su layo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਹੋਰ ਅਨੰਤ ਦੈਂਤ ਪੈਦਾ ਕਰ ਲਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "अमित असुर उपराजि सु लयो ॥",
      "sourceLineId": "139432",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਧੂਲੀ ਕਰਨ ਬਿਦਿਤ ਕੇਸੀ ਭਨ ॥",
      "transliteration": "dhoolee karan bidhit kesee bhan ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਵਿਚ) ਧੂਲੀ ਕਰਨ, ਕੇਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "धूली करन बिदित केसी भन ॥",
      "sourceLineId": "139433",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਘੋਰ ਦਾੜ ਅਰੁ ਸ੍ਰੋਨਤ ਲੋਚਨ ॥੨੨੮॥",
      "transliteration": "ghor dhaaR ar sronat lochan ||228||",
      "translation": "",
      "punjabiViakhya": "ਘੋਰ ਦਾੜ੍ਰਹ ਅਤੇ ਸ੍ਰੋਨਤ ਲੋਚਨ ਸ਼ਾਮਲ ਦਸੇ ਜਾਦੇ ਸਨ ॥੨੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "घोर दाड़ अरु स्रोनत लोचन ॥२२८॥",
      "sourceLineId": "139434",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗਰਧਬ ਕੇਤੁ ਮਹਿਖ ਧੁਜ ਨਾਮਾ ॥",
      "transliteration": "garadhab ket mahikh dhuj naamaa ||",
      "translation": "",
      "punjabiViakhya": "ਗਰਧਬ ਕੇਤੁ, ਮਹਿਖ ਧੁਜ,",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "गरधब केतु महिख धुज नामा ॥",
      "sourceLineId": "139435",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਅਰੁਨ ਨੇਤ੍ਰ ਉਪਜਾ ਸੰਗ੍ਰਾਮਾ ॥",
      "transliteration": "arun netr upajaa sa(n)graamaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਰੁਨ ਨੇਤ੍ਰ ਨਾ (ਦੇ ਦੈਂਤ) ਯੁੱਧ ਵਿਚ ਪੈਦਾ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "अरुन नेत्र उपजा संग्रामा ॥",
      "sourceLineId": "139436",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਅਸਿਧੁਜ ਨਿਰਖਿ ਅਸੁਰ ਉਪਜੇ ਰਨ ॥",
      "transliteration": "asidhuj nirakh asur upaje ran ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਰਣ ਵਿਚ ਪੈਦਾ ਹੁੰਦਿਆਂ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "असिधुज निरखि असुर उपजे रन ॥",
      "sourceLineId": "139437",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਮਾਰਤ ਭਯੋ ਦਾਨਵਨ ਕੇ ਗਨ ॥੨੨੯॥",
      "transliteration": "maarat bhayo dhaanavan ke gan ||229||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ('ਅਸਿਧੁਜ') ਨੇ ਦੈਂਤਾ ਦੇ ਦਲ ਖਪਾ ਦਿੱਤੇ ॥੨੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "मारत भयो दानवन के गन ॥२२९॥",
      "sourceLineId": "139438",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਅਸਿਧੁਜ ਕੋਪ ਅਧਿਕ ਕਹ ਕਰਾ ॥",
      "transliteration": "asidhuj kop adhik keh karaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਿਧੁਜ ਨੇ ਬਹੁਤ ਕ੍ਰੋਧ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "असिधुज कोप अधिक कह करा ॥",
      "sourceLineId": "139439",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਸੈਨ ਦਾਨਵਨ ਕੋ ਰਨ ਹਰਾ ॥",
      "transliteration": "sain dhaanavan ko ran haraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੈਂਤਾ ਦੀ ਸੈਨਾ ਨੂੰ ਰਣ ਵਿਚ ਹਰ ਲਿਆ (ਅਰਥਾਤ ਮਾਰ ਮੁਕਾਇਆ)।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "सैन दानवन को रन हरा ॥",
      "sourceLineId": "139440",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਸਸਤ੍ਰ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "bhaat bhaat tan sasatr prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਸ਼ਸਤ੍ਰ ਮਾਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन ससत्र प्रहारे ॥",
      "sourceLineId": "139441",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਤਿਲ ਤਿਲ ਪਾਇ ਸੁਭਟ ਕਟਿ ਡਾਰੇ ॥੨੩੦॥",
      "transliteration": "til til pai subhaT kaT ddaare ||230||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਸੂਰਮਿਆਂ ਨੂੰ ਟੋਟੇ ਟੋਟੇ ਕਰ ਦਿੱਤਾ ॥੨੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "तिल तिल पाइ सुभट कटि डारे ॥२३०॥",
      "sourceLineId": "139442",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਹਨੀ ਸੈਨ ਅਸਿਧੁਜ ਜਬ ॥",
      "transliteration": "eeh bidh hanee sain asidhuj jab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਅਸਿਧੁਜ ਨੇ ਇਸ ਤਰ੍ਰਹਾ (ਦੈਂਤ) ਸੈਨਾ ਮਾਰ ਦਿੱਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "इह बिधि हनी सैन असिधुज जब ॥",
      "sourceLineId": "139443",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਕਾਪਤ ਭਯੋ ਅਸੁਰ ਜਿਯ ਮੋ ਤਬ ॥",
      "transliteration": "kaapat bhayo asur jiy mo tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੈਂਤ ਮਨ ਵਿਚ ਕੰਬਣ ਲਗਾ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "कापत भयो असुर जिय मो तब ॥",
      "sourceLineId": "139444",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਅਮਿਤ ਅਸੁਰ ਰਨ ਔਰ ਪ੍ਰਕਾਸੇ ॥",
      "transliteration": "amit asur ran aauar prakaase ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਵਿਚ ਬੇਸ਼ੁਮਾਰ ਦੈਂਤ ਹੋਰ ਪ੍ਰਗਟ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "अमित असुर रन और प्रकासे ॥",
      "sourceLineId": "139445",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਤਿਨ ਕੋ ਕਹਤ ਨਾਮ ਬਿਨੁ ਸਾਸੇ ॥੨੩੧॥",
      "transliteration": "tin ko kahat naam bin saase ||231||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਨਾ (ਹੁਣ ਮੈਂ) ਬਿਨਾ ਸਾਹ ਲਿਆਂ ਕਹਿੰਦਾ ਹਾ (ਅਰਥਾਤ ਲਗਾਤਾਰ ਕਹਿੰਦਾ ਹਾ) ॥੨੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "तिन को कहत नाम बिनु सासे ॥२३१॥",
      "sourceLineId": "139446",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਗੀਧ ਧੁਜਾ ਕਾਕ ਧੁਜ ਰਾਛਸ ॥",
      "transliteration": "geedh dhujaa kaak dhuj raachhas ||",
      "translation": "",
      "punjabiViakhya": "ਗੀਧ ਧੁਜਾ, ਕਾਕ ਧੁਜ ਦੈਂਤ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "गीध धुजा काक धुज राछस ॥",
      "sourceLineId": "139447",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਉਲੂ ਕੇਤੁ ਬੀਯੋ ਬਡ ਰਾਛਸ ॥",
      "transliteration": "auloo ket beeyo badd raachhas ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਉਲੂ ਕੇਤੁ ਨਾ ਦੇ ਵੱਡੇ ਦੈਂਤ ਰਣ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "उलू केतु बीयो बड राछस ॥",
      "sourceLineId": "139448",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਅਸਿਧੁਜ ਕੇ ਰਨ ਸਮੁਹਿ ਸਿਧਾਏ ॥",
      "transliteration": "asidhuj ke ran samuh sidhaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਿਧੁਜ ਦੇ ਸਾਹਮਣੇ ਆ ਕੇ ਡਟੇ",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "असिधुज के रन समुहि सिधाए ॥",
      "sourceLineId": "139449",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1374_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਚਹੂੰ ਓਰ ਉਘਾਏ ॥੨੩੨॥",
      "transliteration": "maar maar chahoo(n) or ughaae ||232||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੌਹਾ ਪਾਸੇ 'ਮਾਰੋ ਮਾਰੋ' ਕਹਿਣ ਲਗੇ ॥੨੩੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1374,
      "hindi": "",
      "hindiTransliteration": "मारि मारि चहूँ ओर उघाए ॥२३२॥",
      "sourceLineId": "139450",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
