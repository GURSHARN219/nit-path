{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1375,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1375_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਿਸਿਖਨ ਬ੍ਰਿਸਟਿ ਕਰੀ ਕੋਪਹਿ ਕਰਿ ॥",
      "transliteration": "bisikhan birasaT karee kopeh kar ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਬਾਣਾ ਦੀ (ਇਸ ਤਰ੍ਰਹਾ) ਬਰਖਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "बिसिखन बृसटि करी कोपहि करि ॥",
      "sourceLineId": "139451",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਲਧਰ ਐਸ ਬਡੇ ਭੂਧਰ ਪਰ ॥",
      "transliteration": "jaladhar aais badde bhoodhar par ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਬਦਲ ਵਡਿਆਂ ਪਹਾੜਾ ਉਤੇ (ਕਰਦੇ ਹਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "जलधर ऐस बडे भूधर पर ॥",
      "sourceLineId": "139452",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਕਰਿ ਕੋਪ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "sasatr asatr kar kop prahaare ||",
      "translation": "",
      "punjabiViakhya": "(ਅਸਿਧੁਜ ਨੇ) ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਸ਼ਸਤ੍ਰਾ ਅਸਤ੍ਰਾ ਦੇ ਵਾਰ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "ससत्र असत्र करि कोप प्रहारे ॥",
      "sourceLineId": "139453",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚਟਪਟ ਸੁਭਟ ਬਿਕਟਿ ਕਟਿ ਡਾਰੇ ॥੨੩੩॥",
      "transliteration": "chaTapaT subhaT bikaT kaT ddaare ||233||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਝਟ ਪਟ ਭਿਆਨਕ ਯੋਧੇ ਕਟ ਸੁਟੇ ॥੨੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "चटपट सुभट बिकटि कटि डारे ॥२३३॥",
      "sourceLineId": "139454",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹੁਅੰ ਸਬਦ ਅਸਿਧੁਜਹਿ ਉਚਾਰਾ ॥",
      "transliteration": "hua(n) sabadh asidhujeh uchaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਅਸਿਧੁਜ ਨੇ 'ਹੁਅੰ' ਸ਼ਬਦ ਉਚਾਰਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "हुअं सबद असिधुजहि उचारा ॥",
      "sourceLineId": "139455",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਿਹ ਤੇ ਆਧਿ ਬ੍ਰਯਾਧਿ ਬਪੁ ਧਾਰਾ ॥",
      "transliteration": "teh te aadh brayaadh bap dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ ਆਧਿ-ਵਿਆਧਿ ਰੋਗਾ ਨੇ ਜਨਮ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "तिह ते आधि ब्रयाधि बपु धारा ॥",
      "sourceLineId": "139456",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੀਤ ਜ੍ਵਰ ਅਰ ਉਸਨ ਤਾਪ ਭਨੇ ॥",
      "transliteration": "seet javair ar usan taap bhane ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਨਾ ਗਿਣਦਾ ਹਾ, ਸੀਤ ਰੋਗ, ਜ੍ਵਰ ਰੋਗ, ਉਸਨ ਤਾਪ,",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "सीत ज्वर अर उसन ताप भने ॥",
      "sourceLineId": "139457",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਛਈ ਰੋਗ ਅਰੁ ਸੰਨ੍ਰਯਪਾਤ ਗਨ ॥੨੩੪॥",
      "transliteration": "chhiee rog ar sa(n)nrayapaat gan ||234||",
      "translation": "",
      "punjabiViakhya": "ਖਈ ਰੋਗ ਅਤੇ ਸੰਨਿ-ਪਾਤ ਰੋਗ ॥੨੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "छई रोग अरु संन्रयपात गन ॥२३४॥",
      "sourceLineId": "139458",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਾਇ ਪਿਤ੍ਰਯ ਕਫ ਉਪਜਤ ਭਏ ॥",
      "transliteration": "bai pitray kaf upajat bhe ||",
      "translation": "",
      "punjabiViakhya": "ਵਾਈ, ਪਿਤ, ਕਫ ਆਦਿ ਰੋਗ ਪੈਦਾ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "बाइ पित्रय कफ उपजत भए ॥",
      "sourceLineId": "139459",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਾ ਤੇ ਭੇਦ ਅਮਿਤ ਹ੍ਵੈ ਗਏ ॥",
      "transliteration": "taa te bhedh amit havai ge ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਉਨ੍ਰਹਾ ਦੇ ਅਗੋਂ ਕਈ ਭੇਦ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "ता ते भेद अमित ह्वै गए ॥",
      "sourceLineId": "139460",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਮ ਤਿਨੈ ਗਨ ਪ੍ਰਗਟ ਸੁਨਾਊ ॥",
      "transliteration": "naam tinai gan pragaT sunaauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਮੈਂ) ਹੁਣ ਉਨ੍ਰਹਾ ਦੇ ਨਾ ਸਪਸ਼ਟ ਸੁਣਾਉਾਂਦਾ ਹਾ",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "नाम तिनै गन प्रगट सुनाऊ ॥",
      "sourceLineId": "139461",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਯੁਰ ਬੇਦਿਯਨ ਸਭਨ ਰਿਝਾਊ ॥੨੩੫॥",
      "transliteration": "ayur bedhiyan sabhan rijhaauoo ||235||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਅਯੁਰਵੇਦੀਆਂ (ਵੈਦਾ) ਨੂੰ ਪ੍ਰਸੰਨ ਕਰਦਾ ਹਾ ॥੨੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "अयुर बेदियन सभन रिझाऊ ॥२३५॥",
      "sourceLineId": "139462",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਮ ਪਾਤ ਅਰ ਸ੍ਰੋਨਤ ਪਾਤ ॥",
      "transliteration": "aam paat ar sronat paat ||",
      "translation": "",
      "punjabiViakhya": "ਇਨ੍ਰਹਾ ਰੋਗਾ ਦੇ ਨਾ ਗਿਣੋ। ਆਮ-ਪਾਤ, ਸ੍ਰੋਨਤ-ਪਾਤ,",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "आम पात अर स्रोनत पात ॥",
      "sourceLineId": "139463",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਰਧ ਸਿਰਾ ਅਰੁ ਹ੍ਰਿਦੈ ਸੰਘਾਤ ॥",
      "transliteration": "aradh siraa ar hiradhai sa(n)ghaat ||",
      "translation": "",
      "punjabiViakhya": "ਅਰਧ-ਸਿਰਾ (ਪੀੜ) ਹ੍ਰਿਦੈ ਸੰਘਾਤ (ਹਿਰਦੇ ਦਾ ਰੁਕਣਾ)",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "अरध सिरा अरु हृदै संघात ॥",
      "sourceLineId": "139464",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪ੍ਰਾਨ ਬਾਇ ਆਪਾਨ ਬਾਇ ਭਨਿ ॥",
      "transliteration": "praan bai aapaan bai bhan ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਾਣ ਵਾਯੂ, ਅਪਾਨ ਵਾਯੂ,",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "प्रान बाइ आपान बाइ भनि ॥",
      "sourceLineId": "139465",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੰਤ ਰੋਗ ਅਰੁ ਦਾੜ ਪੀੜ ਗਨ ॥੨੩੬॥",
      "transliteration": "dha(n)t rog ar dhaaR peeR gan ||236||",
      "translation": "",
      "punjabiViakhya": "ਦੰਤ-ਰੋਗ ਅਤੇ ਦਾੜ੍ਰਹ-ਪੀੜ ॥੨੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "दंत रोग अरु दाड़ पीड़ गन ॥२३६॥",
      "sourceLineId": "139466",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੂਖਾ ਜਰ ਤੇਇਯਾ ਚੌਥਾਯਾ ॥",
      "transliteration": "sookhaa jar teiyaa chauathaayaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਸੋਕਾ, ਤੇਈਆ ਜ੍ਵਰ, ਚੌਥਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "सूखा जर तेइया चौथाया ॥",
      "sourceLineId": "139467",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਸਟ ਦਿਵਸਯੋ ਅਰੁ ਬੀਸਾਯਾ ॥",
      "transliteration": "asaT dhivasayo ar beesaayaa ||",
      "translation": "",
      "punjabiViakhya": "ਅੱਠ ਅਤੇ ਵੀਹ ਦਿਨਾ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "असट दिवसयो अरु बीसाया ॥",
      "sourceLineId": "139468",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਡੇਢ ਮਾਸਿਯਾ ਪੁਨਿ ਤਪ ਭਯੋ ॥",
      "transliteration": "ddedd maasiyaa pun tap bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਡੇਢ ਮਹੀਨੇ ਵਾਲਾ ਬੁਖਾਰ ਹੋਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "डेढ मासिया पुनि तप भयो ॥",
      "sourceLineId": "139469",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦਾਤ ਕਾਢ ਦੈਤਨ ਪਰ ਧਯੋ ॥੨੩੭॥",
      "transliteration": "dhaat kaadd dhaitan par dhayo ||237||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦੰਦ ਕਢ ਕੇ ਦੈਂਤਾ ਉਤੇ ਧਾ ਕੇ ਪਏ ॥੨੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "दात काढ दैतन पर धयो ॥२३७॥",
      "sourceLineId": "139470",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਫੀਲਪਾਵ ਪੁਨਿ ਜਾਨੂ ਰੋਗਾ ॥",
      "transliteration": "feelapaav pun jaanoo rogaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਫੀਲਪਾਵ ਅਤੇ ਗੋਡਿਆਂ ਤੇ ਦਰਦ ਵਾਲੇ ਰੋਗ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "फीलपाव पुनि जानू रोगा ॥",
      "sourceLineId": "139471",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਉਪਜਾ ਦੇਨ ਦੁਸਟ ਦਲ ਸੋਗਾ ॥",
      "transliteration": "aupajaa dhen dhusaT dhal sogaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੁਸ਼ਟਾ ਦੇ ਦਲਾ ਨੂੰ ਕਸ਼ਟ ਦੇਣ ਲਈ ਪੈਦਾ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "उपजा देन दुसट दल सोगा ॥",
      "sourceLineId": "139472",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਖਈ ਸੁ ਬਾਦੀ ਭਈ ਮਵੇਸੀ ॥",
      "transliteration": "khiee su baadhee bhiee mavesee ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤੋਂ ਬਾਦ) ਖਈ, ਬਾਦੀ, ਮਵੇਸੀ (ਬਵਾਸੀਰ)",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "खई सु बादी भई मवेसी ॥",
      "sourceLineId": "139473",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪਾਡ ਰੋਗ ਪੀਨਸ ਕਟਿ ਦੇਸੀ ॥੨੩੮॥",
      "transliteration": "paadd rog peenas kaT dhesee ||238||",
      "translation": "",
      "punjabiViakhya": "ਪਾਡ ਰੋਗ (ਪੀਲੀਆ) ਪੀਨਸ (ਪੁਰਾਣਾ ਜ਼ੁਕਾਮ) ਕਟਿ ਦੇਸੀ (ਲਕ ਦੀ ਪੀੜ) ॥੨੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "पाड रोग पीनस कटि देसी ॥२३८॥",
      "sourceLineId": "139474",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚਿਨਗਿ ਪ੍ਰਮੇਵ ਭਗਿੰਦ੍ਰ ਦਖੂਤ੍ਰਾ ॥",
      "transliteration": "chinag pramev bhagi(n)dhr dhakhootraa ||",
      "translation": "",
      "punjabiViakhya": "ਚਿਨਗ (ਸ਼ਰੀਰ ਵਿਚੋਂ ਚਿਣਗਾ ਨਿਕਲਣ ਵਾਲਾ ਰੋਗ) ਪ੍ਰਮੇਹ, ਭਗਿੰਦ੍ਰ, ਦਖੂਤ੍ਰਾ (ਪਿਸ਼ਾਬ ਬੰਦ ਹੋਣ ਅਥਵਾ ਸੜਨ ਦਾ ਰੋਗ)",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "चिनगि प्रमेव भगिंद्र दखूत्रा ॥",
      "sourceLineId": "139475",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਥਰੀ ਬਾਇ ਫਿਰੰਗ ਅਧਨੇਤ੍ਰਾ ॥",
      "transliteration": "patharee bai fira(n)g adhanetraa ||",
      "translation": "",
      "punjabiViakhya": "ਪਥਰੀ, ਬਾਇ ਫਿਰੰਗ (ਆਤਸ਼ਕ ਦੀ ਇਕ ਕਿਸਮ) ਅਧਨੇਤ੍ਰਾ (ਅੰਧਰਾਤ੍ਰਾ)",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "पथरी बाइ फिरंग अधनेत्रा ॥",
      "sourceLineId": "139476",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਲਤ ਕੁਸਟ ਉਪਜਾ ਦੁਸਟਨ ਤਨ ॥",
      "transliteration": "galat kusaT upajaa dhusaTan tan ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਗਲਿਤ ਕੋਹੜ ਨਾ ਦੇ ਰੋਗ ਦੁਸ਼ਟਾ ਦੇ ਤਨ ਵਿਚ ਪੈਦਾ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "गलत कुसट उपजा दुसटन तन ॥",
      "sourceLineId": "139477",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੇਤ ਕੁਸਟ ਕੇਤਿਨ ਕੇ ਭਯੋ ਭਨ ॥੨੩੯॥",
      "transliteration": "set kusaT ketin ke bhayo bhan ||239||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈਆਂ ਦੇ ਤਨ ਵਿਚ ਸਫ਼ੈਦ ਕੋਹੜ ਹੋ ਗਿਆ ॥੨੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "सेत कुसट केतिन के भयो भन ॥२३९॥",
      "sourceLineId": "139478",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕੇਤੇ ਸਤ੍ਰੁ ਸੂਲ ਹ੍ਵੈ ਮਰੇ ॥",
      "transliteration": "kete satr sool havai mare ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਵੈਰੀ ਸੂਲ ਦੀ ਬੀਮਾਰੀ ਨਾਲ ਮਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "केते सत्रु सूल ह्वै मरे ॥",
      "sourceLineId": "139479",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕੇਤੇ ਆਂਤ ਰੋਗ ਤੇ ਟਰੇ ॥",
      "transliteration": "kete aa(n)t rog te Tare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਆਂਦਰਾ ਦੇ ਰੋਗ ਨਾਲ ਖ਼ਤਮ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "केते आँत रोग ते टरे ॥",
      "sourceLineId": "139480",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੰਗ੍ਰਹਨੀ ਸੰਗ੍ਰਹ ਦੁਸਟ ਕਿਯ ॥",
      "transliteration": "sa(n)grahanee sa(n)greh dhusaT kiy ||",
      "translation": "",
      "punjabiViakhya": "ਕਈਆਂ ਦੁਸ਼ਟਾ ਨੂੰ ਸੰਗ੍ਰਹਿਣੀ ਦੀ ਬੀਮਾਰੀ ਲਗ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "संग्रहनी संग्रह दुसट किय ॥",
      "sourceLineId": "139481",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੀਯਨ ਕੋ ਪੁਨਿ ਨਾਮ ਨ ਤਿਨ ਲਿਯ ॥੨੪੦॥",
      "transliteration": "jeeyan ko pun naam na tin liy ||240||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਫਿਰ ਜੀਣ ਦਾ ਨਾਮ ਨਾ ਲਿਆ ॥੨੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "जीयन को पुनि नाम न तिन लिय ॥२४०॥",
      "sourceLineId": "139482",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੇਤੇ ਉਪਜ ਸੀਤਲਾ ਮਰੇ ॥",
      "transliteration": "kete upaj seetalaa mare ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਸੀਤਲਾ ਦੀ ਬੀਮਾਰੀ ਪੈਦਾ ਹੋਣ ਨਾਲ ਮਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "केते उपज सीतला मरे ॥",
      "sourceLineId": "139483",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕੇਤੇ ਅਗਿਨਿ ਬਾਵ ਤੇ ਜਰੇ ॥",
      "transliteration": "kete agin baav te jare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਵਾਈ ਅਗਨੀ ਨਾਲ ਸੜ ਮੋਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "केते अगिनि बाव ते जरे ॥",
      "sourceLineId": "139484",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਰਮ ਚਿਤ ਕੇਤੇ ਹ੍ਵੈ ਮਰੇ ॥",
      "transliteration": "bharam chit kete havai mare ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ 'ਭਰਮ-ਚਿਤ' (ਰੋਗ) ਨਾਲ ਮਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "भरम चित केते ह्वै मरे ॥",
      "sourceLineId": "139485",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਉਦਰ ਰੋਗ ਕੇਤੇ ਅਰਿ ਟਰੇ ॥੨੪੧॥",
      "transliteration": "audhar rog kete ar Tare ||241||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਵੈਰੀ ਉਦਰ-ਰੋਗ ਨਾਲ ਟਲ ਗਏ ॥੨੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "उदर रोग केते अरि टरे ॥२४१॥",
      "sourceLineId": "139486",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਬ ਅਸਿਧੁਜ ਅਸ ਰੋਗ ਪ੍ਰਕਾਸੇ ॥",
      "transliteration": "jab asidhuj as rog prakaase ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਅਸਿਧੁਜ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਰੋਗਾ ਨੂੰ ਪ੍ਰਗਟ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "जब असिधुज अस रोग प्रकासे ॥",
      "sourceLineId": "139487",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਧਿਕ ਸਤ੍ਰੁ ਤਾਪਤ ਹ੍ਵੈ ਤ੍ਰਾਸੇ ॥",
      "transliteration": "adhik satr taapat havai traase ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਬਹੁਤ ਸਾਰੇ ਵੈਰੀ ਡਰ ਨਾਲ ਦੁਖੀ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "अधिक सत्रु तापत ह्वै त्रासे ॥",
      "sourceLineId": "139488",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾ ਕੇ ਤਨ ਗਨ ਦਈ ਦਿਖਾਈ ॥",
      "transliteration": "jaa ke tan gan dhiee dhikhaiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸ਼ਰੀਰ ਉਤੇ ਕਿਸੇ ਰੋਗ ਨੇ ਵਿਖਾਈ ਦਿੱਤੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "जा के तन गन दई दिखाई ॥",
      "sourceLineId": "139489",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਿਨੌ ਜੀਯਤ ਕੀ ਆਸ ਚੁਕਾਈ ॥੨੪੨॥",
      "transliteration": "tinau jeeyat kee aas chukaiee ||242||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਜੀਣ ਦੀ ਆਸ ਛਡ ਦਿੱਤੀ ॥੨੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "तिनौ जीयत की आस चुकाई ॥२४२॥",
      "sourceLineId": "139490",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕੇਤਿਕ ਦੁਸਟ ਤਾਪ ਤਨ ਤਪੈ ॥",
      "transliteration": "ketik dhusaT taap tan tapai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਦੁਸ਼ਟ ਤਾਪ ਨਾਲ ਤਪ ਗਏ (ਅਰਥਾਤ ਮਰ ਗਏ)",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "केतिक दुसट ताप तन तपै ॥",
      "sourceLineId": "139491",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕੇਤਿਕ ਉਦਰ ਰੋਗ ਹ੍ਵੈ ਖਪੈ ॥",
      "transliteration": "ketik udhar rog havai khapai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਉਦਰ ਰੋਗ ਨਾਲ ਖਪ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "केतिक उदर रोग ह्वै खपै ॥",
      "sourceLineId": "139492",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿਤਕਨ ਆਨਿ ਕਾਪਨੀ ਚਢੀ ॥",
      "transliteration": "kitakan aan kaapanee chaddee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਨੂੰ ਕਾਬਾ ਆਣ ਚੜ੍ਰਹਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "कितकन आनि कापनी चढी ॥",
      "sourceLineId": "139493",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕੇਤਿਕ ਬਾਇ ਪਿਤ ਤਨ ਬਢੀ ॥੨੪੩॥",
      "transliteration": "ketik bai pit tan baddee ||243||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈਆਂ ਦੇ ਸ਼ਰੀਰ ਵਿਚ ਵਾਯੂ ਅਤੇ ਪਿਤ ਵਧ ਗਈ ॥੨੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "केतिक बाइ पित तन बढी ॥२४३॥",
      "sourceLineId": "139494",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਉਦਰ ਬਿਕਾਰ ਕਿਤੇ ਮਰਿ ਗਏ ॥",
      "transliteration": "audhar bikaar kite mar ge ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਪੇਟ ਦੇ ਵਿਕਾਰ ਕਰ ਕੇ ਮਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "उदर बिकार किते मरि गए ॥",
      "sourceLineId": "139495",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਾਪਤਿ ਕਿਤਕ ਤਾਪ ਤਨ ਭਏ ॥",
      "transliteration": "taapat kitak taap tan bhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤਨੇ ਤਾਪ ਨਾਲ ਪੀੜਿਤ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "तापति कितक ताप तन भए ॥",
      "sourceLineId": "139496",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਿਤਕਨ ਸੰਨ੍ਰਯਪਾਤ ਹ੍ਵੈ ਗਯੋ ॥",
      "transliteration": "kitakan sa(n)nrayapaat havai gayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਨੂੰ ਸੰਨਿਪਾਤ ਰੋਗ ਹੋ ਗਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "कितकन संन्रयपात ह्वै गयो ॥",
      "sourceLineId": "139497",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1375_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੇਤਿਨ ਬਾਇ ਪਿਤ ਕਫ ਭਯੋ ॥੨੪੪॥",
      "transliteration": "ketin bai pit kaf bhayo ||244||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤਨਿਆਂ ਨੂੰ ਵਾਯੂ, ਪਿਤ ਅਤੇ ਕਫ਼ ਦੀਆਂ ਬੀਮਾਰੀਆਂ ਲਗ ਗਈਆਂ ॥੨੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1375,
      "hindi": "",
      "hindiTransliteration": "केतिन बाइ पित कफ भयो ॥२४४॥",
      "sourceLineId": "139498",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
