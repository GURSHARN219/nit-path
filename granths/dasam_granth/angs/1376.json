{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1376,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1376_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕੇਤਿਕ ਮਰੇ ਮੂੰਡ ਕੀ ਪੀਰਾ ॥",
      "transliteration": "ketik mare moo(n)dd kee peeraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਸਿਰ ਦੀ ਪੀੜ ਨਾਲ ਮਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "केतिक मरे मूँड की पीरा ॥",
      "sourceLineId": "139499",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਿਤਕ ਬਾਇ ਤੇ ਭਏ ਅਧੀਰਾ ॥",
      "transliteration": "kitak bai te bhe adheeraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਵਾਯੂ ਦੇ ਰੋਗ ਨਾਲ ਅਧੀਰ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "कितक बाइ ते भए अधीरा ॥",
      "sourceLineId": "139500",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕੇਤਿਕ ਛਈ ਰੋਗ ਛੈ ਕਿਯੋ ॥",
      "transliteration": "ketik chhiee rog chhai kiyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਈਆਂ ਨੂੰ ਖਈ ਰੋਗ (ਤਪੇਦਿਕ) ਨੇ ਨਸ਼ਟ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "केतिक छई रोग छै कियो ॥",
      "sourceLineId": "139501",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕੇਤਨ ਨਾਸ ਬਾਇ ਤੇ ਥਿਯੋ ॥੨੪੫॥",
      "transliteration": "ketan naas bai te thiyo ||245||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਵਾਯੂ (ਰੋਗ) ਨਾਲ ਖ਼ਤਮ ਹੋ ਗਏ ॥੨੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "केतन नास बाइ ते थियो ॥२४५॥",
      "sourceLineId": "139502",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦਾੜ ਪੀੜ ਕੇਤੇ ਮਰਿ ਗਏ ॥",
      "transliteration": "dhaaR peeR kete mar ge ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਦਾੜ੍ਰਹ ਦੀ ਪੀੜ ਨਾਲ ਮਰ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "दाड़ पीड़ केते मरि गए ॥",
      "sourceLineId": "139503",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਾਇ ਭਏ ਬਵਰੇ ਕਈ ਭਏ ॥",
      "transliteration": "bai bhe bavare kiee bhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਵਾਯੂ (ਰੋਗ) ਹੋ ਜਾਣ ਕਾਰਨ ਬੋਲੇ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "बाइ भए बवरे कई भए ॥",
      "sourceLineId": "139504",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਿਨ ਕੌ ਆਨਿ ਰੋਗ ਤਨ ਗ੍ਰਾਸਾ ॥",
      "transliteration": "jin kau aan rog tan graasaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਸ਼ਰੀਰ ਨੂੰ ਆ ਕੇ ਰੋਗ ਨੇ ਗ੍ਰਸ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "जिन कौ आनि रोग तन ग्रासा ॥",
      "sourceLineId": "139505",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਾ ਕਾ ਪ੍ਰਾਨ ਦੇਹ ਤਜਿ ਨਾਸਾ ॥੨੪੬॥",
      "transliteration": "taa kaa praan dheh taj naasaa ||246||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਪ੍ਰਾਣ ਸ਼ਰੀਰ ਨੂੰ ਛਡ ਕੇ ਭਜ ਗਿਆ ॥੨੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "ता का प्रान देह तजि नासा ॥२४६॥",
      "sourceLineId": "139506",
      "sourceShabadId": "12783",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "139507",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਹਾ ਲਗੇ ਮੈ ਬਰਨ ਸੁਨਾਊ ॥",
      "transliteration": "kahaa lage mai baran sunaauoo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਥੋਂ ਤਕ ਮੈਂ ਵਰਣਨ ਕਰ ਕੇ ਸੁਣਾਵਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "कहा लगे मै बरन सुनाऊ ॥",
      "sourceLineId": "139508",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗ੍ਰੰਥ ਬਢਨ ਤੇ ਅਤਿ ਡਰਪਾਊ ॥",
      "transliteration": "gra(n)th baddan te at ddarapaauoo ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਉਾਂਕਿ) ਗ੍ਰੰਥ ਦੇ ਵੱਡਾ ਹੋ ਜਾਣ ਤੋਂ ਡਰਦਾ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "ग्रंथ बढन ते अति डरपाऊ ॥",
      "sourceLineId": "139509",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਭਯੋ ਦਾਨਵਨ ਨਾਸਾ ॥",
      "transliteration": "eeh bidh bhayo dhaanavan naasaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦੈਂਤਾ ਦਾ ਨਾਸ਼ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "इह बिधि भयो दानवन नासा ॥",
      "sourceLineId": "139510",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਖੜਗਕੇਤੁ ਅਸੁ ਕਿਯਾ ਤਮਾਸਾ ॥੨੪੭॥",
      "transliteration": "khaRagaket as kiyaa tamaasaa ||247||",
      "translation": "",
      "punjabiViakhya": "ਖੜਗ ਕੇਤੁ (ਮਹਾ ਕਾਲ) ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਕੌਤਕ ਕੀਤਾ ॥੨੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "खड़गकेतु असु किया तमासा ॥२४७॥",
      "sourceLineId": "139511",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਤਨ ਦਾਨਵ ਜਬ ਮਾਰੇ ॥",
      "transliteration": "eeh bidh tan dhaanav jab maare ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਇਸ ਤਰ੍ਰਹਾ ਦਾਨਵ ਮਾਰੇ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "इह बिधि तन दानव जब मारे ॥",
      "sourceLineId": "139512",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪੁਨਿ ਅਸਿਧੁਜ ਅਸ ਮੰਤ੍ਰ ਬਿਚਾਰੇ ॥",
      "transliteration": "pun asidhuj as ma(n)tr bichaare ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਅਸਿਧੁਜ (ਮਹਾ ਕਾਲ) ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "पुनि असिधुज अस मंत्र बिचारे ॥",
      "sourceLineId": "139513",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੋ ਇਨ ਕੋ ਹ੍ਵੈ ਹੈ ਰਨ ਆਸਾ ॥",
      "transliteration": "jo in ko havai hai ran aasaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਜੇ ਇਨ੍ਰਹਾ ਨੂੰ ਯੁੱਧ ਕਰਨ ਦੀ ਆਸ ਹੋਏਗੀ",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "जो इन को ह्वै है रन आसा ॥",
      "sourceLineId": "139514",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੁਝੈ ਦਿਖੈ ਹੈ ਕਵਨ ਤਮਾਸਾ ॥੨੪੮॥",
      "transliteration": "mujhai dhikhai hai kavan tamaasaa ||248||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਹੀ ਮੈਨੂੰ ਕੋਈ ਤਮਾਸ਼ਾ ਵਿਖਾਉਣਗੇ ॥੨੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "मुझै दिखै है कवन तमासा ॥२४८॥",
      "sourceLineId": "139515",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਿਨ ਕਹ ਦੀਨ ਐਸ ਬਰਦਾਨਾ ॥",
      "transliteration": "tin keh dheen aais baradhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਮਹਾ ਕਾਲ ਨੇ) ਉਨ੍ਰਹਾ ਨੂੰ ਇਸ ਤਰ੍ਰਹਾ ਵਰਦਾਨ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "तिन कह दीन ऐस बरदाना ॥",
      "sourceLineId": "139516",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤੁਮਤੇ ਹੋਹਿ ਅਵਖਧੀ ਨਾਨਾ ॥",
      "transliteration": "tumate hoh avakhadhee naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿ ਤੁਹਾਡੇ ਤੋਂ ਕਈ ਪ੍ਰਕਾਰ ਦੀਆਂ ਔਸ਼ਧੀਆਂ ਉਤਪੰਨ ਹੋਣਗੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "तुमते होहि अवखधी नाना ॥",
      "sourceLineId": "139517",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਹ ਕੇ ਤਨ ਕੌ ਰੋਗ ਸੰਤਾਵੈ ॥",
      "transliteration": "jeh ke tan kau rog sa(n)taavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੇ ਤਨ ਨੂੰ ਰੋਗ ਸਤਾਏਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "जिह के तन कौ रोग संतावै ॥",
      "sourceLineId": "139518",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਾਹਿ ਅਵਖਧੀ ਬੇਗ ਜਿਯਾਵੈ ॥੨੪੯॥",
      "transliteration": "taeh avakhadhee beg jiyaavai ||249||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਔਸ਼ਧੀ ਤੁਰਤ ਜੀਵਿਤ ਕਰ ਦੇਵੇਗੀ ॥੨੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "ताहि अवखधी बेग जियावै ॥२४९॥",
      "sourceLineId": "139519",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਦਯੋ ਜਬੈ ਬਰਦਾਨਾ ॥",
      "transliteration": "eeh bidh dhayo jabai baradhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ (ਮਹਾ ਕਾਲ ਨੇ) ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਵਰਦਾਨ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "इह बिधि दयो जबै बरदाना ॥",
      "sourceLineId": "139520",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਿਰਤਕ ਹੁਤੇ ਅਸੁਰ ਜੇ ਨਾਨਾ ॥",
      "transliteration": "mritak hute asur je naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਰ ਚੁਕੇ ਅਨੇਕ ਦੈਂਤਾ ਤੋਂ ਹੀ",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "मिरतक हुते असुर जे नाना ॥",
      "sourceLineId": "139521",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਨ ਤੇ ਅਧਿਕ ਅਵਖਧੀ ਨਿਕਸੀ ॥",
      "transliteration": "tin te adhik avakhadhee nikasee ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਔਸ਼ਧੀਆਂ ਨਿਕਲ ਆਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "तिन ते अधिक अवखधी निकसी ॥",
      "sourceLineId": "139522",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਪਨੇ ਸਕਲ ਗੁਨਨ ਕਹ ਬਿਗਸੀ ॥੨੫੦॥",
      "transliteration": "apane sakal gunan keh bigasee ||250||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਆਪਣੇ ਸਾਰੇ ਗੁਣਕਾਰੀ ਤੱਤਾ ਨਾਲ ਵਿਕਸਿਤ (ਭਰਪੂਰ) ਸਨ ॥੨੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "अपने सकल गुनन कह बिगसी ॥२५०॥",
      "sourceLineId": "139523",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾ ਕੇ ਦੇਹ ਪਿਤ੍ਰਯ ਦੁਖ ਦੇਈ ॥",
      "transliteration": "jaa ke dheh pitray dhukh dheiee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ (ਦੈਂਤ) ਦੇ ਸ਼ਰੀਰ ਨੂੰ ਪਿਤ ਦੁਖ ਦਿੰਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "जा के देह पित्रय दुख देई ॥",
      "sourceLineId": "139524",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੋ ਭਖਿ ਜਰੀ ਬਾਤ ਕੀ ਲੇਈ ॥",
      "transliteration": "so bhakh jaree baat kee leiee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵਾਤ ਦੀ ਜੜੀ-ਬੂਟੀ ਖਾ ਲੈਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "सो भखि जरी बात की लेई ॥",
      "sourceLineId": "139525",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਿਹ ਦਾਨਵ ਕੌ ਬਾਇ ਸੰਤਾਵੈ ॥",
      "transliteration": "jeh dhaanav kau bai sa(n)taavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੈਂਤ ਨੂੰ ਵਾਯੂ ਸਤਾਉਾਂਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "जिह दानव कौ बाइ संतावै ॥",
      "sourceLineId": "139526",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੋ ਲੈ ਜਰੀ ਪਿਤ੍ਰਯ ਕੀ ਖਾਵੈ ॥੨੫੧॥",
      "transliteration": "so lai jaree pitray kee khaavai ||251||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਪਿਤ (ਵਾਯੂ) ਦੀ ਬੂਟੀ ਖਾ ਲੈਂਦਾ ਸੀ ॥੨੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "सो लै जरी पित्रय की खावै ॥२५१॥",
      "sourceLineId": "139527",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਾ ਕੀ ਦੇਹਿਹ ਕਫ ਦੁਖ ਲ੍ਯਾਵੈ ॥",
      "transliteration": "jaa kee dheheh kaf dhukh layaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਦੀ ਦੇਹ ਵਿਚ ਕਫ਼ ਦੁਖ ਲਿਆਉਾਂਦੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "जा की देहिह कफ दुख ल्यावै ॥",
      "sourceLineId": "139528",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੋ ਲੈ ਕਫਨਾਸਨੀ ਚਬਾਵੈ ॥",
      "transliteration": "so lai kafanaasanee chabaavai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ 'ਕਫਨਾਸਨੀ' ਬੂਟੀ ਚਬਾ ਲੈਂਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "सो लै कफनासनी चबावै ॥",
      "sourceLineId": "139529",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਅਸੁਰ ਭਏ ਬਿਨੁ ਰੋਗਾ ॥",
      "transliteration": "eeh bidh asur bhe bin rogaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਦੈਂਤ ਰੋਗਾ ਤੋਂ ਮੁਕਤ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "इह बिधि असुर भए बिनु रोगा ॥",
      "sourceLineId": "139530",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਾਡਤ ਭਏ ਜੁਧ ਤਜਿ ਸੋਗਾ ॥੨੫੨॥",
      "transliteration": "maaddat bhe judh taj sogaa ||252||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਦੁਖ ਨੂੰ ਤਿਆਗ ਕੇ ਯੁੱਧ ਮਚਾ ਦਿੱਤਾ ॥੨੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "माडत भए जुध तजि सोगा ॥२५२॥",
      "sourceLineId": "139531",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਗਨਿ ਅਸਤ੍ਰ ਛਾਡਾ ਤਬ ਦਾਨਵ ॥",
      "transliteration": "agan asatr chhaaddaa tab dhaanav ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੈਂਤਾ ਨੇ ਅਗਨੀ ਅਸਤ੍ਰ ਛਡਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "अगनि असत्र छाडा तब दानव ॥",
      "sourceLineId": "139532",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾ ਤੇ ਭਏ ਭਸਮ ਬਹੁ ਮਾਨਵ ॥",
      "transliteration": "jaa te bhe bhasam bahu maanav ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਬਹੁਤ ਸਾਰੇ ਮਨੁੱਖ ਭਸਮ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "जा ते भए भसम बहु मानव ॥",
      "sourceLineId": "139533",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਾਰੁਣਾਸਤ੍ਰ ਤਬ ਕਾਲ ਚਲਾਯੋ ॥",
      "transliteration": "baarunaasatr tab kaal chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਲ ਨੇ ਵਰੁਣ ਅਸਤ੍ਰ ਚਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "बारुणासत्र तब काल चलायो ॥",
      "sourceLineId": "139534",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਕਲ ਅਗਨਿ ਕੋ ਤੇਜ ਮਿਟਾਯੋ ॥੨੫੩॥",
      "transliteration": "sakal agan ko tej miTaayo ||253||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨਾਲ) ਸਾਰੀ ਅੱਗ ਦਾ ਤੇਜ ਮਿਟ ਗਿਆ ॥੨੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "सकल अगनि को तेज मिटायो ॥२५३॥",
      "sourceLineId": "139535",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਛਸ ਪਵਨ ਅਸਤ੍ਰ ਸੰਧਾਨਾ ॥",
      "transliteration": "raachhas pavan asatr sa(n)dhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤਾ ਨੇ ਪਵਨ ਅਸਤ੍ਰ ਨੂੰ ਸਾਧਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "राछस पवन असत्र संधाना ॥",
      "sourceLineId": "139536",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾ ਤੇ ਉਡਤ ਭਏ ਗਨ ਨਾਨਾ ॥",
      "transliteration": "jaa te uddat bhe gan naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ ਅਨੇਕਾ ਪ੍ਰਾਣੀ ਉਡ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "जा ते उडत भए गन नाना ॥",
      "sourceLineId": "139537",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭੂਧਰਾਸਤ੍ਰ ਤਬ ਕਾਲ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "bhoodharaasatr tab kaal prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਲ ਨੇ ਭੂਧਰ (ਪਰਬਤ) ਅਸਤ੍ਰ ਚਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "भूधरासत्र तब काल प्रहारा ॥",
      "sourceLineId": "139538",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਭ ਸਿਵਕਨ ਕੋ ਪ੍ਰਾਨ ਉਬਾਰਾ ॥੨੫੪॥",
      "transliteration": "sabh sivakan ko praan ubaaraa ||254||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਸੇਵਕਾ ਦੇ ਪ੍ਰਾਣ ਬਚਾ ਲਏ ॥੨੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "सभ सिवकन को प्रान उबारा ॥२५४॥",
      "sourceLineId": "139539",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮੇਘ ਅਸਤ੍ਰ ਛੋਰਾ ਪੁਨਿ ਦਾਨਵ ॥",
      "transliteration": "megh asatr chhoraa pun dhaanav ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਦਾਨਵਾ ਨੇ ਮੇਘ ਅਸਤ੍ਰ ਨੂੰ ਛਡਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "मेघ असत्र छोरा पुनि दानव ॥",
      "sourceLineId": "139540",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੀਜ ਗਏ ਜਿਹ ਤੇ ਸਭ ਮਾਨਵ ॥",
      "transliteration": "bheej ge jeh te sabh maanav ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਸਾਰੇ ਮਨੁੱਖ ਭਿਜ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "भीज गए जिह ते सभ मानव ॥",
      "sourceLineId": "139541",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਾਇ ਅਸਤ੍ਰ ਲੈ ਕਾਲ ਚਲਾਯੋ ॥",
      "transliteration": "bai asatr lai kaal chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਲ ਨੇ ਵਾਯੂ ਅਸਤ੍ਰ ਚਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "बाइ असत्र लै काल चलायो ॥",
      "sourceLineId": "139542",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਭ ਮੇਘਨ ਤਤਕਾਲ ਉਡਾਯੋ ॥੨੫੫॥",
      "transliteration": "sabh meghan tatakaal uddaayo ||255||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨਾਲ) ਸਾਰਿਆਂ ਬਦਲਾ ਨੂੰ ਤੁਰਤ ਉਡਾ ਦਿੱਤਾ ॥੨੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "सभ मेघन ततकाल उडायो ॥२५५॥",
      "sourceLineId": "139543",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰਾਛਸਾਸਤ੍ਰ ਰਾਛਸਹਿ ਚਲਾਯੋ ॥",
      "transliteration": "raachhasaasatr raachhaseh chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤਾ ਨੇ (ਫਿਰ) ਰਾਛਸ (ਰਾਖਸ਼) ਅਸਤ੍ਰ ਚਲਾਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "राछसासत्र राछसहि चलायो ॥",
      "sourceLineId": "139544",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਹੁ ਅਸੁਰਨ ਤਾ ਤੇ ਉਪਜਾਯੋ ॥",
      "transliteration": "bahu asuran taa te upajaayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਬਹੁਤ ਦੈਂਤ ਪੈਦਾ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "बहु असुरन ता ते उपजायो ॥",
      "sourceLineId": "139545",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1376_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੇਵਤਾਸਤ੍ਰ ਛੋਰਾ ਤਬ ਕਾਲਾ ॥",
      "transliteration": "dhevataasatr chhoraa tab kaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਲ ਨੇ ਦੇਵਤਾ ਅਸਤ੍ਰ ਛਡਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1376,
      "hindi": "",
      "hindiTransliteration": "देवतासत्र छोरा तब काला ॥",
      "sourceLineId": "139546",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
