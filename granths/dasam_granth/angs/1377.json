{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1377,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1377_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਸੁਰ ਸੈਨ ਕੂਟਾ ਦਰਹਾਲਾ ॥੨੫੬॥",
      "transliteration": "asur sain kooTaa dharahaalaa ||256||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨਾਲ ਸਾਰੀ) ਦੈਂਤ ਸੈਨਾ ਨੂੰ ਬੁਰੀ ਤਰ੍ਰਹਾ ਮਾਰ ਕੁਟ ਦਿੱਤਾ ॥੨੫੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "असुर सैन कूटा दरहाला ॥२५६॥",
      "sourceLineId": "139547",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਛ ਅਤਸ੍ਰ ਤਬ ਅਸੁਰ ਚਲਾਯੋ ॥",
      "transliteration": "jachh atasr tab asur chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੈਂਤਾ ਨੇ ਜਛ (ਯਕਸ਼) ਅਸਤ੍ਰ ਚਲਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "जछ अतस्र तब असुर चलायो ॥",
      "sourceLineId": "139548",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੰਧ੍ਰਬਾਸਤ੍ਰ ਲੈ ਕਾਲ ਬਗਾਯੋ ॥",
      "transliteration": "ga(n)dhrabaasatr lai kaal bagaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਕਾਲ ਨੇ ਗੰਧਰਬ ਅਸਤ੍ਰ ਵਗਾ ਮਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "गंध्रबासत्र लै काल बगायो ॥",
      "sourceLineId": "139549",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤੇ ਦੋਊ ਆਪੁ ਬੀਰ ਲਰਿ ਮਰੇ ॥",
      "transliteration": "te dhouoo aap beer lar mare ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਦੋਵੇਾਂ ਵੀਰ (ਅਸਤ੍ਰ) ਆਪਸ ਵਿਚ ਲੜ ਮਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "ते दोऊ आपु बीर लरि मरे ॥",
      "sourceLineId": "139550",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਟੁਕ ਟੁਕ ਹ੍ਵੈ ਭੂ ਪਰ ਪੁਨਿ ਝਰੇ ॥੨੫੭॥",
      "transliteration": "Tuk Tuk havai bhoo par pun jhare ||257||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਟੋਟੇ ਟੋਟੇ ਹੋ ਕੇ ਫਿਰ ਧਰਤੀ ਉਤੇ ਡਿਗ ਪਏ ॥੨੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "टुक टुक ह्वै भू पर पुनि झरे ॥२५७॥",
      "sourceLineId": "139551",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਾਰਣਾਸਤ੍ਰ ਜਬ ਅਸੁਰ ਸੰਧਾਨਾ ॥",
      "transliteration": "chaaranaasatr jab asur sa(n)dhaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੈਂਤਾ ਨੇ ਚਾਰਣ ਅਸਤ੍ਰ ਛਡਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "चारणासत्र जब असुर संधाना ॥",
      "sourceLineId": "139552",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚਾਰਣ ਉਪਜ ਠਾਢ ਭੈ ਨਾਨਾ ॥",
      "transliteration": "chaaran upaj Thaadd bhai naanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਅਨੇਕ ਚਾਰਣ ਪੈਦਾ ਹੋ ਕੇ ਡਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "चारण उपज ठाढ भै नाना ॥",
      "sourceLineId": "139553",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਿਧ ਅਸਤ੍ਰ ਅਸਿਧੁਜ ਤਬ ਛੋਰਾ ॥",
      "transliteration": "sidh asatr asidhuj tab chhoraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਅਸਿਧੁਜ (ਮਹਾ ਕਾਲ) ਨੇ 'ਸਿਧ' ਅਸਤ੍ਰ ਛਡਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "सिध असत्र असिधुज तब छोरा ॥",
      "sourceLineId": "139554",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾ ਤੇ ਮੁਖ ਸਤ੍ਰਨ ਕੋ ਤੋਰਾ ॥੨੫੮॥",
      "transliteration": "taa te mukh satran ko toraa ||258||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਵੈਰੀਆਂ ਦਾ ਮੂੰਹ ਭੰਨ ਦਿੱਤਾ ॥੨੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "ता ते मुख सत्रन को तोरा ॥२५८॥",
      "sourceLineId": "139555",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਉਰਗ ਅਸਤ੍ਰ ਲੈ ਅਸੁਰ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "aurag asatr lai asur prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤਾ ਨੇ ਉਰਗ ਅਸਤ੍ਰ ਲੈ ਕੇ ਚਲਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "उरग असत्र लै असुर प्रहारा ॥",
      "sourceLineId": "139556",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਤੇ ਉਪਜੇ ਸਰਪ ਅਪਾਰਾ ॥",
      "transliteration": "taa te upaje sarap apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ ਬੇਸ਼ੁਮਾਰ ਸੱਪ ਪੈਦਾ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "ता ते उपजे सरप अपारा ॥",
      "sourceLineId": "139557",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਖਗਪਤਿ ਅਸਤ੍ਰ ਤਜਾ ਤਬ ਕਾਲਾ ॥",
      "transliteration": "khagapat asatr tajaa tab kaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਲ ਨੇ ਖਗਪਤਿ (ਗਰੁੜ) ਅਸਤ੍ਰ ਛਡਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "खगपति असत्र तजा तब काला ॥",
      "sourceLineId": "139558",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਛਿ ਗਏ ਨਾਗਨ ਦਰਹਾਲਾ ॥੨੫੯॥",
      "transliteration": "bhachh ge naagan dharahaalaa ||259||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਤੁਰਤ ਸੱਪਾ ਨੂੰ ਖਾ ਲਿਆ ॥੨੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "भछि गए नागन दरहाला ॥२५९॥",
      "sourceLineId": "139559",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਿਛੂ ਅਸਤ੍ਰ ਦਾਨਵਹਿ ਚਲਾਯੋ ॥",
      "transliteration": "bichhoo asatr dhaanaveh chalaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਦੈਂਤਾ ਨੇ ਬਿਛੂ ਅਸਤ੍ਰ ਨੂੰ ਚਲਾਇਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "बिछू असत्र दानवहि चलायो ॥",
      "sourceLineId": "139560",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਹੁ ਬਿਛੂਯਨ ਤਾ ਤੇ ਉਪਜਾਯੋ ॥",
      "transliteration": "bahu bichhooyan taa te upajaayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ ਬਹੁਤ ਬਿਛੂ ਪੈਦਾ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "बहु बिछूयन ता ते उपजायो ॥",
      "sourceLineId": "139561",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਲਸਿਟਕਾ ਸਤ੍ਰ ਅਸਿਧੁਜ ਤਬ ਛੋਰਾ ॥",
      "transliteration": "lasiTakaa satr asidhuj tab chhoraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਅਸਿਧੁਜ (ਮਹਾ ਕਾਲ) ਨੇ ਲਸ਼ਟਿਕਾ ਅਸਤ੍ਰ ਛਡਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "लसिटका सत्र असिधुज तब छोरा ॥",
      "sourceLineId": "139562",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਭ ਹੀ ਡਾਕ ਅਠੂਹਨ ਤੋਰਾ ॥੨੬੦॥",
      "transliteration": "sabh hee ddaak aThoohan toraa ||260||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨਾਲ) ਸਾਰਿਆਂ ਬਿਛੂਆਂ (ਅਠੂਹਿਆਂ) ਦੇ ਡੰਗ ਤੋੜ ਸੁਟੇ ॥੨੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "सभ ही डाक अठूहन तोरा ॥२६०॥",
      "sourceLineId": "139563",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਅਸ ਅਸੁਰ ਚਲਾਏ ॥",
      "transliteration": "sasatr asatr as asur chalaae ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤਾ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਦੇ ਅਸਤ੍ਰ ਸ਼ਸਤ੍ਰ ਚਲਾਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "ससत्र असत्र अस असुर चलाए ॥",
      "sourceLineId": "139564",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਖੜਗ ਕੇਤੁ ਪਰ ਕਛੁ ਨ ਬਸਾਏ ॥",
      "transliteration": "khaRag ket par kachh na basaae ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਖੜਗ ਕੇਤੁ (ਮਹਾ ਕਾਲ) ਉਤੇ (ਉਨ੍ਰਹਾ ਦਾ) ਕੁਝ ਵੀ ਵਸ ਨਾ ਚਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "खड़ग केतु पर कछु न बसाए ॥",
      "sourceLineId": "139565",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਸਤ੍ਰਨ ਸਾਥ ਅਸਤ੍ਰੁ ਬਹੁ ਛਏ ॥",
      "transliteration": "asatran saath asatr bahu chhe ||",
      "translation": "",
      "punjabiViakhya": "ਅਸਤ੍ਰਾ ਨਾਲ ਬਹੁਤ ਅਸਤ੍ਰ ਆ ਕੇ ਵਜੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "असत्रन साथ असत्रु बहु छए ॥",
      "sourceLineId": "139566",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾ ਕੌ ਲਗੇ ਲੀਨ ਤੇ ਭਏ ॥੨੬੧॥",
      "transliteration": "jaa kau lage leen te bhe ||261||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਲਗੇ, ਉਸੇ ਵਿਚ ਲੀਨ ਹੋ ਗਏ ॥੨੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "जा कौ लगे लीन ते भए ॥२६१॥",
      "sourceLineId": "139567",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਲੀਨ ਹ੍ਵੈ ਗਏ ਅਸਤ੍ਰ ਨਿਹਾਰੇ ॥",
      "transliteration": "leen havai ge asatr nihaare ||",
      "translation": "",
      "punjabiViakhya": "(ਜਦ ਦੈਂਤਾ ਨੇ) ਲੀਨ ਹੋਏ ਅਸਤ੍ਰਾ ਨੂੰ ਵੇਖਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "लीन ह्वै गए असत्र निहारे ॥",
      "sourceLineId": "139568",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਕਰਿ ਅਸੁਰ ਪੁਕਾਰੇ ॥",
      "transliteration": "hai hai kar asur pukaare ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਦੈਂਤ 'ਹਾਇ ਹਾਇ' ਕਰ ਕੇ ਪੁਕਾਰਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ करि असुर पुकारे ॥",
      "sourceLineId": "139569",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਹਾ ਮੂਢ ਫਿਰਿ ਕੋਪ ਬਢਾਈ ॥",
      "transliteration": "mahaa moodd fir kop baddaiee ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਮੂਰਖਾ ਨੇ ਗੁੱਸੇ ਵਿਚ ਆ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "महा मूढ फिरि कोप बढाई ॥",
      "sourceLineId": "139570",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪੁਨਿ ਅਸਿਧੁਜ ਤਨ ਕਰੀ ਲਰਾਈ ॥੨੬੨॥",
      "transliteration": "pun asidhuj tan karee laraiee ||262||",
      "translation": "",
      "punjabiViakhya": "ਅਸਿਧੁਜ ਨਾਲ ਫਿਰ ਲੜਾਈ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤੀ ॥੨੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "पुनि असिधुज तन करी लराई ॥२६२॥",
      "sourceLineId": "139571",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਭਯੋ ਘੋਰ ਸੰਗ੍ਰਾਮਾ ॥",
      "transliteration": "eeh bidh bhayo ghor sa(n)graamaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਬਹੁਤ ਭਿਆਨਕ ਲੜਾਈ ਹੋਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "इह बिधि भयो घोर संग्रामा ॥",
      "sourceLineId": "139572",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਿਰਖਤ ਦੇਵ ਦਾਨਵੀ ਬਾਮਾ ॥",
      "transliteration": "nirakhat dhev dhaanavee baamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਦੇਵਤਿਆਂ ਅਤੇ ਦੈਂਤਾ ਦੀਆਂ ਇਸਤਰੀਆਂ ਨੇ ਵੇਖਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "निरखत देव दानवी बामा ॥",
      "sourceLineId": "139573",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਧੰਨ੍ਯ ਧੰਨ੍ਯ ਅਸਿਧੁਜ ਕੌ ਕਹੈ ॥",
      "transliteration": "dha(n)nay dha(n)nay asidhuj kau kahai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਅਸਿਧੁਜ ਨੂੰ 'ਧੰਨ ਧੰਨ' ਕਹਿਣ ਲਗੀਆਂ",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "धंन्य धंन्य असिधुज कौ कहै ॥",
      "sourceLineId": "139574",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦਾਨਵ ਹੇਰਿ ਮੋਨ ਹ੍ਵੈ ਰਹੈ ॥੨੬੩॥",
      "transliteration": "dhaanav her mon havai rahai ||263||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੈਂਤਾ ਨੂੰ ਵੇਖ ਕੇ ਚੁਪ ਹੋ ਰਹੀਆਂ ॥੨੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "दानव हेरि मोन ह्वै रहै ॥२६३॥",
      "sourceLineId": "139575",
      "sourceShabadId": "12784",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭੁਜੰਗ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "भुजंग छंद ॥",
      "sourceLineId": "139576",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਹਾ ਰੋਸ ਕੈ ਕੈ ਹਠੀ ਫੇਰਿ ਗਾਜੇ ॥",
      "transliteration": "mahaa ros kai kai haThee fer gaaje ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਰੋਹ ਵਿਚ ਆ ਕੇ ਹਠੀ ਸੂਰਮੇ ਫਿਰ ਗਜਣ ਲਗ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "महा रोस कै कै हठी फेरि गाजे ॥",
      "sourceLineId": "139577",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਹੂੰ ਓਰ ਤੇ ਘੋਰ ਬਾਦਿਤ੍ਰ ਬਾਜੇ ॥",
      "transliteration": "chahoo(n) or te ghor baadhitr baaje ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਚੌਹਾ ਪਾਸਿਆਂ ਤੋਂ ਭਿਆਨਕ ਵਾਜੇ ਵਜਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओर ते घोर बादित्र बाजे ॥",
      "sourceLineId": "139578",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪ੍ਰਣੋ ਸੰਖ ਭੇਰੀ ਬਜੇ ਢੋਲ ਐਸੇ ॥",
      "transliteration": "prano sa(n)kh bheree baje ddol aaise ||",
      "translation": "",
      "punjabiViakhya": "ਪ੍ਰਣੋ (ਛੋਟਾ ਢੋਲ) ਸੰਖ, ਭੇਰੀਆਂ ਅਤੇ ਢੋਲ ਇਸ ਤਰ੍ਰਹਾ ਵਜੇ",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "प्रणो संख भेरी बजे ढोल ऐसे ॥",
      "sourceLineId": "139579",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪ੍ਰਲੈ ਕਾਲ ਕੇ ਕਾਲ ਕੀ ਰਾਤ੍ਰਿ ਜੈਸੇ ॥੨੬੪॥",
      "transliteration": "pralai kaal ke kaal kee raatr jaise ||264||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਪਰਲੋ ਕਾਲ ਦੀ ਰਾਤ ਵੇਲੇ (ਵਜਣਗੇ) ॥੨੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "प्रलै काल के काल की रातृ जैसे ॥२६४॥",
      "sourceLineId": "139580",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਜੇ ਸੰਖ ਔ ਦਾਨਵੀ ਭੇਰ ਐਸੀ ॥",
      "transliteration": "baje sa(n)kh aau dhaanavee bher aaisee ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤਾ ਦੇ ਸੰਖ ਅਤੇ ਭੇਰੀਆਂ ਇਸ ਤਰ੍ਰਹਾ ਵਜ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "बजे संख औ दानवी भेर ऐसी ॥",
      "sourceLineId": "139581",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਹੈ ਆਸੁਰੀ ਬ੍ਰਿਤ ਕੀ ਕ੍ਰਿਤ ਜੈਸੀ ॥",
      "transliteration": "kahai aasuree birat kee kirat jaisee ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਉਹ ਦੈਂਤ-ਬਿਰਤੀ ਦੀ ਕਰਨੀ ਦਸ ਰਹੀਆਂ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "कहै आसुरी बृत की कृत जैसी ॥",
      "sourceLineId": "139582",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਬਾਜੰਤ ਬਾਕੇ ਬਜਾਵੈ ॥",
      "transliteration": "kahoo(n) beer baaja(n)t baake bajaavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਬਾਕੇ ਸੂਰਮੇ ਵਾਜੇ ਵਜਾ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर बाजंत बाके बजावै ॥",
      "sourceLineId": "139583",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨੋ ਚਿਤ ਕੋ ਕੋਪ ਭਾਖੇ ਸੁਨਾਵੈ ॥੨੬੫॥",
      "transliteration": "mano chit ko kop bhaakhe sunaavai ||265||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਆਪਣੇ ਚਿਤ ਦੇ ਕ੍ਰੋਧ ਨੂੰ ਬੋਲ ਕੇ ਸੁਣਾ ਰਹੇ ਹੋਣ ॥੨੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "मनो चित को कोप भाखे सुनावै ॥२६५॥",
      "sourceLineId": "139584",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਿਤੇ ਬੀਰ ਬਜ੍ਰਾਨ ਕੇ ਸਾਥ ਪੇਲੇ ॥",
      "transliteration": "kite beer bajraan ke saath pele ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਸੂਰਮੇ ਬਜ੍ਰਾ (ਬਾਣਾ) ਨਾਲ ਪਰੇ ਧਕ ਦਿੱਤੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "किते बीर बज्रान के साथ पेले ॥",
      "sourceLineId": "139585",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਰੇ ਬਸਤ੍ਰ ਲੋਹੂ ਮਨੋ ਫਾਗ ਖੇਲੇ ॥",
      "transliteration": "bhare basatr lohoo mano faag khele ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਲਹੂ ਨਾਲ ਲਿਬੜੇ ਹੋਏ ਬਸਤ੍ਰ ਇੰਜ ਲਗਦੇ ਸਨ ਮਾਨੋ ਹੋਲੀ ਖੇਡੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "भरे बसत्र लोहू मनो फाग खेले ॥",
      "sourceLineId": "139586",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮੂਏ ਖਾਇ ਕੈ ਦੁਸਟ ਕੇਤੇ ਮਰੂਰੇ ॥",
      "transliteration": "mooe khai kai dhusaT kete maroore ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਦੁਸਟ ਮਰੋੜੇ ਖਾ ਕੇ ਮਰ ਗਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "मूए खाइ कै दुसट केते मरूरे ॥",
      "sourceLineId": "139587",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੋਏ ਜਾਨ ਮਾਲੰਗ ਖਾਏ ਧਤੂਰੇ ॥੨੬੬॥",
      "transliteration": "soe jaan maala(n)g khaae dhatoore ||266||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਪ੍ਰਤੀਤ ਹੁੰਦਾ ਸੀ ਮਾਨੋ) ਮਲੰਗ ਧਤੂਰਾ ਖਾ ਕੇ ਸੌਂ ਗਏ ਹੋਣ ॥੨੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "सोए जान मालंग खाए धतूरे ॥२६६॥",
      "sourceLineId": "139588",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿਤੇ ਟੂਕ ਟੂਕੇ ਬਲੀ ਖੇਤ ਹੋਏ ॥",
      "transliteration": "kite Took Tooke balee khet hoe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਟੋਟੇ ਟੋਟੇ ਹੋਏ ਸੂਰਮੇ ਰਣ-ਖੇਤਰ ਵਿਚ ਪਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "किते टूक टूके बली खेत होए ॥",
      "sourceLineId": "139589",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮਨੋ ਖਾਇ ਕੈ ਭੰਗ ਮਾਲੰਗ ਸੋਏ ॥",
      "transliteration": "mano khai kai bha(n)g maala(n)g soe ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਮਲੰਗ ਭੰਗ ਖਾ ਕੇ ਸੁਤੇ ਪਏ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "मनो खाइ कै भंग मालंग सोए ॥",
      "sourceLineId": "139590",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਰਾਜੈ ਕਟੇ ਅੰਗ ਬਸਤ੍ਰੋ ਲਪੇਟੇ ॥",
      "transliteration": "biraajai kaTe a(n)g basatro lapeTe ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਕਟੇ ਹੋਏ ਅੰਗਾ ਨਾਲ ਬਸਤ੍ਰਾ ਵਿਚ (ਇਸ ਤਰ੍ਰਹਾ) ਲਿਪਟੇ ਪਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "बिराजै कटे अंग बसत्रो लपेटे ॥",
      "sourceLineId": "139591",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੁਮੇ ਕੇ ਮਨੋ ਰੋਜ ਮੈ ਗੌਂਸ ਲੇਟੇ ॥੨੬੭॥",
      "transliteration": "jume ke mano roj mai gaua(n)s leTe ||267||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਜੁਮੇ (ਸ਼ੁਕਰਵਾਰ) ਵਾਲੇ ਦਿਨ ਦੀ ਨਮਾਜ਼ ਵੇਲੇ ਗੌਂਸ (ਫ਼ਕੀਰ ਵਿਸ਼ੇਸ਼) ਅੰਗ ਖਿਲਾਰ ਕੇ ਲੇਟੇ ਪਏ ਹੋਣ ॥੨੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "जुमे के मनो रोज मै गौंस लेटे ॥२६७॥",
      "sourceLineId": "139592",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਹੂੰ ਡਾਕਨੀ ਝਾਕਨੀ ਹਾਕ ਮਾਰੈ ॥",
      "transliteration": "kahoo(n) ddaakanee jhaakanee haak maarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਡਾਕਣੀਆਂ ਅਤੇ ਗਿੱਧਾ ('ਝਾਕਨੀ') ਹੁੰਕਾਰ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1377,
      "hindi": "",
      "hindiTransliteration": "कहूँ डाकनी झाकनी हाक मारै ॥",
      "sourceLineId": "139593",
      "sourceShabadId": "12785",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1377_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਉਠੈ ਨਾਦ ਭਾਰੇ ਛੁਟੈ ਚੀਤਕਾਰੈ ॥",
      "transliteration": "auThai naadh bhaare chhuTai cheetakaarai ||",
      "translation": "",
