{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1379,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1379_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਪੁ ਹਾਥ ਦੈ ਸਾਧ ਉਬਾਰੇ ॥",
      "transliteration": "aap haath dhai saadh ubaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਨੇ ਆਪਣਾ ਹੱਥ ਦੇ ਕੇ ਸਾਧਾ ਨੂੰ ਬਚਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "आपु हाथ दै साध उबारे ॥",
      "sourceLineId": "139643",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਤ੍ਰੁ ਅਨੇਕ ਛਿਨਕ ਮੋ ਟਾਰੇ ॥੨੭੯॥",
      "transliteration": "satr anek chhinak mo Taare ||279||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕਾ ਵੈਰੀਆਂ ਨੂੰ ਛਿਣ ਵਿਚ ਮਾਰ ਦਿੱਤਾ ॥੨੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "सत्रु अनेक छिनक मो टारे ॥२७९॥",
      "sourceLineId": "139644",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਸਿਧੁਜ ਜੂ ਕੋਪਾ ਜਬ ਹੀ ਰਨ ॥",
      "transliteration": "asidhuj joo kopaa jab hee ran ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਵੇਲੇ ਅਸਿਧੁਜ (ਮਹਾ ਕਾਲ) ਰਣ ਵਿਚ ਕ੍ਰੋਧਿਤ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "असिधुज जू कोपा जब ही रन ॥",
      "sourceLineId": "139645",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਾਰਤ ਭਯੋ ਸਤ੍ਰੁਗਨ ਚੁਨਿ ਚੁਨਿ ॥",
      "transliteration": "maarat bhayo satrugan chun chun ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਉਸ ਨੇ ਵੈਰੀਆਂ ਨੂੰ ਚੁਣ ਚੁਣ ਕੇ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "मारत भयो सत्रुगन चुनि चुनि ॥",
      "sourceLineId": "139646",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਭ ਸਿਵਕਨ ਕਹ ਲਿਓ ਉਬਾਰਾ ॥",
      "transliteration": "sabh sivakan keh lio ubaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਸੇਵਕਾ ਨੂੰ ਬਚਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "सभ सिवकन कह लिओ उबारा ॥",
      "sourceLineId": "139647",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦੁਸਟ ਗਠਨ ਕੋ ਕਰਾ ਪ੍ਰਹਾਰਾ ॥੨੮੦॥",
      "transliteration": "dhusaT gaThan ko karaa prahaaraa ||280||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੁਸ਼ਟਾ ਦੇ ਸਮੂਹ ਉਤੇ ਪ੍ਰਹਾਰ ਕੀਤਾ ॥੨੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "दुसट गठन को करा प्रहारा ॥२८०॥",
      "sourceLineId": "139648",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਹਨੇ ਦੁਸਟ ਜਬ ਕਾਲਾ ॥",
      "transliteration": "eeh bidh hane dhusaT jab kaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਕਾਲ ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਦੁਸ਼ਟ ਮਾਰ ਦਿੱਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "इह बिधि हने दुसट जब काला ॥",
      "sourceLineId": "139649",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗਿਰਿ ਗਿਰਿ ਪਰੇ ਧਰਨਿ ਬਿਕਰਾਲਾ ॥",
      "transliteration": "gir gir pare dharan bikaraalaa ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਭਿਆਨਕ (ਦੈਂਤ) ਧਰਤੀ ਉਤੇ ਡਿਗਣ ਲਗ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "गिरि गिरि परे धरनि बिकराला ॥",
      "sourceLineId": "139650",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਿਜ ਹਾਥਨ ਦੈ ਸੰਤ ਉਬਾਰੇ ॥",
      "transliteration": "nij haathan dhai sa(n)t ubaare ||",
      "translation": "",
      "punjabiViakhya": "ਆਪਣੇ ਹੱਥਾ ਨਾਲ ਸੰਤਾ ਨੂੰ ਉਬਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "निज हाथन दै संत उबारे ॥",
      "sourceLineId": "139651",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਤ੍ਰੁ ਅਨੇਕ ਤਨਿਕ ਮਹਿ ਮਾਰੇ ॥੨੮੧॥",
      "transliteration": "satr anek tanik meh maare ||281||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਵੈਰੀਆਂ ਨੂੰ ਛਿਣ ਵਿਚ ਮਾਰ ਮੁਕਾਇਆ ॥੨੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "सत्रु अनेक तनिक महि मारे ॥२८१॥",
      "sourceLineId": "139652",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦਾਨਵ ਅਮਿਤ ਕੋਪ ਕਰਿ ਢੂਕੇ ॥",
      "transliteration": "dhaanav amit kop kar ddooke ||",
      "translation": "",
      "punjabiViakhya": "ਬੇਸ਼ੁਮਾਰ ਦੈਂਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਆ ਢੁਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "दानव अमित कोप करि ढूके ॥",
      "sourceLineId": "139653",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਾਰਹਿ ਮਾਰਿ ਦਸੌ ਦਿਸਿ ਕੂਕੇ ॥",
      "transliteration": "maareh maar dhasau dhis kooke ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਸਾ ਦਿਸ਼ਾਵਾ ਤੋਂ 'ਮਾਰੋ ਮਾਰੋ' ਕੂਕਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "मारहि मारि दसौ दिसि कूके ॥",
      "sourceLineId": "139654",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਹੁਰਿ ਕਾਲ ਕੁਪਿ ਖੜਗ ਸੰਭਾਰਾ ॥",
      "transliteration": "bahur kaal kup khaRag sa(n)bhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਨੇ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਫਿਰ ਖੜਗ ਸੰਭਾਲ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "बहुरि काल कुपि खड़ग संभारा ॥",
      "sourceLineId": "139655",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਤ੍ਰੁ ਸੈਨ ਪਲ ਬੀਚ ਪ੍ਰਹਾਰਾ ॥੨੮੨॥",
      "transliteration": "satr sain pal beech prahaaraa ||282||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਪਲ ਵਿਚ ਹੀ ਵੈਰੀ ਦੀ ਸੈਨਾ ਉਤੇ ਵਾਰ ਕੀਤਾ ॥੨੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "सत्रु सैन पल बीच प्रहारा ॥२८२॥",
      "sourceLineId": "139656",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਹੁਰਿ ਕੋਪ ਕਰਿ ਦੁਸਟ ਅਪਾਰਾ ॥",
      "transliteration": "bahur kop kar dhusaT apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ ਦੁਸ਼ਟ ਕ੍ਰੋਧ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "बहुरि कोप करि दुसट अपारा ॥",
      "sourceLineId": "139657",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕੌ ਚਹਤ ਸੰਘਾਰਾ ॥",
      "transliteration": "mahaa kaal kau chahat sa(n)ghaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਮਹਾ ਕਾਲ ਨੂੰ ਮਾਰਨਾ ਚਾਹੁੰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "महा काल कौ चहत संघारा ॥",
      "sourceLineId": "139658",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਮਿ ਗਗਨਹਿ ਕੋਈ ਬਾਨ ਚਲਾਵੈ ॥",
      "transliteration": "jim gaganeh koiee baan chalaavai ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਵੇਾਂ ਕੋਈ ਆਕਾਸ਼ ਵਲ ਤੀਰ ਚਲਾਉਾਂਦਾ ਹੈ, (ਉਹ) ਆਕਾਸ਼ ਨੂੰ ਨਹੀਂ ਲਗਦਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "जिमि गगनहि कोई बान चलावै ॥",
      "sourceLineId": "139659",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾਹਿ ਨ ਲਗੇ ਤਿਸੀ ਪਰ ਆਵੈ ॥੨੮੩॥",
      "transliteration": "taeh na lage tisee par aavai ||283||",
      "translation": "",
      "punjabiViakhya": "ਸਗੋਂ ਉਸ (ਚਲਾਉਣ ਵਾਲੇ) ਨੂੰ ਹੀ ਆ ਲਗਦਾ ਹੈ ॥੨੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "ताहि न लगे तिसी पर आवै ॥२८३॥",
      "sourceLineId": "139660",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਬਾਦਿਤ੍ਰ ਬਜਾਇ ॥",
      "transliteration": "bhaat bhaat baadhitr bajai ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤਾ ਨੇ ਭਾਤ ਭਾਤ ਦੇ ਵਾਜੇ ਵਜਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "भाति भाति बादित्र बजाइ ॥",
      "sourceLineId": "139661",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦਾਨਵ ਨਿਕਟ ਪਹੂਚੇ ਆਇ ॥",
      "transliteration": "dhaanav nikaT pahooche aai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਮਹਾ ਕਾਲ ਦੇ) ਨੇੜੇ ਆ ਪਹੁੰਚੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "दानव निकट पहूचे आइ ॥",
      "sourceLineId": "139662",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਤਬ ਬਿਰਦ ਸੰਭਾਰੋ ॥",
      "transliteration": "mahaa kaal tab biradh sa(n)bhaaro ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨੇ ਤਦ ਆਪਣੇ ਕਰਤੱਵ ਨੂੰ ਸੰਭਾਲਿਆ (ਪਾਲਿਆ)",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "महा काल तब बिरद संभारो ॥",
      "sourceLineId": "139663",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੰਤ ਉਬਾਰਿ ਦੋਖਿਯਨ ਮਾਰੋ ॥੨੮੪॥",
      "transliteration": "sa(n)t ubaar dhokhiyan maaro ||284||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੁਸ਼ਟਾ ਨੂੰ ਮਾਰ ਕੇ ਸੰਤਾ ਨੂੰ ਬਚਾਇਆ ॥੨੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "संत उबारि दोखियन मारो ॥२८४॥",
      "sourceLineId": "139664",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਖੰਡ ਖੰਡ ਕਰਿ ਦਾਨਵ ਮਾਰੇ ॥",
      "transliteration": "kha(n)dd kha(n)dd kar dhaanav maare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਟੋਟੇ ਟੋਟੇ ਕਰ ਕੇ ਦੈਂਤਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "खंड खंड करि दानव मारे ॥",
      "sourceLineId": "139665",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਲ ਤਿਲ ਪ੍ਰਾਇ ਸਕਲ ਕਰਿ ਡਾਰੇ ॥",
      "transliteration": "til til prai sakal kar ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਨੂੰ ਤਿਲ ਤਿਲ ਦੇ ਬਰਾਬਰ ('ਪ੍ਰਾਇ') ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "तिल तिल प्राइ सकल करि डारे ॥",
      "sourceLineId": "139666",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪਾਵਕਾਸਤ੍ਰ ਕਲਿ ਬਹੁਰਿ ਚਲਾਯੋ ॥",
      "transliteration": "paavakaasatr kal bahur chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਿ (ਕਾਲ) ਨੇ ਫਿਰ ਅਗਨੀ ਅਸਤ੍ਰ ਚਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "पावकासत्र कलि बहुरि चलायो ॥",
      "sourceLineId": "139667",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੈਨ ਅਸੁਰ ਕੋ ਸਗਲ ਗਿਰਾਯੋ ॥੨੮੫॥",
      "transliteration": "sain asur ko sagal giraayo ||285||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੈਂਤਾ ਦੀ ਸਾਰੀ ਸੈਨਾ ਨੂੰ ਡਿਗਾ ਦਿੱਤਾ ॥੨੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "सैन असुर को सगल गिरायो ॥२८५॥",
      "sourceLineId": "139668",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਰੁਣਾਸਤ੍ਰ ਦਾਨਵ ਤਬ ਛੋਰਾ ॥",
      "transliteration": "barunaasatr dhaanav tab chhoraa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੈਂਤਾ ਨੇ ਵਰੁਣ ਅਸਤ੍ਰ ਛਡਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "बरुणासत्र दानव तब छोरा ॥",
      "sourceLineId": "139669",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾ ਤੇ ਪਾਵਕਾਸਤ੍ਰ ਕਹ ਮੋਰਾ ॥",
      "transliteration": "jaa te paavakaasatr keh moraa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਅਗਨੀ ਅਸਤ੍ਰ ਨੂੰ ਮੋੜ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "जा ते पावकासत्र कह मोरा ॥",
      "sourceLineId": "139670",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਾਸ੍ਵਾਸਤ੍ਰ ਤਬ ਕਾਲ ਚਲਾਯੋ ॥",
      "transliteration": "baasavaiaasatr tab kaal chalaayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਲ ਨੇ ਬਾਸਵ ਅਸਤ੍ਰ ਚਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "बास्वासत्र तब काल चलायो ॥",
      "sourceLineId": "139671",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇੰਦ੍ਰ ਪ੍ਰਤ੍ਰਛ ਹ੍ਵੈ ਜੁਧ ਮਚਾਯੋ ॥੨੮੬॥",
      "transliteration": "ei(n)dhr pratrachh havai judh machaayo ||286||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇੰਦਰ ਪ੍ਰਤੱਖ ਹੋ ਕੇ ਯੁੱਧ ਮਚਾਣ ਲਗਾ ॥੨੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "इंद्र प्रत्रछ ह्वै जुध मचायो ॥२८६॥",
      "sourceLineId": "139672",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦਾਨਵ ਨਿਰਖਿ ਠਾਢ ਰਨ ਬਾਸਵ ॥",
      "transliteration": "dhaanav nirakh Thaadd ran baasav ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਵਿਚ ਇੰਦਰ ('ਬਾਸਵ') ਨੂੰ ਖੜੋਤਾ ਵੇਖ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "दानव निरखि ठाढ रन बासव ॥",
      "sourceLineId": "139673",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪੀਵਤ ਭਯੋ ਕੂਪ ਦ੍ਵੈ ਆਸਵ ॥",
      "transliteration": "peevat bhayo koop dhavai aasav ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤ ਸ਼ਰਾਬ ਦੇ ਦੋ ਖੂਹ ਪੀ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "पीवत भयो कूप द्वै आसव ॥",
      "sourceLineId": "139674",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਰਿ ਕੈ ਕੋਪ ਅਤੁਲ ਅਸ ਗਰਜਾ ॥",
      "transliteration": "kar kai kop atul as garajaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਇਸ ਤਰ੍ਰਹਾ ਗਰਜਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "करि कै कोप अतुल अस गरजा ॥",
      "sourceLineId": "139675",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭੂੰਮਿ ਅਕਾਸ ਸਬਦ ਸੁਨਿ ਲਰਜਾ ॥੨੮੭॥",
      "transliteration": "bhoo(n)m akaas sabadh sun larajaa ||287||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਦੀ) ਧੁਨੀ ਨੂੰ ਸੁਣ ਕੇ ਭੂਮੀ ਅਤੇ ਆਕਾਸ਼ ਕੰਬਣ ਲਗ ਗਏ ॥੨੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "भूँमि अकास सबद सुनि लरजा ॥२८७॥",
      "sourceLineId": "139676",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਮਿਤ ਬਾਸਵਹਿ ਬਾਨ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "amit baasaveh baan prahaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇੰਦਰ ਉਤੇ ਬੇਸ਼ੁਮਾਰ ਬਾਣ ਚਲਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "अमित बासवहि बान प्रहारे ॥",
      "sourceLineId": "139677",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਰਮ ਚਰਮ ਸਭ ਭੇਦਿ ਪਧਾਰੇ ॥",
      "transliteration": "baram charam sabh bhedh padhaare ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਢਾਲਾ ਅਤੇ ਕਵਚਾ ਨੂੰ ਵਿੰਨ੍ਰਹ ਕੇ ਪਾਰ ਨਿਕਲ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "बरम चरम सभ भेदि पधारे ॥",
      "sourceLineId": "139678",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਨੁਕ ਨਾਗ ਬਾਬੀ ਧਸਿ ਗਏ ॥",
      "transliteration": "januk naag baabee dhas ge ||",
      "translation": "",
      "punjabiViakhya": "(ਇਸ ਤਰ੍ਰਹਾ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਸੱਪ ਆਪਣੀਆਂ ਖੁਡਾ ਵਿਚ ਵੜ ਗਏ ਹੋਣ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "जनुक नाग बाबी धसि गए ॥",
      "sourceLineId": "139679",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭੂਤਲ ਭੇਦਿ ਪਤਾਰ ਸਿਧਏ ॥੨੮੮॥",
      "transliteration": "bhootal bhedh pataar sidhe ||288||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੂਮੀ ਨੂੰ ਪਾੜ ਕੇ ਪਾਤਾਲ ਵਲ ਚਲੇ ਗਏ ਹੋਣ ॥੨੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "भूतल भेदि पतार सिधए ॥२८८॥",
      "sourceLineId": "139680",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਮਿਤ ਰੋਸ ਬਾਸਵ ਤਬ ਕਿਯਾ ॥",
      "transliteration": "amit ros baasav tab kiyaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇੰਦਰ ਨੇ ਬਹੁਤ ਰੋਸ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "अमित रोस बासव तब किया ॥",
      "sourceLineId": "139681",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਧਨੁਖ ਬਾਨ ਕਰ ਭੀਤਰ ਲਿਯਾ ॥",
      "transliteration": "dhanukh baan kar bheetar liyaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧਨੁਸ਼ ਬਾਣ ਨੂੰ ਹੱਥ ਵਿਚ ਲੈ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "धनुख बान कर भीतर लिया ॥",
      "sourceLineId": "139682",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਮਿਤ ਕੋਪ ਕਰਿ ਬਿਸਿਖ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "amit kop kar bisikh prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ ਬਾਣ ਚਲਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "अमित कोप करि बिसिख प्रहारे ॥",
      "sourceLineId": "139683",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਫੋਰਿ ਦਾਨਵਨ ਪਾਰ ਪਧਾਰੇ ॥੨੮੯॥",
      "transliteration": "for dhaanavan paar padhaare ||289||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦੈਂਤਾ ਨੂੰ ਚੀਰ ਕੇ ਬਾਹਰ ਨਿਕਲ ਗਏ ॥੨੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "फोरि दानवन पार पधारे ॥२८९॥",
      "sourceLineId": "139684",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦਾਨਵ ਅਧਿਕ ਰੋਸ ਕਰਿ ਧਾਏ ॥",
      "transliteration": "dhaanav adhik ros kar dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤ ਨੇ (ਫਿਰ) ਕ੍ਰੋਧ ਕਰ ਕੇ ਹਮਲਾ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "दानव अधिक रोस करि धाए ॥",
      "sourceLineId": "139685",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੇਵ ਪੂਜ ਰਨ ਮਾਝ ਭਜਾਏ ॥",
      "transliteration": "dhev pooj ran maajh bhajaae ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੇਵ-ਪੂਜਾ ਕਰਨ ਵਾਲਿਆਂ ਨੂੰ ਰਣ ਵਿਚੋਂ ਭਜਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "देव पूज रन माझ भजाए ॥",
      "sourceLineId": "139686",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਜਤ ਦੇਵ ਨਿਰਖੇ ਕਲਿ ਜਬ ਹੀ ॥",
      "transliteration": "bhajat dhev nirakhe kal jab hee ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਕਲਿ (ਮਹਾ ਕਾਲ) ਨੇ ਯੁੱਧ ਵਿਚੋਂ ਦੇਵਤੇ ਭਜਦੇ ਹੋਏ ਵੇਖੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "भजत देव निरखे कलि जब ही ॥",
      "sourceLineId": "139687",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਛੋਰੇ ਰਨ ਤਬ ਹੀ ॥੨੯੦॥",
      "transliteration": "sasatr asatr chhore ran tab hee ||290||",
      "translation": "",
      "punjabiViakhya": "ਤਦ (ਸਾਰੇ) ਅਸਤ੍ਰ ਸ਼ਸਤ੍ਰ ਯੁੱਧ ਵਿਚ ਛਡ ਦਿੱਤੇ ॥੨੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "ससत्र असत्र छोरे रन तब ही ॥२९०॥",
      "sourceLineId": "139688",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਾਨਨ ਕੀ ਬਰਖਾ ਕਲਿ ਕਰੀ ॥",
      "transliteration": "baanan kee barakhaa kal karee ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਿ ਨੇ ਬਾਣਾ ਦੀ ਬਰਖਾ ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "बानन की बरखा कलि करी ॥",
      "sourceLineId": "139689",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1379_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਲਾਗਤ ਸੈਨ ਦਾਨਵੀ ਜਰੀ ॥",
      "transliteration": "laagat sain dhaanavee jaree ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੇ ਲਗਦਿਆਂ ਹੀ ਦੈਂਤ ਸੈਨਾ ਸੜ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1379,
      "hindi": "",
      "hindiTransliteration": "लागत सैन दानवी जरी ॥",
      "sourceLineId": "139690",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
