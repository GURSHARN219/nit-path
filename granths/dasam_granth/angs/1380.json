{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1380,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1380_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਤ੍ਰੁ ਅਨੇਕ ਨਿਧਨ ਕਹ ਗਏ ॥",
      "transliteration": "satr anek nidhan keh ge ||",
      "translation": "",
      "punjabiViakhya": "ਅਨੇਕ ਵੈਰੀਆਂ ਦਾ ਦੇਹਾਤ ਹੋ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "सत्रु अनेक निधन कह गए ॥",
      "sourceLineId": "139691",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਹੁਰਿ ਉਪਜਿ ਬਹੁ ਠਾਢੇ ਭਏ ॥੨੯੧॥",
      "transliteration": "bahur upaj bahu Thaadde bhe ||291||",
      "translation": "",
      "punjabiViakhya": "ਪਰ (ਉਨ੍ਰਹਾ ਵਿਚੋਂ) ਫਿਰ (ਹੋਰ ਦੈਂਤ) ਪੈਦਾ ਹੋ ਕੇ ਉਠ ਖੜੋਤੇ ॥੨੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "बहुरि उपजि बहु ठाढे भए ॥२९१॥",
      "sourceLineId": "139692",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਹੁਰਿ ਕਾਲ ਕੁਪਿ ਬਾਨ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "bahur kaal kup baan prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਨੇ ਫਿਰ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਬਾਣ ਚਲਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "बहुरि काल कुपि बान प्रहारे ॥",
      "sourceLineId": "139693",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬੇਧਿ ਦਾਨਵਨ ਪਾਰ ਪਧਾਰੇ ॥",
      "transliteration": "bedh dhaanavan paar padhaare ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਦੈਂਤਾ ਨੂੰ ਵਿੰਨ੍ਰਹ ਕੇ ਪਾਰ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "बेधि दानवन पार पधारे ॥",
      "sourceLineId": "139694",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦਾਨਵ ਤਬੈ ਅਧਿਕ ਕਰਿ ਕ੍ਰੁਧਾ ॥",
      "transliteration": "dhaanav tabai adhik kar krudhaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤਾ ਨੇ ਤਦ ਬਹੁਤ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "दानव तबै अधिक करि क्रुधा ॥",
      "sourceLineId": "139695",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੰਡਾ ਮਹਾ ਕਾਲ ਤਨ ਜੁਧਾ ॥੨੯੨॥",
      "transliteration": "ma(n)ddaa mahaa kaal tan judhaa ||292||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨਾਲ ਯੁੱਧ ਸ਼ੁਰੂ ਕਰ ਦਿੱਤਾ ॥੨੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "मंडा महा काल तन जुधा ॥२९२॥",
      "sourceLineId": "139696",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਤਬ ਬਾਨ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "mahaa kaal tab baan prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨੇ ਤਦ ਤੀਰ ਚਲਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "महा काल तब बान प्रहारे ॥",
      "sourceLineId": "139697",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦਾਨਵ ਏਕ ਏਕ ਕਰਿ ਮਾਰੇ ॥",
      "transliteration": "dhaanav ek ek kar maare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਇਕ ਕਰ ਕੇ ਦੈਂਤਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "दानव एक एक करि मारे ॥",
      "sourceLineId": "139698",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਿਨ ਤੇ ਬਹੁ ਉਪਜਿਤ ਰਨ ਭਏ ॥",
      "transliteration": "tin te bahu upajit ran bhe ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ (ਰਣ-ਭੂਮੀ ਵਿਚ ਫਿਰ) ਹੋਰ ਪੈਦਾ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "तिन ते बहु उपजित रन भए ॥",
      "sourceLineId": "139699",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕੇ ਸਾਮੁਹਿ ਸਿਧਏ ॥੨੯੩॥",
      "transliteration": "mahaa kaal ke saamuh sidhe ||293||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਹਾ ਕਾਲ ਦੇ ਸਾਹਮਣੇ ਆ ਡੱਟੇ ॥੨੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "महा काल के सामुहि सिधए ॥२९३॥",
      "sourceLineId": "139700",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੇਤਿਕ ਧਏ ਤਿਤਕ ਕਲਿ ਮਾਰੇ ॥",
      "transliteration": "jetik dhe titak kal maare ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨੇ ਵੀ (ਦੈਂਤ) ਧਾ ਕੇ ਆਏ, ਉਤਨੇ ਹੀ ਕਲਿ (ਮਹਾ ਕਾਲ) ਨੇ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "जेतिक धए तितक कलि मारे ॥",
      "sourceLineId": "139701",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਥੀ ਗਜੀ ਤਿਲ ਤਿਲ ਕਰਿ ਡਾਰੇ ॥",
      "transliteration": "rathee gajee til til kar ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਰਥਾ ਵਾਲਿਆਂ ਅਤੇ ਹਾਥੀਆਂ ਵਾਲਿਆਂ ਨੂੰ ਤਿਲ ਤਿਲ ਕਰ ਕੇ ਸੁਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "रथी गजी तिल तिल करि डारे ॥",
      "sourceLineId": "139702",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਨਤੇ ਉਪਜਿ ਠਾਢ ਭੇ ਘਨੇ ॥",
      "transliteration": "tinate upaj Thaadd bhe ghane ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਫਿਰ ਅਨੇਕਾ ਪੈਦਾ ਹੋ ਕੇ ਡਟ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "तिनते उपजि ठाढ भे घने ॥",
      "sourceLineId": "139703",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਥੀ ਗਜੀ ਬਾਜੀ ਸੁਭ ਬਨੇ ॥੨੯੪॥",
      "transliteration": "rathee gajee baajee subh bane ||294||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਥਾ ਵਾਲੇ, ਹਾਥੀਆਂ ਅਤੇ ਘੋੜਿਆਂ ਵਾਲੇ ਬਣ ਕੇ ਸਜ ਗਏ ॥੨੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "रथी गजी बाजी सुभ बने ॥२९४॥",
      "sourceLineId": "139704",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਹੁਰਿ ਕਾਲ ਕਰਿ ਕੋਪ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "bahur kaal kar kop prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਕਾਲ ਨੇ ਗੁੱਸੇ ਵਿਚ ਆ ਕੇ ਵਾਰ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "बहुरि काल करि कोप प्रहारे ॥",
      "sourceLineId": "139705",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੈਤ ਅਨਿਕ ਮ੍ਰਿਤੁ ਲੋਕ ਪਧਾਰੇ ॥",
      "transliteration": "dhait anik mrit lok padhaare ||",
      "translation": "",
      "punjabiViakhya": "(ਫਲਸਰੂਪ) ਅਨੇਕ ਦੈਂਤ ਯਮ ਦੇ ਘਰ ਨੂੰ ਚਲੇ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "दैत अनिक मृतु लोक पधारे ॥",
      "sourceLineId": "139706",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਬਹੁਰੌ ਧਨੁ ਧਰਾ ॥",
      "transliteration": "mahaa kaal bahurau dhan dharaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨੇ ਫਿਰ ਧਨੁਸ਼ (ਬਾਣ) ਫੜ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "महा काल बहुरौ धनु धरा ॥",
      "sourceLineId": "139707",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੌ ਸੌ ਬਾਨ ਏਕ ਇਕ ਹਰਾ ॥੨੯੫॥",
      "transliteration": "sau sau baan ek ik haraa ||295||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਕ ਇਕ ਬਾਣ ਨਾਲ ਸੌ ਸੌ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੨੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "सौ सौ बान एक इक हरा ॥२९५॥",
      "sourceLineId": "139708",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੌ ਸੌ ਏਕ ਏਕ ਸਰ ਮਾਰਾ ॥",
      "transliteration": "sau sau ek ek sar maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਸੌ ਸੌ ਨੂੰ ਇਕ ਇਕ ਬਾਣ ਮਾਰਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "सौ सौ एक एक सर मारा ॥",
      "sourceLineId": "139709",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੌ ਸੌ ਗਿਰੀ ਸ੍ਰੋਨ ਕੀ ਧਾਰਾ ॥",
      "transliteration": "sau sau giree sron kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਨ੍ਰਹਾ ਵਿਚੋਂ) ਲਹੂ ਦੀਆਂ ਸੌ ਸੌ ਤਤੀਰੀਆਂ ਚਲ ਪਈਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "सौ सौ गिरी स्रोन की धारा ॥",
      "sourceLineId": "139710",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਤ ਸਤ ਅਸੁਰ ਉਪਜਿ ਭੇ ਠਾਢੇ ॥",
      "transliteration": "sat sat asur upaj bhe Thaadde ||",
      "translation": "",
      "punjabiViakhya": "(ਫਿਰ) ਸੌ ਸੌ ਦੈਂਤ ਪੈਦਾ ਹੋ ਕੇ ਡਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "सत सत असुर उपजि भे ठाढे ॥",
      "sourceLineId": "139711",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਸੀ ਗਜੀ ਕੌਚੀ ਬਲ ਗਾਢੇ ॥੨੯੬॥",
      "transliteration": "asee gajee kauachee bal gaadde ||296||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਤਲਵਾਰਧਾਰੀ, ਹਾਥੀ ਸਵਾਰ, ਕਵਚਧਾਰੀ ਬਲ ਪੂਰਵਕ ਗਡ ਗਏ ॥੨੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "असी गजी कौची बल गाढे ॥२९६॥",
      "sourceLineId": "139712",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰੂਪ ਹਜਾਰ ਹਜਾਰ ਧਾਰਿ ਕਲਿ ॥",
      "transliteration": "roop hajaar hajaar dhaar kal ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਿ (ਮਹਾ ਕਾਲ) ਹਜ਼ਾਰ ਹਜ਼ਾਰ ਰੂਪ ਧਾਰਨ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "रूप हजार हजार धारि कलि ॥",
      "sourceLineId": "139713",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗਰਜਤ ਭਯੋ ਅਤੁਲ ਕਰਿ ਕੈ ਬਲ ॥",
      "transliteration": "garajat bhayo atul kar kai bal ||",
      "translation": "",
      "punjabiViakhya": "ਅਪਾਰ ਬਲ ਨਾਲ ਗਰਜਣ ਲਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "गरजत भयो अतुल करि कै बल ॥",
      "sourceLineId": "139714",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਹ ਕਹ ਹਸਾ ਕਾਲ ਬਿਕਰਾਲਾ ॥",
      "transliteration": "keh keh hasaa kaal bikaraalaa ||",
      "translation": "",
      "punjabiViakhya": "ਵਿਕਰਾਲ ਕਾਲ 'ਕਹ ਕਹ' ਕਰ ਕੇ ਹਸਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "कह कह हसा काल बिकराला ॥",
      "sourceLineId": "139715",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਾਢੇ ਦਾਤ ਤਜਤ ਮੁਖ ਜ੍ਵਾਲਾ ॥੨੯੭॥",
      "transliteration": "kaadde dhaat tajat mukh javaiaalaa ||297||",
      "translation": "",
      "punjabiViakhya": "ਦੰਦ ਕਢ ਕੇ ਮੂੰਹ ਵਿਚੋਂ ਅੱਗ ਉਗਲਣ ਲਗਾ ॥੨੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "काढे दात तजत मुख ज्वाला ॥२९७॥",
      "sourceLineId": "139716",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਏਕ ਏਕ ਰਨ ਬਾਨ ਚਲਾਯੋ ॥",
      "transliteration": "ek ek ran baan chalaayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਰਣ-ਭੂਮੀ ਵਿਚ ਇਕ ਇਕ ਬਾਣ ਚਲਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "एक एक रन बान चलायो ॥",
      "sourceLineId": "139717",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਹਸ ਸਹਸ ਦਾਨਵ ਕਹ ਘਾਯੋ ॥",
      "transliteration": "sahas sahas dhaanav keh ghaayo ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹਜ਼ਾਰ ਹਜ਼ਾਰ ਦੈਂਤਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "सहस सहस दानव कह घायो ॥",
      "sourceLineId": "139718",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕੇਤਿਕ ਸੁਭਟ ਦਾੜ ਗਹਿ ਚਾਬੇ ॥",
      "transliteration": "ketik subhaT dhaaR geh chaabe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਸੂਰਮਿਆਂ ਨੂੰ ਪਕੜ ਕੇ ਦਾੜ੍ਰਹਾ ਹੇਠਾ ਚਬਾ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "केतिक सुभट दाड़ गहि चाबे ॥",
      "sourceLineId": "139719",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕੇਤਿਕ ਸੁਭਟ ਪਾਵ ਤਰ ਦਾਬੇ ॥੨੯੮॥",
      "transliteration": "ketik subhaT paav tar dhaabe ||298||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤਨਿਆਂ ਸੂਰਮਿਆਂ ਨੂੰ ਪੈਰਾ ਹੇਠਾ ਦਬ ਦਿੱਤਾ ॥੨੯੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "केतिक सुभट पाव तर दाबे ॥२९८॥",
      "sourceLineId": "139720",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕੇਤਕ ਪਕਰਿ ਭਛ ਕਰਿ ਲਯੋ ॥",
      "transliteration": "ketak pakar bhachh kar layo ||",
      "translation": "",
      "punjabiViakhya": "ਕਈਆਂ ਨੂੰ ਪਕੜ ਕੇ ਖਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "केतक पकरि भछ करि लयो ॥",
      "sourceLineId": "139721",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਿਨ ਤੇ ਏਕ ਨ ਉਪਜਤ ਭਯੋ ॥",
      "transliteration": "tin te ek na upajat bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਤੋਂ ਇਕ ਵੀ ਹੋਰ ਪੈਦਾ ਨਾ ਹੋ ਸਕਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "तिन ते एक न उपजत भयो ॥",
      "sourceLineId": "139722",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਿਤਕਨ ਦ੍ਰਿਸਟਾਕਰਖਨ ਕੀਯੋ ॥",
      "transliteration": "kitakan dhirasaTaakarakhan keeyo ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਨੂੰ ਦ੍ਰਿਸ਼ਟੀ ਨਾਲ ਖਿਚ ਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "कितकन दृसटाकरखन कीयो ॥",
      "sourceLineId": "139723",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਭਹਿਨ ਕੋ ਸ੍ਰੋਨਿਤ ਹਰਿ ਲੀਯੋ ॥੨੯੯॥",
      "transliteration": "sabhahin ko sronit har leeyo ||299||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰਿਆਂ ਦਾ ਲਹੂ ਖਿਚ ਲਿਆ ॥੨੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "सभहिन को स्रोनित हरि लीयो ॥२९९॥",
      "sourceLineId": "139724",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸ੍ਰੋਨ ਰਹਿਤ ਦਾਨਵ ਜਬ ਭਯੋ ॥",
      "transliteration": "sron rahit dhaanav jab bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਦੈਂਤ ਲਹੂ-ਰਹਿਤ ਹੋ ਗਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "स्रोन रहित दानव जब भयो ॥",
      "sourceLineId": "139725",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੈਤ ਉਪਰਾਜਨ ਤੇ ਰਹਿ ਗਯੋ ॥",
      "transliteration": "dhait uparaajan te reh gayo ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਹੋਰ ਦੈਂਤ ਪੈਦਾ ਹੋਣੋ ਰਹਿ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "दैत उपराजन ते रहि गयो ॥",
      "sourceLineId": "139726",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸ੍ਰਮਿਤ ਅਧਿਕ ਹ੍ਵੈ ਛਾਡਤ ਸ੍ਵਾਸਾ ॥",
      "transliteration": "sramit adhik havai chhaaddat savaiaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਥਕ ਕੇ ਉਹ ਸੁਆਸ ਛਡਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "स्रमित अधिक ह्वै छाडत स्वासा ॥",
      "sourceLineId": "139727",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਾ ਤੇ ਕਰਤ ਦੈਤ ਪਰਗਾਸਾ ॥੩੦੦॥",
      "transliteration": "taa te karat dhait paragaasaa ||300||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤੋਂ (ਹੋਰ) ਦੈਂਤ ਪ੍ਰਗਟ ਹੁੰਦੇ ਸਨ ॥੩੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "ता ते करत दैत परगासा ॥३००॥",
      "sourceLineId": "139728",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਵਨਾਕਰਖ ਕਰਾ ਤਬ ਕਾਲਾ ॥",
      "transliteration": "pavanaakarakh karaa tab kaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਲ ਨੇ ਪਵਨ ਨੂੰ (ਆਪਣੇ ਵਲ) ਖਿਚਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "पवनाकरख करा तब काला ॥",
      "sourceLineId": "139729",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਘਟੇ ਬਢਨ ਤੇ ਅਰਿ ਬਿਕਰਾਲਾ ॥",
      "transliteration": "ghaTe baddan te ar bikaraalaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨਾਲ ਭਿਆਨਕ ਵੈਰੀ ਵਧਣ ਤੋਂ ਘਟ ਗਏ (ਭਾਵ ਰੁਕ ਗਏ)।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "घटे बढन ते अरि बिकराला ॥",
      "sourceLineId": "139730",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਜਬ ਆਕਰਖਨ ਕੀਯਾ ॥",
      "transliteration": "eeh bidh jab aakarakhan keeyaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਜਦ ਆਕਰਸ਼ਣ ('ਆਕਰਖਨ') ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "इह बिधि जब आकरखन कीया ॥",
      "sourceLineId": "139731",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਭ ਬਲ ਹਰਿ ਅਸੁਰਨ ਕਾ ਲੀਯਾ ॥੩੦੧॥",
      "transliteration": "sabh bal har asuran kaa leeyaa ||301||",
      "translation": "",
      "punjabiViakhya": "(ਤਦ) ਦੈਂਤਾ ਦਾ ਸਾਰਾ ਬਲ ਹਰ ਲਿਆ ॥੩੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "सभ बल हरि असुरन का लीया ॥३०१॥",
      "sourceLineId": "139732",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਜੋ ਅਸੁਰ ਪੁਕਾਰਤ ॥",
      "transliteration": "maar maar jo asur pukaarat ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤ ਜੋ 'ਮਾਰੋ ਮਾਰੋ' ਪੁਕਾਰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "मारि मारि जो असुर पुकारत ॥",
      "sourceLineId": "139733",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਹ ਤੇ ਅਮਿਤ ਦੈਤ ਤਨ ਧਾਰਤ ॥",
      "transliteration": "teh te amit dhait tan dhaarat ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਹੋਰ ਅਨੇਕ ਦੈਂਤ ਸ਼ਰੀਰ ਧਾਰਨ ਕਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "तिह ते अमित दैत तन धारत ॥",
      "sourceLineId": "139734",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਾਚਾਕਰਖ ਕਾਲ ਤਬ ਕਯੋ ॥",
      "transliteration": "baachaakarakh kaal tab kayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਕਾਲ ਨੇ ਉਨ੍ਰਹਾ ਦੀ ਬਾਣੀ ('ਬਾਚ') ਨੂੰ ਵੀ ਖਿਚ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "बाचाकरख काल तब कयो ॥",
      "sourceLineId": "139735",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬੋਲਨ ਤੇ ਦਾਨਵ ਰਹਿ ਗਯੋ ॥੩੦੨॥",
      "transliteration": "bolan te dhaanav reh gayo ||302||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਕਰ ਕੇ) ਦੈਂਤ ਬੋਲਣੋ ਰਹਿ ਗਏ ॥੩੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "बोलन ते दानव रहि गयो ॥३०२॥",
      "sourceLineId": "139736",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦਾਨਵ ਜਬ ਬੋਲਹਿ ਰਹਿ ਗਯੋ ॥",
      "transliteration": "dhaanav jab boleh reh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਦੈਂਤ ਬੋਲਣੋ ਰਹਿ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "दानव जब बोलहि रहि गयो ॥",
      "sourceLineId": "139737",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚਿੰਤਾ ਕਰਤ ਚਿਤ ਮੋ ਭਯੋ ॥",
      "transliteration": "chi(n)taa karat chit mo bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਮਨ ਵਿਚ ਚਿੰਤਾ ਕਰਨ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "चिंता करत चित मो भयो ॥",
      "sourceLineId": "139738",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤਾਹੀ ਤੇ ਦਾਨਵ ਬਹੁ ਭਏ ॥",
      "transliteration": "taahee te dhaanav bahu bhe ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ (ਚਿੰਤਾ) ਤੋਂ ਹੀ ਬਹੁਤ ਦੈਂਤ ਪੈਦਾ ਹੋ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "ताही ते दानव बहु भए ॥",
      "sourceLineId": "139739",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਨਮੁਖ ਮਹਾ ਕਾਲ ਕੇ ਧਏ ॥੩੦੩॥",
      "transliteration": "sanamukh mahaa kaal ke dhe ||303||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਹਾ ਕਾਲ ਦੇ ਸਾਹਮਣੇ ਆ ਕੇ ਡਟ ਗਏ ॥੩੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "सनमुख महा काल के धए ॥३०३॥",
      "sourceLineId": "139740",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਕਰਿ ਕੋਪ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "sasatr asatr kar kop prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੇ ਅਸਤ੍ਰ ਸ਼ਸਤ੍ਰ ਪਕੜ ਕੇ ਕ੍ਰੋਧ ਨਾਲ ਵਾਰ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "ससत्र असत्र करि कोप प्रहारे ॥",
      "sourceLineId": "139741",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਹਾਬੀਰ ਬਰਿਯਾਰ ਡਰਾਰੇ ॥",
      "transliteration": "mahaabeer bariyaar ddaraare ||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਨਾਲ) ਮਹਾਬੀਰ ਯੋਧੇ ਡਰਾ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "महाबीर बरियार डरारे ॥",
      "sourceLineId": "139742",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਤਬ ਗੁਰਜ ਸੰਭਾਰੀ ॥",
      "transliteration": "mahaa kaal tab guraj sa(n)bhaaree ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨੇ ਤਦ ਗੁਰਜ ਨੂੰ ਸੰਭਾਲਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "महा काल तब गुरज संभारी ॥",
      "sourceLineId": "139743",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਬਹੁਤਨ ਕੀ ਮੇਧਾ ਕਢਿ ਡਾਰੀ ॥੩੦੪॥",
      "transliteration": "bahutan kee medhaa kadd ddaaree ||304||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਸਾਰੇ (ਦੈਂਤਾ ਦੀ) ਮਿਝ ਕਢ ਦਿੱਤੀ ॥੩੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "बहुतन की मेधा कढि डारी ॥३०४॥",
      "sourceLineId": "139744",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤਿਨ ਕੀ ਭੂਅ ਮੇਜਾ ਜੋ ਪਰੀ ॥",
      "transliteration": "tin kee bhooa mejaa jo paree ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਜੋ ਮਿਝ ਧਰਤੀ ਉਤੇ ਪਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "तिन की भूअ मेजा जो परी ॥",
      "sourceLineId": "139745",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਤਾ ਤੇ ਸੈਨ ਦੇਹ ਬਹੁ ਧਰੀ ॥",
      "transliteration": "taa te sain dheh bahu dharee ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਵੱਡੀ ਸੈਨਾ ਹੋਂਦ ਵਿਚ ਆ ਗਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "ता ते सैन देह बहु धरी ॥",
      "sourceLineId": "139746",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਕਰਿ ਕੋਪ ਅਪਾਰਾ ॥",
      "transliteration": "maar maar kar kop apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰੋ ਮਾਰੋ' ਕਰਦੇ ਬੇਸ਼ੁਮਾਰ ਵਿਕਰਾਲ ਦੈਂਤ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "मारि मारि करि कोप अपारा ॥",
      "sourceLineId": "139747",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਾਗਤ ਭਏ ਅਸੁਰ ਬਿਕਰਾਰਾ ॥੩੦੫॥",
      "transliteration": "jaagat bhe asur bikaraaraa ||305||",
      "translation": "",
      "punjabiViakhya": "ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਜਾਗ ਪਏ (ਅਰਥਾਤ ਤਿਆਰ ਹੋ ਗਏ) ॥੩੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "जागत भए असुर बिकरारा ॥३०५॥",
      "sourceLineId": "139748",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਤਿਨ ਕੇ ਫੋਰਿ ਮੂੰਡਿ ਕਲਿ ਡਰੇ ॥",
      "transliteration": "tin ke for moo(n)dd kal ddare ||",
      "translation": "",
      "punjabiViakhya": "ਕਲਿ (ਮਹਾ ਕਾਲ) ਨੇ ਉਨ੍ਰਹਾ ਦੇ ਸਿਰ ਪਾੜ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "तिन के फोरि मूँडि कलि डरे ॥",
      "sourceLineId": "139749",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਤਾ ਤੇ ਮੇਧਾ ਜੋ ਭੂਅ ਪਰੇ ॥",
      "transliteration": "taa te medhaa jo bhooa pare ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੀ ਜੋ ਮਿਝ ਧਰਤੀ ਉਤੇ ਪਈ,",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "ता ते मेधा जो भूअ परे ॥",
      "sourceLineId": "139750",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਕਹਿ ਅਸੁਰ ਜਗੇ ਰਨ ॥",
      "transliteration": "maar maar keh asur jage ran ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ 'ਮਾਰੋ ਮਾਰੋ' ਕਰਦੇ ਰਣ ਵਿਚ ਦੈਂਤ ਜਾਗ ਪਏ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "मारि मारि कहि असुर जगे रन ॥",
      "sourceLineId": "139751",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਸੂਰਬੀਰ ਬਰਿਯਾਰ ਮਹਾਮਨ ॥੩੦੬॥",
      "transliteration": "soorabeer bariyaar mahaaman ||306||",
      "translation": "",
      "punjabiViakhya": "(ਜੋ) ਬਹੁਤ ਵੱਡੇ ਸੂਰਮੇ ਅਤੇ ਬਹਾਦਰ ਸਨ ॥੩੦੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "सूरबीर बरियार महामन ॥३०६॥",
      "sourceLineId": "139752",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਪੁਨਿ ਕਰਿ ਕਾਲ ਗਦਾ ਰਿਸਿ ਧਰੀ ॥",
      "transliteration": "pun kar kaal gadhaa ris dharee ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਨੇ ਫਿਰ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਹੱਥ ਵਿਚ ਗਦਾ ਪਕੜ ਲਈ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "पुनि करि काल गदा रिसि धरी ॥",
      "sourceLineId": "139753",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਸਤ੍ਰੁ ਖੋਪਰੀ ਤਿਲ ਤਿਲ ਕਰੀ ॥",
      "transliteration": "satr khoparee til til karee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੈਰੀਆਂ ਦੀਆਂ ਖੋਪੜੀਆਂ ਚੂਰ ਚੂਰ ਕਰ ਦਿੱਤੀਆਂ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "सत्रु खोपरी तिल तिल करी ॥",
      "sourceLineId": "139754",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਜੇਤੇ ਟੂਕ ਖੋਪ੍ਰਿਯਨ ਪਰੇ ॥",
      "transliteration": "jete Took khopirayan pare ||",
      "translation": "",
      "punjabiViakhya": "ਖੋਪੜੀਆਂ ਦੇ ਜਿਤਨੇ ਵੀ ਟੁਕੜੇ ਡਿਗੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "जेते टूक खोपृयन परे ॥",
      "sourceLineId": "139755",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਤੇਤਿਕ ਰੂਪ ਦਾਨਵਨ ਧਰੇ ॥੩੦੭॥",
      "transliteration": "tetik roop dhaanavan dhare ||307||",
      "translation": "",
      "punjabiViakhya": "ਉਤਨੇ ਹੀ ਦੈਂਤਾ ਨੇ ਰੂਪ ਧਾਰਨ ਕਰ ਲਏ ॥੩੦੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "तेतिक रूप दानवन धरे ॥३०७॥",
      "sourceLineId": "139756",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਕੇਤਿਕ ਗਦਾ ਪਾਨ ਗਹਿ ਧਾਏ ॥",
      "transliteration": "ketik gadhaa paan geh dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੀ ਹੱਥਾ ਵਿਚ ਗੁਰਜ ਪਕੜ ਕੇ ਆ ਧਸੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "केतिक गदा पान गहि धाए ॥",
      "sourceLineId": "139757",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਕੇਤਿਕ ਖੜਗ ਹਾਥ ਲੈ ਆਏ ॥",
      "transliteration": "ketik khaRag haath lai aae ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਹੱਥ ਵਿਚ ਤਲਵਾਰਾ ਲੈ ਕੇ ਆ ਪਹੁੰਚੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "केतिक खड़ग हाथ लै आए ॥",
      "sourceLineId": "139758",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਕੈ ਕੋਪਹਿ ਸਰਜੇ ॥",
      "transliteration": "maar maar kai kopeh saraje ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰੋ ਮਾਰੋ' ਕਰਦੇ ਉਹ ਗੁੱਸਾ ਕਢ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "मारि मारि कै कोपहि सरजे ॥",
      "sourceLineId": "139759",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਮਾਨਹੁ ਮਹਾਕਾਲ ਘਨ ਗਰਜੇ ॥੩੦੮॥",
      "transliteration": "maanahu mahaakaal ghan garaje ||308||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਪਰਲੋ ਕਾਲ (ਮਹਾਕਾਲ) ਦੇ ਬਦਲ ਗਰਜ ਰਹੇ ਹੋਣ ॥੩੦੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "मानहु महाकाल घन गरजे ॥३०८॥",
      "sourceLineId": "139760",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਆਨਿ ਕਾਲ ਕਹ ਕਰਤ ਪ੍ਰਹਾਰਾ ॥",
      "transliteration": "aan kaal keh karat prahaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਕ ਇਕ ਸੂਰਮਾ ਹਜ਼ਾਰਾ ਹਥਿਆਰ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "आनि काल कह करत प्रहारा ॥",
      "sourceLineId": "139761",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1380_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਇਕ ਇਕ ਸੂਰ ਸਹਸ ਹਥਿਯਾਰਾ ॥",
      "transliteration": "eik ik soor sahas hathiyaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਉਤੇ ਹਮਲਾ ਕਰ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1380,
      "hindi": "",
      "hindiTransliteration": "इक इक सूर सहस हथियारा ॥",
      "sourceLineId": "139762",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
