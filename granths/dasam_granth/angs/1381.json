{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1381,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1381_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕਹ ਲਗਤ ਨ ਭਏ ॥",
      "transliteration": "mahaa kaal keh lagat na bhe ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਮਹਾ ਕਾਲ ਨੂੰ ਕੋਈ ਲਗ ਨਹੀਂ ਰਿਹਾ ਸੀ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "महा काल कह लगत न भए ॥",
      "sourceLineId": "139763",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਾ ਮਹਿ ਸਭੈ ਲੀਨ ਹ੍ਵੈ ਗਏ ॥੩੦੯॥",
      "transliteration": "taa meh sabhai leen havai ge ||309||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ ਮਹਾ ਕਾਲ ਵਿਚ ਲੀਨ ਹੋ ਗਏ ਸਨ ॥੩੦੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "ता महि सभै लीन ह्वै गए ॥३०९॥",
      "sourceLineId": "139764",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਸਤ੍ਰ ਲੀਨ ਲਖਿ ਅਸੁਰ ਰਿਸਾਨੇ ॥",
      "transliteration": "sasatr leen lakh asur risaane ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ਸਤ੍ਰਾ ਨੂੰ (ਮਹਾ ਕਾਲ ਵਿਚ) ਲੀਨ ਹੁੰਦਾ ਵੇਖ ਕੇ ਦੈਂਤ ਬਹੁਤ ਰੋਹ ਵਿਚ ਆ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "ससत्र लीन लखि असुर रिसाने ॥",
      "sourceLineId": "139765",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਸਤ੍ਰ ਅਸਤ੍ਰ ਲੈ ਕੋਪਿ ਸਿਧਾਨੇ ॥",
      "transliteration": "sasatr asatr lai kop sidhaane ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਸਤ੍ਰਾ ਸ਼ਸਤ੍ਰਾ ਨੂੰ ਲੈ ਕੇ ਗੁੱਸੇ ਵਿਚ ਚਲ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "ससत्र असत्र लै कोपि सिधाने ॥",
      "sourceLineId": "139766",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਮਿਤ ਕੋਪ ਕਰਿ ਸਸਤ੍ਰ ਪ੍ਰਹਾਰਤ ॥",
      "transliteration": "amit kop kar sasatr prahaarat ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਗੁੱਸਾ ਕਰ ਕੇ ਹਥਿਆਰ ਚਲਾਉਾਂਦੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "अमित कोप करि ससत्र प्रहारत ॥",
      "sourceLineId": "139767",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਦਿਸਿ ਦਸੌ ਪੁਕਾਰਤ ॥੩੧੦॥",
      "transliteration": "maar maar dhis dhasau pukaarat ||310||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦਸਾ ਦਿਸ਼ਾਵਾ ਵਿਚ 'ਮਾਰੋ ਮਾਰੋ' ਪੁਕਾਰਦੇ ਸਨ ॥੩੧੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "मारि मारि दिसि दसौ पुकारत ॥३१०॥",
      "sourceLineId": "139768",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਕੀ ਸੁਨਿ ਧੁਨਿ ਕਾਨਾ ॥",
      "transliteration": "maar maar kee sun dhun kaanaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰੋ ਮਾਰੋ' ਦੀ ਧੁਨੀ ਕੰਨਾ ਨਾਲ ਸੁਣ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "मारि मारि की सुनि धुनि काना ॥",
      "sourceLineId": "139769",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕੋਪਾ ਕਾਲ ਸਸਤ੍ਰ ਗਹਿ ਨਾਨਾ ॥",
      "transliteration": "kopaa kaal sasatr geh naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਾਲ ਬਹੁਤ ਤਰ੍ਰਹਾ ਦੇ ਸ਼ਸਤ੍ਰ ਪਕੜ ਕੇ ਕ੍ਰੋਧਿਤ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "कोपा काल ससत्र गहि नाना ॥",
      "sourceLineId": "139770",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਾਕਿ ਹਾਕਿ ਹਥਿਯਾਰ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "haak haak hathiyaar prahaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਲਲਕਾਰੇ ਮਾਰ ਮਾਰ ਕੇ ਹਥਿਆਰ ਚਲਾਏ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "हाकि हाकि हथियार प्रहारे ॥",
      "sourceLineId": "139771",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦਸਟ ਅਨਿਕ ਪਲ ਬੀਚ ਸੰਘਾਰੇ ॥੩੧੧॥",
      "transliteration": "dhasaT anik pal beech sa(n)ghaare ||311||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਨੇਕ ਦੁਸ਼ਟਾ ਨੂੰ ਪਲ ਵਿਚ ਖ਼ਤਮ ਕਰ ਦਿੱਤਾ ॥੩੧੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "दसट अनिक पल बीच संघारे ॥३११॥",
      "sourceLineId": "139772",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਿਨ ਤੇ ਮੇਦ ਮਾਸ ਜੋ ਪਰੋ ॥",
      "transliteration": "tin te medh maas jo paro ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦਾ ਜੋ ਮਾਸ ਅਤੇ ਮਿਝ ਧਰਤੀ ਉਤੇ ਡਿਗੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "तिन ते मेद मास जो परो ॥",
      "sourceLineId": "139773",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਾ ਤੇ ਬਹੁ ਅਸੁਰਨ ਤਨ ਧਰੋ ॥",
      "transliteration": "taa te bahu asuran tan dharo ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਤੋਂ ਬਹੁਤ ਸਾਰੇ ਦੈਂਤਾ ਨੇ ਸ਼ਰੀਰ ਧਾਰਨ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "ता ते बहु असुरन तन धरो ॥",
      "sourceLineId": "139774",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਕਹਿ ਸਮੁਹਿ ਸਿਧਾਏ ॥",
      "transliteration": "maar maar keh samuh sidhaae ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਰੋ ਮਾਰੋ' ਕਰਦੇ ਅਤੇ ਉਮੰਗ ਨਾਲ ਛਾਲਾ ਮਾਰਦੇ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "मारि मारि कहि समुहि सिधाए ॥",
      "sourceLineId": "139775",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਾਧੇ ਚੁੰਗ ਚੌਪਿ ਤਨ ਆਏ ॥੩੧੨॥",
      "transliteration": "baadhe chu(n)g chauap tan aae ||312||",
      "translation": "",
      "punjabiViakhya": "ਟੋਲੇ ਬਣਾ ਕੇ ਸਾਹਮਣੇ ਆ ਢੁਕੇ ॥੩੧੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "बाधे चुँग चौपि तन आए ॥३१२॥",
      "sourceLineId": "139776",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਕ ਇਕ ਟੂਕ ਸਹਸ ਕਰਿ ਡਾਰੇ ॥",
      "transliteration": "eik ik Took sahas kar ddaare ||",
      "translation": "",
      "punjabiViakhya": "(ਮਹਾ ਕਾਲ ਨੇ) ਇਕ ਇਕ ਦੇ ਹਜ਼ਾਰਾ ਟੁਕੜੇ ਕਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "इक इक टूक सहस करि डारे ॥",
      "sourceLineId": "139777",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਿਨ ਤੇ ਭਏ ਅਸੁਰ ਰਨ ਭਾਰੇ ॥",
      "transliteration": "tin te bhe asur ran bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਤੋਂ ਰਣ ਵਿਚ ਭਾਰੀ ਦੈਂਤ ਪੈਦਾ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "तिन ते भए असुर रन भारे ॥",
      "sourceLineId": "139778",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਿਨ ਕੇ ਟੂਕ ਟੂਕ ਕਰਿ ਲਛਨ ॥",
      "transliteration": "tin ke Took Took kar lachhan ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਲੱਖਾ ਟੁਕੜੇ ਕਰ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "तिन के टूक टूक करि लछन ॥",
      "sourceLineId": "139779",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੀਧ ਪਿਸਾਚ ਗਏ ਕਰਿ ਭਛਨ ॥੩੧੩॥",
      "transliteration": "geedh pisaach ge kar bhachhan ||313||",
      "translation": "",
      "punjabiViakhya": "ਗਿੱਧਾ ਅਤੇ ਪਿਸਾਚ ਖਾ ਗਏ ॥੩੧੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "गीध पिसाच गए करि भछन ॥३१३॥",
      "sourceLineId": "139780",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤੇ ਭੀ ਅਮਿਤ ਰੂਪ ਕਰਿ ਧਾਏ ॥",
      "transliteration": "te bhee amit roop kar dhaae ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸੂਰਮੇ ਤਿਲ ਤਿਲ ਕਰ ਕੇ ਸੁਟ ਦਿੱਤੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "ते भी अमित रूप करि धाए ॥",
      "sourceLineId": "139781",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੇ ਤਿਲ ਤਿਲ ਕਰਿ ਸੁਭਟ ਗਿਰਾਏ ॥",
      "transliteration": "je til til kar subhaT giraae ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵੀ ਅਮਿਤ ਰੂਪ ਧਾਰ ਕੇ ਚੜ੍ਰਹ ਪਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "जे तिल तिल करि सुभट गिराए ॥",
      "sourceLineId": "139782",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਿਨ ਕੀ ਕਰੀ ਨਾਸ ਸਭ ਸੈਨਾ ॥",
      "transliteration": "tin kee karee naas sabh sainaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨੇ ਉਨ੍ਰਹਾ ਦਾ ਜ਼ਰਾ ਜਿੰਨਾ ਵੀ ਡਰ ਨਾ ਮੰਨ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "तिन की करी नास सभ सैना ॥",
      "sourceLineId": "139783",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕਰ ਰੰਚਕ ਭੈ ਨਾ ॥੩੧੪॥",
      "transliteration": "mahaa kaal kar ra(n)chak bhai naa ||314||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੀ) ਸਾਰੀ ਸੈਨਾ ਨਸ਼ਟ ਕਰ ਦਿੱਤੀ ॥੩੧੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "महा काल कर रंचक भै ना ॥३१४॥",
      "sourceLineId": "139784",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਜੋਧਾ ਕਹੂੰ ਗਾਜਹਿ ॥",
      "transliteration": "maar maar jodhaa kahoo(n) gaajeh ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਯੋਧੇ 'ਮਾਰੋ ਮਾਰੋ' (ਪੁਕਾਰ ਕੇ) ਗਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "मारि मारि जोधा कहूँ गाजहि ॥",
      "sourceLineId": "139785",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੰਬੁਕ ਗੀਧ ਮਾਸ ਲੈ ਭਾਜਹਿ ॥",
      "transliteration": "ja(n)buk geedh maas lai bhaajeh ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਕਿਤੇ) ਗਿਦੜ ਅਤੇ ਗਿੱਧਾ ਮਾਸ ਲੈ ਕੇ ਭਜ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "जंबुक गीध मास लै भाजहि ॥",
      "sourceLineId": "139786",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰੇਤ ਪਿਸਾਚ ਕਹੂੰ ਕਿਲਕਾਰਹਿ ॥",
      "transliteration": "pret pisaach kahoo(n) kilakaareh ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਪ੍ਰੇਤ ਅਤੇ ਪਿਸ਼ਾਚ ਚੀਖ਼ਾ ਮਾਰਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "प्रेत पिसाच कहूँ किलकारहि ॥",
      "sourceLineId": "139787",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਡਾਕਨਿ ਝਾਕਿ ਕਿਲਕਟੀ ਮਾਰਹਿ ॥੩੧੫॥",
      "transliteration": "ddaakan jhaak kilakaTee maareh ||315||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਡਾਕਣੀਆਂ ਅਤੇ ਵੱਡੀਆਂ ਇਲਾ ('ਝਾਕਿ' ਗਿਰਝਾ) ਕਿਲਕਾਰੀਆਂ ਮਾਰਦੀਆਂ ਸਨ ॥੩੧੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "डाकनि झाकि किलकटी मारहि ॥३१५॥",
      "sourceLineId": "139788",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕੋਕਿਲ ਕਾਕ ਜਹਾ ਕਿਲਕਾਰਹਿ ॥",
      "transliteration": "kokil kaak jahaa kilakaareh ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਥੇ ਕੋਇਲਾ ਅਤੇ ਕਾ ਕਿਲਕਾਰਦੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "कोकिल काक जहा किलकारहि ॥",
      "sourceLineId": "139789",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸ੍ਰੋਨਤ ਕੇ ਕੇਸਰ ਘਸਿ ਡਾਰਹਿ ॥",
      "transliteration": "sronat ke kesar ghas ddaareh ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਲਹੂ ਦਾ ਕੇਸਰ ਘਿਸਾ ਕੇ ਪਾਇਆ ਜਾ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "स्रोनत के केसर घसि डारहि ॥",
      "sourceLineId": "139790",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾਨੁਕ ਢੋਲ ਬਡੇ ਡਫ ਸੋਹੈ ॥",
      "transliteration": "jaanuk ddol badde ddaf sohai ||",
      "translation": "",
      "punjabiViakhya": "ਵੱਡੇ ਢੋਲ ਮਾਨੋ ਡਫਲੀਆਂ ਵਾਗ ਸ਼ੋਭ ਰਹੇ ਹੋਣ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "जानुक ढोल बडे डफ सोहै ॥",
      "sourceLineId": "139791",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੇਵ ਦੈਤ ਦਾਨਵ ਮਨ ਮੋਹੈ ॥੩੧੬॥",
      "transliteration": "dhev dhait dhaanav man mohai ||316||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੇਵਤਿਆਂ ਤੇ ਦੈਂਤਾ ਦਾ ਮਨ ਮੋਹ ਰਹੇ ਹੋਣ ॥੩੧੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "देव दैत दानव मन मोहै ॥३१६॥",
      "sourceLineId": "139792",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਾਨ ਜਾਨ ਕੁੰਕਮਾ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "baan jaan ku(n)kamaa prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਬਾਣ ਮਾਨੋ ਕੇਸਰ ਭਰੇ ਲਾਖ ਦੇ ਗੋਲੇ ਹੋਣ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "बान जान कुँकमा प्रहारे ॥",
      "sourceLineId": "139793",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੂਠਿ ਗੁਲਾਲਨ ਬਰਛਾ ਭਾਰੇ ॥",
      "transliteration": "mooTh gulaalan barachhaa bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਰੇ ਬਰਛੇ ਮਾਨੋ ਗੁਲਾਲ ਦੀ ਮੁੱਠੀ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "मूठि गुलालन बरछा भारे ॥",
      "sourceLineId": "139794",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਢਾਲ ਮਨੋ ਡਫਮਾਲਾ ਬਨੀ ॥",
      "transliteration": "ddaal mano ddafamaalaa banee ||",
      "translation": "",
      "punjabiViakhya": "ਢਾਲਾ ਮਾਨੋ ਡਫਲੀਆਂ ਬਣੀਆਂ ਹੋਣ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "ढाल मनो डफमाला बनी ॥",
      "sourceLineId": "139795",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਿਚਕਾਰਿਯੈ ਤੁਫੰਗੈ ਘਨੀ ॥੩੧੭॥",
      "transliteration": "pichakaariyai tufa(n)gai ghanee ||317||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬੰਦੂਕਾ ਮਾਨੋ ਬਹੁਤ ਸਾਰੀਆਂ ਪਿਚਕਾਰੀਆਂ ਬਣੀਆਂ ਹੋਣ ॥੩੧੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "पिचकारियै तुफंगै घनी ॥३१७॥",
      "sourceLineId": "139796",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਭਯੋ ਘੋਰ ਸੰਗ੍ਰਾਮਾ ॥",
      "transliteration": "eeh bidh bhayo ghor sa(n)graamaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦਾ ਘੋਰ ਯੁੱਧ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "इह बिधि भयो घोर संग्रामा ॥",
      "sourceLineId": "139797",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਾਪਾ ਇੰਦ੍ਰ ਚੰਦ੍ਰ ਕੋ ਧਾਮਾ ॥",
      "transliteration": "kaapaa i(n)dhr cha(n)dhr ko dhaamaa ||",
      "translation": "",
      "punjabiViakhya": "ਇੰਦਰ ਤੇ ਚੰਦ੍ਰ ਦੇ ਲੋਕ ਕੰਬ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "कापा इंद्र चंद्र को धामा ॥",
      "sourceLineId": "139798",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਸੁ ਪੰਛੀ ਅਤਿ ਹੀ ਅਕੁਲਾਏ ॥",
      "transliteration": "pas pa(n)chhee at hee akulaae ||",
      "translation": "",
      "punjabiViakhya": "ਪਸ਼ੂ ਅਤੇ ਪੰਛੀ ਵੀ ਬਹੁਤ ਵਿਆਕੁਲ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "पसु पंछी अति ही अकुलाए ॥",
      "sourceLineId": "139799",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਛੋਡਿ ਧਾਮ ਕਾਨਨਹਿ ਸਿਧਾਏ ॥੩੧੮॥",
      "transliteration": "chhodd dhaam kaananeh sidhaae ||318||",
      "translation": "",
      "punjabiViakhya": "ਘਰਾ ਨੂੰ ਛਡ ਕੇ ਜੰਗਲ ਵਲ ਭਜ ਗਏ ॥੩੧੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "छोडि धाम काननहि सिधाए ॥३१८॥",
      "sourceLineId": "139800",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਾਜੀ ਕਹੂੰ ਘਾਇਲ ਭਭਕਾਵਤ ॥",
      "transliteration": "baajee kahoo(n) ghail bhabhakaavat ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘਾਇਲ ਘੋੜੇ ਭਭਕ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "बाजी कहूँ घाइल भभकावत ॥",
      "sourceLineId": "139801",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਉਠਿ ਉਠਿ ਸੁਭਟ ਸਮੁਹ ਕਹ ਧਾਵਤ ॥",
      "transliteration": "auTh uTh subhaT samuh keh dhaavat ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਸੂਰਮੇ ਉਠ ਉਠ ਕੇ ਸਾਹਮਣੇ ਹੋ ਕੇ ਧਾਵਾ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "उठि उठि सुभट समुह कह धावत ॥",
      "sourceLineId": "139802",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਹਕਹਾਟ ਕਹੂੰ ਕਾਲ ਸੁਨਾਵੈ ॥",
      "transliteration": "kahakahaaT kahoo(n) kaal sunaavai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕਾਲ ਦਾ ਡਰਾਉਣਾ ਹਾਸਾ ਸੁਣਾਈ ਦੇ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "कहकहाट कहूँ काल सुनावै ॥",
      "sourceLineId": "139803",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭੀਖਨ ਸੁਨੇ ਨਾਮ ਭੈ ਆਵੈ ॥੩੧੯॥",
      "transliteration": "bheekhan sune naam bhai aavai ||319||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ) ਭਿਆਨਕ ਨਾ ਸੁਣ ਕੇ ਹੀ ਡਰ ਲਗਦਾ ਸੀ ॥੩੧੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "भीखन सुने नाम भै आवै ॥३१९॥",
      "sourceLineId": "139804",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੂਰਨ ਕੇ ਲੋਮਾ ਭੇ ਖਰੇ ॥",
      "transliteration": "sooran ke lomaa bhe khare ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮਿਆਂ ਦੇ ਰੋਮ ਖੜੇ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "सूरन के लोमा भे खरे ॥",
      "sourceLineId": "139805",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਾਤਰ ਨਿਰਖਿ ਧਾਮ ਰਨ ਬਰੇ ॥",
      "transliteration": "kaatar nirakh dhaam ran bare ||",
      "translation": "",
      "punjabiViakhya": "ਡਰਪੋਕ ਵੇਖ ਕੇ ਘਰਾ ਵਿਚ ਜਾ ਵੜੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "कातर निरखि धाम रन बरे ॥",
      "sourceLineId": "139806",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੋਫੀ ਸੂਮ ਭਏ ਬਹੁ ਬ੍ਯਾਕੁਲ ॥",
      "transliteration": "sofee soom bhe bahu bayaakul ||",
      "translation": "",
      "punjabiViakhya": "ਸੋਫ਼ੀ ਅਤੇ ਸੂਮ ਬਹੁਤ ਵਿਆਕੁਲ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "सोफी सूम भए बहु ब्याकुल ॥",
      "sourceLineId": "139807",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦਸੋ ਦਿਸਨ ਭਜਿ ਚਲੇ ਡਰਾਕੁਲ ॥੩੨੦॥",
      "transliteration": "dhaso dhisan bhaj chale ddaraakul ||320||",
      "translation": "",
      "punjabiViakhya": "ਡਰਾਕੁਲ ਦਸਾ ਦਿਸ਼ਾਵਾ ਵਲ ਭਜ ਚਲੇ ॥੩੨੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "दसो दिसन भजि चले डराकुल ॥३२०॥",
      "sourceLineId": "139808",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕੇਤਿਕ ਸੁਭਟ ਪਾਵ ਤੇ ਰੋਪੈ ॥",
      "transliteration": "ketik subhaT paav te ropai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਸੂਰਮਿਆਂ ਨੇ ਪੈਰ ਗਡ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "केतिक सुभट पाव ते रोपै ॥",
      "sourceLineId": "139809",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1381_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਲੈ ਲੈ ਖੜਗ ਨਗਨ ਕਰਿ ਧੋਪੈ ॥",
      "transliteration": "lai lai khaRag nagan kar dhopai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੱਥਾ ਵਿਚ ਨੰਗੀਆਂ ਖੜਗਾ ਅਤੇ ਸਿਧੀਆਂ ਤਲਵਾਰਾ ਲੈ ਕੇ (ਘੁੰਮਾਣ ਲਗੇ)।",
      "source": "DASAM_GRANTH",
      "ang": 1381,
      "hindi": "",
      "hindiTransliteration": "लै लै खड़ग नगन करि धोपै ॥",
      "sourceLineId": "139810",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
