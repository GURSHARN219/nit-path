{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1382,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1382_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕੁਪਿ ਸਸਤ੍ਰ ਪ੍ਰਹਾਰੈ ॥",
      "transliteration": "mahaa kaal kup sasatr prahaarai ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਨੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਸ਼ਸਤ੍ਰਾ ਦੇ ਵਾਰ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "महा काल कुपि ससत्र प्रहारै ॥",
      "sourceLineId": "139811",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਧ ਉਬਾਰਿ ਦੁਸਟ ਸਭ ਮਾਰੇ ॥੩੨੧॥",
      "transliteration": "saadh ubaar dhusaT sabh maare ||321||",
      "translation": "",
      "punjabiViakhya": "ਸਾਧਾ ਨੂੰ ਬਚਾ ਲਿਆ ਅਤੇ ਸਾਰਿਆਂ ਦੁਸ਼ਟਾ ਨੂੰ ਮਾਰ ਦਿੱਤਾ ॥੩੨੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "साध उबारि दुसट सभ मारे ॥३२१॥",
      "sourceLineId": "139812",
      "sourceShabadId": "12789",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭੁਜੰਗ ਛੰਦ ॥",
      "transliteration": "bhuja(n)g chha(n)dh ||",
      "translation": "",
      "punjabiViakhya": "ਭੁਜੰਗ ਛੰਦ:",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "भुजंग छंद ॥",
      "sourceLineId": "139813",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਚੇ ਆਨਿ ਮੈਦਾਨ ਮੈ ਬੀਰ ਭਾਰੇ ॥",
      "transliteration": "mache aan maidhaan mai beer bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਬਲਵਾਨ ਸੂਰਮੇ ਡਟ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "मचे आनि मैदान मै बीर भारे ॥",
      "sourceLineId": "139814",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦਿਖੈ ਕੌਨ ਜੀਤੈ ਦਿਖੈ ਕੌਨ ਹਾਰੇ ॥",
      "transliteration": "dhikhai kauan jeetai dhikhai kauan haare ||",
      "translation": "",
      "punjabiViakhya": "ਵੇਖਦੇ ਹਾ, ਕੌਣ ਜਿਤਦਾ ਹੈ ਅਤੇ ਕੌਣ ਹਾਰਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "दिखै कौन जीतै दिखै कौन हारे ॥",
      "sourceLineId": "139815",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲਏ ਸੂਲ ਔ ਸੇਲ ਕਾਤੀ ਕਟਾਰੀ ॥",
      "transliteration": "le sool aau sel kaatee kaTaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਹੱਥਾ ਵਿਚ) ਤ੍ਰਿਸੂਲ, ਬਰਛੇ, ਕਾਤੀਆਂ ਅਤੇ ਕਟਾਰਾ ਲੈ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "लए सूल औ सेल काती कटारी ॥",
      "sourceLineId": "139816",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚਹੂੰ ਓਰ ਗਾਜੇ ਹਠੀ ਬੀਰ ਭਾਰੀ ॥੩੨੨॥",
      "transliteration": "chahoo(n) or gaaje haThee beer bhaaree ||322||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸਿਆਂ ਵਿਚ ਹਠੀਲੇ ਸੂਰਮੇ ਗਜਣ ਲਗੇ ॥੩੨੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओर गाजे हठी बीर भारी ॥३२२॥",
      "sourceLineId": "139817",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਜੇ ਘੋਰ ਸੰਗ੍ਰਾਮ ਮੋ ਘੋਰ ਬਾਜੇ ॥",
      "transliteration": "baje ghor sa(n)graam mo ghor baaje ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਭਿਆਨਕ ਯੁੱਧ ਵਿਚ ਘੋਰ ਵਾਜੇ ਵਜਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "बजे घोर संग्राम मो घोर बाजे ॥",
      "sourceLineId": "139818",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚਹੂੰ ਓਰ ਬਾਕੇ ਰਥੀ ਬੀਰ ਗਾਜੇ ॥",
      "transliteration": "chahoo(n) or baake rathee beer gaaje ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਹਾ ਪਾਸੇ ਰਥਾ ਵਾਲੇ ਬਾਕੇ ਸੂਰਮੇ ਗਜਣ ਲਗੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "चहूँ ओर बाके रथी बीर गाजे ॥",
      "sourceLineId": "139819",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਲਏ ਸੂਲ ਔ ਸੇਲ ਕਾਤੀ ਕਟਾਰੇ ॥",
      "transliteration": "le sool aau sel kaatee kaTaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ ਹੱਥ ਵਿਚ) ਤ੍ਰਿਸ਼ੂਲ, ਬਰਛੇ, ਕਾਤੀਆਂ ਅਤੇ ਕਟਾਰਾ ਲਈਆਂ ਹੋਈਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "लए सूल औ सेल काती कटारे ॥",
      "sourceLineId": "139820",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਚੇ ਕੋਪ ਕੈ ਕੈ ਹਠੀਲੇ ਰਜ੍ਰਯਾਰੇ ॥੩੨੩॥",
      "transliteration": "mache kop kai kai haTheele rajrayaare ||323||",
      "translation": "",
      "punjabiViakhya": "ਹਠੀਲੇ ਰਜਵਾੜੇ ਕ੍ਰੋਧਿਤ ਹੋ ਕੇ ਜੰਗ ਮਚਾ ਰਹੇ ਸਨ ॥੩੨੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "मचे कोप कै कै हठीले रज्रयारे ॥३२३॥",
      "sourceLineId": "139821",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਹੂੰ ਧੂਲਧਾਨੀ ਛੁਟੈ ਫੀਲ ਨਾਲੈ ॥",
      "transliteration": "kahoo(n) dhooladhaanee chhuTai feel naalai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਲੰਮੀਆਂ ਬੰਦੂਕਾ ਅਤੇ ਹਾਥੀਆਂ ਨਾਲ ਖਿਚੀਆਂ ਜਾਣ ਵਾਲੀਆਂ ਤੋਪਾ ਚਲ ਰਹੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "कहूँ धूलधानी छुटै फील नालै ॥",
      "sourceLineId": "139822",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਹੂੰ ਬਾਜ ਨਾਲੈ ਮਹਾ ਘੋਰ ਜ੍ਵਾਲੈ ॥",
      "transliteration": "kahoo(n) baaj naalai mahaa ghor javaiaalai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਘੋੜਿਆਂ ਦੁਆਰਾ ਖਿਚੀਆਂ ਜਾਣ ਵਾਲੀ ਤੋਪਾ ਅਗਨੀ ਉਗਲ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "कहूँ बाज नालै महा घोर ज्वालै ॥",
      "sourceLineId": "139823",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਹੂੰ ਸੰਖ ਭੇਰੀ ਪ੍ਰਣੋ ਢੋਲ ਬਾਜੈ ॥",
      "transliteration": "kahoo(n) sa(n)kh bheree prano ddol baajai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੰਖ, ਭੇਰੀਆਂ, ਪ੍ਰਣੋ (ਛੋਟੇ ਢੋਲ) ਅਤੇ ਢੋਲ ਵਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "कहूँ संख भेरी प्रणो ढोल बाजै ॥",
      "sourceLineId": "139824",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਹੂੰ ਸੂਰ ਠੋਕੈ ਭੁਜਾ ਭੂਪ ਗਾਜੈ ॥੩੨੪॥",
      "transliteration": "kahoo(n) soor Thokai bhujaa bhoop gaajai ||324||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਮੇ ਡੌਲਿਆਂ ਉਤੇ ਹੱਥ ਮਾਰ ਰਹੇ ਸਨ ਅਤੇ (ਕਿਤੇ) ਰਾਜੇ ਗਜ ਰਹੇ ਸਨ ॥੩੨੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "कहूँ सूर ठोकै भुजा भूप गाजै ॥३२४॥",
      "sourceLineId": "139825",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਹੂੰ ਘੋਰ ਬਾਦਿਤ੍ਰ ਬਾਜੈ ਨਗਾਰੇ ॥",
      "transliteration": "kahoo(n) ghor baadhitr baajai nagaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘੋਰ ਵਾਜੇ ਅਤੇ ਨਗਾਰੇ ਵਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "कहूँ घोर बादित्र बाजै नगारे ॥",
      "sourceLineId": "139826",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੂੰ ਬੀਰ ਬਾਜੀ ਗਿਰੇ ਖੇਤ ਮਾਰੇ ॥",
      "transliteration": "kahoo(n) beer baajee gire khet maare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਮਾਰੇ ਹੋਏ ਸੂਰਮੇ ਅਤੇ ਘੋੜੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਡਿਗੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "कहूँ बीर बाजी गिरे खेत मारे ॥",
      "sourceLineId": "139827",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹੂੰ ਖੇਤ ਨਾਚੈ ਪਠੇ ਪਖਰਾਰੇ ॥",
      "transliteration": "kahoo(n) khet naachai paThe pakharaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਯੁੱਧ-ਖੇਤਰ ਵਿਚ ਜਵਾਨ ਘੋੜ-ਸਵਾਰ ਨਚ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "कहूँ खेत नाचै पठे पखरारे ॥",
      "sourceLineId": "139828",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਹੂੰ ਸੂਰ ਸੰਗ੍ਰਾਮ ਸੋਹੈ ਡਰਾਰੇ ॥੩੨੫॥",
      "transliteration": "kahoo(n) soor sa(n)graam sohai ddaraare ||325||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਭਿਆਨਕ ਸੂਰਮੇ ਯੁੱਧ-ਸਥਲ ਵਿਚ ਸ਼ੋਭ ਰਹੇ ਸਨ ॥੩੨੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "कहूँ सूर संग्राम सोहै डरारे ॥३२५॥",
      "sourceLineId": "139829",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਹੂ ਬਾਜ ਮਾਰੇ ਕਹੂੰ ਝੂਮ ਹਾਥੀ ॥",
      "transliteration": "kahoo baaj maare kahoo(n) jhoom haathee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘੋੜੇ ਮਰੇ ਪਏ ਸਨ ਅਤੇ ਕਿਤੇ ਹਾਥੀ ਘੁੰਮੇਰੀ ਖਾ ਕੇ (ਡਿਗੇ ਪਏ ਸਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "कहू बाज मारे कहूँ झूम हाथी ॥",
      "sourceLineId": "139830",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਹੂੰ ਫੈਟ ਭਾਥੀ ਜੁਝੇ ਬਾਧਿ ਸਾਥੀ ॥",
      "transliteration": "kahoo(n) faiT bhaathee jujhe baadh saathee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਲਕ ਨਾਲ ਬੰਨ੍ਰਹੇ ਹੋਏ ਭਥਿਆਂ ਵਾਲੇ ਸੂਰਮੇ ਮਰੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "कहूँ फैट भाथी जुझे बाधि साथी ॥",
      "sourceLineId": "139831",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹੂੰ ਗਰਜਿ ਠੋਕੈ ਭੁਜਾ ਭੂਪ ਭਾਰੇ ॥",
      "transliteration": "kahoo(n) garaj Thokai bhujaa bhoop bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭਾਰੀ ਭੂਪ ਆਪਣੀਆਂ ਭੁਜਾਵਾ ਨੂੰ ਠੋਕ ਕੇ ਗਰਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "कहूँ गरजि ठोकै भुजा भूप भारे ॥",
      "sourceLineId": "139832",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਮੈ ਸ੍ਰੋਨ ਕੇਤੇ ਗਿਰੇ ਖੇਤ ਮਾਰੇ ॥੩੨੬॥",
      "transliteration": "bamai sron kete gire khet maare ||326||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਸੂਰਮੇ ਯੁੱਧ-ਖੇਤਰ ਵਿਚ ਮਰੇ ਪਏ ਸਨ ਅਤੇ (ਉਨ੍ਰਹਾ ਦੇ ਜ਼ਖ਼ਮਾ ਵਿਚੋਂ) ਲਹੂ ਨਿਕਲ ਰਿਹਾ ਸੀ ॥੩੨੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "बमै स्रोन केते गिरे खेत मारे ॥३२६॥",
      "sourceLineId": "139833",
      "sourceShabadId": "12790",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "139834",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਅਸੁਰ ਜਬੈ ਚੁਨਿ ਮਾਰੇ ॥",
      "transliteration": "eeh bidh asur jabai chun maare ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਜਦੋਂ ਦੈਂਤਾ ਨੂੰ ਚੁਣ ਚੁਣ ਕੇ ਮਾਰ ਦਿੱਤਾ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "इह बिधि असुर जबै चुनि मारे ॥",
      "sourceLineId": "139835",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਮਿਤ ਰੋਸ ਕਰਿ ਔਰ ਸਿਧਾਰੇ ॥",
      "transliteration": "amit ros kar aauar sidhaare ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦੋਂ) ਬਹੁਤ ਕ੍ਰੋਧਵਾਨ ਹੋ ਕੇ ਹੋਰ ਆ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "अमित रोस करि और सिधारे ॥",
      "sourceLineId": "139836",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਾਧੇ ਫੈਟ ਬਿਰਾਜੈ ਭਾਥੀ ॥",
      "transliteration": "baadhe faiT biraajai bhaathee ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਲਕ ਨਾਲ ਭੱਥਾ ਬੰਨ੍ਰਹ ਕੇ ਸ਼ੋਭ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "बाधे फैट बिराजै भाथी ॥",
      "sourceLineId": "139837",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਆਗੇ ਚਲੇ ਅਮਿਤ ਧਰਿ ਹਾਥੀ ॥੩੨੭॥",
      "transliteration": "aage chale amit dhar haathee ||327||",
      "translation": "",
      "punjabiViakhya": "ਬੇਸ਼ੁਮਾਰ ਯੋਧੇ ਹਾਥੀਆਂ ਨੂੰ ਅਗੇ ਕਰ ਕੇ ਚਲ ਰਹੇ ਸਨ ॥੩੨੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "आगे चले अमित धरि हाथी ॥३२७॥",
      "sourceLineId": "139838",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਾਥ ਲਏ ਅਨਗਨ ਪਖਰਾਰੇ ॥",
      "transliteration": "saath le anagan pakharaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੇ) ਆਪਣੇ ਨਾਲ ਬਹੁਤ ਸਾਰੇ ਘੋੜ-ਸਵਾਰ ਲਏ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "साथ लए अनगन पखरारे ॥",
      "sourceLineId": "139839",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਉਮਡਿ ਚਲੇ ਦੈ ਢੋਲ ਨਗਾਰੇ ॥",
      "transliteration": "aumadd chale dhai ddol nagaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਢੋਲ ਅਤੇ ਨਗਾਰੇ ਵਜਾਉਾਂਦੇ ਹੋਏ ਉਮਡ ਕੇ ਚਲ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "उमडि चले दै ढोल नगारे ॥",
      "sourceLineId": "139840",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੰਖ ਝਾਝ ਅਰੁ ਢੋਲ ਬਜਾਇ ॥",
      "transliteration": "sa(n)kh jhaajh ar ddol bajai ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਸੰਖ, ਝਾਝ ਅਤੇ ਢੋਲ ਵਜਾਉਾਂਦੇ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "संख झाझ अरु ढोल बजाइ ॥",
      "sourceLineId": "139841",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਮਕਿ ਚਲੇ ਚੌਗੁਨ ਕਰਿ ਚਾਇ ॥੩੨੮॥",
      "transliteration": "chamak chale chauagun kar chai ||328||",
      "translation": "",
      "punjabiViakhya": "ਚੌਗੁਣੇ ਉਤਸਾਹ ਨਾਲ ਚਲ ਪਏ ਸਨ ॥੩੨੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "चमकि चले चौगुन करि चाइ ॥३२८॥",
      "sourceLineId": "139842",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਡਵਰੂ ਕਹੂੰ ਗੁੜਗੁੜੀ ਬਾਜੈ ॥",
      "transliteration": "ddavaroo kahoo(n) guRaguRee baajai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਡੌਰੂ ਅਤੇ ਕਿਤੇ ਡੁਗਡੁਗੀ ਵਜ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "डवरू कहूँ गुड़गुड़ी बाजै ॥",
      "sourceLineId": "139843",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਠੋਕਿ ਭੁਜਾ ਰਨ ਮੋ ਭਟ ਗਾਜੈ ॥",
      "transliteration": "Thok bhujaa ran mo bhaT gaajai ||",
      "translation": "",
      "punjabiViakhya": "ਯੋਧੇ ਭੁਜਾਵਾ ਨੂੰ ਠੋਕ ਕੇ ਰਣ ਵਿਚ ਗਜ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "ठोकि भुजा रन मो भट गाजै ॥",
      "sourceLineId": "139844",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮੁਰਜ ਉਪੰਗ ਮੁਰਲਿਯੈ ਘਨੀ ॥",
      "transliteration": "muraj upa(n)g muraliyai ghanee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਬਹੁਤ ਮੁਰਜ, ਉਪੰਗ ਅਤੇ ਮੁਰਲੀਆਂ (ਵਜ ਰਹੀਆਂ ਸਨ)।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "मुरज उपंग मुरलियै घनी ॥",
      "sourceLineId": "139845",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭੇਰ ਝਾਜ ਬਾਜੈ ਰੁਨਝੁਨੀ ॥੩੨੯॥",
      "transliteration": "bher jhaaj baajai runajhunee ||329||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਭੇਰੀਆਂ ਤੇ ਝਾਝਾ ਨੇ ਰੁਣਝੁਣ ਲਗਾਈ ਹੋਈ ਸੀ ॥੩੨੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "भेर झाज बाजै रुनझुनी ॥३२९॥",
      "sourceLineId": "139846",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਹੀ ਤੂੰਬਰੇ ਬਜੈ ਅਪਾਰਾ ॥",
      "transliteration": "kahee too(n)bare bajai apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਬੇਅੰਤ ਤੰਬੂਰੇ ਵਜ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "कही तूँबरे बजै अपारा ॥",
      "sourceLineId": "139847",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬੇਨ ਬਾਸੁਰੀ ਕਹੂੰ ਹਜਾਰਾ ॥",
      "transliteration": "ben baasuree kahoo(n) hajaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਹਜ਼ਾਰਾ ਬੀਨਾ ਅਤੇ ਬੰਸਰੀਆਂ ਵਜ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "बेन बासुरी कहूँ हजारा ॥",
      "sourceLineId": "139848",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੁਤਰੀ ਫੀਲ ਨਗਾਰੇ ਘਨੇ ॥",
      "transliteration": "sutaree feel nagaare ghane ||",
      "translation": "",
      "punjabiViakhya": "ਊਠਾ ('ਸੁਤਰੀ') ਅਤੇ ਹਾਥੀਆਂ ('ਫੀਲ') ਉਤੇ ਬੰਨ੍ਰਹੇ ਹੋਏ ਬੇਅੰਤ ਨਗਾਰੇ",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "सुतरी फील नगारे घने ॥",
      "sourceLineId": "139849",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਮਿਤ ਕਾਨ੍ਰਹਰੇ ਜਾਤ ਨ ਗਨੇ ॥੩੩੦॥",
      "transliteration": "amit kaanrahare jaat na gane ||330||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਅਮਿਤ ਕਾਨ੍ਰਹਰੇ (ਵਿਸ਼ੇਸ਼ ਵਾਜੇ) (ਇਤਨੇ ਅਧਿਕ ਸਨ ਕਿ) ਗਿਣੇ ਨਹੀਂ ਜਾ ਸਕਦੇ ਸਨ ॥੩੩੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "अमित कान्रहरे जात न गने ॥३३०॥",
      "sourceLineId": "139850",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਭਯੋ ਜਬੈ ਸੰਗ੍ਰਾਮਾ ॥",
      "transliteration": "eeh bidh bhayo jabai sa(n)graamaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਦੋਂ ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਯੁੱਧ ਹੋ ਰਿਹਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "इह बिधि भयो जबै संग्रामा ॥",
      "sourceLineId": "139851",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਿਕਸੀ ਦਿਨ ਦੂਲਹ ਹ੍ਵੈ ਬਾਮਾ ॥",
      "transliteration": "nikasee dhin dhooleh havai baamaa ||",
      "translation": "",
      "punjabiViakhya": "(ਤਦੋਂ ਇਕ) ਦਿਨ ਦੂਲਹ (ਦੇਈ) ਨਾ ਦੀ ਇਸਤਰੀ ਪ੍ਰਗਟ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "निकसी दिन दूलह ह्वै बामा ॥",
      "sourceLineId": "139852",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਿੰਘ ਬਾਹਨੀ ਧੁਜਾ ਬਿਰਾਜੈ ॥",
      "transliteration": "si(n)gh baahanee dhujaa biraajai ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਸ਼ੇਰ ਉਤੇ ਸਵਾਰ ਸੀ ਅਤੇ (ਉਸ ਦੀ) ਧੁਜਾ ਸ਼ੋਭ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "सिंघ बाहनी धुजा बिराजै ॥",
      "sourceLineId": "139853",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਾਹਿ ਬਿਲੋਕ ਦੈਤ ਦਲ ਭਾਜੈ ॥੩੩੧॥",
      "transliteration": "jaeh bilok dhait dhal bhaajai ||331||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਨੂੰ ਵੇਖ ਕੇ ਦੈਂਤ ਦਲ ਭਜ ਰਹੇ ਸਨ ॥੩੩੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "जाहि बिलोक दैत दल भाजै ॥३३१॥",
      "sourceLineId": "139854",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਵਤ ਹੀ ਬਹੁ ਅਸੁਰ ਸੰਘਾਰੇ ॥",
      "transliteration": "aavat hee bahu asur sa(n)ghaare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਉਾਂਦਿਆਂ ਹੀ ਬਹੁਤ ਸਾਰੇ ਦੈਂਤ ਮਾਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "आवत ही बहु असुर संघारे ॥",
      "sourceLineId": "139855",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਿਲ ਤਿਲ ਪ੍ਰਾਇ ਰਥੀ ਕਰਿ ਡਾਰੇ ॥",
      "transliteration": "til til prai rathee kar ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਰਥਾ ਵਾਲਿਆਂ ਨੂੰ ਤਿਲ ਤਿਲ ਦੇ ਬਰਾਬਰ ('ਪ੍ਰਾਇ') ਕਰ ਸੁਟਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1382,
      "hindi": "",
      "hindiTransliteration": "तिल तिल प्राइ रथी करि डारे ॥",
      "sourceLineId": "139856",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1382_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਾਟਿ ਦਈ ਕੇਤਿਨ ਕੀ ਧੁਜਾ ॥",
