{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1383,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1383_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਤਨ ਸੁਭਟ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "bhaat bhaat tan subhaT prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਤ ਭਾਤ ਦੇ ਸੂਰਮਿਆਂ ਉਤੇ ਵਾਰ ਕੀਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "भाति भाति तन सुभट प्रहारे ॥",
      "sourceLineId": "139859",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਟੂਕ ਟੂਕ ਕਰਿ ਪ੍ਰਿਥੀ ਪਛਾਰੇ ॥",
      "transliteration": "Took Took kar pirathee pachhaare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਟੋਟੇ ਟੋਟੇ ਕਰ ਕੇ ਧਰਤੀ ਉਤੇ ਸੁਟ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "टूक टूक करि पृथी पछारे ॥",
      "sourceLineId": "139860",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕੇਸਨ ਤੇ ਗਹਿ ਕਿਤਨ ਪਛਾਰਾ ॥",
      "transliteration": "kesan te geh kitan pachhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਨੂੰ ਕੇਸਾ ਤੋਂ ਪਕੜ ਕੇ ਪਛਾੜ ਸੁਟਿਆ",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "केसन ते गहि कितन पछारा ॥",
      "sourceLineId": "139861",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਤ੍ਰੁ ਸੈਨ ਤਿਲ ਤਿਲ ਕਰਿ ਡਾਰਾ ॥੩੩੩॥",
      "transliteration": "satr sain til til kar ddaaraa ||333||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਵੈਰੀ ਦੀ ਸੈਨਾ ਨੂੰ ਤਿਲ ਤਿਲ ਜਿੰਨਾ ਕਰ ਦਿੱਤਾ ॥੩੩੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "सत्रु सैन तिल तिल करि डारा ॥३३३॥",
      "sourceLineId": "139862",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਝਮਕਤ ਕਹੀ ਅਸਿਨ ਕੀ ਧਾਰਾ ॥",
      "transliteration": "jhamakat kahee asin kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਤਲਵਾਰਾ ਦੀਆਂ ਧਾਰਾ ਚਮਕ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "झमकत कही असिन की धारा ॥",
      "sourceLineId": "139863",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭਭਕਤ ਰੁੰਡ ਮੁੰਡ ਬਿਕਰਾਰਾ ॥",
      "transliteration": "bhabhakat ru(n)dd mu(n)dd bikaraaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਭਿਆਨਕ ਸਿਰ ਅਤੇ ਧੜ ਭਭਕ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "भभकत रुँड मुँड बिकरारा ॥",
      "sourceLineId": "139864",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕੇਤਿਕ ਗਰਜਿ ਸਸਤ੍ਰ ਕਟਿ ਸਜਹੀ ॥",
      "transliteration": "ketik garaj sasatr kaT sajahee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਲਕ ਨਾਲ ਸ਼ਸਤ੍ਰ ਸਜਾ ਕੇ ਗਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "केतिक गरजि ससत्र कटि सजही ॥",
      "sourceLineId": "139865",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਸਤ੍ਰ ਛੋਰਿ ਕੇਤੇ ਭਟ ਭਜਹੀ ॥੩੩੪॥",
      "transliteration": "asatr chhor kete bhaT bhajahee ||334||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤਨੇ ਸੂਰਮੇ ਅਸਤ੍ਰ ਛਡ ਕੇ ਭਜ ਰਹੇ ਸਨ ॥੩੩੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "असत्र छोरि केते भट भजही ॥३३४॥",
      "sourceLineId": "139866",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਾਰੇ ਪਰੇ ਪ੍ਰਿਥੀ ਪਰ ਕੇਤੇ ॥",
      "transliteration": "maare pare pirathee par kete ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਮਹਾਨ ਅਤੇ ਵਿਕਰਾਲ ਸੂਰਮੇ ਮਾਰੇ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "मारे परे पृथी पर केते ॥",
      "sourceLineId": "139867",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਹਾ ਬੀਰ ਬਿਕਰਾਰ ਬਿਚੇਤੇ ॥",
      "transliteration": "mahaa beer bikaraar bichete ||",
      "translation": "",
      "punjabiViakhya": "ਧਰਤੀ ਉਤੇ ਬੇਸੁੱਧ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "महा बीर बिकरार बिचेते ॥",
      "sourceLineId": "139868",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਝਿਮਿ ਝਿਮਿ ਗਿਰੈ ਸ੍ਰੋਨ ਜਿਮਿ ਝਰਨਾ ॥",
      "transliteration": "jhim jhim girai sron jim jharanaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ ਸ਼ਰੀਰਾ ਤੋਂ) ਝਰਨਿਆਂ ਵਾਗ ਲਹੂ ਝਿਮ ਝਿਮ ਕਰਦਾ ਝਰ ਰਿਹਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "झिमि झिमि गिरै स्रोन जिमि झरना ॥",
      "sourceLineId": "139869",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਯੋ ਘੋਰ ਰਨ ਜਾਤ ਨ ਬਰਨਾ ॥੩੩੫॥",
      "transliteration": "bhayo ghor ran jaat na baranaa ||335||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਘਮਸਾਨ ਯੁੱਧ ਹੋਇਆ, ਜਿਸ ਦਾ ਵਰਣਨ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ ॥੩੩੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "भयो घोर रन जात न बरना ॥३३५॥",
      "sourceLineId": "139870",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਚਿ ਅਚਿ ਰੁਧਰ ਡਾਕਨੀ ਡਹਕੈ ॥",
      "transliteration": "ach ach rudhar ddaakanee ddahakai ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਡਾਕਣੀਆਂ (ਚੁੜੇਲਾ) ਲਹੂ ਪੀ ਪੀ ਕੇ ਡਹਿਕ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "अचि अचि रुधर डाकनी डहकै ॥",
      "sourceLineId": "139871",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭਖਿ ਭਖਿ ਮਾਸ ਕਾਕ ਕਹੂੰ ਕਹਕੈ ॥",
      "transliteration": "bhakh bhakh maas kaak kahoo(n) kahakai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕਾ ਮਾਸ ਖਾ ਖਾ ਕੇ ਕਾ-ਕਾ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "भखि भखि मास काक कहूँ कहकै ॥",
      "sourceLineId": "139872",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦਾਰੁਨ ਹੋਤ ਭਯੋ ਤਹ ਜੁਧਾ ॥",
      "transliteration": "dhaarun hot bhayo teh judhaa ||",
      "translation": "",
      "punjabiViakhya": "ਉਥੇ ਬਹੁਤ ਭਿਆਨਕ ਯੁੱਧ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "दारुन होत भयो तह जुधा ॥",
      "sourceLineId": "139873",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਮਰੇ ਬੀਚ ਨ ਆਵਤ ਬੁਧਾ ॥੩੩੬॥",
      "transliteration": "hamare beech na aavat budhaa ||336||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਦਾ ਅਨੁਮਾਨ ਲਗਾ ਸਕਣਾ) ਮੇਰੀ ਬੁੱਧੀ ਵਿਚ ਨਹੀਂ ਆਉਾਂਦਾ ॥੩੩੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "हमरे बीच न आवत बुधा ॥३३६॥",
      "sourceLineId": "139874",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਾਰੇ ਪਰੇ ਦੈਤ ਕਹੀ ਭਾਰੇ ॥",
      "transliteration": "maare pare dhait kahee bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਵੱਡੇ ਦੈਂਤ ਮਾਰੇ ਪਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "मारे परे दैत कही भारे ॥",
      "sourceLineId": "139875",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗਿਰੇ ਕਾਢਿ ਕਰਿ ਦਾਤ ਡਰਾਰੇ ॥",
      "transliteration": "gire kaadd kar dhaat ddaraare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਭਿਆਨਕ ਦੰਦ ਕਢ ਕੇ ਡਿਗੇ ਪਏ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "गिरे काढि करि दात डरारे ॥",
      "sourceLineId": "139876",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸ੍ਰੋਨਤ ਬਮਤ ਬਦਨ ਤੇ ਏਕਾ ॥",
      "transliteration": "sronat bamat badhan te ekaa ||",
      "translation": "",
      "punjabiViakhya": "ਕੁਝ ਇਕ ਬਲਵਾਨ ਯੁੱਧ ਵਿਚ",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "स्रोनत बमत बदन ते एका ॥",
      "sourceLineId": "139877",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬੀਰ ਖੇਤ ਬਲਵਾਨ ਅਨੇਕਾ ॥੩੩੭॥",
      "transliteration": "beer khet balavaan anekaa ||337||",
      "translation": "",
      "punjabiViakhya": "ਮੂੰਹ ਤੋਂ ਲਹੂ ਦੀ ਉਲਟੀ ਕਰ ਰਹੇ ਸਨ ॥੩੩੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "बीर खेत बलवान अनेका ॥३३७॥",
      "sourceLineId": "139878",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਡੇ ਬਡੇ ਜਿਨ ਕੇ ਸਿਰ ਸੀਂਗਾ ॥",
      "transliteration": "badde badde jin ke sir see(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੈਂਤਾ ਦੇ ਸਿਰਾ ਉਤੇ ਵੱਡੇ ਵੱਡੇ ਸਿੰਗ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "बडे बडे जिन के सिर सींगा ॥",
      "sourceLineId": "139879",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੋਂਚੈ ਬਡੀ ਭਾਤਿ ਜਿਨ ਢੀਂਗਾ ॥",
      "transliteration": "cho(n)chai baddee bhaat jin ddee(n)gaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਜਿਨ੍ਰਹਾ ਦੀਆਂ ਚੁੰਜਾ ਲਮਢੀਗਾ ਵਾਗ ਵੱਡੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "चोंचै बडी भाति जिन ढींगा ॥",
      "sourceLineId": "139880",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸ੍ਰੋਨਤ ਸੇ ਸਰ ਨੈਨ ਅਪਾਰਾ ॥",
      "transliteration": "sronat se sar nain apaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਲਹੂ ਰੰਗੇ ਨੈਣ ਸਰੋਵਰ ਵਰਗੇ ਵੱਡੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "स्रोनत से सर नैन अपारा ॥",
      "sourceLineId": "139881",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਿਰਖ ਜਿਨੈ ਉਪਜਤ ਭ੍ਰਮ ਭਾਰਾ ॥੩੩੮॥",
      "transliteration": "nirakh jinai upajat bhram bhaaraa ||338||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੂੰ ਵੇਖ ਕੇ ਭਾਰਾ ਭਰਮ ਪੈਦਾ ਹੁੰਦਾ ਸੀ ॥੩੩੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "निरख जिनै उपजत भ्रम भारा ॥३३८॥",
      "sourceLineId": "139882",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਹਾ ਬੀਰ ਤ੍ਰੈ ਲੋਕ ਅਤੁਲ ਬਲ ॥",
      "transliteration": "mahaa beer trai lok atul bal ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਦੈਂਤ) ਬਹੁਤ ਵੱਡੇ ਯੋਧੇ ਅਤੇ ਅਤੁਲ ਬਲ ਵਾਲੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "महा बीर त्रै लोक अतुल बल ॥",
      "sourceLineId": "139883",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਰਿ ਅਨੇਕ ਜੀਤੇ ਜਿਨ ਜਲ ਥਲ ॥",
      "transliteration": "ar anek jeete jin jal thal ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ ਜਲ ਥਲ ਵਿਚ ਅਨੇਕ ਵੈਰੀ ਜਿਤ ਲਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "अरि अनेक जीते जिन जल थल ॥",
      "sourceLineId": "139884",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਹਾ ਬੀਰ ਬਲਵਾਨ ਡਰਾਰੇ ॥",
      "transliteration": "mahaa beer balavaan ddaraare ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਮਹਾਬੀਰ, ਬਲਵਾਨ ਅਤੇ ਡਰ ਪੈਦਾ ਕਰਨ ਵਾਲੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "महा बीर बलवान डरारे ॥",
      "sourceLineId": "139885",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚੁਨਿ ਚੁਨਿ ਬਾਲ ਬਰਛਿਯਨ ਮਾਰੇ ॥੩੩੯॥",
      "transliteration": "chun chun baal barachhiyan maare ||339||",
      "translation": "",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਨੂੰ) ਬਾਲਾ (ਦੂਲਹ ਦੇਈ) ਨੇ ਚੁਣ ਚੁਣ ਕੇ ਬਰਛੀ ਨਾਲ ਮਾਰਿਆ ਸੀ ॥੩੩੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "चुनि चुनि बाल बरछियन मारे ॥३३९॥",
      "sourceLineId": "139886",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕੇਤਿਕ ਸੁਭਟ ਅਬਿਕਟੇ ਮਾਰੇ ॥",
      "transliteration": "ketik subhaT abikaTe maare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਸੂਰਮਿਆਂ ਨੂੰ ਸਹਿਜ ਨਾਲ ਮਾਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "केतिक सुभट अबिकटे मारे ॥",
      "sourceLineId": "139887",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕੇਤਿਕ ਕਰਨ ਕੇਹਰੀ ਫਾਰੇ ॥",
      "transliteration": "ketik karan keharee faare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤਨਿਆਂ ਦੇ ਕੰਨ ਸ਼ੇਰ ਨੇ ਪਾੜ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "केतिक करन केहरी फारे ॥",
      "sourceLineId": "139888",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕੇਤਿਕ ਮਹਾ ਕਾਲ ਅਰਿ ਕੂਟੇ ॥",
      "transliteration": "ketik mahaa kaal ar kooTe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਵੈਰੀਆਂ ਨੂੰ ਮਹਾ ਕਾਲ ਨੇ ਕੁਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "केतिक महा काल अरि कूटे ॥",
      "sourceLineId": "139889",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਾਦਲ ਸੇ ਸਭ ਹੀ ਦਲ ਫੂਟੇ ॥੩੪੦॥",
      "transliteration": "baadhal se sabh hee dhal fooTe ||340||",
      "translation": "",
      "punjabiViakhya": "ਬਦਲ ਵਾਗ ਸਾਰੇ (ਵੈਰੀ) ਦਲ ਖੇਰੂੰ ਖੇਰੂੰ ਹੋ ਗਏ ॥੩੪੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "बादल से सभ ही दल फूटे ॥३४०॥",
      "sourceLineId": "139890",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੇਤੇ ਬੀਰ ਬਰਛਿਯਨ ਮਾਰੇ ॥",
      "transliteration": "kete beer barachhiyan maare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਸੂਰਮੇ ਬਰਛੀਆਂ ਨਾਲ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "केते बीर बरछियन मारे ॥",
      "sourceLineId": "139891",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਟੂਕ ਟੂਕ ਕੇਤਿਕ ਕਰਿ ਡਾਰੇ ॥",
      "transliteration": "Took Took ketik kar ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਨੂੰ ਟੋਟੇ ਟੋਟੇ ਕਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "टूक टूक केतिक करि डारे ॥",
      "sourceLineId": "139892",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕੇਤੇ ਹਨੇ ਖੜਗ ਕੀ ਧਾਰਾ ॥",
      "transliteration": "kete hane khaRag kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨਿਆਂ ਨੂੰ ਖੜਗ ਦੀ ਧਾਰ ਨਾਲ ਮਾਰ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "केते हने खड़ग की धारा ॥",
      "sourceLineId": "139893",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਲੋਹ ਕਟੀਲੇ ਸੂਰ ਅਪਾਰਾ ॥੩੪੧॥",
      "transliteration": "loh kaTeele soor apaaraa ||341||",
      "translation": "",
      "punjabiViakhya": "ਬੇਅੰਤ ਸੂਰਮਿਆਂ ਨੂੰ ਲੋਹੇ ਨਾਲ (ਭਾਵ ਸ਼ਸਤ੍ਰਾ ਨਾਲ) ਕਟ ਸੁਟਿਆ ॥੩੪੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "लोह कटीले सूर अपारा ॥३४१॥",
      "sourceLineId": "139894",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕੇਤਿਕ ਸੂਲ ਸੈਹਥੀ ਹਨੇ ॥",
      "transliteration": "ketik sool saihathee hane ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਸੁੰਦਰ ਸੁਘੜ ਸਿਪਾਹੀ ਬਣੇ ਹੋਏ",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "केतिक सूल सैहथी हने ॥",
      "sourceLineId": "139895",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੁੰਦਰ ਸੁਘਰ ਸਿਪਾਹੀ ਬਨੇ ॥",
      "transliteration": "su(n)dhar sughar sipaahee bane ||",
      "translation": "",
      "punjabiViakhya": "ਸੂਰਮੇ ਸ਼ੂਲ ਅਤੇ ਸੈਹਥੀ ਨਾਲ ਮਾਰ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "सुँदर सुघर सिपाही बने ॥",
      "sourceLineId": "139896",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਪਰੇ ਸੁ ਬੀਰ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "eeh bidh pare su beer prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ (ਸ਼ਸਤ੍ਰਾ ਦੇ ਵਾਰਾ ਨਾਲ) ਪ੍ਰਹਾਰੇ ਹੋਏ ਸੂਰਮੇ ਡਿਗੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "इह बिधि परे सु बीर प्रहारे ॥",
      "sourceLineId": "139897",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭੂਮਿ ਚਾਲ ਮਨੋ ਗਿਰੇ ਮੁਨਾਰੇ ॥੩੪੨॥",
      "transliteration": "bhoom chaal mano gire munaare ||342||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਭੂਚਾਲ ਆਉਣ ਨਾਲ ਮੁਨਾਰੇ ਡਿਗੇ ਪਏ ਹੋਣ ॥੩੪੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "भूमि चाल मनो गिरे मुनारे ॥३४२॥",
      "sourceLineId": "139898",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਗਿਰੇ ਬੀਰ ਰਨ ਭਾਰੇ ॥",
      "transliteration": "eeh bidh gire beer ran bhaare ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਵੱਡੇ ਵੱਡੇ ਸੂਰਮੇ ਯੁੱਧ ਵਿਚ ਡਿਗੇ ਪਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "इह बिधि गिरे बीर रन भारे ॥",
      "sourceLineId": "139899",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਨੁ ਨਗ ਇੰਦ੍ਰ ਬਜ੍ਰ ਭੇ ਮਾਰੇ ॥",
      "transliteration": "jan nag i(n)dhr bajr bhe maare ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਇੰਦਰ ਨੇ ਬਜ੍ਰ ਨਾਲ ਪਰਬਤ ਤੋੜੇ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "जनु नग इंद्र बज्र भे मारे ॥",
      "sourceLineId": "139900",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਟੂਕ ਟੂਕ ਜੂਝੇ ਹ੍ਵੈ ਘਨੇ ॥",
      "transliteration": "Took Took joojhe havai ghane ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਟੋਟੇ ਟੋਟੇ ਹੋਏ ਬਹੁਤ ਮਰੇ ਪਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "टूक टूक जूझे ह्वै घने ॥",
      "sourceLineId": "139901",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਾਨੁਕ ਗੌਸ ਕੁਤਬ ਸੇ ਬਨੇ ॥੩੪੩॥",
      "transliteration": "jaanuk gauas kutab se bane ||343||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਗੌਂਸ ਕੁਤਬ ਵਾਗ (ਜੁੰਮੇ ਦੀ ਨਮਾਜ਼ ਵੇਲੇ ਬੰਦਗੀ ਵਿਚ ਅੰਗਾ ਦੀ) ਸਥਿਤੀ ਬਣੀ ਹੋਈ ਹੋਵੇ ॥੩੪੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "जानुक गौस कुतब से बने ॥३४३॥",
      "sourceLineId": "139902",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸ੍ਰੋਨ ਪੁਲਿਤ ਹ੍ਵੈ ਕਿਤੇ ਪਰਾਏ ॥",
      "transliteration": "sron pulit havai kite paraae ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਲਹੂ ਨਾਲ ਲਿਬੜੇ ਭਜੇ ਜਾ ਰਹੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "स्रोन पुलित ह्वै किते पराए ॥",
      "sourceLineId": "139903",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚਾਚਰਿ ਖੇਲਿ ਮਨੋ ਘਰ ਆਏ ॥",
      "transliteration": "chaachar khel mano ghar aae ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਹੋਲੀ ਖੇਡ ਕੇ ਘਰ ਆਏ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "चाचरि खेलि मनो घर आए ॥",
      "sourceLineId": "139904",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭਾਜਤ ਭਏ ਬਿਮਨ ਹ੍ਵੈ ਐਸੇ ॥",
      "transliteration": "bhaajat bhe biman havai aaise ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਅਜਿਹੇ ਬੇਮਨੇ ਹੋ ਕੇ ਭਜ ਰਹੇ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "भाजत भए बिमन ह्वै ऐसे ॥",
      "sourceLineId": "139905",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1383_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦਰਬ ਹਰਾਇ ਜੁਆਰੀ ਜੈਸੇ ॥੩੪੪॥",
      "transliteration": "dharab harai juaaree jaise ||344||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਧਨ ਹਾਰ ਕੇ ਜੁਆਰੀਆਂ (ਭਜ ਤੁਰਦਾ ਹੈ) ॥੩੪੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1383,
      "hindi": "",
      "hindiTransliteration": "दरब हराइ जुआरी जैसे ॥३४४॥",
      "sourceLineId": "139906",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
