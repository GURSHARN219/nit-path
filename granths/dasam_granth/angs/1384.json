{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1384,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1384_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੋ ਜੂਝੇ ਸਨਮੁਖ ਅਸ ਧਾਰਾ ॥",
      "transliteration": "jo joojhe sanamukh as dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਤਲਵਾਰ ਦੀ ਸਾਹਮਣਿਓਾਂ ਧਾਰ ਸਹਿ ਕੇ ਜੂਝਦਾ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "जो जूझे सनमुख अस धारा ॥",
      "sourceLineId": "139907",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਿਨ ਕਾ ਪਲ ਮੋ ਭਯੋ ਉਧਾਰਾ ॥",
      "transliteration": "tin kaa pal mo bhayo udhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਉਸ ਦਾ ਪਲ ਵਿਚ ਉੱਧਾਰ ਹੋ ਜਾਦਾ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "तिन का पल मो भयो उधारा ॥",
      "sourceLineId": "139908",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਇਹ ਜਗ ਤੇ ਬਿਲਖਤ ਨਹਿ ਭਏ ॥",
      "transliteration": "eeh jag te bilakhat neh bhe ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਇਸ ਸੰਸਾਰ ਵਿਚ ਬਿਲਖਦੇ ਨਹੀਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "इह जग ते बिलखत नहि भए ॥",
      "sourceLineId": "139909",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚੜਿ ਬਿਵਾਨ ਸੁਰਲੋਕ ਸਿਧਏ ॥੩੪੫॥",
      "transliteration": "chaR bivaan suralok sidhe ||345||",
      "translation": "",
      "punjabiViakhya": "ਸਗੋਂ ਬਿਮਾਨ ਵਿਚ ਚੜ੍ਰਹ ਕੇ ਸਵਰਗ ਨੂੰ ਜਾਦੇ ਸਨ ॥੩੪੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "चड़ि बिवान सुरलोक सिधए ॥३४५॥",
      "sourceLineId": "139910",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੋਫੀ ਜੇਤੇ ਭਜਤ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "sofee jete bhajat prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਤਨੇ ਭਜਦੇ ਹੋਏ ਸੋਫ਼ੀਆਂ ਉਤੇ ਪ੍ਰਹਾਰ ਕੀਤਾ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "सोफी जेते भजत प्रहारे ॥",
      "sourceLineId": "139911",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੇ ਲੈ ਬਡੇ ਨਰਕ ਮੋ ਡਾਰੇ ॥",
      "transliteration": "te lai badde narak mo ddaare ||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਸਾਰਿਆਂ ਨੂੰ ਵੱਡੇ ਨਰਕ ਵਿਚ ਸੁਟ ਦਿੱਤਾ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "ते लै बडे नरक मो डारे ॥",
      "sourceLineId": "139912",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਾਮੁਹਿ ਹ੍ਵੈ ਜਿਨਿ ਦੀਨੇ ਪ੍ਰਾਨਾ ॥",
      "transliteration": "saamuh havai jin dheene praanaa ||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਨੇ ਸਾਹਮਣੇ ਹੋ ਕੇ ਪ੍ਰਾਣ ਨਿਛਾਵਰ ਕੀਤੇ,",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "सामुहि ह्वै जिनि दीने प्राना ॥",
      "sourceLineId": "139913",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਿਨ ਨਰ ਬੀਰ ਬਰੰਗਨਿ ਨਾਨਾ ॥੩੪੬॥",
      "transliteration": "tin nar beer bara(n)gan naanaa ||346||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਪੁਰਸ਼ਾ ਨੂੰ ਅਨੇਕ ਤਰ੍ਰਹਾ ਦੀਆਂ ਅਪੱਛਰਾਵਾ ਨੇ ਵਰ ਲਿਆ ॥੩੪੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "तिन नर बीर बरंगनि नाना ॥३४६॥",
      "sourceLineId": "139914",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕੇਤਿਕ ਬਿਧੇ ਬਜ੍ਰ ਅਰੁ ਬਾਨਾ ॥",
      "transliteration": "ketik bidhe bajr ar baanaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤਨੇ ਬਜ੍ਰ ਅਤੇ ਬਾਣਾ ਨਾਲ ਵਿੰਨ੍ਰਹੇ ਗਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "केतिक बिधे बज्र अरु बाना ॥",
      "sourceLineId": "139915",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗਿਰਿ ਗਿਰਿ ਪਰੇ ਧਰਨ ਪਰ ਨਾਨਾ ॥",
      "transliteration": "gir gir pare dharan par naanaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਈ ਧਰਤੀ ਉਤੇ ਡਿਗੇ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "गिरि गिरि परे धरन पर नाना ॥",
      "sourceLineId": "139916",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਹਾਰਥੀ ਬਾਨਨ ਕੌ ਬਾਧੇ ॥",
      "transliteration": "mahaarathee baanan kau baadhe ||",
      "translation": "",
      "punjabiViakhya": "ਕਈ ਮਹਾ ਰਥੀ ਬਾਣਾ (ਦੇ ਭਥਿਆਂ) ਨੂੰ ਬੰਨ੍ਰਹੇ ਹੋਇਆਂ ਧਰਤੀ ਉਤੇ ਡਿਗੇ ਪਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "महारथी बानन कौ बाधे ॥",
      "sourceLineId": "139917",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਿਰਿ ਗਿਰਿ ਪਰੇ ਰਹੇ ਪੁਨਿ ਸਾਧੇ ॥੩੪੭॥",
      "transliteration": "gir gir pare rahe pun saadhe ||347||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਫਿਰ ਵੀ (ਉਨ੍ਰਹਾ ਨੇ) ਨਿਸ਼ਾਣਾ ਬੰਨ੍ਰਹਿਆ ਹੋਇਆ ਸੀ ॥੩੪੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "गिरि गिरि परे रहे पुनि साधे ॥३४७॥",
      "sourceLineId": "139918",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੂਰ ਬਡੇ ਰਨ ਮਚੇ ਬਿਕਟ ਅਤਿ ॥",
      "transliteration": "soor badde ran mache bikaT at ||",
      "translation": "",
      "punjabiViakhya": "ਬਹੁਤ ਸੂਰਮਿਆਂ ਨੇ ਡਰਾਉਣਾ ਯੁੱਧ ਮਚਾਇਆ ਹੋਇਆ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "सूर बडे रन मचे बिकट अति ॥",
      "sourceLineId": "139919",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਧਾਇ ਧਾਇ ਕਰ ਪਰੇ ਬਿਕਟ ਮਤਿ ॥",
      "transliteration": "dhai dhai kar pare bikaT mat ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਕਠੋਰ ਬੁੱਧੀ ਵਾਲੇ ਇਕ ਦੂਜੇ ਉਤੇ ਭਜ ਭਜ ਕੇ ਵਾਰ ਕਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "धाइ धाइ कर परे बिकट मति ॥",
      "sourceLineId": "139920",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਾਰਿ ਮਾਰਿ ਕਰਿ ਸਕਲ ਪੁਕਾਰਾ ॥",
      "transliteration": "maar maar kar sakal pukaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਨਗਾਰੇ, ਢੋਲ ਅਤੇ ਦਮਾਮੇ ਵਜ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "मारि मारि करि सकल पुकारा ॥",
      "sourceLineId": "139921",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੁੰਦਭਿ ਢੋਲ ਦਮਾਮੋ ਭਾਰਾ ॥੩੪੮॥",
      "transliteration": "dhu(n)dhabh ddol dhamaamo bhaaraa ||348||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸਾਰੇ (ਸੂਰਮੇ) 'ਮਾਰੋ ਮਾਰੋ' ਪੁਕਾਰ ਰਹੇ ਸਨ ॥੩੪੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "दुँदभि ढोल दमामो भारा ॥३४८॥",
      "sourceLineId": "139922",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਾਕਿ ਹਾਕਿ ਹਥਿਯਾਰ ਪ੍ਰਹਾਰੇ ॥",
      "transliteration": "haak haak hathiyaar prahaare ||",
      "translation": "",
      "punjabiViakhya": "ਵੰਗਾਰ ਵੰਗਾਰ ਕੇ ਹਥਿਆਰ ਚਲਾ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "हाकि हाकि हथियार प्रहारे ॥",
      "sourceLineId": "139923",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬੀਨਿ ਬੀਨਿ ਬਾਨਨ ਤਨ ਮਾਰੇ ॥",
      "transliteration": "been been baanan tan maare ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਸੂਰਮਿਆਂ ਦੇ ਸ਼ਰੀਰਾ ਉਤੇ) ਚੁਣ ਚੁਣ ਕੇ ਤੀਰ ਚਲਾ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "बीनि बीनि बानन तन मारे ॥",
      "sourceLineId": "139924",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਝੁਕਿ ਝੁਕਿ ਹਨੇ ਸੈਹਥੀ ਘਾਇਨ ॥",
      "transliteration": "jhuk jhuk hane saihathee ghain ||",
      "translation": "",
      "punjabiViakhya": "ਝੁਕ ਝੁਕ ਕੇ ਬਰਛੀਆਂ ਮਾਰ ਕੇ ਘਾਇਲ ਕਰ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "झुकि झुकि हने सैहथी घाइन ॥",
      "sourceLineId": "139925",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੂਝੈ ਅਧਿਕ ਦੁਬਹਿਯਾ ਚਾਇਨ ॥੩੪੯॥",
      "transliteration": "joojhai adhik dhubahiyaa chain ||349||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਬਹੁਤ ਚਾਓ ਨਾਲ ਦੋਹਾ ਬਾਹਵਾ ਨਾਲ ਲੜਨ ਵਾਲੇ ਸੂਰਮੇ ਮਾਰੇ ਜਾ ਰਹੇ ਸਨ ॥੩੪੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "जूझै अधिक दुबहिया चाइन ॥३४९॥",
      "sourceLineId": "139926",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਹੀ ਪਰੇ ਹਾਥਿਨ ਕੇ ਸੁੰਡਾ ॥",
      "transliteration": "kahee pare haathin ke su(n)ddaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਹਾਥੀਆਂ ਦੀਆਂ ਸੁੰਢਾ ਪਈਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "कही परे हाथिन के सुँडा ॥",
      "sourceLineId": "139927",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਾਜੀ ਰਥੀ ਗਜਨ ਕੇ ਮੁੰਡਾ ॥",
      "transliteration": "baajee rathee gajan ke mu(n)ddaa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਘੋੜਿਆਂ, ਰਥਵਾਨਾ ਅਤੇ ਹਾਥੀਆਂ ਦੇ ਸਿਰ ਪਏ ਹੋਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "बाजी रथी गजन के मुँडा ॥",
      "sourceLineId": "139928",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਝੁੰਡ ਪਰੇ ਕਹੀ ਜੂਝਿ ਜੁਝਾਰੇ ॥",
      "transliteration": "jhu(n)dd pare kahee joojh jujhaare ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਸੂਰਮਿਆਂ ਦੇ ਝੁੰਡਾ ਦੇ ਝੁੰਡ ਪਏ ਹੋਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "झुँड परे कही जूझि जुझारे ॥",
      "sourceLineId": "139929",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੀਰ ਤੁਫੰਡ ਤੁਪਨ ਕੇ ਮਾਰੇ ॥੩੫੦॥",
      "transliteration": "teer tufa(n)dd tupan ke maare ||350||",
      "translation": "",
      "punjabiViakhya": "ਤੀਰਾ, ਬੰਦੂਕਾ ਅਤੇ ਤੋਪਾ ਨਾਲ ਮਾਰੇ ਹੋਏ ॥੩੫੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "तीर तुफंड तुपन के मारे ॥३५०॥",
      "sourceLineId": "139930",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਹੁ ਜੂਝੇ ਇਹ ਭਾਤਿ ਸਿਪਾਹੀ ॥",
      "transliteration": "bahu joojhe ieh bhaat sipaahee ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਬਹੁਤ ਸਿਪਾਹੀ ਮਾਰੇ ਗਏ",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "बहु जूझे इह भाति सिपाही ॥",
      "sourceLineId": "139931",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਾਤਿ ਭਾਤਿ ਧੁਜਨੀ ਰਿਪੁ ਗਾਹੀ ॥",
      "transliteration": "bhaat bhaat dhujanee rip gaahee ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭਾਤ ਭਾਤ ਨਾਲ ਵੈਰੀ ਦੀ ਸੈਨਾ ਨੂੰ ਗਾਹਿਆ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "भाति भाति धुजनी रिपु गाही ॥",
      "sourceLineId": "139932",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਉਤ ਕੀਯ ਸਿੰਘ ਬਾਹਨੀ ਕੋਪੈ ॥",
      "transliteration": "aut keey si(n)gh baahanee kopai ||",
      "translation": "",
      "punjabiViakhya": "ਉਧਰ ਸ਼ੇਰ ਉਤੇ ਸਵਾਰੀ ਕਰਨ ਵਾਲੀ (ਦੂਲਹ ਦੇਈ) ਕ੍ਰੋਧ ਵਿਚ ਆ ਗਈ",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "उत कीय सिंघ बाहनी कोपै ॥",
      "sourceLineId": "139933",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਤਿ ਅਸਿਧੁਜ ਲੈ ਧਾਯੋ ਧੋਪੈ ॥੩੫੧॥",
      "transliteration": "eit asidhuj lai dhaayo dhopai ||351||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਇਧਰ ਮਹਾ ਕਾਲ ('ਅਸਿਧੁਜ') ਤਲਵਾਰ ਲੈ ਕੇ ਪੈ ਗਿਆ ॥੩੫੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "इति असिधुज लै धायो धोपै ॥३५१॥",
      "sourceLineId": "139934",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਹੂੰ ਲਸੈ ਰਨ ਖੜਗ ਕਟਾਰੀ ॥",
      "transliteration": "kahoo(n) lasai ran khaRag kaTaaree ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਖੜਗਾ ਅਤੇ ਕਟਾਰਾ ਚਮਕ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "कहूँ लसै रन खड़ग कटारी ॥",
      "sourceLineId": "139935",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਾਨੁਕ ਮਛ ਬੰਧੇ ਮਧਿ ਜਾਰੀ ॥",
      "transliteration": "jaanuk machh ba(n)dhe madh jaaree ||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਮੱਛਲੀਆਂ ਜਾਲ ਵਿਚ ਬੰਨ੍ਰਹੀਆਂ (ਭਾਵ ਫਸੀਆਂ) ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "जानुक मछ बंधे मधि जारी ॥",
      "sourceLineId": "139936",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਿੰਘ ਬਾਹਨੀ ਸਤ੍ਰੁ ਬਿਹੰਡੇ ॥",
      "transliteration": "si(n)gh baahanee satr biha(n)dde ||",
      "translation": "",
      "punjabiViakhya": "ਸ਼ੇਰ ਦੀ ਸਵਾਰੀ ਕਰਨ ਵਾਲੀ (ਦੂਲਹ ਦੇਈ) ਨੇ ਵੈਰੀਆਂ ਨੂੰ ਨਸ਼ਟ ਕਰ ਦਿੱਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "सिंघ बाहनी सत्रु बिहंडे ॥",
      "sourceLineId": "139937",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਿਲ ਤਿਲ ਪ੍ਰਾਇ ਅਸੁਰ ਕਰਿ ਖੰਡੇ ॥੩੫੨॥",
      "transliteration": "til til prai asur kar kha(n)dde ||352||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਦੈਂਤਾ ਨੂੰ ਤਿਲ ਤਿਲ ਦੇ ਬਰਾਬਰ ਟੁਕੜੇ ਟੁਕੜੇ ਕਰ ਦਿੱਤਾ ॥੩੫੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "तिल तिल प्राइ असुर करि खंडे ॥३५२॥",
      "sourceLineId": "139938",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਹੂੰ ਪਾਖਰੈ ਕਟੀ ਬਿਰਾਜੈ ॥",
      "transliteration": "kahoo(n) paakharai kaTee biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ (ਘੋੜਿਆਂ ਦੀਆਂ) ਝੁਲਾ ਕਟੀਆਂ ਪਈਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "कहूँ पाखरै कटी बिराजै ॥",
      "sourceLineId": "139939",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਖਤਰ ਕਹੂੰ ਗਿਰੇ ਨਰ ਰਾਜੈ ॥",
      "transliteration": "bakhatar kahoo(n) gire nar raajai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਯੋਧੇ ਕਵਚਾ ਸਮੇਤ ਡਿਗੇ ਹੋਏ ਸ਼ੋਭਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "बखतर कहूँ गिरे नर राजै ॥",
      "sourceLineId": "139940",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਹੂੰ ਚਲਤ ਸ੍ਰੋਨਤ ਕੀ ਧਾਰਾ ॥",
      "transliteration": "kahoo(n) chalat sronat kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਲਹੂ ਦੀਆਂ ਤਤੀਰੀਆਂ ਚਲ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "कहूँ चलत स्रोनत की धारा ॥",
      "sourceLineId": "139941",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਛੁਟਤ ਬਾਗ ਮੋ ਜਨਕੁ ਫੁਹਾਰਾ ॥੩੫੩॥",
      "transliteration": "chhuTat baag mo janak fuhaaraa ||353||",
      "translation": "",
      "punjabiViakhya": "(ਇੰਜ ਲਗਦਾ ਸੀ) ਮਾਨੋ ਬਾਗ਼ ਵਿਚ ਫਵਾਰਾ ਚਲ ਰਿਹਾ ਹੋਵੇ ॥੩੫੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "छुटत बाग मो जनकु फुहारा ॥३५३॥",
      "sourceLineId": "139942",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਹੂੰ ਡਾਕਨੀ ਸ੍ਰੋਨਤ ਪੀਯੈ ॥",
      "transliteration": "kahoo(n) ddaakanee sronat peeyai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਚੁੜੇਲਾ ਲਹੂ ਪੀ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "कहूँ डाकनी स्रोनत पीयै ॥",
      "sourceLineId": "139943",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਝਾਕਨਿ ਕਹੂੰ ਮਾਸ ਭਖਿ ਜੀਯੈ ॥",
      "transliteration": "jhaakan kahoo(n) maas bhakh jeeyai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਗਿਰਝਾ ਜੀ ਭਰ ਕੇ ਮਾਸ ਖਾ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "झाकनि कहूँ मास भखि जीयै ॥",
      "sourceLineId": "139944",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਾਕਨਿ ਕਹੂੰ ਫਿਰੈ ਕਹਕਾਤੀ ॥",
      "transliteration": "kaakan kahoo(n) firai kahakaatee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਕਾਉਣੀਆਂ ਕਾ ਕਾ ਕਰਦੀਆਂ ਹੋਈਆਂ ਫਿਰ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "काकनि कहूँ फिरै कहकाती ॥",
      "sourceLineId": "139945",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪ੍ਰੇਤ ਪਿਸਾਚਨ ਡੋਲਤ ਮਾਤੀ ॥੩੫੪॥",
      "transliteration": "pret pisaachan ddolat maatee ||354||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਪ੍ਰੇਤ ਅਤੇ ਪਿਸਾਚ ਮਦਮਸਤ ਹੋ ਕੇ ਡੋਲ ਰਹੇ ਸਨ ॥੩੫੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "प्रेत पिसाचन डोलत माती ॥३५४॥",
      "sourceLineId": "139946",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਸਤ ਫਿਰਤ ਪ੍ਰੇਤਨ ਕੀ ਦਾਰਾ ॥",
      "transliteration": "hasat firat pretan kee dhaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਪ੍ਰੇਤਾ ਦੀਆਂ ਇਸਤਰੀਆਂ ਹਸਦੀਆਂ ਫਿਰਦੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "हसत फिरत प्रेतन की दारा ॥",
      "sourceLineId": "139947",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਡਾਕਨਿ ਕਹੂੰ ਬਜਾਵਤ ਤਾਰਾ ॥",
      "transliteration": "ddaakan kahoo(n) bajaavat taaraa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਡਾਕਣੀਆਂ (ਚੁੜੇਲਾ) ਤਾੜੀਆਂ ਵਜਾ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "डाकनि कहूँ बजावत तारा ॥",
      "sourceLineId": "139948",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੋਗਿਨ ਫਿਰੈ ਕਹੂੰ ਮੁਸਕਾਤੀ ॥",
      "transliteration": "jogin firai kahoo(n) musakaatee ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਜੋਗਣਾ ਹਸਦੀਆਂ ਫਿਰ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "जोगिन फिरै कहूँ मुसकाती ॥",
      "sourceLineId": "139949",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭੂਤਨ ਕੀ ਇਸਤ੍ਰੀ ਮਦ ਮਾਤੀ ॥੩੫੫॥",
      "transliteration": "bhootan kee isatree madh maatee ||355||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਭੂਤਾ ਦੀਆਂ ਇਸਤਰੀਆਂ (ਭੂਤਨੀਆਂ) ਮਦਮਸਤ (ਘੁੰਮ ਰਹੀਆਂ ਸਨ) ॥੩੫੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "भूतन की इसत्री मद माती ॥३५५॥",
      "sourceLineId": "139950",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਫਿਰਤ ਡਕਾਰ ਕਹੂੰ ਰਨ ਡਾਕਨਿ ॥",
      "transliteration": "firat ddakaar kahoo(n) ran ddaakan ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਰਣ-ਖੇਤਰ ਵਿਚ ਡਾਕਣੀਆਂ ਡਕਾਰਦੀਆਂ ਫਿਰਦੀਆਂ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "फिरत डकार कहूँ रन डाकनि ॥",
      "sourceLineId": "139951",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਾਸ ਅਹਾਰ ਕਰਤ ਕਹੂੰ ਝਾਕਨਿ ॥",
      "transliteration": "maas ahaar karat kahoo(n) jhaakan ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਗਿਰਝਾ ਮਾਸ ਦਾ ਭੋਜਨ ਕਰ ਰਹੀਆਂ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "मास अहार करत कहूँ झाकनि ॥",
      "sourceLineId": "139952",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰੇਤ ਪਿਸਾਚ ਹਸੇ ਕਿਲਕਾਰੈ ॥",
      "transliteration": "pret pisaach hase kilakaarai ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਪ੍ਰੇਤ ਅਤੇ ਪਿਸਾਚ ਕਿਲਕਾਰੀਆਂ ਮਾਰ ਕੇ ਹਸ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1384,
      "hindi": "",
      "hindiTransliteration": "प्रेत पिसाच हसे किलकारै ॥",
      "sourceLineId": "139953",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1384_line_0048",
      "lineIndex": 48,
