{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1385,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1385_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਢੈ ਦੈਤ ਰਨ ਦਾਤ ਬਿਹਾਰਤ ॥",
      "transliteration": "kaddai dhait ran dhaat bihaarat ||",
      "translation": "",
      "punjabiViakhya": "(ਕਿਤੇ) ਦੈਂਤ ਰਣ-ਭੂਮੀ ਵਿਚ ਦੰਦ ਕਢ ਕੇ ਫਿਰ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "कढै दैत रन दात बिहारत ॥",
      "sourceLineId": "139955",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭੂਤ ਪ੍ਰੇਤ ਤਾਲੀ ਕਹ ਮਾਰਤ ॥",
      "transliteration": "bhoot pret taalee keh maarat ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਭੂਤ ਪ੍ਰੇਤ ਤਾੜੀਆਂ ਮਾਰ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "भूत प्रेत ताली कह मारत ॥",
      "sourceLineId": "139956",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਉਲਕਾ ਪਾਤ ਹੋਤ ਆਕਾਸਾ ॥",
      "transliteration": "aulakaa paat hot aakaasaa ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਤੋਂ ਤਾਰੇ ਅਥਵਾ ਅੰਗਾਰੇ ('ਉਲਕਾ') ਡਿਗਦੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "उलका पात होत आकासा ॥",
      "sourceLineId": "139957",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਸੁਰ ਸੈਨ ਇਹ ਬਿਧਿ ਭਯੋ ਨਾਸਾ ॥੩੫੭॥",
      "transliteration": "asur sain ieh bidh bhayo naasaa ||357||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਦੈਂਤ ਸੈਨਾ ਦਾ ਨਾਸ ਹੋ ਗਿਆ ॥੩੫੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "असुर सैन इह बिधि भयो नासा ॥३५७॥",
      "sourceLineId": "139958",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਹਤ ਅਮਿਤ ਰਨ ਪਵਨ ਪ੍ਰਚੰਡਾ ॥",
      "transliteration": "bahat amit ran pavan pracha(n)ddaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ-ਭੂਮੀ ਵਿਚ ਬਹੁਤ ਤੇਜ਼ ਹਵਾ ਚਲ ਰਹੀ ਸੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "बहत अमित रन पवन प्रचंडा ॥",
      "sourceLineId": "139959",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦਿਖਿਯਤ ਪਰੇ ਸੁਭਟ ਖੰਡ ਖੰਡਾ ॥",
      "transliteration": "dhikhiyat pare subhaT kha(n)dd kha(n)ddaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਥੇ) ਟੁਕੜੇ ਟੁਕੜੇ ਹੋਏ ਪਏ ਸੂਰਮੇ ਦਿਖ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "दिखियत परे सुभट खंड खंडा ॥",
      "sourceLineId": "139960",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਾਕਨਿ ਕੁਹਕਿ ਮਾਨਵਤਿ ਤਾਤੀ ॥",
      "transliteration": "kaakan kuhak maanavat taatee ||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨਮਤੀਆਂ ਕਾਉਣੀਆਂ ਤਿਖੀ ਸੁਰ ਵਿਚ ਕਾ ਕਾ ਕਰ ਰਹੀਆਂ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "काकनि कुहकि मानवति ताती ॥",
      "sourceLineId": "139961",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਫਾਗੁਨ ਜਾਨੁ ਕੋਕਿਲਾ ਮਾਤੀ ॥੩੫੮॥",
      "transliteration": "faagun jaan kokilaa maatee ||358||",
      "translation": "",
      "punjabiViakhya": "ਮਾਨੋ ਫਗਣ ਦੇ ਮਹੀਨੇ ਵਿਚ ਕੋਇਲਾ ਮਸਤ ਹੋ ਕੇ ਬੋਲ ਰਹੀਆਂ ਹੋਣ ॥੩੫੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "फागुन जानु कोकिला माती ॥३५८॥",
      "sourceLineId": "139962",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਸ੍ਰੋਨ ਕੁੰਡਿ ਭਰਿ ਗਯੋ ॥",
      "transliteration": "eeh bidh sron ku(n)dd bhar gayo ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਲਹੂ ਦਾ ਕੁੰਡ ਭਰ ਗਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "इह बिधि स्रोन कुँडि भरि गयो ॥",
      "sourceLineId": "139963",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੂਸਰ ਮਾਨਸਰੋਵਰ ਭਯੋ ॥",
      "transliteration": "dhoosar maanasarovar bhayo ||",
      "translation": "",
      "punjabiViakhya": "(ਮਾਨੋ) ਦੂਜਾ ਮਾਨਸਰੋਵਰ ਹੋ ਗਿਆ ਹੋਵੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "दूसर मानसरोवर भयो ॥",
      "sourceLineId": "139964",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੇਤ ਛਤ੍ਰੁ ਤਹ ਹੰਸ ਬਿਰਾਜੈ ॥",
      "transliteration": "set chhatr teh ha(n)s biraajai ||",
      "translation": "",
      "punjabiViakhya": "ਟੁਟੇ ਹੋਏ (ਸਫ਼ੈਦ) ਛਤ੍ਰ ਹੰਸਾ ਵਰਗੇ ਸ਼ੋਭ ਰਹੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "सेत छत्रु तह हंस बिराजै ॥",
      "sourceLineId": "139965",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਨਤ ਸਾਜ ਜਲ ਜਿਯ ਸੇ ਰਾਜੈ ॥੩੫੯॥",
      "transliteration": "anat saaj jal jiy se raajai ||359||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਹੋਰ ਸਾਜ਼-ਸਾਮਾਨ ਜਲ-ਜੀਵਾ ('ਜਲ-ਜਿਯ') ਵਰਗਾ ਲਗ ਰਿਹਾ ਸੀ ॥੩੫੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "अनत साज जल जिय से राजै ॥३५९॥",
      "sourceLineId": "139966",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਟੂਕ ਟੂਕ ਦੰਤੀ ਕਹੂੰ ਭਏ ॥",
      "transliteration": "Took Took dha(n)tee kahoo(n) bhe ||",
      "translation": "",
      "punjabiViakhya": "ਕਿਤੇ ਟੋਟੇ ਟੋਟੇ ਹੋਏ ਹਾਥੀ ਪਏ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "टूक टूक दंती कहूँ भए ॥",
      "sourceLineId": "139967",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਿਲ ਤਿਲ ਪ੍ਰਾਇ ਸੁਭਟ ਹ੍ਵੈ ਗਏ ॥",
      "transliteration": "til til prai subhaT havai ge ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਸੂਰਮੇ ਤਿਲ ਤਿਲ ਦੇ ਬਰਾਬਰ ਹੋਏ ਪਏ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "तिल तिल प्राइ सुभट ह्वै गए ॥",
      "sourceLineId": "139968",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸ੍ਰੋਨਤ ਧਾਰਿ ਬਹੀ ਇਕ ਬਾਰਾ ॥",
      "transliteration": "sronat dhaar bahee ik baaraa ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਪਾਸੇ ਲਹੂ ਦੀ ਧਾਰ ਵਗ ਰਹੀ ਸੀ,",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "स्रोनत धारि बही इक बारा ॥",
      "sourceLineId": "139969",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਈ ਧੂਰਿ ਰਨ ਕੀ ਸਭ ਗਾਰਾ ॥੩੬੦॥",
      "transliteration": "bhiee dhoor ran kee sabh gaaraa ||360||",
      "translation": "",
      "punjabiViakhya": "(ਜਿਸ ਕਰ ਕੇ) ਰਣ ਦੀ ਮਿੱਟੀ ਗਾਰਾ ਬਣੀ ਪਈ ਸੀ ॥੩੬੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "भई धूरि रन की सभ गारा ॥३६०॥",
      "sourceLineId": "139970",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨੇਜਬਾਜ ਬਹੁ ਬੀਰ ਸੰਘਾਰੇ ॥",
      "transliteration": "nejabaaj bahu beer sa(n)ghaare ||",
      "translation": "",
      "punjabiViakhya": "ਨੇਜ਼ਾ-ਬਾਜ਼ਾ ਨੇ ਬਹੁਤ ਸੂਰਮੇ ਮਾਰ ਦਿੱਤੇ ਸਨ",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "नेजबाज बहु बीर संघारे ॥",
      "sourceLineId": "139971",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪ੍ਰੋਏ ਬਰਾ ਸੀਖ ਭਟਿਯਾਰੇ ॥",
      "transliteration": "proe baraa seekh bhaTiyaare ||",
      "translation": "",
      "punjabiViakhya": "(ਮਾਨੋ) ਭਠਿਆਰਾ ਨੇ ਸੀਖਾ ਵਿਚ ਵੜੇ ਪਰੋਏ ਹੋਏ ਹੋਣ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "प्रोए बरा सीख भटियारे ॥",
      "sourceLineId": "139972",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਟੂਕ ਟੂਕ ਭਟ ਰਨ ਹ੍ਵੈ ਰਹੇ ॥",
      "transliteration": "Took Took bhaT ran havai rahe ||",
      "translation": "",
      "punjabiViakhya": "ਰਣ ਵਿਚ ਸੂਰਮੇ ਟੁਕੜੇ ਟੁਕੜੇ ਹੋਏ ਪਏ ਸਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "टूक टूक भट रन ह्वै रहे ॥",
      "sourceLineId": "139973",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਨ ਕੇ ਘਾਵ ਸਰੋਹਿਨ ਬਹੇ ॥੩੬੧॥",
      "transliteration": "jin ke ghaav sarohin bahe ||361||",
      "translation": "",
      "punjabiViakhya": "ਜਿਨ੍ਰਹਾ ਦੇ ਜ਼ਖ਼ਮਾ ਉਤੇ ਸਰੋਹੀ (ਤਲਵਾਰ) ਵਗੀ ਸੀ ॥੩੬੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "जिन के घाव सरोहिन बहे ॥३६१॥",
      "sourceLineId": "139974",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਅਮਿਤ ਕੋਪ ਕਰਿ ਕਾਲਾ ॥",
      "transliteration": "eeh bidh amit kop kar kaalaa ||",
      "translation": "",
      "punjabiViakhya": "ਇਸ ਤਰ੍ਰਹਾ ਨਾਲ ਕਾਲ ਬਹੁਤ ਕ੍ਰੋਧ ਕਰ ਕੇ",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "इह बिधि अमित कोप करि काला ॥",
      "sourceLineId": "139975",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਾਢਤ ਭਯੋ ਦਾਤ ਬਿਕਰਾਲਾ ॥",
      "transliteration": "kaaddat bhayo dhaat bikaraalaa ||",
      "translation": "",
      "punjabiViakhya": "ਭਿਆਨਕ ਦੰਦ ਕਢਣ ਲਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "काढत भयो दात बिकराला ॥",
      "sourceLineId": "139976",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਛਿਪ੍ਰ ਹਨੇ ਛਿਨ ਮਾਝ ਛਤ੍ਰਾਲੇ ॥",
      "transliteration": "chhipr hane chhin maajh chhatraale ||",
      "translation": "",
      "punjabiViakhya": "ਛਿਣ ਭਰ ਵਿਚ ਛੇਤੀ ਨਾਲ ਛਤ੍ਰਾ ਵਾਲੇ ਮਾਰ ਦਿੱਤੇ",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "छिप्र हने छिन माझ छत्राले ॥",
      "sourceLineId": "139977",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੂਰਬੀਰ ਬਲਵਾਨ ਮੁਛਾਲੇ ॥੩੬੨॥",
      "transliteration": "soorabeer balavaan muchhaale ||362||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਸੂਰਬੀਰ, ਬਲਵਾਨ ਅਤੇ ਮੁਛੈਲ ਸਨ ॥੩੬੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "सूरबीर बलवान मुछाले ॥३६२॥",
      "sourceLineId": "139978",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੁਹੂੰ ਅਧਿਕ ਰਨ ਕਿਯੋ ਅਪਾਰਾ ॥",
      "transliteration": "dhuhoo(n) adhik ran kiyo apaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਾ ਨੇ ਬਹੁਤ ਘਮਸਾਨ ਯੁੱਧ ਕੀਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "दुहूँ अधिक रन कियो अपारा ॥",
      "sourceLineId": "139979",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦਾਨਵ ਮਰਤ ਭਯੋ ਨਹਿ ਮਾਰਾ ॥",
      "transliteration": "dhaanav marat bhayo neh maaraa ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਦੈਂਤ ਮਾਰਿਆਂ ਮਰ ਨਹੀਂ ਰਹੇ ਸਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "दानव मरत भयो नहि मारा ॥",
      "sourceLineId": "139980",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਬ ਅਸਿਧੁਜ ਅਸ ਮੰਤ੍ਰ ਬਿਚਾਰੋ ॥",
      "transliteration": "tab asidhuj as ma(n)tr bichaaro ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਅਸਿਧੁਜ (ਮਹਾ ਕਾਲ) ਨੇ ਇਸ ਤਰ੍ਰਹਾ ਵਿਚਾਰ ਕੀਤਾ",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "तब असिधुज अस मंत्र बिचारो ॥",
      "sourceLineId": "139981",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਿਹ ਬਿਧਿ ਤੇ ਦਾਨਵਹਿ ਸੰਘਾਰੋ ॥੩੬੩॥",
      "transliteration": "jeh bidh te dhaanaveh sa(n)ghaaro ||363||",
      "translation": "",
      "punjabiViakhya": "ਜਿਸ ਤਰ੍ਰਹਾ ਕਿ ਦੈਂਤਾ ਨੂੰ ਮਾਰਿਆ ਜਾ ਸਕੇ ॥੩੬੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "जिह बिधि ते दानवहि संघारो ॥३६३॥",
      "sourceLineId": "139982",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਰਬਾਕਰਖਨ ਕਿਯ ਅਸਿਧੁਜ ਜਬ ॥",
      "transliteration": "sarabaakarakhan kiy asidhuj jab ||",
      "translation": "",
      "punjabiViakhya": "ਜਦ ਮਹਾ ਕਾਲ ਨੇ (ਆਪਣੀ ਸ਼ਕਤੀ ਨਾਲ) ਸਾਰਿਆਂ ਨੂੰ ਖਿਚ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "सरबाकरखन किय असिधुज जब ॥",
      "sourceLineId": "139983",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਉਪਜਤ ਤੇ ਰਹਿ ਗਏ ਅਸੁਰ ਤਬ ॥",
      "transliteration": "aupajat te reh ge asur tab ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਦੈਂਤ ਪੈਦਾ ਹੋਣੇ ਬੰਦ ਹੋ ਗਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "उपजत ते रहि गए असुर तब ॥",
      "sourceLineId": "139984",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਗ੍ਯਾ ਬਹੁਰਿ ਕਾਲਿ ਕਹ ਦਈ ॥",
      "transliteration": "aagayaa bahur kaal keh dhiee ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਉਸ ਨੇ 'ਕਾਲਿ' ਨੂੰ ਆਗਿਆ ਦਿੱਤੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "आग्या बहुरि कालि कह दई ॥",
      "sourceLineId": "139985",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਤ੍ਰੁ ਸੈਨ ਭਛਨ ਕਰਿ ਗਈ ॥੩੬੪॥",
      "transliteration": "satr sain bhachhan kar giee ||364||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਵੈਰੀ ਦੀ ਸੈਨਾ ਨੂੰ ਖਾ ਗਈ ॥੩੬੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "सत्रु सैन भछन करि गई ॥३६४॥",
      "sourceLineId": "139986",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਏਕੈ ਅਸੁਰ ਤਬੈ ਰਹਿ ਗਯੋ ॥",
      "transliteration": "ekai asur tabai reh gayo ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਇਕੋ ਦੈਂਤ ਰਹਿ ਗਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "एकै असुर तबै रहि गयो ॥",
      "sourceLineId": "139987",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤ੍ਰਾਸਿਤ ਅਧਿਕ ਚਿਤ ਮਹਿ ਭਯੋ ॥",
      "transliteration": "traasit adhik chit meh bhayo ||",
      "translation": "",
      "punjabiViakhya": "ਉਹ ਮਨ ਵਿਚ ਬਹੁਤ ਡਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "त्रासित अधिक चित महि भयो ॥",
      "sourceLineId": "139988",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਾਇ ਹਾਇ ਕਸ ਕਰੌ ਉਪਾਵਾ ॥",
      "transliteration": "hai hai kas karau upaavaa ||",
      "translation": "",
      "punjabiViakhya": "ਹਾਇ ਹਾਇ' ਕਰਦਾ ਹੋਇਆ ਸੋਚਣ ਲਗਾ ਕਿ ਕੀ ਉਪਾ ਕੀਤਾ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "हाइ हाइ कस करौ उपावा ॥",
      "sourceLineId": "139989",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਸ ਕੋਈ ਚਲਤ ਨੇ ਮੇਰਾ ਦਾਵਾ ॥੩੬੫॥",
      "transliteration": "as koiee chalat ne meraa dhaavaa ||365||",
      "translation": "",
      "punjabiViakhya": "ਹੁਣ ਮੇਰਾ ਕੋਈ ਦਾਵਾ (ਜਾ ਦਾਓ) ਨਹੀਂ ਚਲਦਾ ॥੩੬੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "अस कोई चलत ने मेरा दावा ॥३६५॥",
      "sourceLineId": "139990",
      "sourceShabadId": "12791",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੋਹਰਾ ॥",
      "transliteration": "dhoharaa ||",
      "translation": "",
      "punjabiViakhya": "ਦੋਹਰਾ:",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "दोहरा ॥",
      "sourceLineId": "139991",
      "sourceShabadId": "12792",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਕੀ ਸਰਨਿ ਜੇ ਪਰੇ ਸੁ ਲਏ ਬਚਾਇ ॥",
      "transliteration": "mahaa kaal kee saran je pare su le bachai ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਦੀ ਜੋ ਸ਼ਰਨ ਵਿਚ ਪੈਂਦਾ ਹੈ, ਉਸ ਨੂੰ ਬਚਾ ਲਿਆ ਜਾਦਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "महा काल की सरनि जे परे सु लए बचाइ ॥",
      "sourceLineId": "139992",
      "sourceShabadId": "12792",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਔਰ ਨ ਉਪਜਾ ਦੂਸਰ ਜਗ ਭਛਿਯੋ ਸਭੈ ਬਨਾਇ ॥੩੬੬॥",
      "transliteration": "aauar na upajaa dhoosar jag bhachhiyo sabhai banai ||366||",
      "translation": "",
      "punjabiViakhya": "ਹੋਰ ਦੂਜਾ (ਦੈਂਤ) ਜਗਤ ਵਿਚ ਪੈਦਾ ਨਹੀਂ ਹੋਇਆ, (ਕਾਲਿ ਨੇ) ਸਭ ਨੂੰ ਖਾ ਲਿਆ ॥੩੬੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "और न उपजा दूसर जग भछियो सभै बनाइ ॥३६६॥",
      "sourceLineId": "139993",
      "sourceShabadId": "12792",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੋ ਪੂਜਾ ਅਸਿਕੇਤੁ ਕੀ ਨਿਤ ਪ੍ਰਤਿ ਕਰੈ ਬਨਾਇ ॥",
      "transliteration": "jo poojaa asiket kee nit prat karai banai ||",
      "translation": "",
      "punjabiViakhya": "ਜੋ ਅਸਿਕੇਤੁ (ਮਹਾ ਕਾਲ) ਦੀ ਹਰ ਰੋਜ਼ ਪੂਜਾ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "जो पूजा असिकेतु की नित प्रति करै बनाइ ॥",
      "sourceLineId": "139994",
      "sourceShabadId": "12792",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਿਨ ਪਰ ਅਪਨੋ ਹਾਥ ਦੈ ਅਸਿਧੁਜ ਲੇਤ ਬਚਾਇ ॥੩੬੭॥",
      "transliteration": "tin par apano haath dhai asidhuj let bachai ||367||",
      "translation": "",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਨੂੰ ਆਪਣਾ ਹੱਥ ਦੇ ਕੇ ਅਸਿਧੁਜ ਬਚਾ ਲੈਂਦਾ ਹੈ ॥੩੬੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "तिन पर अपनो हाथ दै असिधुज लेत बचाइ ॥३६७॥",
      "sourceLineId": "139995",
      "sourceShabadId": "12792",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "139996",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੁਸਟ ਦੈਤ ਕਛੁ ਬਾਤ ਨ ਜਾਨੀ ॥",
      "transliteration": "dhusaT dhait kachh baat na jaanee ||",
      "translation": "",
      "punjabiViakhya": "ਦੁਸ਼ਟ ਦੈਂਤ ਨੇ ਕੋਈ ਗੱਲ ਨਾ ਸਮਝੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "दुसट दैत कछु बात न जानी ॥",
      "sourceLineId": "139997",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਤਨ ਪੁਨਿ ਰਿਸਿ ਠਾਨੀ ॥",
      "transliteration": "mahaa kaal tan pun ris Thaanee ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਪ੍ਰਤਿ (ਉਸ ਨੇ) ਫਿਰ ਰੋਹ ਪਾਲ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "महा काल तन पुनि रिसि ठानी ॥",
      "sourceLineId": "139998",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਲ ਅਪਬਲ ਅਪਨੋ ਨ ਬਿਚਾਰਾ ॥",
      "transliteration": "bal apabal apano na bichaaraa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਆਪਣੀ ਸ਼ਕਤੀ ਅਤੇ ਕਮਜ਼ੋਰੀ ਨੂੰ ਨਾ ਵਿਚਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "बल अपबल अपनो न बिचारा ॥",
      "sourceLineId": "139999",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗਰਬ ਠਾਨਿ ਜਿਯ ਬਹੁਰਿ ਹੰਕਾਰਾ ॥੩੬੮॥",
      "transliteration": "garab Thaan jiy bahur ha(n)kaaraa ||368||",
      "translation": "",
      "punjabiViakhya": "ਮਨ ਵਿਚ ਬਹੁਤ ਅਭਿਮਾਨ ਅਤੇ ਹੰਕਾਰ ਠਾਨ ਲਿਆ ॥੩੬੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "गरब ठानि जिय बहुरि हंकारा ॥३६८॥",
      "sourceLineId": "140000",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰੇ ਰੇ ਕਾਲ ਫੂਲਿ ਜਿਨਿ ਜਾਹੁ ॥",
      "transliteration": "re re kaal fool jin jaahu ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਹਿਣ ਲਗਾ) ਹੇ ਕਾਲ! ਐਵੇਾਂ ਫੁਲਿਆ ਨਾ ਫਿਰ,",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "रे रे काल फूलि जिनि जाहु ॥",
      "sourceLineId": "140001",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1385_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਹੁਰਿ ਆਨਿ ਸੰਗ੍ਰਾਮ ਮਚਾਹੁ ॥",
      "transliteration": "bahur aan sa(n)graam machaahu ||",
      "translation": "",
      "punjabiViakhya": "(ਮੇਰੇ ਨਾਲ) ਆ ਕੇ ਫਿਰ ਯੁੱਧ ਕਰ।",
      "source": "DASAM_GRANTH",
      "ang": 1385,
      "hindi": "",
      "hindiTransliteration": "बहुरि आनि संग्राम मचाहु ॥",
      "sourceLineId": "140002",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
