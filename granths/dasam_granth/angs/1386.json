{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1386,
  "lineCount": 72,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1386_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਏਕ ਨਿਦਾਨ ਕਰੋ ਰਨ ਮਾਹੀ ॥",
      "transliteration": "ek nidhaan karo ran maahee ||",
      "translation": "",
      "punjabiViakhya": "(ਅਜ) ਯੁੱਧ-ਭੂਮੀ ਵਿਚ ਇਕ ਨਿਰਣਾ ਹੋ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "एक निदान करो रन माही ॥",
      "sourceLineId": "140003",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੈ ਅਸਿਧੁਜਿ ਕੈ ਦਾਨਵ ਨਾਹੀ ॥੩੬੯॥",
      "transliteration": "kai asidhuj kai dhaanav naahee ||369||",
      "translation": "",
      "punjabiViakhya": "ਜਾ ਅਸਿਧੁਜ ਨਹੀਂ ਜਾ ਦੈਂਤ ਨਹੀਂ ॥੩੬੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "कै असिधुजि कै दानव नाही ॥३६९॥",
      "sourceLineId": "140004",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਏਕ ਪਾਵ ਤਜਿ ਜੁਧ ਨ ਭਾਜਾ ॥",
      "transliteration": "ek paav taj judh na bhaajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ) ਦੈਂਤਾ ਦਾ ਰਾਜਾ ਇਕ ਵੀ ਪੈਰ",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "एक पाव तजि जुध न भाजा ॥",
      "sourceLineId": "140005",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਹਾਰਾਜ ਦੈਤਨ ਕਾ ਰਾਜਾ ॥",
      "transliteration": "mahaaraaj dhaitan kaa raajaa ||",
      "translation": "",
      "punjabiViakhya": "ਪਿਛੇ ਕਰ ਕੇ ਯੁੱਧ ਤੋਂ ਨਾ ਭਜਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "महाराज दैतन का राजा ॥",
      "sourceLineId": "140006",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਆਂਤੌ ਗੀਧ ਗਗਨ ਲੈ ਗਏ ॥",
      "transliteration": "aa(n)tau geedh gagan lai ge ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਵੇਾਂ ਉਸ ਦੀਆਂ ਆਂਦਰਾ ਗਿੱਧਾ ਲੈ ਕੇ ਆਕਾਸ਼ ਵਿਚ ਪਹੁੰਚ ਗਈਆਂ,",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "आँतौ गीध गगन लै गए ॥",
      "sourceLineId": "140007",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਾਹਤ ਬਿਸਿਖ ਤਊ ਹਠ ਭਏ ॥੩੭੦॥",
      "transliteration": "baahat bisikh tuoo haTh bhe ||370||",
      "translation": "",
      "punjabiViakhya": "ਤਾ ਵੀ ਉਹ ਹਠ ਪੂਰਵਕ ਬਾਣ ਚਲਾਉਾਂਦਾ ਰਿਹਾ ॥੩੭੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "बाहत बिसिख तऊ हठ भए ॥३७०॥",
      "sourceLineId": "140008",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਸੁਰ ਅਮਿਤ ਰਨ ਬਾਨ ਚਲਾਏ ॥",
      "transliteration": "asur amit ran baan chalaae ||",
      "translation": "",
      "punjabiViakhya": "ਦੈਂਤ ਰਾਜੇ ਨੇ ਰਣ ਵਿਚ ਅਣਗਿਣਤ ਤੀਰ ਚਲਾਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "असुर अमित रन बान चलाए ॥",
      "sourceLineId": "140009",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਿਰਖਿ ਖੜਗਧੁਜ ਕਾਟਿ ਗਿਰਾਏ ॥",
      "transliteration": "nirakh khaRagadhuj kaaT giraae ||",
      "translation": "",
      "punjabiViakhya": "ਪਰ ਖੜਗਧੁਜ (ਮਹਾ ਕਾਲ) ਨੇ ਵੇਖ ਕੇ ਕਟ ਸੁਟੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "निरखि खड़गधुज काटि गिराए ॥",
      "sourceLineId": "140010",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬੀਸ ਸਹਸ੍ਰ ਅਸੁਰ ਪਰ ਬਾਨਾ ॥",
      "transliteration": "bees sahasr asur par baanaa ||",
      "translation": "",
      "punjabiViakhya": "ਤਦ ਅਸਿਧੁਜ (ਮਹਾ ਕਾਲ) ਨੇ ਕਈ ਤਰ੍ਰਹਾ ਨਾਲ",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "बीस सहस्र असुर पर बाना ॥",
      "sourceLineId": "140011",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸ੍ਰੀ ਅਸਿਧੁਜ ਛਾਡੇ ਬਿਧਿ ਨਾਨਾ ॥੩੭੧॥",
      "transliteration": "sree asidhuj chhaadde bidh naanaa ||371||",
      "translation": "",
      "punjabiViakhya": "ਵੀਹ ਹਜ਼ਾਰਾ ਬਾਣ ਦੈਂਤ ਉਤੇ ਛਡੇ ॥੩੭੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "स्री असिधुज छाडे बिधि नाना ॥३७१॥",
      "sourceLineId": "140012",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਹਾ ਕਾਲ ਪੁਨਿ ਜਿਯ ਮੈ ਕੋਪਾ ॥",
      "transliteration": "mahaa kaal pun jiy mai kopaa ||",
      "translation": "",
      "punjabiViakhya": "ਮਹਾ ਕਾਲ ਫਿਰ ਮਨ ਵਿਚ ਕ੍ਰੋਧਵਾਨ ਹੋਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "महा काल पुनि जिय मै कोपा ॥",
      "sourceLineId": "140013",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਧਨੁਖ ਟੰਕੋਰ ਬਹੁਰਿ ਰਨ ਰੋਪਾ ॥",
      "transliteration": "dhanukh Ta(n)kor bahur ran ropaa ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਧਨੁਸ਼ ਨੂੰ ਟੰਕਾਰ ਕੇ ਫਿਰ ਯੁੱਧ ਜਮਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "धनुख टंकोर बहुरि रन रोपा ॥",
      "sourceLineId": "140014",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਏਕ ਬਾਨ ਤੇ ਧੁਜਹਿ ਗਿਰਾਯੋ ॥",
      "transliteration": "ek baan te dhujeh giraayo ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਨੇ) ਇਕ ਬਾਣ ਨਾਲ (ਦੈਂਤ ਦਾ) ਝੰਡਾ ਡਿਗਾ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "एक बान ते धुजहि गिरायो ॥",
      "sourceLineId": "140015",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੁਤਿਯ ਸਤ੍ਰੁ ਕੋ ਸੀਸ ਉਡਾਯੋ ॥੩੭੨॥",
      "transliteration": "dhutiy satr ko sees uddaayo ||372||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜੇ ਨਾਲ ਵੈਰੀ ਦਾ ਸਿਰ ਉਡਾ ਦਿੱਤਾ ॥੩੭੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "दुतिय सत्रु को सीस उडायो ॥३७२॥",
      "sourceLineId": "140016",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੁਹੂੰ ਬਿਸਿਖ ਕਰਿ ਦ੍ਵੈ ਰਥ ਚਕ੍ਰ ॥",
      "transliteration": "dhuhoo(n) bisikh kar dhavai rath chakr ||",
      "translation": "",
      "punjabiViakhya": "ਦੋ ਤੀਰਾ ਨਾਲ ਰਥ ਦੇ ਦੋਵੇਾਂ ਟੇਢੇ ਚਕ੍ਰ (ਪਹੀਏ)",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "दुहूँ बिसिख करि द्वै रथ चक्र ॥",
      "sourceLineId": "140017",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਾਟਿ ਦਏ ਛਿਨ ਇਕ ਮੈ ਬਕ੍ਰ ॥",
      "transliteration": "kaaT dhe chhin ik mai bakr ||",
      "translation": "",
      "punjabiViakhya": "ਇਕ ਛਿਣ ਵਿਚ ਕਟ ਦਿੱਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "काटि दए छिन इक मै बक्र ॥",
      "sourceLineId": "140018",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚਾਰਹਿ ਬਾਨ ਚਾਰ ਹੂੰ ਬਾਜਾ ॥",
      "transliteration": "chaareh baan chaar hoo(n) baajaa ||",
      "translation": "",
      "punjabiViakhya": "ਚਾਰ ਤੀਰਾ ਨਾਲ ਚੌਹਾ ਹੀ ਘੋੜਿਆਂ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "चारहि बान चार हूँ बाजा ॥",
      "sourceLineId": "140019",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਾਰ ਦਏ ਸਭ ਜਗ ਕੇ ਰਾਜਾ ॥੩੭੩॥",
      "transliteration": "maar dhe sabh jag ke raajaa ||373||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰੇ ਜਗਤ ਦੇ ਰਾਜੇ ਨੇ ਮਾਰ ਦਿੱਤਾ ॥੩੭੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "मार दए सभ जग के राजा ॥३७३॥",
      "sourceLineId": "140020",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਹੁਰਿ ਅਸੁਰ ਕਾ ਕਾਟਸਿ ਮਾਥਾ ॥",
      "transliteration": "bahur asur kaa kaaTas maathaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਜਗਤ ਦੇ ਨਾਥ ਅਸਿਕੇਤੁ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "बहुरि असुर का काटसि माथा ॥",
      "sourceLineId": "140021",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸ੍ਰੀ ਅਸਿਕੇਤਿ ਜਗਤ ਕੇ ਨਾਥਾ ॥",
      "transliteration": "sree asiket jagat ke naathaa ||",
      "translation": "",
      "punjabiViakhya": "(ਬਾਣ ਮਾਰ ਕੇ) ਦੈਂਤ ਦਾ ਮੱਥਾ ਕਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "स्री असिकेति जगत के नाथा ॥",
      "sourceLineId": "140022",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੁਤਿਯ ਬਾਨ ਸੌ ਦੋਊ ਅਰਿ ਕਰ ॥",
      "transliteration": "dhutiy baan sau dhouoo ar kar ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ ਮਨੁੱਖਾ ਦੇ ਰਾਜੇ ਅਸਿਧੁਜ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "दुतिय बान सौ दोऊ अरि कर ॥",
      "sourceLineId": "140023",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਾਟਿ ਦਯੋ ਅਸਿਧੁਜ ਨਰ ਨਾਹਰ ॥੩੭੪॥",
      "transliteration": "kaaT dhayo asidhuj nar naahar ||374||",
      "translation": "",
      "punjabiViakhya": "ਦੂਜੇ ਬਾਣ ਨਾਲ ਵੈਰੀ ਦੇ ਹੱਥ ਕਟ ਸੁਟੇ ॥੩੭੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "काटि दयो असिधुज नर नाहर ॥३७४॥",
      "sourceLineId": "140024",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪੁਨਿ ਰਾਛਸ ਕਾ ਕਾਟਾ ਸੀਸਾ ॥",
      "transliteration": "pun raachhas kaa kaaTaa seesaa ||",
      "translation": "",
      "punjabiViakhya": "ਫਿਰ ਜਗਤ ਦੇ ਸੁਆਮੀ ਅਸਿਕੇਤੁ ਨੇ",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "पुनि राछस का काटा सीसा ॥",
      "sourceLineId": "140025",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸ੍ਰੀ ਅਸਿਕੇਤੁ ਜਗਤ ਕੇ ਈਸਾ ॥",
      "transliteration": "sree asiket jagat ke ieesaa ||",
      "translation": "",
      "punjabiViakhya": "ਰਾਖਸ਼ ਦਾ ਸੀਸ ਕਟ ਦਿੱਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "स्री असिकेतु जगत के ईसा ॥",
      "sourceLineId": "140026",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪੁਹਪਨ ਬ੍ਰਿਸਟਿ ਗਗਨ ਤੇ ਭਈ ॥",
      "transliteration": "puhapan birasaT gagan te bhiee ||",
      "translation": "",
      "punjabiViakhya": "ਆਕਾਸ਼ ਤੋਂ ਫੁਲਾ ਦੀ ਬਰਖਾ ਹੋਈ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "पुहपन बृसटि गगन ते भई ॥",
      "sourceLineId": "140027",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਭਹਿਨ ਆਨਿ ਬਧਾਈ ਦਈ ॥੩੭੫॥",
      "transliteration": "sabhahin aan badhaiee dhiee ||375||",
      "translation": "",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਨੇ ਆ ਕੇ ਵਧਾਈ ਦਿੱਤੀ ॥੩੭੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "सभहिन आनि बधाई दई ॥३७५॥",
      "sourceLineId": "140028",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਧੰਨ੍ਯ ਧੰਨ੍ਯ ਲੋਗਨ ਕੇ ਰਾਜਾ ॥",
      "transliteration": "dha(n)nay dha(n)nay logan ke raajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਅਤੇ ਕਿਹਾ) ਹੇ ਲੋਕਾ ਦੇ ਰਾਜੇ! ਤੁਸੀਂ ਧੰਨ ਹੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "धंन्य धंन्य लोगन के राजा ॥",
      "sourceLineId": "140029",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੁਸਟਨ ਦਾਹ ਗਰੀਬ ਨਿਵਾਜਾ ॥",
      "transliteration": "dhusaTan dhaeh gareeb nivaajaa ||",
      "translation": "",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਦੁਸ਼ਟਾ ਨੂੰ ਮਾਰ ਕੇ ਗ਼ਰੀਬਾ ਦੀ ਰਖਿਆ ਕੀਤੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "दुसटन दाह गरीब निवाजा ॥",
      "sourceLineId": "140030",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਖਲ ਭਵਨ ਕੇ ਸਿਰਜਨਹਾਰੇ ॥",
      "transliteration": "akhal bhavan ke sirajanahaare ||",
      "translation": "",
      "punjabiViakhya": "ਹੇ ਸਾਰੇ ਸੰਸਾਰ ਦੀ ਸਿਰਜਨਾ ਕਰਨ ਵਾਲੇ!",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "अखल भवन के सिरजनहारे ॥",
      "sourceLineId": "140031",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦਾਸ ਜਾਨਿ ਮੁਹਿ ਲੇਹੁ ਉਬਾਰੇ ॥੩੭੬॥",
      "transliteration": "dhaas jaan muh leh ubaare ||376||",
      "translation": "",
      "punjabiViakhya": "ਦਾਸ ਜਾਣ ਕੇ ਮੇਰੀ ਰਖਿਆ ਕਰੋ ॥੩੭੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "दास जानि मुहि लेहु उबारे ॥३७६॥",
      "sourceLineId": "140032",
      "sourceShabadId": "12793",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਬਿਯੋ ਬਾਚ ਬੇਨਤੀ ॥",
      "transliteration": "kabiyo baach benatee ||",
      "translation": "Speech of the poet.",
      "punjabiViakhya": "ਕਵੀ ਨੇ ਬੇਨਤੀ ਕੀਤੀ:",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "कबियो बाच बेनती ॥",
      "sourceLineId": "140033",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "Chaupai",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "140034",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਮਰੀ ਕਰੋ ਹਾਥ ਦੈ ਰੱਛਾ ॥",
      "transliteration": "hamaree karo haath dhai ra'chhaa ||",
      "translation": "Protect me O Lord! with Thine own Hands",
      "punjabiViakhya": "(ਹੇ ਪਰਮ ਸੱਤਾ!) ਆਪਣਾ ਹੱਥ ਦੇ ਕੇ ਮੇਰੀ ਰਖਿਆ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "हमरी करो हाथ दै रच्छा ॥",
      "sourceLineId": "140035",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪੂਰਨ ਹੋਇ ਚਿਤ ਕੀ ਇੱਛਾ ॥",
      "transliteration": "pooran hoi chit kee i'chhaa ||",
      "translation": "all the desires of my heart be fulfilled.",
      "punjabiViakhya": "(ਤਾ ਜੋ) ਮੇਰੇ ਚਿਤ ਦੀ ਇੱਛਾ ਪੂਰੀ ਹੋ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "पूरन होइ चित की इच्छा ॥",
      "sourceLineId": "140036",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਵ ਚਰਨਨ ਮਨ ਰਹੈ ਹਮਾਰਾ ॥",
      "transliteration": "tav charanan man rahai hamaaraa ||",
      "translation": "Let my mind rest under Thy Feet",
      "punjabiViakhya": "ਮੇਰਾ ਮਨ (ਸਦਾ) ਤੁਹਾਡੇ ਚਰਨਾ ਨਾਲ ਜੁੜਿਆ ਰਹੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "तव चरनन मन रहै हमारा ॥",
      "sourceLineId": "140037",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਪਨਾ ਜਾਨ ਕਰੋ ਪ੍ਰਤਿਪਾਰਾ ॥੩੭੭॥",
      "transliteration": "apanaa jaan karo pratipaaraa ||377||",
      "translation": "Sustain me, considering me Thine own.377.",
      "punjabiViakhya": "ਆਪਣਾ ਜਾਣ ਕੇ ਮੇਰੀ ਪ੍ਰਤਿਪਾਲਨਾ ਕਰੋ ॥੩੭੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "अपना जान करो प्रतिपारा ॥३७७॥",
      "sourceLineId": "140038",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਮਰੇ ਦੁਸਟ ਸਭੈ ਤੁਮ ਘਾਵਹੁ ॥",
      "transliteration": "hamare dhusaT sabhai tum ghaavahu ||",
      "translation": "Destroy, O Lord! all my enemies and",
      "punjabiViakhya": "ਮੇਰੇ ਸਾਰੇ ਦੁਸ਼ਟਾ (ਦੁਸ਼ਮਣਾ) ਨੂੰ ਤੁਸੀਂ ਖ਼ਤਮ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "हमरे दुसट सभै तुम घावहु ॥",
      "sourceLineId": "140039",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਪੁ ਹਾਥ ਦੈ ਮੋਹਿ ਬਚਾਵਹੁ ॥",
      "transliteration": "aap haath dhai moh bachaavahu ||",
      "translation": "protect me with Thine own Hands.",
      "punjabiViakhya": "ਮੈਨੂੰ ਆਪਣਾ ਹੱਥ ਦੇ ਕੇ ਬਚਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "आपु हाथ दै मोहि बचावहु ॥",
      "sourceLineId": "140040",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੁਖੀ ਬਸੈ ਮੋਰੋ ਪਰਿਵਾਰਾ ॥",
      "transliteration": "sukhee basai moro parivaaraa ||",
      "translation": "May my family live in comfort",
      "punjabiViakhya": "ਹੇ ਕਰਤਾਰ! ਮੇਰਾ ਪਰਿਵਾਰ,",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "सुखी बसै मोरो परिवारा ॥",
      "sourceLineId": "140041",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੇਵਕ ਸਿੱਖ ਸਭੈ ਕਰਤਾਰਾ ॥੩੭੮॥",
      "transliteration": "sevak si'kh sabhai karataaraa ||378||",
      "translation": "and ease alongwith all my servants and disciples.378.",
      "punjabiViakhya": "ਸੇਵਕ, ਸਿੱਖ ਸਭ ਸੁਖੀ ਵਸਦੇ ਰਹਿਣ ॥੩੭੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "सेवक सिक्ख सभै करतारा ॥३७८॥",
      "sourceLineId": "140042",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮੋ ਰੱਛਾ ਨਿਜ ਕਰ ਦੈ ਕਰਿਯੈ ॥",
      "transliteration": "mo ra'chhaa nij kar dhai kariyai ||",
      "translation": "Protect me O Lord! with Thine own Hands",
      "punjabiViakhya": "ਆਪਣਾ ਹੱਥ ਦੇ ਕੇ ਮੇਰੀ ਰਖਿਆ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "मो रच्छा निज कर दै करियै ॥",
      "sourceLineId": "140043",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਭ ਬੈਰਨ ਕੋ ਆਜ ਸੰਘਰਿਯੈ ॥",
      "transliteration": "sabh bairan ko aaj sa(n)ghariyai ||",
      "translation": "and destroy this day all my enemies",
      "punjabiViakhya": "ਸਾਰਿਆਂ ਵੈਰੀਆਂ ਨੂੰ ਅਜ ਹੀ ਮਾਰ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "सभ बैरन को आज संघरियै ॥",
      "sourceLineId": "140044",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪੂਰਨ ਹੋਇ ਹਮਾਰੀ ਆਸਾ ॥",
      "transliteration": "pooran hoi hamaaree aasaa ||",
      "translation": "May all the aspirations be fulfilled",
      "punjabiViakhya": "ਮੇਰੀ ਆਸ ਪੂਰੀ ਹੋ ਜਾਏ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "पूरन होइ हमारी आसा ॥",
      "sourceLineId": "140045",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤੋਰ ਭਜਨ ਕੀ ਰਹੈ ਪਿਆਸਾ ॥੩੭੯॥",
      "transliteration": "tor bhajan kee rahai piaasaa ||379||",
      "translation": "Let my thirst for Thy Name remain afresh.379.",
      "punjabiViakhya": "(ਸਦਾ) ਤੇਰੇ ਭਜਨ ਲਈ (ਅਥਵਾ ਭਗਤੀ ਲਈ) ਪਿਆਸ (ਤੀਬਰ ਇੱਛਾ) ਬਣੀ ਰਹੇ ॥੩੭੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "तोर भजन की रहै पिआसा ॥३७९॥",
      "sourceLineId": "140046",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤੁਮਹਿ ਛਾਡਿ ਕੋਈ ਅਵਰ ਨ ਧਿਯਾਊਂ ॥",
      "transliteration": "tumeh chhaadd koiee avar na dhiyaauoo(n) ||",
      "translation": "I may remember none else except Thee",
      "punjabiViakhya": "ਤੁਹਾਨੂੰ ਛਡ ਕੇ ਕਿਸੇ ਹੋਰ ਦੀ ਅਰਾਧਨਾ ਨਾ ਕਰਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "तुमहि छाडि कोई अवर न धियाऊं ॥",
      "sourceLineId": "140047",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੋ ਬਰ ਚਹੋਂ ਸੁ ਤੁਮ ਤੇ ਪਾਊਂ ॥",
      "transliteration": "jo bar chaho(n) su tum te paauoo(n) ||",
      "translation": "And obtain all the required boons from Thee",
      "punjabiViakhya": "ਜੋ ਵਰ ਚਾਹਵਾ, ਤੁਹਾਡੇ ਤੋਂ ਹੀ ਪ੍ਰਾਪਤ ਕਰਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "जो बर चहों सु तुम ते पाऊं ॥",
      "sourceLineId": "140048",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੇਵਕ ਸਿੱਖ ਹਮਾਰੇ ਤਾਰੀਅਹਿ ॥",
      "transliteration": "sevak si'kh hamaare taare'eh ||",
      "translation": "Let my servants and disciples cross the world-ocean",
      "punjabiViakhya": "ਮੇਰੇ ਸੇਵਕਾ ਅਤੇ ਸਿੱਖਾ ਨੂੰ (ਭਵਸਾਗਰ ਵਿਚੋਂ) ਤਾਰ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "सेवक सिक्ख हमारे तारीअहि ॥",
      "sourceLineId": "140049",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚੁਨਿ ਚੁਨਿ ਸਤ੍ਰ ਹਮਾਰੇ ਮਾਰੀਅਹਿ ॥੩੮੦॥",
      "transliteration": "chun chun satr hamaare maare'eh ||380||",
      "translation": "All my enemies be singled out and killed.380.",
      "punjabiViakhya": "ਮੇਰੇ ਵੈਰੀਆਂ ਨੂੰ ਚੁਣ ਚੁਣ ਕੇ ਮਾਰ ਦਿਓ ॥੩੮੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "चुनि चुनि सत्र हमारे मारीअहि ॥३८०॥",
      "sourceLineId": "140050",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਆਪ ਹਾਥ ਦੈ ਮੁਝੈ ਉਬਰਿਯੈ ॥",
      "transliteration": "aap haath dhai mujhai ubariyai ||",
      "translation": "Protect me O Lord! with Thine own Hands and",
      "punjabiViakhya": "ਆਪਣਾ ਹੱਥ ਦੇ ਕੇ ਮੇਰਾ ਉੱਧਾਰ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "आप हाथ दै मुझै उबरियै ॥",
      "sourceLineId": "140051",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਮਰਨ ਕਾਲ ਕਾ ਤ੍ਰਾਸ ਨਿਵਰਿਯੈ ॥",
      "transliteration": "maran kaal kaa traas nivariyai ||",
      "translation": "relieve me form the fear of death",
      "punjabiViakhya": "ਮੌਤ ਦੇ ਸਮੇਾਂ ਦਾ ਡਰ ਦੂਰ ਕਰ ਦਿਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "मरन काल का त्रास निवरियै ॥",
      "sourceLineId": "140052",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹੂਜੋ ਸਦਾ ਹਮਾਰੇ ਪੱਛਾ ॥",
      "transliteration": "hoojo sadhaa hamaare pa'chhaa ||",
      "translation": "May Thou ever Bestow Thy favours on my side",
      "punjabiViakhya": "ਸਦਾ ਮੇਰੇ ਪੱਖ ਵਿਚ ਰਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "हूजो सदा हमारे पच्छा ॥",
      "sourceLineId": "140053",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸ੍ਰੀ ਅਸਿਧੁਜ ਜੂ ਕਰਿਯਹੁ ਰੱਛਾ ॥੩੮੧॥",
      "transliteration": "sree asidhuj joo kariyahu ra'chhaa ||381||",
      "translation": "Protect me O Lord! Thou, the Supreme Destroyer.381.",
      "punjabiViakhya": "ਹੇ ਅਸਿਧੁਜ ਜੀ! ਅਤੇ ਮੇਰੀ ਰਖਿਆ ਕਰੋ ॥੩੮੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "स्री असिधुज जू करियहु रच्छा ॥३८१॥",
      "sourceLineId": "140054",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਰਾਖਿ ਲੇਹੁ ਮੁਹਿ ਰਾਖਨਹਾਰੇ ॥",
      "transliteration": "raakh leh muh raakhanahaare ||",
      "translation": "Protect me, O Protector Lord!",
      "punjabiViakhya": "ਹੇ ਰਖਿਆ ਕਰਨ ਵਾਲੇ! ਮੇਰੀ ਰਖਿਆ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "राखि लेहु मुहि राखनहारे ॥",
      "sourceLineId": "140055",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਾਹਿਬ ਸੰਤ ਸਹਾਇ ਪਿਯਾਰੇ ॥",
      "transliteration": "saahib sa(n)t sahai piyaare ||",
      "translation": "Most dear, the Protector of the Saints:",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਸੰਤਾ ਦੇ ਸਾਹਿਬ (ਸੁਆਮੀ) ਅਤੇ ਪਿਆਰੇ ਸਹਾਇਕ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "साहिब संत सहाइ पियारे ॥",
      "sourceLineId": "140056",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਦੀਨ ਬੰਧੁ ਦੁਸਟਨ ਕੇ ਹੰਤਾ ॥",
      "transliteration": "dheen ba(n)dh dhusaTan ke ha(n)taa ||",
      "translation": "Friend of poor and the Destroyer of the enemies",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਦੀਨਾ ਦੇ ਬੰਧੂ ਅਤੇ ਦੁਸ਼ਟਾ ਦੇ ਸੰਘਾਰਕ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "दीन बंधु दुसटन के हंता ॥",
      "sourceLineId": "140057",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਤੁਮ ਹੋ ਪੁਰੀ ਚਤੁਰ ਦਸ ਕੰਤਾ ॥੩੮੨॥",
      "transliteration": "tum ho puree chatur dhas ka(n)taa ||382||",
      "translation": "Thou art the Master of the fourteen worlds.382.",
      "punjabiViakhya": "ਤੁਸੀਂ ਹੀ ਚੌਦਾ ਪੁਰੀਆਂ (ਲੋਕਾ) ਦੇ ਸੁਆਮੀ ਹੋ ॥੩੮੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "तुम हो पुरी चतुर दस कंता ॥३८२॥",
      "sourceLineId": "140058",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਕਾਲ ਪਾਇ ਬ੍ਰਹਮਾ ਬਪੁ ਧਰਾ ॥",
      "transliteration": "kaal pai brahamaa bap dharaa ||",
      "translation": "In due time Brahma appeared in physical form",
      "punjabiViakhya": "ਸਮਾ ਆਣ ਤੇ ਹੀ ਬ੍ਰਹਮਾ ਨੇ ਸ਼ਰੀਰ ਧਾਰਨ ਕੀਤਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "काल पाइ ब्रहमा बपु धरा ॥",
      "sourceLineId": "140059",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਾਲ ਪਾਇ ਸਿਵਜੂ ਅਵਤਰਾ ॥",
      "transliteration": "kaal pai sivajoo avataraa ||",
      "translation": "In due time Shiva incarnated",
      "punjabiViakhya": "ਸਮਾ ਪਾ ਕੇ ਹੀ ਸ਼ਿਵ ਜੀ ਨੇ ਅਵਤਾਰ ਧਾਰਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "काल पाइ सिवजू अवतरा ॥",
      "sourceLineId": "140060",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਾਲ ਪਾਇ ਕਰ ਬਿਸਨੁ ਪ੍ਰਕਾਸਾ ॥",
      "transliteration": "kaal pai kar bisan prakaasaa ||",
      "translation": "In due time Vishnu manifested himself",
      "punjabiViakhya": "ਕਾਲ ਦੀ ਪ੍ਰਾਪਤੀ ਤੇ ਹੀ ਵਿਸ਼ਣੂ ਦਾ ਪ੍ਰਕਾਸ਼ ਹੋਇਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "काल पाइ कर बिसनु प्रकासा ॥",
      "sourceLineId": "140061",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸਕਲ ਕਾਲ ਕਾ ਕੀਆ ਤਮਾਸਾ ॥੩੮੩॥",
      "transliteration": "sakal kaal kaa keeaa tamaasaa ||383||",
      "translation": "All this is the play of the Temporal Lord.383.",
      "punjabiViakhya": "(ਹੇ ਮਹਾਕਾਲ! ਤੁਸੀਂ ਹੀ) ਸਾਰਿਆਂ ਕਾਲਾ ਦਾ ਕੌਤਕ ਰਚਾਇਆ ਹੋਇਆ ਹੈ ॥੩੮੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "सकल काल का कीआ तमासा ॥३८३॥",
      "sourceLineId": "140062",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਜਵਨ ਕਾਲ ਜੋਗੀ ਸਿਵ ਕੀਓ ॥",
      "transliteration": "javan kaal jogee siv keeo ||",
      "translation": "The Temporal Lord, who created Shiva, the Yogi",
      "punjabiViakhya": "ਜਿਸ ਕਾਲ ਨੇ ਸ਼ਿਵ ਨੂੰ ਜੋਗੀ ਬਣਾਇਆ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "जवन काल जोगी सिव कीओ ॥",
      "sourceLineId": "140063",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਬੇਦ ਰਾਜ ਬ੍ਰਹਮਾ ਜੂ ਥੀਓ ॥",
      "transliteration": "bedh raaj brahamaa joo theeo ||",
      "translation": "Who created Brahma, the Master of the Vedas",
      "punjabiViakhya": "ਅਤੇ ਬ੍ਰਹਮਾ ਜੀ ਨੂੰ ਵੇਦਾ ਦਾ ਰਾਜਾ ਬਣਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "बेद राज ब्रहमा जू थीओ ॥",
      "sourceLineId": "140064",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਜਵਨ ਕਾਲ ਸਭ ਲੋਕ ਸਵਾਰਾ ॥",
      "transliteration": "javan kaal sabh lok savaaraa ||",
      "translation": "The Temporal Lord who fashioned the entire world",
      "punjabiViakhya": "ਜਿਸ ਕਾਲ ਨੇ ਸਾਰਿਆਂ ਲੋਕਾ (ਭੁਵਨਾ) ਨੂੰ ਸੰਵਾਰਿਆ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "जवन काल सभ लोक सवारा ॥",
      "sourceLineId": "140065",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਨਮਸਕਾਰ ਹੈ ਤਾਹਿ ਹਮਾਰਾ ॥੩੮੪॥",
      "transliteration": "namasakaar hai taeh hamaaraa ||384||",
      "translation": "I salute the same Lord.384.",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮੇਰਾ ਪ੍ਰਨਾਮ ਹੈ ॥੩੮੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "नमसकार है ताहि हमारा ॥३८४॥",
      "sourceLineId": "140066",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਜਵਨ ਕਾਲ ਸਭ ਜਗਤ ਬਨਾਯੋ ॥",
      "transliteration": "javan kaal sabh jagat banaayo ||",
      "translation": "The Temporal Lord, who created the whole world",
      "punjabiViakhya": "ਜਿਸ ਕਾਲ ਨੇ ਸਾਰਾ ਜਗਤ ਬਣਾਇਆ",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "जवन काल सभ जगत बनायो ॥",
      "sourceLineId": "140067",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਦੇਵ ਦੈਤ ਜੱਛਨ ਉਪਜਾਯੋ ॥",
      "transliteration": "dhev dhait ja'chhan upajaayo ||",
      "translation": "Who created gods, demons and yakshas",
      "punjabiViakhya": "ਅਤੇ ਦੇਵਤੇ, ਦੈਂਤ ਤੇ ਯਕਸ਼ ਪੈਦਾ ਕੀਤੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "देव दैत जच्छन उपजायो ॥",
      "sourceLineId": "140068",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਆਦਿ ਅੰਤਿ ਏਕੈ ਅਵਤਾਰਾ ॥",
      "transliteration": "aadh a(n)t ekai avataaraa ||",
      "translation": "He is the only one form the beginning to the end",
      "punjabiViakhya": "(ਜੋ) ਆਦਿ ਤੋਂ ਅੰਤ ਤਕ ਅਵਤਰਿਤ ਹੈ (ਭਾਵ ਪ੍ਰਕਾਸ਼ਮਾਨ ਹੈ)",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "आदि अंति एकै अवतारा ॥",
      "sourceLineId": "140069",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਸੋਈ ਗੁਰੂ ਸਮਝਿਯਹੁ ਹਮਾਰਾ ॥੩੮੫॥",
      "transliteration": "soiee guroo samajhiyahu hamaaraa ||385||",
      "translation": "I consider Him only my Guru.385.",
      "punjabiViakhya": "ਉਸੇ ਨੂੰ ਮੇਰਾ ਗੁਰੂ ਸਮਝੋ ॥੩੮੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "सोई गुरू समझियहु हमारा ॥३८५॥",
      "sourceLineId": "140070",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਨਮਸਕਾਰ ਤਿਸ ਹੀ ਕੋ ਹਮਾਰੀ ॥",
      "transliteration": "namasakaar tis hee ko hamaaree ||",
      "translation": "I salute Him, non else, but Him",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਮੇਰਾ ਨਮਸਕਾਰ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "नमसकार तिस ही को हमारी ॥",
      "sourceLineId": "140071",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਸਕਲ ਪ੍ਰਜਾ ਜਿਨ ਆਪ ਸਵਾਰੀ ॥",
      "transliteration": "sakal prajaa jin aap savaaree ||",
      "translation": "Who has created Himself and His subject",
      "punjabiViakhya": "ਜਿਸ ਨੇ ਸਾਰੀ ਪ੍ਰਜਾ ਨੂੰ ਬਣਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "सकल प्रजा जिन आप सवारी ॥",
      "sourceLineId": "140072",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਸਿਵਕਨ ਕੋ ਸਿਵਗੁਨ ਸੁਖ ਦੀਓ ॥",
      "transliteration": "sivakan ko sivagun sukh dheeo ||",
      "translation": "He bestows Divine virtues and happiness on His servants",
      "punjabiViakhya": "(ਹੇ ਪਰਮ ਸੱਤਾ! ਤੁਸੀਂ) ਸੇਵਕਾ ਨੂੰ ਸ਼ੁਭ ਗੁਣ ਅਤੇ ਸੁਖ ਦਿੱਤਾ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "सिवकन को सिवगुन सुख दीओ ॥",
      "sourceLineId": "140073",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1386_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਸਤੱ੍ਰੁਨ ਕੋ ਪਲ ਮੋ ਬਧ ਕੀਓ ॥੩੮੬॥",
      "transliteration": "sata'run ko pal mo badh keeo ||386||",
      "translation": "He destroys the enemies instantly.386.",
      "punjabiViakhya": "ਅਤੇ ਵੈਰੀਆਂ ਦਾ ਛਿਣ ਵਿਚ ਵੱਧ ਕੀਤਾ ਹੈ ॥੩੮੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1386,
      "hindi": "",
      "hindiTransliteration": "सत्््रुन को पल मो बध कीओ ॥३८६॥",
      "sourceLineId": "140074",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
