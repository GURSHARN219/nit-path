{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1387,
  "lineCount": 48,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1387_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਘਟ ਘਟ ਕੇ ਅੰਤਰ ਕੀ ਜਾਨਤ ॥",
      "transliteration": "ghaT ghaT ke a(n)tar kee jaanat ||",
      "translation": "He knows the inner feelings of every heart",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਹਰ ਇਕ ਦੇ ਅੰਦਰ ਦੀ ਗੱਲ ਜਾਣਦੇ ਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "घट घट के अंतर की जानत ॥",
      "sourceLineId": "140075",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭਲੇ ਬੁਰੇ ਕੀ ਪੀਰ ਪਛਾਨਤ ॥",
      "transliteration": "bhale bure kee peer pachhaanat ||",
      "translation": "He knows the anguish of both good and bad",
      "punjabiViakhya": "ਅਤੇ ਚੰਗੇ ਮਾੜੇ ਦੀ ਪੀੜ (ਦੁਖ) ਨੂੰ ਪਛਾਣਦੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "भले बुरे की पीर पछानत ॥",
      "sourceLineId": "140076",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚੀਟੀ ਤੇ ਕੁੰਚਰ ਅਸਥੂਲਾ ॥",
      "transliteration": "cheeTee te ku(n)char asathoolaa ||",
      "translation": "From the ant to the solid elephant",
      "punjabiViakhya": "ਕੀੜੀ ਤੋਂ ਲੈ ਕੇ ਵਡਾਕਾਰੇ ਹਾਥੀ ਤਕ,",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "चीटी ते कुँचर असथूला ॥",
      "sourceLineId": "140077",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਭ ਪਰ ਕ੍ਰਿਪਾ ਦ੍ਰਿਸਟਿ ਕਰ ਫੂਲਾ ॥੩੮੭॥",
      "transliteration": "sabh par kirapaa dhirasaT kar foolaa ||387||",
      "translation": "He casts His Graceful glance on all and feels pleased.387.",
      "punjabiViakhya": "ਸਭ ਉਤੇ ਕ੍ਰਿਪਾ ਦ੍ਰਿਸ਼ਟੀ ਰਖ ਕੇ ਪ੍ਰਸੰਨ ਹੁੰਦੇ ਹੋ ॥੩੮੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "सभ पर कृपा दृसटि कर फूला ॥३८७॥",
      "sourceLineId": "140078",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੰਤਨ ਦੁਖ ਪਾਏ ਤੇ ਦੁਖੀ ॥",
      "transliteration": "sa(n)tan dhukh paae te dhukhee ||",
      "translation": "He is painful, when He sees His saints in grief",
      "punjabiViakhya": "ਸੰਤਾ ਦੇ ਦੁਖੀ ਹੋਣ ਤੇ (ਤੁਸੀਂ) ਦੁਖੀ ਹੁੰਦੇ ਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "संतन दुख पाए ते दुखी ॥",
      "sourceLineId": "140079",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੁਖ ਪਾਏ ਸਾਧੁਨ ਕੇ ਸੁਖੀ ॥",
      "transliteration": "sukh paae saadhun ke sukhee ||",
      "translation": "He is happy, when His saints are happy.",
      "punjabiViakhya": "ਅਤੇ ਸਾਧਾ ਦੇ ਸੁਖ ਪ੍ਰਾਪਤ ਕਰਨ ਤੇ ਸੁਖੀ ਹੁੰਦੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "सुख पाए साधुन के सुखी ॥",
      "sourceLineId": "140080",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਏਕ ਏਕ ਕੀ ਪੀਰ ਪਛਾਨੈਂ ॥",
      "transliteration": "ek ek kee peer pachhaanai(n) ||",
      "translation": "He knows the agony of everyone",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਇਕ ਇਕ ਦੇ ਦੁਖ ਨੂੰ ਪਛਾਣਦੇ ਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "एक एक की पीर पछानैं ॥",
      "sourceLineId": "140081",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਘਟ ਘਟ ਕੇ ਪਟ ਪਟ ਕੀ ਜਾਨੈਂ ॥੩੮੮॥",
      "transliteration": "ghaT ghaT ke paT paT kee jaanai(n) ||388||",
      "translation": "He knows the innermost secrets of every heart.388.",
      "punjabiViakhya": "ਅਤੇ ਹਰ ਇਕ ਦੇ ਅੰਦਰ ਪਰਦਿਆਂ (ਵਿਚ ਲੁਕੇ ਭੇਦਾ ਨੂੰ) ਜਾਣਦੇ ਹੋ ॥੩੮੮॥",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "घट घट के पट पट की जानैं ॥३८८॥",
      "sourceLineId": "140082",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਬ ਉਦਕਰਖ ਕਰਾ ਕਰਤਾਰਾ ॥",
      "transliteration": "jab udhakarakh karaa karataaraa ||",
      "translation": "When the Creator projected Himself,",
      "punjabiViakhya": "ਹੇ ਕਰਤਾਰ! ਜਦੋਂ (ਤੁਸੀਂ ਆਪਣਾ) ਵਿਸਤਾਰ ਕਰਦੇ ਹੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "जब उदकरख करा करतारा ॥",
      "sourceLineId": "140083",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪ੍ਰਜਾ ਧਰਤ ਤਬ ਦੇਹ ਅਪਾਰਾ ॥",
      "transliteration": "prajaa dharat tab dheh apaaraa ||",
      "translation": "His creation manifested itself in innumerable forms",
      "punjabiViakhya": "ਤਦ ਸਾਰੀ ਪ੍ਰਜਾ (ਆਪਣੀ) ਅਪਾਰ ਹੋਂਦ ਧਾਰਨ ਕਰਦੀ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "प्रजा धरत तब देह अपारा ॥",
      "sourceLineId": "140084",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਬ ਆਕਰਖ ਕਰਤ ਹੋ ਕਬਹੂੰ ॥",
      "transliteration": "jab aakarakh karat ho kabahoo(n) ||",
      "translation": "When at any time He withdraws His creation,",
      "punjabiViakhya": "ਜਦ ਕਦੇ (ਸ੍ਰਿਸ਼ਟੀ ਨੂੰ ਆਪਣੇ ਵਲ) ਖਿਚਦੇ ਹੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "जब आकरख करत हो कबहूँ ॥",
      "sourceLineId": "140085",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੁਮ ਮੈ ਮਿਲਤ ਦੇਹ ਧਰ ਸਭਹੂੰ ॥੩੮੯॥",
      "transliteration": "tum mai milat dheh dhar sabhahoo(n) ||389||",
      "translation": "all the physical forms are merged in Him.389.",
      "punjabiViakhya": "(ਤਦ) ਤੁਹਾਡੇ ਵਿਚ ਸਾਰੇ ਆਕਾਰ (ਦੇਹ-ਧਾਰੀ) ਸਮਾ ਜਾਦੇ ਹਨ ॥੩੮੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "तुम मै मिलत देह धर सभहूँ ॥३८९॥",
      "sourceLineId": "140086",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੇਤੇ ਬਦਨ ਸ੍ਰਿਸਟਿ ਸਭ ਧਾਰੈ ॥",
      "transliteration": "jete badhan sirasaT sabh dhaarai ||",
      "translation": "All the bodies of living beings created in the world",
      "punjabiViakhya": "ਸ੍ਰਿਸ਼ਟੀ ਵਿਚ ਜਿਤਨੇ ਵੀ ਸਭ ਮੂੰਹ ('ਬਦਨ') ਬਣੇ ਹੋਏ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "जेते बदन सृसटि सभ धारै ॥",
      "sourceLineId": "140087",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਪੁ ਆਪਨੀ ਬੂਝ ਉਚਾਰੈ ॥",
      "transliteration": "aap aapanee boojh uchaarai ||",
      "translation": "speak about Him according to their understanding",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਸਭ ਨੇ) ਆਪਣੀ ਆਪਣੀ ਸੂਝ ਅਨੁਸਾਰ (ਤੇਰੇ ਗੁਣਾ ਦਾ) ਗਾਇਨ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "आपु आपनी बूझ उचारै ॥",
      "sourceLineId": "140088",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤੁਮ ਸਭਹੀ ਤੇ ਰਹਤ ਨਿਰਾਲਮ ॥",
      "transliteration": "tum sabhahee te rahat niraalam ||",
      "translation": "But Thou, O Lord! live quite apart from everything",
      "punjabiViakhya": "ਤੁਸੀਂ ਸਾਰਿਆਂ ਤੋਂ ਬੇਲਾਗ ਰਹਿੰਦੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "तुम सभही ते रहत निरालम ॥",
      "sourceLineId": "140089",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾਨਤ ਬੇਦ ਭੇਦ ਅਰ ਆਲਮ ॥੩੯੦॥",
      "transliteration": "jaanat bedh bhedh ar aalam ||390||",
      "translation": "this fact is know to the Vedas and the learned.390.",
      "punjabiViakhya": "(ਇਸ) ਭੇਦ ਨੂੰ ਸਾਰੇ ਵੇਦ ਅਤੇ (ਸੰਸਾਰ ਦੇ) ਵਿਦਵਾਨ ਜਾਣਦੇ ਹਨ ॥੩੯੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "जानत बेद भेद अर आलम ॥३९०॥",
      "sourceLineId": "140090",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਿਰੰਕਾਰ ਨ੍ਰਿਬਿਕਾਰ ਨਿਰਲੰਭ ॥",
      "transliteration": "nira(n)kaar nirabikaar nirala(n)bh ||",
      "translation": "The Lord is Formless, Sinless and shelterless:",
      "punjabiViakhya": "(ਹੇ ਪਰਮ ਸੱਤਾ! ਤੁਸੀਂ) ਨਿਰਾਕਾਰ, ਨਿਰਵਿਕਾਰ, ਨਿਰਾਧਾਰ ('ਨ੍ਰਿਲੰਭ')",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "निरंकार नृबिकार निरलंभ ॥",
      "sourceLineId": "140091",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਦਿ ਅਨੀਲ ਅਨਾਦਿ ਅਸੰਭ ॥",
      "transliteration": "aadh aneel anaadh asa(n)bh ||",
      "translation": "He is the Primal Power, without Blemish, without Beginning and Unborn",
      "punjabiViakhya": "ਆਦਿ (ਸਰੂਪ) ਅਨੀਲ (ਉਜਲੇ) ਅਨਾਦਿ, ਅਸੰਭ (ਜਨਮ ਰਹਿਤ) ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "आदि अनील अनादि असंभ ॥",
      "sourceLineId": "140092",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਕਾ ਮੂੜ੍ਹ ਉਚਾਰਤ ਭੇਦਾ ॥",
      "transliteration": "taa kaa mooRh uchaarat bhedhaa ||",
      "translation": "The fool claims boastfully about the knowledge of His secrets,",
      "punjabiViakhya": "ਮੂਰਖ ਲੋਗ ਉਸ ਦੇ ਭੇਦ ਦਾ ਵਰਣਨ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "ता का मूड़्ह उचारत भेदा ॥",
      "sourceLineId": "140093",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਾ ਕੋ ਭੇਵ ਨ ਪਾਵਤ ਬੇਦਾ ॥੩੯੧॥",
      "transliteration": "jaa ko bhev na paavat bedhaa ||391||",
      "translation": "which even the Vedas do not know.391.",
      "punjabiViakhya": "ਜਿਸ ਦਾ ਭੇਦ ਵੇਦ ਵੀ ਨਹੀਂ ਪਾ ਸਕੇ ਹਨ ॥੩੯੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "जा को भेव न पावत बेदा ॥३९१॥",
      "sourceLineId": "140094",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਾ ਕੋ ਕਰਿ ਪਾਹਨ ਅਨੁਮਾਨਤ ॥",
      "transliteration": "taa ko kar paahan anumaanat ||",
      "translation": "The fool considers Him a stone,",
      "punjabiViakhya": "(ਜੋ) ਉਸ ਦਾ ਅਨੁਮਾਨ ਪੱਥਰ ਵਿਚ ਕਰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "ता को करि पाहन अनुमानत ॥",
      "sourceLineId": "140095",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਹਾ ਮੂੜ੍ਹ ਕਛੁ ਭੇਦ ਨ ਜਾਨਤ ॥",
      "transliteration": "mahaa mooRh kachh bhedh na jaanat ||",
      "translation": "but the great fool does not know any secret",
      "punjabiViakhya": "(ਉਹ) ਮਹਾ ਮੂਰਖ (ਉਸ ਦਾ) ਕੁਝ ਵੀ ਭੇਦ ਨਹੀਂ ਜਾਣਦੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "महा मूड़्ह कछु भेद न जानत ॥",
      "sourceLineId": "140096",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਹਾਦੇਵ ਕੋ ਕਹਤ ਸਦਾ ਸਿਵ ॥",
      "transliteration": "mahaadhev ko kahat sadhaa siv ||",
      "translation": "He calls Shiva “The Eternal Lord\",",
      "punjabiViakhya": "ਉਹ ਮਹਾਦੇਵ ਨੂੰ ਸਦਾ ਸ਼ਿਵ (ਸਦਾ ਕਲਿਆਣਕਾਰੀ ਈਸ਼ਵਰ) ਕਹਿੰਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "महादेव को कहत सदा सिव ॥",
      "sourceLineId": "140097",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਿਰੰਕਾਰ ਕਾ ਚੀਨਤ ਨਹਿ ਭਿਵ ॥੩੯੨॥",
      "transliteration": "nira(n)kaar kaa cheenat neh bhiv ||392||",
      "translation": "“but he does not know the secret of the Formless Lord.392.",
      "punjabiViakhya": "ਪਰ ਨਿਰੰਕਾਰ ਦਾ ਭੇਦ ਨਹੀਂ ਸਮਝਦੇ ॥੩੯੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "निरंकार का चीनत नहि भिव ॥३९२॥",
      "sourceLineId": "140098",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਪੁ ਆਪਨੀ ਬੁਧਿ ਹੈ ਜੇਤੀ ॥",
      "transliteration": "aap aapanee budh hai jetee ||",
      "translation": "According to ones own intellect,",
      "punjabiViakhya": "(ਹਰ ਇਕ ਦੀ) ਆਪੋ ਆਪਣੀ ਜਿਤਨੀ ਬੁੱਧੀ ਹੈ,",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "आपु आपनी बुधि है जेती ॥",
      "sourceLineId": "140099",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਰਨਤ ਭਿੰਨ ਭਿੰਨ ਤੁਹਿ ਤੇਤੀ ॥",
      "transliteration": "baranat bhi(n)n bhi(n)n tuh tetee ||",
      "translation": "one describes Thee differently",
      "punjabiViakhya": "(ਉਹ) ਤੁਹਾਡਾ ਭਿੰਨ ਭਿੰਨ ਵਰਣਨ ਕਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "बरनत भिंन भिंन तुहि तेती ॥",
      "sourceLineId": "140100",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੁਮਰਾ ਲਖਾ ਨ ਜਾਇ ਪਸਾਰਾ ॥",
      "transliteration": "tumaraa lakhaa na jai pasaaraa ||",
      "translation": "The limits of Thy creation cannot be known",
      "punjabiViakhya": "(ਹੇ ਪ੍ਰਭੂ!) ਤੁਹਾਡੇ ਪਸਾਰੇ ਨੂੰ ਸਮਝਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "तुमरा लखा न जाइ पसारा ॥",
      "sourceLineId": "140101",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਿਹ ਬਿਧਿ ਸਜਾ ਪ੍ਰਥਮ ਸੰਸਾਰਾ ॥੩੯੩॥",
      "transliteration": "keh bidh sajaa pratham sa(n)saaraa ||393||",
      "translation": "and how the world was fashioned in the beginning?393.",
      "punjabiViakhya": "ਕਿ ਕਿਸ ਤਰ੍ਰਹਾ ਪਹਿਲਾ ਸੰਸਾਰ ਸਾਜਿਆ ਗਿਆ ॥੩੯੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "किह बिधि सजा प्रथम संसारा ॥३९३॥",
      "sourceLineId": "140102",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਏਕੈ ਰੂਪ ਅਨੂਪ ਸਰੂਪਾ ॥",
      "transliteration": "ekai roop anoop saroopaa ||",
      "translation": "He hath only one unparalleled Form",
      "punjabiViakhya": "(ਤੇਰਾ) ਇਕੋ ਰੂਪ ਅਨੇਕ ਸਰੂਪਾ ਵਾਲਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "एकै रूप अनूप सरूपा ॥",
      "sourceLineId": "140103",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰੰਕ ਭਯੋ ਰਾਵ ਕਹੀ ਭੂਪਾ ॥",
      "transliteration": "ra(n)k bhayo raav kahee bhoopaa ||",
      "translation": "He manifests Himself as a poor man or a king at different places",
      "punjabiViakhya": "(ਤੁਸੀਂ ਹੀ) ਕਿਤੇ ਰੰਕ ਹੋ, ਕਿਤੇ ਰਾਓ ਅਤੇ ਕਿਤੇ ਰਾਜੇ ਕਹੀਦੇ ਹੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "रंक भयो राव कही भूपा ॥",
      "sourceLineId": "140104",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅੰਡਜ ਜੇਰਜ ਸੇਤਜ ਕੀਨੀ ॥",
      "transliteration": "a(n)ddaj jeraj setaj keenee ||",
      "translation": "He created creatures from eggs, wombs and perspiration",
      "punjabiViakhya": "(ਤੁਸੀਂ ਪਹਿਲਾ) ਅੰਡਜ, ਜੇਰਜ ਅਤੇ ਸੇਤਜ (ਖਾਣੀਆਂ ਦੀ ਰਚਨਾ) ਕੀਤੀ",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "अंडज जेरज सेतज कीनी ॥",
      "sourceLineId": "140105",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਉਤਭੁਜ ਖਾਨਿ ਬਹੁਰ ਰਚਿ ਦੀਨੀ ॥੩੯੪॥",
      "transliteration": "autabhuj khaan bahur rach dheenee ||394||",
      "translation": "Then He created the vegetable kingdom.394.",
      "punjabiViakhya": "ਅਤੇ ਫਿਰ ਉਤਭੁਜ ਖਾਣੀ ਦੀ ਰਚਨਾ ਕਰ ਦਿੱਤੀ ॥੩੯੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "उतभुज खानि बहुर रचि दीनी ॥३९४॥",
      "sourceLineId": "140106",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਹੂੰ ਫੂਲ ਰਾਜਾ ਹ੍ਵੈ ਬੈਠਾ ॥",
      "transliteration": "kahoo(n) fool raajaa havai baiThaa ||",
      "translation": "Somewhere He sits joyfully as a king",
      "punjabiViakhya": "ਕਿਤੇ (ਤੁਸੀਂ) ਪ੍ਰਸੰਨਤਾ ਪੂਰਵਕ ਰਾਜੇ ਬਣੇ ਬੈਠੇ ਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "कहूँ फूल राजा ह्वै बैठा ॥",
      "sourceLineId": "140107",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹੂੰ ਸਿਮਟਿ ਭ੍ਯਿੋ ਸੰਕਰ ਇਕੈਠਾ ॥",
      "transliteration": "kahoo(n) simaT bhiyo sa(n)kar ikaiThaa ||",
      "translation": "Somewhere He contracts Himself as Shiva, the Yogi",
      "punjabiViakhya": "ਅਤੇ ਕਿਤੇ ਸਿਮਟ ਕੇ ਸ਼ੰਕਰ ਦੀ (ਮੂਰਤੀ ਵਿਚ) ਇਕੱਠੇ ਹੋ ਗਏ ਹੋ (ਅਰਥਾਤਰ- ਕਿਤੇ ਸੰਯੁਕਤ ਹੋ ਕੇ ਇਕੱਠੇ ਸਿਮਟੇ ਹੋਏ ਹੋ)।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "कहूँ सिमटि भि्यो संकर इकैठा ॥",
      "sourceLineId": "140108",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਗਰੀ ਸ੍ਰਿਸਟਿ ਦਿਖਾਇ ਅਚੰਭਵ ॥",
      "transliteration": "sagaree sirasaT dhikhai acha(n)bhav ||",
      "translation": "All His creation unfolds wonderful things",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਸਾਰੀ ਸ੍ਰਿਸ਼ਟੀ ਦਾ ਅਚੰਭਾ ਵਿਖਾਇਆ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "सगरी सृसटि दिखाइ अचंभव ॥",
      "sourceLineId": "140109",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਦਿ ਜੁਗਾਦਿ ਸਰੂਪ ਸੁਯੰਭਵ ॥੩੯੫॥",
      "transliteration": "aadh jugaadh saroop suya(n)bhav ||395||",
      "translation": "He, the Primal Power, is from the beginning and Self-Existent.395.",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਮੁਢ ਵਿਚ, ਜੁਗਾ ਦੇ ਆਰੰਭ ਵਿਚ ਆਪਣੇ ਆਪ ਹੋਂਦ ਵਿਚ ਆਣ ਵਾਲੇ ਸਰੂਪ ਹੋ ॥੩੯੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "आदि जुगादि सरूप सुयंभव ॥३९५॥",
      "sourceLineId": "140110",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਬ ਰੱਛਾ ਮੇਰੀ ਤੁਮ ਕਰੋ ॥",
      "transliteration": "ab ra'chhaa meree tum karo ||",
      "translation": "O Lord! keep me now under Thy protection",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਹੁਣ ਮੇਰੀ ਰਖਿਆ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "अब रच्छा मेरी तुम करो ॥",
      "sourceLineId": "140111",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਿੱਖ ਉਬਾਰਿ ਅਸਿੱਖ ਸੰਘਰੋ ॥",
      "transliteration": "si'kh ubaar asi'kh sa(n)gharo ||",
      "translation": "Protect my disciples and destroy my enemies",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਸਿੱਖਾ ਨੂੰ ਬਚਾਓ ਅਤੇ ਅਸਿੱਖਾ ਨੂੰ ਨਸ਼ਟ ਕਰੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "सिक्ख उबारि असिक्ख संघरो ॥",
      "sourceLineId": "140112",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੁਸ਼ਟ ਜਿਤੇ ਉਠਵਤ ਉਤਪਾਤਾ ॥",
      "transliteration": "dhushaT jite uThavat utapaataa ||",
      "translation": "All the villains creations outrage",
      "punjabiViakhya": "ਜਿਤਨੇ ਦੁਸ਼ਟ ਉਤਪਾਤ (ਉਪਦ੍ਰ) ਮਚਾਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "दुशट जिते उठवत उतपाता ॥",
      "sourceLineId": "140113",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਕਲ ਮਲੇਛ ਕਰੋ ਰਣ ਘਾਤਾ ॥੩੯੬॥",
      "transliteration": "sakal malechh karo ran ghaataa ||396||",
      "translation": "and all the infidels be destroyed in the battlefield.396.",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ) ਸਾਰਿਆਂ ਮਲੇਛਾ ਦਾ ਰਣ ਵਿਚ ਨਾਸ਼ ਕਰੋ ॥੩੯੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "सकल मलेछ करो रण घाता ॥३९६॥",
      "sourceLineId": "140114",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੇ ਅਸਿਧੁਜ ਤਵ ਸਰਨੀ ਪਰੇ ॥",
      "transliteration": "je asidhuj tav saranee pare ||",
      "translation": "O Supreme Destroyer! those who sought Thy refuge,",
      "punjabiViakhya": "ਹੇ ਅਸਿਧੁਜ! ਜੋ ਤੁਹਾਡੀ ਸ਼ਰਨ ਵਿਚ ਪੈਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "जे असिधुज तव सरनी परे ॥",
      "sourceLineId": "140115",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਿਨ ਕੇ ਦੁਸ਼ਟ ਦੁਖਿਤ ਹ੍ਵੈ ਮਰੇ ॥",
      "transliteration": "tin ke dhushaT dhukhit havai mare ||",
      "translation": "their enemies met painful death",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਦੁਸ਼ਟ (ਦੁਸ਼ਮਨ) ਦੁਖੀ ਹੋ ਕੇ ਮਰਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "तिन के दुशट दुखित ह्वै मरे ॥",
      "sourceLineId": "140116",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪੁਰਖ ਜਵਨ ਪਗ ਪਰੇ ਤਿਹਾਰੇ ॥",
      "transliteration": "purakh javan pag pare tihaare ||",
      "translation": "The persons who fell at Thy Feet,",
      "punjabiViakhya": "(ਜੋ) ਪੁਰਸ਼ ਤੁਹਾਡੀ ਸ਼ਰਨ ਵਿਚ ਪੈਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "पुरख जवन पग परे तिहारे ॥",
      "sourceLineId": "140117",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਨ ਕੇ ਤੁਮ ਸੰਕਟ ਸਭ ਟਾਰੇ ॥੩੯੭॥",
      "transliteration": "tin ke tum sa(n)kaT sabh Taare ||397||",
      "translation": "thou didst remove all their troubles.397.",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ ਸਾਰੇ ਸੰਕਟ ਤੁਸੀਂ ਦੂਰ ਕਰ ਦਿੰਦੇ ਹੋ ॥੩੯੭॥",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "तिन के तुम संकट सभ टारे ॥३९७॥",
      "sourceLineId": "140118",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੋ ਕਲਿ ਕੋ ਇਕ ਬਾਰ ਧਿਐ ਹੈ ॥",
      "transliteration": "jo kal ko ik baar dhiaai hai ||",
      "translation": "Those who meditate even on the Supreme Destroyer,",
      "punjabiViakhya": "ਜੋ 'ਕਲਿ' ਨੂੰ ਇਕ ਵਾਰ ਧਿਆਉਾਂਦੇ ਹਨ,",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "जो कलि को इक बार धिऐ है ॥",
      "sourceLineId": "140119",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1387_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਾ ਕੇ ਕਾਲ ਨਿਕਟਿ ਨਹਿ ਐਹੈ ॥",
      "transliteration": "taa ke kaal nikaT neh aaihai ||",
      "translation": "death cannot approach them.",
      "punjabiViakhya": "(ਫਿਰ) ਕਾਲ ਉਨ੍ਰਹਾ ਦੇ ਨੇੜੇ ਨਹੀਂ ਆਉਾਂਦਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1387,
      "hindi": "",
      "hindiTransliteration": "ता के काल निकटि नहि ऐहै ॥",
      "sourceLineId": "140120",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
