{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1388,
  "lineCount": 31,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1388_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਦ੍ਰਿਸਟਿ ਤਨ ਜਾਹਿ ਨਿਹਰਿਹੋ ॥",
      "transliteration": "kirapaa dhirasaT tan jaeh nihariho ||",
      "translation": "Upon whomsoever Thou dost cast Thy favourable glance,",
      "punjabiViakhya": "(ਤੁਸੀਂ) ਜਿਸ ਨੂੰ ਕ੍ਰਿਪਾ ਦ੍ਰਿਸ਼ਟੀ ਨਾਲ ਵੇਖਦੇ ਹੋ,",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "कृपा दृसटि तन जाहि निहरिहो ॥",
      "sourceLineId": "140123",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਾਕੇ ਤਾਪ ਤਨਕ ਮੋ ਹਰਿਹੋ ॥",
      "transliteration": "taake taap tanak mo hariho ||",
      "translation": "they are absolved of sins instantly",
      "punjabiViakhya": "ਉਨ੍ਰਹਾ ਦੇ (ਸਾਰੇ) ਦੁਖ ਛਿਣ ਵਿਚ ਹਰੇ ਜਾਦੇ ਹਨ।",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "ताके ताप तनक मो हरिहो ॥",
      "sourceLineId": "140124",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਿੱਧਿ ਸਿੱਧਿ ਘਰ ਮੋ ਸਭ ਹੋਈ ॥",
      "transliteration": "ri'dh si'dh ghar mo sabh hoiee ||",
      "translation": "They have all the worldly and spiritual pleasures in their homes",
      "punjabiViakhya": "(ਉਨ੍ਰਹਾ ਦੇ) ਘਰ ਵਿਚ ਸਭ ਰਿਧੀਆਂ ਅਤੇ ਸਿਧੀਆਂ ਹੋ ਜਾਦੀਆਂ ਹਨ",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "रिद्धि सिद्धि घर मो सभ होई ॥",
      "sourceLineId": "140125",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦੁਸ਼ਟ ਛਾਹ ਛ੍ਵੈ ਸਕੈ ਨ ਕੋਈ ॥੩੯੯॥",
      "transliteration": "dhushaT chhaeh chhavai sakai na koiee ||399||",
      "translation": "None of their enemies can even touch their shadow.399.",
      "punjabiViakhya": "ਅਤੇ ਕੋਈ ਦੁਸ਼ਟ (ਦੁਸ਼ਮਨ) (ਉਨ੍ਰਹਾ ਦੀ) ਪਰਛਾਈ ਨੂੰ ਵੀ ਛੋਹ ਨਹੀਂ ਸਕਦਾ ॥੩੯੯॥",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "दुशट छाह छ्वै सकै न कोई ॥३९९॥",
      "sourceLineId": "140126",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਏਕ ਬਾਰ ਜਿਨ ਤੁਮੈ ਸੰਭਾਰਾ ॥",
      "transliteration": "ek baar jin tumai sa(n)bhaaraa ||",
      "translation": "He, who remembered Thee even once,",
      "punjabiViakhya": "(ਹੇ ਪਰਮ ਸੱਤਾ!) ਜਿਸ ਨੇ ਇਕ ਵਾਰ ਤੁਹਾਨੂੰ ਯਾਦ ਕਰ ਲਿਆ,",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "एक बार जिन तुमै संभारा ॥",
      "sourceLineId": "140127",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਲ ਫਾਸ ਤੇ ਤਾਹਿ ਉਬਾਰਾ ॥",
      "transliteration": "kaal faas te taeh ubaaraa ||",
      "translation": "thou didst protect him from the noose of death",
      "punjabiViakhya": "ਉਸ ਨੂੰ (ਤੁਸੀਂ) ਕਾਲ ਦੀ ਫਾਹੀ ਤੋਂ ਬਚਾ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "काल फास ते ताहि उबारा ॥",
      "sourceLineId": "140128",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਿਨ ਨਰ ਨਾਮ ਤਿਹਾਰੋ ਕਹਾ ॥",
      "transliteration": "jin nar naam tihaaro kahaa ||",
      "translation": "Those persons, who repeated Thy Name,",
      "punjabiViakhya": "ਜਿਸ ਵਿਅਕਤੀ ਨੇ ਤੁਹਾਡਾ ਨਾਮ ਉਚਾਰ ਦਿੱਤਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "जिन नर नाम तिहारो कहा ॥",
      "sourceLineId": "140129",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦਾਰਿਦ ਦੁਸਟ ਦੋਖ ਤੇ ਰਹਾ ॥੪੦੦॥",
      "transliteration": "dhaaridh dhusaT dhokh te rahaa ||400||",
      "translation": "they were saved from poverty and attacks of enemies.400.",
      "punjabiViakhya": "(ਉਹ) ਦਰਿਦ੍ਰ (ਗ਼ਰੀਬੀ) ਦੁਸ਼ਟ (ਦੁਸ਼ਮਨ) ਅਤੇ ਦੁਖਾ ਤੋਂ ਬਚ ਗਿਆ ॥੪੦੦॥",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "दारिद दुसट दोख ते रहा ॥४००॥",
      "sourceLineId": "140130",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਖੜਗ ਕੇਤ ਮੈ ਸਰਣਿ ਤਿਹਾਰੀ ॥",
      "transliteration": "khaRag ket mai saran tihaaree ||",
      "translation": "O Immortal Being (with the sword on Your banner)! I am under Your protection.",
      "punjabiViakhya": "ਹੇ ਖੜਗਕੇਤੁ! ਮੈਂ ਤੁਹਾਡੀ ਸ਼ਰਨ ਵਿਚ ਹਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "खड़ग केत मै सरणि तिहारी ॥",
      "sourceLineId": "140131",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਪ ਹਾਥ ਦੈ ਲੇਹੁ ਉਬਾਰੀ ॥",
      "transliteration": "aap haath dhai leh ubaaree ||",
      "translation": "Give me Your hand and save me.",
      "punjabiViakhya": "ਆਪਣਾ ਹੱਥ ਦੇ ਕੇ (ਮੈਨੂੰ) ਬਚਾ ਲਵੋ।",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "आप हाथ दै लेहु उबारी ॥",
      "sourceLineId": "140132",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਰਬ ਠੌਰ ਮੋ ਹੋਹੁ ਸਹਾਈ ॥",
      "transliteration": "sarab Thauar mo hoh sahaiee ||",
      "translation": "Stand by me everywhere,",
      "punjabiViakhya": "ਸਭ ਥਾਵਾ ਤੇ ਮੇਰੇ ਸਹਾਇਕ ਹੋ ਜਾਓ।",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "सरब ठौर मो होहु सहाई ॥",
      "sourceLineId": "140133",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੁਸਟ ਦੋਖ ਤੇ ਲੇਹੁ ਬਚਾਈ ॥੪੦੧॥",
      "transliteration": "dhusaT dhokh te leh bachaiee ||401||",
      "translation": "and guard me against enmity and pain. 401.",
      "punjabiViakhya": "ਦੁਸ਼ਟ (ਦੁਸ਼ਮਨ) ਅਤੇ ਦੁਖ ਤੋਂ ਬਚਾ ਲਵੋ ॥੪੦੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "दुसट दोख ते लेहु बचाई ॥४०१॥",
      "sourceLineId": "140134",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਕਰੀ ਹਮ ਪਰ ਜਗਮਾਤਾ ॥",
      "transliteration": "kirapaa karee ham par jagamaataa ||",
      "translation": "The Mother of the world has been kind towards me",
      "punjabiViakhya": "ਮੇਰੇ ਉਤੇ ਜਗਮਾਤਾ ਨੇ ਕ੍ਰਿਪਾ ਕੀਤੀ ਹੈ",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "कृपा करी हम पर जगमाता ॥",
      "sourceLineId": "140135",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗ੍ਰੰਥ ਕਰਾ ਪੂਰਨ ਸੁਭਰਾਤਾ ॥",
      "transliteration": "gra(n)th karaa pooran subharaataa ||",
      "translation": "and I have completed the book this auspicious night",
      "punjabiViakhya": "(ਅਤੇ ਮੈਂ) ਸ਼ੁਭ ਗੁਣਾ ਨਾਲ ਭਰਪੂਰ ('ਸੁਭਰਾਤਾ') ਗ੍ਰੰਥ ਪੂਰਾ ਕੀਤਾ ਹੈ।",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "ग्रंथ करा पूरन सुभराता ॥",
      "sourceLineId": "140136",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿਲਬਿਖ ਸਕਲ ਦੇਹ ਕੋ ਹਰਤਾ ॥",
      "transliteration": "kilabikh sakal dheh ko harataa ||",
      "translation": "The Lord is the destroyer of all the sins of the body",
      "punjabiViakhya": "(ਉਹੀ) ਮੇਰੇ ਸ਼ਰੀਰ ਦੇ ਸਾਰੇ ਪਾਪਾ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "किलबिख सकल देह को हरता ॥",
      "sourceLineId": "140137",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੁਸਟ ਦੋਖਿਯਨ ਕੋ ਛੈ ਕਰਤਾ ॥੪੦੨॥",
      "transliteration": "dhusaT dhokhiyan ko chhai karataa ||402||",
      "translation": "and all the malicious and wicked persons.402.",
      "punjabiViakhya": "ਅਤੇ ਦੁਸ਼ਟਾ (ਵੈਰੀਆਂ) ਅਤੇ ਦੋਖੀਆਂ ਨੂੰ ਨਸ਼ਟ ਕਰਨ ਵਾਲੀ ਹੈ ॥੪੦੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "दुसट दोखियन को छै करता ॥४०२॥",
      "sourceLineId": "140138",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸ੍ਰੀ ਅਸਿਧੁਜ ਜਬ ਭਏ ਦਯਾਲਾ ॥",
      "transliteration": "sree asidhuj jab bhe dhayaalaa ||",
      "translation": "When Mahakal became kind,",
      "punjabiViakhya": "ਜਦ ਸ੍ਰੀ ਅਸਿਧੁਜ (ਮਹਾ ਕਾਲ) ਦਿਆਲ ਹੋਏ,",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "स्री असिधुज जब भए दयाला ॥",
      "sourceLineId": "140139",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪੂਰਨ ਕਰਾ ਗ੍ਰੰਥ ਤਤਕਾਲਾ ॥",
      "transliteration": "pooran karaa gra(n)th tatakaalaa ||",
      "translation": "he immediately caused me to complete this book",
      "punjabiViakhya": "ਤਾ ਉਸੇ ਵੇਲੇ (ਮੈਂ ਇਹ) ਗ੍ਰੰਥ ਮੁਕੰਮਲ ਕਰ ਲਿਆ।",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "पूरन करा ग्रंथ ततकाला ॥",
      "sourceLineId": "140140",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਨ ਬਾਛਤ ਫਲ ਪਾਵੈ ਸੋਈ ॥",
      "transliteration": "man baachhat fal paavai soiee ||",
      "translation": "He will obtain the fruit desired by the mind (who will read or listen to this book)",
      "punjabiViakhya": "(ਜੋ ਇਸ ਦਾ ਪਠਨ ਪਾਠਨ ਕਰੇਗਾ) ਉਹ ਮਨ-ਇੱਛਤ ਫਲ ਪ੍ਰਾਪਤ ਕਰੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "मन बाछत फल पावै सोई ॥",
      "sourceLineId": "140141",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੂਖ ਨ ਤਿਸੈ ਬਿਆਪਤ ਕੋਈ ॥੪੦੩॥",
      "transliteration": "dhookh na tisai biaapat koiee ||403||",
      "translation": "and no suffering will occur to him.403.",
      "punjabiViakhya": "ਉਸ ਨੂੰ ਕੋਈ ਵੀ ਦੁਖ ਵਿਆਪਤ ਨਹੀਂ ਹੋਵੇਗਾ ॥੪੦੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "दूख न तिसै बिआपत कोई ॥४०३॥",
      "sourceLineId": "140142",
      "sourceShabadId": "12794",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅੜਿਲ ॥",
      "transliteration": "aRil ||",
      "translation": "ARRIL",
      "punjabiViakhya": "ਅੜਿਲ:",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "अड़िल ॥",
      "sourceLineId": "140143",
      "sourceShabadId": "12795",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੁਨੈ ਗੁੰਗ ਜੋ ਯਾਹਿ ਸੁ ਰਸਨਾ ਪਾਵਈ ॥",
      "transliteration": "sunai gu(n)g jo yaeh su rasanaa paaviee ||",
      "translation": "The dumb, who will listen to it, will be blessed with the tongue to speak",
      "punjabiViakhya": "ਇਸ ਗ੍ਰੰਥ ਨੂੰ ਜੇ ਗੁੰਗਾ ਸੁਣੇਗਾ, (ਤਾ) ਉਹ ਜੀਭ ਪ੍ਰਾਪਤ ਕਰ ਲਵੇਗਾ।",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "सुनै गुँग जो याहि सु रसना पावई ॥",
      "sourceLineId": "140144",
      "sourceShabadId": "12795",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁਨੈ ਮੂੜ ਚਿਤ ਲਾਇ ਚਤੁਰਤਾ ਆਵਈ ॥",
      "transliteration": "sunai mooR chit lai chaturataa aaviee ||",
      "translation": "The fool, who will listen to it attentively, will get wisdom",
      "punjabiViakhya": "ਜੇ ਮੂਰਖ ਚਿਤ ਲਗਾ ਕੇ ਸੁਣੇਗਾ, (ਤਾ ਉਸ ਦੇ ਅੰਦਰ) ਸਿਆਣਪ ਆ ਜਾਏਗੀ।",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "सुनै मूड़ चित लाइ चतुरता आवई ॥",
      "sourceLineId": "140145",
      "sourceShabadId": "12795",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੂਖ ਦਰਦ ਭੌ ਨਿਕਟ ਨ ਤਿਨ ਨਰ ਕੇ ਰਹੈ ॥",
      "transliteration": "dhookh dharadh bhau nikaT na tin nar ke rahai ||",
      "translation": "That person will be absolved of suffering, pain or fear,",
      "punjabiViakhya": "ਉਸ ਵਿਅਕਤੀ ਦੇ ਨੇੜੇ ਦੁਖ, ਦਰਦ ਅਤੇ ਭੈ ਨਹੀਂ ਰਹੇਗਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "दूख दरद भौ निकट न तिन नर के रहै ॥",
      "sourceLineId": "140146",
      "sourceShabadId": "12795",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹੋ ਜੋ ਯਾ ਕੀ ਏਕ ਬਾਰ ਚੌਪਈ ਕੋ ਕਹੈ ॥੪੦੪॥",
      "transliteration": "ho jo yaa kee ek baar chauapiee ko kahai ||404||",
      "translation": "Who will even once recite this Chaupai-prayer.404.",
      "punjabiViakhya": "ਜੋ ਇਕ ਵਾਰ ਇਸ ਚੌਪਈ ਦਾ ਪਾਠ ਕਰੇਗਾ ॥੪੦੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "हो जो या की एक बार चौपई को कहै ॥४०४॥",
      "sourceLineId": "140147",
      "sourceShabadId": "12795",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚੌਪਈ ॥",
      "transliteration": "chauapiee ||",
      "translation": "CHAUPAI",
      "punjabiViakhya": "ਚੌਪਈ:",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "चौपई ॥",
      "sourceLineId": "140148",
      "sourceShabadId": "12796",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੰਬਤ ਸਤ੍ਰਹ ਸਹਸ ਭਣਿਜੈ ॥",
      "transliteration": "sa(n)bat satreh sahas bhanijai ||",
      "translation": "",
      "punjabiViakhya": "(ਪਹਿਲਾ) ਸਤਾਰਾ ਸੌ ਸੰਮਤ ਕਹੋ",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "संबत सत्रह सहस भणिजै ॥",
      "sourceLineId": "140149",
      "sourceShabadId": "12796",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਰਧ ਸਹਸ ਫੁਨਿ ਤੀਨਿ ਕਹਿਜੈ ॥",
      "transliteration": "aradh sahas fun teen kahijai ||",
      "translation": "",
      "punjabiViakhya": "ਅਤੇ (ਫਿਰ ਉਸ ਨਾਲ) ਅੱਧਾ ਸੌ (੫੦) ਅਤੇ ਤਿੰਨ ਕਹੋ (ਅਰਥਾਤ ੧੭੫੩ ਬਿ.)।",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "अरध सहस फुनि तीनि कहिजै ॥",
      "sourceLineId": "140150",
      "sourceShabadId": "12796",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਾਦ੍ਰਵ ਸੁਦੀ ਅਸਟਮੀ ਰਵਿ ਵਾਰਾ ॥",
      "transliteration": "bhaadhrav sudhee asaTamee rav vaaraa ||",
      "translation": "",
      "punjabiViakhya": "ਭਾਦੋਂ ਮਹੀਨੇ ਦੀ ਸੁਦੀ ਅੱਠਵੀਂ ਐਤਵਾਰ ਨੂੰ",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "भाद्रव सुदी असटमी रवि वारा ॥",
      "sourceLineId": "140151",
      "sourceShabadId": "12796",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੀਰ ਸਤੁਦ੍ਰਵ ਗ੍ਰੰਥ ਸੁਧਾਰਾ ॥੪੦੫॥",
      "transliteration": "teer satudhrav gra(n)th sudhaaraa ||405||",
      "translation": "It was Bikrami Samvat 1753",
      "punjabiViakhya": "ਸਤਲੁਜ ਨਦੀ ਦੇ ਕੰਢੇ (ਬੈਠ ਕੇ ਇਹ) ਗ੍ਰੰਥ ਸੰਪੂਰਨ ਕੀਤਾ ॥੪੦੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "तीर सतुद्रव ग्रंथ सुधारा ॥४०५॥",
      "sourceLineId": "140152",
      "sourceShabadId": "12796",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1388_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਤਿ ਸ੍ਰੀ ਚਰਿਤ੍ਰ ਪਖ੍ਯਾਨੇ ਤ੍ਰਿਯਾ ਚਰਿਤ੍ਰੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਬਾਦੇ ਚਾਰ ਸੌ ਪਾਂਚ ਚਰਿਤ੍ਰ ਸਮਾਪਤਮ ਸਤੁ ਸੁਭਮ ਸਤੁ ॥੪੦੫॥੭੫੫੮॥ ਅਫਜੰੂ ॥",
      "transliteration": "eit sree charitr pakhayaane tirayaa charitre ma(n)tree bhoop sa(n)baadhe chaar sau paa(n)ch charitr samaapatam sat subham sat ||405||7558|| afaja(n)oo ||",
      "translation": "This book was completed on the banks of Sutlej on Sunday, the eighth Sudi of the month of Bhadon.",
      "punjabiViakhya": "ਇਥੇ ਸ੍ਰੀ ਚਰਿਤ੍ਰੋਪਾਖਿਆਨ ਦੇ ਤ੍ਰੀਆ ਚਰਿਤ੍ਰ ਦੇ ਮੰਤ੍ਰੀ ਭੂਪ ਸੰਵਾਦ ਦੇ ੪੦੫ ਚਰਿਤ੍ਰ ਦੀ ਸਮਾਪਤੀ, ਸਭ ਸ਼ੁਭ ਹੈ ॥੪੦੫॥੭੫੫੮॥ ਅਫਜੰੂ ॥",
      "source": "DASAM_GRANTH",
      "ang": 1388,
      "hindi": "",
      "hindiTransliteration": "इति स्री चरित्र पख्याने तृया चरित्रे मंत्री भूप संबादे चार सौ पाँच चरित्र समापतम सतु सुभम सतु ॥४०५॥७५५८॥ अफजंू ॥",
      "sourceLineId": "140153",
      "sourceShabadId": "12796",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
