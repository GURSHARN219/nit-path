{
  "schemaVersion": 1,
  "granthId": "dasam",
  "ang": 1389,
  "lineCount": 17,
  "source": "BaniDB",
  "lines": [
    {
      "id": "dasam_ang_1389_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ੴ ਹੁਕਮ ਸਤਿ ॥",
      "transliteration": "ikOankaar hukam sat ||",
      "translation": "The Victory is of the Lord.",
      "punjabiViakhya": "ੴ ਹੁਕਮ ਸਤਿ:",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "ੴ हुकम सति ॥",
      "sourceLineId": "140154",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਵਾਹਿਗੁਰੂ ਜੀ ਕੀ ਫ਼ਤਹ ॥",
      "transliteration": "vaahiguroo jee kee phateh ||",
      "translation": "The Lord is One and His Word is True.",
      "punjabiViakhya": "ਵਾਹਿਗੁਰੂ ਜੀ ਕੀ ਫਤਹਿ:",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "वाहिगुरू जी की फ़तह ॥",
      "sourceLineId": "140155",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜ਼ਫ਼ਰਨਾਮਹ ॥",
      "transliteration": "zapharanaameh ||",
      "translation": "ZAFARNAMAH (The Epistle of Victory)",
      "punjabiViakhya": "ਜ਼ਫ਼ਰਨਾਮਹ",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "ज़फ़रनामह ॥",
      "sourceLineId": "140156",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸ੍ਰੀ ਮੁਖਵਾਕ ਪਾਤਿਸਾਹੀ ੧੦ ॥",
      "transliteration": "sree mukhavaak paatisaahee 10 ||",
      "translation": "The Sacred Utterance of the Tenth Sovereign.",
      "punjabiViakhya": "ਸ੍ਰੀ ਮੁਖਵਾਕ ਪਾਤਿਸਾਹੀ ੧੦",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "स्री मुखवाक पातिसाही १० ॥",
      "sourceLineId": "140157",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਮਾਲੇ ਕਰਾਮਾਤ ਕਾਯਮ ਕਰੀਮ ॥",
      "transliteration": "kamaale karaamaat kaayam kareem ||",
      "translation": "",
      "punjabiViakhya": "(ਉਹ ਪ੍ਰਭੂ) ਕਰਾਮਾਤ ਵਿਚ ਪੂਰਨ, ਅਚਲ, ਕ੍ਰਿਪਾਲੂ,",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "कमाले करामात कायम करीम ॥",
      "sourceLineId": "140158",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਜ਼ਾ ਬਖ਼ਸ਼ੋ ਰਾਜ਼ਿਕ ਰਿਹਾਕੋ ਰਹੀਮ ॥੧॥",
      "transliteration": "razaa bakhhasho raazik rihaako raheem ||1||",
      "translation": "The Lord is perfect in all faculties. He is Immortal and generous. He is the Giver of victuals and Emancipator.1.",
      "punjabiViakhya": "ਖ਼ੁਸ਼ੀਆਂ ਬਖ਼ਸ਼ਣ ਵਾਲਾ, ਰੋਜ਼ੀ ਦੇਣ ਵਾਲਾ, ਮੁਕਤੀਦਾਤਾ ਅਤੇ ਮਿਹਰ ਕਰਨ ਵਾਲਾ ਹੈ ॥੧॥",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "रज़ा बख़शो राज़िक रिहाको रहीम ॥१॥",
      "sourceLineId": "140159",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਮਾ ਬਖ਼ਸ਼ੋ ਬਖ਼ਸ਼ਿੰਦ ਓ ਦਸਤਗੀਰ ॥",
      "transliteration": "amaa bakhhasho bakhhashi(n)dh o dhasatageer ||",
      "translation": "He is the Protector and Helper.",
      "punjabiViakhya": "(ਉਹ) ਈਮਾਨ (ਅਥਵਾ ਸੁਖ) ਦੇਣ ਵਾਲਾ, ਖਿਮਾ ਕਰਨ ਵਾਲਾ, ਹੱਥ (ਭਾਵ-ਬਾਹ) ਪਕੜਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "अमा बख़शो बख़शिंद ओ दसतगीर ॥",
      "sourceLineId": "140160",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਜ਼ਾ ਬਖ਼ਸ਼ ਰੋਜ਼ੀ ਦਿਹੋ ਦਿਲ ਪਜ਼ੀਰ ॥੨॥",
      "transliteration": "razaa bakhhash rozee dhiho dhil pazeer ||2||",
      "translation": "He is Compassionate, the Giver of food, and Enticer.2.",
      "punjabiViakhya": "ਭੁੱਲਾ ਮਾਫ਼ ਕਰਨ ਵਾਲਾ, ਰਿਜ਼ਕ ਦੇਣ ਵਾਲਾ, ਮਨ ਨੂੰ ਪਸੰਦ ਆਣ ਵਾਲਾ ਹੈ ॥੨॥",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "रज़ा बख़श रोज़ी दिहो दिल पज़ीर ॥२॥",
      "sourceLineId": "140161",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸ਼ਹਿਨਸ਼ਾਹਿ ਖ਼ੂਬੀ ਦਿਹੋ ਰਹ ਨਮੂੰ ॥",
      "transliteration": "shahinashaeh khhoobee dhiho reh namoo(n) ||",
      "translation": "He is the Sovereign, treasure-house of qualities and Guide",
      "punjabiViakhya": "(ਉਹ) ਬਾਦਸ਼ਾਹਾ ਦਾ ਬਾਦਸ਼ਾਹ, ਖ਼ੂਬੀਆਂ (ਗੁਣ) ਦੇਣ ਵਾਲਾ, ਪਥ-ਪ੍ਰਦਰਸ਼ਨ ਕਰਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "शहिनशाहि ख़ूबी दिहो रह नमूँ ॥",
      "sourceLineId": "140162",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿ ਬੇਗੂੰਨ ਬੇਚੂੰਨ ਚੂੰ ਬੇਨਮੂੰ ॥੩॥",
      "transliteration": "k begoo(n)n bechoo(n)n choo(n) benamoo(n) ||3||",
      "translation": "He is unparalleled and is without Form and Colour.3.",
      "punjabiViakhya": "ਰੰਗ-ਰਹਿਤ, ਚਿੰਨ੍ਰਹ ਰਹਿਤ ਅਤੇ ਅਦੁੱਤੀ ਹੈ ॥੩॥",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "कि बेगूँन बेचूँन चूँ बेनमूँ ॥३॥",
      "sourceLineId": "140163",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨ ਸਾਜ਼ੋ ਨ ਬਾਜ਼ੋ ਨ ਫ਼ੌਜੋ ਨ ਫ਼ਰਸ਼ ॥",
      "transliteration": "n saazo na baazo na phauajo na pharash ||",
      "translation": "",
      "punjabiViakhya": "(ਉਸ ਪਾਸ) ਨਾ ਸਾਮਾਨ (ਸਾਜ-ਸੱਜਾ) ਹੈ, ਨਾ ਬਾਜ਼ ਹੈ ਅਤੇ ਨਾ ਹੀ ਫ਼ੌਜ ਅਤੇ ਗ਼ਲੀਚੇ।",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "न साज़ो न बाज़ो न फ़ौजो न फ़रश ॥",
      "sourceLineId": "140164",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਖ਼ੁਦਾਵੰਦ ਬਖ਼ਸ਼ਿੰਦਏ ਐਸ਼ੁ ਅਰਸ਼ ॥੪॥",
      "transliteration": "khhudhaava(n)dh bakhhashi(n)dhe aaish arash ||4||",
      "translation": "Through His Generosity, He provides Heavenly Enjoyments to one without any wealth, falcon, army property and authority.4.",
      "punjabiViakhya": "(ਪਰ) ਪਰਮਾਤਮਾ ਸੁਖ-ਸੁਵਿਧਾਵਾ ਅਤੇ ਸਵਰਗ ਪ੍ਰਦਾਨ ਕਰ ਸਕਦਾ ਹੈ ॥੪॥",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "ख़ुदावंद बख़शिंदए ऐशु अरश ॥४॥",
      "sourceLineId": "140165",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਹਾ ਪਾਕ ਜ਼ਬਰਸਤ ਜ਼ਾਹਿਰ ਜ਼ਹੂਰ ॥",
      "transliteration": "jahaa paak zabarasat zaahir zahoor ||",
      "translation": "He is the Transcendent as well as Immanent",
      "punjabiViakhya": "(ਉਹ) ਸੰਸਾਰਿਕ ਪ੍ਰਪੰਚ ਤੋਂ ਪਵਿਤ੍ਰ, ਬਲਸ਼ਾਲੀ, ਸਾਖਿਆਤ (ਹਰ ਥਾ ਉਤੇ ਪ੍ਰਗਟ)",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "जहा पाक ज़बरसत ज़ाहिर ज़हूर ॥",
      "sourceLineId": "140166",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਤਾ ਮੇ ਦਿਹਦ ਹਮ ਚੁ ਹਾਜ਼ਿਰ ਹਜ਼ੂਰ ॥੫॥",
      "transliteration": "ataa me dhihadh ham ch haazir hazoor ||5||",
      "translation": "He is Omnipresent and bestows honours.5.",
      "punjabiViakhya": "ਵਡਿਆਈ ਦੇਣ ਵਾਲਾ ਅਤੇ ਹਰ ਇਕ ਥਾ ਉਤੇ ਮੌਜੂਦ ਹੈ ॥੫॥",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "अता मे दिहद हम चु हाज़िर हज़ूर ॥५॥",
      "sourceLineId": "140167",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਤਾ ਬਖ਼ਸ਼ਓ ਪਾਕ ਪਰਵਰਦਿਗਾਰ ॥",
      "transliteration": "ataa bakhhasho paak paravaradhigaar ||",
      "translation": "He is Holy, Generous and Preserver",
      "punjabiViakhya": "(ਉਹ) ਦਾਤਾ ਦੇਣ ਵਾਲਾ, ਪਵਿਤ੍ਰ, ਪਾਲਨਾ ਕਰਨ ਵਾਲਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "अता बख़शओ पाक परवरदिगार ॥",
      "sourceLineId": "140168",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਹੀਮ ਅਸਤੋ ਰੋਜ਼ੀ ਦਿਹੋ ਹਰ ਦਿਯਾਰ ॥੬॥",
      "transliteration": "raheem asato rozee dhiho har dhiyaar ||6||",
      "translation": "He is Merciful and Provider of victuals.6.",
      "punjabiViakhya": "ਰਹਿਮ ਕਰਨ ਵਾਲਾ ਅਤੇ ਹਰ ਇਕ ਦੇਸ਼ ਨੂੰ ਰੋਜ਼ੀ ਦੇਣ ਵਾਲਾ ਹੈ ॥੬॥",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "रहीम असतो रोज़ी दिहो हर दियार ॥६॥",
      "sourceLineId": "140169",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    },
    {
      "id": "dasam_ang_1389_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿ ਸਾਹਿਬ ਦਿਆਰ ਅਸਤੁ ਆਜ਼ਮ ਅਜ਼ੀਮ ॥",
      "transliteration": "k saahib dhiaar asat aazam azeem ||",
      "translation": "The Lord is Generous, the Highest of the High",
      "punjabiViakhya": "(ਉਹ) ਸਭ ਦੇਸ਼ਾ ਦਾ ਸੁਆਮੀ, ਵੱਡਿਆਂ ਤੋਂ ਵੀ ਵੱਡਾ,",
      "source": "DASAM_GRANTH",
      "ang": 1389,
      "hindi": "",
      "hindiTransliteration": "कि साहिब दिआर असतु आज़म अज़ीम ॥",
      "sourceLineId": "140170",
      "sourceShabadId": "12797",
      "sourceUpdated": "2022-12-24 02:22:37",
      "raag": ""
    }
  ]
}
