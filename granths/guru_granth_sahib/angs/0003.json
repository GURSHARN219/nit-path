{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 3,
  "lineCount": 65,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0003_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁਣਿਐ ਦੂਖ ਪਾਪ ਕਾ ਨਾਸੁ ॥੯॥",
      "transliteration": "suniai dookh paap kaa naas ||9||",
      "translation": "Listening-pain and sin are erased. ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁਣਿਐ ਸਤੁ ਸੰਤੋਖੁ ਗਿਆਨੁ ॥",
      "transliteration": "suniai sat sa(n)tokh giaan ||",
      "translation": "Listening-truth, contentment and spiritual wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੁਣਿਐ ਅਠਸਠਿ ਕਾ ਇਸਨਾਨੁ ॥",
      "transliteration": "suniai athasath kaa isanaan ||",
      "translation": "Listening-take your cleansing bath at the sixty-eight places of pilgrimage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੁਣਿਐ ਪੜਿ ਪੜਿ ਪਾਵਹਿ ਮਾਨੁ ॥",
      "transliteration": "suniai paR paR paavahi maan ||",
      "translation": "Listening-reading and reciting, honor is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੁਣਿਐ ਲਾਗੈ ਸਹਜਿ ਧਿਆਨੁ ॥",
      "transliteration": "suniai laagai sahaj dhiaan ||",
      "translation": "Listening-intuitively grasp the essence of meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਨਕ ਭਗਤਾ ਸਦਾ ਵਿਗਾਸੁ ॥",
      "transliteration": "naanak bhagataa sadaa vigaas ||",
      "translation": "O Nanak, the devotees are forever in bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਣਿਐ ਦੂਖ ਪਾਪ ਕਾ ਨਾਸੁ ॥੧੦॥",
      "transliteration": "suniai dookh paap kaa naas ||10||",
      "translation": "Listening-pain and sin are erased. ||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁਣਿਐ ਸਰਾ ਗੁਣਾ ਕੇ ਗਾਹ ॥",
      "transliteration": "suniai saraa gunaa ke gaah ||",
      "translation": "Listening-dive deep into the ocean of virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੁਣਿਐ ਸੇਖ ਪੀਰ ਪਾਤਿਸਾਹ ॥",
      "transliteration": "suniai sekh peer paatisaah ||",
      "translation": "Listening-the Shaykhs, religious scholars, spiritual teachers and emperors.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁਣਿਐ ਅੰਧੇ ਪਾਵਹਿ ਰਾਹੁ ॥",
      "transliteration": "suniai a(n)dhe paavahi raahu ||",
      "translation": "Listening-even the blind find the Path.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੁਣਿਐ ਹਾਥ ਹੋਵੈ ਅਸਗਾਹੁ ॥",
      "transliteration": "suniai haath hovai asagaahu ||",
      "translation": "Listening-the Unreachable comes within your grasp.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਨਕ ਭਗਤਾ ਸਦਾ ਵਿਗਾਸੁ ॥",
      "transliteration": "naanak bhagataa sadaa vigaas ||",
      "translation": "O Nanak, the devotees are forever in bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁਣਿਐ ਦੂਖ ਪਾਪ ਕਾ ਨਾਸੁ ॥੧੧॥",
      "transliteration": "suniai dookh paap kaa naas ||11||",
      "translation": "Listening-pain and sin are erased. ||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੰਨੇ ਕੀ ਗਤਿ ਕਹੀ ਨ ਜਾਇ ॥",
      "transliteration": "ma(n)ne kee gat kahee na jaai ||",
      "translation": "The state of the faithful cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੇ ਕੋ ਕਹੈ ਪਿਛੈ ਪਛੁਤਾਇ ॥",
      "transliteration": "je ko kahai pichhai pachhutaai ||",
      "translation": "One who tries to describe this shall regret the attempt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਾਗਦਿ ਕਲਮ ਨ ਲਿਖਣਹਾਰੁ ॥",
      "transliteration": "kaagad kalam na likhanahaar ||",
      "translation": "No paper, no pen, no scribe",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੰਨੇ ਕਾ ਬਹਿ ਕਰਨਿ ਵੀਚਾਰੁ ॥",
      "transliteration": "ma(n)ne kaa bahi karan veechaar ||",
      "translation": "can record the state of the faithful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਐਸਾ ਨਾਮੁ ਨਿਰੰਜਨੁ ਹੋਇ ॥",
      "transliteration": "aisaa naam nira(n)jan hoi ||",
      "translation": "Such is the Name of the Immaculate Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੇ ਕੋ ਮੰਨਿ ਜਾਣੈ ਮਨਿ ਕੋਇ ॥੧੨॥",
      "transliteration": "je ko ma(n)n jaanai man koi ||12||",
      "translation": "Only one who has faith comes to know such a state of mind. ||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮੰਨੈ ਸੁਰਤਿ ਹੋਵੈ ਮਨਿ ਬੁਧਿ ॥",
      "transliteration": "ma(n)nai surat hovai man budh ||",
      "translation": "The faithful have intuitive awareness and intelligence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮੰਨੈ ਸਗਲ ਭਵਣ ਕੀ ਸੁਧਿ ॥",
      "transliteration": "ma(n)nai sagal bhavan kee sudh ||",
      "translation": "The faithful know about all worlds and realms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੰਨੈ ਮੁਹਿ ਚੋਟਾ ਨਾ ਖਾਇ ॥",
      "transliteration": "ma(n)nai muhi chotaa naa khaai ||",
      "translation": "The faithful shall never be struck across the face.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੰਨੈ ਜਮ ਕੈ ਸਾਥਿ ਨ ਜਾਇ ॥",
      "transliteration": "ma(n)nai jam kai saath na jaai ||",
      "translation": "The faithful do not have to go with the Messenger of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਐਸਾ ਨਾਮੁ ਨਿਰੰਜਨੁ ਹੋਇ ॥",
      "transliteration": "aisaa naam nira(n)jan hoi ||",
      "translation": "Such is the Name of the Immaculate Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੇ ਕੋ ਮੰਨਿ ਜਾਣੈ ਮਨਿ ਕੋਇ ॥੧੩॥",
      "transliteration": "je ko ma(n)n jaanai man koi ||13||",
      "translation": "Only one who has faith comes to know such a state of mind. ||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੰਨੈ ਮਾਰਗਿ ਠਾਕ ਨ ਪਾਇ ॥",
      "transliteration": "ma(n)nai maarag thaak na paai ||",
      "translation": "The path of the faithful shall never be blocked.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮੰਨੈ ਪਤਿ ਸਿਉ ਪਰਗਟੁ ਜਾਇ ॥",
      "transliteration": "ma(n)nai pat siu paragat jaai ||",
      "translation": "The faithful shall depart with honor and fame.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੰਨੈ ਮਗੁ ਨ ਚਲੈ ਪੰਥੁ ॥",
      "transliteration": "ma(n)nai mag na chalai pa(n)th ||",
      "translation": "The faithful do not follow empty religious rituals.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੰਨੈ ਧਰਮ ਸੇਤੀ ਸਨਬੰਧੁ ॥",
      "transliteration": "ma(n)nai dharam setee sanaba(n)dh ||",
      "translation": "The faithful are firmly bound to the Dharma.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਐਸਾ ਨਾਮੁ ਨਿਰੰਜਨੁ ਹੋਇ ॥",
      "transliteration": "aisaa naam nira(n)jan hoi ||",
      "translation": "Such is the Name of the Immaculate Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੇ ਕੋ ਮੰਨਿ ਜਾਣੈ ਮਨਿ ਕੋਇ ॥੧੪॥",
      "transliteration": "je ko ma(n)n jaanai man koi ||14||",
      "translation": "Only one who has faith comes to know such a state of mind. ||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੰਨੈ ਪਾਵਹਿ ਮੋਖੁ ਦੁਆਰੁ ॥",
      "transliteration": "ma(n)nai paavahi mokh duaar ||",
      "translation": "The faithful find the Door of Liberation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੰਨੈ ਪਰਵਾਰੈ ਸਾਧਾਰੁ ॥",
      "transliteration": "ma(n)nai paravaarai saadhaar ||",
      "translation": "The faithful uplift and redeem their family and relations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮੰਨੈ ਤਰੈ ਤਾਰੇ ਗੁਰੁ ਸਿਖ ॥",
      "transliteration": "ma(n)nai tarai taare gur sikh ||",
      "translation": "The faithful are saved, and carried across with the Sikhs of the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮੰਨੈ ਨਾਨਕ ਭਵਹਿ ਨ ਭਿਖ ॥",
      "transliteration": "ma(n)nai naanak bhavahi na bhikh ||",
      "translation": "The faithful, O Nanak, do not wander around begging.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਐਸਾ ਨਾਮੁ ਨਿਰੰਜਨੁ ਹੋਇ ॥",
      "transliteration": "aisaa naam nira(n)jan hoi ||",
      "translation": "Such is the Name of the Immaculate Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੇ ਕੋ ਮੰਨਿ ਜਾਣੈ ਮਨਿ ਕੋਇ ॥੧੫॥",
      "transliteration": "je ko ma(n)n jaanai man koi ||15||",
      "translation": "Only one who has faith comes to know such a state of mind. ||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪੰਚ ਪਰਵਾਣ ਪੰਚ ਪਰਧਾਨੁ ॥",
      "transliteration": "pa(n)ch paravaan pa(n)ch paradhaan ||",
      "translation": "The chosen ones, the self-elect, are accepted and approved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪੰਚੇ ਪਾਵਹਿ ਦਰਗਹਿ ਮਾਨੁ ॥",
      "transliteration": "pa(n)che paavahi daragahi maan ||",
      "translation": "The chosen ones are honored in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪੰਚੇ ਸੋਹਹਿ ਦਰਿ ਰਾਜਾਨੁ ॥",
      "transliteration": "pa(n)che sohahi dar raajaan ||",
      "translation": "The chosen ones look beautiful in the courts of kings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪੰਚਾ ਕਾ ਗੁਰੁ ਏਕੁ ਧਿਆਨੁ ॥",
      "transliteration": "pa(n)chaa kaa gur ek dhiaan ||",
      "translation": "The chosen ones meditate single-mindedly on the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੇ ਕੋ ਕਹੈ ਕਰੈ ਵੀਚਾਰੁ ॥",
      "transliteration": "je ko kahai karai veechaar ||",
      "translation": "No matter how much anyone tries to explain and describe them,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਰਤੇ ਕੈ ਕਰਣੈ ਨਾਹੀ ਸੁਮਾਰੁ ॥",
      "transliteration": "karate kai karanai naahee sumaar ||",
      "translation": "the actions of the Creator cannot be counted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਧੌਲੁ ਧਰਮੁ ਦਇਆ ਕਾ ਪੂਤੁ ॥",
      "transliteration": "dhaul dharam daiaa kaa poot ||",
      "translation": "The mythical bull is Dharma, the son of compassion;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੰਤੋਖੁ ਥਾਪਿ ਰਖਿਆ ਜਿਨਿ ਸੂਤਿ ॥",
      "transliteration": "sa(n)tokh thaap rakhiaa jin soot ||",
      "translation": "this is what patiently holds the earth in its place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੇ ਕੋ ਬੁਝੈ ਹੋਵੈ ਸਚਿਆਰੁ ॥",
      "transliteration": "je ko bujhai hovai sachiaar ||",
      "translation": "One who understands this becomes truthful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਧਵਲੈ ਉਪਰਿ ਕੇਤਾ ਭਾਰੁ ॥",
      "transliteration": "dhavalai upar ketaa bhaar ||",
      "translation": "What a great load there is on the bull!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਧਰਤੀ ਹੋਰੁ ਪਰੈ ਹੋਰੁ ਹੋਰੁ ॥",
      "transliteration": "dharatee hor parai hor hor ||",
      "translation": "So many worlds beyond this world-so very many!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤਿਸ ਤੇ ਭਾਰੁ ਤਲੈ ਕਵਣੁ ਜੋਰੁ ॥",
      "transliteration": "tis te bhaar talai kavan jor ||",
      "translation": "What power holds them, and supports their weight?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜੀਅ ਜਾਤਿ ਰੰਗਾ ਕੇ ਨਾਵ ॥",
      "transliteration": "jee jaat ra(n)gaa ke naav ||",
      "translation": "The names and the colors of the assorted species of beings",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਭਨਾ ਲਿਖਿਆ ਵੁੜੀ ਕਲਾਮ ॥",
      "transliteration": "sabhanaa likhiaa vuRee kalaam ||",
      "translation": "were all inscribed by the Ever-flowing Pen of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਏਹੁ ਲੇਖਾ ਲਿਖਿ ਜਾਣੈ ਕੋਇ ॥",
      "transliteration": "ehu lekhaa likh jaanai koi ||",
      "translation": "Who knows how to write this account?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਲੇਖਾ ਲਿਖਿਆ ਕੇਤਾ ਹੋਇ ॥",
      "transliteration": "lekhaa likhiaa ketaa hoi ||",
      "translation": "Just imagine what a huge scroll it would take!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕੇਤਾ ਤਾਣੁ ਸੁਆਲਿਹੁ ਰੂਪੁ ॥",
      "transliteration": "ketaa taan suaalihu roop ||",
      "translation": "What power! What fascinating beauty!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕੇਤੀ ਦਾਤਿ ਜਾਣੈ ਕੌਣੁ ਕੂਤੁ ॥",
      "transliteration": "ketee daat jaanai kaun koot ||",
      "translation": "And what gifts! Who can know their extent?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕੀਤਾ ਪਸਾਉ ਏਕੋ ਕਵਾਉ ॥",
      "transliteration": "keetaa pasaau eko kavaau ||",
      "translation": "You created the vast expanse of the Universe with One Word!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਿਸ ਤੇ ਹੋਏ ਲਖ ਦਰੀਆਉ ॥",
      "transliteration": "tis te hoe lakh dareeaau ||",
      "translation": "Hundreds of thousands of rivers began to flow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕੁਦਰਤਿ ਕਵਣ ਕਹਾ ਵੀਚਾਰੁ ॥",
      "transliteration": "kudarat kavan kahaa veechaar ||",
      "translation": "How can Your Creative Potency be described?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਵਾਰਿਆ ਨ ਜਾਵਾ ਏਕ ਵਾਰ ॥",
      "transliteration": "vaariaa na jaavaa ek vaar ||",
      "translation": "I cannot even once be a sacrifice to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜੋ ਤੁਧੁ ਭਾਵੈ ਸਾਈ ਭਲੀ ਕਾਰ ॥",
      "transliteration": "jo tudh bhaavai saaee bhalee kaar ||",
      "translation": "Whatever pleases You is the only good done,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਤੂ ਸਦਾ ਸਲਾਮਤਿ ਨਿਰੰਕਾਰ ॥੧੬॥",
      "transliteration": "too sadaa salaamat nira(n)kaar ||16||",
      "translation": "You, Eternal and Formless One! ||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਅਸੰਖ ਜਪ ਅਸੰਖ ਭਾਉ ॥",
      "transliteration": "asa(n)kh jap asa(n)kh bhaau ||",
      "translation": "Countless meditations, countless loves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਅਸੰਖ ਪੂਜਾ ਅਸੰਖ ਤਪ ਤਾਉ ॥",
      "transliteration": "asa(n)kh poojaa asa(n)kh tap taau ||",
      "translation": "Countless worship services, countless austere disciplines.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਅਸੰਖ ਗਰੰਥ ਮੁਖਿ ਵੇਦ ਪਾਠ ॥",
      "transliteration": "asa(n)kh gara(n)th mukh ved paath ||",
      "translation": "Countless scriptures, and ritual recitations of the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0003_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਅਸੰਖ ਜੋਗ ਮਨਿ ਰਹਹਿ ਉਦਾਸ ॥",
      "transliteration": "asa(n)kh jog man rahahi udaas ||",
      "translation": "Countless Yogis, whose minds remain detached from the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 3,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
