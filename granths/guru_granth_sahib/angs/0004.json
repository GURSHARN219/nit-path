{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 4,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0004_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਸੰਖ ਭਗਤ ਗੁਣ ਗਿਆਨ ਵੀਚਾਰ ॥",
      "transliteration": "asa(n)kh bhagat gun giaan veechaar ||",
      "translation": "Countless devotees contemplate the Wisdom and Virtues of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਸੰਖ ਸਤੀ ਅਸੰਖ ਦਾਤਾਰ ॥",
      "transliteration": "asa(n)kh satee asa(n)kh daataar ||",
      "translation": "Countless the holy, countless the givers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਸੰਖ ਸੂਰ ਮੁਹ ਭਖ ਸਾਰ ॥",
      "transliteration": "asa(n)kh soor muh bhakh saar ||",
      "translation": "Countless heroic spiritual warriors, who bear the brunt of the attack in battle (who with their mouths eat steel).",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਸੰਖ ਮੋਨਿ ਲਿਵ ਲਾਇ ਤਾਰ ॥",
      "transliteration": "asa(n)kh mon liv laai taar ||",
      "translation": "Countless silent sages, vibrating the String of His Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕੁਦਰਤਿ ਕਵਣ ਕਹਾ ਵੀਚਾਰੁ ॥",
      "transliteration": "kudarat kavan kahaa veechaar ||",
      "translation": "How can Your Creative Potency be described?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਵਾਰਿਆ ਨ ਜਾਵਾ ਏਕ ਵਾਰ ॥",
      "transliteration": "vaariaa na jaavaa ek vaar ||",
      "translation": "I cannot even once be a sacrifice to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੋ ਤੁਧੁ ਭਾਵੈ ਸਾਈ ਭਲੀ ਕਾਰ ॥",
      "transliteration": "jo tudh bhaavai saaee bhalee kaar ||",
      "translation": "Whatever pleases You is the only good done,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੂ ਸਦਾ ਸਲਾਮਤਿ ਨਿਰੰਕਾਰ ॥੧੭॥",
      "transliteration": "too sadaa salaamat nira(n)kaar ||17||",
      "translation": "You, Eternal and Formless One. ||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਸੰਖ ਮੂਰਖ ਅੰਧ ਘੋਰ ॥",
      "transliteration": "asa(n)kh moorakh a(n)dh ghor ||",
      "translation": "Countless fools, blinded by ignorance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਸੰਖ ਚੋਰ ਹਰਾਮਖੋਰ ॥",
      "transliteration": "asa(n)kh chor haraamakhor ||",
      "translation": "Countless thieves and embezzlers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਸੰਖ ਅਮਰ ਕਰਿ ਜਾਹਿ ਜੋਰ ॥",
      "transliteration": "asa(n)kh amar kar jaahi jor ||",
      "translation": "Countless impose their will by force.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਸੰਖ ਗਲਵਢ ਹਤਿਆ ਕਮਾਹਿ ॥",
      "transliteration": "asa(n)kh galavadh hatiaa kamaahi ||",
      "translation": "Countless cut-throats and ruthless killers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਸੰਖ ਪਾਪੀ ਪਾਪੁ ਕਰਿ ਜਾਹਿ ॥",
      "transliteration": "asa(n)kh paapee paap kar jaahi ||",
      "translation": "Countless sinners who keep on sinning.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਸੰਖ ਕੂੜਿਆਰ ਕੂੜੇ ਫਿਰਾਹਿ ॥",
      "transliteration": "asa(n)kh kooRiaar kooRe phiraahi ||",
      "translation": "Countless liars, wandering lost in their lies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਸੰਖ ਮਲੇਛ ਮਲੁ ਭਖਿ ਖਾਹਿ ॥",
      "transliteration": "asa(n)kh malechh mal bhakh khaahi ||",
      "translation": "Countless wretches, eating filth as their ration.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਸੰਖ ਨਿੰਦਕ ਸਿਰਿ ਕਰਹਿ ਭਾਰੁ ॥",
      "transliteration": "asa(n)kh ni(n)dak sir karahi bhaar ||",
      "translation": "Countless slanderers, carrying the weight of their stupid mistakes on their heads.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਨਕੁ ਨੀਚੁ ਕਹੈ ਵੀਚਾਰੁ ॥",
      "transliteration": "naanak neech kahai veechaar ||",
      "translation": "Nanak describes the state of the lowly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਵਾਰਿਆ ਨ ਜਾਵਾ ਏਕ ਵਾਰ ॥",
      "transliteration": "vaariaa na jaavaa ek vaar ||",
      "translation": "I cannot even once be a sacrifice to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੋ ਤੁਧੁ ਭਾਵੈ ਸਾਈ ਭਲੀ ਕਾਰ ॥",
      "transliteration": "jo tudh bhaavai saaee bhalee kaar ||",
      "translation": "Whatever pleases You is the only good done,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤੂ ਸਦਾ ਸਲਾਮਤਿ ਨਿਰੰਕਾਰ ॥੧੮॥",
      "transliteration": "too sadaa salaamat nira(n)kaar ||18||",
      "translation": "You, Eternal and Formless One. ||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਸੰਖ ਨਾਵ ਅਸੰਖ ਥਾਵ ॥",
      "transliteration": "asa(n)kh naav asa(n)kh thaav ||",
      "translation": "Countless names, countless places.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਗੰਮ ਅਗੰਮ ਅਸੰਖ ਲੋਅ ॥",
      "transliteration": "aga(n)m aga(n)m asa(n)kh lo ||",
      "translation": "Inaccessible, unapproachable, countless celestial realms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਸੰਖ ਕਹਹਿ ਸਿਰਿ ਭਾਰੁ ਹੋਇ ॥",
      "transliteration": "asa(n)kh kahahi sir bhaar hoi ||",
      "translation": "Even to call them countless is to carry the weight on your head.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਖਰੀ ਨਾਮੁ ਅਖਰੀ ਸਾਲਾਹ ॥",
      "transliteration": "akharee naam akharee saalaah ||",
      "translation": "From the Word, comes the Naam; from the Word, comes Your Praise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਖਰੀ ਗਿਆਨੁ ਗੀਤ ਗੁਣ ਗਾਹ ॥",
      "transliteration": "akharee giaan geet gun gaah ||",
      "translation": "From the Word, comes spiritual wisdom, singing the Songs of Your Glory.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਖਰੀ ਲਿਖਣੁ ਬੋਲਣੁ ਬਾਣਿ ॥",
      "transliteration": "akharee likhan bolan baan ||",
      "translation": "From the Word, come the written and spoken words and hymns.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਖਰਾ ਸਿਰਿ ਸੰਜੋਗੁ ਵਖਾਣਿ ॥",
      "transliteration": "akharaa sir sa(n)jog vakhaan ||",
      "translation": "From the Word, comes destiny, written on one's forehead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਿਨਿ ਏਹਿ ਲਿਖੇ ਤਿਸੁ ਸਿਰਿ ਨਾਹਿ ॥",
      "transliteration": "jin ehi likhe tis sir naahi ||",
      "translation": "But the One who wrote these Words of Destiny-no words are written on His Forehead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਵ ਫੁਰਮਾਏ ਤਿਵ ਤਿਵ ਪਾਹਿ ॥",
      "transliteration": "jiv phuramaae tiv tiv paahi ||",
      "translation": "As He ordains, so do we receive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੇਤਾ ਕੀਤਾ ਤੇਤਾ ਨਾਉ ॥",
      "transliteration": "jetaa keetaa tetaa naau ||",
      "translation": "The created universe is the manifestation of Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਵਿਣੁ ਨਾਵੈ ਨਾਹੀ ਕੋ ਥਾਉ ॥",
      "transliteration": "vin naavai naahee ko thaau ||",
      "translation": "Without Your Name, there is no place at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕੁਦਰਤਿ ਕਵਣ ਕਹਾ ਵੀਚਾਰੁ ॥",
      "transliteration": "kudarat kavan kahaa veechaar ||",
      "translation": "How can I describe Your Creative Power?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਵਾਰਿਆ ਨ ਜਾਵਾ ਏਕ ਵਾਰ ॥",
      "transliteration": "vaariaa na jaavaa ek vaar ||",
      "translation": "I cannot even once be a sacrifice to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੋ ਤੁਧੁ ਭਾਵੈ ਸਾਈ ਭਲੀ ਕਾਰ ॥",
      "transliteration": "jo tudh bhaavai saaee bhalee kaar ||",
      "translation": "Whatever pleases You is the only good done,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੂ ਸਦਾ ਸਲਾਮਤਿ ਨਿਰੰਕਾਰ ॥੧੯॥",
      "transliteration": "too sadaa salaamat nira(n)kaar ||19||",
      "translation": "You, Eternal and Formless One. ||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਰੀਐ ਹਥੁ ਪੈਰੁ ਤਨੁ ਦੇਹ ॥",
      "transliteration": "bhareeai hath pair tan deh ||",
      "translation": "When the hands and the feet and the body are dirty,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਾਣੀ ਧੋਤੈ ਉਤਰਸੁ ਖੇਹ ॥",
      "transliteration": "paanee dhotai utaras kheh ||",
      "translation": "water can wash away the dirt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੂਤ ਪਲੀਤੀ ਕਪੜੁ ਹੋਇ ॥",
      "transliteration": "moot paleetee kapaR hoi ||",
      "translation": "When the clothes are soiled and stained by urine,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੇ ਸਾਬੂਣੁ ਲਈਐ ਓਹੁ ਧੋਇ ॥",
      "transliteration": "de saaboon laeeai ohu dhoi ||",
      "translation": "soap can wash them clean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਰੀਐ ਮਤਿ ਪਾਪਾ ਕੈ ਸੰਗਿ ॥",
      "transliteration": "bhareeai mat paapaa kai sa(n)g ||",
      "translation": "But when the intellect is stained and polluted by sin,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਓਹੁ ਧੋਪੈ ਨਾਵੈ ਕੈ ਰੰਗਿ ॥",
      "transliteration": "ohu dhopai naavai kai ra(n)g ||",
      "translation": "it can only be cleansed by the Love of the Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪੁੰਨੀ ਪਾਪੀ ਆਖਣੁ ਨਾਹਿ ॥",
      "transliteration": "pu(n)nee paapee aakhan naahi ||",
      "translation": "Virtue and vice do not come by mere words;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਰਿ ਕਰਿ ਕਰਣਾ ਲਿਖਿ ਲੈ ਜਾਹੁ ॥",
      "transliteration": "kar kar karanaa likh lai jaahu ||",
      "translation": "actions repeated, over and over again, are engraved on the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਆਪੇ ਬੀਜਿ ਆਪੇ ਹੀ ਖਾਹੁ ॥",
      "transliteration": "aape beej aape hee khaahu ||",
      "translation": "You shall harvest what you plant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਹੁਕਮੀ ਆਵਹੁ ਜਾਹੁ ॥੨੦॥",
      "transliteration": "naanak hukamee aavahu jaahu ||20||",
      "translation": "O Nanak, by the Hukam of God's Command, we come and go in reincarnation. ||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤੀਰਥੁ ਤਪੁ ਦਇਆ ਦਤੁ ਦਾਨੁ ॥",
      "transliteration": "teerath tap daiaa dat daan ||",
      "translation": "Pilgrimages, austere discipline, compassion and charity",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੇ ਕੋ ਪਾਵੈ ਤਿਲ ਕਾ ਮਾਨੁ ॥",
      "transliteration": "je ko paavai til kaa maan ||",
      "translation": "these, by themselves, bring only an iota of merit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੁਣਿਆ ਮੰਨਿਆ ਮਨਿ ਕੀਤਾ ਭਾਉ ॥",
      "transliteration": "suniaa ma(n)niaa man keetaa bhaau ||",
      "translation": "Listening and believing with love and humility in your mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅੰਤਰਗਤਿ ਤੀਰਥਿ ਮਲਿ ਨਾਉ ॥",
      "transliteration": "a(n)taragat teerath mal naau ||",
      "translation": "cleanse yourself with the Name, at the sacred shrine deep within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਭਿ ਗੁਣ ਤੇਰੇ ਮੈ ਨਾਹੀ ਕੋਇ ॥",
      "transliteration": "sabh gun tere mai naahee koi ||",
      "translation": "All virtues are Yours, Lord, I have none at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਵਿਣੁ ਗੁਣ ਕੀਤੇ ਭਗਤਿ ਨ ਹੋਇ ॥",
      "transliteration": "vin gun keete bhagat na hoi ||",
      "translation": "Without virtue, there is no devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੁਅਸਤਿ ਆਥਿ ਬਾਣੀ ਬਰਮਾਉ ॥",
      "transliteration": "suasat aath baanee baramaau ||",
      "translation": "I bow to the Lord of the World, to His Word, to Brahma the Creator.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਤਿ ਸੁਹਾਣੁ ਸਦਾ ਮਨਿ ਚਾਉ ॥",
      "transliteration": "sat suhaan sadaa man chaau ||",
      "translation": "He is Beautiful, True and Eternally Joyful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਵਣੁ ਸੁ ਵੇਲਾ ਵਖਤੁ ਕਵਣੁ ਕਵਣ ਥਿਤਿ ਕਵਣੁ ਵਾਰੁ ॥",
      "transliteration": "kavan s velaa vakhat kavan kavan thit kavan vaar ||",
      "translation": "What was that time, and what was that moment? What was that day, and what was that date?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਵਣਿ ਸਿ ਰੁਤੀ ਮਾਹੁ ਕਵਣੁ ਜਿਤੁ ਹੋਆ ਆਕਾਰੁ ॥",
      "transliteration": "kavan s rutee maahu kavan jit hoaa aakaar ||",
      "translation": "What was that season, and what was that month, when the Universe was created?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਵੇਲ ਨ ਪਾਈਆ ਪੰਡਤੀ ਜਿ ਹੋਵੈ ਲੇਖੁ ਪੁਰਾਣੁ ॥",
      "transliteration": "vel na paaeeaa pa(n)datee j hovai lekh puraan ||",
      "translation": "The Pandits, the religious scholars, cannot find that time, even if it is written in the Puraanas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਵਖਤੁ ਨ ਪਾਇਓ ਕਾਦੀਆ ਜਿ ਲਿਖਨਿ ਲੇਖੁ ਕੁਰਾਣੁ ॥",
      "transliteration": "vakhat na paaio kaadeeaa j likhan lekh kuraan ||",
      "translation": "That time is not known to the Qazis, who study the Koran.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਥਿਤਿ ਵਾਰੁ ਨਾ ਜੋਗੀ ਜਾਣੈ ਰੁਤਿ ਮਾਹੁ ਨਾ ਕੋਈ ॥",
      "transliteration": "thit vaar naa jogee jaanai rut maahu naa koee ||",
      "translation": "The day and the date are not known to the Yogis, nor is the month or the season.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜਾ ਕਰਤਾ ਸਿਰਠੀ ਕਉ ਸਾਜੇ ਆਪੇ ਜਾਣੈ ਸੋਈ ॥",
      "transliteration": "jaa karataa sirathee kau saaje aape jaanai soee ||",
      "translation": "The Creator who created this creation-only He Himself knows.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0004_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕਿਵ ਕਰਿ ਆਖਾ ਕਿਵ ਸਾਲਾਹੀ ਕਿਉ ਵਰਨੀ ਕਿਵ ਜਾਣਾ ॥",
      "transliteration": "kiv kar aakhaa kiv saalaahee kiu varanee kiv jaanaa ||",
      "translation": "How can we speak of Him? How can we praise Him? How can we describe Him? How can we know Him?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 4,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
