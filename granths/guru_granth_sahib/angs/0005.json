{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 5,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0005_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਨਕ ਆਖਣਿ ਸਭੁ ਕੋ ਆਖੈ ਇਕ ਦੂ ਇਕੁ ਸਿਆਣਾ ॥",
      "transliteration": "naanak aakhan sabh ko aakhai ik doo ik siaanaa ||",
      "translation": "O Nanak, everyone speaks of Him, each one wiser than the rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਵਡਾ ਸਾਹਿਬੁ ਵਡੀ ਨਾਈ ਕੀਤਾ ਜਾ ਕਾ ਹੋਵੈ ॥",
      "transliteration": "vadaa saahib vadee naaee keetaa jaa kaa hovai ||",
      "translation": "Great is the Master, Great is His Name. Whatever happens is according to His Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਨਕ ਜੇ ਕੋ ਆਪੌ ਜਾਣੈ ਅਗੈ ਗਇਆ ਨ ਸੋਹੈ ॥੨੧॥",
      "transliteration": "naanak je ko aapau jaanai agai gaiaa na sohai ||21||",
      "translation": "O Nanak, one who claims to know everything shall not be decorated in the world hereafter. ||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਾਤਾਲਾ ਪਾਤਾਲ ਲਖ ਆਗਾਸਾ ਆਗਾਸ ॥",
      "transliteration": "paataalaa paataal lakh aagaasaa aagaas ||",
      "translation": "There are nether worlds beneath nether worlds, and hundreds of thousands of heavenly worlds above.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਓੜਕ ਓੜਕ ਭਾਲਿ ਥਕੇ ਵੇਦ ਕਹਨਿ ਇਕ ਵਾਤ ॥",
      "transliteration": "oRak oRak bhaal thake ved kahan ik vaat ||",
      "translation": "The Vedas say that you can search and search for them all, until you grow weary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਹਸ ਅਠਾਰਹ ਕਹਨਿ ਕਤੇਬਾ ਅਸੁਲੂ ਇਕੁ ਧਾਤੁ ॥",
      "transliteration": "sahas athaarah kahan katebaa asuloo ik dhaat ||",
      "translation": "The scriptures say that there are 18,000 worlds, but in reality, there is only One Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲੇਖਾ ਹੋਇ ਤ ਲਿਖੀਐ ਲੇਖੈ ਹੋਇ ਵਿਣਾਸੁ ॥",
      "transliteration": "lekhaa hoi ta likheeai lekhai hoi vinaas ||",
      "translation": "If you try to write an account of this, you will surely finish yourself before you finish writing it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਨਕ ਵਡਾ ਆਖੀਐ ਆਪੇ ਜਾਣੈ ਆਪੁ ॥੨੨॥",
      "transliteration": "naanak vadaa aakheeai aape jaanai aap ||22||",
      "translation": "O Nanak, call Him Great! He Himself knows Himself. ||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਾਲਾਹੀ ਸਾਲਾਹਿ ਏਤੀ ਸੁਰਤਿ ਨ ਪਾਈਆ ॥",
      "transliteration": "saalaahee saalaahi etee surat na paaeeaa ||",
      "translation": "The praisers praise the Lord, but they do not obtain intuitive understanding",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਦੀਆ ਅਤੈ ਵਾਹ ਪਵਹਿ ਸਮੁੰਦਿ ਨ ਜਾਣੀਅਹਿ ॥",
      "transliteration": "nadeeaa atai vaah pavahi samu(n)d na jaaneeahi ||",
      "translation": "the streams and rivers flowing into the ocean do not know its vastness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਮੁੰਦ ਸਾਹ ਸੁਲਤਾਨ ਗਿਰਹਾ ਸੇਤੀ ਮਾਲੁ ਧਨੁ ॥",
      "transliteration": "samu(n)d saah sulataan girahaa setee maal dhan ||",
      "translation": "Even kings and emperors, with mountains of property and oceans of wealth",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕੀੜੀ ਤੁਲਿ ਨ ਹੋਵਨੀ ਜੇ ਤਿਸੁ ਮਨਹੁ ਨ ਵੀਸਰਹਿ ॥੨੩॥",
      "transliteration": "keeRee tul na hovanee je tis manahu na veesarahi ||23||",
      "translation": "-these are not even equal to an ant, who does not forget God. ||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅੰਤੁ ਨ ਸਿਫਤੀ ਕਹਣਿ ਨ ਅੰਤੁ ॥",
      "transliteration": "a(n)t na siphatee kahan na a(n)t ||",
      "translation": "Endless are His Praises, endless are those who speak them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅੰਤੁ ਨ ਕਰਣੈ ਦੇਣਿ ਨ ਅੰਤੁ ॥",
      "transliteration": "a(n)t na karanai den na a(n)t ||",
      "translation": "Endless are His Actions, endless are His Gifts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅੰਤੁ ਨ ਵੇਖਣਿ ਸੁਣਣਿ ਨ ਅੰਤੁ ॥",
      "transliteration": "a(n)t na vekhan sunan na a(n)t ||",
      "translation": "Endless is His Vision, endless is His Hearing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅੰਤੁ ਨ ਜਾਪੈ ਕਿਆ ਮਨਿ ਮੰਤੁ ॥",
      "transliteration": "a(n)t na jaapai kiaa man ma(n)t ||",
      "translation": "His limits cannot be perceived. What is the Mystery of His Mind?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅੰਤੁ ਨ ਜਾਪੈ ਕੀਤਾ ਆਕਾਰੁ ॥",
      "transliteration": "a(n)t na jaapai keetaa aakaar ||",
      "translation": "The limits of the created universe cannot be perceived.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅੰਤੁ ਨ ਜਾਪੈ ਪਾਰਾਵਾਰੁ ॥",
      "transliteration": "a(n)t na jaapai paaraavaar ||",
      "translation": "Its limits here and beyond cannot be perceived.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅੰਤ ਕਾਰਣਿ ਕੇਤੇ ਬਿਲਲਾਹਿ ॥",
      "transliteration": "a(n)t kaaran kete bilalaahi ||",
      "translation": "Many struggle to know His limits,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਕੇ ਅੰਤ ਨ ਪਾਏ ਜਾਹਿ ॥",
      "transliteration": "taa ke a(n)t na paae jaahi ||",
      "translation": "but His limits cannot be found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਏਹੁ ਅੰਤੁ ਨ ਜਾਣੈ ਕੋਇ ॥",
      "transliteration": "ehu a(n)t na jaanai koi ||",
      "translation": "No one can know these limits.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਹੁਤਾ ਕਹੀਐ ਬਹੁਤਾ ਹੋਇ ॥",
      "transliteration": "bahutaa kaheeai bahutaa hoi ||",
      "translation": "The more you say about them, the more there still remains to be said.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਵਡਾ ਸਾਹਿਬੁ ਊਚਾ ਥਾਉ ॥",
      "transliteration": "vadaa saahib oochaa thaau ||",
      "translation": "Great is the Master, High is His Heavenly Home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਊਚੇ ਉਪਰਿ ਊਚਾ ਨਾਉ ॥",
      "transliteration": "ooche upar oochaa naau ||",
      "translation": "Highest of the High, above all is His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਏਵਡੁ ਊਚਾ ਹੋਵੈ ਕੋਇ ॥",
      "transliteration": "evad oochaa hovai koi ||",
      "translation": "Only one as Great and as High as God",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਿਸੁ ਊਚੇ ਕਉ ਜਾਣੈ ਸੋਇ ॥",
      "transliteration": "tis ooche kau jaanai soi ||",
      "translation": "can know His Lofty and Exalted State.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੇਵਡੁ ਆਪਿ ਜਾਣੈ ਆਪਿ ਆਪਿ ॥",
      "transliteration": "jevad aap jaanai aap aap ||",
      "translation": "Only He Himself is that Great. He Himself knows Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਨਦਰੀ ਕਰਮੀ ਦਾਤਿ ॥੨੪॥",
      "transliteration": "naanak nadaree karamee daat ||24||",
      "translation": "O Nanak, by His Glance of Grace, He bestows His Blessings. ||24||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਹੁਤਾ ਕਰਮੁ ਲਿਖਿਆ ਨਾ ਜਾਇ ॥",
      "transliteration": "bahutaa karam likhiaa naa jaai ||",
      "translation": "His Blessings are so abundant that there can be no written account of them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਵਡਾ ਦਾਤਾ ਤਿਲੁ ਨ ਤਮਾਇ ॥",
      "transliteration": "vadaa daataa til na tamaai ||",
      "translation": "The Great Giver does not hold back anything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕੇਤੇ ਮੰਗਹਿ ਜੋਧ ਅਪਾਰ ॥",
      "transliteration": "kete ma(n)gahi jodh apaar ||",
      "translation": "There are so many great, heroic warriors begging at the Door of the Infinite Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕੇਤਿਆ ਗਣਤ ਨਹੀ ਵੀਚਾਰੁ ॥",
      "transliteration": "ketiaa ganat nahee veechaar ||",
      "translation": "So many contemplate and dwell upon Him, that they cannot be counted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੇਤੇ ਖਪਿ ਤੁਟਹਿ ਵੇਕਾਰ ॥",
      "transliteration": "kete khap tutahi vekaar ||",
      "translation": "So many waste away to death engaged in corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕੇਤੇ ਲੈ ਲੈ ਮੁਕਰੁ ਪਾਹਿ ॥",
      "transliteration": "kete lai lai mukar paahi ||",
      "translation": "So many take and take again, and then deny receiving.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕੇਤੇ ਮੂਰਖ ਖਾਹੀ ਖਾਹਿ ॥",
      "transliteration": "kete moorakh khaahee khaahi ||",
      "translation": "So many foolish consumers keep on consuming.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕੇਤਿਆ ਦੂਖ ਭੂਖ ਸਦ ਮਾਰ ॥",
      "transliteration": "ketiaa dookh bhookh sad maar ||",
      "translation": "So many endure distress, deprivation and constant abuse.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਏਹਿ ਭਿ ਦਾਤਿ ਤੇਰੀ ਦਾਤਾਰ ॥",
      "transliteration": "ehi bh daat teree daataar ||",
      "translation": "Even these are Your Gifts, O Great Giver!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬੰਦਿ ਖਲਾਸੀ ਭਾਣੈ ਹੋਇ ॥",
      "transliteration": "ba(n)d khalaasee bhaanai hoi ||",
      "translation": "Liberation from bondage comes only by Your Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹੋਰੁ ਆਖਿ ਨ ਸਕੈ ਕੋਇ ॥",
      "transliteration": "hor aakh na sakai koi ||",
      "translation": "No one else has any say in this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੇ ਕੋ ਖਾਇਕੁ ਆਖਣਿ ਪਾਇ ॥",
      "transliteration": "je ko khaaik aakhan paai ||",
      "translation": "If some fool should presume to say that he does,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਓਹੁ ਜਾਣੈ ਜੇਤੀਆ ਮੁਹਿ ਖਾਇ ॥",
      "transliteration": "ohu jaanai jeteeaa muhi khaai ||",
      "translation": "he shall learn, and feel the effects of his folly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਪੇ ਜਾਣੈ ਆਪੇ ਦੇਇ ॥",
      "transliteration": "aape jaanai aape dei ||",
      "translation": "He Himself knows, He Himself gives.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਖਹਿ ਸਿ ਭਿ ਕੇਈ ਕੇਇ ॥",
      "transliteration": "aakhahi s bh keee kei ||",
      "translation": "Few, very few are those who acknowledge this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਸ ਨੋ ਬਖਸੇ ਸਿਫਤਿ ਸਾਲਾਹ ॥",
      "transliteration": "jis no bakhase siphat saalaah ||",
      "translation": "One who is blessed to sing the Praises of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਪਾਤਿਸਾਹੀ ਪਾਤਿਸਾਹੁ ॥੨੫॥",
      "transliteration": "naanak paatisaahee paatisaahu ||25||",
      "translation": "O Nanak, is the king of kings. ||25||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਮੁਲ ਗੁਣ ਅਮੁਲ ਵਾਪਾਰ ॥",
      "transliteration": "amul gun amul vaapaar ||",
      "translation": "Priceless are His Virtues, Priceless are His Dealings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਮੁਲ ਵਾਪਾਰੀਏ ਅਮੁਲ ਭੰਡਾਰ ॥",
      "transliteration": "amul vaapaareee amul bha(n)daar ||",
      "translation": "Priceless are His Dealers, Priceless are His Treasures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਮੁਲ ਆਵਹਿ ਅਮੁਲ ਲੈ ਜਾਹਿ ॥",
      "transliteration": "amul aavahi amul lai jaahi ||",
      "translation": "Priceless are those who come to Him, Priceless are those who buy from Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਮੁਲ ਭਾਇ ਅਮੁਲਾ ਸਮਾਹਿ ॥",
      "transliteration": "amul bhaai amulaa samaahi ||",
      "translation": "Priceless is Love for Him, Priceless is absorption into Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਅਮੁਲੁ ਧਰਮੁ ਅਮੁਲੁ ਦੀਬਾਣੁ ॥",
      "transliteration": "amul dharam amul deebaan ||",
      "translation": "Priceless is the Divine Law of Dharma, Priceless is the Divine Court of Justice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਮੁਲੁ ਤੁਲੁ ਅਮੁਲੁ ਪਰਵਾਣੁ ॥",
      "transliteration": "amul tul amul paravaan ||",
      "translation": "Priceless are the scales, priceless are the weights.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਮੁਲੁ ਬਖਸੀਸ ਅਮੁਲੁ ਨੀਸਾਣੁ ॥",
      "transliteration": "amul bakhasees amul neesaan ||",
      "translation": "Priceless are His Blessings, Priceless is His Banner and Insignia.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅਮੁਲੁ ਕਰਮੁ ਅਮੁਲੁ ਫੁਰਮਾਣੁ ॥",
      "transliteration": "amul karam amul phuramaan ||",
      "translation": "Priceless is His Mercy, Priceless is His Royal Command.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਅਮੁਲੋ ਅਮੁਲੁ ਆਖਿਆ ਨ ਜਾਇ ॥",
      "transliteration": "amulo amul aakhiaa na jaai ||",
      "translation": "Priceless, O Priceless beyond expression!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਆਖਿ ਆਖਿ ਰਹੇ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "aakh aakh rahe liv laai ||",
      "translation": "Speak of Him continually, and remain absorbed in His Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਆਖਹਿ ਵੇਦ ਪਾਠ ਪੁਰਾਣ ॥",
      "transliteration": "aakhahi ved paath puraan ||",
      "translation": "The Vedas and the Puraanas speak.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਆਖਹਿ ਪੜੇ ਕਰਹਿ ਵਖਿਆਣ ॥",
      "transliteration": "aakhahi paRe karahi vakhiaan ||",
      "translation": "The scholars speak and lecture.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0005_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਆਖਹਿ ਬਰਮੇ ਆਖਹਿ ਇੰਦ ॥",
      "transliteration": "aakhahi barame aakhahi i(n)d ||",
      "translation": "Brahma speaks, Indra speaks.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 5,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
