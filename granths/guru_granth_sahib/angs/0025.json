{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 25,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0025_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੇਹੀ ਸੁਰਤਿ ਤੇਹਾ ਤਿਨ ਰਾਹੁ ॥",
      "transliteration": "jehee surat tehaa tin raahu ||",
      "translation": "As is their awareness, so is their way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਲੇਖਾ ਇਕੋ ਆਵਹੁ ਜਾਹੁ ॥੧॥",
      "transliteration": "lekhaa iko aavahu jaahu ||1||",
      "translation": "According to the account of our actions, we come and go in reincarnation. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਾਹੇ ਜੀਅ ਕਰਹਿ ਚਤੁਰਾਈ ॥",
      "transliteration": "kaahe jee karahi chaturaaee ||",
      "translation": "Why, O soul, do you try such clever tricks?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਲੇਵੈ ਦੇਵੈ ਢਿਲ ਨ ਪਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "levai devai dhil na paaee ||1|| rahaau ||",
      "translation": "Taking away and giving back, God does not delay. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੇਰੇ ਜੀਅ ਜੀਆ ਕਾ ਤੋਹਿ ॥",
      "transliteration": "tere jee jeeaa kaa tohi ||",
      "translation": "All beings belong to You; all beings are Yours. O Lord and Master,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿਤ ਕਉ ਸਾਹਿਬ ਆਵਹਿ ਰੋਹਿ ॥",
      "transliteration": "kit kau saahib aavahi rohi ||",
      "translation": "how can You become angry with them?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੇ ਤੂ ਸਾਹਿਬ ਆਵਹਿ ਰੋਹਿ ॥",
      "transliteration": "je too saahib aavahi rohi ||",
      "translation": "Even if You, O Lord and Master, become angry with them,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੂ ਓਨਾ ਕਾ ਤੇਰੇ ਓਹਿ ॥੨॥",
      "transliteration": "too onaa kaa tere ohi ||2||",
      "translation": "still, You are theirs, and they are Yours. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਸੀ ਬੋਲਵਿਗਾੜ ਵਿਗਾੜਹ ਬੋਲ ॥",
      "transliteration": "asee bolavigaaR vigaaRah bol ||",
      "translation": "We are foul-mouthed; we spoil everything with our foul words.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤੂ ਨਦਰੀ ਅੰਦਰਿ ਤੋਲਹਿ ਤੋਲ ॥",
      "transliteration": "too nadaree a(n)dar tolahi tol ||",
      "translation": "You weigh us in the balance of Your Glance of Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਹ ਕਰਣੀ ਤਹ ਪੂਰੀ ਮਤਿ ॥",
      "transliteration": "jah karanee tah pooree mat ||",
      "translation": "When one's actions are right, the understanding is perfect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਰਣੀ ਬਾਝਹੁ ਘਟੇ ਘਟਿ ॥੩॥",
      "transliteration": "karanee baajhahu ghate ghat ||3||",
      "translation": "Without good deeds, it becomes more and more deficient. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪ੍ਰਣਵਤਿ ਨਾਨਕ ਗਿਆਨੀ ਕੈਸਾ ਹੋਇ ॥",
      "transliteration": "pranavat naanak giaanee kaisaa hoi ||",
      "translation": "Prays Nanak, what is the nature of the spiritual people?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਪੁ ਪਛਾਣੈ ਬੂਝੈ ਸੋਇ ॥",
      "transliteration": "aap pachhaanai boojhai soi ||",
      "translation": "They are self-realized; they understand God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਕਰੇ ਬੀਚਾਰੁ ॥",
      "transliteration": "gur parasaad kare beechaar ||",
      "translation": "By Guru's Grace, they contemplate Him;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੋ ਗਿਆਨੀ ਦਰਗਹ ਪਰਵਾਣੁ ॥੪॥੩੦॥",
      "transliteration": "so giaanee daragah paravaan ||4||30||",
      "translation": "such spiritual people are honored in His Court. ||4||30||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ੧ ਘਰੁ ੪ ॥",
      "transliteration": "sireeraag mahalaa 1 ghar 4 ||",
      "translation": "Siree Raag, First Mehl, Fourth House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤੂ ਦਰੀਆਉ ਦਾਨਾ ਬੀਨਾ ਮੈ ਮਛੁਲੀ ਕੈਸੇ ਅੰਤੁ ਲਹਾ ॥",
      "transliteration": "too dareeaau daanaa beenaa mai machhulee kaise a(n)t lahaa ||",
      "translation": "You are the River, All-knowing and All-seeing. I am just a fish-how can I find Your limit?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਹ ਜਹ ਦੇਖਾ ਤਹ ਤਹ ਤੂ ਹੈ ਤੁਝ ਤੇ ਨਿਕਸੀ ਫੂਟਿ ਮਰਾ ॥੧॥",
      "transliteration": "jah jah dekhaa tah tah too hai tujh te nikasee phoot maraa ||1||",
      "translation": "Wherever I look, You are there. Outside of You, I would burst and die. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨ ਜਾਣਾ ਮੇਉ ਨ ਜਾਣਾ ਜਾਲੀ ॥",
      "transliteration": "na jaanaa meu na jaanaa jaalee ||",
      "translation": "I do not know of the fisherman, and I do not know of the net.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾ ਦੁਖੁ ਲਾਗੈ ਤਾ ਤੁਝੈ ਸਮਾਲੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaa dukh laagai taa tujhai samaalee ||1|| rahaau ||",
      "translation": "But when the pain comes, then I call upon You. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤੂ ਭਰਪੂਰਿ ਜਾਨਿਆ ਮੈ ਦੂਰਿ ॥",
      "transliteration": "too bharapoor jaaniaa mai door ||",
      "translation": "You are present everywhere. I had thought that You were far away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੋ ਕਛੁ ਕਰੀ ਸੁ ਤੇਰੈ ਹਦੂਰਿ ॥",
      "transliteration": "jo kachh karee s terai hadoor ||",
      "translation": "Whatever I do, I do in Your Presence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੂ ਦੇਖਹਿ ਹਉ ਮੁਕਰਿ ਪਾਉ ॥",
      "transliteration": "too dekhahi hau mukar paau ||",
      "translation": "You see all my actions, and yet I deny them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤੇਰੈ ਕੰਮਿ ਨ ਤੇਰੈ ਨਾਇ ॥੨॥",
      "transliteration": "terai ka(n)m na terai naai ||2||",
      "translation": "I have not worked for You, or Your Name. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੇਤਾ ਦੇਹਿ ਤੇਤਾ ਹਉ ਖਾਉ ॥",
      "transliteration": "jetaa dehi tetaa hau khaau ||",
      "translation": "Whatever You give me, that is what I eat.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਿਆ ਦਰੁ ਨਾਹੀ ਕੈ ਦਰਿ ਜਾਉ ॥",
      "transliteration": "biaa dar naahee kai dar jaau ||",
      "translation": "There is no other door-unto which door should I go?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕੁ ਏਕ ਕਹੈ ਅਰਦਾਸਿ ॥",
      "transliteration": "naanak ek kahai aradaas ||",
      "translation": "Nanak offers this one prayer:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਸਭੁ ਤੇਰੈ ਪਾਸਿ ॥੩॥",
      "transliteration": "jeeu pi(n)d sabh terai paas ||3||",
      "translation": "this body and soul are totally Yours. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਪੇ ਨੇੜੈ ਦੂਰਿ ਆਪੇ ਹੀ ਆਪੇ ਮੰਝਿ ਮਿਆਨੋੁ ॥",
      "transliteration": "aape neRai door aape hee aape ma(n)jh miaanou ||",
      "translation": "He Himself is near, and He Himself is far away; He Himself is in-between.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਪੇ ਵੇਖੈ ਸੁਣੇ ਆਪੇ ਹੀ ਕੁਦਰਤਿ ਕਰੇ ਜਹਾਨੋੁ ॥",
      "transliteration": "aape vekhai sune aape hee kudarat kare jahaanou ||",
      "translation": "He Himself beholds, and He Himself listens. By His Creative Power, He created the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਨਾਨਕਾ ਹੁਕਮੁ ਸੋਈ ਪਰਵਾਨੋੁ ॥੪॥੩੧॥",
      "transliteration": "jo tis bhaavai naanakaa hukam soee paravaanou ||4||31||",
      "translation": "Whatever pleases Him, O Nanak-that Command is acceptable. ||4||31||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ੧ ਘਰੁ ੪ ॥",
      "transliteration": "sireeraag mahalaa 1 ghar 4 ||",
      "translation": "Siree Raag, First Mehl, Fourth House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕੀਤਾ ਕਹਾ ਕਰੇ ਮਨਿ ਮਾਨੁ ॥",
      "transliteration": "keetaa kahaa kare man maan ||",
      "translation": "Why should the created beings feel pride in their minds?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੇਵਣਹਾਰੇ ਕੈ ਹਥਿ ਦਾਨੁ ॥",
      "transliteration": "devanahaare kai hath daan ||",
      "translation": "The Gift is in the Hands of the Great Giver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਾਵੈ ਦੇਇ ਨ ਦੇਈ ਸੋਇ ॥",
      "transliteration": "bhaavai dei na deee soi ||",
      "translation": "As it pleases Him, He may give, or not give.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕੀਤੇ ਕੈ ਕਹਿਐ ਕਿਆ ਹੋਇ ॥੧॥",
      "transliteration": "keete kai kahiai kiaa hoi ||1||",
      "translation": "What can be done by the order of the created beings? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਪੇ ਸਚੁ ਭਾਵੈ ਤਿਸੁ ਸਚੁ ॥",
      "transliteration": "aape sach bhaavai tis sach ||",
      "translation": "He Himself is True; Truth is pleasing to His Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅੰਧਾ ਕਚਾ ਕਚੁ ਨਿਕਚੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "a(n)dhaa kachaa kach nikach ||1|| rahaau ||",
      "translation": "The spiritually blind are unripe and imperfect, inferior and worthless. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾ ਕੇ ਰੁਖ ਬਿਰਖ ਆਰਾਉ ॥",
      "transliteration": "jaa ke rukh birakh aaraau ||",
      "translation": "The One who owns the trees of the forest and the plants of the garden",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੇਹੀ ਧਾਤੁ ਤੇਹਾ ਤਿਨ ਨਾਉ ॥",
      "transliteration": "jehee dhaat tehaa tin naau ||",
      "translation": "according to their nature, He gives them all their names.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਫੁਲੁ ਭਾਉ ਫਲੁ ਲਿਖਿਆ ਪਾਇ ॥",
      "transliteration": "phul bhaau phal likhiaa paai ||",
      "translation": "The Flower and the Fruit of the Lord's Love are obtained by pre-ordained destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਪਿ ਬੀਜਿ ਆਪੇ ਹੀ ਖਾਇ ॥੨॥",
      "transliteration": "aap beej aape hee khaai ||2||",
      "translation": "As we plant, so we harvest and eat. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਚੀ ਕੰਧ ਕਚਾ ਵਿਚਿ ਰਾਜੁ ॥",
      "transliteration": "kachee ka(n)dh kachaa vich raaj ||",
      "translation": "The wall of the body is temporary, as is the soul-mason within it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਤਿ ਅਲੂਣੀ ਫਿਕਾ ਸਾਦੁ ॥",
      "transliteration": "mat aloonee phikaa saad ||",
      "translation": "The flavor of the intellect is bland and insipid without the Salt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕ ਆਣੇ ਆਵੈ ਰਾਸਿ ॥",
      "transliteration": "naanak aane aavai raas ||",
      "translation": "O Nanak, as He wills, He makes things right.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਵਿਣੁ ਨਾਵੈ ਨਾਹੀ ਸਾਬਾਸਿ ॥੩॥੩੨॥",
      "transliteration": "vin naavai naahee saabaas ||3||32||",
      "translation": "Without the Name, no one is approved. ||3||32||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ੧ ਘਰੁ ੫ ॥",
      "transliteration": "sireeraag mahalaa 1 ghar 5 ||",
      "translation": "Siree Raag, First Mehl, Fifth House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਛਲ ਛਲਾਈ ਨਹ ਛਲੈ ਨਹ ਘਾਉ ਕਟਾਰਾ ਕਰਿ ਸਕੈ ॥",
      "transliteration": "achhal chhalaaee nah chhalai nah ghaau kataaraa kar sakai ||",
      "translation": "The Undeceiveable is not deceived by deception. He cannot be wounded by any dagger.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਉ ਸਾਹਿਬੁ ਰਾਖੈ ਤਿਉ ਰਹੈ ਇਸੁ ਲੋਭੀ ਕਾ ਜੀਉ ਟਲ ਪਲੈ ॥੧॥",
      "transliteration": "jiu saahib raakhai tiu rahai is lobhee kaa jeeu tal palai ||1||",
      "translation": "As our Lord and Master keeps us, so do we exist. The soul of this greedy person is tossed this way and that. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬਿਨੁ ਤੇਲ ਦੀਵਾ ਕਿਉ ਜਲੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin tel deevaa kiu jalai ||1|| rahaau ||",
      "translation": "Without the oil, how can the lamp be lit? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪੋਥੀ ਪੁਰਾਣ ਕਮਾਈਐ ॥",
      "transliteration": "pothee puraan kamaaeeai ||",
      "translation": "Let the reading of your prayer book be the oil,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਭਉ ਵਟੀ ਇਤੁ ਤਨਿ ਪਾਈਐ ॥",
      "transliteration": "bhau vatee it tan paaeeai ||",
      "translation": "And let the Fear of God be the wick for the lamp of this body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਚੁ ਬੂਝਣੁ ਆਣਿ ਜਲਾਈਐ ॥੨॥",
      "transliteration": "sach boojhan aan jalaaeeai ||2||",
      "translation": "Light this lamp with the understanding of Truth. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਇਹੁ ਤੇਲੁ ਦੀਵਾ ਇਉ ਜਲੈ ॥",
      "transliteration": "ihu tel deevaa iu jalai ||",
      "translation": "Use this oil to light this lamp.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਰਿ ਚਾਨਣੁ ਸਾਹਿਬ ਤਉ ਮਿਲੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar chaanan saahib tau milai ||1|| rahaau ||",
      "translation": "Light it, and meet your Lord and Master. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਇਤੁ ਤਨਿ ਲਾਗੈ ਬਾਣੀਆ ॥",
      "transliteration": "it tan laagai baaneeaa ||",
      "translation": "This body is softened with the Word of the Guru's Bani;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0025_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸੁਖੁ ਹੋਵੈ ਸੇਵ ਕਮਾਣੀਆ ॥",
      "transliteration": "sukh hovai sev kamaaneeaa ||",
      "translation": "you shall find peace, doing seva (selfless service).",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 25,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
