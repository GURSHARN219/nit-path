{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 71,
  "lineCount": 50,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0071_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਿਤਿ ਨ ਆਇਓ ਪਾਰਬ੍ਰਹਮੁ ਤਾ ਖੜਿ ਰਸਾਤਲਿ ਦੀਤ ॥੭॥",
      "transliteration": "chit na aaio paarabraham taa khaR rasaatal deet ||7||",
      "translation": "But still, if you do not come to remember the Supreme Lord God, then you shall be taken and consigned to the most hideous hell! ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਾਇਆ ਰੋਗੁ ਨ ਛਿਦ੍ਰੁ ਕਿਛੁ ਨਾ ਕਿਛੁ ਕਾੜਾ ਸੋਗੁ ॥",
      "transliteration": "kaaiaa rog na chhidr kichh naa kichh kaaRaa sog ||",
      "translation": "You may have a body free of disease and deformity, and have no worries or grief at all;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਿਰਤੁ ਨ ਆਵੀ ਚਿਤਿ ਤਿਸੁ ਅਹਿਨਿਸਿ ਭੋਗੈ ਭੋਗੁ ॥",
      "transliteration": "mirat na aavee chit tis ahinis bhogai bhog ||",
      "translation": "you may be unmindful of death, and night and day revel in pleasures;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਭ ਕਿਛੁ ਕੀਤੋਨੁ ਆਪਣਾ ਜੀਇ ਨ ਸੰਕ ਧਰਿਆ ॥",
      "transliteration": "sabh kichh keeton aapanaa jeei na sa(n)k dhariaa ||",
      "translation": "you may take everything as your own, and have no fear in your mind at all;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚਿਤਿ ਨ ਆਇਓ ਪਾਰਬ੍ਰਹਮੁ ਜਮਕੰਕਰ ਵਸਿ ਪਰਿਆ ॥੮॥",
      "transliteration": "chit na aaio paarabraham jamaka(n)kar vas pariaa ||8||",
      "translation": "but still, if you do not come to remember the Supreme Lord God, you shall fall under the power of the Messenger of Death. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿਰਪਾ ਕਰੇ ਜਿਸੁ ਪਾਰਬ੍ਰਹਮੁ ਹੋਵੈ ਸਾਧੂ ਸੰਗੁ ॥",
      "transliteration": "kirapaa kare jis paarabraham hovai saadhoo sa(n)g ||",
      "translation": "The Supreme Lord showers His Mercy, and we find the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਿਉ ਜਿਉ ਓਹੁ ਵਧਾਈਐ ਤਿਉ ਤਿਉ ਹਰਿ ਸਿਉ ਰੰਗੁ ॥",
      "transliteration": "jiu jiu ohu vadhaaeeai tiu tiu har siu ra(n)g ||",
      "translation": "The more time we spend there, the more we come to love the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੁਹਾ ਸਿਰਿਆ ਕਾ ਖਸਮੁ ਆਪਿ ਅਵਰੁ ਨ ਦੂਜਾ ਥਾਉ ॥",
      "transliteration": "duhaa siriaa kaa khasam aap avar na doojaa thaau ||",
      "translation": "The Lord is the Master of both worlds; there is no other place of rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਤਿਗੁਰ ਤੁਠੈ ਪਾਇਆ ਨਾਨਕ ਸਚਾ ਨਾਉ ॥੯॥੧॥੨੬॥",
      "transliteration": "satigur tuthai paaiaa naanak sachaa naau ||9||1||26||",
      "translation": "When the True Guru is pleased and satisfied, O Nanak, the True Name is obtained. ||9||1||26||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ੫ ਘਰੁ ੫ ॥",
      "transliteration": "sireeraag mahalaa 5 ghar 5 ||",
      "translation": "Siree Raag, Fifth Mehl, Fifth House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਾਨਉ ਨਹੀ ਭਾਵੈ ਕਵਨ ਬਾਤਾ ॥",
      "transliteration": "jaanau nahee bhaavai kavan baataa ||",
      "translation": "I do not know what pleases my Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਨ ਖੋਜਿ ਮਾਰਗੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "man khoj maarag ||1|| rahaau ||",
      "translation": "O mind, seek out the way! ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਿਆਨੀ ਧਿਆਨੁ ਲਾਵਹਿ ॥",
      "transliteration": "dhiaanee dhiaan laavahi ||",
      "translation": "The meditatives practice meditation,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗਿਆਨੀ ਗਿਆਨੁ ਕਮਾਵਹਿ ॥",
      "transliteration": "giaanee giaan kamaavahi ||",
      "translation": "and the wise practice spiritual wisdom,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪ੍ਰਭੁ ਕਿਨ ਹੀ ਜਾਤਾ ॥੧॥",
      "transliteration": "prabh kin hee jaataa ||1||",
      "translation": "but how rare are those who know God! ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਗਉਤੀ ਰਹਤ ਜੁਗਤਾ ॥",
      "transliteration": "bhagautee rahat jugataa ||",
      "translation": "The worshipper of Bhagaauti practices self-discipline,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੋਗੀ ਕਹਤ ਮੁਕਤਾ ॥",
      "transliteration": "jogee kahat mukataa ||",
      "translation": "the Yogi speaks of liberation,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਪਸੀ ਤਪਹਿ ਰਾਤਾ ॥੨॥",
      "transliteration": "tapasee tapahi raataa ||2||",
      "translation": "and the ascetic is absorbed in asceticism. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੋਨੀ ਮੋਨਿਧਾਰੀ ॥",
      "transliteration": "monee monidhaaree ||",
      "translation": "The men of silence observe silence,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਨਿਆਸੀ ਬ੍ਰਹਮਚਾਰੀ ॥",
      "transliteration": "saniaasee brahamachaaree ||",
      "translation": "the Sanyaasees observe celibacy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਉਦਾਸੀ ਉਦਾਸਿ ਰਾਤਾ ॥੩॥",
      "transliteration": "udaasee udaas raataa ||3||",
      "translation": "and the Udaasees abide in detachment. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭਗਤਿ ਨਵੈ ਪਰਕਾਰਾ ॥",
      "transliteration": "bhagat navai parakaaraa ||",
      "translation": "There are nine forms of devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪੰਡਿਤੁ ਵੇਦੁ ਪੁਕਾਰਾ ॥",
      "transliteration": "pa(n)dit ved pukaaraa ||",
      "translation": "The Pandits recite the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗਿਰਸਤੀ ਗਿਰਸਤਿ ਧਰਮਾਤਾ ॥੪॥",
      "transliteration": "girasatee girasat dharamaataa ||4||",
      "translation": "The householders assert their faith in family life. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਕ ਸਬਦੀ ਬਹੁ ਰੂਪਿ ਅਵਧੂਤਾ ॥",
      "transliteration": "ik sabadee bahu roop avadhootaa ||",
      "translation": "Those who utter only One Word, those who take many forms, the naked renunciates,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਾਪੜੀ ਕਉਤੇ ਜਾਗੂਤਾ ॥",
      "transliteration": "kaapaRee kaute jaagootaa ||",
      "translation": "the wearers of patched coats, the magicians, those who remain always awake,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਕਿ ਤੀਰਥਿ ਨਾਤਾ ॥੫॥",
      "transliteration": "ik teerath naataa ||5||",
      "translation": "and those who bathe at holy places of pilgrimage-||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਿਰਹਾਰ ਵਰਤੀ ਆਪਰਸਾ ॥",
      "transliteration": "nirahaar varatee aaparasaa ||",
      "translation": "Those who go without food, those who never touch others,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਕਿ ਲੂਕਿ ਨ ਦੇਵਹਿ ਦਰਸਾ ॥",
      "transliteration": "ik look na devahi darasaa ||",
      "translation": "the hermits who never show themselves,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਕਿ ਮਨ ਹੀ ਗਿਆਤਾ ॥੬॥",
      "transliteration": "ik man hee giaataa ||6||",
      "translation": "and those who are wise in their own minds-||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਘਾਟਿ ਨ ਕਿਨ ਹੀ ਕਹਾਇਆ ॥",
      "transliteration": "ghaat na kin hee kahaaiaa ||",
      "translation": "Of these, no one admits to any deficiency;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਭ ਕਹਤੇ ਹੈ ਪਾਇਆ ॥",
      "transliteration": "sabh kahate hai paaiaa ||",
      "translation": "all say that they have found the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਸੁ ਮੇਲੇ ਸੋ ਭਗਤਾ ॥੭॥",
      "transliteration": "jis mele so bhagataa ||7||",
      "translation": "But he alone is a devotee, whom the Lord has united with Himself. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਗਲ ਉਕਤਿ ਉਪਾਵਾ ॥",
      "transliteration": "sagal ukat upaavaa ||",
      "translation": "Abandoning all devices and contrivances,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਿਆਗੀ ਸਰਨਿ ਪਾਵਾ ॥",
      "transliteration": "tiaagee saran paavaa ||",
      "translation": "I have sought His Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਨਕੁ ਗੁਰ ਚਰਣਿ ਪਰਾਤਾ ॥੮॥੨॥੨੭॥",
      "transliteration": "naanak gur charan paraataa ||8||2||27||",
      "translation": "Nanak has fallen at the Feet of the Guru. ||8||2||27||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ੧ ਘਰੁ ੩ ॥",
      "transliteration": "sireeraag mahalaa 1 ghar 3 ||",
      "translation": "Siree Raag, First Mehl, Third House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੋਗੀ ਅੰਦਰਿ ਜੋਗੀਆ ॥",
      "transliteration": "jogee a(n)dar jogeeaa ||",
      "translation": "Among Yogis, You are the Yogi;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤੂੰ ਭੋਗੀ ਅੰਦਰਿ ਭੋਗੀਆ ॥",
      "transliteration": "too(n) bhogee a(n)dar bhogeeaa ||",
      "translation": "among pleasure seekers, You are the Pleasure Seeker.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੇਰਾ ਅੰਤੁ ਨ ਪਾਇਆ ਸੁਰਗਿ ਮਛਿ ਪਇਆਲਿ ਜੀਉ ॥੧॥",
      "transliteration": "teraa a(n)t na paaiaa surag machh paiaal jeeu ||1||",
      "translation": "Your limits are not known to any of the beings in the heavens, in this world, or in the nether regions of the underworld. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਉ ਵਾਰੀ ਹਉ ਵਾਰਣੈ ਕੁਰਬਾਣੁ ਤੇਰੇ ਨਾਵ ਨੋ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "hau vaaree hau vaaranai kurabaan tere naav no ||1|| rahaau ||",
      "translation": "I am devoted, dedicated, a sacrifice to Your Name. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੁਧੁ ਸੰਸਾਰੁ ਉਪਾਇਆ ॥",
      "transliteration": "tudh sa(n)saar upaaiaa ||",
      "translation": "You created the world,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਿਰੇ ਸਿਰਿ ਧੰਧੇ ਲਾਇਆ ॥",
      "transliteration": "sire sir dha(n)dhe laaiaa ||",
      "translation": "and assigned tasks to one and all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਵੇਖਹਿ ਕੀਤਾ ਆਪਣਾ ਕਰਿ ਕੁਦਰਤਿ ਪਾਸਾ ਢਾਲਿ ਜੀਉ ॥੨॥",
      "transliteration": "vekhahi keetaa aapanaa kar kudarat paasaa dhaal jeeu ||2||",
      "translation": "You watch over Your Creation, and through Your All-powerful Creative Potency, You cast the dice. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪਰਗਟਿ ਪਾਹਾਰੈ ਜਾਪਦਾ ॥",
      "transliteration": "paragat paahaarai jaapadaa ||",
      "translation": "You are manifest in the Expanse of Your Workshop.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਭੁ ਨਾਵੈ ਨੋ ਪਰਤਾਪਦਾ ॥",
      "transliteration": "sabh naavai no parataapadaa ||",
      "translation": "Everyone longs for Your Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਤਿਗੁਰ ਬਾਝੁ ਨ ਪਾਇਓ ਸਭ ਮੋਹੀ ਮਾਇਆ ਜਾਲਿ ਜੀਉ ॥੩॥",
      "transliteration": "satigur baajh na paaio sabh mohee maaiaa jaal jeeu ||3||",
      "translation": "but without the Guru, no one finds You. All are enticed and trapped by Maya. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਤਿਗੁਰ ਕਉ ਬਲਿ ਜਾਈਐ ॥",
      "transliteration": "satigur kau bal jaaeeai ||",
      "translation": "I am a sacrifice to the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0071_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਤੁ ਮਿਲਿਐ ਪਰਮ ਗਤਿ ਪਾਈਐ ॥",
      "transliteration": "jit miliai param gat paaeeai ||",
      "translation": "Meeting Him, the supreme status is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 71,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
