{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 72,
  "lineCount": 46,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0072_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁਰਿ ਨਰ ਮੁਨਿ ਜਨ ਲੋਚਦੇ ਸੋ ਸਤਿਗੁਰਿ ਦੀਆ ਬੁਝਾਇ ਜੀਉ ॥੪॥",
      "transliteration": "sur nar mun jan lochade so satigur deeaa bujhaai jeeu ||4||",
      "translation": "The angelic beings and the silent sages long for Him; the True Guru has given me this understanding. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਤਸੰਗਤਿ ਕੈਸੀ ਜਾਣੀਐ ॥",
      "transliteration": "satasa(n)gat kaisee jaaneeai ||",
      "translation": "How is the Society of the Saints to be known?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਿਥੈ ਏਕੋ ਨਾਮੁ ਵਖਾਣੀਐ ॥",
      "transliteration": "jithai eko naam vakhaaneeai ||",
      "translation": "There, the Name of the One Lord is chanted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਏਕੋ ਨਾਮੁ ਹੁਕਮੁ ਹੈ ਨਾਨਕ ਸਤਿਗੁਰਿ ਦੀਆ ਬੁਝਾਇ ਜੀਉ ॥੫॥",
      "transliteration": "eko naam hukam hai naanak satigur deeaa bujhaai jeeu ||5||",
      "translation": "The One Name is the Lord's Command; O Nanak, the True Guru has given me this understanding. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਹੁ ਜਗਤੁ ਭਰਮਿ ਭੁਲਾਇਆ ॥",
      "transliteration": "ihu jagat bharam bhulaaiaa ||",
      "translation": "This world has been deluded by doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਪਹੁ ਤੁਧੁ ਖੁਆਇਆ ॥",
      "transliteration": "aapahu tudh khuaaiaa ||",
      "translation": "You Yourself, Lord, have led it astray.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਰਤਾਪੁ ਲਗਾ ਦੋਹਾਗਣੀ ਭਾਗ ਜਿਨਾ ਕੇ ਨਾਹਿ ਜੀਉ ॥੬॥",
      "transliteration": "parataap lagaa dohaaganee bhaag jinaa ke naahi jeeu ||6||",
      "translation": "The discarded soul-brides suffer in terrible agony; they have no luck at all. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੋਹਾਗਣੀ ਕਿਆ ਨੀਸਾਣੀਆ ॥",
      "transliteration": "dohaaganee kiaa neesaaneeaa ||",
      "translation": "What are the signs of the discarded brides?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਖਸਮਹੁ ਘੁਥੀਆ ਫਿਰਹਿ ਨਿਮਾਣੀਆ ॥",
      "transliteration": "khasamahu ghutheeaa phirahi nimaaneeaa ||",
      "translation": "They miss their Husband Lord, and they wander around in dishonor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮੈਲੇ ਵੇਸ ਤਿਨਾ ਕਾਮਣੀ ਦੁਖੀ ਰੈਣਿ ਵਿਹਾਇ ਜੀਉ ॥੭॥",
      "transliteration": "maile ves tinaa kaamanee dukhee rain vihaai jeeu ||7||",
      "translation": "The clothes of those brides are filthy-they pass their life-night in agony. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੋਹਾਗਣੀ ਕਿਆ ਕਰਮੁ ਕਮਾਇਆ ॥",
      "transliteration": "sohaaganee kiaa karam kamaaiaa ||",
      "translation": "What actions have the happy soul-brides performed?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪੂਰਬਿ ਲਿਖਿਆ ਫਲੁ ਪਾਇਆ ॥",
      "transliteration": "poorab likhiaa phal paaiaa ||",
      "translation": "They have obtained the fruit of their pre-ordained destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਕੈ ਆਪਣੀ ਆਪੇ ਲਏ ਮਿਲਾਇ ਜੀਉ ॥੮॥",
      "transliteration": "nadar kare kai aapanee aape lae milaai jeeu ||8||",
      "translation": "Casting His Glance of Grace, the Lord unites them with Himself. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹੁਕਮੁ ਜਿਨਾ ਨੋ ਮਨਾਇਆ ॥",
      "transliteration": "hukam jinaa no manaaiaa ||",
      "translation": "Those, whom God causes to abide by His Will,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਿਨ ਅੰਤਰਿ ਸਬਦੁ ਵਸਾਇਆ ॥",
      "transliteration": "tin a(n)tar sabad vasaaiaa ||",
      "translation": "have the Shabad of His Word abiding deep within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਹੀਆ ਸੇ ਸੋਹਾਗਣੀ ਜਿਨ ਸਹ ਨਾਲਿ ਪਿਆਰੁ ਜੀਉ ॥੯॥",
      "transliteration": "saheeaa se sohaaganee jin sah naal piaar jeeu ||9||",
      "translation": "They are the true soul-brides, who embrace love for their Husband Lord. ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਨਾ ਭਾਣੇ ਕਾ ਰਸੁ ਆਇਆ ॥",
      "transliteration": "jinaa bhaane kaa ras aaiaa ||",
      "translation": "Those who take pleasure in God's Will",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਿਨ ਵਿਚਹੁ ਭਰਮੁ ਚੁਕਾਇਆ ॥",
      "transliteration": "tin vichahu bharam chukaaiaa ||",
      "translation": "remove doubt from within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਸਤਿਗੁਰੁ ਐਸਾ ਜਾਣੀਐ ਜੋ ਸਭਸੈ ਲਏ ਮਿਲਾਇ ਜੀਉ ॥੧੦॥",
      "transliteration": "naanak satigur aisaa jaaneeai jo sabhasai lae milaai jeeu ||10||",
      "translation": "O Nanak, know Him as the True Guru, who unites all with the Lord. ||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਮਿਲਿਐ ਫਲੁ ਪਾਇਆ ॥",
      "transliteration": "satigur miliai phal paaiaa ||",
      "translation": "Meeting with the True Guru, they receive the fruits of their destiny,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਨਿ ਵਿਚਹੁ ਅਹਕਰਣੁ ਚੁਕਾਇਆ ॥",
      "transliteration": "jin vichahu ahakaran chukaaiaa ||",
      "translation": "and egotism is driven out from within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੁਰਮਤਿ ਕਾ ਦੁਖੁ ਕਟਿਆ ਭਾਗੁ ਬੈਠਾ ਮਸਤਕਿ ਆਇ ਜੀਉ ॥੧੧॥",
      "transliteration": "duramat kaa dukh katiaa bhaag baithaa masatak aai jeeu ||11||",
      "translation": "The pain of evil-mindedness is eliminated; good fortune comes and shines radiantly from their foreheads. ||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਤੇਰੀ ਬਾਣੀਆ ॥",
      "transliteration": "a(n)mrit teree baaneeaa ||",
      "translation": "The Bani of Your Word is Ambrosial Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੇਰਿਆ ਭਗਤਾ ਰਿਦੈ ਸਮਾਣੀਆ ॥",
      "transliteration": "teriaa bhagataa ridai samaaneeaa ||",
      "translation": "It permeates the hearts of Your devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁਖ ਸੇਵਾ ਅੰਦਰਿ ਰਖਿਐ ਆਪਣੀ ਨਦਰਿ ਕਰਹਿ ਨਿਸਤਾਰਿ ਜੀਉ ॥੧੨॥",
      "transliteration": "sukh sevaa a(n)dar rakhiai aapanee nadar karahi nisataar jeeu ||12||",
      "translation": "Serving You, peace is obtained; granting Your Mercy, You bestow salvation. ||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮਿਲਿਆ ਜਾਣੀਐ ॥",
      "transliteration": "satigur miliaa jaaneeai ||",
      "translation": "Meeting with the True Guru, one comes to know;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਿਤੁ ਮਿਲਿਐ ਨਾਮੁ ਵਖਾਣੀਐ ॥",
      "transliteration": "jit miliai naam vakhaaneeai ||",
      "translation": "by this meeting, one comes to chant the Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਤਿਗੁਰ ਬਾਝੁ ਨ ਪਾਇਓ ਸਭ ਥਕੀ ਕਰਮ ਕਮਾਇ ਜੀਉ ॥੧੩॥",
      "transliteration": "satigur baajh na paaio sabh thakee karam kamaai jeeu ||13||",
      "translation": "Without the True Guru, God is not found; all have grown weary of performing religious rituals. ||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਉ ਸਤਿਗੁਰ ਵਿਟਹੁ ਘੁਮਾਇਆ ॥",
      "transliteration": "hau satigur vitahu ghumaaiaa ||",
      "translation": "I am a sacrifice to the True Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਨਿ ਭ੍ਰਮਿ ਭੁਲਾ ਮਾਰਗਿ ਪਾਇਆ ॥",
      "transliteration": "jin bhram bhulaa maarag paaiaa ||",
      "translation": "I was wandering in doubt, and He has set me on the right path.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਜੇ ਆਪਣੀ ਆਪੇ ਲਏ ਰਲਾਇ ਜੀਉ ॥੧੪॥",
      "transliteration": "nadar kare je aapanee aape lae ralaai jeeu ||14||",
      "translation": "If the Lord casts His Glance of Grace, He unites us with Himself. ||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤੂੰ ਸਭਨਾ ਮਾਹਿ ਸਮਾਇਆ ॥",
      "transliteration": "too(n) sabhanaa maahi samaaiaa ||",
      "translation": "You, Lord, are pervading in all,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਿਨਿ ਕਰਤੈ ਆਪੁ ਲੁਕਾਇਆ ॥",
      "transliteration": "tin karatai aap lukaaiaa ||",
      "translation": "and yet, the Creator keeps Himself concealed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਪਰਗਟੁ ਹੋਇਆ ਜਾ ਕਉ ਜੋਤਿ ਧਰੀ ਕਰਤਾਰਿ ਜੀਉ ॥੧੫॥",
      "transliteration": "naanak guramukh paragat hoiaa jaa kau jot dharee karataar jeeu ||15||",
      "translation": "O Nanak, the Creator is revealed to the Gurmukh, within whom He has infused His Light. ||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਪੇ ਖਸਮਿ ਨਿਵਾਜਿਆ ॥",
      "transliteration": "aape khasam nivaajiaa ||",
      "translation": "The Master Himself bestows honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਦੇ ਸਾਜਿਆ ॥",
      "transliteration": "jeeu pi(n)d de saajiaa ||",
      "translation": "He creates and bestows body and soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਪਣੇ ਸੇਵਕ ਕੀ ਪੈਜ ਰਖੀਆ ਦੁਇ ਕਰ ਮਸਤਕਿ ਧਾਰਿ ਜੀਉ ॥੧੬॥",
      "transliteration": "aapane sevak kee paij rakheeaa dui kar masatak dhaar jeeu ||16||",
      "translation": "He Himself preserves the honor of His servants; He places both His Hands upon their foreheads. ||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭਿ ਸੰਜਮ ਰਹੇ ਸਿਆਣਪਾ ॥",
      "transliteration": "sabh sa(n)jam rahe siaanapaa ||",
      "translation": "All strict rituals are just clever contrivances.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੇਰਾ ਪ੍ਰਭੁ ਸਭੁ ਕਿਛੁ ਜਾਣਦਾ ॥",
      "transliteration": "meraa prabh sabh kichh jaanadaa ||",
      "translation": "My God knows everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪ੍ਰਗਟ ਪ੍ਰਤਾਪੁ ਵਰਤਾਇਓ ਸਭੁ ਲੋਕੁ ਕਰੈ ਜੈਕਾਰੁ ਜੀਉ ॥੧੭॥",
      "transliteration": "pragat prataap varataaio sabh lok karai jaikaar jeeu ||17||",
      "translation": "He has made His Glory manifest, and all people celebrate Him. ||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮੇਰੇ ਗੁਣ ਅਵਗਨ ਨ ਬੀਚਾਰਿਆ ॥",
      "transliteration": "mere gun avagan na beechaariaa ||",
      "translation": "He has not considered my merits and demerits;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪ੍ਰਭਿ ਅਪਣਾ ਬਿਰਦੁ ਸਮਾਰਿਆ ॥",
      "transliteration": "prabh apanaa birad samaariaa ||",
      "translation": "this is God's Own Nature.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੰਠਿ ਲਾਇ ਕੈ ਰਖਿਓਨੁ ਲਗੈ ਨ ਤਤੀ ਵਾਉ ਜੀਉ ॥੧੮॥",
      "transliteration": "ka(n)th laai kai rakhion lagai na tatee vaau jeeu ||18||",
      "translation": "Hugging me close in His Embrace, He protects me, and now, even the hot wind does not touch me. ||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮੈ ਮਨਿ ਤਨਿ ਪ੍ਰਭੂ ਧਿਆਇਆ ॥",
      "transliteration": "mai man tan prabhoo dhiaaiaa ||",
      "translation": "Within my mind and body, I meditate on God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੀਇ ਇਛਿਅੜਾ ਫਲੁ ਪਾਇਆ ॥",
      "transliteration": "jeei ichhiaRaa phal paaiaa ||",
      "translation": "I have obtained the fruits of my soul's desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0072_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਾਹ ਪਾਤਿਸਾਹ ਸਿਰਿ ਖਸਮੁ ਤੂੰ ਜਪਿ ਨਾਨਕ ਜੀਵੈ ਨਾਉ ਜੀਉ ॥੧੯॥",
      "transliteration": "saah paatisaah sir khasam too(n) jap naanak jeevai naau jeeu ||19||",
      "translation": "You are the Supreme Lord and Master, above the heads of kings. Nanak lives by chanting Your Name. ||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 72,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
