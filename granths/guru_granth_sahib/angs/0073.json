{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 73,
  "lineCount": 48,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0073_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤੁਧੁ ਆਪੇ ਆਪੁ ਉਪਾਇਆ ॥",
      "transliteration": "tudh aape aap upaaiaa ||",
      "translation": "You Yourself created the Universe;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੂਜਾ ਖੇਲੁ ਕਰਿ ਦਿਖਲਾਇਆ ॥",
      "transliteration": "doojaa khel kar dikhalaaiaa ||",
      "translation": "You created the play of duality, and staged it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਭੁ ਸਚੋ ਸਚੁ ਵਰਤਦਾ ਜਿਸੁ ਭਾਵੈ ਤਿਸੈ ਬੁਝਾਇ ਜੀਉ ॥੨੦॥",
      "transliteration": "sabh sacho sach varatadaa jis bhaavai tisai bujhaai jeeu ||20||",
      "translation": "The Truest of the True is pervading everywhere; He instructs those with whom He is pleased. ||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਪਾਇਆ ॥",
      "transliteration": "gur parasaadee paaiaa ||",
      "translation": "By Guru's Grace, I have found God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਥੈ ਮਾਇਆ ਮੋਹੁ ਚੁਕਾਇਆ ॥",
      "transliteration": "tithai maaiaa mohu chukaaiaa ||",
      "translation": "By His Grace, I have shed emotional attachment to Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿਰਪਾ ਕਰਿ ਕੈ ਆਪਣੀ ਆਪੇ ਲਏ ਸਮਾਇ ਜੀਉ ॥੨੧॥",
      "transliteration": "kirapaa kar kai aapanee aape lae samaai jeeu ||21||",
      "translation": "Showering His Mercy, He has blended me into Himself. ||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੋਪੀ ਨੈ ਗੋਆਲੀਆ ॥",
      "transliteration": "gopee nai goaaleeaa ||",
      "translation": "You are the Gopis, the milk-maids of Krishna; You are the sacred river Jamunaa; You are Krishna, the herdsman.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੁਧੁ ਆਪੇ ਗੋਇ ਉਠਾਲੀਆ ॥",
      "transliteration": "tudh aape goi uthaaleeaa ||",
      "translation": "You Yourself support the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹੁਕਮੀ ਭਾਂਡੇ ਸਾਜਿਆ ਤੂੰ ਆਪੇ ਭੰਨਿ ਸਵਾਰਿ ਜੀਉ ॥੨੨॥",
      "transliteration": "hukamee bhaa(n)de saajiaa too(n) aape bha(n)n savaar jeeu ||22||",
      "translation": "By Your Command, human beings are fashioned. You Yourself embellish them, and then again destroy them. ||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਨ ਸਤਿਗੁਰ ਸਿਉ ਚਿਤੁ ਲਾਇਆ ॥",
      "transliteration": "jin satigur siu chit laaiaa ||",
      "translation": "Those who have focused their consciousness on the True Guru",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਿਨੀ ਦੂਜਾ ਭਾਉ ਚੁਕਾਇਆ ॥",
      "transliteration": "tinee doojaa bhaau chukaaiaa ||",
      "translation": "have rid themselves of the love of duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਿਰਮਲ ਜੋਤਿ ਤਿਨ ਪ੍ਰਾਣੀਆ ਓਇ ਚਲੇ ਜਨਮੁ ਸਵਾਰਿ ਜੀਉ ॥੨੩॥",
      "transliteration": "niramal jot tin praaneeaa oi chale janam savaar jeeu ||23||",
      "translation": "The light of those mortal beings is immaculate. They depart after redeeming their lives. ||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੇਰੀਆ ਸਦਾ ਸਦਾ ਚੰਗਿਆਈਆ ॥",
      "transliteration": "tereeaa sadaa sadaa cha(n)giaaeeaa ||",
      "translation": "I praise the Greatness of Your Goodness,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੈ ਰਾਤਿ ਦਿਹੈ ਵਡਿਆਈਆਂ ॥",
      "transliteration": "mai raat dihai vadiaaeeaa(n) ||",
      "translation": "Forever and ever, night and day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਣਮੰਗਿਆ ਦਾਨੁ ਦੇਵਣਾ ਕਹੁ ਨਾਨਕ ਸਚੁ ਸਮਾਲਿ ਜੀਉ ॥੨੪॥੧॥",
      "transliteration": "anama(n)giaa daan devanaa kahu naanak sach samaal jeeu ||24||1||",
      "translation": "You bestow Your Gifts, even if we do not ask for them. Says Nanak, contemplate the True Lord. ||24||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਿਰੀਰਾਗੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "sireeraag mahalaa 5 ||",
      "translation": "Siree Raag, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪੈ ਪਾਇ ਮਨਾਈ ਸੋਇ ਜੀਉ ॥",
      "transliteration": "pai paai manaaee soi jeeu ||",
      "translation": "I fall at His Feet to please and appease Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਤਿਗੁਰ ਪੁਰਖਿ ਮਿਲਾਇਆ ਤਿਸੁ ਜੇਵਡੁ ਅਵਰੁ ਨ ਕੋਇ ਜੀਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "satigur purakh milaaiaa tis jevad avar na koi jeeu ||1|| rahaau ||",
      "translation": "The True Guru has united me with the Lord, the Primal Being. There is no other as great as He. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੋਸਾਈ ਮਿਹੰਡਾ ਇਠੜਾ ॥",
      "transliteration": "gosaaee miha(n)daa ithaRaa ||",
      "translation": "The Lord of the Universe is my Sweet Beloved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅੰਮ ਅਬੇ ਥਾਵਹੁ ਮਿਠੜਾ ॥",
      "transliteration": "a(n)m abe thaavahu mithaRaa ||",
      "translation": "He is sweeter than my mother or father.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੈਣ ਭਾਈ ਸਭਿ ਸਜਣਾ ਤੁਧੁ ਜੇਹਾ ਨਾਹੀ ਕੋਇ ਜੀਉ ॥੧॥",
      "transliteration": "bhain bhaaee sabh sajanaa tudh jehaa naahee koi jeeu ||1||",
      "translation": "Among all sisters and brothers and friends, there is no one like You. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤੇਰੈ ਹੁਕਮੇ ਸਾਵਣੁ ਆਇਆ ॥",
      "transliteration": "terai hukame saavan aaiaa ||",
      "translation": "By Your Command, the month of Saawan has come.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੈ ਸਤ ਕਾ ਹਲੁ ਜੋਆਇਆ ॥",
      "transliteration": "mai sat kaa hal joaaiaa ||",
      "translation": "I have hooked up the plow of Truth,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਉ ਬੀਜਣ ਲਗਾ ਆਸ ਕਰਿ ਹਰਿ ਬੋਹਲ ਬਖਸ ਜਮਾਇ ਜੀਉ ॥੨॥",
      "transliteration": "naau beejan lagaa aas kar har bohal bakhas jamaai jeeu ||2||",
      "translation": "and I plant the seed of the Name in hopes that the Lord, in His Generosity, will bestow a bountiful harvest. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਉ ਗੁਰ ਮਿਲਿ ਇਕੁ ਪਛਾਣਦਾ ॥",
      "transliteration": "hau gur mil ik pachhaanadaa ||",
      "translation": "Meeting with the Guru, I recognize only the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੁਯਾ ਕਾਗਲੁ ਚਿਤਿ ਨ ਜਾਣਦਾ ॥",
      "transliteration": "duyaa kaagal chit na jaanadaa ||",
      "translation": "In my consciousness, I do not know of any other account.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਰਿ ਇਕਤੈ ਕਾਰੈ ਲਾਇਓਨੁ ਜਿਉ ਭਾਵੈ ਤਿਂਵੈ ਨਿਬਾਹਿ ਜੀਉ ॥੩॥",
      "transliteration": "har ikatai kaarai laaion jiu bhaavai ti(n)vai nibaahi jeeu ||3||",
      "translation": "The Lord has assigned one task to me; as it pleases Him, I perform it. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੁਸੀ ਭੋਗਿਹੁ ਭੁੰਚਹੁ ਭਾਈਹੋ ॥",
      "transliteration": "tusee bhogihu bhu(n)chahu bhaaeeho ||",
      "translation": "Enjoy yourselves and eat, O Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰਿ ਦੀਬਾਣਿ ਕਵਾਇ ਪੈਨਾਈਓ ॥",
      "transliteration": "gur deebaan kavaai painaaeeo ||",
      "translation": "In the Guru's Court, He has blessed me with the Robe of Honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਉ ਹੋਆ ਮਾਹਰੁ ਪਿੰਡ ਦਾ ਬੰਨਿ ਆਦੇ ਪੰਜਿ ਸਰੀਕ ਜੀਉ ॥੪॥",
      "transliteration": "hau hoaa maahar pi(n)d daa ba(n)n aade pa(n)j sareek jeeu ||4||",
      "translation": "I have become the Master of my body-village; I have taken the five rivals as prisoners. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਉ ਆਇਆ ਸਾਮੑੈ ਤਿਹੰਡੀਆ ॥",
      "transliteration": "hau aaiaa saamhai tiha(n)deeaa ||",
      "translation": "I have come to Your Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪੰਜਿ ਕਿਰਸਾਣ ਮੁਜੇਰੇ ਮਿਹਡਿਆ ॥",
      "transliteration": "pa(n)j kirasaan mujere mihadiaa ||",
      "translation": "The five farm-hands have become my tenants;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੰਨੁ ਕੋਈ ਕਢਿ ਨ ਹੰਘਈ ਨਾਨਕ ਵੁਠਾ ਘੁਘਿ ਗਿਰਾਉ ਜੀਉ ॥੫॥",
      "transliteration": "ka(n)n koee kadh na ha(n)ghaee naanak vuthaa ghugh giraau jeeu ||5||",
      "translation": "none dare to raise their heads against me. O Nanak, my village is populous and prosperous. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਉ ਵਾਰੀ ਘੁੰਮਾ ਜਾਵਦਾ ॥",
      "transliteration": "hau vaaree ghu(n)maa jaavadaa ||",
      "translation": "I am a sacrifice, a sacrifice to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਕ ਸਾਹਾ ਤੁਧੁ ਧਿਆਇਦਾ ॥",
      "transliteration": "ik saahaa tudh dhiaaidaa ||",
      "translation": "I meditate on You continually.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਉਜੜੁ ਥੇਹੁ ਵਸਾਇਓ ਹਉ ਤੁਧ ਵਿਟਹੁ ਕੁਰਬਾਣੁ ਜੀਉ ॥੬॥",
      "transliteration": "ujaR thehu vasaaio hau tudh vitahu kurabaan jeeu ||6||",
      "translation": "The village was in ruins, but You have re-populated it. I am a sacrifice to You. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਰਿ ਇਠੈ ਨਿਤ ਧਿਆਇਦਾ ॥",
      "transliteration": "har ithai nit dhiaaidaa ||",
      "translation": "O Beloved Lord, I meditate on You continually;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨਿ ਚਿੰਦੀ ਸੋ ਫਲੁ ਪਾਇਦਾ ॥",
      "transliteration": "man chi(n)dee so phal paaidaa ||",
      "translation": "I obtain the fruits of my mind's desires.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਭੇ ਕਾਜ ਸਵਾਰਿਅਨੁ ਲਾਹੀਅਨੁ ਮਨ ਕੀ ਭੁਖ ਜੀਉ ॥੭॥",
      "transliteration": "sabhe kaaj savaarian laaheean man kee bhukh jeeu ||7||",
      "translation": "All my affairs are arranged, and the hunger of my mind is appeased. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮੈ ਛਡਿਆ ਸਭੋ ਧੰਧੜਾ ॥",
      "transliteration": "mai chhadiaa sabho dha(n)dhaRaa ||",
      "translation": "I have forsaken all my entanglements;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੋਸਾਈ ਸੇਵੀ ਸਚੜਾ ॥",
      "transliteration": "gosaaee sevee sachaRaa ||",
      "translation": "I serve the True Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਉ ਨਿਧਿ ਨਾਮੁ ਨਿਧਾਨੁ ਹਰਿ ਮੈ ਪਲੈ ਬਧਾ ਛਿਕਿ ਜੀਉ ॥੮॥",
      "transliteration": "nau nidh naam nidhaan har mai palai badhaa chhik jeeu ||8||",
      "translation": "I have firmly attached the Name, the Home of the Nine Treasures to my robe. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮੈ ਸੁਖੀ ਹੂੰ ਸੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "mai sukhee hoo(n) sukh paaiaa ||",
      "translation": "I have obtained the comfort of comforts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰਿ ਅੰਤਰਿ ਸਬਦੁ ਵਸਾਇਆ ॥",
      "transliteration": "gur a(n)tar sabad vasaaiaa ||",
      "translation": "The Guru has implanted the Word of the Shabad deep within me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਪੁਰਖਿ ਵਿਖਾਲਿਆ ਮਸਤਕਿ ਧਰਿ ਕੈ ਹਥੁ ਜੀਉ ॥੯॥",
      "transliteration": "satigur purakh vikhaaliaa masatak dhar kai hath jeeu ||9||",
      "translation": "The True Guru has shown me my Husband Lord; He has placed His Hand upon my forehead. ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੈ ਬਧੀ ਸਚੁ ਧਰਮ ਸਾਲ ਹੈ ॥",
      "transliteration": "mai badhee sach dharam saal hai ||",
      "translation": "I have established the Temple of Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਰਸਿਖਾ ਲਹਦਾ ਭਾਲਿ ਕੈ ॥",
      "transliteration": "gurasikhaa lahadaa bhaal kai ||",
      "translation": "I sought out the Guru's Sikhs, and brought them into it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0073_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪੈਰ ਧੋਵਾ ਪਖਾ ਫੇਰਦਾ ਤਿਸੁ ਨਿਵਿ ਨਿਵਿ ਲਗਾ ਪਾਇ ਜੀਉ ॥੧੦॥",
      "transliteration": "pair dhovaa pakhaa pheradaa tis niv niv lagaa paai jeeu ||10||",
      "translation": "I wash their feet, and wave the fan over them. Bowing low, I fall at their feet. ||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 73,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
