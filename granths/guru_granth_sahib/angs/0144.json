{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 144,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0144_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਏਕ ਤੁਈ ਏਕ ਤੁਈ ॥੨॥",
      "transliteration": "ek tuee ek tuee ||2||",
      "translation": "You alone, Lord, You alone. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਃ ੧ ॥",
      "transliteration": "mah 1 ||",
      "translation": "First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨ ਦਾਦੇ ਦਿਹੰਦ ਆਦਮੀ ॥",
      "transliteration": "na daade diha(n)d aadamee ||",
      "translation": "Neither the just, nor the generous, nor any humans at all,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨ ਸਪਤ ਜੇਰ ਜਿਮੀ ॥",
      "transliteration": "na sapat jer jimee ||",
      "translation": "Nor the seven realms beneath the earth, shall remain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਸਤਿ ਏਕ ਦਿਗਰਿ ਕੁਈ ॥",
      "transliteration": "asat ek digar kuee ||",
      "translation": "The One Lord alone exists. Who else is there?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਏਕ ਤੁਈ ਏਕ ਤੁਈ ॥੩॥",
      "transliteration": "ek tuee ek tuee ||3||",
      "translation": "You alone, Lord, You alone. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਃ ੧ ॥",
      "transliteration": "mah 1 ||",
      "translation": "First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨ ਸੂਰ ਸਸਿ ਮੰਡਲੋ ॥",
      "transliteration": "na soor sas ma(n)dalo ||",
      "translation": "Neither the sun, nor the moon, nor the planets,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨ ਸਪਤ ਦੀਪ ਨਹ ਜਲੋ ॥",
      "transliteration": "na sapat deep nah jalo ||",
      "translation": "Nor the seven continents, nor the oceans,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅੰਨ ਪਉਣ ਥਿਰੁ ਨ ਕੁਈ ॥",
      "transliteration": "a(n)n paun thir na kuee ||",
      "translation": "Nor food, nor the wind-nothing is permanent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਏਕੁ ਤੁਈ ਏਕੁ ਤੁਈ ॥੪॥",
      "transliteration": "ek tuee ek tuee ||4||",
      "translation": "You alone, Lord, You alone. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਃ ੧ ॥",
      "transliteration": "mah 1 ||",
      "translation": "First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨ ਰਿਜਕੁ ਦਸਤ ਆ ਕਸੇ ॥",
      "transliteration": "na rijak dasat aa kase ||",
      "translation": "Our sustenance is not in the hands of any person.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਮਾ ਰਾ ਏਕੁ ਆਸ ਵਸੇ ॥",
      "transliteration": "hamaa raa ek aas vase ||",
      "translation": "The hopes of all rest in the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਸਤਿ ਏਕੁ ਦਿਗਰ ਕੁਈ ॥",
      "transliteration": "asat ek digar kuee ||",
      "translation": "The One Lord alone exists-who else is there?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਏਕ ਤੁਈ ਏਕੁ ਤੁਈ ॥੫॥",
      "transliteration": "ek tuee ek tuee ||5||",
      "translation": "You alone, Lord, You alone. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਃ ੧ ॥",
      "transliteration": "mah 1 ||",
      "translation": "First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਰੰਦਏ ਨ ਗਿਰਾਹ ਜਰ ॥",
      "transliteration": "para(n)dae na giraah jar ||",
      "translation": "The birds have no money in their pockets.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦਰਖਤ ਆਬ ਆਸ ਕਰ ॥",
      "transliteration": "darakhat aab aas kar ||",
      "translation": "They place their hopes on trees and water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦਿਹੰਦ ਸੁਈ ॥",
      "transliteration": "diha(n)d suee ||",
      "translation": "He alone is the Giver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਏਕ ਤੁਈ ਏਕ ਤੁਈ ॥੬॥",
      "transliteration": "ek tuee ek tuee ||6||",
      "translation": "You alone, Lord, You alone. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਃ ੧ ॥",
      "transliteration": "mah 1 ||",
      "translation": "First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਨਕ ਲਿਲਾਰਿ ਲਿਖਿਆ ਸੋਇ ॥",
      "transliteration": "naanak lilaar likhiaa soi ||",
      "translation": "O Nanak, that destiny which is pre-ordained and written on one's forehead",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮੇਟਿ ਨ ਸਾਕੈ ਕੋਇ ॥",
      "transliteration": "met na saakai koi ||",
      "translation": "no one can erase it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਲਾ ਧਰੈ ਹਿਰੈ ਸੁਈ ॥",
      "transliteration": "kalaa dharai hirai suee ||",
      "translation": "The Lord infuses strength, and He takes it away again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਏਕੁ ਤੁਈ ਏਕੁ ਤੁਈ ॥੭॥",
      "transliteration": "ek tuee ek tuee ||7||",
      "translation": "You alone, O Lord, You alone. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਚਾ ਤੇਰਾ ਹੁਕਮੁ ਗੁਰਮੁਖਿ ਜਾਣਿਆ ॥",
      "transliteration": "sachaa teraa hukam guramukh jaaniaa ||",
      "translation": "True is the Hukam of Your Command. To the Gurmukh, it is known.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰਮਤੀ ਆਪੁ ਗਵਾਇ ਸਚੁ ਪਛਾਣਿਆ ॥",
      "transliteration": "guramatee aap gavaai sach pachhaaniaa ||",
      "translation": "Through the Guru's Teachings, selfishness and conceit are eradicated, and the Truth is realized.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਚੁ ਤੇਰਾ ਦਰਬਾਰੁ ਸਬਦੁ ਨੀਸਾਣਿਆ ॥",
      "transliteration": "sach teraa darabaar sabad neesaaniaa ||",
      "translation": "True is Your Court. It is proclaimed and revealed through the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਚਾ ਸਬਦੁ ਵੀਚਾਰਿ ਸਚਿ ਸਮਾਣਿਆ ॥",
      "transliteration": "sachaa sabad veechaar sach samaaniaa ||",
      "translation": "Meditating deeply on the True Word of the Shabad, I have merged into the Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਨਮੁਖ ਸਦਾ ਕੂੜਿਆਰ ਭਰਮਿ ਭੁਲਾਣਿਆ ॥",
      "transliteration": "manamukh sadaa kooRiaar bharam bhulaaniaa ||",
      "translation": "The self-willed manmukhs are always false; they are deluded by doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਵਿਸਟਾ ਅੰਦਰਿ ਵਾਸੁ ਸਾਦੁ ਨ ਜਾਣਿਆ ॥",
      "transliteration": "visataa a(n)dar vaas saad na jaaniaa ||",
      "translation": "They dwell in manure, and they do not know the taste of the Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਵਿਣੁ ਨਾਵੈ ਦੁਖੁ ਪਾਇ ਆਵਣ ਜਾਣਿਆ ॥",
      "transliteration": "vin naavai dukh paai aavan jaaniaa ||",
      "translation": "Without the Name, they suffer the agonies of coming and going.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕ ਪਾਰਖੁ ਆਪਿ ਜਿਨਿ ਖੋਟਾ ਖਰਾ ਪਛਾਣਿਆ ॥੧੩॥",
      "transliteration": "naanak paarakh aap jin khotaa kharaa pachhaaniaa ||13||",
      "translation": "O Nanak, the Lord Himself is the Appraiser, who distinguishes the counterfeit from the genuine. ||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਲੋਕੁ ਮਃ ੧ ॥",
      "transliteration": "salok mah 1 ||",
      "translation": "Salok, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੀਹਾ ਬਾਜਾ ਚਰਗਾ ਕੁਹੀਆ ਏਨਾ ਖਵਾਲੇ ਘਾਹ ॥",
      "transliteration": "seehaa baajaa charagaa kuheeaa enaa khavaale ghaah ||",
      "translation": "Tigers, hawks, falcons and eagles-the Lord could make them eat grass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਘਾਹੁ ਖਾਨਿ ਤਿਨਾ ਮਾਸੁ ਖਵਾਲੇ ਏਹਿ ਚਲਾਏ ਰਾਹ ॥",
      "transliteration": "ghaahu khaan tinaa maas khavaale ehi chalaae raah ||",
      "translation": "And those animals which eat grass-He could make them eat meat. He could make them follow this way of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਦੀਆ ਵਿਚਿ ਟਿਬੇ ਦੇਖਾਲੇ ਥਲੀ ਕਰੇ ਅਸਗਾਹ ॥",
      "transliteration": "nadeeaa vich tibe dekhaale thalee kare asagaah ||",
      "translation": "He could raise dry land from the rivers, and turn the deserts into bottomless oceans.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕੀੜਾ ਥਾਪਿ ਦੇਇ ਪਾਤਿਸਾਹੀ ਲਸਕਰ ਕਰੇ ਸੁਆਹ ॥",
      "transliteration": "keeRaa thaap dei paatisaahee lasakar kare suaah ||",
      "translation": "He could appoint a worm as king, and reduce an army to ashes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੇਤੇ ਜੀਅ ਜੀਵਹਿ ਲੈ ਸਾਹਾ ਜੀਵਾਲੇ ਤਾ ਕਿ ਅਸਾਹ ॥",
      "transliteration": "jete jee jeevahi lai saahaa jeevaale taa k asaah ||",
      "translation": "All beings and creatures live by breathing, but He could keep us alive, even without the breath.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਨਕ ਜਿਉ ਜਿਉ ਸਚੇ ਭਾਵੈ ਤਿਉ ਤਿਉ ਦੇਇ ਗਿਰਾਹ ॥੧॥",
      "transliteration": "naanak jiu jiu sache bhaavai tiu tiu dei giraah ||1||",
      "translation": "O Nanak, as it pleases the True Lord, He gives us sustenance. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਃ ੧ ॥",
      "transliteration": "mah 1 ||",
      "translation": "First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਕਿ ਮਾਸਹਾਰੀ ਇਕਿ ਤ੍ਰਿਣੁ ਖਾਹਿ ॥",
      "transliteration": "ik maasahaaree ik trin khaahi ||",
      "translation": "Some eat meat, while others eat grass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਕਨਾ ਛਤੀਹ ਅੰਮ੍ਰਿਤ ਪਾਹਿ ॥",
      "transliteration": "ikanaa chhateeh a(n)mrit paahi ||",
      "translation": "Some have all the thirty-six varieties of delicacies,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਇਕਿ ਮਿਟੀਆ ਮਹਿ ਮਿਟੀਆ ਖਾਹਿ ॥",
      "transliteration": "ik miteeaa mahi miteeaa khaahi ||",
      "translation": "while others live in the dirt and eat mud.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਇਕਿ ਪਉਣ ਸੁਮਾਰੀ ਪਉਣ ਸੁਮਾਰਿ ॥",
      "transliteration": "ik paun sumaaree paun sumaar ||",
      "translation": "Some control the breath, and regulate their breathing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਕਿ ਨਿਰੰਕਾਰੀ ਨਾਮ ਆਧਾਰਿ ॥",
      "transliteration": "ik nira(n)kaaree naam aadhaar ||",
      "translation": "Some live by the Support of the Naam, the Name of the Formless Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜੀਵੈ ਦਾਤਾ ਮਰੈ ਨ ਕੋਇ ॥",
      "transliteration": "jeevai daataa marai na koi ||",
      "translation": "The Great Giver lives; no one dies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਨਕ ਮੁਠੇ ਜਾਹਿ ਨਾਹੀ ਮਨਿ ਸੋਇ ॥੨॥",
      "transliteration": "naanak muthe jaahi naahee man soi ||2||",
      "translation": "O Nanak, those who do not enshrine the Lord within their minds are deluded. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਕੀ ਕਾਰ ਕਰਮਿ ਕਮਾਈਐ ॥",
      "transliteration": "poore gur kee kaar karam kamaaeeai ||",
      "translation": "By the karma of good actions, some come to serve the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰਮਤੀ ਆਪੁ ਗਵਾਇ ਨਾਮੁ ਧਿਆਈਐ ॥",
      "transliteration": "guramatee aap gavaai naam dhiaaeeai ||",
      "translation": "Through the Guru's Teachings, some eliminate selfishness and conceit, and meditate on the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਦੂਜੀ ਕਾਰੈ ਲਗਿ ਜਨਮੁ ਗਵਾਈਐ ॥",
      "transliteration": "doojee kaarai lag janam gavaaeeai ||",
      "translation": "Undertaking any other task, they waste their lives in vain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਵਿਣੁ ਨਾਵੈ ਸਭ ਵਿਸੁ ਪੈਝੈ ਖਾਈਐ ॥",
      "transliteration": "vin naavai sabh vis paijhai khaaeeai ||",
      "translation": "Without the Name, all that they wear and eat is poison.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਚਾ ਸਬਦੁ ਸਾਲਾਹਿ ਸਚਿ ਸਮਾਈਐ ॥",
      "transliteration": "sachaa sabad saalaahi sach samaaeeai ||",
      "translation": "Praising the True Word of the Shabad, they merge with the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਵਿਣੁ ਸਤਿਗੁਰੁ ਸੇਵੇ ਨਾਹੀ ਸੁਖਿ ਨਿਵਾਸੁ ਫਿਰਿ ਫਿਰਿ ਆਈਐ ॥",
      "transliteration": "vin satigur seve naahee sukh nivaas phir phir aaeeai ||",
      "translation": "Without serving the True Guru, they do not obtain the home of peace; they are consigned to reincarnation, over and over again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਦੁਨੀਆ ਖੋਟੀ ਰਾਸਿ ਕੂੜੁ ਕਮਾਈਐ ॥",
      "transliteration": "duneeaa khotee raas kooR kamaaeeai ||",
      "translation": "Investing counterfeit capital, they earn only falsehood in the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਨਾਨਕ ਸਚੁ ਖਰਾ ਸਾਲਾਹਿ ਪਤਿ ਸਿਉ ਜਾਈਐ ॥੧੪॥",
      "transliteration": "naanak sach kharaa saalaahi pat siu jaaeeai ||14||",
      "translation": "O Nanak, singing the Praises of the Pure, True Lord, they depart with honor. ||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸਲੋਕੁ ਮਃ ੧ ॥",
      "transliteration": "salok mah 1 ||",
      "translation": "Salok, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0144_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਤੁਧੁ ਭਾਵੈ ਤਾ ਵਾਵਹਿ ਗਾਵਹਿ ਤੁਧੁ ਭਾਵੈ ਜਲਿ ਨਾਵਹਿ ॥",
      "transliteration": "tudh bhaavai taa vaavahi gaavahi tudh bhaavai jal naavahi ||",
      "translation": "When it pleases You, we play music and sing; when it pleases You, we bathe in water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 144,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
