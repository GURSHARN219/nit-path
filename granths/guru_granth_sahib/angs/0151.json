{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 151,
  "lineCount": 40,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0151_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਗੁ ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੧ ਚਉਪਦੇ ਦੁਪਦੇ ॥",
      "transliteration": "raag gauRee guaareree mahalaa 1 chaupade dupade ||",
      "translation": "Raag Gauree Gwaarayree, First Mehl, Chau-Padhay & Dho-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ੴ ਸਤਿ ਨਾਮੁ ਕਰਤਾ ਪੁਰਖੁ ਨਿਰਭਉ ਨਿਰਵੈਰੁ ਅਕਾਲ ਮੂਰਤਿ ਅਜੂਨੀ ਸੈਭੰ ਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar sat naam karataa purakh nirabhau niravair akaal moorat ajoonee saibha(n) gur prasaad ||",
      "translation": "One Universal Creator God. Truth Is The Name. Creative Being Personified. No Fear. No Hatred. Image Of The Undying. Beyond Birth. Self-Existent. By Guru's Grace:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭਉ ਮੁਚੁ ਭਾਰਾ ਵਡਾ ਤੋਲੁ ॥",
      "transliteration": "bhau much bhaaraa vadaa tol ||",
      "translation": "The Fear of God is overpowering, and so very heavy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਨ ਮਤਿ ਹਉਲੀ ਬੋਲੇ ਬੋਲੁ ॥",
      "transliteration": "man mat haulee bole bol ||",
      "translation": "while the intellect is lightweight, as is the speech one speaks.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਿਰਿ ਧਰਿ ਚਲੀਐ ਸਹੀਐ ਭਾਰੁ ॥",
      "transliteration": "sir dhar chaleeai saheeai bhaar ||",
      "translation": "So place the Fear of God upon your head, and bear that weight;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਦਰੀ ਕਰਮੀ ਗੁਰ ਬੀਚਾਰੁ ॥੧॥",
      "transliteration": "nadaree karamee gur beechaar ||1||",
      "translation": "by the Grace of the Merciful Lord, contemplate the Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭੈ ਬਿਨੁ ਕੋਇ ਨ ਲੰਘਸਿ ਪਾਰਿ ॥",
      "transliteration": "bhai bin koi na la(n)ghas paar ||",
      "translation": "Without the Fear of God, no one crosses over the world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੈ ਭਉ ਰਾਖਿਆ ਭਾਇ ਸਵਾਰਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bhai bhau raakhiaa bhaai savaar ||1|| rahaau ||",
      "translation": "This Fear of God adorns the Love of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭੈ ਤਨਿ ਅਗਨਿ ਭਖੈ ਭੈ ਨਾਲਿ ॥",
      "transliteration": "bhai tan agan bhakhai bhai naal ||",
      "translation": "The fire of fear within the body is burnt away by the Fear of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭੈ ਭਉ ਘੜੀਐ ਸਬਦਿ ਸਵਾਰਿ ॥",
      "transliteration": "bhai bhau ghaReeai sabad savaar ||",
      "translation": "Through this Fear of God, we are adorned with the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭੈ ਬਿਨੁ ਘਾੜਤ ਕਚੁ ਨਿਕਚ ॥",
      "transliteration": "bhai bin ghaaRat kach nikach ||",
      "translation": "Without the Fear of God, all that is fashioned is false.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅੰਧਾ ਸਚਾ ਅੰਧੀ ਸਟ ॥੨॥",
      "transliteration": "a(n)dhaa sachaa a(n)dhee sat ||2||",
      "translation": "Useless is the mold, and useless are the hammer-strokes on the mold. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬੁਧੀ ਬਾਜੀ ਉਪਜੈ ਚਾਉ ॥",
      "transliteration": "budhee baajee upajai chaau ||",
      "translation": "The desire for the worldly drama arises in the intellect,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਹਸ ਸਿਆਣਪ ਪਵੈ ਨ ਤਾਉ ॥",
      "transliteration": "sahas siaanap pavai na taau ||",
      "translation": "but even with thousands of clever mental tricks, the heat of the Fear of God does not come into play.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਮਨਮੁਖਿ ਬੋਲਣੁ ਵਾਉ ॥",
      "transliteration": "naanak manamukh bolan vaau ||",
      "translation": "O Nanak, the speech of the self-willed manmukh is just wind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅੰਧਾ ਅਖਰੁ ਵਾਉ ਦੁਆਉ ॥੩॥੧॥",
      "transliteration": "a(n)dhaa akhar vaau duaau ||3||1||",
      "translation": "His words are worthless and empty, like the wind. ||3||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਡਰਿ ਘਰੁ ਘਰਿ ਡਰੁ ਡਰਿ ਡਰੁ ਜਾਇ ॥",
      "transliteration": "dar ghar ghar dar dar dar jaai ||",
      "translation": "Place the Fear of God within the home of your heart; with this Fear of God in your heart, all other fears shall be frightened away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋ ਡਰੁ ਕੇਹਾ ਜਿਤੁ ਡਰਿ ਡਰੁ ਪਾਇ ॥",
      "transliteration": "so dar kehaa jit dar dar paai ||",
      "translation": "What sort of fear is that, which frightens other fears?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤੁਧੁ ਬਿਨੁ ਦੂਜੀ ਨਾਹੀ ਜਾਇ ॥",
      "transliteration": "tudh bin doojee naahee jaai ||",
      "translation": "Without You, I have other place of rest at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਵਰਤੈ ਸਭ ਤੇਰੀ ਰਜਾਇ ॥੧॥",
      "transliteration": "jo kichh varatai sabh teree rajaai ||1||",
      "translation": "Whatever happens is all according to Your Will. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਡਰੀਐ ਜੇ ਡਰੁ ਹੋਵੈ ਹੋਰੁ ॥",
      "transliteration": "dareeai je dar hovai hor ||",
      "translation": "Be afraid, if you have any fear, other than the Fear of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਡਰਿ ਡਰਿ ਡਰਣਾ ਮਨ ਕਾ ਸੋਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dar dar daranaa man kaa sor ||1|| rahaau ||",
      "translation": "Afraid of fear, and living in fear, the mind is held in tumult. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾ ਜੀਉ ਮਰੈ ਨ ਡੂਬੈ ਤਰੈ ॥",
      "transliteration": "naa jeeu marai na doobai tarai ||",
      "translation": "The soul does not die; it does not drown, and it does not swim across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਿਨਿ ਕਿਛੁ ਕੀਆ ਸੋ ਕਿਛੁ ਕਰੈ ॥",
      "transliteration": "jin kichh keeaa so kichh karai ||",
      "translation": "The One who created everything does everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹੁਕਮੇ ਆਵੈ ਹੁਕਮੇ ਜਾਇ ॥",
      "transliteration": "hukame aavai hukame jaai ||",
      "translation": "By the Hukam of His Command we come, and by the Hukam of His Command we go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਆਗੈ ਪਾਛੈ ਹੁਕਮਿ ਸਮਾਇ ॥੨॥",
      "transliteration": "aagai paachhai hukam samaai ||2||",
      "translation": "Before and after, His Command is pervading. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹੰਸੁ ਹੇਤੁ ਆਸਾ ਅਸਮਾਨੁ ॥",
      "transliteration": "ha(n)s het aasaa asamaan ||",
      "translation": "Cruelty, attachment, desire and egotism",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਸੁ ਵਿਚਿ ਭੂਖ ਬਹੁਤੁ ਨੈ ਸਾਨੁ ॥",
      "transliteration": "tis vich bhookh bahut nai saan ||",
      "translation": "there is great hunger in these, like the raging torrent of a wild stream.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਉ ਖਾਣਾ ਪੀਣਾ ਆਧਾਰੁ ॥",
      "transliteration": "bhau khaanaa peenaa aadhaar ||",
      "translation": "Let the Fear of God be your food, drink and support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਵਿਣੁ ਖਾਧੇ ਮਰਿ ਹੋਹਿ ਗਵਾਰ ॥੩॥",
      "transliteration": "vin khaadhe mar hohi gavaar ||3||",
      "translation": "Without doing this, the fools simply die. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਸ ਕਾ ਕੋਇ ਕੋਈ ਕੋਇ ਕੋਇ ॥",
      "transliteration": "jis kaa koi koee koi koi ||",
      "translation": "If anyone really has anyone else - how rare is that person!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਭੁ ਕੋ ਤੇਰਾ ਤੂੰ ਸਭਨਾ ਕਾ ਸੋਇ ॥",
      "transliteration": "sabh ko teraa too(n) sabhanaa kaa soi ||",
      "translation": "All are Yours - You are the Lord of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾ ਕੇ ਜੀਅ ਜੰਤ ਧਨੁ ਮਾਲੁ ॥",
      "transliteration": "jaa ke jee ja(n)t dhan maal ||",
      "translation": "All beings and creatures, wealth and property belong to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕ ਆਖਣੁ ਬਿਖਮੁ ਬੀਚਾਰੁ ॥੪॥੨॥",
      "transliteration": "naanak aakhan bikham beechaar ||4||2||",
      "translation": "O Nanak, it is so difficult to describe and contemplate Him. ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਾਤਾ ਮਤਿ ਪਿਤਾ ਸੰਤੋਖੁ ॥",
      "transliteration": "maataa mat pitaa sa(n)tokh ||",
      "translation": "Let wisdom be your mother, and contentment your father.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਤੁ ਭਾਈ ਕਰਿ ਏਹੁ ਵਿਸੇਖੁ ॥੧॥",
      "transliteration": "sat bhaaee kar ehu visekh ||1||",
      "translation": "Let Truth be your brother - these are your best relatives. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਹਣਾ ਹੈ ਕਿਛੁ ਕਹਣੁ ਨ ਜਾਇ ॥",
      "transliteration": "kahanaa hai kichh kahan na jaai ||",
      "translation": "He has been described, but He cannot be described at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0151_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਉ ਕੁਦਰਤਿ ਕੀਮਤਿ ਨਹੀ ਪਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tau kudarat keemat nahee paai ||1|| rahaau ||",
      "translation": "Your All-pervading creative nature cannot be estimated. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 151,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
