{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 152,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0152_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਰਮ ਸੁਰਤਿ ਦੁਇ ਸਸੁਰ ਭਏ ॥",
      "transliteration": "saram surat dui sasur bhae ||",
      "translation": "Modesty, humility and intuitive understanding are my mother-in-law and father-in-law;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਰਣੀ ਕਾਮਣਿ ਕਰਿ ਮਨ ਲਏ ॥੨॥",
      "transliteration": "karanee kaaman kar man lae ||2||",
      "translation": "I have made good deeds my spouse. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਾਹਾ ਸੰਜੋਗੁ ਵੀਆਹੁ ਵਿਜੋਗੁ ॥",
      "transliteration": "saahaa sa(n)jog veeaahu vijog ||",
      "translation": "Union with the Holy is my wedding date, and separation from the world is my marriage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਚੁ ਸੰਤਤਿ ਕਹੁ ਨਾਨਕ ਜੋਗੁ ॥੩॥੩॥",
      "transliteration": "sach sa(n)tat kahu naanak jog ||3||3||",
      "translation": "Says Nanak, Truth is the child born of this Union. ||3||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਉਣੈ ਪਾਣੀ ਅਗਨੀ ਕਾ ਮੇਲੁ ॥",
      "transliteration": "paunai paanee aganee kaa mel ||",
      "translation": "The union of air, water and fire",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੰਚਲ ਚਪਲ ਬੁਧਿ ਕਾ ਖੇਲੁ ॥",
      "transliteration": "cha(n)chal chapal budh kaa khel ||",
      "translation": "the body is the play-thing of the fickle and unsteady intellect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਉ ਦਰਵਾਜੇ ਦਸਵਾ ਦੁਆਰੁ ॥",
      "transliteration": "nau daravaaje dasavaa duaar ||",
      "translation": "It has nine doors, and then there is the Tenth Gate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬੁਝੁ ਰੇ ਗਿਆਨੀ ਏਹੁ ਬੀਚਾਰੁ ॥੧॥",
      "transliteration": "bujh re giaanee ehu beechaar ||1||",
      "translation": "Reflect upon this and understand it, O wise one. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਥਤਾ ਬਕਤਾ ਸੁਨਤਾ ਸੋਈ ॥",
      "transliteration": "kathataa bakataa sunataa soee ||",
      "translation": "The Lord is the One who speaks, teaches and listens.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਪੁ ਬੀਚਾਰੇ ਸੁ ਗਿਆਨੀ ਹੋਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aap beechaare s giaanee hoee ||1|| rahaau ||",
      "translation": "One who contemplates his own self is truly wise. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੇਹੀ ਮਾਟੀ ਬੋਲੈ ਪਉਣੁ ॥",
      "transliteration": "dehee maatee bolai paun ||",
      "translation": "The body is dust; the wind speaks through it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬੁਝੁ ਰੇ ਗਿਆਨੀ ਮੂਆ ਹੈ ਕਉਣੁ ॥",
      "transliteration": "bujh re giaanee mooaa hai kaun ||",
      "translation": "Understand, O wise one, who has died.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੂਈ ਸੁਰਤਿ ਬਾਦੁ ਅਹੰਕਾਰੁ ॥",
      "transliteration": "mooee surat baad aha(n)kaar ||",
      "translation": "Awareness, conflict and ego have died,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਓਹੁ ਨ ਮੂਆ ਜੋ ਦੇਖਣਹਾਰੁ ॥੨॥",
      "transliteration": "ohu na mooaa jo dekhanahaar ||2||",
      "translation": "but the One who sees does not die. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੈ ਕਾਰਣਿ ਤਟਿ ਤੀਰਥ ਜਾਹੀ ॥",
      "transliteration": "jai kaaran tat teerath jaahee ||",
      "translation": "For the sake of it, you journey to sacred shrines and holy rivers;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਤਨ ਪਦਾਰਥ ਘਟ ਹੀ ਮਾਹੀ ॥",
      "transliteration": "ratan padaarath ghat hee maahee ||",
      "translation": "but this priceless jewel is within your own heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪੜਿ ਪੜਿ ਪੰਡਿਤੁ ਬਾਦੁ ਵਖਾਣੈ ॥",
      "transliteration": "paR paR pa(n)dit baad vakhaanai ||",
      "translation": "The Pandits, the religious scholars, read and read endlessly; they stir up arguments and controversies,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭੀਤਰਿ ਹੋਦੀ ਵਸਤੁ ਨ ਜਾਣੈ ॥੩॥",
      "transliteration": "bheetar hodee vasat na jaanai ||3||",
      "translation": "but they do not know the secret deep within. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਉ ਨ ਮੂਆ ਮੇਰੀ ਮੁਈ ਬਲਾਇ ॥",
      "transliteration": "hau na mooaa meree muee balaai ||",
      "translation": "I have not died - that evil nature within me has died.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਓਹੁ ਨ ਮੂਆ ਜੋ ਰਹਿਆ ਸਮਾਇ ॥",
      "transliteration": "ohu na mooaa jo rahiaa samaai ||",
      "translation": "The One who is pervading everywhere does not die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰਿ ਬ੍ਰਹਮੁ ਦਿਖਾਇਆ ॥",
      "transliteration": "kahu naanak gur braham dikhaaiaa ||",
      "translation": "Says Nanak, the Guru has revealed God to me,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਰਤਾ ਜਾਤਾ ਨਦਰਿ ਨ ਆਇਆ ॥੪॥੪॥",
      "transliteration": "marataa jaataa nadar na aaiaa ||4||4||",
      "translation": "and now I see that there is no such thing as birth or death. ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ਦਖਣੀ ॥",
      "transliteration": "gauRee mahalaa 1 dakhanee ||",
      "translation": "Gauree, First Mehl, Dakhanee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁਣਿ ਸੁਣਿ ਬੂਝੈ ਮਾਨੈ ਨਾਉ ॥",
      "transliteration": "sun sun boojhai maanai naau ||",
      "translation": "I am forever a sacrifice to the one who listens and hears,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਾ ਕੈ ਸਦ ਬਲਿਹਾਰੈ ਜਾਉ ॥",
      "transliteration": "taa kai sad balihaarai jaau ||",
      "translation": "Who understands and believes in the Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਆਪਿ ਭੁਲਾਏ ਠਉਰ ਨ ਠਾਉ ॥",
      "transliteration": "aap bhulaae thaur na thaau ||",
      "translation": "When the Lord Himself leads us astray, there is no other place of rest for us to find.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੂੰ ਸਮਝਾਵਹਿ ਮੇਲਿ ਮਿਲਾਉ ॥੧॥",
      "transliteration": "too(n) samajhaavahi mel milaau ||1||",
      "translation": "You impart understanding, and You unite us in Your Union. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਮੁ ਮਿਲੈ ਚਲੈ ਮੈ ਨਾਲਿ ॥",
      "transliteration": "naam milai chalai mai naal ||",
      "translation": "I obtain the Naam, which shall go along with me in the end.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਬਾਧੀ ਸਭ ਕਾਲਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin naavai baadhee sabh kaal ||1|| rahaau ||",
      "translation": "Without the Name, all are held in the grip of Death. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਖੇਤੀ ਵਣਜੁ ਨਾਵੈ ਕੀ ਓਟ ॥",
      "transliteration": "khetee vanaj naavai kee ot ||",
      "translation": "My farming and my trading are by the Support of the Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪਾਪੁ ਪੁੰਨੁ ਬੀਜ ਕੀ ਪੋਟ ॥",
      "transliteration": "paap pu(n)n beej kee pot ||",
      "translation": "The seeds of sin and virtue are bound together.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਜੀਅ ਮਹਿ ਚੋਟ ॥",
      "transliteration": "kaam krodh jee mahi chot ||",
      "translation": "Sexual desire and anger are the wounds of the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਮੁ ਵਿਸਾਰਿ ਚਲੇ ਮਨਿ ਖੋਟ ॥੨॥",
      "transliteration": "naam visaar chale man khot ||2||",
      "translation": "The evil-minded ones forget the Naam, and then depart. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਾਚੇ ਗੁਰ ਕੀ ਸਾਚੀ ਸੀਖ ॥",
      "transliteration": "saache gur kee saachee seekh ||",
      "translation": "True are the Teachings of the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਸੀਤਲੁ ਸਾਚੁ ਪਰੀਖ ॥",
      "transliteration": "tan man seetal saach pareekh ||",
      "translation": "The body and mind are cooled and soothed, by the touchstone of Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਲ ਪੁਰਾਇਨਿ ਰਸ ਕਮਲ ਪਰੀਖ ॥",
      "transliteration": "jal puraain ras kamal pareekh ||",
      "translation": "This is the true mark of wisdom: that one remains detached, like the water-lily, or the lotus upon the water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਬਦਿ ਰਤੇ ਮੀਠੇ ਰਸ ਈਖ ॥੩॥",
      "transliteration": "sabad rate meethe ras eekh ||3||",
      "translation": "Attuned to the Word of the Shabad, one becomes sweet, like the juice of the sugar cane. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹੁਕਮਿ ਸੰਜੋਗੀ ਗੜਿ ਦਸ ਦੁਆਰ ॥",
      "transliteration": "hukam sa(n)jogee gaR das duaar ||",
      "translation": "By the Hukam of the Lord's Command, the castle of the body has ten gates.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪੰਚ ਵਸਹਿ ਮਿਲਿ ਜੋਤਿ ਅਪਾਰ ॥",
      "transliteration": "pa(n)ch vasahi mil jot apaar ||",
      "translation": "The five passions dwell there, together with the Divine Light of the Infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਪਿ ਤੁਲੈ ਆਪੇ ਵਣਜਾਰ ॥",
      "transliteration": "aap tulai aape vanajaar ||",
      "translation": "The Lord Himself is the merchandise, and He Himself is the trader.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਸਵਾਰਣਹਾਰ ॥੪॥੫॥",
      "transliteration": "naanak naam savaaranahaar ||4||5||",
      "translation": "O Nanak, through the Naam, the Name of the Lord, we are adorned and rejuvenated. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਾਤੋ ਜਾਇ ਕਹਾ ਤੇ ਆਵੈ ॥",
      "transliteration": "jaato jaai kahaa te aavai ||",
      "translation": "How can we know where we came from?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਹ ਉਪਜੈ ਕਹ ਜਾਇ ਸਮਾਵੈ ॥",
      "transliteration": "kah upajai kah jaai samaavai ||",
      "translation": "Where did we originate, and where will we go and merge?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਿਉ ਬਾਧਿਓ ਕਿਉ ਮੁਕਤੀ ਪਾਵੈ ॥",
      "transliteration": "kiu baadhio kiu mukatee paavai ||",
      "translation": "How are we bound, and how do we obtain liberation?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਿਉ ਅਬਿਨਾਸੀ ਸਹਜਿ ਸਮਾਵੈ ॥੧॥",
      "transliteration": "kiu abinaasee sahaj samaavai ||1||",
      "translation": "How do we merge with intuitive ease into the Eternal, Imperishable Lord? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਮੁ ਰਿਦੈ ਅੰਮ੍ਰਿਤੁ ਮੁਖਿ ਨਾਮੁ ॥",
      "transliteration": "naam ridai a(n)mrit mukh naam ||",
      "translation": "With the Naam in the heart and the Ambrosial Naam on our lips,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਰਹਰ ਨਾਮੁ ਨਰਹਰ ਨਿਹਕਾਮੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "narahar naam narahar nihakaam ||1|| rahaau ||",
      "translation": "through the Name of the Lord, we rise above desire, like the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਹਜੇ ਆਵੈ ਸਹਜੇ ਜਾਇ ॥",
      "transliteration": "sahaje aavai sahaje jaai ||",
      "translation": "With intuitive ease we come, and with intuitive ease we depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮਨ ਤੇ ਉਪਜੈ ਮਨ ਮਾਹਿ ਸਮਾਇ ॥",
      "transliteration": "man te upajai man maahi samaai ||",
      "translation": "From the mind we originate, and into the mind we are absorbed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਮੁਕਤੋ ਬੰਧੁ ਨ ਪਾਇ ॥",
      "transliteration": "guramukh mukato ba(n)dh na paai ||",
      "translation": "As Gurmukh, we are liberated, and are not bound.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਬਦੁ ਬੀਚਾਰਿ ਛੁਟੈ ਹਰਿ ਨਾਇ ॥੨॥",
      "transliteration": "sabad beechaar chhutai har naai ||2||",
      "translation": "Contemplating the Word of the Shabad, we are emancipated through the Name of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਰਵਰ ਪੰਖੀ ਬਹੁ ਨਿਸਿ ਬਾਸੁ ॥",
      "transliteration": "taravar pa(n)khee bahu nis baas ||",
      "translation": "At night, lots of birds settle on the tree.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸੁਖ ਦੁਖੀਆ ਮਨਿ ਮੋਹ ਵਿਣਾਸੁ ॥",
      "transliteration": "sukh dukheeaa man moh vinaas ||",
      "translation": "Some are happy, and some are sad. Caught in the desires of the mind, they perish.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਾਝ ਬਿਹਾਗ ਤਕਹਿ ਆਗਾਸੁ ॥",
      "transliteration": "saajh bihaag takahi aagaas ||",
      "translation": "And when the life-night comes to its end, then they look to the sky.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0152_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਦਹ ਦਿਸਿ ਧਾਵਹਿ ਕਰਮਿ ਲਿਖਿਆਸੁ ॥੩॥",
      "transliteration": "dah dis dhaavahi karam likhiaas ||3||",
      "translation": "They fly away in all ten directions, according to their pre-ordained destiny. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 152,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
