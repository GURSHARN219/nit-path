{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 153,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0153_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਮ ਸੰਜੋਗੀ ਗੋਇਲਿ ਥਾਟੁ ॥",
      "transliteration": "naam sa(n)jogee goil thaat ||",
      "translation": "Those who are committed to the Naam, see the world as merely a temporary pasture.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਫੂਟੈ ਬਿਖੁ ਮਾਟੁ ॥",
      "transliteration": "kaam krodh phootai bikh maat ||",
      "translation": "Sexual desire and anger are broken, like a jar of poison.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਨੁ ਵਖਰ ਸੂਨੋ ਘਰੁ ਹਾਟੁ ॥",
      "transliteration": "bin vakhar soono ghar haat ||",
      "translation": "Without the merchandise of the Name, the house of the body and the store of the mind are empty.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰ ਮਿਲਿ ਖੋਲੇ ਬਜਰ ਕਪਾਟ ॥੪॥",
      "transliteration": "gur mil khole bajar kapaat ||4||",
      "translation": "Meeting the Guru, the hard and heavy doors are opened. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਧੁ ਮਿਲੈ ਪੂਰਬ ਸੰਜੋਗ ॥",
      "transliteration": "saadh milai poorab sa(n)jog ||",
      "translation": "One meets the Holy Saint only through perfect destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਚਿ ਰਹਸੇ ਪੂਰੇ ਹਰਿ ਲੋਗ ॥",
      "transliteration": "sach rahase poore har log ||",
      "translation": "The Lord's perfect people rejoice in the Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਦੇ ਲੈ ਸਹਜਿ ਸੁਭਾਇ ॥",
      "transliteration": "man tan de lai sahaj subhaai ||",
      "translation": "Surrendering their minds and bodies, they find the Lord with intuitive ease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਨਕ ਤਿਨ ਕੈ ਲਾਗਉ ਪਾਇ ॥੫॥੬॥",
      "transliteration": "naanak tin kai laagau paai ||5||6||",
      "translation": "Nanak falls at their feet. ||5||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਮਾਇਆ ਮਹਿ ਚੀਤੁ ॥",
      "transliteration": "kaam krodh maaiaa mahi cheet ||",
      "translation": "The conscious mind is engrossed in sexual desire, anger and Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਝੂਠ ਵਿਕਾਰਿ ਜਾਗੈ ਹਿਤ ਚੀਤੁ ॥",
      "transliteration": "jhooth vikaar jaagai hit cheet ||",
      "translation": "The conscious mind is awake only to falsehood, corruption and attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪੂੰਜੀ ਪਾਪ ਲੋਭ ਕੀ ਕੀਤੁ ॥",
      "transliteration": "poo(n)jee paap lobh kee keet ||",
      "translation": "It gathers in the assets of sin and greed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਰੁ ਤਾਰੀ ਮਨਿ ਨਾਮੁ ਸੁਚੀਤੁ ॥੧॥",
      "transliteration": "tar taaree man naam sucheet ||1||",
      "translation": "So swim across the river of life, O my mind, with the Sacred Naam, the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਵਾਹੁ ਵਾਹੁ ਸਾਚੇ ਮੈ ਤੇਰੀ ਟੇਕ ॥",
      "transliteration": "vaahu vaahu saache mai teree tek ||",
      "translation": "Waaho! Waaho! - Great! Great is my True Lord! I seek Your All-powerful Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹਉ ਪਾਪੀ ਤੂੰ ਨਿਰਮਲੁ ਏਕ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "hau paapee too(n) niramal ek ||1|| rahaau ||",
      "translation": "I am a sinner - You alone are pure. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਗਨਿ ਪਾਣੀ ਬੋਲੈ ਭੜਵਾਉ ॥",
      "transliteration": "agan paanee bolai bhaRavaau ||",
      "translation": "Fire and water join together, and the breath roars in its fury!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਹਵਾ ਇੰਦ੍ਰੀ ਏਕੁ ਸੁਆਉ ॥",
      "transliteration": "jihavaa i(n)dree ek suaau ||",
      "translation": "The tongue and the sex organs each seek to taste.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦਿਸਟਿ ਵਿਕਾਰੀ ਨਾਹੀ ਭਉ ਭਾਉ ॥",
      "transliteration": "disat vikaaree naahee bhau bhaau ||",
      "translation": "The eyes which look upon corruption do not know the Love and the Fear of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਪੁ ਮਾਰੇ ਤਾ ਪਾਏ ਨਾਉ ॥੨॥",
      "transliteration": "aap maare taa paae naau ||2||",
      "translation": "Conquering self-conceit, one obtains the Name. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਬਦਿ ਮਰੈ ਫਿਰਿ ਮਰਣੁ ਨ ਹੋਇ ॥",
      "transliteration": "sabad marai phir maran na hoi ||",
      "translation": "One who dies in the Word of the Shabad, shall never again have to die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਨੁ ਮੂਏ ਕਿਉ ਪੂਰਾ ਹੋਇ ॥",
      "transliteration": "bin mooe kiu pooraa hoi ||",
      "translation": "Without such a death, how can one attain perfection?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਰਪੰਚਿ ਵਿਆਪਿ ਰਹਿਆ ਮਨੁ ਦੋਇ ॥",
      "transliteration": "parapa(n)ch viaap rahiaa man doi ||",
      "translation": "The mind is engrossed in deception, treachery and duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਥਿਰੁ ਨਾਰਾਇਣੁ ਕਰੇ ਸੁ ਹੋਇ ॥੩॥",
      "transliteration": "thir naaraain kare s hoi ||3||",
      "translation": "Whatever the Immortal Lord does, comes to pass. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬੋਹਿਥਿ ਚੜਉ ਜਾ ਆਵੈ ਵਾਰੁ ॥",
      "transliteration": "bohith chaRau jaa aavai vaar ||",
      "translation": "So get aboard that boat when your turn comes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਠਾਕੇ ਬੋਹਿਥ ਦਰਗਹ ਮਾਰ ॥",
      "transliteration": "thaake bohith daragah maar ||",
      "translation": "Those who fail to embark upon that boat shall be beaten in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਚੁ ਸਾਲਾਹੀ ਧੰਨੁ ਗੁਰਦੁਆਰੁ ॥",
      "transliteration": "sach saalaahee dha(n)n guraduaar ||",
      "translation": "Blessed is that Gurdwara, the Guru's Gate, where the Praises of the True Lord are sung.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਨਕ ਦਰਿ ਘਰਿ ਏਕੰਕਾਰੁ ॥੪॥੭॥",
      "transliteration": "naanak dar ghar eka(n)kaar ||4||7||",
      "translation": "O Nanak, the One Creator Lord is pervading hearth and home. ||4||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਉਲਟਿਓ ਕਮਲੁ ਬ੍ਰਹਮੁ ਬੀਚਾਰਿ ॥",
      "transliteration": "ulatio kamal braham beechaar ||",
      "translation": "The inverted heart-lotus has been turned upright, through reflective meditation on God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਧਾਰ ਗਗਨਿ ਦਸ ਦੁਆਰਿ ॥",
      "transliteration": "a(n)mrit dhaar gagan das duaar ||",
      "translation": "From the Sky of the Tenth Gate, the Ambrosial Nectar trickles down.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤ੍ਰਿਭਵਣੁ ਬੇਧਿਆ ਆਪਿ ਮੁਰਾਰਿ ॥੧॥",
      "transliteration": "tribhavan bedhiaa aap muraar ||1||",
      "translation": "The Lord Himself is pervading the three worlds. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰੇ ਮਨ ਮੇਰੇ ਭਰਮੁ ਨ ਕੀਜੈ ॥",
      "transliteration": "re man mere bharam na keejai ||",
      "translation": "O my mind, do not give in to doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਨਿ ਮਾਨਿਐ ਅੰਮ੍ਰਿਤ ਰਸੁ ਪੀਜੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "man maaniai a(n)mrit ras peejai ||1|| rahaau ||",
      "translation": "When the mind surrenders to the Name, it drinks in the essence of Ambrosial Nectar. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਨਮੁ ਜੀਤਿ ਮਰਣਿ ਮਨੁ ਮਾਨਿਆ ॥",
      "transliteration": "janam jeet maran man maaniaa ||",
      "translation": "So win the game of life; let your mind surrender and accept death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਪਿ ਮੂਆ ਮਨੁ ਮਨ ਤੇ ਜਾਨਿਆ ॥",
      "transliteration": "aap mooaa man man te jaaniaa ||",
      "translation": "When the self dies, the individual mind comes to know the Supreme Mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਜਰਿ ਭਈ ਘਰੁ ਘਰ ਤੇ ਜਾਨਿਆ ॥੨॥",
      "transliteration": "najar bhaee ghar ghar te jaaniaa ||2||",
      "translation": "As the inner vision is awakened, one comes to know one's own home, deep within the self. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਤੁ ਸਤੁ ਤੀਰਥੁ ਮਜਨੁ ਨਾਮਿ ॥",
      "transliteration": "jat sat teerath majan naam ||",
      "translation": "The Naam, the Name of the Lord, is austerity, chastity and cleansing baths at sacred shrines of pilgrimage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਧਿਕ ਬਿਥਾਰੁ ਕਰਉ ਕਿਸੁ ਕਾਮਿ ॥",
      "transliteration": "adhik bithaar karau kis kaam ||",
      "translation": "What good are ostentatious displays?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਰ ਨਾਰਾਇਣ ਅੰਤਰਜਾਮਿ ॥੩॥",
      "transliteration": "nar naaraain a(n)tarajaam ||3||",
      "translation": "The All-pervading Lord is the Inner-knower, the Searcher of hearts. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਨ ਮਨਉ ਤਉ ਪਰ ਘਰ ਜਾਉ ॥",
      "transliteration": "aan manau tau par ghar jaau ||",
      "translation": "If I had faith in someone else, then I would go to that one's house.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਿਸੁ ਜਾਚਉ ਨਾਹੀ ਕੋ ਥਾਉ ॥",
      "transliteration": "kis jaachau naahee ko thaau ||",
      "translation": "But where should I go, to beg? There is no other place for me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮਤਿ ਸਹਜਿ ਸਮਾਉ ॥੪॥੮॥",
      "transliteration": "naanak guramat sahaj samaau ||4||8||",
      "translation": "O Nanak, through the Guru's Teachings, I am intuitively absorbed in the Lord. ||4||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮਿਲੈ ਸੁ ਮਰਣੁ ਦਿਖਾਏ ॥",
      "transliteration": "satigur milai s maran dikhaae ||",
      "translation": "Meeting the True Guru, we are shown the way to die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਰਣ ਰਹਣ ਰਸੁ ਅੰਤਰਿ ਭਾਏ ॥",
      "transliteration": "maran rahan ras a(n)tar bhaae ||",
      "translation": "Remaining alive in this death brings joy deep within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗਰਬੁ ਨਿਵਾਰਿ ਗਗਨ ਪੁਰੁ ਪਾਏ ॥੧॥",
      "transliteration": "garab nivaar gagan pur paae ||1||",
      "translation": "Overcoming egotistical pride, the Tenth Gate is found. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਰਣੁ ਲਿਖਾਇ ਆਏ ਨਹੀ ਰਹਣਾ ॥",
      "transliteration": "maran likhaai aae nahee rahanaa ||",
      "translation": "Death is pre-ordained - no one who comes can remain here.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹਰਿ ਜਪਿ ਜਾਪਿ ਰਹਣੁ ਹਰਿ ਸਰਣਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har jap jaap rahan har saranaa ||1|| rahaau ||",
      "translation": "So chant and meditate on the Lord, and remain in the Sanctuary of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮਿਲੈ ਤ ਦੁਬਿਧਾ ਭਾਗੈ ॥",
      "transliteration": "satigur milai ta dubidhaa bhaagai ||",
      "translation": "Meeting the True Guru, duality is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਮਲੁ ਬਿਗਾਸਿ ਮਨੁ ਹਰਿ ਪ੍ਰਭ ਲਾਗੈ ॥",
      "transliteration": "kamal bigaas man har prabh laagai ||",
      "translation": "The heart-lotus blossoms forth, and the mind is attached to the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜੀਵਤੁ ਮਰੈ ਮਹਾ ਰਸੁ ਆਗੈ ॥੨॥",
      "transliteration": "jeevat marai mahaa ras aagai ||2||",
      "translation": "One who remains dead while yet alive obtains the greatest happiness hereafter. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਮਿਲਿਐ ਸਚ ਸੰਜਮਿ ਸੂਚਾ ॥",
      "transliteration": "satigur miliai sach sa(n)jam soochaa ||",
      "translation": "Meeting the True Guru, one becomes truthful, chaste and pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰ ਕੀ ਪਉੜੀ ਊਚੋ ਊਚਾ ॥",
      "transliteration": "gur kee pauRee oocho oochaa ||",
      "translation": "Climbing up the steps of the Guru's Path, one becomes the highest of the high.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਰਮਿ ਮਿਲੈ ਜਮ ਕਾ ਭਉ ਮੂਚਾ ॥੩॥",
      "transliteration": "karam milai jam kaa bhau moochaa ||3||",
      "translation": "When the Lord grants His Mercy, the fear of death is conquered. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਗੁਰਿ ਮਿਲਿਐ ਮਿਲਿ ਅੰਕਿ ਸਮਾਇਆ ॥",
      "transliteration": "gur miliai mil a(n)k samaaiaa ||",
      "translation": "Uniting in Guru's Union, we are absorbed in His Loving Embrace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਘਰੁ ਮਹਲੁ ਦਿਖਾਇਆ ॥",
      "transliteration": "kar kirapaa ghar mahal dikhaaiaa ||",
      "translation": "Granting His Grace, He reveals the Mansion of His Presence, within the home of the self.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0153_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਨਾਨਕ ਹਉਮੈ ਮਾਰਿ ਮਿਲਾਇਆ ॥੪॥੯॥",
      "transliteration": "naanak haumai maar milaaiaa ||4||9||",
      "translation": "O Nanak, conquering egotism, we are absorbed into the Lord. ||4||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 153,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
