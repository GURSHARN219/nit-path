{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 154,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0154_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਿਰਤੁ ਪਇਆ ਨਹ ਮੇਟੈ ਕੋਇ ॥",
      "transliteration": "kirat paiaa nah metai koi ||",
      "translation": "Past actions cannot be erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿਆ ਜਾਣਾ ਕਿਆ ਆਗੈ ਹੋਇ ॥",
      "transliteration": "kiaa jaanaa kiaa aagai hoi ||",
      "translation": "What do we know of what will happen hereafter?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੋ ਤਿਸੁ ਭਾਣਾ ਸੋਈ ਹੂਆ ॥",
      "transliteration": "jo tis bhaanaa soee hooaa ||",
      "translation": "Whatever pleases Him shall come to pass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਵਰੁ ਨ ਕਰਣੈ ਵਾਲਾ ਦੂਆ ॥੧॥",
      "transliteration": "avar na karanai vaalaa dooaa ||1||",
      "translation": "There is no other Doer except Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾ ਜਾਣਾ ਕਰਮ ਕੇਵਡ ਤੇਰੀ ਦਾਤਿ ॥",
      "transliteration": "naa jaanaa karam kevad teree daat ||",
      "translation": "I do not know about karma, or how great Your gifts are.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਰਮੁ ਧਰਮੁ ਤੇਰੇ ਨਾਮ ਕੀ ਜਾਤਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "karam dharam tere naam kee jaat ||1|| rahaau ||",
      "translation": "The karma of actions, the Dharma of righteousness, social class and status, are contained within Your Name. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੂ ਏਵਡੁ ਦਾਤਾ ਦੇਵਣਹਾਰੁ ॥",
      "transliteration": "too evad daataa devanahaar ||",
      "translation": "You are So Great, O Giver, O Great Giver!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤੋਟਿ ਨਾਹੀ ਤੁਧੁ ਭਗਤਿ ਭੰਡਾਰ ॥",
      "transliteration": "tot naahee tudh bhagat bha(n)daar ||",
      "translation": "The treasure of Your devotional worship is never exhausted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕੀਆ ਗਰਬੁ ਨ ਆਵੈ ਰਾਸਿ ॥",
      "transliteration": "keeaa garab na aavai raas ||",
      "translation": "One who takes pride in himself shall never be right.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਸਭੁ ਤੇਰੈ ਪਾਸਿ ॥੨॥",
      "transliteration": "jeeu pi(n)d sabh terai paas ||2||",
      "translation": "The soul and body are all at Your disposal. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੂ ਮਾਰਿ ਜੀਵਾਲਹਿ ਬਖਸਿ ਮਿਲਾਇ ॥",
      "transliteration": "too maar jeevaalahi bakhas milaai ||",
      "translation": "You kill and rejuvenate. You forgive and merge us into Yourself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਉ ਭਾਵੀ ਤਿਉ ਨਾਮੁ ਜਪਾਇ ॥",
      "transliteration": "jiu bhaavee tiu naam japaai ||",
      "translation": "As it pleases You, You inspire us to chant Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤੂੰ ਦਾਨਾ ਬੀਨਾ ਸਾਚਾ ਸਿਰਿ ਮੇਰੈ ॥",
      "transliteration": "too(n) daanaa beenaa saachaa sir merai ||",
      "translation": "You are All-knowing, All-seeing and True, O my Supreme Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰਮਤਿ ਦੇਇ ਭਰੋਸੈ ਤੇਰੈ ॥੩॥",
      "transliteration": "guramat dei bharosai terai ||3||",
      "translation": "Please, bless me with the Guru's Teachings; my faith is in You alone. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਨ ਮਹਿ ਮੈਲੁ ਨਾਹੀ ਮਨੁ ਰਾਤਾ ॥",
      "transliteration": "tan mahi mail naahee man raataa ||",
      "translation": "One whose mind is attuned to the Lord, has no pollution in his body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰ ਬਚਨੀ ਸਚੁ ਸਬਦਿ ਪਛਾਤਾ ॥",
      "transliteration": "gur bachanee sach sabad pachhaataa ||",
      "translation": "Through the Guru's Word, the True Shabad is realized.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤੇਰਾ ਤਾਣੁ ਨਾਮ ਕੀ ਵਡਿਆਈ ॥",
      "transliteration": "teraa taan naam kee vadiaaee ||",
      "translation": "All Power is Yours, through the greatness of Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਰਹਣਾ ਭਗਤਿ ਸਰਣਾਈ ॥੪॥੧੦॥",
      "transliteration": "naanak rahanaa bhagat saranaaee ||4||10||",
      "translation": "Nanak abides in the Sanctuary of Your devotees. ||4||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਨਿ ਅਕਥੁ ਕਹਾਇਆ ਅਪਿਓ ਪੀਆਇਆ ॥",
      "transliteration": "jin akath kahaaiaa apio peeaaiaa ||",
      "translation": "Those who speak the Unspoken, drink in the Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਨ ਭੈ ਵਿਸਰੇ ਨਾਮਿ ਸਮਾਇਆ ॥੧॥",
      "transliteration": "an bhai visare naam samaaiaa ||1||",
      "translation": "Other fears are forgotten, and they are absorbed into the Naam, the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿਆ ਡਰੀਐ ਡਰੁ ਡਰਹਿ ਸਮਾਨਾ ॥",
      "transliteration": "kiaa dareeai dar darahi samaanaa ||",
      "translation": "Why should we fear, when fear is dispelled by the Fear of God?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਕੈ ਸਬਦਿ ਪਛਾਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "poore gur kai sabad pachhaanaa ||1|| rahaau ||",
      "translation": "Through the Shabad, the Word of the Perfect Guru, I recognize God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਿਸੁ ਨਰ ਰਾਮੁ ਰਿਦੈ ਹਰਿ ਰਾਸਿ ॥",
      "transliteration": "jis nar raam ridai har raas ||",
      "translation": "Those whose hearts are filled with the Lord's essence are blessed and acclaimed,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਹਜਿ ਸੁਭਾਇ ਮਿਲੇ ਸਾਬਾਸਿ ॥੨॥",
      "transliteration": "sahaj subhaai mile saabaas ||2||",
      "translation": "And intuitively absorbed into the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਾਹਿ ਸਵਾਰੈ ਸਾਝ ਬਿਆਲ ॥",
      "transliteration": "jaahi savaarai saajh biaal ||",
      "translation": "Those whom the Lord puts to sleep, evening and morning",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਤ ਉਤ ਮਨਮੁਖ ਬਾਧੇ ਕਾਲ ॥੩॥",
      "transliteration": "it ut manamukh baadhe kaal ||3||",
      "translation": "- those self-willed manmukhs are bound and gagged by Death, here and hereafter. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਰਾਮੁ ਰਿਦੈ ਸੇ ਪੂਰੇ ॥",
      "transliteration": "ahinis raam ridai se poore ||",
      "translation": "Those whose hearts are filled with the Lord, day and night, are perfect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਾਨਕ ਰਾਮ ਮਿਲੇ ਭ੍ਰਮ ਦੂਰੇ ॥੪॥੧੧॥",
      "transliteration": "naanak raam mile bhram doore ||4||11||",
      "translation": "O Nanak, they merge into the Lord, and their doubts are cast away. ||4||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਨਮਿ ਮਰੈ ਤ੍ਰੈ ਗੁਣ ਹਿਤਕਾਰੁ ॥",
      "transliteration": "janam marai trai gun hitakaar ||",
      "translation": "One who loves the three qualities is subject to birth and death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚਾਰੇ ਬੇਦ ਕਥਹਿ ਆਕਾਰੁ ॥",
      "transliteration": "chaare bed kathahi aakaar ||",
      "translation": "The four Vedas speak only of the visible forms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੀਨਿ ਅਵਸਥਾ ਕਹਹਿ ਵਖਿਆਨੁ ॥",
      "transliteration": "teen avasathaa kahahi vakhiaan ||",
      "translation": "They describe and explain the three states of mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੁਰੀਆਵਸਥਾ ਸਤਿਗੁਰ ਤੇ ਹਰਿ ਜਾਨੁ ॥੧॥",
      "transliteration": "tureeaavasathaa satigur te har jaan ||1||",
      "translation": "but the fourth state, union with the Lord, is known only through the True Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਾਮ ਭਗਤਿ ਗੁਰ ਸੇਵਾ ਤਰਣਾ ॥",
      "transliteration": "raam bhagat gur sevaa taranaa ||",
      "translation": "Through devotional worship of the Lord, and service to the Guru, one swims across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਾਹੁੜਿ ਜਨਮੁ ਨ ਹੋਇ ਹੈ ਮਰਣਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "baahuR janam na hoi hai maranaa ||1|| rahaau ||",
      "translation": "Then, one is not born again, and is not subject to death. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚਾਰਿ ਪਦਾਰਥ ਕਹੈ ਸਭੁ ਕੋਈ ॥",
      "transliteration": "chaar padaarath kahai sabh koee ||",
      "translation": "Everyone speaks of the four great blessings;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਿੰਮ੍ਰਿਤਿ ਸਾਸਤ ਪੰਡਿਤ ਮੁਖਿ ਸੋਈ ॥",
      "transliteration": "si(n)mrit saasat pa(n)dit mukh soee ||",
      "translation": "the Simritees, the Shaastras and the Pandits speak of them as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਅਰਥੁ ਬੀਚਾਰੁ ਨ ਪਾਇਆ ॥",
      "transliteration": "bin gur arath beechaar na paaiaa ||",
      "translation": "But without the Guru, they do not understand their true significance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮੁਕਤਿ ਪਦਾਰਥੁ ਭਗਤਿ ਹਰਿ ਪਾਇਆ ॥੨॥",
      "transliteration": "mukat padaarath bhagat har paaiaa ||2||",
      "translation": "The treasure of liberation is obtained through devotional worship of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਾ ਕੈ ਹਿਰਦੈ ਵਸਿਆ ਹਰਿ ਸੋਈ ॥",
      "transliteration": "jaa kai hiradai vasiaa har soee ||",
      "translation": "Those, within whose hearts the Lord dwells,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਭਗਤਿ ਪਰਾਪਤਿ ਹੋਈ ॥",
      "transliteration": "guramukh bhagat paraapat hoee ||",
      "translation": "become Gurmukh; they receive the blessings of devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਰਿ ਕੀ ਭਗਤਿ ਮੁਕਤਿ ਆਨੰਦੁ ॥",
      "transliteration": "har kee bhagat mukat aana(n)d ||",
      "translation": "Through devotional worship of the Lord, liberation and bliss are obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰਮਤਿ ਪਾਏ ਪਰਮਾਨੰਦੁ ॥੩॥",
      "transliteration": "guramat paae paramaana(n)d ||3||",
      "translation": "Through the Guru's Teachings, supreme ecstasy is obtained. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਨਿ ਪਾਇਆ ਗੁਰਿ ਦੇਖਿ ਦਿਖਾਇਆ ॥",
      "transliteration": "jin paaiaa gur dekh dikhaaiaa ||",
      "translation": "One who meets the Guru, beholds Him, and inspires others to behold Him as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਸਾ ਮਾਹਿ ਨਿਰਾਸੁ ਬੁਝਾਇਆ ॥",
      "transliteration": "aasaa maahi niraas bujhaaiaa ||",
      "translation": "In the midst of hope, the Guru teaches us to live above hope and desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੀਨਾ ਨਾਥੁ ਸਰਬ ਸੁਖਦਾਤਾ ॥",
      "transliteration": "deenaa naath sarab sukhadaataa ||",
      "translation": "He is the Master of the meek, the Giver of peace to all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਚਰਣੀ ਮਨੁ ਰਾਤਾ ॥੪॥੧੨॥",
      "transliteration": "naanak har charanee man raataa ||4||12||",
      "translation": "Nanak's mind is imbued with the Lotus Feet of the Lord. ||4||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗਉੜੀ ਚੇਤੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee chetee mahalaa 1 ||",
      "translation": "Gauree Chaytee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਕਾਇਆ ਰਹੈ ਸੁਖਾਲੀ ਬਾਜੀ ਇਹੁ ਸੰਸਾਰੋ ॥",
      "transliteration": "a(n)mrit kaaiaa rahai sukhaalee baajee ihu sa(n)saaro ||",
      "translation": "With your nectar-like body, you live in comfort, but this world is just a passing drama.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਲਬੁ ਲੋਭੁ ਮੁਚੁ ਕੂੜੁ ਕਮਾਵਹਿ ਬਹੁਤੁ ਉਠਾਵਹਿ ਭਾਰੋ ॥",
      "transliteration": "lab lobh much kooR kamaavahi bahut uthaavahi bhaaro ||",
      "translation": "You practice greed, avarice and great falsehood, and you carry such a heavy burden.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤੂੰ ਕਾਇਆ ਮੈ ਰੁਲਦੀ ਦੇਖੀ ਜਿਉ ਧਰ ਉਪਰਿ ਛਾਰੋ ॥੧॥",
      "transliteration": "too(n) kaaiaa mai ruladee dekhee jiu dhar upar chhaaro ||1||",
      "translation": "O body, I have seen you blowing away like dust on the earth. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੁਣਿ ਸੁਣਿ ਸਿਖ ਹਮਾਰੀ ॥",
      "transliteration": "sun sun sikh hamaaree ||",
      "translation": "Listen - listen to my advice!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0154_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸੁਕ੍ਰਿਤੁ ਕੀਤਾ ਰਹਸੀ ਮੇਰੇ ਜੀਅੜੇ ਬਹੁੜਿ ਨ ਆਵੈ ਵਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sukrit keetaa rahasee mere jeeaRe bahuR na aavai vaaree ||1|| rahaau ||",
      "translation": "Only the good deeds which you have done shall remain with you, O my soul. This opportunity shall not come again! ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 154,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
