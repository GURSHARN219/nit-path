{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 158,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0158_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਨਿ ਨਿਰਮਲਿ ਵਸੈ ਸਚੁ ਸੋਇ ॥",
      "transliteration": "man niramal vasai sach soi ||",
      "translation": "The mind becomes pure, when the True Lord dwells within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਚਿ ਵਸਿਐ ਸਾਚੀ ਸਭ ਕਾਰ ॥",
      "transliteration": "saach vasiai saachee sabh kaar ||",
      "translation": "When one dwells in Truth, all actions become true.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਊਤਮ ਕਰਣੀ ਸਬਦ ਬੀਚਾਰ ॥੩॥",
      "transliteration": "ootam karanee sabad beechaar ||3||",
      "translation": "The ultimate action is to contemplate the Word of the Shabad. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰ ਤੇ ਸਾਚੀ ਸੇਵਾ ਹੋਇ ॥",
      "transliteration": "gur te saachee sevaa hoi ||",
      "translation": "Through the Guru, true service is performed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਮੁ ਪਛਾਣੈ ਕੋਇ ॥",
      "transliteration": "guramukh naam pachhaanai koi ||",
      "translation": "How rare is that Gurmukh who recognizes the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੀਵੈ ਦਾਤਾ ਦੇਵਣਹਾਰੁ ॥",
      "transliteration": "jeevai daataa devanahaar ||",
      "translation": "The Giver, the Great Giver, lives forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਨਾਮੇ ਲਗੈ ਪਿਆਰੁ ॥੪॥੧॥੨੧॥",
      "transliteration": "naanak har naame lagai piaar ||4||1||21||",
      "translation": "Nanak enshrines love for the Name of the Lord. ||4||1||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "gauRee guaareree mahalaa 3 ||",
      "translation": "Gauree Gwaarayree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰ ਤੇ ਗਿਆਨੁ ਪਾਏ ਜਨੁ ਕੋਇ ॥",
      "transliteration": "gur te giaan paae jan koi ||",
      "translation": "Those who obtain spiritual wisdom from the Guru are very rare.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰ ਤੇ ਬੂਝੈ ਸੀਝੈ ਸੋਇ ॥",
      "transliteration": "gur te boojhai seejhai soi ||",
      "translation": "Those who obtain this understanding from the Guru become acceptable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਰ ਤੇ ਸਹਜੁ ਸਾਚੁ ਬੀਚਾਰੁ ॥",
      "transliteration": "gur te sahaj saach beechaar ||",
      "translation": "Through the Guru, we intuitively contemplate the True One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰ ਤੇ ਪਾਏ ਮੁਕਤਿ ਦੁਆਰੁ ॥੧॥",
      "transliteration": "gur te paae mukat duaar ||1||",
      "translation": "Through the Guru, the Gate of Liberation is found. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪੂਰੈ ਭਾਗਿ ਮਿਲੈ ਗੁਰੁ ਆਇ ॥",
      "transliteration": "poorai bhaag milai gur aai ||",
      "translation": "Through perfect good destiny, we come to meet the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਾਚੈ ਸਹਜਿ ਸਾਚਿ ਸਮਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saachai sahaj saach samaai ||1|| rahaau ||",
      "translation": "The true ones are intuitively absorbed in the True Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰਿ ਮਿਲਿਐ ਤ੍ਰਿਸਨਾ ਅਗਨਿ ਬੁਝਾਏ ॥",
      "transliteration": "gur miliai trisanaa agan bujhaae ||",
      "translation": "Meeting the Guru, the fire of desire is quenched.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰ ਤੇ ਸਾਂਤਿ ਵਸੈ ਮਨਿ ਆਏ ॥",
      "transliteration": "gur te saa(n)t vasai man aae ||",
      "translation": "Through the Guru, peace and tranquility come to dwell within the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰ ਤੇ ਪਵਿਤ ਪਾਵਨ ਸੁਚਿ ਹੋਇ ॥",
      "transliteration": "gur te pavit paavan such hoi ||",
      "translation": "Through the Guru, we become pure, holy and true.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰ ਤੇ ਸਬਦਿ ਮਿਲਾਵਾ ਹੋਇ ॥੨॥",
      "transliteration": "gur te sabad milaavaa hoi ||2||",
      "translation": "Through the Guru, we are absorbed in the Word of the Shabad. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਾਝੁ ਗੁਰੂ ਸਭ ਭਰਮਿ ਭੁਲਾਈ ॥",
      "transliteration": "baajh guroo sabh bharam bhulaaee ||",
      "translation": "Without the Guru, everyone wanders in doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਬਹੁਤਾ ਦੁਖੁ ਪਾਈ ॥",
      "transliteration": "bin naavai bahutaa dukh paaee ||",
      "translation": "Without the Name, they suffer in terrible pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਹੋਵੈ ਸੁ ਨਾਮੁ ਧਿਆਈ ॥",
      "transliteration": "guramukh hovai s naam dhiaaee ||",
      "translation": "Those who meditate on the Naam become Gurmukh.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦਰਸਨਿ ਸਚੈ ਸਚੀ ਪਤਿ ਹੋਈ ॥੩॥",
      "transliteration": "darasan sachai sachee pat hoee ||3||",
      "translation": "True honor is obtained through the Darshan, the Blessed Vision of the True Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿਸ ਨੋ ਕਹੀਐ ਦਾਤਾ ਇਕੁ ਸੋਈ ॥",
      "transliteration": "kis no kaheeai daataa ik soee ||",
      "translation": "Why speak of any other? He alone is the Giver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿਰਪਾ ਕਰੇ ਸਬਦਿ ਮਿਲਾਵਾ ਹੋਈ ॥",
      "transliteration": "kirapaa kare sabad milaavaa hoee ||",
      "translation": "When He grants His Grace, union with the Shabad is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਿਲਿ ਪ੍ਰੀਤਮ ਸਾਚੇ ਗੁਣ ਗਾਵਾ ॥",
      "transliteration": "mil preetam saache gun gaavaa ||",
      "translation": "Meeting with my Beloved, I sing the Glorious Praises of the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਨਕ ਸਾਚੇ ਸਾਚਿ ਸਮਾਵਾ ॥੪॥੨॥੨੨॥",
      "transliteration": "naanak saache saach samaavaa ||4||2||22||",
      "translation": "O Nanak, becoming true, I am absorbed in the True One. ||4||2||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "gauRee guaareree mahalaa 3 ||",
      "translation": "Gauree Gwaarayree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੁ ਥਾਉ ਸਚੁ ਮਨੁ ਨਿਰਮਲੁ ਹੋਇ ॥",
      "transliteration": "s thaau sach man niramal hoi ||",
      "translation": "True is that place, where the mind becomes pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਚਿ ਨਿਵਾਸੁ ਕਰੇ ਸਚੁ ਸੋਇ ॥",
      "transliteration": "sach nivaas kare sach soi ||",
      "translation": "True is the one who abides in Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਚੀ ਬਾਣੀ ਜੁਗ ਚਾਰੇ ਜਾਪੈ ॥",
      "transliteration": "sachee baanee jug chaare jaapai ||",
      "translation": "The True Bani of the Word is known throughout the four ages.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਭੁ ਕਿਛੁ ਸਾਚਾ ਆਪੇ ਆਪੈ ॥੧॥",
      "transliteration": "sabh kichh saachaa aape aapai ||1||",
      "translation": "The True One Himself is everything. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਰਮੁ ਹੋਵੈ ਸਤਸੰਗਿ ਮਿਲਾਏ ॥",
      "transliteration": "karam hovai satasa(n)g milaae ||",
      "translation": "Through the karma of good actions, one joins the Sat Sangat, the True Congregation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਗਾਵੈ ਬੈਸਿ ਸੁ ਥਾਏ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har gun gaavai bais s thaae ||1|| rahaau ||",
      "translation": "Sing the Glories of the Lord, sitting in that place. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਲਉ ਇਹ ਜਿਹਵਾ ਦੂਜੈ ਭਾਇ ॥",
      "transliteration": "jalau ih jihavaa doojai bhaai ||",
      "translation": "Burn this tongue, which loves duality,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਰਿ ਰਸੁ ਨ ਚਾਖੈ ਫੀਕਾ ਆਲਾਇ ॥",
      "transliteration": "har ras na chaakhai pheekaa aalaai ||",
      "translation": "which does not taste the sublime essence of the Lord, and which utters insipid words.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿਨੁ ਬੂਝੇ ਤਨੁ ਮਨੁ ਫੀਕਾ ਹੋਇ ॥",
      "transliteration": "bin boojhe tan man pheekaa hoi ||",
      "translation": "Without understanding, the body and mind become tasteless and insipid.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਦੁਖੀਆ ਚਲਿਆ ਰੋਇ ॥੨॥",
      "transliteration": "bin naavai dukheeaa chaliaa roi ||2||",
      "translation": "Without the Name, the miserable ones depart crying out in pain. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਸਨਾ ਹਰਿ ਰਸੁ ਚਾਖਿਆ ਸਹਜਿ ਸੁਭਾਇ ॥",
      "transliteration": "rasanaa har ras chaakhiaa sahaj subhaai ||",
      "translation": "One whose tongue naturally and intuitively tastes the Lord's sublime essence,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਸਚਿ ਸਮਾਇ ॥",
      "transliteration": "gur kirapaa te sach samaai ||",
      "translation": "By Guru's Grace, is absorbed in the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਾਚੇ ਰਾਤੀ ਗੁਰਸਬਦੁ ਵੀਚਾਰ ॥",
      "transliteration": "saache raatee gurasabad veechaar ||",
      "translation": "Imbued with Truth, one contemplates the Word of the Guru's Shabad,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਪੀਵੈ ਨਿਰਮਲ ਧਾਰ ॥੩॥",
      "transliteration": "a(n)mrit peevai niramal dhaar ||3||",
      "translation": "and drinks in the Ambrosial Nectar, from the immaculate stream within. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਮਿ ਸਮਾਵੈ ਜੋ ਭਾਡਾ ਹੋਇ ॥",
      "transliteration": "naam samaavai jo bhaadaa hoi ||",
      "translation": "The Naam, the Name of the Lord, is collected in the vessel of the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਊਂਧੈ ਭਾਂਡੈ ਟਿਕੈ ਨ ਕੋਇ ॥",
      "transliteration": "oo(n)dhai bhaa(n)dai tikai na koi ||",
      "translation": "Nothing is collected if the vessel is upside-down.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰਸਬਦੀ ਮਨਿ ਨਾਮਿ ਨਿਵਾਸੁ ॥",
      "transliteration": "gurasabadee man naam nivaas ||",
      "translation": "Through the Word of the Guru's Shabad, the Naam abides within the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਸਚੁ ਭਾਂਡਾ ਜਿਸੁ ਸਬਦ ਪਿਆਸ ॥੪॥੩॥੨੩॥",
      "transliteration": "naanak sach bhaa(n)daa jis sabad piaas ||4||3||23||",
      "translation": "O Nanak, True is that vessel of the mind, which thirsts for the Shabad. ||4||3||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "gauRee guaareree mahalaa 3 ||",
      "translation": "Gauree Gwaarayree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਇਕਿ ਗਾਵਤ ਰਹੇ ਮਨਿ ਸਾਦੁ ਨ ਪਾਇ ॥",
      "transliteration": "ik gaavat rahe man saad na paai ||",
      "translation": "Some sing on and on, but their minds do not find happiness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹਉਮੈ ਵਿਚਿ ਗਾਵਹਿ ਬਿਰਥਾ ਜਾਇ ॥",
      "transliteration": "haumai vich gaavahi birathaa jaai ||",
      "translation": "In egotism, they sing, but it is wasted uselessly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗਾਵਣਿ ਗਾਵਹਿ ਜਿਨ ਨਾਮ ਪਿਆਰੁ ॥",
      "transliteration": "gaavan gaavahi jin naam piaar ||",
      "translation": "Those who love the Naam, sing the song.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਾਚੀ ਬਾਣੀ ਸਬਦ ਬੀਚਾਰੁ ॥੧॥",
      "transliteration": "saachee baanee sabad beechaar ||1||",
      "translation": "They contemplate the True Bani of the Word, and the Shabad. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗਾਵਤ ਰਹੈ ਜੇ ਸਤਿਗੁਰ ਭਾਵੈ ॥",
      "transliteration": "gaavat rahai je satigur bhaavai ||",
      "translation": "They sing on and on, if it pleases the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਰਾਤਾ ਨਾਮਿ ਸੁਹਾਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "man tan raataa naam suhaavai ||1|| rahaau ||",
      "translation": "Their minds and bodies are embellished and adorned, attuned to the Naam, the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਇਕਿ ਗਾਵਹਿ ਇਕਿ ਭਗਤਿ ਕਰੇਹਿ ॥",
      "transliteration": "ik gaavahi ik bhagat karehi ||",
      "translation": "Some sing, and some perform devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨਾਮੁ ਨ ਪਾਵਹਿ ਬਿਨੁ ਅਸਨੇਹ ॥",
      "transliteration": "naam na paavahi bin asaneh ||",
      "translation": "Without heart-felt love, the Naam is not obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸਚੀ ਭਗਤਿ ਗੁਰਸਬਦ ਪਿਆਰਿ ॥",
      "transliteration": "sachee bhagat gurasabad piaar ||",
      "translation": "True devotional worship consists of love for the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0158_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਅਪਨਾ ਪਿਰੁ ਰਾਖਿਆ ਸਦਾ ਉਰਿ ਧਾਰਿ ॥੨॥",
      "transliteration": "apanaa pir raakhiaa sadaa ur dhaar ||2||",
      "translation": "The devotee keeps his Beloved clasped tightly to his heart. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 158,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
