{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 159,
  "lineCount": 53,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0159_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਗਤਿ ਕਰਹਿ ਮੂਰਖ ਆਪੁ ਜਣਾਵਹਿ ॥",
      "transliteration": "bhagat karahi moorakh aap janaavahi ||",
      "translation": "The fools perform devotional worship by showing off;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਚਿ ਨਚਿ ਟਪਹਿ ਬਹੁਤੁ ਦੁਖੁ ਪਾਵਹਿ ॥",
      "transliteration": "nach nach tapahi bahut dukh paavahi ||",
      "translation": "they dance and dance and jump all around, but they only suffer in terrible pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਚਿਐ ਟਪਿਐ ਭਗਤਿ ਨ ਹੋਇ ॥",
      "transliteration": "nachiai tapiai bhagat na hoi ||",
      "translation": "By dancing and jumping, devotional worship is not performed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਬਦਿ ਮਰੈ ਭਗਤਿ ਪਾਏ ਜਨੁ ਸੋਇ ॥੩॥",
      "transliteration": "sabad marai bhagat paae jan soi ||3||",
      "translation": "But one who dies in the Word of the Shabad, obtains devotional worship. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਗਤਿ ਵਛਲੁ ਭਗਤਿ ਕਰਾਏ ਸੋਇ ॥",
      "transliteration": "bhagat vachhal bhagat karaae soi ||",
      "translation": "The Lord is the Lover of His devotees; He inspires them to perform devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਚੀ ਭਗਤਿ ਵਿਚਹੁ ਆਪੁ ਖੋਇ ॥",
      "transliteration": "sachee bhagat vichahu aap khoi ||",
      "translation": "True devotional worship consists of eliminating selfishness and conceit from within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੇਰਾ ਪ੍ਰਭੁ ਸਾਚਾ ਸਭ ਬਿਧਿ ਜਾਣੈ ॥",
      "transliteration": "meraa prabh saachaa sabh bidh jaanai ||",
      "translation": "My True God knows all ways and means.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਨਕ ਬਖਸੇ ਨਾਮੁ ਪਛਾਣੈ ॥੪॥੪॥੨੪॥",
      "transliteration": "naanak bakhase naam pachhaanai ||4||4||24||",
      "translation": "O Nanak, He forgives those who recognize the Naam. ||4||4||24||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "gauRee guaareree mahalaa 3 ||",
      "translation": "Gauree Gwaarayree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨੁ ਮਾਰੇ ਧਾਤੁ ਮਰਿ ਜਾਇ ॥",
      "transliteration": "man maare dhaat mar jaai ||",
      "translation": "When someone kills and subdues his own mind, his wandering nature is also subdued.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਨੁ ਮੂਏ ਕੈਸੇ ਹਰਿ ਪਾਇ ॥",
      "transliteration": "bin mooe kaise har paai ||",
      "translation": "Without such a death, how can one find the Lord?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਨੁ ਮਰੈ ਦਾਰੂ ਜਾਣੈ ਕੋਇ ॥",
      "transliteration": "man marai daaroo jaanai koi ||",
      "translation": "Only a few know the medicine to kill the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਨੁ ਸਬਦਿ ਮਰੈ ਬੂਝੈ ਜਨੁ ਸੋਇ ॥੧॥",
      "transliteration": "man sabad marai boojhai jan soi ||1||",
      "translation": "One whose mind dies in the Word of the Shabad, understands Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਸ ਨੋ ਬਖਸੇ ਦੇ ਵਡਿਆਈ ॥",
      "transliteration": "jis no bakhase de vadiaaee ||",
      "translation": "He grants greatness to those whom He forgives.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਹਰਿ ਵਸੈ ਮਨਿ ਆਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur parasaad har vasai man aaee ||1|| rahaau ||",
      "translation": "By Guru's Grace, the Lord comes to dwell within the mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਕਰਣੀ ਕਾਰ ਕਮਾਵੈ ॥",
      "transliteration": "guramukh karanee kaar kamaavai ||",
      "translation": "The Gurmukh practices doing good deeds;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾ ਇਸੁ ਮਨ ਕੀ ਸੋਝੀ ਪਾਵੈ ॥",
      "transliteration": "taa is man kee sojhee paavai ||",
      "translation": "thus he comes to understand this mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਨੁ ਮੈ ਮਤੁ ਮੈਗਲ ਮਿਕਦਾਰਾ ॥",
      "transliteration": "man mai mat maigal mikadaaraa ||",
      "translation": "The mind is like an elephant, drunk with wine.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੁਰੁ ਅੰਕਸੁ ਮਾਰਿ ਜੀਵਾਲਣਹਾਰਾ ॥੨॥",
      "transliteration": "gur a(n)kas maar jeevaalanahaaraa ||2||",
      "translation": "The Guru is the rod which controls it, and shows it the way. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਨੁ ਅਸਾਧੁ ਸਾਧੈ ਜਨੁ ਕੋਇ ॥",
      "transliteration": "man asaadh saadhai jan koi ||",
      "translation": "The mind is uncontrollable; how rare are those who subdue it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਚਰੁ ਚਰੈ ਤਾ ਨਿਰਮਲੁ ਹੋਇ ॥",
      "transliteration": "achar charai taa niramal hoi ||",
      "translation": "Those who move the immovable become pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਇਹੁ ਮਨੁ ਲਇਆ ਸਵਾਰਿ ॥",
      "transliteration": "guramukh ihu man laiaa savaar ||",
      "translation": "The Gurmukhs embellish and beautify this mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਉਮੈ ਵਿਚਹੁ ਤਜੇ ਵਿਕਾਰ ॥੩॥",
      "transliteration": "haumai vichahu taje vikaar ||3||",
      "translation": "They eradicate egotism and corruption from within. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੋ ਧੁਰਿ ਰਾਖਿਅਨੁ ਮੇਲਿ ਮਿਲਾਇ ॥",
      "transliteration": "jo dhur raakhian mel milaai ||",
      "translation": "Those who, by pre-ordained destiny, are united in the Lord's Union,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਦੇ ਨ ਵਿਛੁੜਹਿ ਸਬਦਿ ਸਮਾਇ ॥",
      "transliteration": "kade na vichhuRahi sabad samaai ||",
      "translation": "are never separated from Him again; they are absorbed in the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਪਣੀ ਕਲਾ ਆਪੇ ਹੀ ਜਾਣੈ ॥",
      "transliteration": "aapanee kalaa aape hee jaanai ||",
      "translation": "He Himself knows His Own Almighty Power.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਨਾਮੁ ਪਛਾਣੈ ॥੪॥੫॥੨੫॥",
      "transliteration": "naanak guramukh naam pachhaanai ||4||5||25||",
      "translation": "O Nanak, the Gurmukh realizes the Naam, the Name of the Lord. ||4||5||25||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "gauRee guaareree mahalaa 3 ||",
      "translation": "Gauree Gwaarayree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਉਮੈ ਵਿਚਿ ਸਭੁ ਜਗੁ ਬਉਰਾਨਾ ॥",
      "transliteration": "haumai vich sabh jag bauraanaa ||",
      "translation": "The entire world has gone insane in egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੂਜੈ ਭਾਇ ਭਰਮਿ ਭੁਲਾਨਾ ॥",
      "transliteration": "doojai bhaai bharam bhulaanaa ||",
      "translation": "In the love of duality, it wanders deluded by doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਹੁ ਚਿੰਤਾ ਚਿਤਵੈ ਆਪੁ ਨ ਪਛਾਨਾ ॥",
      "transliteration": "bahu chi(n)taa chitavai aap na pachhaanaa ||",
      "translation": "The mind is distracted by great anxiety; no one recognizes one's own self.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਧੰਧਾ ਕਰਤਿਆ ਅਨਦਿਨੁ ਵਿਹਾਨਾ ॥੧॥",
      "transliteration": "dha(n)dhaa karatiaa anadin vihaanaa ||1||",
      "translation": "Occupied with their own affairs, their nights and days are passing away. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਿਰਦੈ ਰਾਮੁ ਰਮਹੁ ਮੇਰੇ ਭਾਈ ॥",
      "transliteration": "hiradai raam ramahu mere bhaaee ||",
      "translation": "Meditate on the Lord in your hearts, O my Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਰਸਨਾ ਹਰਿ ਰਸਨ ਰਸਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "guramukh rasanaa har rasan rasaaee ||1|| rahaau ||",
      "translation": "The Gurmukh's tongue savors the sublime essence of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਹਿਰਦੈ ਜਿਨਿ ਰਾਮੁ ਪਛਾਤਾ ॥",
      "transliteration": "guramukh hiradai jin raam pachhaataa ||",
      "translation": "The Gurmukhs recognize the Lord in their own hearts;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਗਜੀਵਨੁ ਸੇਵਿ ਜੁਗ ਚਾਰੇ ਜਾਤਾ ॥",
      "transliteration": "jagajeevan sev jug chaare jaataa ||",
      "translation": "they serve the Lord, the Life of the World. They are famous throughout the four ages.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਉਮੈ ਮਾਰਿ ਗੁਰ ਸਬਦਿ ਪਛਾਤਾ ॥",
      "transliteration": "haumai maar gur sabad pachhaataa ||",
      "translation": "They subdue egotism, and realize the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਕਰੇ ਪ੍ਰਭ ਕਰਮ ਬਿਧਾਤਾ ॥੨॥",
      "transliteration": "kripaa kare prabh karam bidhaataa ||2||",
      "translation": "God, the Architect of Destiny, showers His Mercy upon them. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੇ ਜਨ ਸਚੇ ਜੋ ਗੁਰ ਸਬਦਿ ਮਿਲਾਏ ॥",
      "transliteration": "se jan sache jo gur sabad milaae ||",
      "translation": "True are those who merge into the Word of the Guru's Shabad;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਧਾਵਤ ਵਰਜੇ ਠਾਕਿ ਰਹਾਏ ॥",
      "transliteration": "dhaavat varaje thaak rahaae ||",
      "translation": "they restrain their wandering mind and keep it steady.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਮੁ ਨਵ ਨਿਧਿ ਗੁਰ ਤੇ ਪਾਏ ॥",
      "transliteration": "naam nav nidh gur te paae ||",
      "translation": "The Naam, the Name of the Lord, is the nine treasures. It is obtained from the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਰਿ ਕਿਰਪਾ ਤੇ ਹਰਿ ਵਸੈ ਮਨਿ ਆਏ ॥੩॥",
      "transliteration": "har kirapaa te har vasai man aae ||3||",
      "translation": "By the Lord's Grace, the Lord comes to dwell in the mind. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰਾਮ ਰਾਮ ਕਰਤਿਆ ਸੁਖੁ ਸਾਂਤਿ ਸਰੀਰ ॥",
      "transliteration": "raam raam karatiaa sukh saa(n)t sareer ||",
      "translation": "Chanting the Name of the Lord, Raam, Raam, the body becomes peaceful and tranquil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅੰਤਰਿ ਵਸੈ ਨ ਲਾਗੈ ਜਮ ਪੀਰ ॥",
      "transliteration": "a(n)tar vasai na laagai jam peer ||",
      "translation": "He dwells deep within - the pain of death does not touch Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਪੇ ਸਾਹਿਬੁ ਆਪਿ ਵਜੀਰ ॥",
      "transliteration": "aape saahib aap vajeer ||",
      "translation": "He Himself is our Lord and Master; He is His Own Advisor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕ ਸੇਵਿ ਸਦਾ ਹਰਿ ਗੁਣੀ ਗਹੀਰ ॥੪॥੬॥੨੬॥",
      "transliteration": "naanak sev sadaa har gunee gaheer ||4||6||26||",
      "translation": "O Nanak, serve the Lord forever; He is the treasure of glorious virtue. ||4||6||26||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "gauRee guaareree mahalaa 3 ||",
      "translation": "Gauree Gwaarayree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੋ ਕਿਉ ਵਿਸਰੈ ਜਿਸ ਕੇ ਜੀਅ ਪਰਾਨਾ ॥",
      "transliteration": "so kiu visarai jis ke jee paraanaa ||",
      "translation": "Why forget Him, unto whom the soul and the breath of life belong?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੋ ਕਿਉ ਵਿਸਰੈ ਸਭ ਮਾਹਿ ਸਮਾਨਾ ॥",
      "transliteration": "so kiu visarai sabh maahi samaanaa ||",
      "translation": "Why forget Him, who is all-pervading?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਤੁ ਸੇਵਿਐ ਦਰਗਹ ਪਤਿ ਪਰਵਾਨਾ ॥੧॥",
      "transliteration": "jit seviai daragah pat paravaanaa ||1||",
      "translation": "Serving Him, one is honored and accepted in the Court of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਰਿ ਕੇ ਨਾਮ ਵਿਟਹੁ ਬਲਿ ਜਾਉ ॥",
      "transliteration": "har ke naam vitahu bal jaau ||",
      "translation": "I am a sacrifice to the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤੂੰ ਵਿਸਰਹਿ ਤਦਿ ਹੀ ਮਰਿ ਜਾਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "too(n) visarahi tad hee mar jaau ||1|| rahaau ||",
      "translation": "If I were to forget You, at that very instant, I would die. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0159_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਿਨ ਤੂੰ ਵਿਸਰਹਿ ਜਿ ਤੁਧੁ ਆਪਿ ਭੁਲਾਏ ॥",
      "transliteration": "tin too(n) visarahi j tudh aap bhulaae ||",
      "translation": "Those whom You Yourself have led astray, forget You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 159,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
