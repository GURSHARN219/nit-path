{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 161,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0161_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਸੁ ਕਲਿਜੁਗ ਮਹਿ ਕਰਮ ਧਰਮੁ ਨ ਕੋਈ ॥",
      "transliteration": "is kalijug mahi karam dharam na koee ||",
      "translation": "In this Dark Age of Kali Yuga, no one is interested in good karma, or Dharmic faith.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਲੀ ਕਾ ਜਨਮੁ ਚੰਡਾਲ ਕੈ ਘਰਿ ਹੋਈ ॥",
      "transliteration": "kalee kaa janam cha(n)daal kai ghar hoee ||",
      "translation": "This Dark Age was born in the house of evil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਨਕ ਨਾਮ ਬਿਨਾ ਕੋ ਮੁਕਤਿ ਨ ਹੋਈ ॥੪॥੧੦॥੩੦॥",
      "transliteration": "naanak naam binaa ko mukat na hoee ||4||10||30||",
      "translation": "O Nanak, without the Naam, the Name of the Lord, no one is liberated. ||4||10||30||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੩ ਗੁਆਰੇਰੀ ॥",
      "transliteration": "gauRee mahalaa 3 guaareree ||",
      "translation": "Gauree, Third Mehl, Gwaarayree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਚਾ ਅਮਰੁ ਸਚਾ ਪਾਤਿਸਾਹੁ ॥",
      "transliteration": "sachaa amar sachaa paatisaahu ||",
      "translation": "True is the Lord King, True is His Royal Command.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਨਿ ਸਾਚੈ ਰਾਤੇ ਹਰਿ ਵੇਪਰਵਾਹੁ ॥",
      "transliteration": "man saachai raate har veparavaahu ||",
      "translation": "Those whose minds are attuned to the True,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਚੈ ਮਹਲਿ ਸਚਿ ਨਾਮਿ ਸਮਾਹੁ ॥੧॥",
      "transliteration": "sachai mahal sach naam samaahu ||1||",
      "translation": "Carefree Lord enter the True Mansion of His Presence, and merge in the True Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁਣਿ ਮਨ ਮੇਰੇ ਸਬਦੁ ਵੀਚਾਰਿ ॥",
      "transliteration": "sun man mere sabad veechaar ||",
      "translation": "Listen, O my mind: contemplate the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਾਮ ਜਪਹੁ ਭਵਜਲੁ ਉਤਰਹੁ ਪਾਰਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raam japahu bhavajal utarahu paar ||1|| rahaau ||",
      "translation": "Chant the Lord's Name, and cross over the terrifying world-ocean. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭਰਮੇ ਆਵੈ ਭਰਮੇ ਜਾਇ ॥",
      "transliteration": "bharame aavai bharame jaai ||",
      "translation": "In doubt he comes, and in doubt he goes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਹੁ ਜਗੁ ਜਨਮਿਆ ਦੂਜੈ ਭਾਇ ॥",
      "transliteration": "ihu jag janamiaa doojai bhaai ||",
      "translation": "This world is born out of the love of duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਨਮੁਖਿ ਨ ਚੇਤੈ ਆਵੈ ਜਾਇ ॥੨॥",
      "transliteration": "manamukh na chetai aavai jaai ||2||",
      "translation": "The self-willed manmukh does not remember the Lord; he continues coming and going in reincarnation. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਪਿ ਭੁਲਾ ਕਿ ਪ੍ਰਭਿ ਆਪਿ ਭੁਲਾਇਆ ॥",
      "transliteration": "aap bhulaa k prabh aap bhulaaiaa ||",
      "translation": "Does he himself go astray, or does God lead him astray?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਹੁ ਜੀਉ ਵਿਡਾਣੀ ਚਾਕਰੀ ਲਾਇਆ ॥",
      "transliteration": "ihu jeeu vidaanee chaakaree laaiaa ||",
      "translation": "This soul is enjoined to the service of someone else.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਹਾ ਦੁਖੁ ਖਟੇ ਬਿਰਥਾ ਜਨਮੁ ਗਵਾਇਆ ॥੩॥",
      "transliteration": "mahaa dukh khate birathaa janam gavaaiaa ||3||",
      "translation": "It earns only terrible pain, and this life is lost in vain. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿਰਪਾ ਕਰਿ ਸਤਿਗੁਰੂ ਮਿਲਾਏ ॥",
      "transliteration": "kirapaa kar satiguroo milaae ||",
      "translation": "Granting His Grace, He leads us to meet the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਏਕੋ ਨਾਮੁ ਚੇਤੇ ਵਿਚਹੁ ਭਰਮੁ ਚੁਕਾਏ ॥",
      "transliteration": "eko naam chete vichahu bharam chukaae ||",
      "translation": "Remembering the One Name, doubt is cast out from within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਜਪੇ ਨਾਉ ਨਉ ਨਿਧਿ ਪਾਏ ॥੪॥੧੧॥੩੧॥",
      "transliteration": "naanak naam jape naau nau nidh paae ||4||11||31||",
      "translation": "O Nanak, chanting the Naam, the Name of the Lord, the nine treasures of the Name are obtained. ||4||11||31||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "gauRee guaareree mahalaa 3 ||",
      "translation": "Gauree Gwaarayree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਨਾ ਗੁਰਮੁਖਿ ਧਿਆਇਆ ਤਿਨ ਪੂਛਉ ਜਾਇ ॥",
      "transliteration": "jinaa guramukh dhiaaiaa tin poochhau jaai ||",
      "translation": "Go and ask the Gurmukhs, who meditate on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਰ ਸੇਵਾ ਤੇ ਮਨੁ ਪਤੀਆਇ ॥",
      "transliteration": "gur sevaa te man pateeaai ||",
      "translation": "Serving the Guru, the mind is satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੇ ਧਨਵੰਤ ਹਰਿ ਨਾਮੁ ਕਮਾਇ ॥",
      "transliteration": "se dhanava(n)t har naam kamaai ||",
      "translation": "Those who earn the Lord's Name are wealthy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਤੇ ਸੋਝੀ ਪਾਇ ॥੧॥",
      "transliteration": "poore gur te sojhee paai ||1||",
      "translation": "Through the Perfect Guru, understanding is obtained. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਪਹੁ ਮੇਰੇ ਭਾਈ ॥",
      "transliteration": "har har naam japahu mere bhaaee ||",
      "translation": "Chant the Name of the Lord, Har, Har, O my Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸੇਵਾ ਹਰਿ ਘਾਲ ਥਾਇ ਪਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "guramukh sevaa har ghaal thaai paaee ||1|| rahaau ||",
      "translation": "The Gurmukhs serve the Lord, and so they are accepted. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਪੁ ਪਛਾਣੈ ਮਨੁ ਨਿਰਮਲੁ ਹੋਇ ॥",
      "transliteration": "aap pachhaanai man niramal hoi ||",
      "translation": "Those who recognize the self - their minds become pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੀਵਨ ਮੁਕਤਿ ਹਰਿ ਪਾਵੈ ਸੋਇ ॥",
      "transliteration": "jeevan mukat har paavai soi ||",
      "translation": "They become Jivan-mukta, liberated while yet alive, and they find the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਗਾਵੈ ਮਤਿ ਊਤਮ ਹੋਇ ॥",
      "transliteration": "har gun gaavai mat ootam hoi ||",
      "translation": "Singing the Glorious Praises of the Lord, the intellect becomes pure and sublime,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਹਜੇ ਸਹਜਿ ਸਮਾਵੈ ਸੋਇ ॥੨॥",
      "transliteration": "sahaje sahaj samaavai soi ||2||",
      "translation": "and they are easily and intuitively absorbed in the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੂਜੈ ਭਾਇ ਨ ਸੇਵਿਆ ਜਾਇ ॥",
      "transliteration": "doojai bhaai na seviaa jaai ||",
      "translation": "In the love of duality, no one can serve the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਉਮੈ ਮਾਇਆ ਮਹਾ ਬਿਖੁ ਖਾਇ ॥",
      "transliteration": "haumai maaiaa mahaa bikh khaai ||",
      "translation": "In egotism and Maya, they are eating toxic poison.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪੁਤਿ ਕੁਟੰਬਿ ਗ੍ਰਿਹਿ ਮੋਹਿਆ ਮਾਇ ॥",
      "transliteration": "put kuta(n)b grihi mohiaa maai ||",
      "translation": "They are emotionally attached to their children, family and home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਨਮੁਖਿ ਅੰਧਾ ਆਵੈ ਜਾਇ ॥੩॥",
      "transliteration": "manamukh a(n)dhaa aavai jaai ||3||",
      "translation": "The blind, self-willed manmukhs come and go in reincarnation. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਦੇਵੈ ਜਨੁ ਸੋਇ ॥",
      "transliteration": "har har naam devai jan soi ||",
      "translation": "Those, unto whom the Lord bestows His Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਨਦਿਨੁ ਭਗਤਿ ਗੁਰਸਬਦੀ ਹੋਇ ॥",
      "transliteration": "anadin bhagat gurasabadee hoi ||",
      "translation": "Worship Him night and day, through the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰਮਤਿ ਵਿਰਲਾ ਬੂਝੈ ਕੋਇ ॥",
      "transliteration": "guramat viralaa boojhai koi ||",
      "translation": "How rare are those who understand the Guru's Teachings!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਸਮਾਵੈ ਸੋਇ ॥੪॥੧੨॥੩੨॥",
      "transliteration": "naanak naam samaavai soi ||4||12||32||",
      "translation": "O Nanak, they are absorbed in the Naam, the Name of the Lord. ||4||12||32||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "gauRee guaareree mahalaa 3 ||",
      "translation": "Gauree Gwaarayree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰ ਸੇਵਾ ਜੁਗ ਚਾਰੇ ਹੋਈ ॥",
      "transliteration": "gur sevaa jug chaare hoee ||",
      "translation": "The Guru's service has been performed throughout the four ages.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪੂਰਾ ਜਨੁ ਕਾਰ ਕਮਾਵੈ ਕੋਈ ॥",
      "transliteration": "pooraa jan kaar kamaavai koee ||",
      "translation": "Very few are those perfect ones who do this good deed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਖੁਟੁ ਨਾਮ ਧਨੁ ਹਰਿ ਤੋਟਿ ਨ ਹੋਈ ॥",
      "transliteration": "akhut naam dhan har tot na hoee ||",
      "translation": "The wealth of the Lord's Name is inexhaustible; it shall never be exhausted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਐਥੈ ਸਦਾ ਸੁਖੁ ਦਰਿ ਸੋਭਾ ਹੋਈ ॥੧॥",
      "transliteration": "aithai sadaa sukh dar sobhaa hoee ||1||",
      "translation": "In this world, it brings a constant peace, and at the Lord's Gate, it brings honor. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਏ ਮਨ ਮੇਰੇ ਭਰਮੁ ਨ ਕੀਜੈ ॥",
      "transliteration": "e man mere bharam na keejai ||",
      "translation": "O my mind, have no doubt about this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸੇਵਾ ਅੰਮ੍ਰਿਤ ਰਸੁ ਪੀਜੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "guramukh sevaa a(n)mrit ras peejai ||1|| rahaau ||",
      "translation": "Those Gurmukhs who serve, drink in the Ambrosial Nectar. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵਹਿ ਸੇ ਮਹਾਪੁਰਖ ਸੰਸਾਰੇ ॥",
      "transliteration": "satigur sevahi se mahaapurakh sa(n)saare ||",
      "translation": "Those who serve the True Guru are the greatest people of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਪਿ ਉਧਰੇ ਕੁਲ ਸਗਲ ਨਿਸਤਾਰੇ ॥",
      "transliteration": "aap udhare kul sagal nisataare ||",
      "translation": "They save themselves, and they redeem all their generations as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਰਖਹਿ ਉਰ ਧਾਰੇ ॥",
      "transliteration": "har kaa naam rakhahi ur dhaare ||",
      "translation": "They keep the Name of the Lord clasped tightly to their hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਭਉਜਲ ਉਤਰਹਿ ਪਾਰੇ ॥੨॥",
      "transliteration": "naam rate bhaujal utarahi paare ||2||",
      "translation": "Attuned to the Naam, they cross over the terrifying world-ocean. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵਹਿ ਸਦਾ ਮਨਿ ਦਾਸਾ ॥",
      "transliteration": "satigur sevahi sadaa man daasaa ||",
      "translation": "Serving the True Guru, the mind becomes humble forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਹਉਮੈ ਮਾਰਿ ਕਮਲੁ ਪਰਗਾਸਾ ॥",
      "transliteration": "haumai maar kamal paragaasaa ||",
      "translation": "Egotism is subdued, and the heart-lotus blossoms forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਨਹਦੁ ਵਾਜੈ ਨਿਜ ਘਰਿ ਵਾਸਾ ॥",
      "transliteration": "anahad vaajai nij ghar vaasaa ||",
      "translation": "The Unstruck Melody vibrates, as they dwell within the home of the self.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਘਰ ਮਾਹਿ ਉਦਾਸਾ ॥੩॥",
      "transliteration": "naam rate ghar maahi udaasaa ||3||",
      "translation": "Attuned to the Naam, they remain detached within their own home. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵਹਿ ਤਿਨ ਕੀ ਸਚੀ ਬਾਣੀ ॥",
      "transliteration": "satigur sevahi tin kee sachee baanee ||",
      "translation": "Serving the True Guru, their words are true.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜੁਗੁ ਜੁਗੁ ਭਗਤੀ ਆਖਿ ਵਖਾਣੀ ॥",
      "transliteration": "jug jug bhagatee aakh vakhaanee ||",
      "translation": "Throughout the ages, the devotees chant and repeat these words.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0161_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਅਨਦਿਨੁ ਜਪਹਿ ਹਰਿ ਸਾਰੰਗਪਾਣੀ ॥",
      "transliteration": "anadin japahi har saara(n)gapaanee ||",
      "translation": "Night and day, they meditate on the Lord, the Sustainer of the Earth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 161,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
