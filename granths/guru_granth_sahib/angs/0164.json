{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 164,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0164_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੰਨਿਆਸੀ ਬਿਭੂਤ ਲਾਇ ਦੇਹ ਸਵਾਰੀ ॥",
      "transliteration": "sa(n)niaasee bibhoot laai deh savaaree ||",
      "translation": "The Sannyaasee smears his body with ashes;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪਰ ਤ੍ਰਿਅ ਤਿਆਗੁ ਕਰੀ ਬ੍ਰਹਮਚਾਰੀ ॥",
      "transliteration": "par tri tiaag karee brahamachaaree ||",
      "translation": "renouncing other men's women, he practices celibacy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੈ ਮੂਰਖ ਹਰਿ ਆਸ ਤੁਮਾਰੀ ॥੨॥",
      "transliteration": "mai moorakh har aas tumaaree ||2||",
      "translation": "I am just a fool, Lord; I place my hopes in You! ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਖਤ੍ਰੀ ਕਰਮ ਕਰੇ ਸੂਰਤਣੁ ਪਾਵੈ ॥",
      "transliteration": "khatree karam kare sooratan paavai ||",
      "translation": "The Kh'shaatriya acts bravely, and is recognized as a warrior.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੂਦੁ ਵੈਸੁ ਪਰ ਕਿਰਤਿ ਕਮਾਵੈ ॥",
      "transliteration": "sood vais par kirat kamaavai ||",
      "translation": "The Shoodra and the Vaisha work and slave for others;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੈ ਮੂਰਖ ਹਰਿ ਨਾਮੁ ਛਡਾਵੈ ॥੩॥",
      "transliteration": "mai moorakh har naam chhadaavai ||3||",
      "translation": "I am just a fool - I am saved by the Lord's Name. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਭ ਤੇਰੀ ਸ੍ਰਿਸਟਿ ਤੂੰ ਆਪਿ ਰਹਿਆ ਸਮਾਈ ॥",
      "transliteration": "sabh teree srisat too(n) aap rahiaa samaaee ||",
      "translation": "The entire Universe is Yours; You Yourself permeate and pervade it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਨਕ ਦੇ ਵਡਿਆਈ ॥",
      "transliteration": "guramukh naanak de vadiaaee ||",
      "translation": "O Nanak, the Gurmukhs are blessed with glorious greatness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮੈ ਅੰਧੁਲੇ ਹਰਿ ਟੇਕ ਟਿਕਾਈ ॥੪॥੧॥੩੯॥",
      "transliteration": "mai a(n)dhule har tek tikaaee ||4||1||39||",
      "translation": "I am blind - I have taken the Lord as my Support. ||4||1||39||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੪ ॥",
      "transliteration": "gauRee guaareree mahalaa 4 ||",
      "translation": "Gauree Gwaarayree, Fourth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਿਰਗੁਣ ਕਥਾ ਕਥਾ ਹੈ ਹਰਿ ਕੀ ॥",
      "transliteration": "niragun kathaa kathaa hai har kee ||",
      "translation": "The Speech of the Lord is the most sublime speech, free of any attributes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਜੁ ਮਿਲਿ ਸਾਧੂ ਸੰਗਤਿ ਜਨ ਕੀ ॥",
      "transliteration": "bhaj mil saadhoo sa(n)gat jan kee ||",
      "translation": "Vibrate on it, meditate on it, and join the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਰੁ ਭਉਜਲੁ ਅਕਥ ਕਥਾ ਸੁਨਿ ਹਰਿ ਕੀ ॥੧॥",
      "transliteration": "tar bhaujal akath kathaa sun har kee ||1||",
      "translation": "Cross over the terrifying world-ocean, listening to the Unspoken Speech of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗੋਬਿੰਦ ਸਤਸੰਗਤਿ ਮੇਲਾਇ ॥",
      "transliteration": "gobi(n)d satasa(n)gat melaai ||",
      "translation": "O Lord of the Universe, unite me with the Sat Sangat, the True Congregation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹਰਿ ਰਸੁ ਰਸਨਾ ਰਾਮ ਗੁਨ ਗਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har ras rasanaa raam gun gaai ||1|| rahaau ||",
      "translation": "My tongue savors the sublime essence of the Lord, singing the Lord's Glorious Praises. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੋ ਜਨ ਧਿਆਵਹਿ ਹਰਿ ਹਰਿ ਨਾਮਾ ॥",
      "transliteration": "jo jan dhiaavahi har har naamaa ||",
      "translation": "Those humble beings who meditate on the Name of the Lord, Har, Har",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਿਨ ਦਾਸਨਿ ਦਾਸ ਕਰਹੁ ਹਮ ਰਾਮਾ ॥",
      "transliteration": "tin daasan daas karahu ham raamaa ||",
      "translation": "please make me the slave of their slaves, Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਨ ਕੀ ਸੇਵਾ ਊਤਮ ਕਾਮਾ ॥੨॥",
      "transliteration": "jan kee sevaa ootam kaamaa ||2||",
      "translation": "Serving Your slaves is the ultimate good deed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੋ ਹਰਿ ਕੀ ਹਰਿ ਕਥਾ ਸੁਣਾਵੈ ॥",
      "transliteration": "jo har kee har kathaa sunaavai ||",
      "translation": "One who chants the Speech of the Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋ ਜਨੁ ਹਮਰੈ ਮਨਿ ਚਿਤਿ ਭਾਵੈ ॥",
      "transliteration": "so jan hamarai man chit bhaavai ||",
      "translation": "that humble servant is pleasing to my conscious mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਨ ਪਗ ਰੇਣੁ ਵਡਭਾਗੀ ਪਾਵੈ ॥੩॥",
      "transliteration": "jan pag ren vadabhaagee paavai ||3||",
      "translation": "Those who are blessed with great good fortune obtain the dust of the feet of the humble. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਸਿਉ ਪ੍ਰੀਤਿ ਬਨਿ ਆਈ ॥",
      "transliteration": "sa(n)t janaa siu preet ban aaee ||",
      "translation": "Those who are blessed with such pre-ordained destiny",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਿਨ ਕਉ ਲਿਖਤੁ ਲਿਖਿਆ ਧੁਰਿ ਪਾਈ ॥",
      "transliteration": "jin kau likhat likhiaa dhur paaee ||",
      "translation": "Are in love with the humble Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੇ ਜਨ ਨਾਨਕ ਨਾਮਿ ਸਮਾਈ ॥੪॥੨॥੪੦॥",
      "transliteration": "te jan naanak naam samaaee ||4||2||40||",
      "translation": "Those humble beings, O Nanak, are absorbed in the Naam, the Name of the Lord. ||4||2||40||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੪ ॥",
      "transliteration": "gauRee guaareree mahalaa 4 ||",
      "translation": "Gauree Gwaarayree, Fourth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਾਤਾ ਪ੍ਰੀਤਿ ਕਰੇ ਪੁਤੁ ਖਾਇ ॥",
      "transliteration": "maataa preet kare put khaai ||",
      "translation": "The mother loves to see her son eat.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮੀਨੇ ਪ੍ਰੀਤਿ ਭਈ ਜਲਿ ਨਾਇ ॥",
      "transliteration": "meene preet bhaee jal naai ||",
      "translation": "The fish loves to bathe in the water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਤਿਗੁਰ ਪ੍ਰੀਤਿ ਗੁਰਸਿਖ ਮੁਖਿ ਪਾਇ ॥੧॥",
      "transliteration": "satigur preet gurasikh mukh paai ||1||",
      "translation": "The True Guru loves to place food in the mouth of His GurSikh. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੇ ਹਰਿ ਜਨ ਹਰਿ ਮੇਲਹੁ ਹਮ ਪਿਆਰੇ ॥",
      "transliteration": "te har jan har melahu ham piaare ||",
      "translation": "If only I could meet those humble servants of the Lord, O my Beloved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਨ ਮਿਲਿਆ ਦੁਖ ਜਾਹਿ ਹਮਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jin miliaa dukh jaahi hamaare ||1|| rahaau ||",
      "translation": "Meeting with them, my sorrows depart. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਉ ਮਿਲਿ ਬਛਰੇ ਗਊ ਪ੍ਰੀਤਿ ਲਗਾਵੈ ॥",
      "transliteration": "jiu mil bachhare gaoo preet lagaavai ||",
      "translation": "As the cow shows her love to her strayed calf when she finds it,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਾਮਨਿ ਪ੍ਰੀਤਿ ਜਾ ਪਿਰੁ ਘਰਿ ਆਵੈ ॥",
      "transliteration": "kaaman preet jaa pir ghar aavai ||",
      "translation": "and as the bride shows her love for her husband when he returns home,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰਿ ਜਨ ਪ੍ਰੀਤਿ ਜਾ ਹਰਿ ਜਸੁ ਗਾਵੈ ॥੨॥",
      "transliteration": "har jan preet jaa har jas gaavai ||2||",
      "translation": "so does the Lord's humble servant love to sing the Praises of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਾਰਿੰਗ ਪ੍ਰੀਤਿ ਬਸੈ ਜਲ ਧਾਰਾ ॥",
      "transliteration": "saari(n)g preet basai jal dhaaraa ||",
      "translation": "The rainbird loves the rainwater, falling in torrents;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਰਪਤਿ ਪ੍ਰੀਤਿ ਮਾਇਆ ਦੇਖਿ ਪਸਾਰਾ ॥",
      "transliteration": "narapat preet maaiaa dekh pasaaraa ||",
      "translation": "the king loves to see his wealth on display.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਰਿ ਜਨ ਪ੍ਰੀਤਿ ਜਪੈ ਨਿਰੰਕਾਰਾ ॥੩॥",
      "transliteration": "har jan preet japai nira(n)kaaraa ||3||",
      "translation": "The humble servant of the Lord loves to meditate on the Formless Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਰ ਪ੍ਰਾਣੀ ਪ੍ਰੀਤਿ ਮਾਇਆ ਧਨੁ ਖਾਟੇ ॥",
      "transliteration": "nar praanee preet maaiaa dhan khaate ||",
      "translation": "The mortal man loves to accumulate wealth and property.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗੁਰਸਿਖ ਪ੍ਰੀਤਿ ਗੁਰੁ ਮਿਲੈ ਗਲਾਟੇ ॥",
      "transliteration": "gurasikh preet gur milai galaate ||",
      "translation": "The GurSikh loves to meet and embrace the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਪ੍ਰੀਤਿ ਸਾਧ ਪਗ ਚਾਟੇ ॥੪॥੩॥੪੧॥",
      "transliteration": "jan naanak preet saadh pag chaate ||4||3||41||",
      "translation": "Servant Nanak loves to kiss the feet of the Holy. ||4||3||41||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੪ ॥",
      "transliteration": "gauRee guaareree mahalaa 4 ||",
      "translation": "Gauree Gwaarayree, Fourth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੀਖਕ ਪ੍ਰੀਤਿ ਭੀਖ ਪ੍ਰਭ ਪਾਇ ॥",
      "transliteration": "bheekhak preet bheekh prabh paai ||",
      "translation": "The beggar loves to receive charity from the wealthy landlord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭੂਖੇ ਪ੍ਰੀਤਿ ਹੋਵੈ ਅੰਨੁ ਖਾਇ ॥",
      "transliteration": "bhookhe preet hovai a(n)n khaai ||",
      "translation": "The hungry person loves to eat food.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੁਰਸਿਖ ਪ੍ਰੀਤਿ ਗੁਰ ਮਿਲਿ ਆਘਾਇ ॥੧॥",
      "transliteration": "gurasikh preet gur mil aaghaai ||1||",
      "translation": "The GurSikh loves to find satisfaction by meeting the Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਰਿ ਦਰਸਨੁ ਦੇਹੁ ਹਰਿ ਆਸ ਤੁਮਾਰੀ ॥",
      "transliteration": "har darasan dehu har aas tumaaree ||",
      "translation": "O Lord, grant me the Blessed Vision of Your Darshan; I place my hopes in You, Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਲੋਚ ਪੂਰਿ ਹਮਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa loch poor hamaaree ||1|| rahaau ||",
      "translation": "Shower me with Your Mercy, and fulfill my longing. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚਕਵੀ ਪ੍ਰੀਤਿ ਸੂਰਜੁ ਮੁਖਿ ਲਾਗੈ ॥",
      "transliteration": "chakavee preet sooraj mukh laagai ||",
      "translation": "The song-bird loves the sun shining in her face.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਿਲੈ ਪਿਆਰੇ ਸਭ ਦੁਖ ਤਿਆਗੈ ॥",
      "transliteration": "milai piaare sabh dukh tiaagai ||",
      "translation": "Meeting her Beloved, all her pains are left behind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੁਰਸਿਖ ਪ੍ਰੀਤਿ ਗੁਰੂ ਮੁਖਿ ਲਾਗੈ ॥੨॥",
      "transliteration": "gurasikh preet guroo mukh laagai ||2||",
      "translation": "The GurSikh loves to gaze upon the Face of the Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬਛਰੇ ਪ੍ਰੀਤਿ ਖੀਰੁ ਮੁਖਿ ਖਾਇ ॥",
      "transliteration": "bachhare preet kheer mukh khaai ||",
      "translation": "The calf loves to suck its mother's milk;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਹਿਰਦੈ ਬਿਗਸੈ ਦੇਖੈ ਮਾਇ ॥",
      "transliteration": "hiradai bigasai dekhai maai ||",
      "translation": "its heart blossoms forth upon seeing its mother.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗੁਰਸਿਖ ਪ੍ਰੀਤਿ ਗੁਰੂ ਮੁਖਿ ਲਾਇ ॥੩॥",
      "transliteration": "gurasikh preet guroo mukh laai ||3||",
      "translation": "The GurSikh loves to gaze upon the Face of the Guru. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਹੋਰੁ ਸਭ ਪ੍ਰੀਤਿ ਮਾਇਆ ਮੋਹੁ ਕਾਚਾ ॥",
      "transliteration": "hor sabh preet maaiaa mohu kaachaa ||",
      "translation": "All other loves and emotional attachment to Maya are false.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬਿਨਸਿ ਜਾਇ ਕੂਰਾ ਕਚੁ ਪਾਚਾ ॥",
      "transliteration": "binas jaai kooraa kach paachaa ||",
      "translation": "They shall pass away, like false and transitory decorations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0164_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਪ੍ਰੀਤਿ ਤ੍ਰਿਪਤਿ ਗੁਰੁ ਸਾਚਾ ॥੪॥੪॥੪੨॥",
      "transliteration": "jan naanak preet tripat gur saachaa ||4||4||42||",
      "translation": "Servant Nanak is fulfilled, through the Love of the True Guru. ||4||4||42||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 164,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
