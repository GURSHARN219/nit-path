{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 176,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0176_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਸਤੀ ਘੋੜੇ ਦੇਖਿ ਵਿਗਾਸਾ ॥",
      "transliteration": "hasatee ghoRe dekh vigaasaa ||",
      "translation": "He is pleased at the sight of his elephants and horses",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਲਸਕਰ ਜੋੜੇ ਨੇਬ ਖਵਾਸਾ ॥",
      "transliteration": "lasakar joRe neb khavaasaa ||",
      "translation": "and his armies assembled, his servants and his soldiers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗਲਿ ਜੇਵੜੀ ਹਉਮੈ ਕੇ ਫਾਸਾ ॥੨॥",
      "transliteration": "gal jevaRee haumai ke phaasaa ||2||",
      "translation": "But the noose of egotism is tightening around his neck. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਾਜੁ ਕਮਾਵੈ ਦਹ ਦਿਸ ਸਾਰੀ ॥",
      "transliteration": "raaj kamaavai dah dis saaree ||",
      "translation": "His rule may extend in all ten directions;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਾਣੈ ਰੰਗ ਭੋਗ ਬਹੁ ਨਾਰੀ ॥",
      "transliteration": "maanai ra(n)g bhog bahu naaree ||",
      "translation": "he may revel in pleasures, and enjoy many women",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਿਉ ਨਰਪਤਿ ਸੁਪਨੈ ਭੇਖਾਰੀ ॥੩॥",
      "transliteration": "jiu narapat supanai bhekhaaree ||3||",
      "translation": "- but he is just a beggar, who in his dream, is a king. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਏਕੁ ਕੁਸਲੁ ਮੋ ਕਉ ਸਤਿਗੁਰੂ ਬਤਾਇਆ ॥",
      "transliteration": "ek kusal mo kau satiguroo bataaiaa ||",
      "translation": "The True Guru has shown me that there is only one pleasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਰਿ ਜੋ ਕਿਛੁ ਕਰੇ ਸੁ ਹਰਿ ਕਿਆ ਭਗਤਾ ਭਾਇਆ ॥",
      "transliteration": "har jo kichh kare s har kiaa bhagataa bhaaiaa ||",
      "translation": "Whatever the Lord does, is pleasing to the Lord's devotee.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਹਉਮੈ ਮਾਰਿ ਸਮਾਇਆ ॥੪॥",
      "transliteration": "jan naanak haumai maar samaaiaa ||4||",
      "translation": "Servant Nanak has abolished his ego, and he is absorbed in the Lord. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਨਿ ਬਿਧਿ ਕੁਸਲ ਹੋਤ ਮੇਰੇ ਭਾਈ ॥",
      "transliteration": "in bidh kusal hot mere bhaaee ||",
      "translation": "This is the way to find happiness, O my Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਉ ਪਾਈਐ ਹਰਿ ਰਾਮ ਸਹਾਈ ॥੧॥ ਰਹਾਉ ਦੂਜਾ ॥",
      "transliteration": "iu paaeeai har raam sahaaee ||1|| rahaau doojaa ||",
      "translation": "This is the way to find the Lord, our Help and Support. ||1||Second Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਿਉ ਭ੍ਰਮੀਐ ਭ੍ਰਮੁ ਕਿਸ ਕਾ ਹੋਈ ॥",
      "transliteration": "kiu bhrameeai bhram kis kaa hoee ||",
      "translation": "Why do you doubt? What do you doubt?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾ ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ ਰਵਿਆ ਸੋਈ ॥",
      "transliteration": "jaa jal thal maheeal raviaa soee ||",
      "translation": "God is pervading the water, the land and the sky.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਉਬਰੇ ਮਨਮੁਖ ਪਤਿ ਖੋਈ ॥੧॥",
      "transliteration": "guramukh ubare manamukh pat khoee ||1||",
      "translation": "The Gurmukhs are saved, while the self-willed manmukhs lose their honor. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਸੁ ਰਾਖੈ ਆਪਿ ਰਾਮੁ ਦਇਆਰਾ ॥",
      "transliteration": "jis raakhai aap raam daiaaraa ||",
      "translation": "One who is protected by the Merciful Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਿਸੁ ਨਹੀ ਦੂਜਾ ਕੋ ਪਹੁਚਨਹਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tis nahee doojaa ko pahuchanahaaraa ||1|| rahaau ||",
      "translation": "- no one else can rival him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਭ ਮਹਿ ਵਰਤੈ ਏਕੁ ਅਨੰਤਾ ॥",
      "transliteration": "sabh mahi varatai ek ana(n)taa ||",
      "translation": "The Infinite One is pervading among all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਤੂੰ ਸੁਖਿ ਸੋਉ ਹੋਇ ਅਚਿੰਤਾ ॥",
      "transliteration": "taa too(n) sukh sou hoi achi(n)taa ||",
      "translation": "So sleep in peace, and don't worry.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਓਹੁ ਸਭੁ ਕਿਛੁ ਜਾਣੈ ਜੋ ਵਰਤੰਤਾ ॥੨॥",
      "transliteration": "ohu sabh kichh jaanai jo varata(n)taa ||2||",
      "translation": "He knows everything which happens. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਨਮੁਖ ਮੁਏ ਜਿਨ ਦੂਜੀ ਪਿਆਸਾ ॥",
      "transliteration": "manamukh mue jin doojee piaasaa ||",
      "translation": "The self-willed manmukhs are dying in the thirst of duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਹੁ ਜੋਨੀ ਭਵਹਿ ਧੁਰਿ ਕਿਰਤਿ ਲਿਖਿਆਸਾ ॥",
      "transliteration": "bahu jonee bhavahi dhur kirat likhiaasaa ||",
      "translation": "They wander lost through countless incarnations; this is their pre-ordained destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੈਸਾ ਬੀਜਹਿ ਤੈਸਾ ਖਾਸਾ ॥੩॥",
      "transliteration": "jaisaa beejahi taisaa khaasaa ||3||",
      "translation": "As they plant, so shall they harvest. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੇਖਿ ਦਰਸੁ ਮਨਿ ਭਇਆ ਵਿਗਾਸਾ ॥",
      "transliteration": "dekh daras man bhaiaa vigaasaa ||",
      "translation": "Beholding the Blessed Vision of the Lord's Darshan, my mind has blossomed forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਭੁ ਨਦਰੀ ਆਇਆ ਬ੍ਰਹਮੁ ਪਰਗਾਸਾ ॥",
      "transliteration": "sabh nadaree aaiaa braham paragaasaa ||",
      "translation": "And now everywhere I look, God is revealed to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਕੀ ਹਰਿ ਪੂਰਨ ਆਸਾ ॥੪॥੨॥੭੧॥",
      "transliteration": "jan naanak kee har pooran aasaa ||4||2||71||",
      "translation": "Servant Nanak's hopes have been fulfilled by the Lord. ||4||2||71||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਈ ਜਨਮ ਭਏ ਕੀਟ ਪਤੰਗਾ ॥",
      "transliteration": "kaee janam bhae keet pata(n)gaa ||",
      "translation": "In so many incarnations, you were a worm and an insect;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਈ ਜਨਮ ਗਜ ਮੀਨ ਕੁਰੰਗਾ ॥",
      "transliteration": "kaee janam gaj meen kura(n)gaa ||",
      "translation": "in so many incarnations, you were an elephant, a fish and a deer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਈ ਜਨਮ ਪੰਖੀ ਸਰਪ ਹੋਇਓ ॥",
      "transliteration": "kaee janam pa(n)khee sarap hoio ||",
      "translation": "In so many incarnations, you were a bird and a snake.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਈ ਜਨਮ ਹੈਵਰ ਬ੍ਰਿਖ ਜੋਇਓ ॥੧॥",
      "transliteration": "kaee janam haivar brikh joio ||1||",
      "translation": "In so many incarnations, you were yoked as an ox and a horse. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਿਲੁ ਜਗਦੀਸ ਮਿਲਨ ਕੀ ਬਰੀਆ ॥",
      "transliteration": "mil jagadees milan kee bareeaa ||",
      "translation": "Meet the Lord of the Universe - now is the time to meet Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚਿਰੰਕਾਲ ਇਹ ਦੇਹ ਸੰਜਰੀਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "chira(n)kaal ih deh sa(n)jareeaa ||1|| rahaau ||",
      "translation": "After so very long, this human body was fashioned for you. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਈ ਜਨਮ ਸੈਲ ਗਿਰਿ ਕਰਿਆ ॥",
      "transliteration": "kaee janam sail gir kariaa ||",
      "translation": "In so many incarnations, you were rocks and mountains;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਈ ਜਨਮ ਗਰਭ ਹਿਰਿ ਖਰਿਆ ॥",
      "transliteration": "kaee janam garabh hir khariaa ||",
      "translation": "in so many incarnations, you were aborted in the womb;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਈ ਜਨਮ ਸਾਖ ਕਰਿ ਉਪਾਇਆ ॥",
      "transliteration": "kaee janam saakh kar upaaiaa ||",
      "translation": "in so many incarnations, you developed branches and leaves;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਲਖ ਚਉਰਾਸੀਹ ਜੋਨਿ ਭ੍ਰਮਾਇਆ ॥੨॥",
      "transliteration": "lakh chauraaseeh jon bhramaaiaa ||2||",
      "translation": "you wandered through 8.4 million incarnations. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਭਇਓ ਜਨਮੁ ਪਰਾਪਤਿ ॥",
      "transliteration": "saadhasa(n)g bhaio janam paraapat ||",
      "translation": "Through the Saadh Sangat, the Company of the Holy, you obtained this human life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਰਿ ਸੇਵਾ ਭਜੁ ਹਰਿ ਹਰਿ ਗੁਰਮਤਿ ॥",
      "transliteration": "kar sevaa bhaj har har guramat ||",
      "translation": "Do seva - selfless service; follow the Guru's Teachings, and vibrate the Lord's Name, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਿਆਗਿ ਮਾਨੁ ਝੂਠੁ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "tiaag maan jhooth abhimaan ||",
      "translation": "Abandon pride, falsehood and arrogance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੀਵਤ ਮਰਹਿ ਦਰਗਹ ਪਰਵਾਨੁ ॥੩॥",
      "transliteration": "jeevat marahi daragah paravaan ||3||",
      "translation": "Remain dead while yet alive, and you shall be welcomed in the Court of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਹੋਆ ਸੁ ਤੁਝ ਤੇ ਹੋਗੁ ॥",
      "transliteration": "jo kichh hoaa s tujh te hog ||",
      "translation": "Whatever has been, and whatever shall be, comes from You, Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਵਰੁ ਨ ਦੂਜਾ ਕਰਣੈ ਜੋਗੁ ॥",
      "transliteration": "avar na doojaa karanai jog ||",
      "translation": "No one else can do anything at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾ ਮਿਲੀਐ ਜਾ ਲੈਹਿ ਮਿਲਾਇ ॥",
      "transliteration": "taa mileeai jaa laihi milaai ||",
      "translation": "We are united with You, when You unite us with Yourself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਹਰਿ ਹਰਿ ਗੁਣ ਗਾਇ ॥੪॥੩॥੭੨॥",
      "transliteration": "kahu naanak har har gun gaai ||4||3||72||",
      "translation": "Says Nanak, sing the Glorious Praises of the Lord, Har, Har. ||4||3||72||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਰਮ ਭੂਮਿ ਮਹਿ ਬੋਅਹੁ ਨਾਮੁ ॥",
      "transliteration": "karam bhoom mahi boahu naam ||",
      "translation": "In the field of karma, plant the seed of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪੂਰਨ ਹੋਇ ਤੁਮਾਰਾ ਕਾਮੁ ॥",
      "transliteration": "pooran hoi tumaaraa kaam ||",
      "translation": "Your works shall be brought to fruition.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਫਲ ਪਾਵਹਿ ਮਿਟੈ ਜਮ ਤ੍ਰਾਸ ॥",
      "transliteration": "phal paavahi mitai jam traas ||",
      "translation": "You shall obtain these fruits, and the fear of death shall be dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਿਤ ਗਾਵਹਿ ਹਰਿ ਹਰਿ ਗੁਣ ਜਾਸ ॥੧॥",
      "transliteration": "nit gaavahi har har gun jaas ||1||",
      "translation": "Sing continually the Glorious Praises of the Lord, Har, Har. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਅੰਤਰਿ ਉਰਿ ਧਾਰਿ ॥",
      "transliteration": "har har naam a(n)tar ur dhaar ||",
      "translation": "Keep the Name of the Lord, Har, Har, enshrined in your heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੀਘਰ ਕਾਰਜੁ ਲੇਹੁ ਸਵਾਰਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "seeghar kaaraj lehu savaar ||1|| rahaau ||",
      "translation": "and your affairs shall be quickly resolved. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅਪਨੇ ਪ੍ਰਭ ਸਿਉ ਹੋਹੁ ਸਾਵਧਾਨੁ ॥",
      "transliteration": "apane prabh siu hohu saavadhaan ||",
      "translation": "Be always attentive to your God;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0176_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਾ ਤੂੰ ਦਰਗਹ ਪਾਵਹਿ ਮਾਨੁ ॥",
      "transliteration": "taa too(n) daragah paavahi maan ||",
      "translation": "thus you shall be honored in His Court.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 176,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
