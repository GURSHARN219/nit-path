{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 178,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0178_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਅੰਮ੍ਰਿਤ ਰਸੁ ਚਾਖੁ ॥",
      "transliteration": "gur kaa sabad a(n)mrit ras chaakh ||",
      "translation": "Taste the ambrosial essence, the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਵਰਿ ਜਤਨ ਕਹਹੁ ਕਉਨ ਕਾਜ ॥",
      "transliteration": "avar jatan kahahu kaun kaaj ||",
      "translation": "Of what use are other efforts?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਰਾਖੈ ਆਪਿ ਲਾਜ ॥੨॥",
      "transliteration": "kar kirapaa raakhai aap laaj ||2||",
      "translation": "Showing His Mercy, the Lord Himself protects our honor. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿਆ ਮਾਨੁਖ ਕਹਹੁ ਕਿਆ ਜੋਰੁ ॥",
      "transliteration": "kiaa maanukh kahahu kiaa jor ||",
      "translation": "What is the human? What power does he have?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਝੂਠਾ ਮਾਇਆ ਕਾ ਸਭੁ ਸੋਰੁ ॥",
      "transliteration": "jhoothaa maaiaa kaa sabh sor ||",
      "translation": "All the tumult of Maya is false.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਰਣ ਕਰਾਵਨਹਾਰ ਸੁਆਮੀ ॥",
      "transliteration": "karan karaavanahaar suaamee ||",
      "translation": "Our Lord and Master is the One who acts, and causes others to act.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਗਲ ਘਟਾ ਕੇ ਅੰਤਰਜਾਮੀ ॥੩॥",
      "transliteration": "sagal ghataa ke a(n)tarajaamee ||3||",
      "translation": "He is the Inner-knower, the Searcher of all hearts. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਰਬ ਸੁਖਾ ਸੁਖੁ ਸਾਚਾ ਏਹੁ ॥",
      "transliteration": "sarab sukhaa sukh saachaa ehu ||",
      "translation": "Of all comforts, this is the true comfort.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰ ਉਪਦੇਸੁ ਮਨੈ ਮਹਿ ਲੇਹੁ ॥",
      "transliteration": "gur upades manai mahi lehu ||",
      "translation": "Keep the Guru's Teachings in your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾ ਕਉ ਰਾਮ ਨਾਮ ਲਿਵ ਲਾਗੀ ॥",
      "transliteration": "jaa kau raam naam liv laagee ||",
      "translation": "Those who bear love for the Name of the Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਸੋ ਧੰਨੁ ਵਡਭਾਗੀ ॥੪॥੭॥੭੬॥",
      "transliteration": "kahu naanak so dha(n)n vadabhaagee ||4||7||76||",
      "translation": "- says Nanak, they are blessed, and very fortunate. ||4||7||76||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁਣਿ ਹਰਿ ਕਥਾ ਉਤਾਰੀ ਮੈਲੁ ॥",
      "transliteration": "sun har kathaa utaaree mail ||",
      "translation": "Listening to the Lord's sermon, my pollution has been washed away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਹਾ ਪੁਨੀਤ ਭਏ ਸੁਖ ਸੈਲੁ ॥",
      "transliteration": "mahaa puneet bhae sukh sail ||",
      "translation": "I have become totally pure, and I now walk in peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਵਡੈ ਭਾਗਿ ਪਾਇਆ ਸਾਧਸੰਗੁ ॥",
      "transliteration": "vadai bhaag paaiaa saadhasa(n)g ||",
      "translation": "By great good fortune, I found the Saadh Sangat, the Company of the Holy;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਸਿਉ ਲਾਗੋ ਰੰਗੁ ॥੧॥",
      "transliteration": "paarabraham siu laago ra(n)g ||1||",
      "translation": "I have fallen in love with the Supreme Lord God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਪਤ ਜਨੁ ਤਾਰਿਓ ॥",
      "transliteration": "har har naam japat jan taario ||",
      "translation": "Chanting the Name of the Lord, Har, Har, His servant has been carried across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਗਨਿ ਸਾਗਰੁ ਗੁਰਿ ਪਾਰਿ ਉਤਾਰਿਓ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "agan saagar gur paar utaario ||1|| rahaau ||",
      "translation": "The Guru has lifted me up and carried me across the ocean of fire. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਰਿ ਕੀਰਤਨੁ ਮਨ ਸੀਤਲ ਭਏ ॥",
      "transliteration": "kar keeratan man seetal bhae ||",
      "translation": "Singing the Kirtan of His Praises, my mind has become peaceful;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਕਿਲਵਿਖ ਗਏ ॥",
      "transliteration": "janam janam ke kilavikh gae ||",
      "translation": "the sins of countless incarnations have been washed away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਰਬ ਨਿਧਾਨ ਪੇਖੇ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "sarab nidhaan pekhe man maahi ||",
      "translation": "I have seen all the treasures within my own mind;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਬ ਢੂਢਨ ਕਾਹੇ ਕਉ ਜਾਹਿ ॥੨॥",
      "transliteration": "ab dhoodhan kaahe kau jaahi ||2||",
      "translation": "why should I now go out searching for them? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪ੍ਰਭ ਅਪੁਨੇ ਜਬ ਭਏ ਦਇਆਲ ॥",
      "transliteration": "prabh apune jab bhae daiaal ||",
      "translation": "When God Himself becomes merciful,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪੂਰਨ ਹੋਈ ਸੇਵਕ ਘਾਲ ॥",
      "transliteration": "pooran hoee sevak ghaal ||",
      "translation": "the work of His servant becomes perfect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬੰਧਨ ਕਾਟਿ ਕੀਏ ਅਪਨੇ ਦਾਸ ॥",
      "transliteration": "ba(n)dhan kaat keee apane daas ||",
      "translation": "He has cut away my bonds, and made me His slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਸਿਮਰਿ ਗੁਣਤਾਸ ॥੩॥",
      "transliteration": "simar simar simar gunataas ||3||",
      "translation": "Remember, remember, remember Him in meditation; He is the treasure of excellence. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਏਕੋ ਮਨਿ ਏਕੋ ਸਭ ਠਾਇ ॥",
      "transliteration": "eko man eko sabh thaai ||",
      "translation": "He alone is in the mind; He alone is everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪੂਰਨ ਪੂਰਿ ਰਹਿਓ ਸਭ ਜਾਇ ॥",
      "transliteration": "pooran poor rahio sabh jaai ||",
      "translation": "The Perfect Lord is totally permeating and pervading everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਸਭੁ ਭਰਮੁ ਚੁਕਾਇਆ ॥",
      "transliteration": "gur poorai sabh bharam chukaaiaa ||",
      "translation": "The Perfect Guru has dispelled all doubts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਨਾਨਕ ਸੁਖੁ ਪਾਇਆ ॥੪॥੮॥੭੭॥",
      "transliteration": "har simarat naanak sukh paaiaa ||4||8||77||",
      "translation": "Remembering the Lord in meditation, Nanak has found peace. ||4||8||77||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਗਲੇ ਮੁਏ ਸਿ ਪਾਛੈ ਪਰੇ ॥",
      "transliteration": "agale mue s paachhai pare ||",
      "translation": "Those who have died have been forgotten.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜੋ ਉਬਰੇ ਸੇ ਬੰਧਿ ਲਕੁ ਖਰੇ ॥",
      "transliteration": "jo ubare se ba(n)dh lak khare ||",
      "translation": "Those who survive have fastened their belts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਿਹ ਧੰਧੇ ਮਹਿ ਓਇ ਲਪਟਾਏ ॥",
      "transliteration": "jih dha(n)dhe mahi oi lapataae ||",
      "translation": "They are busily occupied in their affairs;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਉਨ ਤੇ ਦੁਗੁਣ ਦਿੜੀ ਉਨ ਮਾਏ ॥੧॥",
      "transliteration": "un te dugun diRee un maae ||1||",
      "translation": "they cling twice as hard to Maya. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਓਹ ਬੇਲਾ ਕਛੁ ਚੀਤਿ ਨ ਆਵੈ ॥",
      "transliteration": "oh belaa kachh cheet na aavai ||",
      "translation": "No one thinks of the time of death;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਿਨਸਿ ਜਾਇ ਤਾਹੂ ਲਪਟਾਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "binas jaai taahoo lapataavai ||1|| rahaau ||",
      "translation": "people grasp to hold that which shall pass away. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਸਾ ਬੰਧੀ ਮੂਰਖ ਦੇਹ ॥",
      "transliteration": "aasaa ba(n)dhee moorakh deh ||",
      "translation": "The fools - their bodies are bound down by desires.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਲਪਟਿਓ ਅਸਨੇਹ ॥",
      "transliteration": "kaam krodh lapatio asaneh ||",
      "translation": "They are mired in sexual desire, anger and attachment;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਿਰ ਊਪਰਿ ਠਾਢੋ ਧਰਮ ਰਾਇ ॥",
      "transliteration": "sir oopar thaadho dharam raai ||",
      "translation": "the Righteous Judge of Dharma stands over their heads.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮੀਠੀ ਕਰਿ ਕਰਿ ਬਿਖਿਆ ਖਾਇ ॥੨॥",
      "transliteration": "meethee kar kar bikhiaa khaai ||2||",
      "translation": "Believing it to be sweet, the fools eat poison. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਉ ਬੰਧਉ ਹਉ ਸਾਧਉ ਬੈਰੁ ॥",
      "transliteration": "hau ba(n)dhau hau saadhau bair ||",
      "translation": "They say, \"I shall tie up my enemy, and I shall cut him down.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਮਰੀ ਭੂਮਿ ਕਉਣੁ ਘਾਲੈ ਪੈਰੁ ॥",
      "transliteration": "hamaree bhoom kaun ghaalai pair ||",
      "translation": "Who dares to set foot upon my land?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਉ ਪੰਡਿਤੁ ਹਉ ਚਤੁਰੁ ਸਿਆਣਾ ॥",
      "transliteration": "hau pa(n)dit hau chatur siaanaa ||",
      "translation": "I am learned, I am clever and wise.\"",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਰਣੈਹਾਰੁ ਨ ਬੁਝੈ ਬਿਗਾਨਾ ॥੩॥",
      "transliteration": "karanaihaar na bujhai bigaanaa ||3||",
      "translation": "The ignorant ones do not recognize their Creator. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਪੁਨੀ ਗਤਿ ਮਿਤਿ ਆਪੇ ਜਾਨੈ ॥",
      "transliteration": "apunee gat mit aape jaanai ||",
      "translation": "The Lord Himself knows His Own state and condition.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਿਆ ਕੋ ਕਹੈ ਕਿਆ ਆਖਿ ਵਖਾਨੈ ॥",
      "transliteration": "kiaa ko kahai kiaa aakh vakhaanai ||",
      "translation": "What can anyone say? How can anyone describe Him?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਿਤੁ ਜਿਤੁ ਲਾਵਹਿ ਤਿਤੁ ਤਿਤੁ ਲਗਨਾ ॥",
      "transliteration": "jit jit laavahi tit tit laganaa ||",
      "translation": "Whatever He attaches us to - to that we are attached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਪਨਾ ਭਲਾ ਸਭ ਕਾਹੂ ਮੰਗਨਾ ॥੪॥",
      "transliteration": "apanaa bhalaa sabh kaahoo ma(n)ganaa ||4||",
      "translation": "Everyone begs for their own good. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਭ ਕਿਛੁ ਤੇਰਾ ਤੂੰ ਕਰਣੈਹਾਰੁ ॥",
      "transliteration": "sabh kichh teraa too(n) karanaihaar ||",
      "translation": "Everything is Yours; You are the Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅੰਤੁ ਨਾਹੀ ਕਿਛੁ ਪਾਰਾਵਾਰੁ ॥",
      "transliteration": "a(n)t naahee kichh paaraavaar ||",
      "translation": "You have no end or limitation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਦਾਸ ਅਪਨੇ ਕਉ ਦੀਜੈ ਦਾਨੁ ॥",
      "transliteration": "daas apane kau deejai daan ||",
      "translation": "Please give this gift to Your servant,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਬਹੂ ਨ ਵਿਸਰੈ ਨਾਨਕ ਨਾਮੁ ॥੫॥੯॥੭੮॥",
      "transliteration": "kabahoo na visarai naanak naam ||5||9||78||",
      "translation": "that Nanak might never forget the Naam. ||5||9||78||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਅਨਿਕ ਜਤਨ ਨਹੀ ਹੋਤ ਛੁਟਾਰਾ ॥",
      "transliteration": "anik jatan nahee hot chhutaaraa ||",
      "translation": "By all sorts of efforts, people do not find salvation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਬਹੁਤੁ ਸਿਆਣਪ ਆਗਲ ਭਾਰਾ ॥",
      "transliteration": "bahut siaanap aagal bhaaraa ||",
      "translation": "Through clever tricks, the weight is only piled on more and more.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਹਰਿ ਕੀ ਸੇਵਾ ਨਿਰਮਲ ਹੇਤ ॥",
      "transliteration": "har kee sevaa niramal het ||",
      "translation": "Serving the Lord with a pure heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0178_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਦਰਗਹ ਸੋਭਾ ਸੇਤ ॥੧॥",
      "transliteration": "prabh kee daragah sobhaa set ||1||",
      "translation": "you shall be received with honor at God's Court. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 178,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
