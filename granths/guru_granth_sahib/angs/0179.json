{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 179,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0179_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਨ ਮੇਰੇ ਗਹੁ ਹਰਿ ਨਾਮ ਕਾ ਓਲਾ ॥",
      "transliteration": "man mere gahu har naam kaa olaa ||",
      "translation": "O my mind, hold tight to the Support of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤੁਝੈ ਨ ਲਾਗੈ ਤਾਤਾ ਝੋਲਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tujhai na laagai taataa jholaa ||1|| rahaau ||",
      "translation": "The hot winds shall never even touch you. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਿਉ ਬੋਹਿਥੁ ਭੈ ਸਾਗਰ ਮਾਹਿ ॥",
      "transliteration": "jiu bohith bhai saagar maahi ||",
      "translation": "Like a boat in the ocean of fear;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅੰਧਕਾਰ ਦੀਪਕ ਦੀਪਾਹਿ ॥",
      "transliteration": "a(n)dhakaar deepak deepaahi ||",
      "translation": "like a lamp which illumines the darkness;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਗਨਿ ਸੀਤ ਕਾ ਲਾਹਸਿ ਦੂਖ ॥",
      "transliteration": "agan seet kaa laahas dookh ||",
      "translation": "like fire which takes away the pain of cold",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਮਨਿ ਹੋਵਤ ਸੂਖ ॥੨॥",
      "transliteration": "naam japat man hovat sookh ||2||",
      "translation": "- just so, chanting the Name, the mind becomes peaceful. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਉਤਰਿ ਜਾਇ ਤੇਰੇ ਮਨ ਕੀ ਪਿਆਸ ॥",
      "transliteration": "utar jaai tere man kee piaas ||",
      "translation": "The thirst of your mind shall be quenched,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪੂਰਨ ਹੋਵੈ ਸਗਲੀ ਆਸ ॥",
      "transliteration": "pooran hovai sagalee aas ||",
      "translation": "and all hopes shall be fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਡੋਲੈ ਨਾਹੀ ਤੁਮਰਾ ਚੀਤੁ ॥",
      "transliteration": "dolai naahee tumaraa cheet ||",
      "translation": "Your consciousness shall not waver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਜਪਿ ਗੁਰਮੁਖਿ ਮੀਤ ॥੩॥",
      "transliteration": "a(n)mrit naam jap guramukh meet ||3||",
      "translation": "Meditate on the Ambrosial Naam as Gurmukh, O my friend. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਮੁ ਅਉਖਧੁ ਸੋਈ ਜਨੁ ਪਾਵੈ ॥",
      "transliteration": "naam aukhadh soee jan paavai ||",
      "translation": "He alone receives the panacea, the medicine of the Naam,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਆਪਿ ਦਿਵਾਵੈ ॥",
      "transliteration": "kar kirapaa jis aap divaavai ||",
      "translation": "unto whom the Lord, in His Grace, bestows it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਾ ਕੈ ਹਿਰਦੈ ਵਸੈ ॥",
      "transliteration": "har har naam jaa kai hiradai vasai ||",
      "translation": "One whose heart is filled with the Name of the Lord, Har, Har",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੂਖੁ ਦਰਦੁ ਤਿਹ ਨਾਨਕ ਨਸੈ ॥੪॥੧੦॥੭੯॥",
      "transliteration": "dookh darad tih naanak nasai ||4||10||79||",
      "translation": "- O Nanak, his pains and sorrows are eliminated. ||4||10||79||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁਤੁ ਦਰਬੁ ਕਰਿ ਮਨੁ ਨ ਅਘਾਨਾ ॥",
      "transliteration": "bahut darab kar man na aghaanaa ||",
      "translation": "Even with vast sums of wealth, the mind is not satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਨਿਕ ਰੂਪ ਦੇਖਿ ਨਹ ਪਤੀਆਨਾ ॥",
      "transliteration": "anik roop dekh nah pateeaanaa ||",
      "translation": "Gazing upon countless beauties, the man is not satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪੁਤ੍ਰ ਕਲਤ੍ਰ ਉਰਝਿਓ ਜਾਨਿ ਮੇਰੀ ॥",
      "transliteration": "putr kalatr urajhio jaan meree ||",
      "translation": "He is so involved with his wife and sons - he believes that they belong to him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਓਹ ਬਿਨਸੈ ਓਇ ਭਸਮੈ ਢੇਰੀ ॥੧॥",
      "transliteration": "oh binasai oi bhasamai dheree ||1||",
      "translation": "That wealth shall pass away, and those relatives shall be reduced to ashes. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਭਜਨ ਦੇਖਉ ਬਿਲਲਾਤੇ ॥",
      "transliteration": "bin har bhajan dekhau bilalaate ||",
      "translation": "Without meditating and vibrating on the Lord, they are crying out in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਧ੍ਰਿਗੁ ਤਨੁ ਧ੍ਰਿਗੁ ਧਨੁ ਮਾਇਆ ਸੰਗਿ ਰਾਤੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dhrig tan dhrig dhan maaiaa sa(n)g raate ||1|| rahaau ||",
      "translation": "Their bodies are cursed, and their wealth is cursed - they are imbued with Maya. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਉ ਬਿਗਾਰੀ ਕੈ ਸਿਰਿ ਦੀਜਹਿ ਦਾਮ ॥",
      "transliteration": "jiu bigaaree kai sir deejahi daam ||",
      "translation": "The servant carries the bags of money on his head,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਓਇ ਖਸਮੈ ਕੈ ਗ੍ਰਿਹਿ ਉਨ ਦੂਖ ਸਹਾਮ ॥",
      "transliteration": "oi khasamai kai grihi un dookh sahaam ||",
      "translation": "but it goes to his master's house, and he receives only pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਿਉ ਸੁਪਨੈ ਹੋਇ ਬੈਸਤ ਰਾਜਾ ॥",
      "transliteration": "jiu supanai hoi baisat raajaa ||",
      "translation": "The man sits as a king in his dreams,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨੇਤ੍ਰ ਪਸਾਰੈ ਤਾ ਨਿਰਾਰਥ ਕਾਜਾ ॥੨॥",
      "transliteration": "netr pasaarai taa niraarath kaajaa ||2||",
      "translation": "but when he opens his eyes, he sees that it was all in vain. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਿਉ ਰਾਖਾ ਖੇਤ ਊਪਰਿ ਪਰਾਏ ॥",
      "transliteration": "jiu raakhaa khet oopar paraae ||",
      "translation": "The watchman oversees the field of another,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਖੇਤੁ ਖਸਮ ਕਾ ਰਾਖਾ ਉਠਿ ਜਾਏ ॥",
      "transliteration": "khet khasam kaa raakhaa uth jaae ||",
      "translation": "but the field belongs to his master, while he must get up and depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਉਸੁ ਖੇਤ ਕਾਰਣਿ ਰਾਖਾ ਕੜੈ ॥",
      "transliteration": "us khet kaaran raakhaa kaRai ||",
      "translation": "He works so hard, and suffers for that field,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਸ ਕੈ ਪਾਲੈ ਕਛੂ ਨ ਪੜੈ ॥੩॥",
      "transliteration": "tis kai paalai kachhoo na paRai ||3||",
      "translation": "but still, nothing comes into his hands. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਸ ਕਾ ਰਾਜੁ ਤਿਸੈ ਕਾ ਸੁਪਨਾ ॥",
      "transliteration": "jis kaa raaj tisai kaa supanaa ||",
      "translation": "The dream is His, and the kingdom is His;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਨਿ ਮਾਇਆ ਦੀਨੀ ਤਿਨਿ ਲਾਈ ਤ੍ਰਿਸਨਾ ॥",
      "transliteration": "jin maaiaa deenee tin laaee trisanaa ||",
      "translation": "He who has given the wealth of Maya, has infused the desire for it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਆਪਿ ਬਿਨਾਹੇ ਆਪਿ ਕਰੇ ਰਾਸਿ ॥",
      "transliteration": "aap binaahe aap kare raas ||",
      "translation": "He Himself annihilates, and He Himself restores.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਨਕ ਪ੍ਰਭ ਆਗੈ ਅਰਦਾਸਿ ॥੪॥੧੧॥੮੦॥",
      "transliteration": "naanak prabh aagai aradaas ||4||11||80||",
      "translation": "Nanak offers this prayer to God. ||4||11||80||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਹੁ ਰੰਗ ਮਾਇਆ ਬਹੁ ਬਿਧਿ ਪੇਖੀ ॥",
      "transliteration": "bahu ra(n)g maaiaa bahu bidh pekhee ||",
      "translation": "I have gazed upon the many forms of Maya, in so many ways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਲਮ ਕਾਗਦ ਸਿਆਨਪ ਲੇਖੀ ॥",
      "transliteration": "kalam kaagad siaanap lekhee ||",
      "translation": "With pen and paper, I have written clever things.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਹਰ ਮਲੂਕ ਹੋਇ ਦੇਖਿਆ ਖਾਨ ॥",
      "transliteration": "mahar malook hoi dekhiaa khaan ||",
      "translation": "I have seen what it is to be a chief, a king, and an emperor,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਾ ਤੇ ਨਾਹੀ ਮਨੁ ਤ੍ਰਿਪਤਾਨ ॥੧॥",
      "transliteration": "taa te naahee man tripataan ||1||",
      "translation": "but they do not satisfy the mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੋ ਸੁਖੁ ਮੋ ਕਉ ਸੰਤ ਬਤਾਵਹੁ ॥",
      "transliteration": "so sukh mo kau sa(n)t bataavahu ||",
      "translation": "Show me that peace, O Saints,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤ੍ਰਿਸਨਾ ਬੂਝੈ ਮਨੁ ਤ੍ਰਿਪਤਾਵਹੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "trisanaa boojhai man tripataavahu ||1|| rahaau ||",
      "translation": "which will quench my thirst and satisfy my mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਸੁ ਪਵਨ ਹਸਤਿ ਅਸਵਾਰੀ ॥",
      "transliteration": "as pavan hasat asavaaree ||",
      "translation": "You may have horses as fast as the wind, elephants to ride on,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚੋਆ ਚੰਦਨੁ ਸੇਜ ਸੁੰਦਰਿ ਨਾਰੀ ॥",
      "transliteration": "choaa cha(n)dan sej su(n)dar naaree ||",
      "translation": "sandalwood oil, and beautiful women in bed,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਟ ਨਾਟਿਕ ਆਖਾਰੇ ਗਾਇਆ ॥",
      "transliteration": "nat naatik aakhaare gaaiaa ||",
      "translation": "actors in dramas, singing in theaters",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾ ਮਹਿ ਮਨਿ ਸੰਤੋਖੁ ਨ ਪਾਇਆ ॥੨॥",
      "transliteration": "taa mahi man sa(n)tokh na paaiaa ||2||",
      "translation": "- but even with them, the mind does not find contentment. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਖਤੁ ਸਭਾ ਮੰਡਨ ਦੋਲੀਚੇ ॥",
      "transliteration": "takhat sabhaa ma(n)dan doleeche ||",
      "translation": "You may have a throne at the royal court, with beautiful decorations and soft carpets,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਗਲ ਮੇਵੇ ਸੁੰਦਰ ਬਾਗੀਚੇ ॥",
      "transliteration": "sagal meve su(n)dar baageeche ||",
      "translation": "all sorts of luscious fruits and beautiful gardens,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਖੇੜ ਬਿਰਤਿ ਰਾਜਨ ਕੀ ਲੀਲਾ ॥",
      "transliteration": "aakheR birat raajan kee leelaa ||",
      "translation": "the excitement of the chase and princely pleasures",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਨੁ ਨ ਸੁਹੇਲਾ ਪਰਪੰਚੁ ਹੀਲਾ ॥੩॥",
      "transliteration": "man na suhelaa parapa(n)ch heelaa ||3||",
      "translation": "- but still, the mind is not made happy by such illusory diversions. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਸੰਤਨ ਸਚੁ ਕਹਿਆ ॥",
      "transliteration": "kar kirapaa sa(n)tan sach kahiaa ||",
      "translation": "In their kindness, the Saints have told me of the True One,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਰਬ ਸੂਖ ਇਹੁ ਆਨੰਦੁ ਲਹਿਆ ॥",
      "transliteration": "sarab sookh ihu aana(n)d lahiaa ||",
      "translation": "and so I have obtained all comforts and joy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਹਰਿ ਕੀਰਤਨੁ ਗਾਈਐ ॥",
      "transliteration": "saadhasa(n)g har keeratan gaaeeai ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, I sing the Kirtan of the Lord's Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਵਡਭਾਗੀ ਪਾਈਐ ॥੪॥",
      "transliteration": "kahu naanak vadabhaagee paaeeai ||4||",
      "translation": "Says Nanak, through great good fortune, I have found this. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਾ ਕੈ ਹਰਿ ਧਨੁ ਸੋਈ ਸੁਹੇਲਾ ॥",
      "transliteration": "jaa kai har dhan soee suhelaa ||",
      "translation": "One who obtains the wealth of the Lord becomes happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ ਸਾਧਸੰਗਿ ਮੇਲਾ ॥੧॥ ਰਹਾਉ ਦੂਜਾ ॥੧੨॥੮੧॥",
      "transliteration": "prabh kirapaa te saadhasa(n)g melaa ||1|| rahaau doojaa ||12||81||",
      "translation": "By God's Grace, I have joined the Saadh Sangat. ||1||Second Pause||12||81||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0179_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 179,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
