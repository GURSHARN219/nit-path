{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 180,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0180_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪ੍ਰਾਣੀ ਜਾਣੈ ਇਹੁ ਤਨੁ ਮੇਰਾ ॥",
      "transliteration": "praanee jaanai ihu tan meraa ||",
      "translation": "The mortal claims this body as his own.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਹੁਰਿ ਬਹੁਰਿ ਉਆਹੂ ਲਪਟੇਰਾ ॥",
      "transliteration": "bahur bahur uaahoo lapateraa ||",
      "translation": "Again and again, he clings to it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪੁਤ੍ਰ ਕਲਤ੍ਰ ਗਿਰਸਤ ਕਾ ਫਾਸਾ ॥",
      "transliteration": "putr kalatr girasat kaa phaasaa ||",
      "translation": "He is entangled with his children, his wife and household affairs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹੋਨੁ ਨ ਪਾਈਐ ਰਾਮ ਕੇ ਦਾਸਾ ॥੧॥",
      "transliteration": "hon na paaeeai raam ke daasaa ||1||",
      "translation": "He cannot be the slave of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਵਨ ਸੁ ਬਿਧਿ ਜਿਤੁ ਰਾਮ ਗੁਣ ਗਾਇ ॥",
      "transliteration": "kavan s bidh jit raam gun gaai ||",
      "translation": "What is that way, by which the Lord's Praises might be sung?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਵਨ ਸੁ ਮਤਿ ਜਿਤੁ ਤਰੈ ਇਹ ਮਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kavan s mat jit tarai ih maai ||1|| rahaau ||",
      "translation": "What is that intellect, by which this person might swim across, O mother? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੋ ਭਲਾਈ ਸੋ ਬੁਰਾ ਜਾਨੈ ॥",
      "transliteration": "jo bhalaaee so buraa jaanai ||",
      "translation": "That which is for his own good, he thinks is evil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਾਚੁ ਕਹੈ ਸੋ ਬਿਖੈ ਸਮਾਨੈ ॥",
      "transliteration": "saach kahai so bikhai samaanai ||",
      "translation": "If someone tells him the truth, he looks upon that as poison.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਾਣੈ ਨਾਹੀ ਜੀਤ ਅਰੁ ਹਾਰ ॥",
      "transliteration": "jaanai naahee jeet ar haar ||",
      "translation": "He cannot tell victory from defeat.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਹੁ ਵਲੇਵਾ ਸਾਕਤ ਸੰਸਾਰ ॥੨॥",
      "transliteration": "ihu valevaa saakat sa(n)saar ||2||",
      "translation": "This is the way of life in the world of the faithless cynic. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੋ ਹਲਾਹਲ ਸੋ ਪੀਵੈ ਬਉਰਾ ॥",
      "transliteration": "jo halaahal so peevai bauraa ||",
      "translation": "The demented fool drinks in the deadly poison,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਨਾਮੁ ਜਾਨੈ ਕਰਿ ਕਉਰਾ ॥",
      "transliteration": "a(n)mrit naam jaanai kar kauraa ||",
      "translation": "while he believes the Ambrosial Naam to be bitter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਧਸੰਗ ਕੈ ਨਾਹੀ ਨੇਰਿ ॥",
      "transliteration": "saadhasa(n)g kai naahee ner ||",
      "translation": "He does not even approach the Saadh Sangat, the Company of the Holy;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਲਖ ਚਉਰਾਸੀਹ ਭ੍ਰਮਤਾ ਫੇਰਿ ॥੩॥",
      "transliteration": "lakh chauraaseeh bhramataa pher ||3||",
      "translation": "he wanders lost through 8.4 million incarnations. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਏਕੈ ਜਾਲਿ ਫਹਾਏ ਪੰਖੀ ॥",
      "transliteration": "ekai jaal phahaae pa(n)khee ||",
      "translation": "The birds are caught in the net of Maya;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਸਿ ਰਸਿ ਭੋਗ ਕਰਹਿ ਬਹੁ ਰੰਗੀ ॥",
      "transliteration": "ras ras bhog karahi bahu ra(n)gee ||",
      "translation": "immersed in the pleasures of love, they frolic in so many ways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਿਸੁ ਭਏ ਕ੍ਰਿਪਾਲ ॥",
      "transliteration": "kahu naanak jis bhae kripaal ||",
      "translation": "Says Nanak, the Perfect Guru has cut away the noose from those,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਤਾ ਕੇ ਕਾਟੇ ਜਾਲ ॥੪॥੧੩॥੮੨॥",
      "transliteration": "gur poorai taa ke kaate jaal ||4||13||82||",
      "translation": "Unto whom the Lord has shown His Mercy. ||4||13||82||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਉ ਕਿਰਪਾ ਤੇ ਮਾਰਗੁ ਪਾਈਐ ॥",
      "transliteration": "tau kirapaa te maarag paaeeai ||",
      "translation": "By Your Grace, we find the Way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ ਨਾਮੁ ਧਿਆਈਐ ॥",
      "transliteration": "prabh kirapaa te naam dhiaaeeai ||",
      "translation": "By God's Grace, we meditate on the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ ਬੰਧਨ ਛੁਟੈ ॥",
      "transliteration": "prabh kirapaa te ba(n)dhan chhutai ||",
      "translation": "By God's Grace, we are released from our bondage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਉ ਕਿਰਪਾ ਤੇ ਹਉਮੈ ਤੁਟੈ ॥੧॥",
      "transliteration": "tau kirapaa te haumai tutai ||1||",
      "translation": "By Your Grace, egotism is eradicated. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੁਮ ਲਾਵਹੁ ਤਉ ਲਾਗਹ ਸੇਵ ॥",
      "transliteration": "tum laavahu tau laagah sev ||",
      "translation": "As You assign me, so I take to Your service.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਮ ਤੇ ਕਛੂ ਨ ਹੋਵੈ ਦੇਵ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ham te kachhoo na hovai dev ||1|| rahaau ||",
      "translation": "By myself, I cannot do anything at all, O Divine Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤੁਧੁ ਭਾਵੈ ਤਾ ਗਾਵਾ ਬਾਣੀ ॥",
      "transliteration": "tudh bhaavai taa gaavaa baanee ||",
      "translation": "If it pleases You, then I sing the Word of Your Bani.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੁਧੁ ਭਾਵੈ ਤਾ ਸਚੁ ਵਖਾਣੀ ॥",
      "transliteration": "tudh bhaavai taa sach vakhaanee ||",
      "translation": "If it pleases You, then I speak the Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੁਧੁ ਭਾਵੈ ਤਾ ਸਤਿਗੁਰ ਮਇਆ ॥",
      "transliteration": "tudh bhaavai taa satigur maiaa ||",
      "translation": "If it pleases You, then the True Guru showers His Mercy upon me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਰਬ ਸੁਖਾ ਪ੍ਰਭ ਤੇਰੀ ਦਇਆ ॥੨॥",
      "transliteration": "sarab sukhaa prabh teree daiaa ||2||",
      "translation": "All peace comes by Your Kindness, God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੋ ਤੁਧੁ ਭਾਵੈ ਸੋ ਨਿਰਮਲ ਕਰਮਾ ॥",
      "transliteration": "jo tudh bhaavai so niramal karamaa ||",
      "translation": "Whatever pleases You is a pure action of karma.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੋ ਤੁਧੁ ਭਾਵੈ ਸੋ ਸਚੁ ਧਰਮਾ ॥",
      "transliteration": "jo tudh bhaavai so sach dharamaa ||",
      "translation": "Whatever pleases You is the true faith of Dharma.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਰਬ ਨਿਧਾਨ ਗੁਣ ਤੁਮ ਹੀ ਪਾਸਿ ॥",
      "transliteration": "sarab nidhaan gun tum hee paas ||",
      "translation": "The treasure of all excellence is with You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤੂੰ ਸਾਹਿਬੁ ਸੇਵਕ ਅਰਦਾਸਿ ॥੩॥",
      "transliteration": "too(n) saahib sevak aradaas ||3||",
      "translation": "Your servant prays to You, O Lord and Master. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਨਿਰਮਲੁ ਹੋਇ ਹਰਿ ਰੰਗਿ ॥",
      "transliteration": "man tan niramal hoi har ra(n)g ||",
      "translation": "The mind and body become immaculate through the Lord's Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਰਬ ਸੁਖਾ ਪਾਵਉ ਸਤਸੰਗਿ ॥",
      "transliteration": "sarab sukhaa paavau satasa(n)g ||",
      "translation": "All peace is found in the Sat Sangat, the True Congregation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਮਿ ਤੇਰੈ ਰਹੈ ਮਨੁ ਰਾਤਾ ॥",
      "transliteration": "naam terai rahai man raataa ||",
      "translation": "My mind remains attuned to Your Name;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਹੁ ਕਲਿਆਣੁ ਨਾਨਕ ਕਰਿ ਜਾਤਾ ॥੪॥੧੪॥੮੩॥",
      "transliteration": "ihu kaliaan naanak kar jaataa ||4||14||83||",
      "translation": "Nanak affirms this as his greatest pleasure. ||4||14||83||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਨ ਰਸਾ ਜੇਤੇ ਤੈ ਚਾਖੇ ॥",
      "transliteration": "aan rasaa jete tai chaakhe ||",
      "translation": "You may taste the other flavors,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਿਮਖ ਨ ਤ੍ਰਿਸਨਾ ਤੇਰੀ ਲਾਥੇ ॥",
      "transliteration": "nimakh na trisanaa teree laathe ||",
      "translation": "but your thirst shall not depart, even for an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਰਿ ਰਸ ਕਾ ਤੂੰ ਚਾਖਹਿ ਸਾਦੁ ॥",
      "transliteration": "har ras kaa too(n) chaakhahi saad ||",
      "translation": "But when you taste the sweet flavor the the Lord's sublime essence",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚਾਖਤ ਹੋਇ ਰਹਹਿ ਬਿਸਮਾਦੁ ॥੧॥",
      "transliteration": "chaakhat hoi rahahi bisamaad ||1||",
      "translation": "- upon tasting it, you shall be wonder-struck and amazed. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਰਸਨਾ ਪੀਉ ਪਿਆਰੀ ॥",
      "transliteration": "a(n)mrit rasanaa peeu piaaree ||",
      "translation": "O dear beloved tongue, drink in the Ambrosial Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਹ ਰਸ ਰਾਤੀ ਹੋਇ ਤ੍ਰਿਪਤਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ih ras raatee hoi tripataaree ||1|| rahaau ||",
      "translation": "Imbued with this sublime essence, you shall be satisfied. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹੇ ਜਿਹਵੇ ਤੂੰ ਰਾਮ ਗੁਣ ਗਾਉ ॥",
      "transliteration": "he jihave too(n) raam gun gaau ||",
      "translation": "O tongue, sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਿਮਖ ਨਿਮਖ ਹਰਿ ਹਰਿ ਹਰਿ ਧਿਆਉ ॥",
      "transliteration": "nimakh nimakh har har har dhiaau ||",
      "translation": "Each and every moment, meditate on the Lord, Har, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਨ ਨ ਸੁਨੀਐ ਕਤਹੂੰ ਜਾਈਐ ॥",
      "transliteration": "aan na suneeai katahoo(n) jaaeeai ||",
      "translation": "Do not listen to any other, and do not go anywhere else.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਵਡਭਾਗੀ ਪਾਈਐ ॥੨॥",
      "transliteration": "saadhasa(n)gat vadabhaagee paaeeai ||2||",
      "translation": "By great good fortune, you shall find the Saadh Sangat, the Company of the Holy. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਆਠ ਪਹਰ ਜਿਹਵੇ ਆਰਾਧਿ ॥",
      "transliteration": "aath pahar jihave aaraadh ||",
      "translation": "Twenty-four hours a day, O tongue, dwell upon God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਠਾਕੁਰ ਆਗਾਧਿ ॥",
      "transliteration": "paarabraham thaakur aagaadh ||",
      "translation": "The Unfathomable, Supreme Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਈਹਾ ਊਹਾ ਸਦਾ ਸੁਹੇਲੀ ॥",
      "transliteration": "eehaa oohaa sadaa suhelee ||",
      "translation": "Here and hereafter, you shall be happy forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਗਾਵਤ ਰਸਨ ਅਮੋਲੀ ॥੩॥",
      "transliteration": "har gun gaavat rasan amolee ||3||",
      "translation": "Chanting the Glorious Praises of the Lord, O tongue, you shall become priceless. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬਨਸਪਤਿ ਮਉਲੀ ਫਲ ਫੁਲ ਪੇਡੇ ॥",
      "transliteration": "banasapat maulee phal phul pede ||",
      "translation": "All the vegetation will blossom forth for you, flowering in fruition;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਇਹ ਰਸ ਰਾਤੀ ਬਹੁਰਿ ਨ ਛੋਡੇ ॥",
      "transliteration": "ih ras raatee bahur na chhode ||",
      "translation": "imbued with this sublime essence, you shall never leave it again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਆਨ ਨ ਰਸ ਕਸ ਲਵੈ ਨ ਲਾਈ ॥",
      "transliteration": "aan na ras kas lavai na laaee ||",
      "translation": "No other sweet and tasty flavors can compare to it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰ ਭਏ ਹੈ ਸਹਾਈ ॥੪॥੧੫॥੮੪॥",
      "transliteration": "kahu naanak gur bhae hai sahaaee ||4||15||84||",
      "translation": "Says Nanak, the Guru has become my Support. ||4||15||84||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0180_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਮਨੁ ਮੰਦਰੁ ਤਨੁ ਸਾਜੀ ਬਾਰਿ ॥",
      "transliteration": "man ma(n)dar tan saajee baar ||",
      "translation": "The mind is the temple, and the body is the fence built around it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 180,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
