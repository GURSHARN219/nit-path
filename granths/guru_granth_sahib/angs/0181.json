{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 181,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0181_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਸ ਹੀ ਮਧੇ ਬਸਤੁ ਅਪਾਰ ॥",
      "transliteration": "is hee madhe basat apaar ||",
      "translation": "The infinite substance is within it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਸ ਹੀ ਭੀਤਰਿ ਸੁਨੀਅਤ ਸਾਹੁ ॥",
      "transliteration": "is hee bheetar suneeat saahu ||",
      "translation": "Within it, the great merchant is said to dwell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਵਨੁ ਬਾਪਾਰੀ ਜਾ ਕਾ ਊਹਾ ਵਿਸਾਹੁ ॥੧॥",
      "transliteration": "kavan baapaaree jaa kaa oohaa visaahu ||1||",
      "translation": "Who is the trader who deals there? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਮ ਰਤਨ ਕੋ ਕੋ ਬਿਉਹਾਰੀ ॥",
      "transliteration": "naam ratan ko ko biuhaaree ||",
      "translation": "How rare is that trader who deals in the jewel of the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਭੋਜਨੁ ਕਰੇ ਆਹਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "a(n)mrit bhojan kare aahaaree ||1|| rahaau ||",
      "translation": "He takes the Ambrosial Nectar as his food. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਅਰਪੀ ਸੇਵ ਕਰੀਜੈ ॥",
      "transliteration": "man tan arapee sev kareejai ||",
      "translation": "He dedicates his mind and body to serving the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਵਨ ਸੁ ਜੁਗਤਿ ਜਿਤੁ ਕਰਿ ਭੀਜੈ ॥",
      "transliteration": "kavan s jugat jit kar bheejai ||",
      "translation": "How can we please the Lord?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਾਇ ਲਗਉ ਤਜਿ ਮੇਰਾ ਤੇਰੈ ॥",
      "transliteration": "paai lagau taj meraa terai ||",
      "translation": "I fall at His Feet, and I renounce all sense of 'mine and yours'.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਵਨੁ ਸੁ ਜਨੁ ਜੋ ਸਉਦਾ ਜੋਰੈ ॥੨॥",
      "transliteration": "kavan s jan jo saudaa jorai ||2||",
      "translation": "Who can settle this bargain? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਹਲੁ ਸਾਹ ਕਾ ਕਿਨ ਬਿਧਿ ਪਾਵੈ ॥",
      "transliteration": "mahal saah kaa kin bidh paavai ||",
      "translation": "How can I attain the Mansion of the Lord's Presence?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਵਨ ਸੁ ਬਿਧਿ ਜਿਤੁ ਭੀਤਰਿ ਬੁਲਾਵੈ ॥",
      "transliteration": "kavan s bidh jit bheetar bulaavai ||",
      "translation": "How can I get Him to call me inside?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੂੰ ਵਡ ਸਾਹੁ ਜਾ ਕੇ ਕੋਟਿ ਵਣਜਾਰੇ ॥",
      "transliteration": "too(n) vad saahu jaa ke kot vanajaare ||",
      "translation": "You are the Great Merchant; You have millions of traders.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਵਨੁ ਸੁ ਦਾਤਾ ਲੇ ਸੰਚਾਰੇ ॥੩॥",
      "transliteration": "kavan s daataa le sa(n)chaare ||3||",
      "translation": "Who is the benefactor? Who can take me to Him? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਖੋਜਤ ਖੋਜਤ ਨਿਜ ਘਰੁ ਪਾਇਆ ॥",
      "transliteration": "khojat khojat nij ghar paaiaa ||",
      "translation": "Seeking and searching, I have found my own home, deep within my own being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਮੋਲ ਰਤਨੁ ਸਾਚੁ ਦਿਖਲਾਇਆ ॥",
      "transliteration": "amol ratan saach dikhalaaiaa ||",
      "translation": "The True Lord has shown me the priceless jewel.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਬ ਮੇਲੇ ਸਾਹਿ ॥",
      "transliteration": "kar kirapaa jab mele saahi ||",
      "translation": "When the Great Merchant shows His Mercy, He blends us into Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰ ਕੈ ਵੇਸਾਹਿ ॥੪॥੧੬॥੮੫॥",
      "transliteration": "kahu naanak gur kai vesaahi ||4||16||85||",
      "translation": "Says Nanak, place your faith in the Guru. ||4||16||85||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ਗੁਆਰੇਰੀ ॥",
      "transliteration": "gauRee mahalaa 5 guaareree ||",
      "translation": "Gauree, Fifth Mehl, Gwaarayree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰੈਣਿ ਦਿਨਸੁ ਰਹੈ ਇਕ ਰੰਗਾ ॥",
      "transliteration": "rain dinas rahai ik ra(n)gaa ||",
      "translation": "Night and day, they remain in the Love of the One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਜਾਣੈ ਸਦ ਹੀ ਸੰਗਾ ॥",
      "transliteration": "prabh kau jaanai sad hee sa(n)gaa ||",
      "translation": "They know that God is always with them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਠਾਕੁਰ ਨਾਮੁ ਕੀਓ ਉਨਿ ਵਰਤਨਿ ॥",
      "transliteration": "thaakur naam keeo un varatan ||",
      "translation": "They make the Name of their Lord and Master their way of life;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤ੍ਰਿਪਤਿ ਅਘਾਵਨੁ ਹਰਿ ਕੈ ਦਰਸਨਿ ॥੧॥",
      "transliteration": "tripat aghaavan har kai darasan ||1||",
      "translation": "they are satisfied and fulfilled with the Blessed Vision of the Lord's Darshan. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ ਮਨ ਤਨ ਹਰੇ ॥",
      "transliteration": "har sa(n)g raate man tan hare ||",
      "translation": "Imbued with the Love of the Lord, their minds and bodies are rejuvenated,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕੀ ਸਰਨੀ ਪਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur poore kee saranee pare ||1|| rahaau ||",
      "translation": "entering the Sanctuary of the Perfect Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚਰਣ ਕਮਲ ਆਤਮ ਆਧਾਰ ॥",
      "transliteration": "charan kamal aatam aadhaar ||",
      "translation": "The Lord's Lotus Feet are the Support of the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਏਕੁ ਨਿਹਾਰਹਿ ਆਗਿਆਕਾਰ ॥",
      "transliteration": "ek nihaarahi aagiaakaar ||",
      "translation": "They see only the One, and obey His Order.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਏਕੋ ਬਨਜੁ ਏਕੋ ਬਿਉਹਾਰੀ ॥",
      "transliteration": "eko banaj eko biuhaaree ||",
      "translation": "There is only one trade, and one occupation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਵਰੁ ਨ ਜਾਨਹਿ ਬਿਨੁ ਨਿਰੰਕਾਰੀ ॥੨॥",
      "transliteration": "avar na jaanahi bin nira(n)kaaree ||2||",
      "translation": "They know no other than the Formless Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਰਖ ਸੋਗ ਦੁਹਹੂੰ ਤੇ ਮੁਕਤੇ ॥",
      "transliteration": "harakh sog duhahoo(n) te mukate ||",
      "translation": "They are free of both pleasure and pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਦਾ ਅਲਿਪਤੁ ਜੋਗ ਅਰੁ ਜੁਗਤੇ ॥",
      "transliteration": "sadaa alipat jog ar jugate ||",
      "translation": "They remain unattached, joined to the Lord's Way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦੀਸਹਿ ਸਭ ਮਹਿ ਸਭ ਤੇ ਰਹਤੇ ॥",
      "transliteration": "deesahi sabh mahi sabh te rahate ||",
      "translation": "They are seen among all, and yet they are distinct from all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕਾ ਓਇ ਧਿਆਨੁ ਧਰਤੇ ॥੩॥",
      "transliteration": "paarabraham kaa oi dhiaan dharate ||3||",
      "translation": "They focus their meditation on the Supreme Lord God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੰਤਨ ਕੀ ਮਹਿਮਾ ਕਵਨ ਵਖਾਨਉ ॥",
      "transliteration": "sa(n)tan kee mahimaa kavan vakhaanau ||",
      "translation": "How can I describe the Glories of the Saints?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਗਾਧਿ ਬੋਧਿ ਕਿਛੁ ਮਿਤਿ ਨਹੀ ਜਾਨਉ ॥",
      "transliteration": "agaadh bodh kichh mit nahee jaanau ||",
      "translation": "Their knowledge is unfathomable; their limits cannot be known.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਮੋਹਿ ਕਿਰਪਾ ਕੀਜੈ ॥",
      "transliteration": "paarabraham mohi kirapaa keejai ||",
      "translation": "O Supreme Lord God, please shower Your Mercy upon me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਧੂਰਿ ਸੰਤਨ ਕੀ ਨਾਨਕ ਦੀਜੈ ॥੪॥੧੭॥੮੬॥",
      "transliteration": "dhoor sa(n)tan kee naanak deejai ||4||17||86||",
      "translation": "Bless Nanak with the dust of the feet of the Saints. ||4||17||86||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੂੰ ਮੇਰਾ ਸਖਾ ਤੂੰਹੀ ਮੇਰਾ ਮੀਤੁ ॥",
      "transliteration": "too(n) meraa sakhaa too(n)hee meraa meet ||",
      "translation": "You are my Companion; You are my Best Friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੂੰ ਮੇਰਾ ਪ੍ਰੀਤਮੁ ਤੁਮ ਸੰਗਿ ਹੀਤੁ ॥",
      "transliteration": "too(n) meraa preetam tum sa(n)g heet ||",
      "translation": "You are my Beloved; I am in love with You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤੂੰ ਮੇਰੀ ਪਤਿ ਤੂਹੈ ਮੇਰਾ ਗਹਣਾ ॥",
      "transliteration": "too(n) meree pat toohai meraa gahanaa ||",
      "translation": "You are my honor; You are my decoration.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੁਝ ਬਿਨੁ ਨਿਮਖੁ ਨ ਜਾਈ ਰਹਣਾ ॥੧॥",
      "transliteration": "tujh bin nimakh na jaaee rahanaa ||1||",
      "translation": "Without You, I cannot survive, even for an instant. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤੂੰ ਮੇਰੇ ਲਾਲਨ ਤੂੰ ਮੇਰੇ ਪ੍ਰਾਨ ॥",
      "transliteration": "too(n) mere laalan too(n) mere praan ||",
      "translation": "You are my Intimate Beloved, You are my breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੂੰ ਮੇਰੇ ਸਾਹਿਬ ਤੂੰ ਮੇਰੇ ਖਾਨ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "too(n) mere saahib too(n) mere khaan ||1|| rahaau ||",
      "translation": "You are my Lord and Master; You are my Leader. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਉ ਤੁਮ ਰਾਖਹੁ ਤਿਵ ਹੀ ਰਹਨਾ ॥",
      "transliteration": "jiu tum raakhahu tiv hee rahanaa ||",
      "translation": "As You keep me, so do I survive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੋ ਤੁਮ ਕਹਹੁ ਸੋਈ ਮੋਹਿ ਕਰਨਾ ॥",
      "transliteration": "jo tum kahahu soee mohi karanaa ||",
      "translation": "Whatever You say, that is what I do.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਹ ਪੇਖਉ ਤਹਾ ਤੁਮ ਬਸਨਾ ॥",
      "transliteration": "jah pekhau tahaa tum basanaa ||",
      "translation": "Wherever I look, there I see You dwelling.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਿਰਭਉ ਨਾਮੁ ਜਪਉ ਤੇਰਾ ਰਸਨਾ ॥੨॥",
      "transliteration": "nirabhau naam japau teraa rasanaa ||2||",
      "translation": "O my Fearless Lord, with my tongue, I chant Your Name. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤੂੰ ਮੇਰੀ ਨਵ ਨਿਧਿ ਤੂੰ ਭੰਡਾਰੁ ॥",
      "transliteration": "too(n) meree nav nidh too(n) bha(n)daar ||",
      "translation": "You are my nine treasures, You are my storehouse.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਰੰਗ ਰਸਾ ਤੂੰ ਮਨਹਿ ਅਧਾਰੁ ॥",
      "transliteration": "ra(n)g rasaa too(n) manahi adhaar ||",
      "translation": "I am imbued with Your Love; You are the Support of my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤੂੰ ਮੇਰੀ ਸੋਭਾ ਤੁਮ ਸੰਗਿ ਰਚੀਆ ॥",
      "transliteration": "too(n) meree sobhaa tum sa(n)g racheeaa ||",
      "translation": "You are my Glory; I am blended with You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤੂੰ ਮੇਰੀ ਓਟ ਤੂੰ ਹੈ ਮੇਰਾ ਤਕੀਆ ॥੩॥",
      "transliteration": "too(n) meree ot too(n) hai meraa takeeaa ||3||",
      "translation": "You are my Shelter; You are my Anchoring Support. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਨ ਤਨ ਅੰਤਰਿ ਤੁਹੀ ਧਿਆਇਆ ॥",
      "transliteration": "man tan a(n)tar tuhee dhiaaiaa ||",
      "translation": "Deep within my mind and body, I meditate on You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਰਮੁ ਤੁਮਾਰਾ ਗੁਰ ਤੇ ਪਾਇਆ ॥",
      "transliteration": "maram tumaaraa gur te paaiaa ||",
      "translation": "I have obtained Your secret from the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਤਿਗੁਰ ਤੇ ਦ੍ਰਿੜਿਆ ਇਕੁ ਏਕੈ ॥",
      "transliteration": "satigur te driRiaa ik ekai ||",
      "translation": "Through the True Guru, the One and only Lord was implanted within me;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਹਰਿ ਹਰਿ ਹਰਿ ਟੇਕੈ ॥੪॥੧੮॥੮੭॥",
      "transliteration": "naanak daas har har har tekai ||4||18||87||",
      "translation": "servant Nanak has taken to the Support of the Lord, Har, Har, Har. ||4||18||87||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0181_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 181,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
