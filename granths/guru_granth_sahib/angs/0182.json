{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 182,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0182_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਿਆਪਤ ਹਰਖ ਸੋਗ ਬਿਸਥਾਰ ॥",
      "transliteration": "biaapat harakh sog bisathaar ||",
      "translation": "It torments us with the expression of pleasure and pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਆਪਤ ਸੁਰਗ ਨਰਕ ਅਵਤਾਰ ॥",
      "transliteration": "biaapat surag narak avataar ||",
      "translation": "It torments us through incarnations in heaven and hell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਆਪਤ ਧਨ ਨਿਰਧਨ ਪੇਖਿ ਸੋਭਾ ॥",
      "transliteration": "biaapat dhan niradhan pekh sobhaa ||",
      "translation": "It is seen to afflict the rich, the poor and the glorious.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮੂਲੁ ਬਿਆਧੀ ਬਿਆਪਸਿ ਲੋਭਾ ॥੧॥",
      "transliteration": "mool biaadhee biaapas lobhaa ||1||",
      "translation": "The source of this illness which torments us is greed. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਾਇਆ ਬਿਆਪਤ ਬਹੁ ਪਰਕਾਰੀ ॥",
      "transliteration": "maaiaa biaapat bahu parakaaree ||",
      "translation": "Maya torments us in so many ways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੰਤ ਜੀਵਹਿ ਪ੍ਰਭ ਓਟ ਤੁਮਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sa(n)t jeevahi prabh ot tumaaree ||1|| rahaau ||",
      "translation": "But the Saints live under Your Protection, God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਿਆਪਤ ਅਹੰਬੁਧਿ ਕਾ ਮਾਤਾ ॥",
      "transliteration": "biaapat aha(n)budh kaa maataa ||",
      "translation": "It torments us through intoxication with intellectual pride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਿਆਪਤ ਪੁਤ੍ਰ ਕਲਤ੍ਰ ਸੰਗਿ ਰਾਤਾ ॥",
      "transliteration": "biaapat putr kalatr sa(n)g raataa ||",
      "translation": "It torments us through the love of children and spouse.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਆਪਤ ਹਸਤਿ ਘੋੜੇ ਅਰੁ ਬਸਤਾ ॥",
      "transliteration": "biaapat hasat ghoRe ar basataa ||",
      "translation": "It torments us through elephants, horses and beautiful clothes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਆਪਤ ਰੂਪ ਜੋਬਨ ਮਦ ਮਸਤਾ ॥੨॥",
      "transliteration": "biaapat roop joban mad masataa ||2||",
      "translation": "It torments us through the intoxication of wine and the beauty of youth. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਆਪਤ ਭੂਮਿ ਰੰਕ ਅਰੁ ਰੰਗਾ ॥",
      "transliteration": "biaapat bhoom ra(n)k ar ra(n)gaa ||",
      "translation": "It torments landlords, paupers and lovers of pleasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਿਆਪਤ ਗੀਤ ਨਾਦ ਸੁਣਿ ਸੰਗਾ ॥",
      "transliteration": "biaapat geet naad sun sa(n)gaa ||",
      "translation": "It torments us through the sweet sounds of music and parties.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਿਆਪਤ ਸੇਜ ਮਹਲ ਸੀਗਾਰ ॥",
      "transliteration": "biaapat sej mahal seegaar ||",
      "translation": "It torments us through beautiful beds, palaces and decorations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪੰਚ ਦੂਤ ਬਿਆਪਤ ਅੰਧਿਆਰ ॥੩॥",
      "transliteration": "pa(n)ch doot biaapat a(n)dhiaar ||3||",
      "translation": "It torments us through the darkness of the five evil passions. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਿਆਪਤ ਕਰਮ ਕਰੈ ਹਉ ਫਾਸਾ ॥",
      "transliteration": "biaapat karam karai hau phaasaa ||",
      "translation": "It torments those who act, entangled in ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਿਆਪਤਿ ਗਿਰਸਤ ਬਿਆਪਤ ਉਦਾਸਾ ॥",
      "transliteration": "biaapat girasat biaapat udaasaa ||",
      "translation": "It torments us through household affairs, and it torments us in renunciation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਚਾਰ ਬਿਉਹਾਰ ਬਿਆਪਤ ਇਹ ਜਾਤਿ ॥",
      "transliteration": "aachaar biuhaar biaapat ih jaat ||",
      "translation": "It torments us through character, lifestyle and social status.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਭ ਕਿਛੁ ਬਿਆਪਤ ਬਿਨੁ ਹਰਿ ਰੰਗ ਰਾਤ ॥੪॥",
      "transliteration": "sabh kichh biaapat bin har ra(n)g raat ||4||",
      "translation": "It torments us through everything, except for those who are imbued with the Love of the Lord. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੰਤਨ ਕੇ ਬੰਧਨ ਕਾਟੇ ਹਰਿ ਰਾਇ ॥",
      "transliteration": "sa(n)tan ke ba(n)dhan kaate har raai ||",
      "translation": "The Sovereign Lord King has cut away the bonds of His Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਕਉ ਕਹਾ ਬਿਆਪੈ ਮਾਇ ॥",
      "transliteration": "taa kau kahaa biaapai maai ||",
      "translation": "How can Maya torment them?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਿਨਿ ਧੂਰਿ ਸੰਤ ਪਾਈ ॥",
      "transliteration": "kahu naanak jin dhoor sa(n)t paaee ||",
      "translation": "Says Nanak, Maya does not draw near those",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਕੈ ਨਿਕਟਿ ਨ ਆਵੈ ਮਾਈ ॥੫॥੧੯॥੮੮॥",
      "transliteration": "taa kai nikat na aavai maaee ||5||19||88||",
      "translation": "Who have obtained the dust of the feet of the Saints. ||5||19||88||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨੈਨਹੁ ਨੀਦ ਪਰ ਦ੍ਰਿਸਟਿ ਵਿਕਾਰ ॥",
      "transliteration": "nainahu need par drisat vikaar ||",
      "translation": "The eyes are asleep in corruption, gazing upon the beauty of another.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸ੍ਰਵਣ ਸੋਏ ਸੁਣਿ ਨਿੰਦ ਵੀਚਾਰ ॥",
      "transliteration": "sravan soe sun ni(n)d veechaar ||",
      "translation": "The ears are asleep, listening to slanderous stories.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਸਨਾ ਸੋਈ ਲੋਭਿ ਮੀਠੈ ਸਾਦਿ ॥",
      "transliteration": "rasanaa soee lobh meethai saad ||",
      "translation": "The tongue is asleep, in its desire for sweet flavors.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਨੁ ਸੋਇਆ ਮਾਇਆ ਬਿਸਮਾਦਿ ॥੧॥",
      "transliteration": "man soiaa maaiaa bisamaad ||1||",
      "translation": "The mind is asleep, fascinated by Maya. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਸੁ ਗ੍ਰਿਹ ਮਹਿ ਕੋਈ ਜਾਗਤੁ ਰਹੈ ॥",
      "transliteration": "is grih mahi koee jaagat rahai ||",
      "translation": "Those who remain awake in this house are very rare;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਾਬਤੁ ਵਸਤੁ ਓਹੁ ਅਪਨੀ ਲਹੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saabat vasat ohu apanee lahai ||1|| rahaau ||",
      "translation": "by doing so, they receive the whole thing. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਗਲ ਸਹੇਲੀ ਅਪਨੈ ਰਸ ਮਾਤੀ ॥",
      "transliteration": "sagal sahelee apanai ras maatee ||",
      "translation": "All of my companions are intoxicated with their sensory pleasures;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗ੍ਰਿਹ ਅਪੁਨੇ ਕੀ ਖਬਰਿ ਨ ਜਾਤੀ ॥",
      "transliteration": "grih apune kee khabar na jaatee ||",
      "translation": "they do not know how to guard their own home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੁਸਨਹਾਰ ਪੰਚ ਬਟਵਾਰੇ ॥",
      "transliteration": "musanahaar pa(n)ch batavaare ||",
      "translation": "The five thieves have plundered them;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੂਨੇ ਨਗਰਿ ਪਰੇ ਠਗਹਾਰੇ ॥੨॥",
      "transliteration": "soone nagar pare thagahaare ||2||",
      "translation": "the thugs descend upon the unguarded village. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਉਨ ਤੇ ਰਾਖੈ ਬਾਪੁ ਨ ਮਾਈ ॥",
      "transliteration": "un te raakhai baap na maaee ||",
      "translation": "Our mothers and fathers cannot save us from them;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਉਨ ਤੇ ਰਾਖੈ ਮੀਤੁ ਨ ਭਾਈ ॥",
      "transliteration": "un te raakhai meet na bhaaee ||",
      "translation": "friends and brothers cannot protect us from them",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦਰਬਿ ਸਿਆਣਪ ਨਾ ਓਇ ਰਹਤੇ ॥",
      "transliteration": "darab siaanap naa oi rahate ||",
      "translation": "they cannot be restrained by wealth or cleverness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਓਇ ਦੁਸਟ ਵਸਿ ਹੋਤੇ ॥੩॥",
      "transliteration": "saadhasa(n)g oi dusat vas hote ||3||",
      "translation": "Only through the Saadh Sangat, the Company of the Holy, can those villains be brought under control. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਮੋਹਿ ਸਾਰਿੰਗਪਾਣਿ ॥",
      "transliteration": "kar kirapaa mohi saari(n)gapaan ||",
      "translation": "Have Mercy upon me, O Lord, Sustainer of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੰਤਨ ਧੂਰਿ ਸਰਬ ਨਿਧਾਨ ॥",
      "transliteration": "sa(n)tan dhoor sarab nidhaan ||",
      "translation": "The dust of the feet of the Saints is all the treasure I need.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਾਬਤੁ ਪੂੰਜੀ ਸਤਿਗੁਰ ਸੰਗਿ ॥",
      "transliteration": "saabat poo(n)jee satigur sa(n)g ||",
      "translation": "In the Company of the True Guru, one's investment remains intact.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਨਕੁ ਜਾਗੈ ਪਾਰਬ੍ਰਹਮ ਕੈ ਰੰਗਿ ॥੪॥",
      "transliteration": "naanak jaagai paarabraham kai ra(n)g ||4||",
      "translation": "Nanak is awake to the Love of the Supreme Lord. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੋ ਜਾਗੈ ਜਿਸੁ ਪ੍ਰਭੁ ਕਿਰਪਾਲੁ ॥",
      "transliteration": "so jaagai jis prabh kirapaal ||",
      "translation": "He alone is awake, unto whom God shows His Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਹ ਪੂੰਜੀ ਸਾਬਤੁ ਧਨੁ ਮਾਲੁ ॥੧॥ ਰਹਾਉ ਦੂਜਾ ॥੨੦॥੮੯॥",
      "transliteration": "ih poo(n)jee saabat dhan maal ||1|| rahaau doojaa ||20||89||",
      "translation": "This investment, wealth and property shall remain intact. ||1||Second Pause||20||89||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਾ ਕੈ ਵਸਿ ਖਾਨ ਸੁਲਤਾਨ ॥",
      "transliteration": "jaa kai vas khaan sulataan ||",
      "translation": "Kings and emperors are under His Power.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਾ ਕੈ ਵਸਿ ਹੈ ਸਗਲ ਜਹਾਨ ॥",
      "transliteration": "jaa kai vas hai sagal jahaan ||",
      "translation": "The whole world is under His Power.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਾ ਕਾ ਕੀਆ ਸਭੁ ਕਿਛੁ ਹੋਇ ॥",
      "transliteration": "jaa kaa keeaa sabh kichh hoi ||",
      "translation": "Everything is done by His doing;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਸ ਤੇ ਬਾਹਰਿ ਨਾਹੀ ਕੋਇ ॥੧॥",
      "transliteration": "tis te baahar naahee koi ||1||",
      "translation": "other than Him, there is nothing at all. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਹੁ ਬੇਨੰਤੀ ਅਪੁਨੇ ਸਤਿਗੁਰ ਪਾਹਿ ॥",
      "transliteration": "kahu bena(n)tee apune satigur paahi ||",
      "translation": "Offer your prayers to your True Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਾਜ ਤੁਮਾਰੇ ਦੇਇ ਨਿਬਾਹਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kaaj tumaare dei nibaahi ||1|| rahaau ||",
      "translation": "He will resolve your affairs. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਭ ਤੇ ਊਚ ਜਾ ਕਾ ਦਰਬਾਰੁ ॥",
      "transliteration": "sabh te ooch jaa kaa darabaar ||",
      "translation": "The Darbaar of His Court is the most exalted of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਗਲ ਭਗਤ ਜਾ ਕਾ ਨਾਮੁ ਅਧਾਰੁ ॥",
      "transliteration": "sagal bhagat jaa kaa naam adhaar ||",
      "translation": "His Name is the Support of all His devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਰਬ ਬਿਆਪਿਤ ਪੂਰਨ ਧਨੀ ॥",
      "transliteration": "sarab biaapit pooran dhanee ||",
      "translation": "The Perfect Master is pervading everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਾ ਕੀ ਸੋਭਾ ਘਟਿ ਘਟਿ ਬਨੀ ॥੨॥",
      "transliteration": "jaa kee sobhaa ghat ghat banee ||2||",
      "translation": "His Glory is manifest in each and every heart. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਿਸੁ ਸਿਮਰਤ ਦੁਖ ਡੇਰਾ ਢਹੈ ॥",
      "transliteration": "jis simarat dukh deraa dhahai ||",
      "translation": "Remembering Him in meditation, the home of sorrow is abolished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਜਿਸੁ ਸਿਮਰਤ ਜਮੁ ਕਿਛੂ ਨ ਕਹੈ ॥",
      "transliteration": "jis simarat jam kichhoo na kahai ||",
      "translation": "Remembering Him in meditation, the Messenger of Death shall not touch you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0182_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਿਸੁ ਸਿਮਰਤ ਹੋਤ ਸੂਕੇ ਹਰੇ ॥",
      "transliteration": "jis simarat hot sooke hare ||",
      "translation": "Remembering Him in meditation, the dry branches become green again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 182,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
