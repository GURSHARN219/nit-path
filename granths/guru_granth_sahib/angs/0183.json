{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 183,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0183_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਸੁ ਸਿਮਰਤ ਡੂਬਤ ਪਾਹਨ ਤਰੇ ॥੩॥",
      "transliteration": "jis simarat doobat paahan tare ||3||",
      "translation": "Remembering Him in meditation, sinking stones are made to float. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੰਤ ਸਭਾ ਕਉ ਸਦਾ ਜੈਕਾਰੁ ॥",
      "transliteration": "sa(n)t sabhaa kau sadaa jaikaar ||",
      "translation": "I salute and applaud the Society of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਨ ਪ੍ਰਾਨ ਅਧਾਰੁ ॥",
      "transliteration": "har har naam jan praan adhaar ||",
      "translation": "The Name of the Lord, Har, Har, is the Support of the breath of life of His servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਮੇਰੀ ਸੁਣੀ ਅਰਦਾਸਿ ॥",
      "transliteration": "kahu naanak meree sunee aradaas ||",
      "translation": "Says Nanak, the Lord has heard my prayer;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਮੋ ਕਉ ਨਾਮ ਨਿਵਾਸਿ ॥੪॥੨੧॥੯੦॥",
      "transliteration": "sa(n)t prasaad mo kau naam nivaas ||4||21||90||",
      "translation": "by the Grace of the Saints, I dwell in the Naam, the Name of the Lord. ||4||21||90||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਤਿਗੁਰ ਦਰਸਨਿ ਅਗਨਿ ਨਿਵਾਰੀ ॥",
      "transliteration": "satigur darasan agan nivaaree ||",
      "translation": "By the Blessed Vision of the True Guru's Darshan, the fire of desire is quenched.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਤਿਗੁਰ ਭੇਟਤ ਹਉਮੈ ਮਾਰੀ ॥",
      "transliteration": "satigur bhetat haumai maaree ||",
      "translation": "Meeting the True Guru, egotism is subdued.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਤਿਗੁਰ ਸੰਗਿ ਨਾਹੀ ਮਨੁ ਡੋਲੈ ॥",
      "transliteration": "satigur sa(n)g naahee man dolai ||",
      "translation": "In the Company of the True Guru, the mind does not waver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਬਾਣੀ ਗੁਰਮੁਖਿ ਬੋਲੈ ॥੧॥",
      "transliteration": "a(n)mrit baanee guramukh bolai ||1||",
      "translation": "The Gurmukh speaks the Ambrosial Word of Gurbani. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਭੁ ਜਗੁ ਸਾਚਾ ਜਾ ਸਚ ਮਹਿ ਰਾਤੇ ॥",
      "transliteration": "sabh jag saachaa jaa sach mahi raate ||",
      "translation": "He sees the True One pervading the whole world; he is imbued with the True One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੀਤਲ ਸਾਤਿ ਗੁਰ ਤੇ ਪ੍ਰਭ ਜਾਤੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "seetal saat gur te prabh jaate ||1|| rahaau ||",
      "translation": "I have become cool and tranquil, knowing God, through the Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਜਪੈ ਹਰਿ ਨਾਉ ॥",
      "transliteration": "sa(n)t prasaad japai har naau ||",
      "translation": "By the Grace of the Saints, one chants the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਹਰਿ ਕੀਰਤਨੁ ਗਾਉ ॥",
      "transliteration": "sa(n)t prasaad har keeratan gaau ||",
      "translation": "By the Grace of the Saints, one sings the Kirtan of the Lord's Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਸਗਲ ਦੁਖ ਮਿਟੇ ॥",
      "transliteration": "sa(n)t prasaad sagal dukh mite ||",
      "translation": "By the Grace of the Saints, all pains are erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਬੰਧਨ ਤੇ ਛੁਟੇ ॥੨॥",
      "transliteration": "sa(n)t prasaad ba(n)dhan te chhute ||2||",
      "translation": "By the Grace of the Saints, one is released from bondage. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੰਤ ਕ੍ਰਿਪਾ ਤੇ ਮਿਟੇ ਮੋਹ ਭਰਮ ॥",
      "transliteration": "sa(n)t kripaa te mite moh bharam ||",
      "translation": "By the kind Mercy of the Saints, emotional attachment and doubt are removed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਾਧ ਰੇਣ ਮਜਨ ਸਭਿ ਧਰਮ ॥",
      "transliteration": "saadh ren majan sabh dharam ||",
      "translation": "Taking a bath in the dust of the feet of the Holy - this is true Dharmic faith.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਾਧ ਕ੍ਰਿਪਾਲ ਦਇਆਲ ਗੋਵਿੰਦੁ ॥",
      "transliteration": "saadh kripaal daiaal govi(n)d ||",
      "translation": "By the kindness of the Holy, the Lord of the Universe becomes merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਧਾ ਮਹਿ ਇਹ ਹਮਰੀ ਜਿੰਦੁ ॥੩॥",
      "transliteration": "saadhaa mahi ih hamaree ji(n)d ||3||",
      "translation": "The life of my soul is with the Holy. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿਰਪਾ ਨਿਧਿ ਕਿਰਪਾਲ ਧਿਆਵਉ ॥",
      "transliteration": "kirapaa nidh kirapaal dhiaavau ||",
      "translation": "Meditating on the Merciful Lord, the Treasure of Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਤਾ ਬੈਠਣੁ ਪਾਵਉ ॥",
      "transliteration": "saadhasa(n)g taa baithan paavau ||",
      "translation": "I have obtained a seat in the Saadh Sangat.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੋਹਿ ਨਿਰਗੁਣ ਕਉ ਪ੍ਰਭਿ ਕੀਨੀ ਦਇਆ ॥",
      "transliteration": "mohi niragun kau prabh keenee daiaa ||",
      "translation": "I am worthless, but God has been kind to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਨਾਨਕ ਨਾਮੁ ਲਇਆ ॥੪॥੨੨॥੯੧॥",
      "transliteration": "saadhasa(n)g naanak naam laiaa ||4||22||91||",
      "translation": "In the Saadh Sangat, Nanak has taken to the Naam, the Name of the Lord. ||4||22||91||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਜਪਿਓ ਭਗਵੰਤੁ ॥",
      "transliteration": "saadhasa(n)g japio bhagava(n)t ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, I meditate on the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕੇਵਲ ਨਾਮੁ ਦੀਓ ਗੁਰਿ ਮੰਤੁ ॥",
      "transliteration": "keval naam deeo gur ma(n)t ||",
      "translation": "The Guru has given me the Mantra of the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਜਿ ਅਭਿਮਾਨ ਭਏ ਨਿਰਵੈਰ ॥",
      "transliteration": "taj abhimaan bhae niravair ||",
      "translation": "Shedding my ego, I have become free of hate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਠ ਪਹਰ ਪੂਜਹੁ ਗੁਰ ਪੈਰ ॥੧॥",
      "transliteration": "aath pahar poojahu gur pair ||1||",
      "translation": "Twenty-four hours a day, I worship the Guru's Feet. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਬ ਮਤਿ ਬਿਨਸੀ ਦੁਸਟ ਬਿਗਾਨੀ ॥",
      "transliteration": "ab mat binasee dusat bigaanee ||",
      "translation": "Now, my evil sense of alienation is eliminated,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਬ ਤੇ ਸੁਣਿਆ ਹਰਿ ਜਸੁ ਕਾਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jab te suniaa har jas kaanee ||1|| rahaau ||",
      "translation": "since I have heard the Praises of the Lord with my ears. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਹਜ ਸੂਖ ਆਨੰਦ ਨਿਧਾਨ ॥",
      "transliteration": "sahaj sookh aana(n)d nidhaan ||",
      "translation": "The Savior Lord is the treasure of intuitive peace, poise and bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰਾਖਨਹਾਰ ਰਖਿ ਲੇਇ ਨਿਦਾਨ ॥",
      "transliteration": "raakhanahaar rakh lei nidaan ||",
      "translation": "He shall save me in the end.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੂਖ ਦਰਦ ਬਿਨਸੇ ਭੈ ਭਰਮ ॥",
      "transliteration": "dookh darad binase bhai bharam ||",
      "translation": "My pains, sufferings, fears and doubts have been erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਵਣ ਜਾਣ ਰਖੇ ਕਰਿ ਕਰਮ ॥੨॥",
      "transliteration": "aavan jaan rakhe kar karam ||2||",
      "translation": "He has mercifully saved me from coming and going in reincarnation. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪੇਖੈ ਬੋਲੈ ਸੁਣੈ ਸਭੁ ਆਪਿ ॥",
      "transliteration": "pekhai bolai sunai sabh aap ||",
      "translation": "He Himself beholds, speaks and hears all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਦਾ ਸੰਗਿ ਤਾ ਕਉ ਮਨ ਜਾਪਿ ॥",
      "transliteration": "sadaa sa(n)g taa kau man jaap ||",
      "translation": "O my mind, meditate on the One who is always with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਭਇਓ ਪਰਗਾਸੁ ॥",
      "transliteration": "sa(n)t prasaad bhaio paragaas ||",
      "translation": "By the Grace of the Saints, the Light has dawned.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪੂਰਿ ਰਹੇ ਏਕੈ ਗੁਣਤਾਸੁ ॥੩॥",
      "transliteration": "poor rahe ekai gunataas ||3||",
      "translation": "The One Lord, the Treasure of Excellence, is perfectly pervading everywhere. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਹਤ ਪਵਿਤ੍ਰ ਸੁਣਤ ਪੁਨੀਤ ॥",
      "transliteration": "kahat pavitr sunat puneet ||",
      "translation": "Pure are those who speak, and sanctified are those who hear and sing,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੁਣ ਗੋਵਿੰਦ ਗਾਵਹਿ ਨਿਤ ਨੀਤ ॥",
      "transliteration": "gun govi(n)d gaavahi nit neet ||",
      "translation": "Forever and ever, the Glorious Praises of the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਾ ਕਉ ਹੋਹੁ ਕ੍ਰਿਪਾਲ ॥",
      "transliteration": "kahu naanak jaa kau hohu kripaal ||",
      "translation": "Says Nanak, when the Lord bestows His Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਕੀ ਸਭ ਪੂਰਨ ਘਾਲ ॥੪॥੨੩॥੯੨॥",
      "transliteration": "tis jan kee sabh pooran ghaal ||4||23||92||",
      "translation": "all one's efforts are fulfilled. ||4||23||92||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬੰਧਨ ਤੋੜਿ ਬੋਲਾਵੈ ਰਾਮੁ ॥",
      "transliteration": "ba(n)dhan toR bolaavai raam ||",
      "translation": "He breaks our bonds, and inspires us to chant the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਨ ਮਹਿ ਲਾਗੈ ਸਾਚੁ ਧਿਆਨੁ ॥",
      "transliteration": "man mahi laagai saach dhiaan ||",
      "translation": "With the mind centered in meditation on the True Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਿਟਹਿ ਕਲੇਸ ਸੁਖੀ ਹੋਇ ਰਹੀਐ ॥",
      "transliteration": "mitahi kales sukhee hoi raheeai ||",
      "translation": "Anguish is eradicated, and one comes to dwell in peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਐਸਾ ਦਾਤਾ ਸਤਿਗੁਰੁ ਕਹੀਐ ॥੧॥",
      "transliteration": "aisaa daataa satigur kaheeai ||1||",
      "translation": "Such is the True Guru, the Great Giver. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੋ ਸੁਖਦਾਤਾ ਜਿ ਨਾਮੁ ਜਪਾਵੈ ॥",
      "transliteration": "so sukhadaataa j naam japaavai ||",
      "translation": "He alone is the Giver of peace, who inspires us to chant the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਤਿਸੁ ਸੰਗਿ ਮਿਲਾਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa tis sa(n)g milaavai ||1|| rahaau ||",
      "translation": "By His Grace, He leads us to merge with Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਿਸੁ ਹੋਇ ਦਇਆਲੁ ਤਿਸੁ ਆਪਿ ਮਿਲਾਵੈ ॥",
      "transliteration": "jis hoi daiaal tis aap milaavai ||",
      "translation": "He unites with Himself those unto whom He has shown His Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਰਬ ਨਿਧਾਨ ਗੁਰੂ ਤੇ ਪਾਵੈ ॥",
      "transliteration": "sarab nidhaan guroo te paavai ||",
      "translation": "All treasures are received from the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਆਪੁ ਤਿਆਗਿ ਮਿਟੈ ਆਵਣ ਜਾਣਾ ॥",
      "transliteration": "aap tiaag mitai aavan jaanaa ||",
      "translation": "Renouncing selfishness and conceit, coming and going come to an end.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਪਾਰਬ੍ਰਹਮੁ ਪਛਾਣਾ ॥੨॥",
      "transliteration": "saadh kai sa(n)g paarabraham pachhaanaa ||2||",
      "translation": "In the Saadh Sangat, the Company of the Holy, the Supreme Lord God is recognized. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0183_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਨ ਊਪਰਿ ਪ੍ਰਭ ਭਏ ਦਇਆਲ ॥",
      "transliteration": "jan oopar prabh bhae daiaal ||",
      "translation": "God has become merciful to His humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 183,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
