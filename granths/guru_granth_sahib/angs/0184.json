{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 184,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0184_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਨ ਕੀ ਟੇਕ ਏਕ ਗੋਪਾਲ ॥",
      "transliteration": "jan kee tek ek gopaal ||",
      "translation": "The One Lord of the Universe is the Support of His humble servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਏਕਾ ਲਿਵ ਏਕੋ ਮਨਿ ਭਾਉ ॥",
      "transliteration": "ekaa liv eko man bhaau ||",
      "translation": "They love the One Lord; their minds are filled with love for the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਰਬ ਨਿਧਾਨ ਜਨ ਕੈ ਹਰਿ ਨਾਉ ॥੩॥",
      "transliteration": "sarab nidhaan jan kai har naau ||3||",
      "translation": "The Name of the Lord is all treasures for them. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਸਿਉ ਲਾਗੀ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "paarabraham siu laagee preet ||",
      "translation": "They are in love with the Supreme Lord God;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਿਰਮਲ ਕਰਣੀ ਸਾਚੀ ਰੀਤਿ ॥",
      "transliteration": "niramal karanee saachee reet ||",
      "translation": "their actions are pure, and their lifestyle is true.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਮੇਟਿਆ ਅੰਧਿਆਰਾ ॥",
      "transliteration": "gur poorai metiaa a(n)dhiaaraa ||",
      "translation": "The Perfect Guru has dispelled the darkness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਨਕ ਕਾ ਪ੍ਰਭੁ ਅਪਰ ਅਪਾਰਾ ॥੪॥੨੪॥੯੩॥",
      "transliteration": "naanak kaa prabh apar apaaraa ||4||24||93||",
      "translation": "Nanak's God is Incomparable and Infinite. ||4||24||93||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਿਸੁ ਮਨਿ ਵਸੈ ਤਰੈ ਜਨੁ ਸੋਇ ॥",
      "transliteration": "jis man vasai tarai jan soi ||",
      "translation": "Those whose minds are filled with the Lord, swim across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾ ਕੈ ਕਰਮਿ ਪਰਾਪਤਿ ਹੋਇ ॥",
      "transliteration": "jaa kai karam paraapat hoi ||",
      "translation": "Those who have the blessing of good karma, meet with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੂਖੁ ਰੋਗੁ ਕਛੁ ਭਉ ਨ ਬਿਆਪੈ ॥",
      "transliteration": "dookh rog kachh bhau na biaapai ||",
      "translation": "Pain, disease and fear do not affect them at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਰਿਦੈ ਹਰਿ ਜਾਪੈ ॥੧॥",
      "transliteration": "a(n)mrit naam ridai har jaapai ||1||",
      "translation": "They meditate on the Ambrosial Name of the Lord within their hearts. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਪਰਮੇਸੁਰੁ ਧਿਆਈਐ ॥",
      "transliteration": "paarabraham paramesur dhiaaeeai ||",
      "translation": "Meditate on the Supreme Lord God, the Transcendent Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਤੇ ਇਹ ਮਤਿ ਪਾਈਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur poore te ih mat paaeeai ||1|| rahaau ||",
      "translation": "From the Perfect Guru, this understanding is obtained. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਰਣ ਕਰਾਵਨਹਾਰ ਦਇਆਲ ॥",
      "transliteration": "karan karaavanahaar daiaal ||",
      "translation": "The Merciful Lord is the Doer, the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਸਗਲੇ ਪ੍ਰਤਿਪਾਲ ॥",
      "transliteration": "jee ja(n)t sagale pratipaal ||",
      "translation": "He cherishes and nurtures all beings and creatures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਗਮ ਅਗੋਚਰ ਸਦਾ ਬੇਅੰਤਾ ॥",
      "transliteration": "agam agochar sadaa bea(n)taa ||",
      "translation": "He is Inaccessible, Incomprehensible, Eternal and Infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਿਮਰਿ ਮਨਾ ਪੂਰੇ ਗੁਰ ਮੰਤਾ ॥੨॥",
      "transliteration": "simar manaa poore gur ma(n)taa ||2||",
      "translation": "Meditate on Him, O my mind, through the Teachings of the Perfect Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਾ ਕੀ ਸੇਵਾ ਸਰਬ ਨਿਧਾਨੁ ॥",
      "transliteration": "jaa kee sevaa sarab nidhaan ||",
      "translation": "Serving Him, all treasures are obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਪੂਜਾ ਪਾਈਐ ਮਾਨੁ ॥",
      "transliteration": "prabh kee poojaa paaeeai maan ||",
      "translation": "Worshipping God, honor is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾ ਕੀ ਟਹਲ ਨ ਬਿਰਥੀ ਜਾਇ ॥",
      "transliteration": "jaa kee tahal na birathee jaai ||",
      "translation": "Working for Him is never in vain;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਹਰਿ ਕੇ ਗੁਣ ਗਾਇ ॥੩॥",
      "transliteration": "sadaa sadaa har ke gun gaai ||3||",
      "translation": "forever and ever, sing the Glorious Praises of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "kar kirapaa prabh a(n)tarajaamee ||",
      "translation": "Show Mercy to me, O God, O Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁਖ ਨਿਧਾਨ ਹਰਿ ਅਲਖ ਸੁਆਮੀ ॥",
      "transliteration": "sukh nidhaan har alakh suaamee ||",
      "translation": "The Unseen Lord and Master is the Treasure of Peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਤੇਰੀ ਸਰਣਾਈ ॥",
      "transliteration": "jee ja(n)t teree saranaaee ||",
      "translation": "All beings and creatures seek Your Sanctuary;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਮਿਲੈ ਵਡਿਆਈ ॥੪॥੨੫॥੯੪॥",
      "transliteration": "naanak naam milai vadiaaee ||4||25||94||",
      "translation": "Nanak is blessed to receive the greatness of the Naam, the Name of the Lord. ||4||25||94||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੀਅ ਜੁਗਤਿ ਜਾ ਕੈ ਹੈ ਹਾਥ ॥",
      "transliteration": "jee jugat jaa kai hai haath ||",
      "translation": "Our way of life is in His Hands;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੋ ਸਿਮਰਹੁ ਅਨਾਥ ਕੋ ਨਾਥੁ ॥",
      "transliteration": "so simarahu anaath ko naath ||",
      "translation": "remember Him, the Master of the masterless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪ੍ਰਭ ਚਿਤਿ ਆਏ ਸਭੁ ਦੁਖੁ ਜਾਇ ॥",
      "transliteration": "prabh chit aae sabh dukh jaai ||",
      "translation": "When God comes to mind, all pains depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭੈ ਸਭ ਬਿਨਸਹਿ ਹਰਿ ਕੈ ਨਾਇ ॥੧॥",
      "transliteration": "bhai sabh binasahi har kai naai ||1||",
      "translation": "All fears are dispelled through the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਭਉ ਕਾਹੇ ਕਾ ਮਾਨਹਿ ॥",
      "transliteration": "bin har bhau kaahe kaa maanahi ||",
      "translation": "Why do you fear any other than the Lord?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰਿ ਬਿਸਰਤ ਕਾਹੇ ਸੁਖੁ ਜਾਨਹਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har bisarat kaahe sukh jaanahi ||1|| rahaau ||",
      "translation": "Forgetting the Lord, why do you pretend to be at peace? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਿਨਿ ਧਾਰੇ ਬਹੁ ਧਰਣਿ ਅਗਾਸ ॥",
      "transliteration": "jin dhaare bahu dharan agaas ||",
      "translation": "He established the many worlds and skies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾ ਕੀ ਜੋਤਿ ਜੀਅ ਪਰਗਾਸ ॥",
      "transliteration": "jaa kee jot jee paragaas ||",
      "translation": "The soul is illumined with His Light;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਾ ਕੀ ਬਖਸ ਨ ਮੇਟੈ ਕੋਇ ॥",
      "transliteration": "jaa kee bakhas na metai koi ||",
      "translation": "no one can revoke His Blessing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਪ੍ਰਭੁ ਨਿਰਭਉ ਹੋਇ ॥੨॥",
      "transliteration": "simar simar prabh nirabhau hoi ||2||",
      "translation": "Meditate, meditate in remembrance on God, and become fearless. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਠ ਪਹਰ ਸਿਮਰਹੁ ਪ੍ਰਭ ਨਾਮੁ ॥",
      "transliteration": "aath pahar simarahu prabh naam ||",
      "translation": "Twenty-four hours a day, meditate in remembrance on God's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਨਿਕ ਤੀਰਥ ਮਜਨੁ ਇਸਨਾਨੁ ॥",
      "transliteration": "anik teerath majan isanaan ||",
      "translation": "In it are the many sacred shrines of pilgrimage and cleansing baths.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕੀ ਸਰਣੀ ਪਾਹਿ ॥",
      "transliteration": "paarabraham kee saranee paahi ||",
      "translation": "Seek the Sanctuary of the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕੋਟਿ ਕਲੰਕ ਖਿਨ ਮਹਿ ਮਿਟਿ ਜਾਹਿ ॥੩॥",
      "transliteration": "kot kala(n)k khin mahi mit jaahi ||3||",
      "translation": "Millions of mistakes shall be erased in an instant. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬੇਮੁਹਤਾਜੁ ਪੂਰਾ ਪਾਤਿਸਾਹੁ ॥",
      "transliteration": "bemuhataaj pooraa paatisaahu ||",
      "translation": "The Perfect King is self-sufficient.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪ੍ਰਭ ਸੇਵਕ ਸਾਚਾ ਵੇਸਾਹੁ ॥",
      "transliteration": "prabh sevak saachaa vesaahu ||",
      "translation": "God's servant has true faith in Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਰਾਖੇ ਦੇ ਹਾਥ ॥",
      "transliteration": "gur poorai raakhe de haath ||",
      "translation": "Giving him His Hand, the Perfect Guru protects him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਪਾਰਬ੍ਰਹਮ ਸਮਰਾਥ ॥੪॥੨੬॥੯੫॥",
      "transliteration": "naanak paarabraham samaraath ||4||26||95||",
      "translation": "O Nanak, the Supreme Lord God is All-powerful. ||4||26||95||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਨਾਮਿ ਮਨੁ ਲਾਗਾ ॥",
      "transliteration": "gur parasaad naam man laagaa ||",
      "translation": "By Guru's Grace, my mind is attached to the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕਾ ਸੋਇਆ ਜਾਗਾ ॥",
      "transliteration": "janam janam kaa soiaa jaagaa ||",
      "translation": "Asleep for so many incarnations, it is now awakened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਗੁਣ ਉਚਰੈ ਪ੍ਰਭ ਬਾਣੀ ॥",
      "transliteration": "a(n)mrit gun ucharai prabh baanee ||",
      "translation": "I chant the Ambrosial Bani, the Glorious Praises of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਕੀ ਸੁਮਤਿ ਪਰਾਣੀ ॥੧॥",
      "transliteration": "poore gur kee sumat paraanee ||1||",
      "translation": "The Pure Teachings of the Perfect Guru have been revealed to me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪ੍ਰਭ ਸਿਮਰਤ ਕੁਸਲ ਸਭਿ ਪਾਏ ॥",
      "transliteration": "prabh simarat kusal sabh paae ||",
      "translation": "Meditating in remembrance on God, I have found total peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਘਰਿ ਬਾਹਰਿ ਸੁਖ ਸਹਜ ਸਬਾਏ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ghar baahar sukh sahaj sabaae ||1|| rahaau ||",
      "translation": "Within my home, and outside as well, there is peace and poise all around. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੋਈ ਪਛਾਤਾ ਜਿਨਹਿ ਉਪਾਇਆ ॥",
      "transliteration": "soee pachhaataa jinahi upaaiaa ||",
      "translation": "I have recognized the One who created me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭਿ ਆਪਿ ਮਿਲਾਇਆ ॥",
      "transliteration": "kar kirapaa prabh aap milaaiaa ||",
      "translation": "Showing His Mercy, God has blended me with Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਬਾਹ ਪਕਰਿ ਲੀਨੋ ਕਰਿ ਅਪਨਾ ॥",
      "transliteration": "baah pakar leeno kar apanaa ||",
      "translation": "Taking me by the arm, He has made me His Own.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਕਥਾ ਸਦਾ ਜਪੁ ਜਪਨਾ ॥੨॥",
      "transliteration": "har har kathaa sadaa jap japanaa ||2||",
      "translation": "I continually chant and meditate on the Sermon of the Lord, Har, Har. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0184_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮੰਤ੍ਰੁ ਤੰਤ੍ਰੁ ਅਉਖਧੁ ਪੁਨਹਚਾਰੁ ॥",
      "transliteration": "ma(n)tr ta(n)tr aukhadh punahachaar ||",
      "translation": "Mantras, tantras, all-curing medicines and acts of atonement,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 184,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
