{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 185,
  "lineCount": 52,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0185_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜੀਅ ਪ੍ਰਾਨ ਅਧਾਰੁ ॥",
      "transliteration": "har har naam jee praan adhaar ||",
      "translation": "are all in the Name of the Lord, Har, Har, the Support of the soul and the breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਚਾ ਧਨੁ ਪਾਇਓ ਹਰਿ ਰੰਗਿ ॥",
      "transliteration": "saachaa dhan paaio har ra(n)g ||",
      "translation": "I have obtained the true wealth of the Lord's Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੁਤਰੁ ਤਰੇ ਸਾਧ ਕੈ ਸੰਗਿ ॥੩॥",
      "transliteration": "dutar tare saadh kai sa(n)g ||3||",
      "translation": "I have crossed over the treacherous world-ocean in the Saadh Sangat, the Company of the Holy. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੁਖਿ ਬੈਸਹੁ ਸੰਤ ਸਜਨ ਪਰਵਾਰੁ ॥",
      "transliteration": "sukh baisahu sa(n)t sajan paravaar ||",
      "translation": "Sit in peace, O Saints, with the family of friends.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਰਿ ਧਨੁ ਖਟਿਓ ਜਾ ਕਾ ਨਾਹਿ ਸੁਮਾਰੁ ॥",
      "transliteration": "har dhan khatio jaa kaa naahi sumaar ||",
      "translation": "Earn the wealth of the Lord, which is beyond estimation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਿਸਹਿ ਪਰਾਪਤਿ ਤਿਸੁ ਗੁਰੁ ਦੇਇ ॥",
      "transliteration": "jisahi paraapat tis gur dei ||",
      "translation": "He alone obtains it, unto whom the Guru has bestowed it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਨਕ ਬਿਰਥਾ ਕੋਇ ਨ ਹੇਇ ॥੪॥੨੭॥੯੬॥",
      "transliteration": "naanak birathaa koi na hei ||4||27||96||",
      "translation": "O Nanak, no one shall go away empty-handed. ||4||27||96||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਸਤ ਪੁਨੀਤ ਹੋਹਿ ਤਤਕਾਲ ॥",
      "transliteration": "hasat puneet hohi tatakaal ||",
      "translation": "The hands are sanctified instantly,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਨਸਿ ਜਾਹਿ ਮਾਇਆ ਜੰਜਾਲ ॥",
      "transliteration": "binas jaahi maaiaa ja(n)jaal ||",
      "translation": "and the entanglements of Maya are dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਸਨਾ ਰਮਹੁ ਰਾਮ ਗੁਣ ਨੀਤ ॥",
      "transliteration": "rasanaa ramahu raam gun neet ||",
      "translation": "Repeat constantly with your tongue the Glorious Praises of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁਖੁ ਪਾਵਹੁ ਮੇਰੇ ਭਾਈ ਮੀਤ ॥੧॥",
      "transliteration": "sukh paavahu mere bhaaee meet ||1||",
      "translation": "and you shall find peace, O my friends, O Siblings of Destiny. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲਿਖੁ ਲੇਖਣਿ ਕਾਗਦਿ ਮਸਵਾਣੀ ॥",
      "transliteration": "likh lekhan kaagad masavaanee ||",
      "translation": "With pen and ink, write upon your paper",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਹਰਿ ਅੰਮ੍ਰਿਤ ਬਾਣੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raam naam har a(n)mrit baanee ||1|| rahaau ||",
      "translation": "the Name of the Lord, the Ambrosial Word of the Lord's Bani. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਹ ਕਾਰਜਿ ਤੇਰੇ ਜਾਹਿ ਬਿਕਾਰ ॥",
      "transliteration": "ih kaaraj tere jaahi bikaar ||",
      "translation": "By this act, your sins shall be washed away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਿਮਰਤ ਰਾਮ ਨਾਹੀ ਜਮ ਮਾਰ ॥",
      "transliteration": "simarat raam naahee jam maar ||",
      "translation": "Remembering the Lord in meditation, you shall not be punished by the Messenger of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਧਰਮ ਰਾਇ ਕੇ ਦੂਤ ਨ ਜੋਹੈ ॥",
      "transliteration": "dharam raai ke doot na johai ||",
      "translation": "The couriers of the Righteous Judge of Dharma shall not touch you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਾਇਆ ਮਗਨ ਨ ਕਛੂਐ ਮੋਹੈ ॥੨॥",
      "transliteration": "maaiaa magan na kachhooai mohai ||2||",
      "translation": "The intoxication of Maya shall not entice you at all. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਉਧਰਹਿ ਆਪਿ ਤਰੈ ਸੰਸਾਰੁ ॥",
      "transliteration": "udharahi aap tarai sa(n)saar ||",
      "translation": "You shall be redeemed, and through you, the whole world shall be saved,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਜਪਿ ਏਕੰਕਾਰੁ ॥",
      "transliteration": "raam naam jap eka(n)kaar ||",
      "translation": "if you chant the Name of the One and Only Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਪਿ ਕਮਾਉ ਅਵਰਾ ਉਪਦੇਸ ॥",
      "transliteration": "aap kamaau avaraa upades ||",
      "translation": "Practice this yourself, and teach others;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਹਿਰਦੈ ਪਰਵੇਸ ॥੩॥",
      "transliteration": "raam naam hiradai paraves ||3||",
      "translation": "instill the Lord's Name in your heart. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾ ਕੈ ਮਾਥੈ ਏਹੁ ਨਿਧਾਨੁ ॥",
      "transliteration": "jaa kai maathai ehu nidhaan ||",
      "translation": "That person, who has this treasure upon his forehead",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੋਈ ਪੁਰਖੁ ਜਪੈ ਭਗਵਾਨੁ ॥",
      "transliteration": "soee purakh japai bhagavaan ||",
      "translation": "that person meditates on God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਠ ਪਹਰ ਹਰਿ ਹਰਿ ਗੁਣ ਗਾਉ ॥",
      "transliteration": "aath pahar har har gun gaau ||",
      "translation": "Twenty-four hours a day, chant the Glorious Praises of the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਹਉ ਤਿਸੁ ਬਲਿ ਜਾਉ ॥੪॥੨੮॥੯੭॥",
      "transliteration": "kahu naanak hau tis bal jaau ||4||28||97||",
      "translation": "Says Nanak, I am a sacrifice to Him. ||4||28||97||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਾਗੁ ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ਚਉਪਦੇ ਦੁਪਦੇ ॥",
      "transliteration": "raag gauRee guaareree mahalaa 5 chaupade dupade ||",
      "translation": "Raag Gauree Gwaarayree, Fifth Mehl, Chau-Padhay, Dho-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜੋ ਪਰਾਇਓ ਸੋਈ ਅਪਨਾ ॥",
      "transliteration": "jo paraaio soee apanaa ||",
      "translation": "That which belongs to another - he claims as his own.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੋ ਤਜਿ ਛੋਡਨ ਤਿਸੁ ਸਿਉ ਮਨੁ ਰਚਨਾ ॥੧॥",
      "transliteration": "jo taj chhodan tis siu man rachanaa ||1||",
      "translation": "That which he must abandon - to that, his mind is attracted. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਹਹੁ ਗੁਸਾਈ ਮਿਲੀਐ ਕੇਹ ॥",
      "transliteration": "kahahu gusaaee mileeai keh ||",
      "translation": "Tell me, how can he meet the Lord of the World?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੋ ਬਿਬਰਜਤ ਤਿਸ ਸਿਉ ਨੇਹ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jo bibarajat tis siu neh ||1|| rahaau ||",
      "translation": "That which is forbidden - with that, he is in love. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਝੂਠੁ ਬਾਤ ਸਾ ਸਚੁ ਕਰਿ ਜਾਤੀ ॥",
      "transliteration": "jhooth baat saa sach kar jaatee ||",
      "translation": "That which is false - he deems as true.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਤਿ ਹੋਵਨੁ ਮਨਿ ਲਗੈ ਨ ਰਾਤੀ ॥੨॥",
      "transliteration": "sat hovan man lagai na raatee ||2||",
      "translation": "That which is true - his mind is not attached to that at all. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਾਵੈ ਮਾਰਗੁ ਟੇਢਾ ਚਲਨਾ ॥",
      "transliteration": "baavai maarag tedhaa chalanaa ||",
      "translation": "He takes the crooked path of the unrighteous way;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੀਧਾ ਛੋਡਿ ਅਪੂਠਾ ਬੁਨਨਾ ॥੩॥",
      "transliteration": "seedhaa chhod apoothaa bunanaa ||3||",
      "translation": "leaving the straight and narrow path, he weaves his way backwards. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੁਹਾ ਸਿਰਿਆ ਕਾ ਖਸਮੁ ਪ੍ਰਭੁ ਸੋਈ ॥",
      "transliteration": "duhaa siriaa kaa khasam prabh soee ||",
      "translation": "God is the Lord and Master of both worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਸੁ ਮੇਲੇ ਨਾਨਕ ਸੋ ਮੁਕਤਾ ਹੋਈ ॥੪॥੨੯॥੯੮॥",
      "transliteration": "jis mele naanak so mukataa hoee ||4||29||98||",
      "translation": "He, whom the Lord unites with Himself, O Nanak, is liberated. ||4||29||98||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਲਿਜੁਗ ਮਹਿ ਮਿਲਿ ਆਏ ਸੰਜੋਗ ॥",
      "transliteration": "kalijug mahi mil aae sa(n)jog ||",
      "translation": "In the Dark Age of Kali Yuga, they come together through destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਿਚਰੁ ਆਗਿਆ ਤਿਚਰੁ ਭੋਗਹਿ ਭੋਗ ॥੧॥",
      "transliteration": "jichar aagiaa tichar bhogahi bhog ||1||",
      "translation": "As long as the Lord commands, they enjoy their pleasures. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਲੈ ਨ ਪਾਈਐ ਰਾਮ ਸਨੇਹੀ ॥",
      "transliteration": "jalai na paaeeai raam sanehee ||",
      "translation": "By burning oneself, the Beloved Lord is not obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿਰਤਿ ਸੰਜੋਗਿ ਸਤੀ ਉਠਿ ਹੋਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kirat sa(n)jog satee uth hoee ||1|| rahaau ||",
      "translation": "Only by the actions of destiny does she rise up and burn herself, as a 'satee'. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੇਖਾ ਦੇਖੀ ਮਨਹਠਿ ਜਲਿ ਜਾਈਐ ॥",
      "transliteration": "dekhaa dekhee manahath jal jaaeeai ||",
      "translation": "Imitating what she sees, with her stubborn mind-set, she goes into the fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪ੍ਰਿਅ ਸੰਗੁ ਨ ਪਾਵੈ ਬਹੁ ਜੋਨਿ ਭਵਾਈਐ ॥੨॥",
      "transliteration": "pri sa(n)g na paavai bahu jon bhavaaeeai ||2||",
      "translation": "She does not obtain the Company of her Beloved Lord, and she wanders through countless incarnations. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੀਲ ਸੰਜਮਿ ਪ੍ਰਿਅ ਆਗਿਆ ਮਾਨੈ ॥",
      "transliteration": "seel sa(n)jam pri aagiaa maanai ||",
      "translation": "With pure conduct and self-restraint, she surrenders to her Husband Lord's Will;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਿਸੁ ਨਾਰੀ ਕਉ ਦੁਖੁ ਨ ਜਮਾਨੈ ॥੩॥",
      "transliteration": "tis naaree kau dukh na jamaanai ||3||",
      "translation": "that woman shall not suffer pain at the hands of the Messenger of Death. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਿਨਿ ਪ੍ਰਿਉ ਪਰਮੇਸਰੁ ਕਰਿ ਜਾਨਿਆ ॥",
      "transliteration": "kahu naanak jin priu paramesar kar jaaniaa ||",
      "translation": "Says Nanak, she who looks upon the Transcendent Lord as her Husband,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਧੰਨੁ ਸਤੀ ਦਰਗਹ ਪਰਵਾਨਿਆ ॥੪॥੩੦॥੯੯॥",
      "transliteration": "dha(n)n satee daragah paravaaniaa ||4||30||99||",
      "translation": "is the blessed 'satee'; she is received with honor in the Court of the Lord. ||4||30||99||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee guaareree mahalaa 5 ||",
      "translation": "Gauree Gwaarayree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਮ ਧਨਵੰਤ ਭਾਗਠ ਸਚ ਨਾਇ ॥",
      "transliteration": "ham dhanava(n)t bhaagath sach naai ||",
      "translation": "I am prosperous and fortunate, for I have received the True Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0185_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਗਾਵਹ ਸਹਜਿ ਸੁਭਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har gun gaavah sahaj subhaai ||1|| rahaau ||",
      "translation": "I sing the Glorious Praises of the Lord, with natural, intuitive ease. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 185,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
