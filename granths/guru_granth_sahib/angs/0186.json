{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 186,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0186_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪੀਊ ਦਾਦੇ ਕਾ ਖੋਲਿ ਡਿਠਾ ਖਜਾਨਾ ॥",
      "transliteration": "peeoo daade kaa khol dithaa khajaanaa ||",
      "translation": "When I opened it up and gazed upon the treasures of my father and grandfather,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਾ ਮੇਰੈ ਮਨਿ ਭਇਆ ਨਿਧਾਨਾ ॥੧॥",
      "transliteration": "taa merai man bhaiaa nidhaanaa ||1||",
      "translation": "then my mind became very happy. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਤਨ ਲਾਲ ਜਾ ਕਾ ਕਛੂ ਨ ਮੋਲੁ ॥",
      "transliteration": "ratan laal jaa kaa kachhoo na mol ||",
      "translation": "The storehouse is inexhaustible and immeasurable,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਰੇ ਭੰਡਾਰ ਅਖੂਟ ਅਤੋਲ ॥੨॥",
      "transliteration": "bhare bha(n)daar akhoot atol ||2||",
      "translation": "Overflowing with priceless jewels and rubies. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਖਾਵਹਿ ਖਰਚਹਿ ਰਲਿ ਮਿਲਿ ਭਾਈ ॥",
      "transliteration": "khaavahi kharachahi ral mil bhaaee ||",
      "translation": "The Siblings of Destiny meet together, and eat and spend,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੋਟਿ ਨ ਆਵੈ ਵਧਦੋ ਜਾਈ ॥੩॥",
      "transliteration": "tot na aavai vadhado jaaee ||3||",
      "translation": "but these resources do not diminish; they continue to increase. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਿਸੁ ਮਸਤਕਿ ਲੇਖੁ ਲਿਖਾਇ ॥",
      "transliteration": "kahu naanak jis masatak lekh likhaai ||",
      "translation": "Says Nanak, one who has such destiny written on his forehead,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁ ਏਤੁ ਖਜਾਨੈ ਲਇਆ ਰਲਾਇ ॥੪॥੩੧॥੧੦੦॥",
      "transliteration": "s et khajaanai laiaa ralaai ||4||31||100||",
      "translation": "becomes a partner in these treasures. ||4||31||100||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਡਰਿ ਡਰਿ ਮਰਤੇ ਜਬ ਜਾਨੀਐ ਦੂਰਿ ॥",
      "transliteration": "dar dar marate jab jaaneeai door ||",
      "translation": "I was scared, scared to death, when I thought that He was far away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਡਰੁ ਚੂਕਾ ਦੇਖਿਆ ਭਰਪੂਰਿ ॥੧॥",
      "transliteration": "dar chookaa dekhiaa bharapoor ||1||",
      "translation": "But my fear was removed, when I saw that He is pervading everywhere. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਤਿਗੁਰ ਅਪਨੇ ਕਉ ਬਲਿਹਾਰੈ ॥",
      "transliteration": "satigur apane kau balihaarai ||",
      "translation": "I am a sacrifice to my True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਛੋਡਿ ਨ ਜਾਈ ਸਰਪਰ ਤਾਰੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "chhod na jaaee sarapar taarai ||1|| rahaau ||",
      "translation": "He shall not abandon me; He shall surely carry me across. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੂਖੁ ਰੋਗੁ ਸੋਗੁ ਬਿਸਰੈ ਜਬ ਨਾਮੁ ॥",
      "transliteration": "dookh rog sog bisarai jab naam ||",
      "translation": "Pain, disease and sorrow come when one forgets the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਦਾ ਅਨੰਦੁ ਜਾ ਹਰਿ ਗੁਣ ਗਾਮੁ ॥੨॥",
      "transliteration": "sadaa ana(n)d jaa har gun gaam ||2||",
      "translation": "Eternal bliss comes when one sings the Glorious Praises of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬੁਰਾ ਭਲਾ ਕੋਈ ਨ ਕਹੀਜੈ ॥",
      "transliteration": "buraa bhalaa koee na kaheejai ||",
      "translation": "Do not say that anyone is good or bad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਛੋਡਿ ਮਾਨੁ ਹਰਿ ਚਰਨ ਗਹੀਜੈ ॥੩॥",
      "transliteration": "chhod maan har charan gaheejai ||3||",
      "translation": "Renounce your arrogant pride, and grasp the Feet of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰ ਮੰਤ੍ਰੁ ਚਿਤਾਰਿ ॥",
      "transliteration": "kahu naanak gur ma(n)tr chitaar ||",
      "translation": "Says Nanak, remember the GurMantra;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੁਖੁ ਪਾਵਹਿ ਸਾਚੈ ਦਰਬਾਰਿ ॥੪॥੩੨॥੧੦੧॥",
      "transliteration": "sukh paavahi saachai darabaar ||4||32||101||",
      "translation": "you shall find peace at the True Court. ||4||32||101||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾ ਕਾ ਮੀਤੁ ਸਾਜਨੁ ਹੈ ਸਮੀਆ ॥",
      "transliteration": "jaa kaa meet saajan hai sameeaa ||",
      "translation": "Those who have the Lord as their Friend and Companion",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਕਉ ਕਹੁ ਕਾ ਕੀ ਕਮੀਆ ॥੧॥",
      "transliteration": "tis jan kau kahu kaa kee kameeaa ||1||",
      "translation": "- tell me, what else do they need? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾ ਕੀ ਪ੍ਰੀਤਿ ਗੋਬਿੰਦ ਸਿਉ ਲਾਗੀ ॥",
      "transliteration": "jaa kee preet gobi(n)d siu laagee ||",
      "translation": "Those who are in love with the Lord of the Universe",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੂਖੁ ਦਰਦੁ ਭ੍ਰਮੁ ਤਾ ਕਾ ਭਾਗੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dookh darad bhram taa kaa bhaagee ||1|| rahaau ||",
      "translation": "- pain, suffering and doubt run away from them. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਾ ਕਉ ਰਸੁ ਹਰਿ ਰਸੁ ਹੈ ਆਇਓ ॥",
      "transliteration": "jaa kau ras har ras hai aaio ||",
      "translation": "Those who have enjoyed the flavor of the Lord's sublime essence",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੋ ਅਨ ਰਸ ਨਾਹੀ ਲਪਟਾਇਓ ॥੨॥",
      "transliteration": "so an ras naahee lapataaio ||2||",
      "translation": "are not attracted to any other pleasures. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਾ ਕਾ ਕਹਿਆ ਦਰਗਹ ਚਲੈ ॥",
      "transliteration": "jaa kaa kahiaa daragah chalai ||",
      "translation": "Those whose speech is accepted in the Court of the Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੋ ਕਿਸ ਕਉ ਨਦਰਿ ਲੈ ਆਵੈ ਤਲੈ ॥੩॥",
      "transliteration": "so kis kau nadar lai aavai talai ||3||",
      "translation": "- what do they care about anything else? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾ ਕਾ ਸਭੁ ਕਿਛੁ ਤਾ ਕਾ ਹੋਇ ॥",
      "transliteration": "jaa kaa sabh kichh taa kaa hoi ||",
      "translation": "Those who belong to the One, unto whom all things belong",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕਉ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥੪॥੩੩॥੧੦੨॥",
      "transliteration": "naanak taa kau sadaa sukh hoi ||4||33||102||",
      "translation": "- O Nanak, they find a lasting peace. ||4||33||102||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾ ਕੈ ਦੁਖੁ ਸੁਖੁ ਸਮ ਕਰਿ ਜਾਪੈ ॥",
      "transliteration": "jaa kai dukh sukh sam kar jaapai ||",
      "translation": "Those who look alike upon pleasure and pain",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਕਉ ਕਾੜਾ ਕਹਾ ਬਿਆਪੈ ॥੧॥",
      "transliteration": "taa kau kaaRaa kahaa biaapai ||1||",
      "translation": "- how can anxiety touch them? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਹਜ ਅਨੰਦ ਹਰਿ ਸਾਧੂ ਮਾਹਿ ॥",
      "transliteration": "sahaj ana(n)d har saadhoo maahi ||",
      "translation": "The Lord's Holy Saints abide in celestial bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਗਿਆਕਾਰੀ ਹਰਿ ਹਰਿ ਰਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aagiaakaaree har har raai ||1|| rahaau ||",
      "translation": "They remain obedient to the Lord, the Sovereign Lord King. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਾ ਕੈ ਅਚਿੰਤੁ ਵਸੈ ਮਨਿ ਆਇ ॥",
      "transliteration": "jaa kai achi(n)t vasai man aai ||",
      "translation": "Those who have the Carefree Lord abiding in their minds",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਾ ਕਉ ਚਿੰਤਾ ਕਤਹੂੰ ਨਾਹਿ ॥੨॥",
      "transliteration": "taa kau chi(n)taa katahoo(n) naahi ||2||",
      "translation": "- no cares will ever bother them. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾ ਕੈ ਬਿਨਸਿਓ ਮਨ ਤੇ ਭਰਮਾ ॥",
      "transliteration": "jaa kai binasio man te bharamaa ||",
      "translation": "Those who have banished doubt from their minds",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਾ ਕੈ ਕਛੂ ਨਾਹੀ ਡਰੁ ਜਮਾ ॥੩॥",
      "transliteration": "taa kai kachhoo naahee dar jamaa ||3||",
      "translation": "are not afraid of death at all. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾ ਕੈ ਹਿਰਦੈ ਦੀਓ ਗੁਰਿ ਨਾਮਾ ॥",
      "transliteration": "jaa kai hiradai deeo gur naamaa ||",
      "translation": "Those whose hearts are filled with the Lord's Name by the Guru",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਤਾ ਕੈ ਸਗਲ ਨਿਧਾਨਾ ॥੪॥੩੪॥੧੦੩॥",
      "transliteration": "kahu naanak taa kai sagal nidhaanaa ||4||34||103||",
      "translation": "- says Nanak, all treasures come to them. ||4||34||103||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਗਮ ਰੂਪ ਕਾ ਮਨ ਮਹਿ ਥਾਨਾ ॥",
      "transliteration": "agam roop kaa man mahi thaanaa ||",
      "translation": "The Lord of Unfathomable Form has His Place in the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਕਿਨੈ ਵਿਰਲੈ ਜਾਨਾ ॥੧॥",
      "transliteration": "gur prasaad kinai viralai jaanaa ||1||",
      "translation": "By Guru's Grace, a rare few come to understand this. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਹਜ ਕਥਾ ਕੇ ਅੰਮ੍ਰਿਤ ਕੁੰਟਾ ॥",
      "transliteration": "sahaj kathaa ke a(n)mrit ku(n)taa ||",
      "translation": "The Ambrosial Pools of the celestial sermon",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਸਹਿ ਪਰਾਪਤਿ ਤਿਸੁ ਲੈ ਭੁੰਚਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jisahi paraapat tis lai bhu(n)chaa ||1|| rahaau ||",
      "translation": "- those who find them, drink them in. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਨਹਤ ਬਾਣੀ ਥਾਨੁ ਨਿਰਾਲਾ ॥",
      "transliteration": "anahat baanee thaan niraalaa ||",
      "translation": "The unstruck melody of the Guru's Bani vibrates in that most special place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਾ ਕੀ ਧੁਨਿ ਮੋਹੇ ਗੋਪਾਲਾ ॥੨॥",
      "transliteration": "taa kee dhun mohe gopaalaa ||2||",
      "translation": "The Lord of the World is fascinated with this melody. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤਹ ਸਹਜ ਅਖਾਰੇ ਅਨੇਕ ਅਨੰਤਾ ॥",
      "transliteration": "tah sahaj akhaare anek ana(n)taa ||",
      "translation": "The numerous, countless places of celestial peace",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕੇ ਸੰਗੀ ਸੰਤਾ ॥੩॥",
      "transliteration": "paarabraham ke sa(n)gee sa(n)taa ||3||",
      "translation": "- there, the Saints dwell, in the Company of the Supreme Lord God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਰਖ ਅਨੰਤ ਸੋਗ ਨਹੀ ਬੀਆ ॥",
      "transliteration": "harakh ana(n)t sog nahee beeaa ||",
      "translation": "There is infinite joy, and no sorrow or duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੋ ਘਰੁ ਗੁਰਿ ਨਾਨਕ ਕਉ ਦੀਆ ॥੪॥੩੫॥੧੦੪॥",
      "transliteration": "so ghar gur naanak kau deeaa ||4||35||104||",
      "translation": "The Guru has blessed Nanak with this home. ||4||35||104||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗਉੜੀ ਮਃ ੫ ॥",
      "transliteration": "gauRee mah 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਵਨ ਰੂਪੁ ਤੇਰਾ ਆਰਾਧਉ ॥",
      "transliteration": "kavan roop teraa aaraadhau ||",
      "translation": "What form of Yours should I worship and adore?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0186_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਵਨ ਜੋਗ ਕਾਇਆ ਲੇ ਸਾਧਉ ॥੧॥",
      "transliteration": "kavan jog kaaiaa le saadhau ||1||",
      "translation": "What Yoga should I practice to control my body? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 186,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
