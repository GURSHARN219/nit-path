{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 187,
  "lineCount": 53,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0187_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਵਨ ਗੁਨੁ ਜੋ ਤੁਝੁ ਲੈ ਗਾਵਉ ॥",
      "transliteration": "kavan gun jo tujh lai gaavau ||",
      "translation": "What is that virtue, by which I may sing of You?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਵਨ ਬੋਲ ਪਾਰਬ੍ਰਹਮ ਰੀਝਾਵਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kavan bol paarabraham reejhaavau ||1|| rahaau ||",
      "translation": "What is that speech, by which I may please the Supreme Lord God? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਵਨ ਸੁ ਪੂਜਾ ਤੇਰੀ ਕਰਉ ॥",
      "transliteration": "kavan s poojaa teree karau ||",
      "translation": "What worship service shall I perform for You?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਵਨ ਸੁ ਬਿਧਿ ਜਿਤੁ ਭਵਜਲ ਤਰਉ ॥੨॥",
      "transliteration": "kavan s bidh jit bhavajal tarau ||2||",
      "translation": "How can I cross over the terrifying world-ocean? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਵਨ ਤਪੁ ਜਿਤੁ ਤਪੀਆ ਹੋਇ ॥",
      "transliteration": "kavan tap jit tapeeaa hoi ||",
      "translation": "What is that penance, by which I may become a penitent?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਵਨੁ ਸੁ ਨਾਮੁ ਹਉਮੈ ਮਲੁ ਖੋਇ ॥੩॥",
      "transliteration": "kavan s naam haumai mal khoi ||3||",
      "translation": "What is that Name, by which the filth of egotism may be washed away? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਣ ਪੂਜਾ ਗਿਆਨ ਧਿਆਨ ਨਾਨਕ ਸਗਲ ਘਾਲ ॥",
      "transliteration": "gun poojaa giaan dhiaan naanak sagal ghaal ||",
      "translation": "Virtue, worship, spiritual wisdom, meditation and all service, O Nanak,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਸੁ ਕਰਿ ਕਿਰਪਾ ਸਤਿਗੁਰੁ ਮਿਲੈ ਦਇਆਲ ॥੪॥",
      "transliteration": "jis kar kirapaa satigur milai daiaal ||4||",
      "translation": "are obtained from the True Guru, when, in His Mercy and Kindness, He meets us. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਿਸ ਹੀ ਗੁਨੁ ਤਿਨ ਹੀ ਪ੍ਰਭੁ ਜਾਤਾ ॥",
      "transliteration": "tis hee gun tin hee prabh jaataa ||",
      "translation": "They alone receive this merit, and they alone know God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਸ ਕੀ ਮਾਨਿ ਲੇਇ ਸੁਖਦਾਤਾ ॥੧॥ ਰਹਾਉ ਦੂਜਾ ॥੩੬॥੧੦੫॥",
      "transliteration": "jis kee maan lei sukhadaataa ||1|| rahaau doojaa ||36||105||",
      "translation": "who are approved by the Giver of peace. ||1||Second Pause||36||105||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਆਪਨ ਤਨੁ ਨਹੀ ਜਾ ਕੋ ਗਰਬਾ ॥",
      "transliteration": "aapan tan nahee jaa ko garabaa ||",
      "translation": "The body which you are so proud of, does not belong to you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਜ ਮਿਲਖ ਨਹੀ ਆਪਨ ਦਰਬਾ ॥੧॥",
      "transliteration": "raaj milakh nahee aapan darabaa ||1||",
      "translation": "Power, property and wealth are not yours. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਪਨ ਨਹੀ ਕਾ ਕਉ ਲਪਟਾਇਓ ॥",
      "transliteration": "aapan nahee kaa kau lapataaio ||",
      "translation": "They are not yours, so why do you cling to them?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਆਪਨ ਨਾਮੁ ਸਤਿਗੁਰ ਤੇ ਪਾਇਓ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aapan naam satigur te paaio ||1|| rahaau ||",
      "translation": "Only the Naam, the Name of the Lord, is yours; it is received from the True Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਤ ਬਨਿਤਾ ਆਪਨ ਨਹੀ ਭਾਈ ॥",
      "transliteration": "sut banitaa aapan nahee bhaaee ||",
      "translation": "Children, spouse and siblings are not yours.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਸਟ ਮੀਤ ਆਪ ਬਾਪੁ ਨ ਮਾਈ ॥੨॥",
      "transliteration": "isat meet aap baap na maaee ||2||",
      "translation": "Dear friends, mother and father are not yours. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੁਇਨਾ ਰੂਪਾ ਫੁਨਿ ਨਹੀ ਦਾਮ ॥",
      "transliteration": "suinaa roopaa phun nahee daam ||",
      "translation": "Gold, silver and money are not yours.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹੈਵਰ ਗੈਵਰ ਆਪਨ ਨਹੀ ਕਾਮ ॥੩॥",
      "transliteration": "haivar gaivar aapan nahee kaam ||3||",
      "translation": "Fine horses and magnificent elephants are of no use to you. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜੋ ਗੁਰਿ ਬਖਸਿ ਮਿਲਾਇਆ ॥",
      "transliteration": "kahu naanak jo gur bakhas milaaiaa ||",
      "translation": "Says Nanak, those whom the Guru forgives, meet with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਿਸ ਕਾ ਸਭੁ ਕਿਛੁ ਜਿਸ ਕਾ ਹਰਿ ਰਾਇਆ ॥੪॥੩੭॥੧੦੬॥",
      "transliteration": "tis kaa sabh kichh jis kaa har raaiaa ||4||37||106||",
      "translation": "Everything belongs to those who have the Lord as their King. ||4||37||106||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਣ ਊਪਰਿ ਮੇਰੇ ਮਾਥੇ ॥",
      "transliteration": "gur ke charan oopar mere maathe ||",
      "translation": "I place the Guru's Feet on my forehead,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਾ ਤੇ ਦੁਖ ਮੇਰੇ ਸਗਲੇ ਲਾਥੇ ॥੧॥",
      "transliteration": "taa te dukh mere sagale laathe ||1||",
      "translation": "and all my pains are gone. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਤਿਗੁਰ ਅਪੁਨੇ ਕਉ ਕੁਰਬਾਨੀ ॥",
      "transliteration": "satigur apune kau kurabaanee ||",
      "translation": "I am a sacrifice to my True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਤਮ ਚੀਨਿ ਪਰਮ ਰੰਗ ਮਾਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aatam cheen param ra(n)g maanee ||1|| rahaau ||",
      "translation": "I have come to understand my soul, and I enjoy supreme bliss. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚਰਣ ਰੇਣੁ ਗੁਰ ਕੀ ਮੁਖਿ ਲਾਗੀ ॥",
      "transliteration": "charan ren gur kee mukh laagee ||",
      "translation": "I have applied the dust of the Guru's Feet to my face,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਹੰਬੁਧਿ ਤਿਨਿ ਸਗਲ ਤਿਆਗੀ ॥੨॥",
      "transliteration": "aha(n)budh tin sagal tiaagee ||2||",
      "translation": "which has removed all my arrogant intellect. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਲਗੋ ਮਨਿ ਮੀਠਾ ॥",
      "transliteration": "gur kaa sabad lago man meethaa ||",
      "translation": "The Word of the Guru's Shabad has become sweet to my mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਤਾ ਤੇ ਮੋਹਿ ਡੀਠਾ ॥੩॥",
      "transliteration": "paarabraham taa te mohi deethaa ||3||",
      "translation": "and I behold the Supreme Lord God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗੁਰੁ ਸੁਖਦਾਤਾ ਗੁਰੁ ਕਰਤਾਰੁ ॥",
      "transliteration": "gur sukhadaataa gur karataar ||",
      "translation": "The Guru is the Giver of peace; the Guru is the Creator.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੀਅ ਪ੍ਰਾਣ ਨਾਨਕ ਗੁਰੁ ਆਧਾਰੁ ॥੪॥੩੮॥੧੦੭॥",
      "transliteration": "jee praan naanak gur aadhaar ||4||38||107||",
      "translation": "O Nanak, the Guru is the Support of the breath of life and the soul. ||4||38||107||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰੇ ਮਨ ਮੇਰੇ ਤੂੰ ਤਾ ਕਉ ਆਹਿ ॥",
      "transliteration": "re man mere too(n) taa kau aahi ||",
      "translation": "O my mind, seek the One,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾ ਕੈ ਊਣਾ ਕਛਹੂ ਨਾਹਿ ॥੧॥",
      "transliteration": "jaa kai oonaa kachhahoo naahi ||1||",
      "translation": "who lacks nothing. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਰਿ ਸਾ ਪ੍ਰੀਤਮੁ ਕਰਿ ਮਨ ਮੀਤ ॥",
      "transliteration": "har saa preetam kar man meet ||",
      "translation": "Make the Beloved Lord your friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪ੍ਰਾਨ ਅਧਾਰੁ ਰਾਖਹੁ ਸਦ ਚੀਤ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "praan adhaar raakhahu sad cheet ||1|| rahaau ||",
      "translation": "Keep Him constantly in your mind; He is the Support of the breath of life. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰੇ ਮਨ ਮੇਰੇ ਤੂੰ ਤਾ ਕਉ ਸੇਵਿ ॥",
      "transliteration": "re man mere too(n) taa kau sev ||",
      "translation": "O my mind, serve Him;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਦਿ ਪੁਰਖ ਅਪਰੰਪਰ ਦੇਵ ॥੨॥",
      "transliteration": "aad purakh apara(n)par dev ||2||",
      "translation": "He is the Primal Being, the Infinite Divine Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਿਸੁ ਊਪਰਿ ਮਨ ਕਰਿ ਤੂੰ ਆਸਾ ॥",
      "transliteration": "tis oopar man kar too(n) aasaa ||",
      "translation": "Place your hopes in the One",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਦਿ ਜੁਗਾਦਿ ਜਾ ਕਾ ਭਰਵਾਸਾ ॥੩॥",
      "transliteration": "aad jugaad jaa kaa bharavaasaa ||3||",
      "translation": "who is the Support of all beings, from the very beginning of time, and throughout the ages. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਾ ਕੀ ਪ੍ਰੀਤਿ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "jaa kee preet sadaa sukh hoi ||",
      "translation": "His Love brings eternal peace;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਨਕੁ ਗਾਵੈ ਗੁਰ ਮਿਲਿ ਸੋਇ ॥੪॥੩੯॥੧੦੮॥",
      "transliteration": "naanak gaavai gur mil soi ||4||39||108||",
      "translation": "meeting the Guru, Nanak sings His Glorious Praises. ||4||39||108||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮੀਤੁ ਕਰੈ ਸੋਈ ਹਮ ਮਾਨਾ ॥",
      "transliteration": "meet karai soee ham maanaa ||",
      "translation": "Whatever my Friend does, I accept.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੀਤ ਕੇ ਕਰਤਬ ਕੁਸਲ ਸਮਾਨਾ ॥੧॥",
      "transliteration": "meet ke karatab kusal samaanaa ||1||",
      "translation": "My Friend's actions are pleasing to me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਏਕਾ ਟੇਕ ਮੇਰੈ ਮਨਿ ਚੀਤ ॥",
      "transliteration": "ekaa tek merai man cheet ||",
      "translation": "Within my conscious mind, the One Lord is my only Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਿਸੁ ਕਿਛੁ ਕਰਣਾ ਸੁ ਹਮਰਾ ਮੀਤ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jis kichh karanaa s hamaraa meet ||1|| rahaau ||",
      "translation": "One who does this is my Friend. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮੀਤੁ ਹਮਾਰਾ ਵੇਪਰਵਾਹਾ ॥",
      "transliteration": "meet hamaaraa veparavaahaa ||",
      "translation": "My Friend is Carefree.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਮੋਹਿ ਅਸਨਾਹਾ ॥੨॥",
      "transliteration": "gur kirapaa te mohi asanaahaa ||2||",
      "translation": "By Guru's Grace, I give my love to Him. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮੀਤੁ ਹਮਾਰਾ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "meet hamaaraa a(n)tarajaamee ||",
      "translation": "My Friend is the Inner-knower, the Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਮਰਥ ਪੁਰਖੁ ਪਾਰਬ੍ਰਹਮੁ ਸੁਆਮੀ ॥੩॥",
      "transliteration": "samarath purakh paarabraham suaamee ||3||",
      "translation": "He is the All-powerful Being, the Supreme Lord and Master. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0187_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਹਮ ਦਾਸੇ ਤੁਮ ਠਾਕੁਰ ਮੇਰੇ ॥",
      "transliteration": "ham daase tum thaakur mere ||",
      "translation": "I am Your servant; You are my Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 187,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
