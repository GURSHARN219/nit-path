{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 188,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0188_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਾਨੁ ਮਹਤੁ ਨਾਨਕ ਪ੍ਰਭੁ ਤੇਰੇ ॥੪॥੪੦॥੧੦੯॥",
      "transliteration": "maan mahat naanak prabh tere ||4||40||109||",
      "translation": "Nanak: my honor and glory are Yours, God. ||4||40||109||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਾ ਕਉ ਤੁਮ ਭਏ ਸਮਰਥ ਅੰਗਾ ॥",
      "transliteration": "jaa kau tum bhae samarath a(n)gaa ||",
      "translation": "Those who have You on their side, O All-powerful Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਾ ਕਉ ਕਛੁ ਨਾਹੀ ਕਾਲੰਗਾ ॥੧॥",
      "transliteration": "taa kau kachh naahee kaala(n)gaa ||1||",
      "translation": "- no black stain can stick to them. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਾਧਉ ਜਾ ਕਉ ਹੈ ਆਸ ਤੁਮਾਰੀ ॥",
      "transliteration": "maadhau jaa kau hai aas tumaaree ||",
      "translation": "O Lord of wealth, those who place their hopes in You",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਾ ਕਉ ਕਛੁ ਨਾਹੀ ਸੰਸਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "taa kau kachh naahee sa(n)saaree ||1|| rahaau ||",
      "translation": "- nothing of the world can touch them at all. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਾ ਕੈ ਹਿਰਦੈ ਠਾਕੁਰੁ ਹੋਇ ॥",
      "transliteration": "jaa kai hiradai thaakur hoi ||",
      "translation": "Those whose hearts are filled with their Lord and Master",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਾ ਕਉ ਸਹਸਾ ਨਾਹੀ ਕੋਇ ॥੨॥",
      "transliteration": "taa kau sahasaa naahee koi ||2||",
      "translation": "- no anxiety can affect them. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਾ ਕਉ ਤੁਮ ਦੀਨੀ ਪ੍ਰਭ ਧੀਰ ॥",
      "transliteration": "jaa kau tum deenee prabh dheer ||",
      "translation": "Those, unto whom You give Your consolation, God",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਾ ਕੈ ਨਿਕਟਿ ਨ ਆਵੈ ਪੀਰ ॥੩॥",
      "transliteration": "taa kai nikat na aavai peer ||3||",
      "translation": "- pain does not even approach them. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਮੈ ਸੋ ਗੁਰੁ ਪਾਇਆ ॥",
      "transliteration": "kahu naanak mai so gur paaiaa ||",
      "translation": "Says Nanak, I have found that Guru,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਪੂਰਨ ਦੇਖਾਇਆ ॥੪॥੪੧॥੧੧੦॥",
      "transliteration": "paarabraham pooran dekhaaiaa ||4||41||110||",
      "translation": "who has shown me the Perfect, Supreme Lord God. ||4||41||110||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੁਲਭ ਦੇਹ ਪਾਈ ਵਡਭਾਗੀ ॥",
      "transliteration": "dulabh deh paaee vadabhaagee ||",
      "translation": "This human body is so difficult to obtain; it is only obtained by great good fortune.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਮੁ ਨ ਜਪਹਿ ਤੇ ਆਤਮ ਘਾਤੀ ॥੧॥",
      "transliteration": "naam na japahi te aatam ghaatee ||1||",
      "translation": "Those who do not meditate on the Naam, the Name of the Lord, are murderers of the soul. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਰਿ ਨ ਜਾਹੀ ਜਿਨਾ ਬਿਸਰਤ ਰਾਮ ॥",
      "transliteration": "mar na jaahee jinaa bisarat raam ||",
      "translation": "Those who forget the Lord might just as well die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਮ ਬਿਹੂਨ ਜੀਵਨ ਕਉਨ ਕਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naam bihoon jeevan kaun kaam ||1|| rahaau ||",
      "translation": "Without the Naam, of what use are their lives? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਖਾਤ ਪੀਤ ਖੇਲਤ ਹਸਤ ਬਿਸਥਾਰ ॥",
      "transliteration": "khaat peet khelat hasat bisathaar ||",
      "translation": "Eating, drinking, playing, laughing and showing off",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਵਨ ਅਰਥ ਮਿਰਤਕ ਸੀਗਾਰ ॥੨॥",
      "transliteration": "kavan arath miratak seegaar ||2||",
      "translation": "- what use are the ostentatious displays of the dead? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੋ ਨ ਸੁਨਹਿ ਜਸੁ ਪਰਮਾਨੰਦਾ ॥",
      "transliteration": "jo na sunahi jas paramaana(n)daa ||",
      "translation": "Those who do not listen to the Praises of the Lord of supreme bliss,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਸੁ ਪੰਖੀ ਤ੍ਰਿਗਦ ਜੋਨਿ ਤੇ ਮੰਦਾ ॥੩॥",
      "transliteration": "pas pa(n)khee trigad jon te ma(n)daa ||3||",
      "translation": "are worse off than beasts, birds or creeping creatures. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰਿ ਮੰਤ੍ਰੁ ਦ੍ਰਿੜਾਇਆ ॥",
      "transliteration": "kahu naanak gur ma(n)tr driRaaiaa ||",
      "translation": "Says Nanak, the GurMantra has been implanted within me;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕੇਵਲ ਨਾਮੁ ਰਿਦ ਮਾਹਿ ਸਮਾਇਆ ॥੪॥੪੨॥੧੧੧॥",
      "transliteration": "keval naam rid maahi samaaiaa ||4||42||111||",
      "translation": "the Name alone is contained within my heart. ||4||42||111||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਾ ਕੀ ਮਾਈ ਕਾ ਕੋ ਬਾਪ ॥",
      "transliteration": "kaa kee maaee kaa ko baap ||",
      "translation": "Whose mother is this? Whose father is this?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਮ ਧਾਰੀਕ ਝੂਠੇ ਸਭਿ ਸਾਕ ॥੧॥",
      "transliteration": "naam dhaareek jhoothe sabh saak ||1||",
      "translation": "They are relatives in name only- they are all false. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਾਹੇ ਕਉ ਮੂਰਖ ਭਖਲਾਇਆ ॥",
      "transliteration": "kaahe kau moorakh bhakhalaaiaa ||",
      "translation": "Why are you screaming and shouting, you fool?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਿਲਿ ਸੰਜੋਗਿ ਹੁਕਮਿ ਤੂੰ ਆਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mil sa(n)jog hukam too(n) aaiaa ||1|| rahaau ||",
      "translation": "By good destiny and the Lord's Order, you have come into the world. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਏਕਾ ਮਾਟੀ ਏਕਾ ਜੋਤਿ ॥",
      "transliteration": "ekaa maatee ekaa jot ||",
      "translation": "There is the one dust, the one light,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਏਕੋ ਪਵਨੁ ਕਹਾ ਕਉਨੁ ਰੋਤਿ ॥੨॥",
      "transliteration": "eko pavan kahaa kaun rot ||2||",
      "translation": "the one praanic wind. Why are you crying? For whom do you cry? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੇਰਾ ਮੇਰਾ ਕਰਿ ਬਿਲਲਾਹੀ ॥",
      "transliteration": "meraa meraa kar bilalaahee ||",
      "translation": "People weep and cry out, \"Mine, mine!\"",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਰਣਹਾਰੁ ਇਹੁ ਜੀਅਰਾ ਨਾਹੀ ॥੩॥",
      "transliteration": "maranahaar ihu jeearaa naahee ||3||",
      "translation": "This soul is not perishable. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰਿ ਖੋਲੇ ਕਪਾਟ ॥",
      "transliteration": "kahu naanak gur khole kapaat ||",
      "translation": "Says Nanak, the Guru has opened my shutters;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮੁਕਤੁ ਭਏ ਬਿਨਸੇ ਭ੍ਰਮ ਥਾਟ ॥੪॥੪੩॥੧੧੨॥",
      "transliteration": "mukat bhae binase bhram thaat ||4||43||112||",
      "translation": "I am liberated, and my doubts have been dispelled. ||4||43||112||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਵਡੇ ਵਡੇ ਜੋ ਦੀਸਹਿ ਲੋਗ ॥",
      "transliteration": "vade vade jo deesahi log ||",
      "translation": "Those who seem to be great and powerful,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਿਨ ਕਉ ਬਿਆਪੈ ਚਿੰਤਾ ਰੋਗ ॥੧॥",
      "transliteration": "tin kau biaapai chi(n)taa rog ||1||",
      "translation": "are afflicted by the disease of anxiety. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਉਨ ਵਡਾ ਮਾਇਆ ਵਡਿਆਈ ॥",
      "transliteration": "kaun vadaa maaiaa vadiaaee ||",
      "translation": "Who is great by the greatness of Maya?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੋ ਵਡਾ ਜਿਨਿ ਰਾਮ ਲਿਵ ਲਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "so vadaa jin raam liv laaee ||1|| rahaau ||",
      "translation": "They alone are great, who are lovingly attached to the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭੂਮੀਆ ਭੂਮਿ ਊਪਰਿ ਨਿਤ ਲੁਝੈ ॥",
      "transliteration": "bhoomeeaa bhoom oopar nit lujhai ||",
      "translation": "The landlord fights over his land each day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਛੋਡਿ ਚਲੈ ਤ੍ਰਿਸਨਾ ਨਹੀ ਬੁਝੈ ॥੨॥",
      "transliteration": "chhod chalai trisanaa nahee bujhai ||2||",
      "translation": "He shall have to leave it in the end, and yet his desire is still not satisfied. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਇਹੁ ਤਤੁ ਬੀਚਾਰਾ ॥",
      "transliteration": "kahu naanak ihu tat beechaaraa ||",
      "translation": "Says Nanak, this is the essence of Truth:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਭਜਨ ਨਾਹੀ ਛੁਟਕਾਰਾ ॥੩॥੪੪॥੧੧੩॥",
      "transliteration": "bin har bhajan naahee chhutakaaraa ||3||44||113||",
      "translation": "without the Lord's meditation, there is no salvation. ||3||44||113||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪੂਰਾ ਮਾਰਗੁ ਪੂਰਾ ਇਸਨਾਨੁ ॥",
      "transliteration": "pooraa maarag pooraa isanaan ||",
      "translation": "Perfect is the path; perfect is the cleansing bath.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਭੁ ਕਿਛੁ ਪੂਰਾ ਹਿਰਦੈ ਨਾਮੁ ॥੧॥",
      "transliteration": "sabh kichh pooraa hiradai naam ||1||",
      "translation": "Everything is perfect, if the Naam is in the heart. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪੂਰੀ ਰਹੀ ਜਾ ਪੂਰੈ ਰਾਖੀ ॥",
      "transliteration": "pooree rahee jaa poorai raakhee ||",
      "translation": "One's honor remains perfect, when the Perfect Lord preserves it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕੀ ਸਰਣਿ ਜਨ ਤਾਕੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "paarabraham kee saran jan taakee ||1|| rahaau ||",
      "translation": "His servant takes to the Sanctuary of the Supreme Lord God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਪੂਰਾ ਸੁਖੁ ਪੂਰਾ ਸੰਤੋਖੁ ॥",
      "transliteration": "pooraa sukh pooraa sa(n)tokh ||",
      "translation": "Perfect is the peace; perfect is the contentment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪੂਰਾ ਤਪੁ ਪੂਰਨ ਰਾਜੁ ਜੋਗੁ ॥੨॥",
      "transliteration": "pooraa tap pooran raaj jog ||2||",
      "translation": "Perfect is the penance; perfect is the Raja Yoga, the Yoga of meditation and success. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਰਿ ਕੈ ਮਾਰਗਿ ਪਤਿਤ ਪੁਨੀਤ ॥",
      "transliteration": "har kai maarag patit puneet ||",
      "translation": "On the Lord's Path, sinners are purified.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪੂਰੀ ਸੋਭਾ ਪੂਰਾ ਲੋਕੀਕ ॥੩॥",
      "transliteration": "pooree sobhaa pooraa lokeek ||3||",
      "translation": "Perfect is their glory; perfect is their humanity. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਰਣਹਾਰੁ ਸਦ ਵਸੈ ਹਦੂਰਾ ॥",
      "transliteration": "karanahaar sad vasai hadooraa ||",
      "translation": "They dwell forever in the Presence of the Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਮੇਰਾ ਸਤਿਗੁਰੁ ਪੂਰਾ ॥੪॥੪੫॥੧੧੪॥",
      "transliteration": "kahu naanak meraa satigur pooraa ||4||45||114||",
      "translation": "Says Nanak, my True Guru is Perfect. ||4||45||114||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0188_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸੰਤ ਕੀ ਧੂਰਿ ਮਿਟੇ ਅਘ ਕੋਟ ॥",
      "transliteration": "sa(n)t kee dhoor mite agh kot ||",
      "translation": "Millions of sins are wiped away by the dust of the feet of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 188,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
