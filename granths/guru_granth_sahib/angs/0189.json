{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 189,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0189_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਜਨਮ ਮਰਣ ਤੇ ਛੋਟ ॥੧॥",
      "transliteration": "sa(n)t prasaad janam maran te chhot ||1||",
      "translation": "By the Grace of the Saints, one is released from birth and death. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੰਤ ਕਾ ਦਰਸੁ ਪੂਰਨ ਇਸਨਾਨੁ ॥",
      "transliteration": "sa(n)t kaa daras pooran isanaan ||",
      "translation": "The Blessed Vision of the Saints is the perfect cleansing bath.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੰਤ ਕ੍ਰਿਪਾ ਤੇ ਜਪੀਐ ਨਾਮੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sa(n)t kripaa te japeeai naam ||1|| rahaau ||",
      "translation": "By the Grace of the Saints, one comes to chant the Naam, the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੰਤ ਕੈ ਸੰਗਿ ਮਿਟਿਆ ਅਹੰਕਾਰੁ ॥",
      "transliteration": "sa(n)t kai sa(n)g mitiaa aha(n)kaar ||",
      "translation": "In the Society of the Saints, egotism is shed,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦ੍ਰਿਸਟਿ ਆਵੈ ਸਭੁ ਏਕੰਕਾਰੁ ॥੨॥",
      "transliteration": "drisat aavai sabh eka(n)kaar ||2||",
      "translation": "and the One Lord is seen everywhere. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੰਤ ਸੁਪ੍ਰਸੰਨ ਆਏ ਵਸਿ ਪੰਚਾ ॥",
      "transliteration": "sa(n)t suprasa(n)n aae vas pa(n)chaa ||",
      "translation": "By the pleasure of the Saints, the five passions are overpowered,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਨਾਮੁ ਰਿਦੈ ਲੈ ਸੰਚਾ ॥੩॥",
      "transliteration": "a(n)mrit naam ridai lai sa(n)chaa ||3||",
      "translation": "and the heart is irrigated with the Ambrosial Naam. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਾ ਕਾ ਪੂਰਾ ਕਰਮ ॥",
      "transliteration": "kahu naanak jaa kaa pooraa karam ||",
      "translation": "Says Nanak, one whose karma is perfect,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਿਸੁ ਭੇਟੇ ਸਾਧੂ ਕੇ ਚਰਨ ॥੪॥੪੬॥੧੧੫॥",
      "transliteration": "tis bhete saadhoo ke charan ||4||46||115||",
      "translation": "touches the feet of the Holy. ||4||46||115||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਜਪਤ ਕਮਲੁ ਪਰਗਾਸੈ ॥",
      "transliteration": "har gun japat kamal paragaasai ||",
      "translation": "Meditating on the Glories of the Lord, the heart-lotus blossoms radiantly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਤ੍ਰਾਸ ਸਭ ਨਾਸੈ ॥੧॥",
      "transliteration": "har simarat traas sabh naasai ||1||",
      "translation": "Remembering the Lord in meditation, all fears are dispelled. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾ ਮਤਿ ਪੂਰੀ ਜਿਤੁ ਹਰਿ ਗੁਣ ਗਾਵੈ ॥",
      "transliteration": "saa mat pooree jit har gun gaavai ||",
      "translation": "Perfect is that intellect, by which the Glorious Praises of the Lord are sung.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਵਡੈ ਭਾਗਿ ਸਾਧੂ ਸੰਗੁ ਪਾਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "vadai bhaag saadhoo sa(n)g paavai ||1|| rahaau ||",
      "translation": "By great good fortune, one finds the Saadh Sangat, the Company of the Holy. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਪਾਈਐ ਨਿਧਿ ਨਾਮਾ ॥",
      "transliteration": "saadhasa(n)g paaeeai nidh naamaa ||",
      "translation": "In the Saadh Sangat, the treasure of the Name is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਪੂਰਨ ਸਭਿ ਕਾਮਾ ॥੨॥",
      "transliteration": "saadhasa(n)g pooran sabh kaamaa ||2||",
      "translation": "In the Saadh Sangat, all one's works are brought to fruition. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰਿ ਕੀ ਭਗਤਿ ਜਨਮੁ ਪਰਵਾਣੁ ॥",
      "transliteration": "har kee bhagat janam paravaan ||",
      "translation": "Through devotion to the Lord, one's life is approved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਨਾਮੁ ਵਖਾਣੁ ॥੩॥",
      "transliteration": "gur kirapaa te naam vakhaan ||3||",
      "translation": "By Guru's Grace, one chants the Naam, the Name of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਸੋ ਜਨੁ ਪਰਵਾਨੁ ॥",
      "transliteration": "kahu naanak so jan paravaan ||",
      "translation": "Says Nanak, that humble being is accepted,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਾ ਕੈ ਰਿਦੈ ਵਸੈ ਭਗਵਾਨੁ ॥੪॥੪੭॥੧੧੬॥",
      "transliteration": "jaa kai ridai vasai bhagavaan ||4||47||116||",
      "translation": "within whose heart the Lord God abides. ||4||47||116||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਏਕਸੁ ਸਿਉ ਜਾ ਕਾ ਮਨੁ ਰਾਤਾ ॥",
      "transliteration": "ekas siu jaa kaa man raataa ||",
      "translation": "Those whose minds are imbued with the One Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਵਿਸਰੀ ਤਿਸੈ ਪਰਾਈ ਤਾਤਾ ॥੧॥",
      "transliteration": "visaree tisai paraaee taataa ||1||",
      "translation": "forget to feel jealous of others. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਿਨੁ ਗੋਬਿੰਦ ਨ ਦੀਸੈ ਕੋਈ ॥",
      "transliteration": "bin gobi(n)d na deesai koee ||",
      "translation": "They see none other than the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਕਰਤਾ ਸੋਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "karan karaavan karataa soee ||1|| rahaau ||",
      "translation": "The Creator is the Doer, the Cause of causes. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨਹਿ ਕਮਾਵੈ ਮੁਖਿ ਹਰਿ ਹਰਿ ਬੋਲੈ ॥",
      "transliteration": "manahi kamaavai mukh har har bolai ||",
      "translation": "Those who work willingly, and chant the Name of the Lord, Har, Har",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੋ ਜਨੁ ਇਤ ਉਤ ਕਤਹਿ ਨ ਡੋਲੈ ॥੨॥",
      "transliteration": "so jan it ut katahi na dolai ||2||",
      "translation": "- they do not waver, here or hereafter. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾ ਕੈ ਹਰਿ ਧਨੁ ਸੋ ਸਚ ਸਾਹੁ ॥",
      "transliteration": "jaa kai har dhan so sach saahu ||",
      "translation": "Those who possess the wealth of the Lord are the true bankers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਕਰਿ ਦੀਨੋ ਵਿਸਾਹੁ ॥੩॥",
      "transliteration": "gur poorai kar deeno visaahu ||3||",
      "translation": "The Perfect Guru has established their line of credit. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੀਵਨ ਪੁਰਖੁ ਮਿਲਿਆ ਹਰਿ ਰਾਇਆ ॥",
      "transliteration": "jeevan purakh miliaa har raaiaa ||",
      "translation": "The Giver of life, the Sovereign Lord King meets them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਪਰਮ ਪਦੁ ਪਾਇਆ ॥੪॥੪੮॥੧੧੭॥",
      "transliteration": "kahu naanak param pad paaiaa ||4||48||117||",
      "translation": "Says Nanak, they attain the supreme status. ||4||48||117||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਮੁ ਭਗਤ ਕੈ ਪ੍ਰਾਨ ਅਧਾਰੁ ॥",
      "transliteration": "naam bhagat kai praan adhaar ||",
      "translation": "The Naam, the Name of the Lord, is the Support of the breath of life of His devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਮੋ ਧਨੁ ਨਾਮੋ ਬਿਉਹਾਰੁ ॥੧॥",
      "transliteration": "naamo dhan naamo biuhaar ||1||",
      "translation": "The Naam is their wealth, the Naam is their occupation. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਮ ਵਡਾਈ ਜਨੁ ਸੋਭਾ ਪਾਏ ॥",
      "transliteration": "naam vadaaee jan sobhaa paae ||",
      "translation": "By the greatness of the Naam, His humble servants are blessed with glory.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਆਪਿ ਦਿਵਾਏ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa jis aap divaae ||1|| rahaau ||",
      "translation": "The Lord Himself bestows it, in His Mercy. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਮੁ ਭਗਤ ਕੈ ਸੁਖ ਅਸਥਾਨੁ ॥",
      "transliteration": "naam bhagat kai sukh asathaan ||",
      "translation": "The Naam is the home of peace of His devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਮ ਰਤੁ ਸੋ ਭਗਤੁ ਪਰਵਾਨੁ ॥੨॥",
      "transliteration": "naam rat so bhagat paravaan ||2||",
      "translation": "Attuned to the Naam, His devotees are approved. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਜਨ ਕਉ ਧਾਰੈ ॥",
      "transliteration": "har kaa naam jan kau dhaarai ||",
      "translation": "The Name of the Lord is the support of His humble servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਾਸਿ ਸਾਸਿ ਜਨੁ ਨਾਮੁ ਸਮਾਰੈ ॥੩॥",
      "transliteration": "saas saas jan naam samaarai ||3||",
      "translation": "With each and every breath, they remember the Naam. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਿਸੁ ਪੂਰਾ ਭਾਗੁ ॥",
      "transliteration": "kahu naanak jis pooraa bhaag ||",
      "translation": "Says Nanak, those who have perfect destiny",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਮ ਸੰਗਿ ਤਾ ਕਾ ਮਨੁ ਲਾਗੁ ॥੪॥੪੯॥੧੧੮॥",
      "transliteration": "naam sa(n)g taa kaa man laag ||4||49||118||",
      "translation": "- their minds are attached to the Naam. ||4||49||118||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਹਰਿ ਨਾਮੁ ਧਿਆਇਆ ॥",
      "transliteration": "sa(n)t prasaad har naam dhiaaiaa ||",
      "translation": "By the Grace of the Saints, I meditated on the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਬ ਤੇ ਧਾਵਤੁ ਮਨੁ ਤ੍ਰਿਪਤਾਇਆ ॥੧॥",
      "transliteration": "tab te dhaavat man tripataaiaa ||1||",
      "translation": "Since then, my restless mind has been satisfied. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੁਖ ਬਿਸ੍ਰਾਮੁ ਪਾਇਆ ਗੁਣ ਗਾਇ ॥",
      "transliteration": "sukh bisraam paaiaa gun gaai ||",
      "translation": "I have obtained the home of peace, singing His Glorious Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸ੍ਰਮੁ ਮਿਟਿਆ ਮੇਰੀ ਹਤੀ ਬਲਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sram mitiaa meree hatee balaai ||1|| rahaau ||",
      "translation": "My troubles have ended, and the demon has been destroyed. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਅਰਾਧਿ ਭਗਵੰਤਾ ॥",
      "transliteration": "charan kamal araadh bhagava(n)taa ||",
      "translation": "Worship and adore the Lotus Feet of the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨ ਤੇ ਮਿਟੀ ਮੇਰੀ ਚਿੰਤਾ ॥੨॥",
      "transliteration": "har simaran te mitee meree chi(n)taa ||2||",
      "translation": "Meditating in remembrance on the Lord, my anxiety has come to an end. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਭ ਤਜਿ ਅਨਾਥੁ ਏਕ ਸਰਣਿ ਆਇਓ ॥",
      "transliteration": "sabh taj anaath ek saran aaio ||",
      "translation": "I have renounced all - I am an orphan. I have come to the Sanctuary of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਊਚ ਅਸਥਾਨੁ ਤਬ ਸਹਜੇ ਪਾਇਓ ॥੩॥",
      "transliteration": "ooch asathaan tab sahaje paaio ||3||",
      "translation": "Since then, I have found the highest celestial home. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਦੂਖੁ ਦਰਦੁ ਭਰਮੁ ਭਉ ਨਸਿਆ ॥",
      "transliteration": "dookh darad bharam bhau nasiaa ||",
      "translation": "My pains, troubles, doubts and fears are gone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਰਣਹਾਰੁ ਨਾਨਕ ਮਨਿ ਬਸਿਆ ॥੪॥੫੦॥੧੧੯॥",
      "transliteration": "karanahaar naanak man basiaa ||4||50||119||",
      "translation": "The Creator Lord abides in Nanak's mind. ||4||50||119||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0189_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਰ ਕਰਿ ਟਹਲ ਰਸਨਾ ਗੁਣ ਗਾਵਉ ॥",
      "transliteration": "kar kar tahal rasanaa gun gaavau ||",
      "translation": "With my hands I do His work; with my tongue I sing His Glorious Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 189,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
