{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 190,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0190_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਰਨ ਠਾਕੁਰ ਕੈ ਮਾਰਗਿ ਧਾਵਉ ॥੧॥",
      "transliteration": "charan thaakur kai maarag dhaavau ||1||",
      "translation": "With my feet, I walk on the Path of my Lord and Master. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭਲੋ ਸਮੋ ਸਿਮਰਨ ਕੀ ਬਰੀਆ ॥",
      "transliteration": "bhalo samo simaran kee bareeaa ||",
      "translation": "It is a good time, when I remember Him in meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਿਮਰਤ ਨਾਮੁ ਭੈ ਪਾਰਿ ਉਤਰੀਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "simarat naam bhai paar utareeaa ||1|| rahaau ||",
      "translation": "Meditating on the Naam, the Name of the Lord, I cross over the terrifying world-ocean. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨੇਤ੍ਰ ਸੰਤਨ ਕਾ ਦਰਸਨੁ ਪੇਖੁ ॥",
      "transliteration": "netr sa(n)tan kaa darasan pekh ||",
      "translation": "With your eyes, behold the Blessed Vision of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪ੍ਰਭ ਅਵਿਨਾਸੀ ਮਨ ਮਹਿ ਲੇਖੁ ॥੨॥",
      "transliteration": "prabh avinaasee man mahi lekh ||2||",
      "translation": "Record the Immortal Lord God within your mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੁਣਿ ਕੀਰਤਨੁ ਸਾਧ ਪਹਿ ਜਾਇ ॥",
      "transliteration": "sun keeratan saadh pahi jaai ||",
      "translation": "Listen to the Kirtan of His Praises, at the Feet of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਨਮ ਮਰਣ ਕੀ ਤ੍ਰਾਸ ਮਿਟਾਇ ॥੩॥",
      "transliteration": "janam maran kee traas mitaai ||3||",
      "translation": "Your fears of birth and death shall depart. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚਰਣ ਕਮਲ ਠਾਕੁਰ ਉਰਿ ਧਾਰਿ ॥",
      "transliteration": "charan kamal thaakur ur dhaar ||",
      "translation": "Enshrine the Lotus Feet of your Lord and Master within your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੁਲਭ ਦੇਹ ਨਾਨਕ ਨਿਸਤਾਰਿ ॥੪॥੫੧॥੧੨੦॥",
      "transliteration": "dulabh deh naanak nisataar ||4||51||120||",
      "translation": "Thus this human life, so difficult to obtain, shall be redeemed. ||4||51||120||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਾ ਕਉ ਅਪਨੀ ਕਿਰਪਾ ਧਾਰੈ ॥",
      "transliteration": "jaa kau apanee kirapaa dhaarai ||",
      "translation": "Those, upon whom the Lord Himself showers His Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੋ ਜਨੁ ਰਸਨਾ ਨਾਮੁ ਉਚਾਰੈ ॥੧॥",
      "transliteration": "so jan rasanaa naam uchaarai ||1||",
      "translation": "chant the Naam, the Name of the Lord, with their tongues. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਰਿ ਬਿਸਰਤ ਸਹਸਾ ਦੁਖੁ ਬਿਆਪੈ ॥",
      "transliteration": "har bisarat sahasaa dukh biaapai ||",
      "translation": "Forgetting the Lord, superstition and sorrow shall overtake you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਿਮਰਤ ਨਾਮੁ ਭਰਮੁ ਭਉ ਭਾਗੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "simarat naam bharam bhau bhaagai ||1|| rahaau ||",
      "translation": "Meditating on the Naam, doubt and fear shall depart. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹਰਿ ਕੀਰਤਨੁ ਸੁਣੈ ਹਰਿ ਕੀਰਤਨੁ ਗਾਵੈ ॥",
      "transliteration": "har keeratan sunai har keeratan gaavai ||",
      "translation": "Listening to the Kirtan of the Lord's Praises, and singing the Lord's Kirtan,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਦੂਖੁ ਨਿਕਟਿ ਨਹੀ ਆਵੈ ॥੨॥",
      "transliteration": "tis jan dookh nikat nahee aavai ||2||",
      "translation": "misfortune shall not even come near you. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰਿ ਕੀ ਟਹਲ ਕਰਤ ਜਨੁ ਸੋਹੈ ॥",
      "transliteration": "har kee tahal karat jan sohai ||",
      "translation": "Working for the Lord, His humble servants look beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਕਉ ਮਾਇਆ ਅਗਨਿ ਨ ਪੋਹੈ ॥੩॥",
      "transliteration": "taa kau maaiaa agan na pohai ||3||",
      "translation": "The fire of Maya does not touch them. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਨਿ ਤਨਿ ਮੁਖਿ ਹਰਿ ਨਾਮੁ ਦਇਆਲ ॥",
      "transliteration": "man tan mukh har naam daiaal ||",
      "translation": "Within their minds, bodies and mouths, is the Name of the Merciful Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਨਕ ਤਜੀਅਲੇ ਅਵਰਿ ਜੰਜਾਲ ॥੪॥੫੨॥੧੨੧॥",
      "transliteration": "naanak tajeeale avar ja(n)jaal ||4||52||121||",
      "translation": "Nanak has renounced other entanglements. ||4||52||121||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਛਾਡਿ ਸਿਆਨਪ ਬਹੁ ਚਤੁਰਾਈ ॥",
      "transliteration": "chhaad siaanap bahu chaturaaee ||",
      "translation": "Renounce your cleverness, and your cunning tricks.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕੀ ਟੇਕ ਟਿਕਾਈ ॥੧॥",
      "transliteration": "gur poore kee tek tikaaee ||1||",
      "translation": "Seek the Support of the Perfect Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੁਖ ਬਿਨਸੇ ਸੁਖ ਹਰਿ ਗੁਣ ਗਾਇ ॥",
      "transliteration": "dukh binase sukh har gun gaai ||",
      "translation": "Your pain shall depart, and in peace, you shall sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰੁ ਪੂਰਾ ਭੇਟਿਆ ਲਿਵ ਲਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur pooraa bhetiaa liv laai ||1|| rahaau ||",
      "translation": "Meeting the Perfect Guru, let yourself be absorbed in the Lord's Love. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਦੀਓ ਗੁਰਿ ਮੰਤ੍ਰੁ ॥",
      "transliteration": "har kaa naam deeo gur ma(n)tr ||",
      "translation": "The Guru has given me the Mantra of the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਿਟੇ ਵਿਸੂਰੇ ਉਤਰੀ ਚਿੰਤ ॥੨॥",
      "transliteration": "mite visoore utaree chi(n)t ||2||",
      "translation": "My worries are forgotten, and my anxiety is gone. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਨਦ ਭਏ ਗੁਰ ਮਿਲਤ ਕ੍ਰਿਪਾਲ ॥",
      "transliteration": "anad bhae gur milat kripaal ||",
      "translation": "Meeting with the Merciful Guru, I am in ecstasy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਕਾਟੇ ਜਮ ਜਾਲ ॥੩॥",
      "transliteration": "kar kirapaa kaate jam jaal ||3||",
      "translation": "Showering His Mercy, He has cut away the noose of the Messenger of Death. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰੁ ਪੂਰਾ ਪਾਇਆ ॥",
      "transliteration": "kahu naanak gur pooraa paaiaa ||",
      "translation": "Says Nanak, I have found the Perfect Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਾ ਤੇ ਬਹੁਰਿ ਨ ਬਿਆਪੈ ਮਾਇਆ ॥੪॥੫੩॥੧੨੨॥",
      "transliteration": "taa te bahur na biaapai maaiaa ||4||53||122||",
      "translation": "Maya shall no longer harass me. ||4||53||122||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰਾਖਿ ਲੀਆ ਗੁਰਿ ਪੂਰੈ ਆਪਿ ॥",
      "transliteration": "raakh leeaa gur poorai aap ||",
      "translation": "The Perfect Guru Himself has saved me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਨਮੁਖ ਕਉ ਲਾਗੋ ਸੰਤਾਪੁ ॥੧॥",
      "transliteration": "manamukh kau laago sa(n)taap ||1||",
      "translation": "The self-willed manmukhs are afflicted with misfortune. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰੂ ਗੁਰੂ ਜਪਿ ਮੀਤ ਹਮਾਰੇ ॥",
      "transliteration": "guroo guroo jap meet hamaare ||",
      "translation": "Chant and meditate on the Guru, the Guru, O my friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੁਖ ਊਜਲ ਹੋਵਹਿ ਦਰਬਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mukh oojal hovahi darabaare ||1|| rahaau ||",
      "translation": "Your face shall be radiant in the Court of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਣ ਹਿਰਦੈ ਵਸਾਇ ॥",
      "transliteration": "gur ke charan hiradai vasaai ||",
      "translation": "Enshrine the Feet of the Guru within your heart;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੁਖ ਦੁਸਮਨ ਤੇਰੀ ਹਤੈ ਬਲਾਇ ॥੨॥",
      "transliteration": "dukh dusaman teree hatai balaai ||2||",
      "translation": "your pains, enemies and bad luck shall be destroyed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਤੇਰੈ ਸੰਗਿ ਸਹਾਈ ॥",
      "transliteration": "gur kaa sabad terai sa(n)g sahaaee ||",
      "translation": "The Word of the Guru's Shabad is your Companion and Helper.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦਇਆਲ ਭਏ ਸਗਲੇ ਜੀਅ ਭਾਈ ॥੩॥",
      "transliteration": "daiaal bhae sagale jee bhaaee ||3||",
      "translation": "O Siblings of Destiny, all beings shall be kind to you. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਜਬ ਕਿਰਪਾ ਕਰੀ ॥",
      "transliteration": "gur poorai jab kirapaa karee ||",
      "translation": "When the Perfect Guru granted His Grace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਨਤਿ ਨਾਨਕ ਮੇਰੀ ਪੂਰੀ ਪਰੀ ॥੪॥੫੪॥੧੨੩॥",
      "transliteration": "bhanat naanak meree pooree paree ||4||54||123||",
      "translation": "says Nanak, I was totally, completely fulfilled. ||4||54||123||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਨਿਕ ਰਸਾ ਖਾਏ ਜੈਸੇ ਢੋਰ ॥",
      "transliteration": "anik rasaa khaae jaise dhor ||",
      "translation": "Like beasts, they consume all sorts of tasty treats.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮੋਹ ਕੀ ਜੇਵਰੀ ਬਾਧਿਓ ਚੋਰ ॥੧॥",
      "transliteration": "moh kee jevaree baadhio chor ||1||",
      "translation": "With the rope of emotional attachment, they are bound and gagged like thieves. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਿਰਤਕ ਦੇਹ ਸਾਧਸੰਗ ਬਿਹੂਨਾ ॥",
      "transliteration": "miratak deh saadhasa(n)g bihoonaa ||",
      "translation": "Their bodies are corpses, without the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਵਤ ਜਾਤ ਜੋਨੀ ਦੁਖ ਖੀਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aavat jaat jonee dukh kheenaa ||1|| rahaau ||",
      "translation": "They come and go in reincarnation, and are destroyed by pain. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਨਿਕ ਬਸਤ੍ਰ ਸੁੰਦਰ ਪਹਿਰਾਇਆ ॥",
      "transliteration": "anik basatr su(n)dar pahiraaiaa ||",
      "translation": "They wear all sorts of beautiful robes,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਿਉ ਡਰਨਾ ਖੇਤ ਮਾਹਿ ਡਰਾਇਆ ॥੨॥",
      "transliteration": "jiu daranaa khet maahi daraaiaa ||2||",
      "translation": "but they are still just scarecrows in the field, frightening away the birds. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਗਲ ਸਰੀਰ ਆਵਤ ਸਭ ਕਾਮ ॥",
      "transliteration": "sagal sareer aavat sabh kaam ||",
      "translation": "All bodies are of some use,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਿਹਫਲ ਮਾਨੁਖੁ ਜਪੈ ਨਹੀ ਨਾਮ ॥੩॥",
      "transliteration": "nihaphal maanukh japai nahee naam ||3||",
      "translation": "but those who do not meditate on the Naam, the Name of the Lord, are totally useless. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਾ ਕਉ ਭਏ ਦਇਆਲਾ ॥",
      "transliteration": "kahu naanak jaa kau bhae daiaalaa ||",
      "translation": "Says Nanak, those unto whom the Lord becomes Merciful,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਮਿਲਿ ਭਜਹਿ ਗੋੁਪਾਲਾ ॥੪॥੫੫॥੧੨੪॥",
      "transliteration": "saadhasa(n)g mil bhajahi goupaalaa ||4||55||124||",
      "translation": "join the Saadh Sangat, and meditate on the Lord of the Universe. ||4||55||124||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0190_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 190,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
