{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 191,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0191_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਲਿ ਕਲੇਸ ਗੁਰ ਸਬਦਿ ਨਿਵਾਰੇ ॥",
      "transliteration": "kal kales gur sabad nivaare ||",
      "translation": "The Word of the Guru's Shabad quiets worries and troubles.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਵਣ ਜਾਣ ਰਹੇ ਸੁਖ ਸਾਰੇ ॥੧॥",
      "transliteration": "aavan jaan rahe sukh saare ||1||",
      "translation": "Coming and going ceases, and all comforts are obtained. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭੈ ਬਿਨਸੇ ਨਿਰਭਉ ਹਰਿ ਧਿਆਇਆ ॥",
      "transliteration": "bhai binase nirabhau har dhiaaiaa ||",
      "translation": "Fear is dispelled, meditating on the Fearless Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਹਰਿ ਕੇ ਗੁਣ ਗਾਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saadhasa(n)g har ke gun gaaiaa ||1|| rahaau ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, I chant the Glorious Praises of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਚਰਨ ਕਵਲ ਰਿਦ ਅੰਤਰਿ ਧਾਰੇ ॥",
      "transliteration": "charan kaval rid a(n)tar dhaare ||",
      "translation": "I have enshrined the Lotus Feet of the Lord within my heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਗਨਿ ਸਾਗਰ ਗੁਰਿ ਪਾਰਿ ਉਤਾਰੇ ॥੨॥",
      "transliteration": "agan saagar gur paar utaare ||2||",
      "translation": "The Guru has carried me across the ocean of fire. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬੂਡਤ ਜਾਤ ਪੂਰੈ ਗੁਰਿ ਕਾਢੇ ॥",
      "transliteration": "boodat jaat poorai gur kaadhe ||",
      "translation": "I was sinking down, and the Perfect Guru pulled me out.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਟੂਟੇ ਗਾਢੇ ॥੩॥",
      "transliteration": "janam janam ke toote gaadhe ||3||",
      "translation": "I was cut off from the Lord for countless incarnations, and now the Guru united me with Him again. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਤਿਸੁ ਗੁਰ ਬਲਿਹਾਰੀ ॥",
      "transliteration": "kahu naanak tis gur balihaaree ||",
      "translation": "Says Nanak, I am a sacrifice to the Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਸੁ ਭੇਟਤ ਗਤਿ ਭਈ ਹਮਾਰੀ ॥੪॥੫੬॥੧੨੫॥",
      "transliteration": "jis bhetat gat bhaee hamaaree ||4||56||125||",
      "translation": "meeting Him, I have been saved. ||4||56||125||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਤਾ ਕੀ ਸਰਨੀ ਪਰਹੁ ॥",
      "transliteration": "saadhasa(n)g taa kee saranee parahu ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, seek His Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਅਪਨਾ ਆਗੈ ਧਰਹੁ ॥੧॥",
      "transliteration": "man tan apanaa aagai dharahu ||1||",
      "translation": "Place your mind and body in offering before Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਪੀਵਹੁ ਮੇਰੇ ਭਾਈ ॥",
      "transliteration": "a(n)mrit naam peevahu mere bhaaee ||",
      "translation": "Drink in the Ambrosial Nectar of the Name, O my Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਸਭ ਤਪਤਿ ਬੁਝਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "simar simar sabh tapat bujhaaee ||1|| rahaau ||",
      "translation": "Meditating, meditating in remembrance on the Lord, the fire of desire is totally quenched. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਜਿ ਅਭਿਮਾਨੁ ਜਨਮ ਮਰਣੁ ਨਿਵਾਰਹੁ ॥",
      "transliteration": "taj abhimaan janam maran nivaarahu ||",
      "translation": "Renounce your arrogant pride, and end the cycle of birth and death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰਿ ਕੇ ਦਾਸ ਕੇ ਚਰਣ ਨਮਸਕਾਰਹੁ ॥੨॥",
      "transliteration": "har ke daas ke charan namasakaarahu ||2||",
      "translation": "Bow in humility to the feet of the Lord's slave. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਾਸਿ ਸਾਸਿ ਪ੍ਰਭੁ ਮਨਹਿ ਸਮਾਲੇ ॥",
      "transliteration": "saas saas prabh manahi samaale ||",
      "translation": "Remember God in your mind, with each and every breath.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋ ਧਨੁ ਸੰਚਹੁ ਜੋ ਚਾਲੈ ਨਾਲੇ ॥੩॥",
      "transliteration": "so dhan sa(n)chahu jo chaalai naale ||3||",
      "translation": "Gather only that wealth, which shall go with you. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਿਸਹਿ ਪਰਾਪਤਿ ਜਿਸੁ ਮਸਤਕਿ ਭਾਗੁ ॥",
      "transliteration": "tisahi paraapat jis masatak bhaag ||",
      "translation": "He alone obtains it, upon whose forehead such destiny is written.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਤਾ ਕੀ ਚਰਣੀ ਲਾਗੁ ॥੪॥੫੭॥੧੨੬॥",
      "transliteration": "kahu naanak taa kee charanee laag ||4||57||126||",
      "translation": "Says Nanak, fall at the Feet of that Lord. ||4||57||126||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੂਕੇ ਹਰੇ ਕੀਏ ਖਿਨ ਮਾਹੇ ॥",
      "transliteration": "sooke hare keee khin maahe ||",
      "translation": "The dried branches are made green again in an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਦ੍ਰਿਸਟਿ ਸੰਚਿ ਜੀਵਾਏ ॥੧॥",
      "transliteration": "a(n)mrit drisat sa(n)ch jeevaae ||1||",
      "translation": "His Ambrosial Glance irrigates and revives them. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਾਟੇ ਕਸਟ ਪੂਰੇ ਗੁਰਦੇਵ ॥",
      "transliteration": "kaate kasat poore guradev ||",
      "translation": "The Perfect Divine Guru has removed my sorrow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੇਵਕ ਕਉ ਦੀਨੀ ਅਪੁਨੀ ਸੇਵ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sevak kau deenee apunee sev ||1|| rahaau ||",
      "translation": "He blesses His servant with His service. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਿਟਿ ਗਈ ਚਿੰਤ ਪੁਨੀ ਮਨ ਆਸਾ ॥",
      "transliteration": "mit gaee chi(n)t punee man aasaa ||",
      "translation": "Anxiety is removed, and the desires of the mind are fulfilled,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਰੀ ਦਇਆ ਸਤਿਗੁਰਿ ਗੁਣਤਾਸਾ ॥੨॥",
      "transliteration": "karee daiaa satigur gunataasaa ||2||",
      "translation": "when the True Guru, the Treasure of Excellence, shows His Kindness. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੁਖ ਨਾਠੇ ਸੁਖ ਆਇ ਸਮਾਏ ॥",
      "transliteration": "dukh naathe sukh aai samaae ||",
      "translation": "Pain is driven far away, and peace comes in its place;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਢੀਲ ਨ ਪਰੀ ਜਾ ਗੁਰਿ ਫੁਰਮਾਏ ॥੩॥",
      "transliteration": "dheel na paree jaa gur phuramaae ||3||",
      "translation": "there is no delay, when the Guru gives the Order. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਛ ਪੁਨੀ ਪੂਰੇ ਗੁਰ ਮਿਲੇ ॥",
      "transliteration": "ichh punee poore gur mile ||",
      "translation": "Desires are fulfilled, when one meets the True Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਨਕ ਤੇ ਜਨ ਸੁਫਲ ਫਲੇ ॥੪॥੫੮॥੧੨੭॥",
      "transliteration": "naanak te jan suphal phale ||4||58||127||",
      "translation": "O Nanak, His humble servant is fruitful and prosperous. ||4||58||127||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾਪ ਗਏ ਪਾਈ ਪ੍ਰਭਿ ਸਾਂਤਿ ॥",
      "transliteration": "taap gae paaee prabh saa(n)t ||",
      "translation": "The fever has departed; God has showered us with peace and tranquility.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੀਤਲ ਭਏ ਕੀਨੀ ਪ੍ਰਭ ਦਾਤਿ ॥੧॥",
      "transliteration": "seetal bhae keenee prabh daat ||1||",
      "translation": "A cooling peace prevails; God has granted this gift. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ ਭਏ ਸੁਹੇਲੇ ॥",
      "transliteration": "prabh kirapaa te bhae suhele ||",
      "translation": "By God's Grace, we have become comfortable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਬਿਛੁਰੇ ਮੇਲੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "janam janam ke bichhure mele ||1|| rahaau ||",
      "translation": "Separated from Him for countless incarnations, we are now reunited with Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਿਮਰਤ ਸਿਮਰਤ ਪ੍ਰਭ ਕਾ ਨਾਉ ॥",
      "transliteration": "simarat simarat prabh kaa naau ||",
      "translation": "Meditating, meditating in remembrance on God's Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਗਲ ਰੋਗ ਕਾ ਬਿਨਸਿਆ ਥਾਉ ॥੨॥",
      "transliteration": "sagal rog kaa binasiaa thaau ||2||",
      "translation": "the dwelling of all disease is destroyed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਹਜਿ ਸੁਭਾਇ ਬੋਲੈ ਹਰਿ ਬਾਣੀ ॥",
      "transliteration": "sahaj subhaai bolai har baanee ||",
      "translation": "In intuitive peace and poise, chant the Word of the Lord's Bani.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਠ ਪਹਰ ਪ੍ਰਭ ਸਿਮਰਹੁ ਪ੍ਰਾਣੀ ॥੩॥",
      "transliteration": "aath pahar prabh simarahu praanee ||3||",
      "translation": "Twenty-four hours a day, O mortal, meditate on God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੂਖੁ ਦਰਦੁ ਜਮੁ ਨੇੜਿ ਨ ਆਵੈ ॥",
      "transliteration": "dookh darad jam neR na aavai ||",
      "translation": "Pain, suffering and the Messenger of Death do not even approach that one,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜੋ ਹਰਿ ਗੁਨ ਗਾਵੈ ॥੪॥੫੯॥੧੨੮॥",
      "transliteration": "kahu naanak jo har gun gaavai ||4||59||128||",
      "translation": "says Nanak, who sings the Glorious Praises of the Lord. ||4||59||128||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਲੇ ਦਿਨਸ ਭਲੇ ਸੰਜੋਗ ॥",
      "transliteration": "bhale dinas bhale sa(n)jog ||",
      "translation": "Auspicious is the day, and auspicious is the chance,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਤੁ ਭੇਟੇ ਪਾਰਬ੍ਰਹਮ ਨਿਰਜੋਗ ॥੧॥",
      "transliteration": "jit bhete paarabraham nirajog ||1||",
      "translation": "which brought me to the Supreme Lord God, the Unjoined, Unlimited One. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਓਹ ਬੇਲਾ ਕਉ ਹਉ ਬਲਿ ਜਾਉ ॥",
      "transliteration": "oh belaa kau hau bal jaau ||",
      "translation": "I am a sacrifice to that time,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਿਤੁ ਮੇਰਾ ਮਨੁ ਜਪੈ ਹਰਿ ਨਾਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jit meraa man japai har naau ||1|| rahaau ||",
      "translation": "when my mind chants the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਫਲ ਮੂਰਤੁ ਸਫਲ ਓਹ ਘਰੀ ॥",
      "transliteration": "saphal moorat saphal oh gharee ||",
      "translation": "Blessed is that moment, and blessed is that time,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਤੁ ਰਸਨਾ ਉਚਰੈ ਹਰਿ ਹਰੀ ॥੨॥",
      "transliteration": "jit rasanaa ucharai har haree ||2||",
      "translation": "when my tongue chants the Name of the Lord, Har, Haree. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਫਲੁ ਓਹੁ ਮਾਥਾ ਸੰਤ ਨਮਸਕਾਰਸਿ ॥",
      "transliteration": "saphal ohu maathaa sa(n)t namasakaaras ||",
      "translation": "Blessed is that forehead, which bows in humility to the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਚਰਣ ਪੁਨੀਤ ਚਲਹਿ ਹਰਿ ਮਾਰਗਿ ॥੩॥",
      "transliteration": "charan puneet chalahi har maarag ||3||",
      "translation": "Sacred are those feet, which walk on the Lord's Path. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਭਲਾ ਮੇਰਾ ਕਰਮ ॥",
      "transliteration": "kahu naanak bhalaa meraa karam ||",
      "translation": "Says Nanak, auspicious is my karma,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0191_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਿਤੁ ਭੇਟੇ ਸਾਧੂ ਕੇ ਚਰਨ ॥੪॥੬੦॥੧੨੯॥",
      "transliteration": "jit bhete saadhoo ke charan ||4||60||129||",
      "translation": "which has led me to touch the Feet of the Holy. ||4||60||129||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 191,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
