{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 192,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0192_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਰਾਖੁ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "gur kaa sabad raakh man maahi ||",
      "translation": "Keep the Word of the Guru's Shabad in your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਮੁ ਸਿਮਰਿ ਚਿੰਤਾ ਸਭ ਜਾਹਿ ॥੧॥",
      "transliteration": "naam simar chi(n)taa sabh jaahi ||1||",
      "translation": "Meditating in remembrance on the Naam, the Name of the Lord, all anxiety is removed. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਿਨੁ ਭਗਵੰਤ ਨਾਹੀ ਅਨ ਕੋਇ ॥",
      "transliteration": "bin bhagava(n)t naahee an koi ||",
      "translation": "Without the Lord God, there is no one else at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਾਰੈ ਰਾਖੈ ਏਕੋ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "maarai raakhai eko soi ||1|| rahaau ||",
      "translation": "He alone preserves and destroys. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਣ ਰਿਦੈ ਉਰਿ ਧਾਰਿ ॥",
      "transliteration": "gur ke charan ridai ur dhaar ||",
      "translation": "Enshrine the Guru's Feet in your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਗਨਿ ਸਾਗਰੁ ਜਪਿ ਉਤਰਹਿ ਪਾਰਿ ॥੨॥",
      "transliteration": "agan saagar jap utarahi paar ||2||",
      "translation": "Meditate on Him and cross over the ocean of fire. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰ ਮੂਰਤਿ ਸਿਉ ਲਾਇ ਧਿਆਨੁ ॥",
      "transliteration": "gur moorat siu laai dhiaan ||",
      "translation": "Focus your meditation on the Guru's Sublime Form.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਈਹਾ ਊਹਾ ਪਾਵਹਿ ਮਾਨੁ ॥੩॥",
      "transliteration": "eehaa oohaa paavahi maan ||3||",
      "translation": "Here and hereafter, you shall be honored. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਗਲ ਤਿਆਗਿ ਗੁਰ ਸਰਣੀ ਆਇਆ ॥",
      "transliteration": "sagal tiaag gur saranee aaiaa ||",
      "translation": "Renouncing everything, I have come to the Guru's Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਿਟੇ ਅੰਦੇਸੇ ਨਾਨਕ ਸੁਖੁ ਪਾਇਆ ॥੪॥੬੧॥੧੩੦॥",
      "transliteration": "mite a(n)dese naanak sukh paaiaa ||4||61||130||",
      "translation": "My anxieties are over - O Nanak, I have found peace. ||4||61||130||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਸੁ ਸਿਮਰਤ ਦੂਖੁ ਸਭੁ ਜਾਇ ॥",
      "transliteration": "jis simarat dookh sabh jaai ||",
      "translation": "Remembering Him in meditation, all pains are gone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਮੁ ਰਤਨੁ ਵਸੈ ਮਨਿ ਆਇ ॥੧॥",
      "transliteration": "naam ratan vasai man aai ||1||",
      "translation": "The jewel of the Naam, the Name of the Lord, comes to dwell in the mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਪਿ ਮਨ ਮੇਰੇ ਗੋਵਿੰਦ ਕੀ ਬਾਣੀ ॥",
      "transliteration": "jap man mere govi(n)d kee baanee ||",
      "translation": "O my mind, chant the Bani, the Hymns of the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਾਧੂ ਜਨ ਰਾਮੁ ਰਸਨ ਵਖਾਣੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saadhoo jan raam rasan vakhaanee ||1|| rahaau ||",
      "translation": "The Holy People chant the Lord's Name with their tongues. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਕਸੁ ਬਿਨੁ ਨਾਹੀ ਦੂਜਾ ਕੋਇ ॥",
      "transliteration": "ikas bin naahee doojaa koi ||",
      "translation": "Without the One Lord, there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਾ ਕੀ ਦ੍ਰਿਸਟਿ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥੨॥",
      "transliteration": "jaa kee drisat sadaa sukh hoi ||2||",
      "translation": "By His Glance of Grace, eternal peace is obtained. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਾਜਨੁ ਮੀਤੁ ਸਖਾ ਕਰਿ ਏਕੁ ॥",
      "transliteration": "saajan meet sakhaa kar ek ||",
      "translation": "Make the One Lord your friend, intimate and companion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਅਖਰ ਮਨ ਮਹਿ ਲੇਖੁ ॥੩॥",
      "transliteration": "har har akhar man mahi lekh ||3||",
      "translation": "Write in your mind the Word of the Lord, Har, Har. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਵਿ ਰਹਿਆ ਸਰਬਤ ਸੁਆਮੀ ॥",
      "transliteration": "rav rahiaa sarabat suaamee ||",
      "translation": "The Lord Master is totally pervading everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਣ ਗਾਵੈ ਨਾਨਕੁ ਅੰਤਰਜਾਮੀ ॥੪॥੬੨॥੧੩੧॥",
      "transliteration": "gun gaavai naanak a(n)tarajaamee ||4||62||131||",
      "translation": "Nanak sings the Praises of the Inner-knower, the Searcher of hearts. ||4||62||131||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭੈ ਮਹਿ ਰਚਿਓ ਸਭੁ ਸੰਸਾਰਾ ॥",
      "transliteration": "bhai mahi rachio sabh sa(n)saaraa ||",
      "translation": "The whole world is engrossed in fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਸੁ ਭਉ ਨਾਹੀ ਜਿਸੁ ਨਾਮੁ ਅਧਾਰਾ ॥੧॥",
      "transliteration": "tis bhau naahee jis naam adhaaraa ||1||",
      "translation": "Those who have the Naam, the Name of the Lord, as their Support, feel no fear. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਉ ਨ ਵਿਆਪੈ ਤੇਰੀ ਸਰਣਾ ॥",
      "transliteration": "bhau na viaapai teree saranaa ||",
      "translation": "Fear does not affect those who take to Your Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੋ ਤੁਧੁ ਭਾਵੈ ਸੋਈ ਕਰਣਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jo tudh bhaavai soee karanaa ||1|| rahaau ||",
      "translation": "You do whatever You please. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੋਗ ਹਰਖ ਮਹਿ ਆਵਣ ਜਾਣਾ ॥",
      "transliteration": "sog harakh mahi aavan jaanaa ||",
      "translation": "In pleasure and in pain, the world is coming and going in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਨਿ ਸੁਖੁ ਪਾਇਆ ਜੋ ਪ੍ਰਭ ਭਾਣਾ ॥੨॥",
      "transliteration": "tin sukh paaiaa jo prabh bhaanaa ||2||",
      "translation": "Those who are pleasing to God, find peace. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਗਨਿ ਸਾਗਰੁ ਮਹਾ ਵਿਆਪੈ ਮਾਇਆ ॥",
      "transliteration": "agan saagar mahaa viaapai maaiaa ||",
      "translation": "Maya pervades the awesome ocean of fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੇ ਸੀਤਲ ਜਿਨ ਸਤਿਗੁਰੁ ਪਾਇਆ ॥੩॥",
      "transliteration": "se seetal jin satigur paaiaa ||3||",
      "translation": "Those who have found the True Guru are calm and cool. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰਾਖਿ ਲੇਇ ਪ੍ਰਭੁ ਰਾਖਨਹਾਰਾ ॥",
      "transliteration": "raakh lei prabh raakhanahaaraa ||",
      "translation": "Please preserve me, O God, O Great Preserver!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਕਿਆ ਜੰਤ ਵਿਚਾਰਾ ॥੪॥੬੩॥੧੩੨॥",
      "transliteration": "kahu naanak kiaa ja(n)t vichaaraa ||4||63||132||",
      "translation": "Says Nanak, what a helpless creature I am! ||4||63||132||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੁਮਰੀ ਕ੍ਰਿਪਾ ਤੇ ਜਪੀਐ ਨਾਉ ॥",
      "transliteration": "tumaree kripaa te japeeai naau ||",
      "translation": "By Your Grace, I chant Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤੁਮਰੀ ਕ੍ਰਿਪਾ ਤੇ ਦਰਗਹ ਥਾਉ ॥੧॥",
      "transliteration": "tumaree kripaa te daragah thaau ||1||",
      "translation": "By Your Grace, I obtain a seat in Your Court. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤੁਝ ਬਿਨੁ ਪਾਰਬ੍ਰਹਮ ਨਹੀ ਕੋਇ ॥",
      "transliteration": "tujh bin paarabraham nahee koi ||",
      "translation": "Without You, O Supreme Lord God, there is no one.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੁਮਰੀ ਕ੍ਰਿਪਾ ਤੇ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tumaree kripaa te sadaa sukh hoi ||1|| rahaau ||",
      "translation": "By Your Grace, everlasting peace is obtained. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੁਮ ਮਨਿ ਵਸੇ ਤਉ ਦੂਖੁ ਨ ਲਾਗੈ ॥",
      "transliteration": "tum man vase tau dookh na laagai ||",
      "translation": "If You abide in the mind, we do not suffer in sorrow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤੁਮਰੀ ਕ੍ਰਿਪਾ ਤੇ ਭ੍ਰਮੁ ਭਉ ਭਾਗੈ ॥੨॥",
      "transliteration": "tumaree kripaa te bhram bhau bhaagai ||2||",
      "translation": "By Your Grace, doubt and fear run away. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਅਪਰੰਪਰ ਸੁਆਮੀ ॥",
      "transliteration": "paarabraham apara(n)par suaamee ||",
      "translation": "O Supreme Lord God, Infinite Lord and Master,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਗਲ ਘਟਾ ਕੇ ਅੰਤਰਜਾਮੀ ॥੩॥",
      "transliteration": "sagal ghataa ke a(n)tarajaamee ||3||",
      "translation": "You are the Inner-knower, the Searcher of all hearts. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਰਉ ਅਰਦਾਸਿ ਅਪਨੇ ਸਤਿਗੁਰ ਪਾਸਿ ॥",
      "transliteration": "karau aradaas apane satigur paas ||",
      "translation": "I offer this prayer to the True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਮਿਲੈ ਸਚੁ ਰਾਸਿ ॥੪॥੬੪॥੧੩੩॥",
      "transliteration": "naanak naam milai sach raas ||4||64||133||",
      "translation": "O Nanak, may I be blessed with the treasure of the True Name. ||4||64||133||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਣ ਬਿਨਾ ਜੈਸੇ ਥੋਥਰ ਤੁਖਾ ॥",
      "transliteration": "kan binaa jaise thothar tukhaa ||",
      "translation": "As the husk is empty without the grain,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਮ ਬਿਹੂਨ ਸੂਨੇ ਸੇ ਮੁਖਾ ॥੧॥",
      "transliteration": "naam bihoon soone se mukhaa ||1||",
      "translation": "so is the mouth empty without the Naam, the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਪਹੁ ਨਿਤ ਪ੍ਰਾਣੀ ॥",
      "transliteration": "har har naam japahu nit praanee ||",
      "translation": "O mortal, chant continually the Name of the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਮ ਬਿਹੂਨ ਧ੍ਰਿਗੁ ਦੇਹ ਬਿਗਾਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naam bihoon dhrig deh bigaanee ||1|| rahaau ||",
      "translation": "Without the Naam, cursed is the body, which shall be taken back by Death. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਨਾਹੀ ਮੁਖਿ ਭਾਗੁ ॥",
      "transliteration": "naam binaa naahee mukh bhaag ||",
      "translation": "Without the Naam, no one's face shows good fortune.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਭਰਤ ਬਿਹੂਨ ਕਹਾ ਸੋਹਾਗੁ ॥੨॥",
      "transliteration": "bharat bihoon kahaa sohaag ||2||",
      "translation": "Without the Husband, where is the marriage? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾਮੁ ਬਿਸਾਰਿ ਲਗੈ ਅਨ ਸੁਆਇ ॥",
      "transliteration": "naam bisaar lagai an suaai ||",
      "translation": "Forgetting the Naam, and attached to other tastes,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਾ ਕੀ ਆਸ ਨ ਪੂਜੈ ਕਾਇ ॥੩॥",
      "transliteration": "taa kee aas na poojai kaai ||3||",
      "translation": "no desires are fulfilled. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਅਪਨੀ ਦਾਤਿ ॥",
      "transliteration": "kar kirapaa prabh apanee daat ||",
      "translation": "O God, grant Your Grace, and give me this gift.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0192_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਜਪੈ ਦਿਨ ਰਾਤਿ ॥੪॥੬੫॥੧੩੪॥",
      "transliteration": "naanak naam japai din raat ||4||65||134||",
      "translation": "Please, let Nanak chant Your Name, day and night. ||4||65||134||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 192,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
