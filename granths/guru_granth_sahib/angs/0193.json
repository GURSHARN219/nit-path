{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 193,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0193_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤੂੰ ਸਮਰਥੁ ਤੂੰਹੈ ਮੇਰਾ ਸੁਆਮੀ ॥",
      "transliteration": "too(n) samarath too(n)hai meraa suaamee ||",
      "translation": "You are All-powerful, You are my Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਭੁ ਕਿਛੁ ਤੁਮ ਤੇ ਤੂੰ ਅੰਤਰਜਾਮੀ ॥੧॥",
      "transliteration": "sabh kichh tum te too(n) a(n)tarajaamee ||1||",
      "translation": "Everything comes from You; You are the Inner-knower, the Searcher of hearts. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਪੂਰਨ ਜਨ ਓਟ ॥",
      "transliteration": "paarabraham pooran jan ot ||",
      "translation": "The Perfect Supreme Lord God is the Support of His humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੇਰੀ ਸਰਣਿ ਉਧਰਹਿ ਜਨ ਕੋਟਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "teree saran udharahi jan kot ||1|| rahaau ||",
      "translation": "Millions are saved in Your Sanctuary. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੇਤੇ ਜੀਅ ਤੇਤੇ ਸਭਿ ਤੇਰੇ ॥",
      "transliteration": "jete jee tete sabh tere ||",
      "translation": "As many creatures as there are - they are all Yours.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੁਮਰੀ ਕ੍ਰਿਪਾ ਤੇ ਸੂਖ ਘਨੇਰੇ ॥੨॥",
      "transliteration": "tumaree kripaa te sookh ghanere ||2||",
      "translation": "By Your Grace, all sorts of comforts are obtained. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਵਰਤੈ ਸਭ ਤੇਰਾ ਭਾਣਾ ॥",
      "transliteration": "jo kichh varatai sabh teraa bhaanaa ||",
      "translation": "Whatever happens, is all according to Your Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹੁਕਮੁ ਬੂਝੈ ਸੋ ਸਚਿ ਸਮਾਣਾ ॥੩॥",
      "transliteration": "hukam boojhai so sach samaanaa ||3||",
      "translation": "One who understands the Hukam of the Lord's Command, is absorbed in the True Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਦੀਜੈ ਪ੍ਰਭ ਦਾਨੁ ॥",
      "transliteration": "kar kirapaa deejai prabh daan ||",
      "translation": "Please grant Your Grace, God, and bestow this gift",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਨਕ ਸਿਮਰੈ ਨਾਮੁ ਨਿਧਾਨੁ ॥੪॥੬੬॥੧੩੫॥",
      "transliteration": "naanak simarai naam nidhaan ||4||66||135||",
      "translation": "upon Nanak, that he may meditate on the treasure of the Naam. ||4||66||135||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾ ਕਾ ਦਰਸੁ ਪਾਈਐ ਵਡਭਾਗੀ ॥",
      "transliteration": "taa kaa daras paaeeai vadabhaagee ||",
      "translation": "By great good fortune, the Blessed Vision of His Darshan is obtained,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾ ਕੀ ਰਾਮ ਨਾਮਿ ਲਿਵ ਲਾਗੀ ॥੧॥",
      "transliteration": "jaa kee raam naam liv laagee ||1||",
      "translation": "by those who are lovingly absorbed in the Lord's Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਾ ਕੈ ਹਰਿ ਵਸਿਆ ਮਨ ਮਾਹੀ ॥",
      "transliteration": "jaa kai har vasiaa man maahee ||",
      "translation": "Those whose minds are filled with the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਾ ਕਉ ਦੁਖੁ ਸੁਪਨੈ ਭੀ ਨਾਹੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "taa kau dukh supanai bhee naahee ||1|| rahaau ||",
      "translation": "do not suffer pain, even in dreams. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਰਬ ਨਿਧਾਨ ਰਾਖੇ ਜਨ ਮਾਹਿ ॥",
      "transliteration": "sarab nidhaan raakhe jan maahi ||",
      "translation": "All treasures have been placed within the minds of His humble servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਕੈ ਸੰਗਿ ਕਿਲਵਿਖ ਦੁਖ ਜਾਹਿ ॥੨॥",
      "transliteration": "taa kai sa(n)g kilavikh dukh jaahi ||2||",
      "translation": "In their company, sinful mistakes and sorrows are taken away. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਨ ਕੀ ਮਹਿਮਾ ਕਥੀ ਨ ਜਾਇ ॥",
      "transliteration": "jan kee mahimaa kathee na jaai ||",
      "translation": "The Glories of the Lord's humble servants cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਜਨੁ ਰਹਿਆ ਸਮਾਇ ॥੩॥",
      "transliteration": "paarabraham jan rahiaa samaai ||3||",
      "translation": "The servants of the Supreme Lord God remain absorbed in Him. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਬਿਨਉ ਸੁਨੀਜੈ ॥",
      "transliteration": "kar kirapaa prabh binau suneejai ||",
      "translation": "Grant Your Grace, God, and hear my prayer:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦਾਸ ਕੀ ਧੂਰਿ ਨਾਨਕ ਕਉ ਦੀਜੈ ॥੪॥੬੭॥੧੩੬॥",
      "transliteration": "daas kee dhoor naanak kau deejai ||4||67||136||",
      "translation": "please bless Nanak with the dust of the feet of Your slave. ||4||67||136||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਤੇਰੀ ਜਾਇ ਬਲਾਇ ॥",
      "transliteration": "har simarat teree jaai balaai ||",
      "translation": "Remembering the Lord in meditation, your misfortune shall be taken away,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਰਬ ਕਲਿਆਣ ਵਸੈ ਮਨਿ ਆਇ ॥੧॥",
      "transliteration": "sarab kaliaan vasai man aai ||1||",
      "translation": "and all joy shall come to abide in your mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਜੁ ਮਨ ਮੇਰੇ ਏਕੋ ਨਾਮ ॥",
      "transliteration": "bhaj man mere eko naam ||",
      "translation": "Meditate, O my mind, on the One Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੀਅ ਤੇਰੇ ਕੈ ਆਵੈ ਕਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jee tere kai aavai kaam ||1|| rahaau ||",
      "translation": "It alone shall be of use to your soul. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰੈਣਿ ਦਿਨਸੁ ਗੁਣ ਗਾਉ ਅਨੰਤਾ ॥",
      "transliteration": "rain dinas gun gaau ana(n)taa ||",
      "translation": "Night and day, sing the Glorious Praises of the Infinite Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕਾ ਨਿਰਮਲ ਮੰਤਾ ॥੨॥",
      "transliteration": "gur poore kaa niramal ma(n)taa ||2||",
      "translation": "through the Pure Mantra of the Perfect Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਛੋਡਿ ਉਪਾਵ ਏਕ ਟੇਕ ਰਾਖੁ ॥",
      "transliteration": "chhod upaav ek tek raakh ||",
      "translation": "Give up other efforts, and place your faith in the Support of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਹਾ ਪਦਾਰਥੁ ਅੰਮ੍ਰਿਤ ਰਸੁ ਚਾਖੁ ॥੩॥",
      "transliteration": "mahaa padaarath a(n)mrit ras chaakh ||3||",
      "translation": "Taste the Ambrosial Essence of this, the greatest treasure. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਿਖਮ ਸਾਗਰੁ ਤੇਈ ਜਨ ਤਰੇ ॥",
      "transliteration": "bikham saagar teee jan tare ||",
      "translation": "They alone cross over the treacherous world-ocean,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਨਕ ਜਾ ਕਉ ਨਦਰਿ ਕਰੇ ॥੪॥੬੮॥੧੩੭॥",
      "transliteration": "naanak jaa kau nadar kare ||4||68||137||",
      "translation": "O Nanak, upon whom the Lord casts His Glance of Grace. ||4||68||137||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਿਰਦੈ ਚਰਨ ਕਮਲ ਪ੍ਰਭ ਧਾਰੇ ॥",
      "transliteration": "hiradai charan kamal prabh dhaare ||",
      "translation": "I have enshrined the Lotus Feet of God within my heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪੂਰੇ ਸਤਿਗੁਰ ਮਿਲਿ ਨਿਸਤਾਰੇ ॥੧॥",
      "transliteration": "poore satigur mil nisataare ||1||",
      "translation": "Meeting the Perfect True Guru, I am emancipated. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੋਵਿੰਦ ਗੁਣ ਗਾਵਹੁ ਮੇਰੇ ਭਾਈ ॥",
      "transliteration": "govi(n)d gun gaavahu mere bhaaee ||",
      "translation": "Sing the Glorious Praises of the Lord of the Universe, O my Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਿਲਿ ਸਾਧੂ ਹਰਿ ਨਾਮੁ ਧਿਆਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mil saadhoo har naam dhiaaee ||1|| rahaau ||",
      "translation": "Joining the Holy Saints, meditate on the Lord's Name. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੁਲਭ ਦੇਹ ਹੋਈ ਪਰਵਾਨੁ ॥",
      "transliteration": "dulabh deh hoee paravaan ||",
      "translation": "This human body, so difficult to obtain, is redeemed",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਤਿਗੁਰ ਤੇ ਪਾਇਆ ਨਾਮ ਨੀਸਾਨੁ ॥੨॥",
      "transliteration": "satigur te paaiaa naam neesaan ||2||",
      "translation": "when one receives the banner of the Naam from the True Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਪੂਰਨ ਪਦੁ ਪਾਇਆ ॥",
      "transliteration": "har simarat pooran pad paaiaa ||",
      "translation": "Meditating in remembrance on the Lord, the state of perfection is attained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਭੈ ਭਰਮ ਮਿਟਾਇਆ ॥੩॥",
      "transliteration": "saadhasa(n)g bhai bharam mitaaiaa ||3||",
      "translation": "In the Saadh Sangat, the Company of the Holy, fear and doubt depart. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਤ ਕਤ ਦੇਖਉ ਤਤ ਰਹਿਆ ਸਮਾਇ ॥",
      "transliteration": "jat kat dekhau tat rahiaa samaai ||",
      "translation": "Wherever I look, there I see the Lord pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਹਰਿ ਕੀ ਸਰਣਾਇ ॥੪॥੬੯॥੧੩੮॥",
      "transliteration": "naanak daas har kee saranaai ||4||69||138||",
      "translation": "Slave Nanak has entered the Lord's Sanctuary. ||4||69||138||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰ ਜੀ ਕੇ ਦਰਸਨ ਕਉ ਬਲਿ ਜਾਉ ॥",
      "transliteration": "gur jee ke darasan kau bal jaau ||",
      "translation": "I am a sacrifice to the Blessed Vision of the Guru's Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਪਿ ਜਪਿ ਜੀਵਾ ਸਤਿਗੁਰ ਨਾਉ ॥੧॥",
      "transliteration": "jap jap jeevaa satigur naau ||1||",
      "translation": "Chanting and meditating on the Name of the True Guru, I live. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਪੂਰਨ ਗੁਰਦੇਵ ॥",
      "transliteration": "paarabraham pooran guradev ||",
      "translation": "O Supreme Lord God, O Perfect Divine Guru,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਲਾਗਉ ਤੇਰੀ ਸੇਵ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa laagau teree sev ||1|| rahaau ||",
      "translation": "show mercy to me, and commit me to Your service. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਹਿਰਦੈ ਉਰ ਧਾਰੀ ॥",
      "transliteration": "charan kamal hiradai ur dhaaree ||",
      "translation": "I enshrine His Lotus Feet within my heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮਨ ਤਨ ਧਨ ਗੁਰ ਪ੍ਰਾਨ ਅਧਾਰੀ ॥੨॥",
      "transliteration": "man tan dhan gur praan adhaaree ||2||",
      "translation": "I offer my mind, body and wealth to the Guru, the Support of the breath of life. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਫਲ ਜਨਮੁ ਹੋਵੈ ਪਰਵਾਣੁ ॥",
      "transliteration": "saphal janam hovai paravaan ||",
      "translation": "My life is prosperous, fruitful and approved;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰੁ ਪਾਰਬ੍ਰਹਮੁ ਨਿਕਟਿ ਕਰਿ ਜਾਣੁ ॥੩॥",
      "transliteration": "gur paarabraham nikat kar jaan ||3||",
      "translation": "I know that the Guru, the Supreme Lord God, is near me. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੰਤ ਧੂਰਿ ਪਾਈਐ ਵਡਭਾਗੀ ॥",
      "transliteration": "sa(n)t dhoor paaeeai vadabhaagee ||",
      "translation": "By great good fortune, I have obtained the dust of the feet of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0193_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਨਕ ਗੁਰ ਭੇਟਤ ਹਰਿ ਸਿਉ ਲਿਵ ਲਾਗੀ ॥੪॥੭੦॥੧੩੯॥",
      "transliteration": "naanak gur bhetat har siu liv laagee ||4||70||139||",
      "translation": "O Nanak, meeting the Guru, I have fallen in love with the Lord. ||4||70||139||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 193,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
