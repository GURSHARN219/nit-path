{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 194,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0194_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਰੈ ਦੁਹਕਰਮ ਦਿਖਾਵੈ ਹੋਰੁ ॥",
      "transliteration": "karai duhakaram dikhaavai hor ||",
      "translation": "They do their evil deeds, and pretend otherwise;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਾਮ ਕੀ ਦਰਗਹ ਬਾਧਾ ਚੋਰੁ ॥੧॥",
      "transliteration": "raam kee daragah baadhaa chor ||1||",
      "translation": "but in the Court of the Lord, they shall be bound and gagged like thieves. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਾਮੁ ਰਮੈ ਸੋਈ ਰਾਮਾਣਾ ॥",
      "transliteration": "raam ramai soee raamaanaa ||",
      "translation": "Those who remember the Lord belong to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ ਏਕੁ ਸਮਾਣਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jal thal maheeal ek samaanaa ||1|| rahaau ||",
      "translation": "The One Lord is contained in the water, the land and the sky. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅੰਤਰਿ ਬਿਖੁ ਮੁਖਿ ਅੰਮ੍ਰਿਤੁ ਸੁਣਾਵੈ ॥",
      "transliteration": "a(n)tar bikh mukh a(n)mrit sunaavai ||",
      "translation": "Their inner beings are filled with poison, and yet with their mouths, they preach words of Ambrosial Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਮ ਪੁਰਿ ਬਾਧਾ ਚੋਟਾ ਖਾਵੈ ॥੨॥",
      "transliteration": "jam pur baadhaa chotaa khaavai ||2||",
      "translation": "Bound and gagged in the City of Death, they are punished and beaten. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਨਿਕ ਪੜਦੇ ਮਹਿ ਕਮਾਵੈ ਵਿਕਾਰ ॥",
      "transliteration": "anik paRade mahi kamaavai vikaar ||",
      "translation": "Hiding behind many screens, they commit acts of corruption,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਪ੍ਰਗਟ ਹੋਹਿ ਸੰਸਾਰ ॥੩॥",
      "transliteration": "khin mahi pragat hohi sa(n)saar ||3||",
      "translation": "but in an instant, they are revealed to all the world. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅੰਤਰਿ ਸਾਚਿ ਨਾਮਿ ਰਸਿ ਰਾਤਾ ॥",
      "transliteration": "a(n)tar saach naam ras raataa ||",
      "translation": "Those whose inner beings are true, who are attuned to the ambrosial essence of the Naam, the Name of the Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਨਕ ਤਿਸੁ ਕਿਰਪਾਲੁ ਬਿਧਾਤਾ ॥੪॥੭੧॥੧੪੦॥",
      "transliteration": "naanak tis kirapaal bidhaataa ||4||71||140||",
      "translation": "- O Nanak, the Lord, the Architect of Destiny, is merciful to them. ||4||71||140||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਮ ਰੰਗੁ ਕਦੇ ਉਤਰਿ ਨ ਜਾਇ ॥",
      "transliteration": "raam ra(n)g kade utar na jaai ||",
      "translation": "The Lord's Love shall never leave or depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗੁਰੁ ਪੂਰਾ ਜਿਸੁ ਦੇਇ ਬੁਝਾਇ ॥੧॥",
      "transliteration": "gur pooraa jis dei bujhaai ||1||",
      "translation": "They alone understand, unto whom the Perfect Guru gives it. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹਰਿ ਰੰਗਿ ਰਾਤਾ ਸੋ ਮਨੁ ਸਾਚਾ ॥",
      "transliteration": "har ra(n)g raataa so man saachaa ||",
      "translation": "One whose mind is attuned to the Lord's Love is true.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਲਾਲ ਰੰਗ ਪੂਰਨ ਪੁਰਖੁ ਬਿਧਾਤਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "laal ra(n)g pooran purakh bidhaataa ||1|| rahaau ||",
      "translation": "The Love of the Beloved, the Architect of Destiny, is perfect. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੰਤਹ ਸੰਗਿ ਬੈਸਿ ਗੁਨ ਗਾਇ ॥",
      "transliteration": "sa(n)tah sa(n)g bais gun gaai ||",
      "translation": "Sitting in the Society of the Saints, sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਕਾ ਰੰਗੁ ਨ ਉਤਰੈ ਜਾਇ ॥੨॥",
      "transliteration": "taa kaa ra(n)g na utarai jaai ||2||",
      "translation": "The color of His Love shall never fade away. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਸਿਮਰਨ ਸੁਖੁ ਨਹੀ ਪਾਇਆ ॥",
      "transliteration": "bin har simaran sukh nahee paaiaa ||",
      "translation": "Without meditating in remembrance on the Lord, peace is not found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਨ ਰੰਗ ਫੀਕੇ ਸਭ ਮਾਇਆ ॥੩॥",
      "transliteration": "aan ra(n)g pheeke sabh maaiaa ||3||",
      "translation": "All the other loves and tastes of Maya are bland and insipid. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਰਿ ਰੰਗੇ ਸੇ ਭਏ ਨਿਹਾਲ ॥",
      "transliteration": "gur ra(n)ge se bhae nihaal ||",
      "translation": "Those who are imbued with love by the Guru become happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰ ਭਏ ਹੈ ਦਇਆਲ ॥੪॥੭੨॥੧੪੧॥",
      "transliteration": "kahu naanak gur bhae hai daiaal ||4||72||141||",
      "translation": "Says Nanak, the Guru has become merciful to them. ||4||72||141||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਿਮਰਤ ਸੁਆਮੀ ਕਿਲਵਿਖ ਨਾਸੇ ॥",
      "transliteration": "simarat suaamee kilavikh naase ||",
      "translation": "Meditating in remembrance on the Lord Master, sinful mistakes are erased,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਆਨੰਦ ਨਿਵਾਸੇ ॥੧॥",
      "transliteration": "sookh sahaj aana(n)d nivaase ||1||",
      "translation": "and one comes to abide in peace, celestial joy and bliss. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਮ ਜਨਾ ਕਉ ਰਾਮ ਭਰੋਸਾ ॥",
      "transliteration": "raam janaa kau raam bharosaa ||",
      "translation": "The Lord's humble servants place their faith in the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਸਭੁ ਮਿਟਿਓ ਅੰਦੇਸਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naam japat sabh mitio a(n)desaa ||1|| rahaau ||",
      "translation": "Chanting the Naam, the Name of the Lord, all anxieties are dispelled. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਕਛੁ ਭਉ ਨ ਭਰਾਤੀ ॥",
      "transliteration": "saadhasa(n)g kachh bhau na bharaatee ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, there is no fear or doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਣ ਗੋਪਾਲ ਗਾਈਅਹਿ ਦਿਨੁ ਰਾਤੀ ॥੨॥",
      "transliteration": "gun gopaal gaaeeahi din raatee ||2||",
      "translation": "The Glorious Praises of the Lord are sung there, day and night. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਬੰਧਨ ਛੋਟ ॥",
      "transliteration": "kar kirapaa prabh ba(n)dhan chhot ||",
      "translation": "Granting His Grace, God has released me from bondage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚਰਣ ਕਮਲ ਕੀ ਦੀਨੀ ਓਟ ॥੩॥",
      "transliteration": "charan kamal kee deenee ot ||3||",
      "translation": "He has given me the Support of His Lotus Feet. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਮਨਿ ਭਈ ਪਰਤੀਤਿ ॥",
      "transliteration": "kahu naanak man bhaee parateet ||",
      "translation": "Says Nanak, faith comes into the mind of His servant,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਿਰਮਲ ਜਸੁ ਪੀਵਹਿ ਜਨ ਨੀਤਿ ॥੪॥੭੩॥੧੪੨॥",
      "transliteration": "niramal jas peevahi jan neet ||4||73||142||",
      "translation": "Who continually drinks in the Immaculate Praises of the Lord. ||4||73||142||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਰਿ ਚਰਣੀ ਜਾ ਕਾ ਮਨੁ ਲਾਗਾ ॥",
      "transliteration": "har charanee jaa kaa man laagaa ||",
      "translation": "Those who keep their minds attached to the Lord's Feet",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੂਖੁ ਦਰਦੁ ਭ੍ਰਮੁ ਤਾ ਕਾ ਭਾਗਾ ॥੧॥",
      "transliteration": "dookh darad bhram taa kaa bhaagaa ||1||",
      "translation": "- pain, suffering and doubt run away from them. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਰਿ ਧਨ ਕੋ ਵਾਪਾਰੀ ਪੂਰਾ ॥",
      "transliteration": "har dhan ko vaapaaree pooraa ||",
      "translation": "Those who deal in the Lord's wealth are perfect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਸਹਿ ਨਿਵਾਜੇ ਸੋ ਜਨੁ ਸੂਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jisahi nivaaje so jan sooraa ||1|| rahaau ||",
      "translation": "Those who are honored by the Lord are the true spiritual heroes. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾ ਕਉ ਭਏ ਕ੍ਰਿਪਾਲ ਗੁਸਾਈ ॥",
      "transliteration": "jaa kau bhae kripaal gusaaee ||",
      "translation": "Those humble beings, unto whom the Lord of the Universe shows mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੇ ਜਨ ਲਾਗੇ ਗੁਰ ਕੀ ਪਾਈ ॥੨॥",
      "transliteration": "se jan laage gur kee paaee ||2||",
      "translation": "fall at the Guru's Feet. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਸਾਂਤਿ ਆਨੰਦਾ ॥",
      "transliteration": "sookh sahaj saa(n)t aana(n)daa ||",
      "translation": "They are blessed with peace, celestial bliss, tranquility and ecstasy;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਪਿ ਜਪਿ ਜੀਵੇ ਪਰਮਾਨੰਦਾ ॥੩॥",
      "transliteration": "jap jap jeeve paramaana(n)daa ||3||",
      "translation": "chanting and meditating, they live in supreme bliss. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਮ ਰਾਸਿ ਸਾਧ ਸੰਗਿ ਖਾਟੀ ॥",
      "transliteration": "naam raas saadh sa(n)g khaatee ||",
      "translation": "In the Saadh Sangat, I have earned the wealth of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਪ੍ਰਭਿ ਅਪਦਾ ਕਾਟੀ ॥੪॥੭੪॥੧੪੩॥",
      "transliteration": "kahu naanak prabh apadaa kaatee ||4||74||143||",
      "translation": "Says Nanak, God has relieved my pain. ||4||74||143||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਸਭਿ ਮਿਟਹਿ ਕਲੇਸ ॥",
      "transliteration": "har simarat sabh mitahi kales ||",
      "translation": "Meditating in remembrance on the Lord, all suffering is eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚਰਣ ਕਮਲ ਮਨ ਮਹਿ ਪਰਵੇਸ ॥੧॥",
      "transliteration": "charan kamal man mahi paraves ||1||",
      "translation": "The Lord's Lotus Feet are enshrined within my mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਉਚਰਹੁ ਰਾਮ ਨਾਮੁ ਲਖ ਬਾਰੀ ॥",
      "transliteration": "ucharahu raam naam lakh baaree ||",
      "translation": "Chant the Lord's Name, hundreds of thousands of times, O my dear,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਰਸੁ ਪੀਵਹੁ ਪ੍ਰਭ ਪਿਆਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "a(n)mrit ras peevahu prabh piaaree ||1|| rahaau ||",
      "translation": "and drink deeply of the Ambrosial Essence of God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਰਸ ਮਹਾ ਅਨੰਦਾ ॥",
      "transliteration": "sookh sahaj ras mahaa ana(n)daa ||",
      "translation": "Peace, celestial bliss, pleasures and the greatest ecstasy are obtained;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਪਿ ਜਪਿ ਜੀਵੇ ਪਰਮਾਨੰਦਾ ॥੨॥",
      "transliteration": "jap jap jeeve paramaana(n)daa ||2||",
      "translation": "chanting and meditating, you shall live in supreme bliss. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਲੋਭ ਮਦ ਖੋਏ ॥",
      "transliteration": "kaam krodh lobh mad khoe ||",
      "translation": "Sexual desire, anger, greed and ego are eradicated;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਕਿਲਬਿਖ ਸਭ ਧੋਏ ॥੩॥",
      "transliteration": "saadh kai sa(n)g kilabikh sabh dhoe ||3||",
      "translation": "in the Saadh Sangat, the Company of the Holy, all sinful mistakes are washed away. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਦੀਨ ਦਇਆਲਾ ॥",
      "transliteration": "kar kirapaa prabh deen daiaalaa ||",
      "translation": "Grant Your Grace, O God, O Merciful to the meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0194_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਨਕ ਦੀਜੈ ਸਾਧ ਰਵਾਲਾ ॥੪॥੭੫॥੧੪੪॥",
      "transliteration": "naanak deejai saadh ravaalaa ||4||75||144||",
      "translation": "Please bless Nanak with the dust of the feet of the Holy. ||4||75||144||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 194,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
