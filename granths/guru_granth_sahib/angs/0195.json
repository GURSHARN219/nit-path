{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 195,
  "lineCount": 53,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0195_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਸ ਕਾ ਦੀਆ ਪੈਨੈ ਖਾਇ ॥",
      "transliteration": "jis kaa deeaa painai khaai ||",
      "translation": "They wear and eat the gifts from the Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਿਸੁ ਸਿਉ ਆਲਸੁ ਕਿਉ ਬਨੈ ਮਾਇ ॥੧॥",
      "transliteration": "tis siu aalas kiu banai maai ||1||",
      "translation": "how can laziness help them, O mother? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਖਸਮੁ ਬਿਸਾਰਿ ਆਨ ਕੰਮਿ ਲਾਗਹਿ ॥",
      "transliteration": "khasam bisaar aan ka(n)m laagahi ||",
      "translation": "Forgetting her Husband Lord, and attaching herself to other affairs,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਉਡੀ ਬਦਲੇ ਰਤਨੁ ਤਿਆਗਹਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kaudee badale ratan tiaagahi ||1|| rahaau ||",
      "translation": "the soul-bride throws away the precious jewel in exchange for a mere shell. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪ੍ਰਭੂ ਤਿਆਗਿ ਲਾਗਤ ਅਨ ਲੋਭਾ ॥",
      "transliteration": "prabhoo tiaag laagat an lobhaa ||",
      "translation": "Forsaking God, she is attached to other desires.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦਾਸਿ ਸਲਾਮੁ ਕਰਤ ਕਤ ਸੋਭਾ ॥੨॥",
      "transliteration": "daas salaam karat kat sobhaa ||2||",
      "translation": "But who has gained honor by saluting the slave? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਰਸੁ ਖਾਵਹਿ ਖਾਨ ਪਾਨ ॥",
      "transliteration": "a(n)mrit ras khaavahi khaan paan ||",
      "translation": "They consume food and drink, delicious and sublime as ambrosial nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਿਨਿ ਦੀਏ ਤਿਸਹਿ ਨ ਜਾਨਹਿ ਸੁਆਨ ॥੩॥",
      "transliteration": "jin deee tisahi na jaanahi suaan ||3||",
      "translation": "But the dog does not know the One who has bestowed these. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਹਮ ਲੂਣ ਹਰਾਮੀ ॥",
      "transliteration": "kahu naanak ham loon haraamee ||",
      "translation": "Says Nanak, I have been unfaithful to my own nature.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਖਸਿ ਲੇਹੁ ਪ੍ਰਭ ਅੰਤਰਜਾਮੀ ॥੪॥੭੬॥੧੪੫॥",
      "transliteration": "bakhas lehu prabh a(n)tarajaamee ||4||76||145||",
      "translation": "Please forgive me, O God, O Searcher of hearts. ||4||76||145||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪ੍ਰਭ ਕੇ ਚਰਨ ਮਨ ਮਾਹਿ ਧਿਆਨੁ ॥",
      "transliteration": "prabh ke charan man maahi dhiaan ||",
      "translation": "I meditate on the Feet of God within my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਗਲ ਤੀਰਥ ਮਜਨ ਇਸਨਾਨੁ ॥੧॥",
      "transliteration": "sagal teerath majan isanaan ||1||",
      "translation": "This is my cleansing bath at all the sacred shrines of pilgrimage. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹਰਿ ਦਿਨੁ ਹਰਿ ਸਿਮਰਨੁ ਮੇਰੇ ਭਾਈ ॥",
      "transliteration": "har din har simaran mere bhaaee ||",
      "translation": "Meditate in remembrance on the Lord every day, O my Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕੋਟਿ ਜਨਮ ਕੀ ਮਲੁ ਲਹਿ ਜਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kot janam kee mal lahi jaaee ||1|| rahaau ||",
      "translation": "Thus, the filth of millions of incarnations shall be taken away. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰਿ ਕੀ ਕਥਾ ਰਿਦ ਮਾਹਿ ਬਸਾਈ ॥",
      "transliteration": "har kee kathaa rid maahi basaaee ||",
      "translation": "Enshrine the Lord's Sermon within your heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਨ ਬਾਂਛਤ ਸਗਲੇ ਫਲ ਪਾਈ ॥੨॥",
      "transliteration": "man baa(n)chhat sagale phal paaee ||2||",
      "translation": "and you shall obtain all the desires of your mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੀਵਨ ਮਰਣੁ ਜਨਮੁ ਪਰਵਾਨੁ ॥",
      "transliteration": "jeevan maran janam paravaan ||",
      "translation": "Redeemed is the life, death and birth of those,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਾ ਕੈ ਰਿਦੈ ਵਸੈ ਭਗਵਾਨੁ ॥੩॥",
      "transliteration": "jaa kai ridai vasai bhagavaan ||3||",
      "translation": "within whose hearts the Lord God abides. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਸੇਈ ਜਨ ਪੂਰੇ ॥",
      "transliteration": "kahu naanak seee jan poore ||",
      "translation": "Says Nanak, those humble beings are perfect,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਨਾ ਪਰਾਪਤਿ ਸਾਧੂ ਧੂਰੇ ॥੪॥੭੭॥੧੪੬॥",
      "transliteration": "jinaa paraapat saadhoo dhoore ||4||77||146||",
      "translation": "who are blessed with the dust of the feet of the Holy. ||4||77||146||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਖਾਦਾ ਪੈਨਦਾ ਮੂਕਰਿ ਪਾਇ ॥",
      "transliteration": "khaadaa painadaa mookar paai ||",
      "translation": "They eat and wear what they are given, but still, they deny the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਸ ਨੋ ਜੋਹਹਿ ਦੂਤ ਧਰਮ ਰਾਇ ॥੧॥",
      "transliteration": "tis no johahi doot dharam raai ||1||",
      "translation": "The messengers of the Righteous Judge of Dharma shall hunt them down. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਿਸੁ ਸਿਉ ਬੇਮੁਖੁ ਜਿਨਿ ਜੀਉ ਪਿੰਡੁ ਦੀਨਾ ॥",
      "transliteration": "tis siu bemukh jin jeeu pi(n)d deenaa ||",
      "translation": "They are unfaithful to the One, who has given them body and soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕੋਟਿ ਜਨਮ ਭਰਮਹਿ ਬਹੁ ਜੂਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kot janam bharamahi bahu joonaa ||1|| rahaau ||",
      "translation": "Through millions of incarnations, for so many lifetimes, they wander lost. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਾਕਤ ਕੀ ਐਸੀ ਹੈ ਰੀਤਿ ॥",
      "transliteration": "saakat kee aisee hai reet ||",
      "translation": "Such is the lifestyle of the faithless cynics;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕਰੈ ਸਗਲ ਬਿਪਰੀਤਿ ॥੨॥",
      "transliteration": "jo kichh karai sagal bipareet ||2||",
      "translation": "everything they do is evil. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੀਉ ਪ੍ਰਾਣ ਜਿਨਿ ਮਨੁ ਤਨੁ ਧਾਰਿਆ ॥",
      "transliteration": "jeeu praan jin man tan dhaariaa ||",
      "translation": "Within their minds, they have forgotten that Lord and Master,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੋਈ ਠਾਕੁਰੁ ਮਨਹੁ ਬਿਸਾਰਿਆ ॥੩॥",
      "transliteration": "soee thaakur manahu bisaariaa ||3||",
      "translation": "Who created the soul, breath of life, mind and body. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਧੇ ਬਿਕਾਰ ਲਿਖੇ ਬਹੁ ਕਾਗਰ ॥",
      "transliteration": "badhe bikaar likhe bahu kaagar ||",
      "translation": "Their wickedness and corruption have increased - they are recorded in volumes of books.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਨਕ ਉਧਰੁ ਕ੍ਰਿਪਾ ਸੁਖ ਸਾਗਰ ॥੪॥",
      "transliteration": "naanak udhar kripaa sukh saagar ||4||",
      "translation": "O Nanak, they are saved only by the Mercy of God, the Ocean of peace. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਤੇਰੀ ਸਰਣਾਇ ॥",
      "transliteration": "paarabraham teree saranaai ||",
      "translation": "O Supreme Lord God, I have come to Your Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬੰਧਨ ਕਾਟਿ ਤਰੈ ਹਰਿ ਨਾਇ ॥੧॥ ਰਹਾਉ ਦੂਜਾ ॥੭੮॥੧੪੭॥",
      "transliteration": "ba(n)dhan kaat tarai har naai ||1|| rahaau doojaa ||78||147||",
      "translation": "Break my bonds, and carry me across, with the Lord's Name. ||1||Second Pause||78||147||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਪਨੇ ਲੋਭ ਕਉ ਕੀਨੋ ਮੀਤੁ ॥",
      "transliteration": "apane lobh kau keeno meet ||",
      "translation": "For their own advantage, they make God their friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਗਲ ਮਨੋਰਥ ਮੁਕਤਿ ਪਦੁ ਦੀਤੁ ॥੧॥",
      "transliteration": "sagal manorath mukat pad deet ||1||",
      "translation": "He fulfills all their desires, and blesses them with the state of liberation. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਐਸਾ ਮੀਤੁ ਕਰਹੁ ਸਭੁ ਕੋਇ ॥",
      "transliteration": "aisaa meet karahu sabh koi ||",
      "translation": "Everyone should make Him such a friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾ ਤੇ ਬਿਰਥਾ ਕੋਇ ਨ ਹੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaa te birathaa koi na hoi ||1|| rahaau ||",
      "translation": "No one goes away empty-handed from Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਪੁਨੈ ਸੁਆਇ ਰਿਦੈ ਲੈ ਧਾਰਿਆ ॥",
      "transliteration": "apunai suaai ridai lai dhaariaa ||",
      "translation": "For their own purposes, they enshrine the Lord in the heart;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੂਖ ਦਰਦ ਰੋਗ ਸਗਲ ਬਿਦਾਰਿਆ ॥੨॥",
      "transliteration": "dookh darad rog sagal bidaariaa ||2||",
      "translation": "all pain, suffering and disease are taken away. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰਸਨਾ ਗੀਧੀ ਬੋਲਤ ਰਾਮ ॥",
      "transliteration": "rasanaa geedhee bolat raam ||",
      "translation": "Their tongues learn the habit of chanting the Lord's Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪੂਰਨ ਹੋਏ ਸਗਲੇ ਕਾਮ ॥੩॥",
      "transliteration": "pooran hoe sagale kaam ||3||",
      "translation": "and all their works are brought to perfection. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਨਿਕ ਬਾਰ ਨਾਨਕ ਬਲਿਹਾਰਾ ॥",
      "transliteration": "anik baar naanak balihaaraa ||",
      "translation": "So many times, Nanak is a sacrifice to Him;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਫਲ ਦਰਸਨੁ ਗੋਬਿੰਦੁ ਹਮਾਰਾ ॥੪॥੭੯॥੧੪੮॥",
      "transliteration": "saphal darasan gobi(n)d hamaaraa ||4||79||148||",
      "translation": "fruitful is the Blessed Vision, the Darshan, of my Lord of the Universe. ||4||79||148||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੋਟਿ ਬਿਘਨ ਹਿਰੇ ਖਿਨ ਮਾਹਿ ॥",
      "transliteration": "kot bighan hire khin maahi ||",
      "translation": "Millions of obstacles are removed in an instant,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਕਥਾ ਸਾਧਸੰਗਿ ਸੁਨਾਹਿ ॥੧॥",
      "transliteration": "har har kathaa saadhasa(n)g sunaahi ||1||",
      "translation": "for those who listen to the Sermon of the Lord, Har, Har, in the Saadh Sangat, the Company of the Holy. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪੀਵਤ ਰਾਮ ਰਸੁ ਅੰਮ੍ਰਿਤ ਗੁਣ ਜਾਸੁ ॥",
      "transliteration": "peevat raam ras a(n)mrit gun jaas ||",
      "translation": "They drink in the sublime essence of the Lord's Name, the Ambrosial Elixir.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਪਿ ਹਰਿ ਚਰਣ ਮਿਟੀ ਖੁਧਿ ਤਾਸੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jap har charan mitee khudh taas ||1|| rahaau ||",
      "translation": "Meditating on the Lord's Feet, hunger is taken away. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਰਬ ਕਲਿਆਣ ਸੁਖ ਸਹਜ ਨਿਧਾਨ ॥",
      "transliteration": "sarab kaliaan sukh sahaj nidhaan ||",
      "translation": "The treasure of all happiness, celestial peace and poise,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0195_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਾ ਕੈ ਰਿਦੈ ਵਸਹਿ ਭਗਵਾਨ ॥੨॥",
      "transliteration": "jaa kai ridai vasahi bhagavaan ||2||",
      "translation": "are obtained by those, whose hearts are filled with the Lord God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 195,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
