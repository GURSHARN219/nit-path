{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 196,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0196_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਉਖਧ ਮੰਤ੍ਰ ਤੰਤ ਸਭਿ ਛਾਰੁ ॥",
      "transliteration": "aukhadh ma(n)tr ta(n)t sabh chhaar ||",
      "translation": "All medicines and remedies, mantras and tantras are nothing more than ashes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਰਣੈਹਾਰੁ ਰਿਦੇ ਮਹਿ ਧਾਰੁ ॥੩॥",
      "transliteration": "karanaihaar ride mahi dhaar ||3||",
      "translation": "Enshrine the Creator Lord within your heart. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਜਿ ਸਭਿ ਭਰਮ ਭਜਿਓ ਪਾਰਬ੍ਰਹਮੁ ॥",
      "transliteration": "taj sabh bharam bhajio paarabraham ||",
      "translation": "Renounce all your doubts, and vibrate upon the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਅਟਲ ਇਹੁ ਧਰਮੁ ॥੪॥੮੦॥੧੪੯॥",
      "transliteration": "kahu naanak atal ihu dharam ||4||80||149||",
      "translation": "Says Nanak, this path of Dharma is eternal and unchanging. ||4||80||149||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਭੇਟੇ ਗੁਰ ਸੋਈ ॥",
      "transliteration": "kar kirapaa bhete gur soee ||",
      "translation": "The Lord bestowed His Mercy, and led me to meet the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਿਤੁ ਬਲਿ ਰੋਗੁ ਨ ਬਿਆਪੈ ਕੋਈ ॥੧॥",
      "transliteration": "tit bal rog na biaapai koee ||1||",
      "translation": "By His power, no disease afflicts me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਮ ਰਮਣ ਤਰਣ ਭੈ ਸਾਗਰ ॥",
      "transliteration": "raam raman taran bhai saagar ||",
      "translation": "Remembering the Lord, I cross over the terrifying world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਰਣਿ ਸੂਰ ਫਾਰੇ ਜਮ ਕਾਗਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saran soor phaare jam kaagar ||1|| rahaau ||",
      "translation": "In the Sanctuary of the spiritual warrior, the account books of the Messenger of Death are torn up. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਮੰਤ੍ਰੁ ਦੀਓ ਹਰਿ ਨਾਮ ॥",
      "transliteration": "satigur ma(n)tr deeo har naam ||",
      "translation": "The True Guru has given me the Mantra of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਹ ਆਸਰ ਪੂਰਨ ਭਏ ਕਾਮ ॥੨॥",
      "transliteration": "ih aasar pooran bhae kaam ||2||",
      "translation": "By this Support, my affairs have been resolved. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਪ ਤਪ ਸੰਜਮ ਪੂਰੀ ਵਡਿਆਈ ॥",
      "transliteration": "jap tap sa(n)jam pooree vadiaaee ||",
      "translation": "Meditation, self-discipline, self-control and perfect greatness were obtained when the Merciful Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾਲ ਹਰਿ ਭਏ ਸਹਾਈ ॥੩॥",
      "transliteration": "gur kirapaal har bhae sahaaee ||3||",
      "translation": "The Guru, became my Help and Support. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਾਨ ਮੋਹ ਖੋਏ ਗੁਰਿ ਭਰਮ ॥",
      "transliteration": "maan moh khoe gur bharam ||",
      "translation": "The Guru has dispelled pride, emotional attachment and superstition.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪੇਖੁ ਨਾਨਕ ਪਸਰੇ ਪਾਰਬ੍ਰਹਮ ॥੪॥੮੧॥੧੫੦॥",
      "transliteration": "pekh naanak pasare paarabraham ||4||81||150||",
      "translation": "Nanak sees the Supreme Lord God pervading everywhere. ||4||81||150||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਖੈ ਰਾਜ ਤੇ ਅੰਧੁਲਾ ਭਾਰੀ ॥",
      "transliteration": "bikhai raaj te a(n)dhulaa bhaaree ||",
      "translation": "The blind beggar is better off than the vicious king.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੁਖਿ ਲਾਗੈ ਰਾਮ ਨਾਮੁ ਚਿਤਾਰੀ ॥੧॥",
      "transliteration": "dukh laagai raam naam chitaaree ||1||",
      "translation": "Overcome by pain, the blind man invokes the Lord's Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤੇਰੇ ਦਾਸ ਕਉ ਤੁਹੀ ਵਡਿਆਈ ॥",
      "transliteration": "tere daas kau tuhee vadiaaee ||",
      "translation": "You are the glorious greatness of Your slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਾਇਆ ਮਗਨੁ ਨਰਕਿ ਲੈ ਜਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "maaiaa magan narak lai jaaee ||1|| rahaau ||",
      "translation": "The intoxication of Maya leads the others to hell. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰੋਗ ਗਿਰਸਤ ਚਿਤਾਰੇ ਨਾਉ ॥",
      "transliteration": "rog girasat chitaare naau ||",
      "translation": "Gripped by disease, they invoke the Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਿਖੁ ਮਾਤੇ ਕਾ ਠਉਰ ਨ ਠਾਉ ॥੨॥",
      "transliteration": "bikh maate kaa thaur na thaau ||2||",
      "translation": "But those who are intoxicated with vice shall find no home, no place of rest. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਸਿਉ ਲਾਗੀ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "charan kamal siu laagee preet ||",
      "translation": "One who is in love with the Lord's Lotus Feet,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਨ ਸੁਖਾ ਨਹੀ ਆਵਹਿ ਚੀਤਿ ॥੩॥",
      "transliteration": "aan sukhaa nahee aavahi cheet ||3||",
      "translation": "does not think of any other comforts. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਸਿਮਰਉ ਪ੍ਰਭ ਸੁਆਮੀ ॥",
      "transliteration": "sadaa sadaa simarau prabh suaamee ||",
      "translation": "Forever and ever, meditate on God, your Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਿਲੁ ਨਾਨਕ ਹਰਿ ਅੰਤਰਜਾਮੀ ॥੪॥੮੨॥੧੫੧॥",
      "transliteration": "mil naanak har a(n)tarajaamee ||4||82||151||",
      "translation": "O Nanak, meet with the Lord, the Inner-knower, the Searcher of hearts. ||4||82||151||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਆਠ ਪਹਰ ਸੰਗੀ ਬਟਵਾਰੇ ॥",
      "transliteration": "aath pahar sa(n)gee batavaare ||",
      "translation": "Twenty-four hours a day, the highway robbers are my companions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭਿ ਲਏ ਨਿਵਾਰੇ ॥੧॥",
      "transliteration": "kar kirapaa prabh lae nivaare ||1||",
      "translation": "Granting His Grace, God has driven them away. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਐਸਾ ਹਰਿ ਰਸੁ ਰਮਹੁ ਸਭੁ ਕੋਇ ॥",
      "transliteration": "aisaa har ras ramahu sabh koi ||",
      "translation": "Everyone should dwell on the Sweet Name of such a Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਰਬ ਕਲਾ ਪੂਰਨ ਪ੍ਰਭੁ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sarab kalaa pooran prabh soi ||1|| rahaau ||",
      "translation": "God is overflowing with all power. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਹਾ ਤਪਤਿ ਸਾਗਰ ਸੰਸਾਰ ॥",
      "transliteration": "mahaa tapat saagar sa(n)saar ||",
      "translation": "The world-ocean is burning hot!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪ੍ਰਭ ਖਿਨ ਮਹਿ ਪਾਰਿ ਉਤਾਰਣਹਾਰ ॥੨॥",
      "transliteration": "prabh khin mahi paar utaaranahaar ||2||",
      "translation": "In an instant, God saves us, and carries us across. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਨਿਕ ਬੰਧਨ ਤੋਰੇ ਨਹੀ ਜਾਹਿ ॥",
      "transliteration": "anik ba(n)dhan tore nahee jaahi ||",
      "translation": "There are so many bonds, they cannot be broken.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਿਮਰਤ ਨਾਮ ਮੁਕਤਿ ਫਲ ਪਾਹਿ ॥੩॥",
      "transliteration": "simarat naam mukat phal paahi ||3||",
      "translation": "Remembering the Naam, the Name of the Lord, the fruit of liberation is obtained. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਉਕਤਿ ਸਿਆਨਪ ਇਸ ਤੇ ਕਛੁ ਨਾਹਿ ॥",
      "transliteration": "ukat siaanap is te kachh naahi ||",
      "translation": "By clever devices, nothing is accomplished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਨਾਨਕ ਗੁਣ ਗਾਹਿ ॥੪॥੮੩॥੧੫੨॥",
      "transliteration": "kar kirapaa naanak gun gaahi ||4||83||152||",
      "translation": "Grant Your Grace to Nanak, that he may sing the Glories of God. ||4||83||152||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਥਾਤੀ ਪਾਈ ਹਰਿ ਕੋ ਨਾਮ ॥",
      "transliteration": "thaatee paaee har ko naam ||",
      "translation": "Those who obtain the wealth of the Lord's Name",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਚਰੁ ਸੰਸਾਰ ਪੂਰਨ ਸਭਿ ਕਾਮ ॥੧॥",
      "transliteration": "bichar sa(n)saar pooran sabh kaam ||1||",
      "translation": "move freely in the world; all their affairs are resolved. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਵਡਭਾਗੀ ਹਰਿ ਕੀਰਤਨੁ ਗਾਈਐ ॥",
      "transliteration": "vadabhaagee har keeratan gaaeeai ||",
      "translation": "By great good fortune, the Kirtan of the Lord's Praises are sung.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਤੂੰ ਦੇਹਿ ਤ ਪਾਈਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "paarabraham too(n) dehi ta paaeeai ||1|| rahaau ||",
      "translation": "O Supreme Lord God, as You give, so do I receive. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਰਿ ਕੇ ਚਰਣ ਹਿਰਦੈ ਉਰਿ ਧਾਰਿ ॥",
      "transliteration": "har ke charan hiradai ur dhaar ||",
      "translation": "Enshrine the Lord's Feet within your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭਵ ਸਾਗਰੁ ਚੜਿ ਉਤਰਹਿ ਪਾਰਿ ॥੨॥",
      "transliteration": "bhav saagar chaR utarahi paar ||2||",
      "translation": "Get aboard this boat, and cross over the terrifying world-ocean. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਾਧੂ ਸੰਗੁ ਕਰਹੁ ਸਭੁ ਕੋਇ ॥",
      "transliteration": "saadhoo sa(n)g karahu sabh koi ||",
      "translation": "Everyone who joins the Saadh Sangat, the Company of the Holy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਦਾ ਕਲਿਆਣ ਫਿਰਿ ਦੂਖੁ ਨ ਹੋਇ ॥੩॥",
      "transliteration": "sadaa kaliaan phir dookh na hoi ||3||",
      "translation": "obtains eternal peace; pain does not afflict them any longer. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰੇਮ ਭਗਤਿ ਭਜੁ ਗੁਣੀ ਨਿਧਾਨੁ ॥",
      "transliteration": "prem bhagat bhaj gunee nidhaan ||",
      "translation": "With loving devotional worship, meditate on the treasure of excellence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਨਕ ਦਰਗਹ ਪਾਈਐ ਮਾਨੁ ॥੪॥੮੪॥੧੫੩॥",
      "transliteration": "naanak daragah paaeeai maan ||4||84||153||",
      "translation": "O Nanak, you shall be honored in the Court of the Lord. ||4||84||153||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ ਪੂਰਨ ਹਰਿ ਮੀਤ ॥",
      "transliteration": "jal thal maheeal pooran har meet ||",
      "translation": "The Lord, our Friend, is totally pervading the water, the land and the skies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਭ੍ਰਮ ਬਿਨਸੇ ਗਾਏ ਗੁਣ ਨੀਤ ॥੧॥",
      "transliteration": "bhram binase gaae gun neet ||1||",
      "translation": "Doubts are dispelled by continually singing the Lord's Glorious Praises. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਊਠਤ ਸੋਵਤ ਹਰਿ ਸੰਗਿ ਪਹਰੂਆ ॥",
      "transliteration": "oothat sovat har sa(n)g paharooaa ||",
      "translation": "While rising up, and while lying down in sleep, the Lord is always with you, watching over you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਾ ਕੈ ਸਿਮਰਣਿ ਜਮ ਨਹੀ ਡਰੂਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaa kai simaran jam nahee darooaa ||1|| rahaau ||",
      "translation": "Remembering Him in meditation, the fear of Death departs. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0196_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਚਰਣ ਕਮਲ ਪ੍ਰਭ ਰਿਦੈ ਨਿਵਾਸੁ ॥",
      "transliteration": "charan kamal prabh ridai nivaas ||",
      "translation": "With God's Lotus Feet abiding in the heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 196,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
