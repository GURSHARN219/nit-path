{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 197,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0197_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਗਲ ਦੂਖ ਕਾ ਹੋਇਆ ਨਾਸੁ ॥੨॥",
      "transliteration": "sagal dookh kaa hoiaa naas ||2||",
      "translation": "all suffering comes to an end. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਸਾ ਮਾਣੁ ਤਾਣੁ ਧਨੁ ਏਕ ॥",
      "transliteration": "aasaa maan taan dhan ek ||",
      "translation": "The One Lord is my hope, honor, power and wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਾਚੇ ਸਾਹ ਕੀ ਮਨ ਮਹਿ ਟੇਕ ॥੩॥",
      "transliteration": "saache saah kee man mahi tek ||3||",
      "translation": "Within my mind is the Support of the True Banker. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਹਾ ਗਰੀਬ ਜਨ ਸਾਧ ਅਨਾਥ ॥",
      "transliteration": "mahaa gareeb jan saadh anaath ||",
      "translation": "I am the poorest and most helpless servant of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਨਕ ਪ੍ਰਭਿ ਰਾਖੇ ਦੇ ਹਾਥ ॥੪॥੮੫॥੧੫੪॥",
      "transliteration": "naanak prabh raakhe de haath ||4||85||154||",
      "translation": "O Nanak, giving me His Hand, God has protected me. ||4||85||154||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮਿ ਮਜਨੁ ਕਰਿ ਸੂਚੇ ॥",
      "transliteration": "har har naam majan kar sooche ||",
      "translation": "Taking my cleansing bath in the Name of the Lord, Har, Har, I have been purified.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕੋਟਿ ਗ੍ਰਹਣ ਪੁੰਨ ਫਲ ਮੂਚੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kot grahan pu(n)n phal mooche ||1|| rahaau ||",
      "translation": "Its reward surpasses the giving of charity at millions of solar eclipses. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਰਿ ਕੇ ਚਰਣ ਰਿਦੇ ਮਹਿ ਬਸੇ ॥",
      "transliteration": "har ke charan ride mahi base ||",
      "translation": "With the Lord's Feet abiding in the heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਕਿਲਵਿਖ ਨਸੇ ॥੧॥",
      "transliteration": "janam janam ke kilavikh nase ||1||",
      "translation": "the sinful mistakes of countless incarnations are removed. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਕੀਰਤਨ ਫਲੁ ਪਾਇਆ ॥",
      "transliteration": "saadhasa(n)g keeratan phal paaiaa ||",
      "translation": "I have obtained the reward of the Kirtan of the Lord's Praises, in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਮ ਕਾ ਮਾਰਗੁ ਦ੍ਰਿਸਟਿ ਨ ਆਇਆ ॥੨॥",
      "transliteration": "jam kaa maarag drisat na aaiaa ||2||",
      "translation": "I no longer have to gaze upon the way of death. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਨ ਬਚ ਕ੍ਰਮ ਗੋਵਿੰਦ ਅਧਾਰੁ ॥",
      "transliteration": "man bach kram govi(n)d adhaar ||",
      "translation": "In thought, word and deed, seek the Support of the Lord of the Universe;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾ ਤੇ ਛੁਟਿਓ ਬਿਖੁ ਸੰਸਾਰੁ ॥੩॥",
      "transliteration": "taa te chhutio bikh sa(n)saar ||3||",
      "translation": "thus you shall be saved from the poisonous world-ocean. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭਿ ਕੀਨੋ ਅਪਨਾ ॥",
      "transliteration": "kar kirapaa prabh keeno apanaa ||",
      "translation": "Granting His Grace, God has made me His Own.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਨਕ ਜਾਪੁ ਜਪੇ ਹਰਿ ਜਪਨਾ ॥੪॥੮੬॥੧੫੫॥",
      "transliteration": "naanak jaap jape har japanaa ||4||86||155||",
      "translation": "Nanak chants and meditates on the Chant of the Lord's Name. ||4||86||155||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਉ ਸਰਣਾਈ ਜਿਨਿ ਹਰਿ ਜਾਤੇ ॥",
      "transliteration": "pau saranaaee jin har jaate ||",
      "translation": "Seek the Sanctuary of those who have come to know the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਸੀਤਲੁ ਚਰਣ ਹਰਿ ਰਾਤੇ ॥੧॥",
      "transliteration": "man tan seetal charan har raate ||1||",
      "translation": "Your mind and body shall become cool and peaceful, imbued with the Feet of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭੈ ਭੰਜਨ ਪ੍ਰਭ ਮਨਿ ਨ ਬਸਾਹੀ ॥",
      "transliteration": "bhai bha(n)jan prabh man na basaahee ||",
      "translation": "If God, the Destroyer of fear, does not dwell within your mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਡਰਪਤ ਡਰਪਤ ਜਨਮ ਬਹੁਤੁ ਜਾਹੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "darapat darapat janam bahut jaahee ||1|| rahaau ||",
      "translation": "you shall spend countless incarnations in fear and dread. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਾ ਕੈ ਰਿਦੈ ਬਸਿਓ ਹਰਿ ਨਾਮ ॥",
      "transliteration": "jaa kai ridai basio har naam ||",
      "translation": "Those who have the Lord's Name dwelling within their hearts",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਗਲ ਮਨੋਰਥ ਤਾ ਕੇ ਪੂਰਨ ਕਾਮ ॥੨॥",
      "transliteration": "sagal manorath taa ke pooran kaam ||2||",
      "translation": "have all their desires and tasks fulfilled. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਨਮੁ ਜਰਾ ਮਿਰਤੁ ਜਿਸੁ ਵਾਸਿ ॥",
      "transliteration": "janam jaraa mirat jis vaas ||",
      "translation": "Birth, old age and death are in His Power,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੋ ਸਮਰਥੁ ਸਿਮਰਿ ਸਾਸਿ ਗਿਰਾਸਿ ॥੩॥",
      "transliteration": "so samarath simar saas giraas ||3||",
      "translation": "so remember that All-powerful Lord with each breath and morsel of food. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੀਤੁ ਸਾਜਨੁ ਸਖਾ ਪ੍ਰਭੁ ਏਕ ॥",
      "transliteration": "meet saajan sakhaa prabh ek ||",
      "translation": "The One God is my Intimate, Best Friend and Companion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਮੁ ਸੁਆਮੀ ਕਾ ਨਾਨਕ ਟੇਕ ॥੪॥੮੭॥੧੫੬॥",
      "transliteration": "naam suaamee kaa naanak tek ||4||87||156||",
      "translation": "The Naam, the Name of my Lord and Master, is Nanak's only Support. ||4||87||156||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਾਹਰਿ ਰਾਖਿਓ ਰਿਦੈ ਸਮਾਲਿ ॥",
      "transliteration": "baahar raakhio ridai samaal ||",
      "translation": "When they are out and about, they keep Him enshrined in their hearts;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਘਰਿ ਆਏ ਗੋਵਿੰਦੁ ਲੈ ਨਾਲਿ ॥੧॥",
      "transliteration": "ghar aae govi(n)d lai naal ||1||",
      "translation": "returning home, the Lord of the Universe is still with them. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਸੰਤਨ ਕੈ ਸੰਗਿ ॥",
      "transliteration": "har har naam sa(n)tan kai sa(n)g ||",
      "translation": "The Name of the Lord, Har, Har, is the Companion of His Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਰਾਤਾ ਰਾਮ ਕੈ ਰੰਗਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "man tan raataa raam kai ra(n)g ||1|| rahaau ||",
      "translation": "Their minds and bodies are imbued with the Love of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਸਾਗਰੁ ਤਰਿਆ ॥",
      "transliteration": "gur parasaadee saagar tariaa ||",
      "translation": "By Guru's Grace, one crosses over the world-ocean;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਕਿਲਵਿਖ ਸਭਿ ਹਿਰਿਆ ॥੨॥",
      "transliteration": "janam janam ke kilavikh sabh hiriaa ||2||",
      "translation": "the sinful mistakes of countless incarnations are all washed away. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੋਭਾ ਸੁਰਤਿ ਨਾਮਿ ਭਗਵੰਤੁ ॥",
      "transliteration": "sobhaa surat naam bhagava(n)t ||",
      "translation": "Honor and intuitive awareness are acquired through the Name of the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਕਾ ਨਿਰਮਲ ਮੰਤੁ ॥੩॥",
      "transliteration": "poore gur kaa niramal ma(n)t ||3||",
      "translation": "The Teachings of the Perfect Guru are immaculate and pure. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚਰਣ ਕਮਲ ਹਿਰਦੇ ਮਹਿ ਜਾਪੁ ॥",
      "transliteration": "charan kamal hirade mahi jaap ||",
      "translation": "Within your heart, meditate on the His Lotus Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਨਕੁ ਪੇਖਿ ਜੀਵੈ ਪਰਤਾਪੁ ॥੪॥੮੮॥੧੫੭॥",
      "transliteration": "naanak pekh jeevai parataap ||4||88||157||",
      "translation": "Nanak lives by beholding the Lord's Expansive Power. ||4||88||157||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਧੰਨੁ ਇਹੁ ਥਾਨੁ ਗੋਵਿੰਦ ਗੁਣ ਗਾਏ ॥",
      "transliteration": "dha(n)n ihu thaan govi(n)d gun gaae ||",
      "translation": "Blessed is this place, where the Glorious Praises of the Lord of the Universe are sung.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕੁਸਲ ਖੇਮ ਪ੍ਰਭਿ ਆਪਿ ਬਸਾਏ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kusal khem prabh aap basaae ||1|| rahaau ||",
      "translation": "God Himself bestows peace and pleasure. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਿਪਤਿ ਤਹਾ ਜਹਾ ਹਰਿ ਸਿਮਰਨੁ ਨਾਹੀ ॥",
      "transliteration": "bipat tahaa jahaa har simaran naahee ||",
      "translation": "Misfortune occurs where the Lord is not remembered in meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੋਟਿ ਅਨੰਦ ਜਹ ਹਰਿ ਗੁਨ ਗਾਹੀ ॥੧॥",
      "transliteration": "kot ana(n)d jah har gun gaahee ||1||",
      "translation": "There are millions of joys where the Glorious Praises of the Lord are sung. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਰਿ ਬਿਸਰਿਐ ਦੁਖ ਰੋਗ ਘਨੇਰੇ ॥",
      "transliteration": "har bisariai dukh rog ghanere ||",
      "translation": "Forgetting the Lord, all sorts of pains and diseases come.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪ੍ਰਭ ਸੇਵਾ ਜਮੁ ਲਗੈ ਨ ਨੇਰੇ ॥੨॥",
      "transliteration": "prabh sevaa jam lagai na nere ||2||",
      "translation": "Serving God, the Messenger of Death will not even approach you. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੋ ਵਡਭਾਗੀ ਨਿਹਚਲ ਥਾਨੁ ॥",
      "transliteration": "so vadabhaagee nihachal thaan ||",
      "translation": "Very blessed, stable and sublime is that place,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਹ ਜਪੀਐ ਪ੍ਰਭ ਕੇਵਲ ਨਾਮੁ ॥੩॥",
      "transliteration": "jah japeeai prabh keval naam ||3||",
      "translation": "where the Name of God alone is chanted. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਹ ਜਾਈਐ ਤਹ ਨਾਲਿ ਮੇਰਾ ਸੁਆਮੀ ॥",
      "transliteration": "jah jaaeeai tah naal meraa suaamee ||",
      "translation": "Wherever I go, my Lord and Master is with me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਮਿਲਿਆ ਅੰਤਰਜਾਮੀ ॥੪॥੮੯॥੧੫੮॥",
      "transliteration": "naanak kau miliaa a(n)tarajaamee ||4||89||158||",
      "translation": "Nanak has met the Inner-knower, the Searcher of hearts. ||4||89||158||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜੋ ਪ੍ਰਾਣੀ ਗੋਵਿੰਦੁ ਧਿਆਵੈ ॥",
      "transliteration": "jo praanee govi(n)d dhiaavai ||",
      "translation": "That mortal who meditates on the Lord of the Universe,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪੜਿਆ ਅਣਪੜਿਆ ਪਰਮ ਗਤਿ ਪਾਵੈ ॥੧॥",
      "transliteration": "paRiaa anapaRiaa param gat paavai ||1||",
      "translation": "whether educated or uneducated, obtains the state of supreme dignity. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਾਧੂ ਸੰਗਿ ਸਿਮਰਿ ਗੋਪਾਲ ॥",
      "transliteration": "saadhoo sa(n)g simar gopaal ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, meditate on the Lord of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0197_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਝੂਠਾ ਧਨੁ ਮਾਲੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin naavai jhoothaa dhan maal ||1|| rahaau ||",
      "translation": "Without the Name, wealth and property are false. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 197,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
