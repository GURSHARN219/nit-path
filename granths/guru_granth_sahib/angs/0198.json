{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 198,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0198_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰੂਪਵੰਤੁ ਸੋ ਚਤੁਰੁ ਸਿਆਣਾ ॥",
      "transliteration": "roopava(n)t so chatur siaanaa ||",
      "translation": "They alone are handsome, clever and wise,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਨਿ ਜਨਿ ਮਾਨਿਆ ਪ੍ਰਭ ਕਾ ਭਾਣਾ ॥੨॥",
      "transliteration": "jin jan maaniaa prabh kaa bhaanaa ||2||",
      "translation": "who surrender to the Will of God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਗ ਮਹਿ ਆਇਆ ਸੋ ਪਰਵਾਣੁ ॥",
      "transliteration": "jag mahi aaiaa so paravaan ||",
      "translation": "Blessed is their coming into this world,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਅਪਣਾ ਸੁਆਮੀ ਜਾਣੁ ॥੩॥",
      "transliteration": "ghat ghat apanaa suaamee jaan ||3||",
      "translation": "if they recognize their Lord and Master in each and every heart. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਾ ਕੇ ਪੂਰਨ ਭਾਗ ॥",
      "transliteration": "kahu naanak jaa ke pooran bhaag ||",
      "translation": "Says Nanak, their good fortune is perfect,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਰਿ ਚਰਣੀ ਤਾ ਕਾ ਮਨੁ ਲਾਗ ॥੪॥੯੦॥੧੫੯॥",
      "transliteration": "har charanee taa kaa man laag ||4||90||159||",
      "translation": "if they enshrine the Lord's Feet within their minds. ||4||90||159||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਰਿ ਕੇ ਦਾਸ ਸਿਉ ਸਾਕਤ ਨਹੀ ਸੰਗੁ ॥",
      "transliteration": "har ke daas siu saakat nahee sa(n)g ||",
      "translation": "The Lord's servant does not associate with the faithless cynic.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਓਹੁ ਬਿਖਈ ਓਸੁ ਰਾਮ ਕੋ ਰੰਗੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ohu bikhaee os raam ko ra(n)g ||1|| rahaau ||",
      "translation": "One is in the clutches of vice, while the other is in love with the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨ ਅਸਵਾਰ ਜੈਸੇ ਤੁਰੀ ਸੀਗਾਰੀ ॥",
      "transliteration": "man asavaar jaise turee seegaaree ||",
      "translation": "It would be like an imaginary rider on a decorated horse,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਉ ਕਾਪੁਰਖੁ ਪੁਚਾਰੈ ਨਾਰੀ ॥੧॥",
      "transliteration": "jiu kaapurakh puchaarai naaree ||1||",
      "translation": "or a eunuch caressing a woman. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬੈਲ ਕਉ ਨੇਤ੍ਰਾ ਪਾਇ ਦੁਹਾਵੈ ॥",
      "transliteration": "bail kau netraa paai duhaavai ||",
      "translation": "It would be like tying up an ox and trying to milk it,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਊ ਚਰਿ ਸਿੰਘ ਪਾਛੈ ਪਾਵੈ ॥੨॥",
      "transliteration": "gaoo char si(n)gh paachhai paavai ||2||",
      "translation": "or riding a cow to chase a tiger. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗਾਡਰ ਲੇ ਕਾਮਧੇਨੁ ਕਰਿ ਪੂਜੀ ॥",
      "transliteration": "gaadar le kaamadhen kar poojee ||",
      "translation": "It would be like taking a sheep and worshipping it as the Elysian cow,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਉਦੇ ਕਉ ਧਾਵੈ ਬਿਨੁ ਪੂੰਜੀ ॥੩॥",
      "transliteration": "saude kau dhaavai bin poo(n)jee ||3||",
      "translation": "the giver of all blessings; it would be like going out shopping without any money. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਨਕ ਰਾਮ ਨਾਮੁ ਜਪਿ ਚੀਤ ॥",
      "transliteration": "naanak raam naam jap cheet ||",
      "translation": "O Nanak, consciously meditate on the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਿਮਰਿ ਸੁਆਮੀ ਹਰਿ ਸਾ ਮੀਤ ॥੪॥੯੧॥੧੬੦॥",
      "transliteration": "simar suaamee har saa meet ||4||91||160||",
      "translation": "Meditate in remembrance on the Lord Master, your Best Friend. ||4||91||160||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਾ ਮਤਿ ਨਿਰਮਲ ਕਹੀਅਤ ਧੀਰ ॥",
      "transliteration": "saa mat niramal kaheeat dheer ||",
      "translation": "Pure and steady is that intellect,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਮ ਰਸਾਇਣੁ ਪੀਵਤ ਬੀਰ ॥੧॥",
      "transliteration": "raam rasaain peevat beer ||1||",
      "translation": "which drinks in the Lord's sublime essence. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਰਿ ਕੇ ਚਰਣ ਹਿਰਦੈ ਕਰਿ ਓਟ ॥",
      "transliteration": "har ke charan hiradai kar ot ||",
      "translation": "Keep the Support of the Lord's Feet in your heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਨਮ ਮਰਣ ਤੇ ਹੋਵਤ ਛੋਟ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "janam maran te hovat chhot ||1|| rahaau ||",
      "translation": "and you shall be saved from the cycle of birth and death. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋ ਤਨੁ ਨਿਰਮਲੁ ਜਿਤੁ ਉਪਜੈ ਨ ਪਾਪੁ ॥",
      "transliteration": "so tan niramal jit upajai na paap ||",
      "translation": "Pure is that body, in which sin does not arise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਾਮ ਰੰਗਿ ਨਿਰਮਲ ਪਰਤਾਪੁ ॥੨॥",
      "transliteration": "raam ra(n)g niramal parataap ||2||",
      "translation": "In the Love of the Lord is pure glory. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਮਿਟਿ ਜਾਤ ਬਿਕਾਰ ॥",
      "transliteration": "saadhasa(n)g mit jaat bikaar ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, corruption is eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਭ ਤੇ ਊਚ ਏਹੋ ਉਪਕਾਰ ॥੩॥",
      "transliteration": "sabh te ooch eho upakaar ||3||",
      "translation": "This is the greatest blessing of all. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪ੍ਰੇਮ ਭਗਤਿ ਰਾਤੇ ਗੋਪਾਲ ॥",
      "transliteration": "prem bhagat raate gopaal ||",
      "translation": "Imbued with loving devotional worship of the Sustainer of the Universe,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਜਾਚੈ ਸਾਧ ਰਵਾਲ ॥੪॥੯੨॥੧੬੧॥",
      "transliteration": "naanak jaachai saadh ravaal ||4||92||161||",
      "translation": "Nanak asks for the dust of the feet of the Holy. ||4||92||161||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਐਸੀ ਪ੍ਰੀਤਿ ਗੋਵਿੰਦ ਸਿਉ ਲਾਗੀ ॥",
      "transliteration": "aisee preet govi(n)d siu laagee ||",
      "translation": "Such is my love for the Lord of the Universe;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੇਲਿ ਲਏ ਪੂਰਨ ਵਡਭਾਗੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mel lae pooran vadabhaagee ||1|| rahaau ||",
      "translation": "through perfect good destiny, I have been united with Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਰਤਾ ਪੇਖਿ ਬਿਗਸੈ ਜਿਉ ਨਾਰੀ ॥",
      "transliteration": "bharataa pekh bigasai jiu naaree ||",
      "translation": "As the wife is delighted upon beholding her husband,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਿਉ ਹਰਿ ਜਨੁ ਜੀਵੈ ਨਾਮੁ ਚਿਤਾਰੀ ॥੧॥",
      "transliteration": "tiu har jan jeevai naam chitaaree ||1||",
      "translation": "so does the Lord's humble servant live by chanting the Naam, the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪੂਤ ਪੇਖਿ ਜਿਉ ਜੀਵਤ ਮਾਤਾ ॥",
      "transliteration": "poot pekh jiu jeevat maataa ||",
      "translation": "As the mother is rejuvenated upon seeing her son,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਓਤਿ ਪੋਤਿ ਜਨੁ ਹਰਿ ਸਿਉ ਰਾਤਾ ॥੨॥",
      "transliteration": "ot pot jan har siu raataa ||2||",
      "translation": "so is the Lord's humble servant imbued with Him, through and through. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਲੋਭੀ ਅਨਦੁ ਕਰੈ ਪੇਖਿ ਧਨਾ ॥",
      "transliteration": "lobhee anad karai pekh dhanaa ||",
      "translation": "As the greedy man rejoices upon beholding his wealth,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਨ ਚਰਨ ਕਮਲ ਸਿਉ ਲਾਗੋ ਮਨਾ ॥੩॥",
      "transliteration": "jan charan kamal siu laago manaa ||3||",
      "translation": "so is the mind of the Lord's humble servant attached to His Lotus Feet. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਿਸਰੁ ਨਹੀ ਇਕੁ ਤਿਲੁ ਦਾਤਾਰ ॥",
      "transliteration": "bisar nahee ik til daataar ||",
      "translation": "May I never forget You, for even an instant, O Great Giver!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਨਕ ਕੇ ਪ੍ਰਭ ਪ੍ਰਾਨ ਅਧਾਰ ॥੪॥੯੩॥੧੬੨॥",
      "transliteration": "naanak ke prabh praan adhaar ||4||93||162||",
      "translation": "Nanak's God is the Support of his breath of life. ||4||93||162||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਾਮ ਰਸਾਇਣਿ ਜੋ ਜਨ ਗੀਧੇ ॥",
      "transliteration": "raam rasaain jo jan geedhe ||",
      "translation": "Those humble beings who are accustomed to the Lord's sublime essence,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਪ੍ਰੇਮ ਭਗਤੀ ਬੀਧੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "charan kamal prem bhagatee beedhe ||1|| rahaau ||",
      "translation": "are pierced through with loving devotional worship of the Lord's Lotus Feet. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਨ ਰਸਾ ਦੀਸਹਿ ਸਭਿ ਛਾਰੁ ॥",
      "transliteration": "aan rasaa deesahi sabh chhaar ||",
      "translation": "All other pleasures look like ashes;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਨਿਹਫਲ ਸੰਸਾਰ ॥੧॥",
      "transliteration": "naam binaa nihaphal sa(n)saar ||1||",
      "translation": "without the Naam, the Name of the Lord, the world is fruitless. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅੰਧ ਕੂਪ ਤੇ ਕਾਢੇ ਆਪਿ ॥",
      "transliteration": "a(n)dh koop te kaadhe aap ||",
      "translation": "He Himself rescues us from the deep dark well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਣ ਗੋਵਿੰਦ ਅਚਰਜ ਪਰਤਾਪ ॥੨॥",
      "transliteration": "gun govi(n)d acharaj parataap ||2||",
      "translation": "Wondrous and Glorious are the Praises of the Lord of the Universe. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਵਣਿ ਤ੍ਰਿਣਿ ਤ੍ਰਿਭਵਣਿ ਪੂਰਨ ਗੋਪਾਲ ॥",
      "transliteration": "van trin tribhavan pooran gopaal ||",
      "translation": "In the woods and meadows, and throughout the three worlds, the Sustainer of the Universe is pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬ੍ਰਹਮ ਪਸਾਰੁ ਜੀਅ ਸੰਗਿ ਦਇਆਲ ॥੩॥",
      "transliteration": "braham pasaar jee sa(n)g daiaal ||3||",
      "translation": "The Expansive Lord God is Merciful to all beings. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਸਾ ਕਥਨੀ ਸਾਰੁ ॥",
      "transliteration": "kahu naanak saa kathanee saar ||",
      "translation": "Says Nanak, that speech alone is excellent,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਮਾਨਿ ਲੇਤੁ ਜਿਸੁ ਸਿਰਜਨਹਾਰੁ ॥੪॥੯੪॥੧੬੩॥",
      "transliteration": "maan let jis sirajanahaar ||4||94||163||",
      "translation": "which is approved by the Creator Lord. ||4||94||163||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਿਤਪ੍ਰਤਿ ਨਾਵਣੁ ਰਾਮ ਸਰਿ ਕੀਜੈ ॥",
      "transliteration": "nitaprat naavan raam sar keejai ||",
      "translation": "Every day, take your bath in the Sacred Pool of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਝੋਲਿ ਮਹਾ ਰਸੁ ਹਰਿ ਅੰਮ੍ਰਿਤੁ ਪੀਜੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jhol mahaa ras har a(n)mrit peejai ||1|| rahaau ||",
      "translation": "Mix and drink in the most delicious, sublime Ambrosial Nectar of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨਿਰਮਲ ਉਦਕੁ ਗੋਵਿੰਦ ਕਾ ਨਾਮ ॥",
      "transliteration": "niramal udak govi(n)d kaa naam ||",
      "translation": "The water of the Name of the Lord of the Universe is immaculate and pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0198_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮਜਨੁ ਕਰਤ ਪੂਰਨ ਸਭਿ ਕਾਮ ॥੧॥",
      "transliteration": "majan karat pooran sabh kaam ||1||",
      "translation": "Take your cleansing bath in it, and all your affairs shall be resolved. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 198,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
