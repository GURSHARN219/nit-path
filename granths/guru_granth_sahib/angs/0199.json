{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 199,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0199_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੰਤਸੰਗਿ ਤਹ ਗੋਸਟਿ ਹੋਇ ॥",
      "transliteration": "sa(n)tasa(n)g tah gosat hoi ||",
      "translation": "In the Society of the Saints, spiritual conversations take place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੋਟਿ ਜਨਮ ਕੇ ਕਿਲਵਿਖ ਖੋਇ ॥੨॥",
      "transliteration": "kot janam ke kilavikh khoi ||2||",
      "translation": "The sinful mistakes of millions of incarnations are erased. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਿਮਰਹਿ ਸਾਧ ਕਰਹਿ ਆਨੰਦੁ ॥",
      "transliteration": "simarahi saadh karahi aana(n)d ||",
      "translation": "The Holy Saints meditate in remembrance, in ecstasy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਨਿ ਤਨਿ ਰਵਿਆ ਪਰਮਾਨੰਦੁ ॥੩॥",
      "transliteration": "man tan raviaa paramaana(n)d ||3||",
      "translation": "Their minds and bodies are immersed in supreme ecstasy. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਸਹਿ ਪਰਾਪਤਿ ਹਰਿ ਚਰਣ ਨਿਧਾਨ ॥",
      "transliteration": "jisahi paraapat har charan nidhaan ||",
      "translation": "Slave Nanak is a sacrifice to those",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਤਿਸਹਿ ਕੁਰਬਾਨ ॥੪॥੯੫॥੧੬੪॥",
      "transliteration": "naanak daas tisahi kurabaan ||4||95||164||",
      "translation": "Who have obtained the treasure of the Lord's Feet. ||4||95||164||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੋ ਕਿਛੁ ਕਰਿ ਜਿਤੁ ਮੈਲੁ ਨ ਲਾਗੈ ॥",
      "transliteration": "so kichh kar jit mail na laagai ||",
      "translation": "Do only that, by which no filth or pollution shall stick to you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਰਿ ਕੀਰਤਨ ਮਹਿ ਏਹੁ ਮਨੁ ਜਾਗੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har keeratan mahi ehu man jaagai ||1|| rahaau ||",
      "translation": "Let your mind remain awake and aware, singing the Kirtan of the Lord's Praises. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਏਕੋ ਸਿਮਰਿ ਨ ਦੂਜਾ ਭਾਉ ॥",
      "transliteration": "eko simar na doojaa bhaau ||",
      "translation": "Meditate in remembrance on the One Lord; do not be in love with duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੰਤਸੰਗਿ ਜਪਿ ਕੇਵਲ ਨਾਉ ॥੧॥",
      "transliteration": "sa(n)tasa(n)g jap keval naau ||1||",
      "translation": "In the Society of the Saints, chant only the Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਨੇਮ ਬ੍ਰਤ ਪੂਜਾ ॥",
      "transliteration": "karam dharam nem brat poojaa ||",
      "translation": "The karma of good actions, the Dharma of righteous living, religious rituals, fasts and worship",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਬਿਨੁ ਜਾਨੁ ਨ ਦੂਜਾ ॥੨॥",
      "transliteration": "paarabraham bin jaan na doojaa ||2||",
      "translation": "- practice these, but do not know any other than the Supreme Lord God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾ ਕੀ ਪੂਰਨ ਹੋਈ ਘਾਲ ॥",
      "transliteration": "taa kee pooran hoee ghaal ||",
      "translation": "Their works are brought to fruition,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਾ ਕੀ ਪ੍ਰੀਤਿ ਅਪੁਨੇ ਪ੍ਰਭ ਨਾਲਿ ॥੩॥",
      "transliteration": "jaa kee preet apune prabh naal ||3||",
      "translation": "if they place their love in God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੋ ਬੈਸਨੋ ਹੈ ਅਪਰ ਅਪਾਰੁ ॥",
      "transliteration": "so baisano hai apar apaar ||",
      "translation": "Infinitely invaluable is that Vaishnaav, that worshipper of Vishnu,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਿਨਿ ਤਜੇ ਬਿਕਾਰ ॥੪॥੯੬॥੧੬੫॥",
      "transliteration": "kahu naanak jin taje bikaar ||4||96||165||",
      "translation": "says Nanak, who has renounced corruption. ||4||96||165||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੀਵਤ ਛਾਡਿ ਜਾਹਿ ਦੇਵਾਨੇ ॥",
      "transliteration": "jeevat chhaad jaahi devaane ||",
      "translation": "They desert you even when you are alive, O madman;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮੁਇਆ ਉਨ ਤੇ ਕੋ ਵਰਸਾਂਨੇ ॥੧॥",
      "transliteration": "muiaa un te ko varasaa(n)ne ||1||",
      "translation": "what good can they do when someone is dead? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਿਮਰਿ ਗੋਵਿੰਦੁ ਮਨਿ ਤਨਿ ਧੁਰਿ ਲਿਖਿਆ ॥",
      "transliteration": "simar govi(n)d man tan dhur likhiaa ||",
      "translation": "Meditate in remembrance on the Lord of the Universe in your mind and body - this is your pre-ordained destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਾਹੂ ਕਾਜ ਨ ਆਵਤ ਬਿਖਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kaahoo kaaj na aavat bikhiaa ||1|| rahaau ||",
      "translation": "The poison of Maya is of no use at all. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਿਖੈ ਠਗਉਰੀ ਜਿਨਿ ਜਿਨਿ ਖਾਈ ॥",
      "transliteration": "bikhai thagauree jin jin khaaee ||",
      "translation": "Those who have eaten this poison of deception",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਾ ਕੀ ਤ੍ਰਿਸਨਾ ਕਬਹੂੰ ਨ ਜਾਈ ॥੨॥",
      "transliteration": "taa kee trisanaa kabahoo(n) na jaaee ||2||",
      "translation": "- their thirst shall never depart. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦਾਰਨ ਦੁਖ ਦੁਤਰ ਸੰਸਾਰੁ ॥",
      "transliteration": "daaran dukh dutar sa(n)saar ||",
      "translation": "The treacherous world-ocean is filled with terrible pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਬਿਨੁ ਕੈਸੇ ਉਤਰਸਿ ਪਾਰਿ ॥੩॥",
      "transliteration": "raam naam bin kaise utaras paar ||3||",
      "translation": "Without the Lord's Name, how can anyone cross over? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਮਿਲਿ ਦੁਇ ਕੁਲ ਸਾਧਿ ॥",
      "transliteration": "saadhasa(n)g mil dui kul saadh ||",
      "translation": "Joining the Saadh Sangat, the Company of the Holy, you shall be saved here and hereafter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਨਾਨਕ ਆਰਾਧਿ ॥੪॥੯੭॥੧੬੬॥",
      "transliteration": "raam naam naanak aaraadh ||4||97||166||",
      "translation": "O Nanak, worship and adore the Name of the Lord. ||4||97||166||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗਰੀਬਾ ਉਪਰਿ ਜਿ ਖਿੰਜੈ ਦਾੜੀ ॥",
      "transliteration": "gareebaa upar j khi(n)jai daaRee ||",
      "translation": "The bearded emperor who struck down the poor,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮਿ ਸਾ ਅਗਨਿ ਮਹਿ ਸਾੜੀ ॥੧॥",
      "transliteration": "paarabraham saa agan mahi saaRee ||1||",
      "translation": "has been burnt in the fire by the Supreme Lord God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪੂਰਾ ਨਿਆਉ ਕਰੇ ਕਰਤਾਰੁ ॥",
      "transliteration": "pooraa niaau kare karataar ||",
      "translation": "The Creator administers true justice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਪੁਨੇ ਦਾਸ ਕਉ ਰਾਖਨਹਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "apune daas kau raakhanahaar ||1|| rahaau ||",
      "translation": "He is the Saving Grace of His slaves. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਦਿ ਜੁਗਾਦਿ ਪ੍ਰਗਟਿ ਪਰਤਾਪੁ ॥",
      "transliteration": "aad jugaad pragat parataap ||",
      "translation": "In the beginning, and throughout the ages, His glory is manifest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਿੰਦਕੁ ਮੁਆ ਉਪਜਿ ਵਡ ਤਾਪੁ ॥੨॥",
      "transliteration": "ni(n)dak muaa upaj vad taap ||2||",
      "translation": "The slanderer died after contracting the deadly fever. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਿਨਿ ਮਾਰਿਆ ਜਿ ਰਖੈ ਨ ਕੋਇ ॥",
      "transliteration": "tin maariaa j rakhai na koi ||",
      "translation": "He is killed, and no one can save him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਗੈ ਪਾਛੈ ਮੰਦੀ ਸੋਇ ॥੩॥",
      "transliteration": "aagai paachhai ma(n)dee soi ||3||",
      "translation": "Here and hereafter, his reputation is evil. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਪੁਨੇ ਦਾਸ ਰਾਖੈ ਕੰਠਿ ਲਾਇ ॥",
      "transliteration": "apune daas raakhai ka(n)th laai ||",
      "translation": "The Lord hugs His slaves close in His Embrace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਰਣਿ ਨਾਨਕ ਹਰਿ ਨਾਮੁ ਧਿਆਇ ॥੪॥੯੮॥੧੬੭॥",
      "transliteration": "saran naanak har naam dhiaai ||4||98||167||",
      "translation": "Nanak seeks the Lord's Sanctuary, and meditates on the Naam. ||4||98||167||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਹਜਰੁ ਝੂਠਾ ਕੀਤੋਨੁ ਆਪਿ ॥",
      "transliteration": "mahajar jhoothaa keeton aap ||",
      "translation": "The memorandum was proven to be false by the Lord Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਾਪੀ ਕਉ ਲਾਗਾ ਸੰਤਾਪੁ ॥੧॥",
      "transliteration": "paapee kau laagaa sa(n)taap ||1||",
      "translation": "The sinner is now suffering in despair. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਿਸਹਿ ਸਹਾਈ ਗੋਬਿਦੁ ਮੇਰਾ ॥",
      "transliteration": "jisahi sahaaee gobid meraa ||",
      "translation": "Those who have my Lord of the Universe as their support",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਸੁ ਕਉ ਜਮੁ ਨਹੀ ਆਵੈ ਨੇਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tis kau jam nahee aavai neraa ||1|| rahaau ||",
      "translation": "- death does not even approach them. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਾਚੀ ਦਰਗਹ ਬੋਲੈ ਕੂੜੁ ॥",
      "transliteration": "saachee daragah bolai kooR ||",
      "translation": "In the True Court, they lie;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਿਰੁ ਹਾਥ ਪਛੋੜੈ ਅੰਧਾ ਮੂੜੁ ॥੨॥",
      "transliteration": "sir haath pachhoRai a(n)dhaa mooR ||2||",
      "translation": "the blind fools strike their own heads with their own hands. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰੋਗ ਬਿਆਪੇ ਕਰਦੇ ਪਾਪ ॥",
      "transliteration": "rog biaape karade paap ||",
      "translation": "Sickness afflicts those who commit sins;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਦਲੀ ਹੋਇ ਬੈਠਾ ਪ੍ਰਭੁ ਆਪਿ ॥੩॥",
      "transliteration": "adalee hoi baithaa prabh aap ||3||",
      "translation": "God Himself sits as the Judge. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਪਨ ਕਮਾਇਐ ਆਪੇ ਬਾਧੇ ॥",
      "transliteration": "apan kamaaiai aape baadhe ||",
      "translation": "By their own actions, they are bound and gagged.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਦਰਬੁ ਗਇਆ ਸਭੁ ਜੀਅ ਕੈ ਸਾਥੈ ॥੪॥",
      "transliteration": "darab gaiaa sabh jee kai saathai ||4||",
      "translation": "All their wealth is gone, along with their lives. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਾਨਕ ਸਰਨਿ ਪਰੇ ਦਰਬਾਰਿ ॥",
      "transliteration": "naanak saran pare darabaar ||",
      "translation": "Nanak has taken to the Sanctuary of the Lord's Court;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਰਾਖੀ ਪੈਜ ਮੇਰੈ ਕਰਤਾਰਿ ॥੫॥੯੯॥੧੬੮॥",
      "transliteration": "raakhee paij merai karataar ||5||99||168||",
      "translation": "my Creator has preserved my honor. ||5||99||168||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਨ ਕੀ ਧੂਰਿ ਮਨ ਮੀਠ ਖਟਾਨੀ ॥",
      "transliteration": "jan kee dhoor man meeth khataanee ||",
      "translation": "The dust of the feet of the humble beings is so sweet to my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0199_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪੂਰਬਿ ਕਰਮਿ ਲਿਖਿਆ ਧੁਰਿ ਪ੍ਰਾਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "poorab karam likhiaa dhur praanee ||1|| rahaau ||",
      "translation": "Perfect karma is the mortal's pre-ordained destiny. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 199,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
