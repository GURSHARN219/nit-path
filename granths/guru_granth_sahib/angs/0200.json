{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 200,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0200_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਹੰਬੁਧਿ ਮਨ ਪੂਰਿ ਥਿਧਾਈ ॥",
      "transliteration": "aha(n)budh man poor thidhaaee ||",
      "translation": "The mind is overflowing with the greasy dirt of egotistical pride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਧ ਧੂਰਿ ਕਰਿ ਸੁਧ ਮੰਜਾਈ ॥੧॥",
      "transliteration": "saadh dhoor kar sudh ma(n)jaaee ||1||",
      "translation": "With the dust of the feet of the Holy, it is scrubbed clean. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਨਿਕ ਜਲਾ ਜੇ ਧੋਵੈ ਦੇਹੀ ॥",
      "transliteration": "anik jalaa je dhovai dehee ||",
      "translation": "The body may be washed with loads of water,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮੈਲੁ ਨ ਉਤਰੈ ਸੁਧੁ ਨ ਤੇਹੀ ॥੨॥",
      "transliteration": "mail na utarai sudh na tehee ||2||",
      "translation": "and yet its filth is not removed, and it does not become clean. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਭੇਟਿਓ ਸਦਾ ਕ੍ਰਿਪਾਲ ॥",
      "transliteration": "satigur bhetio sadaa kripaal ||",
      "translation": "I have met the True Guru, who is merciful forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਿ ਸਿਮਰਿ ਕਾਟਿਆ ਭਉ ਕਾਲ ॥੩॥",
      "transliteration": "har simar simar kaatiaa bhau kaal ||3||",
      "translation": "Meditating, meditating in remembrance on the Lord, I am rid of the fear of death. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੁਕਤਿ ਭੁਗਤਿ ਜੁਗਤਿ ਹਰਿ ਨਾਉ ॥",
      "transliteration": "mukat bhugat jugat har naau ||",
      "translation": "Liberation, pleasures and worldly success are all in the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪ੍ਰੇਮ ਭਗਤਿ ਨਾਨਕ ਗੁਣ ਗਾਉ ॥੪॥੧੦੦॥੧੬੯॥",
      "transliteration": "prem bhagat naanak gun gaau ||4||100||169||",
      "translation": "With loving devotional worship, O Nanak, sing His Glorious Praises. ||4||100||169||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੀਵਨ ਪਦਵੀ ਹਰਿ ਕੇ ਦਾਸ ॥",
      "transliteration": "jeevan padavee har ke daas ||",
      "translation": "The Lord's slaves attain the highest status of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਨ ਮਿਲਿਆ ਆਤਮ ਪਰਗਾਸੁ ॥੧॥",
      "transliteration": "jin miliaa aatam paragaas ||1||",
      "translation": "Meeting them, the soul is enlightened. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਕਾ ਸਿਮਰਨੁ ਸੁਨਿ ਮਨ ਕਾਨੀ ॥",
      "transliteration": "har kaa simaran sun man kaanee ||",
      "translation": "Those who listen with their mind and ears to the Lord's meditative remembrance,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁਖੁ ਪਾਵਹਿ ਹਰਿ ਦੁਆਰ ਪਰਾਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sukh paavahi har duaar paraanee ||1|| rahaau ||",
      "translation": "are blessed with peace at the Lord's Gate, O mortal. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਠ ਪਹਰ ਧਿਆਈਐ ਗੋਪਾਲੁ ॥",
      "transliteration": "aath pahar dhiaaeeai gopaal ||",
      "translation": "Twenty-four hours a day, meditate on the Sustainer of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਦਰਸਨੁ ਦੇਖਿ ਨਿਹਾਲੁ ॥੨॥੧੦੧॥੧੭੦॥",
      "transliteration": "naanak darasan dekh nihaal ||2||101||170||",
      "translation": "O Nanak, gazing on the Blessed Vision of His Darshan, I am enraptured. ||2||101||170||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਾਂਤਿ ਭਈ ਗੁਰ ਗੋਬਿਦਿ ਪਾਈ ॥",
      "transliteration": "saa(n)t bhaee gur gobid paaee ||",
      "translation": "Peace and tranquility have come; the Guru, the Lord of the Universe, has brought it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾਪ ਪਾਪ ਬਿਨਸੇ ਮੇਰੇ ਭਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "taap paap binase mere bhaaee ||1|| rahaau ||",
      "translation": "The burning sins have departed, O my Siblings of Destiny. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਨਿਤ ਰਸਨ ਬਖਾਨ ॥",
      "transliteration": "raam naam nit rasan bakhaan ||",
      "translation": "With your tongue, continually chant the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਨਸੇ ਰੋਗ ਭਏ ਕਲਿਆਨ ॥੧॥",
      "transliteration": "binase rog bhae kaliaan ||1||",
      "translation": "Disease shall depart, and you shall be saved. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਗੁਣ ਅਗਮ ਬੀਚਾਰ ॥",
      "transliteration": "paarabraham gun agam beechaar ||",
      "translation": "Contemplate the Glorious Virtues of the Unfathomable Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾਧੂ ਸੰਗਮਿ ਹੈ ਨਿਸਤਾਰ ॥੨॥",
      "transliteration": "saadhoo sa(n)gam hai nisataar ||2||",
      "translation": "In the Saadh Sangat, the Company of the Holy, you shall be emancipated. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਿਰਮਲ ਗੁਣ ਗਾਵਹੁ ਨਿਤ ਨੀਤ ॥",
      "transliteration": "niramal gun gaavahu nit neet ||",
      "translation": "Sing the Glories of God each and every day;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗਈ ਬਿਆਧਿ ਉਬਰੇ ਜਨ ਮੀਤ ॥੩॥",
      "transliteration": "gaee biaadh ubare jan meet ||3||",
      "translation": "your afflictions shall be dispelled, and you shall be saved, my humble friend. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਨ ਬਚ ਕ੍ਰਮ ਪ੍ਰਭੁ ਅਪਨਾ ਧਿਆਈ ॥",
      "transliteration": "man bach kram prabh apanaa dhiaaee ||",
      "translation": "In thought, word and deed, I meditate on my God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਤੇਰੀ ਸਰਣਾਈ ॥੪॥੧੦੨॥੧੭੧॥",
      "transliteration": "naanak daas teree saranaaee ||4||102||171||",
      "translation": "Slave Nanak has come to Your Sanctuary. ||4||102||171||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨੇਤ੍ਰ ਪ੍ਰਗਾਸੁ ਕੀਆ ਗੁਰਦੇਵ ॥",
      "transliteration": "netr pragaas keeaa guradev ||",
      "translation": "The Divine Guru has opened his eyes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਰਮ ਗਏ ਪੂਰਨ ਭਈ ਸੇਵ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bharam gae pooran bhaee sev ||1|| rahaau ||",
      "translation": "Doubt has been dispelled; my service has been successful. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੀਤਲਾ ਤੇ ਰਖਿਆ ਬਿਹਾਰੀ ॥",
      "transliteration": "seetalaa te rakhiaa bihaaree ||",
      "translation": "The Giver of joy has saved him from smallpox.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਪ੍ਰਭ ਕਿਰਪਾ ਧਾਰੀ ॥੧॥",
      "transliteration": "paarabraham prabh kirapaa dhaaree ||1||",
      "translation": "The Supreme Lord God has granted His Grace. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਜਪੈ ਸੋ ਜੀਵੈ ॥",
      "transliteration": "naanak naam japai so jeevai ||",
      "translation": "O Nanak, he alone lives, who chants the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਹਰਿ ਅੰਮ੍ਰਿਤੁ ਪੀਵੈ ॥੨॥੧੦੩॥੧੭੨॥",
      "transliteration": "saadhasa(n)g har a(n)mrit peevai ||2||103||172||",
      "translation": "In the Saadh Sangat, the Company of the Holy, drink deeply of the Lord's Ambrosial Nectar. ||2||103||172||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਧਨੁ ਓਹੁ ਮਸਤਕੁ ਧਨੁ ਤੇਰੇ ਨੇਤ ॥",
      "transliteration": "dhan ohu masatak dhan tere net ||",
      "translation": "Blessed is that forehead, and blessed are those eyes;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਧਨੁ ਓਇ ਭਗਤ ਜਿਨ ਤੁਮ ਸੰਗਿ ਹੇਤ ॥੧॥",
      "transliteration": "dhan oi bhagat jin tum sa(n)g het ||1||",
      "translation": "blessed are those devotees who are in love with You. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਕੈਸੇ ਸੁਖੁ ਲਹੀਐ ॥",
      "transliteration": "naam binaa kaise sukh laheeai ||",
      "translation": "Without the Naam, the Name of the Lord, how anyone find peace?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਸਨਾ ਰਾਮ ਨਾਮ ਜਸੁ ਕਹੀਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "rasanaa raam naam jas kaheeai ||1|| rahaau ||",
      "translation": "With your tongue, chant the Praises of the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਿਨ ਊਪਰਿ ਜਾਈਐ ਕੁਰਬਾਣੁ ॥",
      "transliteration": "tin oopar jaaeeai kurabaan ||",
      "translation": "Nanak is a sacrifice to those",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾਨਕ ਜਿਨਿ ਜਪਿਆ ਨਿਰਬਾਣੁ ॥੨॥੧੦੪॥੧੭੩॥",
      "transliteration": "naanak jin japiaa nirabaan ||2||104||173||",
      "translation": "who meditate on the Lord of Nirvaanaa. ||2||104||173||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤੂੰਹੈ ਮਸਲਤਿ ਤੂੰਹੈ ਨਾਲਿ ॥",
      "transliteration": "too(n)hai masalat too(n)hai naal ||",
      "translation": "You are my Advisor; You are always with me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੂਹੈ ਰਾਖਹਿ ਸਾਰਿ ਸਮਾਲਿ ॥੧॥",
      "transliteration": "toohai raakhahi saar samaal ||1||",
      "translation": "You preserve, protect and care for me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਐਸਾ ਰਾਮੁ ਦੀਨ ਦੁਨੀ ਸਹਾਈ ॥",
      "transliteration": "aisaa raam deen dunee sahaaee ||",
      "translation": "Such is the Lord, our Help and Support in this world and the next.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦਾਸ ਕੀ ਪੈਜ ਰਖੈ ਮੇਰੇ ਭਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "daas kee paij rakhai mere bhaaee ||1|| rahaau ||",
      "translation": "He protects the honor of His slave, O my Sibling of Destiny. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਗੈ ਆਪਿ ਇਹੁ ਥਾਨੁ ਵਸਿ ਜਾ ਕੈ ॥",
      "transliteration": "aagai aap ihu thaan vas jaa kai ||",
      "translation": "He alone exists hereafter; this place is in His Power.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਠ ਪਹਰ ਮਨੁ ਹਰਿ ਕਉ ਜਾਪੈ ॥੨॥",
      "transliteration": "aath pahar man har kau jaapai ||2||",
      "translation": "Twenty-four hours a day, O my mind, chant and meditate on the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਤਿ ਪਰਵਾਣੁ ਸਚੁ ਨੀਸਾਣੁ ॥",
      "transliteration": "pat paravaan sach neesaan ||",
      "translation": "His honor is acknowledged, and he bears the True Insignia;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਾ ਕਉ ਆਪਿ ਕਰਹਿ ਫੁਰਮਾਨੁ ॥੩॥",
      "transliteration": "jaa kau aap karahi phuramaan ||3||",
      "translation": "the Lord Himself issues His Royal Command. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਆਪੇ ਦਾਤਾ ਆਪਿ ਪ੍ਰਤਿਪਾਲਿ ॥",
      "transliteration": "aape daataa aap pratipaal ||",
      "translation": "He Himself is the Giver; He Himself is the Cherisher.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਿਤ ਨਿਤ ਨਾਨਕ ਰਾਮ ਨਾਮੁ ਸਮਾਲਿ ॥੪॥੧੦੫॥੧੭੪॥",
      "transliteration": "nit nit naanak raam naam samaal ||4||105||174||",
      "translation": "Continually, continuously, O Nanak, dwell upon the Name of the Lord. ||4||105||174||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਪੂਰਾ ਭਇਆ ਕ੍ਰਿਪਾਲੁ ॥",
      "transliteration": "satigur pooraa bhaiaa kripaal ||",
      "translation": "When the Perfect True Guru becomes merciful,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਹਿਰਦੈ ਵਸਿਆ ਸਦਾ ਗੁਪਾਲੁ ॥੧॥",
      "transliteration": "hiradai vasiaa sadaa gupaal ||1||",
      "translation": "the Lord of the World abides in the heart forever. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0200_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਰਾਮੁ ਰਵਤ ਸਦ ਹੀ ਸੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "raam ravat sad hee sukh paaiaa ||",
      "translation": "Meditating on the Lord, I have found eternal peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 200,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
