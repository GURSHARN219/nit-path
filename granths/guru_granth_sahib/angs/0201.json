{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 201,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0201_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਇਆ ਕਰੀ ਪੂਰਨ ਹਰਿ ਰਾਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "maiaa karee pooran har raaiaa ||1|| rahaau ||",
      "translation": "The Sovereign Lord, the Perfect King, has shown His Mercy to me. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਾ ਕੇ ਪੂਰੇ ਭਾਗ ॥",
      "transliteration": "kahu naanak jaa ke poore bhaag ||",
      "translation": "Says Nanak, one whose destiny is perfect,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਅਸਥਿਰੁ ਸੋਹਾਗੁ ॥੨॥੧੦੬॥",
      "transliteration": "har har naam asathir sohaag ||2||106||",
      "translation": "meditates on the Name of the Lord, Har, Har, the Everlasting Husband. ||2||106||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਧੋਤੀ ਖੋਲਿ ਵਿਛਾਏ ਹੇਠਿ ॥",
      "transliteration": "dhotee khol vichhaae heth ||",
      "translation": "He opens his loin-cloth, and spreads it out beneath him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਰਧਪ ਵਾਂਗੂ ਲਾਹੇ ਪੇਟਿ ॥੧॥",
      "transliteration": "garadhap vaa(n)goo laahe pet ||1||",
      "translation": "Like a donkey, he gulps down all that comes his way. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਿਨੁ ਕਰਤੂਤੀ ਮੁਕਤਿ ਨ ਪਾਈਐ ॥",
      "transliteration": "bin karatootee mukat na paaeeai ||",
      "translation": "Without good deeds, liberation is not obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮੁਕਤਿ ਪਦਾਰਥੁ ਨਾਮੁ ਧਿਆਈਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mukat padaarath naam dhiaaeeai ||1|| rahaau ||",
      "translation": "The wealth of liberation is only obtained by meditating on the Naam, the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪੂਜਾ ਤਿਲਕ ਕਰਤ ਇਸਨਾਨਾਂ ॥",
      "transliteration": "poojaa tilak karat isanaanaa(n) ||",
      "translation": "He performs worship ceremonies, applies the ceremonial tilak mark to his forehead, and takes his ritual cleansing baths;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਛੁਰੀ ਕਾਢਿ ਲੇਵੈ ਹਥਿ ਦਾਨਾ ॥੨॥",
      "transliteration": "chhuree kaadh levai hath daanaa ||2||",
      "translation": "he pulls out his knife, and demands donations. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬੇਦੁ ਪੜੈ ਮੁਖਿ ਮੀਠੀ ਬਾਣੀ ॥",
      "transliteration": "bed paRai mukh meethee baanee ||",
      "translation": "With his mouth, he recites the Vedas in sweet musical measures,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੀਆਂ ਕੁਹਤ ਨ ਸੰਗੈ ਪਰਾਣੀ ॥੩॥",
      "transliteration": "jeeaa(n) kuhat na sa(n)gai paraanee ||3||",
      "translation": "and yet he does not hesitate to take the lives of others. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਿਸੁ ਕਿਰਪਾ ਧਾਰੈ ॥",
      "transliteration": "kahu naanak jis kirapaa dhaarai ||",
      "translation": "Says Nanak, when God showers His Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਿਰਦਾ ਸੁਧੁ ਬ੍ਰਹਮੁ ਬੀਚਾਰੈ ॥੪॥੧੦੭॥",
      "transliteration": "hiradaa sudh braham beechaarai ||4||107||",
      "translation": "even his heart becomes pure, and he contemplates God. ||4||107||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਥਿਰੁ ਘਰਿ ਬੈਸਹੁ ਹਰਿ ਜਨ ਪਿਆਰੇ ॥",
      "transliteration": "thir ghar baisahu har jan piaare ||",
      "translation": "Remain steady in the home of your own self, O beloved servant of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਤੁਮਰੇ ਕਾਜ ਸਵਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "satigur tumare kaaj savaare ||1|| rahaau ||",
      "translation": "The True Guru shall resolve all your affairs. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੁਸਟ ਦੂਤ ਪਰਮੇਸਰਿ ਮਾਰੇ ॥",
      "transliteration": "dusat doot paramesar maare ||",
      "translation": "The Transcendent Lord has struck down the wicked and the evil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਨ ਕੀ ਪੈਜ ਰਖੀ ਕਰਤਾਰੇ ॥੧॥",
      "transliteration": "jan kee paij rakhee karataare ||1||",
      "translation": "The Creator has preserved the honor of His servant. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਾਦਿਸਾਹ ਸਾਹ ਸਭ ਵਸਿ ਕਰਿ ਦੀਨੇ ॥",
      "transliteration": "baadisaah saah sabh vas kar deene ||",
      "translation": "The kings and emperors are all under his power;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮ ਮਹਾ ਰਸ ਪੀਨੇ ॥੨॥",
      "transliteration": "a(n)mrit naam mahaa ras peene ||2||",
      "translation": "he drinks deeply of the most sublime essence of the Ambrosial Naam. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਿਰਭਉ ਹੋਇ ਭਜਹੁ ਭਗਵਾਨ ॥",
      "transliteration": "nirabhau hoi bhajahu bhagavaan ||",
      "translation": "Meditate fearlessly on the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਮਿਲਿ ਕੀਨੋ ਦਾਨੁ ॥੩॥",
      "transliteration": "saadhasa(n)gat mil keeno daan ||3||",
      "translation": "Joining the Saadh Sangat, the Company of the Holy, this gift is given. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਰਣਿ ਪਰੇ ਪ੍ਰਭ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "saran pare prabh a(n)tarajaamee ||",
      "translation": "Nanak has entered the Sanctuary of God, the Inner-knower, the Searcher of hearts;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਨਕ ਓਟ ਪਕਰੀ ਪ੍ਰਭ ਸੁਆਮੀ ॥੪॥੧੦੮॥",
      "transliteration": "naanak ot pakaree prabh suaamee ||4||108||",
      "translation": "he grasps the Support of God, his Lord and Master. ||4||108||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ ਭਾਹਿ ਨ ਜਲੈ ॥",
      "transliteration": "har sa(n)g raate bhaahi na jalai ||",
      "translation": "One who is attuned to the Lord, shall not be burned in the fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ ਮਾਇਆ ਨਹੀ ਛਲੈ ॥",
      "transliteration": "har sa(n)g raate maaiaa nahee chhalai ||",
      "translation": "One who is attuned to the Lord, shall not be enticed by Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ ਨਹੀ ਡੂਬੈ ਜਲਾ ॥",
      "transliteration": "har sa(n)g raate nahee doobai jalaa ||",
      "translation": "One who is attuned to the Lord, shall not be drowned in water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ ਸੁਫਲ ਫਲਾ ॥੧॥",
      "transliteration": "har sa(n)g raate suphal phalaa ||1||",
      "translation": "One who is attuned to the Lord, is prosperous and fruitful. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਭ ਭੈ ਮਿਟਹਿ ਤੁਮਾਰੈ ਨਾਇ ॥",
      "transliteration": "sabh bhai mitahi tumaarai naai ||",
      "translation": "All fear is eradicated by Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭੇਟਤ ਸੰਗਿ ਹਰਿ ਹਰਿ ਗੁਨ ਗਾਇ ॥ ਰਹਾਉ ॥",
      "transliteration": "bhetat sa(n)g har har gun gaai || rahaau ||",
      "translation": "Joining the Sangat, the Holy Congregation, sing the Glorious Praises of the Lord, Har, Har. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ ਮਿਟੈ ਸਭ ਚਿੰਤਾ ॥",
      "transliteration": "har sa(n)g raate mitai sabh chi(n)taa ||",
      "translation": "One who is attuned to the Lord, is free of all anxieties.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਰਿ ਸਿਉ ਸੋ ਰਚੈ ਜਿਸੁ ਸਾਧ ਕਾ ਮੰਤਾ ॥",
      "transliteration": "har siu so rachai jis saadh kaa ma(n)taa ||",
      "translation": "One who is attuned to the Lord, is blessed with the Mantra of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ ਜਮ ਕੀ ਨਹੀ ਤ੍ਰਾਸ ॥",
      "transliteration": "har sa(n)g raate jam kee nahee traas ||",
      "translation": "One who is attuned to the Lord, is not haunted by the fear of death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ ਪੂਰਨ ਆਸ ॥੨॥",
      "transliteration": "har sa(n)g raate pooran aas ||2||",
      "translation": "One who is attuned to the Lord, sees all his hopes fulfilled. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ ਦੂਖੁ ਨ ਲਾਗੈ ॥",
      "transliteration": "har sa(n)g raate dookh na laagai ||",
      "translation": "One who is attuned to the Lord, does not suffer in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤਾ ਅਨਦਿਨੁ ਜਾਗੈ ॥",
      "transliteration": "har sa(n)g raataa anadin jaagai ||",
      "translation": "One who is attuned to the Lord, remains awake and aware, night and day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤਾ ਸਹਜ ਘਰਿ ਵਸੈ ॥",
      "transliteration": "har sa(n)g raataa sahaj ghar vasai ||",
      "translation": "One who is attuned to the Lord, dwells in the home of intuitive peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ ਭ੍ਰਮੁ ਭਉ ਨਸੈ ॥੩॥",
      "transliteration": "har sa(n)g raate bhram bhau nasai ||3||",
      "translation": "One who is attuned to the Lord, sees his doubts and fears run away. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ ਮਤਿ ਊਤਮ ਹੋਇ ॥",
      "transliteration": "har sa(n)g raate mat ootam hoi ||",
      "translation": "One who is attuned to the Lord, has the most sublime and exalted intellect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰਾਤੇ ਨਿਰਮਲ ਸੋਇ ॥",
      "transliteration": "har sa(n)g raate niramal soi ||",
      "translation": "One who is attuned to the Lord, has a pure and spotless reputation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਤਿਨ ਕਉ ਬਲਿ ਜਾਈ ॥",
      "transliteration": "kahu naanak tin kau bal jaaee ||",
      "translation": "Says Nanak, I am a sacrifice to those,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਨ ਕਉ ਪ੍ਰਭੁ ਮੇਰਾ ਬਿਸਰਤ ਨਾਹੀ ॥੪॥੧੦੯॥",
      "transliteration": "jin kau prabh meraa bisarat naahee ||4||109||",
      "translation": "Who do not forget my God. ||4||109||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਉਦਮੁ ਕਰਤ ਸੀਤਲ ਮਨ ਭਏ ॥",
      "transliteration": "udam karat seetal man bhae ||",
      "translation": "Through sincere efforts, the mind is made peaceful and calm.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਾਰਗਿ ਚਲਤ ਸਗਲ ਦੁਖ ਗਏ ॥",
      "transliteration": "maarag chalat sagal dukh gae ||",
      "translation": "Walking on the Lord's Way, all pains are taken away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਮਨਿ ਭਏ ਅਨੰਦ ॥",
      "transliteration": "naam japat man bhae ana(n)d ||",
      "translation": "Chanting the Naam, the Name of the Lord, the mind becomes blissful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਰਸਿ ਗਾਏ ਗੁਨ ਪਰਮਾਨੰਦ ॥੧॥",
      "transliteration": "ras gaae gun paramaana(n)d ||1||",
      "translation": "Singing the Glorious Praises of the Lord, supreme bliss is obtained. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਖੇਮ ਭਇਆ ਕੁਸਲ ਘਰਿ ਆਏ ॥",
      "transliteration": "khem bhaiaa kusal ghar aae ||",
      "translation": "There is joy all around, and peace has come to my home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਭੇਟਤ ਸਾਧਸੰਗਿ ਗਈ ਬਲਾਏ ॥ ਰਹਾਉ ॥",
      "transliteration": "bhetat saadhasa(n)g gaee balaae || rahaau ||",
      "translation": "Joining the Saadh Sangat, the Company of the Holy, misfortune disappears. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨੇਤ੍ਰ ਪੁਨੀਤ ਪੇਖਤ ਹੀ ਦਰਸ ॥",
      "transliteration": "netr puneet pekhat hee daras ||",
      "translation": "My eyes are purified, beholding the Blessed Vision of His Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਧਨਿ ਮਸਤਕ ਚਰਨ ਕਮਲ ਹੀ ਪਰਸ ॥",
      "transliteration": "dhan masatak charan kamal hee paras ||",
      "translation": "Blessed is the forehead which touches His Lotus Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0201_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗੋਬਿੰਦ ਕੀ ਟਹਲ ਸਫਲ ਇਹ ਕਾਂਇਆ ॥",
      "transliteration": "gobi(n)d kee tahal saphal ih kaa(n)iaa ||",
      "translation": "Working for the Lord of the Universe, the body becomes fruitful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 201,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
