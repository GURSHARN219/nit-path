{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 202,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0202_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਪਰਮ ਪਦੁ ਪਾਇਆ ॥੨॥",
      "transliteration": "sa(n)t prasaad param pad paaiaa ||2||",
      "translation": "By the Grace of the Saints, I have obtained the supreme status. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਨ ਕੀ ਕੀਨੀ ਆਪਿ ਸਹਾਇ ॥",
      "transliteration": "jan kee keenee aap sahaai ||",
      "translation": "The Lord is the Help and Support of His humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੁਖੁ ਪਾਇਆ ਲਗਿ ਦਾਸਹ ਪਾਇ ॥",
      "transliteration": "sukh paaiaa lag daasah paai ||",
      "translation": "I have found peace, falling at the feet of His slaves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਪੁ ਗਇਆ ਤਾ ਆਪਹਿ ਭਏ ॥",
      "transliteration": "aap gaiaa taa aapahi bhae ||",
      "translation": "When selfishness is gone, then one becomes the Lord Himself;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਨਿਧਾਨ ਕੀ ਸਰਨੀ ਪਏ ॥੩॥",
      "transliteration": "kripaa nidhaan kee saranee pae ||3||",
      "translation": "seek the Sanctuary of the treasure of mercy. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੋ ਚਾਹਤ ਸੋਈ ਜਬ ਪਾਇਆ ॥",
      "transliteration": "jo chaahat soee jab paaiaa ||",
      "translation": "When someone finds the One he has desired,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਬ ਢੂੰਢਨ ਕਹਾ ਕੋ ਜਾਇਆ ॥",
      "transliteration": "tab dhoo(n)dhan kahaa ko jaaiaa ||",
      "translation": "then where should he go to look for Him?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਸਥਿਰ ਭਏ ਬਸੇ ਸੁਖ ਆਸਨ ॥",
      "transliteration": "asathir bhae base sukh aasan ||",
      "translation": "I have become steady and stable, and I dwell in the seat of peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਨਾਨਕ ਸੁਖ ਬਾਸਨ ॥੪॥੧੧੦॥",
      "transliteration": "gur prasaad naanak sukh baasan ||4||110||",
      "translation": "By Guru's Grace, Nanak has entered the home of peace. ||4||110||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕੋਟਿ ਮਜਨ ਕੀਨੋ ਇਸਨਾਨ ॥",
      "transliteration": "kot majan keeno isanaan ||",
      "translation": "The merits of taking millions of ceremonial cleansing baths,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਲਾਖ ਅਰਬ ਖਰਬ ਦੀਨੋ ਦਾਨੁ ॥",
      "transliteration": "laakh arab kharab deeno daan ||",
      "translation": "the giving of hundreds of thousands, billions and trillions in charity",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਾ ਮਨਿ ਵਸਿਓ ਹਰਿ ਕੋ ਨਾਮੁ ॥੧॥",
      "transliteration": "jaa man vasio har ko naam ||1||",
      "translation": "- these are obtained by those whose minds are filled with the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਗਲ ਪਵਿਤ ਗੁਨ ਗਾਇ ਗੁਪਾਲ ॥",
      "transliteration": "sagal pavit gun gaai gupaal ||",
      "translation": "Those who sing the Glories of the Lord of the World are totally pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਾਪ ਮਿਟਹਿ ਸਾਧੂ ਸਰਨਿ ਦਇਆਲ ॥ ਰਹਾਉ ॥",
      "transliteration": "paap mitahi saadhoo saran daiaal || rahaau ||",
      "translation": "Their sins are erased, in the Sanctuary of the Kind and Holy Saints. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁਤੁ ਉਰਧ ਤਪ ਸਾਧਨ ਸਾਧੇ ॥",
      "transliteration": "bahut uradh tap saadhan saadhe ||",
      "translation": "The merits of performing all sorts of austere acts of penance and self-discipline,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਨਿਕ ਲਾਭ ਮਨੋਰਥ ਲਾਧੇ ॥",
      "transliteration": "anik laabh manorath laadhe ||",
      "translation": "earning huge profits and seeing one's desires fulfilled",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮ ਰਸਨ ਆਰਾਧੇ ॥੨॥",
      "transliteration": "har har naam rasan aaraadhe ||2||",
      "translation": "- these are obtained by chanting the Name of the Lord, Har, Har, with the tongue. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਿੰਮ੍ਰਿਤਿ ਸਾਸਤ ਬੇਦ ਬਖਾਨੇ ॥",
      "transliteration": "si(n)mrit saasat bed bakhaane ||",
      "translation": "The merits of reciting the Simritees, the Shaastras and the Vedas,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੋਗ ਗਿਆਨ ਸਿਧ ਸੁਖ ਜਾਨੇ ॥",
      "transliteration": "jog giaan sidh sukh jaane ||",
      "translation": "knowledge of the science of Yoga, spiritual wisdom and the pleasure of miraculous spiritual powers",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਪ੍ਰਭ ਸਿਉ ਮਨ ਮਾਨੇ ॥੩॥",
      "transliteration": "naam japat prabh siu man maane ||3||",
      "translation": "- these come by surrendering the mind and meditating on the Name of God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਗਾਧਿ ਬੋਧਿ ਹਰਿ ਅਗਮ ਅਪਾਰੇ ॥",
      "transliteration": "agaadh bodh har agam apaare ||",
      "translation": "The wisdom of the Inaccessible and Infinite Lord is incomprehensible.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਨਾਮੁ ਰਿਦੇ ਬੀਚਾਰੇ ॥",
      "transliteration": "naam japat naam ride beechaare ||",
      "translation": "Meditating on the Naam, the Name of the Lord, and contemplating the Naam within our hearts,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਪ੍ਰਭ ਕਿਰਪਾ ਧਾਰੇ ॥੪॥੧੧੧॥",
      "transliteration": "naanak kau prabh kirapaa dhaare ||4||111||",
      "translation": "O Nanak, God has showered His Mercy upon us. ||4||111||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗਉੜੀ ਮਃ ੫ ॥",
      "transliteration": "gauRee mah 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਸਿਮਰਿ ਸੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "simar simar simar sukh paaiaa ||",
      "translation": "Meditating, meditating, meditating in remembrance, I have found peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਗੁਰ ਰਿਦੈ ਬਸਾਇਆ ॥੧॥",
      "transliteration": "charan kamal gur ridai basaaiaa ||1||",
      "translation": "I have enshrined the Lotus Feet of the Guru within my heart. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੁਰ ਗੋਬਿੰਦੁ ਪਾਰਬ੍ਰਹਮੁ ਪੂਰਾ ॥",
      "transliteration": "gur gobi(n)d paarabraham pooraa ||",
      "translation": "The Guru, the Lord of the Universe, the Supreme Lord God, is perfect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਸਹਿ ਅਰਾਧਿ ਮੇਰਾ ਮਨੁ ਧੀਰਾ ॥ ਰਹਾਉ ॥",
      "transliteration": "tisahi araadh meraa man dheeraa || rahaau ||",
      "translation": "Worshipping Him, my mind has found a lasting peace. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਨਦਿਨੁ ਜਪਉ ਗੁਰੂ ਗੁਰ ਨਾਮ ॥",
      "transliteration": "anadin japau guroo gur naam ||",
      "translation": "Night and day, I meditate on the Guru, and the Name of the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਾ ਤੇ ਸਿਧਿ ਭਏ ਸਗਲ ਕਾਂਮ ॥੨॥",
      "transliteration": "taa te sidh bhae sagal kaa(n)m ||2||",
      "translation": "Thus all my works are brought to perfection. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦਰਸਨ ਦੇਖਿ ਸੀਤਲ ਮਨ ਭਏ ॥",
      "transliteration": "darasan dekh seetal man bhae ||",
      "translation": "Beholding the Blessed Vision of His Darshan, my mind has become cool and tranquil,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਕਿਲਬਿਖ ਗਏ ॥੩॥",
      "transliteration": "janam janam ke kilabikh gae ||3||",
      "translation": "and the sinful mistakes of countless incarnations have been washed away. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਕਹਾ ਭੈ ਭਾਈ ॥",
      "transliteration": "kahu naanak kahaa bhai bhaaee ||",
      "translation": "Says Nanak, where is fear now, O Siblings of Destiny?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਪਨੇ ਸੇਵਕ ਕੀ ਆਪਿ ਪੈਜ ਰਖਾਈ ॥੪॥੧੧੨॥",
      "transliteration": "apane sevak kee aap paij rakhaaee ||4||112||",
      "translation": "The Guru Himself has preserved the honor of His servant. ||4||112||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਪਨੇ ਸੇਵਕ ਕਉ ਆਪਿ ਸਹਾਈ ॥",
      "transliteration": "apane sevak kau aap sahaaee ||",
      "translation": "The Lord Himself is the Help and Support of His servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਿਤ ਪ੍ਰਤਿਪਾਰੈ ਬਾਪ ਜੈਸੇ ਮਾਈ ॥੧॥",
      "transliteration": "nit pratipaarai baap jaise maaee ||1||",
      "translation": "He always cherishes them, like their father and mother. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਸਰਨਿ ਉਬਰੈ ਸਭ ਕੋਇ ॥",
      "transliteration": "prabh kee saran ubarai sabh koi ||",
      "translation": "In God's Sanctuary, everyone is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਪੂਰਨ ਸਚੁ ਸੋਇ ॥ ਰਹਾਉ ॥",
      "transliteration": "karan karaavan pooran sach soi || rahaau ||",
      "translation": "That Perfect True Lord is the Doer, the Cause of causes. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਬ ਮਨਿ ਬਸਿਆ ਕਰਨੈਹਾਰਾ ॥",
      "transliteration": "ab man basiaa karanaihaaraa ||",
      "translation": "My mind now dwells in the Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭੈ ਬਿਨਸੇ ਆਤਮ ਸੁਖ ਸਾਰਾ ॥੨॥",
      "transliteration": "bhai binase aatam sukh saaraa ||2||",
      "translation": "My fears have been dispelled, and my soul has found the most sublime peace. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਅਪਨੇ ਜਨ ਰਾਖੇ ॥",
      "transliteration": "kar kirapaa apane jan raakhe ||",
      "translation": "The Lord has granted His Grace, and saved His humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਕਿਲਬਿਖ ਲਾਥੇ ॥੩॥",
      "transliteration": "janam janam ke kilabikh laathe ||3||",
      "translation": "The sinful mistakes of so many incarnations have been washed away. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਹਨੁ ਨ ਜਾਇ ਪ੍ਰਭ ਕੀ ਵਡਿਆਈ ॥",
      "transliteration": "kahan na jaai prabh kee vadiaaee ||",
      "translation": "The Greatness of God cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਸਦਾ ਸਰਨਾਈ ॥੪॥੧੧੩॥",
      "transliteration": "naanak daas sadaa saranaaee ||4||113||",
      "translation": "Servant Nanak is forever in His Sanctuary. ||4||113||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਾਗੁ ਗਉੜੀ ਚੇਤੀ ਮਹਲਾ ੫ ਦੁਪਦੇ ॥",
      "transliteration": "raag gauRee chetee mahalaa 5 dupade ||",
      "translation": "Raag Gauree Chaytee, Fifth Mehl, Dho-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਰਾਮ ਕੋ ਬਲੁ ਪੂਰਨ ਭਾਈ ॥",
      "transliteration": "raam ko bal pooran bhaaee ||",
      "translation": "The power of the Lord is universal and perfect, O Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਾ ਤੇ ਬ੍ਰਿਥਾ ਨ ਬਿਆਪੈ ਕਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "taa te brithaa na biaapai kaaee ||1|| rahaau ||",
      "translation": "So no pain can ever afflict me. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜੋ ਜੋ ਚਿਤਵੈ ਦਾਸੁ ਹਰਿ ਮਾਈ ॥",
      "transliteration": "jo jo chitavai daas har maaee ||",
      "translation": "Whatever the Lord's slave wishes, O mother,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੋ ਸੋ ਕਰਤਾ ਆਪਿ ਕਰਾਈ ॥੧॥",
      "transliteration": "so so karataa aap karaaee ||1||",
      "translation": "the Creator Himself causes that to be done. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਿੰਦਕ ਕੀ ਪ੍ਰਭਿ ਪਤਿ ਗਵਾਈ ॥",
      "transliteration": "ni(n)dak kee prabh pat gavaaee ||",
      "translation": "God causes the slanderers to lose their honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0202_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਗੁਣ ਨਿਰਭਉ ਗਾਈ ॥੨॥੧੧੪॥",
      "transliteration": "naanak har gun nirabhau gaaee ||2||114||",
      "translation": "Nanak sings the Glorious Praises of the Fearless Lord. ||2||114||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 202,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
