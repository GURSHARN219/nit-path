{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 210,
  "lineCount": 44,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0210_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਗੁ ਗਉੜੀ₁ ਪੂਰਬੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raag gauRee₁ poorabee mahalaa 5 ||",
      "translation": "Raag Gauree Poorbee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਕਬਹੂ ਨ ਮਨਹੁ ਬਿਸਾਰੇ ॥",
      "transliteration": "har har kabahoo na manahu bisaare ||",
      "translation": "Never forget the Lord, Har, Har, from your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਈਹਾ ਊਹਾ ਸਰਬ ਸੁਖਦਾਤਾ ਸਗਲ ਘਟਾ ਪ੍ਰਤਿਪਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "eehaa oohaa sarab sukhadaataa sagal ghataa pratipaare ||1|| rahaau ||",
      "translation": "Here and hereafter, He is the Giver of all peace. He is the Cherisher of all hearts. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਹਾ ਕਸਟ ਕਾਟੈ ਖਿਨ ਭੀਤਰਿ ਰਸਨਾ ਨਾਮੁ ਚਿਤਾਰੇ ॥",
      "transliteration": "mahaa kasat kaatai khin bheetar rasanaa naam chitaare ||",
      "translation": "He removes the most terrible pains in an instant, if the tongue repeats His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੀਤਲ ਸਾਂਤਿ ਸੂਖ ਹਰਿ ਸਰਣੀ ਜਲਤੀ ਅਗਨਿ ਨਿਵਾਰੇ ॥੧॥",
      "transliteration": "seetal saa(n)t sookh har saranee jalatee agan nivaare ||1||",
      "translation": "In the Lord's Sanctuary there is soothing coolness, peace and tranquility. He has extinguished the burning fire. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗਰਭ ਕੁੰਡ ਨਰਕ ਤੇ ਰਾਖੈ ਭਵਜਲੁ ਪਾਰਿ ਉਤਾਰੇ ॥",
      "transliteration": "garabh ku(n)d narak te raakhai bhavajal paar utaare ||",
      "translation": "He saves us from the hellish pit of the womb, and carries us across the terrifying world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਆਰਾਧਤ ਮਨ ਮਹਿ ਜਮ ਕੀ ਤ੍ਰਾਸ ਬਿਦਾਰੇ ॥੨॥",
      "transliteration": "charan kamal aaraadhat man mahi jam kee traas bidaare ||2||",
      "translation": "Adoring His Lotus Feet in the mind, the fear of death is banished. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪੂਰਨ ਪਾਰਬ੍ਰਹਮ ਪਰਮੇਸੁਰ ਊਚਾ ਅਗਮ ਅਪਾਰੇ ॥",
      "transliteration": "pooran paarabraham paramesur oochaa agam apaare ||",
      "translation": "He is the Perfect, Supreme Lord God, the Transcendent Lord, lofty, unfathomable and infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਣ ਗਾਵਤ ਧਿਆਵਤ ਸੁਖ ਸਾਗਰ ਜੂਏ ਜਨਮੁ ਨ ਹਾਰੇ ॥੩॥",
      "transliteration": "gun gaavat dhiaavat sukh saagar jooe janam na haare ||3||",
      "translation": "Singing His Glorious Praises, and meditating on the Ocean of peace, one's life is not lost in the gamble. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਾਮਿ ਕ੍ਰੋਧਿ ਲੋਭਿ ਮੋਹਿ ਮਨੁ ਲੀਨੋ ਨਿਰਗੁਣ ਕੇ ਦਾਤਾਰੇ ॥",
      "transliteration": "kaam krodh lobh mohi man leeno niragun ke daataare ||",
      "translation": "My mind is engrossed in sexual desire, anger, greed and attachment, O Giver to the unworthy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਅਪੁਨੋ ਨਾਮੁ ਦੀਜੈ ਨਾਨਕ ਸਦ ਬਲਿਹਾਰੇ ॥੪॥੧॥੧੩੮॥",
      "transliteration": "kar kirapaa apuno naam deejai naanak sad balihaare ||4||1||138||",
      "translation": "Please grant Your Grace, and bless me with Your Name; Nanak is forever a sacrifice to You. ||4||1||138||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਗੁ ਗਉੜੀ ਚੇਤੀ₁ ਮਹਲਾ ੫ ॥",
      "transliteration": "raag gauRee chetee₁ mahalaa 5 ||",
      "translation": "Raag Gauree Chaytee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁਖੁ ਨਾਹੀ ਰੇ ਹਰਿ ਭਗਤਿ ਬਿਨਾ ॥",
      "transliteration": "sukh naahee re har bhagat binaa ||",
      "translation": "There is no peace without devotional worship of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੀਤਿ ਜਨਮੁ ਇਹੁ ਰਤਨੁ ਅਮੋਲਕੁ ਸਾਧਸੰਗਤਿ ਜਪਿ ਇਕ ਖਿਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jeet janam ihu ratan amolak saadhasa(n)gat jap ik khinaa ||1|| rahaau ||",
      "translation": "Be victorious, and win the priceless jewel of this human life, by meditating on Him in the Saadh Sangat, the Company of the Holy, even for an instant. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਤ ਸੰਪਤਿ ਬਨਿਤਾ ਬਿਨੋਦ ॥",
      "transliteration": "sut sa(n)pat banitaa binod ||",
      "translation": "Many have renounced and left their children,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਛੋਡਿ ਗਏ ਬਹੁ ਲੋਗ ਭੋਗ ॥੧॥",
      "transliteration": "chhod gae bahu log bhog ||1||",
      "translation": "Wealth, spouses, joyful games and pleasures. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹੈਵਰ ਗੈਵਰ ਰਾਜ ਰੰਗ ॥",
      "transliteration": "haivar gaivar raaj ra(n)g ||",
      "translation": "Horses, elephants and the pleasures of power",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਿਆਗਿ ਚਲਿਓ ਹੈ ਮੂੜ ਨੰਗ ॥੨॥",
      "transliteration": "tiaag chalio hai mooR na(n)g ||2||",
      "translation": "- leaving these behind, the fool must depart naked. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚੋਆ ਚੰਦਨ ਦੇਹ ਫੂਲਿਆ ॥",
      "transliteration": "choaa cha(n)dan deh phooliaa ||",
      "translation": "The body, scented with musk and sandalwood",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੋ ਤਨੁ ਧਰ ਸੰਗਿ ਰੂਲਿਆ ॥੩॥",
      "transliteration": "so tan dhar sa(n)g rooliaa ||3||",
      "translation": "- that body shall come to roll in the dust. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੋਹਿ ਮੋਹਿਆ ਜਾਨੈ ਦੂਰਿ ਹੈ ॥",
      "transliteration": "mohi mohiaa jaanai door hai ||",
      "translation": "Infatuated with emotional attachment, they think that God is far away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਸਦਾ ਹਦੂਰਿ ਹੈ ॥੪॥੧॥੧੩੯॥",
      "transliteration": "kahu naanak sadaa hadoor hai ||4||1||139||",
      "translation": "Says Nanak, he is Ever-present! ||4||1||139||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨ ਧਰ ਤਰਬੇ ਹਰਿ ਨਾਮ ਨੋ ॥",
      "transliteration": "man dhar tarabe har naam no ||",
      "translation": "O mind, cross over with the Support of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਾਗਰ ਲਹਰਿ ਸੰਸਾ ਸੰਸਾਰੁ ਗੁਰੁ ਬੋਹਿਥੁ ਪਾਰ ਗਰਾਮਨੋ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saagar lahar sa(n)saa sa(n)saar gur bohith paar garaamano ||1|| rahaau ||",
      "translation": "The Guru is the boat to carry you across the world-ocean, through the waves of cynicism and doubt. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਲਿ ਕਾਲਖ ਅੰਧਿਆਰੀਆ ॥",
      "transliteration": "kal kaalakh a(n)dhiaareeaa ||",
      "translation": "In this Dark Age of Kali Yuga, there is only pitch darkness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰ ਗਿਆਨ ਦੀਪਕ ਉਜਿਆਰੀਆ ॥੧॥",
      "transliteration": "gur giaan deepak ujiaareeaa ||1||",
      "translation": "The lamp of the Guru's spiritual wisdom illuminates and enlightens. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿਖੁ ਬਿਖਿਆ ਪਸਰੀ ਅਤਿ ਘਨੀ ॥",
      "transliteration": "bikh bikhiaa pasaree at ghanee ||",
      "translation": "The poison of corruption is spread out far and wide.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਉਬਰੇ ਜਪਿ ਜਪਿ ਹਰਿ ਗੁਨੀ ॥੨॥",
      "transliteration": "ubare jap jap har gunee ||2||",
      "translation": "Only the virtuous are saved, chanting and meditating on the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਤਵਾਰੋ ਮਾਇਆ ਸੋਇਆ ॥",
      "transliteration": "matavaaro maaiaa soiaa ||",
      "translation": "Intoxicated with Maya, the people are asleep.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰ ਭੇਟਤ ਭ੍ਰਮੁ ਭਉ ਖੋਇਆ ॥੩॥",
      "transliteration": "gur bhetat bhram bhau khoiaa ||3||",
      "translation": "Meeting the Guru, doubt and fear are dispelled. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਏਕੁ ਧਿਆਇਆ ॥",
      "transliteration": "kahu naanak ek dhiaaiaa ||",
      "translation": "Says Nanak, meditate on the One Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਨਦਰੀ ਆਇਆ ॥੪॥੨॥੧੪੦॥",
      "transliteration": "ghat ghat nadaree aaiaa ||4||2||140||",
      "translation": "behold Him in each and every heart. ||4||2||140||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੀਬਾਨੁ ਹਮਾਰੋ ਤੁਹੀ ਏਕ ॥",
      "transliteration": "deebaan hamaaro tuhee ek ||",
      "translation": "You alone are my Chief Advisor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੇਵਾ ਥਾਰੀ ਗੁਰਹਿ ਟੇਕ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sevaa thaaree gurahi tek ||1|| rahaau ||",
      "translation": "I serve You with the Support of the Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਨਿਕ ਜੁਗਤਿ ਨਹੀ ਪਾਇਆ ॥",
      "transliteration": "anik jugat nahee paaiaa ||",
      "translation": "By various devices, I could not find You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 210,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0210_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਰਿ ਚਾਕਰ ਲੈ ਲਾਇਆ ॥੧॥",
      "transliteration": "gur chaakar lai laaiaa ||1||",
