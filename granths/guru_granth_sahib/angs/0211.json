{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 211,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0211_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪ੍ਰਭ ਕੇ ਚਾਕਰ ਸੇ ਭਲੇ ॥",
      "transliteration": "prabh ke chaakar se bhale ||",
      "translation": "The slaves of God are good.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਨਕ ਤਿਨ ਮੁਖ ਊਜਲੇ ॥੪॥੩॥੧੪੧॥",
      "transliteration": "naanak tin mukh oojale ||4||3||141||",
      "translation": "O Nanak, their faces are radiant. ||4||3||141||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੀਅਰੇ ਓਲੑਾ ਨਾਮ ਕਾ ॥",
      "transliteration": "jeeare olhaa naam kaa ||",
      "translation": "Hey, soul: your only Support is the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਵਰੁ ਜਿ ਕਰਨ ਕਰਾਵਨੋ ਤਿਨ ਮਹਿ ਭਉ ਹੈ ਜਾਮ ਕਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "avar j karan karaavano tin mahi bhau hai jaam kaa ||1|| rahaau ||",
      "translation": "Whatever else you do or make happen, the fear of death still hangs over you. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਵਰ ਜਤਨਿ ਨਹੀ ਪਾਈਐ ॥",
      "transliteration": "avar jatan nahee paaeeai ||",
      "translation": "He is not obtained by any other efforts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਵਡੈ ਭਾਗਿ ਹਰਿ ਧਿਆਈਐ ॥੧॥",
      "transliteration": "vadai bhaag har dhiaaeeai ||1||",
      "translation": "By great good fortune, meditate on the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਲਾਖ ਹਿਕਮਤੀ ਜਾਨੀਐ ॥",
      "transliteration": "laakh hikamatee jaaneeai ||",
      "translation": "You may know hundreds of thousands of clever tricks,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਗੈ ਤਿਲੁ ਨਹੀ ਮਾਨੀਐ ॥੨॥",
      "transliteration": "aagai til nahee maaneeai ||2||",
      "translation": "but not even one will be of any use at all hereafter. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਹੰਬੁਧਿ ਕਰਮ ਕਮਾਵਨੇ ॥",
      "transliteration": "aha(n)budh karam kamaavane ||",
      "translation": "Good deeds done in the pride of ego are swept away,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗ੍ਰਿਹ ਬਾਲੂ ਨੀਰਿ ਬਹਾਵਨੇ ॥੩॥",
      "transliteration": "grih baaloo neer bahaavane ||3||",
      "translation": "Like the house of sand by water. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪ੍ਰਭੁ ਕ੍ਰਿਪਾਲੁ ਕਿਰਪਾ ਕਰੈ ॥",
      "transliteration": "prabh kripaal kirapaa karai ||",
      "translation": "When God the Merciful shows His Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਮੁ ਨਾਨਕ ਸਾਧੂ ਸੰਗਿ ਮਿਲੈ ॥੪॥੪॥੧੪੨॥",
      "transliteration": "naam naanak saadhoo sa(n)g milai ||4||4||142||",
      "translation": "Nanak receives the Naam in the Saadh Sangat, the Company of the Holy. ||4||4||142||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਾਰਨੈ ਬਲਿਹਾਰਨੈ ਲਖ ਬਰੀਆ ॥",
      "transliteration": "baaranai balihaaranai lakh bareeaa ||",
      "translation": "I am a sacrifice, dedicated hundreds of thousands of times, to my Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਮੋ ਹੋ ਨਾਮੁ ਸਾਹਿਬ ਕੋ ਪ੍ਰਾਨ ਅਧਰੀਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naamo ho naam saahib ko praan adhareeaa ||1|| rahaau ||",
      "translation": "His Name, and His Name alone, is the Support of the breath of life. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਤੁਹੀ ਏਕ ॥",
      "transliteration": "karan karaavan tuhee ek ||",
      "translation": "You alone are the Doer, the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਕੀ ਤੁਹੀ ਟੇਕ ॥੧॥",
      "transliteration": "jee ja(n)t kee tuhee tek ||1||",
      "translation": "You are the Support of all beings and creatures. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਜ ਜੋਬਨ ਪ੍ਰਭ ਤੂੰ ਧਨੀ ॥",
      "transliteration": "raaj joban prabh too(n) dhanee ||",
      "translation": "O God, You are my power, authority and youth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤੂੰ ਨਿਰਗੁਨ ਤੂੰ ਸਰਗੁਨੀ ॥੨॥",
      "transliteration": "too(n) niragun too(n) saragunee ||2||",
      "translation": "You are absolute, without attributes, and also related, with the most sublime attributes. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਈਹਾ ਊਹਾ ਤੁਮ ਰਖੇ ॥",
      "transliteration": "eehaa oohaa tum rakhe ||",
      "translation": "Here and hereafter, You are my Savior and Protector.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਕੋ ਲਖੇ ॥੩॥",
      "transliteration": "gur kirapaa te ko lakhe ||3||",
      "translation": "By Guru's Grace, some understand You. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅੰਤਰਜਾਮੀ ਪ੍ਰਭ ਸੁਜਾਨੁ ॥",
      "transliteration": "a(n)tarajaamee prabh sujaan ||",
      "translation": "God is All-knowing, the Inner-knower, the Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਨਕ ਤਕੀਆ ਤੁਹੀ ਤਾਣੁ ॥੪॥੫॥੧੪੩॥",
      "transliteration": "naanak takeeaa tuhee taan ||4||5||143||",
      "translation": "You are Nanak's strength and support. ||4||5||143||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਹਰਿ ਆਰਾਧੀਐ ॥",
      "transliteration": "har har har aaraadheeai ||",
      "translation": "Worship and adore the Lord, Har, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੰਤਸੰਗਿ ਹਰਿ ਮਨਿ ਵਸੈ ਭਰਮੁ ਮੋਹੁ ਭਉ ਸਾਧੀਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sa(n)tasa(n)g har man vasai bharam mohu bhau saadheeai ||1|| rahaau ||",
      "translation": "In the Society of the Saints, He dwells in the mind; doubt, emotional attachment and fear are vanquished. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬੇਦ ਪੁਰਾਣ ਸਿਮ੍ਰਿਤਿ ਭਨੇ ॥",
      "transliteration": "bed puraan simrit bhane ||",
      "translation": "The Vedas, the Puraanas and the Simritees are heard to proclaim",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਭ ਊਚ ਬਿਰਾਜਿਤ ਜਨ ਸੁਨੇ ॥੧॥",
      "transliteration": "sabh ooch biraajit jan sune ||1||",
      "translation": "that the Lord's servant dwells as the highest of all. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਗਲ ਅਸਥਾਨ ਭੈ ਭੀਤ ਚੀਨ ॥",
      "transliteration": "sagal asathaan bhai bheet cheen ||",
      "translation": "All places are filled with fear - know this well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਮ ਸੇਵਕ ਭੈ ਰਹਤ ਕੀਨ ॥੨॥",
      "transliteration": "raam sevak bhai rahat keen ||2||",
      "translation": "Only the Lord's servants are free of fear. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਲਖ ਚਉਰਾਸੀਹ ਜੋਨਿ ਫਿਰਹਿ ॥",
      "transliteration": "lakh chauraaseeh jon phirahi ||",
      "translation": "People wander through 8.4 million incarnations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੋਬਿੰਦ ਲੋਕ ਨਹੀ ਜਨਮਿ ਮਰਹਿ ॥੩॥",
      "transliteration": "gobi(n)d lok nahee janam marahi ||3||",
      "translation": "God's people are not subject to birth and death. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਲ ਬੁਧਿ ਸਿਆਨਪ ਹਉਮੈ ਰਹੀ ॥",
      "transliteration": "bal budh siaanap haumai rahee ||",
      "translation": "He has given up power, wisdom, cleverness and egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਰਿ ਸਾਧ ਸਰਣਿ ਨਾਨਕ ਗਹੀ ॥੪॥੬॥੧੪੪॥",
      "transliteration": "har saadh saran naanak gahee ||4||6||144||",
      "translation": "Nanak has taken to the Sanctuary of the Lord's Holy Saints. ||4||6||144||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਨ ਰਾਮ ਨਾਮ ਗੁਨ ਗਾਈਐ ॥",
      "transliteration": "man raam naam gun gaaeeai ||",
      "translation": "O my mind, sing the Glorious Praises of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨੀਤ ਨੀਤ ਹਰਿ ਸੇਵੀਐ ਸਾਸਿ ਸਾਸਿ ਹਰਿ ਧਿਆਈਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "neet neet har seveeai saas saas har dhiaaeeai ||1|| rahaau ||",
      "translation": "Serve the Lord continually and continuously; with each and every breath, meditate on the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੰਤਸੰਗਿ ਹਰਿ ਮਨਿ ਵਸੈ ॥",
      "transliteration": "sa(n)tasa(n)g har man vasai ||",
      "translation": "In the Society of the Saints, the Lord dwells in the mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੁਖੁ ਦਰਦੁ ਅਨੇਰਾ ਭ੍ਰਮੁ ਨਸੈ ॥੧॥",
      "transliteration": "dukh darad aneraa bhram nasai ||1||",
      "translation": "and pain, suffering, darkness and doubt depart. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਹਰਿ ਜਾਪੀਐ ॥",
      "transliteration": "sa(n)t prasaad har jaapeeai ||",
      "translation": "That humble being, who meditates on the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੋ ਜਨੁ ਦੂਖਿ ਨ ਵਿਆਪੀਐ ॥੨॥",
      "transliteration": "so jan dookh na viaapeeai ||2||",
      "translation": "By the Grace of the Saints, is not afflicted with pain. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾ ਕਉ ਗੁਰੁ ਹਰਿ ਮੰਤ੍ਰੁ ਦੇ ॥",
      "transliteration": "jaa kau gur har ma(n)tr de ||",
      "translation": "Those unto whom the Guru gives the Mantra of the Lord's Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੋ ਉਬਰਿਆ ਮਾਇਆ ਅਗਨਿ ਤੇ ॥੩॥",
      "transliteration": "so ubariaa maaiaa agan te ||3||",
      "translation": "are saved from the fire of Maya. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਪ੍ਰਭ ਮਇਆ ਕਰਿ ॥",
      "transliteration": "naanak kau prabh maiaa kar ||",
      "translation": "Be kind to Nanak, O God;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੇਰੈ ਮਨਿ ਤਨਿ ਵਾਸੈ ਨਾਮੁ ਹਰਿ ॥੪॥੭॥੧੪੫॥",
      "transliteration": "merai man tan vaasai naam har ||4||7||145||",
      "translation": "let the Lord's Name dwell within my mind and body. ||4||7||145||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਸਨਾ ਜਪੀਐ ਏਕੁ ਨਾਮ ॥",
      "transliteration": "rasanaa japeeai ek naam ||",
      "translation": "With your tongue, chant the Name of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਈਹਾ ਸੁਖੁ ਆਨੰਦੁ ਘਨਾ ਆਗੈ ਜੀਅ ਕੈ ਸੰਗਿ ਕਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "eehaa sukh aana(n)d ghanaa aagai jee kai sa(n)g kaam ||1|| rahaau ||",
      "translation": "In this world, it shall bring you peace, comfort and great joy; hereafter, it shall go with your soul, and shall be of use to you. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਟੀਐ ਤੇਰਾ ਅਹੰ ਰੋਗੁ ॥",
      "transliteration": "kateeai teraa aha(n) rog ||",
      "translation": "The disease of your ego shall be eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤੂੰ ਗੁਰ ਪ੍ਰਸਾਦਿ ਕਰਿ ਰਾਜ ਜੋਗੁ ॥੧॥",
      "transliteration": "too(n) gur prasaad kar raaj jog ||1||",
      "translation": "By Guru's Grace, practice Raja Yoga, the Yoga of meditation and success. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਹਰਿ ਰਸੁ ਜਿਨਿ ਜਨਿ ਚਾਖਿਆ ॥",
      "transliteration": "har ras jin jan chaakhiaa ||",
      "translation": "Those who taste the sublime essence of the Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਾ ਕੀ ਤ੍ਰਿਸਨਾ ਲਾਥੀਆ ॥੨॥",
      "transliteration": "taa kee trisanaa laatheeaa ||2||",
      "translation": "have their thirst quenched. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਹਰਿ ਬਿਸ੍ਰਾਮ ਨਿਧਿ ਪਾਇਆ ॥",
      "transliteration": "har bisraam nidh paaiaa ||",
      "translation": "Those who have found the Lord, the Treasure of peace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸੋ ਬਹੁਰਿ ਨ ਕਤ ਹੀ ਧਾਇਆ ॥੩॥",
      "transliteration": "so bahur na kat hee dhaaiaa ||3||",
      "translation": "shall not go anywhere else again. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਾ ਕਉ ਗੁਰਿ ਦੀਆ ॥",
      "transliteration": "har har naam jaa kau gur deeaa ||",
      "translation": "Those, unto whom the Guru has given the Lord's Name, Har, Har",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0211_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕਾ ਭਉ ਗਇਆ ॥੪॥੮॥੧੪੬॥",
      "transliteration": "naanak taa kaa bhau gaiaa ||4||8||146||",
      "translation": "- O Nanak, their fears are removed. ||4||8||146||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 211,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
