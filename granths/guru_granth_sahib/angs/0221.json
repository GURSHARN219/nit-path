{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 221,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0221_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੁਰ ਕੀ ਮਤਿ ਜੀਇ ਆਈ ਕਾਰਿ ॥੧॥",
      "transliteration": "gur kee mat jeei aaee kaar ||1||",
      "translation": "The Guru's Teachings are useful to my soul. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਨ ਬਿਧਿ ਰਾਮ ਰਮਤ ਮਨੁ ਮਾਨਿਆ ॥",
      "transliteration": "in bidh raam ramat man maaniaa ||",
      "translation": "Chanting the Lord's Name in this way, my mind is satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗਿਆਨ ਅੰਜਨੁ ਗੁਰ ਸਬਦਿ ਪਛਾਨਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "giaan a(n)jan gur sabad pachhaaniaa ||1|| rahaau ||",
      "translation": "I have obtained the ointment of spiritual wisdom, recognizing the Word of the Guru's Shabad. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਕੁ ਸੁਖੁ ਮਾਨਿਆ ਸਹਜਿ ਮਿਲਾਇਆ ॥",
      "transliteration": "ik sukh maaniaa sahaj milaaiaa ||",
      "translation": "Blended with the One Lord, I enjoy intuitive peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਿਰਮਲ ਬਾਣੀ ਭਰਮੁ ਚੁਕਾਇਆ ॥",
      "transliteration": "niramal baanee bharam chukaaiaa ||",
      "translation": "Through the Immaculate Bani of the Word, my doubts have been dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲਾਲ ਭਏ ਸੂਹਾ ਰੰਗੁ ਮਾਇਆ ॥",
      "transliteration": "laal bhae soohaa ra(n)g maaiaa ||",
      "translation": "Instead of the pale color of Maya, I am imbued with the deep crimson color of the Lord's Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਦਰਿ ਭਈ ਬਿਖੁ ਠਾਕਿ ਰਹਾਇਆ ॥੨॥",
      "transliteration": "nadar bhaee bikh thaak rahaaiaa ||2||",
      "translation": "By the Lord's Glance of Grace, the poison has been eliminated. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਉਲਟ ਭਈ ਜੀਵਤ ਮਰਿ ਜਾਗਿਆ ॥",
      "transliteration": "ulat bhaee jeevat mar jaagiaa ||",
      "translation": "When I turned away, and became dead while yet alive, I was awakened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਬਦਿ ਰਵੇ ਮਨੁ ਹਰਿ ਸਿਉ ਲਾਗਿਆ ॥",
      "transliteration": "sabad rave man har siu laagiaa ||",
      "translation": "Chanting the Word of the Shabad, my mind is attached to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਸੁ ਸੰਗ੍ਰਹਿ ਬਿਖੁ ਪਰਹਰਿ ਤਿਆਗਿਆ ॥",
      "transliteration": "ras sa(n)grahi bikh parahar tiaagiaa ||",
      "translation": "I have gathered in the Lord's sublime essence, and cast out the poison.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭਾਇ ਬਸੇ ਜਮ ਕਾ ਭਉ ਭਾਗਿਆ ॥੩॥",
      "transliteration": "bhaai base jam kaa bhau bhaagiaa ||3||",
      "translation": "Abiding in His Love, the fear of death has run away. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਾਦ ਰਹੇ ਬਾਦੰ ਅਹੰਕਾਰਾ ॥",
      "transliteration": "saad rahe baada(n) aha(n)kaaraa ||",
      "translation": "My taste for pleasure ended, along with conflict and egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚਿਤੁ ਹਰਿ ਸਿਉ ਰਾਤਾ ਹੁਕਮਿ ਅਪਾਰਾ ॥",
      "transliteration": "chit har siu raataa hukam apaaraa ||",
      "translation": "My consciousness is attuned to the Lord, by the Order of the Infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾਤਿ ਰਹੇ ਪਤਿ ਕੇ ਆਚਾਰਾ ॥",
      "transliteration": "jaat rahe pat ke aachaaraa ||",
      "translation": "My pursuit for worldy pride and honour is over.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦ੍ਰਿਸਟਿ ਭਈ ਸੁਖੁ ਆਤਮ ਧਾਰਾ ॥੪॥",
      "transliteration": "drisat bhaee sukh aatam dhaaraa ||4||",
      "translation": "When He blessed me with His Glance of Grace, peace was established in my soul. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤੁਝ ਬਿਨੁ ਕੋਇ ਨ ਦੇਖਉ ਮੀਤੁ ॥",
      "transliteration": "tujh bin koi na dekhau meet ||",
      "translation": "Without You, I see no friend at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿਸੁ ਸੇਵਉ ਕਿਸੁ ਦੇਵਉ ਚੀਤੁ ॥",
      "transliteration": "kis sevau kis devau cheet ||",
      "translation": "Whom should I serve? Unto whom should I dedicate my consciousness?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿਸੁ ਪੂਛਉ ਕਿਸੁ ਲਾਗਉ ਪਾਇ ॥",
      "transliteration": "kis poochhau kis laagau paai ||",
      "translation": "Whom should I ask? At whose feet should I fall?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿਸੁ ਉਪਦੇਸਿ ਰਹਾ ਲਿਵ ਲਾਇ ॥੫॥",
      "transliteration": "kis upades rahaa liv laai ||5||",
      "translation": "By whose teachings will I remain absorbed in His Love? ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗੁਰ ਸੇਵੀ ਗੁਰ ਲਾਗਉ ਪਾਇ ॥",
      "transliteration": "gur sevee gur laagau paai ||",
      "translation": "I serve the Guru, and I fall at the Guru's Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭਗਤਿ ਕਰੀ ਰਾਚਉ ਹਰਿ ਨਾਇ ॥",
      "transliteration": "bhagat karee raachau har naai ||",
      "translation": "I worship Him, and I am absorbed in the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਿਖਿਆ ਦੀਖਿਆ ਭੋਜਨ ਭਾਉ ॥",
      "transliteration": "sikhiaa deekhiaa bhojan bhaau ||",
      "translation": "The Lord's Love is my instruction, sermon and food.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹੁਕਮਿ ਸੰਜੋਗੀ ਨਿਜ ਘਰਿ ਜਾਉ ॥੬॥",
      "transliteration": "hukam sa(n)jogee nij ghar jaau ||6||",
      "translation": "Enjoined to the Lord's Command, I have entered the home of my inner self. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗਰਬ ਗਤੰ ਸੁਖ ਆਤਮ ਧਿਆਨਾ ॥",
      "transliteration": "garab gata(n) sukh aatam dhiaanaa ||",
      "translation": "With the extinction of pride, my soul has found peace and meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੋਤਿ ਭਈ ਜੋਤੀ ਮਾਹਿ ਸਮਾਨਾ ॥",
      "transliteration": "jot bhaee jotee maahi samaanaa ||",
      "translation": "The Divine Light has dawned, and I am absorbed in the Light.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਲਿਖਤੁ ਮਿਟੈ ਨਹੀ ਸਬਦੁ ਨੀਸਾਨਾ ॥",
      "transliteration": "likhat mitai nahee sabad neesaanaa ||",
      "translation": "Pre-ordained destiny cannot be erased; the Shabad is my banner and insignia.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਰਤਾ ਕਰਣਾ ਕਰਤਾ ਜਾਨਾ ॥੭॥",
      "transliteration": "karataa karanaa karataa jaanaa ||7||",
      "translation": "I know the Creator, the Creator of His Creation. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਹ ਪੰਡਿਤੁ ਨਹ ਚਤੁਰੁ ਸਿਆਨਾ ॥",
      "transliteration": "nah pa(n)dit nah chatur siaanaa ||",
      "translation": "I am not a learned Pandit, I am not clever or wise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਹ ਭੂਲੋ ਨਹ ਭਰਮਿ ਭੁਲਾਨਾ ॥",
      "transliteration": "nah bhoolo nah bharam bhulaanaa ||",
      "translation": "I do not wander; I am not deluded by doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਥਉ ਨ ਕਥਨੀ ਹੁਕਮੁ ਪਛਾਨਾ ॥",
      "transliteration": "kathau na kathanee hukam pachhaanaa ||",
      "translation": "I do not speak empty speech; I have recognized the Hukam of His Command.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮਤਿ ਸਹਜਿ ਸਮਾਨਾ ॥੮॥੧॥",
      "transliteration": "naanak guramat sahaj samaanaa ||8||1||",
      "translation": "Nanak is absorbed in intuitive peace through the Guru's Teachings. ||8||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee guaareree mahalaa 1 ||",
      "translation": "Gauree Gwaarayree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਨੁ ਕੁੰਚਰੁ ਕਾਇਆ ਉਦਿਆਨੈ ॥",
      "transliteration": "man ku(n)char kaaiaa udiaanai ||",
      "translation": "The mind is an elephant in the forest of the body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰੁ ਅੰਕਸੁ ਸਚੁ ਸਬਦੁ ਨੀਸਾਨੈ ॥",
      "transliteration": "gur a(n)kas sach sabad neesaanai ||",
      "translation": "The Guru is the controlling stick; when the Insignia of the True Shabad is applied,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਾਜ ਦੁਆਰੈ ਸੋਭ ਸੁ ਮਾਨੈ ॥੧॥",
      "transliteration": "raaj duaarai sobh s maanai ||1||",
      "translation": "One obtains honor in the Court of God the King. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚਤੁਰਾਈ ਨਹ ਚੀਨਿਆ ਜਾਇ ॥",
      "transliteration": "chaturaaee nah cheeniaa jaai ||",
      "translation": "He cannot be known through clever tricks.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਿਨੁ ਮਾਰੇ ਕਿਉ ਕੀਮਤਿ ਪਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin maare kiu keemat paai ||1|| rahaau ||",
      "translation": "Without subduing the mind, how can His value be estimated? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਘਰ ਮਹਿ ਅੰਮ੍ਰਿਤੁ ਤਸਕਰੁ ਲੇਈ ॥",
      "transliteration": "ghar mahi a(n)mrit tasakar leee ||",
      "translation": "In the house of the self is the Ambrosial Nectar, which is being stolen by the thieves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨੰਨਾਕਾਰੁ ਨ ਕੋਇ ਕਰੇਈ ॥",
      "transliteration": "na(n)naakaar na koi kareee ||",
      "translation": "No one can say no to them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਾਖੈ ਆਪਿ ਵਡਿਆਈ ਦੇਈ ॥੨॥",
      "transliteration": "raakhai aap vadiaaee deee ||2||",
      "translation": "He Himself protects us, and blesses us with greatness. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨੀਲ ਅਨੀਲ ਅਗਨਿ ਇਕ ਠਾਈ ॥",
      "transliteration": "neel aneel agan ik thaaee ||",
      "translation": "There are billions, countless billions of fires of desire at the seat of the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਲਿ ਨਿਵਰੀ ਗੁਰਿ ਬੂਝ ਬੁਝਾਈ ॥",
      "transliteration": "jal nivaree gur boojh bujhaaee ||",
      "translation": "They are extinguished only with the water of understanding, imparted by the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਨੁ ਦੇ ਲੀਆ ਰਹਸਿ ਗੁਣ ਗਾਈ ॥੩॥",
      "transliteration": "man de leeaa rahas gun gaaee ||3||",
      "translation": "Offering my mind, I have attained it, and I joyfully sing His Glorious Praises. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੈਸਾ ਘਰਿ ਬਾਹਰਿ ਸੋ ਤੈਸਾ ॥",
      "transliteration": "jaisaa ghar baahar so taisaa ||",
      "translation": "Just as He is within the home of the self, so is He beyond.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬੈਸਿ ਗੁਫਾ ਮਹਿ ਆਖਉ ਕੈਸਾ ॥",
      "transliteration": "bais guphaa mahi aakhau kaisaa ||",
      "translation": "But how can I describe Him, sitting in a cave?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਾਗਰਿ ਡੂਗਰਿ ਨਿਰਭਉ ਐਸਾ ॥੪॥",
      "transliteration": "saagar doogar nirabhau aisaa ||4||",
      "translation": "The Fearless Lord is in the oceans, just as He is in the mountains. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੂਏ ਕਉ ਕਹੁ ਮਾਰੇ ਕਉਨੁ ॥",
      "transliteration": "mooe kau kahu maare kaun ||",
      "translation": "Tell me, who can kill someone who is already dead?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਿਡਰੇ ਕਉ ਕੈਸਾ ਡਰੁ ਕਵਨੁ ॥",
      "transliteration": "nidare kau kaisaa dar kavan ||",
      "translation": "What does he fear? Who can frighten the fearless one?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਬਦਿ ਪਛਾਨੈ ਤੀਨੇ ਭਉਨ ॥੫॥",
      "transliteration": "sabad pachhaanai teene bhaun ||5||",
      "translation": "He recognizes the Word of the Shabad, throughout the three worlds. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਨਿ ਕਹਿਆ ਤਿਨਿ ਕਹਨੁ ਵਖਾਨਿਆ ॥",
      "transliteration": "jin kahiaa tin kahan vakhaaniaa ||",
      "translation": "One who speaks, merely describes speech.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਿਨਿ ਬੂਝਿਆ ਤਿਨਿ ਸਹਜਿ ਪਛਾਨਿਆ ॥",
      "transliteration": "jin boojhiaa tin sahaj pachhaaniaa ||",
      "translation": "But one who understands, intuitively realizes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਦੇਖਿ ਬੀਚਾਰਿ ਮੇਰਾ ਮਨੁ ਮਾਨਿਆ ॥੬॥",
      "transliteration": "dekh beechaar meraa man maaniaa ||6||",
      "translation": "Seeing and reflecting upon it, my mind surrenders. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕੀਰਤਿ ਸੂਰਤਿ ਮੁਕਤਿ ਇਕ ਨਾਈ ॥",
      "transliteration": "keerat soorat mukat ik naaee ||",
      "translation": "Praise, beauty and liberation are in the One Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਹੀ ਨਿਰੰਜਨੁ ਰਹਿਆ ਸਮਾਈ ॥",
      "transliteration": "tahee nira(n)jan rahiaa samaaee ||",
      "translation": "In it, the Immaculate Lord is permeating and pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਿਜ ਘਰਿ ਬਿਆਪਿ ਰਹਿਆ ਨਿਜ ਠਾਈ ॥੭॥",
      "transliteration": "nij ghar biaap rahiaa nij thaaee ||7||",
      "translation": "He dwells in the home of the self, and in His own sublime place. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0221_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਉਸਤਤਿ ਕਰਹਿ ਕੇਤੇ ਮੁਨਿ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "usatat karahi kete mun preet ||",
      "translation": "The many silent sages lovingly praise Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 221,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
