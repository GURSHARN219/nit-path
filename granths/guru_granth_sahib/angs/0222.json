{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 222,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0222_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਨਿ ਮਨਿ ਸੂਚੈ ਸਾਚੁ ਸੁ ਚੀਤਿ ॥",
      "transliteration": "tan man soochai saach s cheet ||",
      "translation": "Their bodies and minds are purified, as they enshrine the True Lord in their consciousness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਭਜੁ ਨੀਤਾ ਨੀਤਿ ॥੮॥੨॥",
      "transliteration": "naanak har bhaj neetaa neet ||8||2||",
      "translation": "O Nanak, meditate on the Lord, each and every day. ||8||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee guaareree mahalaa 1 ||",
      "translation": "Gauree Gwaarayree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾ ਮਨੁ ਮਰੈ ਨ ਕਾਰਜੁ ਹੋਇ ॥",
      "transliteration": "naa man marai na kaaraj hoi ||",
      "translation": "The mind does not die, so the job is not accomplished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਨੁ ਵਸਿ ਦੂਤਾ ਦੁਰਮਤਿ ਦੋਇ ॥",
      "transliteration": "man vas dootaa duramat doi ||",
      "translation": "The mind is under the power of the demons of evil intellect and duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਨੁ ਮਾਨੈ ਗੁਰ ਤੇ ਇਕੁ ਹੋਇ ॥੧॥",
      "transliteration": "man maanai gur te ik hoi ||1||",
      "translation": "But when the mind surrenders, through the Guru, it becomes one. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਿਰਗੁਣ ਰਾਮੁ ਗੁਣਹ ਵਸਿ ਹੋਇ ॥",
      "transliteration": "niragun raam gunah vas hoi ||",
      "translation": "The Lord is without attributes; the attributes of virtue are under His control.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਪੁ ਨਿਵਾਰਿ ਬੀਚਾਰੇ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aap nivaar beechaare soi ||1|| rahaau ||",
      "translation": "One who eliminates selfishness contemplates Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਨੁ ਭੂਲੋ ਬਹੁ ਚਿਤੈ ਵਿਕਾਰੁ ॥",
      "transliteration": "man bhoolo bahu chitai vikaar ||",
      "translation": "The deluded mind thinks of all sorts of corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨੁ ਭੂਲੋ ਸਿਰਿ ਆਵੈ ਭਾਰੁ ॥",
      "transliteration": "man bhoolo sir aavai bhaar ||",
      "translation": "When the mind is deluded, the load of wickedness falls on the head.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਨੁ ਮਾਨੈ ਹਰਿ ਏਕੰਕਾਰੁ ॥੨॥",
      "transliteration": "man maanai har eka(n)kaar ||2||",
      "translation": "But when the mind surrenders to the Lord, it realizes the One and Only Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਨੁ ਭੂਲੋ ਮਾਇਆ ਘਰਿ ਜਾਇ ॥",
      "transliteration": "man bhoolo maaiaa ghar jaai ||",
      "translation": "The deluded mind enters the house of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਾਮਿ ਬਿਰੂਧਉ ਰਹੈ ਨ ਠਾਇ ॥",
      "transliteration": "kaam biroodhau rahai na thaai ||",
      "translation": "Engrossed in sexual desire, it does not remain steady.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਰਿ ਭਜੁ ਪ੍ਰਾਣੀ ਰਸਨ ਰਸਾਇ ॥੩॥",
      "transliteration": "har bhaj praanee rasan rasaai ||3||",
      "translation": "O mortal, lovingly vibrate the Lord's Name with your tongue. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੈਵਰ ਹੈਵਰ ਕੰਚਨ ਸੁਤ ਨਾਰੀ ॥",
      "transliteration": "gaivar haivar ka(n)chan sut naaree ||",
      "translation": "Elephants, horses, gold, children and spouses",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁ ਚਿੰਤਾ ਪਿੜ ਚਾਲੈ ਹਾਰੀ ॥",
      "transliteration": "bahu chi(n)taa piR chaalai haaree ||",
      "translation": "in the anxious affairs of all these, people lose the game and depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੂਐ ਖੇਲਣੁ ਕਾਚੀ ਸਾਰੀ ॥੪॥",
      "transliteration": "jooai khelan kaachee saaree ||4||",
      "translation": "In the game of chess, their pieces do not reach their destination. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੰਪਉ ਸੰਚੀ ਭਏ ਵਿਕਾਰ ॥",
      "transliteration": "sa(n)pau sa(n)chee bhae vikaar ||",
      "translation": "They gather wealth, but only evil comes from it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਰਖ ਸੋਕ ਉਭੇ ਦਰਵਾਰਿ ॥",
      "transliteration": "harakh sok ubhe daravaar ||",
      "translation": "Pleasure and pain stand in the doorway.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਖੁ ਸਹਜੇ ਜਪਿ ਰਿਦੈ ਮੁਰਾਰਿ ॥੫॥",
      "transliteration": "sukh sahaje jap ridai muraar ||5||",
      "translation": "Intuitive peace comes by meditating on the Lord, within the heart. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਤਾ ਮੇਲਿ ਮਿਲਾਏ ॥",
      "transliteration": "nadar kare taa mel milaae ||",
      "translation": "When the Lord bestows His Glance of Grace, then He unites us in His Union.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਣ ਸੰਗ੍ਰਹਿ ਅਉਗਣ ਸਬਦਿ ਜਲਾਏ ॥",
      "transliteration": "gun sa(n)grahi augan sabad jalaae ||",
      "translation": "Through the Word of the Shabad, merits are gathered in, and demerits are burned away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਮੁ ਪਦਾਰਥੁ ਪਾਏ ॥੬॥",
      "transliteration": "guramukh naam padaarath paae ||6||",
      "translation": "The Gurmukh obtains the treasure of the Naam, the Name of the Lord. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਸਭ ਦੂਖ ਨਿਵਾਸੁ ॥",
      "transliteration": "bin naavai sabh dookh nivaas ||",
      "translation": "Without the Name, all live in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਨਮੁਖ ਮੂੜ ਮਾਇਆ ਚਿਤ ਵਾਸੁ ॥",
      "transliteration": "manamukh mooR maaiaa chit vaas ||",
      "translation": "The consciousness of the foolish, self-willed manmukh is the dwelling place of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਗਿਆਨੁ ਧੁਰਿ ਕਰਮਿ ਲਿਖਿਆਸੁ ॥੭॥",
      "transliteration": "guramukh giaan dhur karam likhiaas ||7||",
      "translation": "The Gurmukh obtains spiritual wisdom, according to pre-ordained destiny. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਨੁ ਚੰਚਲੁ ਧਾਵਤੁ ਫੁਨਿ ਧਾਵੈ ॥",
      "transliteration": "man cha(n)chal dhaavat phun dhaavai ||",
      "translation": "The fickle mind continuously runs after fleeting things.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਾਚੇ ਸੂਚੇ ਮੈਲੁ ਨ ਭਾਵੈ ॥",
      "transliteration": "saache sooche mail na bhaavai ||",
      "translation": "The Pure True Lord is not pleased by filth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਹਰਿ ਗੁਣ ਗਾਵੈ ॥੮॥੩॥",
      "transliteration": "naanak guramukh har gun gaavai ||8||3||",
      "translation": "O Nanak, the Gurmukh sings the Glorious Praises of the Lord. ||8||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗਉੜੀ ਗੁਆਰੇਰੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee guaareree mahalaa 1 ||",
      "translation": "Gauree Gwaarayree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਉਮੈ ਕਰਤਿਆ ਨਹ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "haumai karatiaa nah sukh hoi ||",
      "translation": "Acting in egotism, peace is not obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਨਮਤਿ ਝੂਠੀ ਸਚਾ ਸੋਇ ॥",
      "transliteration": "manamat jhoothee sachaa soi ||",
      "translation": "The intellect of the mind is false; only the Lord is True.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਗਲ ਬਿਗੂਤੇ ਭਾਵੈ ਦੋਇ ॥",
      "transliteration": "sagal bigoote bhaavai doi ||",
      "translation": "All who love duality are ruined.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੋ ਕਮਾਵੈ ਧੁਰਿ ਲਿਖਿਆ ਹੋਇ ॥੧॥",
      "transliteration": "so kamaavai dhur likhiaa hoi ||1||",
      "translation": "People act as they are pre-ordained. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਐਸਾ ਜਗੁ ਦੇਖਿਆ ਜੂਆਰੀ ॥",
      "transliteration": "aisaa jag dekhiaa jooaaree ||",
      "translation": "I have seen the world to be such a gambler;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਭਿ ਸੁਖ ਮਾਗੈ ਨਾਮੁ ਬਿਸਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sabh sukh maagai naam bisaaree ||1|| rahaau ||",
      "translation": "all beg for peace, but they forget the Naam, the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਦਿਸਟੁ ਦਿਸੈ ਤਾ ਕਹਿਆ ਜਾਇ ॥",
      "transliteration": "adisat disai taa kahiaa jaai ||",
      "translation": "If the Unseen Lord could be seen, then He could be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਿਨੁ ਦੇਖੇ ਕਹਣਾ ਬਿਰਥਾ ਜਾਇ ॥",
      "transliteration": "bin dekhe kahanaa birathaa jaai ||",
      "translation": "Without seeing Him, all descriptions are useless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਦੀਸੈ ਸਹਜਿ ਸੁਭਾਇ ॥",
      "transliteration": "guramukh deesai sahaj subhaai ||",
      "translation": "The Gurmukh sees Him with intuitive ease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੇਵਾ ਸੁਰਤਿ ਏਕ ਲਿਵ ਲਾਇ ॥੨॥",
      "transliteration": "sevaa surat ek liv laai ||2||",
      "translation": "So serve the One Lord, with loving awareness. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੁਖੁ ਮਾਂਗਤ ਦੁਖੁ ਆਗਲ ਹੋਇ ॥",
      "transliteration": "sukh maa(n)gat dukh aagal hoi ||",
      "translation": "People beg for peace, but they receive severe pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਗਲ ਵਿਕਾਰੀ ਹਾਰੁ ਪਰੋਇ ॥",
      "transliteration": "sagal vikaaree haar paroi ||",
      "translation": "They are all weaving a wreath of corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਏਕ ਬਿਨਾ ਝੂਠੇ ਮੁਕਤਿ ਨ ਹੋਇ ॥",
      "transliteration": "ek binaa jhoothe mukat na hoi ||",
      "translation": "You are false - without the One, there is no liberation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਰਿ ਕਰਿ ਕਰਤਾ ਦੇਖੈ ਸੋਇ ॥੩॥",
      "transliteration": "kar kar karataa dekhai soi ||3||",
      "translation": "The Creator created the creation, and He watches over it. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤ੍ਰਿਸਨਾ ਅਗਨਿ ਸਬਦਿ ਬੁਝਾਏ ॥",
      "transliteration": "trisanaa agan sabad bujhaae ||",
      "translation": "The fire of desire is quenched by the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੂਜਾ ਭਰਮੁ ਸਹਜਿ ਸੁਭਾਏ ॥",
      "transliteration": "doojaa bharam sahaj subhaae ||",
      "translation": "Duality and doubt are automatically eliminated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਰਮਤੀ ਨਾਮੁ ਰਿਦੈ ਵਸਾਏ ॥",
      "transliteration": "guramatee naam ridai vasaae ||",
      "translation": "Following the Guru's Teachings, the Naam abides in the heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਾਚੀ ਬਾਣੀ ਹਰਿ ਗੁਣ ਗਾਏ ॥੪॥",
      "transliteration": "saachee baanee har gun gaae ||4||",
      "translation": "Through the True Word of His Bani, sing the Glorious Praises of the Lord. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤਨ ਮਹਿ ਸਾਚੋ ਗੁਰਮੁਖਿ ਭਾਉ ॥",
      "transliteration": "tan mahi saacho guramukh bhaau ||",
      "translation": "The True Lord abides within the body of that Gurmukh who enshrines love for Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਨਾਹੀ ਨਿਜ ਠਾਉ ॥",
      "transliteration": "naam binaa naahee nij thaau ||",
      "translation": "Without the Naam, none obtain their own place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪ੍ਰੇਮ ਪਰਾਇਣ ਪ੍ਰੀਤਮ ਰਾਉ ॥",
      "transliteration": "prem paraain preetam raau ||",
      "translation": "The Beloved Lord King is dedicated to love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਤਾ ਬੂਝੈ ਨਾਉ ॥੫॥",
      "transliteration": "nadar kare taa boojhai naau ||5||",
      "translation": "If He bestows His Glance of Grace, then we realize His Name. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਾਇਆ ਮੋਹੁ ਸਰਬ ਜੰਜਾਲਾ ॥",
      "transliteration": "maaiaa mohu sarab ja(n)jaalaa ||",
      "translation": "Emotional attachment to Maya is total entanglement.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮਨਮੁਖ ਕੁਚੀਲ ਕੁਛਿਤ ਬਿਕਰਾਲਾ ॥",
      "transliteration": "manamukh kucheel kuchhit bikaraalaa ||",
      "translation": "The self-willed manmukh is filthy, cursed and dreadful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵੇ ਚੂਕੈ ਜੰਜਾਲਾ ॥",
      "transliteration": "satigur seve chookai ja(n)jaalaa ||",
      "translation": "Serving the True Guru, these entanglements are ended.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਸਦਾ ਸੁਖੁ ਨਾਲਾ ॥੬॥",
      "transliteration": "a(n)mrit naam sadaa sukh naalaa ||6||",
      "translation": "In the Ambrosial Nectar of the Naam, you shall abide in lasting peace. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਬੂਝੈ ਏਕ ਲਿਵ ਲਾਏ ॥",
      "transliteration": "guramukh boojhai ek liv laae ||",
      "translation": "The Gurmukhs understand the One Lord, and enshrine love for Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਨਿਜ ਘਰਿ ਵਾਸੈ ਸਾਚਿ ਸਮਾਏ ॥",
      "transliteration": "nij ghar vaasai saach samaae ||",
      "translation": "They dwell in the home of their own inner beings, and merge in the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜੰਮਣੁ ਮਰਣਾ ਠਾਕਿ ਰਹਾਏ ॥",
      "transliteration": "ja(n)man maranaa thaak rahaae ||",
      "translation": "The cycle of birth and death is ended.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਤੇ ਇਹ ਮਤਿ ਪਾਏ ॥੭॥",
      "transliteration": "poore gur te ih mat paae ||7||",
      "translation": "This understanding is obtained from the Perfect Guru. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0222_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਕਥਨੀ ਕਥਉ ਨ ਆਵੈ ਓਰੁ ॥",
      "transliteration": "kathanee kathau na aavai or ||",
      "translation": "Speaking the speech, there is no end to it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 222,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
