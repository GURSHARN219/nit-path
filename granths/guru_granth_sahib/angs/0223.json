{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 223,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0223_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੁਰੁ ਪੁਛਿ ਦੇਖਿਆ ਨਾਹੀ ਦਰੁ ਹੋਰੁ ॥",
      "transliteration": "gur puchh dekhiaa naahee dar hor ||",
      "translation": "I have consulted the Guru, and I have seen that there is no other door than His.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੁਖੁ ਸੁਖੁ ਭਾਣੈ ਤਿਸੈ ਰਜਾਇ ॥",
      "transliteration": "dukh sukh bhaanai tisai rajaai ||",
      "translation": "Pain and pleasure reside in the Pleasure of His Will and His Command.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਨਕੁ ਨੀਚੁ ਕਹੈ ਲਿਵ ਲਾਇ ॥੮॥੪॥",
      "transliteration": "naanak neech kahai liv laai ||8||4||",
      "translation": "Nanak, the lowly, says embrace love for the Lord. ||8||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੂਜੀ ਮਾਇਆ ਜਗਤ ਚਿਤ ਵਾਸੁ ॥",
      "transliteration": "doojee maaiaa jagat chit vaas ||",
      "translation": "The duality of Maya dwells in the consciousness of the people of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਅਹੰਕਾਰ ਬਿਨਾਸੁ ॥੧॥",
      "transliteration": "kaam krodh aha(n)kaar binaas ||1||",
      "translation": "They are destroyed by sexual desire, anger and egotism. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੂਜਾ ਕਉਣੁ ਕਹਾ ਨਹੀ ਕੋਈ ॥",
      "transliteration": "doojaa kaun kahaa nahee koee ||",
      "translation": "Whom should I call the second, when there is only the One?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਭ ਮਹਿ ਏਕੁ ਨਿਰੰਜਨੁ ਸੋਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sabh mahi ek nira(n)jan soee ||1|| rahaau ||",
      "translation": "The One Immaculate Lord is pervading among all. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੂਜੀ ਦੁਰਮਤਿ ਆਖੈ ਦੋਇ ॥",
      "transliteration": "doojee duramat aakhai doi ||",
      "translation": "The dual-minded evil intellect speaks of a second.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਵੈ ਜਾਇ ਮਰਿ ਦੂਜਾ ਹੋਇ ॥੨॥",
      "transliteration": "aavai jaai mar doojaa hoi ||2||",
      "translation": "One who harbors duality comes and goes and dies. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਧਰਣਿ ਗਗਨ ਨਹ ਦੇਖਉ ਦੋਇ ॥",
      "transliteration": "dharan gagan nah dekhau doi ||",
      "translation": "In the earth and in the sky, I do not see any second.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਰੀ ਪੁਰਖ ਸਬਾਈ ਲੋਇ ॥੩॥",
      "transliteration": "naaree purakh sabaaee loi ||3||",
      "translation": "Among all the women and the men, His Light is shining. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਵਿ ਸਸਿ ਦੇਖਉ ਦੀਪਕ ਉਜਿਆਲਾ ॥",
      "transliteration": "rav sas dekhau deepak ujiaalaa ||",
      "translation": "In the lamps of the sun and the moon, I see His Light.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਰਬ ਨਿਰੰਤਰਿ ਪ੍ਰੀਤਮੁ ਬਾਲਾ ॥੪॥",
      "transliteration": "sarab nira(n)tar preetam baalaa ||4||",
      "translation": "Dwelling among all is my ever-youthful Beloved. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਮੇਰਾ ਚਿਤੁ ਲਾਇਆ ॥",
      "transliteration": "kar kirapaa meraa chit laaiaa ||",
      "translation": "In His Mercy, He attuned my consciousness to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਮੋ ਕਉ ਏਕੁ ਬੁਝਾਇਆ ॥੫॥",
      "transliteration": "satigur mo kau ek bujhaaiaa ||5||",
      "translation": "The True Guru has led me to understand the One Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਏਕੁ ਨਿਰੰਜਨੁ ਗੁਰਮੁਖਿ ਜਾਤਾ ॥",
      "transliteration": "ek nira(n)jan guramukh jaataa ||",
      "translation": "The Gurmukh knows the One Immaculate Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੂਜਾ ਮਾਰਿ ਸਬਦਿ ਪਛਾਤਾ ॥੬॥",
      "transliteration": "doojaa maar sabad pachhaataa ||6||",
      "translation": "Subduing duality, one comes to realize the Word of the Shabad. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਏਕੋ ਹੁਕਮੁ ਵਰਤੈ ਸਭ ਲੋਈ ॥",
      "transliteration": "eko hukam varatai sabh loee ||",
      "translation": "The Command of the One Lord prevails throughout all the worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਏਕਸੁ ਤੇ ਸਭ ਓਪਤਿ ਹੋਈ ॥੭॥",
      "transliteration": "ekas te sabh opat hoee ||7||",
      "translation": "From the One, all have arisen. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਾਹ ਦੋਵੈ ਖਸਮੁ ਏਕੋ ਜਾਣੁ ॥",
      "transliteration": "raah dovai khasam eko jaan ||",
      "translation": "There are two routes, but remember that their Lord and Master is only One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਹੁਕਮੁ ਪਛਾਣੁ ॥੮॥",
      "transliteration": "gur kai sabad hukam pachhaan ||8||",
      "translation": "Through the Word of the Guru's Shabad, recognize the Hukam of the Lord's Command. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਗਲ ਰੂਪ ਵਰਨ ਮਨ ਮਾਹੀ ॥",
      "transliteration": "sagal roop varan man maahee ||",
      "translation": "He is contained in all forms, colors and minds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਏਕੋ ਸਾਲਾਹੀ ॥੯॥੫॥",
      "transliteration": "kahu naanak eko saalaahee ||9||5||",
      "translation": "Says Nanak, praise the One Lord. ||9||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਧਿਆਤਮ ਕਰਮ ਕਰੇ ਤਾ ਸਾਚਾ ॥",
      "transliteration": "adhiaatam karam kare taa saachaa ||",
      "translation": "Those who live a spiritual lifestyle - they alone are true.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮੁਕਤਿ ਭੇਦੁ ਕਿਆ ਜਾਣੈ ਕਾਚਾ ॥੧॥",
      "transliteration": "mukat bhed kiaa jaanai kaachaa ||1||",
      "translation": "What can the false know about the secrets of liberation? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਐਸਾ ਜੋਗੀ ਜੁਗਤਿ ਬੀਚਾਰੈ ॥",
      "transliteration": "aisaa jogee jugat beechaarai ||",
      "translation": "Those who contemplate the Way are Yogis.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪੰਚ ਮਾਰਿ ਸਾਚੁ ਉਰਿ ਧਾਰੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "pa(n)ch maar saach ur dhaarai ||1|| rahaau ||",
      "translation": "They conquer the five thieves, and enshrine the True Lord in the heart. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਸ ਕੈ ਅੰਤਰਿ ਸਾਚੁ ਵਸਾਵੈ ॥",
      "transliteration": "jis kai a(n)tar saach vasaavai ||",
      "translation": "Those who enshrine the True Lord deep within,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੋਗ ਜੁਗਤਿ ਕੀ ਕੀਮਤਿ ਪਾਵੈ ॥੨॥",
      "transliteration": "jog jugat kee keemat paavai ||2||",
      "translation": "realize the value of the Way of Yoga. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰਵਿ ਸਸਿ ਏਕੋ ਗ੍ਰਿਹ ਉਦਿਆਨੈ ॥",
      "transliteration": "rav sas eko grih udiaanai ||",
      "translation": "The sun and the moon are one and the same for them, as are household and wilderness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਰਣੀ ਕੀਰਤਿ ਕਰਮ ਸਮਾਨੈ ॥੩॥",
      "transliteration": "karanee keerat karam samaanai ||3||",
      "translation": "The karma of their daily practice is to praise the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਏਕ ਸਬਦ ਇਕ ਭਿਖਿਆ ਮਾਗੈ ॥",
      "transliteration": "ek sabad ik bhikhiaa maagai ||",
      "translation": "They beg for the alms of the one and only Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗਿਆਨੁ ਧਿਆਨੁ ਜੁਗਤਿ ਸਚੁ ਜਾਗੈ ॥੪॥",
      "transliteration": "giaan dhiaan jugat sach jaagai ||4||",
      "translation": "They remain awake and aware in spiritual wisdom and meditation, and the true way of life. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭੈ ਰਚਿ ਰਹੈ ਨ ਬਾਹਰਿ ਜਾਇ ॥",
      "transliteration": "bhai rach rahai na baahar jaai ||",
      "translation": "They remain absorbed in the fear of God; they never leave it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕੀਮਤਿ ਕਉਣ ਰਹੈ ਲਿਵ ਲਾਇ ॥੫॥",
      "transliteration": "keemat kaun rahai liv laai ||5||",
      "translation": "Who can estimate their value? They remain lovingly absorbed in the Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਪੇ ਮੇਲੇ ਭਰਮੁ ਚੁਕਾਏ ॥",
      "transliteration": "aape mele bharam chukaae ||",
      "translation": "The Lord unites them with Himself, dispelling their doubts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਪਰਮ ਪਦੁ ਪਾਏ ॥੬॥",
      "transliteration": "gur parasaad param pad paae ||6||",
      "translation": "By Guru's Grace, the supreme status is obtained. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਰ ਕੀ ਸੇਵਾ ਸਬਦੁ ਵੀਚਾਰੁ ॥",
      "transliteration": "gur kee sevaa sabad veechaar ||",
      "translation": "In the Guru's service is reflection upon the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਉਮੈ ਮਾਰੇ ਕਰਣੀ ਸਾਰੁ ॥੭॥",
      "transliteration": "haumai maare karanee saar ||7||",
      "translation": "Subduing ego, practice pure actions. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਪ ਤਪ ਸੰਜਮ ਪਾਠ ਪੁਰਾਣੁ ॥",
      "transliteration": "jap tap sa(n)jam paath puraan ||",
      "translation": "Chanting, meditation, austere self-discipline and the reading of the Puraanas,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਅਪਰੰਪਰ ਮਾਨੁ ॥੮॥੬॥",
      "transliteration": "kahu naanak apara(n)par maan ||8||6||",
      "translation": "says Nanak, are contained in surrender to the Unlimited Lord. ||8||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਖਿਮਾ ਗਹੀ ਬ੍ਰਤੁ ਸੀਲ ਸੰਤੋਖੰ ॥",
      "transliteration": "khimaa gahee brat seel sa(n)tokha(n) ||",
      "translation": "To practice forgiveness is the true fast, good conduct and contentment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰੋਗੁ ਨ ਬਿਆਪੈ ਨਾ ਜਮ ਦੋਖੰ ॥",
      "transliteration": "rog na biaapai naa jam dokha(n) ||",
      "translation": "Disease does not afflict me, nor does the pain of death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੁਕਤ ਭਏ ਪ੍ਰਭ ਰੂਪ ਨ ਰੇਖੰ ॥੧॥",
      "transliteration": "mukat bhae prabh roop na rekha(n) ||1||",
      "translation": "I am liberated, and absorbed into God, who has no form or feature. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜੋਗੀ ਕਉ ਕੈਸਾ ਡਰੁ ਹੋਇ ॥",
      "transliteration": "jogee kau kaisaa dar hoi ||",
      "translation": "What fear does the Yogi have?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਰੂਖਿ ਬਿਰਖਿ ਗ੍ਰਿਹਿ ਬਾਹਰਿ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "rookh birakh grihi baahar soi ||1|| rahaau ||",
      "translation": "The Lord is among the trees and the plants, within the household and outside as well. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਿਰਭਉ ਜੋਗੀ ਨਿਰੰਜਨੁ ਧਿਆਵੈ ॥",
      "transliteration": "nirabhau jogee nira(n)jan dhiaavai ||",
      "translation": "The Yogis meditate on the Fearless, Immaculate Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਨਦਿਨੁ ਜਾਗੈ ਸਚਿ ਲਿਵ ਲਾਵੈ ॥",
      "transliteration": "anadin jaagai sach liv laavai ||",
      "translation": "Night and day, they remain awake and aware, embracing love for the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੋ ਜੋਗੀ ਮੇਰੈ ਮਨਿ ਭਾਵੈ ॥੨॥",
      "transliteration": "so jogee merai man bhaavai ||2||",
      "translation": "Those Yogis are pleasing to my mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਾਲੁ ਜਾਲੁ ਬ੍ਰਹਮ ਅਗਨੀ ਜਾਰੇ ॥",
      "transliteration": "kaal jaal braham aganee jaare ||",
      "translation": "The trap of death is burnt by the Fire of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਰਾ ਮਰਣ ਗਤੁ ਗਰਬੁ ਨਿਵਾਰੇ ॥",
      "transliteration": "jaraa maran gat garab nivaare ||",
      "translation": "Old age, death and pride are conquered.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਆਪਿ ਤਰੈ ਪਿਤਰੀ ਨਿਸਤਾਰੇ ॥੩॥",
      "transliteration": "aap tarai pitaree nisataare ||3||",
      "translation": "They swim across, and save their ancestors as well. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵੇ ਸੋ ਜੋਗੀ ਹੋਇ ॥",
      "transliteration": "satigur seve so jogee hoi ||",
      "translation": "Those who serve the True Guru are the Yogis.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਭੈ ਰਚਿ ਰਹੈ ਸੁ ਨਿਰਭਉ ਹੋਇ ॥",
      "transliteration": "bhai rach rahai s nirabhau hoi ||",
      "translation": "Those who remain immersed in the Fear of God become fearless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0223_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜੈਸਾ ਸੇਵੈ ਤੈਸੋ ਹੋਇ ॥੪॥",
      "transliteration": "jaisaa sevai taiso hoi ||4||",
      "translation": "They become just like the One they serve. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 223,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
