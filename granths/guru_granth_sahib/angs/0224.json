{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 224,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0224_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਰ ਨਿਹਕੇਵਲ ਨਿਰਭਉ ਨਾਉ ॥",
      "transliteration": "nar nihakeval nirabhau naau ||",
      "translation": "The Name makes a man pure and fearless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਨਾਥਹ ਨਾਥ ਕਰੇ ਬਲਿ ਜਾਉ ॥",
      "transliteration": "anaathah naath kare bal jaau ||",
      "translation": "It makes the masterless become the master of all. I am a sacrifice to him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪੁਨਰਪਿ ਜਨਮੁ ਨਾਹੀ ਗੁਣ ਗਾਉ ॥੫॥",
      "transliteration": "punarap janam naahee gun gaau ||5||",
      "translation": "Such a person is not reincarnated again; he sings the Glories of God. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅੰਤਰਿ ਬਾਹਰਿ ਏਕੋ ਜਾਣੈ ॥",
      "transliteration": "a(n)tar baahar eko jaanai ||",
      "translation": "Inwardly and outwardly, he knows the One Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦੇ ਆਪੁ ਪਛਾਣੈ ॥",
      "transliteration": "gur kai sabade aap pachhaanai ||",
      "translation": "through the Word of the Guru's Shabad, he realizes himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਾਚੈ ਸਬਦਿ ਦਰਿ ਨੀਸਾਣੈ ॥੬॥",
      "transliteration": "saachai sabad dar neesaanai ||6||",
      "translation": "He bears the Banner and Insignia of the True Shabad in the Lord's Court. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਬਦਿ ਮਰੈ ਤਿਸੁ ਨਿਜ ਘਰਿ ਵਾਸਾ ॥",
      "transliteration": "sabad marai tis nij ghar vaasaa ||",
      "translation": "One who dies in the Shabad abides in his own home within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਵੈ ਨ ਜਾਵੈ ਚੂਕੈ ਆਸਾ ॥",
      "transliteration": "aavai na jaavai chookai aasaa ||",
      "translation": "He does not come or go in reincarnation, and his hopes are subdued.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਕਮਲੁ ਪਰਗਾਸਾ ॥੭॥",
      "transliteration": "gur kai sabad kamal paragaasaa ||7||",
      "translation": "Through the Word of the Guru's Shabad, his heart-lotus blossoms forth. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੋ ਦੀਸੈ ਸੋ ਆਸ ਨਿਰਾਸਾ ॥",
      "transliteration": "jo deesai so aas niraasaa ||",
      "translation": "Whoever is seen, is driven by hope and despair,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਬਿਖੁ ਭੂਖ ਪਿਆਸਾ ॥",
      "transliteration": "kaam krodh bikh bhookh piaasaa ||",
      "translation": "by sexual desire, anger, corruption, hunger and thirst.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਨਕ ਬਿਰਲੇ ਮਿਲਹਿ ਉਦਾਸਾ ॥੮॥੭॥",
      "transliteration": "naanak birale milahi udaasaa ||8||7||",
      "translation": "O Nanak, those detached recluses who meet the Lord are so very rare. ||8||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਐਸੋ ਦਾਸੁ ਮਿਲੈ ਸੁਖੁ ਹੋਈ ॥",
      "transliteration": "aiso daas milai sukh hoee ||",
      "translation": "Meeting such a slave, peace is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੁਖੁ ਵਿਸਰੈ ਪਾਵੈ ਸਚੁ ਸੋਈ ॥੧॥",
      "transliteration": "dukh visarai paavai sach soee ||1||",
      "translation": "Pain is forgotten, when the True Lord is found. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦਰਸਨੁ ਦੇਖਿ ਭਈ ਮਤਿ ਪੂਰੀ ॥",
      "transliteration": "darasan dekh bhaee mat pooree ||",
      "translation": "Beholding the blessed vision of his darshan, my understanding has become perfect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਠਸਠਿ ਮਜਨੁ ਚਰਨਹ ਧੂਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "athasath majan charanah dhooree ||1|| rahaau ||",
      "translation": "The cleansing baths at the sixty-eight sacred shrines of pilgrimage are in the dust of his feet. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨੇਤ੍ਰ ਸੰਤੋਖੇ ਏਕ ਲਿਵ ਤਾਰਾ ॥",
      "transliteration": "netr sa(n)tokhe ek liv taaraa ||",
      "translation": "My eyes are contented with the constant love of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਹਵਾ ਸੂਚੀ ਹਰਿ ਰਸ ਸਾਰਾ ॥੨॥",
      "transliteration": "jihavaa soochee har ras saaraa ||2||",
      "translation": "My tongue is purified by the most sublime essence of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਚੁ ਕਰਣੀ ਅਭ ਅੰਤਰਿ ਸੇਵਾ ॥",
      "transliteration": "sach karanee abh a(n)tar sevaa ||",
      "translation": "True are my actions, and deep within my being, I serve Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਨੁ ਤ੍ਰਿਪਤਾਸਿਆ ਅਲਖ ਅਭੇਵਾ ॥੩॥",
      "transliteration": "man tripataasiaa alakh abhevaa ||3||",
      "translation": "My mind is satisfied by the Inscrutable, Mysterious Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਹ ਜਹ ਦੇਖਉ ਤਹ ਤਹ ਸਾਚਾ ॥",
      "transliteration": "jah jah dekhau tah tah saachaa ||",
      "translation": "Wherever I look, there I find the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਿਨੁ ਬੂਝੇ ਝਗਰਤ ਜਗੁ ਕਾਚਾ ॥੪॥",
      "transliteration": "bin boojhe jhagarat jag kaachaa ||4||",
      "translation": "Without understanding, the world argues in falsehood. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਰੁ ਸਮਝਾਵੈ ਸੋਝੀ ਹੋਈ ॥",
      "transliteration": "gur samajhaavai sojhee hoee ||",
      "translation": "When the Guru instructs, understanding is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਵਿਰਲਾ ਬੂਝੈ ਕੋਈ ॥੫॥",
      "transliteration": "guramukh viralaa boojhai koee ||5||",
      "translation": "How rare is that Gurmukh who understands. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਰਾਖਹੁ ਰਖਵਾਲੇ ॥",
      "transliteration": "kar kirapaa raakhahu rakhavaale ||",
      "translation": "Show Your Mercy, and save me, O Savior Lord!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਿਨੁ ਬੂਝੇ ਪਸੂ ਭਏ ਬੇਤਾਲੇ ॥੬॥",
      "transliteration": "bin boojhe pasoo bhae betaale ||6||",
      "translation": "Without understanding, people become beasts and demons. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੁਰਿ ਕਹਿਆ ਅਵਰੁ ਨਹੀ ਦੂਜਾ ॥",
      "transliteration": "gur kahiaa avar nahee doojaa ||",
      "translation": "The Guru has said that there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਿਸੁ ਕਹੁ ਦੇਖਿ ਕਰਉ ਅਨ ਪੂਜਾ ॥੭॥",
      "transliteration": "kis kahu dekh karau an poojaa ||7||",
      "translation": "So tell me, who should I see, and who should I worship? ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੰਤ ਹੇਤਿ ਪ੍ਰਭਿ ਤ੍ਰਿਭਵਣ ਧਾਰੇ ॥",
      "transliteration": "sa(n)t het prabh tribhavan dhaare ||",
      "translation": "For the sake of the Saints, God has established the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਤਮੁ ਚੀਨੈ ਸੁ ਤਤੁ ਬੀਚਾਰੇ ॥੮॥",
      "transliteration": "aatam cheenai s tat beechaare ||8||",
      "translation": "One who understands his own soul, contemplates the essence of reality. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਾਚੁ ਰਿਦੈ ਸਚੁ ਪ੍ਰੇਮ ਨਿਵਾਸ ॥",
      "transliteration": "saach ridai sach prem nivaas ||",
      "translation": "One whose heart is filled with Truth and true love",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪ੍ਰਣਵਤਿ ਨਾਨਕ ਹਮ ਤਾ ਕੇ ਦਾਸ ॥੯॥੮॥",
      "transliteration": "pranavat naanak ham taa ke daas ||9||8||",
      "translation": "- prays Nanak, I am his servant. ||9||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬ੍ਰਹਮੈ ਗਰਬੁ ਕੀਆ ਨਹੀ ਜਾਨਿਆ ॥",
      "transliteration": "brahamai garab keeaa nahee jaaniaa ||",
      "translation": "Brahma acted in pride, and did not understand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬੇਦ ਕੀ ਬਿਪਤਿ ਪੜੀ ਪਛੁਤਾਨਿਆ ॥",
      "transliteration": "bed kee bipat paRee pachhutaaniaa ||",
      "translation": "Only when he was faced with the downfall of the Vedas did he repent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਹ ਪ੍ਰਭ ਸਿਮਰੇ ਤਹੀ ਮਨੁ ਮਾਨਿਆ ॥੧॥",
      "transliteration": "jah prabh simare tahee man maaniaa ||1||",
      "translation": "Remembering God in meditation, the mind is conciliated. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਐਸਾ ਗਰਬੁ ਬੁਰਾ ਸੰਸਾਰੈ ॥",
      "transliteration": "aisaa garab buraa sa(n)saarai ||",
      "translation": "Such is the horrible pride of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਿਸੁ ਗੁਰੁ ਮਿਲੈ ਤਿਸੁ ਗਰਬੁ ਨਿਵਾਰੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jis gur milai tis garab nivaarai ||1|| rahaau ||",
      "translation": "The Guru eliminates the pride of those who meet Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਲਿ ਰਾਜਾ ਮਾਇਆ ਅਹੰਕਾਰੀ ॥",
      "transliteration": "bal raajaa maaiaa aha(n)kaaree ||",
      "translation": "Bal the King, in Maya and egotism,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਗਨ ਕਰੈ ਬਹੁ ਭਾਰ ਅਫਾਰੀ ॥",
      "transliteration": "jagan karai bahu bhaar aphaaree ||",
      "translation": "held his ceremonial feasts, but he was puffed up with pride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਪੂਛੇ ਜਾਇ ਪਇਆਰੀ ॥੨॥",
      "transliteration": "bin gur poochhe jaai paiaaree ||2||",
      "translation": "Without the Guru's advice, he had to go to the underworld. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਰੀਚੰਦੁ ਦਾਨੁ ਕਰੈ ਜਸੁ ਲੇਵੈ ॥",
      "transliteration": "hareecha(n)d daan karai jas levai ||",
      "translation": "Hari Chand gave in charity, and earned public praise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਅੰਤੁ ਨ ਪਾਇ ਅਭੇਵੈ ॥",
      "transliteration": "bin gur a(n)t na paai abhevai ||",
      "translation": "But without the Guru, he did not find the limits of the Mysterious Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਪਿ ਭੁਲਾਇ ਆਪੇ ਮਤਿ ਦੇਵੈ ॥੩॥",
      "transliteration": "aap bhulaai aape mat devai ||3||",
      "translation": "The Lord Himself misleads people, and He Himself imparts understanding. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੁਰਮਤਿ ਹਰਣਾਖਸੁ ਦੁਰਾਚਾਰੀ ॥",
      "transliteration": "duramat haranaakhas duraachaaree ||",
      "translation": "The evil-minded Harnaakhash committed evil deeds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰਭੁ ਨਾਰਾਇਣੁ ਗਰਬ ਪ੍ਰਹਾਰੀ ॥",
      "transliteration": "prabh naaraain garab prahaaree ||",
      "translation": "God, the Lord of all, is the Destroyer of pride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪ੍ਰਹਲਾਦ ਉਧਾਰੇ ਕਿਰਪਾ ਧਾਰੀ ॥੪॥",
      "transliteration": "prahalaad udhaare kirapaa dhaaree ||4||",
      "translation": "He bestowed His Mercy, and saved Prahlaad. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਭੂਲੋ ਰਾਵਣੁ ਮੁਗਧੁ ਅਚੇਤਿ ॥",
      "transliteration": "bhoolo raavan mugadh achet ||",
      "translation": "Raawan was deluded, foolish and unwise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਲੂਟੀ ਲੰਕਾ ਸੀਸ ਸਮੇਤਿ ॥",
      "transliteration": "lootee la(n)kaa sees samet ||",
      "translation": "Sri Lanka was plundered, and he lost his head.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗਰਬਿ ਗਇਆ ਬਿਨੁ ਸਤਿਗੁਰ ਹੇਤਿ ॥੫॥",
      "transliteration": "garab gaiaa bin satigur het ||5||",
      "translation": "He indulged in ego, and lacked the love of the True Guru. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਹਸਬਾਹੁ ਮਧੁ ਕੀਟ ਮਹਿਖਾਸਾ ॥",
      "transliteration": "sahasabaahu madh keet mahikhaasaa ||",
      "translation": "The Lord killed the thousand-armed Arjun, and the demons Madhu-keetab and Meh-khaasaa.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਹਰਣਾਖਸੁ ਲੇ ਨਖਹੁ ਬਿਧਾਸਾ ॥",
      "transliteration": "haranaakhas le nakhahu bidhaasaa ||",
      "translation": "He seized Harnaakhash and tore him apart with his nails.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਦੈਤ ਸੰਘਾਰੇ ਬਿਨੁ ਭਗਤਿ ਅਭਿਆਸਾ ॥੬॥",
      "transliteration": "dait sa(n)ghaare bin bhagat abhiaasaa ||6||",
      "translation": "The demons were slain; they did not practice devotional worship. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਰਾਸੰਧਿ ਕਾਲਜਮੁਨ ਸੰਘਾਰੇ ॥",
      "transliteration": "jaraasa(n)dh kaalajamun sa(n)ghaare ||",
      "translation": "The demons Jaraa-sandh and Kaal-jamun were destroyed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਰਕਤਬੀਜੁ ਕਾਲੁਨੇਮੁ ਬਿਦਾਰੇ ॥",
      "transliteration": "rakatabeej kaalunem bidaare ||",
      "translation": "Rakat-beej and Kaal-naym were annihilated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਦੈਤ ਸੰਘਾਰਿ ਸੰਤ ਨਿਸਤਾਰੇ ॥੭॥",
      "transliteration": "dait sa(n)ghaar sa(n)t nisataare ||7||",
      "translation": "Slaying the demons, the Lord saved His Saints. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0224_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਆਪੇ ਸਤਿਗੁਰੁ ਸਬਦੁ ਬੀਚਾਰੇ ॥",
      "transliteration": "aape satigur sabad beechaare ||",
      "translation": "He Himself, as the True Guru, contemplates the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 224,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
