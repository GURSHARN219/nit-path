{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 225,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0225_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੂਜੈ ਭਾਇ ਦੈਤ ਸੰਘਾਰੇ ॥",
      "transliteration": "doojai bhaai dait sa(n)ghaare ||",
      "translation": "Because of the love of duality, God killed the demons.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਚਿ ਭਗਤਿ ਨਿਸਤਾਰੇ ॥੮॥",
      "transliteration": "guramukh saach bhagat nisataare ||8||",
      "translation": "By their true devotion, the Gurmukhs have been saved. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬੂਡਾ ਦੁਰਜੋਧਨੁ ਪਤਿ ਖੋਈ ॥",
      "transliteration": "boodaa durajodhan pat khoee ||",
      "translation": "Sinking down, Durodhan lost his honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਾਮੁ ਨ ਜਾਨਿਆ ਕਰਤਾ ਸੋਈ ॥",
      "transliteration": "raam na jaaniaa karataa soee ||",
      "translation": "He did not know the Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਨ ਕਉ ਦੂਖਿ ਪਚੈ ਦੁਖੁ ਹੋਈ ॥੯॥",
      "transliteration": "jan kau dookh pachai dukh hoee ||9||",
      "translation": "One who makes the Lord's humble servant suffer, shall himself suffer and rot. ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਨਮੇਜੈ ਗੁਰਸਬਦੁ ਨ ਜਾਨਿਆ ॥",
      "transliteration": "janamejai gurasabad na jaaniaa ||",
      "translation": "Janameja did not know the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿਉ ਸੁਖੁ ਪਾਵੈ ਭਰਮਿ ਭੁਲਾਨਿਆ ॥",
      "transliteration": "kiu sukh paavai bharam bhulaaniaa ||",
      "translation": "Deluded by doubt, how could he find peace?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਕੁ ਤਿਲੁ ਭੂਲੇ ਬਹੁਰਿ ਪਛੁਤਾਨਿਆ ॥੧੦॥",
      "transliteration": "ik til bhoole bahur pachhutaaniaa ||10||",
      "translation": "Making a mistake, for even an instant, you shall regret and repent later on. ||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕੰਸੁ ਕੇਸੁ ਚਾਂਡੂਰੁ ਨ ਕੋਈ ॥",
      "transliteration": "ka(n)s kes chaa(n)door na koee ||",
      "translation": "Kansa the King and his warriors Kays and Chandoor had no equals.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਾਮੁ ਨ ਚੀਨਿਆ ਅਪਨੀ ਪਤਿ ਖੋਈ ॥",
      "transliteration": "raam na cheeniaa apanee pat khoee ||",
      "translation": "But they did not remember the Lord, and they lost their honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਨੁ ਜਗਦੀਸ ਨ ਰਾਖੈ ਕੋਈ ॥੧੧॥",
      "transliteration": "bin jagadees na raakhai koee ||11||",
      "translation": "Without the Lord of the Universe, no one can be saved. ||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਗਰਬੁ ਨ ਮੇਟਿਆ ਜਾਇ ॥",
      "transliteration": "bin gur garab na metiaa jaai ||",
      "translation": "Without the Guru, pride cannot be eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੁਰਮਤਿ ਧਰਮੁ ਧੀਰਜੁ ਹਰਿ ਨਾਇ ॥",
      "transliteration": "guramat dharam dheeraj har naai ||",
      "translation": "Following the Guru's Teachings, one obtains Dharmic faith, composure and the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਮਿਲੈ ਗੁਣ ਗਾਇ ॥੧੨॥੯॥",
      "transliteration": "naanak naam milai gun gaai ||12||9||",
      "translation": "O Nanak, singing the Glories of God, His Name is received. ||12||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚੋਆ ਚੰਦਨੁ ਅੰਕਿ ਚੜਾਵਉ ॥",
      "transliteration": "choaa cha(n)dan a(n)k chaRaavau ||",
      "translation": "I may anoint my limbs with sandalwood oil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪਾਟ ਪਟੰਬਰ ਪਹਿਰਿ ਹਢਾਵਉ ॥",
      "transliteration": "paat pata(n)bar pahir hadhaavau ||",
      "translation": "I may dress up and wear silk and satin clothes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਨਾਮ ਕਹਾ ਸੁਖੁ ਪਾਵਉ ॥੧॥",
      "transliteration": "bin har naam kahaa sukh paavau ||1||",
      "translation": "But without the Lord's Name, where would I find peace? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿਆ ਪਹਿਰਉ ਕਿਆ ਓਢਿ ਦਿਖਾਵਉ ॥",
      "transliteration": "kiaa pahirau kiaa odh dikhaavau ||",
      "translation": "So what should I wear? In what clothes should I display myself?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਨੁ ਜਗਦੀਸ ਕਹਾ ਸੁਖੁ ਪਾਵਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin jagadees kahaa sukh paavau ||1|| rahaau ||",
      "translation": "Without the Lord of the Universe, how can I find peace? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਾਨੀ ਕੁੰਡਲ ਗਲਿ ਮੋਤੀਅਨ ਕੀ ਮਾਲਾ ॥",
      "transliteration": "kaanee ku(n)dal gal moteean kee maalaa ||",
      "translation": "I may wear ear-rings, and a pearl necklace around my neck;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਲਾਲ ਨਿਹਾਲੀ ਫੂਲ ਗੁਲਾਲਾ ॥",
      "transliteration": "laal nihaalee phool gulaalaa ||",
      "translation": "my bed may be adorned with red blankets, flowers and red powder;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਿਨੁ ਜਗਦੀਸ ਕਹਾ ਸੁਖੁ ਭਾਲਾ ॥੨॥",
      "transliteration": "bin jagadees kahaa sukh bhaalaa ||2||",
      "translation": "but without the Lord of the Universe, where can I search for peace? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨੈਨ ਸਲੋਨੀ ਸੁੰਦਰ ਨਾਰੀ ॥",
      "transliteration": "nain salonee su(n)dar naaree ||",
      "translation": "I may have a beautiful woman with fascinating eyes;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਖੋੜ ਸੀਗਾਰ ਕਰੈ ਅਤਿ ਪਿਆਰੀ ॥",
      "transliteration": "khoR seegaar karai at piaaree ||",
      "translation": "she may decorate herself with the sixteen adornments, and make herself appear gorgeous.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਿਨੁ ਜਗਦੀਸ ਭਜੇ ਨਿਤ ਖੁਆਰੀ ॥੩॥",
      "transliteration": "bin jagadees bhaje nit khuaaree ||3||",
      "translation": "But without meditating on the Lord of the Universe, there is only continual suffering. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦਰ ਘਰ ਮਹਲਾ ਸੇਜ ਸੁਖਾਲੀ ॥",
      "transliteration": "dar ghar mahalaa sej sukhaalee ||",
      "translation": "In his hearth and home, in his palace, upon his soft and comfortable bed,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਫੂਲ ਬਿਛਾਵੈ ਮਾਲੀ ॥",
      "transliteration": "ahinis phool bichhaavai maalee ||",
      "translation": "day and night, the flower-girls scatter flower petals;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਨਾਮ ਸੁ ਦੇਹ ਦੁਖਾਲੀ ॥੪॥",
      "transliteration": "bin har naam s deh dukhaalee ||4||",
      "translation": "but without the Lord's Name, the body is miserable. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹੈਵਰ ਗੈਵਰ ਨੇਜੇ ਵਾਜੇ ॥",
      "transliteration": "haivar gaivar neje vaaje ||",
      "translation": "Horses, elephants, lances, marching bands,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਲਸਕਰ ਨੇਬ ਖਵਾਸੀ ਪਾਜੇ ॥",
      "transliteration": "lasakar neb khavaasee paaje ||",
      "translation": "armies, standard bearers, royal attendants and ostentatious displays",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਿਨੁ ਜਗਦੀਸ ਝੂਠੇ ਦਿਵਾਜੇ ॥੫॥",
      "transliteration": "bin jagadees jhoothe divaaje ||5||",
      "translation": "- without the Lord of the Universe, these undertakings are all useless. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਿਧੁ ਕਹਾਵਉ ਰਿਧਿ ਸਿਧਿ ਬੁਲਾਵਉ ॥",
      "transliteration": "sidh kahaavau ridh sidh bulaavau ||",
      "translation": "He may be called a Siddha, a man of spiritual perfection, and he may summon riches and supernatural powers;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾਜ ਕੁਲਹ ਸਿਰਿ ਛਤ੍ਰੁ ਬਨਾਵਉ ॥",
      "transliteration": "taaj kulah sir chhatr banaavau ||",
      "translation": "he may place a crown upon his head, and carry a royal umbrella;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਿਨੁ ਜਗਦੀਸ ਕਹਾ ਸਚੁ ਪਾਵਉ ॥੬॥",
      "transliteration": "bin jagadees kahaa sach paavau ||6||",
      "translation": "but without the Lord of the Universe, where can Truth be found? ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਖਾਨੁ ਮਲੂਕੁ ਕਹਾਵਉ ਰਾਜਾ ॥",
      "transliteration": "khaan malook kahaavau raajaa ||",
      "translation": "He may be called an emperor, a lord, and a king;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਬੇ ਤਬੇ ਕੂੜੇ ਹੈ ਪਾਜਾ ॥",
      "transliteration": "abe tabe kooRe hai paajaa ||",
      "translation": "he may give orders - \"Do this now, do this then\" - but this is a false display.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਿਨੁ ਗੁਰਸਬਦ ਨ ਸਵਰਸਿ ਕਾਜਾ ॥੭॥",
      "transliteration": "bin gurasabad na savaras kaajaa ||7||",
      "translation": "Without the Word of the Guru's Shabad, his works are not accomplished. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਉਮੈ ਮਮਤਾ ਗੁਰ ਸਬਦਿ ਵਿਸਾਰੀ ॥",
      "transliteration": "haumai mamataa gur sabad visaaree ||",
      "translation": "Egotism and possessiveness are dispelled by the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਰਮਤਿ ਜਾਨਿਆ ਰਿਦੈ ਮੁਰਾਰੀ ॥",
      "transliteration": "guramat jaaniaa ridai muraaree ||",
      "translation": "With the Guru's Teachings in my heart, I have come to know the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰਣਵਤਿ ਨਾਨਕ ਸਰਣਿ ਤੁਮਾਰੀ ॥੮॥੧੦॥",
      "transliteration": "pranavat naanak saran tumaaree ||8||10||",
      "translation": "Prays Nanak, I seek Your Sanctuary. ||8||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੇਵਾ ਏਕ ਨ ਜਾਨਸਿ ਅਵਰੇ ॥",
      "transliteration": "sevaa ek na jaanas avare ||",
      "translation": "Those who serve the One Lord, do not know any other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਰਪੰਚ ਬਿਆਧਿ ਤਿਆਗੈ ਕਵਰੇ ॥",
      "transliteration": "parapa(n)ch biaadh tiaagai kavare ||",
      "translation": "They abandon the bitter worldly conflicts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਾਇ ਮਿਲੈ ਸਚੁ ਸਾਚੈ ਸਚੁ ਰੇ ॥੧॥",
      "transliteration": "bhaai milai sach saachai sach re ||1||",
      "translation": "Through love and truth, they meet the Truest of the True. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਐਸਾ ਰਾਮ ਭਗਤੁ ਜਨੁ ਹੋਈ ॥",
      "transliteration": "aisaa raam bhagat jan hoee ||",
      "translation": "Such are the humble devotees of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਗਾਇ ਮਿਲੈ ਮਲੁ ਧੋਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har gun gaai milai mal dhoee ||1|| rahaau ||",
      "translation": "They sing the Glorious Praises of the Lord, and their pollution is washed away. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਊਂਧੋ ਕਵਲੁ ਸਗਲ ਸੰਸਾਰੈ ॥",
      "transliteration": "oo(n)dho kaval sagal sa(n)saarai ||",
      "translation": "The heart-lotus of the entire universe is upside-down.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਦੁਰਮਤਿ ਅਗਨਿ ਜਗਤ ਪਰਜਾਰੈ ॥",
      "transliteration": "duramat agan jagat parajaarai ||",
      "translation": "The fire of evil-mindedness is burning up the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੋ ਉਬਰੈ ਗੁਰਸਬਦੁ ਬੀਚਾਰੈ ॥੨॥",
      "transliteration": "so ubarai gurasabad beechaarai ||2||",
      "translation": "They alone are saved, who contemplate the Word of the Guru's Shabad. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਭ੍ਰਿੰਗ ਪਤੰਗੁ ਕੁੰਚਰੁ ਅਰੁ ਮੀਨਾ ॥",
      "transliteration": "bhri(n)g pata(n)g ku(n)char ar meenaa ||",
      "translation": "The bumble bee, the moth, the elephant, the fish",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਿਰਗੁ ਮਰੈ ਸਹਿ ਅਪੁਨਾ ਕੀਨਾ ॥",
      "transliteration": "mirag marai sahi apunaa keenaa ||",
      "translation": "and the deer - all suffer for their actions, and die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤ੍ਰਿਸਨਾ ਰਾਚਿ ਤਤੁ ਨਹੀ ਬੀਨਾ ॥੩॥",
      "transliteration": "trisanaa raach tat nahee beenaa ||3||",
      "translation": "Trapped by desire, they cannot see reality. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਾਮੁ ਚਿਤੈ ਕਾਮਣਿ ਹਿਤਕਾਰੀ ॥",
      "transliteration": "kaam chitai kaaman hitakaaree ||",
      "translation": "The lover of women is obsessed with sex.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕ੍ਰੋਧੁ ਬਿਨਾਸੈ ਸਗਲ ਵਿਕਾਰੀ ॥",
      "transliteration": "krodh binaasai sagal vikaaree ||",
      "translation": "All the wicked are ruined by their anger.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0225_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਪਤਿ ਮਤਿ ਖੋਵਹਿ ਨਾਮੁ ਵਿਸਾਰੀ ॥੪॥",
      "transliteration": "pat mat khovahi naam visaaree ||4||",
      "translation": "Honor and good sense are lost, when one forgets the Naam, the Name of the Lord. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 225,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
