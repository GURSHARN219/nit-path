{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 226,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0226_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਰ ਘਰਿ ਚੀਤੁ ਮਨਮੁਖਿ ਡੋਲਾਇ ॥",
      "transliteration": "par ghar cheet manamukh dolaai ||",
      "translation": "The self-willed manmukh is lured by another man's wife.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗਲਿ ਜੇਵਰੀ ਧੰਧੈ ਲਪਟਾਇ ॥",
      "transliteration": "gal jevaree dha(n)dhai lapataai ||",
      "translation": "The noose is around his neck, and he is entangled in petty conflicts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਛੂਟਸਿ ਹਰਿ ਗੁਣ ਗਾਇ ॥੫॥",
      "transliteration": "guramukh chhootas har gun gaai ||5||",
      "translation": "The Gurmukh is emancipated, singing the Glorious Praises of the Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਿਉ ਤਨੁ ਬਿਧਵਾ ਪਰ ਕਉ ਦੇਈ ॥",
      "transliteration": "jiu tan bidhavaa par kau deee ||",
      "translation": "The lonely widow gives her body to a stranger;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਾਮਿ ਦਾਮਿ ਚਿਤੁ ਪਰ ਵਸਿ ਸੇਈ ॥",
      "transliteration": "kaam daam chit par vas seee ||",
      "translation": "she allows her mind to be controlled by others for lust or money",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਿਨੁ ਪਿਰ ਤ੍ਰਿਪਤਿ ਨ ਕਬਹੂੰ ਹੋਈ ॥੬॥",
      "transliteration": "bin pir tripat na kabahoo(n) hoee ||6||",
      "translation": ", but without her husband, she is never satisfied. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪੜਿ ਪੜਿ ਪੋਥੀ ਸਿੰਮ੍ਰਿਤਿ ਪਾਠਾ ॥",
      "transliteration": "paR paR pothee si(n)mrit paathaa ||",
      "translation": "You may read, recite and study the scriptures,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬੇਦ ਪੁਰਾਣ ਪੜੈ ਸੁਣਿ ਥਾਟਾ ॥",
      "transliteration": "bed puraan paRai sun thaataa ||",
      "translation": "The Simritees, Vedas and Puraanas;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਨੁ ਰਸ ਰਾਤੇ ਮਨੁ ਬਹੁ ਨਾਟਾ ॥੭॥",
      "transliteration": "bin ras raate man bahu naataa ||7||",
      "translation": "but without being imbued with the Lord's essence, the mind wanders endlessly. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਉ ਚਾਤ੍ਰਿਕ ਜਲ ਪ੍ਰੇਮ ਪਿਆਸਾ ॥",
      "transliteration": "jiu chaatrik jal prem piaasaa ||",
      "translation": "As the rainbird thirsts longingly for the drop of rain,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਉ ਮੀਨਾ ਜਲ ਮਾਹਿ ਉਲਾਸਾ ॥",
      "transliteration": "jiu meenaa jal maahi ulaasaa ||",
      "translation": "and as the fish delights in the water,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਰਸੁ ਪੀ ਤ੍ਰਿਪਤਾਸਾ ॥੮॥੧੧॥",
      "transliteration": "naanak har ras pee tripataasaa ||8||11||",
      "translation": "Nanak is satisfied by the sublime essence of the Lord. ||8||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਠੁ ਕਰਿ ਮਰੈ ਨ ਲੇਖੈ ਪਾਵੈ ॥",
      "transliteration": "hath kar marai na lekhai paavai ||",
      "translation": "One who dies in stubbornness shall not be approved,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਵੇਸ ਕਰੈ ਬਹੁ ਭਸਮ ਲਗਾਵੈ ॥",
      "transliteration": "ves karai bahu bhasam lagaavai ||",
      "translation": "even though he may wear religious robes and smear his body all over with ashes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਮੁ ਬਿਸਾਰਿ ਬਹੁਰਿ ਪਛੁਤਾਵੈ ॥੧॥",
      "transliteration": "naam bisaar bahur pachhutaavai ||1||",
      "translation": "Forgetting the Naam, the Name of the Lord, he comes to regret and repent in the end. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤੂੰ ਮਨਿ ਹਰਿ ਜੀਉ ਤੂੰ ਮਨਿ ਸੂਖ ॥",
      "transliteration": "too(n) man har jeeu too(n) man sookh ||",
      "translation": "Believe in the Dear Lord, and you shall find peace of mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮੁ ਬਿਸਾਰਿ ਸਹਹਿ ਜਮ ਦੂਖ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naam bisaar sahahi jam dookh ||1|| rahaau ||",
      "translation": "Forgetting the Naam, you shall have to endure the pain of death. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੋਆ ਚੰਦਨ ਅਗਰ ਕਪੂਰਿ ॥",
      "transliteration": "choaa cha(n)dan agar kapoor ||",
      "translation": "The smell of musk, sandalwood and camphor,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਾਇਆ ਮਗਨੁ ਪਰਮ ਪਦੁ ਦੂਰਿ ॥",
      "transliteration": "maaiaa magan param pad door ||",
      "translation": "and the intoxication of Maya, takes one far away from the state of supreme dignity.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਮਿ ਬਿਸਾਰਿਐ ਸਭੁ ਕੂੜੋ ਕੂਰਿ ॥੨॥",
      "transliteration": "naam bisaariai sabh kooRo koor ||2||",
      "translation": "Forgetting the Naam, one becomes the most false of all the false. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨੇਜੇ ਵਾਜੇ ਤਖਤਿ ਸਲਾਮੁ ॥",
      "transliteration": "neje vaaje takhat salaam ||",
      "translation": "Lances and swords, marching bands, thrones and the salutes of others",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਧਕੀ ਤ੍ਰਿਸਨਾ ਵਿਆਪੈ ਕਾਮੁ ॥",
      "transliteration": "adhakee trisanaa viaapai kaam ||",
      "translation": "only increase his desire; he is engrossed in sexual desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਜਾਚੇ ਭਗਤਿ ਨ ਨਾਮੁ ॥੩॥",
      "transliteration": "bin har jaache bhagat na naam ||3||",
      "translation": "Without seeking the Lord, neither devotional worship nor the Naam are obtained. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਵਾਦਿ ਅਹੰਕਾਰਿ ਨਾਹੀ ਪ੍ਰਭ ਮੇਲਾ ॥",
      "transliteration": "vaad aha(n)kaar naahee prabh melaa ||",
      "translation": "Union with God is not obtained by arguments and egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨੁ ਦੇ ਪਾਵਹਿ ਨਾਮੁ ਸੁਹੇਲਾ ॥",
      "transliteration": "man de paavahi naam suhelaa ||",
      "translation": "But by offering your mind, the comfort of the Naam is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੂਜੈ ਭਾਇ ਅਗਿਆਨੁ ਦੁਹੇਲਾ ॥੪॥",
      "transliteration": "doojai bhaai agiaan duhelaa ||4||",
      "translation": "In the love of duality and ignorance, you shall suffer. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਿਨੁ ਦਮ ਕੇ ਸਉਦਾ ਨਹੀ ਹਾਟ ॥",
      "transliteration": "bin dam ke saudaa nahee haat ||",
      "translation": "Without money, you cannot buy anything in the store.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਿਨੁ ਬੋਹਿਥ ਸਾਗਰ ਨਹੀ ਵਾਟ ॥",
      "transliteration": "bin bohith saagar nahee vaat ||",
      "translation": "Without a boat, you cannot cross over the ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਸੇਵੇ ਘਾਟੇ ਘਾਟਿ ॥੫॥",
      "transliteration": "bin gur seve ghaate ghaat ||5||",
      "translation": "Without serving the Guru, everything is lost. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਿਸ ਕਉ ਵਾਹੁ ਵਾਹੁ ਜਿ ਵਾਟ ਦਿਖਾਵੈ ॥",
      "transliteration": "tis kau vaahu vaahu j vaat dikhaavai ||",
      "translation": "Waaho! Waaho! - Hail, hail, to the one who shows us the Way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਿਸ ਕਉ ਵਾਹੁ ਵਾਹੁ ਜਿ ਸਬਦੁ ਸੁਣਾਵੈ ॥",
      "transliteration": "tis kau vaahu vaahu j sabad sunaavai ||",
      "translation": "Waaho! Waaho! - Hail, hail, to the one who teaches the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਿਸ ਕਉ ਵਾਹੁ ਵਾਹੁ ਜਿ ਮੇਲਿ ਮਿਲਾਵੈ ॥੬॥",
      "transliteration": "tis kau vaahu vaahu j mel milaavai ||6||",
      "translation": "Waaho! Waaho! - Hail, hail, to the one who unites me in the Lord's Union. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਵਾਹੁ ਵਾਹੁ ਤਿਸ ਕਉ ਜਿਸ ਕਾ ਇਹੁ ਜੀਉ ॥",
      "transliteration": "vaahu vaahu tis kau jis kaa ihu jeeu ||",
      "translation": "Waaho! Waaho! - Hail, hail, to the one who is the Keeper of this soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰਸਬਦੀ ਮਥਿ ਅੰਮ੍ਰਿਤੁ ਪੀਉ ॥",
      "transliteration": "gurasabadee math a(n)mrit peeu ||",
      "translation": "Through the Word of the Guru's Shabad, contemplate this Ambrosial Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਮ ਵਡਾਈ ਤੁਧੁ ਭਾਣੈ ਦੀਉ ॥੭॥",
      "transliteration": "naam vadaaee tudh bhaanai deeu ||7||",
      "translation": "The Glorious Greatness of the Naam is bestowed according to the Pleasure of Your Will. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਕਿਉ ਜੀਵਾ ਮਾਇ ॥",
      "transliteration": "naam binaa kiu jeevaa maai ||",
      "translation": "Without the Naam, how can I live, O mother?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਨਦਿਨੁ ਜਪਤੁ ਰਹਉ ਤੇਰੀ ਸਰਣਾਇ ॥",
      "transliteration": "anadin japat rahau teree saranaai ||",
      "translation": "Night and day, I chant it; I remain in the Protection of Your Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ ਪਤਿ ਪਾਇ ॥੮॥੧੨॥",
      "transliteration": "naanak naam rate pat paai ||8||12||",
      "translation": "O Nanak, attuned to the Naam, honor is attained. ||8||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਉਮੈ ਕਰਤ ਭੇਖੀ ਨਹੀ ਜਾਨਿਆ ॥",
      "transliteration": "haumai karat bhekhee nahee jaaniaa ||",
      "translation": "Acting in egotism, the Lord is not known, even by wearing religious robes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਭਗਤਿ ਵਿਰਲੇ ਮਨੁ ਮਾਨਿਆ ॥੧॥",
      "transliteration": "guramukh bhagat virale man maaniaa ||1||",
      "translation": "How rare is that Gurmukh, who surrenders his mind in devotional worship. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਉ ਹਉ ਕਰਤ ਨਹੀ ਸਚੁ ਪਾਈਐ ॥",
      "transliteration": "hau hau karat nahee sach paaeeai ||",
      "translation": "By actions done in egotism, selfishness and conceit, the True Lord is not obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਉਮੈ ਜਾਇ ਪਰਮ ਪਦੁ ਪਾਈਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "haumai jaai param pad paaeeai ||1|| rahaau ||",
      "translation": "But when egotism departs, then the state of supreme dignity is obtained. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਉਮੈ ਕਰਿ ਰਾਜੇ ਬਹੁ ਧਾਵਹਿ ॥",
      "transliteration": "haumai kar raaje bahu dhaavahi ||",
      "translation": "The kings act in egotism, and undertake all sorts of expeditions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਉਮੈ ਖਪਹਿ ਜਨਮਿ ਮਰਿ ਆਵਹਿ ॥੨॥",
      "transliteration": "haumai khapahi janam mar aavahi ||2||",
      "translation": "But through their egotism, they are ruined; they die, only to be reborn over and over again. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਉਮੈ ਨਿਵਰੈ ਗੁਰਸਬਦੁ ਵੀਚਾਰੈ ॥",
      "transliteration": "haumai nivarai gurasabad veechaarai ||",
      "translation": "Egotism is overcome only by contemplating the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚੰਚਲ ਮਤਿ ਤਿਆਗੈ ਪੰਚ ਸੰਘਾਰੈ ॥੩॥",
      "transliteration": "cha(n)chal mat tiaagai pa(n)ch sa(n)ghaarai ||3||",
      "translation": "One who restrains his fickle mind subdues the five passions. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅੰਤਰਿ ਸਾਚੁ ਸਹਜ ਘਰਿ ਆਵਹਿ ॥",
      "transliteration": "a(n)tar saach sahaj ghar aavahi ||",
      "translation": "With the True Lord deep within the self, the Celestial Mansion is intuitively found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਰਾਜਨੁ ਜਾਣਿ ਪਰਮ ਗਤਿ ਪਾਵਹਿ ॥੪॥",
      "transliteration": "raajan jaan param gat paavahi ||4||",
      "translation": "Understanding the Sovereign Lord, the state of supreme dignity is obtained. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਚੁ ਕਰਣੀ ਗੁਰੁ ਭਰਮੁ ਚੁਕਾਵੈ ॥",
      "transliteration": "sach karanee gur bharam chukaavai ||",
      "translation": "The Guru dispels the doubts of those whose actions are true.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਿਰਭਉ ਕੈ ਘਰਿ ਤਾੜੀ ਲਾਵੈ ॥੫॥",
      "transliteration": "nirabhau kai ghar taaRee laavai ||5||",
      "translation": "They focus their attention on the Home of the Fearless Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਹਉ ਹਉ ਕਰਿ ਮਰਣਾ ਕਿਆ ਪਾਵੈ ॥",
      "transliteration": "hau hau kar maranaa kiaa paavai ||",
      "translation": "Those who act in egotism, selfishness and conceit die; what do they gain?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪੂਰਾ ਗੁਰੁ ਭੇਟੇ ਸੋ ਝਗਰੁ ਚੁਕਾਵੈ ॥੬॥",
      "transliteration": "pooraa gur bhete so jhagar chukaavai ||6||",
      "translation": "Those who meet the Perfect Guru are rid of all conflicts. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜੇਤੀ ਹੈ ਤੇਤੀ ਕਿਹੁ ਨਾਹੀ ॥",
      "transliteration": "jetee hai tetee kihu naahee ||",
      "translation": "Whatever exists, is in reality nothing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0226_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਗਿਆਨ ਭੇਟਿ ਗੁਣ ਗਾਹੀ ॥੭॥",
      "transliteration": "guramukh giaan bhet gun gaahee ||7||",
      "translation": "Obtaining spiritual wisdom from the Guru, I sing the Glories of God. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 226,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
