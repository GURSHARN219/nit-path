{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 227,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0227_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਉਮੈ ਬੰਧਨ ਬੰਧਿ ਭਵਾਵੈ ॥",
      "transliteration": "haumai ba(n)dhan ba(n)dh bhavaavai ||",
      "translation": "Egotism binds people in bondage, and causes them to wander around lost.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਨਕ ਰਾਮ ਭਗਤਿ ਸੁਖੁ ਪਾਵੈ ॥੮॥੧੩॥",
      "transliteration": "naanak raam bhagat sukh paavai ||8||13||",
      "translation": "O Nanak, peace is obtained through devotional worship of the Lord. ||8||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪ੍ਰਥਮੇ ਬ੍ਰਹਮਾ ਕਾਲੈ ਘਰਿ ਆਇਆ ॥",
      "transliteration": "prathame brahamaa kaalai ghar aaiaa ||",
      "translation": "First, Brahma entered the house of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬ੍ਰਹਮ ਕਮਲੁ ਪਇਆਲਿ ਨ ਪਾਇਆ ॥",
      "transliteration": "braham kamal paiaal na paaiaa ||",
      "translation": "Brahma entered the lotus, and searched the nether regions, but he did not find the end of it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਗਿਆ ਨਹੀ ਲੀਨੀ ਭਰਮਿ ਭੁਲਾਇਆ ॥੧॥",
      "transliteration": "aagiaa nahee leenee bharam bhulaaiaa ||1||",
      "translation": "He did not accept the Lord's Order - he was deluded by doubt. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੋ ਉਪਜੈ ਸੋ ਕਾਲਿ ਸੰਘਾਰਿਆ ॥",
      "transliteration": "jo upajai so kaal sa(n)ghaariaa ||",
      "translation": "Whoever is created, shall be destroyed by Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਮ ਹਰਿ ਰਾਖੇ ਗੁਰਸਬਦੁ ਬੀਚਾਰਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ham har raakhe gurasabad beechaariaa ||1|| rahaau ||",
      "translation": "But I am protected by the Lord; I contemplate the Word of the Guru's Shabad. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਾਇਆ ਮੋਹੇ ਦੇਵੀ ਸਭਿ ਦੇਵਾ ॥",
      "transliteration": "maaiaa mohe devee sabh devaa ||",
      "translation": "All the gods and goddesses are enticed by Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਲੁ ਨ ਛੋਡੈ ਬਿਨੁ ਗੁਰ ਕੀ ਸੇਵਾ ॥",
      "transliteration": "kaal na chhodai bin gur kee sevaa ||",
      "translation": "Death cannot be avoided, without serving the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਓਹੁ ਅਬਿਨਾਸੀ ਅਲਖ ਅਭੇਵਾ ॥੨॥",
      "transliteration": "ohu abinaasee alakh abhevaa ||2||",
      "translation": "That Lord is Imperishable, Invisible and Inscrutable. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁਲਤਾਨ ਖਾਨ ਬਾਦਿਸਾਹ ਨਹੀ ਰਹਨਾ ॥",
      "transliteration": "sulataan khaan baadisaah nahee rahanaa ||",
      "translation": "The sultans, emperors and kings shall not remain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਮਹੁ ਭੂਲੈ ਜਮ ਕਾ ਦੁਖੁ ਸਹਨਾ ॥",
      "transliteration": "naamahu bhoolai jam kaa dukh sahanaa ||",
      "translation": "Forgetting the Name, they shall endure the pain of death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੈ ਧਰ ਨਾਮੁ ਜਿਉ ਰਾਖਹੁ ਰਹਨਾ ॥੩॥",
      "transliteration": "mai dhar naam jiu raakhahu rahanaa ||3||",
      "translation": "My only Support is the Naam, the Name of the Lord; as He keeps me, I survive. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚਉਧਰੀ ਰਾਜੇ ਨਹੀ ਕਿਸੈ ਮੁਕਾਮੁ ॥",
      "transliteration": "chaudharee raaje nahee kisai mukaam ||",
      "translation": "The leaders and kings shall not remain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਾਹ ਮਰਹਿ ਸੰਚਹਿ ਮਾਇਆ ਦਾਮ ॥",
      "transliteration": "saah marahi sa(n)chahi maaiaa daam ||",
      "translation": "The bankers shall die, after accumulating their wealth and money.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੈ ਧਨੁ ਦੀਜੈ ਹਰਿ ਅੰਮ੍ਰਿਤ ਨਾਮੁ ॥੪॥",
      "transliteration": "mai dhan deejai har a(n)mrit naam ||4||",
      "translation": "Grant me, O Lord, the wealth of Your Ambrosial Naam. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਯਤਿ ਮਹਰ ਮੁਕਦਮ ਸਿਕਦਾਰੈ ॥",
      "transliteration": "rayat mahar mukadam sikadaarai ||",
      "translation": "The people, rulers, leaders and chiefs",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਿਹਚਲੁ ਕੋਇ ਨ ਦਿਸੈ ਸੰਸਾਰੈ ॥",
      "transliteration": "nihachal koi na disai sa(n)saarai ||",
      "translation": "none of them shall be able to remain in the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਫਰਿਉ ਕਾਲੁ ਕੂੜੁ ਸਿਰਿ ਮਾਰੈ ॥੫॥",
      "transliteration": "aphariu kaal kooR sir maarai ||5||",
      "translation": "Death is inevitable; it strikes the heads of the false. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਿਹਚਲੁ ਏਕੁ ਸਚਾ ਸਚੁ ਸੋਈ ॥",
      "transliteration": "nihachal ek sachaa sach soee ||",
      "translation": "Only the One Lord, the Truest of the True, is permanent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਨਿ ਕਰਿ ਸਾਜੀ ਤਿਨਹਿ ਸਭ ਗੋਈ ॥",
      "transliteration": "jin kar saajee tinahi sabh goee ||",
      "translation": "He who created and fashioned everything, shall destroy it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਓਹੁ ਗੁਰਮੁਖਿ ਜਾਪੈ ਤਾਂ ਪਤਿ ਹੋਈ ॥੬॥",
      "transliteration": "ohu guramukh jaapai taa(n) pat hoee ||6||",
      "translation": "One who becomes Gurmukh and meditates on the Lord is honored. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਾਜੀ ਸੇਖ ਭੇਖ ਫਕੀਰਾ ॥",
      "transliteration": "kaajee sekh bhekh phakeeraa ||",
      "translation": "The Qazis, Shaykhs and Fakeers in religious robes",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਵਡੇ ਕਹਾਵਹਿ ਹਉਮੈ ਤਨਿ ਪੀਰਾ ॥",
      "transliteration": "vade kahaavahi haumai tan peeraa ||",
      "translation": "call themselves great; but through their egotism, their bodies are suffering in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਾਲੁ ਨ ਛੋਡੈ ਬਿਨੁ ਸਤਿਗੁਰ ਕੀ ਧੀਰਾ ॥੭॥",
      "transliteration": "kaal na chhodai bin satigur kee dheeraa ||7||",
      "translation": "Death does not spare them, without the Support of the True Guru. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਾਲੁ ਜਾਲੁ ਜਿਹਵਾ ਅਰੁ ਨੈਣੀ ॥",
      "transliteration": "kaal jaal jihavaa ar nainee ||",
      "translation": "The trap of Death is hanging over their tongues and eyes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਾਨੀ ਕਾਲੁ ਸੁਣੈ ਬਿਖੁ ਬੈਣੀ ॥",
      "transliteration": "kaanee kaal sunai bikh bainee ||",
      "translation": "Death is over their ears, when they hear talk of evil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਿਨੁ ਸਬਦੈ ਮੂਠੇ ਦਿਨੁ ਰੈਣੀ ॥੮॥",
      "transliteration": "bin sabadai moothe din rainee ||8||",
      "translation": "Without the Shabad, they are plundered, day and night. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਿਰਦੈ ਸਾਚੁ ਵਸੈ ਹਰਿ ਨਾਇ ॥",
      "transliteration": "hiradai saach vasai har naai ||",
      "translation": "Death cannot touch those whose hearts are filled with the True Name of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਾਲੁ ਨ ਜੋਹਿ ਸਕੈ ਗੁਣ ਗਾਇ ॥",
      "transliteration": "kaal na johi sakai gun gaai ||",
      "translation": "And who sing the Glories of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਸਬਦਿ ਸਮਾਇ ॥੯॥੧੪॥",
      "transliteration": "naanak guramukh sabad samaai ||9||14||",
      "translation": "O Nanak, the Gurmukh is absorbed in the Word of the Shabad. ||9||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "gauRee mahalaa 1 ||",
      "translation": "Gauree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬੋਲਹਿ ਸਾਚੁ ਮਿਥਿਆ ਨਹੀ ਰਾਈ ॥",
      "transliteration": "bolahi saach mithiaa nahee raaee ||",
      "translation": "They speak the Truth - not an iota of falsehood.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚਾਲਹਿ ਗੁਰਮੁਖਿ ਹੁਕਮਿ ਰਜਾਈ ॥",
      "transliteration": "chaalahi guramukh hukam rajaaee ||",
      "translation": "The Gurmukhs walk in the Way of the Lord's Command.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਹਹਿ ਅਤੀਤ ਸਚੇ ਸਰਣਾਈ ॥੧॥",
      "transliteration": "rahahi ateet sache saranaaee ||1||",
      "translation": "They remain unattached, in the Sanctuary of the True Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਚ ਘਰਿ ਬੈਸੈ ਕਾਲੁ ਨ ਜੋਹੈ ॥",
      "transliteration": "sach ghar baisai kaal na johai ||",
      "translation": "They dwell in their true home, and Death does not touch them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨਮੁਖ ਕਉ ਆਵਤ ਜਾਵਤ ਦੁਖੁ ਮੋਹੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "manamukh kau aavat jaavat dukh mohai ||1|| rahaau ||",
      "translation": "The self-willed manmukhs come and go, in the pain of emotional attachment. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਪਿਉ ਪੀਅਉ ਅਕਥੁ ਕਥਿ ਰਹੀਐ ॥",
      "transliteration": "apiu peeau akath kath raheeai ||",
      "translation": "So, drink deeply of this Nectar, and speak the Unspoken Speech.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਿਜ ਘਰਿ ਬੈਸਿ ਸਹਜ ਘਰੁ ਲਹੀਐ ॥",
      "transliteration": "nij ghar bais sahaj ghar laheeai ||",
      "translation": "Dwelling in the home of your own being within, you shall find the home of intuitive peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਰਿ ਰਸਿ ਮਾਤੇ ਇਹੁ ਸੁਖੁ ਕਹੀਐ ॥੨॥",
      "transliteration": "har ras maate ihu sukh kaheeai ||2||",
      "translation": "One who is imbued with the Lord's sublime essence, is said to experience this peace. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰਮਤਿ ਚਾਲ ਨਿਹਚਲ ਨਹੀ ਡੋਲੈ ॥",
      "transliteration": "guramat chaal nihachal nahee dolai ||",
      "translation": "Following the Guru's Teachings, one becomes perfectly stable, and never wavers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੁਰਮਤਿ ਸਾਚਿ ਸਹਜਿ ਹਰਿ ਬੋਲੈ ॥",
      "transliteration": "guramat saach sahaj har bolai ||",
      "translation": "Following the Guru's Teachings, one intuitively chants the Name of the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪੀਵੈ ਅੰਮ੍ਰਿਤੁ ਤਤੁ ਵਿਰੋਲੈ ॥੩॥",
      "transliteration": "peevai a(n)mrit tat virolai ||3||",
      "translation": "Drinking in this Ambrosial Nectar, and churning it, the essential reality is discerned. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਦੇਖਿਆ ਦੀਖਿਆ ਲੀਨੀ ॥",
      "transliteration": "satigur dekhiaa deekhiaa leenee ||",
      "translation": "Beholding the True Guru, I have received His Teachings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਅਰਪਿਓ ਅੰਤਰਗਤਿ ਕੀਨੀ ॥",
      "transliteration": "man tan arapio a(n)taragat keenee ||",
      "translation": "I have offered my mind and body, after searching deep within my own being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗਤਿ ਮਿਤਿ ਪਾਈ ਆਤਮੁ ਚੀਨੀ ॥੪॥",
      "transliteration": "gat mit paaee aatam cheenee ||4||",
      "translation": "I have come to realize the value of understanding my own soul. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭੋਜਨੁ ਨਾਮੁ ਨਿਰੰਜਨ ਸਾਰੁ ॥",
      "transliteration": "bhojan naam nira(n)jan saar ||",
      "translation": "The Naam, the Name of the Immaculate Lord, is the most excellent and sublime food.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਪਰਮ ਹੰਸੁ ਸਚੁ ਜੋਤਿ ਅਪਾਰ ॥",
      "transliteration": "param ha(n)s sach jot apaar ||",
      "translation": "The pure swan-souls see the True Light of the Infinite Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਹ ਦੇਖਉ ਤਹ ਏਕੰਕਾਰੁ ॥੫॥",
      "transliteration": "jah dekhau tah eka(n)kaar ||5||",
      "translation": "Wherever I look, I see the One and Only Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਰਹੈ ਨਿਰਾਲਮੁ ਏਕਾ ਸਚੁ ਕਰਣੀ ॥",
      "transliteration": "rahai niraalam ekaa sach karanee ||",
      "translation": "One who remains pure and unblemished and practices only true deeds,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪਰਮ ਪਦੁ ਪਾਇਆ ਸੇਵਾ ਗੁਰ ਚਰਣੀ ॥",
      "transliteration": "param pad paaiaa sevaa gur charanee ||",
      "translation": "obtains the supreme status, serving at the Guru's Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਨ ਤੇ ਮਨੁ ਮਾਨਿਆ ਚੂਕੀ ਅਹੰ ਭ੍ਰਮਣੀ ॥੬॥",
      "transliteration": "man te man maaniaa chookee aha(n) bhramanee ||6||",
      "translation": "The mind is reconciliated with the mind, and the ego's wandering ways come to an end. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਇਨ ਬਿਧਿ ਕਉਣੁ ਕਉਣੁ ਨਹੀ ਤਾਰਿਆ ॥",
      "transliteration": "in bidh kaun kaun nahee taariaa ||",
      "translation": "In this way, who - who has not been saved?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0227_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਹਰਿ ਜਸਿ ਸੰਤ ਭਗਤ ਨਿਸਤਾਰਿਆ ॥",
      "transliteration": "har jas sa(n)t bhagat nisataariaa ||",
      "translation": "The Lord's Praises have saved His Saints and devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 227,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
