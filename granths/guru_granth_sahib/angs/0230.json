{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 230,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0230_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਵਿਚਹੁ ਹਉਮੈ ਜਾਇ ॥",
      "transliteration": "guramukh vichahu haumai jaai ||",
      "translation": "The Gurmukh eradicates egotism from within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਮੈਲੁ ਨ ਲਾਗੈ ਆਇ ॥",
      "transliteration": "guramukh mail na laagai aai ||",
      "translation": "No filth sticks to the Gurmukh.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਮੁ ਵਸੈ ਮਨਿ ਆਇ ॥੨॥",
      "transliteration": "guramukh naam vasai man aai ||2||",
      "translation": "The Naam, the Name of the Lord, comes to dwell within the mind of the Gurmukh. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਕਰਮ ਧਰਮ ਸਚਿ ਹੋਈ ॥",
      "transliteration": "guramukh karam dharam sach hoee ||",
      "translation": "Through karma and Dharma, good actions and righteous faith, the Gurmukh becomes true.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਅਹੰਕਾਰੁ ਜਲਾਏ ਦੋਈ ॥",
      "transliteration": "guramukh aha(n)kaar jalaae doee ||",
      "translation": "The Gurmukh burns away egotism and duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਮਿ ਰਤੇ ਸੁਖੁ ਹੋਈ ॥੩॥",
      "transliteration": "guramukh naam rate sukh hoee ||3||",
      "translation": "The Gurmukh is attuned to the Naam, and is at peace. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਪਣਾ ਮਨੁ ਪਰਬੋਧਹੁ ਬੂਝਹੁ ਸੋਈ ॥",
      "transliteration": "aapanaa man parabodhahu boojhahu soee ||",
      "translation": "Instruct your own mind, and understand Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਲੋਕ ਸਮਝਾਵਹੁ ਸੁਣੇ ਨ ਕੋਈ ॥",
      "transliteration": "lok samajhaavahu sune na koee ||",
      "translation": "You may preach to other people, but no one will listen.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਮਝਹੁ ਸਦਾ ਸੁਖੁ ਹੋਈ ॥੪॥",
      "transliteration": "guramukh samajhahu sadaa sukh hoee ||4||",
      "translation": "The Gurmukh understands, and is always at peace. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨਮੁਖਿ ਡੰਫੁ ਬਹੁਤੁ ਚਤੁਰਾਈ ॥",
      "transliteration": "manamukh da(n)ph bahut chaturaaee ||",
      "translation": "The self-willed manmukhs are such clever hypocrites.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕਮਾਵੈ ਸੁ ਥਾਇ ਨ ਪਾਈ ॥",
      "transliteration": "jo kichh kamaavai s thaai na paaee ||",
      "translation": "No matter what they do, it is not acceptable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਆਵੈ ਜਾਵੈ ਠਉਰ ਨ ਕਾਈ ॥੫॥",
      "transliteration": "aavai jaavai thaur na kaaee ||5||",
      "translation": "They come and go in reincarnation, and find no place of rest. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਨਮੁਖ ਕਰਮ ਕਰੇ ਬਹੁਤੁ ਅਭਿਮਾਨਾ ॥",
      "transliteration": "manamukh karam kare bahut abhimaanaa ||",
      "translation": "The manmukhs perform their rituals, but they are totally selfish and conceited.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਗ ਜਿਉ ਲਾਇ ਬਹੈ ਨਿਤ ਧਿਆਨਾ ॥",
      "transliteration": "bag jiu laai bahai nit dhiaanaa ||",
      "translation": "They sit there, like storks, pretending to meditate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਮਿ ਪਕੜਿਆ ਤਬ ਹੀ ਪਛੁਤਾਨਾ ॥੬॥",
      "transliteration": "jam pakaRiaa tab hee pachhutaanaa ||6||",
      "translation": "Caught by the Messenger of Death, they shall regret and repent in the end. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰ ਸੇਵੇ ਮੁਕਤਿ ਨ ਹੋਈ ॥",
      "transliteration": "bin satigur seve mukat na hoee ||",
      "translation": "Without serving the True Guru, liberation is not obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਮਿਲੈ ਹਰਿ ਸੋਈ ॥",
      "transliteration": "gur parasaadee milai har soee ||",
      "translation": "By Guru's Grace, one meets the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰੁ ਦਾਤਾ ਜੁਗ ਚਾਰੇ ਹੋਈ ॥੭॥",
      "transliteration": "gur daataa jug chaare hoee ||7||",
      "translation": "The Guru is the Great Giver, throughout the four ages. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਜਾਤਿ ਪਤਿ ਨਾਮੇ ਵਡਿਆਈ ॥",
      "transliteration": "guramukh jaat pat naame vadiaaee ||",
      "translation": "For the Gurmukh, the Naam is social status, honor and glorious greatness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਇਰ ਕੀ ਪੁਤ੍ਰੀ ਬਿਦਾਰਿ ਗਵਾਈ ॥",
      "transliteration": "saair kee putree bidaar gavaaee ||",
      "translation": "Maya, the daughter of the ocean, has been slain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਨਕ ਬਿਨੁ ਨਾਵੈ ਝੂਠੀ ਚਤੁਰਾਈ ॥੮॥੨॥",
      "transliteration": "naanak bin naavai jhoothee chaturaaee ||8||2||",
      "translation": "O Nanak, without the Name, all clever tricks are false. ||8||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗਉੜੀ ਮਃ ੩ ॥",
      "transliteration": "gauRee mah 3 ||",
      "translation": "Gauree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਸੁ ਜੁਗ ਕਾ ਧਰਮੁ ਪੜਹੁ ਤੁਮ ਭਾਈ ॥",
      "transliteration": "is jug kaa dharam paRahu tum bhaaee ||",
      "translation": "Learn the Dharma of this age, O Siblings of Destiny;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪੂਰੈ ਗੁਰਿ ਸਭ ਸੋਝੀ ਪਾਈ ॥",
      "transliteration": "poorai gur sabh sojhee paaee ||",
      "translation": "all understanding is obtained from the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਐਥੈ ਅਗੈ ਹਰਿ ਨਾਮੁ ਸਖਾਈ ॥੧॥",
      "transliteration": "aithai agai har naam sakhaaee ||1||",
      "translation": "Here and hereafter, the Lord's Name is our Companion. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਮ ਪੜਹੁ ਮਨਿ ਕਰਹੁ ਬੀਚਾਰੁ ॥",
      "transliteration": "raam paRahu man karahu beechaar ||",
      "translation": "Learn of the Lord, and contemplate Him in your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਮੈਲੁ ਉਤਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur parasaadee mail utaar ||1|| rahaau ||",
      "translation": "By Guru's Grace, your filth shall be washed away. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਵਾਦਿ ਵਿਰੋਧਿ ਨ ਪਾਇਆ ਜਾਇ ॥",
      "transliteration": "vaad virodh na paaiaa jaai ||",
      "translation": "Through argument and debate, He cannot be found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਫੀਕਾ ਦੂਜੈ ਭਾਇ ॥",
      "transliteration": "man tan pheekaa doojai bhaai ||",
      "translation": "The mind and body are made insipid through the love of duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਸਚਿ ਲਿਵ ਲਾਇ ॥੨॥",
      "transliteration": "gur kai sabad sach liv laai ||2||",
      "translation": "Through the Word of the Guru's Shabad, lovingly attune yourself to the True Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਉਮੈ ਮੈਲਾ ਇਹੁ ਸੰਸਾਰਾ ॥",
      "transliteration": "haumai mailaa ihu sa(n)saaraa ||",
      "translation": "This world is polluted with egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਿਤ ਤੀਰਥਿ ਨਾਵੈ ਨ ਜਾਇ ਅਹੰਕਾਰਾ ॥",
      "transliteration": "nit teerath naavai na jaai aha(n)kaaraa ||",
      "translation": "By taking cleansing baths daily at sacred shrines of pilgrimage, egotism is not eliminated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਭੇਟੇ ਜਮੁ ਕਰੇ ਖੁਆਰਾ ॥੩॥",
      "transliteration": "bin gur bhete jam kare khuaaraa ||3||",
      "translation": "Without meeting the Guru, they are tortured by Death. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੋ ਜਨੁ ਸਾਚਾ ਜਿ ਹਉਮੈ ਮਾਰੈ ॥",
      "transliteration": "so jan saachaa j haumai maarai ||",
      "translation": "Those humble beings are true, who conquer their ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਪੰਚ ਸੰਘਾਰੈ ॥",
      "transliteration": "gur kai sabad pa(n)ch sa(n)ghaarai ||",
      "translation": "Through the Word of the Guru's Shabad, they conquer the five thieves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਪਿ ਤਰੈ ਸਗਲੇ ਕੁਲ ਤਾਰੈ ॥੪॥",
      "transliteration": "aap tarai sagale kul taarai ||4||",
      "translation": "They save themselves, and save all their generations as well. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਾਇਆ ਮੋਹਿ ਨਟਿ ਬਾਜੀ ਪਾਈ ॥",
      "transliteration": "maaiaa mohi nat baajee paaee ||",
      "translation": "The Actor has staged the drama of emotional attachment to Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨਮੁਖ ਅੰਧ ਰਹੇ ਲਪਟਾਈ ॥",
      "transliteration": "manamukh a(n)dh rahe lapataaee ||",
      "translation": "The self-willed manmukhs cling blindly to it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਅਲਿਪਤ ਰਹੇ ਲਿਵ ਲਾਈ ॥੫॥",
      "transliteration": "guramukh alipat rahe liv laaee ||5||",
      "translation": "The Gurmukhs remain detached, and lovingly attune themselves to the Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਹੁਤੇ ਭੇਖ ਕਰੈ ਭੇਖਧਾਰੀ ॥",
      "transliteration": "bahute bhekh karai bhekhadhaaree ||",
      "translation": "The disguisers put on their various disguises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅੰਤਰਿ ਤਿਸਨਾ ਫਿਰੈ ਅਹੰਕਾਰੀ ॥",
      "transliteration": "a(n)tar tisanaa phirai aha(n)kaaree ||",
      "translation": "Desire rages within them, and they carry on egotistically.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਪੁ ਨ ਚੀਨੈ ਬਾਜੀ ਹਾਰੀ ॥੬॥",
      "transliteration": "aap na cheenai baajee haaree ||6||",
      "translation": "They do not understand themselves, and they lose the game of life. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਾਪੜ ਪਹਿਰਿ ਕਰੇ ਚਤੁਰਾਈ ॥",
      "transliteration": "kaapaR pahir kare chaturaaee ||",
      "translation": "Putting on religious robes, they act so clever,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮਾਇਆ ਮੋਹਿ ਅਤਿ ਭਰਮਿ ਭੁਲਾਈ ॥",
      "transliteration": "maaiaa mohi at bharam bhulaaee ||",
      "translation": "but they are totally deluded by doubt and emotional attachment to Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਸੇਵੇ ਬਹੁਤੁ ਦੁਖੁ ਪਾਈ ॥੭॥",
      "transliteration": "bin gur seve bahut dukh paaee ||7||",
      "translation": "Without serving the Guru, they suffer in terrible pain. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਸਦਾ ਬੈਰਾਗੀ ॥",
      "transliteration": "naam rate sadaa bairaagee ||",
      "translation": "Those who are attuned to the Naam, the Name of the Lord, remain detached forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗ੍ਰਿਹੀ ਅੰਤਰਿ ਸਾਚਿ ਲਿਵ ਲਾਗੀ ॥",
      "transliteration": "grihee a(n)tar saach liv laagee ||",
      "translation": "Even as householders, they lovingly attune themselves to the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਨਕ ਸਤਿਗੁਰੁ ਸੇਵਹਿ ਸੇ ਵਡਭਾਗੀ ॥੮॥੩॥",
      "transliteration": "naanak satigur sevahi se vadabhaagee ||8||3||",
      "translation": "O Nanak, those who serve the True Guru are blessed and very fortunate. ||8||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "gauRee mahalaa 3 ||",
      "translation": "Gauree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਮੂਲੁ ਵੇਦ ਅਭਿਆਸਾ ॥",
      "transliteration": "brahamaa mool ved abhiaasaa ||",
      "translation": "Brahma is the founder of the study of the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤਿਸ ਤੇ ਉਪਜੇ ਦੇਵ ਮੋਹ ਪਿਆਸਾ ॥",
      "transliteration": "tis te upaje dev moh piaasaa ||",
      "translation": "From him emanated the gods, enticed by desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤ੍ਰੈ ਗੁਣ ਭਰਮੇ ਨਾਹੀ ਨਿਜ ਘਰਿ ਵਾਸਾ ॥੧॥",
      "transliteration": "trai gun bharame naahee nij ghar vaasaa ||1||",
      "translation": "They wander in the three qualities, and they do not dwell within their own home. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਹਮ ਹਰਿ ਰਾਖੇ ਸਤਿਗੁਰੂ ਮਿਲਾਇਆ ॥",
      "transliteration": "ham har raakhe satiguroo milaaiaa ||",
      "translation": "The Lord has saved me; I have met the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਅਨਦਿਨੁ ਭਗਤਿ ਹਰਿ ਨਾਮੁ ਦ੍ਰਿੜਾਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "anadin bhagat har naam driRaaiaa ||1|| rahaau ||",
      "translation": "He has implanted devotional worship of the Lord's Name, night and day. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤ੍ਰੈ ਗੁਣ ਬਾਣੀ ਬ੍ਰਹਮ ਜੰਜਾਲਾ ॥",
      "transliteration": "trai gun baanee braham ja(n)jaalaa ||",
      "translation": "The songs of Brahma entangle people in the three qualities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0230_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਪੜਿ ਵਾਦੁ ਵਖਾਣਹਿ ਸਿਰਿ ਮਾਰੇ ਜਮਕਾਲਾ ॥",
      "transliteration": "paR vaad vakhaanahi sir maare jamakaalaa ||",
      "translation": "Reading about the debates and disputes, they are hit over the head by the Messenger of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 230,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
