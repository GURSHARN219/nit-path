{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 232,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0232_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਮੁ ਨ ਚੇਤਹਿ ਉਪਾਵਣਹਾਰਾ ॥",
      "transliteration": "naam na chetahi upaavanahaaraa ||",
      "translation": "They do not remember the Name of the Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਰਿ ਜੰਮਹਿ ਫਿਰਿ ਵਾਰੋ ਵਾਰਾ ॥੨॥",
      "transliteration": "mar ja(n)mahi phir vaaro vaaraa ||2||",
      "translation": "They die, and are reborn, over and over, again and again. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅੰਧੇ ਗੁਰੂ ਤੇ ਭਰਮੁ ਨ ਜਾਈ ॥",
      "transliteration": "a(n)dhe guroo te bharam na jaaee ||",
      "translation": "Those whose guru is spiritually blind - their doubts are not dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮੂਲੁ ਛੋਡਿ ਲਾਗੇ ਦੂਜੈ ਭਾਈ ॥",
      "transliteration": "mool chhod laage doojai bhaaee ||",
      "translation": "Abandoning the Source of all, they have become attached to the love of duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਿਖੁ ਕਾ ਮਾਤਾ ਬਿਖੁ ਮਾਹਿ ਸਮਾਈ ॥੩॥",
      "transliteration": "bikh kaa maataa bikh maahi samaaee ||3||",
      "translation": "Infected with poison, they are immersed in poison. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਾਇਆ ਕਰਿ ਮੂਲੁ ਜੰਤ੍ਰ ਭਰਮਾਏ ॥",
      "transliteration": "maaiaa kar mool ja(n)tr bharamaae ||",
      "translation": "Believing Maya to be the source of all, they wander in doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਰਿ ਜੀਉ ਵਿਸਰਿਆ ਦੂਜੈ ਭਾਏ ॥",
      "transliteration": "har jeeu visariaa doojai bhaae ||",
      "translation": "They have forgotten the Dear Lord, and they are in love with duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਸੁ ਨਦਰਿ ਕਰੇ ਸੋ ਪਰਮ ਗਤਿ ਪਾਏ ॥੪॥",
      "transliteration": "jis nadar kare so param gat paae ||4||",
      "translation": "The supreme status is obtained only by those who are blessed with His Glance of Grace. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅੰਤਰਿ ਸਾਚੁ ਬਾਹਰਿ ਸਾਚੁ ਵਰਤਾਏ ॥",
      "transliteration": "a(n)tar saach baahar saach varataae ||",
      "translation": "One who has Truth pervading within, radiates Truth outwardly as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਾਚੁ ਨ ਛਪੈ ਜੇ ਕੋ ਰਖੈ ਛਪਾਏ ॥",
      "transliteration": "saach na chhapai je ko rakhai chhapaae ||",
      "translation": "The Truth does not remain hidden, even though one may try to hide it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗਿਆਨੀ ਬੂਝਹਿ ਸਹਜਿ ਸੁਭਾਏ ॥੫॥",
      "transliteration": "giaanee boojhahi sahaj subhaae ||5||",
      "translation": "The spiritually wise know this intuitively. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਚਿ ਰਹਿਆ ਲਿਵ ਲਾਏ ॥",
      "transliteration": "guramukh saach rahiaa liv laae ||",
      "translation": "The Gurmukhs keep their consciousness lovingly centered on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਉਮੈ ਮਾਇਆ ਸਬਦਿ ਜਲਾਏ ॥",
      "transliteration": "haumai maaiaa sabad jalaae ||",
      "translation": "Ego and Maya are burned away by the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੇਰਾ ਪ੍ਰਭੁ ਸਾਚਾ ਮੇਲਿ ਮਿਲਾਏ ॥੬॥",
      "transliteration": "meraa prabh saachaa mel milaae ||6||",
      "translation": "My True God unites them in His Union. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਦਾਤਾ ਸਬਦੁ ਸੁਣਾਏ ॥",
      "transliteration": "satigur daataa sabad sunaae ||",
      "translation": "The True Guru, The Giver, preaches the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਧਾਵਤੁ ਰਾਖੈ ਠਾਕਿ ਰਹਾਏ ॥",
      "transliteration": "dhaavat raakhai thaak rahaae ||",
      "translation": "He controls, and restrains, and holds still the wandering mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਤੇ ਸੋਝੀ ਪਾਏ ॥੭॥",
      "transliteration": "poore gur te sojhee paae ||7||",
      "translation": "Understanding is obtained through the Perfect Guru. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਪੇ ਕਰਤਾ ਸ੍ਰਿਸਟਿ ਸਿਰਜਿ ਜਿਨਿ ਗੋਈ ॥",
      "transliteration": "aape karataa srisat siraj jin goee ||",
      "translation": "The Creator Himself has created the universe; He Himself shall destroy it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਿਸੁ ਬਿਨੁ ਦੂਜਾ ਅਵਰੁ ਨ ਕੋਈ ॥",
      "transliteration": "tis bin doojaa avar na koee ||",
      "translation": "Without Him, there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਬੂਝੈ ਕੋਈ ॥੮॥੬॥",
      "transliteration": "naanak guramukh boojhai koee ||8||6||",
      "translation": "O Nanak, how rare are those who, as Gurmukh, understand this! ||8||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "gauRee mahalaa 3 ||",
      "translation": "Gauree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਮੁ ਅਮੋਲਕੁ ਗੁਰਮੁਖਿ ਪਾਵੈ ॥",
      "transliteration": "naam amolak guramukh paavai ||",
      "translation": "The Gurmukhs obtain the Naam, the Priceless Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਮੋ ਸੇਵੇ ਨਾਮਿ ਸਹਜਿ ਸਮਾਵੈ ॥",
      "transliteration": "naamo seve naam sahaj samaavai ||",
      "translation": "They serve the Name, and through the Name, they are absorbed in intuitive peace and poise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਨਾਮੁ ਰਸਨਾ ਨਿਤ ਗਾਵੈ ॥",
      "transliteration": "a(n)mrit naam rasanaa nit gaavai ||",
      "translation": "With their tongues, they continually sing the Ambrosial Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਿਸ ਨੋ ਕ੍ਰਿਪਾ ਕਰੇ ਸੋ ਹਰਿ ਰਸੁ ਪਾਵੈ ॥੧॥",
      "transliteration": "jis no kripaa kare so har ras paavai ||1||",
      "translation": "They obtain the Lord's Name; the Lord showers His Mercy upon them. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਨਦਿਨੁ ਹਿਰਦੈ ਜਪਉ ਜਗਦੀਸਾ ॥",
      "transliteration": "anadin hiradai japau jagadeesaa ||",
      "translation": "Night and day, within your heart, meditate on the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਾਵਉ ਪਰਮ ਪਦੁ ਸੂਖਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "guramukh paavau param pad sookhaa ||1|| rahaau ||",
      "translation": "The Gurmukhs obtain the supreme state of peace. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹਿਰਦੈ ਸੂਖੁ ਭਇਆ ਪਰਗਾਸੁ ॥",
      "transliteration": "hiradai sookh bhaiaa paragaas ||",
      "translation": "Peace comes to fill the hearts of those",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਗਾਵਹਿ ਸਚੁ ਗੁਣਤਾਸੁ ॥",
      "transliteration": "guramukh gaavahi sach gunataas ||",
      "translation": "who, as Gurmukh, sing of the True Lord, the treasure of excellence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦਾਸਨਿ ਦਾਸ ਨਿਤ ਹੋਵਹਿ ਦਾਸੁ ॥",
      "transliteration": "daasan daas nit hovahi daas ||",
      "translation": "They become the constant slaves of the slaves of the Lord's slaves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗ੍ਰਿਹ ਕੁਟੰਬ ਮਹਿ ਸਦਾ ਉਦਾਸੁ ॥੨॥",
      "transliteration": "grih kuta(n)b mahi sadaa udaas ||2||",
      "translation": "Within their households and families, they remain always detached. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੀਵਨ ਮੁਕਤੁ ਗੁਰਮੁਖਿ ਕੋ ਹੋਈ ॥",
      "transliteration": "jeevan mukat guramukh ko hoee ||",
      "translation": "How rare are those who, as Gurmukh, become Jivan Mukta - liberated while yet alive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪਰਮ ਪਦਾਰਥੁ ਪਾਵੈ ਸੋਈ ॥",
      "transliteration": "param padaarath paavai soee ||",
      "translation": "They alone obtain the supreme treasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤ੍ਰੈ ਗੁਣ ਮੇਟੇ ਨਿਰਮਲੁ ਹੋਈ ॥",
      "transliteration": "trai gun mete niramal hoee ||",
      "translation": "Eradicating the three qualities, they become pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਹਜੇ ਸਾਚਿ ਮਿਲੈ ਪ੍ਰਭੁ ਸੋਈ ॥੩॥",
      "transliteration": "sahaje saach milai prabh soee ||3||",
      "translation": "They are intuitively absorbed in the True Lord God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੋਹ ਕੁਟੰਬ ਸਿਉ ਪ੍ਰੀਤਿ ਨ ਹੋਇ ॥",
      "transliteration": "moh kuta(n)b siu preet na hoi ||",
      "translation": "Emotional attachment to family does not exist,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਾ ਹਿਰਦੈ ਵਸਿਆ ਸਚੁ ਸੋਇ ॥",
      "transliteration": "jaa hiradai vasiaa sach soi ||",
      "translation": "when the True Lord abides within the heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਮਨੁ ਬੇਧਿਆ ਅਸਥਿਰੁ ਹੋਇ ॥",
      "transliteration": "guramukh man bedhiaa asathir hoi ||",
      "translation": "The mind of the Gurmukh is pierced through and held steady.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹੁਕਮੁ ਪਛਾਣੈ ਬੂਝੈ ਸਚੁ ਸੋਇ ॥੪॥",
      "transliteration": "hukam pachhaanai boojhai sach soi ||4||",
      "translation": "One who recognizes the Hukam of the Lord's Command understands the True Lord. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤੂੰ ਕਰਤਾ ਮੈ ਅਵਰੁ ਨ ਕੋਇ ॥",
      "transliteration": "too(n) karataa mai avar na koi ||",
      "translation": "You are the Creator Lord - there is no other for me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੁਝੁ ਸੇਵੀ ਤੁਝ ਤੇ ਪਤਿ ਹੋਇ ॥",
      "transliteration": "tujh sevee tujh te pat hoi ||",
      "translation": "I serve You, and through You, I obtain honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਿਰਪਾ ਕਰਹਿ ਗਾਵਾ ਪ੍ਰਭੁ ਸੋਇ ॥",
      "transliteration": "kirapaa karahi gaavaa prabh soi ||",
      "translation": "God showers His Mercy, and I sing His Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਮ ਰਤਨੁ ਸਭ ਜਗ ਮਹਿ ਲੋਇ ॥੫॥",
      "transliteration": "naam ratan sabh jag mahi loi ||5||",
      "translation": "The light of the jewel of the Naam permeates the entire world. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਬਾਣੀ ਮੀਠੀ ਲਾਗੀ ॥",
      "transliteration": "guramukh baanee meethee laagee ||",
      "translation": "To the Gurmukhs, the Word of God's Bani seems so sweet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅੰਤਰੁ ਬਿਗਸੈ ਅਨਦਿਨੁ ਲਿਵ ਲਾਗੀ ॥",
      "transliteration": "a(n)tar bigasai anadin liv laagee ||",
      "translation": "Deep within, their hearts blossom forth; night and day, they lovingly center themselves on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਹਜੇ ਸਚੁ ਮਿਲਿਆ ਪਰਸਾਦੀ ॥",
      "transliteration": "sahaje sach miliaa parasaadee ||",
      "translation": "The True Lord is intuitively obtained, by His Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਪਾਇਆ ਪੂਰੈ ਵਡਭਾਗੀ ॥੬॥",
      "transliteration": "satigur paaiaa poorai vadabhaagee ||6||",
      "translation": "The True Guru is obtained by the destiny of perfect good fortune. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹਉਮੈ ਮਮਤਾ ਦੁਰਮਤਿ ਦੁਖ ਨਾਸੁ ॥",
      "transliteration": "haumai mamataa duramat dukh naas ||",
      "translation": "Egotism, possessiveness, evil-mindedness and suffering depart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਬ ਹਿਰਦੈ ਰਾਮ ਨਾਮ ਗੁਣਤਾਸੁ ॥",
      "transliteration": "jab hiradai raam naam gunataas ||",
      "translation": "when the Lord's Name, the Ocean of Virtue, comes to dwell within the heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਬੁਧਿ ਪ੍ਰਗਟੀ ਪ੍ਰਭ ਜਾਸੁ ॥",
      "transliteration": "guramukh budh pragatee prabh jaas ||",
      "translation": "The intellect of the Gurmukhs is awakened, and they praise God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਬ ਹਿਰਦੈ ਰਵਿਆ ਚਰਣ ਨਿਵਾਸੁ ॥੭॥",
      "transliteration": "jab hiradai raviaa charan nivaas ||7||",
      "translation": "when the Lord's Lotus Feet come to dwell within the heart. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਦੇਇ ਸੋਈ ਜਨੁ ਪਾਏ ॥",
      "transliteration": "jis naam dei soee jan paae ||",
      "translation": "They alone receive the Naam, unto whom it is given.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਮੇਲੇ ਆਪੁ ਗਵਾਏ ॥",
      "transliteration": "guramukh mele aap gavaae ||",
      "translation": "The Gurmukhs shed their ego, and merge with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਹਿਰਦੈ ਸਾਚਾ ਨਾਮੁ ਵਸਾਏ ॥",
      "transliteration": "hiradai saachaa naam vasaae ||",
      "translation": "The True Name abides within their hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਨਕ ਸਹਜੇ ਸਾਚਿ ਸਮਾਏ ॥੮॥੭॥",
      "transliteration": "naanak sahaje saach samaae ||8||7||",
      "translation": "O Nanak, they are intuitively absorbed in the True Lord. ||8||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "gauRee mahalaa 3 ||",
      "translation": "Gauree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0232_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮਨ ਹੀ ਮਨੁ ਸਵਾਰਿਆ ਭੈ ਸਹਜਿ ਸੁਭਾਇ ॥",
      "transliteration": "man hee man savaariaa bhai sahaj subhaai ||",
      "translation": "The mind has intuitively healed itself, through the Fear of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 232,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
