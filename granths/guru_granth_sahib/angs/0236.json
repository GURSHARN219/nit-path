{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 236,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0236_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਸਭੁ ਕਿਛੁ ਏਕੈ ॥",
      "transliteration": "karan karaavan sabh kichh ekai ||",
      "translation": "The One Lord is the Creator of all things, the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਪੇ ਬੁਧਿ ਬੀਚਾਰਿ ਬਿਬੇਕੈ ॥",
      "transliteration": "aape budh beechaar bibekai ||",
      "translation": "He Himself is wisdom, contemplation and discerning understanding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੂਰਿ ਨ ਨੇਰੈ ਸਭ ਕੈ ਸੰਗਾ ॥",
      "transliteration": "door na nerai sabh kai sa(n)gaa ||",
      "translation": "He is not far away; He is near at hand, with all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਚੁ ਸਾਲਾਹਣੁ ਨਾਨਕ ਹਰਿ ਰੰਗਾ ॥੮॥੧॥",
      "transliteration": "sach saalaahan naanak har ra(n)gaa ||8||1||",
      "translation": "So praise the True One, O Nanak, with love! ||8||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰ ਸੇਵਾ ਤੇ ਨਾਮੇ ਲਾਗਾ ॥",
      "transliteration": "gur sevaa te naame laagaa ||",
      "translation": "Serving the Guru, one is committed to the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਿਸ ਕਉ ਮਿਲਿਆ ਜਿਸੁ ਮਸਤਕਿ ਭਾਗਾ ॥",
      "transliteration": "tis kau miliaa jis masatak bhaagaa ||",
      "translation": "It is received only by those who have such good destiny inscribed upon their foreheads.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਿਸ ਕੈ ਹਿਰਦੈ ਰਵਿਆ ਸੋਇ ॥",
      "transliteration": "tis kai hiradai raviaa soi ||",
      "translation": "The Lord dwells within their hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਸੀਤਲੁ ਨਿਹਚਲੁ ਹੋਇ ॥੧॥",
      "transliteration": "man tan seetal nihachal hoi ||1||",
      "translation": "Their minds and bodies become peaceful and stable. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਐਸਾ ਕੀਰਤਨੁ ਕਰਿ ਮਨ ਮੇਰੇ ॥",
      "transliteration": "aisaa keeratan kar man mere ||",
      "translation": "O my mind, sing such Praises of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਈਹਾ ਊਹਾ ਜੋ ਕਾਮਿ ਤੇਰੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "eehaa oohaa jo kaam terai ||1|| rahaau ||",
      "translation": "which shall be of use to you here and hereafter. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਭਉ ਅਪਦਾ ਜਾਇ ॥",
      "transliteration": "jaas japat bhau apadaa jaai ||",
      "translation": "Meditating on Him, fear and misfortune depart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਾਵਤ ਮਨੂਆ ਆਵੈ ਠਾਇ ॥",
      "transliteration": "dhaavat manooaa aavai thaai ||",
      "translation": "and the wandering mind is held steady.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਫਿਰਿ ਦੂਖੁ ਨ ਲਾਗੈ ॥",
      "transliteration": "jaas japat phir dookh na laagai ||",
      "translation": "Meditating on Him, suffering shall never again overtake you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਇਹ ਹਉਮੈ ਭਾਗੈ ॥੨॥",
      "transliteration": "jaas japat ih haumai bhaagai ||2||",
      "translation": "Meditating on Him, this ego runs away. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਵਸਿ ਆਵਹਿ ਪੰਚਾ ॥",
      "transliteration": "jaas japat vas aavahi pa(n)chaa ||",
      "translation": "Meditating on Him, the five passions are overcome.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਰਿਦੈ ਅੰਮ੍ਰਿਤੁ ਸੰਚਾ ॥",
      "transliteration": "jaas japat ridai a(n)mrit sa(n)chaa ||",
      "translation": "Meditating on Him, Ambrosial Nectar is collected in the heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਇਹ ਤ੍ਰਿਸਨਾ ਬੁਝੈ ॥",
      "transliteration": "jaas japat ih trisanaa bujhai ||",
      "translation": "Meditating on Him, this desire is quenched.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਹਰਿ ਦਰਗਹ ਸਿਝੈ ॥੩॥",
      "transliteration": "jaas japat har daragah sijhai ||3||",
      "translation": "Meditating on Him, one is approved in the Court of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਕੋਟਿ ਮਿਟਹਿ ਅਪਰਾਧ ॥",
      "transliteration": "jaas japat kot mitahi aparaadh ||",
      "translation": "Meditating on Him, millions of mistakes are erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਹਰਿ ਹੋਵਹਿ ਸਾਧ ॥",
      "transliteration": "jaas japat har hovahi saadh ||",
      "translation": "Meditating on Him, one becomes Holy, blessed by the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਮਨੁ ਸੀਤਲੁ ਹੋਵੈ ॥",
      "transliteration": "jaas japat man seetal hovai ||",
      "translation": "Meditating on Him, the mind is cooled and soothed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਮਲੁ ਸਗਲੀ ਖੋਵੈ ॥੪॥",
      "transliteration": "jaas japat mal sagalee khovai ||4||",
      "translation": "Meditating on Him, all filth is washed away. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਰਤਨੁ ਹਰਿ ਮਿਲੈ ॥",
      "transliteration": "jaas japat ratan har milai ||",
      "translation": "Meditating on Him, the jewel of the Lord is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਹੁਰਿ ਨ ਛੋਡੈ ਹਰਿ ਸੰਗਿ ਹਿਲੈ ॥",
      "transliteration": "bahur na chhodai har sa(n)g hilai ||",
      "translation": "One is reconciled with the Lord, and shall not abandon Him again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਕਈ ਬੈਕੁੰਠ ਵਾਸੁ ॥",
      "transliteration": "jaas japat kaee baiku(n)th vaas ||",
      "translation": "Meditating on Him, many acquire a home in the heavens.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਸੁਖ ਸਹਜਿ ਨਿਵਾਸੁ ॥੫॥",
      "transliteration": "jaas japat sukh sahaj nivaas ||5||",
      "translation": "Meditating on Him, one abides in intuitive peace. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਇਹ ਅਗਨਿ ਨ ਪੋਹਤ ॥",
      "transliteration": "jaas japat ih agan na pohat ||",
      "translation": "Meditating on Him, one is not affected by this fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਇਹੁ ਕਾਲੁ ਨ ਜੋਹਤ ॥",
      "transliteration": "jaas japat ihu kaal na johat ||",
      "translation": "Meditating on Him, one is not under the gaze of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਤੇਰਾ ਨਿਰਮਲ ਮਾਥਾ ॥",
      "transliteration": "jaas japat teraa niramal maathaa ||",
      "translation": "Meditating on Him, your forehead shall be immaculate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਸਗਲਾ ਦੁਖੁ ਲਾਥਾ ॥੬॥",
      "transliteration": "jaas japat sagalaa dukh laathaa ||6||",
      "translation": "Meditating on Him, all pains are destroyed. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਮੁਸਕਲੁ ਕਛੂ ਨ ਬਨੈ ॥",
      "transliteration": "jaas japat musakal kachhoo na banai ||",
      "translation": "Meditating on Him, no difficulties are encountered.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਸੁਣਿ ਅਨਹਤ ਧੁਨੈ ॥",
      "transliteration": "jaas japat sun anahat dhunai ||",
      "translation": "Meditating on Him, one hears the unstruck melody.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਇਹ ਨਿਰਮਲ ਸੋਇ ॥",
      "transliteration": "jaas japat ih niramal soi ||",
      "translation": "Meditating on Him, one acquires this pure reputation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਕਮਲੁ ਸੀਧਾ ਹੋਇ ॥੭॥",
      "transliteration": "jaas japat kamal seedhaa hoi ||7||",
      "translation": "Meditating on Him, the heart-lotus is turned upright. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰਿ ਸੁਭ ਦ੍ਰਿਸਟਿ ਸਭ ਊਪਰਿ ਕਰੀ ॥",
      "transliteration": "gur subh drisat sabh oopar karee ||",
      "translation": "The Guru has bestowed His Glance of Grace upon all,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਸ ਕੈ ਹਿਰਦੈ ਮੰਤ੍ਰੁ ਦੇ ਹਰੀ ॥",
      "transliteration": "jis kai hiradai ma(n)tr de haree ||",
      "translation": "within whose hearts the Lord has implanted His Mantra.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਖੰਡ ਕੀਰਤਨੁ ਤਿਨਿ ਭੋਜਨੁ ਚੂਰਾ ॥",
      "transliteration": "akha(n)d keeratan tin bhojan chooraa ||",
      "translation": "The unbroken Kirtan of the Lord's Praises is their food and nourishment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਿਸੁ ਸਤਿਗੁਰੁ ਪੂਰਾ ॥੮॥੨॥",
      "transliteration": "kahu naanak jis satigur pooraa ||8||2||",
      "translation": "Says Nanak, they have the Perfect True Guru. ||8||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਰਿਦ ਅੰਤਰਿ ਧਾਰੈ ॥",
      "transliteration": "gur kaa sabad rid a(n)tar dhaarai ||",
      "translation": "Those who implant the Word of the Guru's Shabad within their hearts",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪੰਚ ਜਨਾ ਸਿਉ ਸੰਗੁ ਨਿਵਾਰੈ ॥",
      "transliteration": "pa(n)ch janaa siu sa(n)g nivaarai ||",
      "translation": "cut their connections with the five passions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦਸ ਇੰਦ੍ਰੀ ਕਰਿ ਰਾਖੈ ਵਾਸਿ ॥",
      "transliteration": "das i(n)dree kar raakhai vaas ||",
      "translation": "They keep the ten organs under their control;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾ ਕੈ ਆਤਮੈ ਹੋਇ ਪਰਗਾਸੁ ॥੧॥",
      "transliteration": "taa kai aatamai hoi paragaas ||1||",
      "translation": "their souls are enlightened. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਐਸੀ ਦ੍ਰਿੜਤਾ ਤਾ ਕੈ ਹੋਇ ॥",
      "transliteration": "aisee driRataa taa kai hoi ||",
      "translation": "They alone acquire such stability,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਾ ਕਉ ਦਇਆ ਮਇਆ ਪ੍ਰਭ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaa kau daiaa maiaa prabh soi ||1|| rahaau ||",
      "translation": "whom God blesses with His Mercy and Grace. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਾਜਨੁ ਦੁਸਟੁ ਜਾ ਕੈ ਏਕ ਸਮਾਨੈ ॥",
      "transliteration": "saajan dusat jaa kai ek samaanai ||",
      "translation": "Friend and foe are one and the same to them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜੇਤਾ ਬੋਲਣੁ ਤੇਤਾ ਗਿਆਨੈ ॥",
      "transliteration": "jetaa bolan tetaa giaanai ||",
      "translation": "Whatever they speak is wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜੇਤਾ ਸੁਨਣਾ ਤੇਤਾ ਨਾਮੁ ॥",
      "transliteration": "jetaa sunanaa tetaa naam ||",
      "translation": "Whatever they hear is the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜੇਤਾ ਪੇਖਨੁ ਤੇਤਾ ਧਿਆਨੁ ॥੨॥",
      "transliteration": "jetaa pekhan tetaa dhiaan ||2||",
      "translation": "Whatever they see is meditation. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਹਜੇ ਜਾਗਣੁ ਸਹਜੇ ਸੋਇ ॥",
      "transliteration": "sahaje jaagan sahaje soi ||",
      "translation": "They awaken in peace and poise; they sleep in peace and poise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਹਜੇ ਹੋਤਾ ਜਾਇ ਸੁ ਹੋਇ ॥",
      "transliteration": "sahaje hotaa jaai s hoi ||",
      "translation": "That which is meant to be, automatically happens.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਹਜਿ ਬੈਰਾਗੁ ਸਹਜੇ ਹੀ ਹਸਨਾ ॥",
      "transliteration": "sahaj bairaag sahaje hee hasanaa ||",
      "translation": "In peace and poise, they remain detached; in peace and poise, they laugh.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਹਜੇ ਚੂਪ ਸਹਜੇ ਹੀ ਜਪਨਾ ॥੩॥",
      "transliteration": "sahaje choop sahaje hee japanaa ||3||",
      "translation": "In peace and poise, they remain silent; in peace and poise, they chant. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸਹਜੇ ਭੋਜਨੁ ਸਹਜੇ ਭਾਉ ॥",
      "transliteration": "sahaje bhojan sahaje bhaau ||",
      "translation": "In peace and poise they eat; in peace and poise they love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਹਜੇ ਮਿਟਿਓ ਸਗਲ ਦੁਰਾਉ ॥",
      "transliteration": "sahaje mitio sagal duraau ||",
      "translation": "The illusion of duality is easily and totally removed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸਹਜੇ ਹੋਆ ਸਾਧੂ ਸੰਗੁ ॥",
      "transliteration": "sahaje hoaa saadhoo sa(n)g ||",
      "translation": "They naturally join the Saadh Sangat, the Society of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸਹਜਿ ਮਿਲਿਓ ਪਾਰਬ੍ਰਹਮੁ ਨਿਸੰਗੁ ॥੪॥",
      "transliteration": "sahaj milio paarabraham nisa(n)g ||4||",
      "translation": "In peace and poise, they meet and merge with the Supreme Lord God. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0236_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸਹਜੇ ਗ੍ਰਿਹ ਮਹਿ ਸਹਜਿ ਉਦਾਸੀ ॥",
      "transliteration": "sahaje grih mahi sahaj udaasee ||",
      "translation": "They are at peace in their homes, and they are at peace while detached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 236,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
