{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 237,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0237_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਹਜੇ ਦੁਬਿਧਾ ਤਨ ਕੀ ਨਾਸੀ ॥",
      "transliteration": "sahaje dubidhaa tan kee naasee ||",
      "translation": "In peace, their bodies' duality is eliminated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾ ਕੈ ਸਹਜਿ ਮਨਿ ਭਇਆ ਅਨੰਦੁ ॥",
      "transliteration": "jaa kai sahaj man bhaiaa ana(n)d ||",
      "translation": "Bliss comes naturally to their minds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਾ ਕਉ ਭੇਟਿਆ ਪਰਮਾਨੰਦੁ ॥੫॥",
      "transliteration": "taa kau bhetiaa paramaana(n)d ||5||",
      "translation": "They meet the Lord, the Embodiment of Supreme Bliss. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਹਜੇ ਅੰਮ੍ਰਿਤੁ ਪੀਓ ਨਾਮੁ ॥",
      "transliteration": "sahaje a(n)mrit peeo naam ||",
      "translation": "In peaceful poise, they drink in the Ambrosial Nectar of the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਹਜੇ ਕੀਨੋ ਜੀਅ ਕੋ ਦਾਨੁ ॥",
      "transliteration": "sahaje keeno jee ko daan ||",
      "translation": "In peace and poise, they give to the poor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਹਜ ਕਥਾ ਮਹਿ ਆਤਮੁ ਰਸਿਆ ॥",
      "transliteration": "sahaj kathaa mahi aatam rasiaa ||",
      "translation": "Their souls naturally delight in the Lord's Sermon.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਾ ਕੈ ਸੰਗਿ ਅਬਿਨਾਸੀ ਵਸਿਆ ॥੬॥",
      "transliteration": "taa kai sa(n)g abinaasee vasiaa ||6||",
      "translation": "The Imperishable Lord abides with them. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਹਜੇ ਆਸਣੁ ਅਸਥਿਰੁ ਭਾਇਆ ॥",
      "transliteration": "sahaje aasan asathir bhaaiaa ||",
      "translation": "In peace and poise, they assume the unchanging position.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਹਜੇ ਅਨਹਤ ਸਬਦੁ ਵਜਾਇਆ ॥",
      "transliteration": "sahaje anahat sabad vajaaiaa ||",
      "translation": "In peace and poise, the unstruck vibration of the Shabad resounds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਹਜੇ ਰੁਣ ਝੁਣਕਾਰੁ ਸੁਹਾਇਆ ॥",
      "transliteration": "sahaje run jhunakaar suhaaiaa ||",
      "translation": "In peace and poise, the celestial bells resound.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਕੈ ਘਰਿ ਪਾਰਬ੍ਰਹਮੁ ਸਮਾਇਆ ॥੭॥",
      "transliteration": "taa kai ghar paarabraham samaaiaa ||7||",
      "translation": "Within their homes, the Supreme Lord God is pervading. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਹਜੇ ਜਾ ਕਉ ਪਰਿਓ ਕਰਮਾ ॥",
      "transliteration": "sahaje jaa kau pario karamaa ||",
      "translation": "With intuitive ease, they meet the Lord, according to their karma.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਹਜੇ ਗੁਰੁ ਭੇਟਿਓ ਸਚੁ ਧਰਮਾ ॥",
      "transliteration": "sahaje gur bhetio sach dharamaa ||",
      "translation": "With intuitive ease, they meet with the Guru, in the true Dharma.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾ ਕੈ ਸਹਜੁ ਭਇਆ ਸੋ ਜਾਣੈ ॥",
      "transliteration": "jaa kai sahaj bhaiaa so jaanai ||",
      "translation": "Those who know, attain the poise of intuitive peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਤਾ ਕੈ ਕੁਰਬਾਣੈ ॥੮॥੩॥",
      "transliteration": "naanak daas taa kai kurabaanai ||8||3||",
      "translation": "Slave Nanak is a sacrifice to them. ||8||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪ੍ਰਥਮੇ ਗਰਭ ਵਾਸ ਤੇ ਟਰਿਆ ॥",
      "transliteration": "prathame garabh vaas te tariaa ||",
      "translation": "First, they come forth from the womb.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪੁਤ੍ਰ ਕਲਤ੍ਰ ਕੁਟੰਬ ਸੰਗਿ ਜੁਰਿਆ ॥",
      "transliteration": "putr kalatr kuta(n)b sa(n)g juriaa ||",
      "translation": "They become attached to their children, spouses and families.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭੋਜਨੁ ਅਨਿਕ ਪ੍ਰਕਾਰ ਬਹੁ ਕਪਰੇ ॥",
      "transliteration": "bhojan anik prakaar bahu kapare ||",
      "translation": "The foods of various sorts and appearances,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਰਪਰ ਗਵਨੁ ਕਰਹਿਗੇ ਬਪੁਰੇ ॥੧॥",
      "transliteration": "sarapar gavan karahige bapure ||1||",
      "translation": "will surely pass away, O wretched mortal! ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਵਨੁ ਅਸਥਾਨੁ ਜੋ ਕਬਹੁ ਨ ਟਰੈ ॥",
      "transliteration": "kavan asathaan jo kabahu na tarai ||",
      "translation": "What is that place which never perishes?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਵਨੁ ਸਬਦੁ ਜਿਤੁ ਦੁਰਮਤਿ ਹਰੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kavan sabad jit duramat harai ||1|| rahaau ||",
      "translation": "What is that Word by which the dirt of the mind is removed? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇੰਦ੍ਰ ਪੁਰੀ ਮਹਿ ਸਰਪਰ ਮਰਣਾ ॥",
      "transliteration": "i(n)dr puree mahi sarapar maranaa ||",
      "translation": "In the Realm of Indra, death is sure and certain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬ੍ਰਹਮ ਪੁਰੀ ਨਿਹਚਲੁ ਨਹੀ ਰਹਣਾ ॥",
      "transliteration": "braham puree nihachal nahee rahanaa ||",
      "translation": "The Realm of Brahma shall not remain permanent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਿਵ ਪੁਰੀ ਕਾ ਹੋਇਗਾ ਕਾਲਾ ॥",
      "transliteration": "siv puree kaa hoigaa kaalaa ||",
      "translation": "The Realm of Shiva shall also perish.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤ੍ਰੈ ਗੁਣ ਮਾਇਆ ਬਿਨਸਿ ਬਿਤਾਲਾ ॥੨॥",
      "transliteration": "trai gun maaiaa binas bitaalaa ||2||",
      "translation": "The three dispositions, Maya and the demons shall vanish. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਿਰਿ ਤਰ ਧਰਣਿ ਗਗਨ ਅਰੁ ਤਾਰੇ ॥",
      "transliteration": "gir tar dharan gagan ar taare ||",
      "translation": "The mountains, the trees, the earth, the sky and the stars;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਵਿ ਸਸਿ ਪਵਣੁ ਪਾਵਕੁ ਨੀਰਾਰੇ ॥",
      "transliteration": "rav sas pavan paavak neeraare ||",
      "translation": "the sun, the moon, the wind, water and fire;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦਿਨਸੁ ਰੈਣਿ ਬਰਤ ਅਰੁ ਭੇਦਾ ॥",
      "transliteration": "dinas rain barat ar bhedaa ||",
      "translation": "day and night, fasting days and their determination;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਸਤ ਸਿੰਮ੍ਰਿਤਿ ਬਿਨਸਹਿਗੇ ਬੇਦਾ ॥੩॥",
      "transliteration": "saasat si(n)mrit binasahige bedaa ||3||",
      "translation": "the Shaastras, the Simritees and the Vedas shall pass away. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤੀਰਥ ਦੇਵ ਦੇਹੁਰਾ ਪੋਥੀ ॥",
      "transliteration": "teerath dev dehuraa pothee ||",
      "translation": "The sacred shrines of pilgrimage, gods, temples and holy books;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਾਲਾ ਤਿਲਕੁ ਸੋਚ ਪਾਕ ਹੋਤੀ ॥",
      "transliteration": "maalaa tilak soch paak hotee ||",
      "translation": "rosaries, ceremonial tilak marks on the forehead, meditative people, the pure, and the performers of burnt offerings;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਧੋਤੀ ਡੰਡਉਤਿ ਪਰਸਾਦਨ ਭੋਗਾ ॥",
      "transliteration": "dhotee da(n)daut parasaadan bhogaa ||",
      "translation": "wearing loin cloths, bowing in reverence and the enjoyment of sacred foods",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਵਨੁ ਕਰੈਗੋ ਸਗਲੋ ਲੋਗਾ ॥੪॥",
      "transliteration": "gavan karaigo sagalo logaa ||4||",
      "translation": "- all these, and all people, shall pass away. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾਤਿ ਵਰਨ ਤੁਰਕ ਅਰੁ ਹਿੰਦੂ ॥",
      "transliteration": "jaat varan turak ar hi(n)doo ||",
      "translation": "Social classes, races, Muslims and Hindus;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪਸੁ ਪੰਖੀ ਅਨਿਕ ਜੋਨਿ ਜਿੰਦੂ ॥",
      "transliteration": "pas pa(n)khee anik jon ji(n)doo ||",
      "translation": "beasts, birds and the many varieties of beings and creatures;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਗਲ ਪਾਸਾਰੁ ਦੀਸੈ ਪਾਸਾਰਾ ॥",
      "transliteration": "sagal paasaar deesai paasaaraa ||",
      "translation": "the entire world and the visible universe",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਿਨਸਿ ਜਾਇਗੋ ਸਗਲ ਆਕਾਰਾ ॥੫॥",
      "transliteration": "binas jaaigo sagal aakaaraa ||5||",
      "translation": "- all forms of existence shall pass away. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਹਜ ਸਿਫਤਿ ਭਗਤਿ ਤਤੁ ਗਿਆਨਾ ॥",
      "transliteration": "sahaj siphat bhagat tat giaanaa ||",
      "translation": "Through the Praises of the Lord, devotional worship, spiritual wisdom and the essence of reality,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਦਾ ਅਨੰਦੁ ਨਿਹਚਲੁ ਸਚੁ ਥਾਨਾ ॥",
      "transliteration": "sadaa ana(n)d nihachal sach thaanaa ||",
      "translation": "eternal bliss and the imperishable true place are obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਹਾ ਸੰਗਤਿ ਸਾਧ ਗੁਣ ਰਸੈ ॥",
      "transliteration": "tahaa sa(n)gat saadh gun rasai ||",
      "translation": "There, in the Saadh Sangat, the Company of the Holy, the Lord's Glorious Praises are sung with love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਨਭਉ ਨਗਰੁ ਤਹਾ ਸਦ ਵਸੈ ॥੬॥",
      "transliteration": "anabhau nagar tahaa sad vasai ||6||",
      "translation": "There, in the city of fearlessness, He dwells forever. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਹ ਭਉ ਭਰਮਾ ਸੋਗੁ ਨ ਚਿੰਤਾ ॥",
      "transliteration": "tah bhau bharamaa sog na chi(n)taa ||",
      "translation": "There is no fear, doubt, suffering or anxiety there;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਆਵਣੁ ਜਾਵਣੁ ਮਿਰਤੁ ਨ ਹੋਤਾ ॥",
      "transliteration": "aavan jaavan mirat na hotaa ||",
      "translation": "there is no coming or going, and no death there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਹ ਸਦਾ ਅਨੰਦ ਅਨਹਤ ਆਖਾਰੇ ॥",
      "transliteration": "tah sadaa ana(n)d anahat aakhaare ||",
      "translation": "There is eternal bliss, and the unstruck celestial music there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭਗਤ ਵਸਹਿ ਕੀਰਤਨ ਆਧਾਰੇ ॥੭॥",
      "transliteration": "bhagat vasahi keeratan aadhaare ||7||",
      "translation": "The devotees dwell there, with the Kirtan of the Lord's Praises as their support. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕਾ ਅੰਤੁ ਨ ਪਾਰੁ ॥",
      "transliteration": "paarabraham kaa a(n)t na paar ||",
      "translation": "There is no end or limitation to the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਉਣੁ ਕਰੈ ਤਾ ਕਾ ਬੀਚਾਰੁ ॥",
      "transliteration": "kaun karai taa kaa beechaar ||",
      "translation": "Who can embrace His contemplation?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਿਸੁ ਕਿਰਪਾ ਕਰੈ ॥",
      "transliteration": "kahu naanak jis kirapaa karai ||",
      "translation": "Says Nanak, when the Lord showers His Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਿਹਚਲ ਥਾਨੁ ਸਾਧਸੰਗਿ ਤਰੈ ॥੮॥੪॥",
      "transliteration": "nihachal thaan saadhasa(n)g tarai ||8||4||",
      "translation": "the imperishable home is obtained; in the Saadh Sangat, you shall be saved. ||8||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜੋ ਇਸੁ ਮਾਰੇ ਸੋਈ ਸੂਰਾ ॥",
      "transliteration": "jo is maare soee sooraa ||",
      "translation": "One who kills this is a spiritual hero.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜੋ ਇਸੁ ਮਾਰੇ ਸੋਈ ਪੂਰਾ ॥",
      "transliteration": "jo is maare soee pooraa ||",
      "translation": "One who kills this is perfect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜੋ ਇਸੁ ਮਾਰੇ ਤਿਸਹਿ ਵਡਿਆਈ ॥",
      "transliteration": "jo is maare tisahi vadiaaee ||",
      "translation": "One who kills this obtains glorious greatness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜੋ ਇਸੁ ਮਾਰੇ ਤਿਸ ਕਾ ਦੁਖੁ ਜਾਈ ॥੧॥",
      "transliteration": "jo is maare tis kaa dukh jaaee ||1||",
      "translation": "One who kills this is freed of suffering. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਐਸਾ ਕੋਇ ਜਿ ਦੁਬਿਧਾ ਮਾਰਿ ਗਵਾਵੈ ॥",
      "transliteration": "aisaa koi j dubidhaa maar gavaavai ||",
      "translation": "How rare is such a person, who kills and casts off duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0237_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਇਸਹਿ ਮਾਰਿ ਰਾਜ ਜੋਗੁ ਕਮਾਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "isahi maar raaj jog kamaavai ||1|| rahaau ||",
      "translation": "Killing it, he attains Raja Yoga, the Yoga of meditation and success. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 237,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
