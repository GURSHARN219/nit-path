{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 240,
  "lineCount": 51,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0240_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਨਿ ਗੁਰਿ ਮੋ ਕਉ ਦੀਨਾ ਜੀਉ ॥",
      "transliteration": "jin gur mo kau deenaa jeeu ||",
      "translation": "The Guru who gave me my soul,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਪੁਨਾ ਦਾਸਰਾ ਆਪੇ ਮੁਲਿ ਲੀਉ ॥੬॥",
      "transliteration": "aapunaa daasaraa aape mul leeu ||6||",
      "translation": "has Himself purchased me, and made me His slave. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਪੇ ਲਾਇਓ ਅਪਨਾ ਪਿਆਰੁ ॥",
      "transliteration": "aape laaio apanaa piaar ||",
      "translation": "He Himself has blessed me with His Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਤਿਸੁ ਗੁਰ ਕਉ ਕਰੀ ਨਮਸਕਾਰੁ ॥੭॥",
      "transliteration": "sadaa sadaa tis gur kau karee namasakaar ||7||",
      "translation": "Forever and ever, I humbly bow to the Guru. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਲਿ ਕਲੇਸ ਭੈ ਭ੍ਰਮ ਦੁਖ ਲਾਥਾ ॥",
      "transliteration": "kal kales bhai bhram dukh laathaa ||",
      "translation": "My troubles, conflicts, fears, doubts and pains have been dispelled;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਮੇਰਾ ਗੁਰੁ ਸਮਰਾਥਾ ॥੮॥੯॥",
      "transliteration": "kahu naanak meraa gur samaraathaa ||8||9||",
      "translation": "says Nanak, my Guru is All-powerful. ||8||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਿਲੁ ਮੇਰੇ ਗੋਬਿੰਦ ਅਪਨਾ ਨਾਮੁ ਦੇਹੁ ॥",
      "transliteration": "mil mere gobi(n)d apanaa naam dehu ||",
      "translation": "Meet me, O my Lord of the Universe. Please bless me with Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਧ੍ਰਿਗੁ ਧ੍ਰਿਗੁ ਅਸਨੇਹੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naam binaa dhrig dhrig asanehu ||1|| rahaau ||",
      "translation": "Without the Naam, the Name of the Lord, cursed, cursed is love and intimacy. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਜੋ ਪਹਿਰੈ ਖਾਇ ॥",
      "transliteration": "naam binaa jo pahirai khaai ||",
      "translation": "Without the Naam, one who dresses and eats well",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਉ ਕੂਕਰੁ ਜੂਠਨ ਮਹਿ ਪਾਇ ॥੧॥",
      "transliteration": "jiu kookar joothan mahi paai ||1||",
      "translation": "is like a dog, who falls in and eats impure foods. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਜੇਤਾ ਬਿਉਹਾਰੁ ॥",
      "transliteration": "naam binaa jetaa biuhaar ||",
      "translation": "Without the Naam, all occupations are useless,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਉ ਮਿਰਤਕ ਮਿਥਿਆ ਸੀਗਾਰੁ ॥੨॥",
      "transliteration": "jiu miratak mithiaa seegaar ||2||",
      "translation": "Like decorations on a dead body. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਮੁ ਬਿਸਾਰਿ ਕਰੇ ਰਸ ਭੋਗ ॥",
      "transliteration": "naam bisaar kare ras bhog ||",
      "translation": "One who forgets the Naam and indulges in pleasures,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁਖੁ ਸੁਪਨੈ ਨਹੀ ਤਨ ਮਹਿ ਰੋਗ ॥੩॥",
      "transliteration": "sukh supanai nahee tan mahi rog ||3||",
      "translation": "shall find no peace, even in dreams; his body shall become diseased. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਮੁ ਤਿਆਗਿ ਕਰੇ ਅਨ ਕਾਜ ॥",
      "transliteration": "naam tiaag kare an kaaj ||",
      "translation": "One who renounces the Naam and engages in other occupations,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਨਸਿ ਜਾਇ ਝੂਠੇ ਸਭਿ ਪਾਜ ॥੪॥",
      "transliteration": "binas jaai jhoothe sabh paaj ||4||",
      "translation": "shall see all of his false pretenses fall away. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮ ਸੰਗਿ ਮਨਿ ਪ੍ਰੀਤਿ ਨ ਲਾਵੈ ॥",
      "transliteration": "naam sa(n)g man preet na laavai ||",
      "translation": "One whose mind does not embrace love for the Naam",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕੋਟਿ ਕਰਮ ਕਰਤੋ ਨਰਕਿ ਜਾਵੈ ॥੫॥",
      "transliteration": "kot karam karato narak jaavai ||5||",
      "translation": "shall go to hell, even though he may perform millions of ceremonial rituals. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਜਿਨਿ ਮਨਿ ਨ ਆਰਾਧਾ ॥",
      "transliteration": "har kaa naam jin man na aaraadhaa ||",
      "translation": "One whose mind does not contemplate the Name of the Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚੋਰ ਕੀ ਨਿਆਈ ਜਮ ਪੁਰਿ ਬਾਧਾ ॥੬॥",
      "transliteration": "chor kee niaaee jam pur baadhaa ||6||",
      "translation": "is bound like a thief, in the City of Death. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਲਾਖ ਅਡੰਬਰ ਬਹੁਤੁ ਬਿਸਥਾਰਾ ॥",
      "transliteration": "laakh ada(n)bar bahut bisathaaraa ||",
      "translation": "Hundreds of thousands of ostentatious shows and great expanses",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਝੂਠੇ ਪਾਸਾਰਾ ॥੭॥",
      "transliteration": "naam binaa jhoothe paasaaraa ||7||",
      "translation": "- without the Naam, all these displays are false. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਸੋਈ ਜਨੁ ਲੇਇ ॥",
      "transliteration": "har kaa naam soee jan lei ||",
      "translation": "That humble being repeats the Name of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਨਾਨਕ ਜਿਸੁ ਦੇਇ ॥੮॥੧੦॥",
      "transliteration": "kar kirapaa naanak jis dei ||8||10||",
      "translation": "O Nanak, whom the Lord blesses with His Mercy. ||8||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗਉੜੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee mahalaa 5 ||",
      "translation": "Gauree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਆਦਿ ਮਧਿ ਜੋ ਅੰਤਿ ਨਿਬਾਹੈ ॥",
      "transliteration": "aad madh jo a(n)t nibaahai ||",
      "translation": "My mind longs for that Friend,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੋ ਸਾਜਨੁ ਮੇਰਾ ਮਨੁ ਚਾਹੈ ॥੧॥",
      "transliteration": "so saajan meraa man chaahai ||1||",
      "translation": "Who shall stand by me in the beginning, in the middle and in the end. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਰਿ ਕੀ ਪ੍ਰੀਤਿ ਸਦਾ ਸੰਗਿ ਚਾਲੈ ॥",
      "transliteration": "har kee preet sadaa sa(n)g chaalai ||",
      "translation": "The Lord's Love goes with us forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦਇਆਲ ਪੁਰਖ ਪੂਰਨ ਪ੍ਰਤਿਪਾਲੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "daiaal purakh pooran pratipaalai ||1|| rahaau ||",
      "translation": "The Perfect and Merciful Lord cherishes all. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਿਨਸਤ ਨਾਹੀ ਛੋਡਿ ਨ ਜਾਇ ॥",
      "transliteration": "binasat naahee chhod na jaai ||",
      "translation": "He shall never perish, and He shall never abandon me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਹ ਪੇਖਾ ਤਹ ਰਹਿਆ ਸਮਾਇ ॥੨॥",
      "transliteration": "jah pekhaa tah rahiaa samaai ||2||",
      "translation": "Wherever I look, there I see Him pervading and permeating. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁੰਦਰੁ ਸੁਘੜੁ ਚਤੁਰੁ ਜੀਅ ਦਾਤਾ ॥",
      "transliteration": "su(n)dar sughaR chatur jee daataa ||",
      "translation": "He is Beautiful, All-knowing, the most Clever, the Giver of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਾਈ ਪੂਤੁ ਪਿਤਾ ਪ੍ਰਭੁ ਮਾਤਾ ॥੩॥",
      "transliteration": "bhaaee poot pitaa prabh maataa ||3||",
      "translation": "God is my Brother, Son, Father and Mother. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜੀਵਨ ਪ੍ਰਾਨ ਅਧਾਰ ਮੇਰੀ ਰਾਸਿ ॥",
      "transliteration": "jeevan praan adhaar meree raas ||",
      "translation": "He is the Support of the breath of life; He is my Wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰੀਤਿ ਲਾਈ ਕਰਿ ਰਿਦੈ ਨਿਵਾਸਿ ॥੪॥",
      "transliteration": "preet laaee kar ridai nivaas ||4||",
      "translation": "Abiding within my heart, He inspires me to enshrine love for Him. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਾਇਆ ਸਿਲਕ ਕਾਟੀ ਗੋਪਾਲਿ ॥",
      "transliteration": "maaiaa silak kaatee gopaal ||",
      "translation": "The Lord of the World has cut away the noose of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਰਿ ਅਪੁਨਾ ਲੀਨੋ ਨਦਰਿ ਨਿਹਾਲਿ ॥੫॥",
      "transliteration": "kar apunaa leeno nadar nihaal ||5||",
      "translation": "He has made me His own, blessing me with His Glance of Grace. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਕਾਟੇ ਸਭਿ ਰੋਗ ॥",
      "transliteration": "simar simar kaate sabh rog ||",
      "translation": "Remembering, remembering Him in meditation, all diseases are healed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਰਣ ਧਿਆਨ ਸਰਬ ਸੁਖ ਭੋਗ ॥੬॥",
      "transliteration": "charan dhiaan sarab sukh bhog ||6||",
      "translation": "Meditating on His Feet, all comforts are enjoyed. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪੂਰਨ ਪੁਰਖੁ ਨਵਤਨੁ ਨਿਤ ਬਾਲਾ ॥",
      "transliteration": "pooran purakh navatan nit baalaa ||",
      "translation": "The Perfect Primal Lord is Ever-fresh and Ever-young.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਰਿ ਅੰਤਰਿ ਬਾਹਰਿ ਸੰਗਿ ਰਖਵਾਲਾ ॥੭॥",
      "transliteration": "har a(n)tar baahar sa(n)g rakhavaalaa ||7||",
      "translation": "The Lord is with me, inwardly and outwardly, as my Protector. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਹਰਿ ਹਰਿ ਪਦੁ ਚੀਨ ॥",
      "transliteration": "kahu naanak har har pad cheen ||",
      "translation": "Says Nanak, that devotee who realizes the state of the Lord, Har, Har,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਰਬਸੁ ਨਾਮੁ ਭਗਤ ਕਉ ਦੀਨ ॥੮॥੧੧॥",
      "transliteration": "sarabas naam bhagat kau deen ||8||11||",
      "translation": "is blessed with the treasure of the Naam. ||8||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਾਗੁ ਗਉੜੀ ਮਾਝ ਮਹਲਾ ੫ ॥",
      "transliteration": "raag gauRee maajh mahalaa 5 ||",
      "translation": "Raag Gauree Maajh, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਖੋਜਤ ਫਿਰੇ ਅਸੰਖ ਅੰਤੁ ਨ ਪਾਰੀਆ ॥",
      "transliteration": "khojat phire asa(n)kh a(n)t na paareeaa ||",
      "translation": "Countless are those who wander around searching for You, but they do not find Your limits.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੇਈ ਹੋਏ ਭਗਤ ਜਿਨਾ ਕਿਰਪਾਰੀਆ ॥੧॥",
      "transliteration": "seee hoe bhagat jinaa kirapaareeaa ||1||",
      "translation": "They alone are Your devotees, who are blessed by Your Grace. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹਉ ਵਾਰੀਆ ਹਰਿ ਵਾਰੀਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "hau vaareeaa har vaareeaa ||1|| rahaau ||",
      "translation": "I am a sacrifice, I am a sacrifice to You. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੁਣਿ ਸੁਣਿ ਪੰਥੁ ਡਰਾਉ ਬਹੁਤੁ ਭੈਹਾਰੀਆ ॥",
      "transliteration": "sun sun pa(n)th daraau bahut bhaihaareeaa ||",
      "translation": "Continually hearing of the terrifying path, I am so afraid.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0240_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮੈ ਤਕੀ ਓਟ ਸੰਤਾਹ ਲੇਹੁ ਉਬਾਰੀਆ ॥੨॥",
      "transliteration": "mai takee ot sa(n)taah lehu ubaareeaa ||2||",
      "translation": "I have sought the Protection of the Saints; please, save me! ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 240,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
