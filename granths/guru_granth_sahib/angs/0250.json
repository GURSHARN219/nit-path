{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 250,
  "lineCount": 52,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0250_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗਉੜੀ ਬਾਵਨ ਅਖਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee baavan akharee mahalaa 5 ||",
      "translation": "Gauree, Baavan Akhree ~ The 52 Letters, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰਦੇਵ ਮਾਤਾ ਗੁਰਦੇਵ ਪਿਤਾ ਗੁਰਦੇਵ ਸੁਆਮੀ ਪਰਮੇਸੁਰਾ ॥",
      "transliteration": "guradev maataa guradev pitaa guradev suaamee paramesuraa ||",
      "translation": "The Divine Guru is my mother, the Divine Guru is my father; the Divine Guru is my Transcendent Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਰਦੇਵ ਸਖਾ ਅਗਿਆਨ ਭੰਜਨੁ ਗੁਰਦੇਵ ਬੰਧਿਪ ਸਹੋਦਰਾ ॥",
      "transliteration": "guradev sakhaa agiaan bha(n)jan guradev ba(n)dhip sahodaraa ||",
      "translation": "The Divine Guru is my companion, the Destroyer of ignorance; the Divine Guru is my relative and brother.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰਦੇਵ ਦਾਤਾ ਹਰਿ ਨਾਮੁ ਉਪਦੇਸੈ ਗੁਰਦੇਵ ਮੰਤੁ ਨਿਰੋਧਰਾ ॥",
      "transliteration": "guradev daataa har naam upadesai guradev ma(n)t nirodharaa ||",
      "translation": "The Divine Guru is the Giver, the Teacher of the Lord's Name. The Divine Guru is the Mantra which never fails.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਰਦੇਵ ਸਾਂਤਿ ਸਤਿ ਬੁਧਿ ਮੂਰਤਿ ਗੁਰਦੇਵ ਪਾਰਸ ਪਰਸ ਪਰਾ ॥",
      "transliteration": "guradev saa(n)t sat budh moorat guradev paaras paras paraa ||",
      "translation": "The Divine Guru is the Image of peace, truth and wisdom. The Divine Guru is the Philosopher's Stone - touching it, one is transformed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰਦੇਵ ਤੀਰਥੁ ਅੰਮ੍ਰਿਤ ਸਰੋਵਰੁ ਗੁਰ ਗਿਆਨ ਮਜਨੁ ਅਪਰੰਪਰਾ ॥",
      "transliteration": "guradev teerath a(n)mrit sarovar gur giaan majan apara(n)paraa ||",
      "translation": "The Divine Guru is the sacred shrine of pilgrimage, and the pool of divine ambrosia; bathing in the Guru's wisdom, one experiences the Infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰਦੇਵ ਕਰਤਾ ਸਭਿ ਪਾਪ ਹਰਤਾ ਗੁਰਦੇਵ ਪਤਿਤ ਪਵਿਤ ਕਰਾ ॥",
      "transliteration": "guradev karataa sabh paap harataa guradev patit pavit karaa ||",
      "translation": "The Divine Guru is the Creator, and the Destroyer of all sins; the Divine Guru is the Purifier of sinners.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰਦੇਵ ਆਦਿ ਜੁਗਾਦਿ ਜੁਗੁ ਜੁਗੁ ਗੁਰਦੇਵ ਮੰਤੁ ਹਰਿ ਜਪਿ ਉਧਰਾ ॥",
      "transliteration": "guradev aad jugaad jug jug guradev ma(n)t har jap udharaa ||",
      "translation": "The Divine Guru existed at the primal beginning, throughout the ages, in each and every age. The Divine Guru is the Mantra of the Lord's Name; chanting it, one is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਰਦੇਵ ਸੰਗਤਿ ਪ੍ਰਭ ਮੇਲਿ ਕਰਿ ਕਿਰਪਾ ਹਮ ਮੂੜ ਪਾਪੀ ਜਿਤੁ ਲਗਿ ਤਰਾ ॥",
      "transliteration": "guradev sa(n)gat prabh mel kar kirapaa ham mooR paapee jit lag taraa ||",
      "translation": "O God, please be merciful to me, that I may be with the Divine Guru; I am a foolish sinner, but holding onto Him, I am carried across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰਦੇਵ ਸਤਿਗੁਰੁ ਪਾਰਬ੍ਰਹਮੁ ਪਰਮੇਸਰੁ ਗੁਰਦੇਵ ਨਾਨਕ ਹਰਿ ਨਮਸਕਰਾ ॥੧॥",
      "transliteration": "guradev satigur paarabraham paramesar guradev naanak har namasakaraa ||1||",
      "translation": "The Divine Guru is the True Guru, the Supreme Lord God, the Transcendent Lord; Nanak bows in humble reverence to the Lord, the Divine Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਪਹਿ ਕੀਆ ਕਰਾਇਆ ਆਪਹਿ ਕਰਨੈ ਜੋਗੁ ॥",
      "transliteration": "aapahi keeaa karaaiaa aapahi karanai jog ||",
      "translation": "He Himself acts, and causes others to act; He Himself can do everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਏਕੋ ਰਵਿ ਰਹਿਆ ਦੂਸਰ ਹੋਆ ਨ ਹੋਗੁ ॥੧॥",
      "transliteration": "naanak eko rav rahiaa doosar hoaa na hog ||1||",
      "translation": "O Nanak, the One Lord is pervading everywhere; there has never been any other, and there never shall be. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਓਅੰ ਸਾਧ ਸਤਿਗੁਰ ਨਮਸਕਾਰੰ ॥",
      "transliteration": "oa(n) saadh satigur namasakaara(n) ||",
      "translation": "ONG: I humbly bow in reverence to the One Universal Creator, to the Holy True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਦਿ ਮਧਿ ਅੰਤਿ ਨਿਰੰਕਾਰੰ ॥",
      "transliteration": "aad madh a(n)t nira(n)kaara(n) ||",
      "translation": "In the beginning, in the middle, and in the end, He is the Formless Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਪਹਿ ਸੁੰਨ ਆਪਹਿ ਸੁਖ ਆਸਨ ॥",
      "transliteration": "aapahi su(n)n aapahi sukh aasan ||",
      "translation": "He Himself is in the absolute state of primal meditation; He Himself is in the seat of peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਪਹਿ ਸੁਨਤ ਆਪ ਹੀ ਜਾਸਨ ॥",
      "transliteration": "aapahi sunat aap hee jaasan ||",
      "translation": "He Himself listens to His Own Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਪਨ ਆਪੁ ਆਪਹਿ ਉਪਾਇਓ ॥",
      "transliteration": "aapan aap aapahi upaaio ||",
      "translation": "He Himself created Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਪਹਿ ਬਾਪ ਆਪ ਹੀ ਮਾਇਓ ॥",
      "transliteration": "aapahi baap aap hee maaio ||",
      "translation": "He is His Own Father, He is His Own Mother.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਪਹਿ ਸੂਖਮ ਆਪਹਿ ਅਸਥੂਲਾ ॥",
      "transliteration": "aapahi sookham aapahi asathoolaa ||",
      "translation": "He Himself is subtle and etheric; He Himself is manifest and obvious.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਲਖੀ ਨ ਜਾਈ ਨਾਨਕ ਲੀਲਾ ॥੧॥",
      "transliteration": "lakhee na jaaee naanak leelaa ||1||",
      "translation": "O Nanak, His wondrous play cannot be understood. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਦੀਨ ਦਇਆਲਾ ॥",
      "transliteration": "kar kirapaa prabh deen daiaalaa ||",
      "translation": "O God, Merciful to the meek, please be kind to me,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤੇਰੇ ਸੰਤਨ ਕੀ ਮਨੁ ਹੋਇ ਰਵਾਲਾ ॥ ਰਹਾਉ ॥",
      "transliteration": "tere sa(n)tan kee man hoi ravaalaa || rahaau ||",
      "translation": "that my mind might become the dust of the feet of Your Saints. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਿਰੰਕਾਰ ਆਕਾਰ ਆਪਿ ਨਿਰਗੁਨ ਸਰਗੁਨ ਏਕ ॥",
      "transliteration": "nira(n)kaar aakaar aap niragun saragun ek ||",
      "translation": "He Himself is formless, and also formed; the One Lord is without attributes, and also with attributes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਏਕਹਿ ਏਕ ਬਖਾਨਨੋ ਨਾਨਕ ਏਕ ਅਨੇਕ ॥੧॥",
      "transliteration": "ekahi ek bakhaanano naanak ek anek ||1||",
      "translation": "Describe the One Lord as One, and Only One; O Nanak, He is the One, and the many. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਓਅੰ ਗੁਰਮੁਖਿ ਕੀਓ ਅਕਾਰਾ ॥",
      "transliteration": "oa(n) guramukh keeo akaaraa ||",
      "translation": "ONG: The One Universal Creator created the Creation through the Word of the Primal Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਏਕਹਿ ਸੂਤਿ ਪਰੋਵਨਹਾਰਾ ॥",
      "transliteration": "ekahi soot parovanahaaraa ||",
      "translation": "He strung it upon His one thread.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਿੰਨ ਭਿੰਨ ਤ੍ਰੈ ਗੁਣ ਬਿਸਥਾਰੰ ॥",
      "transliteration": "bhi(n)n bhi(n)n trai gun bisathaara(n) ||",
      "translation": "He created the diverse expanse of the three qualities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਿਰਗੁਨ ਤੇ ਸਰਗੁਨ ਦ੍ਰਿਸਟਾਰੰ ॥",
      "transliteration": "niragun te saragun drisataara(n) ||",
      "translation": "From formless, He appeared as form.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਗਲ ਭਾਤਿ ਕਰਿ ਕਰਹਿ ਉਪਾਇਓ ॥",
      "transliteration": "sagal bhaat kar karahi upaaio ||",
      "translation": "The Creator has created the creation of all sorts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਨਮ ਮਰਨ ਮਨ ਮੋਹੁ ਬਢਾਇਓ ॥",
      "transliteration": "janam maran man mohu badhaaio ||",
      "translation": "The attachment of the mind has led to birth and death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੁਹੂ ਭਾਤਿ ਤੇ ਆਪਿ ਨਿਰਾਰਾ ॥",
      "transliteration": "duhoo bhaat te aap niraaraa ||",
      "translation": "He Himself is above both, untouched and unaffected.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਨਕ ਅੰਤੁ ਨ ਪਾਰਾਵਾਰਾ ॥੨॥",
      "transliteration": "naanak a(n)t na paaraavaaraa ||2||",
      "translation": "O Nanak, He has no end or limitation. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੇਈ ਸਾਹ ਭਗਵੰਤ ਸੇ ਸਚੁ ਸੰਪੈ ਹਰਿ ਰਾਸਿ ॥",
      "transliteration": "seee saah bhagava(n)t se sach sa(n)pai har raas ||",
      "translation": "Those who gather Truth, and the riches of the Lord's Name, are rich and very fortunate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਨਕ ਸਚੁ ਸੁਚਿ ਪਾਈਐ ਤਿਹ ਸੰਤਨ ਕੈ ਪਾਸਿ ॥੧॥",
      "transliteration": "naanak sach such paaeeai tih sa(n)tan kai paas ||1||",
      "translation": "O Nanak, truthfulness and purity are obtained from Saints such as these. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਵੜੀ ॥",
      "transliteration": "pavaRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਸਾ ਸਤਿ ਸਤਿ ਸਤਿ ਸੋਊ ॥",
      "transliteration": "sasaa sat sat sat sooo ||",
      "translation": "SASSA: True, True, True is that Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਤਿ ਪੁਰਖ ਤੇ ਭਿੰਨ ਨ ਕੋਊ ॥",
      "transliteration": "sat purakh te bhi(n)n na kooo ||",
      "translation": "No one is separate from the True Primal Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੋਊ ਸਰਨਿ ਪਰੈ ਜਿਹ ਪਾਯੰ ॥",
      "transliteration": "sooo saran parai jih paaya(n) ||",
      "translation": "They alone enter the Lord's Sanctuary, whom the Lord inspires to enter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਗੁਨ ਗਾਇ ਸੁਨਾਯੰ ॥",
      "transliteration": "simar simar gun gaai sunaaya(n) ||",
      "translation": "Meditating, meditating in remembrance, they sing and preach the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੰਸੈ ਭਰਮੁ ਨਹੀ ਕਛੁ ਬਿਆਪਤ ॥",
      "transliteration": "sa(n)sai bharam nahee kachh biaapat ||",
      "translation": "Doubt and skepticism do not affect them at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪ੍ਰਗਟ ਪ੍ਰਤਾਪੁ ਤਾਹੂ ਕੋ ਜਾਪਤ ॥",
      "transliteration": "pragat prataap taahoo ko jaapat ||",
      "translation": "They behold the manifest glory of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੋ ਸਾਧੂ ਇਹ ਪਹੁਚਨਹਾਰਾ ॥",
      "transliteration": "so saadhoo ih pahuchanahaaraa ||",
      "translation": "They are the Holy Saints - they reach this destination.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕੈ ਸਦ ਬਲਿਹਾਰਾ ॥੩॥",
      "transliteration": "naanak taa kai sad balihaaraa ||3||",
      "translation": "Nanak is forever a sacrifice to them. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0250_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਧਨੁ ਧਨੁ ਕਹਾ ਪੁਕਾਰਤੇ ਮਾਇਆ ਮੋਹ ਸਭ ਕੂਰ ॥",
      "transliteration": "dhan dhan kahaa pukaarate maaiaa moh sabh koor ||",
      "translation": "Why are you crying out for riches and wealth? All this emotional attachment to Maya is false.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 250,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
