{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 258,
  "lineCount": 62,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0258_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਿਧਿ ਨਿਧਾਨ ਹਰਿ ਅੰਮ੍ਰਿਤ ਪੂਰੇ ॥",
      "transliteration": "nidh nidhaan har a(n)mrit poore ||",
      "translation": "They are filled and fulfilled with the Ambrosial Nectar of the Lord, the Treasure of sublime wealth;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਹ ਬਾਜੇ ਨਾਨਕ ਅਨਹਦ ਤੂਰੇ ॥੩੬॥",
      "transliteration": "tah baaje naanak anahad toore ||36||",
      "translation": "O Nanak, the unstruck celestial melody vibrates for them. ||36||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਤਿ ਰਾਖੀ ਗੁਰਿ ਪਾਰਬ੍ਰਹਮ ਤਜਿ ਪਰਪੰਚ ਮੋਹ ਬਿਕਾਰ ॥",
      "transliteration": "pat raakhee gur paarabraham taj parapa(n)ch moh bikaar ||",
      "translation": "The Guru, the Supreme Lord God, preserved my honor, when I renounced hypocrisy, emotional attachment and corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਨਕ ਸੋਊ ਆਰਾਧੀਐ ਅੰਤੁ ਨ ਪਾਰਾਵਾਰੁ ॥੧॥",
      "transliteration": "naanak sooo aaraadheeai a(n)t na paaraavaar ||1||",
      "translation": "O Nanak, worship and adore the One, who has no end or limitation. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਪਾ ਪਰਮਿਤਿ ਪਾਰੁ ਨ ਪਾਇਆ ॥",
      "transliteration": "papaa paramit paar na paaiaa ||",
      "translation": "PAPPA: He is beyond estimation; His limits cannot be found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਤਿਤ ਪਾਵਨ ਅਗਮ ਹਰਿ ਰਾਇਆ ॥",
      "transliteration": "patit paavan agam har raaiaa ||",
      "translation": "The Sovereign Lord King is inaccessible;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹੋਤ ਪੁਨੀਤ ਕੋਟ ਅਪਰਾਧੂ ॥",
      "transliteration": "hot puneet kot aparaadhoo ||",
      "translation": "He is the Purifier of sinners. Millions of sinners are purified;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਜਪਹਿ ਮਿਲਿ ਸਾਧੂ ॥",
      "transliteration": "a(n)mrit naam japahi mil saadhoo ||",
      "translation": "they meet the Holy, and chant the Ambrosial Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਰਪਚ ਧ੍ਰੋਹ ਮੋਹ ਮਿਟਨਾਈ ॥",
      "transliteration": "parapach dhroh moh mitanaaee ||",
      "translation": "Deception, fraud and emotional attachment are eliminated,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾ ਕਉ ਰਾਖਹੁ ਆਪਿ ਗੁਸਾਈ ॥",
      "transliteration": "jaa kau raakhahu aap gusaaee ||",
      "translation": "by those who are protected by the Lord of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਾਤਿਸਾਹੁ ਛਤ੍ਰ ਸਿਰ ਸੋਊ ॥",
      "transliteration": "paatisaahu chhatr sir sooo ||",
      "translation": "He is the Supreme King, with the royal canopy above His Head.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਨਕ ਦੂਸਰ ਅਵਰੁ ਨ ਕੋਊ ॥੩੭॥",
      "transliteration": "naanak doosar avar na kooo ||37||",
      "translation": "O Nanak, there is no other at all. ||37||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਫਾਹੇ ਕਾਟੇ ਮਿਟੇ ਗਵਨ ਫਤਿਹ ਭਈ ਮਨਿ ਜੀਤ ॥",
      "transliteration": "phaahe kaate mite gavan phatih bhaee man jeet ||",
      "translation": "The noose of Death is cut, and one's wanderings cease; victory is obtained, when one conquers his own mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਨਕ ਗੁਰ ਤੇ ਥਿਤ ਪਾਈ ਫਿਰਨ ਮਿਟੇ ਨਿਤ ਨੀਤ ॥੧॥",
      "transliteration": "naanak gur te thit paaee phiran mite nit neet ||1||",
      "translation": "O Nanak, eternal stability is obtained from the Guru, and one's day-to-day wanderings cease. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਫਫਾ ਫਿਰਤ ਫਿਰਤ ਤੂ ਆਇਆ ॥",
      "transliteration": "phaphaa phirat phirat too aaiaa ||",
      "translation": "FAFFA: After wandering and wandering for so long, you have come;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦ੍ਰੁਲਭ ਦੇਹ ਕਲਿਜੁਗ ਮਹਿ ਪਾਇਆ ॥",
      "transliteration": "drulabh deh kalijug mahi paaiaa ||",
      "translation": "in this Dark Age of Kali Yuga, you have obtained this human body, so very difficult to obtain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਫਿਰਿ ਇਆ ਅਉਸਰੁ ਚਰੈ ਨ ਹਾਥਾ ॥",
      "transliteration": "phir iaa ausar charai na haathaa ||",
      "translation": "This opportunity shall not come into your hands again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਮੁ ਜਪਹੁ ਤਉ ਕਟੀਅਹਿ ਫਾਸਾ ॥",
      "transliteration": "naam japahu tau kateeahi phaasaa ||",
      "translation": "So chant the Naam, the Name of the Lord, and the noose of Death shall be cut away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਫਿਰਿ ਫਿਰਿ ਆਵਨ ਜਾਨੁ ਨ ਹੋਈ ॥",
      "transliteration": "phir phir aavan jaan na hoee ||",
      "translation": "You shall not have to come and go in reincarnation over and over again,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਏਕਹਿ ਏਕ ਜਪਹੁ ਜਪੁ ਸੋਈ ॥",
      "transliteration": "ekahi ek japahu jap soee ||",
      "translation": "if you chant and meditate on the One and Only Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਰਹੁ ਕ੍ਰਿਪਾ ਪ੍ਰਭ ਕਰਨੈਹਾਰੇ ॥",
      "transliteration": "karahu kripaa prabh karanaihaare ||",
      "translation": "Shower Your Mercy, O God, Creator Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੇਲਿ ਲੇਹੁ ਨਾਨਕ ਬੇਚਾਰੇ ॥੩੮॥",
      "transliteration": "mel lehu naanak bechaare ||38||",
      "translation": "and unite poor Nanak with Yourself. ||38||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਿਨਉ ਸੁਨਹੁ ਤੁਮ ਪਾਰਬ੍ਰਹਮ ਦੀਨ ਦਇਆਲ ਗੁਪਾਲ ॥",
      "transliteration": "binau sunahu tum paarabraham deen daiaal gupaal ||",
      "translation": "Hear my prayer, O Supreme Lord God, Merciful to the meek, Lord of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੁਖ ਸੰਪੈ ਬਹੁ ਭੋਗ ਰਸ ਨਾਨਕ ਸਾਧ ਰਵਾਲ ॥੧॥",
      "transliteration": "sukh sa(n)pai bahu bhog ras naanak saadh ravaal ||1||",
      "translation": "The dust of the feet of the Holy is peace, wealth, great enjoyment and pleasure for Nanak. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਬਾ ਬ੍ਰਹਮੁ ਜਾਨਤ ਤੇ ਬ੍ਰਹਮਾ ॥",
      "transliteration": "babaa braham jaanat te brahamaa ||",
      "translation": "BABBA: One who knows God is a Brahmin.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬੈਸਨੋ ਤੇ ਗੁਰਮੁਖਿ ਸੁਚ ਧਰਮਾ ॥",
      "transliteration": "baisano te guramukh such dharamaa ||",
      "translation": "A Vaishnaav is one who, as Gurmukh, lives the righteous life of Dharma.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬੀਰਾ ਆਪਨ ਬੁਰਾ ਮਿਟਾਵੈ ॥",
      "transliteration": "beeraa aapan buraa mitaavai ||",
      "translation": "One who eradicates his own evil is a brave warrior;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾਹੂ ਬੁਰਾ ਨਿਕਟਿ ਨਹੀ ਆਵੈ ॥",
      "transliteration": "taahoo buraa nikat nahee aavai ||",
      "translation": "no evil even approaches him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਾਧਿਓ ਆਪਨ ਹਉ ਹਉ ਬੰਧਾ ॥",
      "transliteration": "baadhio aapan hau hau ba(n)dhaa ||",
      "translation": "Man is bound by the chains of his own egotism, selfishness and conceit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੋਸੁ ਦੇਤ ਆਗਹ ਕਉ ਅੰਧਾ ॥",
      "transliteration": "dos det aagah kau a(n)dhaa ||",
      "translation": "The spiritually blind place the blame on others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਾਤ ਚੀਤ ਸਭ ਰਹੀ ਸਿਆਨਪ ॥",
      "transliteration": "baat cheet sabh rahee siaanap ||",
      "translation": "But all debates and clever tricks are of no use at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਸਹਿ ਜਨਾਵਹੁ ਸੋ ਜਾਨੈ ਨਾਨਕ ॥੩੯॥",
      "transliteration": "jisahi janaavahu so jaanai naanak ||39||",
      "translation": "O Nanak, he alone comes to know, whom the Lord inspires to know. ||39||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭੈ ਭੰਜਨ ਅਘ ਦੂਖ ਨਾਸ ਮਨਹਿ ਅਰਾਧਿ ਹਰੇ ॥",
      "transliteration": "bhai bha(n)jan agh dookh naas manahi araadh hare ||",
      "translation": "The Destroyer of fear, the Eradicator of sin and sorrow - enshrine that Lord in your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੰਤਸੰਗ ਜਿਹ ਰਿਦ ਬਸਿਓ ਨਾਨਕ ਤੇ ਨ ਭ੍ਰਮੇ ॥੧॥",
      "transliteration": "sa(n)tasa(n)g jih rid basio naanak te na bhrame ||1||",
      "translation": "One whose heart abides in the Society of the Saints, O Nanak, does not wander around in doubt. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭਭਾ ਭਰਮੁ ਮਿਟਾਵਹੁ ਅਪਨਾ ॥",
      "transliteration": "bhabhaa bharam mitaavahu apanaa ||",
      "translation": "BHABHA: Cast out your doubt and delusion",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਆ ਸੰਸਾਰੁ ਸਗਲ ਹੈ ਸੁਪਨਾ ॥",
      "transliteration": "iaa sa(n)saar sagal hai supanaa ||",
      "translation": "this world is just a dream.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਰਮੇ ਸੁਰਿ ਨਰ ਦੇਵੀ ਦੇਵਾ ॥",
      "transliteration": "bharame sur nar devee devaa ||",
      "translation": "The angelic beings, goddesses and gods are deluded by doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭਰਮੇ ਸਿਧ ਸਾਧਿਕ ਬ੍ਰਹਮੇਵਾ ॥",
      "transliteration": "bharame sidh saadhik brahamevaa ||",
      "translation": "The Siddhas and seekers, and even Brahma are deluded by doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭਰਮਿ ਭਰਮਿ ਮਾਨੁਖ ਡਹਕਾਏ ॥",
      "transliteration": "bharam bharam maanukh dahakaae ||",
      "translation": "Wandering around, deluded by doubt, people are ruined.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੁਤਰ ਮਹਾ ਬਿਖਮ ਇਹ ਮਾਏ ॥",
      "transliteration": "dutar mahaa bikham ih maae ||",
      "translation": "It is so very difficult and treacherous to cross over this ocean of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਭ੍ਰਮ ਭੈ ਮੋਹ ਮਿਟਾਇਆ ॥",
      "transliteration": "guramukh bhram bhai moh mitaaiaa ||",
      "translation": "That Gurmukh who has eradicated doubt, fear and attachment,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਨਕ ਤੇਹ ਪਰਮ ਸੁਖ ਪਾਇਆ ॥੪੦॥",
      "transliteration": "naanak teh param sukh paaiaa ||40||",
      "translation": "O Nanak, obtains supreme peace. ||40||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਾਇਆ ਡੋਲੈ ਬਹੁ ਬਿਧੀ ਮਨੁ ਲਪਟਿਓ ਤਿਹ ਸੰਗ ॥",
      "transliteration": "maaiaa dolai bahu bidhee man lapatio tih sa(n)g ||",
      "translation": "Maya clings to the mind, and causes it to waver in so many ways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਾਗਨ ਤੇ ਜਿਹ ਤੁਮ ਰਖਹੁ ਸੁ ਨਾਨਕ ਨਾਮਹਿ ਰੰਗ ॥੧॥",
      "transliteration": "maagan te jih tum rakhahu s naanak naamahi ra(n)g ||1||",
      "translation": "When You, O Lord, restrain someone from asking for wealth, then, O Nanak, he comes to love the Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮਮਾ ਮਾਗਨਹਾਰ ਇਆਨਾ ॥",
      "transliteration": "mamaa maaganahaar iaanaa ||",
      "translation": "MAMMA: The beggar is so ignorant",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਦੇਨਹਾਰ ਦੇ ਰਹਿਓ ਸੁਜਾਨਾ ॥",
      "transliteration": "denahaar de rahio sujaanaa ||",
      "translation": "the Great Giver continues to give. He is All-knowing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜੋ ਦੀਨੋ ਸੋ ਏਕਹਿ ਬਾਰ ॥",
      "transliteration": "jo deeno so ekahi baar ||",
      "translation": "Whatever He gives, He gives once and for all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਮਨ ਮੂਰਖ ਕਹ ਕਰਹਿ ਪੁਕਾਰ ॥",
      "transliteration": "man moorakh kah karahi pukaar ||",
      "translation": "O foolish mind, why do you complain, and cry out so loud?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜਉ ਮਾਗਹਿ ਤਉ ਮਾਗਹਿ ਬੀਆ ॥",
      "transliteration": "jau maagahi tau maagahi beeaa ||",
      "translation": "Whenever you ask for something, you ask for worldly things;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜਾ ਤੇ ਕੁਸਲ ਨ ਕਾਹੂ ਥੀਆ ॥",
      "transliteration": "jaa te kusal na kaahoo theeaa ||",
      "translation": "no one has obtained happiness from these.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਮਾਗਨਿ ਮਾਗ ਤ ਏਕਹਿ ਮਾਗ ॥",
      "transliteration": "maagan maag ta ekahi maag ||",
      "translation": "If you must ask for a gift, then ask for the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0258_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਨਾਨਕ ਜਾ ਤੇ ਪਰਹਿ ਪਰਾਗ ॥੪੧॥",
      "transliteration": "naanak jaa te parahi paraag ||41||",
      "translation": "O Nanak, by Him, you shall be saved. ||41||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 258,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
