{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 259,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0259_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਲੋਕ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਤਿ ਪੂਰੀ ਪਰਧਾਨ ਤੇ ਗੁਰ ਪੂਰੇ ਮਨ ਮੰਤ ॥",
      "transliteration": "mat pooree paradhaan te gur poore man ma(n)t ||",
      "translation": "Perfect is the intellect, and most distinguished is the reputation, of those whose minds are filled with the Mantra of the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਿਹ ਜਾਨਿਓ ਪ੍ਰਭੁ ਆਪੁਨਾ ਨਾਨਕ ਤੇ ਭਗਵੰਤ ॥੧॥",
      "transliteration": "jih jaanio prabh aapunaa naanak te bhagava(n)t ||1||",
      "translation": "Those who come to know their God, O Nanak, are very fortunate. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਮਾ ਜਾਹੂ ਮਰਮੁ ਪਛਾਨਾ ॥",
      "transliteration": "mamaa jaahoo maram pachhaanaa ||",
      "translation": "MAMMA: Those who understand God's mystery are satisfied,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭੇਟਤ ਸਾਧਸੰਗ ਪਤੀਆਨਾ ॥",
      "transliteration": "bhetat saadhasa(n)g pateeaanaa ||",
      "translation": "joining the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੁਖ ਸੁਖ ਉਆ ਕੈ ਸਮਤ ਬੀਚਾਰਾ ॥",
      "transliteration": "dukh sukh uaa kai samat beechaaraa ||",
      "translation": "They look upon pleasure and pain as the same.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਰਕ ਸੁਰਗ ਰਹਤ ਅਉਤਾਰਾ ॥",
      "transliteration": "narak surag rahat autaaraa ||",
      "translation": "They are exempt from incarnation into heaven or hell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾਹੂ ਸੰਗ ਤਾਹੂ ਨਿਰਲੇਪਾ ॥",
      "transliteration": "taahoo sa(n)g taahoo niralepaa ||",
      "translation": "They live in the world, and yet they are detached from it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪੂਰਨ ਘਟ ਘਟ ਪੁਰਖ ਬਿਸੇਖਾ ॥",
      "transliteration": "pooran ghat ghat purakh bisekhaa ||",
      "translation": "The Sublime Lord, the Primal Being, is totally pervading each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਉਆ ਰਸ ਮਹਿ ਉਆਹੂ ਸੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "uaa ras mahi uaahoo sukh paaiaa ||",
      "translation": "In His Love, they find peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਨਕ ਲਿਪਤ ਨਹੀ ਤਿਹ ਮਾਇਆ ॥੪੨॥",
      "transliteration": "naanak lipat nahee tih maaiaa ||42||",
      "translation": "O Nanak, Maya does not cling to them at all. ||42||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਯਾਰ ਮੀਤ ਸੁਨਿ ਸਾਜਨਹੁ ਬਿਨੁ ਹਰਿ ਛੂਟਨੁ ਨਾਹਿ ॥",
      "transliteration": "yaar meet sun saajanahu bin har chhootan naahi ||",
      "translation": "Listen, my dear friends and companions: without the Lord, there is no salvation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਤਿਹ ਬੰਧਨ ਕਟੇ ਗੁਰ ਕੀ ਚਰਨੀ ਪਾਹਿ ॥੧॥",
      "transliteration": "naanak tih ba(n)dhan kate gur kee charanee paahi ||1||",
      "translation": "O Nanak, one who falls at the Feet of the Guru, has his bonds cut away. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਵੜੀ ॥",
      "transliteration": "pavaRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਯਯਾ ਜਤਨ ਕਰਤ ਬਹੁ ਬਿਧੀਆ ॥",
      "transliteration": "yayaa jatan karat bahu bidheeaa ||",
      "translation": "YAYYA: People try all sorts of things,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਏਕ ਨਾਮ ਬਿਨੁ ਕਹ ਲਉ ਸਿਧੀਆ ॥",
      "transliteration": "ek naam bin kah lau sidheeaa ||",
      "translation": "but without the One Name, how far can they succeed?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਯਾਹੂ ਜਤਨ ਕਰਿ ਹੋਤ ਛੁਟਾਰਾ ॥",
      "transliteration": "yaahoo jatan kar hot chhutaaraa ||",
      "translation": "Those efforts, by which emancipation may be attained",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਉਆਹੂ ਜਤਨ ਸਾਧ ਸੰਗਾਰਾ ॥",
      "transliteration": "uaahoo jatan saadh sa(n)gaaraa ||",
      "translation": "those efforts are made in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਯਾ ਉਬਰਨ ਧਾਰੈ ਸਭੁ ਕੋਊ ॥",
      "transliteration": "yaa ubaran dhaarai sabh kooo ||",
      "translation": "Everyone has this idea of salvation,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਉਆਹਿ ਜਪੇ ਬਿਨੁ ਉਬਰ ਨ ਹੋਊ ॥",
      "transliteration": "uaahi jape bin ubar na hooo ||",
      "translation": "but without meditation, there can be no salvation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਯਾਹੂ ਤਰਨ ਤਾਰਨ ਸਮਰਾਥਾ ॥",
      "transliteration": "yaahoo taran taaran samaraathaa ||",
      "translation": "The All-powerful Lord is the boat to carry us across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਾਖਿ ਲੇਹੁ ਨਿਰਗੁਨ ਨਰਨਾਥਾ ॥",
      "transliteration": "raakh lehu niragun naranaathaa ||",
      "translation": "O Lord, please save these worthless beings!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਨ ਬਚ ਕ੍ਰਮ ਜਿਹ ਆਪਿ ਜਨਾਈ ॥",
      "transliteration": "man bach kram jih aap janaaee ||",
      "translation": "Those whom the Lord Himself instructs in thought, word and deed",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਨਕ ਤਿਹ ਮਤਿ ਪ੍ਰਗਟੀ ਆਈ ॥੪੩॥",
      "transliteration": "naanak tih mat pragatee aaee ||43||",
      "translation": "- O Nanak, their intellect is enlightened. ||43||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰੋਸੁ ਨ ਕਾਹੂ ਸੰਗ ਕਰਹੁ ਆਪਨ ਆਪੁ ਬੀਚਾਰਿ ॥",
      "transliteration": "ros na kaahoo sa(n)g karahu aapan aap beechaar ||",
      "translation": "Do not be angry with anyone else; look within your own self instead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹੋਇ ਨਿਮਾਨਾ ਜਗਿ ਰਹਹੁ ਨਾਨਕ ਨਦਰੀ ਪਾਰਿ ॥੧॥",
      "transliteration": "hoi nimaanaa jag rahahu naanak nadaree paar ||1||",
      "translation": "Be humble in this world, O Nanak, and by His Grace you shall be carried across. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਰਾ ਰੇਨ ਹੋਤ ਸਭ ਜਾ ਕੀ ॥",
      "transliteration": "raaraa ren hot sabh jaa kee ||",
      "translation": "RARRA: Be the dust under the feet of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਜਿ ਅਭਿਮਾਨੁ ਛੁਟੈ ਤੇਰੀ ਬਾਕੀ ॥",
      "transliteration": "taj abhimaan chhutai teree baakee ||",
      "translation": "Give up your egotistical pride, and the balance of your account shall be written off.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰਣਿ ਦਰਗਹਿ ਤਉ ਸੀਝਹਿ ਭਾਈ ॥",
      "transliteration": "ran daragahi tau seejhahi bhaaee ||",
      "translation": "Then, you shall win the battle in the Court of the Lord, O Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਉ ਗੁਰਮੁਖਿ ਰਾਮ ਨਾਮ ਲਿਵ ਲਾਈ ॥",
      "transliteration": "jau guramukh raam naam liv laaee ||",
      "translation": "As Gurmukh, lovingly attune yourself to the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਹਤ ਰਹਤ ਰਹਿ ਜਾਹਿ ਬਿਕਾਰਾ ॥",
      "transliteration": "rahat rahat rahi jaahi bikaaraa ||",
      "translation": "Your evil ways shall be slowly and steadily blotted out,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕੈ ਸਬਦਿ ਅਪਾਰਾ ॥",
      "transliteration": "gur poore kai sabad apaaraa ||",
      "translation": "By the Shabad, the Incomparable Word of the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰਾਤੇ ਰੰਗ ਨਾਮ ਰਸ ਮਾਤੇ ॥",
      "transliteration": "raate ra(n)g naam ras maate ||",
      "translation": "You shall be imbued with the Lord's Love, and intoxicated with the Nectar of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਗੁਰ ਕੀਨੀ ਦਾਤੇ ॥੪੪॥",
      "transliteration": "naanak har gur keenee daate ||44||",
      "translation": "O Nanak, the Lord, the Guru, has given this gift. ||44||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲਾਲਚ ਝੂਠ ਬਿਖੈ ਬਿਆਧਿ ਇਆ ਦੇਹੀ ਮਹਿ ਬਾਸ ॥",
      "transliteration": "laalach jhooth bikhai biaadh iaa dehee mahi baas ||",
      "translation": "The afflictions of greed, falsehood and corruption abide in this body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਅੰਮ੍ਰਿਤੁ ਗੁਰਮੁਖਿ ਪੀਆ ਨਾਨਕ ਸੂਖਿ ਨਿਵਾਸ ॥੧॥",
      "transliteration": "har har a(n)mrit guramukh peeaa naanak sookh nivaas ||1||",
      "translation": "Drinking in the Ambrosial Nectar of the Lord's Name, Har, Har, O Nanak, the Gurmukh abides in peace. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਲਲਾ ਲਾਵਉ ਅਉਖਧ ਜਾਹੂ ॥",
      "transliteration": "lalaa laavau aukhadh jaahoo ||",
      "translation": "LALLA: One who takes the medicine of the Naam, the Name of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੂਖ ਦਰਦ ਤਿਹ ਮਿਟਹਿ ਖਿਨਾਹੂ ॥",
      "transliteration": "dookh darad tih mitahi khinaahoo ||",
      "translation": "is cured of his pain and sorrow in an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਮ ਅਉਖਧੁ ਜਿਹ ਰਿਦੈ ਹਿਤਾਵੈ ॥",
      "transliteration": "naam aukhadh jih ridai hitaavai ||",
      "translation": "One whose heart is filled with the medicine of the Naam,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਾਹਿ ਰੋਗੁ ਸੁਪਨੈ ਨਹੀ ਆਵੈ ॥",
      "transliteration": "taahi rog supanai nahee aavai ||",
      "translation": "is not infested with disease, even in his dreams.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਰਿ ਅਉਖਧੁ ਸਭ ਘਟ ਹੈ ਭਾਈ ॥",
      "transliteration": "har aukhadh sabh ghat hai bhaaee ||",
      "translation": "The medicine of the Lord's Name is in all hearts, O Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਬਿਨੁ ਬਿਧਿ ਨ ਬਨਾਈ ॥",
      "transliteration": "gur poore bin bidh na banaaee ||",
      "translation": "Without the Perfect Guru, no one knows how to prepare it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਸੰਜਮੁ ਕਰਿ ਦੀਆ ॥",
      "transliteration": "gur poorai sa(n)jam kar deeaa ||",
      "translation": "When the Perfect Guru gives the instructions to prepare it,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਨਕ ਤਉ ਫਿਰਿ ਦੂਖ ਨ ਥੀਆ ॥੪੫॥",
      "transliteration": "naanak tau phir dookh na theeaa ||45||",
      "translation": "then, O Nanak, one does not suffer illness again. ||45||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਵਾਸੁਦੇਵ ਸਰਬਤ੍ਰ ਮੈ ਊਨ ਨ ਕਤਹੂ ਠਾਇ ॥",
      "transliteration": "vaasudev sarabatr mai oon na katahoo thaai ||",
      "translation": "The All-pervading Lord is in all places. There is no place where He does not exist.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅੰਤਰਿ ਬਾਹਰਿ ਸੰਗਿ ਹੈ ਨਾਨਕ ਕਾਇ ਦੁਰਾਇ ॥੧॥",
      "transliteration": "a(n)tar baahar sa(n)g hai naanak kaai duraai ||1||",
      "translation": "Inside and outside, He is with you. O Nanak, what can be hidden from Him? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਵਵਾ ਵੈਰੁ ਨ ਕਰੀਐ ਕਾਹੂ ॥",
      "transliteration": "vavaa vair na kareeai kaahoo ||",
      "translation": "WAWWA: Do not harbor hatred against anyone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਘਟ ਘਟ ਅੰਤਰਿ ਬ੍ਰਹਮ ਸਮਾਹੂ ॥",
      "transliteration": "ghat ghat a(n)tar braham samaahoo ||",
      "translation": "In each and every heart, God is contained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਵਾਸੁਦੇਵ ਜਲ ਥਲ ਮਹਿ ਰਵਿਆ ॥",
      "transliteration": "vaasudev jal thal mahi raviaa ||",
      "translation": "The All-pervading Lord is permeating and pervading the oceans and the land.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਵਿਰਲੈ ਹੀ ਗਵਿਆ ॥",
      "transliteration": "gur prasaad viralai hee gaviaa ||",
      "translation": "How rare are those who, by Guru's Grace, sing of Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਵੈਰ ਵਿਰੋਧ ਮਿਟੇ ਤਿਹ ਮਨ ਤੇ ॥",
      "transliteration": "vair virodh mite tih man te ||",
      "translation": "Hatred and alienation depart from those",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਹਰਿ ਕੀਰਤਨੁ ਗੁਰਮੁਖਿ ਜੋ ਸੁਨਤੇ ॥",
      "transliteration": "har keeratan guramukh jo sunate ||",
      "translation": "who, as Gurmukh, listen to the Kirtan of the Lord's Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0259_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਵਰਨ ਚਿਹਨ ਸਗਲਹ ਤੇ ਰਹਤਾ ॥",
      "transliteration": "varan chihan sagalah te rahataa ||",
      "translation": "O Nanak, one who becomes Gurmukh chants the Name of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 259,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
