{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 260,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0260_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਹਰਿ ਗੁਰਮੁਖਿ ਜੋ ਕਹਤਾ ॥੪੬॥",
      "transliteration": "naanak har har guramukh jo kahataa ||46||",
      "translation": "Har, Har, and rises above all social classes and status symbols. ||46||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਉ ਹਉ ਕਰਤ ਬਿਹਾਨੀਆ ਸਾਕਤ ਮੁਗਧ ਅਜਾਨ ॥",
      "transliteration": "hau hau karat bihaaneeaa saakat mugadh ajaan ||",
      "translation": "Acting in egotism, selfishness and conceit, the foolish, ignorant, faithless cynic wastes his life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ੜੜਕਿ ਮੁਏ ਜਿਉ ਤ੍ਰਿਖਾਵੰਤ ਨਾਨਕ ਕਿਰਤਿ ਕਮਾਨ ॥੧॥",
      "transliteration": "RaRak mue jiu trikhaava(n)t naanak kirat kamaan ||1||",
      "translation": "He dies in agony, like one dying of thirst; O Nanak, this is because of the deeds he has done. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ੜਾੜਾ ੜਾੜਿ ਮਿਟੈ ਸੰਗਿ ਸਾਧੂ ॥",
      "transliteration": "RaaRaa RaaR mitai sa(n)g saadhoo ||",
      "translation": "RARRA: Conflict is eliminated in the Saadh Sangat, the Company of the Holy;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਤਤੁ ਨਾਮ ਅਰਾਧੂ ॥",
      "transliteration": "karam dharam tat naam araadhoo ||",
      "translation": "meditate in adoration on the Naam, the Name of the Lord, the essence of karma and Dharma.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰੂੜੋ ਜਿਹ ਬਸਿਓ ਰਿਦ ਮਾਹੀ ॥",
      "transliteration": "rooRo jih basio rid maahee ||",
      "translation": "When the Beautiful Lord abides within the heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਉਆ ਕੀ ੜਾੜਿ ਮਿਟਤ ਬਿਨਸਾਹੀ ॥",
      "transliteration": "uaa kee RaaR mitat binasaahee ||",
      "translation": "conflict is erased and ended.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ੜਾੜਿ ਕਰਤ ਸਾਕਤ ਗਾਵਾਰਾ ॥",
      "transliteration": "RaaR karat saakat gaavaaraa ||",
      "translation": "The foolish, faithless cynic picks arguments",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੇਹ ਹੀਐ ਅਹੰਬੁਧਿ ਬਿਕਾਰਾ ॥",
      "transliteration": "jeh heeai aha(n)budh bikaaraa ||",
      "translation": "his heart is filled with corruption and egotistical intellect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ੜਾੜਾ ਗੁਰਮੁਖਿ ੜਾੜਿ ਮਿਟਾਈ ॥",
      "transliteration": "RaaRaa guramukh RaaR mitaaee ||",
      "translation": "RARRA: For the Gurmukh, conflict is eliminated in an instant,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਿਮਖ ਮਾਹਿ ਨਾਨਕ ਸਮਝਾਈ ॥੪੭॥",
      "transliteration": "nimakh maahi naanak samajhaaee ||47||",
      "translation": "O Nanak, through the Teachings. ||47||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਾਧੂ ਕੀ ਮਨ ਓਟ ਗਹੁ ਉਕਤਿ ਸਿਆਨਪ ਤਿਆਗੁ ॥",
      "transliteration": "saadhoo kee man ot gahu ukat siaanap tiaag ||",
      "translation": "O mind, grasp the Support of the Holy Saint; give up your clever arguments.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰ ਦੀਖਿਆ ਜਿਹ ਮਨਿ ਬਸੈ ਨਾਨਕ ਮਸਤਕਿ ਭਾਗੁ ॥੧॥",
      "transliteration": "gur deekhiaa jih man basai naanak masatak bhaag ||1||",
      "translation": "One who has the Guru's Teachings within his mind, O Nanak, has good destiny inscribed upon his forehead. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਸਾ ਸਰਨਿ ਪਰੇ ਅਬ ਹਾਰੇ ॥",
      "transliteration": "sasaa saran pare ab haare ||",
      "translation": "SASSA: I have now entered Your Sanctuary, Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਾਸਤ੍ਰ ਸਿਮ੍ਰਿਤਿ ਬੇਦ ਪੂਕਾਰੇ ॥",
      "transliteration": "saasatr simrit bed pookaare ||",
      "translation": "I am so tired of reciting the Shaastras, the Simritees and the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋਧਤ ਸੋਧਤ ਸੋਧਿ ਬੀਚਾਰਾ ॥",
      "transliteration": "sodhat sodhat sodh beechaaraa ||",
      "translation": "I searched and searched and searched, and now I have come to realize,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਭਜਨ ਨਹੀ ਛੁਟਕਾਰਾ ॥",
      "transliteration": "bin har bhajan nahee chhutakaaraa ||",
      "translation": "that without meditating on the Lord, there is no emancipation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾਸਿ ਸਾਸਿ ਹਮ ਭੂਲਨਹਾਰੇ ॥",
      "transliteration": "saas saas ham bhoolanahaare ||",
      "translation": "With each and every breath, I make mistakes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤੁਮ ਸਮਰਥ ਅਗਨਤ ਅਪਾਰੇ ॥",
      "transliteration": "tum samarath aganat apaare ||",
      "translation": "You are All-powerful, endless and infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਰਨਿ ਪਰੇ ਕੀ ਰਾਖੁ ਦਇਆਲਾ ॥",
      "transliteration": "saran pare kee raakh daiaalaa ||",
      "translation": "I seek Your Sanctuary - please save me, Merciful Lord!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਨਕ ਤੁਮਰੇ ਬਾਲ ਗੁਪਾਲਾ ॥੪੮॥",
      "transliteration": "naanak tumare baal gupaalaa ||48||",
      "translation": "Nanak is Your child, O Lord of the World. ||48||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਖੁਦੀ ਮਿਟੀ ਤਬ ਸੁਖ ਭਏ ਮਨ ਤਨ ਭਏ ਅਰੋਗ ॥",
      "transliteration": "khudee mitee tab sukh bhae man tan bhae arog ||",
      "translation": "When selfishness and conceit are erased, peace comes, and the mind and body are healed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਦ੍ਰਿਸਟੀ ਆਇਆ ਉਸਤਤਿ ਕਰਨੈ ਜੋਗੁ ॥੧॥",
      "transliteration": "naanak drisatee aaiaa usatat karanai jog ||1||",
      "translation": "O Nanak, then He comes to be seen - the One who is worthy of praise. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਖਖਾ ਖਰਾ ਸਰਾਹਉ ਤਾਹੂ ॥",
      "transliteration": "khakhaa kharaa saraahau taahoo ||",
      "translation": "KHAKHA: Praise and extol Him on High,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੋ ਖਿਨ ਮਹਿ ਊਨੇ ਸੁਭਰ ਭਰਾਹੂ ॥",
      "transliteration": "jo khin mahi oone subhar bharaahoo ||",
      "translation": "who fills the empty to over-flowing in an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਖਰਾ ਨਿਮਾਨਾ ਹੋਤ ਪਰਾਨੀ ॥",
      "transliteration": "kharaa nimaanaa hot paraanee ||",
      "translation": "When the mortal being becomes totally humble,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਨਦਿਨੁ ਜਾਪੈ ਪ੍ਰਭ ਨਿਰਬਾਨੀ ॥",
      "transliteration": "anadin jaapai prabh nirabaanee ||",
      "translation": "then he meditates night and day on God, the Detached Lord of Nirvaanaa.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਾਵੈ ਖਸਮ ਤ ਉਆ ਸੁਖੁ ਦੇਤਾ ॥",
      "transliteration": "bhaavai khasam ta uaa sukh detaa ||",
      "translation": "If it pleases the Will of our Lord and Master, then He blesses us with peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਐਸੋ ਆਗਨਤਾ ॥",
      "transliteration": "paarabraham aiso aaganataa ||",
      "translation": "Such is the Infinite, Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਸੰਖ ਖਤੇ ਖਿਨ ਬਖਸਨਹਾਰਾ ॥",
      "transliteration": "asa(n)kh khate khin bakhasanahaaraa ||",
      "translation": "He forgives countless sins in an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕ ਸਾਹਿਬ ਸਦਾ ਦਇਆਰਾ ॥੪੯॥",
      "transliteration": "naanak saahib sadaa daiaaraa ||49||",
      "translation": "O Nanak, our Lord and Master is merciful forever. ||49||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਤਿ ਕਹਉ ਸੁਨਿ ਮਨ ਮੇਰੇ ਸਰਨਿ ਪਰਹੁ ਹਰਿ ਰਾਇ ॥",
      "transliteration": "sat kahau sun man mere saran parahu har raai ||",
      "translation": "I speak the Truth - listen, O my mind: take to the Sanctuary of the Sovereign Lord King.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਉਕਤਿ ਸਿਆਨਪ ਸਗਲ ਤਿਆਗਿ ਨਾਨਕ ਲਏ ਸਮਾਇ ॥੧॥",
      "transliteration": "ukat siaanap sagal tiaag naanak lae samaai ||1||",
      "translation": "Give up all your clever tricks, O Nanak, and He shall absorb you into Himself. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਸਾ ਸਿਆਨਪ ਛਾਡੁ ਇਆਨਾ ॥",
      "transliteration": "sasaa siaanap chhaad iaanaa ||",
      "translation": "SASSA: Give up your clever tricks, you ignorant fool!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਿਕਮਤਿ ਹੁਕਮਿ ਨ ਪ੍ਰਭੁ ਪਤੀਆਨਾ ॥",
      "transliteration": "hikamat hukam na prabh pateeaanaa ||",
      "translation": "God is not pleased with clever tricks and commands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਹਸ ਭਾਤਿ ਕਰਹਿ ਚਤੁਰਾਈ ॥",
      "transliteration": "sahas bhaat karahi chaturaaee ||",
      "translation": "You may practice a thousand forms of cleverness,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੰਗਿ ਤੁਹਾਰੈ ਏਕ ਨ ਜਾਈ ॥",
      "transliteration": "sa(n)g tuhaarai ek na jaaee ||",
      "translation": "but not even one will go along with you in the end.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੋਊ ਸੋਊ ਜਪਿ ਦਿਨ ਰਾਤੀ ॥",
      "transliteration": "sooo sooo jap din raatee ||",
      "translation": "Meditate on that Lord, that Lord, day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰੇ ਜੀਅ ਚਲੈ ਤੁਹਾਰੈ ਸਾਥੀ ॥",
      "transliteration": "re jee chalai tuhaarai saathee ||",
      "translation": "O soul, He alone shall go along with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਾਧ ਸੇਵਾ ਲਾਵੈ ਜਿਹ ਆਪੈ ॥",
      "transliteration": "saadh sevaa laavai jih aapai ||",
      "translation": "Those whom the Lord Himself commits to the service of the Holy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕਉ ਦੂਖੁ ਨ ਬਿਆਪੈ ॥੫੦॥",
      "transliteration": "naanak taa kau dookh na biaapai ||50||",
      "translation": "O Nanak, are not afflicted by suffering. ||50||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਮੁਖ ਤੇ ਬੋਲਨਾ ਮਨਿ ਵੂਠੈ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "har har mukh te bolanaa man voothai sukh hoi ||",
      "translation": "Chanting the Name of the Lord, Har, Har, and keeping it in your mind, you shall find peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾਨਕ ਸਭ ਮਹਿ ਰਵਿ ਰਹਿਆ ਥਾਨ ਥਨੰਤਰਿ ਸੋਇ ॥੧॥",
      "transliteration": "naanak sabh mahi rav rahiaa thaan thana(n)tar soi ||1||",
      "translation": "O Nanak, the Lord is pervading everywhere; He is contained in all spaces and interspaces. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਹੇਰਉ ਘਟਿ ਘਟਿ ਸਗਲ ਕੈ ਪੂਰਿ ਰਹੇ ਭਗਵਾਨ ॥",
      "transliteration": "herau ghat ghat sagal kai poor rahe bhagavaan ||",
      "translation": "Behold! The Lord God is totally pervading each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਹੋਵਤ ਆਏ ਸਦ ਸਦੀਵ ਦੁਖ ਭੰਜਨ ਗੁਰ ਗਿਆਨ ॥",
      "transliteration": "hovat aae sad sadeev dukh bha(n)jan gur giaan ||",
      "translation": "Forever and ever, the Guru's wisdom has been the Destroyer of pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਹਉ ਛੁਟਕੈ ਹੋਇ ਅਨੰਦੁ ਤਿਹ ਹਉ ਨਾਹੀ ਤਹ ਆਪਿ ॥",
      "transliteration": "hau chhutakai hoi ana(n)d tih hau naahee tah aap ||",
      "translation": "Quieting the ego, ecstasy is obtained. Where the ego does not exist, God Himself is there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਹਤੇ ਦੂਖ ਜਨਮਹ ਮਰਨ ਸੰਤਸੰਗ ਪਰਤਾਪ ॥",
      "transliteration": "hate dookh janamah maran sa(n)tasa(n)g parataap ||",
      "translation": "The pain of birth and death is removed, by the power of the Society of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਹਿਤ ਕਰਿ ਨਾਮ ਦ੍ਰਿੜੈ ਦਇਆਲਾ ॥",
      "transliteration": "hit kar naam driRai daiaalaa ||",
      "translation": "He becomes kind to those who lovingly enshrine the Name of the Merciful Lord within their hearts,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0260_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸੰਤਹ ਸੰਗਿ ਹੋਤ ਕਿਰਪਾਲਾ ॥",
      "transliteration": "sa(n)tah sa(n)g hot kirapaalaa ||",
      "translation": "In the Society of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 260,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
