{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 263,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0263_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕੈ ਲਾਗਉ ਪਾਏ ॥੩॥",
      "transliteration": "naanak taa kai laagau paae ||3||",
      "translation": "Nanak grasps the feet of those humble beings. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪ੍ਰਭ ਕਾ ਸਿਮਰਨੁ ਸਭ ਤੇ ਊਚਾ ॥",
      "transliteration": "prabh kaa simaran sabh te oochaa ||",
      "translation": "The remembrance of God is the highest and most exalted of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ ਉਧਰੇ ਮੂਚਾ ॥",
      "transliteration": "prabh kai simaran udhare moochaa ||",
      "translation": "In the remembrance of God, many are saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ ਤ੍ਰਿਸਨਾ ਬੁਝੈ ॥",
      "transliteration": "prabh kai simaran trisanaa bujhai ||",
      "translation": "In the remembrance of God, thirst is quenched.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ ਸਭੁ ਕਿਛੁ ਸੁਝੈ ॥",
      "transliteration": "prabh kai simaran sabh kichh sujhai ||",
      "translation": "In the remembrance of God, all things are known.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ ਨਾਹੀ ਜਮ ਤ੍ਰਾਸਾ ॥",
      "transliteration": "prabh kai simaran naahee jam traasaa ||",
      "translation": "In the remembrance of God, there is no fear of death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ ਪੂਰਨ ਆਸਾ ॥",
      "transliteration": "prabh kai simaran pooran aasaa ||",
      "translation": "In the remembrance of God, hopes are fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ ਮਨ ਕੀ ਮਲੁ ਜਾਇ ॥",
      "transliteration": "prabh kai simaran man kee mal jaai ||",
      "translation": "In the remembrance of God, the filth of the mind is removed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਰਿਦ ਮਾਹਿ ਸਮਾਇ ॥",
      "transliteration": "a(n)mrit naam rid maahi samaai ||",
      "translation": "The Ambrosial Naam, the Name of the Lord, is absorbed into the heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪ੍ਰਭ ਜੀ ਬਸਹਿ ਸਾਧ ਕੀ ਰਸਨਾ ॥",
      "transliteration": "prabh jee basahi saadh kee rasanaa ||",
      "translation": "God abides upon the tongues of His Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਨਕ ਜਨ ਕਾ ਦਾਸਨਿ ਦਸਨਾ ॥੪॥",
      "transliteration": "naanak jan kaa daasan dasanaa ||4||",
      "translation": "Nanak is the servant of the slave of His slaves. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਸੇ ਧਨਵੰਤੇ ॥",
      "transliteration": "prabh kau simarahi se dhanava(n)te ||",
      "translation": "Those who remember God are wealthy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਸੇ ਪਤਿਵੰਤੇ ॥",
      "transliteration": "prabh kau simarahi se pativa(n)te ||",
      "translation": "Those who remember God are honorable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਸੇ ਜਨ ਪਰਵਾਨ ॥",
      "transliteration": "prabh kau simarahi se jan paravaan ||",
      "translation": "Those who remember God are approved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਸੇ ਪੁਰਖ ਪ੍ਰਧਾਨ ॥",
      "transliteration": "prabh kau simarahi se purakh pradhaan ||",
      "translation": "Those who remember God are the most distinguished persons.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਸਿ ਬੇਮੁਹਤਾਜੇ ॥",
      "transliteration": "prabh kau simarahi s bemuhataaje ||",
      "translation": "Those who remember God are not lacking.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਸਿ ਸਰਬ ਕੇ ਰਾਜੇ ॥",
      "transliteration": "prabh kau simarahi s sarab ke raaje ||",
      "translation": "Those who remember God are the rulers of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਸੇ ਸੁਖਵਾਸੀ ॥",
      "transliteration": "prabh kau simarahi se sukhavaasee ||",
      "translation": "Those who remember God dwell in peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਸਦਾ ਅਬਿਨਾਸੀ ॥",
      "transliteration": "prabh kau simarahi sadaa abinaasee ||",
      "translation": "Those who remember God are immortal and eternal.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਿਮਰਨ ਤੇ ਲਾਗੇ ਜਿਨ ਆਪਿ ਦਇਆਲਾ ॥",
      "transliteration": "simaran te laage jin aap daiaalaa ||",
      "translation": "They alone hold to the remembrance of Him, unto whom He Himself shows His Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਨਕ ਜਨ ਕੀ ਮੰਗੈ ਰਵਾਲਾ ॥੫॥",
      "transliteration": "naanak jan kee ma(n)gai ravaalaa ||5||",
      "translation": "Nanak begs for the dust of their feet. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਸੇ ਪਰਉਪਕਾਰੀ ॥",
      "transliteration": "prabh kau simarahi se paraupakaaree ||",
      "translation": "Those who remember God generously help others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਤਿਨ ਸਦ ਬਲਿਹਾਰੀ ॥",
      "transliteration": "prabh kau simarahi tin sad balihaaree ||",
      "translation": "Those who remember God - to them, I am forever a sacrifice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਸੇ ਮੁਖ ਸੁਹਾਵੇ ॥",
      "transliteration": "prabh kau simarahi se mukh suhaave ||",
      "translation": "Those who remember God - their faces are beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਤਿਨ ਸੂਖਿ ਬਿਹਾਵੈ ॥",
      "transliteration": "prabh kau simarahi tin sookh bihaavai ||",
      "translation": "Those who remember God abide in peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਤਿਨ ਆਤਮੁ ਜੀਤਾ ॥",
      "transliteration": "prabh kau simarahi tin aatam jeetaa ||",
      "translation": "Those who remember God conquer their souls.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਤਿਨ ਨਿਰਮਲ ਰੀਤਾ ॥",
      "transliteration": "prabh kau simarahi tin niramal reetaa ||",
      "translation": "Those who remember God have a pure and spotless lifestyle.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਤਿਨ ਅਨਦ ਘਨੇਰੇ ॥",
      "transliteration": "prabh kau simarahi tin anad ghanere ||",
      "translation": "Those who remember God experience all sorts of joys.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪ੍ਰਭ ਕਉ ਸਿਮਰਹਿ ਬਸਹਿ ਹਰਿ ਨੇਰੇ ॥",
      "transliteration": "prabh kau simarahi basahi har nere ||",
      "translation": "Those who remember God abide near the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੰਤ ਕ੍ਰਿਪਾ ਤੇ ਅਨਦਿਨੁ ਜਾਗਿ ॥",
      "transliteration": "sa(n)t kripaa te anadin jaag ||",
      "translation": "By the Grace of the Saints, one remains awake and aware, night and day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾਨਕ ਸਿਮਰਨੁ ਪੂਰੈ ਭਾਗਿ ॥੬॥",
      "transliteration": "naanak simaran poorai bhaag ||6||",
      "translation": "O Nanak, this meditative remembrance comes only by perfect destiny. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ ਕਾਰਜ ਪੂਰੇ ॥",
      "transliteration": "prabh kai simaran kaaraj poore ||",
      "translation": "Remembering God, one's works are accomplished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ ਕਬਹੁ ਨ ਝੂਰੇ ॥",
      "transliteration": "prabh kai simaran kabahu na jhoore ||",
      "translation": "Remembering God, one never grieves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ ਹਰਿ ਗੁਨ ਬਾਨੀ ॥",
      "transliteration": "prabh kai simaran har gun baanee ||",
      "translation": "Remembering God, one speaks the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ ਸਹਜਿ ਸਮਾਨੀ ॥",
      "transliteration": "prabh kai simaran sahaj samaanee ||",
      "translation": "Remembering God, one is absorbed into the state of intuitive ease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ ਨਿਹਚਲ ਆਸਨੁ ॥",
      "transliteration": "prabh kai simaran nihachal aasan ||",
      "translation": "Remembering God, one attains the unchanging position.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ ਕਮਲ ਬਿਗਾਸਨੁ ॥",
      "transliteration": "prabh kai simaran kamal bigaasan ||",
      "translation": "Remembering God, the heart-lotus blossoms forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਸਿਮਰਨਿ ਅਨਹਦ ਝੁਨਕਾਰ ॥",
      "transliteration": "prabh kai simaran anahad jhunakaar ||",
      "translation": "Remembering God, the unstruck melody vibrates.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੁਖੁ ਪ੍ਰਭ ਸਿਮਰਨ ਕਾ ਅੰਤੁ ਨ ਪਾਰ ॥",
      "transliteration": "sukh prabh simaran kaa a(n)t na paar ||",
      "translation": "The peace of the meditative remembrance of God has no end or limitation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਿਮਰਹਿ ਸੇ ਜਨ ਜਿਨ ਕਉ ਪ੍ਰਭ ਮਇਆ ॥",
      "transliteration": "simarahi se jan jin kau prabh maiaa ||",
      "translation": "They alone remember Him, upon whom God bestows His Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਨਕ ਤਿਨ ਜਨ ਸਰਨੀ ਪਇਆ ॥੭॥",
      "transliteration": "naanak tin jan saranee paiaa ||7||",
      "translation": "Nanak seeks the Sanctuary of those humble beings. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨੁ ਕਰਿ ਭਗਤ ਪ੍ਰਗਟਾਏ ॥",
      "transliteration": "har simaran kar bhagat pragataae ||",
      "translation": "Remembering the Lord, His devotees are famous and radiant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨਿ ਲਗਿ ਬੇਦ ਉਪਾਏ ॥",
      "transliteration": "har simaran lag bed upaae ||",
      "translation": "Remembering the Lord, the Vedas were composed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨਿ ਭਏ ਸਿਧ ਜਤੀ ਦਾਤੇ ॥",
      "transliteration": "har simaran bhae sidh jatee daate ||",
      "translation": "Remembering the Lord, we become Siddhas, celibates and givers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨਿ ਨੀਚ ਚਹੁ ਕੁੰਟ ਜਾਤੇ ॥",
      "transliteration": "har simaran neech chahu ku(n)t jaate ||",
      "translation": "Remembering the Lord, the lowly become known in all four directions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨਿ ਧਾਰੀ ਸਭ ਧਰਨਾ ॥",
      "transliteration": "har simaran dhaaree sabh dharanaa ||",
      "translation": "For the remembrance of the Lord, the whole world was established.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਹਰਿ ਕਾਰਨ ਕਰਨਾ ॥",
      "transliteration": "simar simar har kaaran karanaa ||",
      "translation": "Remember, remember in meditation the Lord, the Creator, the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨਿ ਕੀਓ ਸਗਲ ਅਕਾਰਾ ॥",
      "transliteration": "har simaran keeo sagal akaaraa ||",
      "translation": "For the remembrance of the Lord, He created the whole creation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨ ਮਹਿ ਆਪਿ ਨਿਰੰਕਾਰਾ ॥",
      "transliteration": "har simaran mahi aap nira(n)kaaraa ||",
      "translation": "In the remembrance of the Lord, He Himself is Formless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਆਪਿ ਬੁਝਾਇਆ ॥",
      "transliteration": "kar kirapaa jis aap bujhaaiaa ||",
      "translation": "By His Grace, He Himself bestows understanding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਹਰਿ ਸਿਮਰਨੁ ਤਿਨਿ ਪਾਇਆ ॥੮॥੧॥",
      "transliteration": "naanak guramukh har simaran tin paaiaa ||8||1||",
      "translation": "O Nanak, the Gurmukh attains the remembrance of the Lord. ||8||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਦੀਨ ਦਰਦ ਦੁਖ ਭੰਜਨਾ ਘਟਿ ਘਟਿ ਨਾਥ ਅਨਾਥ ॥",
      "transliteration": "deen darad dukh bha(n)janaa ghat ghat naath anaath ||",
      "translation": "O Destroyer of the pains and the suffering of the poor, O Master of each and every heart, O Masterless One:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0263_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਰਣਿ ਤੁਮੑਾਰੀ ਆਇਓ ਨਾਨਕ ਕੇ ਪ੍ਰਭ ਸਾਥ ॥੧॥",
      "transliteration": "saran tumhaaree aaio naanak ke prabh saath ||1||",
      "translation": "I have come seeking Your Sanctuary. O God, please be with Nanak! ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 263,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
