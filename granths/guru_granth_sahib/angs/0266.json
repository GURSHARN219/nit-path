{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 266,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0266_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਨਿਕ ਜਤਨ ਕਰਿ ਤ੍ਰਿਸਨ ਨਾ ਧ੍ਰਾਪੈ ॥",
      "transliteration": "anik jatan kar trisan naa dhraapai ||",
      "translation": "You try all sorts of things, but your thirst is still not satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭੇਖ ਅਨੇਕ ਅਗਨਿ ਨਹੀ ਬੁਝੈ ॥",
      "transliteration": "bhekh anek agan nahee bujhai ||",
      "translation": "Wearing various religious robes, the fire is not extinguished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕੋਟਿ ਉਪਾਵ ਦਰਗਹ ਨਹੀ ਸਿਝੈ ॥",
      "transliteration": "kot upaav daragah nahee sijhai ||",
      "translation": "Even making millions of efforts, you shall not be accepted in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਛੂਟਸਿ ਨਾਹੀ ਊਭ ਪਇਆਲਿ ॥",
      "transliteration": "chhootas naahee oobh paiaal ||",
      "translation": "You cannot escape to the heavens, or to the nether regions,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮੋਹਿ ਬਿਆਪਹਿ ਮਾਇਆ ਜਾਲਿ ॥",
      "transliteration": "mohi biaapahi maaiaa jaal ||",
      "translation": "if you are entangled in emotional attachment and the net of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਵਰ ਕਰਤੂਤਿ ਸਗਲੀ ਜਮੁ ਡਾਨੈ ॥",
      "transliteration": "avar karatoot sagalee jam daanai ||",
      "translation": "All other efforts are punished by the Messenger of Death,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੋਵਿੰਦ ਭਜਨ ਬਿਨੁ ਤਿਲੁ ਨਹੀ ਮਾਨੈ ॥",
      "transliteration": "govi(n)d bhajan bin til nahee maanai ||",
      "translation": "which accepts nothing at all, except meditation on the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਜਪਤ ਦੁਖੁ ਜਾਇ ॥",
      "transliteration": "har kaa naam japat dukh jaai ||",
      "translation": "Chanting the Name of the Lord, sorrow is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਨਕ ਬੋਲੈ ਸਹਜਿ ਸੁਭਾਇ ॥੪॥",
      "transliteration": "naanak bolai sahaj subhaai ||4||",
      "translation": "O Nanak, chant it with intuitive ease. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਾਰਿ ਪਦਾਰਥ ਜੇ ਕੋ ਮਾਗੈ ॥",
      "transliteration": "chaar padaarath je ko maagai ||",
      "translation": "One who prays for the four cardinal blessings",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਾਧ ਜਨਾ ਕੀ ਸੇਵਾ ਲਾਗੈ ॥",
      "transliteration": "saadh janaa kee sevaa laagai ||",
      "translation": "should commit himself to the service of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੇ ਕੋ ਆਪੁਨਾ ਦੂਖੁ ਮਿਟਾਵੈ ॥",
      "transliteration": "je ko aapunaa dookh mitaavai ||",
      "translation": "If you wish to erase your sorrows,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਰਿਦੈ ਸਦ ਗਾਵੈ ॥",
      "transliteration": "har har naam ridai sad gaavai ||",
      "translation": "sing the Name of the Lord, Har, Har, within your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜੇ ਕੋ ਅਪੁਨੀ ਸੋਭਾ ਲੋਰੈ ॥",
      "transliteration": "je ko apunee sobhaa lorai ||",
      "translation": "If you long for honor for yourself,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਇਹ ਹਉਮੈ ਛੋਰੈ ॥",
      "transliteration": "saadhasa(n)g ih haumai chhorai ||",
      "translation": "then renounce your ego in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੇ ਕੋ ਜਨਮ ਮਰਣ ਤੇ ਡਰੈ ॥",
      "transliteration": "je ko janam maran te darai ||",
      "translation": "If you fear the cycle of birth and death,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਾਧ ਜਨਾ ਕੀ ਸਰਨੀ ਪਰੈ ॥",
      "transliteration": "saadh janaa kee saranee parai ||",
      "translation": "then seek the Sanctuary of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਸੁ ਜਨ ਕਉ ਪ੍ਰਭ ਦਰਸ ਪਿਆਸਾ ॥",
      "transliteration": "jis jan kau prabh daras piaasaa ||",
      "translation": "Those who thirst for the Blessed Vision of God's Darshan",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕੈ ਬਲਿ ਬਲਿ ਜਾਸਾ ॥੫॥",
      "transliteration": "naanak taa kai bal bal jaasaa ||5||",
      "translation": "- Nanak is a sacrifice, a sacrifice to them. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਗਲ ਪੁਰਖ ਮਹਿ ਪੁਰਖੁ ਪ੍ਰਧਾਨੁ ॥",
      "transliteration": "sagal purakh mahi purakh pradhaan ||",
      "translation": "Among all persons, the supreme person is the one",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਜਾ ਕਾ ਮਿਟੈ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "saadhasa(n)g jaa kaa mitai abhimaan ||",
      "translation": "who gives up his egotistical pride in the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਪਸ ਕਉ ਜੋ ਜਾਣੈ ਨੀਚਾ ॥",
      "transliteration": "aapas kau jo jaanai neechaa ||",
      "translation": "One who sees himself as lowly,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋਊ ਗਨੀਐ ਸਭ ਤੇ ਊਚਾ ॥",
      "transliteration": "sooo ganeeai sabh te oochaa ||",
      "translation": "shall be accounted as the highest of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਾ ਕਾ ਮਨੁ ਹੋਇ ਸਗਲ ਕੀ ਰੀਨਾ ॥",
      "transliteration": "jaa kaa man hoi sagal kee reenaa ||",
      "translation": "One whose mind is the dust of all,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਤਿਨਿ ਘਟਿ ਘਟਿ ਚੀਨਾ ॥",
      "transliteration": "har har naam tin ghat ghat cheenaa ||",
      "translation": "recognizes the Name of the Lord, Har, Har, in each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨ ਅਪੁਨੇ ਤੇ ਬੁਰਾ ਮਿਟਾਨਾ ॥",
      "transliteration": "man apune te buraa mitaanaa ||",
      "translation": "One who eradicates cruelty from within his own mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੇਖੈ ਸਗਲ ਸ੍ਰਿਸਟਿ ਸਾਜਨਾ ॥",
      "transliteration": "pekhai sagal srisat saajanaa ||",
      "translation": "looks upon all the world as his friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੂਖ ਦੂਖ ਜਨ ਸਮ ਦ੍ਰਿਸਟੇਤਾ ॥",
      "transliteration": "sookh dookh jan sam drisatetaa ||",
      "translation": "One who looks upon pleasure and pain as one and the same,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਨਕ ਪਾਪ ਪੁੰਨ ਨਹੀ ਲੇਪਾ ॥੬॥",
      "transliteration": "naanak paap pu(n)n nahee lepaa ||6||",
      "translation": "O Nanak, is not affected by sin or virtue. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਿਰਧਨ ਕਉ ਧਨੁ ਤੇਰੋ ਨਾਉ ॥",
      "transliteration": "niradhan kau dhan tero naau ||",
      "translation": "To the poor, Your Name is wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਿਥਾਵੇ ਕਉ ਨਾਉ ਤੇਰਾ ਥਾਉ ॥",
      "transliteration": "nithaave kau naau teraa thaau ||",
      "translation": "To the homeless, Your Name is home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਿਮਾਨੇ ਕਉ ਪ੍ਰਭ ਤੇਰੋ ਮਾਨੁ ॥",
      "transliteration": "nimaane kau prabh tero maan ||",
      "translation": "To the dishonored, You, O God, are honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਗਲ ਘਟਾ ਕਉ ਦੇਵਹੁ ਦਾਨੁ ॥",
      "transliteration": "sagal ghataa kau devahu daan ||",
      "translation": "To all, You are the Giver of gifts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨਹਾਰ ਸੁਆਮੀ ॥",
      "transliteration": "karan karaavanahaar suaamee ||",
      "translation": "O Creator Lord, Cause of causes, O Lord and Master,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਗਲ ਘਟਾ ਕੇ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "sagal ghataa ke a(n)tarajaamee ||",
      "translation": "Inner-knower, Searcher of all hearts:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਪਨੀ ਗਤਿ ਮਿਤਿ ਜਾਨਹੁ ਆਪੇ ॥",
      "transliteration": "apanee gat mit jaanahu aape ||",
      "translation": "You alone know Your own condition and state.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਪਨ ਸੰਗਿ ਆਪਿ ਪ੍ਰਭ ਰਾਤੇ ॥",
      "transliteration": "aapan sa(n)g aap prabh raate ||",
      "translation": "You Yourself, God, are imbued with Yourself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੁਮੑਰੀ ਉਸਤਤਿ ਤੁਮ ਤੇ ਹੋਇ ॥",
      "transliteration": "tumhree usatat tum te hoi ||",
      "translation": "You alone can celebrate Your Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਨਕ ਅਵਰੁ ਨ ਜਾਨਸਿ ਕੋਇ ॥੭॥",
      "transliteration": "naanak avar na jaanas koi ||7||",
      "translation": "O Nanak, no one else knows. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਰਬ ਧਰਮ ਮਹਿ ਸ੍ਰੇਸਟ ਧਰਮੁ ॥",
      "transliteration": "sarab dharam mahi sresat dharam ||",
      "translation": "Of all religions, the best religion",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਰਿ ਕੋ ਨਾਮੁ ਜਪਿ ਨਿਰਮਲ ਕਰਮੁ ॥",
      "transliteration": "har ko naam jap niramal karam ||",
      "translation": "is to chant the Name of the Lord and maintain pure conduct.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਗਲ ਕ੍ਰਿਆ ਮਹਿ ਊਤਮ ਕਿਰਿਆ ॥",
      "transliteration": "sagal kriaa mahi ootam kiriaa ||",
      "translation": "Of all religious rituals, the most sublime ritual",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਦੁਰਮਤਿ ਮਲੁ ਹਿਰਿਆ ॥",
      "transliteration": "saadhasa(n)g duramat mal hiriaa ||",
      "translation": "is to erase the filth of the dirty mind in the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਗਲ ਉਦਮ ਮਹਿ ਉਦਮੁ ਭਲਾ ॥",
      "transliteration": "sagal udam mahi udam bhalaa ||",
      "translation": "Of all efforts, the best effort",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਜਪਹੁ ਜੀਅ ਸਦਾ ॥",
      "transliteration": "har kaa naam japahu jee sadaa ||",
      "translation": "is to chant the Name of the Lord in the heart, forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਗਲ ਬਾਨੀ ਮਹਿ ਅੰਮ੍ਰਿਤ ਬਾਨੀ ॥",
      "transliteration": "sagal baanee mahi a(n)mrit baanee ||",
      "translation": "Of all speech, the most ambrosial speech",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਰਿ ਕੋ ਜਸੁ ਸੁਨਿ ਰਸਨ ਬਖਾਨੀ ॥",
      "transliteration": "har ko jas sun rasan bakhaanee ||",
      "translation": "is to hear the Lord's Praise and chant it with the tongue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਗਲ ਥਾਨ ਤੇ ਓਹੁ ਊਤਮ ਥਾਨੁ ॥",
      "transliteration": "sagal thaan te ohu ootam thaan ||",
      "translation": "Of all places, the most sublime place,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਨਕ ਜਿਹ ਘਟਿ ਵਸੈ ਹਰਿ ਨਾਮੁ ॥੮॥੩॥",
      "transliteration": "naanak jih ghat vasai har naam ||8||3||",
      "translation": "O Nanak, is that heart in which the Name of the Lord abides. ||8||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਿਰਗੁਨੀਆਰ ਇਆਨਿਆ ਸੋ ਪ੍ਰਭੁ ਸਦਾ ਸਮਾਲਿ ॥",
      "transliteration": "niraguneeaar iaaniaa so prabh sadaa samaal ||",
      "translation": "You worthless, ignorant fool - dwell upon God forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਿਨਿ ਕੀਆ ਤਿਸੁ ਚੀਤਿ ਰਖੁ ਨਾਨਕ ਨਿਬਹੀ ਨਾਲਿ ॥੧॥",
      "transliteration": "jin keeaa tis cheet rakh naanak nibahee naal ||1||",
      "translation": "Cherish in your consciousness the One who created you; O Nanak, He alone shall go along with you. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਰਮਈਆ ਕੇ ਗੁਨ ਚੇਤਿ ਪਰਾਨੀ ॥",
      "transliteration": "ramaeeaa ke gun chet paraanee ||",
      "translation": "Think of the Glory of the All-pervading Lord, O mortal;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਵਨ ਮੂਲ ਤੇ ਕਵਨ ਦ੍ਰਿਸਟਾਨੀ ॥",
      "transliteration": "kavan mool te kavan drisataanee ||",
      "translation": "what is your origin, and what is your appearance?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਜਿਨਿ ਤੂੰ ਸਾਜਿ ਸਵਾਰਿ ਸੀਗਾਰਿਆ ॥",
      "transliteration": "jin too(n) saaj savaar seegaariaa ||",
      "translation": "He who fashioned, adorned and decorated you",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗਰਭ ਅਗਨਿ ਮਹਿ ਜਿਨਹਿ ਉਬਾਰਿਆ ॥",
      "transliteration": "garabh agan mahi jinahi ubaariaa ||",
      "translation": "in the fire of the womb, He preserved you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਬਾਰ ਬਿਵਸਥਾ ਤੁਝਹਿ ਪਿਆਰੈ ਦੂਧ ॥",
      "transliteration": "baar bivasathaa tujhahi piaarai doodh ||",
      "translation": "In your infancy, He gave you milk to drink.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਭਰਿ ਜੋਬਨ ਭੋਜਨ ਸੁਖ ਸੂਧ ॥",
      "transliteration": "bhar joban bhojan sukh soodh ||",
      "translation": "In the flower of your youth, He gave you food, pleasure and understanding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0266_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਬਿਰਧਿ ਭਇਆ ਊਪਰਿ ਸਾਕ ਸੈਨ ॥",
      "transliteration": "biradh bhaiaa oopar saak sain ||",
      "translation": "As you grow old, family and friends,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 266,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
