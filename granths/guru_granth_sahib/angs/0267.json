{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 267,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0267_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮੁਖਿ ਅਪਿਆਉ ਬੈਠ ਕਉ ਦੈਨ ॥",
      "transliteration": "mukh apiaau baith kau dain ||",
      "translation": "Are there to feed you as you rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਹੁ ਨਿਰਗੁਨੁ ਗੁਨੁ ਕਛੂ ਨ ਬੂਝੈ ॥",
      "transliteration": "ihu niragun gun kachhoo na boojhai ||",
      "translation": "This worthless person has not appreciated in the least, all the good deeds done for him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਖਸਿ ਲੇਹੁ ਤਉ ਨਾਨਕ ਸੀਝੈ ॥੧॥",
      "transliteration": "bakhas lehu tau naanak seejhai ||1||",
      "translation": "If you bless him with forgiveness, O Nanak, only then will he be saved. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਧਰ ਊਪਰਿ ਸੁਖਿ ਬਸਹਿ ॥",
      "transliteration": "jih prasaad dhar oopar sukh basahi ||",
      "translation": "By His Grace, you abide in comfort upon the earth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੁਤ ਭ੍ਰਾਤ ਮੀਤ ਬਨਿਤਾ ਸੰਗਿ ਹਸਹਿ ॥",
      "transliteration": "sut bhraat meet banitaa sa(n)g hasahi ||",
      "translation": "With your children, siblings, friends and spouse, you laugh.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਪੀਵਹਿ ਸੀਤਲ ਜਲਾ ॥",
      "transliteration": "jih prasaad peevahi seetal jalaa ||",
      "translation": "By His Grace, you drink in cool water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਖਦਾਈ ਪਵਨੁ ਪਾਵਕੁ ਅਮੁਲਾ ॥",
      "transliteration": "sukhadaaee pavan paavak amulaa ||",
      "translation": "You have peaceful breezes and priceless fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਭੋਗਹਿ ਸਭਿ ਰਸਾ ॥",
      "transliteration": "jih prasaad bhogahi sabh rasaa ||",
      "translation": "By His Grace, you enjoy all sorts of pleasures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਗਲ ਸਮਗ੍ਰੀ ਸੰਗਿ ਸਾਥਿ ਬਸਾ ॥",
      "transliteration": "sagal samagree sa(n)g saath basaa ||",
      "translation": "You are provided with all the necessities of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੀਨੇ ਹਸਤ ਪਾਵ ਕਰਨ ਨੇਤ੍ਰ ਰਸਨਾ ॥",
      "transliteration": "deene hasat paav karan netr rasanaa ||",
      "translation": "He gave you hands, feet, ears, eyes and tongue,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਿਸਹਿ ਤਿਆਗਿ ਅਵਰ ਸੰਗਿ ਰਚਨਾ ॥",
      "transliteration": "tisahi tiaag avar sa(n)g rachanaa ||",
      "translation": "and yet, you forsake Him and attach yourself to others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਐਸੇ ਦੋਖ ਮੂੜ ਅੰਧ ਬਿਆਪੇ ॥",
      "transliteration": "aise dokh mooR a(n)dh biaape ||",
      "translation": "Such sinful mistakes cling to the blind fools;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਨਕ ਕਾਢਿ ਲੇਹੁ ਪ੍ਰਭ ਆਪੇ ॥੨॥",
      "transliteration": "naanak kaadh lehu prabh aape ||2||",
      "translation": "Nanak: uplift and save them, God! ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਦਿ ਅੰਤਿ ਜੋ ਰਾਖਨਹਾਰੁ ॥",
      "transliteration": "aad a(n)t jo raakhanahaar ||",
      "translation": "From beginning to end, He is our Protector,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਿਸ ਸਿਉ ਪ੍ਰੀਤਿ ਨ ਕਰੈ ਗਵਾਰੁ ॥",
      "transliteration": "tis siu preet na karai gavaar ||",
      "translation": "and yet, the ignorant do not give their love to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾ ਕੀ ਸੇਵਾ ਨਵ ਨਿਧਿ ਪਾਵੈ ॥",
      "transliteration": "jaa kee sevaa nav nidh paavai ||",
      "translation": "Serving Him, the nine treasures are obtained,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾ ਸਿਉ ਮੂੜਾ ਮਨੁ ਨਹੀ ਲਾਵੈ ॥",
      "transliteration": "taa siu mooRaa man nahee laavai ||",
      "translation": "and yet, the foolish do not link their minds with Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੋ ਠਾਕੁਰੁ ਸਦ ਸਦਾ ਹਜੂਰੇ ॥",
      "transliteration": "jo thaakur sad sadaa hajoore ||",
      "translation": "Our Lord and Master is Ever-present, forever and ever,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਕਉ ਅੰਧਾ ਜਾਨਤ ਦੂਰੇ ॥",
      "transliteration": "taa kau a(n)dhaa jaanat doore ||",
      "translation": "and yet, the spiritually blind believe that He is far away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਾ ਕੀ ਟਹਲ ਪਾਵੈ ਦਰਗਹ ਮਾਨੁ ॥",
      "transliteration": "jaa kee tahal paavai daragah maan ||",
      "translation": "In His service, one obtains honor in the Court of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਿਸਹਿ ਬਿਸਾਰੈ ਮੁਗਧੁ ਅਜਾਨੁ ॥",
      "transliteration": "tisahi bisaarai mugadh ajaan ||",
      "translation": "and yet, the ignorant fool forgets Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਇਹੁ ਭੂਲਨਹਾਰੁ ॥",
      "transliteration": "sadaa sadaa ihu bhoolanahaar ||",
      "translation": "Forever and ever, this person makes mistakes;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਨਕ ਰਾਖਨਹਾਰੁ ਅਪਾਰੁ ॥੩॥",
      "transliteration": "naanak raakhanahaar apaar ||3||",
      "translation": "O Nanak, the Infinite Lord is our Saving Grace. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਤਨੁ ਤਿਆਗਿ ਕਉਡੀ ਸੰਗਿ ਰਚੈ ॥",
      "transliteration": "ratan tiaag kaudee sa(n)g rachai ||",
      "translation": "Forsaking the jewel, they are engrossed with a shell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਾਚੁ ਛੋਡਿ ਝੂਠ ਸੰਗਿ ਮਚੈ ॥",
      "transliteration": "saach chhod jhooth sa(n)g machai ||",
      "translation": "They renounce Truth and embrace falsehood.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੋ ਛਡਨਾ ਸੁ ਅਸਥਿਰੁ ਕਰਿ ਮਾਨੈ ॥",
      "transliteration": "jo chhadanaa s asathir kar maanai ||",
      "translation": "That which passes away, they believe to be permanent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੋ ਹੋਵਨੁ ਸੋ ਦੂਰਿ ਪਰਾਨੈ ॥",
      "transliteration": "jo hovan so door paraanai ||",
      "translation": "That which is immanent, they believe to be far off.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਛੋਡਿ ਜਾਇ ਤਿਸ ਕਾ ਸ੍ਰਮੁ ਕਰੈ ॥",
      "transliteration": "chhod jaai tis kaa sram karai ||",
      "translation": "They struggle for what they must eventually leave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੰਗਿ ਸਹਾਈ ਤਿਸੁ ਪਰਹਰੈ ॥",
      "transliteration": "sa(n)g sahaaee tis paraharai ||",
      "translation": "They turn away from the Lord, their Help and Support, who is always with them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚੰਦਨ ਲੇਪੁ ਉਤਾਰੈ ਧੋਇ ॥",
      "transliteration": "cha(n)dan lep utaarai dhoi ||",
      "translation": "They wash off the sandalwood paste;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗਰਧਬ ਪ੍ਰੀਤਿ ਭਸਮ ਸੰਗਿ ਹੋਇ ॥",
      "transliteration": "garadhab preet bhasam sa(n)g hoi ||",
      "translation": "like donkeys, they are in love with the mud.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅੰਧ ਕੂਪ ਮਹਿ ਪਤਿਤ ਬਿਕਰਾਲ ॥",
      "transliteration": "a(n)dh koop mahi patit bikaraal ||",
      "translation": "They have fallen into the deep, dark pit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਨਕ ਕਾਢਿ ਲੇਹੁ ਪ੍ਰਭ ਦਇਆਲ ॥੪॥",
      "transliteration": "naanak kaadh lehu prabh daiaal ||4||",
      "translation": "Nanak: lift them up and save them, O Merciful Lord God! ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਰਤੂਤਿ ਪਸੂ ਕੀ ਮਾਨਸ ਜਾਤਿ ॥",
      "transliteration": "karatoot pasoo kee maanas jaat ||",
      "translation": "They belong to the human species, but they act like animals.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਲੋਕ ਪਚਾਰਾ ਕਰੈ ਦਿਨੁ ਰਾਤਿ ॥",
      "transliteration": "lok pachaaraa karai din raat ||",
      "translation": "They curse others day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਾਹਰਿ ਭੇਖ ਅੰਤਰਿ ਮਲੁ ਮਾਇਆ ॥",
      "transliteration": "baahar bhekh a(n)tar mal maaiaa ||",
      "translation": "Outwardly, they wear religious robes, but within is the filth of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਛਪਸਿ ਨਾਹਿ ਕਛੁ ਕਰੈ ਛਪਾਇਆ ॥",
      "transliteration": "chhapas naahi kachh karai chhapaaiaa ||",
      "translation": "They cannot conceal this, no matter how hard they try.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਾਹਰਿ ਗਿਆਨ ਧਿਆਨ ਇਸਨਾਨ ॥",
      "transliteration": "baahar giaan dhiaan isanaan ||",
      "translation": "Outwardly, they display knowledge, meditation and purification,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅੰਤਰਿ ਬਿਆਪੈ ਲੋਭੁ ਸੁਆਨੁ ॥",
      "transliteration": "a(n)tar biaapai lobh suaan ||",
      "translation": "but within clings the dog of greed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅੰਤਰਿ ਅਗਨਿ ਬਾਹਰਿ ਤਨੁ ਸੁਆਹ ॥",
      "transliteration": "a(n)tar agan baahar tan suaah ||",
      "translation": "The fire of desire rages within; outwardly they apply ashes to their bodies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗਲਿ ਪਾਥਰ ਕੈਸੇ ਤਰੈ ਅਥਾਹ ॥",
      "transliteration": "gal paathar kaise tarai athaah ||",
      "translation": "There is a stone around their neck - how can they cross the unfathomable ocean?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਾ ਕੈ ਅੰਤਰਿ ਬਸੈ ਪ੍ਰਭੁ ਆਪਿ ॥",
      "transliteration": "jaa kai a(n)tar basai prabh aap ||",
      "translation": "Those, within whom God Himself abides",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਨਕ ਤੇ ਜਨ ਸਹਜਿ ਸਮਾਤਿ ॥੫॥",
      "transliteration": "naanak te jan sahaj samaat ||5||",
      "translation": "- O Nanak, those humble beings are intuitively absorbed in the Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੁਨਿ ਅੰਧਾ ਕੈਸੇ ਮਾਰਗੁ ਪਾਵੈ ॥",
      "transliteration": "sun a(n)dhaa kaise maarag paavai ||",
      "translation": "By listening, how can the blind find the path?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਰੁ ਗਹਿ ਲੇਹੁ ਓੜਿ ਨਿਬਹਾਵੈ ॥",
      "transliteration": "kar gahi lehu oR nibahaavai ||",
      "translation": "Take hold of his hand, and then he can reach his destination.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਹਾ ਬੁਝਾਰਤਿ ਬੂਝੈ ਡੋਰਾ ॥",
      "transliteration": "kahaa bujhaarat boojhai doraa ||",
      "translation": "How can a riddle be understood by the deaf?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਿਸਿ ਕਹੀਐ ਤਉ ਸਮਝੈ ਭੋਰਾ ॥",
      "transliteration": "nis kaheeai tau samajhai bhoraa ||",
      "translation": "Say 'night', and he thinks you said 'day'.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਹਾ ਬਿਸਨਪਦ ਗਾਵੈ ਗੁੰਗ ॥",
      "transliteration": "kahaa bisanapad gaavai gu(n)g ||",
      "translation": "How can the mute sing the Songs of the Lord?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਤਨ ਕਰੈ ਤਉ ਭੀ ਸੁਰ ਭੰਗ ॥",
      "transliteration": "jatan karai tau bhee sur bha(n)g ||",
      "translation": "He may try, but his voice will fail him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਹ ਪਿੰਗੁਲ ਪਰਬਤ ਪਰ ਭਵਨ ॥",
      "transliteration": "kah pi(n)gul parabat par bhavan ||",
      "translation": "How can the cripple climb up the mountain?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਹੀ ਹੋਤ ਊਹਾ ਉਸੁ ਗਵਨ ॥",
      "transliteration": "nahee hot oohaa us gavan ||",
      "translation": "He simply cannot go there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਰਤਾਰ ਕਰੁਣਾ ਮੈ ਦੀਨੁ ਬੇਨਤੀ ਕਰੈ ॥",
      "transliteration": "karataar karunaa mai deen benatee karai ||",
      "translation": "O Creator, Lord of Mercy - Your humble servant prays;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾਨਕ ਤੁਮਰੀ ਕਿਰਪਾ ਤਰੈ ॥੬॥",
      "transliteration": "naanak tumaree kirapaa tarai ||6||",
      "translation": "Nanak: by Your Grace, please save me. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੰਗਿ ਸਹਾਈ ਸੁ ਆਵੈ ਨ ਚੀਤਿ ॥",
      "transliteration": "sa(n)g sahaaee s aavai na cheet ||",
      "translation": "The Lord, our Help and Support, is always with us, but the mortal does not remember Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜੋ ਬੈਰਾਈ ਤਾ ਸਿਉ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "jo bairaaee taa siu preet ||",
      "translation": "He shows love to his enemies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਬਲੂਆ ਕੇ ਗ੍ਰਿਹ ਭੀਤਰਿ ਬਸੈ ॥",
      "transliteration": "balooaa ke grih bheetar basai ||",
      "translation": "He lives in a castle of sand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਅਨਦ ਕੇਲ ਮਾਇਆ ਰੰਗਿ ਰਸੈ ॥",
      "transliteration": "anad kel maaiaa ra(n)g rasai ||",
      "translation": "He enjoys the games of pleasure and the tastes of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਦ੍ਰਿੜੁ ਕਰਿ ਮਾਨੈ ਮਨਹਿ ਪ੍ਰਤੀਤਿ ॥",
      "transliteration": "driR kar maanai manahi prateet ||",
      "translation": "He believes them to be permanent - this is the belief of his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਾਲੁ ਨ ਆਵੈ ਮੂੜੇ ਚੀਤਿ ॥",
      "transliteration": "kaal na aavai mooRe cheet ||",
      "translation": "Death does not even come to mind for the fool.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਬੈਰ ਬਿਰੋਧ ਕਾਮ ਕ੍ਰੋਧ ਮੋਹ ॥",
      "transliteration": "bair birodh kaam krodh moh ||",
      "translation": "Hate, conflict, sexual desire, anger, emotional attachment,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0267_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਝੂਠ ਬਿਕਾਰ ਮਹਾ ਲੋਭ ਧ੍ਰੋਹ ॥",
      "transliteration": "jhooth bikaar mahaa lobh dhroh ||",
      "translation": "falsehood, corruption, immense greed and deceit:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 267,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
