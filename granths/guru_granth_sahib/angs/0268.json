{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 268,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0268_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਆਹੂ ਜੁਗਤਿ ਬਿਹਾਨੇ ਕਈ ਜਨਮ ॥",
      "transliteration": "iaahoo jugat bihaane kaee janam ||",
      "translation": "So many lifetimes are wasted in these ways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਨਕ ਰਾਖਿ ਲੇਹੁ ਆਪਨ ਕਰਿ ਕਰਮ ॥੭॥",
      "transliteration": "naanak raakh lehu aapan kar karam ||7||",
      "translation": "Nanak: uplift them, and redeem them, O Lord - show Your Mercy! ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤੂ ਠਾਕੁਰੁ ਤੁਮ ਪਹਿ ਅਰਦਾਸਿ ॥",
      "transliteration": "too thaakur tum pahi aradaas ||",
      "translation": "You are our Lord and Master; to You, I offer this prayer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਸਭੁ ਤੇਰੀ ਰਾਸਿ ॥",
      "transliteration": "jeeu pi(n)d sabh teree raas ||",
      "translation": "This body and soul are all Your property.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੁਮ ਮਾਤ ਪਿਤਾ ਹਮ ਬਾਰਿਕ ਤੇਰੇ ॥",
      "transliteration": "tum maat pitaa ham baarik tere ||",
      "translation": "You are our mother and father; we are Your children.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੁਮਰੀ ਕ੍ਰਿਪਾ ਮਹਿ ਸੂਖ ਘਨੇਰੇ ॥",
      "transliteration": "tumaree kripaa mahi sookh ghanere ||",
      "translation": "In Your Grace, there are so many joys!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕੋਇ ਨ ਜਾਨੈ ਤੁਮਰਾ ਅੰਤੁ ॥",
      "transliteration": "koi na jaanai tumaraa a(n)t ||",
      "translation": "No one knows Your limits.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਊਚੇ ਤੇ ਊਚਾ ਭਗਵੰਤ ॥",
      "transliteration": "ooche te oochaa bhagava(n)t ||",
      "translation": "O Highest of the High, Most Generous God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਗਲ ਸਮਗ੍ਰੀ ਤੁਮਰੈ ਸੂਤ੍ਰਿ ਧਾਰੀ ॥",
      "transliteration": "sagal samagree tumarai sootr dhaaree ||",
      "translation": "the whole creation is strung on Your thread.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤੁਮ ਤੇ ਹੋਇ ਸੁ ਆਗਿਆਕਾਰੀ ॥",
      "transliteration": "tum te hoi s aagiaakaaree ||",
      "translation": "That which has come from You is under Your Command.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੁਮਰੀ ਗਤਿ ਮਿਤਿ ਤੁਮ ਹੀ ਜਾਨੀ ॥",
      "transliteration": "tumaree gat mit tum hee jaanee ||",
      "translation": "You alone know Your state and extent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਸਦਾ ਕੁਰਬਾਨੀ ॥੮॥੪॥",
      "transliteration": "naanak daas sadaa kurabaanee ||8||4||",
      "translation": "Nanak, Your slave, is forever a sacrifice. ||8||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੇਨਹਾਰੁ ਪ੍ਰਭ ਛੋਡਿ ਕੈ ਲਾਗਹਿ ਆਨ ਸੁਆਇ ॥",
      "transliteration": "denahaar prabh chhod kai laagahi aan suaai ||",
      "translation": "One who renounces God the Giver, and attaches himself to other affairs",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਕਹੂ ਨ ਸੀਝਈ ਬਿਨੁ ਨਾਵੈ ਪਤਿ ਜਾਇ ॥੧॥",
      "transliteration": "naanak kahoo na seejhaee bin naavai pat jaai ||1||",
      "translation": "- O Nanak, he shall never succeed. Without the Name, he shall lose his honor. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦਸ ਬਸਤੂ ਲੇ ਪਾਛੈ ਪਾਵੈ ॥",
      "transliteration": "das basatoo le paachhai paavai ||",
      "translation": "He obtains ten things, and puts them behind him;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਏਕ ਬਸਤੁ ਕਾਰਨਿ ਬਿਖੋਟਿ ਗਵਾਵੈ ॥",
      "transliteration": "ek basat kaaran bikhot gavaavai ||",
      "translation": "for the sake of one thing withheld, he forfeits his faith.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਏਕ ਭੀ ਨ ਦੇਇ ਦਸ ਭੀ ਹਿਰਿ ਲੇਇ ॥",
      "transliteration": "ek bhee na dei das bhee hir lei ||",
      "translation": "But what if that one thing were not given, and the ten were taken away?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਉ ਮੂੜਾ ਕਹੁ ਕਹਾ ਕਰੇਇ ॥",
      "transliteration": "tau mooRaa kahu kahaa karei ||",
      "translation": "Then, what could the fool say or do?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਸੁ ਠਾਕੁਰ ਸਿਉ ਨਾਹੀ ਚਾਰਾ ॥",
      "transliteration": "jis thaakur siu naahee chaaraa ||",
      "translation": "Our Lord and Master cannot be moved by force.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਕਉ ਕੀਜੈ ਸਦ ਨਮਸਕਾਰਾ ॥",
      "transliteration": "taa kau keejai sad namasakaaraa ||",
      "translation": "Unto Him, bow forever in adoration.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾ ਕੈ ਮਨਿ ਲਾਗਾ ਪ੍ਰਭੁ ਮੀਠਾ ॥",
      "transliteration": "jaa kai man laagaa prabh meethaa ||",
      "translation": "That one, unto whose mind God seems sweet",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਰਬ ਸੂਖ ਤਾਹੂ ਮਨਿ ਵੂਠਾ ॥",
      "transliteration": "sarab sookh taahoo man voothaa ||",
      "translation": "all pleasures come to abide in his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਿਸੁ ਜਨ ਅਪਨਾ ਹੁਕਮੁ ਮਨਾਇਆ ॥",
      "transliteration": "jis jan apanaa hukam manaaiaa ||",
      "translation": "One who abides by the Lord's Will,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਰਬ ਥੋਕ ਨਾਨਕ ਤਿਨਿ ਪਾਇਆ ॥੧॥",
      "transliteration": "sarab thok naanak tin paaiaa ||1||",
      "translation": "O Nanak, obtains all things. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਗਨਤ ਸਾਹੁ ਅਪਨੀ ਦੇ ਰਾਸਿ ॥",
      "transliteration": "aganat saahu apanee de raas ||",
      "translation": "God the Banker gives endless capital to the mortal,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਖਾਤ ਪੀਤ ਬਰਤੈ ਅਨਦ ਉਲਾਸਿ ॥",
      "transliteration": "khaat peet baratai anad ulaas ||",
      "translation": "who eats, drinks and expends it with pleasure and joy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਪੁਨੀ ਅਮਾਨ ਕਛੁ ਬਹੁਰਿ ਸਾਹੁ ਲੇਇ ॥",
      "transliteration": "apunee amaan kachh bahur saahu lei ||",
      "translation": "If some of this capital is later taken back by the Banker,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਗਿਆਨੀ ਮਨਿ ਰੋਸੁ ਕਰੇਇ ॥",
      "transliteration": "agiaanee man ros karei ||",
      "translation": "the ignorant person shows his anger.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਪਨੀ ਪਰਤੀਤਿ ਆਪ ਹੀ ਖੋਵੈ ॥",
      "transliteration": "apanee parateet aap hee khovai ||",
      "translation": "He himself destroys his own credibility,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਹੁਰਿ ਉਸ ਕਾ ਬਿਸ੍ਵਾਸੁ ਨ ਹੋਵੈ ॥",
      "transliteration": "bahur us kaa bisvaas na hovai ||",
      "translation": "and he shall not again be trusted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਸ ਕੀ ਬਸਤੁ ਤਿਸੁ ਆਗੈ ਰਾਖੈ ॥",
      "transliteration": "jis kee basat tis aagai raakhai ||",
      "translation": "When one offers to the Lord, that which belongs to the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਆਗਿਆ ਮਾਨੈ ਮਾਥੈ ॥",
      "transliteration": "prabh kee aagiaa maanai maathai ||",
      "translation": "and willingly abides by the Will of God's Order,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਉਸ ਤੇ ਚਉਗੁਨ ਕਰੈ ਨਿਹਾਲੁ ॥",
      "transliteration": "us te chaugun karai nihaal ||",
      "translation": "the Lord will make him happy four times over.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਨਕ ਸਾਹਿਬੁ ਸਦਾ ਦਇਆਲੁ ॥੨॥",
      "transliteration": "naanak saahib sadaa daiaal ||2||",
      "translation": "O Nanak, our Lord and Master is merciful forever. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਨਿਕ ਭਾਤਿ ਮਾਇਆ ਕੇ ਹੇਤ ॥",
      "transliteration": "anik bhaat maaiaa ke het ||",
      "translation": "The many forms of attachment to Maya shall surely pass away",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਰਪਰ ਹੋਵਤ ਜਾਨੁ ਅਨੇਤ ॥",
      "transliteration": "sarapar hovat jaan anet ||",
      "translation": "- know that they are transitory.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਿਰਖ ਕੀ ਛਾਇਆ ਸਿਉ ਰੰਗੁ ਲਾਵੈ ॥",
      "transliteration": "birakh kee chhaaiaa siu ra(n)g laavai ||",
      "translation": "People fall in love with the shade of the tree,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਓਹ ਬਿਨਸੈ ਉਹੁ ਮਨਿ ਪਛੁਤਾਵੈ ॥",
      "transliteration": "oh binasai uhu man pachhutaavai ||",
      "translation": "and when it passes away, they feel regret in their minds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੋ ਦੀਸੈ ਸੋ ਚਾਲਨਹਾਰੁ ॥",
      "transliteration": "jo deesai so chaalanahaar ||",
      "translation": "Whatever is seen, shall pass away;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਲਪਟਿ ਰਹਿਓ ਤਹ ਅੰਧ ਅੰਧਾਰੁ ॥",
      "transliteration": "lapat rahio tah a(n)dh a(n)dhaar ||",
      "translation": "and yet, the blindest of the blind cling to it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਟਾਊ ਸਿਉ ਜੋ ਲਾਵੈ ਨੇਹ ॥",
      "transliteration": "bataaoo siu jo laavai neh ||",
      "translation": "One who gives her love to a passing traveler",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾ ਕਉ ਹਾਥਿ ਨ ਆਵੈ ਕੇਹ ॥",
      "transliteration": "taa kau haath na aavai keh ||",
      "translation": "nothing shall come into her hands in this way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਨ ਹਰਿ ਕੇ ਨਾਮ ਕੀ ਪ੍ਰੀਤਿ ਸੁਖਦਾਈ ॥",
      "transliteration": "man har ke naam kee preet sukhadaaee ||",
      "translation": "O mind, the love of the Name of the Lord bestows peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਨਾਨਕ ਆਪਿ ਲਏ ਲਾਈ ॥੩॥",
      "transliteration": "kar kirapaa naanak aap lae laaee ||3||",
      "translation": "O Nanak, the Lord, in His Mercy, unites us with Himself. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਿਥਿਆ ਤਨੁ ਧਨੁ ਕੁਟੰਬੁ ਸਬਾਇਆ ॥",
      "transliteration": "mithiaa tan dhan kuta(n)b sabaaiaa ||",
      "translation": "False are body, wealth, and all relations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਿਥਿਆ ਹਉਮੈ ਮਮਤਾ ਮਾਇਆ ॥",
      "transliteration": "mithiaa haumai mamataa maaiaa ||",
      "translation": "False are ego, possessiveness and Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮਿਥਿਆ ਰਾਜ ਜੋਬਨ ਧਨ ਮਾਲ ॥",
      "transliteration": "mithiaa raaj joban dhan maal ||",
      "translation": "False are power, youth, wealth and property.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਮਿਥਿਆ ਕਾਮ ਕ੍ਰੋਧ ਬਿਕਰਾਲ ॥",
      "transliteration": "mithiaa kaam krodh bikaraal ||",
      "translation": "False are sexual desire and wild anger.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮਿਥਿਆ ਰਥ ਹਸਤੀ ਅਸ੍ਵ ਬਸਤ੍ਰਾ ॥",
      "transliteration": "mithiaa rath hasatee asv basatraa ||",
      "translation": "False are chariots, elephants, horses and expensive clothes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਿਥਿਆ ਰੰਗ ਸੰਗਿ ਮਾਇਆ ਪੇਖਿ ਹਸਤਾ ॥",
      "transliteration": "mithiaa ra(n)g sa(n)g maaiaa pekh hasataa ||",
      "translation": "False is the love of gathering wealth, and reveling in the sight of it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਿਥਿਆ ਧ੍ਰੋਹ ਮੋਹ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "mithiaa dhroh moh abhimaan ||",
      "translation": "False are deception, emotional attachment and egotistical pride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮਿਥਿਆ ਆਪਸ ਊਪਰਿ ਕਰਤ ਗੁਮਾਨੁ ॥",
      "transliteration": "mithiaa aapas oopar karat gumaan ||",
      "translation": "False are pride and self-conceit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਅਸਥਿਰੁ ਭਗਤਿ ਸਾਧ ਕੀ ਸਰਨ ॥",
      "transliteration": "asathir bhagat saadh kee saran ||",
      "translation": "Only devotional worship is permanent, and the Sanctuary of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਨਕ ਜਪਿ ਜਪਿ ਜੀਵੈ ਹਰਿ ਕੇ ਚਰਨ ॥੪॥",
      "transliteration": "naanak jap jap jeevai har ke charan ||4||",
      "translation": "Nanak lives by meditating, meditating on the Lotus Feet of the Lord. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮਿਥਿਆ ਸ੍ਰਵਨ ਪਰ ਨਿੰਦਾ ਸੁਨਹਿ ॥",
      "transliteration": "mithiaa sravan par ni(n)daa sunahi ||",
      "translation": "False are the ears which listen to the slander of others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0268_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਮਿਥਿਆ ਹਸਤ ਪਰ ਦਰਬ ਕਉ ਹਿਰਹਿ ॥",
      "transliteration": "mithiaa hasat par darab kau hirahi ||",
      "translation": "False are the hands which steal the wealth of others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 268,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
