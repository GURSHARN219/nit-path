{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 269,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0269_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਿਥਿਆ ਨੇਤ੍ਰ ਪੇਖਤ ਪਰ ਤ੍ਰਿਅ ਰੂਪਾਦ ॥",
      "transliteration": "mithiaa netr pekhat par tri roopaad ||",
      "translation": "False are the eyes which gaze upon the beauty of another's wife.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਿਥਿਆ ਰਸਨਾ ਭੋਜਨ ਅਨ ਸ੍ਵਾਦ ॥",
      "transliteration": "mithiaa rasanaa bhojan an svaad ||",
      "translation": "False is the tongue which enjoys delicacies and external tastes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਿਥਿਆ ਚਰਨ ਪਰ ਬਿਕਾਰ ਕਉ ਧਾਵਹਿ ॥",
      "transliteration": "mithiaa charan par bikaar kau dhaavahi ||",
      "translation": "False are the feet which run to do evil to others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਿਥਿਆ ਮਨ ਪਰ ਲੋਭ ਲੁਭਾਵਹਿ ॥",
      "transliteration": "mithiaa man par lobh lubhaavahi ||",
      "translation": "False is the mind which covets the wealth of others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਿਥਿਆ ਤਨ ਨਹੀ ਪਰਉਪਕਾਰਾ ॥",
      "transliteration": "mithiaa tan nahee paraupakaaraa ||",
      "translation": "False is the body which does not do good to others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਿਥਿਆ ਬਾਸੁ ਲੇਤ ਬਿਕਾਰਾ ॥",
      "transliteration": "mithiaa baas let bikaaraa ||",
      "translation": "False is the nose which inhales corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਿਨੁ ਬੂਝੇ ਮਿਥਿਆ ਸਭ ਭਏ ॥",
      "transliteration": "bin boojhe mithiaa sabh bhae ||",
      "translation": "Without understanding, everything is false.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਫਲ ਦੇਹ ਨਾਨਕ ਹਰਿ ਹਰਿ ਨਾਮ ਲਏ ॥੫॥",
      "transliteration": "saphal deh naanak har har naam lae ||5||",
      "translation": "Fruitful is the body, O Nanak, which takes to the Lord's Name. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਰਥੀ ਸਾਕਤ ਕੀ ਆਰਜਾ ॥",
      "transliteration": "birathee saakat kee aarajaa ||",
      "translation": "The life of the faithless cynic is totally useless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਾਚ ਬਿਨਾ ਕਹ ਹੋਵਤ ਸੂਚਾ ॥",
      "transliteration": "saach binaa kah hovat soochaa ||",
      "translation": "Without the Truth, how can anyone be pure?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਰਥਾ ਨਾਮ ਬਿਨਾ ਤਨੁ ਅੰਧ ॥",
      "transliteration": "birathaa naam binaa tan a(n)dh ||",
      "translation": "Useless is the body of the spiritually blind, without the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮੁਖਿ ਆਵਤ ਤਾ ਕੈ ਦੁਰਗੰਧ ॥",
      "transliteration": "mukh aavat taa kai duraga(n)dh ||",
      "translation": "From his mouth, a foul smell issues forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਿਨੁ ਸਿਮਰਨ ਦਿਨੁ ਰੈਨਿ ਬ੍ਰਿਥਾ ਬਿਹਾਇ ॥",
      "transliteration": "bin simaran din rain brithaa bihaai ||",
      "translation": "Without the remembrance of the Lord, day and night pass in vain,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੇਘ ਬਿਨਾ ਜਿਉ ਖੇਤੀ ਜਾਇ ॥",
      "transliteration": "megh binaa jiu khetee jaai ||",
      "translation": "like the crop which withers without rain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੋਬਿਦ ਭਜਨ ਬਿਨੁ ਬ੍ਰਿਥੇ ਸਭ ਕਾਮ ॥",
      "transliteration": "gobid bhajan bin brithe sabh kaam ||",
      "translation": "Without meditation on the Lord of the Universe, all works are in vain,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਉ ਕਿਰਪਨ ਕੇ ਨਿਰਾਰਥ ਦਾਮ ॥",
      "transliteration": "jiu kirapan ke niraarath daam ||",
      "translation": "like the wealth of a miser, which lies useless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਧੰਨਿ ਧੰਨਿ ਤੇ ਜਨ ਜਿਹ ਘਟਿ ਬਸਿਓ ਹਰਿ ਨਾਉ ॥",
      "transliteration": "dha(n)n dha(n)n te jan jih ghat basio har naau ||",
      "translation": "Blessed, blessed are those, whose hearts are filled with the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕੈ ਬਲਿ ਬਲਿ ਜਾਉ ॥੬॥",
      "transliteration": "naanak taa kai bal bal jaau ||6||",
      "translation": "Nanak is a sacrifice, a sacrifice to them. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਹਤ ਅਵਰ ਕਛੁ ਅਵਰ ਕਮਾਵਤ ॥",
      "transliteration": "rahat avar kachh avar kamaavat ||",
      "translation": "He says one thing, and does something else.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਨਿ ਨਹੀ ਪ੍ਰੀਤਿ ਮੁਖਹੁ ਗੰਢ ਲਾਵਤ ॥",
      "transliteration": "man nahee preet mukhahu ga(n)dh laavat ||",
      "translation": "There is no love in his heart, and yet with his mouth he talks tall.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾਨਨਹਾਰ ਪ੍ਰਭੂ ਪਰਬੀਨ ॥",
      "transliteration": "jaananahaar prabhoo parabeen ||",
      "translation": "The Omniscient Lord God is the Knower of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਾਹਰਿ ਭੇਖ ਨ ਕਾਹੂ ਭੀਨ ॥",
      "transliteration": "baahar bhekh na kaahoo bheen ||",
      "translation": "He is not impressed by outward display.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਵਰ ਉਪਦੇਸੈ ਆਪਿ ਨ ਕਰੈ ॥",
      "transliteration": "avar upadesai aap na karai ||",
      "translation": "One who does not practice what he preaches to others,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਵਤ ਜਾਵਤ ਜਨਮੈ ਮਰੈ ॥",
      "transliteration": "aavat jaavat janamai marai ||",
      "translation": "shall come and go in reincarnation, through birth and death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਿਸ ਕੈ ਅੰਤਰਿ ਬਸੈ ਨਿਰੰਕਾਰੁ ॥",
      "transliteration": "jis kai a(n)tar basai nira(n)kaar ||",
      "translation": "One whose inner being is filled with the Formless Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਿਸ ਕੀ ਸੀਖ ਤਰੈ ਸੰਸਾਰੁ ॥",
      "transliteration": "tis kee seekh tarai sa(n)saar ||",
      "translation": "by his teachings, the world is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੋ ਤੁਮ ਭਾਨੇ ਤਿਨ ਪ੍ਰਭੁ ਜਾਤਾ ॥",
      "transliteration": "jo tum bhaane tin prabh jaataa ||",
      "translation": "Those who are pleasing to You, God, know You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਉਨ ਜਨ ਚਰਨ ਪਰਾਤਾ ॥੭॥",
      "transliteration": "naanak un jan charan paraataa ||7||",
      "translation": "Nanak falls at their feet. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਰਉ ਬੇਨਤੀ ਪਾਰਬ੍ਰਹਮੁ ਸਭੁ ਜਾਨੈ ॥",
      "transliteration": "karau benatee paarabraham sabh jaanai ||",
      "translation": "Offer your prayers to the Supreme Lord God, who knows everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਪਨਾ ਕੀਆ ਆਪਹਿ ਮਾਨੈ ॥",
      "transliteration": "apanaa keeaa aapahi maanai ||",
      "translation": "He Himself values His own creatures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਪਹਿ ਆਪ ਆਪਿ ਕਰਤ ਨਿਬੇਰਾ ॥",
      "transliteration": "aapahi aap aap karat niberaa ||",
      "translation": "He Himself, by Himself, makes the decisions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿਸੈ ਦੂਰਿ ਜਨਾਵਤ ਕਿਸੈ ਬੁਝਾਵਤ ਨੇਰਾ ॥",
      "transliteration": "kisai door janaavat kisai bujhaavat neraa ||",
      "translation": "To some, He appears far away, while others perceive Him near at hand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਉਪਾਵ ਸਿਆਨਪ ਸਗਲ ਤੇ ਰਹਤ ॥",
      "transliteration": "upaav siaanap sagal te rahat ||",
      "translation": "He is beyond all efforts and clever tricks.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਭੁ ਕਛੁ ਜਾਨੈ ਆਤਮ ਕੀ ਰਹਤ ॥",
      "transliteration": "sabh kachh jaanai aatam kee rahat ||",
      "translation": "He knows all the ways and means of the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਸੁ ਭਾਵੈ ਤਿਸੁ ਲਏ ਲੜਿ ਲਾਇ ॥",
      "transliteration": "jis bhaavai tis lae laR laai ||",
      "translation": "Those with whom He is pleased are attached to the hem of His robe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਥਾਨ ਥਨੰਤਰਿ ਰਹਿਆ ਸਮਾਇ ॥",
      "transliteration": "thaan thana(n)tar rahiaa samaai ||",
      "translation": "He is pervading all places and interspaces.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੋ ਸੇਵਕੁ ਜਿਸੁ ਕਿਰਪਾ ਕਰੀ ॥",
      "transliteration": "so sevak jis kirapaa karee ||",
      "translation": "Those upon whom He bestows His favor, become His servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਿਮਖ ਨਿਮਖ ਜਪਿ ਨਾਨਕ ਹਰੀ ॥੮॥੫॥",
      "transliteration": "nimakh nimakh jap naanak haree ||8||5||",
      "translation": "Each and every moment, O Nanak, meditate on the Lord. ||8||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਅਰੁ ਲੋਭ ਮੋਹ ਬਿਨਸਿ ਜਾਇ ਅਹੰਮੇਵ ॥",
      "transliteration": "kaam krodh ar lobh moh binas jaai aha(n)mev ||",
      "translation": "Sexual desire, anger, greed and emotional attachment - may these be gone, and egotism as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਨਕ ਪ੍ਰਭ ਸਰਣਾਗਤੀ ਕਰਿ ਪ੍ਰਸਾਦੁ ਗੁਰਦੇਵ ॥੧॥",
      "transliteration": "naanak prabh saranaagatee kar prasaad guradev ||1||",
      "translation": "Nanak seeks the Sanctuary of God; please bless me with Your Grace, O Divine Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਛਤੀਹ ਅੰਮ੍ਰਿਤ ਖਾਹਿ ॥",
      "transliteration": "jih prasaad chhateeh a(n)mrit khaahi ||",
      "translation": "By His Grace, you partake of the thirty-six delicacies;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਸੁ ਠਾਕੁਰ ਕਉ ਰਖੁ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "tis thaakur kau rakh man maahi ||",
      "translation": "enshrine that Lord and Master within your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਸੁਗੰਧਤ ਤਨਿ ਲਾਵਹਿ ॥",
      "transliteration": "jih prasaad suga(n)dhat tan laavahi ||",
      "translation": "By His Grace, you apply scented oils to your body;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਿਸ ਕਉ ਸਿਮਰਤ ਪਰਮ ਗਤਿ ਪਾਵਹਿ ॥",
      "transliteration": "tis kau simarat param gat paavahi ||",
      "translation": "remembering Him, the supreme status is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਬਸਹਿ ਸੁਖ ਮੰਦਰਿ ॥",
      "transliteration": "jih prasaad basahi sukh ma(n)dar ||",
      "translation": "By His Grace, you dwell in the palace of peace;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਸਹਿ ਧਿਆਇ ਸਦਾ ਮਨ ਅੰਦਰਿ ॥",
      "transliteration": "tisahi dhiaai sadaa man a(n)dar ||",
      "translation": "meditate forever on Him within your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਗ੍ਰਿਹ ਸੰਗਿ ਸੁਖ ਬਸਨਾ ॥",
      "transliteration": "jih prasaad grih sa(n)g sukh basanaa ||",
      "translation": "By His Grace, you abide with your family in peace;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਆਠ ਪਹਰ ਸਿਮਰਹੁ ਤਿਸੁ ਰਸਨਾ ॥",
      "transliteration": "aath pahar simarahu tis rasanaa ||",
      "translation": "keep His remembrance upon your tongue, twenty-four hours a day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਰੰਗ ਰਸ ਭੋਗ ॥",
      "transliteration": "jih prasaad ra(n)g ras bhog ||",
      "translation": "By His Grace, you enjoy tastes and pleasures;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾਨਕ ਸਦਾ ਧਿਆਈਐ ਧਿਆਵਨ ਜੋਗ ॥੧॥",
      "transliteration": "naanak sadaa dhiaaeeai dhiaavan jog ||1||",
      "translation": "O Nanak, meditate forever on the One, who is worthy of meditation. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਪਾਟ ਪਟੰਬਰ ਹਢਾਵਹਿ ॥",
      "transliteration": "jih prasaad paat pata(n)bar hadhaavahi ||",
      "translation": "By His Grace, you wear silks and satins;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਿਸਹਿ ਤਿਆਗਿ ਕਤ ਅਵਰ ਲੁਭਾਵਹਿ ॥",
      "transliteration": "tisahi tiaag kat avar lubhaavahi ||",
      "translation": "why abandon Him, to attach yourself to another?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਸੁਖਿ ਸੇਜ ਸੋਈਜੈ ॥",
      "transliteration": "jih prasaad sukh sej soeejai ||",
      "translation": "By His Grace, you sleep in a cozy bed;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਮਨ ਆਠ ਪਹਰ ਤਾ ਕਾ ਜਸੁ ਗਾਵੀਜੈ ॥",
      "transliteration": "man aath pahar taa kaa jas gaaveejai ||",
      "translation": "O my mind, sing His Praises, twenty-four hours a day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0269_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਤੁਝੁ ਸਭੁ ਕੋਊ ਮਾਨੈ ॥",
      "transliteration": "jih prasaad tujh sabh kooo maanai ||",
      "translation": "By His Grace, you are honored by everyone;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 269,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
