{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 270,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0270_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮੁਖਿ ਤਾ ਕੋ ਜਸੁ ਰਸਨ ਬਖਾਨੈ ॥",
      "transliteration": "mukh taa ko jas rasan bakhaanai ||",
      "translation": "with your mouth and with your tongue, chant His Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਤੇਰੋ ਰਹਤਾ ਧਰਮੁ ॥",
      "transliteration": "jih prasaad tero rahataa dharam ||",
      "translation": "By His Grace, you remain in the Dharma;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਨ ਸਦਾ ਧਿਆਇ ਕੇਵਲ ਪਾਰਬ੍ਰਹਮੁ ॥",
      "transliteration": "man sadaa dhiaai keval paarabraham ||",
      "translation": "O mind, meditate continually on the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪ੍ਰਭ ਜੀ ਜਪਤ ਦਰਗਹ ਮਾਨੁ ਪਾਵਹਿ ॥",
      "transliteration": "prabh jee japat daragah maan paavahi ||",
      "translation": "Meditating on God, you shall be honored in His Court;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਨਕ ਪਤਿ ਸੇਤੀ ਘਰਿ ਜਾਵਹਿ ॥੨॥",
      "transliteration": "naanak pat setee ghar jaavahi ||2||",
      "translation": "O Nanak, you shall return to your true home with honor. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਆਰੋਗ ਕੰਚਨ ਦੇਹੀ ॥",
      "transliteration": "jih prasaad aarog ka(n)chan dehee ||",
      "translation": "By His Grace, you have a healthy, golden body;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲਿਵ ਲਾਵਹੁ ਤਿਸੁ ਰਾਮ ਸਨੇਹੀ ॥",
      "transliteration": "liv laavahu tis raam sanehee ||",
      "translation": "attune yourself to that Loving Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਤੇਰਾ ਓਲਾ ਰਹਤ ॥",
      "transliteration": "jih prasaad teraa olaa rahat ||",
      "translation": "By His Grace, your honor is preserved;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਨ ਸੁਖੁ ਪਾਵਹਿ ਹਰਿ ਹਰਿ ਜਸੁ ਕਹਤ ॥",
      "transliteration": "man sukh paavahi har har jas kahat ||",
      "translation": "O mind, chant the Praises of the Lord, Har, Har, and find peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਤੇਰੇ ਸਗਲ ਛਿਦ੍ਰ ਢਾਕੇ ॥",
      "transliteration": "jih prasaad tere sagal chhidr dhaake ||",
      "translation": "By His Grace, all your deficits are covered;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਨ ਸਰਨੀ ਪਰੁ ਠਾਕੁਰ ਪ੍ਰਭ ਤਾ ਕੈ ॥",
      "transliteration": "man saranee par thaakur prabh taa kai ||",
      "translation": "O mind, seek the Sanctuary of God, our Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਤੁਝੁ ਕੋ ਨ ਪਹੂਚੈ ॥",
      "transliteration": "jih prasaad tujh ko na pahoochai ||",
      "translation": "By His Grace, no one can rival you;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਨ ਸਾਸਿ ਸਾਸਿ ਸਿਮਰਹੁ ਪ੍ਰਭ ਊਚੇ ॥",
      "transliteration": "man saas saas simarahu prabh ooche ||",
      "translation": "O mind, with each and every breath, remember God on High.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਪਾਈ ਦ੍ਰੁਲਭ ਦੇਹ ॥",
      "transliteration": "jih prasaad paaee drulabh deh ||",
      "translation": "By His Grace, you obtained this precious human body;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕੀ ਭਗਤਿ ਕਰੇਹ ॥੩॥",
      "transliteration": "naanak taa kee bhagat kareh ||3||",
      "translation": "O Nanak, worship Him with devotion. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਆਭੂਖਨ ਪਹਿਰੀਜੈ ॥",
      "transliteration": "jih prasaad aabhookhan pahireejai ||",
      "translation": "By His Grace, you wear decorations;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਨ ਤਿਸੁ ਸਿਮਰਤ ਕਿਉ ਆਲਸੁ ਕੀਜੈ ॥",
      "transliteration": "man tis simarat kiu aalas keejai ||",
      "translation": "O mind, why are you so lazy? Why don't you remember Him in meditation?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਅਸ੍ਵ ਹਸਤਿ ਅਸਵਾਰੀ ॥",
      "transliteration": "jih prasaad asv hasat asavaaree ||",
      "translation": "By His Grace, you have horses and elephants to ride;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਨ ਤਿਸੁ ਪ੍ਰਭ ਕਉ ਕਬਹੂ ਨ ਬਿਸਾਰੀ ॥",
      "transliteration": "man tis prabh kau kabahoo na bisaaree ||",
      "translation": "O mind, never forget that God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਬਾਗ ਮਿਲਖ ਧਨਾ ॥",
      "transliteration": "jih prasaad baag milakh dhanaa ||",
      "translation": "By His Grace, you have land, gardens and wealth;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਾਖੁ ਪਰੋਇ ਪ੍ਰਭੁ ਅਪੁਨੇ ਮਨਾ ॥",
      "transliteration": "raakh paroi prabh apune manaa ||",
      "translation": "keep God enshrined in your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਨਿ ਤੇਰੀ ਮਨ ਬਨਤ ਬਨਾਈ ॥",
      "transliteration": "jin teree man banat banaaee ||",
      "translation": "O mind, the One who formed your form",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਊਠਤ ਬੈਠਤ ਸਦ ਤਿਸਹਿ ਧਿਆਈ ॥",
      "transliteration": "oothat baithat sad tisahi dhiaaee ||",
      "translation": "standing up and sitting down, meditate always on Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਸਹਿ ਧਿਆਇ ਜੋ ਏਕ ਅਲਖੈ ॥",
      "transliteration": "tisahi dhiaai jo ek alakhai ||",
      "translation": "Meditate on Him - the One Invisible Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਈਹਾ ਊਹਾ ਨਾਨਕ ਤੇਰੀ ਰਖੈ ॥੪॥",
      "transliteration": "eehaa oohaa naanak teree rakhai ||4||",
      "translation": "here and hereafter, O Nanak, He shall save you. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਕਰਹਿ ਪੁੰਨ ਬਹੁ ਦਾਨ ॥",
      "transliteration": "jih prasaad karahi pu(n)n bahu daan ||",
      "translation": "By His Grace, you give donations in abundance to charities;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਨ ਆਠ ਪਹਰ ਕਰਿ ਤਿਸ ਕਾ ਧਿਆਨ ॥",
      "transliteration": "man aath pahar kar tis kaa dhiaan ||",
      "translation": "O mind, meditate on Him, twenty-four hours a day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਤੂ ਆਚਾਰ ਬਿਉਹਾਰੀ ॥",
      "transliteration": "jih prasaad too aachaar biuhaaree ||",
      "translation": "By His Grace, you perform religious rituals and worldly duties;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਸੁ ਪ੍ਰਭ ਕਉ ਸਾਸਿ ਸਾਸਿ ਚਿਤਾਰੀ ॥",
      "transliteration": "tis prabh kau saas saas chitaaree ||",
      "translation": "think of God with each and every breath.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਤੇਰਾ ਸੁੰਦਰ ਰੂਪੁ ॥",
      "transliteration": "jih prasaad teraa su(n)dar roop ||",
      "translation": "By His Grace, your form is so beautiful;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੋ ਪ੍ਰਭੁ ਸਿਮਰਹੁ ਸਦਾ ਅਨੂਪੁ ॥",
      "transliteration": "so prabh simarahu sadaa anoop ||",
      "translation": "constantly remember God, the Incomparably Beautiful One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਤੇਰੀ ਨੀਕੀ ਜਾਤਿ ॥",
      "transliteration": "jih prasaad teree neekee jaat ||",
      "translation": "By His Grace, you have such high social status;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੋ ਪ੍ਰਭੁ ਸਿਮਰਿ ਸਦਾ ਦਿਨ ਰਾਤਿ ॥",
      "transliteration": "so prabh simar sadaa din raat ||",
      "translation": "remember God always, day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਤੇਰੀ ਪਤਿ ਰਹੈ ॥",
      "transliteration": "jih prasaad teree pat rahai ||",
      "translation": "By His Grace, your honor is preserved;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਨਾਨਕ ਜਸੁ ਕਹੈ ॥੫॥",
      "transliteration": "gur prasaad naanak jas kahai ||5||",
      "translation": "by Guru's Grace, O Nanak, chant His Praises. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਸੁਨਹਿ ਕਰਨ ਨਾਦ ॥",
      "transliteration": "jih prasaad sunahi karan naad ||",
      "translation": "By His Grace, you listen to the sound current of the Naad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਪੇਖਹਿ ਬਿਸਮਾਦ ॥",
      "transliteration": "jih prasaad pekhahi bisamaad ||",
      "translation": "By His Grace, you behold amazing wonders.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਬੋਲਹਿ ਅੰਮ੍ਰਿਤ ਰਸਨਾ ॥",
      "transliteration": "jih prasaad bolahi a(n)mrit rasanaa ||",
      "translation": "By His Grace, you speak ambrosial words with your tongue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਸੁਖਿ ਸਹਜੇ ਬਸਨਾ ॥",
      "transliteration": "jih prasaad sukh sahaje basanaa ||",
      "translation": "By His Grace, you abide in peace and ease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਹਸਤ ਕਰ ਚਲਹਿ ॥",
      "transliteration": "jih prasaad hasat kar chalahi ||",
      "translation": "By His Grace, your hands move and work.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਸੰਪੂਰਨ ਫਲਹਿ ॥",
      "transliteration": "jih prasaad sa(n)pooran phalahi ||",
      "translation": "By His Grace, you are completely fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਪਰਮ ਗਤਿ ਪਾਵਹਿ ॥",
      "transliteration": "jih prasaad param gat paavahi ||",
      "translation": "By His Grace, you obtain the supreme status.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਸੁਖਿ ਸਹਜਿ ਸਮਾਵਹਿ ॥",
      "transliteration": "jih prasaad sukh sahaj samaavahi ||",
      "translation": "By His Grace, you are absorbed into celestial peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਐਸਾ ਪ੍ਰਭੁ ਤਿਆਗਿ ਅਵਰ ਕਤ ਲਾਗਹੁ ॥",
      "transliteration": "aisaa prabh tiaag avar kat laagahu ||",
      "translation": "Why forsake God, and attach yourself to another?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਨਾਨਕ ਮਨਿ ਜਾਗਹੁ ॥੬॥",
      "transliteration": "gur prasaad naanak man jaagahu ||6||",
      "translation": "By Guru's Grace, O Nanak, awaken your mind! ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਤੂੰ ਪ੍ਰਗਟੁ ਸੰਸਾਰਿ ॥",
      "transliteration": "jih prasaad too(n) pragat sa(n)saar ||",
      "translation": "By His Grace, you are famous all over the world;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਿਸੁ ਪ੍ਰਭ ਕਉ ਮੂਲਿ ਨ ਮਨਹੁ ਬਿਸਾਰਿ ॥",
      "transliteration": "tis prabh kau mool na manahu bisaar ||",
      "translation": "never forget God from your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਤੇਰਾ ਪਰਤਾਪੁ ॥",
      "transliteration": "jih prasaad teraa parataap ||",
      "translation": "By His Grace, you have prestige;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਰੇ ਮਨ ਮੂੜ ਤੂ ਤਾ ਕਉ ਜਾਪੁ ॥",
      "transliteration": "re man mooR too taa kau jaap ||",
      "translation": "O foolish mind, meditate on Him!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਤੇਰੇ ਕਾਰਜ ਪੂਰੇ ॥",
      "transliteration": "jih prasaad tere kaaraj poore ||",
      "translation": "By His Grace, your works are completed;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤਿਸਹਿ ਜਾਨੁ ਮਨ ਸਦਾ ਹਜੂਰੇ ॥",
      "transliteration": "tisahi jaan man sadaa hajoore ||",
      "translation": "O mind, know Him to be close at hand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਤੂੰ ਪਾਵਹਿ ਸਾਚੁ ॥",
      "transliteration": "jih prasaad too(n) paavahi saach ||",
      "translation": "By His Grace, you find the Truth;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਰੇ ਮਨ ਮੇਰੇ ਤੂੰ ਤਾ ਸਿਉ ਰਾਚੁ ॥",
      "transliteration": "re man mere too(n) taa siu raach ||",
      "translation": "O my mind, merge yourself into Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਿਹ ਪ੍ਰਸਾਦਿ ਸਭ ਕੀ ਗਤਿ ਹੋਇ ॥",
      "transliteration": "jih prasaad sabh kee gat hoi ||",
      "translation": "By His Grace, everyone is saved;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਨਕ ਜਾਪੁ ਜਪੈ ਜਪੁ ਸੋਇ ॥੭॥",
      "transliteration": "naanak jaap japai jap soi ||7||",
      "translation": "O Nanak, meditate, and chant His Chant. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਆਪਿ ਜਪਾਏ ਜਪੈ ਸੋ ਨਾਉ ॥",
      "transliteration": "aap japaae japai so naau ||",
      "translation": "Those, whom He inspires to chant, chant His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0270_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਆਪਿ ਗਾਵਾਏ ਸੁ ਹਰਿ ਗੁਨ ਗਾਉ ॥",
      "transliteration": "aap gaavaae s har gun gaau ||",
      "translation": "Those, whom He inspires to sing, sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 270,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
