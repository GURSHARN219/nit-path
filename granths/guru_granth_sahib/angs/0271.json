{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 271,
  "lineCount": 63,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0271_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ ਹੋਇ ਪ੍ਰਗਾਸੁ ॥",
      "transliteration": "prabh kirapaa te hoi pragaas ||",
      "translation": "By God's Grace, enlightenment comes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪ੍ਰਭੂ ਦਇਆ ਤੇ ਕਮਲ ਬਿਗਾਸੁ ॥",
      "transliteration": "prabhoo daiaa te kamal bigaas ||",
      "translation": "By God's Kind Mercy, the heart-lotus blossoms forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਭ ਸੁਪ੍ਰਸੰਨ ਬਸੈ ਮਨਿ ਸੋਇ ॥",
      "transliteration": "prabh suprasa(n)n basai man soi ||",
      "translation": "When God is totally pleased, He comes to dwell in the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪ੍ਰਭ ਦਇਆ ਤੇ ਮਤਿ ਊਤਮ ਹੋਇ ॥",
      "transliteration": "prabh daiaa te mat ootam hoi ||",
      "translation": "By God's Kind Mercy, the intellect is exalted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਰਬ ਨਿਧਾਨ ਪ੍ਰਭ ਤੇਰੀ ਮਇਆ ॥",
      "transliteration": "sarab nidhaan prabh teree maiaa ||",
      "translation": "All treasures, O Lord, come by Your Kind Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਪਹੁ ਕਛੂ ਨ ਕਿਨਹੂ ਲਇਆ ॥",
      "transliteration": "aapahu kachhoo na kinahoo laiaa ||",
      "translation": "No one obtains anything by himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਿਤੁ ਜਿਤੁ ਲਾਵਹੁ ਤਿਤੁ ਲਗਹਿ ਹਰਿ ਨਾਥ ॥",
      "transliteration": "jit jit laavahu tit lagahi har naath ||",
      "translation": "As You have delegated, so do we apply ourselves, O Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਨਕ ਇਨ ਕੈ ਕਛੂ ਨ ਹਾਥ ॥੮॥੬॥",
      "transliteration": "naanak in kai kachhoo na haath ||8||6||",
      "translation": "O Nanak, nothing is in our hands. ||8||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਗਮ ਅਗਾਧਿ ਪਾਰਬ੍ਰਹਮੁ ਸੋਇ ॥",
      "transliteration": "agam agaadh paarabraham soi ||",
      "translation": "Unapproachable and Unfathomable is the Supreme Lord God;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੋ ਜੋ ਕਹੈ ਸੁ ਮੁਕਤਾ ਹੋਇ ॥",
      "transliteration": "jo jo kahai s mukataa hoi ||",
      "translation": "whoever speaks of Him shall be liberated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁਨਿ ਮੀਤਾ ਨਾਨਕੁ ਬਿਨਵੰਤਾ ॥",
      "transliteration": "sun meetaa naanak binava(n)taa ||",
      "translation": "Listen, O friends, Nanak prays,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਧ ਜਨਾ ਕੀ ਅਚਰਜ ਕਥਾ ॥੧॥",
      "transliteration": "saadh janaa kee acharaj kathaa ||1||",
      "translation": "To the wonderful story of the Holy. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਮੁਖ ਊਜਲ ਹੋਤ ॥",
      "transliteration": "saadh kai sa(n)g mukh oojal hot ||",
      "translation": "In the Company of the Holy, one's face becomes radiant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਮਲੁ ਸਗਲੀ ਖੋਤ ॥",
      "transliteration": "saadhasa(n)g mal sagalee khot ||",
      "translation": "In the Company of the Holy, all filth is removed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਮਿਟੈ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "saadh kai sa(n)g mitai abhimaan ||",
      "translation": "In the Company of the Holy, egotism is eliminated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਪ੍ਰਗਟੈ ਸੁਗਿਆਨੁ ॥",
      "transliteration": "saadh kai sa(n)g pragatai sugiaan ||",
      "translation": "In the Company of the Holy, spiritual wisdom is revealed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਬੁਝੈ ਪ੍ਰਭੁ ਨੇਰਾ ॥",
      "transliteration": "saadh kai sa(n)g bujhai prabh neraa ||",
      "translation": "In the Company of the Holy, God is understood to be near at hand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਸਭੁ ਹੋਤ ਨਿਬੇਰਾ ॥",
      "transliteration": "saadhasa(n)g sabh hot niberaa ||",
      "translation": "In the Company of the Holy, all conflicts are settled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਪਾਏ ਨਾਮ ਰਤਨੁ ॥",
      "transliteration": "saadh kai sa(n)g paae naam ratan ||",
      "translation": "In the Company of the Holy, one obtains the jewel of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਏਕ ਊਪਰਿ ਜਤਨੁ ॥",
      "transliteration": "saadh kai sa(n)g ek oopar jatan ||",
      "translation": "In the Company of the Holy, one's efforts are directed toward the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਾਧ ਕੀ ਮਹਿਮਾ ਬਰਨੈ ਕਉਨੁ ਪ੍ਰਾਨੀ ॥",
      "transliteration": "saadh kee mahimaa baranai kaun praanee ||",
      "translation": "What mortal can speak of the Glorious Praises of the Holy?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਨਕ ਸਾਧ ਕੀ ਸੋਭਾ ਪ੍ਰਭ ਮਾਹਿ ਸਮਾਨੀ ॥੧॥",
      "transliteration": "naanak saadh kee sobhaa prabh maahi samaanee ||1||",
      "translation": "O Nanak, the glory of the Holy people merges into God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਅਗੋਚਰੁ ਮਿਲੈ ॥",
      "transliteration": "saadh kai sa(n)g agochar milai ||",
      "translation": "In the Company of the Holy, one meets the Incomprehensible Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਸਦਾ ਪਰਫੁਲੈ ॥",
      "transliteration": "saadh kai sa(n)g sadaa paraphulai ||",
      "translation": "In the Company of the Holy, one flourishes forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਆਵਹਿ ਬਸਿ ਪੰਚਾ ॥",
      "transliteration": "saadh kai sa(n)g aavahi bas pa(n)chaa ||",
      "translation": "In the Company of the Holy, the five passions are brought to rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਅੰਮ੍ਰਿਤ ਰਸੁ ਭੁੰਚਾ ॥",
      "transliteration": "saadhasa(n)g a(n)mrit ras bhu(n)chaa ||",
      "translation": "In the Company of the Holy, one enjoys the essence of ambrosia.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਹੋਇ ਸਭ ਕੀ ਰੇਨ ॥",
      "transliteration": "saadhasa(n)g hoi sabh kee ren ||",
      "translation": "In the Company of the Holy, one becomes the dust of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਮਨੋਹਰ ਬੈਨ ॥",
      "transliteration": "saadh kai sa(n)g manohar bain ||",
      "translation": "In the Company of the Holy, one's speech is enticing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਨ ਕਤਹੂੰ ਧਾਵੈ ॥",
      "transliteration": "saadh kai sa(n)g na katahoo(n) dhaavai ||",
      "translation": "In the Company of the Holy, the mind does not wander.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਅਸਥਿਤਿ ਮਨੁ ਪਾਵੈ ॥",
      "transliteration": "saadhasa(n)g asathit man paavai ||",
      "translation": "In the Company of the Holy, the mind becomes stable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਮਾਇਆ ਤੇ ਭਿੰਨ ॥",
      "transliteration": "saadh kai sa(n)g maaiaa te bhi(n)n ||",
      "translation": "In the Company of the Holy, one is rid of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਨਾਨਕ ਪ੍ਰਭ ਸੁਪ੍ਰਸੰਨ ॥੨॥",
      "transliteration": "saadhasa(n)g naanak prabh suprasa(n)n ||2||",
      "translation": "In the Company of the Holy, O Nanak, God is totally pleased. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਦੁਸਮਨ ਸਭਿ ਮੀਤ ॥",
      "transliteration": "saadhasa(n)g dusaman sabh meet ||",
      "translation": "In the Company of the Holy, all one's enemies become friends.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਾਧੂ ਕੈ ਸੰਗਿ ਮਹਾ ਪੁਨੀਤ ॥",
      "transliteration": "saadhoo kai sa(n)g mahaa puneet ||",
      "translation": "In the Company of the Holy, there is great purity.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਕਿਸ ਸਿਉ ਨਹੀ ਬੈਰੁ ॥",
      "transliteration": "saadhasa(n)g kis siu nahee bair ||",
      "translation": "In the Company of the Holy, no one is hated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਨ ਬੀਗਾ ਪੈਰੁ ॥",
      "transliteration": "saadh kai sa(n)g na beegaa pair ||",
      "translation": "In the Company of the Holy, one's feet do not wander.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਨਾਹੀ ਕੋ ਮੰਦਾ ॥",
      "transliteration": "saadh kai sa(n)g naahee ko ma(n)daa ||",
      "translation": "In the Company of the Holy, no one seems evil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਜਾਨੇ ਪਰਮਾਨੰਦਾ ॥",
      "transliteration": "saadhasa(n)g jaane paramaana(n)daa ||",
      "translation": "In the Company of the Holy, supreme bliss is known.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਨਾਹੀ ਹਉ ਤਾਪੁ ॥",
      "transliteration": "saadh kai sa(n)g naahee hau taap ||",
      "translation": "In the Company of the Holy, the fever of ego departs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਤਜੈ ਸਭੁ ਆਪੁ ॥",
      "transliteration": "saadh kai sa(n)g tajai sabh aap ||",
      "translation": "In the Company of the Holy, one renounces all selfishness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਪੇ ਜਾਨੈ ਸਾਧ ਬਡਾਈ ॥",
      "transliteration": "aape jaanai saadh badaaee ||",
      "translation": "He Himself knows the greatness of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਸਾਧ ਪ੍ਰਭੂ ਬਨਿ ਆਈ ॥੩॥",
      "transliteration": "naanak saadh prabhoo ban aaee ||3||",
      "translation": "O Nanak, the Holy are at one with God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਨ ਕਬਹੂ ਧਾਵੈ ॥",
      "transliteration": "saadh kai sa(n)g na kabahoo dhaavai ||",
      "translation": "In the Company of the Holy, the mind never wanders.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਸਦਾ ਸੁਖੁ ਪਾਵੈ ॥",
      "transliteration": "saadh kai sa(n)g sadaa sukh paavai ||",
      "translation": "In the Company of the Holy, one obtains everlasting peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਬਸਤੁ ਅਗੋਚਰ ਲਹੈ ॥",
      "transliteration": "saadhasa(n)g basat agochar lahai ||",
      "translation": "In the Company of the Holy, one grasps the Incomprehensible.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਾਧੂ ਕੈ ਸੰਗਿ ਅਜਰੁ ਸਹੈ ॥",
      "transliteration": "saadhoo kai sa(n)g ajar sahai ||",
      "translation": "In the Company of the Holy, one can endure the unendurable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਬਸੈ ਥਾਨਿ ਊਚੈ ॥",
      "transliteration": "saadh kai sa(n)g basai thaan oochai ||",
      "translation": "In the Company of the Holy, one abides in the loftiest place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਾਧੂ ਕੈ ਸੰਗਿ ਮਹਲਿ ਪਹੂਚੈ ॥",
      "transliteration": "saadhoo kai sa(n)g mahal pahoochai ||",
      "translation": "In the Company of the Holy, one attains the Mansion of the Lord's Presence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਦ੍ਰਿੜੈ ਸਭਿ ਧਰਮ ॥",
      "transliteration": "saadh kai sa(n)g driRai sabh dharam ||",
      "translation": "In the Company of the Holy, one's Dharmic faith is firmly established.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਕੇਵਲ ਪਾਰਬ੍ਰਹਮ ॥",
      "transliteration": "saadh kai sa(n)g keval paarabraham ||",
      "translation": "In the Company of the Holy, one dwells with the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਪਾਏ ਨਾਮ ਨਿਧਾਨ ॥",
      "transliteration": "saadh kai sa(n)g paae naam nidhaan ||",
      "translation": "In the Company of the Holy, one obtains the treasure of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨਾਨਕ ਸਾਧੂ ਕੈ ਕੁਰਬਾਨ ॥੪॥",
      "transliteration": "naanak saadhoo kai kurabaan ||4||",
      "translation": "O Nanak, I am a sacrifice to the Holy. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਸਭ ਕੁਲ ਉਧਾਰੈ ॥",
      "transliteration": "saadh kai sa(n)g sabh kul udhaarai ||",
      "translation": "In the Company of the Holy, all one's family is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਸਾਜਨ ਮੀਤ ਕੁਟੰਬ ਨਿਸਤਾਰੈ ॥",
      "transliteration": "saadhasa(n)g saajan meet kuta(n)b nisataarai ||",
      "translation": "In the Company of the Holy, one's friends, acquaintances and relatives are redeemed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸਾਧੂ ਕੈ ਸੰਗਿ ਸੋ ਧਨੁ ਪਾਵੈ ॥",
      "transliteration": "saadhoo kai sa(n)g so dhan paavai ||",
      "translation": "In the Company of the Holy, that wealth is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਿਸੁ ਧਨ ਤੇ ਸਭੁ ਕੋ ਵਰਸਾਵੈ ॥",
      "transliteration": "jis dhan te sabh ko varasaavai ||",
      "translation": "Everyone benefits from that wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਧਰਮ ਰਾਇ ਕਰੇ ਸੇਵਾ ॥",
      "transliteration": "saadhasa(n)g dharam raai kare sevaa ||",
      "translation": "In the Company of the Holy, the Lord of Dharma serves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਸੋਭਾ ਸੁਰਦੇਵਾ ॥",
      "transliteration": "saadh kai sa(n)g sobhaa suradevaa ||",
      "translation": "In the Company of the Holy, the divine, angelic beings sing God's Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸਾਧੂ ਕੈ ਸੰਗਿ ਪਾਪ ਪਲਾਇਨ ॥",
      "transliteration": "saadhoo kai sa(n)g paap palaain ||",
      "translation": "In the Company of the Holy, one's sins fly away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਅੰਮ੍ਰਿਤ ਗੁਨ ਗਾਇਨ ॥",
      "transliteration": "saadhasa(n)g a(n)mrit gun gaain ||",
      "translation": "In the Company of the Holy, one sings the Ambrosial Glories.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0271_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਸ੍ਰਬ ਥਾਨ ਗੰਮਿ ॥",
      "transliteration": "saadh kai sa(n)g srab thaan ga(n)m ||",
      "translation": "In the Company of the Holy, all places are within reach.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 271,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
