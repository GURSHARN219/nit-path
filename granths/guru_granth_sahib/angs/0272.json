{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 272,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0272_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਨਕ ਸਾਧ ਕੈ ਸੰਗਿ ਸਫਲ ਜਨੰਮ ॥੫॥",
      "transliteration": "naanak saadh kai sa(n)g saphal jana(n)m ||5||",
      "translation": "O Nanak, in the Company of the Holy, one's life becomes fruitful. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਨਹੀ ਕਛੁ ਘਾਲ ॥",
      "transliteration": "saadh kai sa(n)g nahee kachh ghaal ||",
      "translation": "In the Company of the Holy, there is no suffering.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦਰਸਨੁ ਭੇਟਤ ਹੋਤ ਨਿਹਾਲ ॥",
      "transliteration": "darasan bhetat hot nihaal ||",
      "translation": "The Blessed Vision of their Darshan brings a sublime, happy peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਕਲੂਖਤ ਹਰੈ ॥",
      "transliteration": "saadh kai sa(n)g kalookhat harai ||",
      "translation": "In the Company of the Holy, blemishes are removed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਨਰਕ ਪਰਹਰੈ ॥",
      "transliteration": "saadh kai sa(n)g narak paraharai ||",
      "translation": "In the Company of the Holy, hell is far away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਈਹਾ ਊਹਾ ਸੁਹੇਲਾ ॥",
      "transliteration": "saadh kai sa(n)g eehaa oohaa suhelaa ||",
      "translation": "In the Company of the Holy, one is happy here and hereafter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਬਿਛੁਰਤ ਹਰਿ ਮੇਲਾ ॥",
      "transliteration": "saadhasa(n)g bichhurat har melaa ||",
      "translation": "In the Company of the Holy, the separated ones are reunited with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੋ ਇਛੈ ਸੋਈ ਫਲੁ ਪਾਵੈ ॥",
      "transliteration": "jo ichhai soee phal paavai ||",
      "translation": "The fruits of one's desires are obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਨ ਬਿਰਥਾ ਜਾਵੈ ॥",
      "transliteration": "saadh kai sa(n)g na birathaa jaavai ||",
      "translation": "In the Company of the Holy, no one goes empty-handed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਸਾਧ ਰਿਦ ਬਸੈ ॥",
      "transliteration": "paarabraham saadh rid basai ||",
      "translation": "The Supreme Lord God dwells in the hearts of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਨਕ ਉਧਰੈ ਸਾਧ ਸੁਨਿ ਰਸੈ ॥੬॥",
      "transliteration": "naanak udharai saadh sun rasai ||6||",
      "translation": "O Nanak, listening to the sweet words of the Holy, one is saved. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਸੁਨਉ ਹਰਿ ਨਾਉ ॥",
      "transliteration": "saadh kai sa(n)g sunau har naau ||",
      "translation": "In the Company of the Holy, listen to the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਹਰਿ ਕੇ ਗੁਨ ਗਾਉ ॥",
      "transliteration": "saadhasa(n)g har ke gun gaau ||",
      "translation": "In the Company of the Holy, sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਨ ਮਨ ਤੇ ਬਿਸਰੈ ॥",
      "transliteration": "saadh kai sa(n)g na man te bisarai ||",
      "translation": "In the Company of the Holy, do not forget Him from your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਸਰਪਰ ਨਿਸਤਰੈ ॥",
      "transliteration": "saadhasa(n)g sarapar nisatarai ||",
      "translation": "In the Company of the Holy, you shall surely be saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਲਗੈ ਪ੍ਰਭੁ ਮੀਠਾ ॥",
      "transliteration": "saadh kai sa(n)g lagai prabh meethaa ||",
      "translation": "In the Company of the Holy, God seems very sweet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਾਧੂ ਕੈ ਸੰਗਿ ਘਟਿ ਘਟਿ ਡੀਠਾ ॥",
      "transliteration": "saadhoo kai sa(n)g ghat ghat deethaa ||",
      "translation": "In the Company of the Holy, He is seen in each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਭਏ ਆਗਿਆਕਾਰੀ ॥",
      "transliteration": "saadhasa(n)g bhae aagiaakaaree ||",
      "translation": "In the Company of the Holy, we become obedient to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਗਤਿ ਭਈ ਹਮਾਰੀ ॥",
      "transliteration": "saadhasa(n)g gat bhaee hamaaree ||",
      "translation": "In the Company of the Holy, we obtain the state of salvation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਧ ਕੈ ਸੰਗਿ ਮਿਟੇ ਸਭਿ ਰੋਗ ॥",
      "transliteration": "saadh kai sa(n)g mite sabh rog ||",
      "translation": "In the Company of the Holy, all diseases are cured.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਨਕ ਸਾਧ ਭੇਟੇ ਸੰਜੋਗ ॥੭॥",
      "transliteration": "naanak saadh bhete sa(n)jog ||7||",
      "translation": "O Nanak, one meets with the Holy, by highest destiny. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾਧ ਕੀ ਮਹਿਮਾ ਬੇਦ ਨ ਜਾਨਹਿ ॥",
      "transliteration": "saadh kee mahimaa bed na jaanahi ||",
      "translation": "The glory of the Holy people is not known to the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੇਤਾ ਸੁਨਹਿ ਤੇਤਾ ਬਖਿਆਨਹਿ ॥",
      "transliteration": "jetaa sunahi tetaa bakhiaanahi ||",
      "translation": "They can describe only what they have heard.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਾਧ ਕੀ ਉਪਮਾ ਤਿਹੁ ਗੁਣ ਤੇ ਦੂਰਿ ॥",
      "transliteration": "saadh kee upamaa tihu gun te door ||",
      "translation": "The greatness of the Holy people is beyond the three qualities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਾਧ ਕੀ ਉਪਮਾ ਰਹੀ ਭਰਪੂਰਿ ॥",
      "transliteration": "saadh kee upamaa rahee bharapoor ||",
      "translation": "The greatness of the Holy people is all-pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਾਧ ਕੀ ਸੋਭਾ ਕਾ ਨਾਹੀ ਅੰਤ ॥",
      "transliteration": "saadh kee sobhaa kaa naahee a(n)t ||",
      "translation": "The glory of the Holy people has no limit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਾਧ ਕੀ ਸੋਭਾ ਸਦਾ ਬੇਅੰਤ ॥",
      "transliteration": "saadh kee sobhaa sadaa bea(n)t ||",
      "translation": "The glory of the Holy people is infinite and eternal.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਾਧ ਕੀ ਸੋਭਾ ਊਚ ਤੇ ਊਚੀ ॥",
      "transliteration": "saadh kee sobhaa ooch te oochee ||",
      "translation": "The glory of the Holy people is the highest of the high.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਾਧ ਕੀ ਸੋਭਾ ਮੂਚ ਤੇ ਮੂਚੀ ॥",
      "transliteration": "saadh kee sobhaa mooch te moochee ||",
      "translation": "The glory of the Holy people is the greatest of the great.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਧ ਕੀ ਸੋਭਾ ਸਾਧ ਬਨਿ ਆਈ ॥",
      "transliteration": "saadh kee sobhaa saadh ban aaee ||",
      "translation": "The glory of the Holy people is theirs alone;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾਨਕ ਸਾਧ ਪ੍ਰਭ ਭੇਦੁ ਨ ਭਾਈ ॥੮॥੭॥",
      "transliteration": "naanak saadh prabh bhed na bhaaee ||8||7||",
      "translation": "O Nanak, there is no difference between the Holy people and God. ||8||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਨਿ ਸਾਚਾ ਮੁਖਿ ਸਾਚਾ ਸੋਇ ॥",
      "transliteration": "man saachaa mukh saachaa soi ||",
      "translation": "The True One is on his mind, and the True One is upon his lips.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਵਰੁ ਨ ਪੇਖੈ ਏਕਸੁ ਬਿਨੁ ਕੋਇ ॥",
      "transliteration": "avar na pekhai ekas bin koi ||",
      "translation": "He sees only the One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕ ਇਹ ਲਛਣ ਬ੍ਰਹਮ ਗਿਆਨੀ ਹੋਇ ॥੧॥",
      "transliteration": "naanak ih lachhan braham giaanee hoi ||1||",
      "translation": "O Nanak, these are the qualities of the God-conscious being. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਸਦਾ ਨਿਰਲੇਪ ॥",
      "transliteration": "braham giaanee sadaa niralep ||",
      "translation": "The God-conscious being is always unattached,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੈਸੇ ਜਲ ਮਹਿ ਕਮਲ ਅਲੇਪ ॥",
      "transliteration": "jaise jal mahi kamal alep ||",
      "translation": "as the lotus in the water remains detached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਸਦਾ ਨਿਰਦੋਖ ॥",
      "transliteration": "braham giaanee sadaa niradokh ||",
      "translation": "The God-conscious being is always unstained,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੈਸੇ ਸੂਰੁ ਸਰਬ ਕਉ ਸੋਖ ॥",
      "transliteration": "jaise soor sarab kau sokh ||",
      "translation": "like the sun, which gives its comfort and warmth to all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਦ੍ਰਿਸਟਿ ਸਮਾਨਿ ॥",
      "transliteration": "braham giaanee kai drisat samaan ||",
      "translation": "The God-conscious being looks upon all alike,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੈਸੇ ਰਾਜ ਰੰਕ ਕਉ ਲਾਗੈ ਤੁਲਿ ਪਵਾਨ ॥",
      "transliteration": "jaise raaj ra(n)k kau laagai tul pavaan ||",
      "translation": "like the wind, which blows equally upon the king and the poor beggar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਧੀਰਜੁ ਏਕ ॥",
      "transliteration": "braham giaanee kai dheeraj ek ||",
      "translation": "The God-conscious being has a steady patience,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਉ ਬਸੁਧਾ ਕੋਊ ਖੋਦੈ ਕੋਊ ਚੰਦਨ ਲੇਪ ॥",
      "transliteration": "jiu basudhaa kooo khodai kooo cha(n)dan lep ||",
      "translation": "like the earth, which is dug up by one, and anointed with sandal paste by another.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਇਹੈ ਗੁਨਾਉ ॥",
      "transliteration": "braham giaanee kaa ihai gunaau ||",
      "translation": "This is the quality of the God-conscious being:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕ ਜਿਉ ਪਾਵਕ ਕਾ ਸਹਜ ਸੁਭਾਉ ॥੧॥",
      "transliteration": "naanak jiu paavak kaa sahaj subhaau ||1||",
      "translation": "O Nanak, his inherent nature is like a warming fire. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਨਿਰਮਲ ਤੇ ਨਿਰਮਲਾ ॥",
      "transliteration": "braham giaanee niramal te niramalaa ||",
      "translation": "The God-conscious being is the purest of the pure;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜੈਸੇ ਮੈਲੁ ਨ ਲਾਗੈ ਜਲਾ ॥",
      "transliteration": "jaise mail na laagai jalaa ||",
      "translation": "filth does not stick to water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਮਨਿ ਹੋਇ ਪ੍ਰਗਾਸੁ ॥",
      "transliteration": "braham giaanee kai man hoi pragaas ||",
      "translation": "The God-conscious being's mind is enlightened,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜੈਸੇ ਧਰ ਊਪਰਿ ਆਕਾਸੁ ॥",
      "transliteration": "jaise dhar oopar aakaas ||",
      "translation": "like the sky above the earth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਮਿਤ੍ਰ ਸਤ੍ਰੁ ਸਮਾਨਿ ॥",
      "transliteration": "braham giaanee kai mitr satr samaan ||",
      "translation": "To the God-conscious being, friend and foe are the same.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਨਾਹੀ ਅਭਿਮਾਨ ॥",
      "transliteration": "braham giaanee kai naahee abhimaan ||",
      "translation": "The God-conscious being has no egotistical pride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਊਚ ਤੇ ਊਚਾ ॥",
      "transliteration": "braham giaanee ooch te oochaa ||",
      "translation": "The God-conscious being is the highest of the high.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮਨਿ ਅਪਨੈ ਹੈ ਸਭ ਤੇ ਨੀਚਾ ॥",
      "transliteration": "man apanai hai sabh te neechaa ||",
      "translation": "Within his own mind, he is the most humble of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਸੇ ਜਨ ਭਏ ॥",
      "transliteration": "braham giaanee se jan bhae ||",
      "translation": "They alone become God-conscious beings,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਨਕ ਜਿਨ ਪ੍ਰਭੁ ਆਪਿ ਕਰੇਇ ॥੨॥",
      "transliteration": "naanak jin prabh aap karei ||2||",
      "translation": "O Nanak, whom God Himself makes so. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਸਗਲ ਕੀ ਰੀਨਾ ॥",
      "transliteration": "braham giaanee sagal kee reenaa ||",
      "translation": "The God-conscious being is the dust of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਆਤਮ ਰਸੁ ਬ੍ਰਹਮ ਗਿਆਨੀ ਚੀਨਾ ॥",
      "transliteration": "aatam ras braham giaanee cheenaa ||",
      "translation": "The God-conscious being knows the nature of the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੀ ਸਭ ਊਪਰਿ ਮਇਆ ॥",
      "transliteration": "braham giaanee kee sabh oopar maiaa ||",
      "translation": "The God-conscious being shows kindness to all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਤੇ ਕਛੁ ਬੁਰਾ ਨ ਭਇਆ ॥",
      "transliteration": "braham giaanee te kachh buraa na bhaiaa ||",
      "translation": "No evil comes from the God-conscious being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0272_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਸਦਾ ਸਮਦਰਸੀ ॥",
      "transliteration": "braham giaanee sadaa samadarasee ||",
      "translation": "The God-conscious being is always impartial.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 272,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
