{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 273,
  "lineCount": 52,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0273_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੀ ਦ੍ਰਿਸਟਿ ਅੰਮ੍ਰਿਤੁ ਬਰਸੀ ॥",
      "transliteration": "braham giaanee kee drisat a(n)mrit barasee ||",
      "translation": "Nectar rains down from the glance of the God-conscious being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਬੰਧਨ ਤੇ ਮੁਕਤਾ ॥",
      "transliteration": "braham giaanee ba(n)dhan te mukataa ||",
      "translation": "The God-conscious being is free from entanglements.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੀ ਨਿਰਮਲ ਜੁਗਤਾ ॥",
      "transliteration": "braham giaanee kee niramal jugataa ||",
      "translation": "The lifestyle of the God-conscious being is spotlessly pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਭੋਜਨੁ ਗਿਆਨ ॥",
      "transliteration": "braham giaanee kaa bhojan giaan ||",
      "translation": "Spiritual wisdom is the food of the God-conscious being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਨਕ ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਬ੍ਰਹਮ ਧਿਆਨੁ ॥੩॥",
      "transliteration": "naanak braham giaanee kaa braham dhiaan ||3||",
      "translation": "O Nanak, the God-conscious being is absorbed in God's meditation. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਏਕ ਊਪਰਿ ਆਸ ॥",
      "transliteration": "braham giaanee ek oopar aas ||",
      "translation": "The God-conscious being centers his hopes on the One alone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਨਹੀ ਬਿਨਾਸ ॥",
      "transliteration": "braham giaanee kaa nahee binaas ||",
      "translation": "The God-conscious being shall never perish.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਗਰੀਬੀ ਸਮਾਹਾ ॥",
      "transliteration": "braham giaanee kai gareebee samaahaa ||",
      "translation": "The God-conscious being is steeped in humility.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਪਰਉਪਕਾਰ ਉਮਾਹਾ ॥",
      "transliteration": "braham giaanee paraupakaar umaahaa ||",
      "translation": "The God-conscious being delights in doing good to others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਨਾਹੀ ਧੰਧਾ ॥",
      "transliteration": "braham giaanee kai naahee dha(n)dhaa ||",
      "translation": "The God-conscious being has no worldly entanglements.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਲੇ ਧਾਵਤੁ ਬੰਧਾ ॥",
      "transliteration": "braham giaanee le dhaavat ba(n)dhaa ||",
      "translation": "The God-conscious being holds his wandering mind under control.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਹੋਇ ਸੁ ਭਲਾ ॥",
      "transliteration": "braham giaanee kai hoi s bhalaa ||",
      "translation": "The God-conscious being acts in the common good.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਸੁਫਲ ਫਲਾ ॥",
      "transliteration": "braham giaanee suphal phalaa ||",
      "translation": "The God-conscious being blossoms in fruitfulness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਸੰਗਿ ਸਗਲ ਉਧਾਰੁ ॥",
      "transliteration": "braham giaanee sa(n)g sagal udhaar ||",
      "translation": "In the Company of the God-conscious being, all are saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਬ੍ਰਹਮ ਗਿਆਨੀ ਜਪੈ ਸਗਲ ਸੰਸਾਰੁ ॥੪॥",
      "transliteration": "naanak braham giaanee japai sagal sa(n)saar ||4||",
      "translation": "O Nanak, through the God-conscious being, the whole world meditates on God. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਏਕੈ ਰੰਗ ॥",
      "transliteration": "braham giaanee kai ekai ra(n)g ||",
      "translation": "The God-conscious being loves the One Lord alone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਬਸੈ ਪ੍ਰਭੁ ਸੰਗ ॥",
      "transliteration": "braham giaanee kai basai prabh sa(n)g ||",
      "translation": "The God-conscious being dwells with God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਨਾਮੁ ਆਧਾਰੁ ॥",
      "transliteration": "braham giaanee kai naam aadhaar ||",
      "translation": "The God-conscious being takes the Naam as his Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਨਾਮੁ ਪਰਵਾਰੁ ॥",
      "transliteration": "braham giaanee kai naam paravaar ||",
      "translation": "The God-conscious being has the Naam as his Family.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਸਦਾ ਸਦ ਜਾਗਤ ॥",
      "transliteration": "braham giaanee sadaa sad jaagat ||",
      "translation": "The God-conscious being is awake and aware, forever and ever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਅਹੰਬੁਧਿ ਤਿਆਗਤ ॥",
      "transliteration": "braham giaanee aha(n)budh tiaagat ||",
      "translation": "The God-conscious being renounces his proud ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਮਨਿ ਪਰਮਾਨੰਦ ॥",
      "transliteration": "braham giaanee kai man paramaana(n)d ||",
      "translation": "In the mind of the God-conscious being, there is supreme bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਘਰਿ ਸਦਾ ਅਨੰਦ ॥",
      "transliteration": "braham giaanee kai ghar sadaa ana(n)d ||",
      "translation": "In the home of the God-conscious being, there is everlasting bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਸੁਖ ਸਹਜ ਨਿਵਾਸ ॥",
      "transliteration": "braham giaanee sukh sahaj nivaas ||",
      "translation": "The God-conscious being dwells in peaceful ease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਨਕ ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਨਹੀ ਬਿਨਾਸ ॥੫॥",
      "transliteration": "naanak braham giaanee kaa nahee binaas ||5||",
      "translation": "O Nanak, the God-conscious being shall never perish. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਬ੍ਰਹਮ ਕਾ ਬੇਤਾ ॥",
      "transliteration": "braham giaanee braham kaa betaa ||",
      "translation": "The God-conscious being knows God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਏਕ ਸੰਗਿ ਹੇਤਾ ॥",
      "transliteration": "braham giaanee ek sa(n)g hetaa ||",
      "translation": "The God-conscious being is in love with the One alone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਹੋਇ ਅਚਿੰਤ ॥",
      "transliteration": "braham giaanee kai hoi achi(n)t ||",
      "translation": "The God-conscious being is carefree.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਨਿਰਮਲ ਮੰਤ ॥",
      "transliteration": "braham giaanee kaa niramal ma(n)t ||",
      "translation": "Pure are the Teachings of the God-conscious being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਜਿਸੁ ਕਰੈ ਪ੍ਰਭੁ ਆਪਿ ॥",
      "transliteration": "braham giaanee jis karai prabh aap ||",
      "translation": "The God-conscious being is made so by God Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਬਡ ਪਰਤਾਪ ॥",
      "transliteration": "braham giaanee kaa bad parataap ||",
      "translation": "The God-conscious being is gloriously great.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਦਰਸੁ ਬਡਭਾਗੀ ਪਾਈਐ ॥",
      "transliteration": "braham giaanee kaa daras badabhaagee paaeeai ||",
      "translation": "The Darshan, the Blessed Vision of the God-conscious being, is obtained by great good fortune.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਉ ਬਲਿ ਬਲਿ ਜਾਈਐ ॥",
      "transliteration": "braham giaanee kau bal bal jaaeeai ||",
      "translation": "To the God-conscious being, I make my life a sacrifice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਉ ਖੋਜਹਿ ਮਹੇਸੁਰ ॥",
      "transliteration": "braham giaanee kau khojahi mahesur ||",
      "translation": "The God-conscious being is sought by the great god Shiva.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕ ਬ੍ਰਹਮ ਗਿਆਨੀ ਆਪਿ ਪਰਮੇਸੁਰ ॥੬॥",
      "transliteration": "naanak braham giaanee aap paramesur ||6||",
      "translation": "O Nanak, the God-conscious being is Himself the Supreme Lord God. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੀ ਕੀਮਤਿ ਨਾਹਿ ॥",
      "transliteration": "braham giaanee kee keemat naahi ||",
      "translation": "The God-conscious being cannot be appraised.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੈ ਸਗਲ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "braham giaanee kai sagal man maahi ||",
      "translation": "The God-conscious being has all within his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਕਉਨ ਜਾਨੈ ਭੇਦੁ ॥",
      "transliteration": "braham giaanee kaa kaun jaanai bhed ||",
      "translation": "Who can know the mystery of the God-conscious being?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਉ ਸਦਾ ਅਦੇਸੁ ॥",
      "transliteration": "braham giaanee kau sadaa ades ||",
      "translation": "Forever bow to the God-conscious being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਕਥਿਆ ਨ ਜਾਇ ਅਧਾਖੵਰੁ ॥",
      "transliteration": "braham giaanee kaa kathiaa na jaai adhaakhyr ||",
      "translation": "The God-conscious being cannot be described in words.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਸਰਬ ਕਾ ਠਾਕੁਰੁ ॥",
      "transliteration": "braham giaanee sarab kaa thaakur ||",
      "translation": "The God-conscious being is the Lord and Master of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੀ ਮਿਤਿ ਕਉਨੁ ਬਖਾਨੈ ॥",
      "transliteration": "braham giaanee kee mit kaun bakhaanai ||",
      "translation": "Who can describe the limits of the God-conscious being?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੀ ਗਤਿ ਬ੍ਰਹਮ ਗਿਆਨੀ ਜਾਨੈ ॥",
      "transliteration": "braham giaanee kee gat braham giaanee jaanai ||",
      "translation": "Only the God-conscious being can know the state of the God-conscious being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਅੰਤੁ ਨ ਪਾਰੁ ॥",
      "transliteration": "braham giaanee kaa a(n)t na paar ||",
      "translation": "The God-conscious being has no end or limitation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਉ ਸਦਾ ਨਮਸਕਾਰੁ ॥੭॥",
      "transliteration": "naanak braham giaanee kau sadaa namasakaar ||7||",
      "translation": "O Nanak, to the God-conscious being, bow forever in reverence. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਸਭ ਸ੍ਰਿਸਟਿ ਕਾ ਕਰਤਾ ॥",
      "transliteration": "braham giaanee sabh srisat kaa karataa ||",
      "translation": "The God-conscious being is the Creator of all the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਸਦ ਜੀਵੈ ਨਹੀ ਮਰਤਾ ॥",
      "transliteration": "braham giaanee sad jeevai nahee marataa ||",
      "translation": "The God-conscious being lives forever, and does not die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਮੁਕਤਿ ਜੁਗਤਿ ਜੀਅ ਕਾ ਦਾਤਾ ॥",
      "transliteration": "braham giaanee mukat jugat jee kaa daataa ||",
      "translation": "The God-conscious being is the Giver of the way of liberation of the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਪੂਰਨ ਪੁਰਖੁ ਬਿਧਾਤਾ ॥",
      "transliteration": "braham giaanee pooran purakh bidhaataa ||",
      "translation": "The God-conscious being is the Perfect Supreme Being, who orchestrates all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਅਨਾਥ ਕਾ ਨਾਥੁ ॥",
      "transliteration": "braham giaanee anaath kaa naath ||",
      "translation": "The God-conscious being is the helper of the helpless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਸਭ ਊਪਰਿ ਹਾਥੁ ॥",
      "transliteration": "braham giaanee kaa sabh oopar haath ||",
      "translation": "The God-conscious being extends his hand to all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0273_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕਾ ਸਗਲ ਅਕਾਰੁ ॥",
      "transliteration": "braham giaanee kaa sagal akaar ||",
      "translation": "The God-conscious being owns the entire creation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 273,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
