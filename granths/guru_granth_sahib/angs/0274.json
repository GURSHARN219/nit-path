{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 274,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0274_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਆਪਿ ਨਿਰੰਕਾਰੁ ॥",
      "transliteration": "braham giaanee aap nira(n)kaar ||",
      "translation": "The God-conscious being is himself the Formless Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਕੀ ਸੋਭਾ ਬ੍ਰਹਮ ਗਿਆਨੀ ਬਨੀ ॥",
      "transliteration": "braham giaanee kee sobhaa braham giaanee banee ||",
      "translation": "The glory of the God-conscious being belongs to the God-conscious being alone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਨਕ ਬ੍ਰਹਮ ਗਿਆਨੀ ਸਰਬ ਕਾ ਧਨੀ ॥੮॥੮॥",
      "transliteration": "naanak braham giaanee sarab kaa dhanee ||8||8||",
      "translation": "O Nanak, the God-conscious being is the Lord of all. ||8||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਉਰਿ ਧਾਰੈ ਜੋ ਅੰਤਰਿ ਨਾਮੁ ॥",
      "transliteration": "ur dhaarai jo a(n)tar naam ||",
      "translation": "One who enshrines the Naam within the heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਰਬ ਮੈ ਪੇਖੈ ਭਗਵਾਨੁ ॥",
      "transliteration": "sarab mai pekhai bhagavaan ||",
      "translation": "who sees the Lord God in all,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਿਮਖ ਨਿਮਖ ਠਾਕੁਰ ਨਮਸਕਾਰੈ ॥",
      "transliteration": "nimakh nimakh thaakur namasakaarai ||",
      "translation": "who, each and every moment, bows in reverence to the Lord Master",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਨਕ ਓਹੁ ਅਪਰਸੁ ਸਗਲ ਨਿਸਤਾਰੈ ॥੧॥",
      "transliteration": "naanak ohu aparas sagal nisataarai ||1||",
      "translation": "- O Nanak, such a one is the true 'touch-nothing Saint', who emancipates everyone. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਿਥਿਆ ਨਾਹੀ ਰਸਨਾ ਪਰਸ ॥",
      "transliteration": "mithiaa naahee rasanaa paras ||",
      "translation": "One whose tongue does not touch falsehood;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਨ ਮਹਿ ਪ੍ਰੀਤਿ ਨਿਰੰਜਨ ਦਰਸ ॥",
      "transliteration": "man mahi preet nira(n)jan daras ||",
      "translation": "whose mind is filled with love for the Blessed Vision of the Pure Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਰ ਤ੍ਰਿਅ ਰੂਪੁ ਨ ਪੇਖੈ ਨੇਤ੍ਰ ॥",
      "transliteration": "par tri roop na pekhai netr ||",
      "translation": "whose eyes do not gaze upon the beauty of others' wives,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਧ ਕੀ ਟਹਲ ਸੰਤਸੰਗਿ ਹੇਤ ॥",
      "transliteration": "saadh kee tahal sa(n)tasa(n)g het ||",
      "translation": "who serves the Holy and loves the Saints' Congregation,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰਨ ਨ ਸੁਨੈ ਕਾਹੂ ਕੀ ਨਿੰਦਾ ॥",
      "transliteration": "karan na sunai kaahoo kee ni(n)daa ||",
      "translation": "whose ears do not listen to slander against anyone,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਭ ਤੇ ਜਾਨੈ ਆਪਸ ਕਉ ਮੰਦਾ ॥",
      "transliteration": "sabh te jaanai aapas kau ma(n)daa ||",
      "translation": "who deems himself to be the worst of all,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਬਿਖਿਆ ਪਰਹਰੈ ॥",
      "transliteration": "gur prasaad bikhiaa paraharai ||",
      "translation": "who, by Guru's Grace, renounces corruption,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਨ ਕੀ ਬਾਸਨਾ ਮਨ ਤੇ ਟਰੈ ॥",
      "transliteration": "man kee baasanaa man te tarai ||",
      "translation": "who banishes the mind's evil desires from his mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇੰਦ੍ਰੀ ਜਿਤ ਪੰਚ ਦੋਖ ਤੇ ਰਹਤ ॥",
      "transliteration": "i(n)dree jit pa(n)ch dokh te rahat ||",
      "translation": "who conquers his sexual instincts and is free of the five sinful passions",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਕੋਟਿ ਮਧੇ ਕੋ ਐਸਾ ਅਪਰਸ ॥੧॥",
      "transliteration": "naanak kot madhe ko aisaa aparas ||1||",
      "translation": "- O Nanak, among millions, there is scarcely one such 'touch-nothing Saint'. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬੈਸਨੋ ਸੋ ਜਿਸੁ ਊਪਰਿ ਸੁਪ੍ਰਸੰਨ ॥",
      "transliteration": "baisano so jis oopar suprasa(n)n ||",
      "translation": "The true Vaishnaav, the devotee of Vishnu, is the one with whom God is thoroughly pleased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਸਨ ਕੀ ਮਾਇਆ ਤੇ ਹੋਇ ਭਿੰਨ ॥",
      "transliteration": "bisan kee maaiaa te hoi bhi(n)n ||",
      "translation": "He dwells apart from Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਰਮ ਕਰਤ ਹੋਵੈ ਨਿਹਕਰਮ ॥",
      "transliteration": "karam karat hovai nihakaram ||",
      "translation": "Performing good deeds, he does not seek rewards.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਿਸੁ ਬੈਸਨੋ ਕਾ ਨਿਰਮਲ ਧਰਮ ॥",
      "transliteration": "tis baisano kaa niramal dharam ||",
      "translation": "Spotlessly pure is the religion of such a Vaishnaav;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਾਹੂ ਫਲ ਕੀ ਇਛਾ ਨਹੀ ਬਾਛੈ ॥",
      "transliteration": "kaahoo phal kee ichhaa nahee baachhai ||",
      "translation": "he has no desire for the fruits of his labors.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕੇਵਲ ਭਗਤਿ ਕੀਰਤਨ ਸੰਗਿ ਰਾਚੈ ॥",
      "transliteration": "keval bhagat keeratan sa(n)g raachai ||",
      "translation": "He is absorbed in devotional worship and the singing of Kirtan, the songs of the Lord's Glory.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨ ਤਨ ਅੰਤਰਿ ਸਿਮਰਨ ਗੋਪਾਲ ॥",
      "transliteration": "man tan a(n)tar simaran gopaal ||",
      "translation": "Within his mind and body, he meditates in remembrance on the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਭ ਊਪਰਿ ਹੋਵਤ ਕਿਰਪਾਲ ॥",
      "transliteration": "sabh oopar hovat kirapaal ||",
      "translation": "He is kind to all creatures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਆਪਿ ਦ੍ਰਿੜੈ ਅਵਰਹ ਨਾਮੁ ਜਪਾਵੈ ॥",
      "transliteration": "aap driRai avarah naam japaavai ||",
      "translation": "He holds fast to the Naam, and inspires others to chant it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਨਕ ਓਹੁ ਬੈਸਨੋ ਪਰਮ ਗਤਿ ਪਾਵੈ ॥੨॥",
      "transliteration": "naanak ohu baisano param gat paavai ||2||",
      "translation": "O Nanak, such a Vaishnaav obtains the supreme status. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਗਉਤੀ ਭਗਵੰਤ ਭਗਤਿ ਕਾ ਰੰਗੁ ॥",
      "transliteration": "bhagautee bhagava(n)t bhagat kaa ra(n)g ||",
      "translation": "The true Bhagaautee, the devotee of Adi Shakti, loves the devotional worship of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਗਲ ਤਿਆਗੈ ਦੁਸਟ ਕਾ ਸੰਗੁ ॥",
      "transliteration": "sagal tiaagai dusat kaa sa(n)g ||",
      "translation": "He forsakes the company of all wicked people.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਨ ਤੇ ਬਿਨਸੈ ਸਗਲਾ ਭਰਮੁ ॥",
      "transliteration": "man te binasai sagalaa bharam ||",
      "translation": "All doubts are removed from his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਰਿ ਪੂਜੈ ਸਗਲ ਪਾਰਬ੍ਰਹਮੁ ॥",
      "transliteration": "kar poojai sagal paarabraham ||",
      "translation": "He performs devotional service to the Supreme Lord God in all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਪਾਪਾ ਮਲੁ ਖੋਵੈ ॥",
      "transliteration": "saadhasa(n)g paapaa mal khovai ||",
      "translation": "In the Company of the Holy, the filth of sin is washed away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਿਸੁ ਭਗਉਤੀ ਕੀ ਮਤਿ ਊਤਮ ਹੋਵੈ ॥",
      "transliteration": "tis bhagautee kee mat ootam hovai ||",
      "translation": "The wisdom of such a Bhagaautee becomes supreme.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਗਵੰਤ ਕੀ ਟਹਲ ਕਰੈ ਨਿਤ ਨੀਤਿ ॥",
      "transliteration": "bhagava(n)t kee tahal karai nit neet ||",
      "translation": "He constantly performs the service of the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਅਰਪੈ ਬਿਸਨ ਪਰੀਤਿ ॥",
      "transliteration": "man tan arapai bisan pareet ||",
      "translation": "He dedicates his mind and body to the Love of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਰਿ ਕੇ ਚਰਨ ਹਿਰਦੈ ਬਸਾਵੈ ॥",
      "transliteration": "har ke charan hiradai basaavai ||",
      "translation": "The Lotus Feet of the Lord abide in his heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਨਕ ਐਸਾ ਭਗਉਤੀ ਭਗਵੰਤ ਕਉ ਪਾਵੈ ॥੩॥",
      "transliteration": "naanak aisaa bhagautee bhagava(n)t kau paavai ||3||",
      "translation": "O Nanak, such a Bhagaautee attains the Lord God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੋ ਪੰਡਿਤੁ ਜੋ ਮਨੁ ਪਰਬੋਧੈ ॥",
      "transliteration": "so pa(n)dit jo man parabodhai ||",
      "translation": "He is a true Pandit, a religious scholar, who instructs his own mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਆਤਮ ਮਹਿ ਸੋਧੈ ॥",
      "transliteration": "raam naam aatam mahi sodhai ||",
      "translation": "He searches for the Lord's Name within his own soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਸਾਰੁ ਰਸੁ ਪੀਵੈ ॥",
      "transliteration": "raam naam saar ras peevai ||",
      "translation": "He drinks in the Exquisite Nectar of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਉਸੁ ਪੰਡਿਤ ਕੈ ਉਪਦੇਸਿ ਜਗੁ ਜੀਵੈ ॥",
      "transliteration": "us pa(n)dit kai upades jag jeevai ||",
      "translation": "By that Pandit's teachings, the world lives.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਰਿ ਕੀ ਕਥਾ ਹਿਰਦੈ ਬਸਾਵੈ ॥",
      "transliteration": "har kee kathaa hiradai basaavai ||",
      "translation": "He implants the Sermon of the Lord in his heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੋ ਪੰਡਿਤੁ ਫਿਰਿ ਜੋਨਿ ਨ ਆਵੈ ॥",
      "transliteration": "so pa(n)dit phir jon na aavai ||",
      "translation": "Such a Pandit is not cast into the womb of reincarnation again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬੇਦ ਪੁਰਾਨ ਸਿਮ੍ਰਿਤਿ ਬੂਝੈ ਮੂਲ ॥",
      "transliteration": "bed puraan simrit boojhai mool ||",
      "translation": "He understands the fundamental essence of the Vedas, the Puraanas and the Simritees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੂਖਮ ਮਹਿ ਜਾਨੈ ਅਸਥੂਲੁ ॥",
      "transliteration": "sookham mahi jaanai asathool ||",
      "translation": "In the unmanifest, he sees the manifest world to exist.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚਹੁ ਵਰਨਾ ਕਉ ਦੇ ਉਪਦੇਸੁ ॥",
      "transliteration": "chahu varanaa kau de upades ||",
      "translation": "He gives instruction to people of all castes and social classes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਨਕ ਉਸੁ ਪੰਡਿਤ ਕਉ ਸਦਾ ਅਦੇਸੁ ॥੪॥",
      "transliteration": "naanak us pa(n)dit kau sadaa ades ||4||",
      "translation": "O Nanak, to such a Pandit, I bow in salutation forever. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬੀਜ ਮੰਤ੍ਰੁ ਸਰਬ ਕੋ ਗਿਆਨੁ ॥",
      "transliteration": "beej ma(n)tr sarab ko giaan ||",
      "translation": "The Beej Mantra, the Seed Mantra, is spiritual wisdom for everyone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਚਹੁ ਵਰਨਾ ਮਹਿ ਜਪੈ ਕੋਊ ਨਾਮੁ ॥",
      "transliteration": "chahu varanaa mahi japai kooo naam ||",
      "translation": "Anyone, from any class, may chant the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜੋ ਜੋ ਜਪੈ ਤਿਸ ਕੀ ਗਤਿ ਹੋਇ ॥",
      "transliteration": "jo jo japai tis kee gat hoi ||",
      "translation": "Whoever chants it, is emancipated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਪਾਵੈ ਜਨੁ ਕੋਇ ॥",
      "transliteration": "saadhasa(n)g paavai jan koi ||",
      "translation": "And yet, rare are those who attain it, in the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਅੰਤਰਿ ਉਰ ਧਾਰੈ ॥",
      "transliteration": "kar kirapaa a(n)tar ur dhaarai ||",
      "translation": "By His Grace, He enshrines it within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪਸੁ ਪ੍ਰੇਤ ਮੁਘਦ ਪਾਥਰ ਕਉ ਤਾਰੈ ॥",
      "transliteration": "pas pret mughad paathar kau taarai ||",
      "translation": "Even beasts, ghosts and the stone-hearted are saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਰਬ ਰੋਗ ਕਾ ਅਉਖਦੁ ਨਾਮੁ ॥",
      "transliteration": "sarab rog kaa aukhad naam ||",
      "translation": "The Naam is the panacea, the remedy to cure all ills.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਕਲਿਆਣ ਰੂਪ ਮੰਗਲ ਗੁਣ ਗਾਮ ॥",
      "transliteration": "kaliaan roop ma(n)gal gun gaam ||",
      "translation": "Singing the Glory of God is the embodiment of bliss and emancipation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਾਹੂ ਜੁਗਤਿ ਕਿਤੈ ਨ ਪਾਈਐ ਧਰਮਿ ॥",
      "transliteration": "kaahoo jugat kitai na paaeeai dharam ||",
      "translation": "It cannot be obtained by any religious rituals.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਨਾਨਕ ਤਿਸੁ ਮਿਲੈ ਜਿਸੁ ਲਿਖਿਆ ਧੁਰਿ ਕਰਮਿ ॥੫॥",
      "transliteration": "naanak tis milai jis likhiaa dhur karam ||5||",
      "translation": "O Nanak, he alone obtains it, whose karma is so pre-ordained. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0274_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜਿਸ ਕੈ ਮਨਿ ਪਾਰਬ੍ਰਹਮ ਕਾ ਨਿਵਾਸੁ ॥",
      "transliteration": "jis kai man paarabraham kaa nivaas ||",
      "translation": "One whose mind is a home for the Supreme Lord God",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 274,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
