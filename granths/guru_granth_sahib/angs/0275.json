{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 275,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0275_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਿਸ ਕਾ ਨਾਮੁ ਸਤਿ ਰਾਮਦਾਸੁ ॥",
      "transliteration": "tis kaa naam sat raamadaas ||",
      "translation": "- his name is truly Ram Das, the Lord's servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਤਮ ਰਾਮੁ ਤਿਸੁ ਨਦਰੀ ਆਇਆ ॥",
      "transliteration": "aatam raam tis nadaree aaiaa ||",
      "translation": "He comes to have the Vision of the Lord, the Supreme Soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦਾਸ ਦਸੰਤਣ ਭਾਇ ਤਿਨਿ ਪਾਇਆ ॥",
      "transliteration": "daas dasa(n)tan bhaai tin paaiaa ||",
      "translation": "Deeming himself to be the slave of the Lord's slaves, he obtains it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਦਾ ਨਿਕਟਿ ਨਿਕਟਿ ਹਰਿ ਜਾਨੁ ॥",
      "transliteration": "sadaa nikat nikat har jaan ||",
      "translation": "He knows the Lord to be Ever-present, close at hand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੋ ਦਾਸੁ ਦਰਗਹ ਪਰਵਾਨੁ ॥",
      "transliteration": "so daas daragah paravaan ||",
      "translation": "Such a servant is honored in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਪੁਨੇ ਦਾਸ ਕਉ ਆਪਿ ਕਿਰਪਾ ਕਰੈ ॥",
      "transliteration": "apune daas kau aap kirapaa karai ||",
      "translation": "To His servant, He Himself shows His Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਿਸੁ ਦਾਸ ਕਉ ਸਭ ਸੋਝੀ ਪਰੈ ॥",
      "transliteration": "tis daas kau sabh sojhee parai ||",
      "translation": "Such a servant understands everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਗਲ ਸੰਗਿ ਆਤਮ ਉਦਾਸੁ ॥",
      "transliteration": "sagal sa(n)g aatam udaas ||",
      "translation": "Amidst all, his soul is unattached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਐਸੀ ਜੁਗਤਿ ਨਾਨਕ ਰਾਮਦਾਸੁ ॥੬॥",
      "transliteration": "aisee jugat naanak raamadaas ||6||",
      "translation": "Such is the way, O Nanak, of the Lord's servant. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਆਗਿਆ ਆਤਮ ਹਿਤਾਵੈ ॥",
      "transliteration": "prabh kee aagiaa aatam hitaavai ||",
      "translation": "One who, in his soul, loves the Will of God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੀਵਨ ਮੁਕਤਿ ਸੋਊ ਕਹਾਵੈ ॥",
      "transliteration": "jeevan mukat sooo kahaavai ||",
      "translation": "is said to be Jivan Mukta - liberated while yet alive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੈਸਾ ਹਰਖੁ ਤੈਸਾ ਉਸੁ ਸੋਗੁ ॥",
      "transliteration": "taisaa harakh taisaa us sog ||",
      "translation": "As is joy, so is sorrow to him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਦਾ ਅਨੰਦੁ ਤਹ ਨਹੀ ਬਿਓਗੁ ॥",
      "transliteration": "sadaa ana(n)d tah nahee biog ||",
      "translation": "He is in eternal bliss, and is not separated from God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤੈਸਾ ਸੁਵਰਨੁ ਤੈਸੀ ਉਸੁ ਮਾਟੀ ॥",
      "transliteration": "taisaa suvaran taisee us maatee ||",
      "translation": "As is gold, so is dust to him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤੈਸਾ ਅੰਮ੍ਰਿਤੁ ਤੈਸੀ ਬਿਖੁ ਖਾਟੀ ॥",
      "transliteration": "taisaa a(n)mrit taisee bikh khaatee ||",
      "translation": "As is ambrosial nectar, so is bitter poison to him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤੈਸਾ ਮਾਨੁ ਤੈਸਾ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "taisaa maan taisaa abhimaan ||",
      "translation": "As is honor, so is dishonor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤੈਸਾ ਰੰਕੁ ਤੈਸਾ ਰਾਜਾਨੁ ॥",
      "transliteration": "taisaa ra(n)k taisaa raajaan ||",
      "translation": "As is the beggar, so is the king.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੋ ਵਰਤਾਏ ਸਾਈ ਜੁਗਤਿ ॥",
      "transliteration": "jo varataae saaee jugat ||",
      "translation": "Whatever God ordains, that is his way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਓਹੁ ਪੁਰਖੁ ਕਹੀਐ ਜੀਵਨ ਮੁਕਤਿ ॥੭॥",
      "transliteration": "naanak ohu purakh kaheeai jeevan mukat ||7||",
      "translation": "O Nanak, that being is known as Jivan Mukta. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕੇ ਸਗਲੇ ਠਾਉ ॥",
      "transliteration": "paarabraham ke sagale thaau ||",
      "translation": "All places belong to the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਤੁ ਜਿਤੁ ਘਰਿ ਰਾਖੈ ਤੈਸਾ ਤਿਨ ਨਾਉ ॥",
      "transliteration": "jit jit ghar raakhai taisaa tin naau ||",
      "translation": "According to the homes in which they are placed, so are His creatures named.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਪੇ ਕਰਨ ਕਰਾਵਨ ਜੋਗੁ ॥",
      "transliteration": "aape karan karaavan jog ||",
      "translation": "He Himself is the Doer, the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪ੍ਰਭ ਭਾਵੈ ਸੋਈ ਫੁਨਿ ਹੋਗੁ ॥",
      "transliteration": "prabh bhaavai soee phun hog ||",
      "translation": "Whatever pleases God, ultimately comes to pass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪਸਰਿਓ ਆਪਿ ਹੋਇ ਅਨਤ ਤਰੰਗ ॥",
      "transliteration": "pasario aap hoi anat tara(n)g ||",
      "translation": "He Himself is All-pervading, in endless waves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਲਖੇ ਨ ਜਾਹਿ ਪਾਰਬ੍ਰਹਮ ਕੇ ਰੰਗ ॥",
      "transliteration": "lakhe na jaahi paarabraham ke ra(n)g ||",
      "translation": "The playful sport of the Supreme Lord God cannot be known.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੈਸੀ ਮਤਿ ਦੇਇ ਤੈਸਾ ਪਰਗਾਸ ॥",
      "transliteration": "jaisee mat dei taisaa paragaas ||",
      "translation": "As the understanding is given, so is one enlightened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਕਰਤਾ ਅਬਿਨਾਸ ॥",
      "transliteration": "paarabraham karataa abinaas ||",
      "translation": "The Supreme Lord God, the Creator, is eternal and everlasting.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਸਦਾ ਦਇਆਲ ॥",
      "transliteration": "sadaa sadaa sadaa daiaal ||",
      "translation": "Forever, forever and ever, He is merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਨਾਨਕ ਭਏ ਨਿਹਾਲ ॥੮॥੯॥",
      "transliteration": "simar simar naanak bhae nihaal ||8||9||",
      "translation": "Remembering Him, remembering Him in meditation, O Nanak, one is blessed with ecstasy. ||8||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਉਸਤਤਿ ਕਰਹਿ ਅਨੇਕ ਜਨ ਅੰਤੁ ਨ ਪਾਰਾਵਾਰ ॥",
      "transliteration": "usatat karahi anek jan a(n)t na paaraavaar ||",
      "translation": "Many people praise the Lord. He has no end or limitation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਨਕ ਰਚਨਾ ਪ੍ਰਭਿ ਰਚੀ ਬਹੁ ਬਿਧਿ ਅਨਿਕ ਪ੍ਰਕਾਰ ॥੧॥",
      "transliteration": "naanak rachanaa prabh rachee bahu bidh anik prakaar ||1||",
      "translation": "O Nanak, God created the creation, with its many ways and various species. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਹੋਏ ਪੂਜਾਰੀ ॥",
      "transliteration": "kaee kot hoe poojaaree ||",
      "translation": "Many millions are His devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਆਚਾਰ ਬਿਉਹਾਰੀ ॥",
      "transliteration": "kaee kot aachaar biuhaaree ||",
      "translation": "Many millions perform religious rituals and worldly duties.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਭਏ ਤੀਰਥ ਵਾਸੀ ॥",
      "transliteration": "kaee kot bhae teerath vaasee ||",
      "translation": "Many millions become dwellers at sacred shrines of pilgrimage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਬਨ ਭ੍ਰਮਹਿ ਉਦਾਸੀ ॥",
      "transliteration": "kaee kot ban bhramahi udaasee ||",
      "translation": "Many millions wander as renunciates in the wilderness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਬੇਦ ਕੇ ਸ੍ਰੋਤੇ ॥",
      "transliteration": "kaee kot bed ke srote ||",
      "translation": "Many millions listen to the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਤਪੀਸੁਰ ਹੋਤੇ ॥",
      "transliteration": "kaee kot tapeesur hote ||",
      "translation": "Many millions become austere penitents.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਆਤਮ ਧਿਆਨੁ ਧਾਰਹਿ ॥",
      "transliteration": "kaee kot aatam dhiaan dhaarahi ||",
      "translation": "Many millions enshrine meditation within their souls.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਕਬਿ ਕਾਬਿ ਬੀਚਾਰਹਿ ॥",
      "transliteration": "kaee kot kab kaab beechaarahi ||",
      "translation": "Many millions of poets contemplate Him through poetry.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਨਵਤਨ ਨਾਮ ਧਿਆਵਹਿ ॥",
      "transliteration": "kaee kot navatan naam dhiaavahi ||",
      "translation": "Many millions meditate on His eternally new Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਨਕ ਕਰਤੇ ਕਾ ਅੰਤੁ ਨ ਪਾਵਹਿ ॥੧॥",
      "transliteration": "naanak karate kaa a(n)t na paavahi ||1||",
      "translation": "O Nanak, none can find the limits of the Creator. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਭਏ ਅਭਿਮਾਨੀ ॥",
      "transliteration": "kaee kot bhae abhimaanee ||",
      "translation": "Many millions become self-centered.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਅੰਧ ਅਗਿਆਨੀ ॥",
      "transliteration": "kaee kot a(n)dh agiaanee ||",
      "translation": "Many millions are blinded by ignorance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਕਿਰਪਨ ਕਠੋਰ ॥",
      "transliteration": "kaee kot kirapan kathor ||",
      "translation": "Many millions are stone-hearted misers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਅਭਿਗ ਆਤਮ ਨਿਕੋਰ ॥",
      "transliteration": "kaee kot abhig aatam nikor ||",
      "translation": "Many millions are heartless, with dry, withered souls.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਪਰ ਦਰਬ ਕਉ ਹਿਰਹਿ ॥",
      "transliteration": "kaee kot par darab kau hirahi ||",
      "translation": "Many millions steal the wealth of others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਪਰ ਦੂਖਨਾ ਕਰਹਿ ॥",
      "transliteration": "kaee kot par dookhanaa karahi ||",
      "translation": "Many millions slander others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਮਾਇਆ ਸ੍ਰਮ ਮਾਹਿ ॥",
      "transliteration": "kaee kot maaiaa sram maahi ||",
      "translation": "Many millions struggle in Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਪਰਦੇਸ ਭ੍ਰਮਾਹਿ ॥",
      "transliteration": "kaee kot parades bhramaahi ||",
      "translation": "Many millions wander in foreign lands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਿਤੁ ਜਿਤੁ ਲਾਵਹੁ ਤਿਤੁ ਤਿਤੁ ਲਗਨਾ ॥",
      "transliteration": "jit jit laavahu tit tit laganaa ||",
      "translation": "Whatever God attaches them to - with that they are engaged.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾਨਕ ਕਰਤੇ ਕੀ ਜਾਨੈ ਕਰਤਾ ਰਚਨਾ ॥੨॥",
      "transliteration": "naanak karate kee jaanai karataa rachanaa ||2||",
      "translation": "O Nanak, the Creator alone knows the workings of His creation. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਸਿਧ ਜਤੀ ਜੋਗੀ ॥",
      "transliteration": "kaee kot sidh jatee jogee ||",
      "translation": "Many millions are Siddhas, celibates and Yogis.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਰਾਜੇ ਰਸ ਭੋਗੀ ॥",
      "transliteration": "kaee kot raaje ras bhogee ||",
      "translation": "Many millions are kings, enjoying worldly pleasures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਪੰਖੀ ਸਰਪ ਉਪਾਏ ॥",
      "transliteration": "kaee kot pa(n)khee sarap upaae ||",
      "translation": "Many millions of birds and snakes have been created.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਪਾਥਰ ਬਿਰਖ ਨਿਪਜਾਏ ॥",
      "transliteration": "kaee kot paathar birakh nipajaae ||",
      "translation": "Many millions of stones and trees have been produced.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਪਵਣ ਪਾਣੀ ਬੈਸੰਤਰ ॥",
      "transliteration": "kaee kot pavan paanee baisa(n)tar ||",
      "translation": "Many millions are the winds, waters and fires.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਦੇਸ ਭੂ ਮੰਡਲ ॥",
      "transliteration": "kaee kot des bhoo ma(n)dal ||",
      "translation": "Many millions are the countries and realms of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0275_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਸਸੀਅਰ ਸੂਰ ਨਖੵਤ੍ਰ ॥",
      "transliteration": "kaee kot saseear soor nakhytr ||",
      "translation": "Many millions are the moons, suns and stars.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 275,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
