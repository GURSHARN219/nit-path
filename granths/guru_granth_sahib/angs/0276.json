{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 276,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0276_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਦੇਵ ਦਾਨਵ ਇੰਦ੍ਰ ਸਿਰਿ ਛਤ੍ਰ ॥",
      "transliteration": "kaee kot dev daanav i(n)dr sir chhatr ||",
      "translation": "Many millions are the demi-gods, demons and Indras, under their regal canopies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਗਲ ਸਮਗ੍ਰੀ ਅਪਨੈ ਸੂਤਿ ਧਾਰੈ ॥",
      "transliteration": "sagal samagree apanai soot dhaarai ||",
      "translation": "He has strung the entire creation upon His thread.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਨਕ ਜਿਸੁ ਜਿਸੁ ਭਾਵੈ ਤਿਸੁ ਤਿਸੁ ਨਿਸਤਾਰੈ ॥੩॥",
      "transliteration": "naanak jis jis bhaavai tis tis nisataarai ||3||",
      "translation": "O Nanak, He emancipates those with whom He is pleased. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਰਾਜਸ ਤਾਮਸ ਸਾਤਕ ॥",
      "transliteration": "kaee kot raajas taamas saatak ||",
      "translation": "Many millions abide in heated activity, slothful darkness and peaceful light.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਬੇਦ ਪੁਰਾਨ ਸਿਮ੍ਰਿਤਿ ਅਰੁ ਸਾਸਤ ॥",
      "transliteration": "kaee kot bed puraan simrit ar saasat ||",
      "translation": "Many millions are the Vedas, Puraanas, Simritees and Shaastras.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਕੀਏ ਰਤਨ ਸਮੁਦ ॥",
      "transliteration": "kaee kot keee ratan samud ||",
      "translation": "Many millions are the pearls of the oceans.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਨਾਨਾ ਪ੍ਰਕਾਰ ਜੰਤ ॥",
      "transliteration": "kaee kot naanaa prakaar ja(n)t ||",
      "translation": "Many millions are the beings of so many descriptions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਕੀਏ ਚਿਰ ਜੀਵੇ ॥",
      "transliteration": "kaee kot keee chir jeeve ||",
      "translation": "Many millions are made long-lived.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਗਿਰੀ ਮੇਰ ਸੁਵਰਨ ਥੀਵੇ ॥",
      "transliteration": "kaee kot giree mer suvaran theeve ||",
      "translation": "Many millions of hills and mountains have been made of gold.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਜਖੵ ਕਿੰਨਰ ਪਿਸਾਚ ॥",
      "transliteration": "kaee kot jakhy ki(n)nar pisaach ||",
      "translation": "Many millions are the Yakhshas - the servants of the god of wealth, the Kinnars - the gods of celestial music, and the evil spirits of the Pisaach.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਭੂਤ ਪ੍ਰੇਤ ਸੂਕਰ ਮ੍ਰਿਗਾਚ ॥",
      "transliteration": "kaee kot bhoot pret sookar mrigaach ||",
      "translation": "Many millions are the evil nature-spirits, ghosts, pigs and tigers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਭ ਤੇ ਨੇਰੈ ਸਭਹੂ ਤੇ ਦੂਰਿ ॥",
      "transliteration": "sabh te nerai sabhahoo te door ||",
      "translation": "He is near to all, and yet far from all;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਨਕ ਆਪਿ ਅਲਿਪਤੁ ਰਹਿਆ ਭਰਪੂਰਿ ॥੪॥",
      "transliteration": "naanak aap alipat rahiaa bharapoor ||4||",
      "translation": "O Nanak, He Himself remains distinct, while yet pervading all. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਪਾਤਾਲ ਕੇ ਵਾਸੀ ॥",
      "transliteration": "kaee kot paataal ke vaasee ||",
      "translation": "Many millions inhabit the nether regions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਨਰਕ ਸੁਰਗ ਨਿਵਾਸੀ ॥",
      "transliteration": "kaee kot narak surag nivaasee ||",
      "translation": "Many millions dwell in heaven and hell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਜਨਮਹਿ ਜੀਵਹਿ ਮਰਹਿ ॥",
      "transliteration": "kaee kot janamahi jeevahi marahi ||",
      "translation": "Many millions are born, live and die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਬਹੁ ਜੋਨੀ ਫਿਰਹਿ ॥",
      "transliteration": "kaee kot bahu jonee phirahi ||",
      "translation": "Many millions are reincarnated, over and over again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਬੈਠਤ ਹੀ ਖਾਹਿ ॥",
      "transliteration": "kaee kot baithat hee khaahi ||",
      "translation": "Many millions eat while sitting at ease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਘਾਲਹਿ ਥਕਿ ਪਾਹਿ ॥",
      "transliteration": "kaee kot ghaalahi thak paahi ||",
      "translation": "Many millions are exhausted by their labors.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਕੀਏ ਧਨਵੰਤ ॥",
      "transliteration": "kaee kot keee dhanava(n)t ||",
      "translation": "Many millions are created wealthy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਮਾਇਆ ਮਹਿ ਚਿੰਤ ॥",
      "transliteration": "kaee kot maaiaa mahi chi(n)t ||",
      "translation": "Many millions are anxiously involved in Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਹ ਜਹ ਭਾਣਾ ਤਹ ਤਹ ਰਾਖੇ ॥",
      "transliteration": "jah jah bhaanaa tah tah raakhe ||",
      "translation": "Wherever He wills, there He keeps us.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਨਕ ਸਭੁ ਕਿਛੁ ਪ੍ਰਭ ਕੈ ਹਾਥੇ ॥੫॥",
      "transliteration": "naanak sabh kichh prabh kai haathe ||5||",
      "translation": "O Nanak, everything is in the Hands of God. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਭਏ ਬੈਰਾਗੀ ॥",
      "transliteration": "kaee kot bhae bairaagee ||",
      "translation": "Many millions become Bairaagees, who renounce the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਸੰਗਿ ਤਿਨਿ ਲਿਵ ਲਾਗੀ ॥",
      "transliteration": "raam naam sa(n)g tin liv laagee ||",
      "translation": "They have attached themselves to the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਪ੍ਰਭ ਕਉ ਖੋਜੰਤੇ ॥",
      "transliteration": "kaee kot prabh kau khoja(n)te ||",
      "translation": "Many millions are searching for God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਆਤਮ ਮਹਿ ਪਾਰਬ੍ਰਹਮੁ ਲਹੰਤੇ ॥",
      "transliteration": "aatam mahi paarabraham laha(n)te ||",
      "translation": "Within their souls, they find the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਦਰਸਨ ਪ੍ਰਭ ਪਿਆਸ ॥",
      "transliteration": "kaee kot darasan prabh piaas ||",
      "translation": "Many millions thirst for the Blessing of God's Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਨ ਕਉ ਮਿਲਿਓ ਪ੍ਰਭੁ ਅਬਿਨਾਸ ॥",
      "transliteration": "tin kau milio prabh abinaas ||",
      "translation": "They meet with God, the Eternal.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਮਾਗਹਿ ਸਤਸੰਗੁ ॥",
      "transliteration": "kaee kot maagahi satasa(n)g ||",
      "translation": "Many millions pray for the Society of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਤਿਨ ਲਾਗਾ ਰੰਗੁ ॥",
      "transliteration": "paarabraham tin laagaa ra(n)g ||",
      "translation": "They are imbued with the Love of the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਨ ਕਉ ਹੋਏ ਆਪਿ ਸੁਪ੍ਰਸੰਨ ॥",
      "transliteration": "jin kau hoe aap suprasa(n)n ||",
      "translation": "Those with whom He Himself is pleased,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਨਕ ਤੇ ਜਨ ਸਦਾ ਧਨਿ ਧੰਨਿ ॥੬॥",
      "transliteration": "naanak te jan sadaa dhan dha(n)n ||6||",
      "translation": "O Nanak, are blessed, forever blessed. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਖਾਣੀ ਅਰੁ ਖੰਡ ॥",
      "transliteration": "kaee kot khaanee ar kha(n)d ||",
      "translation": "Many millions are the fields of creation and the galaxies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਅਕਾਸ ਬ੍ਰਹਮੰਡ ॥",
      "transliteration": "kaee kot akaas brahama(n)d ||",
      "translation": "Many millions are the etheric skies and the solar systems.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਹੋਏ ਅਵਤਾਰ ॥",
      "transliteration": "kaee kot hoe avataar ||",
      "translation": "Many millions are the divine incarnations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਈ ਜੁਗਤਿ ਕੀਨੋ ਬਿਸਥਾਰ ॥",
      "transliteration": "kaee jugat keeno bisathaar ||",
      "translation": "In so many ways, He has unfolded Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਈ ਬਾਰ ਪਸਰਿਓ ਪਾਸਾਰ ॥",
      "transliteration": "kaee baar pasario paasaar ||",
      "translation": "So many times, He has expanded His expansion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਇਕੁ ਏਕੰਕਾਰ ॥",
      "transliteration": "sadaa sadaa ik eka(n)kaar ||",
      "translation": "Forever and ever, He is the One, the One Universal Creator.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਕੀਨੇ ਬਹੁ ਭਾਤਿ ॥",
      "transliteration": "kaee kot keene bahu bhaat ||",
      "translation": "Many millions are created in various forms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰਭ ਤੇ ਹੋਏ ਪ੍ਰਭ ਮਾਹਿ ਸਮਾਤਿ ॥",
      "transliteration": "prabh te hoe prabh maahi samaat ||",
      "translation": "From God they emanate, and into God they merge once again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਾ ਕਾ ਅੰਤੁ ਨ ਜਾਨੈ ਕੋਇ ॥",
      "transliteration": "taa kaa a(n)t na jaanai koi ||",
      "translation": "His limits are not known to anyone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਪੇ ਆਪਿ ਨਾਨਕ ਪ੍ਰਭੁ ਸੋਇ ॥੭॥",
      "transliteration": "aape aap naanak prabh soi ||7||",
      "translation": "Of Himself, and by Himself, O Nanak, God exists. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਪਾਰਬ੍ਰਹਮ ਕੇ ਦਾਸ ॥",
      "transliteration": "kaee kot paarabraham ke daas ||",
      "translation": "Many millions are the servants of the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤਿਨ ਹੋਵਤ ਆਤਮ ਪਰਗਾਸ ॥",
      "transliteration": "tin hovat aatam paragaas ||",
      "translation": "Their souls are enlightened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਤਤ ਕੇ ਬੇਤੇ ॥",
      "transliteration": "kaee kot tat ke bete ||",
      "translation": "Many millions know the essence of reality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਦਾ ਨਿਹਾਰਹਿ ਏਕੋ ਨੇਤ੍ਰੇ ॥",
      "transliteration": "sadaa nihaarahi eko netre ||",
      "translation": "Their eyes gaze forever on the One alone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਨਾਮ ਰਸੁ ਪੀਵਹਿ ॥",
      "transliteration": "kaee kot naam ras peevahi ||",
      "translation": "Many millions drink in the essence of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਮਰ ਭਏ ਸਦ ਸਦ ਹੀ ਜੀਵਹਿ ॥",
      "transliteration": "amar bhae sad sad hee jeevahi ||",
      "translation": "They become immortal; they live forever and ever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਈ ਕੋਟਿ ਨਾਮ ਗੁਨ ਗਾਵਹਿ ॥",
      "transliteration": "kaee kot naam gun gaavahi ||",
      "translation": "Many millions sing the Glorious Praises of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਆਤਮ ਰਸਿ ਸੁਖਿ ਸਹਜਿ ਸਮਾਵਹਿ ॥",
      "transliteration": "aatam ras sukh sahaj samaavahi ||",
      "translation": "They are absorbed in intuitive peace and pleasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਪੁਨੇ ਜਨ ਕਉ ਸਾਸਿ ਸਾਸਿ ਸਮਾਰੇ ॥",
      "transliteration": "apune jan kau saas saas samaare ||",
      "translation": "He remembers His servants with each and every breath.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾਨਕ ਓਇ ਪਰਮੇਸੁਰ ਕੇ ਪਿਆਰੇ ॥੮॥੧੦॥",
      "transliteration": "naanak oi paramesur ke piaare ||8||10||",
      "translation": "O Nanak, they are the beloveds of the Transcendent Lord God. ||8||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਰਣ ਕਾਰਣ ਪ੍ਰਭੁ ਏਕੁ ਹੈ ਦੂਸਰ ਨਾਹੀ ਕੋਇ ॥",
      "transliteration": "karan kaaran prabh ek hai doosar naahee koi ||",
      "translation": "God alone is the Doer of deeds - there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਨਕ ਤਿਸੁ ਬਲਿਹਾਰਣੈ ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ ਸੋਇ ॥੧॥",
      "transliteration": "naanak tis balihaaranai jal thal maheeal soi ||1||",
      "translation": "O Nanak, I am a sacrifice to the One, who pervades the waters, the lands, the sky and all space. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਕਰਨੈ ਜੋਗੁ ॥",
      "transliteration": "karan karaavan karanai jog ||",
      "translation": "The Doer, the Cause of causes, is potent to do anything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੋਈ ਹੋਗੁ ॥",
      "transliteration": "jo tis bhaavai soee hog ||",
      "translation": "That which pleases Him, comes to pass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0276_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਥਾਪਿ ਉਥਾਪਨਹਾਰਾ ॥",
      "transliteration": "khin mahi thaap uthaapanahaaraa ||",
      "translation": "In an instant, He creates and destroys.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 276,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
