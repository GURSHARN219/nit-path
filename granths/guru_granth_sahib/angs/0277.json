{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 277,
  "lineCount": 63,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0277_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅੰਤੁ ਨਹੀ ਕਿਛੁ ਪਾਰਾਵਾਰਾ ॥",
      "transliteration": "a(n)t nahee kichh paaraavaaraa ||",
      "translation": "He has no end or limitation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹੁਕਮੇ ਧਾਰਿ ਅਧਰ ਰਹਾਵੈ ॥",
      "transliteration": "hukame dhaar adhar rahaavai ||",
      "translation": "By His Order, He established the earth, and He maintains it unsupported.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹੁਕਮੇ ਉਪਜੈ ਹੁਕਮਿ ਸਮਾਵੈ ॥",
      "transliteration": "hukame upajai hukam samaavai ||",
      "translation": "By His Order, the world was created; by His Order, it shall merge again into Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹੁਕਮੇ ਊਚ ਨੀਚ ਬਿਉਹਾਰ ॥",
      "transliteration": "hukame ooch neech biuhaar ||",
      "translation": "By His Order, one's occupation is high or low.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹੁਕਮੇ ਅਨਿਕ ਰੰਗ ਪਰਕਾਰ ॥",
      "transliteration": "hukame anik ra(n)g parakaar ||",
      "translation": "By His Order, there are so many colors and forms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਰਿ ਕਰਿ ਦੇਖੈ ਅਪਨੀ ਵਡਿਆਈ ॥",
      "transliteration": "kar kar dekhai apanee vadiaaee ||",
      "translation": "Having created the Creation, He beholds His own greatness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਨਕ ਸਭ ਮਹਿ ਰਹਿਆ ਸਮਾਈ ॥੧॥",
      "transliteration": "naanak sabh mahi rahiaa samaaee ||1||",
      "translation": "O Nanak, He is pervading in all. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪ੍ਰਭ ਭਾਵੈ ਮਾਨੁਖ ਗਤਿ ਪਾਵੈ ॥",
      "transliteration": "prabh bhaavai maanukh gat paavai ||",
      "translation": "If it pleases God, one attains salvation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪ੍ਰਭ ਭਾਵੈ ਤਾ ਪਾਥਰ ਤਰਾਵੈ ॥",
      "transliteration": "prabh bhaavai taa paathar taraavai ||",
      "translation": "If it pleases God, then even stones can swim.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪ੍ਰਭ ਭਾਵੈ ਬਿਨੁ ਸਾਸ ਤੇ ਰਾਖੈ ॥",
      "transliteration": "prabh bhaavai bin saas te raakhai ||",
      "translation": "If it pleases God, the body is preserved, even without the breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪ੍ਰਭ ਭਾਵੈ ਤਾ ਹਰਿ ਗੁਣ ਭਾਖੈ ॥",
      "transliteration": "prabh bhaavai taa har gun bhaakhai ||",
      "translation": "If it pleases God, then one chants the Lord's Glorious Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪ੍ਰਭ ਭਾਵੈ ਤਾ ਪਤਿਤ ਉਧਾਰੈ ॥",
      "transliteration": "prabh bhaavai taa patit udhaarai ||",
      "translation": "If it pleases God, then even sinners are saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਪਿ ਕਰੈ ਆਪਨ ਬੀਚਾਰੈ ॥",
      "transliteration": "aap karai aapan beechaarai ||",
      "translation": "He Himself acts, and He Himself contemplates.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੁਹਾ ਸਿਰਿਆ ਕਾ ਆਪਿ ਸੁਆਮੀ ॥",
      "transliteration": "duhaa siriaa kaa aap suaamee ||",
      "translation": "He Himself is the Master of both worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਖੇਲੈ ਬਿਗਸੈ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "khelai bigasai a(n)tarajaamee ||",
      "translation": "He plays and He enjoys; He is the Inner-knower, the Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੋ ਭਾਵੈ ਸੋ ਕਾਰ ਕਰਾਵੈ ॥",
      "transliteration": "jo bhaavai so kaar karaavai ||",
      "translation": "As He wills, He causes actions to be done.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਨਕ ਦ੍ਰਿਸਟੀ ਅਵਰੁ ਨ ਆਵੈ ॥੨॥",
      "transliteration": "naanak drisatee avar na aavai ||2||",
      "translation": "Nanak sees no other than Him. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹੁ ਮਾਨੁਖ ਤੇ ਕਿਆ ਹੋਇ ਆਵੈ ॥",
      "transliteration": "kahu maanukh te kiaa hoi aavai ||",
      "translation": "Tell me - what can a mere mortal do?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੋਈ ਕਰਾਵੈ ॥",
      "transliteration": "jo tis bhaavai soee karaavai ||",
      "translation": "Whatever pleases God is what He causes us to do.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਇਸ ਕੈ ਹਾਥਿ ਹੋਇ ਤਾ ਸਭੁ ਕਿਛੁ ਲੇਇ ॥",
      "transliteration": "is kai haath hoi taa sabh kichh lei ||",
      "translation": "If it were in our hands, we would grab up everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੋਈ ਕਰੇਇ ॥",
      "transliteration": "jo tis bhaavai soee karei ||",
      "translation": "Whatever pleases God - that is what He does.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਨਜਾਨਤ ਬਿਖਿਆ ਮਹਿ ਰਚੈ ॥",
      "transliteration": "anajaanat bikhiaa mahi rachai ||",
      "translation": "Through ignorance, people are engrossed in corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੇ ਜਾਨਤ ਆਪਨ ਆਪ ਬਚੈ ॥",
      "transliteration": "je jaanat aapan aap bachai ||",
      "translation": "If they knew better, they would save themselves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਰਮੇ ਭੂਲਾ ਦਹ ਦਿਸਿ ਧਾਵੈ ॥",
      "transliteration": "bharame bhoolaa dah dis dhaavai ||",
      "translation": "Deluded by doubt, they wander around in the ten directions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਿਮਖ ਮਾਹਿ ਚਾਰਿ ਕੁੰਟ ਫਿਰਿ ਆਵੈ ॥",
      "transliteration": "nimakh maahi chaar ku(n)t phir aavai ||",
      "translation": "In an instant, their minds go around the four corners of the world and come back again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਅਪਨੀ ਭਗਤਿ ਦੇਇ ॥",
      "transliteration": "kar kirapaa jis apanee bhagat dei ||",
      "translation": "Those whom the Lord mercifully blesses with His devotional worship",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਨਕ ਤੇ ਜਨ ਨਾਮਿ ਮਿਲੇਇ ॥੩॥",
      "transliteration": "naanak te jan naam milei ||3||",
      "translation": "- O Nanak, they are absorbed into the Naam. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਨੀਚ ਕੀਟ ਕਉ ਰਾਜ ॥",
      "transliteration": "khin mahi neech keet kau raaj ||",
      "translation": "In an instant, the lowly worm is transformed into a king.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਗਰੀਬ ਨਿਵਾਜ ॥",
      "transliteration": "paarabraham gareeb nivaaj ||",
      "translation": "The Supreme Lord God is the Protector of the humble.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਾ ਕਾ ਦ੍ਰਿਸਟਿ ਕਛੂ ਨ ਆਵੈ ॥",
      "transliteration": "jaa kaa drisat kachhoo na aavai ||",
      "translation": "Even one who has never been seen at all,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਿਸੁ ਤਤਕਾਲ ਦਹ ਦਿਸ ਪ੍ਰਗਟਾਵੈ ॥",
      "transliteration": "tis tatakaal dah dis pragataavai ||",
      "translation": "becomes instantly famous in the ten directions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾ ਕਉ ਅਪੁਨੀ ਕਰੈ ਬਖਸੀਸ ॥",
      "transliteration": "jaa kau apunee karai bakhasees ||",
      "translation": "And that one upon whom He bestows His blessings",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਾ ਕਾ ਲੇਖਾ ਨ ਗਨੈ ਜਗਦੀਸ ॥",
      "transliteration": "taa kaa lekhaa na ganai jagadees ||",
      "translation": "the Lord of the world does not hold him to his account.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਸਭ ਤਿਸ ਕੀ ਰਾਸਿ ॥",
      "transliteration": "jeeu pi(n)d sabh tis kee raas ||",
      "translation": "Soul and body are all His property.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਪੂਰਨ ਬ੍ਰਹਮ ਪ੍ਰਗਾਸ ॥",
      "transliteration": "ghat ghat pooran braham pragaas ||",
      "translation": "Each and every heart is illuminated by the Perfect Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਪਨੀ ਬਣਤ ਆਪਿ ਬਨਾਈ ॥",
      "transliteration": "apanee banat aap banaaee ||",
      "translation": "He Himself fashioned His own handiwork.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕ ਜੀਵੈ ਦੇਖਿ ਬਡਾਈ ॥੪॥",
      "transliteration": "naanak jeevai dekh badaaee ||4||",
      "translation": "Nanak lives by beholding His greatness. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਸ ਕਾ ਬਲੁ ਨਾਹੀ ਇਸੁ ਹਾਥ ॥",
      "transliteration": "is kaa bal naahee is haath ||",
      "translation": "There is no power in the hands of mortal beings;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਸਰਬ ਕੋ ਨਾਥ ॥",
      "transliteration": "karan karaavan sarab ko naath ||",
      "translation": "the Doer, the Cause of causes is the Lord of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਗਿਆਕਾਰੀ ਬਪੁਰਾ ਜੀਉ ॥",
      "transliteration": "aagiaakaaree bapuraa jeeu ||",
      "translation": "The helpless beings are subject to His Command.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੋਈ ਫੁਨਿ ਥੀਉ ॥",
      "transliteration": "jo tis bhaavai soee phun theeu ||",
      "translation": "That which pleases Him, ultimately comes to pass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਬਹੂ ਊਚ ਨੀਚ ਮਹਿ ਬਸੈ ॥",
      "transliteration": "kabahoo ooch neech mahi basai ||",
      "translation": "Sometimes, they abide in exaltation; sometimes, they are depressed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਬਹੂ ਸੋਗ ਹਰਖ ਰੰਗਿ ਹਸੈ ॥",
      "transliteration": "kabahoo sog harakh ra(n)g hasai ||",
      "translation": "Sometimes, they are sad, and sometimes they laugh with joy and delight.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਬਹੂ ਨਿੰਦ ਚਿੰਦ ਬਿਉਹਾਰ ॥",
      "transliteration": "kabahoo ni(n)d chi(n)d biuhaar ||",
      "translation": "Sometimes, they are occupied with slander and anxiety.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਬਹੂ ਊਭ ਅਕਾਸ ਪਇਆਲ ॥",
      "transliteration": "kabahoo oobh akaas paiaal ||",
      "translation": "Sometimes, they are high in the Akaashic Ethers, sometimes in the nether regions of the underworld.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਬਹੂ ਬੇਤਾ ਬ੍ਰਹਮ ਬੀਚਾਰ ॥",
      "transliteration": "kabahoo betaa braham beechaar ||",
      "translation": "Sometimes, they know the contemplation of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਨਕ ਆਪਿ ਮਿਲਾਵਣਹਾਰ ॥੫॥",
      "transliteration": "naanak aap milaavanahaar ||5||",
      "translation": "O Nanak, God Himself unites them with Himself. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਬਹੂ ਨਿਰਤਿ ਕਰੈ ਬਹੁ ਭਾਤਿ ॥",
      "transliteration": "kabahoo nirat karai bahu bhaat ||",
      "translation": "Sometimes, they dance in various ways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਬਹੂ ਸੋਇ ਰਹੈ ਦਿਨੁ ਰਾਤਿ ॥",
      "transliteration": "kabahoo soi rahai din raat ||",
      "translation": "Sometimes, they remain asleep day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਬਹੂ ਮਹਾ ਕ੍ਰੋਧ ਬਿਕਰਾਲ ॥",
      "transliteration": "kabahoo mahaa krodh bikaraal ||",
      "translation": "Sometimes, they are awesome, in terrible rage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਬਹੂੰ ਸਰਬ ਕੀ ਹੋਤ ਰਵਾਲ ॥",
      "transliteration": "kabahoo(n) sarab kee hot ravaal ||",
      "translation": "Sometimes, they are the dust of the feet of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਬਹੂ ਹੋਇ ਬਹੈ ਬਡ ਰਾਜਾ ॥",
      "transliteration": "kabahoo hoi bahai bad raajaa ||",
      "translation": "Sometimes, they sit as great kings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਬਹੁ ਭੇਖਾਰੀ ਨੀਚ ਕਾ ਸਾਜਾ ॥",
      "transliteration": "kabahu bhekhaaree neech kaa saajaa ||",
      "translation": "Sometimes, they wear the coat of a lowly beggar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਬਹੂ ਅਪਕੀਰਤਿ ਮਹਿ ਆਵੈ ॥",
      "transliteration": "kabahoo apakeerat mahi aavai ||",
      "translation": "Sometimes, they come to have evil reputations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਬਹੂ ਭਲਾ ਭਲਾ ਕਹਾਵੈ ॥",
      "transliteration": "kabahoo bhalaa bhalaa kahaavai ||",
      "translation": "Sometimes, they are known as very, very good.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਜਿਉ ਪ੍ਰਭੁ ਰਾਖੈ ਤਿਵ ਹੀ ਰਹੈ ॥",
      "transliteration": "jiu prabh raakhai tiv hee rahai ||",
      "translation": "As God keeps them, so they remain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਨਾਨਕ ਸਚੁ ਕਹੈ ॥੬॥",
      "transliteration": "gur prasaad naanak sach kahai ||6||",
      "translation": "By Guru's Grace, O Nanak, the Truth is told. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਬਹੂ ਹੋਇ ਪੰਡਿਤੁ ਕਰੇ ਬਖੵਾਨੁ ॥",
      "transliteration": "kabahoo hoi pa(n)dit kare bakhyaan ||",
      "translation": "Sometimes, as scholars, they deliver lectures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਬਹੂ ਮੋਨਿਧਾਰੀ ਲਾਵੈ ਧਿਆਨੁ ॥",
      "transliteration": "kabahoo monidhaaree laavai dhiaan ||",
      "translation": "Sometimes, they hold to silence in deep meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕਬਹੂ ਤਟ ਤੀਰਥ ਇਸਨਾਨ ॥",
      "transliteration": "kabahoo tat teerath isanaan ||",
      "translation": "Sometimes, they take cleansing baths at places of pilgrimage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਕਬਹੂ ਸਿਧ ਸਾਧਿਕ ਮੁਖਿ ਗਿਆਨ ॥",
      "transliteration": "kabahoo sidh saadhik mukh giaan ||",
      "translation": "Sometimes, as Siddhas or seekers, they impart spiritual wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕਬਹੂ ਕੀਟ ਹਸਤਿ ਪਤੰਗ ਹੋਇ ਜੀਆ ॥",
      "transliteration": "kabahoo keet hasat pata(n)g hoi jeeaa ||",
      "translation": "Sometimes, they becomes worms, elephants, or moths.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0277_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਅਨਿਕ ਜੋਨਿ ਭਰਮੈ ਭਰਮੀਆ ॥",
      "transliteration": "anik jon bharamai bharameeaa ||",
      "translation": "They may wander and roam through countless incarnations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 277,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
