{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 278,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0278_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਨਾ ਰੂਪ ਜਿਉ ਸ੍ਵਾਗੀ ਦਿਖਾਵੈ ॥",
      "transliteration": "naanaa roop jiu svaagee dikhaavai ||",
      "translation": "In various costumes, like actors, they appear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਉ ਪ੍ਰਭ ਭਾਵੈ ਤਿਵੈ ਨਚਾਵੈ ॥",
      "transliteration": "jiu prabh bhaavai tivai nachaavai ||",
      "translation": "As it pleases God, they dance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੋਈ ਹੋਇ ॥",
      "transliteration": "jo tis bhaavai soee hoi ||",
      "translation": "Whatever pleases Him, comes to pass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਨਕ ਦੂਜਾ ਅਵਰੁ ਨ ਕੋਇ ॥੭॥",
      "transliteration": "naanak doojaa avar na koi ||7||",
      "translation": "O Nanak, there is no other at all. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਬਹੂ ਸਾਧਸੰਗਤਿ ਇਹੁ ਪਾਵੈ ॥",
      "transliteration": "kabahoo saadhasa(n)gat ihu paavai ||",
      "translation": "Sometimes, this being attains the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਉਸੁ ਅਸਥਾਨ ਤੇ ਬਹੁਰਿ ਨ ਆਵੈ ॥",
      "transliteration": "us asathaan te bahur na aavai ||",
      "translation": "From that place, he does not have to come back again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅੰਤਰਿ ਹੋਇ ਗਿਆਨ ਪਰਗਾਸੁ ॥",
      "transliteration": "a(n)tar hoi giaan paragaas ||",
      "translation": "The light of spiritual wisdom dawns within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਉਸੁ ਅਸਥਾਨ ਕਾ ਨਹੀ ਬਿਨਾਸੁ ॥",
      "transliteration": "us asathaan kaa nahee binaas ||",
      "translation": "That place does not perish.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਨ ਤਨ ਨਾਮਿ ਰਤੇ ਇਕ ਰੰਗਿ ॥",
      "transliteration": "man tan naam rate ik ra(n)g ||",
      "translation": "The mind and body are imbued with the Love of the Naam, the Name of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਦਾ ਬਸਹਿ ਪਾਰਬ੍ਰਹਮ ਕੈ ਸੰਗਿ ॥",
      "transliteration": "sadaa basahi paarabraham kai sa(n)g ||",
      "translation": "He dwells forever with the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਉ ਜਲ ਮਹਿ ਜਲੁ ਆਇ ਖਟਾਨਾ ॥",
      "transliteration": "jiu jal mahi jal aai khataanaa ||",
      "translation": "As water comes to blend with water,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਿਉ ਜੋਤੀ ਸੰਗਿ ਜੋਤਿ ਸਮਾਨਾ ॥",
      "transliteration": "tiu jotee sa(n)g jot samaanaa ||",
      "translation": "his light blends into the Light.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਿਟਿ ਗਏ ਗਵਨ ਪਾਏ ਬਿਸ੍ਰਾਮ ॥",
      "transliteration": "mit gae gavan paae bisraam ||",
      "translation": "Reincarnation is ended, and eternal peace is found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਨਕ ਪ੍ਰਭ ਕੈ ਸਦ ਕੁਰਬਾਨ ॥੮॥੧੧॥",
      "transliteration": "naanak prabh kai sad kurabaan ||8||11||",
      "translation": "Nanak is forever a sacrifice to God. ||8||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਖੀ ਬਸੈ ਮਸਕੀਨੀਆ ਆਪੁ ਨਿਵਾਰਿ ਤਲੇ ॥",
      "transliteration": "sukhee basai masakeeneeaa aap nivaar tale ||",
      "translation": "The humble beings abide in peace; subduing egotism, they are meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਡੇ ਬਡੇ ਅਹੰਕਾਰੀਆ ਨਾਨਕ ਗਰਬਿ ਗਲੇ ॥੧॥",
      "transliteration": "bade bade aha(n)kaareeaa naanak garab gale ||1||",
      "translation": "The very proud and arrogant persons, O Nanak, are consumed by their own pride. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਸ ਕੈ ਅੰਤਰਿ ਰਾਜ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "jis kai a(n)tar raaj abhimaan ||",
      "translation": "One who has the pride of power within,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋ ਨਰਕਪਾਤੀ ਹੋਵਤ ਸੁਆਨੁ ॥",
      "transliteration": "so narakapaatee hovat suaan ||",
      "translation": "shall dwell in hell, and become a dog.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੋ ਜਾਨੈ ਮੈ ਜੋਬਨਵੰਤੁ ॥",
      "transliteration": "jo jaanai mai jobanava(n)t ||",
      "translation": "One who deems himself to have the beauty of youth,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੋ ਹੋਵਤ ਬਿਸਟਾ ਕਾ ਜੰਤੁ ॥",
      "transliteration": "so hovat bisataa kaa ja(n)t ||",
      "translation": "shall become a maggot in manure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਪਸ ਕਉ ਕਰਮਵੰਤੁ ਕਹਾਵੈ ॥",
      "transliteration": "aapas kau karamava(n)t kahaavai ||",
      "translation": "One who claims to act virtuously,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਨਮਿ ਮਰੈ ਬਹੁ ਜੋਨਿ ਭ੍ਰਮਾਵੈ ॥",
      "transliteration": "janam marai bahu jon bhramaavai ||",
      "translation": "shall live and die, wandering through countless reincarnations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਧਨ ਭੂਮਿ ਕਾ ਜੋ ਕਰੈ ਗੁਮਾਨੁ ॥",
      "transliteration": "dhan bhoom kaa jo karai gumaan ||",
      "translation": "One who takes pride in wealth and lands",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੋ ਮੂਰਖੁ ਅੰਧਾ ਅਗਿਆਨੁ ॥",
      "transliteration": "so moorakh a(n)dhaa agiaan ||",
      "translation": "is a fool, blind and ignorant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸ ਕੈ ਹਿਰਦੈ ਗਰੀਬੀ ਬਸਾਵੈ ॥",
      "transliteration": "kar kirapaa jis kai hiradai gareebee basaavai ||",
      "translation": "One whose heart is mercifully blessed with abiding humility,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਈਹਾ ਮੁਕਤੁ ਆਗੈ ਸੁਖੁ ਪਾਵੈ ॥੧॥",
      "transliteration": "naanak eehaa mukat aagai sukh paavai ||1||",
      "translation": "O Nanak, is liberated here, and obtains peace hereafter. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਧਨਵੰਤਾ ਹੋਇ ਕਰਿ ਗਰਬਾਵੈ ॥",
      "transliteration": "dhanava(n)taa hoi kar garabaavai ||",
      "translation": "One who becomes wealthy and takes pride in it",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤ੍ਰਿਣ ਸਮਾਨਿ ਕਛੁ ਸੰਗਿ ਨ ਜਾਵੈ ॥",
      "transliteration": "trin samaan kachh sa(n)g na jaavai ||",
      "translation": "not even a piece of straw shall go along with him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਹੁ ਲਸਕਰ ਮਾਨੁਖ ਊਪਰਿ ਕਰੇ ਆਸ ॥",
      "transliteration": "bahu lasakar maanukh oopar kare aas ||",
      "translation": "He may place his hopes on a large army of men,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪਲ ਭੀਤਰਿ ਤਾ ਕਾ ਹੋਇ ਬਿਨਾਸ ॥",
      "transliteration": "pal bheetar taa kaa hoi binaas ||",
      "translation": "but he shall vanish in an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਭ ਤੇ ਆਪ ਜਾਨੈ ਬਲਵੰਤੁ ॥",
      "transliteration": "sabh te aap jaanai balava(n)t ||",
      "translation": "One who deems himself to be the strongest of all,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਹੋਇ ਜਾਇ ਭਸਮੰਤੁ ॥",
      "transliteration": "khin mahi hoi jaai bhasama(n)t ||",
      "translation": "in an instant, shall be reduced to ashes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਿਸੈ ਨ ਬਦੈ ਆਪਿ ਅਹੰਕਾਰੀ ॥",
      "transliteration": "kisai na badai aap aha(n)kaaree ||",
      "translation": "One who thinks of no one else except his own prideful self",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਧਰਮ ਰਾਇ ਤਿਸੁ ਕਰੇ ਖੁਆਰੀ ॥",
      "transliteration": "dharam raai tis kare khuaaree ||",
      "translation": "the Righteous Judge of Dharma shall expose his disgrace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਜਾ ਕਾ ਮਿਟੈ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "gur prasaad jaa kaa mitai abhimaan ||",
      "translation": "One who, by Guru's Grace, eliminates his ego,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੋ ਜਨੁ ਨਾਨਕ ਦਰਗਹ ਪਰਵਾਨੁ ॥੨॥",
      "transliteration": "so jan naanak daragah paravaan ||2||",
      "translation": "O Nanak, becomes acceptable in the Court of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕੋਟਿ ਕਰਮ ਕਰੈ ਹਉ ਧਾਰੇ ॥",
      "transliteration": "kot karam karai hau dhaare ||",
      "translation": "If someone does millions of good deeds, while acting in ego,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸ੍ਰਮੁ ਪਾਵੈ ਸਗਲੇ ਬਿਰਥਾਰੇ ॥",
      "transliteration": "sram paavai sagale birathaare ||",
      "translation": "he shall incur only trouble; all this is in vain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਨਿਕ ਤਪਸਿਆ ਕਰੇ ਅਹੰਕਾਰ ॥",
      "transliteration": "anik tapasiaa kare aha(n)kaar ||",
      "translation": "If someone performs great penance, while acting in selfishness and conceit,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਰਕ ਸੁਰਗ ਫਿਰਿ ਫਿਰਿ ਅਵਤਾਰ ॥",
      "transliteration": "narak surag phir phir avataar ||",
      "translation": "he shall be reincarnated into heaven and hell, over and over again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਨਿਕ ਜਤਨ ਕਰਿ ਆਤਮ ਨਹੀ ਦ੍ਰਵੈ ॥",
      "transliteration": "anik jatan kar aatam nahee dravai ||",
      "translation": "He makes all sorts of efforts, but his soul is still not softened",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਰਿ ਦਰਗਹ ਕਹੁ ਕੈਸੇ ਗਵੈ ॥",
      "transliteration": "har daragah kahu kaise gavai ||",
      "translation": "how can he go to the Court of the Lord?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਪਸ ਕਉ ਜੋ ਭਲਾ ਕਹਾਵੈ ॥",
      "transliteration": "aapas kau jo bhalaa kahaavai ||",
      "translation": "One who calls himself good",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਿਸਹਿ ਭਲਾਈ ਨਿਕਟਿ ਨ ਆਵੈ ॥",
      "transliteration": "tisahi bhalaaee nikat na aavai ||",
      "translation": "goodness shall not draw near him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਰਬ ਕੀ ਰੇਨ ਜਾ ਕਾ ਮਨੁ ਹੋਇ ॥",
      "transliteration": "sarab kee ren jaa kaa man hoi ||",
      "translation": "One whose mind is the dust of all",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਤਾ ਕੀ ਨਿਰਮਲ ਸੋਇ ॥੩॥",
      "transliteration": "kahu naanak taa kee niramal soi ||3||",
      "translation": "- says Nanak, his reputation is spotlessly pure. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਬ ਲਗੁ ਜਾਨੈ ਮੁਝ ਤੇ ਕਛੁ ਹੋਇ ॥",
      "transliteration": "jab lag jaanai mujh te kachh hoi ||",
      "translation": "As long as someone thinks that he is the one who acts,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਬ ਇਸ ਕਉ ਸੁਖੁ ਨਾਹੀ ਕੋਇ ॥",
      "transliteration": "tab is kau sukh naahee koi ||",
      "translation": "he shall have no peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਬ ਇਹ ਜਾਨੈ ਮੈ ਕਿਛੁ ਕਰਤਾ ॥",
      "transliteration": "jab ih jaanai mai kichh karataa ||",
      "translation": "As long as this mortal thinks that he is the one who does things,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤਬ ਲਗੁ ਗਰਭ ਜੋਨਿ ਮਹਿ ਫਿਰਤਾ ॥",
      "transliteration": "tab lag garabh jon mahi phirataa ||",
      "translation": "he shall wander in reincarnation through the womb.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਬ ਧਾਰੈ ਕੋਊ ਬੈਰੀ ਮੀਤੁ ॥",
      "transliteration": "jab dhaarai kooo bairee meet ||",
      "translation": "As long as he considers one an enemy, and another a friend,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਬ ਲਗੁ ਨਿਹਚਲੁ ਨਾਹੀ ਚੀਤੁ ॥",
      "transliteration": "tab lag nihachal naahee cheet ||",
      "translation": "his mind shall not come to rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਬ ਲਗੁ ਮੋਹ ਮਗਨ ਸੰਗਿ ਮਾਇ ॥",
      "transliteration": "jab lag moh magan sa(n)g maai ||",
      "translation": "As long as he is intoxicated with attachment to Maya,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਤਬ ਲਗੁ ਧਰਮ ਰਾਇ ਦੇਇ ਸਜਾਇ ॥",
      "transliteration": "tab lag dharam raai dei sajaai ||",
      "translation": "the Righteous Judge shall punish him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ ਬੰਧਨ ਤੂਟੈ ॥",
      "transliteration": "prabh kirapaa te ba(n)dhan tootai ||",
      "translation": "By God's Grace, his bonds are shattered;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਨਾਨਕ ਹਉ ਛੂਟੈ ॥੪॥",
      "transliteration": "gur prasaad naanak hau chhootai ||4||",
      "translation": "by Guru's Grace, O Nanak, his ego is eliminated. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0278_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸਹਸ ਖਟੇ ਲਖ ਕਉ ਉਠਿ ਧਾਵੈ ॥",
      "transliteration": "sahas khate lakh kau uth dhaavai ||",
      "translation": "Earning a thousand, he runs after a hundred thousand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 278,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
