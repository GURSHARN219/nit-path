{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 279,
  "lineCount": 62,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0279_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤ੍ਰਿਪਤਿ ਨ ਆਵੈ ਮਾਇਆ ਪਾਛੈ ਪਾਵੈ ॥",
      "transliteration": "tripat na aavai maaiaa paachhai paavai ||",
      "translation": "Satisfaction is not obtained by chasing after Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਨਿਕ ਭੋਗ ਬਿਖਿਆ ਕੇ ਕਰੈ ॥",
      "transliteration": "anik bhog bikhiaa ke karai ||",
      "translation": "He may enjoy all sorts of corrupt pleasures,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਹ ਤ੍ਰਿਪਤਾਵੈ ਖਪਿ ਖਪਿ ਮਰੈ ॥",
      "transliteration": "nah tripataavai khap khap marai ||",
      "translation": "but he is still not satisfied; he indulges again and again, wearing himself out, until he dies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਿਨਾ ਸੰਤੋਖ ਨਹੀ ਕੋਊ ਰਾਜੈ ॥",
      "transliteration": "binaa sa(n)tokh nahee kooo raajai ||",
      "translation": "Without contentment, no one is satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੁਪਨ ਮਨੋਰਥ ਬ੍ਰਿਥੇ ਸਭ ਕਾਜੈ ॥",
      "transliteration": "supan manorath brithe sabh kaajai ||",
      "translation": "Like the objects in a dream, all his efforts are in vain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਮ ਰੰਗਿ ਸਰਬ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "naam ra(n)g sarab sukh hoi ||",
      "translation": "Through the love of the Naam, all peace is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਡਭਾਗੀ ਕਿਸੈ ਪਰਾਪਤਿ ਹੋਇ ॥",
      "transliteration": "badabhaagee kisai paraapat hoi ||",
      "translation": "Only a few obtain this, by great good fortune.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਆਪੇ ਆਪਿ ॥",
      "transliteration": "karan karaavan aape aap ||",
      "translation": "He Himself is Himself the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਨਾਨਕ ਹਰਿ ਜਾਪਿ ॥੫॥",
      "transliteration": "sadaa sadaa naanak har jaap ||5||",
      "translation": "Forever and ever, O Nanak, chant the Lord's Name. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਕਰਨੈਹਾਰੁ ॥",
      "transliteration": "karan karaavan karanaihaar ||",
      "translation": "The Doer, the Cause of causes, is the Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਸ ਕੈ ਹਾਥਿ ਕਹਾ ਬੀਚਾਰੁ ॥",
      "transliteration": "is kai haath kahaa beechaar ||",
      "translation": "What deliberations are in the hands of mortal beings?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੈਸੀ ਦ੍ਰਿਸਟਿ ਕਰੇ ਤੈਸਾ ਹੋਇ ॥",
      "transliteration": "jaisee drisat kare taisaa hoi ||",
      "translation": "As God casts His Glance of Grace, they come to be.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਪੇ ਆਪਿ ਆਪਿ ਪ੍ਰਭੁ ਸੋਇ ॥",
      "transliteration": "aape aap aap prabh soi ||",
      "translation": "God Himself, of Himself, is unto Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕੀਨੋ ਸੁ ਅਪਨੈ ਰੰਗਿ ॥",
      "transliteration": "jo kichh keeno s apanai ra(n)g ||",
      "translation": "Whatever He created, was by His Own Pleasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਭ ਤੇ ਦੂਰਿ ਸਭਹੂ ਕੈ ਸੰਗਿ ॥",
      "transliteration": "sabh te door sabhahoo kai sa(n)g ||",
      "translation": "He is far from all, and yet with all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬੂਝੈ ਦੇਖੈ ਕਰੈ ਬਿਬੇਕ ॥",
      "transliteration": "boojhai dekhai karai bibek ||",
      "translation": "He understands, He sees, and He passes judgment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਪਹਿ ਏਕ ਆਪਹਿ ਅਨੇਕ ॥",
      "transliteration": "aapahi ek aapahi anek ||",
      "translation": "He Himself is the One, and He Himself is the many.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਰੈ ਨ ਬਿਨਸੈ ਆਵੈ ਨ ਜਾਇ ॥",
      "transliteration": "marai na binasai aavai na jaai ||",
      "translation": "He does not die or perish; He does not come or go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਸਦ ਹੀ ਰਹਿਆ ਸਮਾਇ ॥੬॥",
      "transliteration": "naanak sad hee rahiaa samaai ||6||",
      "translation": "O Nanak, He remains forever All-pervading. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਪਿ ਉਪਦੇਸੈ ਸਮਝੈ ਆਪਿ ॥",
      "transliteration": "aap upadesai samajhai aap ||",
      "translation": "He Himself instructs, and He Himself learns.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਪੇ ਰਚਿਆ ਸਭ ਕੈ ਸਾਥਿ ॥",
      "transliteration": "aape rachiaa sabh kai saath ||",
      "translation": "He Himself mingles with all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਪਿ ਕੀਨੋ ਆਪਨ ਬਿਸਥਾਰੁ ॥",
      "transliteration": "aap keeno aapan bisathaar ||",
      "translation": "He Himself created His own expanse.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਭੁ ਕਛੁ ਉਸ ਕਾ ਓਹੁ ਕਰਨੈਹਾਰੁ ॥",
      "transliteration": "sabh kachh us kaa ohu karanaihaar ||",
      "translation": "All things are His; He is the Creator.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਉਸ ਤੇ ਭਿੰਨ ਕਹਹੁ ਕਿਛੁ ਹੋਇ ॥",
      "transliteration": "us te bhi(n)n kahahu kichh hoi ||",
      "translation": "Without Him, what could be done?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਥਾਨ ਥਨੰਤਰਿ ਏਕੈ ਸੋਇ ॥",
      "transliteration": "thaan thana(n)tar ekai soi ||",
      "translation": "In the spaces and interspaces, He is the One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਪੁਨੇ ਚਲਿਤ ਆਪਿ ਕਰਣੈਹਾਰ ॥",
      "transliteration": "apune chalit aap karanaihaar ||",
      "translation": "In His own play, He Himself is the Actor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਉਤਕ ਕਰੈ ਰੰਗ ਆਪਾਰ ॥",
      "transliteration": "kautak karai ra(n)g aapaar ||",
      "translation": "He produces His plays with infinite variety.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਨ ਮਹਿ ਆਪਿ ਮਨ ਅਪੁਨੇ ਮਾਹਿ ॥",
      "transliteration": "man mahi aap man apune maahi ||",
      "translation": "He Himself is in the mind, and the mind is in Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਨਕ ਕੀਮਤਿ ਕਹਨੁ ਨ ਜਾਇ ॥੭॥",
      "transliteration": "naanak keemat kahan na jaai ||7||",
      "translation": "O Nanak, His worth cannot be estimated. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਤਿ ਸਤਿ ਸਤਿ ਪ੍ਰਭੁ ਸੁਆਮੀ ॥",
      "transliteration": "sat sat sat prabh suaamee ||",
      "translation": "True, True, True is God, our Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਕਿਨੈ ਵਖਿਆਨੀ ॥",
      "transliteration": "gur parasaad kinai vakhiaanee ||",
      "translation": "By Guru's Grace, some speak of Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਚੁ ਸਚੁ ਸਚੁ ਸਭੁ ਕੀਨਾ ॥",
      "transliteration": "sach sach sach sabh keenaa ||",
      "translation": "True, True, True is the Creator of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੋਟਿ ਮਧੇ ਕਿਨੈ ਬਿਰਲੈ ਚੀਨਾ ॥",
      "transliteration": "kot madhe kinai biralai cheenaa ||",
      "translation": "Out of millions, scarcely anyone knows Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਲਾ ਭਲਾ ਭਲਾ ਤੇਰਾ ਰੂਪ ॥",
      "transliteration": "bhalaa bhalaa bhalaa teraa roop ||",
      "translation": "Beautiful, Beautiful, Beautiful is Your Sublime Form.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਤਿ ਸੁੰਦਰ ਅਪਾਰ ਅਨੂਪ ॥",
      "transliteration": "at su(n)dar apaar anoop ||",
      "translation": "You are Exquisitely Beautiful, Infinite and Incomparable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਿਰਮਲ ਨਿਰਮਲ ਨਿਰਮਲ ਤੇਰੀ ਬਾਣੀ ॥",
      "transliteration": "niramal niramal niramal teree baanee ||",
      "translation": "Pure, Pure, Pure is the Word of Your Bani,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਸੁਨੀ ਸ੍ਰਵਨ ਬਖੵਾਣੀ ॥",
      "transliteration": "ghat ghat sunee sravan bakhyaanee ||",
      "translation": "heard in each and every heart, spoken to the ears.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪਵਿਤ੍ਰ ਪਵਿਤ੍ਰ ਪਵਿਤ੍ਰ ਪੁਨੀਤ ॥",
      "transliteration": "pavitr pavitr pavitr puneet ||",
      "translation": "Holy, Holy, Holy and Sublimely Pure",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਮੁ ਜਪੈ ਨਾਨਕ ਮਨਿ ਪ੍ਰੀਤਿ ॥੮॥੧੨॥",
      "transliteration": "naam japai naanak man preet ||8||12||",
      "translation": "- chant the Naam, O Nanak, with heart-felt love. ||8||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੰਤ ਸਰਨਿ ਜੋ ਜਨੁ ਪਰੈ ਸੋ ਜਨੁ ਉਧਰਨਹਾਰ ॥",
      "transliteration": "sa(n)t saran jo jan parai so jan udharanahaar ||",
      "translation": "One who seeks the Sanctuary of the Saints shall be saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੰਤ ਕੀ ਨਿੰਦਾ ਨਾਨਕਾ ਬਹੁਰਿ ਬਹੁਰਿ ਅਵਤਾਰ ॥੧॥",
      "transliteration": "sa(n)t kee ni(n)daa naanakaa bahur bahur avataar ||1||",
      "translation": "One who slanders the Saints, O Nanak, shall be reincarnated over and over again. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੰਤ ਕੈ ਦੂਖਨਿ ਆਰਜਾ ਘਟੈ ॥",
      "transliteration": "sa(n)t kai dookhan aarajaa ghatai ||",
      "translation": "Slandering the Saints, one's life is cut short.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੰਤ ਕੈ ਦੂਖਨਿ ਜਮ ਤੇ ਨਹੀ ਛੁਟੈ ॥",
      "transliteration": "sa(n)t kai dookhan jam te nahee chhutai ||",
      "translation": "Slandering the Saints, one shall not escape the Messenger of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੰਤ ਕੈ ਦੂਖਨਿ ਸੁਖੁ ਸਭੁ ਜਾਇ ॥",
      "transliteration": "sa(n)t kai dookhan sukh sabh jaai ||",
      "translation": "Slandering the Saints, all happiness vanishes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੰਤ ਕੈ ਦੂਖਨਿ ਨਰਕ ਮਹਿ ਪਾਇ ॥",
      "transliteration": "sa(n)t kai dookhan narak mahi paai ||",
      "translation": "Slandering the Saints, one falls into hell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੰਤ ਕੈ ਦੂਖਨਿ ਮਤਿ ਹੋਇ ਮਲੀਨ ॥",
      "transliteration": "sa(n)t kai dookhan mat hoi maleen ||",
      "translation": "Slandering the Saints, the intellect is polluted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੰਤ ਕੈ ਦੂਖਨਿ ਸੋਭਾ ਤੇ ਹੀਨ ॥",
      "transliteration": "sa(n)t kai dookhan sobhaa te heen ||",
      "translation": "Slandering the Saints, one's reputation is lost.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੰਤ ਕੇ ਹਤੇ ਕਉ ਰਖੈ ਨ ਕੋਇ ॥",
      "transliteration": "sa(n)t ke hate kau rakhai na koi ||",
      "translation": "One who is cursed by a Saint cannot be saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸੰਤ ਕੈ ਦੂਖਨਿ ਥਾਨ ਭ੍ਰਸਟੁ ਹੋਇ ॥",
      "transliteration": "sa(n)t kai dookhan thaan bhrasat hoi ||",
      "translation": "Slandering the Saints, one's place is defiled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੰਤ ਕ੍ਰਿਪਾਲ ਕ੍ਰਿਪਾ ਜੇ ਕਰੈ ॥",
      "transliteration": "sa(n)t kripaal kripaa je karai ||",
      "translation": "But if the Compassionate Saint shows His Kindness,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾਨਕ ਸੰਤਸੰਗਿ ਨਿੰਦਕੁ ਭੀ ਤਰੈ ॥੧॥",
      "transliteration": "naanak sa(n)tasa(n)g ni(n)dak bhee tarai ||1||",
      "translation": "O Nanak, in the Company of the Saints, the slanderer may still be saved. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੰਤ ਕੇ ਦੂਖਨ ਤੇ ਮੁਖੁ ਭਵੈ ॥",
      "transliteration": "sa(n)t ke dookhan te mukh bhavai ||",
      "translation": "Slandering the Saints, one becomes a wry-faced malcontent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸੰਤਨ ਕੈ ਦੂਖਨਿ ਕਾਗ ਜਿਉ ਲਵੈ ॥",
      "transliteration": "sa(n)tan kai dookhan kaag jiu lavai ||",
      "translation": "Slandering the Saints, one croaks like a raven.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸੰਤਨ ਕੈ ਦੂਖਨਿ ਸਰਪ ਜੋਨਿ ਪਾਇ ॥",
      "transliteration": "sa(n)tan kai dookhan sarap jon paai ||",
      "translation": "Slandering the Saints, one is reincarnated as a snake.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸੰਤ ਕੈ ਦੂਖਨਿ ਤ੍ਰਿਗਦ ਜੋਨਿ ਕਿਰਮਾਇ ॥",
      "transliteration": "sa(n)t kai dookhan trigad jon kiramaai ||",
      "translation": "Slandering the Saints, one is reincarnated as a wiggling worm.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸੰਤਨ ਕੈ ਦੂਖਨਿ ਤ੍ਰਿਸਨਾ ਮਹਿ ਜਲੈ ॥",
      "transliteration": "sa(n)tan kai dookhan trisanaa mahi jalai ||",
      "translation": "Slandering the Saints, one burns in the fire of desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸੰਤ ਕੈ ਦੂਖਨਿ ਸਭੁ ਕੋ ਛਲੈ ॥",
      "transliteration": "sa(n)t kai dookhan sabh ko chhalai ||",
      "translation": "Slandering the Saints, one tries to deceive everyone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸੰਤ ਕੈ ਦੂਖਨਿ ਤੇਜੁ ਸਭੁ ਜਾਇ ॥",
      "transliteration": "sa(n)t kai dookhan tej sabh jaai ||",
      "translation": "Slandering the Saints, all one's influence vanishes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸੰਤ ਕੈ ਦੂਖਨਿ ਨੀਚੁ ਨੀਚਾਇ ॥",
      "transliteration": "sa(n)t kai dookhan neech neechaai ||",
      "translation": "Slandering the Saints, one becomes the lowest of the low.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0279_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਸੰਤ ਦੋਖੀ ਕਾ ਥਾਉ ਕੋ ਨਾਹਿ ॥",
      "transliteration": "sa(n)t dokhee kaa thaau ko naahi ||",
      "translation": "For the slanderer of the Saint, there is no place of rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 279,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
