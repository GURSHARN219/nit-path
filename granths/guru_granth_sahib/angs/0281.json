{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 281,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0281_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਸ ਨੋ ਕ੍ਰਿਪਾ ਕਰੈ ਤਿਸੁ ਆਪਨ ਨਾਮੁ ਦੇਇ ॥",
      "transliteration": "jis no kripaa karai tis aapan naam dei ||",
      "translation": "He Himself gives His Name to those, upon whom He bestows His Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਡਭਾਗੀ ਨਾਨਕ ਜਨ ਸੇਇ ॥੮॥੧੩॥",
      "transliteration": "badabhaagee naanak jan sei ||8||13||",
      "translation": "Very fortunate, O Nanak, are those people. ||8||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਜਹੁ ਸਿਆਨਪ ਸੁਰਿ ਜਨਹੁ ਸਿਮਰਹੁ ਹਰਿ ਹਰਿ ਰਾਇ ॥",
      "transliteration": "tajahu siaanap sur janahu simarahu har har raai ||",
      "translation": "Give up your cleverness, good people - remember the Lord God, your King!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਏਕ ਆਸ ਹਰਿ ਮਨਿ ਰਖਹੁ ਨਾਨਕ ਦੂਖੁ ਭਰਮੁ ਭਉ ਜਾਇ ॥੧॥",
      "transliteration": "ek aas har man rakhahu naanak dookh bharam bhau jaai ||1||",
      "translation": "Enshrine in your heart, your hopes in the One Lord. O Nanak, your pain, doubt and fear shall depart. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਾਨੁਖ ਕੀ ਟੇਕ ਬ੍ਰਿਥੀ ਸਭ ਜਾਨੁ ॥",
      "transliteration": "maanukh kee tek brithee sabh jaan ||",
      "translation": "Reliance on mortals is in vain - know this well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੇਵਨ ਕਉ ਏਕੈ ਭਗਵਾਨੁ ॥",
      "transliteration": "devan kau ekai bhagavaan ||",
      "translation": "The Great Giver is the One Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਿਸ ਕੈ ਦੀਐ ਰਹੈ ਅਘਾਇ ॥",
      "transliteration": "jis kai deeai rahai aghaai ||",
      "translation": "By His gifts, we are satisfied,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਹੁਰਿ ਨ ਤ੍ਰਿਸਨਾ ਲਾਗੈ ਆਇ ॥",
      "transliteration": "bahur na trisanaa laagai aai ||",
      "translation": "and we suffer from thirst no longer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਾਰੈ ਰਾਖੈ ਏਕੋ ਆਪਿ ॥",
      "transliteration": "maarai raakhai eko aap ||",
      "translation": "The One Lord Himself destroys and also preserves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਾਨੁਖ ਕੈ ਕਿਛੁ ਨਾਹੀ ਹਾਥਿ ॥",
      "transliteration": "maanukh kai kichh naahee haath ||",
      "translation": "Nothing at all is in the hands of mortal beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਸ ਕਾ ਹੁਕਮੁ ਬੂਝਿ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "tis kaa hukam boojh sukh hoi ||",
      "translation": "Understanding His Order, there is peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਿਸ ਕਾ ਨਾਮੁ ਰਖੁ ਕੰਠਿ ਪਰੋਇ ॥",
      "transliteration": "tis kaa naam rakh ka(n)th paroi ||",
      "translation": "So take His Name, and wear it as your necklace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਸਿਮਰਿ ਪ੍ਰਭੁ ਸੋਇ ॥",
      "transliteration": "simar simar simar prabh soi ||",
      "translation": "Remember, remember, remember God in meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਨਕ ਬਿਘਨੁ ਨ ਲਾਗੈ ਕੋਇ ॥੧॥",
      "transliteration": "naanak bighan na laagai koi ||1||",
      "translation": "O Nanak, no obstacle shall stand in your way. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਉਸਤਤਿ ਮਨ ਮਹਿ ਕਰਿ ਨਿਰੰਕਾਰ ॥",
      "transliteration": "usatat man mahi kar nira(n)kaar ||",
      "translation": "Praise the Formless Lord in your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਰਿ ਮਨ ਮੇਰੇ ਸਤਿ ਬਿਉਹਾਰ ॥",
      "transliteration": "kar man mere sat biuhaar ||",
      "translation": "O my mind, make this your true occupation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਿਰਮਲ ਰਸਨਾ ਅੰਮ੍ਰਿਤੁ ਪੀਉ ॥",
      "transliteration": "niramal rasanaa a(n)mrit peeu ||",
      "translation": "Let your tongue become pure, drinking in the Ambrosial Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਦਾ ਸੁਹੇਲਾ ਕਰਿ ਲੇਹਿ ਜੀਉ ॥",
      "transliteration": "sadaa suhelaa kar lehi jeeu ||",
      "translation": "Your soul shall be forever peaceful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨੈਨਹੁ ਪੇਖੁ ਠਾਕੁਰ ਕਾ ਰੰਗੁ ॥",
      "transliteration": "nainahu pekh thaakur kaa ra(n)g ||",
      "translation": "With your eyes, see the wondrous play of your Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਬਿਨਸੈ ਸਭ ਸੰਗੁ ॥",
      "transliteration": "saadhasa(n)g binasai sabh sa(n)g ||",
      "translation": "In the Company of the Holy, all other associations vanish.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਰਨ ਚਲਉ ਮਾਰਗਿ ਗੋਬਿੰਦ ॥",
      "transliteration": "charan chalau maarag gobi(n)d ||",
      "translation": "With your feet, walk in the Way of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਿਟਹਿ ਪਾਪ ਜਪੀਐ ਹਰਿ ਬਿੰਦ ॥",
      "transliteration": "mitahi paap japeeai har bi(n)d ||",
      "translation": "Sins are washed away, chanting the Lord's Name, even for a moment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਰ ਹਰਿ ਕਰਮ ਸ੍ਰਵਨਿ ਹਰਿ ਕਥਾ ॥",
      "transliteration": "kar har karam sravan har kathaa ||",
      "translation": "So do the Lord's Work, and listen to the Lord's Sermon.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰਿ ਦਰਗਹ ਨਾਨਕ ਊਜਲ ਮਥਾ ॥੨॥",
      "transliteration": "har daragah naanak oojal mathaa ||2||",
      "translation": "In the Lord's Court, O Nanak, your face shall be radiant. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਡਭਾਗੀ ਤੇ ਜਨ ਜਗ ਮਾਹਿ ॥",
      "transliteration": "badabhaagee te jan jag maahi ||",
      "translation": "Very fortunate are those humble beings in this world,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਹਰਿ ਕੇ ਗੁਨ ਗਾਹਿ ॥",
      "transliteration": "sadaa sadaa har ke gun gaahi ||",
      "translation": "who sing the Glorious Praises of the Lord, forever and ever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਜੋ ਕਰਹਿ ਬੀਚਾਰ ॥",
      "transliteration": "raam naam jo karahi beechaar ||",
      "translation": "Those who dwell upon the Lord's Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੇ ਧਨਵੰਤ ਗਨੀ ਸੰਸਾਰ ॥",
      "transliteration": "se dhanava(n)t ganee sa(n)saar ||",
      "translation": "are the most wealthy and prosperous in the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਨਿ ਤਨਿ ਮੁਖਿ ਬੋਲਹਿ ਹਰਿ ਮੁਖੀ ॥",
      "transliteration": "man tan mukh bolahi har mukhee ||",
      "translation": "Those who speak of the Supreme Lord in thought, word and deed",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਜਾਨਹੁ ਤੇ ਸੁਖੀ ॥",
      "transliteration": "sadaa sadaa jaanahu te sukhee ||",
      "translation": "know that they are peaceful and happy, forever and ever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਏਕੋ ਏਕੁ ਏਕੁ ਪਛਾਨੈ ॥",
      "transliteration": "eko ek ek pachhaanai ||",
      "translation": "One who recognizes the One and only Lord as One,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਤ ਉਤ ਕੀ ਓਹੁ ਸੋਝੀ ਜਾਨੈ ॥",
      "transliteration": "it ut kee ohu sojhee jaanai ||",
      "translation": "understands this world and the next.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਮ ਸੰਗਿ ਜਿਸ ਕਾ ਮਨੁ ਮਾਨਿਆ ॥",
      "transliteration": "naam sa(n)g jis kaa man maaniaa ||",
      "translation": "One whose mind accepts the Company of the Naam,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਨਕ ਤਿਨਹਿ ਨਿਰੰਜਨੁ ਜਾਨਿਆ ॥੩॥",
      "transliteration": "naanak tinahi nira(n)jan jaaniaa ||3||",
      "translation": "the Name of the Lord, O Nanak, knows the Immaculate Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਆਪਨ ਆਪੁ ਸੁਝੈ ॥",
      "transliteration": "gur prasaad aapan aap sujhai ||",
      "translation": "By Guru's Grace, one understands himself;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਿਸ ਕੀ ਜਾਨਹੁ ਤ੍ਰਿਸਨਾ ਬੁਝੈ ॥",
      "transliteration": "tis kee jaanahu trisanaa bujhai ||",
      "translation": "know that then, his thirst is quenched.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਹਰਿ ਹਰਿ ਜਸੁ ਕਹਤ ॥",
      "transliteration": "saadhasa(n)g har har jas kahat ||",
      "translation": "In the Company of the Holy, one chants the Praises of the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਰਬ ਰੋਗ ਤੇ ਓਹੁ ਹਰਿ ਜਨੁ ਰਹਤ ॥",
      "transliteration": "sarab rog te ohu har jan rahat ||",
      "translation": "Such a devotee of the Lord is free of all disease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਨਦਿਨੁ ਕੀਰਤਨੁ ਕੇਵਲ ਬਖੵਾਨੁ ॥",
      "transliteration": "anadin keeratan keval bakhyaan ||",
      "translation": "Night and day, sing the Kirtan, the Praises of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗ੍ਰਿਹਸਤ ਮਹਿ ਸੋਈ ਨਿਰਬਾਨੁ ॥",
      "transliteration": "grihasat mahi soee nirabaan ||",
      "translation": "In the midst of your household, remain balanced and unattached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਏਕ ਊਪਰਿ ਜਿਸੁ ਜਨ ਕੀ ਆਸਾ ॥",
      "transliteration": "ek oopar jis jan kee aasaa ||",
      "translation": "One who places his hopes in the One Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਸ ਕੀ ਕਟੀਐ ਜਮ ਕੀ ਫਾਸਾ ॥",
      "transliteration": "tis kee kateeai jam kee phaasaa ||",
      "translation": "the noose of Death is cut away from his neck.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕੀ ਜਿਸੁ ਮਨਿ ਭੂਖ ॥",
      "transliteration": "paarabraham kee jis man bhookh ||",
      "translation": "One whose mind hungers for the Supreme Lord God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕ ਤਿਸਹਿ ਨ ਲਾਗਹਿ ਦੂਖ ॥੪॥",
      "transliteration": "naanak tisahi na laagahi dookh ||4||",
      "translation": "O Nanak, shall not suffer pain. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਿਸ ਕਉ ਹਰਿ ਪ੍ਰਭੁ ਮਨਿ ਚਿਤਿ ਆਵੈ ॥",
      "transliteration": "jis kau har prabh man chit aavai ||",
      "translation": "One who focuses his conscious mind on the Lord God",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੋ ਸੰਤੁ ਸੁਹੇਲਾ ਨਹੀ ਡੁਲਾਵੈ ॥",
      "transliteration": "so sa(n)t suhelaa nahee dulaavai ||",
      "translation": "- that Saint is at peace; he does not waver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਿਸੁ ਪ੍ਰਭੁ ਅਪੁਨਾ ਕਿਰਪਾ ਕਰੈ ॥",
      "transliteration": "jis prabh apunaa kirapaa karai ||",
      "translation": "Those unto whom God has granted His Grace",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੋ ਸੇਵਕੁ ਕਹੁ ਕਿਸ ਤੇ ਡਰੈ ॥",
      "transliteration": "so sevak kahu kis te darai ||",
      "translation": "who do those servants need to fear?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜੈਸਾ ਸਾ ਤੈਸਾ ਦ੍ਰਿਸਟਾਇਆ ॥",
      "transliteration": "jaisaa saa taisaa drisataaiaa ||",
      "translation": "As God is, so does He appear;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਪੁਨੇ ਕਾਰਜ ਮਹਿ ਆਪਿ ਸਮਾਇਆ ॥",
      "transliteration": "apune kaaraj mahi aap samaaiaa ||",
      "translation": "in His Own creation, He Himself is pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੋਧਤ ਸੋਧਤ ਸੋਧਤ ਸੀਝਿਆ ॥",
      "transliteration": "sodhat sodhat sodhat seejhiaa ||",
      "translation": "Searching, searching, searching, and finally, success!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਤਤੁ ਸਭੁ ਬੂਝਿਆ ॥",
      "transliteration": "gur prasaad tat sabh boojhiaa ||",
      "translation": "By Guru's Grace, the essence of all reality is understood.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਬ ਦੇਖਉ ਤਬ ਸਭੁ ਕਿਛੁ ਮੂਲੁ ॥",
      "transliteration": "jab dekhau tab sabh kichh mool ||",
      "translation": "Wherever I look, there I see Him, at the root of all things.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਨਕ ਸੋ ਸੂਖਮੁ ਸੋਈ ਅਸਥੂਲੁ ॥੫॥",
      "transliteration": "naanak so sookham soee asathool ||5||",
      "translation": "O Nanak, He is the subtle, and He is also the manifest. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਨਹ ਕਿਛੁ ਜਨਮੈ ਨਹ ਕਿਛੁ ਮਰੈ ॥",
      "transliteration": "nah kichh janamai nah kichh marai ||",
      "translation": "Nothing is born, and nothing dies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਆਪਨ ਚਲਿਤੁ ਆਪ ਹੀ ਕਰੈ ॥",
      "transliteration": "aapan chalit aap hee karai ||",
      "translation": "He Himself stages His own drama.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਆਵਨੁ ਜਾਵਨੁ ਦ੍ਰਿਸਟਿ ਅਨਦ੍ਰਿਸਟਿ ॥",
      "transliteration": "aavan jaavan drisat anadrisat ||",
      "translation": "Coming and going, seen and unseen,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0281_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਆਗਿਆਕਾਰੀ ਧਾਰੀ ਸਭ ਸ੍ਰਿਸਟਿ ॥",
      "transliteration": "aagiaakaaree dhaaree sabh srisat ||",
      "translation": "all the world is obedient to His Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 281,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
