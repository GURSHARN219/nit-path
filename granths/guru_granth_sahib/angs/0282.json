{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 282,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0282_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਪੇ ਆਪਿ ਸਗਲ ਮਹਿ ਆਪਿ ॥",
      "transliteration": "aape aap sagal mahi aap ||",
      "translation": "He Himself is All-in-Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਨਿਕ ਜੁਗਤਿ ਰਚਿ ਥਾਪਿ ਉਥਾਪਿ ॥",
      "transliteration": "anik jugat rach thaap uthaap ||",
      "translation": "In His many ways, He establishes and disestablishes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਬਿਨਾਸੀ ਨਾਹੀ ਕਿਛੁ ਖੰਡ ॥",
      "transliteration": "abinaasee naahee kichh kha(n)d ||",
      "translation": "He is Imperishable; nothing can be broken.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਧਾਰਣ ਧਾਰਿ ਰਹਿਓ ਬ੍ਰਹਮੰਡ ॥",
      "transliteration": "dhaaran dhaar rahio brahama(n)d ||",
      "translation": "He lends His Support to maintain the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਲਖ ਅਭੇਵ ਪੁਰਖ ਪਰਤਾਪ ॥",
      "transliteration": "alakh abhev purakh parataap ||",
      "translation": "Unfathomable and Inscrutable is the Glory of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਪਿ ਜਪਾਏ ਤ ਨਾਨਕ ਜਾਪ ॥੬॥",
      "transliteration": "aap japaae ta naanak jaap ||6||",
      "translation": "As He inspires us to meditate, O Nanak, so do we meditate. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਿਨ ਪ੍ਰਭੁ ਜਾਤਾ ਸੁ ਸੋਭਾਵੰਤ ॥",
      "transliteration": "jin prabh jaataa s sobhaava(n)t ||",
      "translation": "Those who know God are glorious.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਗਲ ਸੰਸਾਰੁ ਉਧਰੈ ਤਿਨ ਮੰਤ ॥",
      "transliteration": "sagal sa(n)saar udharai tin ma(n)t ||",
      "translation": "The whole world is redeemed by their teachings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪ੍ਰਭ ਕੇ ਸੇਵਕ ਸਗਲ ਉਧਾਰਨ ॥",
      "transliteration": "prabh ke sevak sagal udhaaran ||",
      "translation": "God's servants redeem all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪ੍ਰਭ ਕੇ ਸੇਵਕ ਦੂਖ ਬਿਸਾਰਨ ॥",
      "transliteration": "prabh ke sevak dookh bisaaran ||",
      "translation": "God's servants cause sorrows to be forgotten.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਪੇ ਮੇਲਿ ਲਏ ਕਿਰਪਾਲ ॥",
      "transliteration": "aape mel lae kirapaal ||",
      "translation": "The Merciful Lord unites them with Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਜਪਿ ਭਏ ਨਿਹਾਲ ॥",
      "transliteration": "gur kaa sabad jap bhae nihaal ||",
      "translation": "Chanting the Word of the Guru's Shabad, they become ecstatic.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਉਨ ਕੀ ਸੇਵਾ ਸੋਈ ਲਾਗੈ ॥",
      "transliteration": "un kee sevaa soee laagai ||",
      "translation": "He alone is committed to serve them,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਸ ਨੋ ਕ੍ਰਿਪਾ ਕਰਹਿ ਬਡਭਾਗੈ ॥",
      "transliteration": "jis no kripaa karahi badabhaagai ||",
      "translation": "upon whom God bestows His Mercy, by great good fortune.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਪਾਵਹਿ ਬਿਸ੍ਰਾਮੁ ॥",
      "transliteration": "naam japat paavahi bisraam ||",
      "translation": "Those who chant the Naam find their place of rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਨਕ ਤਿਨ ਪੁਰਖ ਕਉ ਊਤਮ ਕਰਿ ਮਾਨੁ ॥੭॥",
      "transliteration": "naanak tin purakh kau ootam kar maan ||7||",
      "translation": "O Nanak, respect those persons as the most noble. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕਰੈ ਸੁ ਪ੍ਰਭ ਕੈ ਰੰਗਿ ॥",
      "transliteration": "jo kichh karai s prabh kai ra(n)g ||",
      "translation": "Whatever you do, do it for the Love of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਬਸੈ ਹਰਿ ਸੰਗਿ ॥",
      "transliteration": "sadaa sadaa basai har sa(n)g ||",
      "translation": "Forever and ever, abide with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਹਜ ਸੁਭਾਇ ਹੋਵੈ ਸੋ ਹੋਇ ॥",
      "transliteration": "sahaj subhaai hovai so hoi ||",
      "translation": "By its own natural course, whatever will be will be.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਰਣੈਹਾਰੁ ਪਛਾਣੈ ਸੋਇ ॥",
      "transliteration": "karanaihaar pachhaanai soi ||",
      "translation": "Acknowledge that Creator Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪ੍ਰਭ ਕਾ ਕੀਆ ਜਨ ਮੀਠ ਲਗਾਨਾ ॥",
      "transliteration": "prabh kaa keeaa jan meeth lagaanaa ||",
      "translation": "God's doings are sweet to His humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੈਸਾ ਸਾ ਤੈਸਾ ਦ੍ਰਿਸਟਾਨਾ ॥",
      "transliteration": "jaisaa saa taisaa drisataanaa ||",
      "translation": "As He is, so does He appear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਿਸ ਤੇ ਉਪਜੇ ਤਿਸੁ ਮਾਹਿ ਸਮਾਏ ॥",
      "transliteration": "jis te upaje tis maahi samaae ||",
      "translation": "From Him we came, and into Him we shall merge again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਓਇ ਸੁਖ ਨਿਧਾਨ ਉਨਹੂ ਬਨਿ ਆਏ ॥",
      "transliteration": "oi sukh nidhaan unahoo ban aae ||",
      "translation": "He is the treasure of peace, and so does His servant become.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਪਸ ਕਉ ਆਪਿ ਦੀਨੋ ਮਾਨੁ ॥",
      "transliteration": "aapas kau aap deeno maan ||",
      "translation": "Unto His own, He has given His honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਨਕ ਪ੍ਰਭ ਜਨੁ ਏਕੋ ਜਾਨੁ ॥੮॥੧੪॥",
      "transliteration": "naanak prabh jan eko jaan ||8||14||",
      "translation": "O Nanak, know that God and His humble servant are one and the same. ||8||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਰਬ ਕਲਾ ਭਰਪੂਰ ਪ੍ਰਭ ਬਿਰਥਾ ਜਾਨਨਹਾਰ ॥",
      "transliteration": "sarab kalaa bharapoor prabh birathaa jaananahaar ||",
      "translation": "God is totally imbued with all powers; He is the Knower of our troubles.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾ ਕੈ ਸਿਮਰਨਿ ਉਧਰੀਐ ਨਾਨਕ ਤਿਸੁ ਬਲਿਹਾਰ ॥੧॥",
      "transliteration": "jaa kai simaran udhareeai naanak tis balihaar ||1||",
      "translation": "Meditating in remembrance on Him, we are saved; Nanak is a sacrifice to Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਟੂਟੀ ਗਾਢਨਹਾਰ ਗੋੁਪਾਲ ॥",
      "transliteration": "tootee gaadhanahaar goupaal ||",
      "translation": "The Lord of the World is the Mender of the broken.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਰਬ ਜੀਆ ਆਪੇ ਪ੍ਰਤਿਪਾਲ ॥",
      "transliteration": "sarab jeeaa aape pratipaal ||",
      "translation": "He Himself cherishes all beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਗਲ ਕੀ ਚਿੰਤਾ ਜਿਸੁ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "sagal kee chi(n)taa jis man maahi ||",
      "translation": "The cares of all are on His Mind;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਿਸ ਤੇ ਬਿਰਥਾ ਕੋਈ ਨਾਹਿ ॥",
      "transliteration": "tis te birathaa koee naahi ||",
      "translation": "no one is turned away from Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰੇ ਮਨ ਮੇਰੇ ਸਦਾ ਹਰਿ ਜਾਪਿ ॥",
      "transliteration": "re man mere sadaa har jaap ||",
      "translation": "O my mind, meditate forever on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਬਿਨਾਸੀ ਪ੍ਰਭੁ ਆਪੇ ਆਪਿ ॥",
      "transliteration": "abinaasee prabh aape aap ||",
      "translation": "The Imperishable Lord God is Himself All-in-all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਪਨ ਕੀਆ ਕਛੂ ਨ ਹੋਇ ॥",
      "transliteration": "aapan keeaa kachhoo na hoi ||",
      "translation": "By one's own actions, nothing is accomplished,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੇ ਸਉ ਪ੍ਰਾਨੀ ਲੋਚੈ ਕੋਇ ॥",
      "transliteration": "je sau praanee lochai koi ||",
      "translation": "even though the mortal may wish it so, hundreds of times.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਿਸੁ ਬਿਨੁ ਨਾਹੀ ਤੇਰੈ ਕਿਛੁ ਕਾਮ ॥",
      "transliteration": "tis bin naahee terai kichh kaam ||",
      "translation": "Without Him, nothing is of any use to you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗਤਿ ਨਾਨਕ ਜਪਿ ਏਕ ਹਰਿ ਨਾਮ ॥੧॥",
      "transliteration": "gat naanak jap ek har naam ||1||",
      "translation": "Salvation, O Nanak, is attained by chanting the Name of the One Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰੂਪਵੰਤੁ ਹੋਇ ਨਾਹੀ ਮੋਹੈ ॥",
      "transliteration": "roopava(n)t hoi naahee mohai ||",
      "translation": "One who is good-looking should not be vain;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਜੋਤਿ ਸਗਲ ਘਟ ਸੋਹੈ ॥",
      "transliteration": "prabh kee jot sagal ghat sohai ||",
      "translation": "the Light of God is in all hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਧਨਵੰਤਾ ਹੋਇ ਕਿਆ ਕੋ ਗਰਬੈ ॥",
      "transliteration": "dhanava(n)taa hoi kiaa ko garabai ||",
      "translation": "Why should anyone be proud of being rich?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਾ ਸਭੁ ਕਿਛੁ ਤਿਸ ਕਾ ਦੀਆ ਦਰਬੈ ॥",
      "transliteration": "jaa sabh kichh tis kaa deeaa darabai ||",
      "translation": "All riches are His gifts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਤਿ ਸੂਰਾ ਜੇ ਕੋਊ ਕਹਾਵੈ ॥",
      "transliteration": "at sooraa je kooo kahaavai ||",
      "translation": "One may call himself a great hero,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਕਲਾ ਬਿਨਾ ਕਹ ਧਾਵੈ ॥",
      "transliteration": "prabh kee kalaa binaa kah dhaavai ||",
      "translation": "but without God's Power, what can anyone do?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੇ ਕੋ ਹੋਇ ਬਹੈ ਦਾਤਾਰੁ ॥",
      "transliteration": "je ko hoi bahai daataar ||",
      "translation": "One who brags about giving to charities",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਸੁ ਦੇਨਹਾਰੁ ਜਾਨੈ ਗਾਵਾਰੁ ॥",
      "transliteration": "tis denahaar jaanai gaavaar ||",
      "translation": "the Great Giver shall judge him to be a fool.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਿਸੁ ਗੁਰ ਪ੍ਰਸਾਦਿ ਤੂਟੈ ਹਉ ਰੋਗੁ ॥",
      "transliteration": "jis gur prasaad tootai hau rog ||",
      "translation": "One who, by Guru's Grace, is cured of the disease of ego",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਨਕ ਸੋ ਜਨੁ ਸਦਾ ਅਰੋਗੁ ॥੨॥",
      "transliteration": "naanak so jan sadaa arog ||2||",
      "translation": "- O Nanak, that person is forever healthy. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਿਉ ਮੰਦਰ ਕਉ ਥਾਮੈ ਥੰਮਨੁ ॥",
      "transliteration": "jiu ma(n)dar kau thaamai tha(n)man ||",
      "translation": "As a palace is supported by its pillars,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤਿਉ ਗੁਰ ਕਾ ਸਬਦੁ ਮਨਹਿ ਅਸਥੰਮਨੁ ॥",
      "transliteration": "tiu gur kaa sabad manahi asatha(n)man ||",
      "translation": "so does the Guru's Word support the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਿਉ ਪਾਖਾਣੁ ਨਾਵ ਚੜਿ ਤਰੈ ॥",
      "transliteration": "jiu paakhaan naav chaR tarai ||",
      "translation": "As a stone placed in a boat can cross over the river,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪ੍ਰਾਣੀ ਗੁਰ ਚਰਣ ਲਗਤੁ ਨਿਸਤਰੈ ॥",
      "transliteration": "praanee gur charan lagat nisatarai ||",
      "translation": "so is the mortal saved, grasping hold of the Guru's Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਿਉ ਅੰਧਕਾਰ ਦੀਪਕ ਪਰਗਾਸੁ ॥",
      "transliteration": "jiu a(n)dhakaar deepak paragaas ||",
      "translation": "As the darkness is illuminated by the lamp,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਗੁਰ ਦਰਸਨੁ ਦੇਖਿ ਮਨਿ ਹੋਇ ਬਿਗਾਸੁ ॥",
      "transliteration": "gur darasan dekh man hoi bigaas ||",
      "translation": "so does the mind blossom forth, beholding the Blessed Vision of the Guru's Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਿਉ ਮਹਾ ਉਦਿਆਨ ਮਹਿ ਮਾਰਗੁ ਪਾਵੈ ॥",
      "transliteration": "jiu mahaa udiaan mahi maarag paavai ||",
      "translation": "The path is found through the great wilderness by joining the Saadh Sangat,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤਿਉ ਸਾਧੂ ਸੰਗਿ ਮਿਲਿ ਜੋਤਿ ਪ੍ਰਗਟਾਵੈ ॥",
      "transliteration": "tiu saadhoo sa(n)g mil jot pragataavai ||",
      "translation": "The Company of the Holy, and one's light shines forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਤਿਨ ਸੰਤਨ ਕੀ ਬਾਛਉ ਧੂਰਿ ॥",
      "transliteration": "tin sa(n)tan kee baachhau dhoor ||",
      "translation": "I seek the dust of the feet of those Saints;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਨਾਨਕ ਕੀ ਹਰਿ ਲੋਚਾ ਪੂਰਿ ॥੩॥",
      "transliteration": "naanak kee har lochaa poor ||3||",
      "translation": "O Lord, fulfill Nanak's longing! ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0282_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਮਨ ਮੂਰਖ ਕਾਹੇ ਬਿਲਲਾਈਐ ॥",
      "transliteration": "man moorakh kaahe bilalaaeeai ||",
      "translation": "O foolish mind, why do you cry and bewail?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 282,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
