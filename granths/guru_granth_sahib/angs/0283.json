{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 283,
  "lineCount": 62,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0283_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪੁਰਬ ਲਿਖੇ ਕਾ ਲਿਖਿਆ ਪਾਈਐ ॥",
      "transliteration": "purab likhe kaa likhiaa paaeeai ||",
      "translation": "You shall obtain your pre-ordained destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੂਖ ਸੂਖ ਪ੍ਰਭ ਦੇਵਨਹਾਰੁ ॥",
      "transliteration": "dookh sookh prabh devanahaar ||",
      "translation": "God is the Giver of pain and pleasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਵਰ ਤਿਆਗਿ ਤੂ ਤਿਸਹਿ ਚਿਤਾਰੁ ॥",
      "transliteration": "avar tiaag too tisahi chitaar ||",
      "translation": "Abandon others, and think of Him alone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੋ ਕਛੁ ਕਰੈ ਸੋਈ ਸੁਖੁ ਮਾਨੁ ॥",
      "transliteration": "jo kachh karai soee sukh maan ||",
      "translation": "Whatever He does - take comfort in that.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭੂਲਾ ਕਾਹੇ ਫਿਰਹਿ ਅਜਾਨ ॥",
      "transliteration": "bhoolaa kaahe phirahi ajaan ||",
      "translation": "Why do you wander around, you ignorant fool?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਉਨ ਬਸਤੁ ਆਈ ਤੇਰੈ ਸੰਗ ॥",
      "transliteration": "kaun basat aaee terai sa(n)g ||",
      "translation": "What things did you bring with you?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲਪਟਿ ਰਹਿਓ ਰਸਿ ਲੋਭੀ ਪਤੰਗ ॥",
      "transliteration": "lapat rahio ras lobhee pata(n)g ||",
      "translation": "You cling to worldly pleasures like a greedy moth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਜਪਿ ਹਿਰਦੇ ਮਾਹਿ ॥",
      "transliteration": "raam naam jap hirade maahi ||",
      "translation": "Dwell upon the Lord's Name in your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਨਕ ਪਤਿ ਸੇਤੀ ਘਰਿ ਜਾਹਿ ॥੪॥",
      "transliteration": "naanak pat setee ghar jaahi ||4||",
      "translation": "O Nanak, thus you shall return to your home with honor. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਸੁ ਵਖਰ ਕਉ ਲੈਨਿ ਤੂ ਆਇਆ ॥",
      "transliteration": "jis vakhar kau lain too aaiaa ||",
      "translation": "This merchandise, which you have come to obtain",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਸੰਤਨ ਘਰਿ ਪਾਇਆ ॥",
      "transliteration": "raam naam sa(n)tan ghar paaiaa ||",
      "translation": "- the Lord's Name is obtained in the home of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਜਿ ਅਭਿਮਾਨੁ ਲੇਹੁ ਮਨ ਮੋਲਿ ॥",
      "transliteration": "taj abhimaan lehu man mol ||",
      "translation": "Renounce your egotistical pride, and with your mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਹਿਰਦੇ ਮਹਿ ਤੋਲਿ ॥",
      "transliteration": "raam naam hirade mahi tol ||",
      "translation": "Purchase the Lord's Name - measure it out within your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਲਾਦਿ ਖੇਪ ਸੰਤਹ ਸੰਗਿ ਚਾਲੁ ॥",
      "transliteration": "laad khep sa(n)tah sa(n)g chaal ||",
      "translation": "Load up this merchandise, and set out with the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਵਰ ਤਿਆਗਿ ਬਿਖਿਆ ਜੰਜਾਲ ॥",
      "transliteration": "avar tiaag bikhiaa ja(n)jaal ||",
      "translation": "Give up other corrupt entanglements.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਧੰਨਿ ਧੰਨਿ ਕਹੈ ਸਭੁ ਕੋਇ ॥",
      "transliteration": "dha(n)n dha(n)n kahai sabh koi ||",
      "translation": "\"Blessed, blessed\", everyone will call you,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੁਖ ਊਜਲ ਹਰਿ ਦਰਗਹ ਸੋਇ ॥",
      "transliteration": "mukh oojal har daragah soi ||",
      "translation": "and your face shall be radiant in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਹੁ ਵਾਪਾਰੁ ਵਿਰਲਾ ਵਾਪਾਰੈ ॥",
      "transliteration": "ihu vaapaar viralaa vaapaarai ||",
      "translation": "In this trade, only a few are trading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕੈ ਸਦ ਬਲਿਹਾਰੈ ॥੫॥",
      "transliteration": "naanak taa kai sad balihaarai ||5||",
      "translation": "Nanak is forever a sacrifice to them. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਰਨ ਸਾਧ ਕੇ ਧੋਇ ਧੋਇ ਪੀਉ ॥",
      "transliteration": "charan saadh ke dhoi dhoi peeu ||",
      "translation": "Wash the feet of the Holy, and drink in this water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਰਪਿ ਸਾਧ ਕਉ ਅਪਨਾ ਜੀਉ ॥",
      "transliteration": "arap saadh kau apanaa jeeu ||",
      "translation": "Dedicate your soul to the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾਧ ਕੀ ਧੂਰਿ ਕਰਹੁ ਇਸਨਾਨੁ ॥",
      "transliteration": "saadh kee dhoor karahu isanaan ||",
      "translation": "Take your cleansing bath in the dust of the feet of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਾਧ ਊਪਰਿ ਜਾਈਐ ਕੁਰਬਾਨੁ ॥",
      "transliteration": "saadh oopar jaaeeai kurabaan ||",
      "translation": "To the Holy, make your life a sacrifice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਾਧ ਸੇਵਾ ਵਡਭਾਗੀ ਪਾਈਐ ॥",
      "transliteration": "saadh sevaa vadabhaagee paaeeai ||",
      "translation": "Service to the Holy is obtained by great good fortune.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਹਰਿ ਕੀਰਤਨੁ ਗਾਈਐ ॥",
      "transliteration": "saadhasa(n)g har keeratan gaaeeai ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, the Kirtan of the Lord's Praise is sung.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਨਿਕ ਬਿਘਨ ਤੇ ਸਾਧੂ ਰਾਖੈ ॥",
      "transliteration": "anik bighan te saadhoo raakhai ||",
      "translation": "From all sorts of dangers, the Saint saves us.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਰਿ ਗੁਨ ਗਾਇ ਅੰਮ੍ਰਿਤ ਰਸੁ ਚਾਖੈ ॥",
      "transliteration": "har gun gaai a(n)mrit ras chaakhai ||",
      "translation": "Singing the Glorious Praises of the Lord, we taste the ambrosial essence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਓਟ ਗਹੀ ਸੰਤਹ ਦਰਿ ਆਇਆ ॥",
      "transliteration": "ot gahee sa(n)tah dar aaiaa ||",
      "translation": "Seeking the Protection of the Saints, we have come to their door.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਰਬ ਸੂਖ ਨਾਨਕ ਤਿਹ ਪਾਇਆ ॥੬॥",
      "transliteration": "sarab sookh naanak tih paaiaa ||6||",
      "translation": "All comforts, O Nanak, are so obtained. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਿਰਤਕ ਕਉ ਜੀਵਾਲਨਹਾਰ ॥",
      "transliteration": "miratak kau jeevaalanahaar ||",
      "translation": "He infuses life back into the dead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭੂਖੇ ਕਉ ਦੇਵਤ ਅਧਾਰ ॥",
      "transliteration": "bhookhe kau devat adhaar ||",
      "translation": "He gives food to the hungry.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਰਬ ਨਿਧਾਨ ਜਾ ਕੀ ਦ੍ਰਿਸਟੀ ਮਾਹਿ ॥",
      "transliteration": "sarab nidhaan jaa kee drisatee maahi ||",
      "translation": "All treasures are within His Glance of Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪੁਰਬ ਲਿਖੇ ਕਾ ਲਹਣਾ ਪਾਹਿ ॥",
      "transliteration": "purab likhe kaa lahanaa paahi ||",
      "translation": "People obtain that which they are pre-ordained to receive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਭੁ ਕਿਛੁ ਤਿਸ ਕਾ ਓਹੁ ਕਰਨੈ ਜੋਗੁ ॥",
      "transliteration": "sabh kichh tis kaa ohu karanai jog ||",
      "translation": "All things are His; He is the Doer of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਿਸੁ ਬਿਨੁ ਦੂਸਰ ਹੋਆ ਨ ਹੋਗੁ ॥",
      "transliteration": "tis bin doosar hoaa na hog ||",
      "translation": "Other than Him, there has never been any other, and there shall never be.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਪਿ ਜਨ ਸਦਾ ਸਦਾ ਦਿਨੁ ਰੈਣੀ ॥",
      "transliteration": "jap jan sadaa sadaa din rainee ||",
      "translation": "Meditate on Him forever and ever, day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਭ ਤੇ ਊਚ ਨਿਰਮਲ ਇਹ ਕਰਣੀ ॥",
      "transliteration": "sabh te ooch niramal ih karanee ||",
      "translation": "This way of life is exalted and immaculate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸ ਕਉ ਨਾਮੁ ਦੀਆ ॥",
      "transliteration": "kar kirapaa jis kau naam deeaa ||",
      "translation": "One whom the Lord, in His Grace, blesses with His Name",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਨਕ ਸੋ ਜਨੁ ਨਿਰਮਲੁ ਥੀਆ ॥੭॥",
      "transliteration": "naanak so jan niramal theeaa ||7||",
      "translation": "- O Nanak, that person becomes immaculate and pure. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾ ਕੈ ਮਨਿ ਗੁਰ ਕੀ ਪਰਤੀਤਿ ॥",
      "transliteration": "jaa kai man gur kee parateet ||",
      "translation": "One who has faith in the Guru in his mind",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਆਵੈ ਹਰਿ ਪ੍ਰਭੁ ਚੀਤਿ ॥",
      "transliteration": "tis jan aavai har prabh cheet ||",
      "translation": "comes to dwell upon the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਗਤੁ ਭਗਤੁ ਸੁਨੀਐ ਤਿਹੁ ਲੋਇ ॥",
      "transliteration": "bhagat bhagat suneeai tihu loi ||",
      "translation": "He is acclaimed as a devotee, a humble devotee throughout the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾ ਕੈ ਹਿਰਦੈ ਏਕੋ ਹੋਇ ॥",
      "transliteration": "jaa kai hiradai eko hoi ||",
      "translation": "The One Lord is in his heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਚੁ ਕਰਣੀ ਸਚੁ ਤਾ ਕੀ ਰਹਤ ॥",
      "transliteration": "sach karanee sach taa kee rahat ||",
      "translation": "True are his actions; true are his ways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਚੁ ਹਿਰਦੈ ਸਤਿ ਮੁਖਿ ਕਹਤ ॥",
      "transliteration": "sach hiradai sat mukh kahat ||",
      "translation": "True is his heart; Truth is what he speaks with his mouth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਾਚੀ ਦ੍ਰਿਸਟਿ ਸਾਚਾ ਆਕਾਰੁ ॥",
      "transliteration": "saachee drisat saachaa aakaar ||",
      "translation": "True is his vision; true is his form.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਚੁ ਵਰਤੈ ਸਾਚਾ ਪਾਸਾਰੁ ॥",
      "transliteration": "sach varatai saachaa paasaar ||",
      "translation": "He distributes Truth and he spreads Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਜਿਨਿ ਸਚੁ ਕਰਿ ਜਾਤਾ ॥",
      "transliteration": "paarabraham jin sach kar jaataa ||",
      "translation": "One who recognizes the Supreme Lord God as True",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਨਕ ਸੋ ਜਨੁ ਸਚਿ ਸਮਾਤਾ ॥੮॥੧੫॥",
      "transliteration": "naanak so jan sach samaataa ||8||15||",
      "translation": "- O Nanak, that humble being is absorbed into the True One. ||8||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਰੂਪੁ ਨ ਰੇਖ ਨ ਰੰਗੁ ਕਿਛੁ ਤ੍ਰਿਹੁ ਗੁਣ ਤੇ ਪ੍ਰਭ ਭਿੰਨ ॥",
      "transliteration": "roop na rekh na ra(n)g kichh trihu gun te prabh bhi(n)n ||",
      "translation": "He has no form, no shape, no color; God is beyond the three qualities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤਿਸਹਿ ਬੁਝਾਏ ਨਾਨਕਾ ਜਿਸੁ ਹੋਵੈ ਸੁਪ੍ਰਸੰਨ ॥੧॥",
      "transliteration": "tisahi bujhaae naanakaa jis hovai suprasa(n)n ||1||",
      "translation": "They alone understand Him, O Nanak, with whom He is pleased. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਅਬਿਨਾਸੀ ਪ੍ਰਭੁ ਮਨ ਮਹਿ ਰਾਖੁ ॥",
      "transliteration": "abinaasee prabh man mahi raakh ||",
      "translation": "Keep the Immortal Lord God enshrined within your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮਾਨੁਖ ਕੀ ਤੂ ਪ੍ਰੀਤਿ ਤਿਆਗੁ ॥",
      "transliteration": "maanukh kee too preet tiaag ||",
      "translation": "Renounce your love and attachment to people.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਤਿਸ ਤੇ ਪਰੈ ਨਾਹੀ ਕਿਛੁ ਕੋਇ ॥",
      "transliteration": "tis te parai naahee kichh koi ||",
      "translation": "Beyond Him, there is nothing at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸਰਬ ਨਿਰੰਤਰਿ ਏਕੋ ਸੋਇ ॥",
      "transliteration": "sarab nira(n)tar eko soi ||",
      "translation": "The One Lord is pervading among all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਆਪੇ ਬੀਨਾ ਆਪੇ ਦਾਨਾ ॥",
      "transliteration": "aape beenaa aape daanaa ||",
      "translation": "He Himself is All-seeing; He Himself is All-knowing,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਗਹਿਰ ਗੰਭੀਰੁ ਗਹੀਰੁ ਸੁਜਾਨਾ ॥",
      "transliteration": "gahir ga(n)bheer gaheer sujaanaa ||",
      "translation": "Unfathomable, Profound, Deep and All-knowing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਪਰਮੇਸੁਰ ਗੋਬਿੰਦ ॥",
      "transliteration": "paarabraham paramesur gobi(n)d ||",
      "translation": "He is the Supreme Lord God, the Transcendent Lord, the Lord of the Universe,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਨਿਧਾਨ ਦਇਆਲ ਬਖਸੰਦ ॥",
      "transliteration": "kripaa nidhaan daiaal bakhasa(n)d ||",
      "translation": "the Treasure of mercy, compassion and forgiveness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0283_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਸਾਧ ਤੇਰੇ ਕੀ ਚਰਨੀ ਪਾਉ ॥",
      "transliteration": "saadh tere kee charanee paau ||",
      "translation": "To fall at the Feet of Your Holy Beings",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 283,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
