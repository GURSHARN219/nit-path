{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 284,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0284_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਨਕ ਕੈ ਮਨਿ ਇਹੁ ਅਨਰਾਉ ॥੧॥",
      "transliteration": "naanak kai man ihu anaraau ||1||",
      "translation": "- this is the longing of Nanak's mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਨਸਾ ਪੂਰਨ ਸਰਨਾ ਜੋਗ ॥",
      "transliteration": "manasaa pooran saranaa jog ||",
      "translation": "He is the Fulfiller of wishes, who can give us Sanctuary;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੋ ਕਰਿ ਪਾਇਆ ਸੋਈ ਹੋਗੁ ॥",
      "transliteration": "jo kar paaiaa soee hog ||",
      "translation": "That which He has written, comes to pass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਰਨ ਭਰਨ ਜਾ ਕਾ ਨੇਤ੍ਰ ਫੋਰੁ ॥",
      "transliteration": "haran bharan jaa kaa netr phor ||",
      "translation": "He destroys and creates in the twinkling of an eye.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਸ ਕਾ ਮੰਤ੍ਰੁ ਨ ਜਾਨੈ ਹੋਰੁ ॥",
      "transliteration": "tis kaa ma(n)tr na jaanai hor ||",
      "translation": "No one else knows the mystery of His ways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਨਦ ਰੂਪ ਮੰਗਲ ਸਦ ਜਾ ਕੈ ॥",
      "transliteration": "anad roop ma(n)gal sad jaa kai ||",
      "translation": "He is the embodiment of ecstasy and everlasting joy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਰਬ ਥੋਕ ਸੁਨੀਅਹਿ ਘਰਿ ਤਾ ਕੈ ॥",
      "transliteration": "sarab thok suneeahi ghar taa kai ||",
      "translation": "I have heard that all things are in His home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਜ ਮਹਿ ਰਾਜੁ ਜੋਗ ਮਹਿ ਜੋਗੀ ॥",
      "transliteration": "raaj mahi raaj jog mahi jogee ||",
      "translation": "Among kings, He is the King; among yogis, He is the Yogi.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਪ ਮਹਿ ਤਪੀਸਰੁ ਗ੍ਰਿਹਸਤ ਮਹਿ ਭੋਗੀ ॥",
      "transliteration": "tap mahi tapeesar grihasat mahi bhogee ||",
      "translation": "Among ascetics, He is the Ascetic; among householders, He is the Enjoyer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਧਿਆਇ ਧਿਆਇ ਭਗਤਹ ਸੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "dhiaai dhiaai bhagatah sukh paaiaa ||",
      "translation": "By constant meditation, His devotee finds peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਨਕ ਤਿਸੁ ਪੁਰਖ ਕਾ ਕਿਨੈ ਅੰਤੁ ਨ ਪਾਇਆ ॥੨॥",
      "transliteration": "naanak tis purakh kaa kinai a(n)t na paaiaa ||2||",
      "translation": "O Nanak, no one has found the limits of that Supreme Being. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾ ਕੀ ਲੀਲਾ ਕੀ ਮਿਤਿ ਨਾਹਿ ॥",
      "transliteration": "jaa kee leelaa kee mit naahi ||",
      "translation": "There is no limit to His play.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਗਲ ਦੇਵ ਹਾਰੇ ਅਵਗਾਹਿ ॥",
      "transliteration": "sagal dev haare avagaahi ||",
      "translation": "All the demigods have grown weary of searching for it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਿਤਾ ਕਾ ਜਨਮੁ ਕਿ ਜਾਨੈ ਪੂਤੁ ॥",
      "transliteration": "pitaa kaa janam k jaanai poot ||",
      "translation": "What does the son know of his father's birth?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਗਲ ਪਰੋਈ ਅਪੁਨੈ ਸੂਤਿ ॥",
      "transliteration": "sagal paroee apunai soot ||",
      "translation": "All are strung upon His string.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਮਤਿ ਗਿਆਨੁ ਧਿਆਨੁ ਜਿਨ ਦੇਇ ॥",
      "transliteration": "sumat giaan dhiaan jin dei ||",
      "translation": "He bestows good sense, spiritual wisdom and meditation,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਨ ਦਾਸ ਨਾਮੁ ਧਿਆਵਹਿ ਸੇਇ ॥",
      "transliteration": "jan daas naam dhiaavahi sei ||",
      "translation": "On His humble servants and slaves who meditate on the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਿਹੁ ਗੁਣ ਮਹਿ ਜਾ ਕਉ ਭਰਮਾਏ ॥",
      "transliteration": "tihu gun mahi jaa kau bharamaae ||",
      "translation": "He leads some astray in the three qualities;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਨਮਿ ਮਰੈ ਫਿਰਿ ਆਵੈ ਜਾਏ ॥",
      "transliteration": "janam marai phir aavai jaae ||",
      "translation": "they are born and die, coming and going over and over again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਊਚ ਨੀਚ ਤਿਸ ਕੇ ਅਸਥਾਨ ॥",
      "transliteration": "ooch neech tis ke asathaan ||",
      "translation": "The high and the low are His places.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੈਸਾ ਜਨਾਵੈ ਤੈਸਾ ਨਾਨਕ ਜਾਨ ॥੩॥",
      "transliteration": "jaisaa janaavai taisaa naanak jaan ||3||",
      "translation": "As He inspires us to know Him, O Nanak, so is He known. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਨਾ ਰੂਪ ਨਾਨਾ ਜਾ ਕੇ ਰੰਗ ॥",
      "transliteration": "naanaa roop naanaa jaa ke ra(n)g ||",
      "translation": "Many are His forms; many are His colors.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਨਾ ਭੇਖ ਕਰਹਿ ਇਕ ਰੰਗ ॥",
      "transliteration": "naanaa bhekh karahi ik ra(n)g ||",
      "translation": "Many are the appearances which He assumes, and yet He is still the One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਨਾ ਬਿਧਿ ਕੀਨੋ ਬਿਸਥਾਰੁ ॥",
      "transliteration": "naanaa bidh keeno bisathaar ||",
      "translation": "In so many ways, He has extended Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰਭੁ ਅਬਿਨਾਸੀ ਏਕੰਕਾਰੁ ॥",
      "transliteration": "prabh abinaasee eka(n)kaar ||",
      "translation": "The Eternal Lord God is the One, the Creator.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਨਾ ਚਲਿਤ ਕਰੇ ਖਿਨ ਮਾਹਿ ॥",
      "transliteration": "naanaa chalit kare khin maahi ||",
      "translation": "He performs His many plays in an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੂਰਿ ਰਹਿਓ ਪੂਰਨੁ ਸਭ ਠਾਇ ॥",
      "transliteration": "poor rahio pooran sabh thaai ||",
      "translation": "The Perfect Lord is pervading all places.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਾ ਬਿਧਿ ਕਰਿ ਬਨਤ ਬਨਾਈ ॥",
      "transliteration": "naanaa bidh kar banat banaaee ||",
      "translation": "In so many ways, He created the creation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਪਨੀ ਕੀਮਤਿ ਆਪੇ ਪਾਈ ॥",
      "transliteration": "apanee keemat aape paaee ||",
      "translation": "He alone can estimate His worth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਭ ਘਟ ਤਿਸ ਕੇ ਸਭ ਤਿਸ ਕੇ ਠਾਉ ॥",
      "transliteration": "sabh ghat tis ke sabh tis ke thaau ||",
      "translation": "All hearts are His, and all places are His.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਪਿ ਜਪਿ ਜੀਵੈ ਨਾਨਕ ਹਰਿ ਨਾਉ ॥੪॥",
      "transliteration": "jap jap jeevai naanak har naau ||4||",
      "translation": "Nanak lives by chanting, chanting the Name of the Lord. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਮ ਕੇ ਧਾਰੇ ਸਗਲੇ ਜੰਤ ॥",
      "transliteration": "naam ke dhaare sagale ja(n)t ||",
      "translation": "The Naam is the Support of all creatures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਮ ਕੇ ਧਾਰੇ ਖੰਡ ਬ੍ਰਹਮੰਡ ॥",
      "transliteration": "naam ke dhaare kha(n)d brahama(n)d ||",
      "translation": "The Naam is the Support of the earth and solar systems.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਮ ਕੇ ਧਾਰੇ ਸਿਮ੍ਰਿਤਿ ਬੇਦ ਪੁਰਾਨ ॥",
      "transliteration": "naam ke dhaare simrit bed puraan ||",
      "translation": "The Naam is the Support of the Simritees, the Vedas and the Puraanas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਮ ਕੇ ਧਾਰੇ ਸੁਨਨ ਗਿਆਨ ਧਿਆਨ ॥",
      "transliteration": "naam ke dhaare sunan giaan dhiaan ||",
      "translation": "The Naam is the Support by which we hear of spiritual wisdom and meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਮ ਕੇ ਧਾਰੇ ਆਗਾਸ ਪਾਤਾਲ ॥",
      "transliteration": "naam ke dhaare aagaas paataal ||",
      "translation": "The Naam is the Support of the Akaashic ethers and the nether regions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਮ ਕੇ ਧਾਰੇ ਸਗਲ ਆਕਾਰ ॥",
      "transliteration": "naam ke dhaare sagal aakaar ||",
      "translation": "The Naam is the Support of all bodies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਮ ਕੇ ਧਾਰੇ ਪੁਰੀਆ ਸਭ ਭਵਨ ॥",
      "transliteration": "naam ke dhaare pureeaa sabh bhavan ||",
      "translation": "The Naam is the Support of all worlds and realms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਮ ਕੈ ਸੰਗਿ ਉਧਰੇ ਸੁਨਿ ਸ੍ਰਵਨ ॥",
      "transliteration": "naam kai sa(n)g udhare sun sravan ||",
      "translation": "Associating with the Naam, listening to it with the ears, one is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਆਪਨੈ ਨਾਮਿ ਲਾਏ ॥",
      "transliteration": "kar kirapaa jis aapanai naam laae ||",
      "translation": "Those whom the Lord mercifully attaches to His Naam",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਨਕ ਚਉਥੇ ਪਦ ਮਹਿ ਸੋ ਜਨੁ ਗਤਿ ਪਾਏ ॥੫॥",
      "transliteration": "naanak chauthe pad mahi so jan gat paae ||5||",
      "translation": "- O Nanak, in the fourth state, those humble servants attain salvation. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰੂਪੁ ਸਤਿ ਜਾ ਕਾ ਸਤਿ ਅਸਥਾਨੁ ॥",
      "transliteration": "roop sat jaa kaa sat asathaan ||",
      "translation": "His form is true, and true is His place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪੁਰਖੁ ਸਤਿ ਕੇਵਲ ਪਰਧਾਨੁ ॥",
      "transliteration": "purakh sat keval paradhaan ||",
      "translation": "His personality is true - He alone is supreme.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਰਤੂਤਿ ਸਤਿ ਸਤਿ ਜਾ ਕੀ ਬਾਣੀ ॥",
      "transliteration": "karatoot sat sat jaa kee baanee ||",
      "translation": "His acts are true, and true is His Word.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਤਿ ਪੁਰਖ ਸਭ ਮਾਹਿ ਸਮਾਣੀ ॥",
      "transliteration": "sat purakh sabh maahi samaanee ||",
      "translation": "The True Lord is permeating all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਤਿ ਕਰਮੁ ਜਾ ਕੀ ਰਚਨਾ ਸਤਿ ॥",
      "transliteration": "sat karam jaa kee rachanaa sat ||",
      "translation": "True are His actions; His creation is true.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੂਲੁ ਸਤਿ ਸਤਿ ਉਤਪਤਿ ॥",
      "transliteration": "mool sat sat utapat ||",
      "translation": "His root is true, and true is what originates from it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਤਿ ਕਰਣੀ ਨਿਰਮਲ ਨਿਰਮਲੀ ॥",
      "transliteration": "sat karanee niramal niramalee ||",
      "translation": "True is His lifestyle, the purest of the pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਿਸਹਿ ਬੁਝਾਏ ਤਿਸਹਿ ਸਭ ਭਲੀ ॥",
      "transliteration": "jisahi bujhaae tisahi sabh bhalee ||",
      "translation": "All goes well for those who know Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਤਿ ਨਾਮੁ ਪ੍ਰਭ ਕਾ ਸੁਖਦਾਈ ॥",
      "transliteration": "sat naam prabh kaa sukhadaaee ||",
      "translation": "The True Name of God is the Giver of peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬਿਸ੍ਵਾਸੁ ਸਤਿ ਨਾਨਕ ਗੁਰ ਤੇ ਪਾਈ ॥੬॥",
      "transliteration": "bisvaas sat naanak gur te paaee ||6||",
      "translation": "Nanak has obtained true faith from the Guru. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਤਿ ਬਚਨ ਸਾਧੂ ਉਪਦੇਸ ॥",
      "transliteration": "sat bachan saadhoo upades ||",
      "translation": "True are the Teachings, and the Instructions of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਤਿ ਤੇ ਜਨ ਜਾ ਕੈ ਰਿਦੈ ਪ੍ਰਵੇਸ ॥",
      "transliteration": "sat te jan jaa kai ridai praves ||",
      "translation": "True are those into whose hearts He enters.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਤਿ ਨਿਰਤਿ ਬੂਝੈ ਜੇ ਕੋਇ ॥",
      "transliteration": "sat nirat boojhai je koi ||",
      "translation": "One who knows and loves the Truth",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਤਾ ਕੀ ਗਤਿ ਹੋਇ ॥",
      "transliteration": "naam japat taa kee gat hoi ||",
      "translation": "chanting the Naam, he obtains salvation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਆਪਿ ਸਤਿ ਕੀਆ ਸਭੁ ਸਤਿ ॥",
      "transliteration": "aap sat keeaa sabh sat ||",
      "translation": "He Himself is True, and all that He has made is true.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0284_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਆਪੇ ਜਾਨੈ ਅਪਨੀ ਮਿਤਿ ਗਤਿ ॥",
      "transliteration": "aape jaanai apanee mit gat ||",
      "translation": "He Himself knows His own state and condition.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 284,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
