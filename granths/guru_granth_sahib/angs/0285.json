{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 285,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0285_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਸ ਕੀ ਸ੍ਰਿਸਟਿ ਸੁ ਕਰਣੈਹਾਰੁ ॥",
      "transliteration": "jis kee srisat s karanaihaar ||",
      "translation": "He is the Creator Lord of His world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਵਰ ਨ ਬੂਝਿ ਕਰਤ ਬੀਚਾਰੁ ॥",
      "transliteration": "avar na boojh karat beechaar ||",
      "translation": "No one else understands Him, although they may try.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਰਤੇ ਕੀ ਮਿਤਿ ਨ ਜਾਨੈ ਕੀਆ ॥",
      "transliteration": "karate kee mit na jaanai keeaa ||",
      "translation": "The created cannot know the extent of the Creator.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਨਕ ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੋ ਵਰਤੀਆ ॥੭॥",
      "transliteration": "naanak jo tis bhaavai so varateeaa ||7||",
      "translation": "O Nanak, whatever pleases Him comes to pass. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਿਸਮਨ ਬਿਸਮ ਭਏ ਬਿਸਮਾਦ ॥",
      "transliteration": "bisaman bisam bhae bisamaad ||",
      "translation": "Gazing upon His wondrous wonder, I am wonder-struck and amazed!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਿਨਿ ਬੂਝਿਆ ਤਿਸੁ ਆਇਆ ਸ੍ਵਾਦ ॥",
      "transliteration": "jin boojhiaa tis aaiaa svaad ||",
      "translation": "One who realizes this, comes to taste this state of joy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਰੰਗਿ ਰਾਚਿ ਜਨ ਰਹੇ ॥",
      "transliteration": "prabh kai ra(n)g raach jan rahe ||",
      "translation": "God's humble servants remain absorbed in His Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰ ਕੈ ਬਚਨਿ ਪਦਾਰਥ ਲਹੇ ॥",
      "transliteration": "gur kai bachan padaarath lahe ||",
      "translation": "Following the Guru's Teachings, they receive the four cardinal blessings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਓਇ ਦਾਤੇ ਦੁਖ ਕਾਟਨਹਾਰ ॥",
      "transliteration": "oi daate dukh kaatanahaar ||",
      "translation": "They are the givers, the dispellers of pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾ ਕੈ ਸੰਗਿ ਤਰੈ ਸੰਸਾਰ ॥",
      "transliteration": "jaa kai sa(n)g tarai sa(n)saar ||",
      "translation": "In their company, the world is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਨ ਕਾ ਸੇਵਕੁ ਸੋ ਵਡਭਾਗੀ ॥",
      "transliteration": "jan kaa sevak so vadabhaagee ||",
      "translation": "The slave of the Lord's servant is so very blessed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਨ ਕੈ ਸੰਗਿ ਏਕ ਲਿਵ ਲਾਗੀ ॥",
      "transliteration": "jan kai sa(n)g ek liv laagee ||",
      "translation": "In the company of His servant, one becomes attached to the Love of the One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੁਨ ਗੋਬਿਦ ਕੀਰਤਨੁ ਜਨੁ ਗਾਵੈ ॥",
      "transliteration": "gun gobid keeratan jan gaavai ||",
      "translation": "His humble servant sings the Kirtan, the songs of the glory of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਨਾਨਕ ਫਲੁ ਪਾਵੈ ॥੮॥੧੬॥",
      "transliteration": "gur prasaad naanak phal paavai ||8||16||",
      "translation": "By Guru's Grace, O Nanak, he receives the fruits of his rewards. ||8||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਆਦਿ ਸਚੁ ਜੁਗਾਦਿ ਸਚੁ ॥",
      "transliteration": "aad sach jugaad sach ||",
      "translation": "True in the beginning, True throughout the ages,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹੈ ਭਿ ਸਚੁ ਨਾਨਕ ਹੋਸੀ ਭਿ ਸਚੁ ॥੧॥",
      "transliteration": "hai bh sach naanak hosee bh sach ||1||",
      "translation": "True here and now. O Nanak, He shall forever be True. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚਰਨ ਸਤਿ ਸਤਿ ਪਰਸਨਹਾਰ ॥",
      "transliteration": "charan sat sat parasanahaar ||",
      "translation": "His Lotus Feet are True, and True are those who touch Them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪੂਜਾ ਸਤਿ ਸਤਿ ਸੇਵਦਾਰ ॥",
      "transliteration": "poojaa sat sat sevadaar ||",
      "translation": "His devotional worship is True, and True are those who worship Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦਰਸਨੁ ਸਤਿ ਸਤਿ ਪੇਖਨਹਾਰ ॥",
      "transliteration": "darasan sat sat pekhanahaar ||",
      "translation": "The Blessing of His Vision is True, and True are those who behold it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਮੁ ਸਤਿ ਸਤਿ ਧਿਆਵਨਹਾਰ ॥",
      "transliteration": "naam sat sat dhiaavanahaar ||",
      "translation": "His Naam is True, and True are those who meditate on it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਪਿ ਸਤਿ ਸਤਿ ਸਭ ਧਾਰੀ ॥",
      "transliteration": "aap sat sat sabh dhaaree ||",
      "translation": "He Himself is True, and True is all that He sustains.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਪੇ ਗੁਣ ਆਪੇ ਗੁਣਕਾਰੀ ॥",
      "transliteration": "aape gun aape gunakaaree ||",
      "translation": "He Himself is virtuous goodness, and He Himself is the Bestower of virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਬਦੁ ਸਤਿ ਸਤਿ ਪ੍ਰਭੁ ਬਕਤਾ ॥",
      "transliteration": "sabad sat sat prabh bakataa ||",
      "translation": "The Word of His Shabad is True, and True are those who speak of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੁਰਤਿ ਸਤਿ ਸਤਿ ਜਸੁ ਸੁਨਤਾ ॥",
      "transliteration": "surat sat sat jas sunataa ||",
      "translation": "Those ears are True, and True are those who listen to His Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬੁਝਨਹਾਰ ਕਉ ਸਤਿ ਸਭ ਹੋਇ ॥",
      "transliteration": "bujhanahaar kau sat sabh hoi ||",
      "translation": "All is True to one who understands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਸਤਿ ਸਤਿ ਪ੍ਰਭੁ ਸੋਇ ॥੧॥",
      "transliteration": "naanak sat sat prabh soi ||1||",
      "translation": "O Nanak, True, True is He, the Lord God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਤਿ ਸਰੂਪੁ ਰਿਦੈ ਜਿਨਿ ਮਾਨਿਆ ॥",
      "transliteration": "sat saroop ridai jin maaniaa ||",
      "translation": "One who believes in the Embodiment of Truth with all his heart",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਤਿਨਿ ਮੂਲੁ ਪਛਾਨਿਆ ॥",
      "transliteration": "karan karaavan tin mool pachhaaniaa ||",
      "translation": "recognizes the Cause of causes as the Root of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾ ਕੈ ਰਿਦੈ ਬਿਸ੍ਵਾਸੁ ਪ੍ਰਭ ਆਇਆ ॥",
      "transliteration": "jaa kai ridai bisvaas prabh aaiaa ||",
      "translation": "One whose heart is filled with faith in God",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਤੁ ਗਿਆਨੁ ਤਿਸੁ ਮਨਿ ਪ੍ਰਗਟਾਇਆ ॥",
      "transliteration": "tat giaan tis man pragataaiaa ||",
      "translation": "the essence of spiritual wisdom is revealed to his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭੈ ਤੇ ਨਿਰਭਉ ਹੋਇ ਬਸਾਨਾ ॥",
      "transliteration": "bhai te nirabhau hoi basaanaa ||",
      "translation": "Coming out of fear, he comes to live without fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਿਸ ਤੇ ਉਪਜਿਆ ਤਿਸੁ ਮਾਹਿ ਸਮਾਨਾ ॥",
      "transliteration": "jis te upajiaa tis maahi samaanaa ||",
      "translation": "He is absorbed into the One, from whom he originated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਸਤੁ ਮਾਹਿ ਲੇ ਬਸਤੁ ਗਡਾਈ ॥",
      "transliteration": "basat maahi le basat gadaaee ||",
      "translation": "When something blends with its own,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਾ ਕਉ ਭਿੰਨ ਨ ਕਹਨਾ ਜਾਈ ॥",
      "transliteration": "taa kau bhi(n)n na kahanaa jaaee ||",
      "translation": "it cannot be said to be separate from it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬੂਝੈ ਬੂਝਨਹਾਰੁ ਬਿਬੇਕ ॥",
      "transliteration": "boojhai boojhanahaar bibek ||",
      "translation": "This is understood only by one of discerning understanding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਰਾਇਨ ਮਿਲੇ ਨਾਨਕ ਏਕ ॥੨॥",
      "transliteration": "naaraain mile naanak ek ||2||",
      "translation": "Meeting with the Lord, O Nanak, he becomes one with Him. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਠਾਕੁਰ ਕਾ ਸੇਵਕੁ ਆਗਿਆਕਾਰੀ ॥",
      "transliteration": "thaakur kaa sevak aagiaakaaree ||",
      "translation": "The servant is obedient to his Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਠਾਕੁਰ ਕਾ ਸੇਵਕੁ ਸਦਾ ਪੂਜਾਰੀ ॥",
      "transliteration": "thaakur kaa sevak sadaa poojaaree ||",
      "translation": "The servant worships his Lord and Master forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਠਾਕੁਰ ਕੇ ਸੇਵਕ ਕੈ ਮਨਿ ਪਰਤੀਤਿ ॥",
      "transliteration": "thaakur ke sevak kai man parateet ||",
      "translation": "The servant of the Lord Master has faith in his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਠਾਕੁਰ ਕੇ ਸੇਵਕ ਕੀ ਨਿਰਮਲ ਰੀਤਿ ॥",
      "transliteration": "thaakur ke sevak kee niramal reet ||",
      "translation": "The servant of the Lord Master lives a pure lifestyle.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਠਾਕੁਰ ਕਉ ਸੇਵਕੁ ਜਾਨੈ ਸੰਗਿ ॥",
      "transliteration": "thaakur kau sevak jaanai sa(n)g ||",
      "translation": "The servant of the Lord Master knows that the Lord is with him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪ੍ਰਭ ਕਾ ਸੇਵਕੁ ਨਾਮ ਕੈ ਰੰਗਿ ॥",
      "transliteration": "prabh kaa sevak naam kai ra(n)g ||",
      "translation": "God's servant is attuned to the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੇਵਕ ਕਉ ਪ੍ਰਭ ਪਾਲਨਹਾਰਾ ॥",
      "transliteration": "sevak kau prabh paalanahaaraa ||",
      "translation": "God is the Cherisher of His servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੇਵਕ ਕੀ ਰਾਖੈ ਨਿਰੰਕਾਰਾ ॥",
      "transliteration": "sevak kee raakhai nira(n)kaaraa ||",
      "translation": "The Formless Lord preserves His servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੋ ਸੇਵਕੁ ਜਿਸੁ ਦਇਆ ਪ੍ਰਭੁ ਧਾਰੈ ॥",
      "transliteration": "so sevak jis daiaa prabh dhaarai ||",
      "translation": "Unto His servant, God bestows His Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਨਕ ਸੋ ਸੇਵਕੁ ਸਾਸਿ ਸਾਸਿ ਸਮਾਰੈ ॥੩॥",
      "transliteration": "naanak so sevak saas saas samaarai ||3||",
      "translation": "O Nanak, that servant remembers Him with each and every breath. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਪੁਨੇ ਜਨ ਕਾ ਪਰਦਾ ਢਾਕੈ ॥",
      "transliteration": "apune jan kaa paradaa dhaakai ||",
      "translation": "He covers the faults of His servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਅਪਨੇ ਸੇਵਕ ਕੀ ਸਰਪਰ ਰਾਖੈ ॥",
      "transliteration": "apane sevak kee sarapar raakhai ||",
      "translation": "He surely preserves the honor of His servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਪਨੇ ਦਾਸ ਕਉ ਦੇਇ ਵਡਾਈ ॥",
      "transliteration": "apane daas kau dei vadaaee ||",
      "translation": "He blesses His slave with greatness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਪਨੇ ਸੇਵਕ ਕਉ ਨਾਮੁ ਜਪਾਈ ॥",
      "transliteration": "apane sevak kau naam japaaee ||",
      "translation": "He inspires His servant to chant the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅਪਨੇ ਸੇਵਕ ਕੀ ਆਪਿ ਪਤਿ ਰਾਖੈ ॥",
      "transliteration": "apane sevak kee aap pat raakhai ||",
      "translation": "He Himself preserves the honor of His servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਾ ਕੀ ਗਤਿ ਮਿਤਿ ਕੋਇ ਨ ਲਾਖੈ ॥",
      "transliteration": "taa kee gat mit koi na laakhai ||",
      "translation": "No one knows His state and extent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪ੍ਰਭ ਕੇ ਸੇਵਕ ਕਉ ਕੋ ਨ ਪਹੂਚੈ ॥",
      "transliteration": "prabh ke sevak kau ko na pahoochai ||",
      "translation": "No one is equal to the servant of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਪ੍ਰਭ ਕੇ ਸੇਵਕ ਊਚ ਤੇ ਊਚੇ ॥",
      "transliteration": "prabh ke sevak ooch te ooche ||",
      "translation": "The servant of God is the highest of the high.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜੋ ਪ੍ਰਭਿ ਅਪਨੀ ਸੇਵਾ ਲਾਇਆ ॥",
      "transliteration": "jo prabh apanee sevaa laaiaa ||",
      "translation": "One whom God applies to His own service, O Nanak",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਨਾਨਕ ਸੋ ਸੇਵਕੁ ਦਹ ਦਿਸਿ ਪ੍ਰਗਟਾਇਆ ॥੪॥",
      "transliteration": "naanak so sevak dah dis pragataaiaa ||4||",
      "translation": "- that servant is famous in the ten directions. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਨੀਕੀ ਕੀਰੀ ਮਹਿ ਕਲ ਰਾਖੈ ॥",
      "transliteration": "neekee keeree mahi kal raakhai ||",
      "translation": "He infuses His Power into the tiny ant;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਭਸਮ ਕਰੈ ਲਸਕਰ ਕੋਟਿ ਲਾਖੈ ॥",
      "transliteration": "bhasam karai lasakar kot laakhai ||",
      "translation": "it can then reduce the armies of millions to ashes",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0285_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਜਿਸ ਕਾ ਸਾਸੁ ਨ ਕਾਢਤ ਆਪਿ ॥",
      "transliteration": "jis kaa saas na kaadhat aap ||",
      "translation": "Those whose breath of life He Himself does not take away",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 285,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
