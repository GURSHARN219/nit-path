{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 286,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0286_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਾ ਕਉ ਰਾਖਤ ਦੇ ਕਰਿ ਹਾਥ ॥",
      "transliteration": "taa kau raakhat de kar haath ||",
      "translation": "He preserves them, and holds out His Hands to protect them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਾਨਸ ਜਤਨ ਕਰਤ ਬਹੁ ਭਾਤਿ ॥",
      "transliteration": "maanas jatan karat bahu bhaat ||",
      "translation": "You may make all sorts of efforts,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਿਸ ਕੇ ਕਰਤਬ ਬਿਰਥੇ ਜਾਤਿ ॥",
      "transliteration": "tis ke karatab birathe jaat ||",
      "translation": "but these attempts are in vain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਾਰੈ ਨ ਰਾਖੈ ਅਵਰੁ ਨ ਕੋਇ ॥",
      "transliteration": "maarai na raakhai avar na koi ||",
      "translation": "No one else can kill or preserve",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਰਬ ਜੀਆ ਕਾ ਰਾਖਾ ਸੋਇ ॥",
      "transliteration": "sarab jeeaa kaa raakhaa soi ||",
      "translation": "He is the Protector of all beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਹੇ ਸੋਚ ਕਰਹਿ ਰੇ ਪ੍ਰਾਣੀ ॥",
      "transliteration": "kaahe soch karahi re praanee ||",
      "translation": "So why are you so anxious, O mortal?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਪਿ ਨਾਨਕ ਪ੍ਰਭ ਅਲਖ ਵਿਡਾਣੀ ॥੫॥",
      "transliteration": "jap naanak prabh alakh vidaanee ||5||",
      "translation": "Meditate, O Nanak, on God, the invisible, the wonderful! ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਾਰੰ ਬਾਰ ਬਾਰ ਪ੍ਰਭੁ ਜਪੀਐ ॥",
      "transliteration": "baara(n) baar baar prabh japeeai ||",
      "translation": "Time after time, again and again, meditate on God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪੀ ਅੰਮ੍ਰਿਤੁ ਇਹੁ ਮਨੁ ਤਨੁ ਧ੍ਰਪੀਐ ॥",
      "transliteration": "pee a(n)mrit ihu man tan dhrapeeai ||",
      "translation": "Drinking in this Nectar, this mind and body are satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਮ ਰਤਨੁ ਜਿਨਿ ਗੁਰਮੁਖਿ ਪਾਇਆ ॥",
      "transliteration": "naam ratan jin guramukh paaiaa ||",
      "translation": "The jewel of the Naam is obtained by the Gurmukhs;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਿਸੁ ਕਿਛੁ ਅਵਰੁ ਨਾਹੀ ਦ੍ਰਿਸਟਾਇਆ ॥",
      "transliteration": "tis kichh avar naahee drisataaiaa ||",
      "translation": "they see no other than God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਮੁ ਧਨੁ ਨਾਮੋ ਰੂਪੁ ਰੰਗੁ ॥",
      "transliteration": "naam dhan naamo roop ra(n)g ||",
      "translation": "Unto them, the Naam is wealth, the Naam is beauty and delight.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਮੋ ਸੁਖੁ ਹਰਿ ਨਾਮ ਕਾ ਸੰਗੁ ॥",
      "transliteration": "naamo sukh har naam kaa sa(n)g ||",
      "translation": "The Naam is peace, the Lord's Name is their companion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਮ ਰਸਿ ਜੋ ਜਨ ਤ੍ਰਿਪਤਾਨੇ ॥",
      "transliteration": "naam ras jo jan tripataane ||",
      "translation": "Those who are satisfied by the essence of the Naam",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਨ ਤਨ ਨਾਮਹਿ ਨਾਮਿ ਸਮਾਨੇ ॥",
      "transliteration": "man tan naamahi naam samaane ||",
      "translation": "their minds and bodies are drenched with the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਊਠਤ ਬੈਠਤ ਸੋਵਤ ਨਾਮ ॥",
      "transliteration": "oothat baithat sovat naam ||",
      "translation": "While standing up, sitting down and sleeping, the Naam,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਨ ਕੈ ਸਦ ਕਾਮ ॥੬॥",
      "transliteration": "kahu naanak jan kai sad kaam ||6||",
      "translation": "says Nanak, is forever the occupation of God's humble servant. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬੋਲਹੁ ਜਸੁ ਜਿਹਬਾ ਦਿਨੁ ਰਾਤਿ ॥",
      "transliteration": "bolahu jas jihabaa din raat ||",
      "translation": "Chant His Praises with your tongue, day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪ੍ਰਭਿ ਅਪਨੈ ਜਨ ਕੀਨੀ ਦਾਤਿ ॥",
      "transliteration": "prabh apanai jan keenee daat ||",
      "translation": "God Himself has given this gift to His servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਰਹਿ ਭਗਤਿ ਆਤਮ ਕੈ ਚਾਇ ॥",
      "transliteration": "karahi bhagat aatam kai chaai ||",
      "translation": "Performing devotional worship with heart-felt love,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪ੍ਰਭ ਅਪਨੇ ਸਿਉ ਰਹਹਿ ਸਮਾਇ ॥",
      "transliteration": "prabh apane siu rahahi samaai ||",
      "translation": "they remain absorbed in God Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੋ ਹੋਆ ਹੋਵਤ ਸੋ ਜਾਨੈ ॥",
      "transliteration": "jo hoaa hovat so jaanai ||",
      "translation": "They know the past and the present.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪ੍ਰਭ ਅਪਨੇ ਕਾ ਹੁਕਮੁ ਪਛਾਨੈ ॥",
      "transliteration": "prabh apane kaa hukam pachhaanai ||",
      "translation": "They recognize God's Own Command.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਸ ਕੀ ਮਹਿਮਾ ਕਉਨ ਬਖਾਨਉ ॥",
      "transliteration": "tis kee mahimaa kaun bakhaanau ||",
      "translation": "Who can describe His Glory?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਸ ਕਾ ਗੁਨੁ ਕਹਿ ਏਕ ਨ ਜਾਨਉ ॥",
      "transliteration": "tis kaa gun kahi ek na jaanau ||",
      "translation": "I cannot describe even one of His virtuous qualities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਠ ਪਹਰ ਪ੍ਰਭ ਬਸਹਿ ਹਜੂਰੇ ॥",
      "transliteration": "aath pahar prabh basahi hajoore ||",
      "translation": "Those who dwell in God's Presence, twenty-four hours a day",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਸੇਈ ਜਨ ਪੂਰੇ ॥੭॥",
      "transliteration": "kahu naanak seee jan poore ||7||",
      "translation": "- says Nanak, they are the perfect persons. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਨ ਮੇਰੇ ਤਿਨ ਕੀ ਓਟ ਲੇਹਿ ॥",
      "transliteration": "man mere tin kee ot lehi ||",
      "translation": "O my mind, seek their protection;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਅਪਨਾ ਤਿਨ ਜਨ ਦੇਹਿ ॥",
      "transliteration": "man tan apanaa tin jan dehi ||",
      "translation": "give your mind and body to those humble beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਨਿ ਜਨਿ ਅਪਨਾ ਪ੍ਰਭੂ ਪਛਾਤਾ ॥",
      "transliteration": "jin jan apanaa prabhoo pachhaataa ||",
      "translation": "Those humble beings who recognizes God",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੋ ਜਨੁ ਸਰਬ ਥੋਕ ਕਾ ਦਾਤਾ ॥",
      "transliteration": "so jan sarab thok kaa daataa ||",
      "translation": "are the givers of all things.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਿਸ ਕੀ ਸਰਨਿ ਸਰਬ ਸੁਖ ਪਾਵਹਿ ॥",
      "transliteration": "tis kee saran sarab sukh paavahi ||",
      "translation": "In His Sanctuary, all comforts are obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਿਸ ਕੈ ਦਰਸਿ ਸਭ ਪਾਪ ਮਿਟਾਵਹਿ ॥",
      "transliteration": "tis kai daras sabh paap mitaavahi ||",
      "translation": "By the Blessing of His Darshan, all sins are erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਵਰ ਸਿਆਨਪ ਸਗਲੀ ਛਾਡੁ ॥",
      "transliteration": "avar siaanap sagalee chhaad ||",
      "translation": "So renounce all other clever devices,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਕੀ ਤੂ ਸੇਵਾ ਲਾਗੁ ॥",
      "transliteration": "tis jan kee too sevaa laag ||",
      "translation": "and enjoin yourself to the service of those servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਵਨੁ ਜਾਨੁ ਨ ਹੋਵੀ ਤੇਰਾ ॥",
      "transliteration": "aavan jaan na hovee teraa ||",
      "translation": "Your comings and goings shall be ended.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕ ਤਿਸੁ ਜਨ ਕੇ ਪੂਜਹੁ ਸਦ ਪੈਰਾ ॥੮॥੧੭॥",
      "transliteration": "naanak tis jan ke poojahu sad pairaa ||8||17||",
      "translation": "O Nanak, worship the feet of God's humble servants forever. ||8||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਤਿ ਪੁਰਖੁ ਜਿਨਿ ਜਾਨਿਆ ਸਤਿਗੁਰੁ ਤਿਸ ਕਾ ਨਾਉ ॥",
      "transliteration": "sat purakh jin jaaniaa satigur tis kaa naau ||",
      "translation": "The one who knows the True Lord God, is called the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਿਸ ਕੈ ਸੰਗਿ ਸਿਖੁ ਉਧਰੈ ਨਾਨਕ ਹਰਿ ਗੁਨ ਗਾਉ ॥੧॥",
      "transliteration": "tis kai sa(n)g sikh udharai naanak har gun gaau ||1||",
      "translation": "In His Company, the Sikh is saved, O Nanak, singing the Glorious Praises of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸਿਖ ਕੀ ਕਰੈ ਪ੍ਰਤਿਪਾਲ ॥",
      "transliteration": "satigur sikh kee karai pratipaal ||",
      "translation": "The True Guru cherishes His Sikh.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੇਵਕ ਕਉ ਗੁਰੁ ਸਦਾ ਦਇਆਲ ॥",
      "transliteration": "sevak kau gur sadaa daiaal ||",
      "translation": "The Guru is always merciful to His servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਿਖ ਕੀ ਗੁਰੁ ਦੁਰਮਤਿ ਮਲੁ ਹਿਰੈ ॥",
      "transliteration": "sikh kee gur duramat mal hirai ||",
      "translation": "The Guru washes away the filth of the evil intellect of His Sikh.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰ ਬਚਨੀ ਹਰਿ ਨਾਮੁ ਉਚਰੈ ॥",
      "transliteration": "gur bachanee har naam ucharai ||",
      "translation": "Through the Guru's Teachings, he chants the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸਿਖ ਕੇ ਬੰਧਨ ਕਾਟੈ ॥",
      "transliteration": "satigur sikh ke ba(n)dhan kaatai ||",
      "translation": "The True Guru cuts away the bonds of His Sikh.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਿਖੁ ਬਿਕਾਰ ਤੇ ਹਾਟੈ ॥",
      "transliteration": "gur kaa sikh bikaar te haatai ||",
      "translation": "The Sikh of the Guru abstains from evil deeds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸਿਖ ਕਉ ਨਾਮ ਧਨੁ ਦੇਇ ॥",
      "transliteration": "satigur sikh kau naam dhan dei ||",
      "translation": "The True Guru gives His Sikh the wealth of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਿਖੁ ਵਡਭਾਗੀ ਹੇ ॥",
      "transliteration": "gur kaa sikh vadabhaagee he ||",
      "translation": "The Sikh of the Guru is very fortunate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸਿਖ ਕਾ ਹਲਤੁ ਪਲਤੁ ਸਵਾਰੈ ॥",
      "transliteration": "satigur sikh kaa halat palat savaarai ||",
      "translation": "The True Guru arranges this world and the next for His Sikh.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਾਨਕ ਸਤਿਗੁਰੁ ਸਿਖ ਕਉ ਜੀਅ ਨਾਲਿ ਸਮਾਰੈ ॥੧॥",
      "transliteration": "naanak satigur sikh kau jee naal samaarai ||1||",
      "translation": "O Nanak, with the fullness of His heart, the True Guru mends His Sikh. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰ ਕੈ ਗ੍ਰਿਹਿ ਸੇਵਕੁ ਜੋ ਰਹੈ ॥",
      "transliteration": "gur kai grihi sevak jo rahai ||",
      "translation": "That selfless servant, who lives in the Guru's household,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰ ਕੀ ਆਗਿਆ ਮਨ ਮਹਿ ਸਹੈ ॥",
      "transliteration": "gur kee aagiaa man mahi sahai ||",
      "translation": "is to obey the Guru's Commands with all his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਆਪਸ ਕਉ ਕਰਿ ਕਛੁ ਨ ਜਨਾਵੈ ॥",
      "transliteration": "aapas kau kar kachh na janaavai ||",
      "translation": "He is not to call attention to himself in any way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਰਿਦੈ ਸਦ ਧਿਆਵੈ ॥",
      "transliteration": "har har naam ridai sad dhiaavai ||",
      "translation": "He is to meditate constantly within his heart on the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਮਨੁ ਬੇਚੈ ਸਤਿਗੁਰ ਕੈ ਪਾਸਿ ॥",
      "transliteration": "man bechai satigur kai paas ||",
      "translation": "One who sells his mind to the True Guru",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਿਸੁ ਸੇਵਕ ਕੇ ਕਾਰਜ ਰਾਸਿ ॥",
      "transliteration": "tis sevak ke kaaraj raas ||",
      "translation": "- that humble servant's affairs are resolved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸੇਵਾ ਕਰਤ ਹੋਇ ਨਿਹਕਾਮੀ ॥",
      "transliteration": "sevaa karat hoi nihakaamee ||",
      "translation": "One who performs selfless service, without thought of reward,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0286_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਤਿਸ ਕਉ ਹੋਤ ਪਰਾਪਤਿ ਸੁਆਮੀ ॥",
      "transliteration": "tis kau hot paraapat suaamee ||",
      "translation": "shall attain his Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 286,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
