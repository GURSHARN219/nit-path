{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 287,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0287_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਪਨੀ ਕ੍ਰਿਪਾ ਜਿਸੁ ਆਪਿ ਕਰੇਇ ॥",
      "transliteration": "apanee kripaa jis aap karei ||",
      "translation": "He Himself grants His Grace;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਨਕ ਸੋ ਸੇਵਕੁ ਗੁਰ ਕੀ ਮਤਿ ਲੇਇ ॥੨॥",
      "transliteration": "naanak so sevak gur kee mat lei ||2||",
      "translation": "O Nanak, that selfless servant lives the Guru's Teachings. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬੀਸ ਬਿਸਵੇ ਗੁਰ ਕਾ ਮਨੁ ਮਾਨੈ ॥",
      "transliteration": "bees bisave gur kaa man maanai ||",
      "translation": "One who obeys the Guru's Teachings one hundred per cent",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੋ ਸੇਵਕੁ ਪਰਮੇਸੁਰ ਕੀ ਗਤਿ ਜਾਨੈ ॥",
      "transliteration": "so sevak paramesur kee gat jaanai ||",
      "translation": "that selfless servant comes to know the state of the Transcendent Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੋ ਸਤਿਗੁਰੁ ਜਿਸੁ ਰਿਦੈ ਹਰਿ ਨਾਉ ॥",
      "transliteration": "so satigur jis ridai har naau ||",
      "translation": "The True Guru's Heart is filled with the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਨਿਕ ਬਾਰ ਗੁਰ ਕਉ ਬਲਿ ਜਾਉ ॥",
      "transliteration": "anik baar gur kau bal jaau ||",
      "translation": "So many times, I am a sacrifice to the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਰਬ ਨਿਧਾਨ ਜੀਅ ਕਾ ਦਾਤਾ ॥",
      "transliteration": "sarab nidhaan jee kaa daataa ||",
      "translation": "He is the treasure of everything, the Giver of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਠ ਪਹਰ ਪਾਰਬ੍ਰਹਮ ਰੰਗਿ ਰਾਤਾ ॥",
      "transliteration": "aath pahar paarabraham ra(n)g raataa ||",
      "translation": "Twenty-four hours a day, He is imbued with the Love of the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬ੍ਰਹਮ ਮਹਿ ਜਨੁ ਜਨ ਮਹਿ ਪਾਰਬ੍ਰਹਮੁ ॥",
      "transliteration": "braham mahi jan jan mahi paarabraham ||",
      "translation": "The servant is in God, and God is in the servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਏਕਹਿ ਆਪਿ ਨਹੀ ਕਛੁ ਭਰਮੁ ॥",
      "transliteration": "ekahi aap nahee kachh bharam ||",
      "translation": "He Himself is One - there is no doubt about this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਹਸ ਸਿਆਨਪ ਲਇਆ ਨ ਜਾਈਐ ॥",
      "transliteration": "sahas siaanap laiaa na jaaeeai ||",
      "translation": "By thousands of clever tricks, He is not found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਨਕ ਐਸਾ ਗੁਰੁ ਬਡਭਾਗੀ ਪਾਈਐ ॥੩॥",
      "transliteration": "naanak aisaa gur badabhaagee paaeeai ||3||",
      "translation": "O Nanak, such a Guru is obtained by the greatest good fortune. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਫਲ ਦਰਸਨੁ ਪੇਖਤ ਪੁਨੀਤ ॥",
      "transliteration": "saphal darasan pekhat puneet ||",
      "translation": "Blessed is His Darshan; receiving it, one is purified.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਰਸਤ ਚਰਨ ਗਤਿ ਨਿਰਮਲ ਰੀਤਿ ॥",
      "transliteration": "parasat charan gat niramal reet ||",
      "translation": "Touching His Feet, one's conduct and lifestyle become pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭੇਟਤ ਸੰਗਿ ਰਾਮ ਗੁਨ ਰਵੇ ॥",
      "transliteration": "bhetat sa(n)g raam gun rave ||",
      "translation": "Abiding in His Company, one chants the Lord's Praise,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕੀ ਦਰਗਹ ਗਵੇ ॥",
      "transliteration": "paarabraham kee daragah gave ||",
      "translation": "and reaches the Court of the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਨਿ ਕਰਿ ਬਚਨ ਕਰਨ ਆਘਾਨੇ ॥",
      "transliteration": "sun kar bachan karan aaghaane ||",
      "translation": "Listening to His Teachings, one's ears are satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਨਿ ਸੰਤੋਖੁ ਆਤਮ ਪਤੀਆਨੇ ॥",
      "transliteration": "man sa(n)tokh aatam pateeaane ||",
      "translation": "The mind is contented, and the soul is fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪੂਰਾ ਗੁਰੁ ਅਖੵਓ ਜਾ ਕਾ ਮੰਤ੍ਰ ॥",
      "transliteration": "pooraa gur akhyo jaa kaa ma(n)tr ||",
      "translation": "The Guru is perfect; His Teachings are everlasting.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਦ੍ਰਿਸਟਿ ਪੇਖੈ ਹੋਇ ਸੰਤ ॥",
      "transliteration": "a(n)mrit drisat pekhai hoi sa(n)t ||",
      "translation": "Beholding His Ambrosial Glance, one becomes saintly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਣ ਬਿਅੰਤ ਕੀਮਤਿ ਨਹੀ ਪਾਇ ॥",
      "transliteration": "gun bia(n)t keemat nahee paai ||",
      "translation": "Endless are His virtuous qualities; His worth cannot be appraised.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਨਕ ਜਿਸੁ ਭਾਵੈ ਤਿਸੁ ਲਏ ਮਿਲਾਇ ॥੪॥",
      "transliteration": "naanak jis bhaavai tis lae milaai ||4||",
      "translation": "O Nanak, one who pleases Him is united with Him. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਿਹਬਾ ਏਕ ਉਸਤਤਿ ਅਨੇਕ ॥",
      "transliteration": "jihabaa ek usatat anek ||",
      "translation": "The tongue is one, but His Praises are many.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਤਿ ਪੁਰਖ ਪੂਰਨ ਬਿਬੇਕ ॥",
      "transliteration": "sat purakh pooran bibek ||",
      "translation": "The True Lord, of perfect perfection",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਾਹੂ ਬੋਲ ਨ ਪਹੁਚਤ ਪ੍ਰਾਨੀ ॥",
      "transliteration": "kaahoo bol na pahuchat praanee ||",
      "translation": "- no speech can take the mortal to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਗਮ ਅਗੋਚਰ ਪ੍ਰਭ ਨਿਰਬਾਨੀ ॥",
      "transliteration": "agam agochar prabh nirabaanee ||",
      "translation": "God is Inaccessible, Incomprehensible, balanced in the state of Nirvaanaa.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਿਰਾਹਾਰ ਨਿਰਵੈਰ ਸੁਖਦਾਈ ॥",
      "transliteration": "niraahaar niravair sukhadaaee ||",
      "translation": "He is not sustained by food; He has no hatred or vengeance; He is the Giver of peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਾ ਕੀ ਕੀਮਤਿ ਕਿਨੈ ਨ ਪਾਈ ॥",
      "transliteration": "taa kee keemat kinai na paaee ||",
      "translation": "No one can estimate His worth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਨਿਕ ਭਗਤ ਬੰਦਨ ਨਿਤ ਕਰਹਿ ॥",
      "transliteration": "anik bhagat ba(n)dan nit karahi ||",
      "translation": "Countless devotees continually bow in reverence to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਹਿਰਦੈ ਸਿਮਰਹਿ ॥",
      "transliteration": "charan kamal hiradai simarahi ||",
      "translation": "In their hearts, they meditate on His Lotus Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਦ ਬਲਿਹਾਰੀ ਸਤਿਗੁਰ ਅਪਨੇ ॥",
      "transliteration": "sad balihaaree satigur apane ||",
      "translation": "Nanak is forever a sacrifice to the True Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਨਕ ਜਿਸੁ ਪ੍ਰਸਾਦਿ ਐਸਾ ਪ੍ਰਭੁ ਜਪਨੇ ॥੫॥",
      "transliteration": "naanak jis prasaad aisaa prabh japane ||5||",
      "translation": "by His Grace, he meditates on God. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਹੁ ਹਰਿ ਰਸੁ ਪਾਵੈ ਜਨੁ ਕੋਇ ॥",
      "transliteration": "ihu har ras paavai jan koi ||",
      "translation": "Only a few obtain this ambrosial essence of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਪੀਵੈ ਅਮਰੁ ਸੋ ਹੋਇ ॥",
      "transliteration": "a(n)mrit peevai amar so hoi ||",
      "translation": "Drinking in this Nectar, one becomes immortal.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਉਸੁ ਪੁਰਖ ਕਾ ਨਾਹੀ ਕਦੇ ਬਿਨਾਸ ॥",
      "transliteration": "us purakh kaa naahee kade binaas ||",
      "translation": "That person whose mind is illuminated",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਾ ਕੈ ਮਨਿ ਪ੍ਰਗਟੇ ਗੁਨਤਾਸ ॥",
      "transliteration": "jaa kai man pragate gunataas ||",
      "translation": "By the treasure of excellence, never dies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਠ ਪਹਰ ਹਰਿ ਕਾ ਨਾਮੁ ਲੇਇ ॥",
      "transliteration": "aath pahar har kaa naam lei ||",
      "translation": "Twenty-four hours a day, he takes the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਚੁ ਉਪਦੇਸੁ ਸੇਵਕ ਕਉ ਦੇਇ ॥",
      "transliteration": "sach upades sevak kau dei ||",
      "translation": "The Lord gives true instruction to His servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੋਹ ਮਾਇਆ ਕੈ ਸੰਗਿ ਨ ਲੇਪੁ ॥",
      "transliteration": "moh maaiaa kai sa(n)g na lep ||",
      "translation": "He is not polluted by emotional attachment to Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਨ ਮਹਿ ਰਾਖੈ ਹਰਿ ਹਰਿ ਏਕੁ ॥",
      "transliteration": "man mahi raakhai har har ek ||",
      "translation": "In his mind, he cherishes the One Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅੰਧਕਾਰ ਦੀਪਕ ਪਰਗਾਸੇ ॥",
      "transliteration": "a(n)dhakaar deepak paragaase ||",
      "translation": "In the pitch darkness, a lamp shines forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਨਕ ਭਰਮ ਮੋਹ ਦੁਖ ਤਹ ਤੇ ਨਾਸੇ ॥੬॥",
      "transliteration": "naanak bharam moh dukh tah te naase ||6||",
      "translation": "O Nanak, doubt, emotional attachment and pain are erased. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਪਤਿ ਮਾਹਿ ਠਾਢਿ ਵਰਤਾਈ ॥",
      "transliteration": "tapat maahi thaadh varataaee ||",
      "translation": "In the burning heat, a soothing coolness prevails.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਨਦੁ ਭਇਆ ਦੁਖ ਨਾਠੇ ਭਾਈ ॥",
      "transliteration": "anad bhaiaa dukh naathe bhaaee ||",
      "translation": "Happiness ensues and pain departs, O Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਨਮ ਮਰਨ ਕੇ ਮਿਟੇ ਅੰਦੇਸੇ ॥",
      "transliteration": "janam maran ke mite a(n)dese ||",
      "translation": "The fear of birth and death is dispelled,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਾਧੂ ਕੇ ਪੂਰਨ ਉਪਦੇਸੇ ॥",
      "transliteration": "saadhoo ke pooran upadese ||",
      "translation": "by the perfect Teachings of the Holy Saint.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭਉ ਚੂਕਾ ਨਿਰਭਉ ਹੋਇ ਬਸੇ ॥",
      "transliteration": "bhau chookaa nirabhau hoi base ||",
      "translation": "Fear is lifted, and one abides in fearlessness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਗਲ ਬਿਆਧਿ ਮਨ ਤੇ ਖੈ ਨਸੇ ॥",
      "transliteration": "sagal biaadh man te khai nase ||",
      "translation": "All evils are dispelled from the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਿਸ ਕਾ ਸਾ ਤਿਨਿ ਕਿਰਪਾ ਧਾਰੀ ॥",
      "transliteration": "jis kaa saa tin kirapaa dhaaree ||",
      "translation": "He takes us into His favor as His own.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਜਪਿ ਨਾਮੁ ਮੁਰਾਰੀ ॥",
      "transliteration": "saadhasa(n)g jap naam muraaree ||",
      "translation": "In the Company of the Holy, chant the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਥਿਤਿ ਪਾਈ ਚੂਕੇ ਭ੍ਰਮ ਗਵਨ ॥",
      "transliteration": "thit paaee chooke bhram gavan ||",
      "translation": "Stability is attained; doubt and wandering cease,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੁਨਿ ਨਾਨਕ ਹਰਿ ਹਰਿ ਜਸੁ ਸ੍ਰਵਨ ॥੭॥",
      "transliteration": "sun naanak har har jas sravan ||7||",
      "translation": "O Nanak, listening with one's ears to the Praises of the Lord, Har, Har. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਿਰਗੁਨੁ ਆਪਿ ਸਰਗੁਨੁ ਭੀ ਓਹੀ ॥",
      "transliteration": "niragun aap saragun bhee ohee ||",
      "translation": "He Himself is absolute and unrelated; He Himself is also involved and related.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਲਾ ਧਾਰਿ ਜਿਨਿ ਸਗਲੀ ਮੋਹੀ ॥",
      "transliteration": "kalaa dhaar jin sagalee mohee ||",
      "translation": "Manifesting His power, He fascinates the entire world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਅਪਨੇ ਚਰਿਤ ਪ੍ਰਭਿ ਆਪਿ ਬਨਾਏ ॥",
      "transliteration": "apane charit prabh aap banaae ||",
      "translation": "God Himself sets His play in motion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਅਪੁਨੀ ਕੀਮਤਿ ਆਪੇ ਪਾਏ ॥",
      "transliteration": "apunee keemat aape paae ||",
      "translation": "Only He Himself can estimate His worth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਹਰਿ ਬਿਨੁ ਦੂਜਾ ਨਾਹੀ ਕੋਇ ॥",
      "transliteration": "har bin doojaa naahee koi ||",
      "translation": "There is none, other than the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸਰਬ ਨਿਰੰਤਰਿ ਏਕੋ ਸੋਇ ॥",
      "transliteration": "sarab nira(n)tar eko soi ||",
      "translation": "Permeating all, He is the One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਓਤਿ ਪੋਤਿ ਰਵਿਆ ਰੂਪ ਰੰਗ ॥",
      "transliteration": "ot pot raviaa roop ra(n)g ||",
      "translation": "Through and through, He pervades in form and color.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0287_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਭਏ ਪ੍ਰਗਾਸ ਸਾਧ ਕੈ ਸੰਗ ॥",
      "transliteration": "bhae pragaas saadh kai sa(n)g ||",
      "translation": "He is revealed in the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 287,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
