{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 288,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0288_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਚਿ ਰਚਨਾ ਅਪਨੀ ਕਲ ਧਾਰੀ ॥",
      "transliteration": "rach rachanaa apanee kal dhaaree ||",
      "translation": "Having created the creation, He infuses His own power into it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਨਿਕ ਬਾਰ ਨਾਨਕ ਬਲਿਹਾਰੀ ॥੮॥੧੮॥",
      "transliteration": "anik baar naanak balihaaree ||8||18||",
      "translation": "So many times, Nanak is a sacrifice to Him. ||8||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਾਥਿ ਨ ਚਾਲੈ ਬਿਨੁ ਭਜਨ ਬਿਖਿਆ ਸਗਲੀ ਛਾਰੁ ॥",
      "transliteration": "saath na chaalai bin bhajan bikhiaa sagalee chhaar ||",
      "translation": "Nothing shall go along with you, except your devotion. All corruption is like ashes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਕਮਾਵਨਾ ਨਾਨਕ ਇਹੁ ਧਨੁ ਸਾਰੁ ॥੧॥",
      "transliteration": "har har naam kamaavanaa naanak ihu dhan saar ||1||",
      "translation": "Practice the Name of the Lord, Har, Har. O Nanak, this is the most excellent wealth. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਮਿਲਿ ਕਰਹੁ ਬੀਚਾਰੁ ॥",
      "transliteration": "sa(n)t janaa mil karahu beechaar ||",
      "translation": "Joining the Company of the Saints, practice deep meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਏਕੁ ਸਿਮਰਿ ਨਾਮ ਆਧਾਰੁ ॥",
      "transliteration": "ek simar naam aadhaar ||",
      "translation": "Remember the One, and take the Support of the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਵਰਿ ਉਪਾਵ ਸਭਿ ਮੀਤ ਬਿਸਾਰਹੁ ॥",
      "transliteration": "avar upaav sabh meet bisaarahu ||",
      "translation": "Forget all other efforts, O my friend",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਰਿਦ ਮਹਿ ਉਰਿ ਧਾਰਹੁ ॥",
      "transliteration": "charan kamal rid mahi ur dhaarahu ||",
      "translation": "- enshrine the Lord's Lotus Feet within your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਰਨ ਕਾਰਨ ਸੋ ਪ੍ਰਭੁ ਸਮਰਥੁ ॥",
      "transliteration": "karan kaaran so prabh samarath ||",
      "translation": "God is All-powerful; He is the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦ੍ਰਿੜੁ ਕਰਿ ਗਹਹੁ ਨਾਮੁ ਹਰਿ ਵਥੁ ॥",
      "transliteration": "driR kar gahahu naam har vath ||",
      "translation": "Grasp firmly the object of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਇਹੁ ਧਨੁ ਸੰਚਹੁ ਹੋਵਹੁ ਭਗਵੰਤ ॥",
      "transliteration": "ihu dhan sa(n)chahu hovahu bhagava(n)t ||",
      "translation": "Gather this wealth, and become very fortunate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਕਾ ਨਿਰਮਲ ਮੰਤ ॥",
      "transliteration": "sa(n)t janaa kaa niramal ma(n)t ||",
      "translation": "Pure are the instructions of the humble Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਏਕ ਆਸ ਰਾਖਹੁ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "ek aas raakhahu man maahi ||",
      "translation": "Keep faith in the One Lord within your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਰਬ ਰੋਗ ਨਾਨਕ ਮਿਟਿ ਜਾਹਿ ॥੧॥",
      "transliteration": "sarab rog naanak mit jaahi ||1||",
      "translation": "All disease, O Nanak, shall then be dispelled. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਸੁ ਧਨ ਕਉ ਚਾਰਿ ਕੁੰਟ ਉਠਿ ਧਾਵਹਿ ॥",
      "transliteration": "jis dhan kau chaar ku(n)t uth dhaavahi ||",
      "translation": "The wealth which you chase after in the four directions",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੋ ਧਨੁ ਹਰਿ ਸੇਵਾ ਤੇ ਪਾਵਹਿ ॥",
      "transliteration": "so dhan har sevaa te paavahi ||",
      "translation": "you shall obtain that wealth by serving the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਸੁ ਸੁਖ ਕਉ ਨਿਤ ਬਾਛਹਿ ਮੀਤ ॥",
      "transliteration": "jis sukh kau nit baachhahi meet ||",
      "translation": "The peace, which you always yearn for, O friend",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋ ਸੁਖੁ ਸਾਧੂ ਸੰਗਿ ਪਰੀਤਿ ॥",
      "transliteration": "so sukh saadhoo sa(n)g pareet ||",
      "translation": "that peace comes by the love of the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਸੁ ਸੋਭਾ ਕਉ ਕਰਹਿ ਭਲੀ ਕਰਨੀ ॥",
      "transliteration": "jis sobhaa kau karahi bhalee karanee ||",
      "translation": "The glory, for which you perform good deeds",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾ ਸੋਭਾ ਭਜੁ ਹਰਿ ਕੀ ਸਰਨੀ ॥",
      "transliteration": "saa sobhaa bhaj har kee saranee ||",
      "translation": "- you shall obtain that glory by seeking the Lord's Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਨਿਕ ਉਪਾਵੀ ਰੋਗੁ ਨ ਜਾਇ ॥",
      "transliteration": "anik upaavee rog na jaai ||",
      "translation": "All sorts of remedies have not cured the disease",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰੋਗੁ ਮਿਟੈ ਹਰਿ ਅਵਖਧੁ ਲਾਇ ॥",
      "transliteration": "rog mitai har avakhadh laai ||",
      "translation": "- the disease is cured only by giving the medicine of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਰਬ ਨਿਧਾਨ ਮਹਿ ਹਰਿ ਨਾਮੁ ਨਿਧਾਨੁ ॥",
      "transliteration": "sarab nidhaan mahi har naam nidhaan ||",
      "translation": "Of all treasures, the Lord's Name is the supreme treasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਪਿ ਨਾਨਕ ਦਰਗਹਿ ਪਰਵਾਨੁ ॥੨॥",
      "transliteration": "jap naanak daragahi paravaan ||2||",
      "translation": "Chant it, O Nanak, and be accepted in the Court of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਨੁ ਪਰਬੋਧਹੁ ਹਰਿ ਕੈ ਨਾਇ ॥",
      "transliteration": "man parabodhahu har kai naai ||",
      "translation": "Enlighten your mind with the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦਹ ਦਿਸਿ ਧਾਵਤ ਆਵੈ ਠਾਇ ॥",
      "transliteration": "dah dis dhaavat aavai thaai ||",
      "translation": "Having wandered around in the ten directions, it comes to its place of rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾ ਕਉ ਬਿਘਨੁ ਨ ਲਾਗੈ ਕੋਇ ॥",
      "transliteration": "taa kau bighan na laagai koi ||",
      "translation": "No obstacle stands in the way of one",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਾ ਕੈ ਰਿਦੈ ਬਸੈ ਹਰਿ ਸੋਇ ॥",
      "transliteration": "jaa kai ridai basai har soi ||",
      "translation": "whose heart is filled with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਲਿ ਤਾਤੀ ਠਾਂਢਾ ਹਰਿ ਨਾਉ ॥",
      "transliteration": "kal taatee thaa(n)dhaa har naau ||",
      "translation": "The Dark Age of Kali Yuga is so hot; the Lord's Name is soothing and cool.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਸਦਾ ਸੁਖ ਪਾਉ ॥",
      "transliteration": "simar simar sadaa sukh paau ||",
      "translation": "Remember, remember it in meditation, and obtain everlasting peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਉ ਬਿਨਸੈ ਪੂਰਨ ਹੋਇ ਆਸ ॥",
      "transliteration": "bhau binasai pooran hoi aas ||",
      "translation": "Your fear shall be dispelled, and your hopes shall be fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਗਤਿ ਭਾਇ ਆਤਮ ਪਰਗਾਸ ॥",
      "transliteration": "bhagat bhaai aatam paragaas ||",
      "translation": "By devotional worship and loving adoration, your soul shall be enlightened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਿਤੁ ਘਰਿ ਜਾਇ ਬਸੈ ਅਬਿਨਾਸੀ ॥",
      "transliteration": "tit ghar jaai basai abinaasee ||",
      "translation": "You shall go to that home, and live forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਕਾਟੀ ਜਮ ਫਾਸੀ ॥੩॥",
      "transliteration": "kahu naanak kaatee jam phaasee ||3||",
      "translation": "Says Nanak, the noose of death is cut away. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਤੁ ਬੀਚਾਰੁ ਕਹੈ ਜਨੁ ਸਾਚਾ ॥",
      "transliteration": "tat beechaar kahai jan saachaa ||",
      "translation": "One who contemplates the essence of reality, is said to be the true person.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਨਮਿ ਮਰੈ ਸੋ ਕਾਚੋ ਕਾਚਾ ॥",
      "transliteration": "janam marai so kaacho kaachaa ||",
      "translation": "Birth and death are the lot of the false and the insincere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਵਾ ਗਵਨੁ ਮਿਟੈ ਪ੍ਰਭ ਸੇਵ ॥",
      "transliteration": "aavaa gavan mitai prabh sev ||",
      "translation": "Coming and going in reincarnation is ended by serving God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਪੁ ਤਿਆਗਿ ਸਰਨਿ ਗੁਰਦੇਵ ॥",
      "transliteration": "aap tiaag saran guradev ||",
      "translation": "Give up your selfishness and conceit, and seek the Sanctuary of the Divine Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਉ ਰਤਨ ਜਨਮ ਕਾ ਹੋਇ ਉਧਾਰੁ ॥",
      "transliteration": "iu ratan janam kaa hoi udhaar ||",
      "translation": "Thus the jewel of this human life is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਸਿਮਰਿ ਪ੍ਰਾਨ ਆਧਾਰੁ ॥",
      "transliteration": "har har simar praan aadhaar ||",
      "translation": "Remember the Lord, Har, Har, the Support of the breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਨਿਕ ਉਪਾਵ ਨ ਛੂਟਨਹਾਰੇ ॥",
      "transliteration": "anik upaav na chhootanahaare ||",
      "translation": "By all sorts of efforts, people are not saved",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਿੰਮ੍ਰਿਤਿ ਸਾਸਤ ਬੇਦ ਬੀਚਾਰੇ ॥",
      "transliteration": "si(n)mrit saasat bed beechaare ||",
      "translation": "not by studying the Simritees, the Shaastras or the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਰਿ ਕੀ ਭਗਤਿ ਕਰਹੁ ਮਨੁ ਲਾਇ ॥",
      "transliteration": "har kee bhagat karahu man laai ||",
      "translation": "Worship the Lord with whole-hearted devotion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਨਿ ਬੰਛਤ ਨਾਨਕ ਫਲ ਪਾਇ ॥੪॥",
      "transliteration": "man ba(n)chhat naanak phal paai ||4||",
      "translation": "O Nanak, you shall obtain the fruits of your mind's desire. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੰਗਿ ਨ ਚਾਲਸਿ ਤੇਰੈ ਧਨਾ ॥",
      "transliteration": "sa(n)g na chaalas terai dhanaa ||",
      "translation": "Your wealth shall not go with you;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤੂੰ ਕਿਆ ਲਪਟਾਵਹਿ ਮੂਰਖ ਮਨਾ ॥",
      "transliteration": "too(n) kiaa lapataavahi moorakh manaa ||",
      "translation": "why do you cling to it, you fool?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੁਤ ਮੀਤ ਕੁਟੰਬ ਅਰੁ ਬਨਿਤਾ ॥",
      "transliteration": "sut meet kuta(n)b ar banitaa ||",
      "translation": "Children, friends, family and spouse",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਇਨ ਤੇ ਕਹਹੁ ਤੁਮ ਕਵਨ ਸਨਾਥਾ ॥",
      "transliteration": "in te kahahu tum kavan sanaathaa ||",
      "translation": "who of these shall accompany you?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਰਾਜ ਰੰਗ ਮਾਇਆ ਬਿਸਥਾਰ ॥",
      "transliteration": "raaj ra(n)g maaiaa bisathaar ||",
      "translation": "Power, pleasure, and the vast expanse of Maya",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਇਨ ਤੇ ਕਹਹੁ ਕਵਨ ਛੁਟਕਾਰ ॥",
      "transliteration": "in te kahahu kavan chhutakaar ||",
      "translation": "who has ever escaped from these?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅਸੁ ਹਸਤੀ ਰਥ ਅਸਵਾਰੀ ॥",
      "transliteration": "as hasatee rath asavaaree ||",
      "translation": "Horses, elephants, chariots and pageantry",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਝੂਠਾ ਡੰਫੁ ਝੂਠੁ ਪਾਸਾਰੀ ॥",
      "transliteration": "jhoothaa da(n)ph jhooth paasaaree ||",
      "translation": "- false shows and false displays.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਿਨਿ ਦੀਏ ਤਿਸੁ ਬੁਝੈ ਨ ਬਿਗਾਨਾ ॥",
      "transliteration": "jin deee tis bujhai na bigaanaa ||",
      "translation": "The fool does not acknowledge the One who gave this;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਮੁ ਬਿਸਾਰਿ ਨਾਨਕ ਪਛੁਤਾਨਾ ॥੫॥",
      "transliteration": "naam bisaar naanak pachhutaanaa ||5||",
      "translation": "forgetting the Naam, O Nanak, he will repent in the end. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗੁਰ ਕੀ ਮਤਿ ਤੂੰ ਲੇਹਿ ਇਆਨੇ ॥",
      "transliteration": "gur kee mat too(n) lehi iaane ||",
      "translation": "Take the Guru's advice, you ignorant fool;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਭਗਤਿ ਬਿਨਾ ਬਹੁ ਡੂਬੇ ਸਿਆਨੇ ॥",
      "transliteration": "bhagat binaa bahu doobe siaane ||",
      "translation": "without devotion, even the clever have drowned.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਹਰਿ ਕੀ ਭਗਤਿ ਕਰਹੁ ਮਨ ਮੀਤ ॥",
      "transliteration": "har kee bhagat karahu man meet ||",
      "translation": "Worship the Lord with heart-felt devotion, my friend;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਨਿਰਮਲ ਹੋਇ ਤੁਮੑਾਰੋ ਚੀਤ ॥",
      "transliteration": "niramal hoi tumhaaro cheet ||",
      "translation": "your consciousness shall become pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0288_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਰਾਖਹੁ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "charan kamal raakhahu man maahi ||",
      "translation": "Enshrine the Lord's Lotus Feet in your mind;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 288,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
