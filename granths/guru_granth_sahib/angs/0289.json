{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 289,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0289_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਕਿਲਬਿਖ ਜਾਹਿ ॥",
      "transliteration": "janam janam ke kilabikh jaahi ||",
      "translation": "the sins of countless lifetimes shall depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਪਿ ਜਪਹੁ ਅਵਰਾ ਨਾਮੁ ਜਪਾਵਹੁ ॥",
      "transliteration": "aap japahu avaraa naam japaavahu ||",
      "translation": "Chant the Naam yourself, and inspire others to chant it as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੁਨਤ ਕਹਤ ਰਹਤ ਗਤਿ ਪਾਵਹੁ ॥",
      "transliteration": "sunat kahat rahat gat paavahu ||",
      "translation": "Hearing, speaking and living it, emancipation is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਾਰ ਭੂਤ ਸਤਿ ਹਰਿ ਕੋ ਨਾਉ ॥",
      "transliteration": "saar bhoot sat har ko naau ||",
      "translation": "The essential reality is the True Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਹਜਿ ਸੁਭਾਇ ਨਾਨਕ ਗੁਨ ਗਾਉ ॥੬॥",
      "transliteration": "sahaj subhaai naanak gun gaau ||6||",
      "translation": "With intuitive ease, O Nanak, sing His Glorious Praises. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਨ ਗਾਵਤ ਤੇਰੀ ਉਤਰਸਿ ਮੈਲੁ ॥",
      "transliteration": "gun gaavat teree utaras mail ||",
      "translation": "Chanting His Glories, your filth shall be washed off.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਿਨਸਿ ਜਾਇ ਹਉਮੈ ਬਿਖੁ ਫੈਲੁ ॥",
      "transliteration": "binas jaai haumai bikh phail ||",
      "translation": "The all-consuming poison of ego will be gone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹੋਹਿ ਅਚਿੰਤੁ ਬਸੈ ਸੁਖ ਨਾਲਿ ॥",
      "transliteration": "hohi achi(n)t basai sukh naal ||",
      "translation": "You shall become carefree, and you shall dwell in peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਾਸਿ ਗ੍ਰਾਸਿ ਹਰਿ ਨਾਮੁ ਸਮਾਲਿ ॥",
      "transliteration": "saas graas har naam samaal ||",
      "translation": "With every breath and every morsel of food, cherish the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਛਾਡਿ ਸਿਆਨਪ ਸਗਲੀ ਮਨਾ ॥",
      "transliteration": "chhaad siaanap sagalee manaa ||",
      "translation": "Renounce all clever tricks, O mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਪਾਵਹਿ ਸਚੁ ਧਨਾ ॥",
      "transliteration": "saadhasa(n)g paavahi sach dhanaa ||",
      "translation": "In the Company of the Holy, you shall obtain the true wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਪੂੰਜੀ ਸੰਚਿ ਕਰਹੁ ਬਿਉਹਾਰੁ ॥",
      "transliteration": "har poo(n)jee sa(n)ch karahu biuhaar ||",
      "translation": "So gather the Lord's Name as your capital, and trade in it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਈਹਾ ਸੁਖੁ ਦਰਗਹ ਜੈਕਾਰੁ ॥",
      "transliteration": "eehaa sukh daragah jaikaar ||",
      "translation": "In this world you shall be at peace, and in the Court of the Lord, you shall be acclaimed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਰਬ ਨਿਰੰਤਰਿ ਏਕੋ ਦੇਖੁ ॥",
      "transliteration": "sarab nira(n)tar eko dekh ||",
      "translation": "See the One permeating all;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਾ ਕੈ ਮਸਤਕਿ ਲੇਖੁ ॥੭॥",
      "transliteration": "kahu naanak jaa kai masatak lekh ||7||",
      "translation": "says Nanak, your destiny is pre-ordained. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਏਕੋ ਜਪਿ ਏਕੋ ਸਾਲਾਹਿ ॥",
      "transliteration": "eko jap eko saalaahi ||",
      "translation": "Meditate on the One, and worship the One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਏਕੁ ਸਿਮਰਿ ਏਕੋ ਮਨ ਆਹਿ ॥",
      "transliteration": "ek simar eko man aahi ||",
      "translation": "Remember the One, and yearn for the One in your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਏਕਸ ਕੇ ਗੁਨ ਗਾਉ ਅਨੰਤ ॥",
      "transliteration": "ekas ke gun gaau ana(n)t ||",
      "translation": "Sing the endless Glorious Praises of the One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਨਿ ਤਨਿ ਜਾਪਿ ਏਕ ਭਗਵੰਤ ॥",
      "transliteration": "man tan jaap ek bhagava(n)t ||",
      "translation": "With mind and body, meditate on the One Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਏਕੋ ਏਕੁ ਏਕੁ ਹਰਿ ਆਪਿ ॥",
      "transliteration": "eko ek ek har aap ||",
      "translation": "The One Lord Himself is the One and Only.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪੂਰਨ ਪੂਰਿ ਰਹਿਓ ਪ੍ਰਭੁ ਬਿਆਪਿ ॥",
      "transliteration": "pooran poor rahio prabh biaap ||",
      "translation": "The Pervading Lord God is totally permeating all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਨਿਕ ਬਿਸਥਾਰ ਏਕ ਤੇ ਭਏ ॥",
      "transliteration": "anik bisathaar ek te bhae ||",
      "translation": "The many expanses of the creation have all come from the One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਏਕੁ ਅਰਾਧਿ ਪਰਾਛਤ ਗਏ ॥",
      "transliteration": "ek araadh paraachhat gae ||",
      "translation": "Adoring the One, past sins are removed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਨ ਤਨ ਅੰਤਰਿ ਏਕੁ ਪ੍ਰਭੁ ਰਾਤਾ ॥",
      "transliteration": "man tan a(n)tar ek prabh raataa ||",
      "translation": "Mind and body within are imbued with the One God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਨਾਨਕ ਇਕੁ ਜਾਤਾ ॥੮॥੧੯॥",
      "transliteration": "gur prasaad naanak ik jaataa ||8||19||",
      "translation": "By Guru's Grace, O Nanak, the One is known. ||8||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਫਿਰਤ ਫਿਰਤ ਪ੍ਰਭ ਆਇਆ ਪਰਿਆ ਤਉ ਸਰਨਾਇ ॥",
      "transliteration": "phirat phirat prabh aaiaa pariaa tau saranaai ||",
      "translation": "After wandering and wandering, O God, I have come, and entered Your Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਕੀ ਪ੍ਰਭ ਬੇਨਤੀ ਅਪਨੀ ਭਗਤੀ ਲਾਇ ॥੧॥",
      "transliteration": "naanak kee prabh benatee apanee bhagatee laai ||1||",
      "translation": "This is Nanak's prayer, O God: please, attach me to Your devotional service. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਾਚਕ ਜਨੁ ਜਾਚੈ ਪ੍ਰਭ ਦਾਨੁ ॥",
      "transliteration": "jaachak jan jaachai prabh daan ||",
      "translation": "I am a beggar; I beg for this gift from You:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਦੇਵਹੁ ਹਰਿ ਨਾਮੁ ॥",
      "transliteration": "kar kirapaa devahu har naam ||",
      "translation": "please, by Your Mercy, Lord, give me Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਾਧ ਜਨਾ ਕੀ ਮਾਗਉ ਧੂਰਿ ॥",
      "transliteration": "saadh janaa kee maagau dhoor ||",
      "translation": "I ask for the dust of the feet of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਮੇਰੀ ਸਰਧਾ ਪੂਰਿ ॥",
      "transliteration": "paarabraham meree saradhaa poor ||",
      "translation": "O Supreme Lord God, please fulfill my yearning;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਪ੍ਰਭ ਕੇ ਗੁਨ ਗਾਵਉ ॥",
      "transliteration": "sadaa sadaa prabh ke gun gaavau ||",
      "translation": "may I sing the Glorious Praises of God forever and ever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਾਸਿ ਸਾਸਿ ਪ੍ਰਭ ਤੁਮਹਿ ਧਿਆਵਉ ॥",
      "transliteration": "saas saas prabh tumahi dhiaavau ||",
      "translation": "With each and every breath, may I meditate on You, O God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਸਿਉ ਲਾਗੈ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "charan kamal siu laagai preet ||",
      "translation": "May I enshrine affection for Your Lotus Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭਗਤਿ ਕਰਉ ਪ੍ਰਭ ਕੀ ਨਿਤ ਨੀਤਿ ॥",
      "transliteration": "bhagat karau prabh kee nit neet ||",
      "translation": "May I perform devotional worship to God each and every day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਏਕ ਓਟ ਏਕੋ ਆਧਾਰੁ ॥",
      "transliteration": "ek ot eko aadhaar ||",
      "translation": "You are my only Shelter, my only Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਨਕੁ ਮਾਗੈ ਨਾਮੁ ਪ੍ਰਭ ਸਾਰੁ ॥੧॥",
      "transliteration": "naanak maagai naam prabh saar ||1||",
      "translation": "Nanak asks for the most sublime, the Naam, the Name of God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਦ੍ਰਿਸਟਿ ਮਹਾ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "prabh kee drisat mahaa sukh hoi ||",
      "translation": "By God's Gracious Glance, there is great peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਰਿ ਰਸੁ ਪਾਵੈ ਬਿਰਲਾ ਕੋਇ ॥",
      "transliteration": "har ras paavai biralaa koi ||",
      "translation": "Rare are those who obtain the juice of the Lord's essence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਨ ਚਾਖਿਆ ਸੇ ਜਨ ਤ੍ਰਿਪਤਾਨੇ ॥",
      "transliteration": "jin chaakhiaa se jan tripataane ||",
      "translation": "Those who taste it are satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪੂਰਨ ਪੁਰਖ ਨਹੀ ਡੋਲਾਨੇ ॥",
      "transliteration": "pooran purakh nahee dolaane ||",
      "translation": "They are fulfilled and realized beings - they do not waver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੁਭਰ ਭਰੇ ਪ੍ਰੇਮ ਰਸ ਰੰਗਿ ॥",
      "transliteration": "subhar bhare prem ras ra(n)g ||",
      "translation": "They are totally filled to over-flowing with the sweet delight of His Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਉਪਜੈ ਚਾਉ ਸਾਧ ਕੈ ਸੰਗਿ ॥",
      "transliteration": "upajai chaau saadh kai sa(n)g ||",
      "translation": "Spiritual delight wells up within, in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪਰੇ ਸਰਨਿ ਆਨ ਸਭ ਤਿਆਗਿ ॥",
      "transliteration": "pare saran aan sabh tiaag ||",
      "translation": "Taking to His Sanctuary, they forsake all others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅੰਤਰਿ ਪ੍ਰਗਾਸ ਅਨਦਿਨੁ ਲਿਵ ਲਾਗਿ ॥",
      "transliteration": "a(n)tar pragaas anadin liv laag ||",
      "translation": "Deep within, they are enlightened, and they center themselves on Him, day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਡਭਾਗੀ ਜਪਿਆ ਪ੍ਰਭੁ ਸੋਇ ॥",
      "transliteration": "badabhaagee japiaa prabh soi ||",
      "translation": "Most fortunate are those who meditate on God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ ਸੁਖੁ ਹੋਇ ॥੨॥",
      "transliteration": "naanak naam rate sukh hoi ||2||",
      "translation": "O Nanak, attuned to the Naam, they are at peace. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੇਵਕ ਕੀ ਮਨਸਾ ਪੂਰੀ ਭਈ ॥",
      "transliteration": "sevak kee manasaa pooree bhaee ||",
      "translation": "The wishes of the Lord's servant are fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਤਿਗੁਰ ਤੇ ਨਿਰਮਲ ਮਤਿ ਲਈ ॥",
      "transliteration": "satigur te niramal mat laee ||",
      "translation": "From the True Guru, the pure teachings are obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਨ ਕਉ ਪ੍ਰਭੁ ਹੋਇਓ ਦਇਆਲੁ ॥",
      "transliteration": "jan kau prabh hoio daiaal ||",
      "translation": "Unto His humble servant, God has shown His kindness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੇਵਕੁ ਕੀਨੋ ਸਦਾ ਨਿਹਾਲੁ ॥",
      "transliteration": "sevak keeno sadaa nihaal ||",
      "translation": "He has made His servant eternally happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਬੰਧਨ ਕਾਟਿ ਮੁਕਤਿ ਜਨੁ ਭਇਆ ॥",
      "transliteration": "ba(n)dhan kaat mukat jan bhaiaa ||",
      "translation": "The bonds of His humble servant are cut away, and he is liberated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਨਮ ਮਰਨ ਦੂਖੁ ਭ੍ਰਮੁ ਗਇਆ ॥",
      "transliteration": "janam maran dookh bhram gaiaa ||",
      "translation": "The pains of birth and death, and doubt are gone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਇਛ ਪੁਨੀ ਸਰਧਾ ਸਭ ਪੂਰੀ ॥",
      "transliteration": "ichh punee saradhaa sabh pooree ||",
      "translation": "Desires are satisfied, and faith is fully rewarded,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਰਵਿ ਰਹਿਆ ਸਦ ਸੰਗਿ ਹਜੂਰੀ ॥",
      "transliteration": "rav rahiaa sad sa(n)g hajooree ||",
      "translation": "imbued forever with His all-pervading peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਿਸ ਕਾ ਸਾ ਤਿਨਿ ਲੀਆ ਮਿਲਾਇ ॥",
      "transliteration": "jis kaa saa tin leeaa milaai ||",
      "translation": "He is His - he merges in Union with Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਨਾਨਕ ਭਗਤੀ ਨਾਮਿ ਸਮਾਇ ॥੩॥",
      "transliteration": "naanak bhagatee naam samaai ||3||",
      "translation": "Nanak is absorbed in devotional worship of the Naam. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸੋ ਕਿਉ ਬਿਸਰੈ ਜਿ ਘਾਲ ਨ ਭਾਨੈ ॥",
      "transliteration": "so kiu bisarai j ghaal na bhaanai ||",
      "translation": "Why forget Him, who does not overlook our efforts?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0289_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਸੋ ਕਿਉ ਬਿਸਰੈ ਜਿ ਕੀਆ ਜਾਨੈ ॥",
      "transliteration": "so kiu bisarai j keeaa jaanai ||",
      "translation": "Why forget Him, who acknowledges what we do?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 289,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
