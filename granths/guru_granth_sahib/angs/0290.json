{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 290,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0290_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੋ ਕਿਉ ਬਿਸਰੈ ਜਿਨਿ ਸਭੁ ਕਿਛੁ ਦੀਆ ॥",
      "transliteration": "so kiu bisarai jin sabh kichh deeaa ||",
      "translation": "Why forget Him, who has given us everything?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੋ ਕਿਉ ਬਿਸਰੈ ਜਿ ਜੀਵਨ ਜੀਆ ॥",
      "transliteration": "so kiu bisarai j jeevan jeeaa ||",
      "translation": "Why forget Him, who is the Life of the living beings?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੋ ਕਿਉ ਬਿਸਰੈ ਜਿ ਅਗਨਿ ਮਹਿ ਰਾਖੈ ॥",
      "transliteration": "so kiu bisarai j agan mahi raakhai ||",
      "translation": "Why forget Him, who preserves us in the fire of the womb?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਕੋ ਬਿਰਲਾ ਲਾਖੈ ॥",
      "transliteration": "gur prasaad ko biralaa laakhai ||",
      "translation": "By Guru's Grace, rare is the one who realizes this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੋ ਕਿਉ ਬਿਸਰੈ ਜਿ ਬਿਖੁ ਤੇ ਕਾਢੈ ॥",
      "transliteration": "so kiu bisarai j bikh te kaadhai ||",
      "translation": "Why forget Him, who lifts us up out of corruption?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕਾ ਟੂਟਾ ਗਾਢੈ ॥",
      "transliteration": "janam janam kaa tootaa gaadhai ||",
      "translation": "Those separated from Him for countless lifetimes, are re-united with Him once again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਤਤੁ ਇਹੈ ਬੁਝਾਇਆ ॥",
      "transliteration": "gur poorai tat ihai bujhaaiaa ||",
      "translation": "Through the Perfect Guru, this essential reality is understood.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪ੍ਰਭੁ ਅਪਨਾ ਨਾਨਕ ਜਨ ਧਿਆਇਆ ॥੪॥",
      "transliteration": "prabh apanaa naanak jan dhiaaiaa ||4||",
      "translation": "O Nanak, God's humble servants meditate on Him. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਾਜਨ ਸੰਤ ਕਰਹੁ ਇਹੁ ਕਾਮੁ ॥",
      "transliteration": "saajan sa(n)t karahu ihu kaam ||",
      "translation": "O friends, O Saints, make this your work.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਨ ਤਿਆਗਿ ਜਪਹੁ ਹਰਿ ਨਾਮੁ ॥",
      "transliteration": "aan tiaag japahu har naam ||",
      "translation": "Renounce everything else, and chant the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਸਿਮਰਿ ਸੁਖ ਪਾਵਹੁ ॥",
      "transliteration": "simar simar simar sukh paavahu ||",
      "translation": "Meditate, meditate, meditate in remembrance of Him, and find peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਆਪਿ ਜਪਹੁ ਅਵਰਹ ਨਾਮੁ ਜਪਾਵਹੁ ॥",
      "transliteration": "aap japahu avarah naam japaavahu ||",
      "translation": "Chant the Naam yourself, and inspire others to chant it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਗਤਿ ਭਾਇ ਤਰੀਐ ਸੰਸਾਰੁ ॥",
      "transliteration": "bhagat bhaai tareeai sa(n)saar ||",
      "translation": "By loving devotional worship, you shall cross over the world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਿਨੁ ਭਗਤੀ ਤਨੁ ਹੋਸੀ ਛਾਰੁ ॥",
      "transliteration": "bin bhagatee tan hosee chhaar ||",
      "translation": "Without devotional meditation, the body will be just ashes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਰਬ ਕਲਿਆਣ ਸੂਖ ਨਿਧਿ ਨਾਮੁ ॥",
      "transliteration": "sarab kaliaan sookh nidh naam ||",
      "translation": "All joys and comforts are in the treasure of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬੂਡਤ ਜਾਤ ਪਾਏ ਬਿਸ੍ਰਾਮੁ ॥",
      "transliteration": "boodat jaat paae bisraam ||",
      "translation": "Even the drowning can reach the place of rest and safety.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਗਲ ਦੂਖ ਕਾ ਹੋਵਤ ਨਾਸੁ ॥",
      "transliteration": "sagal dookh kaa hovat naas ||",
      "translation": "All sorrows shall vanish.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਜਪਹੁ ਗੁਨਤਾਸੁ ॥੫॥",
      "transliteration": "naanak naam japahu gunataas ||5||",
      "translation": "O Nanak, chant the Naam, the treasure of excellence. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਉਪਜੀ ਪ੍ਰੀਤਿ ਪ੍ਰੇਮ ਰਸੁ ਚਾਉ ॥",
      "transliteration": "upajee preet prem ras chaau ||",
      "translation": "Love and affection, and the taste of yearning, have welled up within;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਨ ਤਨ ਅੰਤਰਿ ਇਹੀ ਸੁਆਉ ॥",
      "transliteration": "man tan a(n)tar ihee suaau ||",
      "translation": "within my mind and body, this is my purpose:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨੇਤ੍ਰਹੁ ਪੇਖਿ ਦਰਸੁ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "netrahu pekh daras sukh hoi ||",
      "translation": "beholding with my eyes His Blessed Vision, I am at peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਨੁ ਬਿਗਸੈ ਸਾਧ ਚਰਨ ਧੋਇ ॥",
      "transliteration": "man bigasai saadh charan dhoi ||",
      "translation": "My mind blossoms forth in ecstasy, washing the feet of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਗਤ ਜਨਾ ਕੈ ਮਨਿ ਤਨਿ ਰੰਗੁ ॥",
      "transliteration": "bhagat janaa kai man tan ra(n)g ||",
      "translation": "The minds and bodies of His devotees are infused with His Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਿਰਲਾ ਕੋਊ ਪਾਵੈ ਸੰਗੁ ॥",
      "transliteration": "biralaa kooo paavai sa(n)g ||",
      "translation": "Rare is the one who obtains their company.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਏਕ ਬਸਤੁ ਦੀਜੈ ਕਰਿ ਮਇਆ ॥",
      "transliteration": "ek basat deejai kar maiaa ||",
      "translation": "Show Your mercy - please, grant me this one request:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਨਾਮੁ ਜਪਿ ਲਇਆ ॥",
      "transliteration": "gur prasaad naam jap laiaa ||",
      "translation": "by Guru's Grace, may I chant the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾ ਕੀ ਉਪਮਾ ਕਹੀ ਨ ਜਾਇ ॥",
      "transliteration": "taa kee upamaa kahee na jaai ||",
      "translation": "His Praises cannot be spoken;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਰਹਿਆ ਸਰਬ ਸਮਾਇ ॥੬॥",
      "transliteration": "naanak rahiaa sarab samaai ||6||",
      "translation": "O Nanak, He is contained among all. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪ੍ਰਭ ਬਖਸੰਦ ਦੀਨ ਦਇਆਲ ॥",
      "transliteration": "prabh bakhasa(n)d deen daiaal ||",
      "translation": "God, the Forgiving Lord, is kind to the poor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਗਤਿ ਵਛਲ ਸਦਾ ਕਿਰਪਾਲ ॥",
      "transliteration": "bhagat vachhal sadaa kirapaal ||",
      "translation": "He loves His devotees, and He is always merciful to them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਨਾਥ ਨਾਥ ਗੋਬਿੰਦ ਗੁਪਾਲ ॥",
      "transliteration": "anaath naath gobi(n)d gupaal ||",
      "translation": "The Patron of the patronless, the Lord of the Universe, the Sustainer of the world,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਰਬ ਘਟਾ ਕਰਤ ਪ੍ਰਤਿਪਾਲ ॥",
      "transliteration": "sarab ghataa karat pratipaal ||",
      "translation": "the Nourisher of all beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਦਿ ਪੁਰਖ ਕਾਰਣ ਕਰਤਾਰ ॥",
      "transliteration": "aad purakh kaaran karataar ||",
      "translation": "The Primal Being, the Creator of the Creation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਗਤ ਜਨਾ ਕੇ ਪ੍ਰਾਨ ਅਧਾਰ ॥",
      "transliteration": "bhagat janaa ke praan adhaar ||",
      "translation": "The Support of the breath of life of His devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜੋ ਜੋ ਜਪੈ ਸੁ ਹੋਇ ਪੁਨੀਤ ॥",
      "transliteration": "jo jo japai s hoi puneet ||",
      "translation": "Whoever meditates on Him is sanctified,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਗਤਿ ਭਾਇ ਲਾਵੈ ਮਨ ਹੀਤ ॥",
      "transliteration": "bhagat bhaai laavai man heet ||",
      "translation": "focusing the mind in loving devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਮ ਨਿਰਗੁਨੀਆਰ ਨੀਚ ਅਜਾਨ ॥",
      "transliteration": "ham niraguneeaar neech ajaan ||",
      "translation": "I am unworthy, lowly and ignorant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਨਕ ਤੁਮਰੀ ਸਰਨਿ ਪੁਰਖ ਭਗਵਾਨ ॥੭॥",
      "transliteration": "naanak tumaree saran purakh bhagavaan ||7||",
      "translation": "Nanak has entered Your Sanctuary, O Supreme Lord God. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਰਬ ਬੈਕੁੰਠ ਮੁਕਤਿ ਮੋਖ ਪਾਏ ॥",
      "transliteration": "sarab baiku(n)th mukat mokh paae ||",
      "translation": "Everything is obtained: the heavens, liberation and deliverance,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਏਕ ਨਿਮਖ ਹਰਿ ਕੇ ਗੁਨ ਗਾਏ ॥",
      "transliteration": "ek nimakh har ke gun gaae ||",
      "translation": "if one sings the Lord's Glories, even for an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਨਿਕ ਰਾਜ ਭੋਗ ਬਡਿਆਈ ॥",
      "transliteration": "anik raaj bhog badiaaee ||",
      "translation": "So many realms of power, pleasures and great glories,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਰਿ ਕੇ ਨਾਮ ਕੀ ਕਥਾ ਮਨਿ ਭਾਈ ॥",
      "transliteration": "har ke naam kee kathaa man bhaaee ||",
      "translation": "come to one whose mind is pleased with the Sermon of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਹੁ ਭੋਜਨ ਕਾਪਰ ਸੰਗੀਤ ॥",
      "transliteration": "bahu bhojan kaapar sa(n)geet ||",
      "translation": "Abundant foods, clothes and music",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਸਨਾ ਜਪਤੀ ਹਰਿ ਹਰਿ ਨੀਤ ॥",
      "transliteration": "rasanaa japatee har har neet ||",
      "translation": "come to one whose tongue continually chants the Lord's Name, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਲੀ ਸੁ ਕਰਨੀ ਸੋਭਾ ਧਨਵੰਤ ॥",
      "transliteration": "bhalee s karanee sobhaa dhanava(n)t ||",
      "translation": "His actions are good, he is glorious and wealthy;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਿਰਦੈ ਬਸੇ ਪੂਰਨ ਗੁਰ ਮੰਤ ॥",
      "transliteration": "hiradai base pooran gur ma(n)t ||",
      "translation": "the Mantra of the Perfect Guru dwells within his heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਪ੍ਰਭ ਦੇਹੁ ਨਿਵਾਸ ॥",
      "transliteration": "saadhasa(n)g prabh dehu nivaas ||",
      "translation": "O God, grant me a home in the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਰਬ ਸੂਖ ਨਾਨਕ ਪਰਗਾਸ ॥੮॥੨੦॥",
      "transliteration": "sarab sookh naanak paragaas ||8||20||",
      "translation": "All pleasures, O Nanak, are so revealed. ||8||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਰਗੁਨ ਨਿਰਗੁਨ ਨਿਰੰਕਾਰ ਸੁੰਨ ਸਮਾਧੀ ਆਪਿ ॥",
      "transliteration": "saragun niragun nira(n)kaar su(n)n samaadhee aap ||",
      "translation": "He possesses all qualities; He transcends all qualities; He is the Formless Lord. He Himself is in Primal Samaadhi.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਆਪਨ ਕੀਆ ਨਾਨਕਾ ਆਪੇ ਹੀ ਫਿਰਿ ਜਾਪਿ ॥੧॥",
      "transliteration": "aapan keeaa naanakaa aape hee phir jaap ||1||",
      "translation": "Through His Creation, O Nanak, He meditates on Himself. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਬ ਅਕਾਰੁ ਇਹੁ ਕਛੁ ਨ ਦ੍ਰਿਸਟੇਤਾ ॥",
      "transliteration": "jab akaar ihu kachh na drisatetaa ||",
      "translation": "When this world had not yet appeared in any form,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪਾਪ ਪੁੰਨ ਤਬ ਕਹ ਤੇ ਹੋਤਾ ॥",
      "transliteration": "paap pu(n)n tab kah te hotaa ||",
      "translation": "who then committed sins and performed good deeds?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਬ ਧਾਰੀ ਆਪਨ ਸੁੰਨ ਸਮਾਧਿ ॥",
      "transliteration": "jab dhaaree aapan su(n)n samaadh ||",
      "translation": "When the Lord Himself was in Profound Samaadhi,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਤਬ ਬੈਰ ਬਿਰੋਧ ਕਿਸੁ ਸੰਗਿ ਕਮਾਤਿ ॥",
      "transliteration": "tab bair birodh kis sa(n)g kamaat ||",
      "translation": "then against whom were hate and jealousy directed?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਬ ਇਸ ਕਾ ਬਰਨੁ ਚਿਹਨੁ ਨ ਜਾਪਤ ॥",
      "transliteration": "jab is kaa baran chihan na jaapat ||",
      "translation": "When there was no color or shape to be seen,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤਬ ਹਰਖ ਸੋਗ ਕਹੁ ਕਿਸਹਿ ਬਿਆਪਤ ॥",
      "transliteration": "tab harakh sog kahu kisahi biaapat ||",
      "translation": "then who experienced joy and sorrow?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜਬ ਆਪਨ ਆਪ ਆਪਿ ਪਾਰਬ੍ਰਹਮ ॥",
      "transliteration": "jab aapan aap aap paarabraham ||",
      "translation": "When the Supreme Lord Himself was Himself All-in-all,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0290_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਤਬ ਮੋਹ ਕਹਾ ਕਿਸੁ ਹੋਵਤ ਭਰਮ ॥",
      "transliteration": "tab moh kahaa kis hovat bharam ||",
      "translation": "then where was emotional attachment, and who had doubts?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 290,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
