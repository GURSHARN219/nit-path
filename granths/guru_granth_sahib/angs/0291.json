{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 291,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0291_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਪਨ ਖੇਲੁ ਆਪਿ ਵਰਤੀਜਾ ॥",
      "transliteration": "aapan khel aap varateejaa ||",
      "translation": "He Himself has staged His own drama;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਨਕ ਕਰਨੈਹਾਰੁ ਨ ਦੂਜਾ ॥੧॥",
      "transliteration": "naanak karanaihaar na doojaa ||1||",
      "translation": "O Nanak, there is no other Creator. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਬ ਹੋਵਤ ਪ੍ਰਭ ਕੇਵਲ ਧਨੀ ॥",
      "transliteration": "jab hovat prabh keval dhanee ||",
      "translation": "When there was only God the Master,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਬ ਬੰਧ ਮੁਕਤਿ ਕਹੁ ਕਿਸ ਕਉ ਗਨੀ ॥",
      "transliteration": "tab ba(n)dh mukat kahu kis kau ganee ||",
      "translation": "then who was called bound or liberated?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਬ ਏਕਹਿ ਹਰਿ ਅਗਮ ਅਪਾਰ ॥",
      "transliteration": "jab ekahi har agam apaar ||",
      "translation": "When there was only the Lord, Unfathomable and Infinite,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਬ ਨਰਕ ਸੁਰਗ ਕਹੁ ਕਉਨ ਅਉਤਾਰ ॥",
      "transliteration": "tab narak surag kahu kaun autaar ||",
      "translation": "then who entered hell, and who entered heaven?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਬ ਨਿਰਗੁਨ ਪ੍ਰਭ ਸਹਜ ਸੁਭਾਇ ॥",
      "transliteration": "jab niragun prabh sahaj subhaai ||",
      "translation": "When God was without attributes, in absolute poise,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਬ ਸਿਵ ਸਕਤਿ ਕਹਹੁ ਕਿਤੁ ਠਾਇ ॥",
      "transliteration": "tab siv sakat kahahu kit thaai ||",
      "translation": "then where was mind and where was matter - where was Shiva and Shakti?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਬ ਆਪਹਿ ਆਪਿ ਅਪਨੀ ਜੋਤਿ ਧਰੈ ॥",
      "transliteration": "jab aapahi aap apanee jot dharai ||",
      "translation": "When He held His Own Light unto Himself,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਬ ਕਵਨ ਨਿਡਰੁ ਕਵਨ ਕਤ ਡਰੈ ॥",
      "transliteration": "tab kavan nidar kavan kat darai ||",
      "translation": "then who was fearless, and who was afraid?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਪਨ ਚਲਿਤ ਆਪਿ ਕਰਨੈਹਾਰ ॥",
      "transliteration": "aapan chalit aap karanaihaar ||",
      "translation": "He Himself is the Performer in His own plays;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਨਕ ਠਾਕੁਰ ਅਗਮ ਅਪਾਰ ॥੨॥",
      "transliteration": "naanak thaakur agam apaar ||2||",
      "translation": "O Nanak, the Lord Master is Unfathomable and Infinite. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਬਿਨਾਸੀ ਸੁਖ ਆਪਨ ਆਸਨ ॥",
      "transliteration": "abinaasee sukh aapan aasan ||",
      "translation": "When the Immortal Lord was seated at ease,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਹ ਜਨਮ ਮਰਨ ਕਹੁ ਕਹਾ ਬਿਨਾਸਨ ॥",
      "transliteration": "tah janam maran kahu kahaa binaasan ||",
      "translation": "then where was birth, death and dissolution?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਬ ਪੂਰਨ ਕਰਤਾ ਪ੍ਰਭੁ ਸੋਇ ॥",
      "transliteration": "jab pooran karataa prabh soi ||",
      "translation": "When there was only God, the Perfect Creator,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਬ ਜਮ ਕੀ ਤ੍ਰਾਸ ਕਹਹੁ ਕਿਸੁ ਹੋਇ ॥",
      "transliteration": "tab jam kee traas kahahu kis hoi ||",
      "translation": "then who was afraid of death?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਬ ਅਬਿਗਤ ਅਗੋਚਰ ਪ੍ਰਭ ਏਕਾ ॥",
      "transliteration": "jab abigat agochar prabh ekaa ||",
      "translation": "When there was only the One Lord, unmanifest and incomprehensible,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਬ ਚਿਤ੍ਰ ਗੁਪਤ ਕਿਸੁ ਪੂਛਤ ਲੇਖਾ ॥",
      "transliteration": "tab chitr gupat kis poochhat lekhaa ||",
      "translation": "then who was called to account by the recording scribes of the conscious and the subconscious?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਬ ਨਾਥ ਨਿਰੰਜਨ ਅਗੋਚਰ ਅਗਾਧੇ ॥",
      "transliteration": "jab naath nira(n)jan agochar agaadhe ||",
      "translation": "When there was only the Immaculate, Incomprehensible, Unfathomable Master,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਬ ਕਉਨ ਛੁਟੇ ਕਉਨ ਬੰਧਨ ਬਾਧੇ ॥",
      "transliteration": "tab kaun chhute kaun ba(n)dhan baadhe ||",
      "translation": "then who was emancipated, and who was held in bondage?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਪਨ ਆਪ ਆਪ ਹੀ ਅਚਰਜਾ ॥",
      "transliteration": "aapan aap aap hee acharajaa ||",
      "translation": "He Himself, in and of Himself, is the most wonderful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਨਕ ਆਪਨ ਰੂਪ ਆਪ ਹੀ ਉਪਰਜਾ ॥੩॥",
      "transliteration": "naanak aapan roop aap hee uparajaa ||3||",
      "translation": "O Nanak, He Himself created His Own Form. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਹ ਨਿਰਮਲ ਪੁਰਖੁ ਪੁਰਖ ਪਤਿ ਹੋਤਾ ॥",
      "transliteration": "jah niramal purakh purakh pat hotaa ||",
      "translation": "When there was only the Immaculate Being, the Lord of beings,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਹ ਬਿਨੁ ਮੈਲੁ ਕਹਹੁ ਕਿਆ ਧੋਤਾ ॥",
      "transliteration": "tah bin mail kahahu kiaa dhotaa ||",
      "translation": "there was no filth, so what was there to be washed clean?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਹ ਨਿਰੰਜਨ ਨਿਰੰਕਾਰ ਨਿਰਬਾਨ ॥",
      "transliteration": "jah nira(n)jan nira(n)kaar nirabaan ||",
      "translation": "When there was only the Pure, Formless Lord in Nirvaanaa,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਹ ਕਉਨ ਕਉ ਮਾਨ ਕਉਨ ਅਭਿਮਾਨ ॥",
      "transliteration": "tah kaun kau maan kaun abhimaan ||",
      "translation": "then who was honored, and who was dishonored?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਹ ਸਰੂਪ ਕੇਵਲ ਜਗਦੀਸ ॥",
      "transliteration": "jah saroop keval jagadees ||",
      "translation": "When there was only the Form of the Lord of the Universe,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਹ ਛਲ ਛਿਦ੍ਰ ਲਗਤ ਕਹੁ ਕੀਸ ॥",
      "transliteration": "tah chhal chhidr lagat kahu kees ||",
      "translation": "then who was tainted by fraud and sin?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਹ ਜੋਤਿ ਸਰੂਪੀ ਜੋਤਿ ਸੰਗਿ ਸਮਾਵੈ ॥",
      "transliteration": "jah jot saroopee jot sa(n)g samaavai ||",
      "translation": "When the Embodiment of Light was immersed in His Own Light,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਹ ਕਿਸਹਿ ਭੂਖ ਕਵਨੁ ਤ੍ਰਿਪਤਾਵੈ ॥",
      "transliteration": "tah kisahi bhookh kavan tripataavai ||",
      "translation": "then who was hungry, and who was satisfied?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਕਰਨੈਹਾਰੁ ॥",
      "transliteration": "karan karaavan karanaihaar ||",
      "translation": "He is the Cause of causes, the Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਨਕ ਕਰਤੇ ਕਾ ਨਾਹਿ ਸੁਮਾਰੁ ॥੪॥",
      "transliteration": "naanak karate kaa naahi sumaar ||4||",
      "translation": "O Nanak, the Creator is beyond calculation. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਬ ਅਪਨੀ ਸੋਭਾ ਆਪਨ ਸੰਗਿ ਬਨਾਈ ॥",
      "transliteration": "jab apanee sobhaa aapan sa(n)g banaaee ||",
      "translation": "When His Glory was contained within Himself,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਬ ਕਵਨ ਮਾਇ ਬਾਪ ਮਿਤ੍ਰ ਸੁਤ ਭਾਈ ॥",
      "transliteration": "tab kavan maai baap mitr sut bhaaee ||",
      "translation": "then who was mother, father, friend, child or sibling?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਹ ਸਰਬ ਕਲਾ ਆਪਹਿ ਪਰਬੀਨ ॥",
      "transliteration": "jah sarab kalaa aapahi parabeen ||",
      "translation": "When all power and wisdom was latent within Him,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਹ ਬੇਦ ਕਤੇਬ ਕਹਾ ਕੋਊ ਚੀਨ ॥",
      "transliteration": "tah bed kateb kahaa kooo cheen ||",
      "translation": "then where were the Vedas and the scriptures, and who was there to read them?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਬ ਆਪਨ ਆਪੁ ਆਪਿ ਉਰਿ ਧਾਰੈ ॥",
      "transliteration": "jab aapan aap aap ur dhaarai ||",
      "translation": "When He kept Himself, All-in-all, unto His Own Heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਉ ਸਗਨ ਅਪਸਗਨ ਕਹਾ ਬੀਚਾਰੈ ॥",
      "transliteration": "tau sagan apasagan kahaa beechaarai ||",
      "translation": "then who considered omens to be good or bad?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਹ ਆਪਨ ਊਚ ਆਪਨ ਆਪਿ ਨੇਰਾ ॥",
      "transliteration": "jah aapan ooch aapan aap neraa ||",
      "translation": "When He Himself was lofty, and He Himself was near at hand,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਹ ਕਉਨ ਠਾਕੁਰੁ ਕਉਨੁ ਕਹੀਐ ਚੇਰਾ ॥",
      "transliteration": "tah kaun thaakur kaun kaheeai cheraa ||",
      "translation": "then who was called master, and who was called disciple?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਿਸਮਨ ਬਿਸਮ ਰਹੇ ਬਿਸਮਾਦ ॥",
      "transliteration": "bisaman bisam rahe bisamaad ||",
      "translation": "We are wonder-struck at the wondrous wonder of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਨਕ ਅਪਨੀ ਗਤਿ ਜਾਨਹੁ ਆਪਿ ॥੫॥",
      "transliteration": "naanak apanee gat jaanahu aap ||5||",
      "translation": "O Nanak, He alone knows His own state. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਹ ਅਛਲ ਅਛੇਦ ਅਭੇਦ ਸਮਾਇਆ ॥",
      "transliteration": "jah achhal achhed abhed samaaiaa ||",
      "translation": "When the Undeceiveable, Impenetrable, Inscrutable One was self-absorbed,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਊਹਾ ਕਿਸਹਿ ਬਿਆਪਤ ਮਾਇਆ ॥",
      "transliteration": "oohaa kisahi biaapat maaiaa ||",
      "translation": "then who was swayed by Maya?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਪਸ ਕਉ ਆਪਹਿ ਆਦੇਸੁ ॥",
      "transliteration": "aapas kau aapahi aades ||",
      "translation": "When He paid homage to Himself,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਿਹੁ ਗੁਣ ਕਾ ਨਾਹੀ ਪਰਵੇਸੁ ॥",
      "transliteration": "tihu gun kaa naahee paraves ||",
      "translation": "then the three qualities were not prevailing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਹ ਏਕਹਿ ਏਕ ਏਕ ਭਗਵੰਤਾ ॥",
      "transliteration": "jah ekahi ek ek bhagava(n)taa ||",
      "translation": "When there was only the One, the One and Only Lord God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਹ ਕਉਨੁ ਅਚਿੰਤੁ ਕਿਸੁ ਲਾਗੈ ਚਿੰਤਾ ॥",
      "transliteration": "tah kaun achi(n)t kis laagai chi(n)taa ||",
      "translation": "then who was not anxious, and who felt anxiety?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਹ ਆਪਨ ਆਪੁ ਆਪਿ ਪਤੀਆਰਾ ॥",
      "transliteration": "jah aapan aap aap pateeaaraa ||",
      "translation": "When He Himself was satisfied with Himself,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਹ ਕਉਨੁ ਕਥੈ ਕਉਨੁ ਸੁਨਨੈਹਾਰਾ ॥",
      "transliteration": "tah kaun kathai kaun sunanaihaaraa ||",
      "translation": "then who spoke and who listened?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬਹੁ ਬੇਅੰਤ ਊਚ ਤੇ ਊਚਾ ॥",
      "transliteration": "bahu bea(n)t ooch te oochaa ||",
      "translation": "He is vast and infinite, the highest of the high.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾਨਕ ਆਪਸ ਕਉ ਆਪਹਿ ਪਹੂਚਾ ॥੬॥",
      "transliteration": "naanak aapas kau aapahi pahoochaa ||6||",
      "translation": "O Nanak, He alone can reach Himself. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਹ ਆਪਿ ਰਚਿਓ ਪਰਪੰਚੁ ਅਕਾਰੁ ॥",
      "transliteration": "jah aap rachio parapa(n)ch akaar ||",
      "translation": "When He Himself fashioned the visible world of the creation,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਿਹੁ ਗੁਣ ਮਹਿ ਕੀਨੋ ਬਿਸਥਾਰੁ ॥",
      "transliteration": "tihu gun mahi keeno bisathaar ||",
      "translation": "he made the world subject to the three dispositions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0291_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪਾਪੁ ਪੁੰਨੁ ਤਹ ਭਈ ਕਹਾਵਤ ॥",
      "transliteration": "paap pu(n)n tah bhaee kahaavat ||",
      "translation": "Sin and virtue then began to be spoken of.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 291,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
