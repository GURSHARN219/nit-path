{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 292,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0292_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕੋਊ ਨਰਕ ਕੋਊ ਸੁਰਗ ਬੰਛਾਵਤ ॥",
      "transliteration": "kooo narak kooo surag ba(n)chhaavat ||",
      "translation": "Some have gone to hell, and some yearn for paradise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਲ ਜਾਲ ਮਾਇਆ ਜੰਜਾਲ ॥",
      "transliteration": "aal jaal maaiaa ja(n)jaal ||",
      "translation": "Worldly snares and entanglements of Maya,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਉਮੈ ਮੋਹ ਭਰਮ ਭੈ ਭਾਰ ॥",
      "transliteration": "haumai moh bharam bhai bhaar ||",
      "translation": "egotism, attachment, doubt and loads of fear;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦੂਖ ਸੂਖ ਮਾਨ ਅਪਮਾਨ ॥",
      "transliteration": "dookh sookh maan apamaan ||",
      "translation": "pain and pleasure, honor and dishonor",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਨਿਕ ਪ੍ਰਕਾਰ ਕੀਓ ਬਖੵਾਨ ॥",
      "transliteration": "anik prakaar keeo bakhyaan ||",
      "translation": "these came to be described in various ways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਪਨ ਖੇਲੁ ਆਪਿ ਕਰਿ ਦੇਖੈ ॥",
      "transliteration": "aapan khel aap kar dekhai ||",
      "translation": "He Himself creates and beholds His own drama.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਖੇਲੁ ਸੰਕੋਚੈ ਤਉ ਨਾਨਕ ਏਕੈ ॥੭॥",
      "transliteration": "khel sa(n)kochai tau naanak ekai ||7||",
      "translation": "He winds up the drama, and then, O Nanak, He alone remains. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਹ ਅਬਿਗਤੁ ਭਗਤੁ ਤਹ ਆਪਿ ॥",
      "transliteration": "jah abigat bhagat tah aap ||",
      "translation": "Wherever the Eternal Lord's devotee is, He Himself is there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਹ ਪਸਰੈ ਪਾਸਾਰੁ ਸੰਤ ਪਰਤਾਪਿ ॥",
      "transliteration": "jah pasarai paasaar sa(n)t parataap ||",
      "translation": "He unfolds the expanse of His creation for the glory of His Saint.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੁਹੂ ਪਾਖ ਕਾ ਆਪਹਿ ਧਨੀ ॥",
      "transliteration": "duhoo paakh kaa aapahi dhanee ||",
      "translation": "He Himself is the Master of both worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਉਨ ਕੀ ਸੋਭਾ ਉਨਹੂ ਬਨੀ ॥",
      "transliteration": "un kee sobhaa unahoo banee ||",
      "translation": "His Praise is to Himself alone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਆਪਹਿ ਕਉਤਕ ਕਰੈ ਅਨਦ ਚੋਜ ॥",
      "transliteration": "aapahi kautak karai anad choj ||",
      "translation": "He Himself performs and plays His amusements and games.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਪਹਿ ਰਸ ਭੋਗਨ ਨਿਰਜੋਗ ॥",
      "transliteration": "aapahi ras bhogan nirajog ||",
      "translation": "He Himself enjoys pleasures, and yet He is unaffected and untouched.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਸੁ ਭਾਵੈ ਤਿਸੁ ਆਪਨ ਨਾਇ ਲਾਵੈ ॥",
      "transliteration": "jis bhaavai tis aapan naai laavai ||",
      "translation": "He attaches whomever He pleases to His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਸੁ ਭਾਵੈ ਤਿਸੁ ਖੇਲ ਖਿਲਾਵੈ ॥",
      "transliteration": "jis bhaavai tis khel khilaavai ||",
      "translation": "He causes whomever He pleases to play in His play.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬੇਸੁਮਾਰ ਅਥਾਹ ਅਗਨਤ ਅਤੋਲੈ ॥",
      "transliteration": "besumaar athaah aganat atolai ||",
      "translation": "He is beyond calculation, beyond measure, uncountable and unfathomable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਉ ਬੁਲਾਵਹੁ ਤਿਉ ਨਾਨਕ ਦਾਸ ਬੋਲੈ ॥੮॥੨੧॥",
      "transliteration": "jiu bulaavahu tiu naanak daas bolai ||8||21||",
      "translation": "As You inspire him to speak, O Lord, so does servant Nanak speak. ||8||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਕੇ ਠਾਕੁਰਾ ਆਪੇ ਵਰਤਣਹਾਰ ॥",
      "transliteration": "jee ja(n)t ke thaakuraa aape varatanahaar ||",
      "translation": "O Lord and Master of all beings and creatures, You Yourself are prevailing everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਨਕ ਏਕੋ ਪਸਰਿਆ ਦੂਜਾ ਕਹ ਦ੍ਰਿਸਟਾਰ ॥੧॥",
      "transliteration": "naanak eko pasariaa doojaa kah drisataar ||1||",
      "translation": "O Nanak, The One is All-pervading; where is any other to be seen? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਪਿ ਕਥੈ ਆਪਿ ਸੁਨਨੈਹਾਰੁ ॥",
      "transliteration": "aap kathai aap sunanaihaar ||",
      "translation": "He Himself is the speaker, and He Himself is the listener.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਪਹਿ ਏਕੁ ਆਪਿ ਬਿਸਥਾਰੁ ॥",
      "transliteration": "aapahi ek aap bisathaar ||",
      "translation": "He Himself is the One, and He Himself is the many.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਾ ਤਿਸੁ ਭਾਵੈ ਤਾ ਸ੍ਰਿਸਟਿ ਉਪਾਏ ॥",
      "transliteration": "jaa tis bhaavai taa srisat upaae ||",
      "translation": "When it pleases Him, He creates the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਪਨੈ ਭਾਣੈ ਲਏ ਸਮਾਏ ॥",
      "transliteration": "aapanai bhaanai lae samaae ||",
      "translation": "As He pleases, He absorbs it back into Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤੁਮ ਤੇ ਭਿੰਨ ਨਹੀ ਕਿਛੁ ਹੋਇ ॥",
      "transliteration": "tum te bhi(n)n nahee kichh hoi ||",
      "translation": "Without You, nothing can be done.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਆਪਨ ਸੂਤਿ ਸਭੁ ਜਗਤੁ ਪਰੋਇ ॥",
      "transliteration": "aapan soot sabh jagat paroi ||",
      "translation": "Upon Your thread, You have strung the whole world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾ ਕਉ ਪ੍ਰਭ ਜੀਉ ਆਪਿ ਬੁਝਾਏ ॥",
      "transliteration": "jaa kau prabh jeeu aap bujhaae ||",
      "translation": "One whom God Himself inspires to understand",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਚੁ ਨਾਮੁ ਸੋਈ ਜਨੁ ਪਾਏ ॥",
      "transliteration": "sach naam soee jan paae ||",
      "translation": "- that person obtains the True Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੋ ਸਮਦਰਸੀ ਤਤ ਕਾ ਬੇਤਾ ॥",
      "transliteration": "so samadarasee tat kaa betaa ||",
      "translation": "He looks impartially upon all, and he knows the essential reality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾਨਕ ਸਗਲ ਸ੍ਰਿਸਟਿ ਕਾ ਜੇਤਾ ॥੧॥",
      "transliteration": "naanak sagal srisat kaa jetaa ||1||",
      "translation": "O Nanak, he conquers the whole world. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੀਅ ਜੰਤ੍ਰ ਸਭ ਤਾ ਕੈ ਹਾਥ ॥",
      "transliteration": "jee ja(n)tr sabh taa kai haath ||",
      "translation": "All beings and creatures are in His Hands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੀਨ ਦਇਆਲ ਅਨਾਥ ਕੋ ਨਾਥੁ ॥",
      "transliteration": "deen daiaal anaath ko naath ||",
      "translation": "He is Merciful to the meek, the Patron of the patronless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਿਸੁ ਰਾਖੈ ਤਿਸੁ ਕੋਇ ਨ ਮਾਰੈ ॥",
      "transliteration": "jis raakhai tis koi na maarai ||",
      "translation": "No one can kill those who are protected by Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੋ ਮੂਆ ਜਿਸੁ ਮਨਹੁ ਬਿਸਾਰੈ ॥",
      "transliteration": "so mooaa jis manahu bisaarai ||",
      "translation": "One who is forgotten by God, is already dead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਿਸੁ ਤਜਿ ਅਵਰ ਕਹਾ ਕੋ ਜਾਇ ॥",
      "transliteration": "tis taj avar kahaa ko jaai ||",
      "translation": "Leaving Him, where else could anyone go?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਭ ਸਿਰਿ ਏਕੁ ਨਿਰੰਜਨ ਰਾਇ ॥",
      "transliteration": "sabh sir ek nira(n)jan raai ||",
      "translation": "Over the heads of all is the One, the Immaculate King.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੀਅ ਕੀ ਜੁਗਤਿ ਜਾ ਕੈ ਸਭ ਹਾਥਿ ॥",
      "transliteration": "jee kee jugat jaa kai sabh haath ||",
      "translation": "The ways and means of all beings are in His Hands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅੰਤਰਿ ਬਾਹਰਿ ਜਾਨਹੁ ਸਾਥਿ ॥",
      "transliteration": "a(n)tar baahar jaanahu saath ||",
      "translation": "Inwardly and outwardly, know that He is with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਨ ਨਿਧਾਨ ਬੇਅੰਤ ਅਪਾਰ ॥",
      "transliteration": "gun nidhaan bea(n)t apaar ||",
      "translation": "He is the Ocean of excellence, infinite and endless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਸਦਾ ਬਲਿਹਾਰ ॥੨॥",
      "transliteration": "naanak daas sadaa balihaar ||2||",
      "translation": "Slave Nanak is forever a sacrifice to Him. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪੂਰਨ ਪੂਰਿ ਰਹੇ ਦਇਆਲ ॥",
      "transliteration": "pooran poor rahe daiaal ||",
      "translation": "The Perfect, Merciful Lord is pervading everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਭ ਊਪਰਿ ਹੋਵਤ ਕਿਰਪਾਲ ॥",
      "transliteration": "sabh oopar hovat kirapaal ||",
      "translation": "His kindness extends to all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਪਨੇ ਕਰਤਬ ਜਾਨੈ ਆਪਿ ॥",
      "transliteration": "apane karatab jaanai aap ||",
      "translation": "He Himself knows His own ways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅੰਤਰਜਾਮੀ ਰਹਿਓ ਬਿਆਪਿ ॥",
      "transliteration": "a(n)tarajaamee rahio biaap ||",
      "translation": "The Inner-knower, the Searcher of hearts, is present everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਤਿਪਾਲੈ ਜੀਅਨ ਬਹੁ ਭਾਤਿ ॥",
      "transliteration": "pratipaalai jeean bahu bhaat ||",
      "translation": "He cherishes His living beings in so many ways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੋ ਜੋ ਰਚਿਓ ਸੁ ਤਿਸਹਿ ਧਿਆਤਿ ॥",
      "transliteration": "jo jo rachio s tisahi dhiaat ||",
      "translation": "That which He has created meditates on Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਿਸੁ ਭਾਵੈ ਤਿਸੁ ਲਏ ਮਿਲਾਇ ॥",
      "transliteration": "jis bhaavai tis lae milaai ||",
      "translation": "Whoever pleases Him, He blends into Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਭਗਤਿ ਕਰਹਿ ਹਰਿ ਕੇ ਗੁਣ ਗਾਇ ॥",
      "transliteration": "bhagat karahi har ke gun gaai ||",
      "translation": "They perform His devotional service and sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਮਨ ਅੰਤਰਿ ਬਿਸ੍ਵਾਸੁ ਕਰਿ ਮਾਨਿਆ ॥",
      "transliteration": "man a(n)tar bisvaas kar maaniaa ||",
      "translation": "With heart-felt faith, they believe in Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਰਨਹਾਰੁ ਨਾਨਕ ਇਕੁ ਜਾਨਿਆ ॥੩॥",
      "transliteration": "karanahaar naanak ik jaaniaa ||3||",
      "translation": "O Nanak, they realize the One, the Creator Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਨੁ ਲਾਗਾ ਹਰਿ ਏਕੈ ਨਾਇ ॥",
      "transliteration": "jan laagaa har ekai naai ||",
      "translation": "The Lord's humble servant is committed to His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਿਸ ਕੀ ਆਸ ਨ ਬਿਰਥੀ ਜਾਇ ॥",
      "transliteration": "tis kee aas na birathee jaai ||",
      "translation": "His hopes do not go in vain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੇਵਕ ਕਉ ਸੇਵਾ ਬਨਿ ਆਈ ॥",
      "transliteration": "sevak kau sevaa ban aaee ||",
      "translation": "The servant's purpose is to serve;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਹੁਕਮੁ ਬੂਝਿ ਪਰਮ ਪਦੁ ਪਾਈ ॥",
      "transliteration": "hukam boojh param pad paaee ||",
      "translation": "obeying the Lord's Command, the supreme status is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਇਸ ਤੇ ਊਪਰਿ ਨਹੀ ਬੀਚਾਰੁ ॥",
      "transliteration": "is te oopar nahee beechaar ||",
      "translation": "Beyond this, he has no other thought.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਾ ਕੈ ਮਨਿ ਬਸਿਆ ਨਿਰੰਕਾਰੁ ॥",
      "transliteration": "jaa kai man basiaa nira(n)kaar ||",
      "translation": "Within his mind, the Formless Lord abides.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਬੰਧਨ ਤੋਰਿ ਭਏ ਨਿਰਵੈਰ ॥",
      "transliteration": "ba(n)dhan tor bhae niravair ||",
      "translation": "His bonds are cut away, and he becomes free of hatred.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਅਨਦਿਨੁ ਪੂਜਹਿ ਗੁਰ ਕੇ ਪੈਰ ॥",
      "transliteration": "anadin poojahi gur ke pair ||",
      "translation": "Night and day, he worships the Feet of the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0292_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਇਹ ਲੋਕ ਸੁਖੀਏ ਪਰਲੋਕ ਸੁਹੇਲੇ ॥",
      "transliteration": "ih lok sukheee paralok suhele ||",
      "translation": "He is at peace in this world, and happy in the next.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 292,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
