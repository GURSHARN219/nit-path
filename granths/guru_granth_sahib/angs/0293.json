{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 293,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0293_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਪ੍ਰਭਿ ਆਪਹਿ ਮੇਲੇ ॥੪॥",
      "transliteration": "naanak har prabh aapahi mele ||4||",
      "translation": "O Nanak, the Lord God unites him with Himself. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਮਿਲਿ ਕਰਹੁ ਅਨੰਦ ॥",
      "transliteration": "saadhasa(n)g mil karahu ana(n)d ||",
      "translation": "Join the Company of the Holy, and be happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੁਨ ਗਾਵਹੁ ਪ੍ਰਭ ਪਰਮਾਨੰਦ ॥",
      "transliteration": "gun gaavahu prabh paramaana(n)d ||",
      "translation": "Sing the Glories of God, the embodiment of supreme bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਤਤੁ ਕਰਹੁ ਬੀਚਾਰੁ ॥",
      "transliteration": "raam naam tat karahu beechaar ||",
      "translation": "Contemplate the essence of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦ੍ਰੁਲਭ ਦੇਹ ਕਾ ਕਰਹੁ ਉਧਾਰੁ ॥",
      "transliteration": "drulabh deh kaa karahu udhaar ||",
      "translation": "Redeem this human body, so difficult to obtain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਬਚਨ ਹਰਿ ਕੇ ਗੁਨ ਗਾਉ ॥",
      "transliteration": "a(n)mrit bachan har ke gun gaau ||",
      "translation": "Sing the Ambrosial Words of the Lord's Glorious Praises;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪ੍ਰਾਨ ਤਰਨ ਕਾ ਇਹੈ ਸੁਆਉ ॥",
      "transliteration": "praan taran kaa ihai suaau ||",
      "translation": "this is the way to save your mortal soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਠ ਪਹਰ ਪ੍ਰਭ ਪੇਖਹੁ ਨੇਰਾ ॥",
      "transliteration": "aath pahar prabh pekhahu neraa ||",
      "translation": "Behold God near at hand, twenty-four hours a day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਿਟੈ ਅਗਿਆਨੁ ਬਿਨਸੈ ਅੰਧੇਰਾ ॥",
      "transliteration": "mitai agiaan binasai a(n)dheraa ||",
      "translation": "Ignorance shall depart, and darkness shall be dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁਨਿ ਉਪਦੇਸੁ ਹਿਰਦੈ ਬਸਾਵਹੁ ॥",
      "transliteration": "sun upades hiradai basaavahu ||",
      "translation": "Listen to the Teachings, and enshrine them in your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਨ ਇਛੇ ਨਾਨਕ ਫਲ ਪਾਵਹੁ ॥੫॥",
      "transliteration": "man ichhe naanak phal paavahu ||5||",
      "translation": "O Nanak, you shall obtain the fruits of your mind's desires. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਲਤੁ ਪਲਤੁ ਦੁਇ ਲੇਹੁ ਸਵਾਰਿ ॥",
      "transliteration": "halat palat dui lehu savaar ||",
      "translation": "Embellish both this world and the next;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਅੰਤਰਿ ਉਰਿ ਧਾਰਿ ॥",
      "transliteration": "raam naam a(n)tar ur dhaar ||",
      "translation": "enshrine the Lord's Name deep within your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਕੀ ਪੂਰੀ ਦੀਖਿਆ ॥",
      "transliteration": "poore gur kee pooree deekhiaa ||",
      "translation": "Perfect are the Teachings of the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਸੁ ਮਨਿ ਬਸੈ ਤਿਸੁ ਸਾਚੁ ਪਰੀਖਿਆ ॥",
      "transliteration": "jis man basai tis saach pareekhiaa ||",
      "translation": "That person, within whose mind it abides, realizes the Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਨਿ ਤਨਿ ਨਾਮੁ ਜਪਹੁ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "man tan naam japahu liv laai ||",
      "translation": "With your mind and body, chant the Naam; lovingly attune yourself to it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੂਖੁ ਦਰਦੁ ਮਨ ਤੇ ਭਉ ਜਾਇ ॥",
      "transliteration": "dookh darad man te bhau jaai ||",
      "translation": "Sorrow, pain and fear shall depart from your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਚੁ ਵਾਪਾਰੁ ਕਰਹੁ ਵਾਪਾਰੀ ॥",
      "transliteration": "sach vaapaar karahu vaapaaree ||",
      "translation": "Deal in the true trade, O trader,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦਰਗਹ ਨਿਬਹੈ ਖੇਪ ਤੁਮਾਰੀ ॥",
      "transliteration": "daragah nibahai khep tumaaree ||",
      "translation": "and your merchandise shall be safe in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਏਕਾ ਟੇਕ ਰਖਹੁ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "ekaa tek rakhahu man maahi ||",
      "translation": "Keep the Support of the One in your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਨਕ ਬਹੁਰਿ ਨ ਆਵਹਿ ਜਾਹਿ ॥੬॥",
      "transliteration": "naanak bahur na aavahi jaahi ||6||",
      "translation": "O Nanak, you shall not have to come and go in reincarnation again. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਿਸ ਤੇ ਦੂਰਿ ਕਹਾ ਕੋ ਜਾਇ ॥",
      "transliteration": "tis te door kahaa ko jaai ||",
      "translation": "Where can anyone go, to get away from Him?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਉਬਰੈ ਰਾਖਨਹਾਰੁ ਧਿਆਇ ॥",
      "transliteration": "ubarai raakhanahaar dhiaai ||",
      "translation": "Meditating on the Protector Lord, you shall be saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਿਰਭਉ ਜਪੈ ਸਗਲ ਭਉ ਮਿਟੈ ॥",
      "transliteration": "nirabhau japai sagal bhau mitai ||",
      "translation": "Meditating on the Fearless Lord, all fear departs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ ਪ੍ਰਾਣੀ ਛੁਟੈ ॥",
      "transliteration": "prabh kirapaa te praanee chhutai ||",
      "translation": "By God's Grace, mortals are released.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਿਸੁ ਪ੍ਰਭੁ ਰਾਖੈ ਤਿਸੁ ਨਾਹੀ ਦੂਖ ॥",
      "transliteration": "jis prabh raakhai tis naahee dookh ||",
      "translation": "One who is protected by God never suffers in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਮਨਿ ਹੋਵਤ ਸੂਖ ॥",
      "transliteration": "naam japat man hovat sookh ||",
      "translation": "Chanting the Naam, the mind becomes peaceful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚਿੰਤਾ ਜਾਇ ਮਿਟੈ ਅਹੰਕਾਰੁ ॥",
      "transliteration": "chi(n)taa jaai mitai aha(n)kaar ||",
      "translation": "Anxiety departs, and ego is eliminated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਕਉ ਕੋਇ ਨ ਪਹੁਚਨਹਾਰੁ ॥",
      "transliteration": "tis jan kau koi na pahuchanahaar ||",
      "translation": "No one can equal that humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਿਰ ਊਪਰਿ ਠਾਢਾ ਗੁਰੁ ਸੂਰਾ ॥",
      "transliteration": "sir oopar thaadhaa gur sooraa ||",
      "translation": "The Brave and Powerful Guru stands over his head.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕੇ ਕਾਰਜ ਪੂਰਾ ॥੭॥",
      "transliteration": "naanak taa ke kaaraj pooraa ||7||",
      "translation": "O Nanak, his efforts are fulfilled. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਤਿ ਪੂਰੀ ਅੰਮ੍ਰਿਤੁ ਜਾ ਕੀ ਦ੍ਰਿਸਟਿ ॥",
      "transliteration": "mat pooree a(n)mrit jaa kee drisat ||",
      "translation": "His wisdom is perfect, and His Glance is Ambrosial.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦਰਸਨੁ ਪੇਖਤ ਉਧਰਤ ਸ੍ਰਿਸਟਿ ॥",
      "transliteration": "darasan pekhat udharat srisat ||",
      "translation": "Beholding His Vision, the universe is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਜਾ ਕੇ ਅਨੂਪ ॥",
      "transliteration": "charan kamal jaa ke anoop ||",
      "translation": "His Lotus Feet are incomparably beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਫਲ ਦਰਸਨੁ ਸੁੰਦਰ ਹਰਿ ਰੂਪ ॥",
      "transliteration": "saphal darasan su(n)dar har roop ||",
      "translation": "The Blessed Vision of His Darshan is fruitful and rewarding; His Lordly Form is beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਧੰਨੁ ਸੇਵਾ ਸੇਵਕੁ ਪਰਵਾਨੁ ॥",
      "transliteration": "dha(n)n sevaa sevak paravaan ||",
      "translation": "Blessed is His service; His servant is famous.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅੰਤਰਜਾਮੀ ਪੁਰਖੁ ਪ੍ਰਧਾਨੁ ॥",
      "transliteration": "a(n)tarajaamee purakh pradhaan ||",
      "translation": "The Inner-knower, the Searcher of hearts, is the most exalted Supreme Being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਸੁ ਮਨਿ ਬਸੈ ਸੁ ਹੋਤ ਨਿਹਾਲੁ ॥",
      "transliteration": "jis man basai s hot nihaal ||",
      "translation": "That one, within whose mind He abides, is blissfully happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਾ ਕੈ ਨਿਕਟਿ ਨ ਆਵਤ ਕਾਲੁ ॥",
      "transliteration": "taa kai nikat na aavat kaal ||",
      "translation": "Death does not draw near him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਮਰ ਭਏ ਅਮਰਾ ਪਦੁ ਪਾਇਆ ॥",
      "transliteration": "amar bhae amaraa pad paaiaa ||",
      "translation": "One becomes immortal, and obtains the immortal status,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਨਾਨਕ ਹਰਿ ਧਿਆਇਆ ॥੮॥੨੨॥",
      "transliteration": "saadhasa(n)g naanak har dhiaaiaa ||8||22||",
      "translation": "meditating on the Lord, O Nanak, in the Company of the Holy. ||8||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗਿਆਨ ਅੰਜਨੁ ਗੁਰਿ ਦੀਆ ਅਗਿਆਨ ਅੰਧੇਰ ਬਿਨਾਸੁ ॥",
      "transliteration": "giaan a(n)jan gur deeaa agiaan a(n)dher binaas ||",
      "translation": "The Guru has given the healing ointment of spiritual wisdom, and dispelled the darkness of ignorance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਰਿ ਕਿਰਪਾ ਤੇ ਸੰਤ ਭੇਟਿਆ ਨਾਨਕ ਮਨਿ ਪਰਗਾਸੁ ॥੧॥",
      "transliteration": "har kirapaa te sa(n)t bhetiaa naanak man paragaas ||1||",
      "translation": "By the Lord's Grace, I have met the Saint; O Nanak, my mind is enlightened. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੰਤਸੰਗਿ ਅੰਤਰਿ ਪ੍ਰਭੁ ਡੀਠਾ ॥",
      "transliteration": "sa(n)tasa(n)g a(n)tar prabh deethaa ||",
      "translation": "In the Society of the Saints, I see God deep within my being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਮੁ ਪ੍ਰਭੂ ਕਾ ਲਾਗਾ ਮੀਠਾ ॥",
      "transliteration": "naam prabhoo kaa laagaa meethaa ||",
      "translation": "God's Name is sweet to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਗਲ ਸਮਿਗ੍ਰੀ ਏਕਸੁ ਘਟ ਮਾਹਿ ॥",
      "transliteration": "sagal samigree ekas ghat maahi ||",
      "translation": "All things are contained in the Heart of the One,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਨਿਕ ਰੰਗ ਨਾਨਾ ਦ੍ਰਿਸਟਾਹਿ ॥",
      "transliteration": "anik ra(n)g naanaa drisataahi ||",
      "translation": "although they appear in so many various colors.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਉ ਨਿਧਿ ਅੰਮ੍ਰਿਤੁ ਪ੍ਰਭ ਕਾ ਨਾਮੁ ॥",
      "transliteration": "nau nidh a(n)mrit prabh kaa naam ||",
      "translation": "The nine treasures are in the Ambrosial Name of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਦੇਹੀ ਮਹਿ ਇਸ ਕਾ ਬਿਸ੍ਰਾਮੁ ॥",
      "transliteration": "dehee mahi is kaa bisraam ||",
      "translation": "Within the human body is its place of rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੁੰਨ ਸਮਾਧਿ ਅਨਹਤ ਤਹ ਨਾਦ ॥",
      "transliteration": "su(n)n samaadh anahat tah naad ||",
      "translation": "The Deepest Samaadhi, and the unstruck sound current of the Naad are there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਹਨੁ ਨ ਜਾਈ ਅਚਰਜ ਬਿਸਮਾਦ ॥",
      "transliteration": "kahan na jaaee acharaj bisamaad ||",
      "translation": "The wonder and marvel of it cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਿਨਿ ਦੇਖਿਆ ਜਿਸੁ ਆਪਿ ਦਿਖਾਏ ॥",
      "transliteration": "tin dekhiaa jis aap dikhaae ||",
      "translation": "He alone sees it, unto whom God Himself reveals it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਨਕ ਤਿਸੁ ਜਨ ਸੋਝੀ ਪਾਏ ॥੧॥",
      "transliteration": "naanak tis jan sojhee paae ||1||",
      "translation": "O Nanak, that humble being understands. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸੋ ਅੰਤਰਿ ਸੋ ਬਾਹਰਿ ਅਨੰਤ ॥",
      "transliteration": "so a(n)tar so baahar ana(n)t ||",
      "translation": "The Infinite Lord is inside, and outside as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਬਿਆਪਿ ਰਹਿਆ ਭਗਵੰਤ ॥",
      "transliteration": "ghat ghat biaap rahiaa bhagava(n)t ||",
      "translation": "Deep within each and every heart, the Lord God is pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਧਰਨਿ ਮਾਹਿ ਆਕਾਸ ਪਇਆਲ ॥",
      "transliteration": "dharan maahi aakaas paiaal ||",
      "translation": "In the earth, in the Akaashic ethers, and in the nether regions of the underworld",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0293_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸਰਬ ਲੋਕ ਪੂਰਨ ਪ੍ਰਤਿਪਾਲ ॥",
      "transliteration": "sarab lok pooran pratipaal ||",
      "translation": "in all worlds, He is the Perfect Cherisher.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 293,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
