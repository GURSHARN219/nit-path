{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 294,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0294_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਨਿ ਤਿਨਿ ਪਰਬਤਿ ਹੈ ਪਾਰਬ੍ਰਹਮੁ ॥",
      "transliteration": "ban tin parabat hai paarabraham ||",
      "translation": "In the forests, fields and mountains, He is the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜੈਸੀ ਆਗਿਆ ਤੈਸਾ ਕਰਮੁ ॥",
      "transliteration": "jaisee aagiaa taisaa karam ||",
      "translation": "As He orders, so do His creatures act.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪਉਣ ਪਾਣੀ ਬੈਸੰਤਰ ਮਾਹਿ ॥",
      "transliteration": "paun paanee baisa(n)tar maahi ||",
      "translation": "He permeates the winds and the waters.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚਾਰਿ ਕੁੰਟ ਦਹ ਦਿਸੇ ਸਮਾਹਿ ॥",
      "transliteration": "chaar ku(n)t dah dise samaahi ||",
      "translation": "He is pervading in the four corners and in the ten directions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਸ ਤੇ ਭਿੰਨ ਨਹੀ ਕੋ ਠਾਉ ॥",
      "transliteration": "tis te bhi(n)n nahee ko thaau ||",
      "translation": "Without Him, there is no place at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਨਾਨਕ ਸੁਖੁ ਪਾਉ ॥੨॥",
      "transliteration": "gur prasaad naanak sukh paau ||2||",
      "translation": "By Guru's Grace, O Nanak, peace is obtained. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬੇਦ ਪੁਰਾਨ ਸਿੰਮ੍ਰਿਤਿ ਮਹਿ ਦੇਖੁ ॥",
      "transliteration": "bed puraan si(n)mrit mahi dekh ||",
      "translation": "See Him in the Vedas, the Puraanas and the Simritees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਸੀਅਰ ਸੂਰ ਨਖੵਤ੍ਰ ਮਹਿ ਏਕੁ ॥",
      "transliteration": "saseear soor nakhytr mahi ek ||",
      "translation": "In the moon, the sun and the stars, He is the One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਾਣੀ ਪ੍ਰਭ ਕੀ ਸਭੁ ਕੋ ਬੋਲੈ ॥",
      "transliteration": "baanee prabh kee sabh ko bolai ||",
      "translation": "The Bani of God's Word is spoken by everyone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਪਿ ਅਡੋਲੁ ਨ ਕਬਹੂ ਡੋਲੈ ॥",
      "transliteration": "aap adol na kabahoo dolai ||",
      "translation": "He Himself is unwavering - He never wavers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਰਬ ਕਲਾ ਕਰਿ ਖੇਲੈ ਖੇਲ ॥",
      "transliteration": "sarab kalaa kar khelai khel ||",
      "translation": "With absolute power, He plays His play.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮੋਲਿ ਨ ਪਾਈਐ ਗੁਣਹ ਅਮੋਲ ॥",
      "transliteration": "mol na paaeeai gunah amol ||",
      "translation": "His value cannot be estimated; His virtues are invaluable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਰਬ ਜੋਤਿ ਮਹਿ ਜਾ ਕੀ ਜੋਤਿ ॥",
      "transliteration": "sarab jot mahi jaa kee jot ||",
      "translation": "In all light, is His Light.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਧਾਰਿ ਰਹਿਓ ਸੁਆਮੀ ਓਤਿ ਪੋਤਿ ॥",
      "transliteration": "dhaar rahio suaamee ot pot ||",
      "translation": "The Lord and Master supports the weave of the fabric of the universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਭਰਮ ਕਾ ਨਾਸੁ ॥",
      "transliteration": "gur parasaad bharam kaa naas ||",
      "translation": "By Guru's Grace, doubt is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਨਕ ਤਿਨ ਮਹਿ ਏਹੁ ਬਿਸਾਸੁ ॥੩॥",
      "transliteration": "naanak tin mahi ehu bisaas ||3||",
      "translation": "O Nanak, this faith is firmly implanted within. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਕਾ ਪੇਖਨੁ ਸਭੁ ਬ੍ਰਹਮ ॥",
      "transliteration": "sa(n)t janaa kaa pekhan sabh braham ||",
      "translation": "In the eye of the Saint, everything is God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਕੈ ਹਿਰਦੈ ਸਭਿ ਧਰਮ ॥",
      "transliteration": "sa(n)t janaa kai hiradai sabh dharam ||",
      "translation": "In the heart of the Saint, everything is Dharma.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਸੁਨਹਿ ਸੁਭ ਬਚਨ ॥",
      "transliteration": "sa(n)t janaa sunahi subh bachan ||",
      "translation": "The Saint hears words of goodness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਰਬ ਬਿਆਪੀ ਰਾਮ ਸੰਗਿ ਰਚਨ ॥",
      "transliteration": "sarab biaapee raam sa(n)g rachan ||",
      "translation": "He is absorbed in the All-pervading Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਨਿ ਜਾਤਾ ਤਿਸ ਕੀ ਇਹ ਰਹਤ ॥",
      "transliteration": "jin jaataa tis kee ih rahat ||",
      "translation": "This is the way of life of one who knows God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਤਿ ਬਚਨ ਸਾਧੂ ਸਭਿ ਕਹਤ ॥",
      "transliteration": "sat bachan saadhoo sabh kahat ||",
      "translation": "True are all the words spoken by the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੋ ਜੋ ਹੋਇ ਸੋਈ ਸੁਖੁ ਮਾਨੈ ॥",
      "transliteration": "jo jo hoi soee sukh maanai ||",
      "translation": "Whatever happens, he peacefully accepts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨਹਾਰੁ ਪ੍ਰਭੁ ਜਾਨੈ ॥",
      "transliteration": "karan karaavanahaar prabh jaanai ||",
      "translation": "He knows God as the Doer, the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅੰਤਰਿ ਬਸੇ ਬਾਹਰਿ ਭੀ ਓਹੀ ॥",
      "transliteration": "a(n)tar base baahar bhee ohee ||",
      "translation": "He dwells inside, and outside as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਨਕ ਦਰਸਨੁ ਦੇਖਿ ਸਭ ਮੋਹੀ ॥੪॥",
      "transliteration": "naanak darasan dekh sabh mohee ||4||",
      "translation": "O Nanak, beholding the Blessed Vision of His Darshan, all are fascinated. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਆਪਿ ਸਤਿ ਕੀਆ ਸਭੁ ਸਤਿ ॥",
      "transliteration": "aap sat keeaa sabh sat ||",
      "translation": "He Himself is True, and all that He has made is True.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਿਸੁ ਪ੍ਰਭ ਤੇ ਸਗਲੀ ਉਤਪਤਿ ॥",
      "transliteration": "tis prabh te sagalee utapat ||",
      "translation": "The entire creation came from God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਸੁ ਭਾਵੈ ਤਾ ਕਰੇ ਬਿਸਥਾਰੁ ॥",
      "transliteration": "tis bhaavai taa kare bisathaar ||",
      "translation": "As it pleases Him, He creates the expanse.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਿਸੁ ਭਾਵੈ ਤਾ ਏਕੰਕਾਰੁ ॥",
      "transliteration": "tis bhaavai taa eka(n)kaar ||",
      "translation": "As it pleases Him, He becomes the One and Only again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਨਿਕ ਕਲਾ ਲਖੀ ਨਹ ਜਾਇ ॥",
      "transliteration": "anik kalaa lakhee nah jaai ||",
      "translation": "His powers are so numerous, they cannot be known.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਸੁ ਭਾਵੈ ਤਿਸੁ ਲਏ ਮਿਲਾਇ ॥",
      "transliteration": "jis bhaavai tis lae milaai ||",
      "translation": "As it pleases Him, He merges us into Himself again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਵਨ ਨਿਕਟਿ ਕਵਨ ਕਹੀਐ ਦੂਰਿ ॥",
      "transliteration": "kavan nikat kavan kaheeai door ||",
      "translation": "Who is near, and who is far away?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਪੇ ਆਪਿ ਆਪ ਭਰਪੂਰਿ ॥",
      "transliteration": "aape aap aap bharapoor ||",
      "translation": "He Himself is Himself pervading everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅੰਤਰਗਤਿ ਜਿਸੁ ਆਪਿ ਜਨਾਏ ॥",
      "transliteration": "a(n)taragat jis aap janaae ||",
      "translation": "One whom God causes to know that He is within the heart",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਨਕ ਤਿਸੁ ਜਨ ਆਪਿ ਬੁਝਾਏ ॥੫॥",
      "transliteration": "naanak tis jan aap bujhaae ||5||",
      "translation": "- O Nanak, He causes that person to understand Him. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਰਬ ਭੂਤ ਆਪਿ ਵਰਤਾਰਾ ॥",
      "transliteration": "sarab bhoot aap varataaraa ||",
      "translation": "In all forms, He Himself is pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਰਬ ਨੈਨ ਆਪਿ ਪੇਖਨਹਾਰਾ ॥",
      "transliteration": "sarab nain aap pekhanahaaraa ||",
      "translation": "Through all eyes, He Himself is watching.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਗਲ ਸਮਗ੍ਰੀ ਜਾ ਕਾ ਤਨਾ ॥",
      "transliteration": "sagal samagree jaa kaa tanaa ||",
      "translation": "All the creation is His Body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਪਨ ਜਸੁ ਆਪ ਹੀ ਸੁਨਾ ॥",
      "transliteration": "aapan jas aap hee sunaa ||",
      "translation": "He Himself listens to His Own Praise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਵਨ ਜਾਨੁ ਇਕੁ ਖੇਲੁ ਬਨਾਇਆ ॥",
      "transliteration": "aavan jaan ik khel banaaiaa ||",
      "translation": "The One has created the drama of coming and going.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਗਿਆਕਾਰੀ ਕੀਨੀ ਮਾਇਆ ॥",
      "transliteration": "aagiaakaaree keenee maaiaa ||",
      "translation": "He made Maya subservient to His Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਭ ਕੈ ਮਧਿ ਅਲਿਪਤੋ ਰਹੈ ॥",
      "transliteration": "sabh kai madh alipato rahai ||",
      "translation": "In the midst of all, He remains unattached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕਹਣਾ ਸੁ ਆਪੇ ਕਹੈ ॥",
      "transliteration": "jo kichh kahanaa s aape kahai ||",
      "translation": "Whatever is said, He Himself says.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਗਿਆ ਆਵੈ ਆਗਿਆ ਜਾਇ ॥",
      "transliteration": "aagiaa aavai aagiaa jaai ||",
      "translation": "By His Will we come, and by His Will we go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕ ਜਾ ਭਾਵੈ ਤਾ ਲਏ ਸਮਾਇ ॥੬॥",
      "transliteration": "naanak jaa bhaavai taa lae samaai ||6||",
      "translation": "O Nanak, when it pleases Him, then He absorbs us into Himself. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਇਸ ਤੇ ਹੋਇ ਸੁ ਨਾਹੀ ਬੁਰਾ ॥",
      "transliteration": "is te hoi s naahee buraa ||",
      "translation": "If it comes from Him, it cannot be bad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਓਰੈ ਕਹਹੁ ਕਿਨੈ ਕਛੁ ਕਰਾ ॥",
      "transliteration": "orai kahahu kinai kachh karaa ||",
      "translation": "Other than Him, who can do anything?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਆਪਿ ਭਲਾ ਕਰਤੂਤਿ ਅਤਿ ਨੀਕੀ ॥",
      "transliteration": "aap bhalaa karatoot at neekee ||",
      "translation": "He Himself is good; His actions are the very best.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਆਪੇ ਜਾਨੈ ਅਪਨੇ ਜੀ ਕੀ ॥",
      "transliteration": "aape jaanai apane jee kee ||",
      "translation": "He Himself knows His Own Being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਆਪਿ ਸਾਚੁ ਧਾਰੀ ਸਭ ਸਾਚੁ ॥",
      "transliteration": "aap saach dhaaree sabh saach ||",
      "translation": "He Himself is True, and all that He has established is True.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਓਤਿ ਪੋਤਿ ਆਪਨ ਸੰਗਿ ਰਾਚੁ ॥",
      "transliteration": "ot pot aapan sa(n)g raach ||",
      "translation": "Through and through, He is blended with His creation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਾ ਕੀ ਗਤਿ ਮਿਤਿ ਕਹੀ ਨ ਜਾਇ ॥",
      "transliteration": "taa kee gat mit kahee na jaai ||",
      "translation": "His state and extent cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਦੂਸਰ ਹੋਇ ਤ ਸੋਝੀ ਪਾਇ ॥",
      "transliteration": "doosar hoi ta sojhee paai ||",
      "translation": "If there were another like Him, then only he could understand Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤਿਸ ਕਾ ਕੀਆ ਸਭੁ ਪਰਵਾਨੁ ॥",
      "transliteration": "tis kaa keeaa sabh paravaan ||",
      "translation": "His actions are all approved and accepted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਨਾਨਕ ਇਹੁ ਜਾਨੁ ॥੭॥",
      "transliteration": "gur prasaad naanak ihu jaan ||7||",
      "translation": "By Guru's Grace, O Nanak, this is known. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜੋ ਜਾਨੈ ਤਿਸੁ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "jo jaanai tis sadaa sukh hoi ||",
      "translation": "One who knows Him, obtains everlasting peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਆਪਿ ਮਿਲਾਇ ਲਏ ਪ੍ਰਭੁ ਸੋਇ ॥",
      "transliteration": "aap milaai lae prabh soi ||",
      "translation": "God blends that one into Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਓਹੁ ਧਨਵੰਤੁ ਕੁਲਵੰਤੁ ਪਤਿਵੰਤੁ ॥",
      "transliteration": "ohu dhanava(n)t kulava(n)t pativa(n)t ||",
      "translation": "He is wealth and prosperous, and of noble birth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜੀਵਨ ਮੁਕਤਿ ਜਿਸੁ ਰਿਦੈ ਭਗਵੰਤੁ ॥",
      "transliteration": "jeevan mukat jis ridai bhagava(n)t ||",
      "translation": "He is Jivan Mukta - liberated while yet alive; the Lord God abides in his heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0294_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਧੰਨੁ ਧੰਨੁ ਧੰਨੁ ਜਨੁ ਆਇਆ ॥",
      "transliteration": "dha(n)n dha(n)n dha(n)n jan aaiaa ||",
      "translation": "Blessed, blessed, blessed is the coming of that humble being;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 294,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
