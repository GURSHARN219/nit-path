{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 295,
  "lineCount": 62,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0295_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਸੁ ਪ੍ਰਸਾਦਿ ਸਭੁ ਜਗਤੁ ਤਰਾਇਆ ॥",
      "transliteration": "jis prasaad sabh jagat taraaiaa ||",
      "translation": "by his grace, the whole world is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਨ ਆਵਨ ਕਾ ਇਹੈ ਸੁਆਉ ॥",
      "transliteration": "jan aavan kaa ihai suaau ||",
      "translation": "This is his purpose in life;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਨ ਕੈ ਸੰਗਿ ਚਿਤਿ ਆਵੈ ਨਾਉ ॥",
      "transliteration": "jan kai sa(n)g chit aavai naau ||",
      "translation": "in the Company of this humble servant, the Lord's Name comes to mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਪਿ ਮੁਕਤੁ ਮੁਕਤੁ ਕਰੈ ਸੰਸਾਰੁ ॥",
      "transliteration": "aap mukat mukat karai sa(n)saar ||",
      "translation": "He Himself is liberated, and He liberates the universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਨਕ ਤਿਸੁ ਜਨ ਕਉ ਸਦਾ ਨਮਸਕਾਰੁ ॥੮॥੨੩॥",
      "transliteration": "naanak tis jan kau sadaa namasakaar ||8||23||",
      "translation": "O Nanak, to that humble servant, I bow in reverence forever. ||8||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪੂਰਾ ਪ੍ਰਭੁ ਆਰਾਧਿਆ ਪੂਰਾ ਜਾ ਕਾ ਨਾਉ ॥",
      "transliteration": "pooraa prabh aaraadhiaa pooraa jaa kaa naau ||",
      "translation": "I worship and adore the Perfect Lord God. Perfect is His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਨਕ ਪੂਰਾ ਪਾਇਆ ਪੂਰੇ ਕੇ ਗੁਨ ਗਾਉ ॥੧॥",
      "transliteration": "naanak pooraa paaiaa poore ke gun gaau ||1||",
      "translation": "O Nanak, I have obtained the Perfect One; I sing the Glorious Praises of the Perfect Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਸਟਪਦੀ ॥",
      "transliteration": "asatapadee ||",
      "translation": "Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਕਾ ਸੁਨਿ ਉਪਦੇਸੁ ॥",
      "transliteration": "poore gur kaa sun upades ||",
      "translation": "Listen to the Teachings of the Perfect Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਨਿਕਟਿ ਕਰਿ ਪੇਖੁ ॥",
      "transliteration": "paarabraham nikat kar pekh ||",
      "translation": "see the Supreme Lord God near you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਾਸਿ ਸਾਸਿ ਸਿਮਰਹੁ ਗੋਬਿੰਦ ॥",
      "transliteration": "saas saas simarahu gobi(n)d ||",
      "translation": "With each and every breath, meditate in remembrance on the Lord of the Universe,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਨ ਅੰਤਰ ਕੀ ਉਤਰੈ ਚਿੰਦ ॥",
      "transliteration": "man a(n)tar kee utarai chi(n)d ||",
      "translation": "and the anxiety within your mind shall depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਸ ਅਨਿਤ ਤਿਆਗਹੁ ਤਰੰਗ ॥",
      "transliteration": "aas anit tiaagahu tara(n)g ||",
      "translation": "Abandon the waves of fleeting desire,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਕੀ ਧੂਰਿ ਮਨ ਮੰਗ ॥",
      "transliteration": "sa(n)t janaa kee dhoor man ma(n)g ||",
      "translation": "and pray for the dust of the feet of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਆਪੁ ਛੋਡਿ ਬੇਨਤੀ ਕਰਹੁ ॥",
      "transliteration": "aap chhod benatee karahu ||",
      "translation": "Renounce your selfishness and conceit and offer your prayers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਅਗਨਿ ਸਾਗਰੁ ਤਰਹੁ ॥",
      "transliteration": "saadhasa(n)g agan saagar tarahu ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, cross over the ocean of fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹਰਿ ਧਨ ਕੇ ਭਰਿ ਲੇਹੁ ਭੰਡਾਰ ॥",
      "transliteration": "har dhan ke bhar lehu bha(n)daar ||",
      "translation": "Fill your stores with the wealth of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਗੁਰ ਪੂਰੇ ਨਮਸਕਾਰ ॥੧॥",
      "transliteration": "naanak gur poore namasakaar ||1||",
      "translation": "Nanak bows in humility and reverence to the Perfect Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਖੇਮ ਕੁਸਲ ਸਹਜ ਆਨੰਦ ॥",
      "transliteration": "khem kusal sahaj aana(n)d ||",
      "translation": "Happiness, intuitive peace, poise and bliss",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਭਜੁ ਪਰਮਾਨੰਦ ॥",
      "transliteration": "saadhasa(n)g bhaj paramaana(n)d ||",
      "translation": "in the Company of the Holy, meditate on the Lord of supreme bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਰਕ ਨਿਵਾਰਿ ਉਧਾਰਹੁ ਜੀਉ ॥",
      "transliteration": "narak nivaar udhaarahu jeeu ||",
      "translation": "You shall be spared from hell - save your soul!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਨ ਗੋਬਿੰਦ ਅੰਮ੍ਰਿਤ ਰਸੁ ਪੀਉ ॥",
      "transliteration": "gun gobi(n)d a(n)mrit ras peeu ||",
      "translation": "Drink in the ambrosial essence of the Glorious Praises of the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚਿਤਿ ਚਿਤਵਹੁ ਨਾਰਾਇਣ ਏਕ ॥",
      "transliteration": "chit chitavahu naaraain ek ||",
      "translation": "Focus your consciousness on the One, the All-pervading Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਏਕ ਰੂਪ ਜਾ ਕੇ ਰੰਗ ਅਨੇਕ ॥",
      "transliteration": "ek roop jaa ke ra(n)g anek ||",
      "translation": "He has One Form, but He has many manifestations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੋਪਾਲ ਦਾਮੋਦਰ ਦੀਨ ਦਇਆਲ ॥",
      "transliteration": "gopaal daamodar deen daiaal ||",
      "translation": "Sustainer of the Universe, Lord of the world, Kind to the poor,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੁਖ ਭੰਜਨ ਪੂਰਨ ਕਿਰਪਾਲ ॥",
      "transliteration": "dukh bha(n)jan pooran kirapaal ||",
      "translation": "Destroyer of sorrow, perfectly Merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਨਾਮੁ ਬਾਰੰ ਬਾਰ ॥",
      "transliteration": "simar simar naam baara(n) baar ||",
      "translation": "Meditate, meditate in remembrance on the Naam, again and again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਨਕ ਜੀਅ ਕਾ ਇਹੈ ਅਧਾਰ ॥੨॥",
      "transliteration": "naanak jee kaa ihai adhaar ||2||",
      "translation": "O Nanak, it is the Support of the soul. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਉਤਮ ਸਲੋਕ ਸਾਧ ਕੇ ਬਚਨ ॥",
      "transliteration": "utam salok saadh ke bachan ||",
      "translation": "The most sublime hymns are the Words of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਮੁਲੀਕ ਲਾਲ ਏਹਿ ਰਤਨ ॥",
      "transliteration": "amuleek laal ehi ratan ||",
      "translation": "These are priceless rubies and gems.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੁਨਤ ਕਮਾਵਤ ਹੋਤ ਉਧਾਰ ॥",
      "transliteration": "sunat kamaavat hot udhaar ||",
      "translation": "One who listens and acts on them is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਪਿ ਤਰੈ ਲੋਕਹ ਨਿਸਤਾਰ ॥",
      "transliteration": "aap tarai lokah nisataar ||",
      "translation": "He himself swims across, and saves others as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਫਲ ਜੀਵਨੁ ਸਫਲੁ ਤਾ ਕਾ ਸੰਗੁ ॥",
      "transliteration": "saphal jeevan saphal taa kaa sa(n)g ||",
      "translation": "His life is prosperous, and his company is fruitful;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾ ਕੈ ਮਨਿ ਲਾਗਾ ਹਰਿ ਰੰਗੁ ॥",
      "transliteration": "jaa kai man laagaa har ra(n)g ||",
      "translation": "his mind is imbued with the love of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੈ ਜੈ ਸਬਦੁ ਅਨਾਹਦੁ ਵਾਜੈ ॥",
      "transliteration": "jai jai sabad anaahad vaajai ||",
      "translation": "Hail, hail to him, for whom the sound current of the Shabad vibrates.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਨਿ ਸੁਨਿ ਅਨਦ ਕਰੇ ਪ੍ਰਭੁ ਗਾਜੈ ॥",
      "transliteration": "sun sun anad kare prabh gaajai ||",
      "translation": "Hearing it again and again, he is in bliss, proclaiming God's Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਗਟੇ ਗੁਪਾਲ ਮਹਾਂਤ ਕੈ ਮਾਥੇ ॥",
      "transliteration": "pragate gupaal mahaa(n)t kai maathe ||",
      "translation": "The Lord radiates from the foreheads of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਨਕ ਉਧਰੇ ਤਿਨ ਕੈ ਸਾਥੇ ॥੩॥",
      "transliteration": "naanak udhare tin kai saathe ||3||",
      "translation": "Nanak is saved in their company. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਰਨਿ ਜੋਗੁ ਸੁਨਿ ਸਰਨੀ ਆਏ ॥",
      "transliteration": "saran jog sun saranee aae ||",
      "translation": "Hearing that He can give Sanctuary, I have come seeking His Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਆਪ ਮਿਲਾਏ ॥",
      "transliteration": "kar kirapaa prabh aap milaae ||",
      "translation": "Bestowing His Mercy, God has blended me with Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਿਟਿ ਗਏ ਬੈਰ ਭਏ ਸਭ ਰੇਨ ॥",
      "transliteration": "mit gae bair bhae sabh ren ||",
      "translation": "Hatred is gone, and I have become the dust of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਸਾਧਸੰਗਿ ਲੈਨ ॥",
      "transliteration": "a(n)mrit naam saadhasa(n)g lain ||",
      "translation": "I have received the Ambrosial Naam in the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੁਪ੍ਰਸੰਨ ਭਏ ਗੁਰਦੇਵ ॥",
      "transliteration": "suprasa(n)n bhae guradev ||",
      "translation": "The Divine Guru is perfectly pleased;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪੂਰਨ ਹੋਈ ਸੇਵਕ ਕੀ ਸੇਵ ॥",
      "transliteration": "pooran hoee sevak kee sev ||",
      "translation": "the service of His servant has been rewarded.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਲ ਜੰਜਾਲ ਬਿਕਾਰ ਤੇ ਰਹਤੇ ॥",
      "transliteration": "aal ja(n)jaal bikaar te rahate ||",
      "translation": "I have been released from worldly entanglements and corruption,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਸੁਨਿ ਰਸਨਾ ਕਹਤੇ ॥",
      "transliteration": "raam naam sun rasanaa kahate ||",
      "translation": "hearing the Lord's Name and chanting it with my tongue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਰਿ ਪ੍ਰਸਾਦੁ ਦਇਆ ਪ੍ਰਭਿ ਧਾਰੀ ॥",
      "transliteration": "kar prasaad daiaa prabh dhaaree ||",
      "translation": "By His Grace, God has bestowed His Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਨਕ ਨਿਬਹੀ ਖੇਪ ਹਮਾਰੀ ॥੪॥",
      "transliteration": "naanak nibahee khep hamaaree ||4||",
      "translation": "O Nanak, my merchandise has arrived save and sound. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਉਸਤਤਿ ਕਰਹੁ ਸੰਤ ਮੀਤ ॥",
      "transliteration": "prabh kee usatat karahu sa(n)t meet ||",
      "translation": "Sing the Praises of God, O Saints, O friends,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਾਵਧਾਨ ਏਕਾਗਰ ਚੀਤ ॥",
      "transliteration": "saavadhaan ekaagar cheet ||",
      "translation": "with total concentration and one-pointedness of mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੁਖਮਨੀ ਸਹਜ ਗੋਬਿੰਦ ਗੁਨ ਨਾਮ ॥",
      "transliteration": "sukhamanee sahaj gobi(n)d gun naam ||",
      "translation": "Sukhmani is the peaceful ease, the Glory of God, the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਿਸੁ ਮਨਿ ਬਸੈ ਸੁ ਹੋਤ ਨਿਧਾਨ ॥",
      "transliteration": "jis man basai s hot nidhaan ||",
      "translation": "When it abides in the mind, one becomes wealthy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਰਬ ਇਛਾ ਤਾ ਕੀ ਪੂਰਨ ਹੋਇ ॥",
      "transliteration": "sarab ichhaa taa kee pooran hoi ||",
      "translation": "All desires are fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪ੍ਰਧਾਨ ਪੁਰਖੁ ਪ੍ਰਗਟੁ ਸਭ ਲੋਇ ॥",
      "transliteration": "pradhaan purakh pragat sabh loi ||",
      "translation": "One becomes the most respected person, famous all over the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਭ ਤੇ ਊਚ ਪਾਏ ਅਸਥਾਨੁ ॥",
      "transliteration": "sabh te ooch paae asathaan ||",
      "translation": "He obtains the highest place of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਬਹੁਰਿ ਨ ਹੋਵੈ ਆਵਨ ਜਾਨੁ ॥",
      "transliteration": "bahur na hovai aavan jaan ||",
      "translation": "He does not come and go in reincarnation any longer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਹਰਿ ਧਨੁ ਖਾਟਿ ਚਲੈ ਜਨੁ ਸੋਇ ॥",
      "transliteration": "har dhan khaat chalai jan soi ||",
      "translation": "One who departs, after earning the wealth of the Lord's Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਨਾਨਕ ਜਿਸਹਿ ਪਰਾਪਤਿ ਹੋਇ ॥੫॥",
      "transliteration": "naanak jisahi paraapat hoi ||5||",
      "translation": "O Nanak, realizes it. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਖੇਮ ਸਾਂਤਿ ਰਿਧਿ ਨਵ ਨਿਧਿ ॥",
      "transliteration": "khem saa(n)t ridh nav nidh ||",
      "translation": "Comfort, peace and tranquility, wealth and the nine treasures;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਬੁਧਿ ਗਿਆਨੁ ਸਰਬ ਤਹ ਸਿਧਿ ॥",
      "transliteration": "budh giaan sarab tah sidh ||",
      "translation": "wisdom, knowledge, and all spiritual powers;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0295_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਬਿਦਿਆ ਤਪੁ ਜੋਗੁ ਪ੍ਰਭ ਧਿਆਨੁ ॥",
      "transliteration": "bidiaa tap jog prabh dhiaan ||",
      "translation": "learning, penance, Yoga and meditation on God;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 295,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
