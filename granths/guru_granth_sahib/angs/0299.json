{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 299,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0299_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਸਤ ਚਰਨ ਸੰਤ ਟਹਲ ਕਮਾਈਐ ॥",
      "transliteration": "hasat charan sa(n)t tahal kamaaeeai ||",
      "translation": "With your hands and feet, work for the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਨਕ ਇਹੁ ਸੰਜਮੁ ਪ੍ਰਭ ਕਿਰਪਾ ਪਾਈਐ ॥੧੦॥",
      "transliteration": "naanak ihu sa(n)jam prabh kirapaa paaeeai ||10||",
      "translation": "O Nanak, this way of life is obtained by God's Grace. ||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਏਕੋ ਏਕੁ ਬਖਾਨੀਐ ਬਿਰਲਾ ਜਾਣੈ ਸ੍ਵਾਦੁ ॥",
      "transliteration": "eko ek bakhaaneeai biralaa jaanai svaad ||",
      "translation": "Describe the Lord as the One, the One and Only. How rare are those who know the taste of this essence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਣ ਗੋਬਿੰਦ ਨ ਜਾਣੀਐ ਨਾਨਕ ਸਭੁ ਬਿਸਮਾਦੁ ॥੧੧॥",
      "transliteration": "gun gobi(n)d na jaaneeai naanak sabh bisamaad ||11||",
      "translation": "The Glories of the Lord of the Universe cannot be known. O Nanak, He is totally amazing and wonderful! ||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਏਕਾਦਸੀ ਨਿਕਟਿ ਪੇਖਹੁ ਹਰਿ ਰਾਮੁ ॥",
      "transliteration": "ekaadasee nikat pekhahu har raam ||",
      "translation": "The eleventh day of the lunar cycle: Behold the Lord, the Lord, near at hand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇੰਦ੍ਰੀ ਬਸਿ ਕਰਿ ਸੁਣਹੁ ਹਰਿ ਨਾਮੁ ॥",
      "transliteration": "i(n)dree bas kar sunahu har naam ||",
      "translation": "Subdue the desires of your sexual organs, and listen to the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਨਿ ਸੰਤੋਖੁ ਸਰਬ ਜੀਅ ਦਇਆ ॥",
      "transliteration": "man sa(n)tokh sarab jee daiaa ||",
      "translation": "Let your mind be content, and be kind to all beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਨ ਬਿਧਿ ਬਰਤੁ ਸੰਪੂਰਨ ਭਇਆ ॥",
      "transliteration": "in bidh barat sa(n)pooran bhaiaa ||",
      "translation": "In this way, your fast will be successful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਧਾਵਤ ਮਨੁ ਰਾਖੈ ਇਕ ਠਾਇ ॥",
      "transliteration": "dhaavat man raakhai ik thaai ||",
      "translation": "Keep your wandering mind restrained in one place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਸੁਧੁ ਜਪਤ ਹਰਿ ਨਾਇ ॥",
      "transliteration": "man tan sudh japat har naai ||",
      "translation": "Your mind and body shall become pure, chanting the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਭ ਮਹਿ ਪੂਰਿ ਰਹੇ ਪਾਰਬ੍ਰਹਮ ॥",
      "transliteration": "sabh mahi poor rahe paarabraham ||",
      "translation": "The Supreme Lord God is pervading amongst all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਕੀਰਤਨੁ ਕਰਿ ਅਟਲ ਏਹੁ ਧਰਮ ॥੧੧॥",
      "transliteration": "naanak har keeratan kar atal ehu dharam ||11||",
      "translation": "O Nanak, sing the Kirtan of the Lord's Praises; this alone is the eternal faith of Dharma. ||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੁਰਮਤਿ ਹਰੀ ਸੇਵਾ ਕਰੀ ਭੇਟੇ ਸਾਧ ਕ੍ਰਿਪਾਲ ॥",
      "transliteration": "duramat haree sevaa karee bhete saadh kripaal ||",
      "translation": "Evil-mindedness is eliminated, by meeting with and serving the compassionate Holy Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਨਕ ਪ੍ਰਭ ਸਿਉ ਮਿਲਿ ਰਹੇ ਬਿਨਸੇ ਸਗਲ ਜੰਜਾਲ ॥੧੨॥",
      "transliteration": "naanak prabh siu mil rahe binase sagal ja(n)jaal ||12||",
      "translation": "Nanak is merged with God; all his entanglements have come to an end. ||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੁਆਦਸੀ ਦਾਨੁ ਨਾਮੁ ਇਸਨਾਨੁ ॥",
      "transliteration": "duaadasee daan naam isanaan ||",
      "translation": "The twelfth day of the lunar cycle: Dedicate yourself to giving charity, chanting the Naam and purification.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਰਿ ਕੀ ਭਗਤਿ ਕਰਹੁ ਤਜਿ ਮਾਨੁ ॥",
      "transliteration": "har kee bhagat karahu taj maan ||",
      "translation": "Worship the Lord with devotion, and get rid of your pride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਰਿ ਅੰਮ੍ਰਿਤ ਪਾਨ ਕਰਹੁ ਸਾਧਸੰਗਿ ॥",
      "transliteration": "har a(n)mrit paan karahu saadhasa(n)g ||",
      "translation": "Drink in the Ambrosial Nectar of the Lord's Name, in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਨ ਤ੍ਰਿਪਤਾਸੈ ਕੀਰਤਨ ਪ੍ਰਭ ਰੰਗਿ ॥",
      "transliteration": "man tripataasai keeratan prabh ra(n)g ||",
      "translation": "The mind is satisfied by lovingly singing the Kirtan of God's Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕੋਮਲ ਬਾਣੀ ਸਭ ਕਉ ਸੰਤੋਖੈ ॥",
      "transliteration": "komal baanee sabh kau sa(n)tokhai ||",
      "translation": "The Sweet Words of His Bani soothe everyone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪੰਚ ਭੂ ਆਤਮਾ ਹਰਿ ਨਾਮ ਰਸਿ ਪੋਖੈ ॥",
      "transliteration": "pa(n)ch bhoo aatamaa har naam ras pokhai ||",
      "translation": "The soul, the subtle essence of the five elements, cherishes the Nectar of the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਤੇ ਏਹ ਨਿਹਚਉ ਪਾਈਐ ॥",
      "transliteration": "gur poore te eh nihachau paaeeai ||",
      "translation": "This faith is obtained from the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਨਕ ਰਾਮ ਰਮਤ ਫਿਰਿ ਜੋਨਿ ਨ ਆਈਐ ॥੧੨॥",
      "transliteration": "naanak raam ramat phir jon na aaeeai ||12||",
      "translation": "O Nanak, dwelling upon the Lord, you shall not enter the womb of reincarnation again. ||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੀਨਿ ਗੁਣਾ ਮਹਿ ਬਿਆਪਿਆ ਪੂਰਨ ਹੋਤ ਨ ਕਾਮ ॥",
      "transliteration": "teen gunaa mahi biaapiaa pooran hot na kaam ||",
      "translation": "Engrossed in the three qualities, one's efforts do not succeed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪਤਿਤ ਉਧਾਰਣੁ ਮਨਿ ਬਸੈ ਨਾਨਕ ਛੂਟੈ ਨਾਮ ॥੧੩॥",
      "transliteration": "patit udhaaran man basai naanak chhootai naam ||13||",
      "translation": "When the Saving Grace of sinners dwells in the mind, O Nanak, then one is saved by the Naam, the Name of the Lord. ||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤ੍ਰਉਦਸੀ ਤੀਨਿ ਤਾਪ ਸੰਸਾਰ ॥",
      "transliteration": "traudasee teen taap sa(n)saar ||",
      "translation": "The thirteenth day of the lunar cycle: The world is in the fever of the three qualities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਆਵਤ ਜਾਤ ਨਰਕ ਅਵਤਾਰ ॥",
      "transliteration": "aavat jaat narak avataar ||",
      "translation": "It comes and goes, and is reincarnated in hell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਭਜਨੁ ਨ ਮਨ ਮਹਿ ਆਇਓ ॥",
      "transliteration": "har har bhajan na man mahi aaio ||",
      "translation": "Meditation on the Lord, Har, Har, does not enter into the minds of the people.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੁਖ ਸਾਗਰ ਪ੍ਰਭੁ ਨਿਮਖ ਨ ਗਾਇਓ ॥",
      "transliteration": "sukh saagar prabh nimakh na gaaio ||",
      "translation": "They do not sing the Praises of God, the Ocean of peace, even for an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਰਖ ਸੋਗ ਕਾ ਦੇਹ ਕਰਿ ਬਾਧਿਓ ॥",
      "transliteration": "harakh sog kaa deh kar baadhio ||",
      "translation": "This body is the embodiment of pleasure and pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੀਰਘ ਰੋਗੁ ਮਾਇਆ ਆਸਾਧਿਓ ॥",
      "transliteration": "deeragh rog maaiaa aasaadhio ||",
      "translation": "It suffers from the chronic and incurable disease of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦਿਨਹਿ ਬਿਕਾਰ ਕਰਤ ਸ੍ਰਮੁ ਪਾਇਓ ॥",
      "transliteration": "dinahi bikaar karat sram paaio ||",
      "translation": "By day, people practice corruption, wearing themselves out.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨੈਨੀ ਨੀਦ ਸੁਪਨ ਬਰੜਾਇਓ ॥",
      "transliteration": "nainee need supan baraRaaio ||",
      "translation": "And then with sleep in their eyes, they mutter in dreams.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਰਿ ਬਿਸਰਤ ਹੋਵਤ ਏਹ ਹਾਲ ॥",
      "transliteration": "har bisarat hovat eh haal ||",
      "translation": "Forgetting the Lord, this is their condition.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਰਨਿ ਨਾਨਕ ਪ੍ਰਭ ਪੁਰਖ ਦਇਆਲ ॥੧੩॥",
      "transliteration": "saran naanak prabh purakh daiaal ||13||",
      "translation": "Nanak seeks the Sanctuary of God, the kind and compassionate Primal Being. ||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚਾਰਿ ਕੁੰਟ ਚਉਦਹ ਭਵਨ ਸਗਲ ਬਿਆਪਤ ਰਾਮ ॥",
      "transliteration": "chaar ku(n)t chaudah bhavan sagal biaapat raam ||",
      "translation": "The Lord is pervading in all the four directions and the fourteen worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਨਕ ਊਨ ਨ ਦੇਖੀਐ ਪੂਰਨ ਤਾ ਕੇ ਕਾਮ ॥੧੪॥",
      "transliteration": "naanak oon na dekheeai pooran taa ke kaam ||14||",
      "translation": "O Nanak, He is not seen to be lacking anything; His works are perfectly complete. ||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚਉਦਹਿ ਚਾਰਿ ਕੁੰਟ ਪ੍ਰਭ ਆਪ ॥",
      "transliteration": "chaudahi chaar ku(n)t prabh aap ||",
      "translation": "The fourteenth day of the lunar cycle: God Himself is in all four directions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਗਲ ਭਵਨ ਪੂਰਨ ਪਰਤਾਪ ॥",
      "transliteration": "sagal bhavan pooran parataap ||",
      "translation": "On all worlds, His radiant glory is perfect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦਸੇ ਦਿਸਾ ਰਵਿਆ ਪ੍ਰਭੁ ਏਕੁ ॥",
      "transliteration": "dase disaa raviaa prabh ek ||",
      "translation": "The One God is diffused in the ten directions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਧਰਨਿ ਅਕਾਸ ਸਭ ਮਹਿ ਪ੍ਰਭ ਪੇਖੁ ॥",
      "transliteration": "dharan akaas sabh mahi prabh pekh ||",
      "translation": "Behold God in all the earth and sky.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਲ ਥਲ ਬਨ ਪਰਬਤ ਪਾਤਾਲ ॥",
      "transliteration": "jal thal ban parabat paataal ||",
      "translation": "In the water, on the land, in the forests and mountains, and in the nether regions of the underworld,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪਰਮੇਸ੍ਵਰ ਤਹ ਬਸਹਿ ਦਇਆਲ ॥",
      "transliteration": "paramesvar tah basahi daiaal ||",
      "translation": "the Merciful Transcendent Lord is abiding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸੂਖਮ ਅਸਥੂਲ ਸਗਲ ਭਗਵਾਨ ॥",
      "transliteration": "sookham asathool sagal bhagavaan ||",
      "translation": "The Lord God is in all mind and matter, subtle and manifest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਬ੍ਰਹਮੁ ਪਛਾਨ ॥੧੪॥",
      "transliteration": "naanak guramukh braham pachhaan ||14||",
      "translation": "O Nanak, the Gurmukh realizes God. ||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਆਤਮੁ ਜੀਤਾ ਗੁਰਮਤੀ ਗੁਣ ਗਾਏ ਗੋਬਿੰਦ ॥",
      "transliteration": "aatam jeetaa guramatee gun gaae gobi(n)d ||",
      "translation": "The soul is conquered, through the Guru's Teachings, singing the Glories of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦੀ ਭੈ ਮਿਟੇ ਨਾਨਕ ਬਿਨਸੀ ਚਿੰਦ ॥੧੫॥",
      "transliteration": "sa(n)t prasaadee bhai mite naanak binasee chi(n)d ||15||",
      "translation": "By the Grace of the Saints, fear is dispelled, O Nanak, and anxiety is ended. ||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0299_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਅਮਾਵਸ ਆਤਮ ਸੁਖੀ ਭਏ ਸੰਤੋਖੁ ਦੀਆ ਗੁਰਦੇਵ ॥",
      "transliteration": "amaavas aatam sukhee bhae sa(n)tokh deeaa guradev ||",
      "translation": "The day of the new moon: My soul is at peace; the Divine Guru has blessed me with contentment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 299,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
