{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 324,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0324_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤੂੰ ਸਤਿਗੁਰੁ ਹਉ ਨਉਤਨੁ ਚੇਲਾ ॥",
      "transliteration": "too(n) satigur hau nautan chelaa ||",
      "translation": "You are the True Guru, and I am Your new disciple.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਮਿਲੁ ਅੰਤ ਕੀ ਬੇਲਾ ॥੪॥੨॥",
      "transliteration": "kahi kabeer mil a(n)t kee belaa ||4||2||",
      "translation": "Says Kabeer, O Lord, please meet me - this is my very last chance! ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਬ ਹਮ ਏਕੋ ਏਕੁ ਕਰਿ ਜਾਨਿਆ ॥",
      "transliteration": "jab ham eko ek kar jaaniaa ||",
      "translation": "When I realize that there is One, and only One Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਬ ਲੋਗਹ ਕਾਹੇ ਦੁਖੁ ਮਾਨਿਆ ॥੧॥",
      "transliteration": "tab logah kaahe dukh maaniaa ||1||",
      "translation": "why then should the people be upset? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਮ ਅਪਤਹ ਅਪੁਨੀ ਪਤਿ ਖੋਈ ॥",
      "transliteration": "ham apatah apunee pat khoee ||",
      "translation": "I am dishonored; I have lost my honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਮਰੈ ਖੋਜਿ ਪਰਹੁ ਮਤਿ ਕੋਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "hamarai khoj parahu mat koee ||1|| rahaau ||",
      "translation": "No one should follow in my footsteps. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਮ ਮੰਦੇ ਮੰਦੇ ਮਨ ਮਾਹੀ ॥",
      "transliteration": "ham ma(n)de ma(n)de man maahee ||",
      "translation": "I am bad, and bad in my mind as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਾਝ ਪਾਤਿ ਕਾਹੂ ਸਿਉ ਨਾਹੀ ॥੨॥",
      "transliteration": "saajh paat kaahoo siu naahee ||2||",
      "translation": "I have no partnership with anyone. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਤਿ ਅਪਤਿ ਤਾ ਕੀ ਨਹੀ ਲਾਜ ॥",
      "transliteration": "pat apat taa kee nahee laaj ||",
      "translation": "I have no shame about honor or dishonor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਬ ਜਾਨਹੁਗੇ ਜਬ ਉਘਰੈਗੋ ਪਾਜ ॥੩॥",
      "transliteration": "tab jaanahuge jab ugharaigo paaj ||3||",
      "translation": "But you shall know, when your own false covering is laid bare. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਪਤਿ ਹਰਿ ਪਰਵਾਨੁ ॥",
      "transliteration": "kahu kabeer pat har paravaan ||",
      "translation": "Says Kabeer, honor is that which is accepted by the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਰਬ ਤਿਆਗਿ ਭਜੁ ਕੇਵਲ ਰਾਮੁ ॥੪॥੩॥",
      "transliteration": "sarab tiaag bhaj keval raam ||4||3||",
      "translation": "Give up everything - meditate, vibrate upon the Lord alone. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਗਨ ਫਿਰਤ ਜੌ ਪਾਈਐ ਜੋਗੁ ॥",
      "transliteration": "nagan phirat jau paaeeai jog ||",
      "translation": "If Yoga could be obtained by wandering around naked,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਨ ਕਾ ਮਿਰਗੁ ਮੁਕਤਿ ਸਭੁ ਹੋਗੁ ॥੧॥",
      "transliteration": "ban kaa mirag mukat sabh hog ||1||",
      "translation": "then all the deer of the forest would be liberated. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿਆ ਨਾਗੇ ਕਿਆ ਬਾਧੇ ਚਾਮ ॥",
      "transliteration": "kiaa naage kiaa baadhe chaam ||",
      "translation": "What does it matter whether someone goes naked, or wears a deer skin,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਬ ਨਹੀ ਚੀਨਸਿ ਆਤਮ ਰਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jab nahee cheenas aatam raam ||1|| rahaau ||",
      "translation": "if he does not remember the Lord within his soul? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੂਡ ਮੁੰਡਾਏ ਜੌ ਸਿਧਿ ਪਾਈ ॥",
      "transliteration": "mood mu(n)daae jau sidh paaee ||",
      "translation": "If the spiritual perfection of the Siddhas could be obtained by shaving the head,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮੁਕਤੀ ਭੇਡ ਨ ਗਈਆ ਕਾਈ ॥੨॥",
      "transliteration": "mukatee bhed na gaeeaa kaaee ||2||",
      "translation": "then why haven't sheep found liberation? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿੰਦੁ ਰਾਖਿ ਜੌ ਤਰੀਐ ਭਾਈ ॥",
      "transliteration": "bi(n)d raakh jau tareeai bhaaee ||",
      "translation": "If someone could save himself by celibacy, O Siblings of Destiny,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਖੁਸਰੈ ਕਿਉ ਨ ਪਰਮ ਗਤਿ ਪਾਈ ॥੩॥",
      "transliteration": "khusarai kiu na param gat paaee ||3||",
      "translation": "why then haven't eunuchs obtained the state of supreme dignity? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਸੁਨਹੁ ਨਰ ਭਾਈ ॥",
      "transliteration": "kahu kabeer sunahu nar bhaaee ||",
      "translation": "Says Kabeer, listen, O men, O Siblings of Destiny:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਬਿਨੁ ਕਿਨਿ ਗਤਿ ਪਾਈ ॥੪॥੪॥",
      "transliteration": "raam naam bin kin gat paaee ||4||4||",
      "translation": "without the Lord's Name, who has ever found salvation? ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੰਧਿਆ ਪ੍ਰਾਤ ਇਸ੍ਨਾਨੁ ਕਰਾਹੀ ॥",
      "transliteration": "sa(n)dhiaa praat isnaan karaahee ||",
      "translation": "Those who take their ritual baths in the evening and the morning",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਿਉ ਭਏ ਦਾਦੁਰ ਪਾਨੀ ਮਾਹੀ ॥੧॥",
      "transliteration": "jiu bhae daadur paanee maahee ||1||",
      "translation": "are like the frogs in the water. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਉ ਪੈ ਰਾਮ ਰਾਮ ਰਤਿ ਨਾਹੀ ॥",
      "transliteration": "jau pai raam raam rat naahee ||",
      "translation": "When people do not love the Lord's Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੇ ਸਭਿ ਧਰਮ ਰਾਇ ਕੈ ਜਾਹੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "te sabh dharam raai kai jaahee ||1|| rahaau ||",
      "translation": "they must all go to the Righteous Judge of Dharma. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਾਇਆ ਰਤਿ ਬਹੁ ਰੂਪ ਰਚਾਹੀ ॥",
      "transliteration": "kaaiaa rat bahu roop rachaahee ||",
      "translation": "Those who love their bodies and try different looks,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਿਨ ਕਉ ਦਇਆ ਸੁਪਨੈ ਭੀ ਨਾਹੀ ॥੨॥",
      "transliteration": "tin kau daiaa supanai bhee naahee ||2||",
      "translation": "do not feel compassion, even in dreams. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਾਰਿ ਚਰਨ ਕਹਹਿ ਬਹੁ ਆਗਰ ॥",
      "transliteration": "chaar charan kahahi bahu aagar ||",
      "translation": "The wise men call them four-footed creatures;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਾਧੂ ਸੁਖੁ ਪਾਵਹਿ ਕਲਿ ਸਾਗਰ ॥੩॥",
      "transliteration": "saadhoo sukh paavahi kal saagar ||3||",
      "translation": "the Holy find peace in this ocean of pain. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਬਹੁ ਕਾਇ ਕਰੀਜੈ ॥",
      "transliteration": "kahu kabeer bahu kaai kareejai ||",
      "translation": "Says Kabeer, why do you perform so many rituals?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਰਬਸੁ ਛੋਡਿ ਮਹਾ ਰਸੁ ਪੀਜੈ ॥੪॥੫॥",
      "transliteration": "sarabas chhod mahaa ras peejai ||4||5||",
      "translation": "Renounce everything, and drink in the supreme essence of the Lord. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਬੀਰ ਜੀ ਗਉੜੀ ॥",
      "transliteration": "kabeer jee gauRee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਿਆ ਜਪੁ ਕਿਆ ਤਪੁ ਕਿਆ ਬ੍ਰਤ ਪੂਜਾ ॥",
      "transliteration": "kiaa jap kiaa tap kiaa brat poojaa ||",
      "translation": "What use is chanting, and what use is penance, fasting or devotional worship,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾ ਕੈ ਰਿਦੈ ਭਾਉ ਹੈ ਦੂਜਾ ॥੧॥",
      "transliteration": "jaa kai ridai bhaau hai doojaa ||1||",
      "translation": "to one whose heart is filled with the love of duality? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰੇ ਜਨ ਮਨੁ ਮਾਧਉ ਸਿਉ ਲਾਈਐ ॥",
      "transliteration": "re jan man maadhau siu laaeeai ||",
      "translation": "O humble people, link your mind to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਤੁਰਾਈ ਨ ਚਤੁਰਭੁਜੁ ਪਾਈਐ ॥ ਰਹਾਉ ॥",
      "transliteration": "chaturaaee na chaturabhuj paaeeai || rahaau ||",
      "translation": "Through cleverness, the four-armed Lord is not obtained. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਰਹਰੁ ਲੋਭੁ ਅਰੁ ਲੋਕਾਚਾਰੁ ॥",
      "transliteration": "parahar lobh ar lokaachaar ||",
      "translation": "Set aside your greed and worldly ways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਰਹਰੁ ਕਾਮੁ ਕ੍ਰੋਧੁ ਅਹੰਕਾਰੁ ॥੨॥",
      "transliteration": "parahar kaam krodh aha(n)kaar ||2||",
      "translation": "Set aside sexual desire, anger and egotism. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਰਮ ਕਰਤ ਬਧੇ ਅਹੰਮੇਵ ॥",
      "transliteration": "karam karat badhe aha(n)mev ||",
      "translation": "Ritual practices bind people in egotism;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮਿਲਿ ਪਾਥਰ ਕੀ ਕਰਹੀ ਸੇਵ ॥੩॥",
      "transliteration": "mil paathar kee karahee sev ||3||",
      "translation": "meeting together, they worship stones. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਭਗਤਿ ਕਰਿ ਪਾਇਆ ॥",
      "transliteration": "kahu kabeer bhagat kar paaiaa ||",
      "translation": "Says Kabeer, He is obtained only by devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭੋਲੇ ਭਾਇ ਮਿਲੇ ਰਘੁਰਾਇਆ ॥੪॥੬॥",
      "transliteration": "bhole bhaai mile raghuraaiaa ||4||6||",
      "translation": "Through innocent love, the Lord is met. ||4||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗਰਭ ਵਾਸ ਮਹਿ ਕੁਲੁ ਨਹੀ ਜਾਤੀ ॥",
      "transliteration": "garabh vaas mahi kul nahee jaatee ||",
      "translation": "In the dwelling of the womb, there is no ancestry or social status.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬ੍ਰਹਮ ਬਿੰਦੁ ਤੇ ਸਭ ਉਤਪਾਤੀ ॥੧॥",
      "transliteration": "braham bi(n)d te sabh utapaatee ||1||",
      "translation": "All have originated from the Seed of God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਹੁ ਰੇ ਪੰਡਿਤ ਬਾਮਨ ਕਬ ਕੇ ਹੋਏ ॥",
      "transliteration": "kahu re pa(n)dit baaman kab ke hoe ||",
      "translation": "Tell me, O Pandit, O religious scholar: since when have you been a Brahmin?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬਾਮਨ ਕਹਿ ਕਹਿ ਜਨਮੁ ਮਤ ਖੋਏ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "baaman kahi kahi janam mat khoe ||1|| rahaau ||",
      "translation": "Don't waste your life by continually claiming to be a Brahmin. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜੌ ਤੂੰ ਬ੍ਰਾਹਮਣੁ ਬ੍ਰਹਮਣੀ ਜਾਇਆ ॥",
      "transliteration": "jau too(n) braahaman brahamanee jaaiaa ||",
      "translation": "If you are indeed a Brahmin, born of a Brahmin mother,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਉ ਆਨ ਬਾਟ ਕਾਹੇ ਨਹੀ ਆਇਆ ॥੨॥",
      "transliteration": "tau aan baat kaahe nahee aaiaa ||2||",
      "translation": "then why didn't you come by some other way? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤੁਮ ਕਤ ਬ੍ਰਾਹਮਣ ਹਮ ਕਤ ਸੂਦ ॥",
      "transliteration": "tum kat braahaman ham kat sood ||",
      "translation": "How is it that you are a Brahmin, and I am of a low social status?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਹਮ ਕਤ ਲੋਹੂ ਤੁਮ ਕਤ ਦੂਧ ॥੩॥",
      "transliteration": "ham kat lohoo tum kat doodh ||3||",
      "translation": "How is it that I am formed of blood, and you are made of milk? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਜੋ ਬ੍ਰਹਮੁ ਬੀਚਾਰੈ ॥",
      "transliteration": "kahu kabeer jo braham beechaarai ||",
      "translation": "Says Kabeer, one who contemplates God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0324_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸੋ ਬ੍ਰਾਹਮਣੁ ਕਹੀਅਤੁ ਹੈ ਹਮਾਰੈ ॥੪॥੭॥",
      "transliteration": "so braahaman kaheeat hai hamaarai ||4||7||",
      "translation": "is said to be a Brahmin among us. ||4||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 324,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
