{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 325,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0325_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅੰਧਕਾਰ ਸੁਖਿ ਕਬਹਿ ਨ ਸੋਈ ਹੈ ॥",
      "transliteration": "a(n)dhakaar sukh kabahi na soee hai ||",
      "translation": "In the darkness, no one can sleep in peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਾਜਾ ਰੰਕੁ ਦੋਊ ਮਿਲਿ ਰੋਈ ਹੈ ॥੧॥",
      "transliteration": "raajaa ra(n)k dooo mil roee hai ||1||",
      "translation": "The king and the pauper both weep and cry. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਉ ਪੈ ਰਸਨਾ ਰਾਮੁ ਨ ਕਹਿਬੋ ॥",
      "transliteration": "jau pai rasanaa raam na kahibo ||",
      "translation": "As long as the tongue does not chant the Lord's Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਉਪਜਤ ਬਿਨਸਤ ਰੋਵਤ ਰਹਿਬੋ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "upajat binasat rovat rahibo ||1|| rahaau ||",
      "translation": "the person continues coming and going in reincarnation, crying out in pain. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਸ ਦੇਖੀਐ ਤਰਵਰ ਕੀ ਛਾਇਆ ॥",
      "transliteration": "jas dekheeai taravar kee chhaaiaa ||",
      "translation": "It is like the shadow of a tree;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪ੍ਰਾਨ ਗਏ ਕਹੁ ਕਾ ਕੀ ਮਾਇਆ ॥੨॥",
      "transliteration": "praan gae kahu kaa kee maaiaa ||2||",
      "translation": "when the breath of life passes out of the mortal being, tell me, what becomes of his wealth? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਸ ਜੰਤੀ ਮਹਿ ਜੀਉ ਸਮਾਨਾ ॥",
      "transliteration": "jas ja(n)tee mahi jeeu samaanaa ||",
      "translation": "It is like the music contained in the instrument;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮੂਏ ਮਰਮੁ ਕੋ ਕਾ ਕਰ ਜਾਨਾ ॥੩॥",
      "transliteration": "mooe maram ko kaa kar jaanaa ||3||",
      "translation": "how can anyone know the secret of the dead? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹੰਸਾ ਸਰਵਰੁ ਕਾਲੁ ਸਰੀਰ ॥",
      "transliteration": "ha(n)saa saravar kaal sareer ||",
      "translation": "Like the swan on the lake, death hovers over the body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਮ ਰਸਾਇਨ ਪੀਉ ਰੇ ਕਬੀਰ ॥੪॥੮॥",
      "transliteration": "raam rasaain peeu re kabeer ||4||8||",
      "translation": "Drink in the Lord's sweet elixir, Kabeer. ||4||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੋਤਿ ਕੀ ਜਾਤਿ ਜਾਤਿ ਕੀ ਜੋਤੀ ॥",
      "transliteration": "jot kee jaat jaat kee jotee ||",
      "translation": "The creation is born of the Light, and the Light is in the creation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਿਤੁ ਲਾਗੇ ਕੰਚੂਆ ਫਲ ਮੋਤੀ ॥੧॥",
      "transliteration": "tit laage ka(n)chooaa phal motee ||1||",
      "translation": "It bears two fruits: the false glass and the true pearl. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਵਨੁ ਸੁ ਘਰੁ ਜੋ ਨਿਰਭਉ ਕਹੀਐ ॥",
      "transliteration": "kavan s ghar jo nirabhau kaheeai ||",
      "translation": "Where is that home, which is said to be free of fear?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਉ ਭਜਿ ਜਾਇ ਅਭੈ ਹੋਇ ਰਹੀਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bhau bhaj jaai abhai hoi raheeai ||1|| rahaau ||",
      "translation": "There, fear is dispelled and one lives without fear. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਟਿ ਤੀਰਥਿ ਨਹੀ ਮਨੁ ਪਤੀਆਇ ॥",
      "transliteration": "tat teerath nahee man pateeaai ||",
      "translation": "On the banks of sacred rivers, the mind is not appeased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਾਰ ਅਚਾਰ ਰਹੇ ਉਰਝਾਇ ॥੨॥",
      "transliteration": "chaar achaar rahe urajhaai ||2||",
      "translation": "People remain entangled in good and bad deeds. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪਾਪ ਪੁੰਨ ਦੁਇ ਏਕ ਸਮਾਨ ॥",
      "transliteration": "paap pu(n)n dui ek samaan ||",
      "translation": "Sin and virtue are both the same.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਿਜ ਘਰਿ ਪਾਰਸੁ ਤਜਹੁ ਗੁਨ ਆਨ ॥੩॥",
      "transliteration": "nij ghar paaras tajahu gun aan ||3||",
      "translation": "In the home of your own being, is the Philosopher's Stone; renounce your search for any other virtue. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਬੀਰ ਨਿਰਗੁਣ ਨਾਮ ਨ ਰੋਸੁ ॥",
      "transliteration": "kabeer niragun naam na ros ||",
      "translation": "Kabeer: O worthless mortal, do not lose the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਸੁ ਪਰਚਾਇ ਪਰਚਿ ਰਹੁ ਏਸੁ ॥੪॥੯॥",
      "transliteration": "is parachaai parach rahu es ||4||9||",
      "translation": "Keep this mind of yours involved in this involvement. ||4||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੋ ਜਨ ਪਰਮਿਤਿ ਪਰਮਨੁ ਜਾਨਾ ॥",
      "transliteration": "jo jan paramit paraman jaanaa ||",
      "translation": "He claims to know the Lord, who is beyond measure and beyond thought;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਾਤਨ ਹੀ ਬੈਕੁੰਠ ਸਮਾਨਾ ॥੧॥",
      "transliteration": "baatan hee baiku(n)th samaanaa ||1||",
      "translation": "by mere words, he plans to enter heaven. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾ ਜਾਨਾ ਬੈਕੁੰਠ ਕਹਾ ਹੀ ॥",
      "transliteration": "naa jaanaa baiku(n)th kahaa hee ||",
      "translation": "I do not know where heaven is.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਾਨੁ ਜਾਨੁ ਸਭਿ ਕਹਹਿ ਤਹਾ ਹੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaan jaan sabh kahahi tahaa hee ||1|| rahaau ||",
      "translation": "Everyone claims that he plans to go there. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਹਨ ਕਹਾਵਨ ਨਹ ਪਤੀਅਈ ਹੈ ॥",
      "transliteration": "kahan kahaavan nah pateeaee hai ||",
      "translation": "By mere talk, the mind is not appeased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਉ ਮਨੁ ਮਾਨੈ ਜਾ ਤੇ ਹਉਮੈ ਜਈ ਹੈ ॥੨॥",
      "transliteration": "tau man maanai jaa te haumai jaee hai ||2||",
      "translation": "The mind is only appeased, when egotism is conquered. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਬ ਲਗੁ ਮਨਿ ਬੈਕੁੰਠ ਕੀ ਆਸ ॥",
      "transliteration": "jab lag man baiku(n)th kee aas ||",
      "translation": "As long as the mind is filled with the desire for heaven,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਬ ਲਗੁ ਹੋਇ ਨਹੀ ਚਰਨ ਨਿਵਾਸੁ ॥੩॥",
      "transliteration": "tab lag hoi nahee charan nivaas ||3||",
      "translation": "he does not dwell at the Lord's Feet. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਇਹ ਕਹੀਐ ਕਾਹਿ ॥",
      "transliteration": "kahu kabeer ih kaheeai kaahi ||",
      "translation": "Says Kabeer, unto whom should I tell this?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਬੈਕੁੰਠੈ ਆਹਿ ॥੪॥੧੦॥",
      "transliteration": "saadhasa(n)gat baiku(n)thai aahi ||4||10||",
      "translation": "The Saadh Sangat, the Company of the Holy, is heaven. ||4||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਉਪਜੈ ਨਿਪਜੈ ਨਿਪਜਿ ਸਮਾਈ ॥",
      "transliteration": "upajai nipajai nipaj samaaee ||",
      "translation": "We are born, and we grow, and having grown, we pass away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨੈਨਹ ਦੇਖਤ ਇਹੁ ਜਗੁ ਜਾਈ ॥੧॥",
      "transliteration": "nainah dekhat ihu jag jaaee ||1||",
      "translation": "Before our very eyes, this world is passing away. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਲਾਜ ਨ ਮਰਹੁ ਕਹਹੁ ਘਰੁ ਮੇਰਾ ॥",
      "transliteration": "laaj na marahu kahahu ghar meraa ||",
      "translation": "How can you not die of shame, claiming, This world is mine?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅੰਤ ਕੀ ਬਾਰ ਨਹੀ ਕਛੁ ਤੇਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "a(n)t kee baar nahee kachh teraa ||1|| rahaau ||",
      "translation": "At the very last moment, nothing is yours. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਨਿਕ ਜਤਨ ਕਰਿ ਕਾਇਆ ਪਾਲੀ ॥",
      "transliteration": "anik jatan kar kaaiaa paalee ||",
      "translation": "Trying various methods, you cherish your body,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਰਤੀ ਬਾਰ ਅਗਨਿ ਸੰਗਿ ਜਾਲੀ ॥੨॥",
      "transliteration": "maratee baar agan sa(n)g jaalee ||2||",
      "translation": "but at the time of death, it is burned in the fire. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚੋਆ ਚੰਦਨੁ ਮਰਦਨ ਅੰਗਾ ॥",
      "transliteration": "choaa cha(n)dan maradan a(n)gaa ||",
      "translation": "You apply sandalwood oil to your limbs,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੋ ਤਨੁ ਜਲੈ ਕਾਠ ਕੈ ਸੰਗਾ ॥੩॥",
      "transliteration": "so tan jalai kaath kai sa(n)gaa ||3||",
      "translation": "but that body is burned with the firewood. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਸੁਨਹੁ ਰੇ ਗੁਨੀਆ ॥",
      "transliteration": "kahu kabeer sunahu re guneeaa ||",
      "translation": "Says Kabeer, listen, O virtuous people:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਿਨਸੈਗੋ ਰੂਪੁ ਦੇਖੈ ਸਭ ਦੁਨੀਆ ॥੪॥੧੧॥",
      "transliteration": "binasaigo roop dekhai sabh duneeaa ||4||11||",
      "translation": "your beauty shall vanish, as the whole world watches. ||4||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਵਰ ਮੂਏ ਕਿਆ ਸੋਗੁ ਕਰੀਜੈ ॥",
      "transliteration": "avar mooe kiaa sog kareejai ||",
      "translation": "Why do you cry and mourn, when another person dies?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਉ ਕੀਜੈ ਜਉ ਆਪਨ ਜੀਜੈ ॥੧॥",
      "transliteration": "tau keejai jau aapan jeejai ||1||",
      "translation": "Do so only if you yourself are to live. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੈ ਨ ਮਰਉ ਮਰਿਬੋ ਸੰਸਾਰਾ ॥",
      "transliteration": "mai na marau maribo sa(n)saaraa ||",
      "translation": "I shall not die as the rest of the world dies,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਬ ਮੋਹਿ ਮਿਲਿਓ ਹੈ ਜੀਆਵਨਹਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ab mohi milio hai jeeaavanahaaraa ||1|| rahaau ||",
      "translation": "for now I have met the life-giving Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਇਆ ਦੇਹੀ ਪਰਮਲ ਮਹਕੰਦਾ ॥",
      "transliteration": "iaa dehee paramal mahaka(n)daa ||",
      "translation": "People anoint their bodies with fragrant oils,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤਾ ਸੁਖ ਬਿਸਰੇ ਪਰਮਾਨੰਦਾ ॥੨॥",
      "transliteration": "taa sukh bisare paramaana(n)daa ||2||",
      "translation": "and in that pleasure, they forget the supreme bliss. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕੂਅਟਾ ਏਕੁ ਪੰਚ ਪਨਿਹਾਰੀ ॥",
      "transliteration": "kooataa ek pa(n)ch panihaaree ||",
      "translation": "There is one well, and five water-carriers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਟੂਟੀ ਲਾਜੁ ਭਰੈ ਮਤਿ ਹਾਰੀ ॥੩॥",
      "transliteration": "tootee laaj bharai mat haaree ||3||",
      "translation": "Even though the rope is broken, the fools continue trying to draw water. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਇਕ ਬੁਧਿ ਬੀਚਾਰੀ ॥",
      "transliteration": "kahu kabeer ik budh beechaaree ||",
      "translation": "Says Kabeer, through contemplation, I have obtained this one understanding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾ ਓਹੁ ਕੂਅਟਾ ਨਾ ਪਨਿਹਾਰੀ ॥੪॥੧੨॥",
      "transliteration": "naa ohu kooataa naa panihaaree ||4||12||",
      "translation": "There is no well, and no water-carrier. ||4||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਅਸਥਾਵਰ ਜੰਗਮ ਕੀਟ ਪਤੰਗਾ ॥",
      "transliteration": "asathaavar ja(n)gam keet pata(n)gaa ||",
      "translation": "The mobile and immobile creatures, insects and moths",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0325_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਅਨਿਕ ਜਨਮ ਕੀਏ ਬਹੁ ਰੰਗਾ ॥੧॥",
      "transliteration": "anik janam keee bahu ra(n)gaa ||1||",
      "translation": "- in numerous lifetimes, I have passed through those many forms. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 325,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
