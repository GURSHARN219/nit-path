{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 326,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0326_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਐਸੇ ਘਰ ਹਮ ਬਹੁਤੁ ਬਸਾਏ ॥",
      "transliteration": "aise ghar ham bahut basaae ||",
      "translation": "I lived in many such homes, O Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਬ ਹਮ ਰਾਮ ਗਰਭ ਹੋਇ ਆਏ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jab ham raam garabh hoi aae ||1|| rahaau ||",
      "translation": "before I came into the womb this time. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੋਗੀ ਜਤੀ ਤਪੀ ਬ੍ਰਹਮਚਾਰੀ ॥",
      "transliteration": "jogee jatee tapee brahamachaaree ||",
      "translation": "I was a Yogi, a celibate, a penitent, and a Brahmchaaree, with strict self-discipline.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਬਹੂ ਰਾਜਾ ਛਤ੍ਰਪਤਿ ਕਬਹੂ ਭੇਖਾਰੀ ॥੨॥",
      "transliteration": "kabahoo raajaa chhatrapat kabahoo bhekhaaree ||2||",
      "translation": "Sometimes I was a king, sitting on the throne, and sometimes I was a beggar. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਕਤ ਮਰਹਿ ਸੰਤ ਸਭਿ ਜੀਵਹਿ ॥",
      "transliteration": "saakat marahi sa(n)t sabh jeevahi ||",
      "translation": "The faithless cynics shall die, while the Saints shall all survive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਮ ਰਸਾਇਨੁ ਰਸਨਾ ਪੀਵਹਿ ॥੩॥",
      "transliteration": "raam rasaain rasanaa peevahi ||3||",
      "translation": "They drink in the Lord's Ambrosial Essence with their tongues. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਪ੍ਰਭ ਕਿਰਪਾ ਕੀਜੈ ॥",
      "transliteration": "kahu kabeer prabh kirapaa keejai ||",
      "translation": "Says Kabeer, O God, have mercy on me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਾਰਿ ਪਰੇ ਅਬ ਪੂਰਾ ਦੀਜੈ ॥੪॥੧੩॥",
      "transliteration": "haar pare ab pooraa deejai ||4||13||",
      "translation": "I am so tired; now, please bless me with Your perfection. ||4||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ਕੀ ਨਾਲਿ ਰਲਾਇ ਲਿਖਿਆ ਮਹਲਾ ੫ ॥",
      "transliteration": "gauRee kabeer jee kee naal ralaai likhiaa mahalaa 5 ||",
      "translation": "Gauree, Kabeer Jee, With Writings Of The Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਐਸੋ ਅਚਰਜੁ ਦੇਖਿਓ ਕਬੀਰ ॥",
      "transliteration": "aiso acharaj dekhio kabeer ||",
      "translation": "Kabeer has seen such wonders!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦਧਿ ਕੈ ਭੋਲੈ ਬਿਰੋਲੈ ਨੀਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dadh kai bholai birolai neer ||1|| rahaau ||",
      "translation": "Mistaking it for cream, the people are churning water. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰੀ ਅੰਗੂਰੀ ਗਦਹਾ ਚਰੈ ॥",
      "transliteration": "haree a(n)gooree gadahaa charai ||",
      "translation": "The donkey grazes upon the green grass;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਿਤ ਉਠਿ ਹਾਸੈ ਹੀਗੈ ਮਰੈ ॥੧॥",
      "transliteration": "nit uth haasai heegai marai ||1||",
      "translation": "arising each day, he laughs and brays, and then dies. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਾਤਾ ਭੈਸਾ ਅੰਮੁਹਾ ਜਾਇ ॥",
      "transliteration": "maataa bhaisaa a(n)muhaa jaai ||",
      "translation": "The bull is intoxicated, and runs around wildly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕੁਦਿ ਕੁਦਿ ਚਰੈ ਰਸਾਤਲਿ ਪਾਇ ॥੨॥",
      "transliteration": "kud kud charai rasaatal paai ||2||",
      "translation": "He romps and eats and then falls into hell. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਪਰਗਟੁ ਭਈ ਖੇਡ ॥",
      "transliteration": "kahu kabeer paragat bhaee khed ||",
      "translation": "Says Kabeer, a strange sport has become manifest:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਲੇਲੇ ਕਉ ਚੂਘੈ ਨਿਤ ਭੇਡ ॥੩॥",
      "transliteration": "lele kau chooghai nit bhed ||3||",
      "translation": "the sheep is sucking the milk of her lamb. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਾਮ ਰਮਤ ਮਤਿ ਪਰਗਟੀ ਆਈ ॥",
      "transliteration": "raam ramat mat paragatee aaee ||",
      "translation": "Chanting the Lord's Name, my intellect is enlightened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਗੁਰਿ ਸੋਝੀ ਪਾਈ ॥੪॥੧॥੧੪॥",
      "transliteration": "kahu kabeer gur sojhee paaee ||4||1||14||",
      "translation": "Says Kabeer, the Guru has blessed me with this understanding. ||4||1||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ਪੰਚਪਦੇ₂ ॥",
      "transliteration": "gauRee kabeer jee pa(n)chapade₂ ||",
      "translation": "Gauree, Kabeer Jee, Panch-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਉ ਜਲ ਛੋਡਿ ਬਾਹਰਿ ਭਇਓ ਮੀਨਾ ॥",
      "transliteration": "jiu jal chhod baahar bhaio meenaa ||",
      "translation": "I am like a fish out of water,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪੂਰਬ ਜਨਮ ਹਉ ਤਪ ਕਾ ਹੀਨਾ ॥੧॥",
      "transliteration": "poorab janam hau tap kaa heenaa ||1||",
      "translation": "because in my previous life, I did not practice penance and intense meditation. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਬ ਕਹੁ ਰਾਮ ਕਵਨ ਗਤਿ ਮੋਰੀ ॥",
      "transliteration": "ab kahu raam kavan gat moree ||",
      "translation": "Now tell me, Lord, what will my condition be?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਜੀ ਲੇ ਬਨਾਰਸ ਮਤਿ ਭਈ ਥੋਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tajee le banaaras mat bhaee thoree ||1|| rahaau ||",
      "translation": "I left Benares - I had little common sense. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਗਲ ਜਨਮੁ ਸਿਵ ਪੁਰੀ ਗਵਾਇਆ ॥",
      "transliteration": "sagal janam siv puree gavaaiaa ||",
      "translation": "I wasted my whole life in the city of Shiva;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਰਤੀ ਬਾਰ ਮਗਹਰਿ ਉਠਿ ਆਇਆ ॥੨॥",
      "transliteration": "maratee baar magahar uth aaiaa ||2||",
      "translation": "at the time of my death, I moved to Magahar. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਹੁਤੁ ਬਰਸ ਤਪੁ ਕੀਆ ਕਾਸੀ ॥",
      "transliteration": "bahut baras tap keeaa kaasee ||",
      "translation": "For many years, I practiced penance and intense meditation at Kaashi;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਰਨੁ ਭਇਆ ਮਗਹਰ ਕੀ ਬਾਸੀ ॥੩॥",
      "transliteration": "maran bhaiaa magahar kee baasee ||3||",
      "translation": "now that my time to die has come, I have come to dwell at Magahar! ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਾਸੀ ਮਗਹਰ ਸਮ ਬੀਚਾਰੀ ॥",
      "transliteration": "kaasee magahar sam beechaaree ||",
      "translation": "Kaashi and Magahar - I consider them the same.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਓਛੀ ਭਗਤਿ ਕੈਸੇ ਉਤਰਸਿ ਪਾਰੀ ॥੪॥",
      "transliteration": "ochhee bhagat kaise utaras paaree ||4||",
      "translation": "With inadequate devotion, how can anyone swim across? ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਹੁ ਗੁਰ ਗਜ ਸਿਵ ਸਭੁ ਕੋ ਜਾਨੈ ॥",
      "transliteration": "kahu gur gaj siv sabh ko jaanai ||",
      "translation": "Says Kabeer, the Guru and Ganaysha and Shiva all know",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੁਆ ਕਬੀਰੁ ਰਮਤ ਸ੍ਰੀ ਰਾਮੈ ॥੫॥੧੫॥",
      "transliteration": "muaa kabeer ramat sree raamai ||5||15||",
      "translation": "that Kabeer died chanting the Lord's Name. ||5||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚੋਆ ਚੰਦਨ ਮਰਦਨ ਅੰਗਾ ॥",
      "transliteration": "choaa cha(n)dan maradan a(n)gaa ||",
      "translation": "You may anoint your limbs with sandalwood oil,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੋ ਤਨੁ ਜਲੈ ਕਾਠ ਕੈ ਸੰਗਾ ॥੧॥",
      "transliteration": "so tan jalai kaath kai sa(n)gaa ||1||",
      "translation": "but in the end, that body will be burned with the firewood. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਸੁ ਤਨ ਧਨ ਕੀ ਕਵਨ ਬਡਾਈ ॥",
      "transliteration": "is tan dhan kee kavan badaaee ||",
      "translation": "Why should anyone take pride in this body or wealth?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਧਰਨਿ ਪਰੈ ਉਰਵਾਰਿ ਨ ਜਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dharan parai uravaar na jaaee ||1|| rahaau ||",
      "translation": "They shall end up lying on the ground; they shall not go along with you to the world beyond. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਤਿ ਜਿ ਸੋਵਹਿ ਦਿਨ ਕਰਹਿ ਕਾਮ ॥",
      "transliteration": "raat j sovahi din karahi kaam ||",
      "translation": "They sleep by night and work during the day,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਕੁ ਖਿਨੁ ਲੇਹਿ ਨ ਹਰਿ ਕੋ ਨਾਮ ॥੨॥",
      "transliteration": "ik khin lehi na har ko naam ||2||",
      "translation": "but they do not chant the Lord's Name, even for an instant. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਾਥਿ ਤ ਡੋਰ ਮੁਖਿ ਖਾਇਓ ਤੰਬੋਰ ॥",
      "transliteration": "haath ta dor mukh khaaio ta(n)bor ||",
      "translation": "They hold the string of the kite in their hands, and chew betel leaves in their mouths,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਰਤੀ ਬਾਰ ਕਸਿ ਬਾਧਿਓ ਚੋਰ ॥੩॥",
      "transliteration": "maratee baar kas baadhio chor ||3||",
      "translation": "but at the time of death, they shall be tied up tight, like thieves. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰਮਤਿ ਰਸਿ ਰਸਿ ਹਰਿ ਗੁਨ ਗਾਵੈ ॥",
      "transliteration": "guramat ras ras har gun gaavai ||",
      "translation": "Through the Guru's Teachings, and immersed in His Love, sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰਾਮੈ ਰਾਮ ਰਮਤ ਸੁਖੁ ਪਾਵੈ ॥੪॥",
      "transliteration": "raamai raam ramat sukh paavai ||4||",
      "translation": "Chant the Name of the Lord, Raam, Raam, and find peace. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਿਰਪਾ ਕਰਿ ਕੈ ਨਾਮੁ ਦ੍ਰਿੜਾਈ ॥",
      "transliteration": "kirapaa kar kai naam driRaaee ||",
      "translation": "In His Mercy, He implants the Naam within us;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਬਾਸੁ ਸੁਗੰਧ ਬਸਾਈ ॥੫॥",
      "transliteration": "har har baas suga(n)dh basaaee ||5||",
      "translation": "inhale deeply the sweet aroma and fragrance of the Lord, Har, Har. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਹਤ ਕਬੀਰ ਚੇਤਿ ਰੇ ਅੰਧਾ ॥",
      "transliteration": "kahat kabeer chet re a(n)dhaa ||",
      "translation": "Says Kabeer, remember Him, you blind fool!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਤਿ ਰਾਮੁ ਝੂਠਾ ਸਭੁ ਧੰਧਾ ॥੬॥੧੬॥",
      "transliteration": "sat raam jhoothaa sabh dha(n)dhaa ||6||16||",
      "translation": "The Lord is True; all worldly affairs are false. ||6||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ਤਿਪਦੇ ਚਾਰਤੁਕੇ₂ ॥",
      "transliteration": "gauRee kabeer jee tipade chaaratuke₂ ||",
      "translation": "Gauree, Kabeer Jee, Thi-Padhay And Chau-Thukay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਮ ਤੇ ਉਲਟਿ ਭਏ ਹੈ ਰਾਮ ॥",
      "transliteration": "jam te ulat bhae hai raam ||",
      "translation": "I have turned away from death and turned to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਦੁਖ ਬਿਨਸੇ ਸੁਖ ਕੀਓ ਬਿਸਰਾਮ ॥",
      "transliteration": "dukh binase sukh keeo bisaraam ||",
      "translation": "Pain has been eliminated, and I dwell in peac and comfort.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬੈਰੀ ਉਲਟਿ ਭਏ ਹੈ ਮੀਤਾ ॥",
      "transliteration": "bairee ulat bhae hai meetaa ||",
      "translation": "My enemies have been transformed into friends.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਾਕਤ ਉਲਟਿ ਸੁਜਨ ਭਏ ਚੀਤਾ ॥੧॥",
      "transliteration": "saakat ulat sujan bhae cheetaa ||1||",
      "translation": "The faithless cynics have been transformed into good-hearted people. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅਬ ਮੋਹਿ ਸਰਬ ਕੁਸਲ ਕਰਿ ਮਾਨਿਆ ॥",
      "transliteration": "ab mohi sarab kusal kar maaniaa ||",
      "translation": "Now, I feel that everything brings me peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0326_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਾਂਤਿ ਭਈ ਜਬ ਗੋਬਿਦੁ ਜਾਨਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saa(n)t bhaee jab gobid jaaniaa ||1|| rahaau ||",
      "translation": "Peace and tranquility have come, since I realized the Lord of the Universe. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 326,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
