{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 327,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0327_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਨ ਮਹਿ ਹੋਤੀ ਕੋਟਿ ਉਪਾਧਿ ॥",
      "transliteration": "tan mahi hotee kot upaadh ||",
      "translation": "My body was afflicted with millions of diseases.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਉਲਟਿ ਭਈ ਸੁਖ ਸਹਜਿ ਸਮਾਧਿ ॥",
      "transliteration": "ulat bhaee sukh sahaj samaadh ||",
      "translation": "They have been transformed into the peaceful, tranquil concentration of Samaadhi.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਪੁ ਪਛਾਨੈ ਆਪੈ ਆਪ ॥",
      "transliteration": "aap pachhaanai aapai aap ||",
      "translation": "When someone understands his own self,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰੋਗੁ ਨ ਬਿਆਪੈ ਤੀਨੌ ਤਾਪ ॥੨॥",
      "transliteration": "rog na biaapai teenau taap ||2||",
      "translation": "he no longer suffers from illness and the three fevers. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਬ ਮਨੁ ਉਲਟਿ ਸਨਾਤਨੁ ਹੂਆ ॥",
      "transliteration": "ab man ulat sanaatan hooaa ||",
      "translation": "My mind has now been restored to its original purity.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਬ ਜਾਨਿਆ ਜਬ ਜੀਵਤ ਮੂਆ ॥",
      "transliteration": "tab jaaniaa jab jeevat mooaa ||",
      "translation": "When I became dead while yet alive, only then did I come to know the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਸੁਖਿ ਸਹਜਿ ਸਮਾਵਉ ॥",
      "transliteration": "kahu kabeer sukh sahaj samaavau ||",
      "translation": "Says Kabeer, I am now immersed in intuitive peace and poise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਪਿ ਨ ਡਰਉ ਨ ਅਵਰ ਡਰਾਵਉ ॥੩॥੧੭॥",
      "transliteration": "aap na darau na avar daraavau ||3||17||",
      "translation": "I do not fear anyone, and I do not strike fear into anyone else. ||3||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਿੰਡਿ ਮੂਐ ਜੀਉ ਕਿਹ ਘਰਿ ਜਾਤਾ ॥",
      "transliteration": "pi(n)d mooai jeeu kih ghar jaataa ||",
      "translation": "When the body dies, where does the soul go?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਬਦਿ ਅਤੀਤਿ ਅਨਾਹਦਿ ਰਾਤਾ ॥",
      "transliteration": "sabad ateet anaahad raataa ||",
      "translation": "It is absorbed into the untouched, unstruck melody of the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਿਨਿ ਰਾਮੁ ਜਾਨਿਆ ਤਿਨਹਿ ਪਛਾਨਿਆ ॥",
      "transliteration": "jin raam jaaniaa tinahi pachhaaniaa ||",
      "translation": "Only one who knows the Lord realizes Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਉ ਗੂੰਗੇ ਸਾਕਰ ਮਨੁ ਮਾਨਿਆ ॥੧॥",
      "transliteration": "jiu goo(n)ge saakar man maaniaa ||1||",
      "translation": "The mind is satisfied and satiated, like the mute who eats the sugar candy and just smiles, without speaking. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਐਸਾ ਗਿਆਨੁ ਕਥੈ ਬਨਵਾਰੀ ॥",
      "transliteration": "aisaa giaan kathai banavaaree ||",
      "translation": "Such is the spiritual wisdom which the Lord has imparted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਨ ਰੇ ਪਵਨ ਦ੍ਰਿੜ ਸੁਖਮਨ ਨਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "man re pavan driR sukhaman naaree ||1|| rahaau ||",
      "translation": "O mind, hold your breath steady within the central channel of the Sushmanaa. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੋ ਗੁਰੁ ਕਰਹੁ ਜਿ ਬਹੁਰਿ ਨ ਕਰਨਾ ॥",
      "transliteration": "so gur karahu j bahur na karanaa ||",
      "translation": "Adopt such a Guru, that you shall not have to adopt another again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੋ ਪਦੁ ਰਵਹੁ ਜਿ ਬਹੁਰਿ ਨ ਰਵਨਾ ॥",
      "transliteration": "so pad ravahu j bahur na ravanaa ||",
      "translation": "Dwell in such a state, that you shall never have to dwell in any other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੋ ਧਿਆਨੁ ਧਰਹੁ ਜਿ ਬਹੁਰਿ ਨ ਧਰਨਾ ॥",
      "transliteration": "so dhiaan dharahu j bahur na dharanaa ||",
      "translation": "Embrace such a meditation, that you shall never have to embrace any other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਐਸੇ ਮਰਹੁ ਜਿ ਬਹੁਰਿ ਨ ਮਰਨਾ ॥੨॥",
      "transliteration": "aise marahu j bahur na maranaa ||2||",
      "translation": "Die in such a way, that you shall never have to die again. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਉਲਟੀ ਗੰਗਾ ਜਮੁਨ ਮਿਲਾਵਉ ॥",
      "transliteration": "ulatee ga(n)gaa jamun milaavau ||",
      "translation": "Turn your breath away from the left channel, and away from the right channel, and unite them in the central channel of the Sushmanaa.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਨੁ ਜਲ ਸੰਗਮ ਮਨ ਮਹਿ ਨੑਾਵਉ ॥",
      "transliteration": "bin jal sa(n)gam man mahi nhaavau ||",
      "translation": "At their confluence within your mind, take your bath there without water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਲੋਚਾ ਸਮਸਰਿ ਇਹੁ ਬਿਉਹਾਰਾ ॥",
      "transliteration": "lochaa samasar ihu biuhaaraa ||",
      "translation": "To look upon all with an impartial eye - let this be your daily occupation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਤੁ ਬੀਚਾਰਿ ਕਿਆ ਅਵਰਿ ਬੀਚਾਰਾ ॥੩॥",
      "transliteration": "tat beechaar kiaa avar beechaaraa ||3||",
      "translation": "Contemplate this essence of reality - what else is there to contemplate? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਪੁ ਤੇਜੁ ਬਾਇ ਪ੍ਰਿਥਮੀ ਆਕਾਸਾ ॥",
      "transliteration": "ap tej baai prithamee aakaasaa ||",
      "translation": "Water, fire, wind, earth and ether",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਐਸੀ ਰਹਤ ਰਹਉ ਹਰਿ ਪਾਸਾ ॥",
      "transliteration": "aisee rahat rahau har paasaa ||",
      "translation": "adopt such a way of life and you shall be close to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਹੈ ਕਬੀਰ ਨਿਰੰਜਨ ਧਿਆਵਉ ॥",
      "transliteration": "kahai kabeer nira(n)jan dhiaavau ||",
      "translation": "Says Kabeer, meditate on the Immaculate Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਿਤੁ ਘਰਿ ਜਾਉ ਜਿ ਬਹੁਰਿ ਨ ਆਵਉ ॥੪॥੧੮॥",
      "transliteration": "tit ghar jaau j bahur na aavau ||4||18||",
      "translation": "Go to that home, which you shall never have to leave. ||4||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ਤਿਪਦੇ₁₅ ॥",
      "transliteration": "gauRee kabeer jee tipade₁₅ ||",
      "translation": "Gauree, Kabeer Jee, Thi-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕੰਚਨ ਸਿਉ ਪਾਈਐ ਨਹੀ ਤੋਲਿ ॥",
      "transliteration": "ka(n)chan siu paaeeai nahee tol ||",
      "translation": "He cannot be obtained by offering your weight in gold.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਨੁ ਦੇ ਰਾਮੁ ਲੀਆ ਹੈ ਮੋਲਿ ॥੧॥",
      "transliteration": "man de raam leeaa hai mol ||1||",
      "translation": "But I have bought the Lord by giving my mind to Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਬ ਮੋਹਿ ਰਾਮੁ ਅਪੁਨਾ ਕਰਿ ਜਾਨਿਆ ॥",
      "transliteration": "ab mohi raam apunaa kar jaaniaa ||",
      "translation": "Now I recognize that He is my Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਹਜ ਸੁਭਾਇ ਮੇਰਾ ਮਨੁ ਮਾਨਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sahaj subhaai meraa man maaniaa ||1|| rahaau ||",
      "translation": "My mind is intuitively pleased with Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬ੍ਰਹਮੈ ਕਥਿ ਕਥਿ ਅੰਤੁ ਨ ਪਾਇਆ ॥",
      "transliteration": "brahamai kath kath a(n)t na paaiaa ||",
      "translation": "Brahma spoke of Him continually, but could not find His limit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਮ ਭਗਤਿ ਬੈਠੇ ਘਰਿ ਆਇਆ ॥੨॥",
      "transliteration": "raam bhagat baithe ghar aaiaa ||2||",
      "translation": "Because of my devotion to the Lord, He has come to sit within the home of my inner being. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਚੰਚਲ ਮਤਿ ਤਿਆਗੀ ॥",
      "transliteration": "kahu kabeer cha(n)chal mat tiaagee ||",
      "translation": "Says Kabeer, I have renounced my restless intellect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕੇਵਲ ਰਾਮ ਭਗਤਿ ਨਿਜ ਭਾਗੀ ॥੩॥੧॥੧੯॥",
      "transliteration": "keval raam bhagat nij bhaagee ||3||1||19||",
      "translation": "It is my destiny to worship the Lord alone. ||3||1||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਹ ਮਰਨੈ ਸਭੁ ਜਗਤੁ ਤਰਾਸਿਆ ॥",
      "transliteration": "jih maranai sabh jagat taraasiaa ||",
      "translation": "That death which terrifies the entire world",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੋ ਮਰਨਾ ਗੁਰ ਸਬਦਿ ਪ੍ਰਗਾਸਿਆ ॥੧॥",
      "transliteration": "so maranaa gur sabad pragaasiaa ||1||",
      "translation": "- the nature of that death has been revealed to me, through the Word of the Guru's Shabad. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਬ ਕੈਸੇ ਮਰਉ ਮਰਨਿ ਮਨੁ ਮਾਨਿਆ ॥",
      "transliteration": "ab kaise marau maran man maaniaa ||",
      "translation": "Now, how shall I die? My mind has already accepted death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਰਿ ਮਰਿ ਜਾਤੇ ਜਿਨ ਰਾਮੁ ਨ ਜਾਨਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mar mar jaate jin raam na jaaniaa ||1|| rahaau ||",
      "translation": "Those who do not know the Lord, die over and over again, and then depart. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਰਨੋ ਮਰਨੁ ਕਹੈ ਸਭੁ ਕੋਈ ॥",
      "transliteration": "marano maran kahai sabh koee ||",
      "translation": "Everyone says, I will die, I will die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਹਜੇ ਮਰੈ ਅਮਰੁ ਹੋਇ ਸੋਈ ॥੨॥",
      "transliteration": "sahaje marai amar hoi soee ||2||",
      "translation": "But he alone becomes immortal, who dies with intuitive understanding. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਮਨਿ ਭਇਆ ਅਨੰਦਾ ॥",
      "transliteration": "kahu kabeer man bhaiaa ana(n)daa ||",
      "translation": "Says Kabeer, my mind is filled with bliss;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਇਆ ਭਰਮੁ ਰਹਿਆ ਪਰਮਾਨੰਦਾ ॥੩॥੨੦॥",
      "transliteration": "gaiaa bharam rahiaa paramaana(n)daa ||3||20||",
      "translation": "my doubts have been eliminated, and I am in ecstasy. ||3||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਤ ਨਹੀ ਠਉਰ ਮੂਲੁ ਕਤ ਲਾਵਉ ॥",
      "transliteration": "kat nahee thaur mool kat laavau ||",
      "translation": "There is no special place where the soul aches; where should I apply the ointment?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਖੋਜਤ ਤਨ ਮਹਿ ਠਉਰ ਨ ਪਾਵਉ ॥੧॥",
      "transliteration": "khojat tan mahi thaur na paavau ||1||",
      "translation": "I have searched the body, but I have not found such a place. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਲਾਗੀ ਹੋਇ ਸੁ ਜਾਨੈ ਪੀਰ ॥",
      "transliteration": "laagee hoi s jaanai peer ||",
      "translation": "He alone knows it, who feels the pain of such love;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਰਾਮ ਭਗਤਿ ਅਨੀਆਲੇ ਤੀਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raam bhagat aneeaale teer ||1|| rahaau ||",
      "translation": "the arrows of the Lord's devotional worship are so sharp! ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਏਕ ਭਾਇ ਦੇਖਉ ਸਭ ਨਾਰੀ ॥",
      "transliteration": "ek bhaai dekhau sabh naaree ||",
      "translation": "I look upon all His soul-brides with an impartial eye;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਿਆ ਜਾਨਉ ਸਹ ਕਉਨ ਪਿਆਰੀ ॥੨॥",
      "transliteration": "kiaa jaanau sah kaun piaaree ||2||",
      "translation": "how can I know which ones are dear to the Husband Lord? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਜਾ ਕੈ ਮਸਤਕਿ ਭਾਗੁ ॥",
      "transliteration": "kahu kabeer jaa kai masatak bhaag ||",
      "translation": "Says Kabeer, one who has such destiny inscribed upon her forehead",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0327_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਭ ਪਰਹਰਿ ਤਾ ਕਉ ਮਿਲੈ ਸੁਹਾਗੁ ॥੩॥੨੧॥",
      "transliteration": "sabh parahar taa kau milai suhaag ||3||21||",
      "translation": "- her Husband Lord turns all others away, and meets with her. ||3||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 327,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
