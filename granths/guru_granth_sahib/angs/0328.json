{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 328,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0328_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾ ਕੈ ਹਰਿ ਸਾ ਠਾਕੁਰੁ ਭਾਈ ॥",
      "transliteration": "jaa kai har saa thaakur bhaaee ||",
      "translation": "One who has the Lord as his Master, O Siblings of Destiny",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੁਕਤਿ ਅਨੰਤ ਪੁਕਾਰਣਿ ਜਾਈ ॥੧॥",
      "transliteration": "mukat ana(n)t pukaaran jaaee ||1||",
      "translation": "- countless liberations knock at his door. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਬ ਕਹੁ ਰਾਮ ਭਰੋਸਾ ਤੋਰਾ ॥",
      "transliteration": "ab kahu raam bharosaa toraa ||",
      "translation": "If I say now that my trust is in You alone, Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਬ ਕਾਹੂ ਕਾ ਕਵਨੁ ਨਿਹੋਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tab kaahoo kaa kavan nihoraa ||1|| rahaau ||",
      "translation": "then what obligation do I have to anyone else? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੀਨਿ ਲੋਕ ਜਾ ਕੈ ਹਹਿ ਭਾਰ ॥",
      "transliteration": "teen lok jaa kai hahi bhaar ||",
      "translation": "He bears the burden of the three worlds;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੋ ਕਾਹੇ ਨ ਕਰੈ ਪ੍ਰਤਿਪਾਰ ॥੨॥",
      "transliteration": "so kaahe na karai pratipaar ||2||",
      "translation": "why should He not cherish you also? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਇਕ ਬੁਧਿ ਬੀਚਾਰੀ ॥",
      "transliteration": "kahu kabeer ik budh beechaaree ||",
      "translation": "Says Kabeer, through contemplation, I have obtained this one understanding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਿਆ ਬਸੁ ਜਉ ਬਿਖੁ ਦੇ ਮਹਤਾਰੀ ॥੩॥੨੨॥",
      "transliteration": "kiaa bas jau bikh de mahataaree ||3||22||",
      "translation": "If the mother poisons her own child, what can anyone do? ||3||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਨੁ ਸਤ ਸਤੀ ਹੋਇ ਕੈਸੇ ਨਾਰਿ ॥",
      "transliteration": "bin sat satee hoi kaise naar ||",
      "translation": "Without Truth, how can the woman be a true satee - a widow who burns herself on her husband's funeral pyre?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪੰਡਿਤ ਦੇਖਹੁ ਰਿਦੈ ਬੀਚਾਰਿ ॥੧॥",
      "transliteration": "pa(n)dit dekhahu ridai beechaar ||1||",
      "translation": "O Pandit, O religious scholar, see this and contemplate it within your heart. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪ੍ਰੀਤਿ ਬਿਨਾ ਕੈਸੇ ਬਧੈ ਸਨੇਹੁ ॥",
      "transliteration": "preet binaa kaise badhai sanehu ||",
      "translation": "Without love, how can one's affection increase?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਬ ਲਗੁ ਰਸੁ ਤਬ ਲਗੁ ਨਹੀ ਨੇਹੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jab lag ras tab lag nahee nehu ||1|| rahaau ||",
      "translation": "As long as there is attachment to pleasure, there can be no spiritual love. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਾਹਨਿ ਸਤੁ ਕਰੈ ਜੀਅ ਅਪਨੈ ॥",
      "transliteration": "saahan sat karai jee apanai ||",
      "translation": "One who, in his own soul, believes the Queen Maya to be true,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੋ ਰਮਯੇ ਕਉ ਮਿਲੈ ਨ ਸੁਪਨੈ ॥੨॥",
      "transliteration": "so ramaye kau milai na supanai ||2||",
      "translation": "does not meet the Lord, even in dreams. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਧਨੁ ਗ੍ਰਿਹੁ ਸਉਪਿ ਸਰੀਰੁ ॥",
      "transliteration": "tan man dhan grihu saup sareer ||",
      "translation": "One who surrenders her body, mind, wealth, home and self",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੋਈ ਸੁਹਾਗਨਿ ਕਹੈ ਕਬੀਰੁ ॥੩॥੨੩॥",
      "transliteration": "soee suhaagan kahai kabeer ||3||23||",
      "translation": "- she is the true soul-bride, says Kabeer. ||3||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਖਿਆ ਬਿਆਪਿਆ ਸਗਲ ਸੰਸਾਰੁ ॥",
      "transliteration": "bikhiaa biaapiaa sagal sa(n)saar ||",
      "translation": "The whole world is engrossed in corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਖਿਆ ਲੈ ਡੂਬੀ ਪਰਵਾਰੁ ॥੧॥",
      "transliteration": "bikhiaa lai doobee paravaar ||1||",
      "translation": "This corruption has drowned entire families. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰੇ ਨਰ ਨਾਵ ਚਉੜਿ ਕਤ ਬੋੜੀ ॥",
      "transliteration": "re nar naav chauR kat boRee ||",
      "translation": "O man, why have you wrecked your boat and sunk it?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਰਿ ਸਿਉ ਤੋੜਿ ਬਿਖਿਆ ਸੰਗਿ ਜੋੜੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har siu toR bikhiaa sa(n)g joRee ||1|| rahaau ||",
      "translation": "You have broken with the Lord, and joined hands with corruption. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੁਰਿ ਨਰ ਦਾਧੇ ਲਾਗੀ ਆਗਿ ॥",
      "transliteration": "sur nar daadhe laagee aag ||",
      "translation": "Angels and human beings alike are burning in the raging fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਿਕਟਿ ਨੀਰੁ ਪਸੁ ਪੀਵਸਿ ਨ ਝਾਗਿ ॥੨॥",
      "transliteration": "nikat neer pas peevas na jhaag ||2||",
      "translation": "The water is near at hand, but the beast does not drink it in. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚੇਤਤ ਚੇਤਤ ਨਿਕਸਿਓ ਨੀਰੁ ॥",
      "transliteration": "chetat chetat nikasio neer ||",
      "translation": "By constant contemplation and awareness, the water is brought forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੋ ਜਲੁ ਨਿਰਮਲੁ ਕਥਤ ਕਬੀਰੁ ॥੩॥੨੪॥",
      "transliteration": "so jal niramal kathat kabeer ||3||24||",
      "translation": "That water is immaculate and pure, says Kabeer. ||3||24||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਹ ਕੁਲਿ ਪੂਤੁ ਨ ਗਿਆਨ ਬੀਚਾਰੀ ॥",
      "transliteration": "jih kul poot na giaan beechaaree ||",
      "translation": "That family, whose son has no spiritual wisdom or contemplation",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿਧਵਾ ਕਸ ਨ ਭਈ ਮਹਤਾਰੀ ॥੧॥",
      "transliteration": "bidhavaa kas na bhaee mahataaree ||1||",
      "translation": "- why didn't his mother just become a widow? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਹ ਨਰ ਰਾਮ ਭਗਤਿ ਨਹਿ ਸਾਧੀ ॥",
      "transliteration": "jih nar raam bhagat nahi saadhee ||",
      "translation": "That man who has not practiced devotional worship of the Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਨਮਤ ਕਸ ਨ ਮੁਓ ਅਪਰਾਧੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "janamat kas na muo aparaadhee ||1|| rahaau ||",
      "translation": "- why didn't such a sinful man die at birth? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੁਚੁ ਮੁਚੁ ਗਰਭ ਗਏ ਕੀਨ ਬਚਿਆ ॥",
      "transliteration": "much much garabh gae keen bachiaa ||",
      "translation": "So many pregnancies end in miscarriage - why was this one spared?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬੁਡਭੁਜ ਰੂਪ ਜੀਵੇ ਜਗ ਮਝਿਆ ॥੨॥",
      "transliteration": "budabhuj roop jeeve jag majhiaa ||2||",
      "translation": "He lives his life in this world like a deformed amputee. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਜੈਸੇ ਸੁੰਦਰ ਸਰੂਪ ॥",
      "transliteration": "kahu kabeer jaise su(n)dar saroop ||",
      "translation": "Says Kabeer, without the Naam, the Name of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਜੈਸੇ ਕੁਬਜ ਕੁਰੂਪ ॥੩॥੨੫॥",
      "transliteration": "naam binaa jaise kubaj kuroop ||3||25||",
      "translation": "Beautiful and handsome people are just ugly hunch-backs. ||3||25||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੋ ਜਨ ਲੇਹਿ ਖਸਮ ਕਾ ਨਾਉ ॥",
      "transliteration": "jo jan lehi khasam kaa naau ||",
      "translation": "I am forever a sacrifice to those humble beings",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਿਨ ਕੈ ਸਦ ਬਲਿਹਾਰੈ ਜਾਉ ॥੧॥",
      "transliteration": "tin kai sad balihaarai jaau ||1||",
      "translation": "Who take the Name of their Lord and Master. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੋ ਨਿਰਮਲੁ ਨਿਰਮਲ ਹਰਿ ਗੁਨ ਗਾਵੈ ॥",
      "transliteration": "so niramal niramal har gun gaavai ||",
      "translation": "Those who sing the Glorious Praises of the Pure Lord are pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੋ ਭਾਈ ਮੇਰੈ ਮਨਿ ਭਾਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "so bhaaee merai man bhaavai ||1|| rahaau ||",
      "translation": "They are my Siblings of Destiny, so dear to my heart. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਹ ਘਟ ਰਾਮੁ ਰਹਿਆ ਭਰਪੂਰਿ ॥",
      "transliteration": "jih ghat raam rahiaa bharapoor ||",
      "translation": "I am the dust of the lotus feet of those",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਿਨ ਕੀ ਪਗ ਪੰਕਜ ਹਮ ਧੂਰਿ ॥੨॥",
      "transliteration": "tin kee pag pa(n)kaj ham dhoor ||2||",
      "translation": "Whose hearts are filled with the All-pervading Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਾਤਿ ਜੁਲਾਹਾ ਮਤਿ ਕਾ ਧੀਰੁ ॥",
      "transliteration": "jaat julaahaa mat kaa dheer ||",
      "translation": "I am a weaver by birth, and patient of mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਹਜਿ ਸਹਜਿ ਗੁਣ ਰਮੈ ਕਬੀਰੁ ॥੩॥੨੬॥",
      "transliteration": "sahaj sahaj gun ramai kabeer ||3||26||",
      "translation": "Slowly, steadily, Kabeer chants the Glories of God. ||3||26||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗਗਨਿ ਰਸਾਲ ਚੁਐ ਮੇਰੀ ਭਾਠੀ ॥",
      "transliteration": "gagan rasaal chuai meree bhaathee ||",
      "translation": "From the Sky of the Tenth Gate, the nectar trickles down, distilled from my furnace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੰਚਿ ਮਹਾ ਰਸੁ ਤਨੁ ਭਇਆ ਕਾਠੀ ॥੧॥",
      "transliteration": "sa(n)ch mahaa ras tan bhaiaa kaathee ||1||",
      "translation": "I have gathered in this most sublime essence, making my body into firewood. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਉਆ ਕਉ ਕਹੀਐ ਸਹਜ ਮਤਵਾਰਾ ॥",
      "transliteration": "uaa kau kaheeai sahaj matavaaraa ||",
      "translation": "He alone is called intoxicated with intuitive peace and poise,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪੀਵਤ ਰਾਮ ਰਸੁ ਗਿਆਨ ਬੀਚਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "peevat raam ras giaan beechaaraa ||1|| rahaau ||",
      "translation": "who drinks in the juice of the Lord's essence, contemplating spiritual wisdom. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਹਜ ਕਲਾਲਨਿ ਜਉ ਮਿਲਿ ਆਈ ॥",
      "transliteration": "sahaj kalaalan jau mil aaee ||",
      "translation": "Intuitive poise is the bar-maid who comes to serve it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਆਨੰਦਿ ਮਾਤੇ ਅਨਦਿਨੁ ਜਾਈ ॥੨॥",
      "transliteration": "aana(n)d maate anadin jaaee ||2||",
      "translation": "I pass my nights and days in ecstasy. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਚੀਨਤ ਚੀਤੁ ਨਿਰੰਜਨ ਲਾਇਆ ॥",
      "transliteration": "cheenat cheet nira(n)jan laaiaa ||",
      "translation": "Through conscious meditation, I linked my consciousness with the Immaculate Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਤੌ ਅਨਭਉ ਪਾਇਆ ॥੩॥੨੭॥",
      "transliteration": "kahu kabeer tau anabhau paaiaa ||3||27||",
      "translation": "Says Kabeer, then I obtained the Fearless Lord. ||3||27||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0328_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਮਨ ਕਾ ਸੁਭਾਉ ਮਨਹਿ ਬਿਆਪੀ ॥",
      "transliteration": "man kaa subhaau manahi biaapee ||",
      "translation": "The natural tendency of the mind is to chase the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 328,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
