{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 329,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0329_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਨਹਿ ਮਾਰਿ ਕਵਨ ਸਿਧਿ ਥਾਪੀ ॥੧॥",
      "transliteration": "manahi maar kavan sidh thaapee ||1||",
      "translation": "Who has established himself as a Siddha, a being of miraculous spiritual powers, by killing his mind? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਵਨੁ ਸੁ ਮੁਨਿ ਜੋ ਮਨੁ ਮਾਰੈ ॥",
      "transliteration": "kavan s mun jo man maarai ||",
      "translation": "Who is that silent sage, who has killed his mind?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਨ ਕਉ ਮਾਰਿ ਕਹਹੁ ਕਿਸੁ ਤਾਰੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "man kau maar kahahu kis taarai ||1|| rahaau ||",
      "translation": "By killing the mind, tell me, who is saved? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਨ ਅੰਤਰਿ ਬੋਲੈ ਸਭੁ ਕੋਈ ॥",
      "transliteration": "man a(n)tar bolai sabh koee ||",
      "translation": "Everyone speaks through the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਨ ਮਾਰੇ ਬਿਨੁ ਭਗਤਿ ਨ ਹੋਈ ॥੨॥",
      "transliteration": "man maare bin bhagat na hoee ||2||",
      "translation": "Without killing the mind, devotional worship is not performed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਜੋ ਜਾਨੈ ਭੇਉ ॥",
      "transliteration": "kahu kabeer jo jaanai bheu ||",
      "translation": "Says Kabeer, one who knows the secret of this mystery,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਨੁ ਮਧੁਸੂਦਨੁ ਤ੍ਰਿਭਵਣ ਦੇਉ ॥੩॥੨੮॥",
      "transliteration": "man madhusoodan tribhavan deu ||3||28||",
      "translation": "beholds within his own mind the Lord of the three worlds. ||3||28||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਓਇ ਜੁ ਦੀਸਹਿ ਅੰਬਰਿ ਤਾਰੇ ॥",
      "transliteration": "oi j deesahi a(n)bar taare ||",
      "translation": "The stars which are seen in the sky",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿਨਿ ਓਇ ਚੀਤੇ ਚੀਤਨਹਾਰੇ ॥੧॥",
      "transliteration": "kin oi cheete cheetanahaare ||1||",
      "translation": "- who is the painter who painted them? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਹੁ ਰੇ ਪੰਡਿਤ ਅੰਬਰੁ ਕਾ ਸਿਉ ਲਾਗਾ ॥",
      "transliteration": "kahu re pa(n)dit a(n)bar kaa siu laagaa ||",
      "translation": "Tell me, O Pandit, what is the sky attached to?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬੂਝੈ ਬੂਝਨਹਾਰੁ ਸਭਾਗਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "boojhai boojhanahaar sabhaagaa ||1|| rahaau ||",
      "translation": "Very fortunate is the knower who knows this. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੂਰਜ ਚੰਦੁ ਕਰਹਿ ਉਜੀਆਰਾ ॥",
      "transliteration": "sooraj cha(n)d karahi ujeeaaraa ||",
      "translation": "The sun and the moon give their light;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਭ ਮਹਿ ਪਸਰਿਆ ਬ੍ਰਹਮ ਪਸਾਰਾ ॥੨॥",
      "transliteration": "sabh mahi pasariaa braham pasaaraa ||2||",
      "translation": "God's creative extension extends everywhere. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਜਾਨੈਗਾ ਸੋਇ ॥",
      "transliteration": "kahu kabeer jaanaigaa soi ||",
      "translation": "Says Kabeer, he alone knows this,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਿਰਦੈ ਰਾਮੁ ਮੁਖਿ ਰਾਮੈ ਹੋਇ ॥੩॥੨੯॥",
      "transliteration": "hiradai raam mukh raamai hoi ||3||29||",
      "translation": "whose heart is filled with the Lord, and whose mouth is also filled with the Lord. ||3||29||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬੇਦ ਕੀ ਪੁਤ੍ਰੀ ਸਿੰਮ੍ਰਿਤਿ ਭਾਈ ॥",
      "transliteration": "bed kee putree si(n)mrit bhaaee ||",
      "translation": "The Simritee is the daughter of the Vedas, O Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਾਂਕਲ ਜੇਵਰੀ ਲੈ ਹੈ ਆਈ ॥੧॥",
      "transliteration": "saa(n)kal jevaree lai hai aaee ||1||",
      "translation": "She has brought a chain and a rope. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਪਨ ਨਗਰੁ ਆਪ ਤੇ ਬਾਧਿਆ ॥",
      "transliteration": "aapan nagar aap te baadhiaa ||",
      "translation": "She has imprisoned the people in her own city.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮੋਹ ਕੈ ਫਾਧਿ ਕਾਲ ਸਰੁ ਸਾਂਧਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "moh kai phaadh kaal sar saa(n)dhiaa ||1|| rahaau ||",
      "translation": "She has tightened the noose of emotional attachment and shot the arrow of death. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਟੀ ਨ ਕਟੈ ਤੂਟਿ ਨਹ ਜਾਈ ॥",
      "transliteration": "katee na katai toot nah jaaee ||",
      "translation": "By cutting, she cannot be cut, and she cannot be broken.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਾ ਸਾਪਨਿ ਹੋਇ ਜਗ ਕਉ ਖਾਈ ॥੨॥",
      "transliteration": "saa saapan hoi jag kau khaaee ||2||",
      "translation": "She has become a serpent, and she is eating the world. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਮ ਦੇਖਤ ਜਿਨਿ ਸਭੁ ਜਗੁ ਲੂਟਿਆ ॥",
      "transliteration": "ham dekhat jin sabh jag lootiaa ||",
      "translation": "Before my very eyes, she has plundered the entire world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਮੈ ਰਾਮ ਕਹਿ ਛੂਟਿਆ ॥੩॥੩੦॥",
      "transliteration": "kahu kabeer mai raam kahi chhootiaa ||3||30||",
      "translation": "Says Kabeer, chanting the Lord's Name, I have escaped her. ||3||30||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੇਇ ਮੁਹਾਰ ਲਗਾਮੁ ਪਹਿਰਾਵਉ ॥",
      "transliteration": "dei muhaar lagaam pahiraavau ||",
      "translation": "I have grasped the reins and attached the bridle;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਗਲ ਤ ਜੀਨੁ ਗਗਨ ਦਉਰਾਵਉ ॥੧॥",
      "transliteration": "sagal ta jeen gagan dauraavau ||1||",
      "translation": "abandoning everything, I now ride through the skies. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਪਨੈ ਬੀਚਾਰਿ ਅਸਵਾਰੀ ਕੀਜੈ ॥",
      "transliteration": "apanai beechaar asavaaree keejai ||",
      "translation": "I made self-reflection my mount,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਹਜ ਕੈ ਪਾਵੜੈ ਪਗੁ ਧਰਿ ਲੀਜੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sahaj kai paavaRai pag dhar leejai ||1|| rahaau ||",
      "translation": "and in the stirrups of intuitive poise, I placed my feet. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚਲੁ ਰੇ ਬੈਕੁੰਠ ਤੁਝਹਿ ਲੇ ਤਾਰਉ ॥",
      "transliteration": "chal re baiku(n)th tujhahi le taarau ||",
      "translation": "Come, and let me ride you to heaven.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹਿਚਹਿ ਤ ਪ੍ਰੇਮ ਕੈ ਚਾਬੁਕ ਮਾਰਉ ॥੨॥",
      "transliteration": "hichahi ta prem kai chaabuk maarau ||2||",
      "translation": "If you hold back, then I shall strike you with the whip of spiritual love. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਹਤ ਕਬੀਰ ਭਲੇ ਅਸਵਾਰਾ ॥",
      "transliteration": "kahat kabeer bhale asavaaraa ||",
      "translation": "Says Kabeer, those who remain detached from the",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬੇਦ ਕਤੇਬ ਤੇ ਰਹਹਿ ਨਿਰਾਰਾ ॥੩॥੩੧॥",
      "transliteration": "bed kateb te rahahi niraaraa ||3||31||",
      "translation": "Vedas, the Koran and the Bible are the best riders. ||3||31||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਹ ਮੁਖਿ ਪਾਂਚਉ ਅੰਮ੍ਰਿਤ ਖਾਏ ॥",
      "transliteration": "jih mukh paa(n)chau a(n)mrit khaae ||",
      "translation": "That mouth, which used to eat the five delicacies",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਿਹ ਮੁਖ ਦੇਖਤ ਲੂਕਟ ਲਾਏ ॥੧॥",
      "transliteration": "tih mukh dekhat lookat laae ||1||",
      "translation": "- I have seen the flames being applied to that mouth. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਇਕੁ ਦੁਖੁ ਰਾਮ ਰਾਇ ਕਾਟਹੁ ਮੇਰਾ ॥",
      "transliteration": "ik dukh raam raai kaatahu meraa ||",
      "translation": "O Lord, my King, please rid me of this one affliction:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਗਨਿ ਦਹੈ ਅਰੁ ਗਰਭ ਬਸੇਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "agan dahai ar garabh baseraa ||1|| rahaau ||",
      "translation": "may I not be burned in fire, or cast into the womb again. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਾਇਆ ਬਿਗੂਤੀ ਬਹੁ ਬਿਧਿ ਭਾਤੀ ॥",
      "transliteration": "kaaiaa bigootee bahu bidh bhaatee ||",
      "translation": "The body is destroyed by so many ways and means.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕੋ ਜਾਰੇ ਕੋ ਗਡਿ ਲੇ ਮਾਟੀ ॥੨॥",
      "transliteration": "ko jaare ko gad le maatee ||2||",
      "translation": "Some burn it, and some bury it in the earth. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਹਰਿ ਚਰਣ ਦਿਖਾਵਹੁ ॥",
      "transliteration": "kahu kabeer har charan dikhaavahu ||",
      "translation": "Says Kabeer, O Lord, please reveal to me Your Lotus Feet;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪਾਛੈ ਤੇ ਜਮੁ ਕਿਉ ਨ ਪਠਾਵਹੁ ॥੩॥੩੨॥",
      "transliteration": "paachhai te jam kiu na pathaavahu ||3||32||",
      "translation": "after that, go ahead and send me to my death. ||3||32||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "gauRee kabeer jee ||",
      "translation": "Gauree, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਪੇ ਪਾਵਕੁ ਆਪੇ ਪਵਨਾ ॥",
      "transliteration": "aape paavak aape pavanaa ||",
      "translation": "He Himself is the fire, and He Himself is the wind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਾਰੈ ਖਸਮੁ ਤ ਰਾਖੈ ਕਵਨਾ ॥੧॥",
      "transliteration": "jaarai khasam ta raakhai kavanaa ||1||",
      "translation": "When our Lord and Master wishes to burn someone, then who can save him? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਾਮ ਜਪਤ ਤਨੁ ਜਰਿ ਕੀ ਨ ਜਾਇ ॥",
      "transliteration": "raam japat tan jar kee na jaai ||",
      "translation": "When I chant the Lord's Name, what does it matter if my body burns?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਚਿਤੁ ਰਹਿਆ ਸਮਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raam naam chit rahiaa samaai ||1|| rahaau ||",
      "translation": "My consciousness remains absorbed in the Lord's Name. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਾ ਕੋ ਜਰੈ ਕਾਹਿ ਹੋਇ ਹਾਨਿ ॥",
      "transliteration": "kaa ko jarai kaahi hoi haan ||",
      "translation": "Who is burned, and who suffers loss?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਟ ਵਟ ਖੇਲੈ ਸਾਰਿਗਪਾਨਿ ॥੨॥",
      "transliteration": "nat vat khelai saarigapaan ||2||",
      "translation": "The Lord plays, like the juggler with his ball. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਅਖਰ ਦੁਇ ਭਾਖਿ ॥",
      "transliteration": "kahu kabeer akhar dui bhaakh ||",
      "translation": "Says Kabeer, chant the two letters of the Lord's Name - Raa Maa.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਹੋਇਗਾ ਖਸਮੁ ਤ ਲੇਇਗਾ ਰਾਖਿ ॥੩॥੩੩॥",
      "transliteration": "hoigaa khasam ta leigaa raakh ||3||33||",
      "translation": "If He is your Lord and Master, He will protect you. ||3||33||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗਉੜੀ ਕਬੀਰ ਜੀ ਦੁਪਦੇ₂ ॥",
      "transliteration": "gauRee kabeer jee dupade₂ ||",
      "translation": "Gauree, Kabeer Jee, Dho-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨਾ ਮੈ ਜੋਗ ਧਿਆਨ ਚਿਤੁ ਲਾਇਆ ॥",
      "transliteration": "naa mai jog dhiaan chit laaiaa ||",
      "translation": "I have not practiced Yoga, or focused my consciousness on meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਬਿਨੁ ਬੈਰਾਗ ਨ ਛੂਟਸਿ ਮਾਇਆ ॥੧॥",
      "transliteration": "bin bairaag na chhootas maaiaa ||1||",
      "translation": "Without renunciation, I cannot escape Maya. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0329_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕੈਸੇ ਜੀਵਨੁ ਹੋਇ ਹਮਾਰਾ ॥",
      "transliteration": "kaise jeevan hoi hamaaraa ||",
      "translation": "How have I passed my life?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 329,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
