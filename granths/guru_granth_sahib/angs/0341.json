{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 341,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0341_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਝਝਾ ਉਰਝਿ ਸੁਰਝਿ ਨਹੀ ਜਾਨਾ ॥",
      "transliteration": "jhajhaa urajh surajh nahee jaanaa ||",
      "translation": "JHAJHA: You are entangled in the world, and you do not know how to get untangled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਹਿਓ ਝਝਕਿ ਨਾਹੀ ਪਰਵਾਨਾ ॥",
      "transliteration": "rahio jhajhak naahee paravaanaa ||",
      "translation": "You hold back in fear, and are not approved by the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਤ ਝਖਿ ਝਖਿ ਅਉਰਨ ਸਮਝਾਵਾ ॥",
      "transliteration": "kat jhakh jhakh auran samajhaavaa ||",
      "translation": "Why do you talk such nonsense, trying to convince others?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਝਗਰੁ ਕੀਏ ਝਗਰਉ ਹੀ ਪਾਵਾ ॥੧੫॥",
      "transliteration": "jhagar keee jhagarau hee paavaa ||15||",
      "translation": "Stirring up arguments, you shall only obtain more arguments. ||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਞੰਞਾ ਨਿਕਟਿ ਜੁ ਘਟ ਰਹਿਓ ਦੂਰਿ ਕਹਾ ਤਜਿ ਜਾਇ ॥",
      "transliteration": "nja(n)njaa nikat j ghat rahio door kahaa taj jaai ||",
      "translation": "NYANYA: He dwells near you, deep within your heart; why do you leave Him and go far away?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਾ ਕਾਰਣਿ ਜਗੁ ਢੂਢਿਅਉ ਨੇਰਉ ਪਾਇਅਉ ਤਾਹਿ ॥੧੬॥",
      "transliteration": "jaa kaaran jag dhoodhiau nerau paaiau taahi ||16||",
      "translation": "I searched the whole world for Him, but I found Him near myself. ||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਟਟਾ ਬਿਕਟ ਘਾਟ ਘਟ ਮਾਹੀ ॥",
      "transliteration": "tataa bikat ghaat ghat maahee ||",
      "translation": "TATTA: It is such a difficult path, to find Him within your own heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਖੋਲਿ ਕਪਾਟ ਮਹਲਿ ਕਿ ਨ ਜਾਹੀ ॥",
      "transliteration": "khol kapaat mahal k na jaahee ||",
      "translation": "Open the doors within, and enter the Mansion of His Presence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੇਖਿ ਅਟਲ ਟਲਿ ਕਤਹਿ ਨ ਜਾਵਾ ॥",
      "transliteration": "dekh atal tal katahi na jaavaa ||",
      "translation": "Beholding the Immovable Lord, you shall not slip and go anywhere else.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਹੈ ਲਪਟਿ ਘਟ ਪਰਚਉ ਪਾਵਾ ॥੧੭॥",
      "transliteration": "rahai lapat ghat parachau paavaa ||17||",
      "translation": "You shall remain firmly attached to the Lord, and your heart will be happy. ||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਠਠਾ ਇਹੈ ਦੂਰਿ ਠਗ ਨੀਰਾ ॥",
      "transliteration": "thathaa ihai door thag neeraa ||",
      "translation": "T'HAT'HA: Keep yourself far away from this mirage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨੀਠਿ ਨੀਠਿ ਮਨੁ ਕੀਆ ਧੀਰਾ ॥",
      "transliteration": "neeth neeth man keeaa dheeraa ||",
      "translation": "With great difficulty, I have calmed my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਨਿ ਠਗਿ ਠਗਿਆ ਸਗਲ ਜਗੁ ਖਾਵਾ ॥",
      "transliteration": "jin thag thagiaa sagal jag khaavaa ||",
      "translation": "That cheater, who cheated and devoured the whole world",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੋ ਠਗੁ ਠਗਿਆ ਠਉਰ ਮਨੁ ਆਵਾ ॥੧੮॥",
      "transliteration": "so thag thagiaa thaur man aavaa ||18||",
      "translation": "- I have cheated that cheater, and my mind is now at peace. ||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਡਡਾ ਡਰ ਉਪਜੇ ਡਰੁ ਜਾਈ ॥",
      "transliteration": "dadaa dar upaje dar jaaee ||",
      "translation": "DADDA: When the Fear of God wells up, other fears depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਾ ਡਰ ਮਹਿ ਡਰੁ ਰਹਿਆ ਸਮਾਈ ॥",
      "transliteration": "taa dar mahi dar rahiaa samaaee ||",
      "translation": "Other fears are absorbed into that Fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਉ ਡਰ ਡਰੈ ਤ ਫਿਰਿ ਡਰੁ ਲਾਗੈ ॥",
      "transliteration": "jau dar darai ta phir dar laagai ||",
      "translation": "When one rejects the Fear of God, then other fears cling to him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਿਡਰ ਹੂਆ ਡਰੁ ਉਰ ਹੋਇ ਭਾਗੈ ॥੧੯॥",
      "transliteration": "nidar hooaa dar ur hoi bhaagai ||19||",
      "translation": "But if he becomes fearless, the fears of his heart run away. ||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਢਢਾ ਢਿਗ ਢੂਢਹਿ ਕਤ ਆਨਾ ॥",
      "transliteration": "dhadhaa dhig dhoodhahi kat aanaa ||",
      "translation": "DHADHA: Why do you search in other directions?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਢੂਢਤ ਹੀ ਢਹਿ ਗਏ ਪਰਾਨਾ ॥",
      "transliteration": "dhoodhat hee dhahi gae paraanaa ||",
      "translation": "Searching for Him like this, the breath of life runs out.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚੜਿ ਸੁਮੇਰਿ ਢੂਢਿ ਜਬ ਆਵਾ ॥",
      "transliteration": "chaR sumer dhoodh jab aavaa ||",
      "translation": "When I returned after climbing the mountain,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਹ ਗੜੁ ਗੜਿਓ ਸੁ ਗੜ ਮਹਿ ਪਾਵਾ ॥੨੦॥",
      "transliteration": "jih gaR gaRio s gaR mahi paavaa ||20||",
      "translation": "I found Him in the fortress - the fortress which He Himself made. ||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਣਾਣਾ ਰਣਿ ਰੂਤਉ ਨਰ ਨੇਹੀ ਕਰੈ ॥",
      "transliteration": "naanaa ran rootau nar nehee karai ||",
      "translation": "NANNA: The warrior who fights on the battle-field should keep up and press on.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾ ਨਿਵੈ ਨਾ ਫੁਨਿ ਸੰਚਰੈ ॥",
      "transliteration": "naa nivai naa phun sa(n)charai ||",
      "translation": "He should not yield, and he should not retreat.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਧੰਨਿ ਜਨਮੁ ਤਾਹੀ ਕੋ ਗਣੈ ॥",
      "transliteration": "dha(n)n janam taahee ko ganai ||",
      "translation": "Blessed is the coming of one",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਾਰੈ ਏਕਹਿ ਤਜਿ ਜਾਇ ਘਣੈ ॥੨੧॥",
      "transliteration": "maarai ekahi taj jaai ghanai ||21||",
      "translation": "who conquers the one and renounces the many. ||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਤਾ ਅਤਰ ਤਰਿਓ ਨਹ ਜਾਈ ॥",
      "transliteration": "tataa atar tario nah jaaee ||",
      "translation": "TATTA: The impassable world-ocean cannot be crossed over;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਨ ਤ੍ਰਿਭਵਣ ਮਹਿ ਰਹਿਓ ਸਮਾਈ ॥",
      "transliteration": "tan tribhavan mahi rahio samaaee ||",
      "translation": "the body remains embroiled in the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਉ ਤ੍ਰਿਭਵਣ ਤਨ ਮਾਹਿ ਸਮਾਵਾ ॥",
      "transliteration": "jau tribhavan tan maahi samaavaa ||",
      "translation": "But when the Lord of the three worlds enters into the body,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਉ ਤਤਹਿ ਤਤ ਮਿਲਿਆ ਸਚੁ ਪਾਵਾ ॥੨੨॥",
      "transliteration": "tau tatahi tat miliaa sach paavaa ||22||",
      "translation": "then one's essence merges with the essence of reality, and the True Lord is attained. ||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਥਥਾ ਅਥਾਹ ਥਾਹ ਨਹੀ ਪਾਵਾ ॥",
      "transliteration": "thathaa athaah thaah nahee paavaa ||",
      "translation": "T'HAT'HA: He is Unfathomable; His depths cannot be fathomed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਓਹੁ ਅਥਾਹ ਇਹੁ ਥਿਰੁ ਨ ਰਹਾਵਾ ॥",
      "transliteration": "ohu athaah ihu thir na rahaavaa ||",
      "translation": "He is Unfathomable; this body is impermanent, and unstable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਥੋੜੈ ਥਲਿ ਥਾਨਕ ਆਰੰਭੈ ॥",
      "transliteration": "thoRai thal thaanak aara(n)bhai ||",
      "translation": "The mortal builds his dwelling upon this tiny space;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਿਨੁ ਹੀ ਥਾਭਹ ਮੰਦਿਰੁ ਥੰਭੈ ॥੨੩॥",
      "transliteration": "bin hee thaabhah ma(n)dir tha(n)bhai ||23||",
      "translation": "without any pillars, he wishes to support a mansion. ||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦਦਾ ਦੇਖਿ ਜੁ ਬਿਨਸਨਹਾਰਾ ॥",
      "transliteration": "dadaa dekh j binasanahaaraa ||",
      "translation": "DADDA: Whatever is seen shall perish.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਸ ਅਦੇਖਿ ਤਸ ਰਾਖਿ ਬਿਚਾਰਾ ॥",
      "transliteration": "jas adekh tas raakh bichaaraa ||",
      "translation": "Contemplate the One who is unseen.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦਸਵੈ ਦੁਆਰਿ ਕੁੰਚੀ ਜਬ ਦੀਜੈ ॥",
      "transliteration": "dasavai duaar ku(n)chee jab deejai ||",
      "translation": "When the key is inserted in the Tenth Gate,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਉ ਦਇਆਲ ਕੋ ਦਰਸਨੁ ਕੀਜੈ ॥੨੪॥",
      "transliteration": "tau daiaal ko darasan keejai ||24||",
      "translation": "then the Blessed Vision of the Merciful Lord's Darshan is seen. ||24||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਧਧਾ ਅਰਧਹਿ ਉਰਧ ਨਿਬੇਰਾ ॥",
      "transliteration": "dhadhaa aradhahi uradh niberaa ||",
      "translation": "DHADHA: When one ascends from the lower realms of the earth to the higher realms of the heavens, then everything is resolved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਰਧਹਿ ਉਰਧਹ ਮੰਝਿ ਬਸੇਰਾ ॥",
      "transliteration": "aradhahi uradhah ma(n)jh baseraa ||",
      "translation": "The Lord dwells in both the lower and higher worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਰਧਹ ਛਾਡਿ ਉਰਧ ਜਉ ਆਵਾ ॥",
      "transliteration": "aradhah chhaad uradh jau aavaa ||",
      "translation": "Leaving the earth, the soul ascends to the heavens;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਉ ਅਰਧਹਿ ਉਰਧ ਮਿਲਿਆ ਸੁਖ ਪਾਵਾ ॥੨੫॥",
      "transliteration": "tau aradhahi uradh miliaa sukh paavaa ||25||",
      "translation": "then, the lower and higher join together, and peace is obtained. ||25||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨੰਨਾ ਨਿਸਿ ਦਿਨੁ ਨਿਰਖਤ ਜਾਈ ॥",
      "transliteration": "na(n)naa nis din nirakhat jaaee ||",
      "translation": "NANNA: The days and nights go by; I am looking for the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਿਰਖਤ ਨੈਨ ਰਹੇ ਰਤਵਾਈ ॥",
      "transliteration": "nirakhat nain rahe ratavaaee ||",
      "translation": "Looking for Him, my eyes have become blood-shot.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਿਰਖਤ ਨਿਰਖਤ ਜਬ ਜਾਇ ਪਾਵਾ ॥",
      "transliteration": "nirakhat nirakhat jab jaai paavaa ||",
      "translation": "After looking and looking,when He is finally found,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਬ ਲੇ ਨਿਰਖਹਿ ਨਿਰਖ ਮਿਲਾਵਾ ॥੨੬॥",
      "transliteration": "tab le nirakhahi nirakh milaavaa ||26||",
      "translation": "then the one who was looking merges into the One who was looked for. ||26||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪਪਾ ਅਪਰ ਪਾਰੁ ਨਹੀ ਪਾਵਾ ॥",
      "transliteration": "papaa apar paar nahee paavaa ||",
      "translation": "PAPPA: He is limitless; His limits cannot be found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਰਮ ਜੋਤਿ ਸਿਉ ਪਰਚਉ ਲਾਵਾ ॥",
      "transliteration": "param jot siu parachau laavaa ||",
      "translation": "I have attuned myself to the Supreme Light.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਪਾਂਚਉ ਇੰਦ੍ਰੀ ਨਿਗ੍ਰਹ ਕਰਈ ॥",
      "transliteration": "paa(n)chau i(n)dree nigrah karaee ||",
      "translation": "One who controls his five senses",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪਾਪੁ ਪੁੰਨੁ ਦੋਊ ਨਿਰਵਰਈ ॥੨੭॥",
      "transliteration": "paap pu(n)n dooo niravaraee ||27||",
      "translation": "rises above both sin and virtue. ||27||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਫਫਾ ਬਿਨੁ ਫੂਲਹ ਫਲੁ ਹੋਈ ॥",
      "transliteration": "phaphaa bin phoolah phal hoee ||",
      "translation": "FAFFA: Even without the flower, the fruit is produced.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤਾ ਫਲ ਫੰਕ ਲਖੈ ਜਉ ਕੋਈ ॥",
      "transliteration": "taa phal pha(n)k lakhai jau koee ||",
      "translation": "One who looks at a slice of that fruit",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਦੂਣਿ ਨ ਪਰਈ ਫੰਕ ਬਿਚਾਰੈ ॥",
      "transliteration": "doon na paraee pha(n)k bichaarai ||",
      "translation": "and reflects on it, will not be consigned to reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਾ ਫਲ ਫੰਕ ਸਭੈ ਤਨ ਫਾਰੈ ॥੨੮॥",
      "transliteration": "taa phal pha(n)k sabhai tan phaarai ||28||",
      "translation": "A slice of that fruit slices all bodies. ||28||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਬਬਾ ਬਿੰਦਹਿ ਬਿੰਦ ਮਿਲਾਵਾ ॥",
      "transliteration": "babaa bi(n)dahi bi(n)d milaavaa ||",
      "translation": "BABBA: When one drop blends with another drop,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਬਿੰਦਹਿ ਬਿੰਦਿ ਨ ਬਿਛੁਰਨ ਪਾਵਾ ॥",
      "transliteration": "bi(n)dahi bi(n)d na bichhuran paavaa ||",
      "translation": "then these drops cannot be separated again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0341_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਬੰਦਉ ਹੋਇ ਬੰਦਗੀ ਗਹੈ ॥",
      "transliteration": "ba(n)dau hoi ba(n)dagee gahai ||",
      "translation": "Become the Lord's slave, and hold tight to His meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 341,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
