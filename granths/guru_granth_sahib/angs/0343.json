{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 343,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0343_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਾਵਨ ਅਖਰ ਜੋਰੇ ਆਨਿ ॥",
      "transliteration": "baavan akhar jore aan ||",
      "translation": "The fifty-two letters have been joined together.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਕਿਆ ਨ ਅਖਰੁ ਏਕੁ ਪਛਾਨਿ ॥",
      "transliteration": "sakiaa na akhar ek pachhaan ||",
      "translation": "But people cannot recognize the One Word of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਤ ਕਾ ਸਬਦੁ ਕਬੀਰਾ ਕਹੈ ॥",
      "transliteration": "sat kaa sabad kabeeraa kahai ||",
      "translation": "Kabeer speaks the Shabad, the Word of Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪੰਡਿਤ ਹੋਇ ਸੁ ਅਨਭੈ ਰਹੈ ॥",
      "transliteration": "pa(n)dit hoi s anabhai rahai ||",
      "translation": "One who is a Pandit, a religious scholar, must remain fearless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪੰਡਿਤ ਲੋਗਹ ਕਉ ਬਿਉਹਾਰ ॥",
      "transliteration": "pa(n)dit logah kau biuhaar ||",
      "translation": "It is the business of the scholarly person to join letters.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਿਆਨਵੰਤ ਕਉ ਤਤੁ ਬੀਚਾਰ ॥",
      "transliteration": "giaanava(n)t kau tat beechaar ||",
      "translation": "The spiritual person contemplates the essence of reality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਾ ਕੈ ਜੀਅ ਜੈਸੀ ਬੁਧਿ ਹੋਈ ॥",
      "transliteration": "jaa kai jee jaisee budh hoee ||",
      "translation": "According to the wisdom within the mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਜਾਨੈਗਾ ਸੋਈ ॥੪੫॥",
      "transliteration": "kahi kabeer jaanaigaa soee ||45||",
      "translation": "says Kabeer, so does one come to understand. ||45||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਾਗੁ ਗਉੜੀ ਥਿਤੀੰ ਕਬੀਰ ਜੀ ਕੀੰ ॥",
      "transliteration": "raag gauRee thitee(n) kabeer jee kee(n) ||",
      "translation": "Raag Gauree, T'hitee ~ The Lunar Days Of Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਲੋਕੁ ॥",
      "transliteration": "salok ||",
      "translation": "Salok:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪੰਦ੍ਰਹ ਥਿਤੀੰ ਸਾਤ ਵਾਰ ॥",
      "transliteration": "pa(n)drah thitee(n) saat vaar ||",
      "translation": "There are fifteen lunar days, and seven days of the week.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਉਰਵਾਰ ਨ ਪਾਰ ॥",
      "transliteration": "kahi kabeer uravaar na paar ||",
      "translation": "Says Kabeer, it is neither here nor there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਾਧਿਕ ਸਿਧ ਲਖੈ ਜਉ ਭੇਉ ॥",
      "transliteration": "saadhik sidh lakhai jau bheu ||",
      "translation": "When the Siddhas and seekers come to know the Lord's mystery,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਆਪੇ ਕਰਤਾ ਆਪੇ ਦੇਉ ॥੧॥",
      "transliteration": "aape karataa aape deu ||1||",
      "translation": "they themselves become the Creator; they themselves become the Divine Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਥਿਤੀੰ ॥",
      "transliteration": "thitee(n) ||",
      "translation": "T'hitee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅੰਮਾਵਸ ਮਹਿ ਆਸ ਨਿਵਾਰਹੁ ॥",
      "transliteration": "a(n)maavas mahi aas nivaarahu ||",
      "translation": "On the day of the new moon, give up your hopes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅੰਤਰਜਾਮੀ ਰਾਮੁ ਸਮਾਰਹੁ ॥",
      "transliteration": "a(n)tarajaamee raam samaarahu ||",
      "translation": "Remember the Lord, the Inner-knower, the Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੀਵਤ ਪਾਵਹੁ ਮੋਖ ਦੁਆਰ ॥",
      "transliteration": "jeevat paavahu mokh duaar ||",
      "translation": "You shall attain the Gate of Liberation while yet alive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਨਭਉ ਸਬਦੁ ਤਤੁ ਨਿਜੁ ਸਾਰ ॥੧॥",
      "transliteration": "anabhau sabad tat nij saar ||1||",
      "translation": "You shall come to know the Shabad, the Word of the Fearless Lord, and the essence of your own inner being. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਗੋਬਿੰਦ ਰੰਗੁ ਲਾਗਾ ॥",
      "transliteration": "charan kamal gobi(n)d ra(n)g laagaa ||",
      "translation": "One who enshrines love for the Lotus Feet of the Lord of the Universe",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਭਏ ਮਨ ਨਿਰਮਲ ਹਰਿ ਕੀਰਤਨ ਮਹਿ ਅਨਦਿਨੁ ਜਾਗਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sa(n)t prasaad bhae man niramal har keeratan mahi anadin jaagaa ||1|| rahaau ||",
      "translation": "- by the Grace of the Saints, her mind becomes pure; night and day, she remains awake and aware, singing the Kirtan of the Lord's Praises. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਰਿਵਾ ਪ੍ਰੀਤਮ ਕਰਹੁ ਬੀਚਾਰ ॥",
      "transliteration": "parivaa preetam karahu beechaar ||",
      "translation": "On the first day of the lunar cycle, contemplate the Beloved Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਘਟ ਮਹਿ ਖੇਲੈ ਅਘਟ ਅਪਾਰ ॥",
      "transliteration": "ghat mahi khelai aghat apaar ||",
      "translation": "He is playing within the heart; He has no body - He is Infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਾਲ ਕਲਪਨਾ ਕਦੇ ਨ ਖਾਇ ॥",
      "transliteration": "kaal kalapanaa kade na khaai ||",
      "translation": "The pain of death never consumes that person",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਦਿ ਪੁਰਖ ਮਹਿ ਰਹੈ ਸਮਾਇ ॥੨॥",
      "transliteration": "aad purakh mahi rahai samaai ||2||",
      "translation": "who remains absorbed in the Primal Lord God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੁਤੀਆ ਦੁਹ ਕਰਿ ਜਾਨੈ ਅੰਗ ॥",
      "transliteration": "duteeaa duh kar jaanai a(n)g ||",
      "translation": "On the second day of the lunar cycle, know that there are two beings within the fiber of the body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਾਇਆ ਬ੍ਰਹਮ ਰਮੈ ਸਭ ਸੰਗ ॥",
      "transliteration": "maaiaa braham ramai sabh sa(n)g ||",
      "translation": "Maya and God are blended with everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾ ਓਹੁ ਬਢੈ ਨ ਘਟਤਾ ਜਾਇ ॥",
      "transliteration": "naa ohu badhai na ghatataa jaai ||",
      "translation": "God does not increase or decrease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਕੁਲ ਨਿਰੰਜਨ ਏਕੈ ਭਾਇ ॥੩॥",
      "transliteration": "akul nira(n)jan ekai bhaai ||3||",
      "translation": "He is unknowable and immaculate; He does not change. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤ੍ਰਿਤੀਆ ਤੀਨੇ ਸਮ ਕਰਿ ਲਿਆਵੈ ॥",
      "transliteration": "triteeaa teene sam kar liaavai ||",
      "translation": "On the third day of the lunar cycle, one who maintains his equilibrium amidst the three modes",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਆਨਦ ਮੂਲ ਪਰਮ ਪਦੁ ਪਾਵੈ ॥",
      "transliteration": "aanad mool param pad paavai ||",
      "translation": "finds the source of ecstasy and the highest status.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਉਪਜੈ ਬਿਸ੍ਵਾਸ ॥",
      "transliteration": "saadhasa(n)gat upajai bisvaas ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, faith wells up.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਾਹਰਿ ਭੀਤਰਿ ਸਦਾ ਪ੍ਰਗਾਸ ॥੪॥",
      "transliteration": "baahar bheetar sadaa pragaas ||4||",
      "translation": "Outwardly, and deep within, God's Light is always radiant. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚਉਥਹਿ ਚੰਚਲ ਮਨ ਕਉ ਗਹਹੁ ॥",
      "transliteration": "chauthahi cha(n)chal man kau gahahu ||",
      "translation": "On the fourth day of the lunar cycle, restrain your fickle mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਸੰਗਿ ਕਬਹੁ ਨ ਬਹਹੁ ॥",
      "transliteration": "kaam krodh sa(n)g kabahu na bahahu ||",
      "translation": "and do not ever associate with sexual desire or anger.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਲ ਥਲ ਮਾਹੇ ਆਪਹਿ ਆਪ ॥",
      "transliteration": "jal thal maahe aapahi aap ||",
      "translation": "On land and sea, He Himself is in Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਪੈ ਜਪਹੁ ਆਪਨਾ ਜਾਪ ॥੫॥",
      "transliteration": "aapai japahu aapanaa jaap ||5||",
      "translation": "He Himself meditates and chants His Chant. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਾਂਚੈ ਪੰਚ ਤਤ ਬਿਸਥਾਰ ॥",
      "transliteration": "paa(n)chai pa(n)ch tat bisathaar ||",
      "translation": "On the fifth day of the lunar cycle, the five elements expand outward.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਨਿਕ ਕਾਮਿਨੀ ਜੁਗ ਬਿਉਹਾਰ ॥",
      "transliteration": "kanik kaaminee jug biuhaar ||",
      "translation": "Men are occupied in the pursuit of gold and women.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰੇਮ ਸੁਧਾ ਰਸੁ ਪੀਵੈ ਕੋਇ ॥",
      "transliteration": "prem sudhaa ras peevai koi ||",
      "translation": "How rare are those who drink in the pure essence of the Lord's Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਰਾ ਮਰਣ ਦੁਖੁ ਫੇਰਿ ਨ ਹੋਇ ॥੬॥",
      "transliteration": "jaraa maran dukh pher na hoi ||6||",
      "translation": "They shall never again suffer the pains of old age and death. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਛਠਿ ਖਟੁ ਚਕ੍ਰ ਛਹੂੰ ਦਿਸ ਧਾਇ ॥",
      "transliteration": "chhath khat chakr chhahoo(n) dis dhaai ||",
      "translation": "On the sixth day of the lunar cycle, the six chakras run in six directions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਿਨੁ ਪਰਚੈ ਨਹੀ ਥਿਰਾ ਰਹਾਇ ॥",
      "transliteration": "bin parachai nahee thiraa rahaai ||",
      "translation": "Without enlightenment, the body does not remain steady.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦੁਬਿਧਾ ਮੇਟਿ ਖਿਮਾ ਗਹਿ ਰਹਹੁ ॥",
      "transliteration": "dubidhaa met khimaa gahi rahahu ||",
      "translation": "So erase your duality and hold tight to forgiveness,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਕੀ ਸੂਲ ਨ ਸਹਹੁ ॥੭॥",
      "transliteration": "karam dharam kee sool na sahahu ||7||",
      "translation": "and you will not have to endure the torture of karma or religious rituals. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਾਤੈਂ ਸਤਿ ਕਰਿ ਬਾਚਾ ਜਾਣਿ ॥",
      "transliteration": "saatai(n) sat kar baachaa jaan ||",
      "translation": "On the seventh day of the lunar cycle, know the Word as True,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਆਤਮ ਰਾਮੁ ਲੇਹੁ ਪਰਵਾਣਿ ॥",
      "transliteration": "aatam raam lehu paravaan ||",
      "translation": "and you shall be accepted by the Lord, the Supreme Soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਛੂਟੈ ਸੰਸਾ ਮਿਟਿ ਜਾਹਿ ਦੁਖ ॥",
      "transliteration": "chhootai sa(n)saa mit jaahi dukh ||",
      "translation": "Your doubts shall be eradicated, and your pains eliminated,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੁੰਨ ਸਰੋਵਰਿ ਪਾਵਹੁ ਸੁਖ ॥੮॥",
      "transliteration": "su(n)n sarovar paavahu sukh ||8||",
      "translation": "and in the ocean of the celestial void, you shall find peace. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਸਟਮੀ ਅਸਟ ਧਾਤੁ ਕੀ ਕਾਇਆ ॥",
      "transliteration": "asatamee asat dhaat kee kaaiaa ||",
      "translation": "On the eighth day of the lunar cycle, the body is made of the eight ingredients.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤਾ ਮਹਿ ਅਕੁਲ ਮਹਾ ਨਿਧਿ ਰਾਇਆ ॥",
      "transliteration": "taa mahi akul mahaa nidh raaiaa ||",
      "translation": "Within it is the Unknowable Lord, the King of the supreme treasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰ ਗਮ ਗਿਆਨ ਬਤਾਵੈ ਭੇਦ ॥",
      "transliteration": "gur gam giaan bataavai bhed ||",
      "translation": "The Guru, who knows this spiritual wisdom, reveals the secret of this mystery.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਉਲਟਾ ਰਹੈ ਅਭੰਗ ਅਛੇਦ ॥੯॥",
      "transliteration": "ulataa rahai abha(n)g achhed ||9||",
      "translation": "Turning away from the world, He abides in the Unbreakable and Impenetrable Lord. ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਉਮੀ ਨਵੈ ਦੁਆਰ ਕਉ ਸਾਧਿ ॥",
      "transliteration": "naumee navai duaar kau saadh ||",
      "translation": "On the ninth day of the lunar cycle, discipline the nine gates of the body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਬਹਤੀ ਮਨਸਾ ਰਾਖਹੁ ਬਾਂਧਿ ॥",
      "transliteration": "bahatee manasaa raakhahu baa(n)dh ||",
      "translation": "Keep your pulsating desires restrained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0343_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਲੋਭ ਮੋਹ ਸਭ ਬੀਸਰਿ ਜਾਹੁ ॥",
      "transliteration": "lobh moh sabh beesar jaahu ||",
      "translation": "Forget all your greed and emotional attachment;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 343,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
