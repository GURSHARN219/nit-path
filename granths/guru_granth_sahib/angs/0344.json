{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 344,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0344_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੁਗੁ ਜੁਗੁ ਜੀਵਹੁ ਅਮਰ ਫਲ ਖਾਹੁ ॥੧੦॥",
      "transliteration": "jug jug jeevahu amar phal khaahu ||10||",
      "translation": "you shall live throughout the ages, eating the fruit of immortality. ||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦਸਮੀ ਦਹ ਦਿਸ ਹੋਇ ਅਨੰਦ ॥",
      "transliteration": "dasamee dah dis hoi ana(n)d ||",
      "translation": "On the tenth day of the lunar cycle, there is ecstasy in all directions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਛੂਟੈ ਭਰਮੁ ਮਿਲੈ ਗੋਬਿੰਦ ॥",
      "transliteration": "chhootai bharam milai gobi(n)d ||",
      "translation": "Doubt is dispelled, and the Lord of the Universe is met.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੋਤਿ ਸਰੂਪੀ ਤਤ ਅਨੂਪ ॥",
      "transliteration": "jot saroopee tat anoop ||",
      "translation": "He is the Embodiment of light, the incomparable essence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਮਲ ਨ ਮਲ ਨ ਛਾਹ ਨਹੀ ਧੂਪ ॥੧੧॥",
      "transliteration": "amal na mal na chhaah nahee dhoop ||11||",
      "translation": "He is stainless, without stain, beyond both sunshine and shade. ||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਏਕਾਦਸੀ ਏਕ ਦਿਸ ਧਾਵੈ ॥",
      "transliteration": "ekaadasee ek dis dhaavai ||",
      "translation": "On the eleventh day of the lunar cycle, if you run in the direction of the One,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਉ ਜੋਨੀ ਸੰਕਟ ਬਹੁਰਿ ਨ ਆਵੈ ॥",
      "transliteration": "tau jonee sa(n)kat bahur na aavai ||",
      "translation": "you will not have to suffer the pains of reincarnation again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੀਤਲ ਨਿਰਮਲ ਭਇਆ ਸਰੀਰਾ ॥",
      "transliteration": "seetal niramal bhaiaa sareeraa ||",
      "translation": "Your body will become cool, immaculate and pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੂਰਿ ਬਤਾਵਤ ਪਾਇਆ ਨੀਰਾ ॥੧੨॥",
      "transliteration": "door bataavat paaiaa neeraa ||12||",
      "translation": "The Lord was said to be far away, but He is found near at hand. ||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਾਰਸਿ ਬਾਰਹ ਉਗਵੈ ਸੂਰ ॥",
      "transliteration": "baaras baarah ugavai soor ||",
      "translation": "On the twelfth day of the lunar cycle, twelve suns rise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਬਾਜੇ ਅਨਹਦ ਤੂਰ ॥",
      "transliteration": "ahinis baaje anahad toor ||",
      "translation": "Day and night, the celestial bugles vibrate the unstruck melody.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੇਖਿਆ ਤਿਹੂੰ ਲੋਕ ਕਾ ਪੀਉ ॥",
      "transliteration": "dekhiaa tihoo(n) lok kaa peeu ||",
      "translation": "Then, one beholds the Father of the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਚਰਜੁ ਭਇਆ ਜੀਵ ਤੇ ਸੀਉ ॥੧੩॥",
      "transliteration": "acharaj bhaiaa jeev te seeu ||13||",
      "translation": "This is wonderful! The human being has become God! ||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤੇਰਸਿ ਤੇਰਹ ਅਗਮ ਬਖਾਣਿ ॥",
      "transliteration": "teras terah agam bakhaan ||",
      "translation": "On the thirteenth day of the lunar cycle, the thirteen holy books proclaim",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਰਧ ਉਰਧ ਬਿਚਿ ਸਮ ਪਹਿਚਾਣਿ ॥",
      "transliteration": "aradh uradh bich sam pahichaan ||",
      "translation": "that you must recognize the Lord in the nether regions of the underworld as well as the heavens.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨੀਚ ਊਚ ਨਹੀ ਮਾਨ ਅਮਾਨ ॥",
      "transliteration": "neech ooch nahee maan amaan ||",
      "translation": "There is no high or low, no honor or dishonor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਆਪਿਕ ਰਾਮ ਸਗਲ ਸਾਮਾਨ ॥੧੪॥",
      "transliteration": "biaapik raam sagal saamaan ||14||",
      "translation": "The Lord is pervading and permeating all. ||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਉਦਸਿ ਚਉਦਹ ਲੋਕ ਮਝਾਰਿ ॥",
      "transliteration": "chaudas chaudah lok majhaar ||",
      "translation": "On the fourteenth day of the lunar cycle, in the fourteen worlds",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰੋਮ ਰੋਮ ਮਹਿ ਬਸਹਿ ਮੁਰਾਰਿ ॥",
      "transliteration": "rom rom mahi basahi muraar ||",
      "translation": "and on each and every hair, the Lord abides.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਤ ਸੰਤੋਖ ਕਾ ਧਰਹੁ ਧਿਆਨ ॥",
      "transliteration": "sat sa(n)tokh kaa dharahu dhiaan ||",
      "translation": "Center yourself and meditate on truth and contentment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਥਨੀ ਕਥੀਐ ਬ੍ਰਹਮ ਗਿਆਨ ॥੧੫॥",
      "transliteration": "kathanee katheeai braham giaan ||15||",
      "translation": "Speak the speech of God's spiritual wisdom. ||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪੂਨਿਉ ਪੂਰਾ ਚੰਦ ਅਕਾਸ ॥",
      "transliteration": "pooniu pooraa cha(n)d akaas ||",
      "translation": "On the day of the full moon, the full moon fills the heavens.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਸਰਹਿ ਕਲਾ ਸਹਜ ਪਰਗਾਸ ॥",
      "transliteration": "pasarahi kalaa sahaj paragaas ||",
      "translation": "Its power is diffused through its gentle light.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਦਿ ਅੰਤਿ ਮਧਿ ਹੋਇ ਰਹਿਆ ਥੀਰ ॥",
      "transliteration": "aad a(n)t madh hoi rahiaa theer ||",
      "translation": "In the beginning, in the end, and in the middle, God remains firm and steady.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁਖ ਸਾਗਰ ਮਹਿ ਰਮਹਿ ਕਬੀਰ ॥੧੬॥",
      "transliteration": "sukh saagar mahi ramahi kabeer ||16||",
      "translation": "Kabeer is immersed in the ocean of peace. ||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਾਗੁ ਗਉੜੀ ਵਾਰ ਕਬੀਰ ਜੀਉ ਕੇ ੭ ॥",
      "transliteration": "raag gauRee vaar kabeer jeeu ke 7 ||",
      "translation": "Raag Gauree, The Seven Days Of The Week Of Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਾਰ ਬਾਰ ਹਰਿ ਕੇ ਗੁਨ ਗਾਵਉ ॥",
      "transliteration": "baar baar har ke gun gaavau ||",
      "translation": "Sing the Glorious Praises of the Lord each and every day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰ ਗਮਿ ਭੇਦੁ ਸੁ ਹਰਿ ਕਾ ਪਾਵਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur gam bhed s har kaa paavau ||1|| rahaau ||",
      "translation": "Meeting with the Guru, you shall come to know the mystery of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਦਿਤ ਕਰੈ ਭਗਤਿ ਆਰੰਭ ॥",
      "transliteration": "aadit karai bhagat aara(n)bh ||",
      "translation": "On Sunday, begin the devotional worship of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਾਇਆ ਮੰਦਰ ਮਨਸਾ ਥੰਭ ॥",
      "transliteration": "kaaiaa ma(n)dar manasaa tha(n)bh ||",
      "translation": "and restrain the desires within the temple of the body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਅਖੰਡ ਸੁਰਹੀ ਜਾਇ ॥",
      "transliteration": "ahinis akha(n)d surahee jaai ||",
      "translation": "When your attention is focused day and night upon that imperishable place,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਉ ਅਨਹਦ ਬੇਣੁ ਸਹਜ ਮਹਿ ਬਾਇ ॥੧॥",
      "transliteration": "tau anahad ben sahaj mahi baai ||1||",
      "translation": "then the celestial flutes play the unstruck melody in tranquil peace and poise. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੋਮਵਾਰਿ ਸਸਿ ਅੰਮ੍ਰਿਤੁ ਝਰੈ ॥",
      "transliteration": "somavaar sas a(n)mrit jharai ||",
      "translation": "On Monday, the Ambrosial Nectar trickles down from the moon.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚਾਖਤ ਬੇਗਿ ਸਗਲ ਬਿਖ ਹਰੈ ॥",
      "transliteration": "chaakhat beg sagal bikh harai ||",
      "translation": "Tasting it, all poisons are removed in an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਾਣੀ ਰੋਕਿਆ ਰਹੈ ਦੁਆਰ ॥",
      "transliteration": "baanee rokiaa rahai duaar ||",
      "translation": "Restrained by Gurbani, the mind remains indoors;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਉ ਮਨੁ ਮਤਵਾਰੋ ਪੀਵਨਹਾਰ ॥੨॥",
      "transliteration": "tau man matavaaro peevanahaar ||2||",
      "translation": "drinking in this Nectar, it is intoxicated. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੰਗਲਵਾਰੇ ਲੇ ਮਾਹੀਤਿ ॥",
      "transliteration": "ma(n)galavaare le maaheet ||",
      "translation": "On Tuesday, understand reality;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪੰਚ ਚੋਰ ਕੀ ਜਾਣੈ ਰੀਤਿ ॥",
      "transliteration": "pa(n)ch chor kee jaanai reet ||",
      "translation": "you must know the way the five thieves work.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਘਰ ਛੋਡੇਂ ਬਾਹਰਿ ਜਿਨਿ ਜਾਇ ॥",
      "transliteration": "ghar chhode(n) baahar jin jaai ||",
      "translation": "Those who leave their own home to go out wandering",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਤਰੁ ਖਰਾ ਰਿਸੈ ਹੈ ਰਾਇ ॥੩॥",
      "transliteration": "naatar kharaa risai hai raai ||3||",
      "translation": "shall feel the terrible wrath of the Lord, their King. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬੁਧਵਾਰਿ ਬੁਧਿ ਕਰੈ ਪ੍ਰਗਾਸ ॥",
      "transliteration": "budhavaar budh karai pragaas ||",
      "translation": "On Wednesday, one's understanding is enlightened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਿਰਦੈ ਕਮਲ ਮਹਿ ਹਰਿ ਕਾ ਬਾਸ ॥",
      "transliteration": "hiradai kamal mahi har kaa baas ||",
      "translation": "The Lord comes to dwell in the lotus of the heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰ ਮਿਲਿ ਦੋਊ ਏਕ ਸਮ ਧਰੈ ॥",
      "transliteration": "gur mil dooo ek sam dharai ||",
      "translation": "Meeting the Guru, one comes to look alike upon pleasure and pain,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਉਰਧ ਪੰਕ ਲੈ ਸੂਧਾ ਕਰੈ ॥੪॥",
      "transliteration": "uradh pa(n)k lai soodhaa karai ||4||",
      "translation": "and the inverted lotus is turned upright. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬ੍ਰਿਹਸਪਤਿ ਬਿਖਿਆ ਦੇਇ ਬਹਾਇ ॥",
      "transliteration": "brihasapat bikhiaa dei bahaai ||",
      "translation": "On Thursday, wash off your corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤੀਨਿ ਦੇਵ ਏਕ ਸੰਗਿ ਲਾਇ ॥",
      "transliteration": "teen dev ek sa(n)g laai ||",
      "translation": "Forsake the trinity, and attach yourself to the One God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤੀਨਿ ਨਦੀ ਤਹ ਤ੍ਰਿਕੁਟੀ ਮਾਹਿ ॥",
      "transliteration": "teen nadee tah trikutee maahi ||",
      "translation": "At the confluence of the three rivers of knowledge, right action and devotion, there,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਕਸਮਲ ਧੋਵਹਿ ਨਾਹਿ ॥੫॥",
      "transliteration": "ahinis kasamal dhovahi naahi ||5||",
      "translation": "why not wash away your sinful mistakes? ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੁਕ੍ਰਿਤੁ ਸਹਾਰੈ ਸੁ ਇਹ ਬ੍ਰਤਿ ਚੜੈ ॥",
      "transliteration": "sukrit sahaarai s ih brat chaRai ||",
      "translation": "On Friday, keep up and complete your fast;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਨਦਿਨ ਆਪਿ ਆਪ ਸਿਉ ਲੜੈ ॥",
      "transliteration": "anadin aap aap siu laRai ||",
      "translation": "day and night, you must fight against your own self.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੁਰਖੀ ਪਾਂਚਉ ਰਾਖੈ ਸਬੈ ॥",
      "transliteration": "surakhee paa(n)chau raakhai sabai ||",
      "translation": "If you restrain your five senses,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਉ ਦੂਜੀ ਦ੍ਰਿਸਟਿ ਨ ਪੈਸੈ ਕਬੈ ॥੬॥",
      "transliteration": "tau doojee drisat na paisai kabai ||6||",
      "translation": "then you shall not cast your glance on another. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਥਾਵਰ ਥਿਰੁ ਕਰਿ ਰਾਖੈ ਸੋਇ ॥",
      "transliteration": "thaavar thir kar raakhai soi ||",
      "translation": "On Saturday, keep the candle of God's Light",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜੋਤਿ ਦੀ ਵਟੀ ਘਟ ਮਹਿ ਜੋਇ ॥",
      "transliteration": "jot dee vatee ghat mahi joi ||",
      "translation": "Steady within your heart;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਬਾਹਰਿ ਭੀਤਰਿ ਭਇਆ ਪ੍ਰਗਾਸੁ ॥",
      "transliteration": "baahar bheetar bhaiaa pragaas ||",
      "translation": "you will be enlightened, inwardly and outwardly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0344_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਬ ਹੂਆ ਸਗਲ ਕਰਮ ਕਾ ਨਾਸੁ ॥੭॥",
      "transliteration": "tab hooaa sagal karam kaa naas ||7||",
      "translation": "All your karma will be erased. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 344,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
