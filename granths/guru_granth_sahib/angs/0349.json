{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 349,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0349_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕੀਮਤਿ ਪਾਇ ਨ ਕਹਿਆ ਜਾਇ ॥",
      "transliteration": "keemat paai na kahiaa jaai ||",
      "translation": "No one can measure Your Worth, or describe You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਹਣੈ ਵਾਲੇ ਤੇਰੇ ਰਹੇ ਸਮਾਇ ॥੧॥",
      "transliteration": "kahanai vaale tere rahe samaai ||1||",
      "translation": "Those who describe You, remain absorbed in You. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਵਡੇ ਮੇਰੇ ਸਾਹਿਬਾ ਗਹਿਰ ਗੰਭੀਰਾ ਗੁਣੀ ਗਹੀਰਾ ॥",
      "transliteration": "vade mere saahibaa gahir ga(n)bheeraa gunee gaheeraa ||",
      "translation": "O my Great Lord and Master of Unfathomable Depth, You are the Ocean of Excellence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕੋਈ ਨ ਜਾਣੈ ਤੇਰਾ ਕੇਤਾ ਕੇਵਡੁ ਚੀਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "koee na jaanai teraa ketaa kevad cheeraa ||1|| rahaau ||",
      "translation": "No one knows the greatness of Your expanse. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਭਿ ਸੁਰਤੀ ਮਿਲਿ ਸੁਰਤਿ ਕਮਾਈ ॥",
      "transliteration": "sabh suratee mil surat kamaaee ||",
      "translation": "All the contemplators met together and practiced contemplation;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਭ ਕੀਮਤਿ ਮਿਲਿ ਕੀਮਤਿ ਪਾਈ ॥",
      "transliteration": "sabh keemat mil keemat paaee ||",
      "translation": "all the appraisers met together and tried to appraise You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗਿਆਨੀ ਧਿਆਨੀ ਗੁਰ ਗੁਰ ਹਾਈ ॥",
      "transliteration": "giaanee dhiaanee gur gur haaee ||",
      "translation": "The theologians, the meditators and the teachers of teachers",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਹਣੁ ਨ ਜਾਈ ਤੇਰੀ ਤਿਲੁ ਵਡਿਆਈ ॥੨॥",
      "transliteration": "kahan na jaaee teree til vadiaaee ||2||",
      "translation": "could not express even an iota of Your Greatness. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਭਿ ਸਤ ਸਭਿ ਤਪ ਸਭਿ ਚੰਗਿਆਈਆ ॥",
      "transliteration": "sabh sat sabh tap sabh cha(n)giaaeeaa ||",
      "translation": "All Truth, all austerities, all goodness,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਿਧਾ ਪੁਰਖਾ ਕੀਆ ਵਡਿਆਈਆਂ ॥",
      "transliteration": "sidhaa purakhaa keeaa vadiaaeeaa(n) ||",
      "translation": "and the greatness of the Siddhas, the beings of perfect spiritual powers",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੁਧੁ ਵਿਣੁ ਸਿਧੀ ਕਿਨੈ ਨ ਪਾਈਆ ॥",
      "transliteration": "tudh vin sidhee kinai na paaeeaa ||",
      "translation": "without You, none has attained such spiritual powers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਰਮਿ ਮਿਲੈ ਨਾਹੀ ਠਾਕਿ ਰਹਾਈਆ ॥੩॥",
      "transliteration": "karam milai naahee thaak rahaaeeaa ||3||",
      "translation": "They are obtained by Your Grace; their flow cannot be blocked. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਖਣ ਵਾਲਾ ਕਿਆ ਬੇਚਾਰਾ ॥",
      "transliteration": "aakhan vaalaa kiaa bechaaraa ||",
      "translation": "What can the helpless speaker do?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਿਫਤੀ ਭਰੇ ਤੇਰੇ ਭੰਡਾਰਾ ॥",
      "transliteration": "siphatee bhare tere bha(n)daaraa ||",
      "translation": "Your bounties are overflowing with Your Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਸੁ ਤੂੰ ਦੇਹਿ ਤਿਸੈ ਕਿਆ ਚਾਰਾ ॥",
      "transliteration": "jis too(n) dehi tisai kiaa chaaraa ||",
      "translation": "And the one, unto whom You give - why should he think of any other?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਨਕ ਸਚੁ ਸਵਾਰਣਹਾਰਾ ॥੪॥੧॥",
      "transliteration": "naanak sach savaaranahaaraa ||4||1||",
      "translation": "O Nanak, the True Lord is the Embellisher. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਖਾ ਜੀਵਾ ਵਿਸਰੈ ਮਰਿ ਜਾਉ ॥",
      "transliteration": "aakhaa jeevaa visarai mar jaau ||",
      "translation": "Chanting the Name, I live; forgetting it, I die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਖਣਿ ਅਉਖਾ ਸਾਚਾ ਨਾਉ ॥",
      "transliteration": "aakhan aukhaa saachaa naau ||",
      "translation": "It is so difficult to chant the True Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਚੇ ਨਾਮ ਕੀ ਲਾਗੈ ਭੂਖ ॥",
      "transliteration": "saache naam kee laagai bhookh ||",
      "translation": "If someone feels hunger for the True Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਿਤੁ ਭੂਖੈ ਖਾਇ ਚਲੀਅਹਿ ਦੂਖ ॥੧॥",
      "transliteration": "tit bhookhai khaai chaleeahi dookh ||1||",
      "translation": "then that hunger shall consume his pains. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੋ ਕਿਉ ਵਿਸਰੈ ਮੇਰੀ ਮਾਇ ॥",
      "transliteration": "so kiu visarai meree maai ||",
      "translation": "So how could I ever forget Him, O my Mother?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਾਚਾ ਸਾਹਿਬੁ ਸਾਚੈ ਨਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saachaa saahib saachai naai ||1|| rahaau ||",
      "translation": "True is the Master, and True is His Name. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਾਚੇ ਨਾਮ ਕੀ ਤਿਲੁ ਵਡਿਆਈ ॥",
      "transliteration": "saache naam kee til vadiaaee ||",
      "translation": "People have grown weary of trying to appraise the greatness of the True Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਖਿ ਥਕੇ ਕੀਮਤਿ ਨਹੀ ਪਾਈ ॥",
      "transliteration": "aakh thake keemat nahee paaee ||",
      "translation": "But they have not been able to appraise even an iota of it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੇ ਸਭਿ ਮਿਲਿ ਕੈ ਆਖਣ ਪਾਹਿ ॥",
      "transliteration": "je sabh mil kai aakhan paahi ||",
      "translation": "Even if they were all to meet together and recount them,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਵਡਾ ਨ ਹੋਵੈ ਘਾਟਿ ਨ ਜਾਇ ॥੨॥",
      "transliteration": "vadaa na hovai ghaat na jaai ||2||",
      "translation": "You would not be made any greater or lesser. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾ ਓਹੁ ਮਰੈ ਨ ਹੋਵੈ ਸੋਗੁ ॥",
      "transliteration": "naa ohu marai na hovai sog ||",
      "translation": "He does not die - there is no reason to mourn.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੇਂਦਾ ਰਹੈ ਨ ਚੂਕੈ ਭੋਗੁ ॥",
      "transliteration": "de(n)daa rahai na chookai bhog ||",
      "translation": "He continues to give, but His Provisions are never exhausted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗੁਣੁ ਏਹੋ ਹੋਰੁ ਨਾਹੀ ਕੋਇ ॥",
      "transliteration": "gun eho hor naahee koi ||",
      "translation": "This Glorious Virtue is His alone - no one else is like Him;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾ ਕੋ ਹੋਆ ਨਾ ਕੋ ਹੋਇ ॥੩॥",
      "transliteration": "naa ko hoaa naa ko hoi ||3||",
      "translation": "there has never been anyone like Him, and there never shall be. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੇਵਡੁ ਆਪਿ ਤੇਵਡ ਤੇਰੀ ਦਾਤਿ ॥",
      "transliteration": "jevad aap tevad teree daat ||",
      "translation": "As Great as You Yourself are, so Great are Your Gifts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਨਿ ਦਿਨੁ ਕਰਿ ਕੈ ਕੀਤੀ ਰਾਤਿ ॥",
      "transliteration": "jin din kar kai keetee raat ||",
      "translation": "It is You who created day and night as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਖਸਮੁ ਵਿਸਾਰਹਿ ਤੇ ਕਮਜਾਤਿ ॥",
      "transliteration": "khasam visaarahi te kamajaat ||",
      "translation": "Those who forget their Lord and Master are vile and despicable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕ ਨਾਵੈ ਬਾਝੁ ਸਨਾਤਿ ॥੪॥੨॥",
      "transliteration": "naanak naavai baajh sanaat ||4||2||",
      "translation": "O Nanak, without the Name, people are wretched outcasts. ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੇ ਦਰਿ ਮਾਂਗਤੁ ਕੂਕ ਕਰੇ ਮਹਲੀ ਖਸਮੁ ਸੁਣੇ ॥",
      "transliteration": "je dar maa(n)gat kook kare mahalee khasam sune ||",
      "translation": "If a beggar cries out at the door, the Master hears it in His Mansion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭਾਵੈ ਧੀਰਕ ਭਾਵੈ ਧਕੇ ਏਕ ਵਡਾਈ ਦੇਇ ॥੧॥",
      "transliteration": "bhaavai dheerak bhaavai dhake ek vadaaee dei ||1||",
      "translation": "Whether He receives him or pushes him away, it is the Gift of the Lord's Greatness. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾਣਹੁ ਜੋਤਿ ਨ ਪੂਛਹੁ ਜਾਤੀ ਆਗੈ ਜਾਤਿ ਨ ਹੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaanahu jot na poochhahu jaatee aagai jaat na he ||1|| rahaau ||",
      "translation": "Recognize the Lord's Light within all, and do not consider social class or status; there are no classes or castes in the world hereafter. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਪਿ ਕਰਾਏ ਆਪਿ ਕਰੇਇ ॥",
      "transliteration": "aap karaae aap karei ||",
      "translation": "He Himself acts, and He Himself inspires us to act.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਪਿ ਉਲਾਮੑੇ ਚਿਤਿ ਧਰੇਇ ॥",
      "transliteration": "aap ulaamhe chit dharei ||",
      "translation": "He Himself considers our complaints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਾ ਤੂੰ ਕਰਣਹਾਰੁ ਕਰਤਾਰੁ ॥",
      "transliteration": "jaa too(n) karanahaar karataar ||",
      "translation": "Since You, O Creator Lord, are the Doer,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿਆ ਮੁਹਤਾਜੀ ਕਿਆ ਸੰਸਾਰੁ ॥੨॥",
      "transliteration": "kiaa muhataajee kiaa sa(n)saar ||2||",
      "translation": "why should I submit to the world? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਆਪਿ ਉਪਾਏ ਆਪੇ ਦੇਇ ॥",
      "transliteration": "aap upaae aape dei ||",
      "translation": "You Yourself created and You Yourself give.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਪੇ ਦੁਰਮਤਿ ਮਨਹਿ ਕਰੇਇ ॥",
      "transliteration": "aape duramat manahi karei ||",
      "translation": "You Yourself eliminate evil-mindedness;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਵਸੈ ਮਨਿ ਆਇ ॥",
      "transliteration": "gur parasaad vasai man aai ||",
      "translation": "by Guru's Grace, You come to abide in our minds,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੁਖੁ ਅਨੑੇਰਾ ਵਿਚਹੁ ਜਾਇ ॥੩॥",
      "transliteration": "dukh anheraa vichahu jaai ||3||",
      "translation": "and then, pain and darkness are dispelled from within. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਾਚੁ ਪਿਆਰਾ ਆਪਿ ਕਰੇਇ ॥",
      "transliteration": "saach piaaraa aap karei ||",
      "translation": "He Himself infuses love for the Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਵਰੀ ਕਉ ਸਾਚੁ ਨ ਦੇਇ ॥",
      "transliteration": "avaree kau saach na dei ||",
      "translation": "Unto others, the Truth is not bestowed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜੇ ਕਿਸੈ ਦੇਇ ਵਖਾਣੈ ਨਾਨਕੁ ਆਗੈ ਪੂਛ ਨ ਲੇਇ ॥੪॥੩॥",
      "transliteration": "je kisai dei vakhaanai naanak aagai poochh na lei ||4||3||",
      "translation": "If He bestows it upon someone, says Nanak, then, in the world hereafter, that person is not called to account. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤਾਲ ਮਦੀਰੇ ਘਟ ਕੇ ਘਾਟ ॥",
      "transliteration": "taal madeere ghat ke ghaat ||",
      "translation": "The urges of the heart are like cymbals and ankle-bells;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਦੋਲਕ ਦੁਨੀਆ ਵਾਜਹਿ ਵਾਜ ॥",
      "transliteration": "dolak duneeaa vaajahi vaaj ||",
      "translation": "the drum of the world resounds with the beat.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨਾਰਦੁ ਨਾਚੈ ਕਲਿ ਕਾ ਭਾਉ ॥",
      "transliteration": "naarad naachai kal kaa bhaau ||",
      "translation": "Naarad dances to the tune of the Dark Age of Kali Yuga;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਤੀ ਸਤੀ ਕਹ ਰਾਖਹਿ ਪਾਉ ॥੧॥",
      "transliteration": "jatee satee kah raakhahi paau ||1||",
      "translation": "where can the celibates and the men of truth place their feet? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਨਕ ਨਾਮ ਵਿਟਹੁ ਕੁਰਬਾਣੁ ॥",
      "transliteration": "naanak naam vitahu kurabaan ||",
      "translation": "Nanak is a sacrifice to the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਅੰਧੀ ਦੁਨੀਆ ਸਾਹਿਬੁ ਜਾਣੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "a(n)dhee duneeaa saahib jaan ||1|| rahaau ||",
      "translation": "The world is blind; our Lord and Master is All-seeing. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਗੁਰੂ ਪਾਸਹੁ ਫਿਰਿ ਚੇਲਾ ਖਾਇ ॥",
      "transliteration": "guroo paasahu phir chelaa khaai ||",
      "translation": "The disciple feeds on the Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0349_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਤਾਮਿ ਪਰੀਤਿ ਵਸੈ ਘਰਿ ਆਇ ॥",
      "transliteration": "taam pareet vasai ghar aai ||",
      "translation": "out of love for bread, he comes to dwell in his home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 349,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
