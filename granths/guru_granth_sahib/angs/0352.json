{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 352,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0352_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵਿ ਪਾਏ ਨਿਜ ਥਾਉ ॥੧॥",
      "transliteration": "satigur sev paae nij thaau ||1||",
      "translation": "Serving the True Guru, one finds one's own place within the self. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਨ ਚੂਰੇ ਖਟੁ ਦਰਸਨ ਜਾਣੁ ॥",
      "transliteration": "man choore khat darasan jaan ||",
      "translation": "To conquer the mind is the knowledge of the six Shaastras.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਰਬ ਜੋਤਿ ਪੂਰਨ ਭਗਵਾਨੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sarab jot pooran bhagavaan ||1|| rahaau ||",
      "translation": "The Divine Light of the Lord God is perfectly pervading. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਧਿਕ ਤਿਆਸ ਭੇਖ ਬਹੁ ਕਰੈ ॥",
      "transliteration": "adhik tiaas bhekh bahu karai ||",
      "translation": "Excessive thirst for Maya makes people wear all sorts of religious robes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੁਖੁ ਬਿਖਿਆ ਸੁਖੁ ਤਨਿ ਪਰਹਰੈ ॥",
      "transliteration": "dukh bikhiaa sukh tan paraharai ||",
      "translation": "The pain of corruption destroys the body's peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਅੰਤਰਿ ਧਨੁ ਹਿਰੈ ॥",
      "transliteration": "kaam krodh a(n)tar dhan hirai ||",
      "translation": "Sexual desire and anger steal the wealth of the self within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੁਬਿਧਾ ਛੋਡਿ ਨਾਮਿ ਨਿਸਤਰੈ ॥੨॥",
      "transliteration": "dubidhaa chhod naam nisatarai ||2||",
      "translation": "But by abandoning duality, one is emancipated through the Naam, the Name of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਿਫਤਿ ਸਲਾਹਣੁ ਸਹਜ ਅਨੰਦ ॥",
      "transliteration": "siphat salaahan sahaj ana(n)d ||",
      "translation": "In the Lord's Praise and adoration is intuitive peace, poise and bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਖਾ ਸੈਨੁ ਪ੍ਰੇਮੁ ਗੋਬਿੰਦ ॥",
      "transliteration": "sakhaa sain prem gobi(n)d ||",
      "translation": "The Love of the Lord God is one's family and friends.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਪੇ ਕਰੇ ਆਪੇ ਬਖਸਿੰਦੁ ॥",
      "transliteration": "aape kare aape bakhasi(n)d ||",
      "translation": "He Himself is the Doer, and He Himself is the Forgiver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਹਰਿ ਪਹਿ ਆਗੈ ਜਿੰਦੁ ॥੩॥",
      "transliteration": "tan man har pahi aagai ji(n)d ||3||",
      "translation": "My body and mind belong to the Lord; my life is at His Command. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਝੂਠ ਵਿਕਾਰ ਮਹਾ ਦੁਖੁ ਦੇਹ ॥",
      "transliteration": "jhooth vikaar mahaa dukh deh ||",
      "translation": "Falsehood and corruption cause terrible suffering.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭੇਖ ਵਰਨ ਦੀਸਹਿ ਸਭਿ ਖੇਹ ॥",
      "transliteration": "bhekh varan deesahi sabh kheh ||",
      "translation": "All the religious robes and social classes look just like dust.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜੋ ਉਪਜੈ ਸੋ ਆਵੈ ਜਾਇ ॥",
      "transliteration": "jo upajai so aavai jaai ||",
      "translation": "Whoever is born, continues to come and go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਅਸਥਿਰੁ ਨਾਮੁ ਰਜਾਇ ॥੪॥੧੧॥",
      "transliteration": "naanak asathir naam rajaai ||4||11||",
      "translation": "O Nanak, only the Naam and the Lord's Command are eternal and everlasting. ||4||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਏਕੋ ਸਰਵਰੁ ਕਮਲ ਅਨੂਪ ॥",
      "transliteration": "eko saravar kamal anoop ||",
      "translation": "In the pool is the one incomparably beautiful lotus.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਦਾ ਬਿਗਾਸੈ ਪਰਮਲ ਰੂਪ ॥",
      "transliteration": "sadaa bigaasai paramal roop ||",
      "translation": "It blossoms continually; its form is pure and fragrant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਊਜਲ ਮੋਤੀ ਚੂਗਹਿ ਹੰਸ ॥",
      "transliteration": "oojal motee choogahi ha(n)s ||",
      "translation": "The swans pick up the bright jewels.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਰਬ ਕਲਾ ਜਗਦੀਸੈ ਅੰਸ ॥੧॥",
      "transliteration": "sarab kalaa jagadeesai a(n)s ||1||",
      "translation": "They take on the essence of the All-powerful Lord of the Universe. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੋ ਦੀਸੈ ਸੋ ਉਪਜੈ ਬਿਨਸੈ ॥",
      "transliteration": "jo deesai so upajai binasai ||",
      "translation": "Whoever is seen, is subject to birth and death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਿਨੁ ਜਲ ਸਰਵਰਿ ਕਮਲੁ ਨ ਦੀਸੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin jal saravar kamal na deesai ||1|| rahaau ||",
      "translation": "In the pool without water, the lotus is not seen. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਿਰਲਾ ਬੂਝੈ ਪਾਵੈ ਭੇਦੁ ॥",
      "transliteration": "biralaa boojhai paavai bhed ||",
      "translation": "How rare are those who know and understand this secret.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਾਖਾ ਤੀਨਿ ਕਹੈ ਨਿਤ ਬੇਦੁ ॥",
      "transliteration": "saakhaa teen kahai nit bed ||",
      "translation": "The Vedas continually speak of the three branches.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਦ ਬਿੰਦ ਕੀ ਸੁਰਤਿ ਸਮਾਇ ॥",
      "transliteration": "naad bi(n)d kee surat samaai ||",
      "translation": "One who merges into the knowledge of the Lord as absolute and related,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵਿ ਪਰਮ ਪਦੁ ਪਾਇ ॥੨॥",
      "transliteration": "satigur sev param pad paai ||2||",
      "translation": "serves the True Guru and obtains the supreme status. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮੁਕਤੋ ਰਾਤਉ ਰੰਗਿ ਰਵਾਂਤਉ ॥",
      "transliteration": "mukato raatau ra(n)g ravaa(n)tau ||",
      "translation": "One who is imbued with the Love of the Lord and dwells continually upon Him is liberated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਾਜਨ ਰਾਜਿ ਸਦਾ ਬਿਗਸਾਂਤਉ ॥",
      "transliteration": "raajan raaj sadaa bigasaa(n)tau ||",
      "translation": "He is the king of kings, and blossoms forth continually.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਸੁ ਤੂੰ ਰਾਖਹਿ ਕਿਰਪਾ ਧਾਰਿ ॥",
      "transliteration": "jis too(n) raakhahi kirapaa dhaar ||",
      "translation": "That one whom You preserve, by bestowing Your Mercy, O Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬੂਡਤ ਪਾਹਨ ਤਾਰਹਿ ਤਾਰਿ ॥੩॥",
      "transliteration": "boodat paahan taarahi taar ||3||",
      "translation": "even the sinking stone - You float that one across. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤ੍ਰਿਭਵਣ ਮਹਿ ਜੋਤਿ ਤ੍ਰਿਭਵਣ ਮਹਿ ਜਾਣਿਆ ॥",
      "transliteration": "tribhavan mahi jot tribhavan mahi jaaniaa ||",
      "translation": "Your Light is pervading the three worlds; I know that You are permeating the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਉਲਟ ਭਈ ਘਰੁ ਘਰ ਮਹਿ ਆਣਿਆ ॥",
      "transliteration": "ulat bhaee ghar ghar mahi aaniaa ||",
      "translation": "When my mind turned away from Maya, I came to dwell in my own home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਭਗਤਿ ਕਰੇ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "ahinis bhagat kare liv laai ||",
      "translation": "Nanak falls at the feet of that person who immerses himself in the Lord's Love,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਨਕੁ ਤਿਨ ਕੈ ਲਾਗੈ ਪਾਇ ॥੪॥੧੨॥",
      "transliteration": "naanak tin kai laagai paai ||4||12||",
      "translation": "And performs devotional worship night and day. ||4||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰਮਤਿ ਸਾਚੀ ਹੁਜਤਿ ਦੂਰਿ ॥",
      "transliteration": "guramat saachee hujat door ||",
      "translation": "Receiving the True Teachings from the Guru, arguments depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਹੁਤੁ ਸਿਆਣਪ ਲਾਗੈ ਧੂਰਿ ॥",
      "transliteration": "bahut siaanap laagai dhoor ||",
      "translation": "But through excessive cleverness, one is only plastered with dirt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਲਾਗੀ ਮੈਲੁ ਮਿਟੈ ਸਚ ਨਾਇ ॥",
      "transliteration": "laagee mail mitai sach naai ||",
      "translation": "The filth of attachment is removed by the True Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਰਹੈ ਲਿਵ ਲਾਇ ॥੧॥",
      "transliteration": "gur parasaad rahai liv laai ||1||",
      "translation": "By Guru's Grace, one remains lovingly attached to the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹੈ ਹਜੂਰਿ ਹਾਜਰੁ ਅਰਦਾਸਿ ॥",
      "transliteration": "hai hajoor haajar aradaas ||",
      "translation": "He is the Presence Ever-present; offer your prayers to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੁਖੁ ਸੁਖੁ ਸਾਚੁ ਕਰਤੇ ਪ੍ਰਭ ਪਾਸਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dukh sukh saach karate prabh paas ||1|| rahaau ||",
      "translation": "Pain and pleasure are in the Hands of God, the True Creator. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕੂੜੁ ਕਮਾਵੈ ਆਵੈ ਜਾਵੈ ॥",
      "transliteration": "kooR kamaavai aavai jaavai ||",
      "translation": "One who practices falsehood comes and goes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹਣਿ ਕਥਨਿ ਵਾਰਾ ਨਹੀ ਆਵੈ ॥",
      "transliteration": "kahan kathan vaaraa nahee aavai ||",
      "translation": "By speaking and talking, His limits cannot be found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਿਆ ਦੇਖਾ ਸੂਝ ਬੂਝ ਨ ਪਾਵੈ ॥",
      "transliteration": "kiaa dekhaa soojh boojh na paavai ||",
      "translation": "Whatever one sees, is not understood.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਮਨਿ ਤ੍ਰਿਪਤਿ ਨ ਆਵੈ ॥੨॥",
      "transliteration": "bin naavai man tripat na aavai ||2||",
      "translation": "Without the Name, satisfaction does not enter into the mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੋ ਜਨਮੇ ਸੇ ਰੋਗਿ ਵਿਆਪੇ ॥",
      "transliteration": "jo janame se rog viaape ||",
      "translation": "Whoever is born is afflicted by disease,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਉਮੈ ਮਾਇਆ ਦੂਖਿ ਸੰਤਾਪੇ ॥",
      "transliteration": "haumai maaiaa dookh sa(n)taape ||",
      "translation": "tortured by the pain of egotism and Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੇ ਜਨ ਬਾਚੇ ਜੋ ਪ੍ਰਭਿ ਰਾਖੇ ॥",
      "transliteration": "se jan baache jo prabh raakhe ||",
      "translation": "They alone are saved, who are protected by God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵਿ ਅੰਮ੍ਰਿਤ ਰਸੁ ਚਾਖੇ ॥੩॥",
      "transliteration": "satigur sev a(n)mrit ras chaakhe ||3||",
      "translation": "Serving the True Guru, they drink in the Amrit, the Ambrosial Nectar. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਚਲਤਉ ਮਨੁ ਰਾਖੈ ਅੰਮ੍ਰਿਤੁ ਚਾਖੈ ॥",
      "transliteration": "chalatau man raakhai a(n)mrit chaakhai ||",
      "translation": "The unstable mind is restrained by tasting this Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਤਿਗੁਰ ਸੇਵਿ ਅੰਮ੍ਰਿਤ ਸਬਦੁ ਭਾਖੈ ॥",
      "transliteration": "satigur sev a(n)mrit sabad bhaakhai ||",
      "translation": "Serving the True Guru, one comes to cherish the Ambrosial Nectar of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਾਚੈ ਸਬਦਿ ਮੁਕਤਿ ਗਤਿ ਪਾਏ ॥",
      "transliteration": "saachai sabad mukat gat paae ||",
      "translation": "Through the True Word of the Shabad, the state of liberation is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾਨਕ ਵਿਚਹੁ ਆਪੁ ਗਵਾਏ ॥੪॥੧੩॥",
      "transliteration": "naanak vichahu aap gavaae ||4||13||",
      "translation": "O Nanak, self-conceit is eradicated from within. ||4||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜੋ ਤਿਨਿ ਕੀਆ ਸੋ ਸਚੁ ਥੀਆ ॥",
      "transliteration": "jo tin keeaa so sach theeaa ||",
      "translation": "Whatever He has done, has proved to be true.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਸਤਿਗੁਰਿ ਦੀਆ ॥",
      "transliteration": "a(n)mrit naam satigur deeaa ||",
      "translation": "The True Guru bestows the Ambrosial Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਹਿਰਦੈ ਨਾਮੁ ਨਾਹੀ ਮਨਿ ਭੰਗੁ ॥",
      "transliteration": "hiradai naam naahee man bha(n)g ||",
      "translation": "With the Naam in the heart, the mind is not separated from the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਅਨਦਿਨੁ ਨਾਲਿ ਪਿਆਰੇ ਸੰਗੁ ॥੧॥",
      "transliteration": "anadin naal piaare sa(n)g ||1||",
      "translation": "Night and day, one dwells with the Beloved. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0352_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਹਰਿ ਜੀਉ ਰਾਖਹੁ ਅਪਨੀ ਸਰਣਾਈ ॥",
      "transliteration": "har jeeu raakhahu apanee saranaaee ||",
      "translation": "O Lord, please keep me in the Protection of Your Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 352,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
