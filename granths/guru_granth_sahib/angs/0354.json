{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 354,
  "lineCount": 53,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0354_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਐਸਾ ਗੁਰਮਤਿ ਰਮਤੁ ਸਰੀਰਾ ॥",
      "transliteration": "aisaa guramat ramat sareeraa ||",
      "translation": "Through the Guru's Teachings, realize that He is pervading in all bodies;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਰਿ ਭਜੁ ਮੇਰੇ ਮਨ ਗਹਿਰ ਗੰਭੀਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har bhaj mere man gahir ga(n)bheeraa ||1|| rahaau ||",
      "translation": "O my soul, vibrate on the Profound, Unfathomable Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਨਤ ਤਰੰਗ ਭਗਤਿ ਹਰਿ ਰੰਗਾ ॥",
      "transliteration": "anat tara(n)g bhagat har ra(n)gaa ||",
      "translation": "Loving devotion to the Lord brings endless waves of joy and delight.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਨਦਿਨੁ ਸੂਚੇ ਹਰਿ ਗੁਣ ਸੰਗਾ ॥",
      "transliteration": "anadin sooche har gun sa(n)gaa ||",
      "translation": "One who dwells with the Glorious Praises of the Lord, night and day, is sanctified.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਿਥਿਆ ਜਨਮੁ ਸਾਕਤ ਸੰਸਾਰਾ ॥",
      "transliteration": "mithiaa janam saakat sa(n)saaraa ||",
      "translation": "The birth into the world of the faithless cynic is totally useless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਮ ਭਗਤਿ ਜਨੁ ਰਹੈ ਨਿਰਾਰਾ ॥੨॥",
      "transliteration": "raam bhagat jan rahai niraaraa ||2||",
      "translation": "The humble devotee of the Lord remains unattached. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੂਚੀ ਕਾਇਆ ਹਰਿ ਗੁਣ ਗਾਇਆ ॥",
      "transliteration": "soochee kaaiaa har gun gaaiaa ||",
      "translation": "The body which sings the Glorious Praises of the Lord is sanctified.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਤਮੁ ਚੀਨਿ ਰਹੈ ਲਿਵ ਲਾਇਆ ॥",
      "transliteration": "aatam cheen rahai liv laaiaa ||",
      "translation": "The soul remains conscious of the Lord, absorbed in His Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਦਿ ਅਪਾਰੁ ਅਪਰੰਪਰੁ ਹੀਰਾ ॥",
      "transliteration": "aad apaar apara(n)par heeraa ||",
      "translation": "The Lord is the Infinite Primal Being, beyond the beyond, the priceless jewel.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਲਾਲਿ ਰਤਾ ਮੇਰਾ ਮਨੁ ਧੀਰਾ ॥੩॥",
      "transliteration": "laal rataa meraa man dheeraa ||3||",
      "translation": "My mind is totally content, imbued with my Beloved. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਥਨੀ ਕਹਹਿ ਕਹਹਿ ਸੇ ਮੂਏ ॥",
      "transliteration": "kathanee kahahi kahahi se mooe ||",
      "translation": "Those who speak and babble on and on, are truly dead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੋ ਪ੍ਰਭੁ ਦੂਰਿ ਨਾਹੀ ਪ੍ਰਭੁ ਤੂੰ ਹੈ ॥",
      "transliteration": "so prabh door naahee prabh too(n) hai ||",
      "translation": "God is not far away - O God, You are right here.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਭੁ ਜਗੁ ਦੇਖਿਆ ਮਾਇਆ ਛਾਇਆ ॥",
      "transliteration": "sabh jag dekhiaa maaiaa chhaaiaa ||",
      "translation": "I have seen that the whole world is engrossed in Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮਤਿ ਨਾਮੁ ਧਿਆਇਆ ॥੪॥੧੭॥",
      "transliteration": "naanak guramat naam dhiaaiaa ||4||17||",
      "translation": "O Nanak, through the Guru's Teachings, I meditate on the Naam, the Name of the Lord. ||4||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ਤਿਤੁਕਾ ॥",
      "transliteration": "aasaa mahalaa 1 titukaa ||",
      "translation": "Aasaa, First Mehl, Thi-Thukay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕੋਈ ਭੀਖਕੁ ਭੀਖਿਆ ਖਾਇ ॥",
      "transliteration": "koee bheekhak bheekhiaa khaai ||",
      "translation": "One is a beggar, living on charity;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕੋਈ ਰਾਜਾ ਰਹਿਆ ਸਮਾਇ ॥",
      "transliteration": "koee raajaa rahiaa samaai ||",
      "translation": "another is a king, absorbed in himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿਸ ਹੀ ਮਾਨੁ ਕਿਸੈ ਅਪਮਾਨੁ ॥",
      "transliteration": "kis hee maan kisai apamaan ||",
      "translation": "One receives honor, and another dishonor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਢਾਹਿ ਉਸਾਰੇ ਧਰੇ ਧਿਆਨੁ ॥",
      "transliteration": "dhaahi usaare dhare dhiaan ||",
      "translation": "The Lord destroys and creates; He is enshrined in His meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤੁਝ ਤੇ ਵਡਾ ਨਾਹੀ ਕੋਇ ॥",
      "transliteration": "tujh te vadaa naahee koi ||",
      "translation": "There is no other as great as You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿਸੁ ਵੇਖਾਲੀ ਚੰਗਾ ਹੋਇ ॥੧॥",
      "transliteration": "kis vekhaalee cha(n)gaa hoi ||1||",
      "translation": "So whom should I present to You? Who is good enough? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੈ ਤਾਂ ਨਾਮੁ ਤੇਰਾ ਆਧਾਰੁ ॥",
      "transliteration": "mai taa(n) naam teraa aadhaar ||",
      "translation": "The Naam, the Name of the Lord, is my only Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤੂੰ ਦਾਤਾ ਕਰਣਹਾਰੁ ਕਰਤਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "too(n) daataa karanahaar karataar ||1|| rahaau ||",
      "translation": "You are the Great Giver, the Doer, the Creator. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਵਾਟ ਨ ਪਾਵਉ ਵੀਗਾ ਜਾਉ ॥",
      "transliteration": "vaat na paavau veegaa jaau ||",
      "translation": "I have not walked on Your Path; I have followed the crooked path.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦਰਗਹ ਬੈਸਣ ਨਾਹੀ ਥਾਉ ॥",
      "transliteration": "daragah baisan naahee thaau ||",
      "translation": "In the Court of the Lord, I find no place to sit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨ ਕਾ ਅੰਧੁਲਾ ਮਾਇਆ ਕਾ ਬੰਧੁ ॥",
      "transliteration": "man kaa a(n)dhulaa maaiaa kaa ba(n)dh ||",
      "translation": "I am mentally blind, in the bondage of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਖੀਨ ਖਰਾਬੁ ਹੋਵੈ ਨਿਤ ਕੰਧੁ ॥",
      "transliteration": "kheen kharaab hovai nit ka(n)dh ||",
      "translation": "The wall of my body is breaking down, wearing away, growing weaker.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਖਾਣ ਜੀਵਣ ਕੀ ਬਹੁਤੀ ਆਸ ॥",
      "transliteration": "khaan jeevan kee bahutee aas ||",
      "translation": "You have such high hopes of eating and living",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਲੇਖੈ ਤੇਰੈ ਸਾਸ ਗਿਰਾਸ ॥੨॥",
      "transliteration": "lekhai terai saas giraas ||2||",
      "translation": "- your breaths and morsels of food are already counted! ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਅੰਧੁਲੇ ਦੀਪਕੁ ਦੇਇ ॥",
      "transliteration": "ahinis a(n)dhule deepak dei ||",
      "translation": "Night and day they are blind - please, bless them with Your Light.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਉਜਲ ਡੂਬਤ ਚਿੰਤ ਕਰੇਇ ॥",
      "transliteration": "bhaujal doobat chi(n)t karei ||",
      "translation": "They are drowning in the terrifying world-ocean, crying out in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਹਹਿ ਸੁਣਹਿ ਜੋ ਮਾਨਹਿ ਨਾਉ ॥",
      "transliteration": "kahahi sunahi jo maanahi naau ||",
      "translation": "I am a sacrifice to those who chant,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਉ ਬਲਿਹਾਰੈ ਤਾ ਕੈ ਜਾਉ ॥",
      "transliteration": "hau balihaarai taa kai jaau ||",
      "translation": "Hear and believe in the Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਨਕੁ ਏਕ ਕਹੈ ਅਰਦਾਸਿ ॥",
      "transliteration": "naanak ek kahai aradaas ||",
      "translation": "Nanak utters this one prayer;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਸਭੁ ਤੇਰੈ ਪਾਸਿ ॥੩॥",
      "transliteration": "jeeu pi(n)d sabh terai paas ||3||",
      "translation": "soul and body, all belong to You, Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਾਂ ਤੂੰ ਦੇਹਿ ਜਪੀ ਤੇਰਾ ਨਾਉ ॥",
      "transliteration": "jaa(n) too(n) dehi japee teraa naau ||",
      "translation": "When You bless me, I chant Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦਰਗਹ ਬੈਸਣ ਹੋਵੈ ਥਾਉ ॥",
      "transliteration": "daragah baisan hovai thaau ||",
      "translation": "Thus I find my seat in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾਂ ਤੁਧੁ ਭਾਵੈ ਤਾ ਦੁਰਮਤਿ ਜਾਇ ॥",
      "transliteration": "jaa(n) tudh bhaavai taa duramat jaai ||",
      "translation": "When it pleases You, evil-mindedness departs,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗਿਆਨ ਰਤਨੁ ਮਨਿ ਵਸੈ ਆਇ ॥",
      "transliteration": "giaan ratan man vasai aai ||",
      "translation": "and the jewel of spiritual wisdom comes to dwell in the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਤਾ ਸਤਿਗੁਰੁ ਮਿਲੈ ॥",
      "transliteration": "nadar kare taa satigur milai ||",
      "translation": "When the Lord bestows His Glance of Grace, then one comes to meet the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰਣਵਤਿ ਨਾਨਕੁ ਭਵਜਲੁ ਤਰੈ ॥੪॥੧੮॥",
      "transliteration": "pranavat naanak bhavajal tarai ||4||18||",
      "translation": "Prays Nanak, carry us across the terrifying world-ocean. ||4||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ਪੰਚਪਦੇ₆ ॥",
      "transliteration": "aasaa mahalaa 1 pa(n)chapade₆ ||",
      "translation": "Aasaa, First Mehl, Panch-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੁਧ ਬਿਨੁ ਧੇਨੁ ਪੰਖ ਬਿਨੁ ਪੰਖੀ ਜਲ ਬਿਨੁ ਉਤਭੁਜ ਕਾਮਿ ਨਾਹੀ ॥",
      "transliteration": "dudh bin dhen pa(n)kh bin pa(n)khee jal bin utabhuj kaam naahee ||",
      "translation": "A cow without milk; a bird without wings; a garden without water - totally useless!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਿਆ ਸੁਲਤਾਨੁ ਸਲਾਮ ਵਿਹੂਣਾ ਅੰਧੀ ਕੋਠੀ ਤੇਰਾ ਨਾਮੁ ਨਾਹੀ ॥੧॥",
      "transliteration": "kiaa sulataan salaam vihoonaa a(n)dhee kothee teraa naam naahee ||1||",
      "translation": "What is an emperor, without respect? The chamber of the soul is so dark, without the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕੀ ਵਿਸਰਹਿ ਦੁਖੁ ਬਹੁਤਾ ਲਾਗੈ ॥",
      "transliteration": "kee visarahi dukh bahutaa laagai ||",
      "translation": "How could I ever forget You? It would be so painful!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੁਖੁ ਲਾਗੈ ਤੂੰ ਵਿਸਰੁ ਨਾਹੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dukh laagai too(n) visar naahee ||1|| rahaau ||",
      "translation": "I would suffer such pain - no, I shall not forget You! ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਖੀ ਅੰਧੁ ਜੀਭ ਰਸੁ ਨਾਹੀ ਕੰਨੀ ਪਵਣੁ ਨ ਵਾਜੈ ॥",
      "transliteration": "akhee a(n)dh jeebh ras naahee ka(n)nee pavan na vaajai ||",
      "translation": "The eyes grow blind, the tongue does not taste, and the ears do not hear any sound.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚਰਣੀ ਚਲੈ ਪਜੂਤਾ ਆਗੈ ਵਿਣੁ ਸੇਵਾ ਫਲ ਲਾਗੇ ॥੨॥",
      "transliteration": "charanee chalai pajootaa aagai vin sevaa phal laage ||2||",
      "translation": "He walks on his feet only when supported by someone else; without serving the Lord, such are the fruits of life. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਖਰ ਬਿਰਖ ਬਾਗ ਭੁਇ ਚੋਖੀ ਸਿੰਚਿਤ ਭਾਉ ਕਰੇਹੀ ॥",
      "transliteration": "akhar birakh baag bhui chokhee si(n)chit bhaau karehee ||",
      "translation": "The Word is the tree; the garden of the heart is the farm; tend it, and irrigate it with the Lord's Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਭਨਾ ਫਲੁ ਲਾਗੈ ਨਾਮੁ ਏਕੋ ਬਿਨੁ ਕਰਮਾ ਕੈਸੇ ਲੇਹੀ ॥੩॥",
      "transliteration": "sabhanaa phal laagai naam eko bin karamaa kaise lehee ||3||",
      "translation": "All these trees bear the fruit of the Name of the One Lord; but without the karma of good actions, how can anyone obtain it? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜੇਤੇ ਜੀਅ ਤੇਤੇ ਸਭਿ ਤੇਰੇ ਵਿਣੁ ਸੇਵਾ ਫਲੁ ਕਿਸੈ ਨਾਹੀ ॥",
      "transliteration": "jete jee tete sabh tere vin sevaa phal kisai naahee ||",
      "translation": "As many living beings are there are, they are all Yours. Without selfless service, no one obtains any reward.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਦੁਖੁ ਸੁਖੁ ਭਾਣਾ ਤੇਰਾ ਹੋਵੈ ਵਿਣੁ ਨਾਵੈ ਜੀਉ ਰਹੈ ਨਾਹੀ ॥੪॥",
      "transliteration": "dukh sukh bhaanaa teraa hovai vin naavai jeeu rahai naahee ||4||",
      "translation": "Pain and pleasure come by Your Will; without the Name, the soul does not even exist. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0354_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਤਿ ਵਿਚਿ ਮਰਣੁ ਜੀਵਣੁ ਹੋਰੁ ਕੈਸਾ ਜਾ ਜੀਵਾ ਤਾਂ ਜੁਗਤਿ ਨਾਹੀ ॥",
      "transliteration": "mat vich maran jeevan hor kaisaa jaa jeevaa taa(n) jugat naahee ||",
      "translation": "To die in the Teachings is to live. Otherwise, what is life? That is not the way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 354,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
