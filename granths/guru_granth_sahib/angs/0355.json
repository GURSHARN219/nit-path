{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 355,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0355_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਹੈ ਨਾਨਕੁ ਜੀਵਾਲੇ ਜੀਆ ਜਹ ਭਾਵੈ ਤਹ ਰਾਖੁ ਤੁਹੀ ॥੫॥੧੯॥",
      "transliteration": "kahai naanak jeevaale jeeaa jah bhaavai tah raakh tuhee ||5||19||",
      "translation": "Says Nanak, He grants life to the living beings; O Lord, please keep me according to Your Will. ||5||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਾਇਆ ਬ੍ਰਹਮਾ ਮਨੁ ਹੈ ਧੋਤੀ ॥",
      "transliteration": "kaaiaa brahamaa man hai dhotee ||",
      "translation": "Let the body be the Brahmin, and let the mind be the loin-cloth;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗਿਆਨੁ ਜਨੇਊ ਧਿਆਨੁ ਕੁਸਪਾਤੀ ॥",
      "transliteration": "giaan janeoo dhiaan kusapaatee ||",
      "translation": "let spiritual wisdom be the sacred thread, and meditation the ceremonial ring.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਰਿ ਨਾਮਾ ਜਸੁ ਜਾਚਉ ਨਾਉ ॥",
      "transliteration": "har naamaa jas jaachau naau ||",
      "translation": "I seek the Name of the Lord and His Praise as my cleansing bath.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਬ੍ਰਹਮਿ ਸਮਾਉ ॥੧॥",
      "transliteration": "gur parasaadee braham samaau ||1||",
      "translation": "By Guru's Grace, I am absorbed into God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਾਂਡੇ ਐਸਾ ਬ੍ਰਹਮ ਬੀਚਾਰੁ ॥",
      "transliteration": "paa(n)de aisaa braham beechaar ||",
      "translation": "O Pandit, O religious scholar, contemplate God in such a way",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਮੇ ਸੁਚਿ ਨਾਮੋ ਪੜਉ ਨਾਮੇ ਚਜੁ ਆਚਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naame such naamo paRau naame chaj aachaar ||1|| rahaau ||",
      "translation": "that His Name may sanctify you, that His Name may be your study, and His Name your wisdom and way of life. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਾਹਰਿ ਜਨੇਊ ਜਿਚਰੁ ਜੋਤਿ ਹੈ ਨਾਲਿ ॥",
      "transliteration": "baahar janeoo jichar jot hai naal ||",
      "translation": "The outer sacred thread is worthwhile only as long as the Divine Light is within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਧੋਤੀ ਟਿਕਾ ਨਾਮੁ ਸਮਾਲਿ ॥",
      "transliteration": "dhotee tikaa naam samaal ||",
      "translation": "So make the remembrance of the Naam, the Name of the Lord, your loin-cloth and the ceremonial mark on your forehead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਐਥੈ ਓਥੈ ਨਿਬਹੀ ਨਾਲਿ ॥",
      "transliteration": "aithai othai nibahee naal ||",
      "translation": "Here and hereafter, the Name alone shall stand by you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਵਿਣੁ ਨਾਵੈ ਹੋਰਿ ਕਰਮ ਨ ਭਾਲਿ ॥੨॥",
      "transliteration": "vin naavai hor karam na bhaal ||2||",
      "translation": "Do not seek any other actions, except the Name. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪੂਜਾ ਪ੍ਰੇਮ ਮਾਇਆ ਪਰਜਾਲਿ ॥",
      "transliteration": "poojaa prem maaiaa parajaal ||",
      "translation": "Worship the Lord in loving adoration, and burn your desire for Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਕੋ ਵੇਖਹੁ ਅਵਰੁ ਨ ਭਾਲਿ ॥",
      "transliteration": "eko vekhahu avar na bhaal ||",
      "translation": "Behold only the One Lord, and do not seek out any other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੀਨੑੈ ਤਤੁ ਗਗਨ ਦਸ ਦੁਆਰ ॥",
      "transliteration": "cheenhai tat gagan das duaar ||",
      "translation": "Become aware of reality, in the Sky of the Tenth Gate;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਰਿ ਮੁਖਿ ਪਾਠ ਪੜੈ ਬੀਚਾਰ ॥੩॥",
      "transliteration": "har mukh paath paRai beechaar ||3||",
      "translation": "read aloud the Lord's Word, and contemplate it. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭੋਜਨੁ ਭਾਉ ਭਰਮੁ ਭਉ ਭਾਗੈ ॥",
      "transliteration": "bhojan bhaau bharam bhau bhaagai ||",
      "translation": "With the diet of His Love, doubt and fear depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਾਹਰੂਅਰਾ ਛਬਿ ਚੋਰੁ ਨ ਲਾਗੈ ॥",
      "transliteration": "paaharooaraa chhab chor na laagai ||",
      "translation": "With the Lord as your night watchman, no thief will dare to break in.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਿਲਕੁ ਲਿਲਾਟਿ ਜਾਣੈ ਪ੍ਰਭੁ ਏਕੁ ॥",
      "transliteration": "tilak lilaat jaanai prabh ek ||",
      "translation": "Let the knowledge of the One God be the ceremonial mark on your forehead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬੂਝੈ ਬ੍ਰਹਮੁ ਅੰਤਰਿ ਬਿਬੇਕੁ ॥੪॥",
      "transliteration": "boojhai braham a(n)tar bibek ||4||",
      "translation": "Let the realization that God is within you be your discrimination. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਚਾਰੀ ਨਹੀ ਜੀਤਿਆ ਜਾਇ ॥",
      "transliteration": "aachaaree nahee jeetiaa jaai ||",
      "translation": "Through ritual actions, God cannot be won over;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਾਠ ਪੜੈ ਨਹੀ ਕੀਮਤਿ ਪਾਇ ॥",
      "transliteration": "paath paRai nahee keemat paai ||",
      "translation": "by reciting sacred scriptures, His value cannot be estimated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਸਟ ਦਸੀ ਚਹੁ ਭੇਦੁ ਨ ਪਾਇਆ ॥",
      "transliteration": "asat dasee chahu bhed na paaiaa ||",
      "translation": "The eighteen Puraanas and the four Vedas do not know His mystery.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਨਕ ਸਤਿਗੁਰਿ ਬ੍ਰਹਮੁ ਦਿਖਾਇਆ ॥੫॥੨੦॥",
      "transliteration": "naanak satigur braham dikhaaiaa ||5||20||",
      "translation": "O Nanak, the True Guru has shown me the Lord God. ||5||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੇਵਕੁ ਦਾਸੁ ਭਗਤੁ ਜਨੁ ਸੋਈ ॥",
      "transliteration": "sevak daas bhagat jan soee ||",
      "translation": "He alone is the selfless servant, slave and humble devotee,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਠਾਕੁਰ ਕਾ ਦਾਸੁ ਗੁਰਮੁਖਿ ਹੋਈ ॥",
      "transliteration": "thaakur kaa daas guramukh hoee ||",
      "translation": "who as Gurmukh, becomes the slave of his Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਿਨਿ ਸਿਰਿ ਸਾਜੀ ਤਿਨਿ ਫੁਨਿ ਗੋਈ ॥",
      "transliteration": "jin sir saajee tin phun goee ||",
      "translation": "He, who created the Universe, shall ultimately destroy it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਸੁ ਬਿਨੁ ਦੂਜਾ ਅਵਰੁ ਨ ਕੋਈ ॥੧॥",
      "transliteration": "tis bin doojaa avar na koee ||1||",
      "translation": "Without Him, there is no other at all. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਚੁ ਨਾਮੁ ਗੁਰ ਸਬਦਿ ਵੀਚਾਰਿ ॥",
      "transliteration": "saach naam gur sabad veechaar ||",
      "translation": "Through the Word of the Guru's Shabad, the Gurmukh reflects upon the True Name;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਚੇ ਸਾਚੈ ਦਰਬਾਰਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "guramukh saache saachai darabaar ||1|| rahaau ||",
      "translation": "In the True Court, he is found to be true. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਚਾ ਅਰਜੁ ਸਚੀ ਅਰਦਾਸਿ ॥",
      "transliteration": "sachaa araj sachee aradaas ||",
      "translation": "The true supplication, the true prayer",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਹਲੀ ਖਸਮੁ ਸੁਣੇ ਸਾਬਾਸਿ ॥",
      "transliteration": "mahalee khasam sune saabaas ||",
      "translation": "- within the Mansion of His Sublime Presence, the True Lord Master hears and applauds these.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਚੈ ਤਖਤਿ ਬੁਲਾਵੈ ਸੋਇ ॥",
      "transliteration": "sachai takhat bulaavai soi ||",
      "translation": "He summons the truthful to His Heavenly Throne",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੇ ਵਡਿਆਈ ਕਰੇ ਸੁ ਹੋਇ ॥੨॥",
      "transliteration": "de vadiaaee kare s hoi ||2||",
      "translation": "and bestows glorious greatness upon them; that which He wills, comes to pass. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤੇਰਾ ਤਾਣੁ ਤੂਹੈ ਦੀਬਾਣੁ ॥",
      "transliteration": "teraa taan toohai deebaan ||",
      "translation": "The Power is Yours; You are my only Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਸਚੁ ਨੀਸਾਣੁ ॥",
      "transliteration": "gur kaa sabad sach neesaan ||",
      "translation": "The Word of the Guru's Shabad is my true password.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੰਨੇ ਹੁਕਮੁ ਸੁ ਪਰਗਟੁ ਜਾਇ ॥",
      "transliteration": "ma(n)ne hukam s paragat jaai ||",
      "translation": "One who obeys the Hukam of the Lord's Command, goes to Him openly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਚੁ ਨੀਸਾਣੈ ਠਾਕ ਨ ਪਾਇ ॥੩॥",
      "transliteration": "sach neesaanai thaak na paai ||3||",
      "translation": "With the password of truth, his way is not blocked. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪੰਡਿਤ ਪੜਹਿ ਵਖਾਣਹਿ ਵੇਦੁ ॥",
      "transliteration": "pa(n)dit paRahi vakhaanahi ved ||",
      "translation": "The Pandit reads and expounds on the Vedas,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅੰਤਰਿ ਵਸਤੁ ਨ ਜਾਣਹਿ ਭੇਦੁ ॥",
      "transliteration": "a(n)tar vasat na jaanahi bhed ||",
      "translation": "but he does not know the secret of the thing within himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰ ਬਿਨੁ ਸੋਝੀ ਬੂਝ ਨ ਹੋਇ ॥",
      "transliteration": "gur bin sojhee boojh na hoi ||",
      "translation": "Without the Guru, understanding and realization are not obtained;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਾਚਾ ਰਵਿ ਰਹਿਆ ਪ੍ਰਭੁ ਸੋਇ ॥੪॥",
      "transliteration": "saachaa rav rahiaa prabh soi ||4||",
      "translation": "but still God is True, pervading everywhere. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਿਆ ਹਉ ਆਖਾ ਆਖਿ ਵਖਾਣੀ ॥",
      "transliteration": "kiaa hau aakhaa aakh vakhaanee ||",
      "translation": "What should I say, or speak or describe?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤੂੰ ਆਪੇ ਜਾਣਹਿ ਸਰਬ ਵਿਡਾਣੀ ॥",
      "transliteration": "too(n) aape jaanahi sarab vidaanee ||",
      "translation": "Only You Yourself know, O Lord of total wonder.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕ ਏਕੋ ਦਰੁ ਦੀਬਾਣੁ ॥",
      "transliteration": "naanak eko dar deebaan ||",
      "translation": "Nanak takes the Support of the Door of the One God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਚੁ ਤਹਾ ਗੁਦਰਾਣੁ ॥੫॥੨੧॥",
      "transliteration": "guramukh saach tahaa gudaraan ||5||21||",
      "translation": "There, at the True Door, the Gurmukhs sustain themselves. ||5||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਾਚੀ ਗਾਗਰਿ ਦੇਹ ਦੁਹੇਲੀ ਉਪਜੈ ਬਿਨਸੈ ਦੁਖੁ ਪਾਈ ॥",
      "transliteration": "kaachee gaagar deh duhelee upajai binasai dukh paaee ||",
      "translation": "The clay pitcher of the body is miserable; it suffers in pain through birth and death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਇਹੁ ਜਗੁ ਸਾਗਰੁ ਦੁਤਰੁ ਕਿਉ ਤਰੀਐ ਬਿਨੁ ਹਰਿ ਗੁਰ ਪਾਰਿ ਨ ਪਾਈ ॥੧॥",
      "transliteration": "ihu jag saagar dutar kiu tareeai bin har gur paar na paaee ||1||",
      "translation": "How can this terrifying world-ocean be crossed over? Without the Lord - Guru, it cannot be crossed. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤੁਝ ਬਿਨੁ ਅਵਰੁ ਨ ਕੋਈ ਮੇਰੇ ਪਿਆਰੇ ਤੁਝ ਬਿਨੁ ਅਵਰੁ ਨ ਕੋਇ ਹਰੇ ॥",
      "transliteration": "tujh bin avar na koee mere piaare tujh bin avar na koi hare ||",
      "translation": "Without You, there is no other at all, O my Beloved; without you, there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਰਬੀ ਰੰਗੀ ਰੂਪੀ ਤੂੰਹੈ ਤਿਸੁ ਬਖਸੇ ਜਿਸੁ ਨਦਰਿ ਕਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sarabee ra(n)gee roopee too(n)hai tis bakhase jis nadar kare ||1|| rahaau ||",
      "translation": "You are in all colors and forms; he alone is forgiven, upon whom You bestow Your Glance of Grace. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਾਸੁ ਬੁਰੀ ਘਰਿ ਵਾਸੁ ਨ ਦੇਵੈ ਪਿਰ ਸਿਉ ਮਿਲਣ ਨ ਦੇਇ ਬੁਰੀ ॥",
      "transliteration": "saas buree ghar vaas na devai pir siu milan na dei buree ||",
      "translation": "Maya, my mother-in-law, is evil; she does not let me live in my own home. The vicious one does not let me meet with my Husband Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0355_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਖੀ ਸਾਜਨੀ ਕੇ ਹਉ ਚਰਨ ਸਰੇਵਉ ਹਰਿ ਗੁਰ ਕਿਰਪਾ ਤੇ ਨਦਰਿ ਧਰੀ ॥੨॥",
      "transliteration": "sakhee saajanee ke hau charan sarevau har gur kirapaa te nadar dharee ||2||",
      "translation": "I serve at the feet of my companions and friends; the Lord has showered me with His Mercy, through Guru's Grace. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 355,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
