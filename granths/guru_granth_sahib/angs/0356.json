{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 356,
  "lineCount": 50,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0356_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਪੁ ਬੀਚਾਰਿ ਮਾਰਿ ਮਨੁ ਦੇਖਿਆ ਤੁਮ ਸਾ ਮੀਤੁ ਨ ਅਵਰੁ ਕੋਈ ॥",
      "transliteration": "aap beechaar maar man dekhiaa tum saa meet na avar koee ||",
      "translation": "Reflecting upon my self, and conquering my mind, I have seen that there is no other friend like You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਉ ਤੂੰ ਰਾਖਹਿ ਤਿਵ ਹੀ ਰਹਣਾ ਦੁਖੁ ਸੁਖੁ ਦੇਵਹਿ ਕਰਹਿ ਸੋਈ ॥੩॥",
      "transliteration": "jiu too(n) raakhahi tiv hee rahanaa dukh sukh devahi karahi soee ||3||",
      "translation": "As You keep me, so do I live. You are the Giver of peace and pleasure. Whatever You do, comes to pass. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਸਾ ਮਨਸਾ ਦੋਊ ਬਿਨਾਸਤ ਤ੍ਰਿਹੁ ਗੁਣ ਆਸ ਨਿਰਾਸ ਭਈ ॥",
      "transliteration": "aasaa manasaa dooo binaasat trihu gun aas niraas bhaee ||",
      "translation": "Hope and desire have both been dispelled; I have renounced my longing for the three qualities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤੁਰੀਆਵਸਥਾ ਗੁਰਮੁਖਿ ਪਾਈਐ ਸੰਤ ਸਭਾ ਕੀ ਓਟ ਲਹੀ ॥੪॥",
      "transliteration": "tureeaavasathaa guramukh paaeeai sa(n)t sabhaa kee ot lahee ||4||",
      "translation": "The Gurmukh obtains the state of ecstasy, taking to the Shelter of the Saints' Congregation. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਿਆਨ ਧਿਆਨ ਸਗਲੇ ਸਭਿ ਜਪ ਤਪ ਜਿਸੁ ਹਰਿ ਹਿਰਦੈ ਅਲਖ ਅਭੇਵਾ ॥",
      "transliteration": "giaan dhiaan sagale sabh jap tap jis har hiradai alakh abhevaa ||",
      "translation": "All wisdom and meditation, all chanting and penance, come to one whose heart is filled with the Invisible, Inscrutable Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਨਕ ਰਾਮ ਨਾਮਿ ਮਨੁ ਰਾਤਾ ਗੁਰਮਤਿ ਪਾਏ ਸਹਜ ਸੇਵਾ ॥੫॥੨੨॥",
      "transliteration": "naanak raam naam man raataa guramat paae sahaj sevaa ||5||22||",
      "translation": "O Nanak, one whose mind is imbued with the Lord's Name, finds the Guru's Teachings, and intuitively serves. ||5||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ਪੰਚਪਦੇ₂ ॥",
      "transliteration": "aasaa mahalaa 1 pa(n)chapade₂ ||",
      "translation": "Aasaa, First Mehl, Panch-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮੋਹੁ ਕੁਟੰਬੁ ਮੋਹੁ ਸਭ ਕਾਰ ॥",
      "transliteration": "mohu kuta(n)b mohu sabh kaar ||",
      "translation": "Your attachment to your family, your attachment to all your affairs",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮੋਹੁ ਤੁਮ ਤਜਹੁ ਸਗਲ ਵੇਕਾਰ ॥੧॥",
      "transliteration": "mohu tum tajahu sagal vekaar ||1||",
      "translation": "- renounce all your attachments, for they are all corrupt. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮੋਹੁ ਅਰੁ ਭਰਮੁ ਤਜਹੁ ਤੁਮੑ ਬੀਰ ॥",
      "transliteration": "mohu ar bharam tajahu tumh beer ||",
      "translation": "Renounce your attachments and doubts, O brother,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਾਚੁ ਨਾਮੁ ਰਿਦੇ ਰਵੈ ਸਰੀਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saach naam ride ravai sareer ||1|| rahaau ||",
      "translation": "and dwell upon the True Name within your heart and body. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਚੁ ਨਾਮੁ ਜਾ ਨਵ ਨਿਧਿ ਪਾਈ ॥",
      "transliteration": "sach naam jaa nav nidh paaee ||",
      "translation": "When one receives the nine treasures of the True Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰੋਵੈ ਪੂਤੁ ਨ ਕਲਪੈ ਮਾਈ ॥੨॥",
      "transliteration": "rovai poot na kalapai maaee ||2||",
      "translation": "his children do not weep, and his mother does not grieve. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਤੁ ਮੋਹਿ ਡੂਬਾ ਸੰਸਾਰੁ ॥",
      "transliteration": "et mohi doobaa sa(n)saar ||",
      "translation": "In this attachment, the world is drowning.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਕੋਈ ਉਤਰੈ ਪਾਰਿ ॥੩॥",
      "transliteration": "guramukh koee utarai paar ||3||",
      "translation": "Few are the Gurmukhs who swim across. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਏਤੁ ਮੋਹਿ ਫਿਰਿ ਜੂਨੀ ਪਾਹਿ ॥",
      "transliteration": "et mohi phir joonee paahi ||",
      "translation": "In this attachment, people are reincarnated over and over again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੋਹੇ ਲਾਗਾ ਜਮ ਪੁਰਿ ਜਾਹਿ ॥੪॥",
      "transliteration": "mohe laagaa jam pur jaahi ||4||",
      "translation": "Attached to emotional attachment, they go to the city of Death. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰ ਦੀਖਿਆ ਲੇ ਜਪੁ ਤਪੁ ਕਮਾਹਿ ॥",
      "transliteration": "gur deekhiaa le jap tap kamaahi ||",
      "translation": "You have received the Guru's Teachings - now practice meditation and penance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾ ਮੋਹੁ ਤੂਟੈ ਨਾ ਥਾਇ ਪਾਹਿ ॥੫॥",
      "transliteration": "naa mohu tootai naa thaai paahi ||5||",
      "translation": "If attachment is not broken, no one is approved. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਤਾ ਏਹੁ ਮੋਹੁ ਜਾਇ ॥",
      "transliteration": "nadar kare taa ehu mohu jaai ||",
      "translation": "But if He bestows His Glance of Grace, then this attachment departs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਸਿਉ ਰਹੈ ਸਮਾਇ ॥੬॥੨੩॥",
      "transliteration": "naanak har siu rahai samaai ||6||23||",
      "translation": "O Nanak, then one remains merged in the Lord. ||6||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਪਿ ਕਰੇ ਸਚੁ ਅਲਖ ਅਪਾਰੁ ॥",
      "transliteration": "aap kare sach alakh apaar ||",
      "translation": "He Himself does everything, the True, Invisible, Infinite Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਉ ਪਾਪੀ ਤੂੰ ਬਖਸਣਹਾਰੁ ॥੧॥",
      "transliteration": "hau paapee too(n) bakhasanahaar ||1||",
      "translation": "I am a sinner, You are the Forgiver. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤੇਰਾ ਭਾਣਾ ਸਭੁ ਕਿਛੁ ਹੋਵੈ ॥",
      "transliteration": "teraa bhaanaa sabh kichh hovai ||",
      "translation": "By Your Will, everything come to pass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨਹਠਿ ਕੀਚੈ ਅੰਤਿ ਵਿਗੋਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "manahath keechai a(n)t vigovai ||1|| rahaau ||",
      "translation": "One who acts in stubborn-mindedness is ruined in the end. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਨਮੁਖ ਕੀ ਮਤਿ ਕੂੜਿ ਵਿਆਪੀ ॥",
      "transliteration": "manamukh kee mat kooR viaapee ||",
      "translation": "The intellect of the self-willed manmukh is engrossed in falsehood.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਸਿਮਰਣ ਪਾਪਿ ਸੰਤਾਪੀ ॥੨॥",
      "transliteration": "bin har simaran paap sa(n)taapee ||2||",
      "translation": "Without the meditative remembrance of the Lord, it suffers in sin. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੁਰਮਤਿ ਤਿਆਗਿ ਲਾਹਾ ਕਿਛੁ ਲੇਵਹੁ ॥",
      "transliteration": "duramat tiaag laahaa kichh levahu ||",
      "translation": "Renounce evil-mindedness, and you shall reap the rewards.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੋ ਉਪਜੈ ਸੋ ਅਲਖ ਅਭੇਵਹੁ ॥੩॥",
      "transliteration": "jo upajai so alakh abhevahu ||3||",
      "translation": "Whoever is born, comes through the Unknowable and Mysterious Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਐਸਾ ਹਮਰਾ ਸਖਾ ਸਹਾਈ ॥",
      "transliteration": "aisaa hamaraa sakhaa sahaaee ||",
      "translation": "Such is my Friend and Companion;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰ ਹਰਿ ਮਿਲਿਆ ਭਗਤਿ ਦ੍ਰਿੜਾਈ ॥੪॥",
      "transliteration": "gur har miliaa bhagat driRaaee ||4||",
      "translation": "meeting with the Guru, the Lord, devotion was implanted within me. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਗਲਂੀ ਸਉਦਂੀ ਤੋਟਾ ਆਵੈ ॥",
      "transliteration": "sagala(n)ee sauda(n)ee totaa aavai ||",
      "translation": "In all other transactions, one suffers loss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਨਕ ਰਾਮ ਨਾਮੁ ਮਨਿ ਭਾਵੈ ॥੫॥੨੪॥",
      "transliteration": "naanak raam naam man bhaavai ||5||24||",
      "translation": "The Name of the Lord is pleasing to Nanak's mind. ||5||24||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ਚਉਪਦੇ₄ ॥",
      "transliteration": "aasaa mahalaa 1 chaupade₄ ||",
      "translation": "Aasaa, First Mehl, Chau-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਵਿਦਿਆ ਵੀਚਾਰੀ ਤਾਂ ਪਰਉਪਕਾਰੀ ॥",
      "transliteration": "vidiaa veechaaree taa(n) paraupakaaree ||",
      "translation": "Contemplate and reflect upon knowledge, and you will become a benefactor to others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਾਂ ਪੰਚ ਰਾਸੀ ਤਾਂ ਤੀਰਥ ਵਾਸੀ ॥੧॥",
      "transliteration": "jaa(n) pa(n)ch raasee taa(n) teerath vaasee ||1||",
      "translation": "When you conquer the five passions, then you shall come to dwell at the sacred shrine of pilgrimage. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਘੁੰਘਰੂ ਵਾਜੈ ਜੇ ਮਨੁ ਲਾਗੈ ॥",
      "transliteration": "ghu(n)gharoo vaajai je man laagai ||",
      "translation": "You shall hear the vibrations of the tinkling bells, when your mind is held steady.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਉ ਜਮੁ ਕਹਾ ਕਰੇ ਮੋ ਸਿਉ ਆਗੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tau jam kahaa kare mo siu aagai ||1|| rahaau ||",
      "translation": "So what can the Messenger of Death do to me hereafter? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਸ ਨਿਰਾਸੀ ਤਉ ਸੰਨਿਆਸੀ ॥",
      "transliteration": "aas niraasee tau sa(n)niaasee ||",
      "translation": "When you abandon hope and desire, then you become a true Sannyaasi.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਾਂ ਜਤੁ ਜੋਗੀ ਤਾਂ ਕਾਇਆ ਭੋਗੀ ॥੨॥",
      "transliteration": "jaa(n) jat jogee taa(n) kaaiaa bhogee ||2||",
      "translation": "When the Yogi practices abstinence, then he enjoys his body. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦਇਆ ਦਿਗੰਬਰੁ ਦੇਹ ਬੀਚਾਰੀ ॥",
      "transliteration": "daiaa diga(n)bar deh beechaaree ||",
      "translation": "Through compassion, the naked hermit reflects upon his inner self.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਪਿ ਮਰੈ ਅਵਰਾ ਨਹ ਮਾਰੀ ॥੩॥",
      "transliteration": "aap marai avaraa nah maaree ||3||",
      "translation": "He slays his own self, instead of slaying others. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਏਕੁ ਤੂ ਹੋਰਿ ਵੇਸ ਬਹੁਤੇਰੇ ॥",
      "transliteration": "ek too hor ves bahutere ||",
      "translation": "You, O Lord, are the One, but You have so many Forms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕੁ ਜਾਣੈ ਚੋਜ ਨ ਤੇਰੇ ॥੪॥੨੫॥",
      "transliteration": "naanak jaanai choj na tere ||4||25||",
      "translation": "Nanak does not know Your wondrous plays. ||4||25||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਏਕ ਨ ਭਰੀਆ ਗੁਣ ਕਰਿ ਧੋਵਾ ॥",
      "transliteration": "ek na bhareeaa gun kar dhovaa ||",
      "translation": "I am not stained by only one sin, that could be washed clean by virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੇਰਾ ਸਹੁ ਜਾਗੈ ਹਉ ਨਿਸਿ ਭਰਿ ਸੋਵਾ ॥੧॥",
      "transliteration": "meraa sahu jaagai hau nis bhar sovaa ||1||",
      "translation": "My Husband Lord is awake, while I sleep through the entire night of my life. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਇਉ ਕਿਉ ਕੰਤ ਪਿਆਰੀ ਹੋਵਾ ॥",
      "transliteration": "iu kiu ka(n)t piaaree hovaa ||",
      "translation": "In this way, how can I become dear to my Husband Lord?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0356_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਹੁ ਜਾਗੈ ਹਉ ਨਿਸ ਭਰਿ ਸੋਵਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sahu jaagai hau nis bhar sovaa ||1|| rahaau ||",
      "translation": "My Husband Lord remains awake, while I sleep through the entire night of my life. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 356,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
