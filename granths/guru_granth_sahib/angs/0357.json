{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 357,
  "lineCount": 49,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0357_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਸ ਪਿਆਸੀ ਸੇਜੈ ਆਵਾ ॥",
      "transliteration": "aas piaasee sejai aavaa ||",
      "translation": "With hope and desire, I approach His Bed,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਗੈ ਸਹ ਭਾਵਾ ਕਿ ਨ ਭਾਵਾ ॥੨॥",
      "transliteration": "aagai sah bhaavaa k na bhaavaa ||2||",
      "translation": "but I do not know whether He will be pleased with me or not. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿਆ ਜਾਨਾ ਕਿਆ ਹੋਇਗਾ ਰੀ ਮਾਈ ॥",
      "transliteration": "kiaa jaanaa kiaa hoigaa ree maaee ||",
      "translation": "How do I know what will happen to me, O my mother?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਰਿ ਦਰਸਨ ਬਿਨੁ ਰਹਨੁ ਨ ਜਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har darasan bin rahan na jaaee ||1|| rahaau ||",
      "translation": "Without the Blessed Vision of the Lord's Darshan, I cannot survive. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪ੍ਰੇਮੁ ਨ ਚਾਖਿਆ ਮੇਰੀ ਤਿਸ ਨ ਬੁਝਾਨੀ ॥",
      "transliteration": "prem na chaakhiaa meree tis na bujhaanee ||",
      "translation": "I have not tasted His Love, and my thirst is not quenched.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਇਆ ਸੁ ਜੋਬਨੁ ਧਨ ਪਛੁਤਾਨੀ ॥੩॥",
      "transliteration": "gaiaa s joban dhan pachhutaanee ||3||",
      "translation": "My beautiful youth has run away, and now I, the soul-bride, repent and regret. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਜੈ ਸੁ ਜਾਗਉ ਆਸ ਪਿਆਸੀ ॥",
      "transliteration": "ajai s jaagau aas piaasee ||",
      "translation": "Even now, I am held by hope and desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਈਲੇ ਉਦਾਸੀ ਰਹਉ ਨਿਰਾਸੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bhaeele udaasee rahau niraasee ||1|| rahaau ||",
      "translation": "I am depressed; I have no hope at all. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਉਮੈ ਖੋਇ ਕਰੇ ਸੀਗਾਰੁ ॥",
      "transliteration": "haumai khoi kare seegaar ||",
      "translation": "She overcomes her egotism, and adorns herself;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਉ ਕਾਮਣਿ ਸੇਜੈ ਰਵੈ ਭਤਾਰੁ ॥੪॥",
      "transliteration": "tau kaaman sejai ravai bhataar ||4||",
      "translation": "the Husband Lord now ravishes and enjoys the soul-bride on His Bed. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਉ ਨਾਨਕ ਕੰਤੈ ਮਨਿ ਭਾਵੈ ॥",
      "transliteration": "tau naanak ka(n)tai man bhaavai ||",
      "translation": "Then, O Nanak, the bride becomes pleasing to the Mind of her Husband Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਛੋਡਿ ਵਡਾਈ ਅਪਣੇ ਖਸਮ ਸਮਾਵੈ ॥੧॥ ਰਹਾਉ ॥੨੬॥",
      "transliteration": "chhod vadaaee apane khasam samaavai ||1|| rahaau ||26||",
      "translation": "she sheds her self-conceit, and is absorbed in her Lord and Master. ||1||Pause||26||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪੇਵਕੜੈ ਧਨ ਖਰੀ ਇਆਣੀ ॥",
      "transliteration": "pevakaRai dhan kharee iaanee ||",
      "translation": "In this world of my father's house, I, the soul-bride, have been very childish;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਿਸੁ ਸਹ ਕੀ ਮੈ ਸਾਰ ਨ ਜਾਣੀ ॥੧॥",
      "transliteration": "tis sah kee mai saar na jaanee ||1||",
      "translation": "I did not realize the value of my Husband Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਹੁ ਮੇਰਾ ਏਕੁ ਦੂਜਾ ਨਹੀ ਕੋਈ ॥",
      "transliteration": "sahu meraa ek doojaa nahee koee ||",
      "translation": "My Husband is the One; there is no other like Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਮੇਲਾਵਾ ਹੋਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "nadar kare melaavaa hoee ||1|| rahaau ||",
      "translation": "If He bestows His Glance of Grace, then I shall meet Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਾਹੁਰੜੈ ਧਨ ਸਾਚੁ ਪਛਾਣਿਆ ॥",
      "transliteration": "saahuraRai dhan saach pachhaaniaa ||",
      "translation": "In the next world of my in-law's house, I, the the soul-bride, shall realize Truth;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਹਜਿ ਸੁਭਾਇ ਅਪਣਾ ਪਿਰੁ ਜਾਣਿਆ ॥੨॥",
      "transliteration": "sahaj subhaai apanaa pir jaaniaa ||2||",
      "translation": "I shall come to know the celestial peace of my Husband Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਐਸੀ ਮਤਿ ਆਵੈ ॥",
      "transliteration": "gur parasaadee aisee mat aavai ||",
      "translation": "By Guru's Grace, such wisdom comes to me,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਾਂ ਕਾਮਣਿ ਕੰਤੈ ਮਨਿ ਭਾਵੈ ॥੩॥",
      "transliteration": "taa(n) kaaman ka(n)tai man bhaavai ||3||",
      "translation": "so that the soul-bride becomes pleasing to the Mind of the Husband Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹਤੁ ਨਾਨਕੁ ਭੈ ਭਾਵ ਕਾ ਕਰੇ ਸੀਗਾਰੁ ॥",
      "transliteration": "kahat naanak bhai bhaav kaa kare seegaar ||",
      "translation": "Says Nanak, she who adorns herself with the Love and the Fear of God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਦ ਹੀ ਸੇਜੈ ਰਵੈ ਭਤਾਰੁ ॥੪॥੨੭॥",
      "transliteration": "sad hee sejai ravai bhataar ||4||27||",
      "translation": "enjoys her Husband Lord forever on His Bed. ||4||27||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨ ਕਿਸ ਕਾ ਪੂਤੁ ਨ ਕਿਸ ਕੀ ਮਾਈ ॥",
      "transliteration": "na kis kaa poot na kis kee maaee ||",
      "translation": "No one is anyone else's son, and no one is anyone else's mother.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਝੂਠੈ ਮੋਹਿ ਭਰਮਿ ਭੁਲਾਈ ॥੧॥",
      "transliteration": "jhoothai mohi bharam bhulaaee ||1||",
      "translation": "Through false attachments, people wander around in doubt. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮੇਰੇ ਸਾਹਿਬ ਹਉ ਕੀਤਾ ਤੇਰਾ ॥",
      "transliteration": "mere saahib hau keetaa teraa ||",
      "translation": "O My Lord and Master, I am created by You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾਂ ਤੂੰ ਦੇਹਿ ਜਪੀ ਨਾਉ ਤੇਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaa(n) too(n) dehi japee naau teraa ||1|| rahaau ||",
      "translation": "If You give it to me, I will chant Your Name. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਹੁਤੇ ਅਉਗਣ ਕੂਕੈ ਕੋਈ ॥",
      "transliteration": "bahute augan kookai koee ||",
      "translation": "That person who is filled with all sorts of sins may pray at the Lord's Door,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਾ ਤਿਸੁ ਭਾਵੈ ਬਖਸੇ ਸੋਈ ॥੨॥",
      "transliteration": "jaa tis bhaavai bakhase soee ||2||",
      "translation": "but he is forgiven only when the Lord so wills. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਦੁਰਮਤਿ ਖੋਈ ॥",
      "transliteration": "gur parasaadee duramat khoee ||",
      "translation": "By Guru's Grace, evil-mindedness is destroyed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਹ ਦੇਖਾ ਤਹ ਏਕੋ ਸੋਈ ॥੩॥",
      "transliteration": "jah dekhaa tah eko soee ||3||",
      "translation": "Wherever I look, there I find the One Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਹਤ ਨਾਨਕ ਐਸੀ ਮਤਿ ਆਵੈ ॥",
      "transliteration": "kahat naanak aisee mat aavai ||",
      "translation": "Says Nanak, if one comes to such an understanding,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾਂ ਕੋ ਸਚੇ ਸਚਿ ਸਮਾਵੈ ॥੪॥੨੮॥",
      "transliteration": "taa(n) ko sache sach samaavai ||4||28||",
      "translation": "then he is absorbed into the Truest of the True. ||4||28||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ਦੁਪਦੇ ॥",
      "transliteration": "aasaa mahalaa 1 dupade ||",
      "translation": "Aasaa, First Mehl, Dho-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਿਤੁ ਸਰਵਰੜੈ ਭਈਲੇ ਨਿਵਾਸਾ ਪਾਣੀ ਪਾਵਕੁ ਤਿਨਹਿ ਕੀਆ ॥",
      "transliteration": "tit saravaraRai bhaeele nivaasaa paanee paavak tinahi keeaa ||",
      "translation": "In that pool of the world, the people have their homes; there, the Lord has created water and fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪੰਕਜੁ ਮੋਹ ਪਗੁ ਨਹੀ ਚਾਲੈ ਹਮ ਦੇਖਾ ਤਹ ਡੂਬੀਅਲੇ ॥੧॥",
      "transliteration": "pa(n)kaj moh pag nahee chaalai ham dekhaa tah doobeeale ||1||",
      "translation": "In the mud of earthly attachment, their feet have become mired, and I have seen them drowning there. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨ ਏਕੁ ਨ ਚੇਤਸਿ ਮੂੜ ਮਨਾ ॥",
      "transliteration": "man ek na chetas mooR manaa ||",
      "translation": "O foolish people, why don't you remember the One Lord?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਰਿ ਬਿਸਰਤ ਤੇਰੇ ਗੁਣ ਗਲਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har bisarat tere gun galiaa ||1|| rahaau ||",
      "translation": "Forgetting the Lord, your virtues shall wither away. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾ ਹਉ ਜਤੀ ਸਤੀ ਨਹੀ ਪੜਿਆ ਮੂਰਖ ਮੁਗਧਾ ਜਨਮੁ ਭਇਆ ॥",
      "transliteration": "naa hau jatee satee nahee paRiaa moorakh mugadhaa janam bhaiaa ||",
      "translation": "I am not a celibate, nor am I truthful, nor a scholar; I was born foolish and ignorant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰਣਵਤਿ ਨਾਨਕ ਤਿਨੑ ਕੀ ਸਰਣਾ ਜਿਨੑ ਤੂੰ ਨਾਹੀ ਵੀਸਰਿਆ ॥੨॥੨੯॥",
      "transliteration": "pranavat naanak tinh kee saranaa jinh too(n) naahee veesariaa ||2||29||",
      "translation": "Prays Nanak, I seek the Sanctuary of those who do not forget You, Lord. ||2||29||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਛਿਅ ਘਰ ਛਿਅ ਗੁਰ ਛਿਅ ਉਪਦੇਸ ॥",
      "transliteration": "chhi ghar chhi gur chhi upades ||",
      "translation": "There are six systems of philosophy, six teachers, and six doctrines;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰ ਗੁਰੁ ਏਕੋ ਵੇਸ ਅਨੇਕ ॥੧॥",
      "transliteration": "gur gur eko ves anek ||1||",
      "translation": "but the Teacher of teachers is the One Lord, who appears in so many forms. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੈ ਘਰਿ ਕਰਤੇ ਕੀਰਤਿ ਹੋਇ ॥",
      "transliteration": "jai ghar karate keerat hoi ||",
      "translation": "That system, where the Praises of the Creator are sung",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੋ ਘਰੁ ਰਾਖੁ ਵਡਾਈ ਤੋਹਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "so ghar raakh vadaaee tohi ||1|| rahaau ||",
      "translation": "- follow that system; in it rests greatness. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਵਿਸੁਏ ਚਸਿਆ ਘੜੀਆ ਪਹਰਾ ਥਿਤੀ ਵਾਰੀ ਮਾਹੁ ਭਇਆ ॥",
      "transliteration": "visue chasiaa ghaReeaa paharaa thitee vaaree maahu bhaiaa ||",
      "translation": "As the seconds, minutes, hours, days, weekdays months",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੂਰਜੁ ਏਕੋ ਰੁਤਿ ਅਨੇਕ ॥",
      "transliteration": "sooraj eko rut anek ||",
      "translation": "And seasons all originate from the one sun,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0357_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਨਕ ਕਰਤੇ ਕੇ ਕੇਤੇ ਵੇਸ ॥੨॥੩੦॥",
      "transliteration": "naanak karate ke kete ves ||2||30||",
      "translation": "O Nanak, so do all forms originate from the One Creator. ||2||30||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 357,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
