{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 361,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0361_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੁਰ ਕਾ ਦਰਸਨੁ ਅਗਮ ਅਪਾਰਾ ॥੧॥",
      "transliteration": "gur kaa darasan agam apaaraa ||1||",
      "translation": "but the Guru's system is profound and unequalled. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਰ ਕੈ ਦਰਸਨਿ ਮੁਕਤਿ ਗਤਿ ਹੋਇ ॥",
      "transliteration": "gur kai darasan mukat gat hoi ||",
      "translation": "The Guru's system is the way to liberation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਾਚਾ ਆਪਿ ਵਸੈ ਮਨਿ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saachaa aap vasai man soi ||1|| rahaau ||",
      "translation": "The True Lord Himself comes to dwell in the mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰ ਦਰਸਨਿ ਉਧਰੈ ਸੰਸਾਰਾ ॥",
      "transliteration": "gur darasan udharai sa(n)saaraa ||",
      "translation": "Through the Guru's system, the world is saved,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੇ ਕੋ ਲਾਏ ਭਾਉ ਪਿਆਰਾ ॥",
      "transliteration": "je ko laae bhaau piaaraa ||",
      "translation": "if it is embraced with love and affection.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭਾਉ ਪਿਆਰਾ ਲਾਏ ਵਿਰਲਾ ਕੋਇ ॥",
      "transliteration": "bhaau piaaraa laae viralaa koi ||",
      "translation": "How rare is that person who truly loves the Guru's Way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਰ ਕੈ ਦਰਸਨਿ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥੨॥",
      "transliteration": "gur kai darasan sadaa sukh hoi ||2||",
      "translation": "Through the Guru's system, everlasting peace is obtained. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰ ਕੈ ਦਰਸਨਿ ਮੋਖ ਦੁਆਰੁ ॥",
      "transliteration": "gur kai darasan mokh duaar ||",
      "translation": "Through the Guru's system, the Door of Salvation is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵੈ ਪਰਵਾਰ ਸਾਧਾਰੁ ॥",
      "transliteration": "satigur sevai paravaar saadhaar ||",
      "translation": "Serving the True Guru, one's family is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਿਗੁਰੇ ਕਉ ਗਤਿ ਕਾਈ ਨਾਹੀ ॥",
      "transliteration": "nigure kau gat kaaee naahee ||",
      "translation": "There is no salvation for those who have no Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਵਗਣਿ ਮੁਠੇ ਚੋਟਾ ਖਾਹੀ ॥੩॥",
      "transliteration": "avagan muthe chotaa khaahee ||3||",
      "translation": "Beguiled by worthless sins, they are struck down. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਸੁਖੁ ਸਾਂਤਿ ਸਰੀਰ ॥",
      "transliteration": "gur kai sabad sukh saa(n)t sareer ||",
      "translation": "Through the Word of the Guru's Shabad, the body finds peace and tranquility.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਤਾ ਕਉ ਲਗੈ ਨ ਪੀਰ ॥",
      "transliteration": "guramukh taa kau lagai na peer ||",
      "translation": "The Gurmukh is not afflicted by pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਮਕਾਲੁ ਤਿਸੁ ਨੇੜਿ ਨ ਆਵੈ ॥",
      "transliteration": "jamakaal tis neR na aavai ||",
      "translation": "The Messenger of Death does not come near him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਸਾਚਿ ਸਮਾਵੈ ॥੪॥੧॥੪੦॥",
      "transliteration": "naanak guramukh saach samaavai ||4||1||40||",
      "translation": "O Nanak, the Gurmukh is absorbed in the True Lord. ||4||1||40||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੩ ॥",
      "transliteration": "aasaa mahalaa 3 ||",
      "translation": "Aasaa, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਬਦਿ ਮੁਆ ਵਿਚਹੁ ਆਪੁ ਗਵਾਇ ॥",
      "transliteration": "sabad muaa vichahu aap gavaai ||",
      "translation": "One who dies in the Word of the Shabad, eradicates his self-conceit from within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵੇ ਤਿਲੁ ਨ ਤਮਾਇ ॥",
      "transliteration": "satigur seve til na tamaai ||",
      "translation": "He serves the True Guru, with no iota of self-interest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਿਰਭਉ ਦਾਤਾ ਸਦਾ ਮਨਿ ਹੋਇ ॥",
      "transliteration": "nirabhau daataa sadaa man hoi ||",
      "translation": "The Fearless Lord, the Great Giver, ever abides in his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਚੀ ਬਾਣੀ ਪਾਏ ਭਾਗਿ ਕੋਇ ॥੧॥",
      "transliteration": "sachee baanee paae bhaag koi ||1||",
      "translation": "The True Bani of the Word is obtained only by good destiny. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਣ ਸੰਗ੍ਰਹੁ ਵਿਚਹੁ ਅਉਗੁਣ ਜਾਹਿ ॥",
      "transliteration": "gun sa(n)grahu vichahu augun jaahi ||",
      "translation": "So gather merits, and let your demerits depart from within you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਕੈ ਸਬਦਿ ਸਮਾਹਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "poore gur kai sabad samaahi ||1|| rahaau ||",
      "translation": "You shall be absorbed into the Shabad, the Word of the Perfect Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਣਾ ਕਾ ਗਾਹਕੁ ਹੋਵੈ ਸੋ ਗੁਣ ਜਾਣੈ ॥",
      "transliteration": "gunaa kaa gaahak hovai so gun jaanai ||",
      "translation": "One who purchases merits, knows the value of these merits.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਸਬਦਿ ਨਾਮੁ ਵਖਾਣੈ ॥",
      "transliteration": "a(n)mrit sabad naam vakhaanai ||",
      "translation": "He chants the Ambrosial Nectar of the Word, and the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਾਚੀ ਬਾਣੀ ਸੂਚਾ ਹੋਇ ॥",
      "transliteration": "saachee baanee soochaa hoi ||",
      "translation": "Through the True Bani of the Word, he becomes pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੁਣ ਤੇ ਨਾਮੁ ਪਰਾਪਤਿ ਹੋਇ ॥੨॥",
      "transliteration": "gun te naam paraapat hoi ||2||",
      "translation": "Through merit, the Name is obtained. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗੁਣ ਅਮੋਲਕ ਪਾਏ ਨ ਜਾਹਿ ॥",
      "transliteration": "gun amolak paae na jaahi ||",
      "translation": "The invaluable merits cannot be acquired.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਨਿ ਨਿਰਮਲ ਸਾਚੈ ਸਬਦਿ ਸਮਾਹਿ ॥",
      "transliteration": "man niramal saachai sabad samaahi ||",
      "translation": "The pure mind is absorbed into the True Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੇ ਵਡਭਾਗੀ ਜਿਨੑ ਨਾਮੁ ਧਿਆਇਆ ॥",
      "transliteration": "se vadabhaagee jinh naam dhiaaiaa ||",
      "translation": "How very fortunate are those who meditate on the Naam,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਦਾ ਗੁਣਦਾਤਾ ਮੰਨਿ ਵਸਾਇਆ ॥੩॥",
      "transliteration": "sadaa gunadaataa ma(n)n vasaaiaa ||3||",
      "translation": "and ever enshrine in their minds the Lord, the Giver of merit. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੋ ਗੁਣ ਸੰਗ੍ਰਹੈ ਤਿਨੑ ਬਲਿਹਾਰੈ ਜਾਉ ॥",
      "transliteration": "jo gun sa(n)grahai tinh balihaarai jaau ||",
      "translation": "I am a sacrifice to those who gather merits.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦਰਿ ਸਾਚੈ ਸਾਚੇ ਗੁਣ ਗਾਉ ॥",
      "transliteration": "dar saachai saache gun gaau ||",
      "translation": "At the Gate of Truth, I sing the Glorious Praises of the True One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਪੇ ਦੇਵੈ ਸਹਜਿ ਸੁਭਾਇ ॥",
      "transliteration": "aape devai sahaj subhaai ||",
      "translation": "He Himself spontaneously bestows His gifts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਨਕ ਕੀਮਤਿ ਕਹਣੁ ਨ ਜਾਇ ॥੪॥੨॥੪੧॥",
      "transliteration": "naanak keemat kahan na jaai ||4||2||41||",
      "translation": "O Nanak, the value of the Lord cannot be described. ||4||2||41||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੩ ॥",
      "transliteration": "aasaa mahalaa 3 ||",
      "translation": "Aasaa, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਤਿਗੁਰ ਵਿਚਿ ਵਡੀ ਵਡਿਆਈ ॥",
      "transliteration": "satigur vich vadee vadiaaee ||",
      "translation": "Great is the greatness of the True Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚਿਰੀ ਵਿਛੁੰਨੇ ਮੇਲਿ ਮਿਲਾਈ ॥",
      "transliteration": "chiree vichhu(n)ne mel milaaee ||",
      "translation": "He merges in His Merger, those who have been separated for so long.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਪੇ ਮੇਲੇ ਮੇਲਿ ਮਿਲਾਏ ॥",
      "transliteration": "aape mele mel milaae ||",
      "translation": "He Himself merges the merged in His Merger.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਪਣੀ ਕੀਮਤਿ ਆਪੇ ਪਾਏ ॥੧॥",
      "transliteration": "aapanee keemat aape paae ||1||",
      "translation": "He Himself knows His own worth. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਰਿ ਕੀ ਕੀਮਤਿ ਕਿਨ ਬਿਧਿ ਹੋਇ ॥",
      "transliteration": "har kee keemat kin bidh hoi ||",
      "translation": "How can anyone appraise the Lord's worth?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਰਿ ਅਪਰੰਪਰੁ ਅਗਮ ਅਗੋਚਰੁ ਗੁਰ ਕੈ ਸਬਦਿ ਮਿਲੈ ਜਨੁ ਕੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har apara(n)par agam agochar gur kai sabad milai jan koi ||1|| rahaau ||",
      "translation": "Through the Word of the Guru's Shabad, one may merge with the Infinite, Unapproachable and Incomprehensible Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਕੀਮਤਿ ਜਾਣੈ ਕੋਇ ॥",
      "transliteration": "guramukh keemat jaanai koi ||",
      "translation": "Few are the Gurmukhs who know His worth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਵਿਰਲੇ ਕਰਮਿ ਪਰਾਪਤਿ ਹੋਇ ॥",
      "transliteration": "virale karam paraapat hoi ||",
      "translation": "How rare are those who receive the Lord's Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਊਚੀ ਬਾਣੀ ਊਚਾ ਹੋਇ ॥",
      "transliteration": "oochee baanee oochaa hoi ||",
      "translation": "Through the Sublime Bani of His Word, one becomes sublime.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਬਦਿ ਵਖਾਣੈ ਕੋਇ ॥੨॥",
      "transliteration": "guramukh sabad vakhaanai koi ||2||",
      "translation": "The Gurmukh chants the Word of the Shabad. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਵਿਣੁ ਨਾਵੈ ਦੁਖੁ ਦਰਦੁ ਸਰੀਰਿ ॥",
      "transliteration": "vin naavai dukh darad sareer ||",
      "translation": "Without the Name, the body suffers in pain;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਭੇਟੇ ਤਾ ਉਤਰੈ ਪੀਰ ॥",
      "transliteration": "satigur bhete taa utarai peer ||",
      "translation": "but when one meets the True Guru, then that pain is removed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਭੇਟੇ ਦੁਖੁ ਕਮਾਇ ॥",
      "transliteration": "bin gur bhete dukh kamaai ||",
      "translation": "Without meeting the Guru, the mortal earns only pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮਨਮੁਖਿ ਬਹੁਤੀ ਮਿਲੈ ਸਜਾਇ ॥੩॥",
      "transliteration": "manamukh bahutee milai sajaai ||3||",
      "translation": "The self-willed manmukh receives only more punishment. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਮੀਠਾ ਅਤਿ ਰਸੁ ਹੋਇ ॥",
      "transliteration": "har kaa naam meethaa at ras hoi ||",
      "translation": "The essence of the Lord's Name is so very sweet;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪੀਵਤ ਰਹੈ ਪੀਆਏ ਸੋਇ ॥",
      "transliteration": "peevat rahai peeaae soi ||",
      "translation": "he alone drinks it, whom the Lord causes to drink it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਹਰਿ ਰਸੁ ਪਾਏ ॥",
      "transliteration": "gur kirapaa te har ras paae ||",
      "translation": "By Guru's Grace, the essence of the Lord is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ ਗਤਿ ਪਾਏ ॥੪॥੩॥੪੨॥",
      "transliteration": "naanak naam rate gat paae ||4||3||42||",
      "translation": "O Nanak, imbued with the Naam, the Name of the Lord, salvation is attained. ||4||3||42||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੩ ॥",
      "transliteration": "aasaa mahalaa 3 ||",
      "translation": "Aasaa, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮੇਰਾ ਪ੍ਰਭੁ ਸਾਚਾ ਗਹਿਰ ਗੰਭੀਰ ॥",
      "transliteration": "meraa prabh saachaa gahir ga(n)bheer ||",
      "translation": "My God is True, deep and profound.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸੇਵਤ ਹੀ ਸੁਖੁ ਸਾਂਤਿ ਸਰੀਰ ॥",
      "transliteration": "sevat hee sukh saa(n)t sareer ||",
      "translation": "Serving Him, the body acquires peace and tranquility.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸਬਦਿ ਤਰੇ ਜਨ ਸਹਜਿ ਸੁਭਾਇ ॥",
      "transliteration": "sabad tare jan sahaj subhaai ||",
      "translation": "Through the Word of the Shabad, His humble servants easily swim across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0361_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤਿਨ ਕੈ ਹਮ ਸਦ ਲਾਗਹ ਪਾਇ ॥੧॥",
      "transliteration": "tin kai ham sad laagah paai ||1||",
      "translation": "I fall at their feet forever and ever. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 361,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
