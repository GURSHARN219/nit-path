{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 362,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0362_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੋ ਮਨਿ ਰਾਤੇ ਹਰਿ ਰੰਗੁ ਲਾਇ ॥",
      "transliteration": "jo man raate har ra(n)g laai ||",
      "translation": "Those being whose minds are imbued and drenched with the Lord's Love",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਿਨ ਕਾ ਜਨਮ ਮਰਣ ਦੁਖੁ ਲਾਥਾ ਤੇ ਹਰਿ ਦਰਗਹ ਮਿਲੇ ਸੁਭਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tin kaa janam maran dukh laathaa te har daragah mile subhaai ||1|| rahaau ||",
      "translation": "- their pains of birth and death are taken away. They are automatically ushered into the Court of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਬਦੁ ਚਾਖੈ ਸਾਚਾ ਸਾਦੁ ਪਾਏ ॥",
      "transliteration": "sabad chaakhai saachaa saad paae ||",
      "translation": "One who has tasted the Shabad, obtains the true flavor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਮੰਨਿ ਵਸਾਏ ॥",
      "transliteration": "har kaa naam ma(n)n vasaae ||",
      "translation": "The Name of the Lord abides within his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਰਿ ਪ੍ਰਭੁ ਸਦਾ ਰਹਿਆ ਭਰਪੂਰਿ ॥",
      "transliteration": "har prabh sadaa rahiaa bharapoor ||",
      "translation": "The Lord God is Eternal and All-pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਪੇ ਨੇੜੈ ਆਪੇ ਦੂਰਿ ॥੨॥",
      "transliteration": "aape neRai aape door ||2||",
      "translation": "He Himself is near, and He Himself is far away. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਖਣਿ ਆਖੈ ਬਕੈ ਸਭੁ ਕੋਇ ॥",
      "transliteration": "aakhan aakhai bakai sabh koi ||",
      "translation": "Everyone talks and speaks through speech;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਪੇ ਬਖਸਿ ਮਿਲਾਏ ਸੋਇ ॥",
      "transliteration": "aape bakhas milaae soi ||",
      "translation": "the Lord Himself forgives, and unites us with Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਹਣੈ ਕਥਨਿ ਨ ਪਾਇਆ ਜਾਇ ॥",
      "transliteration": "kahanai kathan na paaiaa jaai ||",
      "translation": "By merely speaking and talking, He is not obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਵਸੈ ਮਨਿ ਆਇ ॥੩॥",
      "transliteration": "gur parasaad vasai man aai ||3||",
      "translation": "By Guru's Grace, He comes to abide in the mind. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਵਿਚਹੁ ਆਪੁ ਗਵਾਇ ॥",
      "transliteration": "guramukh vichahu aap gavaai ||",
      "translation": "The Gurmukh eradicates his self-conceit from within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਰੰਗਿ ਰਾਤੇ ਮੋਹੁ ਚੁਕਾਇ ॥",
      "transliteration": "har ra(n)g raate mohu chukaai ||",
      "translation": "He is imbued with the Lord's Love, having discarded worldly attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਤਿ ਨਿਰਮਲੁ ਗੁਰਸਬਦ ਵੀਚਾਰ ॥",
      "transliteration": "at niramal gurasabad veechaar ||",
      "translation": "He contemplates the utterly Immaculate Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਸਵਾਰਣਹਾਰ ॥੪॥੪॥੪੩॥",
      "transliteration": "naanak naam savaaranahaar ||4||4||43||",
      "translation": "O Nanak, the Naam, the Name of the Lord, is our Salvation. ||4||4||43||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੩ ॥",
      "transliteration": "aasaa mahalaa 3 ||",
      "translation": "Aasaa, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੂਜੈ ਭਾਇ ਲਗੇ ਦੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "doojai bhaai lage dukh paaiaa ||",
      "translation": "Attached to the love of duality, one only incurs pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਨੁ ਸਬਦੈ ਬਿਰਥਾ ਜਨਮੁ ਗਵਾਇਆ ॥",
      "transliteration": "bin sabadai birathaa janam gavaaiaa ||",
      "translation": "Without the Word of the Shabad, one's life is wasted away in vain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵੈ ਸੋਝੀ ਹੋਇ ॥",
      "transliteration": "satigur sevai sojhee hoi ||",
      "translation": "Serving the True Guru, understanding is obtained,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੂਜੈ ਭਾਇ ਨ ਲਾਗੈ ਕੋਇ ॥੧॥",
      "transliteration": "doojai bhaai na laagai koi ||1||",
      "translation": "and then, one is not attached to the love of duality. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮੂਲਿ ਲਾਗੇ ਸੇ ਜਨ ਪਰਵਾਣੁ ॥",
      "transliteration": "mool laage se jan paravaan ||",
      "translation": "Those who hold fast to their roots, become acceptable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਨਦਿਨੁ ਰਾਮ ਨਾਮੁ ਜਪਿ ਹਿਰਦੈ ਗੁਰਸਬਦੀ ਹਰਿ ਏਕੋ ਜਾਣੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "anadin raam naam jap hiradai gurasabadee har eko jaan ||1|| rahaau ||",
      "translation": "Night and day, they meditate within their hearts on the Lord's Name; through the Word of the Guru's Shabad, they know the One Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਡਾਲੀ ਲਾਗੈ ਨਿਹਫਲੁ ਜਾਇ ॥",
      "transliteration": "daalee laagai nihaphal jaai ||",
      "translation": "One who is attached to the branch, does not receive the fruits.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅੰਧਂੀ ਕੰਮੀ ਅੰਧ ਸਜਾਇ ॥",
      "transliteration": "a(n)dha(n)ee ka(n)mee a(n)dh sajaai ||",
      "translation": "For blind actions, blind punishment is received.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਨਮੁਖੁ ਅੰਧਾ ਠਉਰ ਨ ਪਾਇ ॥",
      "transliteration": "manamukh a(n)dhaa thaur na paai ||",
      "translation": "The blind, self-willed manmukh finds no place of rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਿਸਟਾ ਕਾ ਕੀੜਾ ਬਿਸਟਾ ਮਾਹਿ ਪਚਾਇ ॥੨॥",
      "transliteration": "bisataa kaa keeRaa bisataa maahi pachaai ||2||",
      "translation": "He is a maggot in manure, and in manure he shall rot away. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੁਰ ਕੀ ਸੇਵਾ ਸਦਾ ਸੁਖੁ ਪਾਏ ॥",
      "transliteration": "gur kee sevaa sadaa sukh paae ||",
      "translation": "Serving the Guru, everlasting peace is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੰਤਸੰਗਤਿ ਮਿਲਿ ਹਰਿ ਗੁਣ ਗਾਏ ॥",
      "transliteration": "sa(n)tasa(n)gat mil har gun gaae ||",
      "translation": "Joining the True Congregation, the Sat Sangat, the Glorious Praises of the Lord are sung.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਮੇ ਨਾਮਿ ਕਰੇ ਵੀਚਾਰੁ ॥",
      "transliteration": "naame naam kare veechaar ||",
      "translation": "One who contemplates the Naam, the Name of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਪਿ ਤਰੈ ਕੁਲ ਉਧਰਣਹਾਰੁ ॥੩॥",
      "transliteration": "aap tarai kul udharanahaar ||3||",
      "translation": "saves himself, and his family as well. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗੁਰ ਕੀ ਬਾਣੀ ਨਾਮਿ ਵਜਾਏ ॥",
      "transliteration": "gur kee baanee naam vajaae ||",
      "translation": "Through the Word of the Guru's Bani, the Naam resounds;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾਨਕ ਮਹਲੁ ਸਬਦਿ ਘਰੁ ਪਾਏ ॥",
      "transliteration": "naanak mahal sabad ghar paae ||",
      "translation": "O Nanak, through the Word of the Shabad, one finds the Mansion of the Lord's Presence within the home of the heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰਮਤਿ ਸਤ ਸਰਿ ਹਰਿ ਜਲਿ ਨਾਇਆ ॥",
      "transliteration": "guramat sat sar har jal naaiaa ||",
      "translation": "Under Guru's Instruction, bathe in the Pool of Truth, in the Water of the Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੁਰਮਤਿ ਮੈਲੁ ਸਭੁ ਦੁਰਤੁ ਗਵਾਇਆ ॥੪॥੫॥੪੪॥",
      "transliteration": "duramat mail sabh durat gavaaiaa ||4||5||44||",
      "translation": "thus the filth of evil-mindedness and sin shall all be washed away. ||4||5||44||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੩ ॥",
      "transliteration": "aasaa mahalaa 3 ||",
      "translation": "Aasaa, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਨਮੁਖ ਮਰਹਿ ਮਰਿ ਮਰਣੁ ਵਿਗਾੜਹਿ ॥",
      "transliteration": "manamukh marahi mar maran vigaaRahi ||",
      "translation": "The self-willed manmukhs are dying; they are wasting away in death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੂਜੈ ਭਾਇ ਆਤਮ ਸੰਘਾਰਹਿ ॥",
      "transliteration": "doojai bhaai aatam sa(n)ghaarahi ||",
      "translation": "In the love of duality, they murder their own souls.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮੇਰਾ ਮੇਰਾ ਕਰਿ ਕਰਿ ਵਿਗੂਤਾ ॥",
      "transliteration": "meraa meraa kar kar vigootaa ||",
      "translation": "Crying out, Mine, mine!, they are ruined.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਤਮੁ ਨ ਚੀਨੑੈ ਭਰਮੈ ਵਿਚਿ ਸੂਤਾ ॥੧॥",
      "transliteration": "aatam na cheenhai bharamai vich sootaa ||1||",
      "translation": "They do not remember their souls; they are asleep in superstition. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਰੁ ਮੁਇਆ ਸਬਦੇ ਮਰਿ ਜਾਇ ॥",
      "transliteration": "mar muiaa sabade mar jaai ||",
      "translation": "He alone dies a real death, who dies in the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਉਸਤਤਿ ਨਿੰਦਾ ਗੁਰਿ ਸਮ ਜਾਣਾਈ ਇਸੁ ਜੁਗ ਮਹਿ ਲਾਹਾ ਹਰਿ ਜਪਿ ਲੈ ਜਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "usatat ni(n)daa gur sam jaanaaee is jug mahi laahaa har jap lai jaai ||1|| rahaau ||",
      "translation": "The Guru has inspired me to realize, that praise and slander are one and the same; in this world, the profit is obtained by chanting the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਮ ਵਿਹੂਣ ਗਰਭ ਗਲਿ ਜਾਇ ॥",
      "transliteration": "naam vihoon garabh gal jaai ||",
      "translation": "Those who lack the Naam, the Name of the Lord, are dissolved within the womb.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਿਰਥਾ ਜਨਮੁ ਦੂਜੈ ਲੋਭਾਇ ॥",
      "transliteration": "birathaa janam doojai lobhaai ||",
      "translation": "Useless is the birth of those who are lured by duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਮ ਬਿਹੂਣੀ ਦੁਖਿ ਜਲੈ ਸਬਾਈ ॥",
      "transliteration": "naam bihoonee dukh jalai sabaaee ||",
      "translation": "Without the Naam, all are burning in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਪੂਰੈ ਬੂਝ ਬੁਝਾਈ ॥੨॥",
      "transliteration": "satigur poorai boojh bujhaaee ||2||",
      "translation": "The Perfect True Guru has given me this understanding. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਨੁ ਚੰਚਲੁ ਬਹੁ ਚੋਟਾ ਖਾਇ ॥",
      "transliteration": "man cha(n)chal bahu chotaa khaai ||",
      "translation": "The fickle mind is struck down so many times.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਏਥਹੁ ਛੁੜਕਿਆ ਠਉਰ ਨ ਪਾਇ ॥",
      "transliteration": "ethahu chhuRakiaa thaur na paai ||",
      "translation": "Having lost this opportunity, no place of rest shall be found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗਰਭ ਜੋਨਿ ਵਿਸਟਾ ਕਾ ਵਾਸੁ ॥",
      "transliteration": "garabh jon visataa kaa vaas ||",
      "translation": "Cast into the womb of reincarnation, the mortal lives in manure;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਤੁ ਘਰਿ ਮਨਮੁਖੁ ਕਰੇ ਨਿਵਾਸੁ ॥੩॥",
      "transliteration": "tit ghar manamukh kare nivaas ||3||",
      "translation": "in such a home, the self-willed manmukh takes up residence. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਪੁਨੇ ਸਤਿਗੁਰ ਕਉ ਸਦਾ ਬਲਿ ਜਾਈ ॥",
      "transliteration": "apune satigur kau sadaa bal jaaee ||",
      "translation": "I am forever a sacrifice to my True Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਜੋਤੀ ਜੋਤਿ ਮਿਲਾਈ ॥",
      "transliteration": "guramukh jotee jot milaaee ||",
      "translation": "the light of the Gurmukh blends with the Divine Light of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਿਰਮਲ ਬਾਣੀ ਨਿਜ ਘਰਿ ਵਾਸਾ ॥",
      "transliteration": "niramal baanee nij ghar vaasaa ||",
      "translation": "Through the Immaculate Bani of the Word, the mortal dwells within the home of his own inner self.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾਨਕ ਹਉਮੈ ਮਾਰੇ ਸਦਾ ਉਦਾਸਾ ॥੪॥੬॥੪੫॥",
      "transliteration": "naanak haumai maare sadaa udaasaa ||4||6||45||",
      "translation": "O Nanak, he conquers his ego, and remains forever detached. ||4||6||45||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੩ ॥",
      "transliteration": "aasaa mahalaa 3 ||",
      "translation": "Aasaa, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0362_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਲਾਲੈ ਆਪਣੀ ਜਾਤਿ ਗਵਾਈ ॥",
      "transliteration": "laalai aapanee jaat gavaaee ||",
      "translation": "The Lord's slave sets aside his own social status.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 362,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
