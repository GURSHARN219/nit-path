{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 363,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0363_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਅਰਪੇ ਸਤਿਗੁਰ ਸਰਣਾਈ ॥",
      "transliteration": "tan man arape satigur saranaaee ||",
      "translation": "He dedicates his mind and body to the True Guru, and seeks His Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਿਰਦੈ ਨਾਮੁ ਵਡੀ ਵਡਿਆਈ ॥",
      "transliteration": "hiradai naam vadee vadiaaee ||",
      "translation": "His greatest greatness is that the Naam, the Name of the Lord, is in his heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਦਾ ਪ੍ਰੀਤਮੁ ਪ੍ਰਭੁ ਹੋਇ ਸਖਾਈ ॥੧॥",
      "transliteration": "sadaa preetam prabh hoi sakhaaee ||1||",
      "translation": "The Beloved Lord God is his constant companion. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੋ ਲਾਲਾ ਜੀਵਤੁ ਮਰੈ ॥",
      "transliteration": "so laalaa jeevat marai ||",
      "translation": "He alone is the Lord's slave, who remains dead while yet alive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੋਗੁ ਹਰਖੁ ਦੁਇ ਸਮ ਕਰਿ ਜਾਣੈ ਗੁਰ ਪਰਸਾਦੀ ਸਬਦਿ ਉਧਰੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sog harakh dui sam kar jaanai gur parasaadee sabad udharai ||1|| rahaau ||",
      "translation": "He looks upon pleasure and pain alike; by Guru's Grace, he is saved through the Word of the Shabad. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਰਣੀ ਕਾਰ ਧੁਰਹੁ ਫੁਰਮਾਈ ॥",
      "transliteration": "karanee kaar dhurahu phuramaaee ||",
      "translation": "He does his deeds according to the Lord's Primal Command.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਿਨੁ ਸਬਦੈ ਕੋ ਥਾਇ ਨ ਪਾਈ ॥",
      "transliteration": "bin sabadai ko thaai na paaee ||",
      "translation": "Without the Shabad, no one is approved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਰਣੀ ਕੀਰਤਿ ਨਾਮੁ ਵਸਾਈ ॥",
      "transliteration": "karanee keerat naam vasaaee ||",
      "translation": "Singing the Kirtan of the Lord's Praises, the Naam abides within the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਪੇ ਦੇਵੈ ਢਿਲ ਨ ਪਾਈ ॥੨॥",
      "transliteration": "aape devai dhil na paaee ||2||",
      "translation": "He Himself gives His gifts, without hesitation. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨਮੁਖਿ ਭਰਮਿ ਭੁਲੈ ਸੰਸਾਰੁ ॥",
      "transliteration": "manamukh bharam bhulai sa(n)saar ||",
      "translation": "The self-willed manmukh wanders around the world in doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਨੁ ਰਾਸੀ ਕੂੜਾ ਕਰੇ ਵਾਪਾਰੁ ॥",
      "transliteration": "bin raasee kooRaa kare vaapaar ||",
      "translation": "Without any capital, he makes false transactions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਵਿਣੁ ਰਾਸੀ ਵਖਰੁ ਪਲੈ ਨ ਪਾਇ ॥",
      "transliteration": "vin raasee vakhar palai na paai ||",
      "translation": "Without any capital, he does not obtain any merchandise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਨਮੁਖਿ ਭੁਲਾ ਜਨਮੁ ਗਵਾਇ ॥੩॥",
      "transliteration": "manamukh bhulaa janam gavaai ||3||",
      "translation": "The mistaken manmukh wastes away his life. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵੇ ਸੁ ਲਾਲਾ ਹੋਇ ॥",
      "transliteration": "satigur seve s laalaa hoi ||",
      "translation": "One who serves the True Guru is the Lord's slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਊਤਮ ਜਾਤੀ ਊਤਮੁ ਸੋਇ ॥",
      "transliteration": "ootam jaatee ootam soi ||",
      "translation": "His social status is exalted, and his reputation is exalted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰ ਪਉੜੀ ਸਭ ਦੂ ਊਚਾ ਹੋਇ ॥",
      "transliteration": "gur pauRee sabh doo oochaa hoi ||",
      "translation": "Climbing the Guru's Ladder, he becomes the most exalted of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਵਡਾਈ ਹੋਇ ॥੪॥੭॥੪੬॥",
      "transliteration": "naanak naam vadaaee hoi ||4||7||46||",
      "translation": "O Nanak, through the Naam, the Name of the Lord, greatness is obtained. ||4||7||46||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੩ ॥",
      "transliteration": "aasaa mahalaa 3 ||",
      "translation": "Aasaa, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਨਮੁਖਿ ਝੂਠੋ ਝੂਠੁ ਕਮਾਵੈ ॥",
      "transliteration": "manamukh jhootho jhooth kamaavai ||",
      "translation": "The self-willed manmukh practices falsehood, only falsehood.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਖਸਮੈ ਕਾ ਮਹਲੁ ਕਦੇ ਨ ਪਾਵੈ ॥",
      "transliteration": "khasamai kaa mahal kade na paavai ||",
      "translation": "He never attains the Mansion of the Lord Presence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੂਜੈ ਲਗੀ ਭਰਮਿ ਭੁਲਾਵੈ ॥",
      "transliteration": "doojai lagee bharam bhulaavai ||",
      "translation": "Attached to duality, he wanders, deluded by doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਮਤਾ ਬਾਧਾ ਆਵੈ ਜਾਵੈ ॥੧॥",
      "transliteration": "mamataa baadhaa aavai jaavai ||1||",
      "translation": "Entangled in worldly attachments, he comes and goes. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੋਹਾਗਣੀ ਕਾ ਮਨ ਦੇਖੁ ਸੀਗਾਰੁ ॥",
      "transliteration": "dohaaganee kaa man dekh seegaar ||",
      "translation": "Behold, the decorations of the discarded bride!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪੁਤ੍ਰ ਕਲਤਿ ਧਨਿ ਮਾਇਆ ਚਿਤੁ ਲਾਏ ਝੂਠੁ ਮੋਹੁ ਪਾਖੰਡ ਵਿਕਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "putr kalat dhan maaiaa chit laae jhooth mohu paakha(n)d vikaar ||1|| rahaau ||",
      "translation": "Her consciousness is attached to children, spouse, wealth, and Maya, falsehood, emotional attachment, hypocrisy and corruption. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਦਾ ਸੋਹਾਗਣਿ ਜੋ ਪ੍ਰਭ ਭਾਵੈ ॥",
      "transliteration": "sadaa sohaagan jo prabh bhaavai ||",
      "translation": "She who is pleasing to God is forever a happy soul-bride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੁਰਸਬਦੀ ਸੀਗਾਰੁ ਬਣਾਵੈ ॥",
      "transliteration": "gurasabadee seegaar banaavai ||",
      "translation": "She makes the Word of the Guru's Shabad her decoration.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੇਜ ਸੁਖਾਲੀ ਅਨਦਿਨੁ ਹਰਿ ਰਾਵੈ ॥",
      "transliteration": "sej sukhaalee anadin har raavai ||",
      "translation": "Her bed is so comfortable; she enjoys her Lord, night and day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਿਲਿ ਪ੍ਰੀਤਮ ਸਦਾ ਸੁਖੁ ਪਾਵੈ ॥੨॥",
      "transliteration": "mil preetam sadaa sukh paavai ||2||",
      "translation": "Meeting her Beloved, the obtains eternal peace. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਾ ਸੋਹਾਗਣਿ ਸਾਚੀ ਜਿਸੁ ਸਾਚਿ ਪਿਆਰੁ ॥",
      "transliteration": "saa sohaagan saachee jis saach piaar ||",
      "translation": "She is a true, virtuous soul-bride, who enshrines love for the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਪਣਾ ਪਿਰੁ ਰਾਖੈ ਸਦਾ ਉਰ ਧਾਰਿ ॥",
      "transliteration": "apanaa pir raakhai sadaa ur dhaar ||",
      "translation": "She keeps her Husband Lord always clasped to her heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨੇੜੈ ਵੇਖੈ ਸਦਾ ਹਦੂਰਿ ॥",
      "transliteration": "neRai vekhai sadaa hadoor ||",
      "translation": "She sees Him near at hand, ever-present.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੇਰਾ ਪ੍ਰਭੁ ਸਰਬ ਰਹਿਆ ਭਰਪੂਰਿ ॥੩॥",
      "transliteration": "meraa prabh sarab rahiaa bharapoor ||3||",
      "translation": "My God is all-pervading everywhere. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਗੈ ਜਾਤਿ ਰੂਪੁ ਨ ਜਾਇ ॥",
      "transliteration": "aagai jaat roop na jaai ||",
      "translation": "Social status and beauty will not go with you hereafter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੇਹਾ ਹੋਵੈ ਜੇਹੇ ਕਰਮ ਕਮਾਇ ॥",
      "transliteration": "tehaa hovai jehe karam kamaai ||",
      "translation": "As are the deeds done here, so does one become.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਬਦੇ ਊਚੋ ਊਚਾ ਹੋਇ ॥",
      "transliteration": "sabade oocho oochaa hoi ||",
      "translation": "Through the Word of the Shabad, one becomes the highest of the high.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਨਕ ਸਾਚਿ ਸਮਾਵੈ ਸੋਇ ॥੪॥੮॥੪੭॥",
      "transliteration": "naanak saach samaavai soi ||4||8||47||",
      "translation": "O Nanak, he is absorbed in the True Lord. ||4||8||47||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੩ ॥",
      "transliteration": "aasaa mahalaa 3 ||",
      "translation": "Aasaa, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭਗਤਿ ਰਤਾ ਜਨੁ ਸਹਜਿ ਸੁਭਾਇ ॥",
      "transliteration": "bhagat rataa jan sahaj subhaai ||",
      "translation": "The Lord's humble servant is imbued with devotional love, effortlessly and spontaneously.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰ ਕੈ ਭੈ ਸਾਚੈ ਸਾਚਿ ਸਮਾਇ ॥",
      "transliteration": "gur kai bhai saachai saach samaai ||",
      "translation": "Through awe and fear of the Guru, he is truly absorbed in the True One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਪੂਰੇ ਭਗਤਿ ਨ ਹੋਇ ॥",
      "transliteration": "bin gur poore bhagat na hoi ||",
      "translation": "Without the Perfect Guru, devotional love is not obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਨਮੁਖ ਰੁੰਨੇ ਅਪਨੀ ਪਤਿ ਖੋਇ ॥੧॥",
      "transliteration": "manamukh ru(n)ne apanee pat khoi ||1||",
      "translation": "The self-willed manmukhs lose their honor, and cry out in pain. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮੇਰੇ ਮਨ ਹਰਿ ਜਪਿ ਸਦਾ ਧਿਆਇ ॥",
      "transliteration": "mere man har jap sadaa dhiaai ||",
      "translation": "O my mind, chant the Lord's Name, and meditate on Him forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਦਾ ਅਨੰਦੁ ਹੋਵੈ ਦਿਨੁ ਰਾਤੀ ਜੋ ਇਛੈ ਸੋਈ ਫਲੁ ਪਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sadaa ana(n)d hovai din raatee jo ichhai soee phal paai ||1|| rahaau ||",
      "translation": "You shall always be in ecstasy, day and night, and you shall obtain the fruits of your desires. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਤੇ ਪੂਰਾ ਪਾਏ ॥",
      "transliteration": "gur poore te pooraa paae ||",
      "translation": "Through the Perfect Guru, the Perfect Lord is obtained,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਿਰਦੈ ਸਬਦੁ ਸਚੁ ਨਾਮੁ ਵਸਾਏ ॥",
      "transliteration": "hiradai sabad sach naam vasaae ||",
      "translation": "and the Shabad, the True Name, is enshrined in the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅੰਤਰੁ ਨਿਰਮਲੁ ਅੰਮ੍ਰਿਤ ਸਰਿ ਨਾਏ ॥",
      "transliteration": "a(n)tar niramal a(n)mrit sar naae ||",
      "translation": "One who bathes in the Pool of Ambrosial Nectar becomes immaculately pure within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਦਾ ਸੂਚੇ ਸਾਚਿ ਸਮਾਏ ॥੨॥",
      "transliteration": "sadaa sooche saach samaae ||2||",
      "translation": "He becomes forever sanctified, and is absorbed in the True Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹਰਿ ਪ੍ਰਭੁ ਵੇਖੈ ਸਦਾ ਹਜੂਰਿ ॥",
      "transliteration": "har prabh vekhai sadaa hajoor ||",
      "translation": "He sees the Lord God ever-present.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਰਹਿਆ ਭਰਪੂਰਿ ॥",
      "transliteration": "gur parasaad rahiaa bharapoor ||",
      "translation": "By Guru's Grace, he sees the Lord permeating and pervading everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਹਾ ਜਾਉ ਤਹ ਵੇਖਾ ਸੋਇ ॥",
      "transliteration": "jahaa jaau tah vekhaa soi ||",
      "translation": "Wherever I go, there I see Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗੁਰ ਬਿਨੁ ਦਾਤਾ ਅਵਰੁ ਨ ਕੋਇ ॥੩॥",
      "transliteration": "gur bin daataa avar na koi ||3||",
      "translation": "Without the Guru, there is no other Giver. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰੁ ਸਾਗਰੁ ਪੂਰਾ ਭੰਡਾਰ ॥",
      "transliteration": "gur saagar pooraa bha(n)daar ||",
      "translation": "The Guru is the ocean, the perfect treasure,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਊਤਮ ਰਤਨ ਜਵਾਹਰ ਅਪਾਰ ॥",
      "transliteration": "ootam ratan javaahar apaar ||",
      "translation": "the most precious jewel and priceless ruby.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਦੇਵਣਹਾਰੁ ॥",
      "transliteration": "gur parasaadee devanahaar ||",
      "translation": "By Guru's Grace, the Great Giver blesses us;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਨਕ ਬਖਸੇ ਬਖਸਣਹਾਰੁ ॥੪॥੯॥੪੮॥",
      "transliteration": "naanak bakhase bakhasanahaar ||4||9||48||",
      "translation": "O Nanak, the Forgiving Lord forgives us. ||4||9||48||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੩ ॥",
      "transliteration": "aasaa mahalaa 3 ||",
      "translation": "Aasaa, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗੁਰੁ ਸਾਇਰੁ ਸਤਿਗੁਰੁ ਸਚੁ ਸੋਇ ॥",
      "transliteration": "gur saair satigur sach soi ||",
      "translation": "The Guru is the Ocean; the True Guru is the Embodiment of Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0363_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਪੂਰੈ ਭਾਗਿ ਗੁਰ ਸੇਵਾ ਹੋਇ ॥",
      "transliteration": "poorai bhaag gur sevaa hoi ||",
      "translation": "Through perfect good destiny, one serves the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 363,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
