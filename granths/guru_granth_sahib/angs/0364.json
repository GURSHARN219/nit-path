{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 364,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0364_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੋ ਬੂਝੈ ਜਿਸੁ ਆਪਿ ਬੁਝਾਏ ॥",
      "transliteration": "so boojhai jis aap bujhaae ||",
      "translation": "He alone understands, whom the Lord Himself inspires to understand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਸੇਵ ਕਰਾਏ ॥੧॥",
      "transliteration": "gur parasaadee sev karaae ||1||",
      "translation": "By Guru's Grace, one serves Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗਿਆਨ ਰਤਨਿ ਸਭ ਸੋਝੀ ਹੋਇ ॥",
      "transliteration": "giaan ratan sabh sojhee hoi ||",
      "translation": "With the jewel of spiritual wisdom, total understanding is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਅਗਿਆਨੁ ਬਿਨਾਸੈ ਅਨਦਿਨੁ ਜਾਗੈ ਵੇਖੈ ਸਚੁ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur parasaad agiaan binaasai anadin jaagai vekhai sach soi ||1|| rahaau ||",
      "translation": "By Guru's Grace, ignorance is dispelled; one then remains wakeful, night and day, and beholds the True Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮੋਹੁ ਗੁਮਾਨੁ ਗੁਰ ਸਬਦਿ ਜਲਾਏ ॥",
      "transliteration": "mohu gumaan gur sabad jalaae ||",
      "translation": "Through the Word of the Guru's Shabad, attachment and pride are burnt away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਤੇ ਸੋਝੀ ਪਾਏ ॥",
      "transliteration": "poore gur te sojhee paae ||",
      "translation": "From the Perfect Guru, true understanding is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅੰਤਰਿ ਮਹਲੁ ਗੁਰ ਸਬਦਿ ਪਛਾਣੈ ॥",
      "transliteration": "a(n)tar mahal gur sabad pachhaanai ||",
      "translation": "Through the Word of the Guru's Shabad, one realizes the Lord's Presence within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਵਣ ਜਾਣੁ ਰਹੈ ਥਿਰੁ ਨਾਮਿ ਸਮਾਣੇ ॥੨॥",
      "transliteration": "aavan jaan rahai thir naam samaane ||2||",
      "translation": "Then, one's coming and going cease, and one becomes stable, absorbed in the Naam, the Name of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੰਮਣੁ ਮਰਣਾ ਹੈ ਸੰਸਾਰੁ ॥",
      "transliteration": "ja(n)man maranaa hai sa(n)saar ||",
      "translation": "The world is tied to birth and death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨਮੁਖੁ ਅਚੇਤੁ ਮਾਇਆ ਮੋਹੁ ਗੁਬਾਰੁ ॥",
      "transliteration": "manamukh achet maaiaa mohu gubaar ||",
      "translation": "The unconscious, self-willed manmukh is enveloped in the darkness of Maya and emotional attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪਰ ਨਿੰਦਾ ਬਹੁ ਕੂੜੁ ਕਮਾਵੈ ॥",
      "transliteration": "par ni(n)daa bahu kooR kamaavai ||",
      "translation": "He slanders others, and practices utter falsehood.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਵਿਸਟਾ ਕਾ ਕੀੜਾ ਵਿਸਟਾ ਮਾਹਿ ਸਮਾਵੈ ॥੩॥",
      "transliteration": "visataa kaa keeRaa visataa maahi samaavai ||3||",
      "translation": "He is a maggot in manure, and into manure he is absorbed. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਤਸੰਗਤਿ ਮਿਲਿ ਸਭ ਸੋਝੀ ਪਾਏ ॥",
      "transliteration": "satasa(n)gat mil sabh sojhee paae ||",
      "translation": "Joining the True Congregation, the Sat Sangat, total understanding is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਹਰਿ ਭਗਤਿ ਦ੍ਰਿੜਾਏ ॥",
      "transliteration": "gur kaa sabad har bhagat driRaae ||",
      "translation": "Through the Word of the Guru's Shabad, devotional love for the Lord is implanted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਾਣਾ ਮੰਨੇ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "bhaanaa ma(n)ne sadaa sukh hoi ||",
      "translation": "One who surrenders to the Lord's Will is peaceful forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਨਕ ਸਚਿ ਸਮਾਵੈ ਸੋਇ ॥੪॥੧੦॥੪੯॥",
      "transliteration": "naanak sach samaavai soi ||4||10||49||",
      "translation": "O Nanak, he is absorbed into the True Lord. ||4||10||49||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੩ ਪੰਚਪਦੇ₂ ॥",
      "transliteration": "aasaa mahalaa 3 pa(n)chapade₂ ||",
      "translation": "Aasaa, Third Mehl, Panch-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਬਦਿ ਮਰੈ ਤਿਸੁ ਸਦਾ ਅਨੰਦ ॥",
      "transliteration": "sabad marai tis sadaa ana(n)d ||",
      "translation": "One who dies in the Word of the Shabad, finds eternal bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਤਿਗੁਰ ਭੇਟੇ ਗੁਰ ਗੋਬਿੰਦ ॥",
      "transliteration": "satigur bhete gur gobi(n)d ||",
      "translation": "He is united with the True Guru, the Guru, the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾ ਫਿਰਿ ਮਰੈ ਨ ਆਵੈ ਜਾਇ ॥",
      "transliteration": "naa phir marai na aavai jaai ||",
      "translation": "He does not die any more, and he does not come or go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਤੇ ਸਾਚਿ ਸਮਾਇ ॥੧॥",
      "transliteration": "poore gur te saach samaai ||1||",
      "translation": "Through the Perfect Guru, he merges with the True Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਨੑ ਕਉ ਨਾਮੁ ਲਿਖਿਆ ਧੁਰਿ ਲੇਖੁ ॥",
      "transliteration": "jinh kau naam likhiaa dhur lekh ||",
      "translation": "One who has the Naam, the Name of the Lord, written in his pre-ordained destiny,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤੇ ਅਨਦਿਨੁ ਨਾਮੁ ਸਦਾ ਧਿਆਵਹਿ ਗੁਰ ਪੂਰੇ ਤੇ ਭਗਤਿ ਵਿਸੇਖੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "te anadin naam sadaa dhiaavahi gur poore te bhagat visekh ||1|| rahaau ||",
      "translation": "night and day, meditates forever on the Naam; he obtains the wondrous blessing of devotional love from the Perfect Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਿਨੑ ਕਉ ਹਰਿ ਪ੍ਰਭੁ ਲਏ ਮਿਲਾਇ ॥",
      "transliteration": "jinh kau har prabh lae milaai ||",
      "translation": "Those, whom the Lord God has blended with Himself",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਨੑ ਕੀ ਗਹਣ ਗਤਿ ਕਹੀ ਨ ਜਾਇ ॥",
      "transliteration": "tinh kee gahan gat kahee na jaai ||",
      "translation": "their sublime state cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪੂਰੈ ਸਤਿਗੁਰ ਦਿਤੀ ਵਡਿਆਈ ॥",
      "transliteration": "poorai satigur ditee vadiaaee ||",
      "translation": "The Perfect True Guru has given the Glorious Greatness,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਊਤਮ ਪਦਵੀ ਹਰਿ ਨਾਮਿ ਸਮਾਈ ॥੨॥",
      "transliteration": "ootam padavee har naam samaaee ||2||",
      "translation": "of the most exalted order, and I am absorbed into the Lord's Name. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕਰੇ ਸੁ ਆਪੇ ਆਪਿ ॥",
      "transliteration": "jo kichh kare s aape aap ||",
      "translation": "Whatever the Lord does, He does all by Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਏਕ ਘੜੀ ਮਹਿ ਥਾਪਿ ਉਥਾਪਿ ॥",
      "transliteration": "ek ghaRee mahi thaap uthaap ||",
      "translation": "In an instant, He establishes, and disestablishes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹਿ ਕਹਿ ਕਹਣਾ ਆਖਿ ਸੁਣਾਏ ॥",
      "transliteration": "kahi kahi kahanaa aakh sunaae ||",
      "translation": "By merely speaking, talking, shouting and preaching about the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੇ ਸਉ ਘਾਲੇ ਥਾਇ ਨ ਪਾਏ ॥੩॥",
      "transliteration": "je sau ghaale thaai na paae ||3||",
      "translation": "Even hundreds of times, the mortal is not approved. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਨੑ ਕੈ ਪੋਤੈ ਪੁੰਨੁ ਤਿਨੑਾ ਗੁਰੂ ਮਿਲਾਏ ॥",
      "transliteration": "jinh kai potai pu(n)n tinhaa guroo milaae ||",
      "translation": "The Guru meets with those, who take virtue as their treasure;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਚੁ ਬਾਣੀ ਗੁਰੁ ਸਬਦੁ ਸੁਣਾਏ ॥",
      "transliteration": "sach baanee gur sabad sunaae ||",
      "translation": "they listen to the True Word of the Guru's Bani, the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਹਾਂ ਸਬਦੁ ਵਸੈ ਤਹਾਂ ਦੁਖੁ ਜਾਏ ॥",
      "transliteration": "jahaa(n) sabad vasai tahaa(n) dukh jaae ||",
      "translation": "Pain departs, from that place where the Shabad abides.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗਿਆਨਿ ਰਤਨਿ ਸਾਚੈ ਸਹਜਿ ਸਮਾਏ ॥੪॥",
      "transliteration": "giaan ratan saachai sahaj samaae ||4||",
      "translation": "By the jewel of spiritual wisdom, one is easily absorbed into the True Lord. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਵੈ ਜੇਵਡੁ ਹੋਰੁ ਧਨੁ ਨਾਹੀ ਕੋਇ ॥",
      "transliteration": "naavai jevad hor dhan naahee koi ||",
      "translation": "No other wealth is as great as the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਸ ਨੋ ਬਖਸੇ ਸਾਚਾ ਸੋਇ ॥",
      "transliteration": "jis no bakhase saachaa soi ||",
      "translation": "It is bestowed only by the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪੂਰੈ ਸਬਦਿ ਮੰਨਿ ਵਸਾਏ ॥",
      "transliteration": "poorai sabad ma(n)n vasaae ||",
      "translation": "Through the Perfect Word of the Shabad, it abides in the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ ਸੁਖੁ ਪਾਏ ॥੫॥੧੧॥੫੦॥",
      "transliteration": "naanak naam rate sukh paae ||5||11||50||",
      "translation": "O Nanak, imbued with the Naam, peace is obtained. ||5||11||50||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੩ ॥",
      "transliteration": "aasaa mahalaa 3 ||",
      "translation": "Aasaa, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਿਰਤਿ ਕਰੇ ਬਹੁ ਵਾਜੇ ਵਜਾਏ ॥",
      "transliteration": "nirat kare bahu vaaje vajaae ||",
      "translation": "One may dance and play numerous instruments;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਅੰਧਾ ਬੋਲਾ ਹੈ ਕਿਸੁ ਆਖਿ ਸੁਣਾਏ ॥",
      "transliteration": "ihu man a(n)dhaa bolaa hai kis aakh sunaae ||",
      "translation": "but this mind is blind and deaf, so for whose benefit is this speaking and preaching?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅੰਤਰਿ ਲੋਭੁ ਭਰਮੁ ਅਨਲ ਵਾਉ ॥",
      "transliteration": "a(n)tar lobh bharam anal vaau ||",
      "translation": "Deep within is the fire of greed, and the dust-storm of doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦੀਵਾ ਬਲੈ ਨ ਸੋਝੀ ਪਾਇ ॥੧॥",
      "transliteration": "deevaa balai na sojhee paai ||1||",
      "translation": "The lamp of knowledge is not burning, and understanding is not obtained. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਭਗਤਿ ਘਟਿ ਚਾਨਣੁ ਹੋਇ ॥",
      "transliteration": "guramukh bhagat ghat chaanan hoi ||",
      "translation": "The Gurmukh has the light of devotional worship within his heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਪੁ ਪਛਾਣਿ ਮਿਲੈ ਪ੍ਰਭੁ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aap pachhaan milai prabh soi ||1|| rahaau ||",
      "translation": "Understanding his own self, he meets God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਿਰਤਿ ਹਰਿ ਲਾਗੈ ਭਾਉ ॥",
      "transliteration": "guramukh nirat har laagai bhaau ||",
      "translation": "The Gurmukh's dance is to embrace love for the Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪੂਰੇ ਤਾਲ ਵਿਚਹੁ ਆਪੁ ਗਵਾਇ ॥",
      "transliteration": "poore taal vichahu aap gavaai ||",
      "translation": "to the beat of the drum, he sheds his ego from within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮੇਰਾ ਪ੍ਰਭੁ ਸਾਚਾ ਆਪੇ ਜਾਣੁ ॥",
      "transliteration": "meraa prabh saachaa aape jaan ||",
      "translation": "My God is True; He Himself is the Knower of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਅੰਤਰਿ ਬ੍ਰਹਮੁ ਪਛਾਣੁ ॥੨॥",
      "transliteration": "gur kai sabad a(n)tar braham pachhaan ||2||",
      "translation": "Through the Word of the Guru's Shabad, recognize the Creator Lord within yourself. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਭਗਤਿ ਅੰਤਰਿ ਪ੍ਰੀਤਿ ਪਿਆਰੁ ॥",
      "transliteration": "guramukh bhagat a(n)tar preet piaar ||",
      "translation": "The Gurmukh is filled with devotional love for the Beloved Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਸਹਜਿ ਵੀਚਾਰੁ ॥",
      "transliteration": "gur kaa sabad sahaj veechaar ||",
      "translation": "He intuitively reflects upon the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਭਗਤਿ ਜੁਗਤਿ ਸਚੁ ਸੋਇ ॥",
      "transliteration": "guramukh bhagat jugat sach soi ||",
      "translation": "For the Gurmukh, loving devotional worship is the way to the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0364_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪਾਖੰਡਿ ਭਗਤਿ ਨਿਰਤਿ ਦੁਖੁ ਹੋਇ ॥੩॥",
      "transliteration": "paakha(n)d bhagat nirat dukh hoi ||3||",
      "translation": "But the dances and the worship of the hypocrites bring only pain. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 364,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
