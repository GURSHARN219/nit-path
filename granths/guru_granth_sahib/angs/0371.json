{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 371,
  "lineCount": 53,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0371_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਜਿ ਕਾਜਿ ਪਰਥਾਇ ਸੁਹਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaj kaaj parathaai suhaaee ||1|| rahaau ||",
      "translation": "In worship, marriage and in the next world, such a soul-bride looks beautiful. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਚਰੁ ਵਸੀ ਪਿਤਾ ਕੈ ਸਾਥਿ ॥",
      "transliteration": "jichar vasee pitaa kai saath ||",
      "translation": "As long as she lived with her father,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਿਚਰੁ ਕੰਤੁ ਬਹੁ ਫਿਰੈ ਉਦਾਸਿ ॥",
      "transliteration": "tichar ka(n)t bahu phirai udaas ||",
      "translation": "her Husband wandered around in sadness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਰਿ ਸੇਵਾ ਸਤ ਪੁਰਖੁ ਮਨਾਇਆ ॥",
      "transliteration": "kar sevaa sat purakh manaaiaa ||",
      "translation": "I served and surrendered to the Lord, the True Being;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਰਿ ਆਣੀ ਘਰ ਮਹਿ ਤਾ ਸਰਬ ਸੁਖ ਪਾਇਆ ॥੨॥",
      "transliteration": "gur aanee ghar mahi taa sarab sukh paaiaa ||2||",
      "translation": "the Guru brought my bride to my home, and I obtained total happiness. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਤੀਹ ਸੁਲਖਣੀ ਸਚੁ ਸੰਤਤਿ ਪੂਤ ॥",
      "transliteration": "bateeh sulakhanee sach sa(n)tat poot ||",
      "translation": "She is blessed with all sublime attributes,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਗਿਆਕਾਰੀ ਸੁਘੜ ਸਰੂਪ ॥",
      "transliteration": "aagiaakaaree sughaR saroop ||",
      "translation": "And her generations are unblemished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਇਛ ਪੂਰੇ ਮਨ ਕੰਤ ਸੁਆਮੀ ॥",
      "transliteration": "ichh poore man ka(n)t suaamee ||",
      "translation": "Her Husband, her Lord and Master, fulfills her heart's desires.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਗਲ ਸੰਤੋਖੀ ਦੇਰ ਜੇਠਾਨੀ ॥੩॥",
      "transliteration": "sagal sa(n)tokhee der jethaanee ||3||",
      "translation": "Hope and desire (my younger brother-in-law and sister-in-law) are now totally content. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਭ ਪਰਵਾਰੈ ਮਾਹਿ ਸਰੇਸਟ ॥",
      "transliteration": "sabh paravaarai maahi saresat ||",
      "translation": "She is the most noble of all the family.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਤੀ ਦੇਵੀ ਦੇਵਰ ਜੇਸਟ ॥",
      "transliteration": "matee devee devar jesat ||",
      "translation": "She counsels and advises her hope and desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਧੰਨੁ ਸੁ ਗ੍ਰਿਹੁ ਜਿਤੁ ਪ੍ਰਗਟੀ ਆਇ ॥",
      "transliteration": "dha(n)n s grihu jit pragatee aai ||",
      "translation": "How blessed is that household, in which she has appeared.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਸੁਖੇ ਸੁਖਿ ਵਿਹਾਇ ॥੪॥੩॥",
      "transliteration": "jan naanak sukhe sukh vihaai ||4||3||",
      "translation": "O servant Nanak, she passes her time in perfect peace and comfort. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਤਾ ਕਰਉ ਸੋ ਪਕਨਿ ਨ ਦੇਈ ॥",
      "transliteration": "mataa karau so pakan na deee ||",
      "translation": "Whatever I resolve, she does not allow it to come to pass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੀਲ ਸੰਜਮ ਕੈ ਨਿਕਟਿ ਖਲੋਈ ॥",
      "transliteration": "seel sa(n)jam kai nikat khaloee ||",
      "translation": "She stands blocking the way of goodness and self-discipline.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਵੇਸ ਕਰੇ ਬਹੁ ਰੂਪ ਦਿਖਾਵੈ ॥",
      "transliteration": "ves kare bahu roop dikhaavai ||",
      "translation": "She wears many disguises, and assumes many forms,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗ੍ਰਿਹਿ ਬਸਨਿ ਨ ਦੇਈ ਵਖਿ ਵਖਿ ਭਰਮਾਵੈ ॥੧॥",
      "transliteration": "grihi basan na deee vakh vakh bharamaavai ||1||",
      "translation": "and she does not allow me to dwell in my own home. She forces me to wander around in different directions. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਘਰ ਕੀ ਨਾਇਕਿ ਘਰ ਵਾਸੁ ਨ ਦੇਵੈ ॥",
      "transliteration": "ghar kee naaik ghar vaas na devai ||",
      "translation": "She has become the mistress of my home, and she does not allow me to live in it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਤਨ ਕਰਉ ਉਰਝਾਇ ਪਰੇਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jatan karau urajhaai parevai ||1|| rahaau ||",
      "translation": "If I try, she fights with me. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਧੁਰ ਕੀ ਭੇਜੀ ਆਈ ਆਮਰਿ ॥",
      "transliteration": "dhur kee bhejee aaee aamar ||",
      "translation": "In the beginning, she was sent as a helper,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਉ ਖੰਡ ਜੀਤੇ ਸਭਿ ਥਾਨ ਥਨੰਤਰ ॥",
      "transliteration": "nau kha(n)d jeete sabh thaan thana(n)tar ||",
      "translation": "but she has overwhelmed the nine continents, all places and interspaces.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਟਿ ਤੀਰਥਿ ਨ ਛੋਡੈ ਜੋਗ ਸੰਨਿਆਸ ॥",
      "transliteration": "tat teerath na chhodai jog sa(n)niaas ||",
      "translation": "She has not spared even the river banks, the sacred shrines of pilgrimage, the Yogis and Sannyaasees,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪੜਿ ਥਾਕੇ ਸਿੰਮ੍ਰਿਤਿ ਬੇਦ ਅਭਿਆਸ ॥੨॥",
      "transliteration": "paR thaake si(n)mrit bed abhiaas ||2||",
      "translation": "or those who tirelessly read the Simritees and study the Vedas. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਹ ਬੈਸਉ ਤਹ ਨਾਲੇ ਬੈਸੈ ॥",
      "transliteration": "jah baisau tah naale baisai ||",
      "translation": "Wherever I sit, she sits there with me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਗਲ ਭਵਨ ਮਹਿ ਸਬਲ ਪ੍ਰਵੇਸੈ ॥",
      "transliteration": "sagal bhavan mahi sabal pravesai ||",
      "translation": "She has imposed her power upon the whole world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੋਛੀ ਸਰਣਿ ਪਇਆ ਰਹਣੁ ਨ ਪਾਈ ॥",
      "transliteration": "hochhee saran paiaa rahan na paaee ||",
      "translation": "Seeking meager protection, I am not protected from her.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਹੁ ਮੀਤਾ ਹਉ ਕੈ ਪਹਿ ਜਾਈ ॥੩॥",
      "transliteration": "kahu meetaa hau kai pahi jaaee ||3||",
      "translation": "Tell me, O my friend: unto whom should I turn for protection? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੁਣਿ ਉਪਦੇਸੁ ਸਤਿਗੁਰ ਪਹਿ ਆਇਆ ॥",
      "transliteration": "sun upades satigur pahi aaiaa ||",
      "translation": "I heard of His Teachings, and so I have come to the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗੁਰਿ ਹਰਿ ਹਰਿ ਨਾਮੁ ਮੋਹਿ ਮੰਤ੍ਰੁ ਦ੍ਰਿੜਾਇਆ ॥",
      "transliteration": "gur har har naam mohi ma(n)tr driRaaiaa ||",
      "translation": "The Guru has implanted the Mantra of the Lord's Name, Har, Har, within me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਿਜ ਘਰਿ ਵਸਿਆ ਗੁਣ ਗਾਇ ਅਨੰਤਾ ॥",
      "transliteration": "nij ghar vasiaa gun gaai ana(n)taa ||",
      "translation": "And now, I dwell in the home of my own inner self; I sing the Glorious Praises of the Infinite Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪ੍ਰਭੁ ਮਿਲਿਓ ਨਾਨਕ ਭਏ ਅਚਿੰਤਾ ॥੪॥",
      "transliteration": "prabh milio naanak bhae achi(n)taa ||4||",
      "translation": "I have met God, O Nanak, and I have become care-free. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਘਰੁ ਮੇਰਾ ਇਹ ਨਾਇਕਿ ਹਮਾਰੀ ॥",
      "transliteration": "ghar meraa ih naaik hamaaree ||",
      "translation": "My home is now my own, and she is now my mistress.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਹ ਆਮਰਿ ਹਮ ਗੁਰਿ ਕੀਏ ਦਰਬਾਰੀ ॥੧॥ ਰਹਾਉ ਦੂਜਾ ॥੪॥੪॥",
      "transliteration": "ih aamar ham gur keee darabaaree ||1|| rahaau doojaa ||4||4||",
      "translation": "She is now my servant, and the Guru has made me intimate with the Lord. ||1||Second Pause||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰਥਮੇ ਮਤਾ ਜਿ ਪਤ੍ਰੀ ਚਲਾਵਉ ॥",
      "transliteration": "prathame mataa j patree chalaavau ||",
      "translation": "First, they advised me to send a letter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੁਤੀਏ ਮਤਾ ਦੁਇ ਮਾਨੁਖ ਪਹੁਚਾਵਉ ॥",
      "transliteration": "duteee mataa dui maanukh pahuchaavau ||",
      "translation": "Second, they advised me to send two men.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤ੍ਰਿਤੀਏ ਮਤਾ ਕਿਛੁ ਕਰਉ ਉਪਾਇਆ ॥",
      "transliteration": "triteee mataa kichh karau upaaiaa ||",
      "translation": "Third, they advised me to make the effort and do something.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੈ ਸਭੁ ਕਿਛੁ ਛੋਡਿ ਪ੍ਰਭ ਤੁਹੀ ਧਿਆਇਆ ॥੧॥",
      "transliteration": "mai sabh kichh chhod prabh tuhee dhiaaiaa ||1||",
      "translation": "But I have renounced everything, and I meditate only on You, God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਹਾ ਅਨੰਦ ਅਚਿੰਤ ਸਹਜਾਇਆ ॥",
      "transliteration": "mahaa ana(n)d achi(n)t sahajaaiaa ||",
      "translation": "Now, I am totally blissful, carefree and at ease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੁਸਮਨ ਦੂਤ ਮੁਏ ਸੁਖੁ ਪਾਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dusaman doot mue sukh paaiaa ||1|| rahaau ||",
      "translation": "The enemies and evil-doers have perished, and I have obtained peace. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਮੋ ਕਉ ਦੀਆ ਉਪਦੇਸੁ ॥",
      "transliteration": "satigur mo kau deeaa upades ||",
      "translation": "The True Guru has imparted the Teachings to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਸਭੁ ਹਰਿ ਕਾ ਦੇਸੁ ॥",
      "transliteration": "jeeu pi(n)d sabh har kaa des ||",
      "translation": "My soul, body and everything belong to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕਰੀ ਸੁ ਤੇਰਾ ਤਾਣੁ ॥",
      "transliteration": "jo kichh karee s teraa taan ||",
      "translation": "Whatever I do, is by Your Almighty Power.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤੂੰ ਮੇਰੀ ਓਟ ਤੂੰਹੈ ਦੀਬਾਣੁ ॥੨॥",
      "transliteration": "too(n) meree ot too(n)hai deebaan ||2||",
      "translation": "You are my only Support, You are my only Court. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤੁਧਨੋ ਛੋਡਿ ਜਾਈਐ ਪ੍ਰਭ ਕੈਂ ਧਰਿ ॥",
      "transliteration": "tudhano chhod jaaeeai prabh kai(n) dhar ||",
      "translation": "If I were to renounce You, God, unto whom could I turn?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਨ ਨ ਬੀਆ ਤੇਰੀ ਸਮਸਰਿ ॥",
      "transliteration": "aan na beeaa teree samasar ||",
      "translation": "There is no other, comparable to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤੇਰੇ ਸੇਵਕ ਕਉ ਕਿਸ ਕੀ ਕਾਣਿ ॥",
      "transliteration": "tere sevak kau kis kee kaan ||",
      "translation": "Who else is Your servant to serve?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਾਕਤੁ ਭੂਲਾ ਫਿਰੈ ਬੇਬਾਣਿ ॥੩॥",
      "transliteration": "saakat bhoolaa phirai bebaan ||3||",
      "translation": "The faithless cynics are deluded; they wander around in the wilderness. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤੇਰੀ ਵਡਿਆਈ ਕਹੀ ਨ ਜਾਇ ॥",
      "transliteration": "teree vadiaaee kahee na jaai ||",
      "translation": "Your Glorious Greatness cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਹ ਕਹ ਰਾਖਿ ਲੈਹਿ ਗਲਿ ਲਾਇ ॥",
      "transliteration": "jah kah raakh laihi gal laai ||",
      "translation": "Wherever I am, you save me, hugging me close in Your embrace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਤੇਰੀ ਸਰਣਾਈ ॥",
      "transliteration": "naanak daas teree saranaaee ||",
      "translation": "Nanak, Your slave, has entered Your Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0371_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਪ੍ਰਭਿ ਰਾਖੀ ਪੈਜ ਵਜੀ ਵਾਧਾਈ ॥੪॥੫॥",
      "transliteration": "prabh raakhee paij vajee vaadhaaee ||4||5||",
      "translation": "God has preserved his honor, and congratulations are pouring in. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 371,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
