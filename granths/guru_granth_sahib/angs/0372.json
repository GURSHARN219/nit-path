{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 372,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0372_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪਰਦੇਸੁ ਝਾਗਿ ਸਉਦੇ ਕਉ ਆਇਆ ॥",
      "transliteration": "parades jhaag saude kau aaiaa ||",
      "translation": "Having wandered through foreign lands, I have come here to do business.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਵਸਤੁ ਅਨੂਪ ਸੁਣੀ ਲਾਭਾਇਆ ॥",
      "transliteration": "vasat anoop sunee laabhaaiaa ||",
      "translation": "I heard of the incomparable and profitable merchandise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਣ ਰਾਸਿ ਬੰਨੑਿ ਪਲੈ ਆਨੀ ॥",
      "transliteration": "gun raas ba(n)nhi palai aanee ||",
      "translation": "I have gathered in my pockets my capital of virtue, and I have brought it here with me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੇਖਿ ਰਤਨੁ ਇਹੁ ਮਨੁ ਲਪਟਾਨੀ ॥੧॥",
      "transliteration": "dekh ratan ihu man lapataanee ||1||",
      "translation": "Beholding the jewel, this mind is fascinated. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਾਹ ਵਾਪਾਰੀ ਦੁਆਰੈ ਆਏ ॥",
      "transliteration": "saah vaapaaree duaarai aae ||",
      "translation": "I have come to the door of the Trader.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਵਖਰੁ ਕਾਢਹੁ ਸਉਦਾ ਕਰਾਏ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "vakhar kaadhahu saudaa karaae ||1|| rahaau ||",
      "translation": "Please display the merchandise, so that the business may be transacted. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਾਹਿ ਪਠਾਇਆ ਸਾਹੈ ਪਾਸਿ ॥",
      "transliteration": "saahi pathaaiaa saahai paas ||",
      "translation": "The Trader has sent me to the Banker.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਮੋਲ ਰਤਨ ਅਮੋਲਾ ਰਾਸਿ ॥",
      "transliteration": "amol ratan amolaa raas ||",
      "translation": "The jewel is priceless, and the capital is priceless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਵਿਸਟੁ ਸੁਭਾਈ ਪਾਇਆ ਮੀਤ ॥",
      "transliteration": "visat subhaaee paaiaa meet ||",
      "translation": "O my gentle brother, mediator and friend",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਉਦਾ ਮਿਲਿਆ ਨਿਹਚਲ ਚੀਤ ॥੨॥",
      "transliteration": "saudaa miliaa nihachal cheet ||2||",
      "translation": "- I have obtained the merchandise, and my consciousness is now steady and stable. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਉ ਨਹੀ ਤਸਕਰ ਪਉਣ ਨ ਪਾਨੀ ॥",
      "transliteration": "bhau nahee tasakar paun na paanee ||",
      "translation": "I have no fear of thieves, of wind or water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਹਜਿ ਵਿਹਾਝੀ ਸਹਜਿ ਲੈ ਜਾਨੀ ॥",
      "transliteration": "sahaj vihaajhee sahaj lai jaanee ||",
      "translation": "I have easily made my purchase, and I easily take it away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਤ ਕੈ ਖਟਿਐ ਦੁਖੁ ਨਹੀ ਪਾਇਆ ॥",
      "transliteration": "sat kai khatiai dukh nahee paaiaa ||",
      "translation": "I have earned Truth, and I shall have no pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਹੀ ਸਲਾਮਤਿ ਘਰਿ ਲੈ ਆਇਆ ॥੩॥",
      "transliteration": "sahee salaamat ghar lai aaiaa ||3||",
      "translation": "I have brought this merchandise home, safe and sound. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਿਲਿਆ ਲਾਹਾ ਭਏ ਅਨੰਦ ॥",
      "transliteration": "miliaa laahaa bhae ana(n)d ||",
      "translation": "I have earned the profit, and I am happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਧੰਨੁ ਸਾਹ ਪੂਰੇ ਬਖਸਿੰਦ ॥",
      "transliteration": "dha(n)n saah poore bakhasi(n)d ||",
      "translation": "Blessed is the Banker, the Perfect Bestower.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਹੁ ਸਉਦਾ ਗੁਰਮੁਖਿ ਕਿਨੈ ਵਿਰਲੈ ਪਾਇਆ ॥",
      "transliteration": "ihu saudaa guramukh kinai viralai paaiaa ||",
      "translation": "How rare is the Gurmukh who obtains this merchandise;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਹਲੀ ਖੇਪ ਨਾਨਕੁ ਲੈ ਆਇਆ ॥੪॥੬॥",
      "transliteration": "sahalee khep naanak lai aaiaa ||4||6||",
      "translation": "Nanak has brought this profitable merchandise home. ||4||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਨੁ ਅਵਗਨੁ ਮੇਰੋ ਕਛੁ ਨ ਬੀਚਾਰੋ ॥",
      "transliteration": "gun avagan mero kachh na beechaaro ||",
      "translation": "He does not consider my merits or demerits.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਹ ਦੇਖਿਓ ਰੂਪ ਰੰਗ ਸਂੀਗਾਰੋ ॥",
      "transliteration": "nah dekhio roop ra(n)g sa(n)eegaaro ||",
      "translation": "He does not look at my beauty, color or decorations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਜ ਅਚਾਰ ਕਿਛੁ ਬਿਧਿ ਨਹੀ ਜਾਨੀ ॥",
      "transliteration": "chaj achaar kichh bidh nahee jaanee ||",
      "translation": "I do not know the ways of wisdom and good conduct.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਾਹ ਪਕਰਿ ਪ੍ਰਿਅ ਸੇਜੈ ਆਨੀ ॥੧॥",
      "transliteration": "baah pakar pri sejai aanee ||1||",
      "translation": "But taking me by the arm, my Husband Lord has led me to His Bed. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁਨਿਬੋ ਸਖੀ ਕੰਤਿ ਹਮਾਰੋ ਕੀਅਲੋ ਖਸਮਾਨਾ ॥",
      "transliteration": "sunibo sakhee ka(n)t hamaaro keealo khasamaanaa ||",
      "translation": "Hear, O my companions, my Husband, my Lord Master, possesses me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਰੁ ਮਸਤਕਿ ਧਾਰਿ ਰਾਖਿਓ ਕਰਿ ਅਪੁਨਾ ਕਿਆ ਜਾਨੈ ਇਹੁ ਲੋਕੁ ਅਜਾਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar masatak dhaar raakhio kar apunaa kiaa jaanai ihu lok ajaanaa ||1|| rahaau ||",
      "translation": "Placing His Hand upon my forehead, He protects me as His Own. What do these ignorant people know? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੁਹਾਗੁ ਹਮਾਰੋ ਅਬ ਹੁਣਿ ਸੋਹਿਓ ॥",
      "transliteration": "suhaag hamaaro ab hun sohio ||",
      "translation": "My married life now appears so beauteous;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕੰਤੁ ਮਿਲਿਓ ਮੇਰੋ ਸਭੁ ਦੁਖੁ ਜੋਹਿਓ ॥",
      "transliteration": "ka(n)t milio mero sabh dukh johio ||",
      "translation": "my Husband Lord has met me, and He sees all my pains.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਂਗਨਿ ਮੇਰੈ ਸੋਭਾ ਚੰਦ ॥",
      "transliteration": "aa(n)gan merai sobhaa cha(n)d ||",
      "translation": "Within the courtyard of my heart, the glory of the moon shines.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਿਸਿ ਬਾਸੁਰ ਪ੍ਰਿਅ ਸੰਗਿ ਅਨੰਦ ॥੨॥",
      "transliteration": "nis baasur pri sa(n)g ana(n)d ||2||",
      "translation": "Night and day, I have fun with my Beloved. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਸਤ੍ਰ ਹਮਾਰੇ ਰੰਗਿ ਚਲੂਲ ॥",
      "transliteration": "basatr hamaare ra(n)g chalool ||",
      "translation": "My clothes are dyed the deep crimson color of the poppy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਗਲ ਆਭਰਣ ਸੋਭਾ ਕੰਠਿ ਫੂਲ ॥",
      "transliteration": "sagal aabharan sobhaa ka(n)th phool ||",
      "translation": "All the ornaments and garlands around my neck adorn me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪ੍ਰਿਅ ਪੇਖੀ ਦ੍ਰਿਸਟਿ ਪਾਏ ਸਗਲ ਨਿਧਾਨ ॥",
      "transliteration": "pri pekhee drisat paae sagal nidhaan ||",
      "translation": "Gazing upon my Beloved with my eyes, I have obtained all treasures;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੁਸਟ ਦੂਤ ਕੀ ਚੂਕੀ ਕਾਨਿ ॥੩॥",
      "transliteration": "dusat doot kee chookee kaan ||3||",
      "translation": "I have shaken off the power of the evil demons. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਦ ਖੁਸੀਆ ਸਦਾ ਰੰਗ ਮਾਣੇ ॥",
      "transliteration": "sad khuseeaa sadaa ra(n)g maane ||",
      "translation": "I have obtained eternal bliss, and I constantly celebrate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਉ ਨਿਧਿ ਨਾਮੁ ਗ੍ਰਿਹ ਮਹਿ ਤ੍ਰਿਪਤਾਨੇ ॥",
      "transliteration": "nau nidh naam grih mahi tripataane ||",
      "translation": "With the nine treasures of the Naam, the Name of the Lord, I am satisfied in my own home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਉ ਪਿਰਹਿ ਸੀਗਾਰੀ ॥",
      "transliteration": "kahu naanak jau pirahi seegaaree ||",
      "translation": "Says Nanak, when the happy soul-bride is adorned by her Beloved,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਥਿਰੁ ਸੋਹਾਗਨਿ ਸੰਗਿ ਭਤਾਰੀ ॥੪॥੭॥",
      "transliteration": "thir sohaagan sa(n)g bhataaree ||4||7||",
      "translation": "she is forever happy with her Husband Lord. ||4||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦਾਨੁ ਦੇਇ ਕਰਿ ਪੂਜਾ ਕਰਨਾ ॥",
      "transliteration": "daan dei kar poojaa karanaa ||",
      "translation": "They give you donations and worship you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਲੈਤ ਦੇਤ ਉਨੑ ਮੂਕਰਿ ਪਰਨਾ ॥",
      "transliteration": "lait det unh mookar paranaa ||",
      "translation": "You take from them, and then deny that they have given anything to you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਤੁ ਦਰਿ ਤੁਮੑ ਹੈ ਬ੍ਰਾਹਮਣ ਜਾਣਾ ॥",
      "transliteration": "jit dar tumh hai braahaman jaanaa ||",
      "translation": "That door, through which you must ultimately go, O Brahmin",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਿਤੁ ਦਰਿ ਤੂੰਹੀ ਹੈ ਪਛੁਤਾਣਾ ॥੧॥",
      "transliteration": "tit dar too(n)hee hai pachhutaanaa ||1||",
      "translation": "- at that door, you will come to regret and repent. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਐਸੇ ਬ੍ਰਾਹਮਣ ਡੂਬੇ ਭਾਈ ॥",
      "transliteration": "aise braahaman doobe bhaaee ||",
      "translation": "Such Brahmins shall drown, O Siblings of Destiny;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਿਰਾਪਰਾਧ ਚਿਤਵਹਿ ਬੁਰਿਆਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "niraaparaadh chitavahi buriaaee ||1|| rahaau ||",
      "translation": "they think of doing evil to the innocent. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅੰਤਰਿ ਲੋਭੁ ਫਿਰਹਿ ਹਲਕਾਏ ॥",
      "transliteration": "a(n)tar lobh phirahi halakaae ||",
      "translation": "Within them is greed, and they wander around like mad dogs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਿੰਦਾ ਕਰਹਿ ਸਿਰਿ ਭਾਰੁ ਉਠਾਏ ॥",
      "transliteration": "ni(n)daa karahi sir bhaar uthaae ||",
      "translation": "They slander others and carry loads of sin upon their heads.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਾਇਆ ਮੂਠਾ ਚੇਤੈ ਨਾਹੀ ॥",
      "transliteration": "maaiaa moothaa chetai naahee ||",
      "translation": "Intoxicated by Maya, they do not think of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਭਰਮੇ ਭੂਲਾ ਬਹੁਤੀ ਰਾਹੀ ॥੨॥",
      "transliteration": "bharame bhoolaa bahutee raahee ||2||",
      "translation": "Deluded by doubt, they wander off on many paths. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬਾਹਰਿ ਭੇਖ ਕਰਹਿ ਘਨੇਰੇ ॥",
      "transliteration": "baahar bhekh karahi ghanere ||",
      "translation": "Outwardly, they wear various religious robes,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅੰਤਰਿ ਬਿਖਿਆ ਉਤਰੀ ਘੇਰੇ ॥",
      "transliteration": "a(n)tar bikhiaa utaree ghere ||",
      "translation": "but within, they are enveloped by poison.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਵਰ ਉਪਦੇਸੈ ਆਪਿ ਨ ਬੂਝੈ ॥",
      "transliteration": "avar upadesai aap na boojhai ||",
      "translation": "They instruct others, but do not understand themselves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਐਸਾ ਬ੍ਰਾਹਮਣੁ ਕਹੀ ਨ ਸੀਝੈ ॥੩॥",
      "transliteration": "aisaa braahaman kahee na seejhai ||3||",
      "translation": "Such Brahmins will never be emancipated. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮੂਰਖ ਬਾਮਣ ਪ੍ਰਭੂ ਸਮਾਲਿ ॥",
      "transliteration": "moorakh baaman prabhoo samaal ||",
      "translation": "O foolish Brahmin, reflect upon God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਦੇਖਤ ਸੁਨਤ ਤੇਰੈ ਹੈ ਨਾਲਿ ॥",
      "transliteration": "dekhat sunat terai hai naal ||",
      "translation": "He watches and hears, and is always with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜੇ ਹੋਵੀ ਭਾਗੁ ॥",
      "transliteration": "kahu naanak je hovee bhaag ||",
      "translation": "Says Nanak, if this is your destiny,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮਾਨੁ ਛੋਡਿ ਗੁਰ ਚਰਣੀ ਲਾਗੁ ॥੪॥੮॥",
      "transliteration": "maan chhod gur charanee laag ||4||8||",
      "translation": "renounce your pride, and grasp the Guru's Feet. ||4||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0372_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 372,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
