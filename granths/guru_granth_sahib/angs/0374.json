{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 374,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0374_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪ੍ਰਥਮੇ ਤੇਰੀ ਨੀਕੀ ਜਾਤਿ ॥",
      "transliteration": "prathame teree neekee jaat ||",
      "translation": "First, your social status is high.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੁਤੀਆ ਤੇਰੀ ਮਨੀਐ ਪਾਂਤਿ ॥",
      "transliteration": "duteeaa teree maneeai paa(n)t ||",
      "translation": "Second, you are honored in society.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤ੍ਰਿਤੀਆ ਤੇਰਾ ਸੁੰਦਰ ਥਾਨੁ ॥",
      "transliteration": "triteeaa teraa su(n)dar thaan ||",
      "translation": "Third, your home is beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਿਗੜ ਰੂਪੁ ਮਨ ਮਹਿ ਅਭਿਮਾਨੁ ॥੧॥",
      "transliteration": "bigaR roop man mahi abhimaan ||1||",
      "translation": "But you are so ugly, with self-conceit in your mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੋਹਨੀ ਸਰੂਪਿ ਸੁਜਾਣਿ ਬਿਚਖਨਿ ॥",
      "transliteration": "sohanee saroop sujaan bichakhan ||",
      "translation": "O beautiful, attractive, wise and clever woman:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਤਿ ਗਰਬੈ ਮੋਹਿ ਫਾਕੀ ਤੂੰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "at garabai mohi phaakee too(n) ||1|| rahaau ||",
      "translation": "you have been trapped by your pride and attachment. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਤਿ ਸੂਚੀ ਤੇਰੀ ਪਾਕਸਾਲ ॥",
      "transliteration": "at soochee teree paakasaal ||",
      "translation": "Your kitchen is so clean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਰਿ ਇਸਨਾਨੁ ਪੂਜਾ ਤਿਲਕੁ ਲਾਲ ॥",
      "transliteration": "kar isanaan poojaa tilak laal ||",
      "translation": "You take your bath, and worship, and apply the crimson mark upon your forehead;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਲੀ ਗਰਬਹਿ ਮੁਖਿ ਗੋਵਹਿ ਗਿਆਨ ॥",
      "transliteration": "galee garabahi mukh govahi giaan ||",
      "translation": "with your mouth you speak wisdom, but you are destroyed by pride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਭ ਬਿਧਿ ਖੋਈ ਲੋਭਿ ਸੁਆਨ ॥੨॥",
      "transliteration": "sabh bidh khoee lobh suaan ||2||",
      "translation": "The dog of greed has ruined you in every way. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਾਪਰ ਪਹਿਰਹਿ ਭੋਗਹਿ ਭੋਗ ॥",
      "transliteration": "kaapar pahirahi bhogahi bhog ||",
      "translation": "You wear your robes and enjoy pleasures;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਆਚਾਰ ਕਰਹਿ ਸੋਭਾ ਮਹਿ ਲੋਗ ॥",
      "transliteration": "aachaar karahi sobhaa mahi log ||",
      "translation": "you practice good conduct to impress people;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਚੋਆ ਚੰਦਨ ਸੁਗੰਧ ਬਿਸਥਾਰ ॥",
      "transliteration": "choaa cha(n)dan suga(n)dh bisathaar ||",
      "translation": "you apply scented oils of sandalwood and musk,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੰਗੀ ਖੋਟਾ ਕ੍ਰੋਧੁ ਚੰਡਾਲ ॥੩॥",
      "transliteration": "sa(n)gee khotaa krodh cha(n)daal ||3||",
      "translation": "but your constant companion is the demon of anger. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਵਰ ਜੋਨਿ ਤੇਰੀ ਪਨਿਹਾਰੀ ॥",
      "transliteration": "avar jon teree panihaaree ||",
      "translation": "Other people may be your water-carriers;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਇਸੁ ਧਰਤੀ ਮਹਿ ਤੇਰੀ ਸਿਕਦਾਰੀ ॥",
      "transliteration": "is dharatee mahi teree sikadaaree ||",
      "translation": "in this world, you may be a ruler.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੁਇਨਾ ਰੂਪਾ ਤੁਝ ਪਹਿ ਦਾਮ ॥",
      "transliteration": "suinaa roopaa tujh pahi daam ||",
      "translation": "Gold, silver and wealth may be yours,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੀਲੁ ਬਿਗਾਰਿਓ ਤੇਰਾ ਕਾਮ ॥੪॥",
      "transliteration": "seel bigaario teraa kaam ||4||",
      "translation": "but the goodness of your conduct has been destroyed by sexual promiscuity. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਾ ਕਉ ਦ੍ਰਿਸਟਿ ਮਇਆ ਹਰਿ ਰਾਇ ॥",
      "transliteration": "jaa kau drisat maiaa har raai ||",
      "translation": "That soul, upon whom the Lord has bestowed His Glance of Grace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾ ਬੰਦੀ ਤੇ ਲਈ ਛਡਾਇ ॥",
      "transliteration": "saa ba(n)dee te laee chhadaai ||",
      "translation": "is delivered from bondage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਮਿਲਿ ਹਰਿ ਰਸੁ ਪਾਇਆ ॥",
      "transliteration": "saadhasa(n)g mil har ras paaiaa ||",
      "translation": "Joining the Saadh Sangat, the Company of the Holy, the Lord's sublime essence is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਸਫਲ ਓਹ ਕਾਇਆ ॥੫॥",
      "transliteration": "kahu naanak saphal oh kaaiaa ||5||",
      "translation": "Says Nanak, how fruitful is that body. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਭਿ ਰੂਪ ਸਭਿ ਸੁਖ ਬਨੇ ਸੁਹਾਗਨਿ ॥",
      "transliteration": "sabh roop sabh sukh bane suhaagan ||",
      "translation": "All graces and all comforts shall come to you, as the happy soul-bride;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਤਿ ਸੁੰਦਰਿ ਬਿਚਖਨਿ ਤੂੰ ॥੧॥ ਰਹਾਉ ਦੂਜਾ ॥੧੨॥",
      "transliteration": "at su(n)dar bichakhan too(n) ||1|| rahaau doojaa ||12||",
      "translation": "you shall be supremely beautiful and wise. ||1||Second Pause||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ਇਕਤੁਕੇ ੨ ॥",
      "transliteration": "aasaa mahalaa 5 ikatuke 2 ||",
      "translation": "Aasaa, Fifth Mehl, Ek-Thukay 2 :",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੀਵਤ ਦੀਸੈ ਤਿਸੁ ਸਰਪਰ ਮਰਣਾ ॥",
      "transliteration": "jeevat deesai tis sarapar maranaa ||",
      "translation": "One who is seen to be alive, shall surely die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮੁਆ ਹੋਵੈ ਤਿਸੁ ਨਿਹਚਲੁ ਰਹਣਾ ॥੧॥",
      "transliteration": "muaa hovai tis nihachal rahanaa ||1||",
      "translation": "But he who is dead shall remain ever-lasting. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੀਵਤ ਮੁਏ ਮੁਏ ਸੇ ਜੀਵੇ ॥",
      "transliteration": "jeevat mue mue se jeeve ||",
      "translation": "Those who die while yet alive, shall through this death, live on.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਅਵਖਧੁ ਮੁਖਿ ਪਾਇਆ ਗੁਰਸਬਦੀ ਰਸੁ ਅੰਮ੍ਰਿਤੁ ਪੀਵੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har har naam avakhadh mukh paaiaa gurasabadee ras a(n)mrit peeve ||1|| rahaau ||",
      "translation": "They place the Name of the Lord, Har, Har, as medicine in their mouths, and through the Word of the Guru's Shabad, they drink in the Ambrosial Nectar. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਾਚੀ ਮਟੁਕੀ ਬਿਨਸਿ ਬਿਨਾਸਾ ॥",
      "transliteration": "kaachee matukee binas binaasaa ||",
      "translation": "The clay pot of the body shall be broken.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਸੁ ਛੂਟੈ ਤ੍ਰਿਕੁਟੀ ਤਿਸੁ ਨਿਜ ਘਰਿ ਵਾਸਾ ॥੨॥",
      "transliteration": "jis chhootai trikutee tis nij ghar vaasaa ||2||",
      "translation": "One who has eliminated the three qualities dwells in the home of his inner self. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਊਚਾ ਚੜੈ ਸੁ ਪਵੈ ਪਇਆਲਾ ॥",
      "transliteration": "oochaa chaRai s pavai paiaalaa ||",
      "translation": "One who climbs high, shall fall into the nether regions of the underworld.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਧਰਨਿ ਪੜੈ ਤਿਸੁ ਲਗੈ ਨ ਕਾਲਾ ॥੩॥",
      "transliteration": "dharan paRai tis lagai na kaalaa ||3||",
      "translation": "One who lies upon the ground, shall not be touched by death. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭ੍ਰਮਤ ਫਿਰੇ ਤਿਨ ਕਿਛੂ ਨ ਪਾਇਆ ॥",
      "transliteration": "bhramat phire tin kichhoo na paaiaa ||",
      "translation": "Those who continue to wander around, achieve nothing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੇ ਅਸਥਿਰ ਜਿਨ ਗੁਰਸਬਦੁ ਕਮਾਇਆ ॥੪॥",
      "transliteration": "se asathir jin gurasabad kamaaiaa ||4||",
      "translation": "Those who practice the Guru's Teachings, become steady and stable. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਸਭੁ ਹਰਿ ਕਾ ਮਾਲੁ ॥",
      "transliteration": "jeeu pi(n)d sabh har kaa maal ||",
      "translation": "This body and soul all belong to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕ ਗੁਰ ਮਿਲਿ ਭਏ ਨਿਹਾਲ ॥੫॥੧੩॥",
      "transliteration": "naanak gur mil bhae nihaal ||5||13||",
      "translation": "O Nanak, meeting the Guru, I am enraptured. ||5||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪੁਤਰੀ ਤੇਰੀ ਬਿਧਿ ਕਰਿ ਥਾਟੀ ॥",
      "transliteration": "putaree teree bidh kar thaatee ||",
      "translation": "The puppet of the body has been fashioned with great skill.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾਨੁ ਸਤਿ ਕਰਿ ਹੋਇਗੀ ਮਾਟੀ ॥੧॥",
      "transliteration": "jaan sat kar hoigee maatee ||1||",
      "translation": "Know for sure that it shall turn to dust. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮੂਲੁ ਸਮਾਲਹੁ ਅਚੇਤ ਗਵਾਰਾ ॥",
      "transliteration": "mool samaalahu achet gavaaraa ||",
      "translation": "Remember your origins, O thoughtless fool.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਤਨੇ ਕਉ ਤੁਮੑ ਕਿਆ ਗਰਬੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "itane kau tumh kiaa garabe ||1|| rahaau ||",
      "translation": "Why are you so proud of yourself? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੀਨਿ ਸੇਰ ਕਾ ਦਿਹਾੜੀ ਮਿਹਮਾਨੁ ॥",
      "transliteration": "teen ser kaa dihaaRee mihamaan ||",
      "translation": "You are a guest, given three meals a day;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਵਰ ਵਸਤੁ ਤੁਝ ਪਾਹਿ ਅਮਾਨ ॥੨॥",
      "transliteration": "avar vasat tujh paahi amaan ||2||",
      "translation": "other things are entrusted to you. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਸਟਾ ਅਸਤ ਰਕਤੁ ਪਰੇਟੇ ਚਾਮ ॥",
      "transliteration": "bisataa asat rakat parete chaam ||",
      "translation": "you are just excrement, bones and blood, wrapped up in skin",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਇਸੁ ਊਪਰਿ ਲੇ ਰਾਖਿਓ ਗੁਮਾਨ ॥੩॥",
      "transliteration": "is oopar le raakhio gumaan ||3||",
      "translation": "- this is what you are taking such pride in! ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਏਕ ਵਸਤੁ ਬੂਝਹਿ ਤਾ ਹੋਵਹਿ ਪਾਕ ॥",
      "transliteration": "ek vasat boojhahi taa hovahi paak ||",
      "translation": "If you could understand even one thing, then you would be pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਿਨੁ ਬੂਝੇ ਤੂੰ ਸਦਾ ਨਾਪਾਕ ॥੪॥",
      "transliteration": "bin boojhe too(n) sadaa naapaak ||4||",
      "translation": "Without understanding, you shall be forever impure. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰ ਕਉ ਕੁਰਬਾਨੁ ॥",
      "transliteration": "kahu naanak gur kau kurabaan ||",
      "translation": "Says Nanak, I am a sacrifice to the Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਸ ਤੇ ਪਾਈਐ ਹਰਿ ਪੁਰਖੁ ਸੁਜਾਨੁ ॥੫॥੧੪॥",
      "transliteration": "jis te paaeeai har purakh sujaan ||5||14||",
      "translation": "through Him, I obtain the Lord, the All-knowing Primal Being. ||5||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ਇਕਤੁਕੇ ਚਉਪਦੇ ॥",
      "transliteration": "aasaa mahalaa 5 ikatuke chaupade ||",
      "translation": "Aasaa, Fifth Mehl, Ek-Thukay, Chau-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਇਕ ਘੜੀ ਦਿਨਸੁ ਮੋ ਕਉ ਬਹੁਤੁ ਦਿਹਾਰੇ ॥",
      "transliteration": "ik ghaRee dinas mo kau bahut dihaare ||",
      "translation": "One moment, one day, is for me many days.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਨੁ ਨ ਰਹੈ ਕੈਸੇ ਮਿਲਉ ਪਿਆਰੇ ॥੧॥",
      "transliteration": "man na rahai kaise milau piaare ||1||",
      "translation": "My mind cannot survive - how can I meet my Beloved? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0374_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਇਕੁ ਪਲੁ ਦਿਨਸੁ ਮੋ ਕਉ ਕਬਹੁ ਨ ਬਿਹਾਵੈ ॥",
      "transliteration": "ik pal dinas mo kau kabahu na bihaavai ||",
      "translation": "I cannot endure one day, even one instant without Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 374,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
