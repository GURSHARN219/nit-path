{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 376,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0376_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਣ ਗਾਈਅਹਿ ਨੀਤ ॥",
      "transliteration": "kahu naanak gun gaaeeahi neet ||",
      "translation": "Says Nanak, sing continually the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮੁਖ ਊਜਲ ਹੋਇ ਨਿਰਮਲ ਚੀਤ ॥੪॥੧੯॥",
      "transliteration": "mukh oojal hoi niramal cheet ||4||19||",
      "translation": "Your face shall be radiant, and your consciousness shall be immaculately pure. ||4||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਉ ਨਿਧਿ ਤੇਰੈ ਸਗਲ ਨਿਧਾਨ ॥",
      "transliteration": "nau nidh terai sagal nidhaan ||",
      "translation": "The nine treasures are Yours - all treasures are Yours.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਛਾ ਪੂਰਕੁ ਰਖੈ ਨਿਦਾਨ ॥੧॥",
      "transliteration": "ichhaa poorak rakhai nidaan ||1||",
      "translation": "The Fulfiller of desires saves mortals in the end. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੂੰ ਮੇਰੋ ਪਿਆਰੋ ਤਾ ਕੈਸੀ ਭੂਖਾ ॥",
      "transliteration": "too(n) mero piaaro taa kaisee bhookhaa ||",
      "translation": "You are my Beloved, so what hunger can I have?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੂੰ ਮਨਿ ਵਸਿਆ ਲਗੈ ਨ ਦੂਖਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "too(n) man vasiaa lagai na dookhaa ||1|| rahaau ||",
      "translation": "When You dwell within my mind, pain does not touch me. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੋ ਤੂੰ ਕਰਹਿ ਸੋਈ ਪਰਵਾਣੁ ॥",
      "transliteration": "jo too(n) karahi soee paravaan ||",
      "translation": "Whatever You do, is acceptable to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਾਚੇ ਸਾਹਿਬ ਤੇਰਾ ਸਚੁ ਫੁਰਮਾਣੁ ॥੨॥",
      "transliteration": "saache saahib teraa sach phuramaan ||2||",
      "translation": "O True Lord and Master, True is Your Order. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾ ਤੁਧੁ ਭਾਵੈ ਤਾ ਹਰਿ ਗੁਣ ਗਾਉ ॥",
      "transliteration": "jaa tudh bhaavai taa har gun gaau ||",
      "translation": "When it is pleasing to Your Will, I sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੇਰੈ ਘਰਿ ਸਦਾ ਸਦਾ ਹੈ ਨਿਆਉ ॥੩॥",
      "transliteration": "terai ghar sadaa sadaa hai niaau ||3||",
      "translation": "Within Your Home, there is justice, forever and ever. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਾਚੇ ਸਾਹਿਬ ਅਲਖ ਅਭੇਵ ॥",
      "transliteration": "saache saahib alakh abhev ||",
      "translation": "O True Lord and Master, You are unknowable and mysterious.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਨਕ ਲਾਇਆ ਲਾਗਾ ਸੇਵ ॥੪॥੨੦॥",
      "transliteration": "naanak laaiaa laagaa sev ||4||20||",
      "translation": "Nanak is committed to Your service. ||4||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਿਕਟਿ ਜੀਅ ਕੈ ਸਦ ਹੀ ਸੰਗਾ ॥",
      "transliteration": "nikat jee kai sad hee sa(n)gaa ||",
      "translation": "He is near at hand; He is the eternal Companion of the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕੁਦਰਤਿ ਵਰਤੈ ਰੂਪ ਅਰੁ ਰੰਗਾ ॥੧॥",
      "transliteration": "kudarat varatai roop ar ra(n)gaa ||1||",
      "translation": "His Creative Power is all-pervading, in form and color. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਰ੍ਹੈ ਨ ਝੁਰੈ ਨਾ ਮਨੁ ਰੋਵਨਹਾਰਾ ॥",
      "transliteration": "karhai na jhurai naa man rovanahaaraa ||",
      "translation": "My mind does not worry; it does not grieve, or cry out.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਵਿਨਾਸੀ ਅਵਿਗਤੁ ਅਗੋਚਰੁ ਸਦਾ ਸਲਾਮਤਿ ਖਸਮੁ ਹਮਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "avinaasee avigat agochar sadaa salaamat khasam hamaaraa ||1|| rahaau ||",
      "translation": "Imperishable, Unshakable, Unapproachable and forever safe and sound is my Husband Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤੇਰੇ ਦਾਸਰੇ ਕਉ ਕਿਸ ਕੀ ਕਾਣਿ ॥",
      "transliteration": "tere daasare kau kis kee kaan ||",
      "translation": "Unto whom does Your servant pay homage?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਸ ਕੀ ਮੀਰਾ ਰਾਖੈ ਆਣਿ ॥੨॥",
      "transliteration": "jis kee meeraa raakhai aan ||2||",
      "translation": "His King preserves his honor. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੋ ਲਉਡਾ ਪ੍ਰਭਿ ਕੀਆ ਅਜਾਤਿ ॥",
      "transliteration": "jo laudaa prabh keeaa ajaat ||",
      "translation": "That slave, whom God has released from the restrictions of social status",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਿਸੁ ਲਉਡੇ ਕਉ ਕਿਸ ਕੀ ਤਾਤਿ ॥੩॥",
      "transliteration": "tis laude kau kis kee taat ||3||",
      "translation": "- who can now hold him in bondage? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਵੇਮੁਹਤਾਜਾ ਵੇਪਰਵਾਹੁ ॥",
      "transliteration": "vemuhataajaa veparavaahu ||",
      "translation": "The Lord is absolutely independent, and totally care-free;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਕਹਹੁ ਗੁਰ ਵਾਹੁ ॥੪॥੨੧॥",
      "transliteration": "naanak daas kahahu gur vaahu ||4||21||",
      "translation": "O servant Nanak, chant His Glorious Praises. ||4||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰਿ ਰਸੁ ਛੋਡਿ ਹੋਛੈ ਰਸਿ ਮਾਤਾ ॥",
      "transliteration": "har ras chhod hochhai ras maataa ||",
      "translation": "Forsaking the Lord's sublime essence, the mortal is intoxicated with false essences.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਘਰ ਮਹਿ ਵਸਤੁ ਬਾਹਰਿ ਉਠਿ ਜਾਤਾ ॥੧॥",
      "transliteration": "ghar mahi vasat baahar uth jaataa ||1||",
      "translation": "The substance is within the home of the self, but the mortal goes out to find it. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੁਨੀ ਨ ਜਾਈ ਸਚੁ ਅੰਮ੍ਰਿਤ ਕਾਥਾ ॥",
      "transliteration": "sunee na jaaee sach a(n)mrit kaathaa ||",
      "translation": "He cannot hear the true ambrosial discourse.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਾਰਿ ਕਰਤ ਝੂਠੀ ਲਗਿ ਗਾਥਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raar karat jhoothee lag gaathaa ||1|| rahaau ||",
      "translation": "Attached to false scriptures, he is engaged in argument. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਵਜਹੁ ਸਾਹਿਬ ਕਾ ਸੇਵ ਬਿਰਾਨੀ ॥",
      "transliteration": "vajahu saahib kaa sev biraanee ||",
      "translation": "He takes his wages from his Lord and Master, but he serves another.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਐਸੇ ਗੁਨਹ ਅਛਾਦਿਓ ਪ੍ਰਾਨੀ ॥੨॥",
      "transliteration": "aise gunah achhaadio praanee ||2||",
      "translation": "With such sins, the mortal is engrossed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਿਸੁ ਸਿਉ ਲੂਕ ਜੋ ਸਦ ਹੀ ਸੰਗੀ ॥",
      "transliteration": "tis siu look jo sad hee sa(n)gee ||",
      "translation": "He tries to hide from the One who is always with him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਾਮਿ ਨ ਆਵੈ ਸੋ ਫਿਰਿ ਫਿਰਿ ਮੰਗੀ ॥੩॥",
      "transliteration": "kaam na aavai so phir phir ma(n)gee ||3||",
      "translation": "He begs from Him, again and again. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਪ੍ਰਭ ਦੀਨ ਦਇਆਲਾ ॥",
      "transliteration": "kahu naanak prabh deen daiaalaa ||",
      "translation": "Says Nanak, God is merciful to the meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਉ ਭਾਵੈ ਤਿਉ ਕਰਿ ਪ੍ਰਤਿਪਾਲਾ ॥੪॥੨੨॥",
      "transliteration": "jiu bhaavai tiu kar pratipaalaa ||4||22||",
      "translation": "As it pleases Him, He cherishes us. ||4||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੀਅ ਪ੍ਰਾਨ ਧਨੁ ਹਰਿ ਕੋ ਨਾਮੁ ॥",
      "transliteration": "jee praan dhan har ko naam ||",
      "translation": "The Naam, the Name of the Lord, is my soul, my life, my wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਈਹਾ ਊਹਾਂ ਉਨ ਸੰਗਿ ਕਾਮੁ ॥੧॥",
      "transliteration": "eehaa oohaa(n) un sa(n)g kaam ||1||",
      "translation": "Here and hereafter, it is with me, to help me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਨਾਮ ਅਵਰੁ ਸਭੁ ਥੋਰਾ ॥",
      "transliteration": "bin har naam avar sabh thoraa ||",
      "translation": "Without the Lord's Name, everything else is useless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤ੍ਰਿਪਤਿ ਅਘਾਵੈ ਹਰਿ ਦਰਸਨਿ ਮਨੁ ਮੋਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tripat aghaavai har darasan man moraa ||1|| rahaau ||",
      "translation": "My mind is satisfied and satiated by the Blessed Vision of the Lord's Darshan. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭਗਤਿ ਭੰਡਾਰ ਗੁਰਬਾਣੀ ਲਾਲ ॥",
      "transliteration": "bhagat bha(n)daar gurabaanee laal ||",
      "translation": "Gurbani is the jewel, the treasure of devotion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗਾਵਤ ਸੁਨਤ ਕਮਾਵਤ ਨਿਹਾਲ ॥੨॥",
      "transliteration": "gaavat sunat kamaavat nihaal ||2||",
      "translation": "Singing, hearing and acting upon it, one is enraptured. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚਰਣ ਕਮਲ ਸਿਉ ਲਾਗੋ ਮਾਨੁ ॥",
      "transliteration": "charan kamal siu laago maan ||",
      "translation": "My mind is attached to the Lord's Lotus Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਤੂਠੈ ਕੀਨੋ ਦਾਨੁ ॥੩॥",
      "transliteration": "satigur toothai keeno daan ||3||",
      "translation": "The True Guru, in His Pleasure, has given this gift. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਗੁਰਿ ਦੀਖਿਆ ਦੀਨੑ ॥",
      "transliteration": "naanak kau gur deekhiaa deenh ||",
      "translation": "Unto Nanak, the Guru has revealed these instructions:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਭ ਅਬਿਨਾਸੀ ਘਟਿ ਘਟਿ ਚੀਨੑ ॥੪॥੨੩॥",
      "transliteration": "prabh abinaasee ghat ghat cheenh ||4||23||",
      "translation": "recognize the Imperishable Lord God in each and every heart. ||4||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਨਦ ਬਿਨੋਦ ਭਰੇਪੁਰਿ ਧਾਰਿਆ ॥",
      "transliteration": "anad binod bharepur dhaariaa ||",
      "translation": "The All-pervading Lord has established joys and celebrations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਪੁਨਾ ਕਾਰਜੁ ਆਪਿ ਸਵਾਰਿਆ ॥੧॥",
      "transliteration": "apunaa kaaraj aap savaariaa ||1||",
      "translation": "He Himself embellishes His own works. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪੂਰ ਸਮਗ੍ਰੀ ਪੂਰੇ ਠਾਕੁਰ ਕੀ ॥",
      "transliteration": "poor samagree poore thaakur kee ||",
      "translation": "Perfect is the Creation of the Perfect Lord Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਭਰਿਪੁਰਿ ਧਾਰਿ ਰਹੀ ਸੋਭ ਜਾ ਕੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bharipur dhaar rahee sobh jaa kee ||1|| rahaau ||",
      "translation": "His magnificent greatness is totally all-pervading. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾਮੁ ਨਿਧਾਨੁ ਜਾ ਕੀ ਨਿਰਮਲ ਸੋਇ ॥",
      "transliteration": "naam nidhaan jaa kee niramal soi ||",
      "translation": "His Name is the treasure; His reputation is immaculate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਆਪੇ ਕਰਤਾ ਅਵਰੁ ਨ ਕੋਇ ॥੨॥",
      "transliteration": "aape karataa avar na koi ||2||",
      "translation": "He Himself is the Creator; there is no other. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਸਭਿ ਤਾ ਕੈ ਹਾਥਿ ॥",
      "transliteration": "jee ja(n)t sabh taa kai haath ||",
      "translation": "All beings and creatures are in His Hands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0376_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਰਵਿ ਰਹਿਆ ਪ੍ਰਭੁ ਸਭ ਕੈ ਸਾਥਿ ॥੩॥",
      "transliteration": "rav rahiaa prabh sabh kai saath ||3||",
      "translation": "God is pervading in all, and is always with them. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 376,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
