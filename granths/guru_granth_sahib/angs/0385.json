{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 385,
  "lineCount": 52,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0385_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅੰਤਰਿ ਬਾਹਰਿ ਏਕੁ ਦਿਖਾਇਆ ॥੪॥੩॥੫੪॥",
      "transliteration": "a(n)tar baahar ek dikhaaiaa ||4||3||54||",
      "translation": "Inwardly and outwardly, He has shown me the One Lord. ||4||3||54||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪਾਵਤੁ ਰਲੀਆ ਜੋਬਨਿ ਬਲੀਆ ॥",
      "transliteration": "paavat raleeaa joban baleeaa ||",
      "translation": "The mortal revels in joy, in the vigor of youth;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਮਾਟੀ ਸੰਗਿ ਰਲੀਆ ॥੧॥",
      "transliteration": "naam binaa maatee sa(n)g raleeaa ||1||",
      "translation": "but without the Name, he mingles with dust. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਾਨ ਕੁੰਡਲੀਆ ਬਸਤ੍ਰ ਓਢਲੀਆ ॥",
      "transliteration": "kaan ku(n)daleeaa basatr odhaleeaa ||",
      "translation": "He may wear ear-rings and fine clothes,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੇਜ ਸੁਖਲੀਆ ਮਨਿ ਗਰਬਲੀਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sej sukhaleeaa man garabaleeaa ||1|| rahaau ||",
      "translation": "and have a comfortable bed, and his mind may be so proud. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਲੈ ਕੁੰਚਰੀਆ ਸਿਰਿ ਕਨਿਕ ਛਤਰੀਆ ॥",
      "transliteration": "talai ku(n)chareeaa sir kanik chhatareeaa ||",
      "translation": "He may have elephants to ride, and golden umbrellas over his head;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਰਿ ਭਗਤਿ ਬਿਨਾ ਲੇ ਧਰਨਿ ਗਡਲੀਆ ॥੨॥",
      "transliteration": "har bhagat binaa le dharan gadaleeaa ||2||",
      "translation": "but without devotional worship to the Lord, he is buried beneath the dirt. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰੂਪ ਸੁੰਦਰੀਆ ਅਨਿਕ ਇਸਤਰੀਆ ॥",
      "transliteration": "roop su(n)dareeaa anik isatareeaa ||",
      "translation": "He may enjoy many women, of exquisite beauty;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਰਿ ਰਸ ਬਿਨੁ ਸਭਿ ਸੁਆਦ ਫਿਕਰੀਆ ॥੩॥",
      "transliteration": "har ras bin sabh suaad phikareeaa ||3||",
      "translation": "but without the sublime essence of the Lord, all tastes are tasteless. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਾਇਆ ਛਲੀਆ ਬਿਕਾਰ ਬਿਖਲੀਆ ॥",
      "transliteration": "maaiaa chhaleeaa bikaar bikhaleeaa ||",
      "translation": "Deluded by Maya, the mortal is led into sin and corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਰਣਿ ਨਾਨਕ ਪ੍ਰਭ ਪੁਰਖ ਦਇਅਲੀਆ ॥੪॥੪॥੫੫॥",
      "transliteration": "saran naanak prabh purakh daialeeaa ||4||4||55||",
      "translation": "Nanak seeks the Sanctuary of God, the All-powerful, Compassionate Lord. ||4||4||55||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਕੁ ਬਗੀਚਾ ਪੇਡ ਘਨ ਕਰਿਆ ॥",
      "transliteration": "ek bageechaa ped ghan kariaa ||",
      "translation": "There is a garden, in which so many plants have grown.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਤਹਾ ਮਹਿ ਫਲਿਆ ॥੧॥",
      "transliteration": "a(n)mrit naam tahaa mahi phaliaa ||1||",
      "translation": "They bear the Ambrosial Nectar of the Naam as their fruit. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਐਸਾ ਕਰਹੁ ਬੀਚਾਰੁ ਗਿਆਨੀ ॥",
      "transliteration": "aisaa karahu beechaar giaanee ||",
      "translation": "Consider this, O wise one,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਾ ਤੇ ਪਾਈਐ ਪਦੁ ਨਿਰਬਾਨੀ ॥",
      "transliteration": "jaa te paaeeai pad nirabaanee ||",
      "translation": "by which you may attain the state of Nirvaanaa.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਸਿ ਪਾਸਿ ਬਿਖੂਆ ਕੇ ਕੁੰਟਾ ਬੀਚਿ ਅੰਮ੍ਰਿਤੁ ਹੈ ਭਾਈ ਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aas paas bikhooaa ke ku(n)taa beech a(n)mrit hai bhaaee re ||1|| rahaau ||",
      "translation": "All around this garden are pools of poison, but within it is the Ambrosial Nectar, O Siblings of Destiny. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਿੰਚਨਹਾਰੇ ਏਕੈ ਮਾਲੀ ॥",
      "transliteration": "si(n)chanahaare ekai maalee ||",
      "translation": "There is only one gardener who tends it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਖਬਰਿ ਕਰਤੁ ਹੈ ਪਾਤ ਪਤ ਡਾਲੀ ॥੨॥",
      "transliteration": "khabar karat hai paat pat daalee ||2||",
      "translation": "He takes care of every leaf and branch. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਗਲ ਬਨਸਪਤਿ ਆਣਿ ਜੜਾਈ ॥",
      "transliteration": "sagal banasapat aan jaRaaee ||",
      "translation": "He brings all sorts of plants and plants them there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਗਲੀ ਫੂਲੀ ਨਿਫਲ ਨ ਕਾਈ ॥੩॥",
      "transliteration": "sagalee phoolee niphal na kaaee ||3||",
      "translation": "They all bear fruit - none is without fruit. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਫਲੁ ਨਾਮੁ ਜਿਨਿ ਗੁਰ ਤੇ ਪਾਇਆ ॥",
      "transliteration": "a(n)mrit phal naam jin gur te paaiaa ||",
      "translation": "One who receives the Ambrosial Fruit of the Naam from the Guru",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਤਰੀ ਤਿਨਿ ਮਾਇਆ ॥੪॥੫॥੫੬॥",
      "transliteration": "naanak daas taree tin maaiaa ||4||5||56||",
      "translation": "- O Nanak, such a servant crosses over the ocean of Maya. ||4||5||56||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਜ ਲੀਲਾ ਤੇਰੈ ਨਾਮਿ ਬਨਾਈ ॥",
      "transliteration": "raaj leelaa terai naam banaaee ||",
      "translation": "The pleasures of royalty are derived from Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੋਗੁ ਬਨਿਆ ਤੇਰਾ ਕੀਰਤਨੁ ਗਾਈ ॥੧॥",
      "transliteration": "jog baniaa teraa keeratan gaaee ||1||",
      "translation": "I attain Yoga, singing the Kirtan of Your Praises. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਰਬ ਸੁਖਾ ਬਨੇ ਤੇਰੈ ਓਲੑੈ ॥",
      "transliteration": "sarab sukhaa bane terai olhai ||",
      "translation": "All comforts are obtained in Your Shelter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭ੍ਰਮ ਕੇ ਪਰਦੇ ਸਤਿਗੁਰ ਖੋਲੑੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bhram ke parade satigur kholhe ||1|| rahaau ||",
      "translation": "The True Guru has removed the veil of doubt. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹੁਕਮੁ ਬੂਝਿ ਰੰਗ ਰਸ ਮਾਣੇ ॥",
      "transliteration": "hukam boojh ra(n)g ras maane ||",
      "translation": "Understanding the Command of the Lord's Will, I revel in pleasure and joy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਤਿਗੁਰ ਸੇਵਾ ਮਹਾ ਨਿਰਬਾਣੇ ॥੨॥",
      "transliteration": "satigur sevaa mahaa nirabaane ||2||",
      "translation": "Serving the True Guru, I obtain the supreme state of Nirvaanaa. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਨਿ ਤੂੰ ਜਾਤਾ ਸੋ ਗਿਰਸਤ ਉਦਾਸੀ ਪਰਵਾਣੁ ॥",
      "transliteration": "jin too(n) jaataa so girasat udaasee paravaan ||",
      "translation": "One who recognizes You is recognized as a householder, and as a renunciate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਮਿ ਰਤਾ ਸੋਈ ਨਿਰਬਾਣੁ ॥੩॥",
      "transliteration": "naam rataa soee nirabaan ||3||",
      "translation": "Imbued with the Naam, the Name of the Lord, he dwells in Nirvaanaa. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾ ਕਉ ਮਿਲਿਓ ਨਾਮੁ ਨਿਧਾਨਾ ॥",
      "transliteration": "jaa kau milio naam nidhaanaa ||",
      "translation": "One who has obtained the treasure of the Naam",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਨਤਿ ਨਾਨਕ ਤਾ ਕਾ ਪੂਰ ਖਜਾਨਾ ॥੪॥੬॥੫੭॥",
      "transliteration": "bhanat naanak taa kaa poor khajaanaa ||4||6||57||",
      "translation": "- prays Nanak, his treasure-house is filled to overflowing. ||4||6||57||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤੀਰਥਿ ਜਾਉ ਤ ਹਉ ਹਉ ਕਰਤੇ ॥",
      "transliteration": "teerath jaau ta hau hau karate ||",
      "translation": "Journeying to sacred shrines of pilgrimage, I see the mortals acting in ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪੰਡਿਤ ਪੂਛਉ ਤ ਮਾਇਆ ਰਾਤੇ ॥੧॥",
      "transliteration": "pa(n)dit poochhau ta maaiaa raate ||1||",
      "translation": "If I ask the Pandits, I find them tainted by Maya. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੋ ਅਸਥਾਨੁ ਬਤਾਵਹੁ ਮੀਤਾ ॥",
      "transliteration": "so asathaan bataavahu meetaa ||",
      "translation": "Show me that place, O friend,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਾ ਕੈ ਹਰਿ ਹਰਿ ਕੀਰਤਨੁ ਨੀਤਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaa kai har har keeratan neetaa ||1|| rahaau ||",
      "translation": "where the Kirtan of the Lord's Praises are forever sung. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਾਸਤ੍ਰ ਬੇਦ ਪਾਪ ਪੁੰਨ ਵੀਚਾਰ ॥",
      "transliteration": "saasatr bed paap pu(n)n veechaar ||",
      "translation": "The Shaastras and the Vedas speak of sin and virtue;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਰਕਿ ਸੁਰਗਿ ਫਿਰਿ ਫਿਰਿ ਅਉਤਾਰ ॥੨॥",
      "transliteration": "narak surag phir phir autaar ||2||",
      "translation": "they say that mortals are reincarnated into heaven and hell, over and over again. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗਿਰਸਤ ਮਹਿ ਚਿੰਤ ਉਦਾਸ ਅਹੰਕਾਰ ॥",
      "transliteration": "girasat mahi chi(n)t udaas aha(n)kaar ||",
      "translation": "In the householder's life, there is anxiety, and in the life of the renunciate, there is egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਰਮ ਕਰਤ ਜੀਅ ਕਉ ਜੰਜਾਰ ॥੩॥",
      "transliteration": "karam karat jee kau ja(n)jaar ||3||",
      "translation": "Performing religious rituals, the soul is entangled. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ ਮਨੁ ਵਸਿ ਆਇਆ ॥",
      "transliteration": "prabh kirapaa te man vas aaiaa ||",
      "translation": "By God's Grace, the mind is brought under control;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਤਰੀ ਤਿਨਿ ਮਾਇਆ ॥੪॥",
      "transliteration": "naanak guramukh taree tin maaiaa ||4||",
      "translation": "O Nanak, the Gurmukh crosses over the ocean of Maya. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਹਰਿ ਕੀਰਤਨੁ ਗਾਈਐ ॥",
      "transliteration": "saadhasa(n)g har keeratan gaaeeai ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, sing the Kirtan of the Lord's Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਹੁ ਅਸਥਾਨੁ ਗੁਰੂ ਤੇ ਪਾਈਐ ॥੧॥ ਰਹਾਉ ਦੂਜਾ ॥੭॥੫੮॥",
      "transliteration": "ihu asathaan guroo te paaeeai ||1|| rahaau doojaa ||7||58||",
      "translation": "This place is found through the Guru. ||1||Second Pause||7||58||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਘਰ ਮਹਿ ਸੂਖ ਬਾਹਰਿ ਫੁਨਿ ਸੂਖਾ ॥",
      "transliteration": "ghar mahi sookh baahar phun sookhaa ||",
      "translation": "Within my home there is peace, and outwardly there is peace as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਸਗਲ ਬਿਨਾਸੇ ਦੂਖਾ ॥੧॥",
      "transliteration": "har simarat sagal binaase dookhaa ||1||",
      "translation": "Remembering the Lord in meditation, all pains are erased. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0385_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਗਲ ਸੂਖ ਜਾਂ ਤੂੰ ਚਿਤਿ ਆਂਵੈਂ ॥",
      "transliteration": "sagal sookh jaa(n) too(n) chit aa(n)vai(n) ||",
      "translation": "There is total peace, when You come into my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 385,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
