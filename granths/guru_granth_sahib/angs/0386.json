{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 386,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0386_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੋ ਨਾਮੁ ਜਪੈ ਜੋ ਜਨੁ ਤੁਧੁ ਭਾਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "so naam japai jo jan tudh bhaavai ||1|| rahaau ||",
      "translation": "He alone is pleasing to Your Will, who chants the Naam. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਸੀਤਲੁ ਜਪਿ ਨਾਮੁ ਤੇਰਾ ॥",
      "transliteration": "tan man seetal jap naam teraa ||",
      "translation": "My body and mind are cooled and soothed, chanting the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਜਪਤ ਢਹੈ ਦੁਖ ਡੇਰਾ ॥੨॥",
      "transliteration": "har har japat dhahai dukh deraa ||2||",
      "translation": "Meditating on the Lord, Har, Har, the house of pain is demolished. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹੁਕਮੁ ਬੂਝੈ ਸੋਈ ਪਰਵਾਨੁ ॥",
      "transliteration": "hukam boojhai soee paravaan ||",
      "translation": "He alone, who understands the Command of the Lord's Will, is approved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਚੁ ਸਬਦੁ ਜਾ ਕਾ ਨੀਸਾਨੁ ॥੩॥",
      "transliteration": "saach sabad jaa kaa neesaan ||3||",
      "translation": "The True Shabad of the Word of God is his trademark and insignia. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਹਰਿ ਨਾਮੁ ਦ੍ਰਿੜਾਇਆ ॥",
      "transliteration": "gur poorai har naam driRaaiaa ||",
      "translation": "The Perfect Guru has implanted the Lord's Name within me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਨਤਿ ਨਾਨਕੁ ਮੇਰੈ ਮਨਿ ਸੁਖੁ ਪਾਇਆ ॥੪॥੮॥੫੯॥",
      "transliteration": "bhanat naanak merai man sukh paaiaa ||4||8||59||",
      "translation": "Prays Nanak, my mind has found peace. ||4||8||59||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਹਾ ਪਠਾਵਹੁ ਤਹ ਤਹ ਜਾਈਁ ॥",
      "transliteration": "jahaa pathaavahu tah tah jaaee(n) ||",
      "translation": "Wherever You send me, there I go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੋ ਤੁਮ ਦੇਹੁ ਸੋਈ ਸੁਖੁ ਪਾਈਁ ॥੧॥",
      "transliteration": "jo tum dehu soee sukh paaee(n) ||1||",
      "translation": "Whatever You give me, brings me peace. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਦਾ ਚੇਰੇ ਗੋਵਿੰਦ ਗੋਸਾਈ ॥",
      "transliteration": "sadaa chere govi(n)d gosaaee ||",
      "translation": "I am forever the chaylaa, the humble disciple, of the Lord of the Universe, the Sustainer of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੁਮੑਰੀ ਕ੍ਰਿਪਾ ਤੇ ਤ੍ਰਿਪਤਿ ਅਘਾਈਁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tumhree kripaa te tripat aghaaee(n) ||1|| rahaau ||",
      "translation": "By Your Grace, I am satisfied and satiated. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੁਮਰਾ ਦੀਆ ਪੈਨੑਉ ਖਾਈਁ ॥",
      "transliteration": "tumaraa deeaa painh khaaee(n) ||",
      "translation": "Whatever You give me, I wear and eat.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਉ ਪ੍ਰਸਾਦਿ ਪ੍ਰਭ ਸੁਖੀ ਵਲਾਈਁ ॥੨॥",
      "transliteration": "tau prasaad prabh sukhee valaaee(n) ||2||",
      "translation": "By Your Grace, O God, my life passes peacefully. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਨ ਤਨ ਅੰਤਰਿ ਤੁਝੈ ਧਿਆਈਁ ॥",
      "transliteration": "man tan a(n)tar tujhai dhiaaee(n) ||",
      "translation": "Deep within my mind and body, I meditate on You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤੁਮੑਰੈ ਲਵੈ ਨ ਕੋਊ ਲਾਈਁ ॥੩॥",
      "transliteration": "tumhrai lavai na kooo laaee(n) ||3||",
      "translation": "I recognize none as equal to You. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਨਿਤ ਇਵੈ ਧਿਆਈਁ ॥",
      "transliteration": "kahu naanak nit ivai dhiaaee(n) ||",
      "translation": "Says Nanak, this is my continual meditation:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗਤਿ ਹੋਵੈ ਸੰਤਹ ਲਗਿ ਪਾਈਁ ॥੪॥੯॥੬੦॥",
      "transliteration": "gat hovai sa(n)tah lag paaee(n) ||4||9||60||",
      "translation": "that I may be emancipated, clinging to the Feet of the Saints. ||4||9||60||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਊਠਤ ਬੈਠਤ ਸੋਵਤ ਧਿਆਈਐ ॥",
      "transliteration": "oothat baithat sovat dhiaaeeai ||",
      "translation": "While standing up, and sitting down, and even while asleep, meditate on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਾਰਗਿ ਚਲਤ ਹਰੇ ਹਰਿ ਗਾਈਐ ॥੧॥",
      "transliteration": "maarag chalat hare har gaaeeai ||1||",
      "translation": "Walking on the Way, sing the Praises of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸ੍ਰਵਨ ਸੁਨੀਜੈ ਅੰਮ੍ਰਿਤ ਕਥਾ ॥",
      "transliteration": "sravan suneejai a(n)mrit kathaa ||",
      "translation": "With your ears, listen to the Ambrosial Sermon.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾਸੁ ਸੁਨੀ ਮਨਿ ਹੋਇ ਅਨੰਦਾ ਦੂਖ ਰੋਗ ਮਨ ਸਗਲੇ ਲਥਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaas sunee man hoi ana(n)daa dookh rog man sagale lathaa ||1|| rahaau ||",
      "translation": "Listening to it, your mind shall be filled with bliss, and the troubles and diseases of your mind shall all depart. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਾਰਜਿ ਕਾਮਿ ਬਾਟ ਘਾਟ ਜਪੀਜੈ ॥",
      "transliteration": "kaaraj kaam baat ghaat japeejai ||",
      "translation": "While you work at your job, on the road and at the beach, meditate and chant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਹਰਿ ਅੰਮ੍ਰਿਤੁ ਪੀਜੈ ॥੨॥",
      "transliteration": "gur prasaad har a(n)mrit peejai ||2||",
      "translation": "By Guru's Grace, drink in the Ambrosial Essence of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦਿਨਸੁ ਰੈਨਿ ਹਰਿ ਕੀਰਤਨੁ ਗਾਈਐ ॥",
      "transliteration": "dinas rain har keeratan gaaeeai ||",
      "translation": "The humble being who sings the Kirtan of the Lord's Praises, day and night,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੋ ਜਨੁ ਜਮ ਕੀ ਵਾਟ ਨ ਪਾਈਐ ॥੩॥",
      "transliteration": "so jan jam kee vaat na paaeeai ||3||",
      "translation": "does not have to go with the Messenger of Death. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਆਠ ਪਹਰ ਜਿਸੁ ਵਿਸਰਹਿ ਨਾਹੀ ॥",
      "transliteration": "aath pahar jis visarahi naahee ||",
      "translation": "One who does not forget the Lord, twenty-four hours a day, is emancipated;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗਤਿ ਹੋਵੈ ਨਾਨਕ ਤਿਸੁ ਲਗਿ ਪਾਈ ॥੪॥੧੦॥੬੧॥",
      "transliteration": "gat hovai naanak tis lag paaee ||4||10||61||",
      "translation": "O Nanak, I fall at his feet. ||4||10||61||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾ ਕੈ ਸਿਮਰਨਿ ਸੂਖ ਨਿਵਾਸੁ ॥",
      "transliteration": "jaa kai simaran sookh nivaas ||",
      "translation": "Remembering Him in meditation, one abides in peace;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਈ ਕਲਿਆਣ ਦੁਖ ਹੋਵਤ ਨਾਸੁ ॥੧॥",
      "transliteration": "bhaee kaliaan dukh hovat naas ||1||",
      "translation": "one becomes happy, and suffering is ended. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਨਦੁ ਕਰਹੁ ਪ੍ਰਭ ਕੇ ਗੁਨ ਗਾਵਹੁ ॥",
      "transliteration": "anad karahu prabh ke gun gaavahu ||",
      "translation": "Celebrate, make merry, and sing God's Glories.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਅਪਨਾ ਸਦ ਸਦਾ ਮਨਾਵਹੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "satigur apanaa sad sadaa manaavahu ||1|| rahaau ||",
      "translation": "Forever and ever, surrender to the True Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਤਿਗੁਰ ਕਾ ਸਚੁ ਸਬਦੁ ਕਮਾਵਹੁ ॥",
      "transliteration": "satigur kaa sach sabad kamaavahu ||",
      "translation": "Act in accordance with the Shabad, the True Word of the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਥਿਰੁ ਘਰਿ ਬੈਠੇ ਪ੍ਰਭੁ ਅਪਨਾ ਪਾਵਹੁ ॥੨॥",
      "transliteration": "thir ghar baithe prabh apanaa paavahu ||2||",
      "translation": "Remain steady and stable within the home of your own self, and find God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਰ ਕਾ ਬੁਰਾ ਨ ਰਾਖਹੁ ਚੀਤ ॥",
      "transliteration": "par kaa buraa na raakhahu cheet ||",
      "translation": "Do not harbor evil intentions against others in your mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੁਮ ਕਉ ਦੁਖੁ ਨਹੀ ਭਾਈ ਮੀਤ ॥੩॥",
      "transliteration": "tum kau dukh nahee bhaaee meet ||3||",
      "translation": "and you shall not be troubled, O Siblings of Destiny, O friends. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਤੰਤੁ ਮੰਤੁ ਗੁਰਿ ਦੀਨੑਾ ॥",
      "transliteration": "har har ta(n)t ma(n)t gur deenhaa ||",
      "translation": "The Name of the Lord, Har, Har, is the Tantric exercise, and the Mantra, given by the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਇਹੁ ਸੁਖੁ ਨਾਨਕ ਅਨਦਿਨੁ ਚੀਨੑਾ ॥੪॥੧੧॥੬੨॥",
      "transliteration": "ihu sukh naanak anadin cheenhaa ||4||11||62||",
      "translation": "Nanak knows this peace alone, night and day. ||4||11||62||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਸੁ ਨੀਚ ਕਉ ਕੋਈ ਨ ਜਾਨੈ ॥",
      "transliteration": "jis neech kau koee na jaanai ||",
      "translation": "That wretched being, whom no one knows",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਉਹੁ ਚਹੁ ਕੁੰਟ ਮਾਨੈ ॥੧॥",
      "transliteration": "naam japat uhu chahu ku(n)t maanai ||1||",
      "translation": "- chanting the Naam, the Name of the Lord, he is honored in the four directions. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦਰਸਨੁ ਮਾਗਉ ਦੇਹਿ ਪਿਆਰੇ ॥",
      "transliteration": "darasan maagau dehi piaare ||",
      "translation": "I beg for the Blessed Vision of Your Darshan; please, give it to me, O Beloved!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤੁਮਰੀ ਸੇਵਾ ਕਉਨ ਕਉਨ ਨ ਤਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tumaree sevaa kaun kaun na taare ||1|| rahaau ||",
      "translation": "Serving You, who, who has not been saved? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਾ ਕੈ ਨਿਕਟਿ ਨ ਆਵੈ ਕੋਈ ॥",
      "transliteration": "jaa kai nikat na aavai koee ||",
      "translation": "That person, whom no one wants to be near",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਗਲ ਸ੍ਰਿਸਟਿ ਉਆ ਕੇ ਚਰਨ ਮਲਿ ਧੋਈ ॥੨॥",
      "transliteration": "sagal srisat uaa ke charan mal dhoee ||2||",
      "translation": "- the whole world comes to wash the dirt of his feet. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜੋ ਪ੍ਰਾਨੀ ਕਾਹੂ ਨ ਆਵਤ ਕਾਮ ॥",
      "transliteration": "jo praanee kaahoo na aavat kaam ||",
      "translation": "That mortal, who is of no use to anyone at all",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਤਾ ਕੋ ਜਪੀਐ ਨਾਮ ॥੩॥",
      "transliteration": "sa(n)t prasaad taa ko japeeai naam ||3||",
      "translation": "- by the Grace of the Saints, he meditates on the Naam. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਮਨ ਸੋਵਤ ਜਾਗੇ ॥",
      "transliteration": "saadhasa(n)g man sovat jaage ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, the sleeping mind awakens.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤਬ ਪ੍ਰਭ ਨਾਨਕ ਮੀਠੇ ਲਾਗੇ ॥੪॥੧੨॥੬੩॥",
      "transliteration": "tab prabh naanak meethe laage ||4||12||63||",
      "translation": "Then, O Nanak, God seems sweet. ||4||12||63||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਏਕੋ ਏਕੀ ਨੈਨ ਨਿਹਾਰਉ ॥",
      "transliteration": "eko ekee nain nihaarau ||",
      "translation": "With my eyes, I behold the One and Only Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0386_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਹਰਿ ਨਾਮੁ ਸਮੑਾਰਉ ॥੧॥",
      "transliteration": "sadaa sadaa har naam samhaarau ||1||",
      "translation": "Forever and ever, I contemplate the Naam, the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 386,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
