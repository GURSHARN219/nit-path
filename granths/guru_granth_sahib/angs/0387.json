{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 387,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0387_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਮ ਰਾਮਾ ਰਾਮਾ ਗੁਨ ਗਾਵਉ ॥",
      "transliteration": "raam raamaa raamaa gun gaavau ||",
      "translation": "I sing the Praises of the Lord, Raam, Raam, Raam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਤਾਪਿ ਸਾਧ ਕੈ ਸੰਗੇ ਹਰਿ ਹਰਿ ਨਾਮੁ ਧਿਆਵਉ ਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sa(n)t prataap saadh kai sa(n)ge har har naam dhiaavau re ||1|| rahaau ||",
      "translation": "By the graceful favor of the Saints, I meditate on the Name of the Lord, Har, Har, in the Saadh Sangat, the Company of the Holy. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਗਲ ਸਮਗ੍ਰੀ ਜਾ ਕੈ ਸੂਤਿ ਪਰੋਈ ॥",
      "transliteration": "sagal samagree jaa kai soot paroee ||",
      "translation": "Everything is strung on His string.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਘਟ ਘਟ ਅੰਤਰਿ ਰਵਿਆ ਸੋਈ ॥੨॥",
      "transliteration": "ghat ghat a(n)tar raviaa soee ||2||",
      "translation": "He is contained in each and every heart. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਓਪਤਿ ਪਰਲਉ ਖਿਨ ਮਹਿ ਕਰਤਾ ॥",
      "transliteration": "opat paralau khin mahi karataa ||",
      "translation": "He creates and destroys in an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਪਿ ਅਲੇਪਾ ਨਿਰਗੁਨੁ ਰਹਤਾ ॥੩॥",
      "transliteration": "aap alepaa niragun rahataa ||3||",
      "translation": "He Himself remains unattached, and without attributes. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "karan karaavan a(n)tarajaamee ||",
      "translation": "He is the Creator, the Cause of causes, the Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਨੰਦ ਕਰੈ ਨਾਨਕ ਕਾ ਸੁਆਮੀ ॥੪॥੧੩॥੬੪॥",
      "transliteration": "ana(n)d karai naanak kaa suaamee ||4||13||64||",
      "translation": "Nanak's Lord and Master celebrates in bliss. ||4||13||64||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕੋਟਿ ਜਨਮ ਕੇ ਰਹੇ ਭਵਾਰੇ ॥",
      "transliteration": "kot janam ke rahe bhavaare ||",
      "translation": "My wandering through millions of births has ended.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੁਲਭ ਦੇਹ ਜੀਤੀ ਨਹੀ ਹਾਰੇ ॥੧॥",
      "transliteration": "dulabh deh jeetee nahee haare ||1||",
      "translation": "I have won, and not lost, this human body, so difficult to obtain. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਿਲਬਿਖ ਬਿਨਾਸੇ ਦੁਖ ਦਰਦ ਦੂਰਿ ॥",
      "transliteration": "kilabikh binaase dukh darad door ||",
      "translation": "My sins have been erased, and my sufferings and pains are gone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਏ ਪੁਨੀਤ ਸੰਤਨ ਕੀ ਧੂਰਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bhae puneet sa(n)tan kee dhoor ||1|| rahaau ||",
      "translation": "I have been sanctified by the dust of the feet of the Saints. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪ੍ਰਭ ਕੇ ਸੰਤ ਉਧਾਰਨ ਜੋਗ ॥",
      "transliteration": "prabh ke sa(n)t udhaaran jog ||",
      "translation": "The Saints of God have the ability to save us;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਿਸੁ ਭੇਟੇ ਜਿਸੁ ਧੁਰਿ ਸੰਜੋਗ ॥੨॥",
      "transliteration": "tis bhete jis dhur sa(n)jog ||2||",
      "translation": "they meet with those of us who have such pre-ordained destiny. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਨਿ ਆਨੰਦੁ ਮੰਤ੍ਰੁ ਗੁਰਿ ਦੀਆ ॥",
      "transliteration": "man aana(n)d ma(n)tr gur deeaa ||",
      "translation": "My mind is filled with bliss, since the Guru gave me the Mantra of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤ੍ਰਿਸਨ ਬੁਝੀ ਮਨੁ ਨਿਹਚਲੁ ਥੀਆ ॥੩॥",
      "transliteration": "trisan bujhee man nihachal theeaa ||3||",
      "translation": "My thirst has been quenched, and my mind has become steady and stable. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮੁ ਪਦਾਰਥੁ ਨਉ ਨਿਧਿ ਸਿਧਿ ॥",
      "transliteration": "naam padaarath nau nidh sidh ||",
      "translation": "The wealth of the Naam, the Name of the Lord, is for me the nine treasures, and the spiritual powers of the Siddhas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਗੁਰ ਤੇ ਪਾਈ ਬੁਧਿ ॥੪॥੧੪॥੬੫॥",
      "transliteration": "naanak gur te paaee budh ||4||14||65||",
      "translation": "O Nanak, I have obtained understanding from the Guru. ||4||14||65||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਿਟੀ ਤਿਆਸ ਅਗਿਆਨ ਅੰਧੇਰੇ ॥",
      "transliteration": "mitee tiaas agiaan a(n)dhere ||",
      "translation": "My thirst, and the darkness of ignorance have been removed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾਧ ਸੇਵਾ ਅਘ ਕਟੇ ਘਨੇਰੇ ॥੧॥",
      "transliteration": "saadh sevaa agh kate ghanere ||1||",
      "translation": "Serving the Holy Saints, countless sins are obliterated. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਆਨੰਦੁ ਘਨਾ ॥",
      "transliteration": "sookh sahaj aana(n)d ghanaa ||",
      "translation": "I have obtained celestial peace and immense joy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਰ ਸੇਵਾ ਤੇ ਭਏ ਮਨ ਨਿਰਮਲ ਹਰਿ ਹਰਿ ਹਰਿ ਹਰਿ ਨਾਮੁ ਸੁਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur sevaa te bhae man niramal har har har har naam sunaa ||1|| rahaau ||",
      "translation": "Serving the Guru, my mind has become immaculately pure, and I have heard the Name of the Lord, Har, Har, Har, Har. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਿਨਸਿਓ ਮਨ ਕਾ ਮੂਰਖੁ ਢੀਠਾ ॥",
      "transliteration": "binasio man kaa moorakh dheethaa ||",
      "translation": "The stubborn foolishness of my mind is gone;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪ੍ਰਭ ਕਾ ਭਾਣਾ ਲਾਗਾ ਮੀਠਾ ॥੨॥",
      "transliteration": "prabh kaa bhaanaa laagaa meethaa ||2||",
      "translation": "God's Will has become sweet to me. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕੇ ਚਰਣ ਗਹੇ ॥",
      "transliteration": "gur poore ke charan gahe ||",
      "translation": "I have grasped the Feet of the Perfect Guru,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕੋਟਿ ਜਨਮ ਕੇ ਪਾਪ ਲਹੇ ॥੩॥",
      "transliteration": "kot janam ke paap lahe ||3||",
      "translation": "and the sins of countless incarnations have been washed away. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਤਨ ਜਨਮੁ ਇਹੁ ਸਫਲ ਭਇਆ ॥",
      "transliteration": "ratan janam ihu saphal bhaiaa ||",
      "translation": "The jewel of this life has become fruitful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਪ੍ਰਭ ਕਰੀ ਮਇਆ ॥੪॥੧੫॥੬੬॥",
      "transliteration": "kahu naanak prabh karee maiaa ||4||15||66||",
      "translation": "Says Nanak, God has shown mercy to me. ||4||15||66||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਅਪਨਾ ਸਦ ਸਦਾ ਸਮੑਾਰੇ ॥",
      "transliteration": "satigur apanaa sad sadaa samhaare ||",
      "translation": "I contemplate, forever and ever, the True Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਨ ਕੇਸ ਸੰਗਿ ਝਾਰੇ ॥੧॥",
      "transliteration": "gur ke charan kes sa(n)g jhaare ||1||",
      "translation": "with my hair, I dust the feet of the Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾਗੁ ਰੇ ਮਨ ਜਾਗਨਹਾਰੇ ॥",
      "transliteration": "jaag re man jaaganahaare ||",
      "translation": "Be wakeful, O my awakening mind!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਅਵਰੁ ਨ ਆਵਸਿ ਕਾਮਾ ਝੂਠਾ ਮੋਹੁ ਮਿਥਿਆ ਪਸਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin har avar na aavas kaamaa jhoothaa mohu mithiaa pasaare ||1|| rahaau ||",
      "translation": "Without the Lord, nothing else shall be of use to you; false is emotional attachment, and useless are worldly entanglements. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰ ਕੀ ਬਾਣੀ ਸਿਉ ਰੰਗੁ ਲਾਇ ॥",
      "transliteration": "gur kee baanee siu ra(n)g laai ||",
      "translation": "Embrace love for the Word of the Guru's Bani.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰੁ ਕਿਰਪਾਲੁ ਹੋਇ ਦੁਖੁ ਜਾਇ ॥੨॥",
      "transliteration": "gur kirapaal hoi dukh jaai ||2||",
      "translation": "When the Guru shows His Mercy, pain is destroyed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗੁਰ ਬਿਨੁ ਦੂਜਾ ਨਾਹੀ ਥਾਉ ॥",
      "transliteration": "gur bin doojaa naahee thaau ||",
      "translation": "Without the Guru, there is no other place of rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰੁ ਦਾਤਾ ਗੁਰੁ ਦੇਵੈ ਨਾਉ ॥੩॥",
      "transliteration": "gur daataa gur devai naau ||3||",
      "translation": "The Guru is the Giver, the Guru gives the Name. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਰੁ ਪਾਰਬ੍ਰਹਮੁ ਪਰਮੇਸਰੁ ਆਪਿ ॥",
      "transliteration": "gur paarabraham paramesar aap ||",
      "translation": "The Guru is the Supreme Lord God; He Himself is the Transcendent Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਠ ਪਹਰ ਨਾਨਕ ਗੁਰ ਜਾਪਿ ॥੪॥੧੬॥੬੭॥",
      "transliteration": "aath pahar naanak gur jaap ||4||16||67||",
      "translation": "Twenty-four hours a day, O Nanak, meditate on the Guru. ||4||16||67||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਪੇ ਪੇਡੁ ਬਿਸਥਾਰੀ ਸਾਖ ॥",
      "transliteration": "aape ped bisathaaree saakh ||",
      "translation": "He Himself is the tree, and the branches extending out.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਪਨੀ ਖੇਤੀ ਆਪੇ ਰਾਖ ॥੧॥",
      "transliteration": "apanee khetee aape raakh ||1||",
      "translation": "He Himself preserves His own crop. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਤ ਕਤ ਪੇਖਉ ਏਕੈ ਓਹੀ ॥",
      "transliteration": "jat kat pekhau ekai ohee ||",
      "translation": "Wherever I look, I see that One Lord alone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਘਟ ਘਟ ਅੰਤਰਿ ਆਪੇ ਸੋਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ghat ghat a(n)tar aape soee ||1|| rahaau ||",
      "translation": "Deep within each and every heart, He Himself is contained. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਪੇ ਸੂਰੁ ਕਿਰਣਿ ਬਿਸਥਾਰੁ ॥",
      "transliteration": "aape soor kiran bisathaar ||",
      "translation": "He Himself is the sun, and the rays emanating from it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੋਈ ਗੁਪਤੁ ਸੋਈ ਆਕਾਰੁ ॥੨॥",
      "transliteration": "soee gupat soee aakaar ||2||",
      "translation": "He is concealed, and He is revealed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਰਗੁਣ ਨਿਰਗੁਣ ਥਾਪੈ ਨਾਉ ॥",
      "transliteration": "saragun niragun thaapai naau ||",
      "translation": "He is said to be of the highest attributes, and without attributes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਦੁਹ ਮਿਲਿ ਏਕੈ ਕੀਨੋ ਠਾਉ ॥੩॥",
      "transliteration": "duh mil ekai keeno thaau ||3||",
      "translation": "Both converge onto His single point. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰਿ ਭ੍ਰਮੁ ਭਉ ਖੋਇਆ ॥",
      "transliteration": "kahu naanak gur bhram bhau khoiaa ||",
      "translation": "Says Nanak, the Guru has dispelled my doubt and fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਨਦ ਰੂਪੁ ਸਭੁ ਨੈਨ ਅਲੋਇਆ ॥੪॥੧੭॥੬੮॥",
      "transliteration": "anad roop sabh nain aloiaa ||4||17||68||",
      "translation": "With my eyes, I perceive the Lord, the embodiment of bliss, to be everywhere. ||4||17||68||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0387_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਉਕਤਿ ਸਿਆਨਪ ਕਿਛੂ ਨ ਜਾਨਾ ॥",
      "transliteration": "ukat siaanap kichhoo na jaanaa ||",
      "translation": "I know nothing of arguments or cleverness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 387,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
