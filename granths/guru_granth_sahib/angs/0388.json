{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 388,
  "lineCount": 53,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0388_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦਿਨੁ ਰੈਣਿ ਤੇਰਾ ਨਾਮੁ ਵਖਾਨਾ ॥੧॥",
      "transliteration": "din rain teraa naam vakhaanaa ||1||",
      "translation": "Day and night, I chant Your Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮੈ ਨਿਰਗੁਨ ਗੁਣੁ ਨਾਹੀ ਕੋਇ ॥",
      "transliteration": "mai niragun gun naahee koi ||",
      "translation": "I am worthless; I have no virtue at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨਹਾਰ ਪ੍ਰਭ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "karan karaavanahaar prabh soi ||1|| rahaau ||",
      "translation": "God is the Creator, the Cause of all causes. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮੂਰਖ ਮੁਗਧ ਅਗਿਆਨ ਅਵੀਚਾਰੀ ॥",
      "transliteration": "moorakh mugadh agiaan aveechaaree ||",
      "translation": "I am foolish, stupid, ignorant and thoughtless;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਮ ਤੇਰੇ ਕੀ ਆਸ ਮਨਿ ਧਾਰੀ ॥੨॥",
      "transliteration": "naam tere kee aas man dhaaree ||2||",
      "translation": "Your Name is my mind's only hope. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਪੁ ਤਪੁ ਸੰਜਮੁ ਕਰਮ ਨ ਸਾਧਾ ॥",
      "transliteration": "jap tap sa(n)jam karam na saadhaa ||",
      "translation": "I have not practiced chanting, deep meditation, self-discipline or good actions;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਮੁ ਪ੍ਰਭੂ ਕਾ ਮਨਹਿ ਅਰਾਧਾ ॥੩॥",
      "transliteration": "naam prabhoo kaa manahi araadhaa ||3||",
      "translation": "but within my mind, I have worshipped God's Name. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿਛੂ ਨ ਜਾਨਾ ਮਤਿ ਮੇਰੀ ਥੋਰੀ ॥",
      "transliteration": "kichhoo na jaanaa mat meree thoree ||",
      "translation": "I know nothing, and my intellect is inadequate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਨਵਤਿ ਨਾਨਕ ਓਟ ਪ੍ਰਭ ਤੋਰੀ ॥੪॥੧੮॥੬੯॥",
      "transliteration": "binavat naanak ot prabh toree ||4||18||69||",
      "translation": "Prays Nanak, O God, You are my only Support. ||4||18||69||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਅਖਰ ਦੁਇ ਇਹ ਮਾਲਾ ॥",
      "transliteration": "har har akhar dui ih maalaa ||",
      "translation": "These two words, Har, Har, make up my maalaa.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਪਤ ਜਪਤ ਭਏ ਦੀਨ ਦਇਆਲਾ ॥੧॥",
      "transliteration": "japat japat bhae deen daiaalaa ||1||",
      "translation": "Continually chanting and reciting this rosary, God has become merciful to me, His humble servant. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਰਉ ਬੇਨਤੀ ਸਤਿਗੁਰ ਅਪੁਨੀ ॥",
      "transliteration": "karau benatee satigur apunee ||",
      "translation": "I offer my prayer to the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਰਾਖਹੁ ਸਰਣਾਈ ਮੋ ਕਉ ਦੇਹੁ ਹਰੇ ਹਰਿ ਜਪਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa raakhahu saranaaee mo kau dehu hare har japanee ||1|| rahaau ||",
      "translation": "Shower Your Mercy upon me, and keep me safe in Your Sanctuary; please, give me the maalaa, the rosary of Har, Har. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹਰਿ ਮਾਲਾ ਉਰ ਅੰਤਰਿ ਧਾਰੈ ॥",
      "transliteration": "har maalaa ur a(n)tar dhaarai ||",
      "translation": "One who enshrines this rosary of the Lord's Name within his heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਨਮ ਮਰਣ ਕਾ ਦੂਖੁ ਨਿਵਾਰੈ ॥੨॥",
      "transliteration": "janam maran kaa dookh nivaarai ||2||",
      "translation": "is freed of the pains of birth and death. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਿਰਦੈ ਸਮਾਲੈ ਮੁਖਿ ਹਰਿ ਹਰਿ ਬੋਲੈ ॥",
      "transliteration": "hiradai samaalai mukh har har bolai ||",
      "translation": "The humble being who contemplates the Lord within his heart, and chants the Lord's Name, Har, Har, with his mouth,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੋ ਜਨੁ ਇਤ ਉਤ ਕਤਹਿ ਨ ਡੋਲੈ ॥੩॥",
      "transliteration": "so jan it ut katahi na dolai ||3||",
      "translation": "never wavers, here or hereafter. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜੋ ਰਾਚੈ ਨਾਇ ॥",
      "transliteration": "kahu naanak jo raachai naai ||",
      "translation": "Says Nanak, one who is imbued with the Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਰਿ ਮਾਲਾ ਤਾ ਕੈ ਸੰਗਿ ਜਾਇ ॥੪॥੧੯॥੭੦॥",
      "transliteration": "har maalaa taa kai sa(n)g jaai ||4||19||70||",
      "translation": "goes to the next world with the maalaa of the Lord's Name. ||4||19||70||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਸ ਕਾ ਸਭੁ ਕਿਛੁ ਤਿਸ ਕਾ ਹੋਇ ॥",
      "transliteration": "jis kaa sabh kichh tis kaa hoi ||",
      "translation": "All things belong to Him - let yourself belong to Him as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਲੇਪੁ ਨ ਬਿਆਪੈ ਕੋਇ ॥੧॥",
      "transliteration": "tis jan lep na biaapai koi ||1||",
      "translation": "No stain clings to such a humble being. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਰਿ ਕਾ ਸੇਵਕੁ ਸਦ ਹੀ ਮੁਕਤਾ ॥",
      "transliteration": "har kaa sevak sad hee mukataa ||",
      "translation": "The Lord's servant is liberated forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕਰੈ ਸੋਈ ਭਲ ਜਨ ਕੈ ਅਤਿ ਨਿਰਮਲ ਦਾਸ ਕੀ ਜੁਗਤਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jo kichh karai soee bhal jan kai at niramal daas kee jugataa ||1|| rahaau ||",
      "translation": "Whatever He does, is pleasing to His servant; the way of life of His slave is immaculately pure. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਗਲ ਤਿਆਗਿ ਹਰਿ ਸਰਣੀ ਆਇਆ ॥",
      "transliteration": "sagal tiaag har saranee aaiaa ||",
      "translation": "One who renounces everything, and enters the Lord's Sanctuary",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਕਹਾ ਬਿਆਪੈ ਮਾਇਆ ॥੨॥",
      "transliteration": "tis jan kahaa biaapai maaiaa ||2||",
      "translation": "- how can Maya cling to him? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਮੁ ਨਿਧਾਨੁ ਜਾ ਕੇ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "naam nidhaan jaa ke man maahi ||",
      "translation": "With the treasure of the Naam, the Name of the Lord, in his mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਸ ਕਉ ਚਿੰਤਾ ਸੁਪਨੈ ਨਾਹਿ ॥੩॥",
      "transliteration": "tis kau chi(n)taa supanai naahi ||3||",
      "translation": "he suffers no anxiety, even in dreams. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰੁ ਪੂਰਾ ਪਾਇਆ ॥",
      "transliteration": "kahu naanak gur pooraa paaiaa ||",
      "translation": "Says Nanak, I have found the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਰਮੁ ਮੋਹੁ ਸਗਲ ਬਿਨਸਾਇਆ ॥੪॥੨੦॥੭੧॥",
      "transliteration": "bharam mohu sagal binasaaiaa ||4||20||71||",
      "translation": "My doubts and attachments have been totally obliterated. ||4||20||71||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਉ ਸੁਪ੍ਰਸੰਨ ਹੋਇਓ ਪ੍ਰਭੁ ਮੇਰਾ ॥",
      "transliteration": "jau suprasa(n)n hoio prabh meraa ||",
      "translation": "When my God is totally pleased with me,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਾਂ ਦੂਖੁ ਭਰਮੁ ਕਹੁ ਕੈਸੇ ਨੇਰਾ ॥੧॥",
      "transliteration": "taa(n) dookh bharam kahu kaise neraa ||1||",
      "translation": "then, tell me, how can suffering or doubt draw near me? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੁਨਿ ਸੁਨਿ ਜੀਵਾ ਸੋਇ ਤੁਮੑਾਰੀ ॥",
      "transliteration": "sun sun jeevaa soi tumhaaree ||",
      "translation": "Continually listening to Your Glory, I live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੋਹਿ ਨਿਰਗੁਨ ਕਉ ਲੇਹੁ ਉਧਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mohi niragun kau lehu udhaaree ||1|| rahaau ||",
      "translation": "I am worthless - save me, O Lord! ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਿਟਿ ਗਇਆ ਦੂਖੁ ਬਿਸਾਰੀ ਚਿੰਤਾ ॥",
      "transliteration": "mit gaiaa dookh bisaaree chi(n)taa ||",
      "translation": "My suffering has been ended, and my anxiety is forgotten.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਫਲੁ ਪਾਇਆ ਜਪਿ ਸਤਿਗੁਰ ਮੰਤਾ ॥੨॥",
      "transliteration": "phal paaiaa jap satigur ma(n)taa ||2||",
      "translation": "I have obtained my reward, chanting the Mantra of the True Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੋਈ ਸਤਿ ਸਤਿ ਹੈ ਸੋਇ ॥",
      "transliteration": "soee sat sat hai soi ||",
      "translation": "He is True, and True is His glory.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਰਖੁ ਕੰਠਿ ਪਰੋਇ ॥੩॥",
      "transliteration": "simar simar rakh ka(n)th paroi ||3||",
      "translation": "Remembering, remembering Him in meditation, keep Him clasped to your heart. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਕਉਨ ਉਹ ਕਰਮਾ ॥",
      "transliteration": "kahu naanak kaun uh karamaa ||",
      "translation": "Says Nanak, what action is there left to do,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਾ ਕੈ ਮਨਿ ਵਸਿਆ ਹਰਿ ਨਾਮਾ ॥੪॥੨੧॥੭੨॥",
      "transliteration": "jaa kai man vasiaa har naamaa ||4||21||72||",
      "translation": "by one whose mind is filled with the Lord's Name? ||4||21||72||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਾਮਿ ਕ੍ਰੋਧਿ ਅਹੰਕਾਰਿ ਵਿਗੂਤੇ ॥",
      "transliteration": "kaam krodh aha(n)kaar vigoote ||",
      "translation": "Sexual desire, anger, and egotism lead to ruin.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨੁ ਕਰਿ ਹਰਿ ਜਨ ਛੂਟੇ ॥੧॥",
      "transliteration": "har simaran kar har jan chhoote ||1||",
      "translation": "Meditating on the Lord, the Lord's humble servants are redeemed. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੋਇ ਰਹੇ ਮਾਇਆ ਮਦ ਮਾਤੇ ॥",
      "transliteration": "soi rahe maaiaa mad maate ||",
      "translation": "The mortals are asleep, intoxicated with the wine of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਾਗਤ ਭਗਤ ਸਿਮਰਤ ਹਰਿ ਰਾਤੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaagat bhagat simarat har raate ||1|| rahaau ||",
      "translation": "The devotees remain awake, imbued with the Lord's meditation. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੋਹ ਭਰਮਿ ਬਹੁ ਜੋਨਿ ਭਵਾਇਆ ॥",
      "transliteration": "moh bharam bahu jon bhavaaiaa ||",
      "translation": "In emotional attachment and doubt, the mortals wander through countless incarnations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਸਥਿਰੁ ਭਗਤ ਹਰਿ ਚਰਣ ਧਿਆਇਆ ॥੨॥",
      "transliteration": "asathir bhagat har charan dhiaaiaa ||2||",
      "translation": "The devotees remain ever-stable, meditating on the Lord's Lotus Feet. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬੰਧਨ ਅੰਧ ਕੂਪ ਗ੍ਰਿਹ ਮੇਰਾ ॥",
      "transliteration": "ba(n)dhan a(n)dh koop grih meraa ||",
      "translation": "Bound to household and possessions, the mortals are lost in the deep, dark pit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮੁਕਤੇ ਸੰਤ ਬੁਝਹਿ ਹਰਿ ਨੇਰਾ ॥੩॥",
      "transliteration": "mukate sa(n)t bujhahi har neraa ||3||",
      "translation": "The Saints are liberated, knowing the Lord to be near at hand. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜੋ ਪ੍ਰਭ ਸਰਣਾਈ ॥",
      "transliteration": "kahu naanak jo prabh saranaaee ||",
      "translation": "Says Nanak, one who has taken to God's Sanctuary,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0388_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਈਹਾ ਸੁਖੁ ਆਗੈ ਗਤਿ ਪਾਈ ॥੪॥੨੨॥੭੩॥",
      "transliteration": "eehaa sukh aagai gat paaee ||4||22||73||",
      "translation": "obtains peace in this world, and salvation in the world hereafter. ||4||22||73||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 388,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
