{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 389,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0389_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤੂ ਮੇਰਾ ਤਰੰਗੁ ਹਮ ਮੀਨ ਤੁਮਾਰੇ ॥",
      "transliteration": "too meraa tara(n)g ham meen tumaare ||",
      "translation": "You are my waves, and I am Your fish.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤੂ ਮੇਰਾ ਠਾਕੁਰੁ ਹਮ ਤੇਰੈ ਦੁਆਰੇ ॥੧॥",
      "transliteration": "too meraa thaakur ham terai duaare ||1||",
      "translation": "You are my Lord and Master; I wait at Your Door. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤੂੰ ਮੇਰਾ ਕਰਤਾ ਹਉ ਸੇਵਕੁ ਤੇਰਾ ॥",
      "transliteration": "too(n) meraa karataa hau sevak teraa ||",
      "translation": "You are my Creator, and I am Your servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਰਣਿ ਗਹੀ ਪ੍ਰਭ ਗੁਨੀ ਗਹੇਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saran gahee prabh gunee gaheraa ||1|| rahaau ||",
      "translation": "I have taken to Your Sanctuary, O God, most profound and excellent. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੂ ਮੇਰਾ ਜੀਵਨੁ ਤੂ ਆਧਾਰੁ ॥",
      "transliteration": "too meraa jeevan too aadhaar ||",
      "translation": "You are my life, You are my Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੁਝਹਿ ਪੇਖਿ ਬਿਗਸੈ ਕਉਲਾਰੁ ॥੨॥",
      "transliteration": "tujhahi pekh bigasai kaulaar ||2||",
      "translation": "Beholding You, my heart-lotus blossoms forth. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੂ ਮੇਰੀ ਗਤਿ ਪਤਿ ਤੂ ਪਰਵਾਨੁ ॥",
      "transliteration": "too meree gat pat too paravaan ||",
      "translation": "You are my salvation and honor; You make me acceptable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤੂ ਸਮਰਥੁ ਮੈ ਤੇਰਾ ਤਾਣੁ ॥੩॥",
      "transliteration": "too samarath mai teraa taan ||3||",
      "translation": "You are All-powerful, You are my strength. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਨਦਿਨੁ ਜਪਉ ਨਾਮ ਗੁਣਤਾਸਿ ॥",
      "transliteration": "anadin japau naam gunataas ||",
      "translation": "Night and day, I chant the Naam, the Name of the Lord, the treasure of excellence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਨਕ ਕੀ ਪ੍ਰਭ ਪਹਿ ਅਰਦਾਸਿ ॥੪॥੨੩॥੭੪॥",
      "transliteration": "naanak kee prabh pahi aradaas ||4||23||74||",
      "translation": "This is Nanak's prayer to God. ||4||23||74||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰੋਵਨਹਾਰੈ ਝੂਠੁ ਕਮਾਨਾ ॥",
      "transliteration": "rovanahaarai jhooth kamaanaa ||",
      "translation": "The mourner practices falsehood;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਸਿ ਹਸਿ ਸੋਗੁ ਕਰਤ ਬੇਗਾਨਾ ॥੧॥",
      "transliteration": "has has sog karat begaanaa ||1||",
      "translation": "he laughs with glee, while mourning for others. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕੋ ਮੂਆ ਕਾ ਕੈ ਘਰਿ ਗਾਵਨੁ ॥",
      "transliteration": "ko mooaa kaa kai ghar gaavan ||",
      "translation": "Someone has died, while there is singing in someone else's house.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕੋ ਰੋਵੈ ਕੋ ਹਸਿ ਹਸਿ ਪਾਵਨੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ko rovai ko has has paavan ||1|| rahaau ||",
      "translation": "One mourns and bewails, while another laughs with glee. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਾਲ ਬਿਵਸਥਾ ਤੇ ਬਿਰਧਾਨਾ ॥",
      "transliteration": "baal bivasathaa te biradhaanaa ||",
      "translation": "From childhood to old age,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਹੁਚਿ ਨ ਮੂਕਾ ਫਿਰਿ ਪਛੁਤਾਨਾ ॥੨॥",
      "transliteration": "pahuch na mookaa phir pachhutaanaa ||2||",
      "translation": "the mortal does not attain his goals, and he comes to regret in the end. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤ੍ਰਿਹੁ ਗੁਣ ਮਹਿ ਵਰਤੈ ਸੰਸਾਰਾ ॥",
      "transliteration": "trihu gun mahi varatai sa(n)saaraa ||",
      "translation": "The world is under the influence of the three qualities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਰਕ ਸੁਰਗ ਫਿਰਿ ਫਿਰਿ ਅਉਤਾਰਾ ॥੩॥",
      "transliteration": "narak surag phir phir autaaraa ||3||",
      "translation": "The mortal is reincarnated, again and again, into heaven and hell. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜੋ ਲਾਇਆ ਨਾਮ ॥",
      "transliteration": "kahu naanak jo laaiaa naam ||",
      "translation": "Says Nanak, one who is attached to the Naam, the Name of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਫਲ ਜਨਮੁ ਤਾ ਕਾ ਪਰਵਾਨ ॥੪॥੨੪॥੭੫॥",
      "transliteration": "saphal janam taa kaa paravaan ||4||24||75||",
      "translation": "becomes acceptable, and his life becomes fruitful. ||4||24||75||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੋਇ ਰਹੀ ਪ੍ਰਭ ਖਬਰਿ ਨ ਜਾਨੀ ॥",
      "transliteration": "soi rahee prabh khabar na jaanee ||",
      "translation": "She remains asleep, and does not know the news of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭੋਰੁ ਭਇਆ ਬਹੁਰਿ ਪਛੁਤਾਨੀ ॥੧॥",
      "transliteration": "bhor bhaiaa bahur pachhutaanee ||1||",
      "translation": "The day dawns, and then, she regrets. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪ੍ਰਿਅ ਪ੍ਰੇਮ ਸਹਜਿ ਮਨਿ ਅਨਦੁ ਧਰਉ ਰੀ ॥",
      "transliteration": "pri prem sahaj man anad dharau ree ||",
      "translation": "Loving the Beloved, the mind is filled with celestial bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪ੍ਰਭ ਮਿਲਬੇ ਕੀ ਲਾਲਸਾ ਤਾ ਤੇ ਆਲਸੁ ਕਹਾ ਕਰਉ ਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "prabh milabe kee laalasaa taa te aalas kahaa karau ree ||1|| rahaau ||",
      "translation": "You yearn to meet with God, so why do you delay? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਰ ਮਹਿ ਅੰਮ੍ਰਿਤੁ ਆਣਿ ਨਿਸਾਰਿਓ ॥",
      "transliteration": "kar mahi a(n)mrit aan nisaario ||",
      "translation": "He came and poured His Ambrosial Nectar into your hands,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਖਿਸਰਿ ਗਇਓ ਭੂਮ ਪਰਿ ਡਾਰਿਓ ॥੨॥",
      "transliteration": "khisar gaio bhoom par daario ||2||",
      "translation": "but it slipped through your fingers, and fell onto the ground. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਦਿ ਮੋਹਿ ਲਾਦੀ ਅਹੰਕਾਰੇ ॥",
      "transliteration": "saad mohi laadee aha(n)kaare ||",
      "translation": "You are burdened with desire, emotional attachment and egotism;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦੋਸੁ ਨਾਹੀ ਪ੍ਰਭ ਕਰਣੈਹਾਰੇ ॥੩॥",
      "transliteration": "dos naahee prabh karanaihaare ||3||",
      "translation": "it is not the fault of God the Creator. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਮਿਟੇ ਭਰਮ ਅੰਧਾਰੇ ॥",
      "transliteration": "saadhasa(n)g mite bharam a(n)dhaare ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, the darkness of doubt is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਨਕ ਮੇਲੀ ਸਿਰਜਣਹਾਰੇ ॥੪॥੨੫॥੭੬॥",
      "transliteration": "naanak melee sirajanahaare ||4||25||76||",
      "translation": "O Nanak, the Creator Lord blends us with Himself. ||4||25||76||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਕੀ ਆਸ ਪਿਆਰੇ ॥",
      "transliteration": "charan kamal kee aas piaare ||",
      "translation": "I long for the Lotus Feet of my Beloved Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਮਕੰਕਰ ਨਸਿ ਗਏ ਵਿਚਾਰੇ ॥੧॥",
      "transliteration": "jamaka(n)kar nas gae vichaare ||1||",
      "translation": "The wretched Messenger of Death has run away from me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤੂ ਚਿਤਿ ਆਵਹਿ ਤੇਰੀ ਮਇਆ ॥",
      "transliteration": "too chit aavahi teree maiaa ||",
      "translation": "You enter into my mind, by Your Kind Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਿਮਰਤ ਨਾਮ ਸਗਲ ਰੋਗ ਖਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "simarat naam sagal rog khaiaa ||1|| rahaau ||",
      "translation": "Meditating on the Naam, the Name of the Lord, all diseases are destroyed. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਨਿਕ ਦੂਖ ਦੇਵਹਿ ਅਵਰਾ ਕਉ ॥",
      "transliteration": "anik dookh devahi avaraa kau ||",
      "translation": "Death gives so much pain to others,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਹੁਚਿ ਨ ਸਾਕਹਿ ਜਨ ਤੇਰੇ ਕਉ ॥੨॥",
      "transliteration": "pahuch na saakahi jan tere kau ||2||",
      "translation": "but it cannot even come near Your slave. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦਰਸ ਤੇਰੇ ਕੀ ਪਿਆਸ ਮਨਿ ਲਾਗੀ ॥",
      "transliteration": "daras tere kee piaas man laagee ||",
      "translation": "My mind thirsts for Your Vision;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਹਜ ਅਨੰਦ ਬਸੈ ਬੈਰਾਗੀ ॥੩॥",
      "transliteration": "sahaj ana(n)d basai bairaagee ||3||",
      "translation": "in peaceful ease and bliss, I dwell in detachment. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਨਕ ਕੀ ਅਰਦਾਸਿ ਸੁਣੀਜੈ ॥",
      "transliteration": "naanak kee aradaas suneejai ||",
      "translation": "Hear this prayer of Nanak:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕੇਵਲ ਨਾਮੁ ਰਿਦੇ ਮਹਿ ਦੀਜੈ ॥੪॥੨੬॥੭੭॥",
      "transliteration": "keval naam ride mahi deejai ||4||26||77||",
      "translation": "please, infuse Your Name into his heart. ||4||26||77||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਨੁ ਤ੍ਰਿਪਤਾਨੋ ਮਿਟੇ ਜੰਜਾਲ ॥",
      "transliteration": "man tripataano mite ja(n)jaal ||",
      "translation": "My mind is satisfied, and my entanglements have been dissolved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰਭੁ ਅਪੁਨਾ ਹੋਇਆ ਕਿਰਪਾਲ ॥੧॥",
      "transliteration": "prabh apunaa hoiaa kirapaal ||1||",
      "translation": "God has become merciful to me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਭਲੀ ਬਨੀ ॥",
      "transliteration": "sa(n)t prasaad bhalee banee ||",
      "translation": "By the Grace of the Saints, everything has turned out well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਾ ਕੈ ਗ੍ਰਿਹਿ ਸਭੁ ਕਿਛੁ ਹੈ ਪੂਰਨੁ ਸੋ ਭੇਟਿਆ ਨਿਰਭੈ ਧਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaa kai grihi sabh kichh hai pooran so bhetiaa nirabhai dhanee ||1|| rahaau ||",
      "translation": "His House is overflowing with all things; I have met Him, the Fearless Master. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਮੁ ਦ੍ਰਿੜਾਇਆ ਸਾਧ ਕ੍ਰਿਪਾਲ ॥",
      "transliteration": "naam driRaaiaa saadh kripaal ||",
      "translation": "By the Kind Mercy of the Holy Saints, the Naam has been implanted within me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮਿਟਿ ਗਈ ਭੂਖ ਮਹਾ ਬਿਕਰਾਲ ॥੨॥",
      "transliteration": "mit gaee bhookh mahaa bikaraal ||2||",
      "translation": "The most dreadful desires have been eliminated. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਠਾਕੁਰਿ ਅਪੁਨੈ ਕੀਨੀ ਦਾਤਿ ॥",
      "transliteration": "thaakur apunai keenee daat ||",
      "translation": "My Master has given me a gift;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਲਨਿ ਬੁਝੀ ਮਨਿ ਹੋਈ ਸਾਂਤਿ ॥੩॥",
      "transliteration": "jalan bujhee man hoee saa(n)t ||3||",
      "translation": "the fire has been extinguished, and my mind is now at peace. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0389_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮਿਟਿ ਗਈ ਭਾਲ ਮਨੁ ਸਹਜਿ ਸਮਾਨਾ ॥",
      "transliteration": "mit gaee bhaal man sahaj samaanaa ||",
      "translation": "My search has ended, and my mind is absorbed in celestial bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 389,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
