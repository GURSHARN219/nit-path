{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 390,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0390_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਨਕ ਪਾਇਆ ਨਾਮ ਖਜਾਨਾ ॥੪॥੨੭॥੭੮॥",
      "transliteration": "naanak paaiaa naam khajaanaa ||4||27||78||",
      "translation": "Nanak has obtained the treasure of the Naam, the Name of the Lord. ||4||27||78||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਠਾਕੁਰ ਸਿਉ ਜਾ ਕੀ ਬਨਿ ਆਈ ॥",
      "transliteration": "thaakur siu jaa kee ban aaee ||",
      "translation": "Those who are attuned to their Lord and Master",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭੋਜਨ ਪੂਰਨ ਰਹੇ ਅਘਾਈ ॥੧॥",
      "transliteration": "bhojan pooran rahe aghaaee ||1||",
      "translation": "are satisfied and fulfilled with the perfect food. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਛੂ ਨ ਥੋਰਾ ਹਰਿ ਭਗਤਨ ਕਉ ॥",
      "transliteration": "kachhoo na thoraa har bhagatan kau ||",
      "translation": "The Lord's devotees never run short of anything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਖਾਤ ਖਰਚਤ ਬਿਲਛਤ ਦੇਵਨ ਕਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "khaat kharachat bilachhat devan kau ||1|| rahaau ||",
      "translation": "They have plenty to eat, spend, enjoy and give. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਾ ਕਾ ਧਨੀ ਅਗਮ ਗੁਸਾਈ ॥",
      "transliteration": "jaa kaa dhanee agam gusaaee ||",
      "translation": "One who has the Unfathomable Lord of the Universe as his Master",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਾਨੁਖ ਕੀ ਕਹੁ ਕੇਤ ਚਲਾਈ ॥੨॥",
      "transliteration": "maanukh kee kahu ket chalaaee ||2||",
      "translation": "- how can any mere mortal stand up to him? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਾ ਕੀ ਸੇਵਾ ਦਸ ਅਸਟ ਸਿਧਾਈ ॥",
      "transliteration": "jaa kee sevaa das asat sidhaaee ||",
      "translation": "One who is served by the eighteen supernatural powers of the Siddhas",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਲਕ ਦਿਸਟਿ ਤਾ ਕੀ ਲਾਗਹੁ ਪਾਈ ॥੩॥",
      "transliteration": "palak disat taa kee laagahu paaee ||3||",
      "translation": "- grasp his feet, even for an instant. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਾ ਕਉ ਦਇਆ ਕਰਹੁ ਮੇਰੇ ਸੁਆਮੀ ॥",
      "transliteration": "jaa kau daiaa karahu mere suaamee ||",
      "translation": "That one, upon whom You have showered Your Mercy, O my Lord Master",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਨਾਹੀ ਤਿਨ ਕਾਮੀ ॥੪॥੨੮॥੭੯॥",
      "transliteration": "kahu naanak naahee tin kaamee ||4||28||79||",
      "translation": "- says Nanak, he does not lack anything. ||4||28||79||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਉ ਮੈ ਅਪੁਨਾ ਸਤਿਗੁਰੁ ਧਿਆਇਆ ॥",
      "transliteration": "jau mai apunaa satigur dhiaaiaa ||",
      "translation": "When I meditate on my True Guru,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਬ ਮੇਰੈ ਮਨਿ ਮਹਾ ਸੁਖੁ ਪਾਇਆ ॥੧॥",
      "transliteration": "tab merai man mahaa sukh paaiaa ||1||",
      "translation": "my mind becomes supremely peaceful. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਿਟਿ ਗਈ ਗਣਤ ਬਿਨਾਸਿਉ ਸੰਸਾ ॥",
      "transliteration": "mit gaee ganat binaasiu sa(n)saa ||",
      "translation": "The record of my account is erased, and my doubts are dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਜਨ ਭਏ ਭਗਵੰਤਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naam rate jan bhae bhagava(n)taa ||1|| rahaau ||",
      "translation": "Imbued with the Naam, the Name of the Lord, His humble servant is blessed with good fortune. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਉ ਮੈ ਅਪੁਨਾ ਸਾਹਿਬੁ ਚੀਤਿ ॥",
      "transliteration": "jau mai apunaa saahib cheet ||",
      "translation": "When I remember my Lord and Master,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਉ ਭਉ ਮਿਟਿਓ ਮੇਰੇ ਮੀਤ ॥੨॥",
      "transliteration": "tau bhau mitio mere meet ||2||",
      "translation": "my fears are dispelled, O my friend. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਉ ਮੈ ਓਟ ਗਹੀ ਪ੍ਰਭ ਤੇਰੀ ॥",
      "transliteration": "jau mai ot gahee prabh teree ||",
      "translation": "When I took to Your Protection, O God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਾਂ ਪੂਰਨ ਹੋਈ ਮਨਸਾ ਮੇਰੀ ॥੩॥",
      "transliteration": "taa(n) pooran hoee manasaa meree ||3||",
      "translation": "my desires were fulfilled. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੇਖਿ ਚਲਿਤ ਮਨਿ ਭਏ ਦਿਲਾਸਾ ॥",
      "transliteration": "dekh chalit man bhae dilaasaa ||",
      "translation": "Gazing upon the wonder of Your play, my mind has become encouraged.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਤੇਰਾ ਭਰਵਾਸਾ ॥੪॥੨੯॥੮੦॥",
      "transliteration": "naanak daas teraa bharavaasaa ||4||29||80||",
      "translation": "Servant Nanak relies on You alone. ||4||29||80||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਨਦਿਨੁ ਮੂਸਾ ਲਾਜੁ ਟੁਕਾਈ ॥",
      "transliteration": "anadin moosaa laaj tukaaee ||",
      "translation": "Night and day, the mouse of time gnaws away at the rope of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗਿਰਤ ਕੂਪ ਮਹਿ ਖਾਹਿ ਮਿਠਾਈ ॥੧॥",
      "transliteration": "girat koop mahi khaahi mithaaee ||1||",
      "translation": "Falling into the well, the mortal eats the sweet treats of Maya. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੋਚਤ ਸਾਚਤ ਰੈਨਿ ਬਿਹਾਨੀ ॥",
      "transliteration": "sochat saachat rain bihaanee ||",
      "translation": "Thinking and planning, the night of the life is passing away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਨਿਕ ਰੰਗ ਮਾਇਆ ਕੇ ਚਿਤਵਤ ਕਬਹੂ ਨ ਸਿਮਰੈ ਸਾਰਿੰਗਪਾਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "anik ra(n)g maaiaa ke chitavat kabahoo na simarai saari(n)gapaanee ||1|| rahaau ||",
      "translation": "Thinking of the many pleasures of Maya, the mortal never remembers the Lord, the Sustainer of the earth. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦ੍ਰੁਮ ਕੀ ਛਾਇਆ ਨਿਹਚਲ ਗ੍ਰਿਹੁ ਬਾਂਧਿਆ ॥",
      "transliteration": "drum kee chhaaiaa nihachal grihu baa(n)dhiaa ||",
      "translation": "Believing the shade of the tree to be permanent, he builds his house beneath it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਾਲ ਕੈ ਫਾਂਸਿ ਸਕਤ ਸਰੁ ਸਾਂਧਿਆ ॥੨॥",
      "transliteration": "kaal kai phaa(n)s sakat sar saa(n)dhiaa ||2||",
      "translation": "But the noose of death is around his neck, and Shakti, the power of Maya, has aimed her arrows at him. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਾਲੂ ਕਨਾਰਾ ਤਰੰਗ ਮੁਖਿ ਆਇਆ ॥",
      "transliteration": "baaloo kanaaraa tara(n)g mukh aaiaa ||",
      "translation": "The sandy shore is being washed away by the waves,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੋ ਥਾਨੁ ਮੂੜਿ ਨਿਹਚਲੁ ਕਰਿ ਪਾਇਆ ॥੩॥",
      "transliteration": "so thaan mooR nihachal kar paaiaa ||3||",
      "translation": "but the fool still believes that place to be permanent. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਜਪਿਓ ਹਰਿ ਰਾਇ ॥",
      "transliteration": "saadhasa(n)g japio har raai ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, chant the Name of the Lord, the King.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਨਕ ਜੀਵੈ ਹਰਿ ਗੁਣ ਗਾਇ ॥੪॥੩੦॥੮੧॥",
      "transliteration": "naanak jeevai har gun gaai ||4||30||81||",
      "translation": "Nanak lives by singing the Glorious Praises of the Lord. ||4||30||81||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ਦੁਤੁਕੇ ੯ ॥",
      "transliteration": "aasaa mahalaa 5 dutuke 9 ||",
      "translation": "Aasaa, Fifth Mehl, Dho-Thukay 9:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਉਨ ਕੈ ਸੰਗਿ ਤੂ ਕਰਤੀ ਕੇਲ ॥",
      "transliteration": "un kai sa(n)g too karatee kel ||",
      "translation": "With that, you are engaged in playful sport;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਉਨ ਕੈ ਸੰਗਿ ਹਮ ਤੁਮ ਸੰਗਿ ਮੇਲ ॥",
      "transliteration": "un kai sa(n)g ham tum sa(n)g mel ||",
      "translation": "with that, I am joined to you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਉਨੑ ਕੈ ਸੰਗਿ ਤੁਮ ਸਭੁ ਕੋਊ ਲੋਰੈ ॥",
      "transliteration": "unh kai sa(n)g tum sabh kooo lorai ||",
      "translation": "With that, everyone longs for you;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਓਸੁ ਬਿਨਾ ਕੋਊ ਮੁਖੁ ਨਹੀ ਜੋਰੈ ॥੧॥",
      "transliteration": "os binaa kooo mukh nahee jorai ||1||",
      "translation": "without it, no one would even look at your face. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤੇ ਬੈਰਾਗੀ ਕਹਾ ਸਮਾਏ ॥",
      "transliteration": "te bairaagee kahaa samaae ||",
      "translation": "Where is that detached soul now contained?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਿਸੁ ਬਿਨੁ ਤੁਹੀ ਦੁਹੇਰੀ ਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tis bin tuhee duheree ree ||1|| rahaau ||",
      "translation": "Without it, you are miserable. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਉਨੑ ਕੈ ਸੰਗਿ ਤੂ ਗ੍ਰਿਹ ਮਹਿ ਮਾਹਰਿ ॥",
      "transliteration": "unh kai sa(n)g too grih mahi maahar ||",
      "translation": "With that, you are the woman of the house;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਉਨੑ ਕੈ ਸੰਗਿ ਤੂ ਹੋਈ ਹੈ ਜਾਹਰਿ ॥",
      "transliteration": "unh kai sa(n)g too hoee hai jaahar ||",
      "translation": "with that, you are respected.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਉਨੑ ਕੈ ਸੰਗਿ ਤੂ ਰਖੀ ਪਪੋਲਿ ॥",
      "transliteration": "unh kai sa(n)g too rakhee papol ||",
      "translation": "With that, you are caressed;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਓਸੁ ਬਿਨਾ ਤੂੰ ਛੁਟਕੀ ਰੋਲਿ ॥੨॥",
      "transliteration": "os binaa too(n) chhutakee rol ||2||",
      "translation": "without it, you are reduced to dust. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਉਨੑ ਕੈ ਸੰਗਿ ਤੇਰਾ ਮਾਨੁ ਮਹਤੁ ॥",
      "transliteration": "unh kai sa(n)g teraa maan mahat ||",
      "translation": "With that, you have honor and respect;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਉਨੑ ਕੈ ਸੰਗਿ ਤੁਮ ਸਾਕੁ ਜਗਤੁ ॥",
      "transliteration": "unh kai sa(n)g tum saak jagat ||",
      "translation": "with that, you have relatives in the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਉਨੑ ਕੈ ਸੰਗਿ ਤੇਰੀ ਸਭ ਬਿਧਿ ਥਾਟੀ ॥",
      "transliteration": "unh kai sa(n)g teree sabh bidh thaatee ||",
      "translation": "With that, you are adorned in every way;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਓਸੁ ਬਿਨਾ ਤੂੰ ਹੋਈ ਹੈ ਮਾਟੀ ॥੩॥",
      "transliteration": "os binaa too(n) hoee hai maatee ||3||",
      "translation": "without it, you are reduced to dust. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਓਹੁ ਬੈਰਾਗੀ ਮਰੈ ਨ ਜਾਇ ॥",
      "transliteration": "ohu bairaagee marai na jaai ||",
      "translation": "That detached soul is neither born, nor dies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹੁਕਮੇ ਬਾਧਾ ਕਾਰ ਕਮਾਇ ॥",
      "transliteration": "hukame baadhaa kaar kamaai ||",
      "translation": "It acts according to the Command of the Lord's Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜੋੜਿ ਵਿਛੋੜੇ ਨਾਨਕ ਥਾਪਿ ॥",
      "transliteration": "joR vichhoRe naanak thaap ||",
      "translation": "O Nanak, having fashioned the body, the Lord unites the soul with it, and separates them again;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅਪਨੀ ਕੁਦਰਤਿ ਜਾਣੈ ਆਪਿ ॥੪॥੩੧॥੮੨॥",
      "transliteration": "apanee kudarat jaanai aap ||4||31||82||",
      "translation": "He alone knows His All-powerful creative nature. ||4||31||82||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0390_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 390,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
