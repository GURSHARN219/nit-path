{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 391,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0391_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾ ਓਹੁ ਮਰਤਾ ਨਾ ਹਮ ਡਰਿਆ ॥",
      "transliteration": "naa ohu marataa naa ham dariaa ||",
      "translation": "He does not die, so I do not fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾ ਓਹੁ ਬਿਨਸੈ ਨਾ ਹਮ ਕੜਿਆ ॥",
      "transliteration": "naa ohu binasai naa ham kaRiaa ||",
      "translation": "He does not perish, so I do not grieve.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾ ਓਹੁ ਨਿਰਧਨੁ ਨਾ ਹਮ ਭੂਖੇ ॥",
      "transliteration": "naa ohu niradhan naa ham bhookhe ||",
      "translation": "He is not poor, so I do not hunger.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾ ਓਸੁ ਦੂਖੁ ਨ ਹਮ ਕਉ ਦੂਖੇ ॥੧॥",
      "transliteration": "naa os dookh na ham kau dookhe ||1||",
      "translation": "He is not in pain, so I do not suffer. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਵਰੁ ਨ ਕੋਊ ਮਾਰਨਵਾਰਾ ॥",
      "transliteration": "avar na kooo maaranavaaraa ||",
      "translation": "There is no other Destroyer than Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੀਅਉ ਹਮਾਰਾ ਜੀਉ ਦੇਨਹਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jeeau hamaaraa jeeu denahaaraa ||1|| rahaau ||",
      "translation": "He is my very life, the Giver of life. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾ ਉਸੁ ਬੰਧਨ ਨਾ ਹਮ ਬਾਧੇ ॥",
      "transliteration": "naa us ba(n)dhan naa ham baadhe ||",
      "translation": "He is not bound, so I am not in bondage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾ ਉਸੁ ਧੰਧਾ ਨਾ ਹਮ ਧਾਧੇ ॥",
      "transliteration": "naa us dha(n)dhaa naa ham dhaadhe ||",
      "translation": "He has no occupation, so I have no entanglements.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾ ਉਸੁ ਮੈਲੁ ਨ ਹਮ ਕਉ ਮੈਲਾ ॥",
      "transliteration": "naa us mail na ham kau mailaa ||",
      "translation": "He has no impurities, so I have no impurities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਓਸੁ ਅਨੰਦੁ ਤ ਹਮ ਸਦ ਕੇਲਾ ॥੨॥",
      "transliteration": "os ana(n)d ta ham sad kelaa ||2||",
      "translation": "He is in ecstasy, so I am always happy. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾ ਉਸੁ ਸੋਚੁ ਨ ਹਮ ਕਉ ਸੋਚਾ ॥",
      "transliteration": "naa us soch na ham kau sochaa ||",
      "translation": "He has no anxiety, so I have no cares.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾ ਉਸੁ ਲੇਪੁ ਨ ਹਮ ਕਉ ਪੋਚਾ ॥",
      "transliteration": "naa us lep na ham kau pochaa ||",
      "translation": "He has no stain, so I have no pollution.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾ ਉਸੁ ਭੂਖ ਨ ਹਮ ਕਉ ਤ੍ਰਿਸਨਾ ॥",
      "transliteration": "naa us bhookh na ham kau trisanaa ||",
      "translation": "He has no hunger, so I have no thirst.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾ ਉਹੁ ਨਿਰਮਲੁ ਤਾਂ ਹਮ ਜਚਨਾ ॥੩॥",
      "transliteration": "jaa uhu niramal taa(n) ham jachanaa ||3||",
      "translation": "Since He is immaculately pure, I correspond to Him. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹਮ ਕਿਛੁ ਨਾਹੀ ਏਕੈ ਓਹੀ ॥",
      "transliteration": "ham kichh naahee ekai ohee ||",
      "translation": "I am nothing; He is the One and only.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਆਗੈ ਪਾਛੈ ਏਕੋ ਸੋਈ ॥",
      "transliteration": "aagai paachhai eko soee ||",
      "translation": "Before and after, He alone exists.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਿ ਖੋਏ ਭ੍ਰਮ ਭੰਗਾ ॥",
      "transliteration": "naanak gur khoe bhram bha(n)gaa ||",
      "translation": "O Nanak, the Guru has taken away my doubts and mistakes;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹਮ ਓਇ ਮਿਲਿ ਹੋਏ ਇਕ ਰੰਗਾ ॥੪॥੩੨॥੮੩॥",
      "transliteration": "ham oi mil hoe ik ra(n)gaa ||4||32||83||",
      "translation": "He and I, joining together, are of the same color. ||4||32||83||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਨਿਕ ਭਾਂਤਿ ਕਰਿ ਸੇਵਾ ਕਰੀਐ ॥",
      "transliteration": "anik bhaa(n)t kar sevaa kareeai ||",
      "translation": "Serve Him in many different ways;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੀਉ ਪ੍ਰਾਨ ਧਨੁ ਆਗੈ ਧਰੀਐ ॥",
      "transliteration": "jeeu praan dhan aagai dhareeai ||",
      "translation": "Dedicate your soul, your breath of life and your wealth to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਾਨੀ ਪਖਾ ਕਰਉ ਤਜਿ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "paanee pakhaa karau taj abhimaan ||",
      "translation": "Carry water for Him, and wave the fan over Him - renounce your ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਨਿਕ ਬਾਰ ਜਾਈਐ ਕੁਰਬਾਨੁ ॥੧॥",
      "transliteration": "anik baar jaaeeai kurabaan ||1||",
      "translation": "Make yourself a sacrifice to Him, time and time again. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਾਈ ਸੁਹਾਗਣਿ ਜੋ ਪ੍ਰਭ ਭਾਈ ॥",
      "transliteration": "saaee suhaagan jo prabh bhaaee ||",
      "translation": "She alone is the happy soul-bride, who is pleasing to God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਸ ਕੈ ਸੰਗਿ ਮਿਲਉ ਮੇਰੀ ਮਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tis kai sa(n)g milau meree maaee ||1|| rahaau ||",
      "translation": "In her company, I may meet Him, O my mother. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦਾਸਨਿ ਦਾਸੀ ਕੀ ਪਨਿਹਾਰਿ ॥",
      "transliteration": "daasan daasee kee panihaar ||",
      "translation": "I am the water-carrier of the slaves of His slaves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਉਨੑ ਕੀ ਰੇਣੁ ਬਸੈ ਜੀਅ ਨਾਲਿ ॥",
      "transliteration": "unh kee ren basai jee naal ||",
      "translation": "I treasure in my soul the dust of their feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਾਥੈ ਭਾਗੁ ਤ ਪਾਵਉ ਸੰਗੁ ॥",
      "transliteration": "maathai bhaag ta paavau sa(n)g ||",
      "translation": "By that good destiny inscribed upon my forehead, I obtain their society.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਿਲੈ ਸੁਆਮੀ ਅਪੁਨੈ ਰੰਗਿ ॥੨॥",
      "transliteration": "milai suaamee apunai ra(n)g ||2||",
      "translation": "Through His Love, the Lord Master meets me. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਾਪ ਤਾਪ ਦੇਵਉ ਸਭ ਨੇਮਾ ॥",
      "transliteration": "jaap taap devau sabh nemaa ||",
      "translation": "I dedicate all to Him - chanting and meditation, austerity and religious observances.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਅਰਪਉ ਸਭ ਹੋਮਾ ॥",
      "transliteration": "karam dharam arapau sabh homaa ||",
      "translation": "I offer all to Him - good actions, righteous conduct and incense burning.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗਰਬੁ ਮੋਹੁ ਤਜਿ ਹੋਵਉ ਰੇਨ ॥",
      "transliteration": "garab mohu taj hovau ren ||",
      "translation": "Renouncing pride and attachment, I become the dust of the feet of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਉਨੑ ਕੈ ਸੰਗਿ ਦੇਖਉ ਪ੍ਰਭੁ ਨੈਨ ॥੩॥",
      "transliteration": "unh kai sa(n)g dekhau prabh nain ||3||",
      "translation": "In their society, I behold God with my eyes. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਿਮਖ ਨਿਮਖ ਏਹੀ ਆਰਾਧਉ ॥",
      "transliteration": "nimakh nimakh ehee aaraadhau ||",
      "translation": "Each and every moment, I contemplate and adore Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦਿਨਸੁ ਰੈਣਿ ਏਹ ਸੇਵਾ ਸਾਧਉ ॥",
      "transliteration": "dinas rain eh sevaa saadhau ||",
      "translation": "Day and night, I serve Him like this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਏ ਕ੍ਰਿਪਾਲ ਗੁਪਾਲ ਗੋਬਿੰਦ ॥",
      "transliteration": "bhae kripaal gupaal gobi(n)d ||",
      "translation": "The Lord of the Universe, the Cherisher of the World, has become merciful;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਨਾਨਕ ਬਖਸਿੰਦ ॥੪॥੩੩॥੮੪॥",
      "transliteration": "saadhasa(n)g naanak bakhasi(n)d ||4||33||84||",
      "translation": "in the Saadh Sangat, the Company of the Holy, O Nanak, He forgives us. ||4||33||84||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਪ੍ਰੀਤਿ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "prabh kee preet sadaa sukh hoi ||",
      "translation": "In the Love of God, eternal peace is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਪ੍ਰੀਤਿ ਦੁਖੁ ਲਗੈ ਨ ਕੋਇ ॥",
      "transliteration": "prabh kee preet dukh lagai na koi ||",
      "translation": "In the Love of God, one is not touched by pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਪ੍ਰੀਤਿ ਹਉਮੈ ਮਲੁ ਖੋਇ ॥",
      "transliteration": "prabh kee preet haumai mal khoi ||",
      "translation": "In the Love of God, the filth of ego is washed away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਪ੍ਰੀਤਿ ਸਦ ਨਿਰਮਲ ਹੋਇ ॥੧॥",
      "transliteration": "prabh kee preet sad niramal hoi ||1||",
      "translation": "In the Love of God, one becomes forever immaculate. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁਨਹੁ ਮੀਤ ਐਸਾ ਪ੍ਰੇਮ ਪਿਆਰੁ ॥",
      "transliteration": "sunahu meet aisaa prem piaar ||",
      "translation": "Listen, O friend: show such love and affection to God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੀਅ ਪ੍ਰਾਨ ਘਟ ਘਟ ਆਧਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jee praan ghat ghat aadhaar ||1|| rahaau ||",
      "translation": "the Support of the soul, the breath of life, of each and every heart. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਪ੍ਰੀਤਿ ਭਏ ਸਗਲ ਨਿਧਾਨ ॥",
      "transliteration": "prabh kee preet bhae sagal nidhaan ||",
      "translation": "In the Love of God, all treasures are obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਪ੍ਰੀਤਿ ਰਿਦੈ ਨਿਰਮਲ ਨਾਮ ॥",
      "transliteration": "prabh kee preet ridai niramal naam ||",
      "translation": "In the Love of God, the Immaculate Naam fills the heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਪ੍ਰੀਤਿ ਸਦ ਸੋਭਾਵੰਤ ॥",
      "transliteration": "prabh kee preet sad sobhaava(n)t ||",
      "translation": "In the Love of God, one is eternally embellished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਪ੍ਰੀਤਿ ਸਭ ਮਿਟੀ ਹੈ ਚਿੰਤ ॥੨॥",
      "transliteration": "prabh kee preet sabh mitee hai chi(n)t ||2||",
      "translation": "In the Love of God, all anxiety is ended. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਪ੍ਰੀਤਿ ਇਹੁ ਭਵਜਲੁ ਤਰੈ ॥",
      "transliteration": "prabh kee preet ihu bhavajal tarai ||",
      "translation": "In the Love of God, one crosses over this terrible world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਪ੍ਰੀਤਿ ਜਮ ਤੇ ਨਹੀ ਡਰੈ ॥",
      "transliteration": "prabh kee preet jam te nahee darai ||",
      "translation": "In the Love of God, one does not fear death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਪ੍ਰੀਤਿ ਸਗਲ ਉਧਾਰੈ ॥",
      "transliteration": "prabh kee preet sagal udhaarai ||",
      "translation": "In the Love of God, all are saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਪ੍ਰੀਤਿ ਚਲੈ ਸੰਗਾਰੈ ॥੩॥",
      "transliteration": "prabh kee preet chalai sa(n)gaarai ||3||",
      "translation": "The Love of God shall go along with you. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਆਪਹੁ ਕੋਈ ਮਿਲੈ ਨ ਭੂਲੈ ॥",
      "transliteration": "aapahu koee milai na bhoolai ||",
      "translation": "By himself, no one is united, and no one goes astray.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਿਸੁ ਕ੍ਰਿਪਾਲੁ ਤਿਸੁ ਸਾਧਸੰਗਿ ਘੂਲੈ ॥",
      "transliteration": "jis kripaal tis saadhasa(n)g ghoolai ||",
      "translation": "One who is blessed by God's Mercy, joins the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਤੇਰੈ ਕੁਰਬਾਣੁ ॥",
      "transliteration": "kahu naanak terai kurabaan ||",
      "translation": "Says Nanak, I am a sacrifice to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸੰਤ ਓਟ ਪ੍ਰਭ ਤੇਰਾ ਤਾਣੁ ॥੪॥੩੪॥੮੫॥",
      "transliteration": "sa(n)t ot prabh teraa taan ||4||34||85||",
      "translation": "O God, You are the Support and the Strength of the Saints. ||4||34||85||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਭੂਪਤਿ ਹੋਇ ਕੈ ਰਾਜੁ ਕਮਾਇਆ ॥",
      "transliteration": "bhoopat hoi kai raaj kamaaiaa ||",
      "translation": "Becoming a king, the mortal wields his royal authority;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0391_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਰਿ ਕਰਿ ਅਨਰਥ ਵਿਹਾਝੀ ਮਾਇਆ ॥",
      "transliteration": "kar kar anarath vihaajhee maaiaa ||",
      "translation": "oppressing the people, he gathers wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 391,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
