{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 392,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0392_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੰਚਤ ਸੰਚਤ ਥੈਲੀ ਕੀਨੑੀ ॥",
      "transliteration": "sa(n)chat sa(n)chat thailee keenhee ||",
      "translation": "Gathering it and collecting it, he fills his bags.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪ੍ਰਭਿ ਉਸ ਤੇ ਡਾਰਿ ਅਵਰ ਕਉ ਦੀਨੑੀ ॥੧॥",
      "transliteration": "prabh us te daar avar kau deenhee ||1||",
      "translation": "But God takes it away from him, and gives it to another. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਾਚ ਗਗਰੀਆ ਅੰਭ ਮਝਰੀਆ ॥",
      "transliteration": "kaach gagareeaa a(n)bh majhareeaa ||",
      "translation": "The mortal is like an unbaked clay pot in water;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗਰਬਿ ਗਰਬਿ ਉਆਹੂ ਮਹਿ ਪਰੀਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "garab garab uaahoo mahi pareeaa ||1|| rahaau ||",
      "translation": "indulging in pride and egotism, he crumbles down and dissolves. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਿਰਭਉ ਹੋਇਓ ਭਇਆ ਨਿਹੰਗਾ ॥",
      "transliteration": "nirabhau hoio bhaiaa niha(n)gaa ||",
      "translation": "Being fearless, he becomes unrestrained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚੀਤਿ ਨ ਆਇਓ ਕਰਤਾ ਸੰਗਾ ॥",
      "transliteration": "cheet na aaio karataa sa(n)gaa ||",
      "translation": "He does not think of the Creator, who is ever with him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਲਸਕਰ ਜੋੜੇ ਕੀਆ ਸੰਬਾਹਾ ॥",
      "transliteration": "lasakar joRe keeaa sa(n)baahaa ||",
      "translation": "He raises armies, and collects arms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਿਕਸਿਆ ਫੂਕ ਤ ਹੋਇ ਗਇਓ ਸੁਆਹਾ ॥੨॥",
      "transliteration": "nikasiaa phook ta hoi gaio suaahaa ||2||",
      "translation": "But when the breath leaves him, he turns to ashes. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਊਚੇ ਮੰਦਰ ਮਹਲ ਅਰੁ ਰਾਨੀ ॥",
      "transliteration": "ooche ma(n)dar mahal ar raanee ||",
      "translation": "He has lofty palaces, mansions and queens,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਸਤਿ ਘੋੜੇ ਜੋੜੇ ਮਨਿ ਭਾਨੀ ॥",
      "transliteration": "hasat ghoRe joRe man bhaanee ||",
      "translation": "elephants and pairs of horses, delighting the mind;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਵਡ ਪਰਵਾਰੁ ਪੂਤ ਅਰੁ ਧੀਆ ॥",
      "transliteration": "vad paravaar poot ar dheeaa ||",
      "translation": "he is blessed with a great family of sons and daughters.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮੋਹਿ ਪਚੇ ਪਚਿ ਅੰਧਾ ਮੂਆ ॥੩॥",
      "transliteration": "mohi pache pach a(n)dhaa mooaa ||3||",
      "translation": "But, engrossed in attachment, the blind fool wastes away to death. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਨਹਿ ਉਪਾਹਾ ਤਿਨਹਿ ਬਿਨਾਹਾ ॥",
      "transliteration": "jinahi upaahaa tinahi binaahaa ||",
      "translation": "The One who created him destroys him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰੰਗ ਰਸਾ ਜੈਸੇ ਸੁਪਨਾਹਾ ॥",
      "transliteration": "ra(n)g rasaa jaise supanaahaa ||",
      "translation": "Enjoyments and pleasures are like just a dream.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੋਈ ਮੁਕਤਾ ਤਿਸੁ ਰਾਜੁ ਮਾਲੁ ॥",
      "transliteration": "soee mukataa tis raaj maal ||",
      "translation": "He alone is liberated, and possesses regal power and wealth,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਜਿਸੁ ਖਸਮੁ ਦਇਆਲੁ ॥੪॥੩੫॥੮੬॥",
      "transliteration": "naanak daas jis khasam daiaal ||4||35||86||",
      "translation": "O Nanak, whom the Lord Master blesses with His Mercy. ||4||35||86||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਨੑ ਸਿਉ ਪ੍ਰੀਤਿ ਕਰੀ ਘਨੇਰੀ ॥",
      "transliteration": "inh siu preet karee ghaneree ||",
      "translation": "The mortal is in love with this,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਉ ਮਿਲੀਐ ਤਉ ਵਧੈ ਵਧੇਰੀ ॥",
      "transliteration": "jau mileeai tau vadhai vadheree ||",
      "translation": "but the more he has, the more he longs for more.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗਲਿ ਚਮੜੀ ਜਉ ਛੋਡੈ ਨਾਹੀ ॥",
      "transliteration": "gal chamaRee jau chhodai naahee ||",
      "translation": "It hangs around his neck, and does not leave him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਲਾਗਿ ਛੁਟੋ ਸਤਿਗੁਰ ਕੀ ਪਾਈ ॥੧॥",
      "transliteration": "laag chhuto satigur kee paaee ||1||",
      "translation": "But falling at the feet of the True Guru, he is saved. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਗ ਮੋਹਨੀ ਹਮ ਤਿਆਗਿ ਗਵਾਈ ॥",
      "transliteration": "jag mohanee ham tiaag gavaaee ||",
      "translation": "I have renounced and discarded Maya, the Enticer of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਿਰਗੁਨੁ ਮਿਲਿਓ ਵਜੀ ਵਧਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "niragun milio vajee vadhaaee ||1|| rahaau ||",
      "translation": "I have met the Absolute Lord, and congratulations are pouring in. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਐਸੀ ਸੁੰਦਰਿ ਮਨ ਕਉ ਮੋਹੈ ॥",
      "transliteration": "aisee su(n)dar man kau mohai ||",
      "translation": "She is so beautiful, she captivates the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਾਟਿ ਘਾਟਿ ਗ੍ਰਿਹਿ ਬਨਿ ਬਨਿ ਜੋਹੈ ॥",
      "transliteration": "baat ghaat grihi ban ban johai ||",
      "translation": "On the road, and the beach, at home, in the forest and in the wilderness, she touches us.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨਿ ਤਨਿ ਲਾਗੈ ਹੋਇ ਕੈ ਮੀਠੀ ॥",
      "transliteration": "man tan laagai hoi kai meethee ||",
      "translation": "She seems so sweet to the mind and body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਮੈ ਖੋਟੀ ਡੀਠੀ ॥੨॥",
      "transliteration": "gur prasaad mai khotee deethee ||2||",
      "translation": "But by Guru's Grace, I have seen her to be deceptive. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਗਰਕ ਉਸ ਕੇ ਵਡੇ ਠਗਾਊ ॥",
      "transliteration": "agarak us ke vade thagaaoo ||",
      "translation": "Her courtiers are also great deceivers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਛੋਡਹਿ ਨਾਹੀ ਬਾਪ ਨ ਮਾਊ ॥",
      "transliteration": "chhodahi naahee baap na maaoo ||",
      "translation": "They do not spare even their fathers or mothers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮੇਲੀ ਅਪਨੇ ਉਨਿ ਲੇ ਬਾਂਧੇ ॥",
      "transliteration": "melee apane un le baa(n)dhe ||",
      "translation": "They have enslaved their companions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਮੈ ਸਗਲੇ ਸਾਧੇ ॥੩॥",
      "transliteration": "gur kirapaa te mai sagale saadhe ||3||",
      "translation": "By Guru's Grace, I have subjugated them all. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਬ ਮੋਰੈ ਮਨਿ ਭਇਆ ਅਨੰਦ ॥",
      "transliteration": "ab morai man bhaiaa ana(n)d ||",
      "translation": "Now, my mind is filled with bliss;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਉ ਚੂਕਾ ਟੂਟੇ ਸਭਿ ਫੰਦ ॥",
      "transliteration": "bhau chookaa toote sabh pha(n)d ||",
      "translation": "my fear is gone, and the noose is cut away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਾ ਸਤਿਗੁਰੁ ਪਾਇਆ ॥",
      "transliteration": "kahu naanak jaa satigur paaiaa ||",
      "translation": "Says Nanak, when I met the True Guru,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਘਰੁ ਸਗਲਾ ਮੈ ਸੁਖੀ ਬਸਾਇਆ ॥੪॥੩੬॥੮੭॥",
      "transliteration": "ghar sagalaa mai sukhee basaaiaa ||4||36||87||",
      "translation": "I came to dwell within my home in absolute peace. ||4||36||87||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਠ ਪਹਰ ਨਿਕਟਿ ਕਰਿ ਜਾਨੈ ॥",
      "transliteration": "aath pahar nikat kar jaanai ||",
      "translation": "Twenty-four hours a day, he knows the Lord to be near at hand;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਭ ਕਾ ਕੀਆ ਮੀਠਾ ਮਾਨੈ ॥",
      "transliteration": "prabh kaa keeaa meethaa maanai ||",
      "translation": "he surrenders to the Sweet Will of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਏਕੁ ਨਾਮੁ ਸੰਤਨ ਆਧਾਰੁ ॥",
      "transliteration": "ek naam sa(n)tan aadhaar ||",
      "translation": "The One Name is the Support of the Saints;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹੋਇ ਰਹੇ ਸਭ ਕੀ ਪਗ ਛਾਰੁ ॥੧॥",
      "transliteration": "hoi rahe sabh kee pag chhaar ||1||",
      "translation": "they remain the dust of the feet of all. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੰਤ ਰਹਤ ਸੁਨਹੁ ਮੇਰੇ ਭਾਈ ॥",
      "transliteration": "sa(n)t rahat sunahu mere bhaaee ||",
      "translation": "Listen, to the way of life of the Saints, O my Siblings of Destiny;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਉਆ ਕੀ ਮਹਿਮਾ ਕਥਨੁ ਨ ਜਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "uaa kee mahimaa kathan na jaaee ||1|| rahaau ||",
      "translation": "their praises cannot be described. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਵਰਤਣਿ ਜਾ ਕੈ ਕੇਵਲ ਨਾਮ ॥",
      "transliteration": "varatan jaa kai keval naam ||",
      "translation": "Their occupation is the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਨਦ ਰੂਪ ਕੀਰਤਨੁ ਬਿਸ੍ਰਾਮ ॥",
      "transliteration": "anad roop keeratan bisraam ||",
      "translation": "The Kirtan, the Praise of the Lord, the embodiment of bliss, is their rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਿਤ੍ਰ ਸਤ੍ਰੁ ਜਾ ਕੈ ਏਕ ਸਮਾਨੈ ॥",
      "transliteration": "mitr satr jaa kai ek samaanai ||",
      "translation": "Friends and enemies are one and the same to them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਭ ਅਪੁਨੇ ਬਿਨੁ ਅਵਰੁ ਨ ਜਾਨੈ ॥੨॥",
      "transliteration": "prabh apune bin avar na jaanai ||2||",
      "translation": "They know of no other than God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕੋਟਿ ਕੋਟਿ ਅਘ ਕਾਟਨਹਾਰਾ ॥",
      "transliteration": "kot kot agh kaatanahaaraa ||",
      "translation": "They erase millions upon millions of sins.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੁਖ ਦੂਰਿ ਕਰਨ ਜੀਅ ਕੇ ਦਾਤਾਰਾ ॥",
      "transliteration": "dukh door karan jee ke daataaraa ||",
      "translation": "They dispel suffering; they are givers of the life of the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੂਰਬੀਰ ਬਚਨ ਕੇ ਬਲੀ ॥",
      "transliteration": "soorabeer bachan ke balee ||",
      "translation": "They are so brave; they are men of their word.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਉਲਾ ਬਪੁਰੀ ਸੰਤੀ ਛਲੀ ॥੩॥",
      "transliteration": "kaulaa bapuree sa(n)tee chhalee ||3||",
      "translation": "The Saints have enticed Maya herself. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤਾ ਕਾ ਸੰਗੁ ਬਾਛਹਿ ਸੁਰਦੇਵ ॥",
      "transliteration": "taa kaa sa(n)g baachhahi suradev ||",
      "translation": "Their company is cherished even by the gods and the angels.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਮੋਘ ਦਰਸੁ ਸਫਲ ਜਾ ਕੀ ਸੇਵ ॥",
      "transliteration": "amogh daras saphal jaa kee sev ||",
      "translation": "Blessed is their Darshan, and fruitful is their service.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਰ ਜੋੜਿ ਨਾਨਕੁ ਕਰੇ ਅਰਦਾਸਿ ॥",
      "transliteration": "kar joR naanak kare aradaas ||",
      "translation": "With his palms pressed together, Nanak offers his prayer:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮੋਹਿ ਸੰਤਹ ਟਹਲ ਦੀਜੈ ਗੁਣਤਾਸਿ ॥੪॥੩੭॥੮੮॥",
      "transliteration": "mohi sa(n)tah tahal deejai gunataas ||4||37||88||",
      "translation": "O Lord, Treasure of Excellence, please bless me with the service of the Saints. ||4||37||88||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਗਲ ਸੂਖ ਜਪਿ ਏਕੈ ਨਾਮ ॥",
      "transliteration": "sagal sookh jap ekai naam ||",
      "translation": "All peace and comforts are in the meditation of the One Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸਗਲ ਧਰਮ ਹਰਿ ਕੇ ਗੁਣ ਗਾਮ ॥",
      "transliteration": "sagal dharam har ke gun gaam ||",
      "translation": "All righteous actions of Dharma are in the singing of the Lord's Glorious Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0392_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਮਹਾ ਪਵਿਤ੍ਰ ਸਾਧ ਕਾ ਸੰਗੁ ॥",
      "transliteration": "mahaa pavitr saadh kaa sa(n)g ||",
      "translation": "The Saadh Sangat, the Company of the Holy, is so very pure and sacred.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 392,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
