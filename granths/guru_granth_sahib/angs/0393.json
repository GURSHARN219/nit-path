{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 393,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0393_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਸੁ ਭੇਟਤ ਲਾਗੈ ਪ੍ਰਭ ਰੰਗੁ ॥੧॥",
      "transliteration": "jis bhetat laagai prabh ra(n)g ||1||",
      "translation": "Meeting with them, love for God is embraced. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਓਇ ਆਨੰਦ ਪਾਵੈ ॥",
      "transliteration": "gur prasaad oi aana(n)d paavai ||",
      "translation": "By Guru's Grace, bliss is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਿਸੁ ਸਿਮਰਤ ਮਨਿ ਹੋਇ ਪ੍ਰਗਾਸਾ ਤਾ ਕੀ ਗਤਿ ਮਿਤਿ ਕਹਨੁ ਨ ਜਾਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jis simarat man hoi pragaasaa taa kee gat mit kahan na jaavai ||1|| rahaau ||",
      "translation": "Meditating upon Him in remembrance, the mind is illumined; his state and condition cannot be described. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਵਰਤ ਨੇਮ ਮਜਨ ਤਿਸੁ ਪੂਜਾ ॥",
      "transliteration": "varat nem majan tis poojaa ||",
      "translation": "Fasts, religious vows, cleansing baths, and worship to Him;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬੇਦ ਪੁਰਾਨ ਤਿਨਿ ਸਿੰਮ੍ਰਿਤਿ ਸੁਨੀਜਾ ॥",
      "transliteration": "bed puraan tin si(n)mrit suneejaa ||",
      "translation": "listening to the Vedas, Puraanas, and Shaastras.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਹਾ ਪੁਨੀਤ ਜਾ ਕਾ ਨਿਰਮਲ ਥਾਨੁ ॥",
      "transliteration": "mahaa puneet jaa kaa niramal thaan ||",
      "translation": "Extremely pure is he, and immaculate is his place,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਜਾ ਕੈ ਹਰਿ ਹਰਿ ਨਾਮੁ ॥੨॥",
      "transliteration": "saadhasa(n)gat jaa kai har har naam ||2||",
      "translation": "who meditates upon the Name of the Lord, Har, Har, in the Saadh Sangat. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪ੍ਰਗਟਿਓ ਸੋ ਜਨੁ ਸਗਲੇ ਭਵਨ ॥",
      "transliteration": "pragatio so jan sagale bhavan ||",
      "translation": "That humble being becomes renowned all over the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਤਿਤ ਪੁਨੀਤ ਤਾ ਕੀ ਪਗ ਰੇਨ ॥",
      "transliteration": "patit puneet taa kee pag ren ||",
      "translation": "Even sinners are purified, by the dust of his feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾ ਕਉ ਭੇਟਿਓ ਹਰਿ ਹਰਿ ਰਾਇ ॥",
      "transliteration": "jaa kau bhetio har har raai ||",
      "translation": "One who has met the Lord, the Lord our King,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਕੀ ਗਤਿ ਮਿਤਿ ਕਥਨੁ ਨ ਜਾਇ ॥੩॥",
      "transliteration": "taa kee gat mit kathan na jaai ||3||",
      "translation": "his condition and state cannot be described. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਆਠ ਪਹਰ ਕਰ ਜੋੜਿ ਧਿਆਵਉ ॥",
      "transliteration": "aath pahar kar joR dhiaavau ||",
      "translation": "Twenty-four hours a day, with palms pressed together, I meditate;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਉਨ ਸਾਧਾ ਕਾ ਦਰਸਨੁ ਪਾਵਉ ॥",
      "transliteration": "un saadhaa kaa darasan paavau ||",
      "translation": "I yearn to obtain the Blessed Vision of the Darshan of those Holy Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੋਹਿ ਗਰੀਬ ਕਉ ਲੇਹੁ ਰਲਾਇ ॥",
      "transliteration": "mohi gareeb kau lehu ralaai ||",
      "translation": "Merge me, the poor one, with You, O Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਆਇ ਪਏ ਸਰਣਾਇ ॥੪॥੩੮॥੮੯॥",
      "transliteration": "naanak aai pae saranaai ||4||38||89||",
      "translation": "Nanak has come to Your Sanctuary. ||4||38||89||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਠ ਪਹਰ ਉਦਕ ਇਸਨਾਨੀ ॥",
      "transliteration": "aath pahar udak isanaanee ||",
      "translation": "Twenty-four hours a day, he takes his cleansing bath in water;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਦ ਹੀ ਭੋਗੁ ਲਗਾਇ ਸੁਗਿਆਨੀ ॥",
      "transliteration": "sad hee bhog lagaai sugiaanee ||",
      "translation": "he makes continual offerings to the Lord; he is a true man of wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਿਰਥਾ ਕਾਹੂ ਛੋਡੈ ਨਾਹੀ ॥",
      "transliteration": "birathaa kaahoo chhodai naahee ||",
      "translation": "He never leaves anything uselessly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਹੁਰਿ ਬਹੁਰਿ ਤਿਸੁ ਲਾਗਹ ਪਾਈ ॥੧॥",
      "transliteration": "bahur bahur tis laagah paaee ||1||",
      "translation": "Again and again, he falls at the Lord's Feet. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਾਲਗਿਰਾਮੁ ਹਮਾਰੈ ਸੇਵਾ ॥",
      "transliteration": "saalagiraam hamaarai sevaa ||",
      "translation": "Such is the Saalagraam, the stone idol, which I serve;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪੂਜਾ ਅਰਚਾ ਬੰਦਨ ਦੇਵਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "poojaa arachaa ba(n)dan devaa ||1|| rahaau ||",
      "translation": "such is my worship, flower-offerings and divine adoration as well. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਘੰਟਾ ਜਾ ਕਾ ਸੁਨੀਐ ਚਹੁ ਕੁੰਟ ॥",
      "transliteration": "gha(n)taa jaa kaa suneeai chahu ku(n)t ||",
      "translation": "His bell resounds to the four corners of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਸਨੁ ਜਾ ਕਾ ਸਦਾ ਬੈਕੁੰਠ ॥",
      "transliteration": "aasan jaa kaa sadaa baiku(n)th ||",
      "translation": "His seat is forever in heaven.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਾ ਕਾ ਚਵਰੁ ਸਭ ਊਪਰਿ ਝੂਲੈ ॥",
      "transliteration": "jaa kaa chavar sabh oopar jhoolai ||",
      "translation": "His chauri, his fly-brush, waves over all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਾ ਕਾ ਧੂਪੁ ਸਦਾ ਪਰਫੁਲੈ ॥੨॥",
      "transliteration": "taa kaa dhoop sadaa paraphulai ||2||",
      "translation": "His incense is ever-fragrant. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਸੰਪਟੁ ਹੈ ਰੇ ਜਾ ਕਾ ॥",
      "transliteration": "ghat ghat sa(n)pat hai re jaa kaa ||",
      "translation": "He is treasured in each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਭਗ ਸਭਾ ਸੰਗਿ ਹੈ ਸਾਧਾ ॥",
      "transliteration": "abhag sabhaa sa(n)g hai saadhaa ||",
      "translation": "The Saadh Sangat, the Company of the Holy, is His Eternal Court.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਰਤੀ ਕੀਰਤਨੁ ਸਦਾ ਅਨੰਦ ॥",
      "transliteration": "aaratee keeratan sadaa ana(n)d ||",
      "translation": "His Aartee, his lamp-lit worship service, is the Kirtan of His Praises, which brings lasting bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਹਿਮਾ ਸੁੰਦਰ ਸਦਾ ਬੇਅੰਤ ॥੩॥",
      "transliteration": "mahimaa su(n)dar sadaa bea(n)t ||3||",
      "translation": "His Greatness is so beautiful, and ever limitless. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਸਹਿ ਪਰਾਪਤਿ ਤਿਸ ਹੀ ਲਹਨਾ ॥",
      "transliteration": "jisahi paraapat tis hee lahanaa ||",
      "translation": "He alone obtains it, who is so pre-ordained;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੰਤ ਚਰਨ ਓਹੁ ਆਇਓ ਸਰਨਾ ॥",
      "transliteration": "sa(n)t charan ohu aaio saranaa ||",
      "translation": "he takes to the Sanctuary of the Saints' Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਾਥਿ ਚੜਿਓ ਹਰਿ ਸਾਲਗਿਰਾਮੁ ॥",
      "transliteration": "haath chaRio har saalagiraam ||",
      "translation": "I hold in my hands the Saalagraam of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰਿ ਕੀਨੋ ਦਾਨੁ ॥੪॥੩੯॥੯੦॥",
      "transliteration": "kahu naanak gur keeno daan ||4||39||90||",
      "translation": "Says Nanak, the Guru has given me this Gift. ||4||39||90||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ਪੰਚਪਦਾ₁ ॥",
      "transliteration": "aasaa mahalaa 5 pa(n)chapadaa₁ ||",
      "translation": "Aasaa, Fifth Mehl, Panch-Pada:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਹ ਪੈਡੈ ਲੂਟੀ ਪਨਿਹਾਰੀ ॥",
      "transliteration": "jih paidai lootee panihaaree ||",
      "translation": "That highway, upon which the water-carrier is plundered",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੋ ਮਾਰਗੁ ਸੰਤਨ ਦੂਰਾਰੀ ॥੧॥",
      "transliteration": "so maarag sa(n)tan dooraaree ||1||",
      "translation": "- that way is far removed from the Saints. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਤਿਗੁਰ ਪੂਰੈ ਸਾਚੁ ਕਹਿਆ ॥",
      "transliteration": "satigur poorai saach kahiaa ||",
      "translation": "The True Guru has spoken the Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਮ ਤੇਰੇ ਕੀ ਮੁਕਤੇ ਬੀਥੀ ਜਮ ਕਾ ਮਾਰਗੁ ਦੂਰਿ ਰਹਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naam tere kee mukate beethee jam kaa maarag door rahiaa ||1|| rahaau ||",
      "translation": "Your Name, O Lord, is the Way to Salvation; the road of the Messenger of Death is far away. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਹ ਲਾਲਚ ਜਾਗਾਤੀ ਘਾਟ ॥",
      "transliteration": "jah laalach jaagaatee ghaat ||",
      "translation": "That place, where the greedy toll-collector dwells",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੂਰਿ ਰਹੀ ਉਹ ਜਨ ਤੇ ਬਾਟ ॥੨॥",
      "transliteration": "door rahee uh jan te baat ||2||",
      "translation": "- that path remains far removed from the Lord's humble servant. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਹ ਆਵਟੇ ਬਹੁਤ ਘਨ ਸਾਥ ॥",
      "transliteration": "jah aavate bahut ghan saath ||",
      "translation": "There, where so very many caravans of men are caught,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕੇ ਸੰਗੀ ਸਾਧ ॥੩॥",
      "transliteration": "paarabraham ke sa(n)gee saadh ||3||",
      "translation": "the Holy Saints remain with the Supreme Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚਿਤ੍ਰ ਗੁਪਤੁ ਸਭ ਲਿਖਤੇ ਲੇਖਾ ॥",
      "transliteration": "chitr gupat sabh likhate lekhaa ||",
      "translation": "Chitra and Gupat, the recording angels of the conscious and the unconscious, write the accounts of all mortal beings,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਗਤ ਜਨਾ ਕਉ ਦ੍ਰਿਸਟਿ ਨ ਪੇਖਾ ॥੪॥",
      "transliteration": "bhagat janaa kau drisat na pekhaa ||4||",
      "translation": "but they cannot even see the Lord's humble devotees. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਿਸੁ ਸਤਿਗੁਰੁ ਪੂਰਾ ॥",
      "transliteration": "kahu naanak jis satigur pooraa ||",
      "translation": "Says Nanak, one whose True Guru is Perfect",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਵਾਜੇ ਤਾ ਕੈ ਅਨਹਦ ਤੂਰਾ ॥੫॥੪੦॥੯੧॥",
      "transliteration": "vaaje taa kai anahad tooraa ||5||40||91||",
      "translation": "- the unblown bugles of ecstasy vibrate for him. ||5||40||91||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ਦੁਪਦਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 5 dupadaa 1 ||",
      "translation": "Aasaa, Fifth Mehl, Du-Pada 1:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਾਧੂ ਸੰਗਿ ਸਿਖਾਇਓ ਨਾਮੁ ॥",
      "transliteration": "saadhoo sa(n)g sikhaaio naam ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, the Naam is learned;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਰਬ ਮਨੋਰਥ ਪੂਰਨ ਕਾਮ ॥",
      "transliteration": "sarab manorath pooran kaam ||",
      "translation": "all desires and tasks are fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬੁਝਿ ਗਈ ਤ੍ਰਿਸਨਾ ਹਰਿ ਜਸਹਿ ਅਘਾਨੇ ॥",
      "transliteration": "bujh gaee trisanaa har jasahi aghaane ||",
      "translation": "My thirst has been quenched, and I am satiated with the Lord's Praise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਪਿ ਜਪਿ ਜੀਵਾ ਸਾਰਿਗਪਾਨੇ ॥੧॥",
      "transliteration": "jap jap jeevaa saarigapaane ||1||",
      "translation": "I live by chanting and meditating upon the Lord, the Sustainer of the earth. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਸਰਨਿ ਪਰਿਆ ॥",
      "transliteration": "karan karaavan saran pariaa ||",
      "translation": "I have entered the Sanctuary of the Creator, the Cause of all causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0393_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਸਹਜ ਘਰੁ ਪਾਇਆ ਮਿਟਿਆ ਅੰਧੇਰਾ ਚੰਦੁ ਚੜਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur parasaad sahaj ghar paaiaa mitiaa a(n)dheraa cha(n)d chaRiaa ||1|| rahaau ||",
      "translation": "By Guru's Grace, I have entered the home of celestial bliss. Darkness is dispelled, and the moon of wisdom has risen. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 393,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
