{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 394,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0394_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਲਾਲ ਜਵੇਹਰ ਭਰੇ ਭੰਡਾਰ ॥",
      "transliteration": "laal javehar bhare bha(n)daar ||",
      "translation": "My treasure-house is overflowing with rubies and jewels;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤੋਟਿ ਨ ਆਵੈ ਜਪਿ ਨਿਰੰਕਾਰ ॥",
      "transliteration": "tot na aavai jap nira(n)kaar ||",
      "translation": "I meditate on the Formless Lord, and so they never run short.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਸਬਦੁ ਪੀਵੈ ਜਨੁ ਕੋਇ ॥",
      "transliteration": "a(n)mrit sabad peevai jan koi ||",
      "translation": "How rare is that humble being, who drinks in the Ambrosial Nectar of the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕੀ ਪਰਮ ਗਤਿ ਹੋਇ ॥੨॥੪੧॥੯੨॥",
      "transliteration": "naanak taa kee param gat hoi ||2||41||92||",
      "translation": "O Nanak, he attains the state of highest dignity. ||2||41||92||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਆਸਾ ਘਰੁ ੭ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa ghar 7 mahalaa 5 ||",
      "translation": "Aasaa, Seventh House, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਰਿਦੈ ਨਿਤ ਧਿਆਈ ॥",
      "transliteration": "har kaa naam ridai nit dhiaaee ||",
      "translation": "Meditate continually on the Name of the Lord within your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੰਗੀ ਸਾਥੀ ਸਗਲ ਤਰਾਂਈ ॥੧॥",
      "transliteration": "sa(n)gee saathee sagal taraa(n)ee ||1||",
      "translation": "Thus you shall save all your companions and associates. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰੁ ਮੇਰੈ ਸੰਗਿ ਸਦਾ ਹੈ ਨਾਲੇ ॥",
      "transliteration": "gur merai sa(n)g sadaa hai naale ||",
      "translation": "My Guru is always with me, near at hand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਤਿਸੁ ਸਦਾ ਸਮੑਾਲੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "simar simar tis sadaa samhaale ||1|| rahaau ||",
      "translation": "Meditating, meditating in remembrance on Him, I cherish Him forever. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤੇਰਾ ਕੀਆ ਮੀਠਾ ਲਾਗੈ ॥",
      "transliteration": "teraa keeaa meethaa laagai ||",
      "translation": "Your actions seem so sweet to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਰਿ ਨਾਮੁ ਪਦਾਰਥੁ ਨਾਨਕੁ ਮਾਂਗੈ ॥੨॥੪੨॥੯੩॥",
      "transliteration": "har naam padaarath naanak maa(n)gai ||2||42||93||",
      "translation": "Nanak begs for the treasure of the Naam, the Name of the Lord. ||2||42||93||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਧੂ ਸੰਗਤਿ ਤਰਿਆ ਸੰਸਾਰੁ ॥",
      "transliteration": "saadhoo sa(n)gat tariaa sa(n)saar ||",
      "translation": "The world is saved by the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਮਨਹਿ ਆਧਾਰੁ ॥੧॥",
      "transliteration": "har kaa naam manahi aadhaar ||1||",
      "translation": "The Name of the Lord is the Support of the mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਗੁਰਦੇਵ ਪਿਆਰੇ ॥",
      "transliteration": "charan kamal guradev piaare ||",
      "translation": "The Saints worship and adore the Lotus Feet of the Divine Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪੂਜਹਿ ਸੰਤ ਹਰਿ ਪ੍ਰੀਤਿ ਪਿਆਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "poojahi sa(n)t har preet piaare ||1|| rahaau ||",
      "translation": "they love the Beloved Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਾ ਕੈ ਮਸਤਕਿ ਲਿਖਿਆ ਭਾਗੁ ॥",
      "transliteration": "jaa kai masatak likhiaa bhaag ||",
      "translation": "She who has such good destiny written upon her forehead,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਤਾ ਕਾ ਥਿਰੁ ਸੋਹਾਗੁ ॥੨॥੪੩॥੯੪॥",
      "transliteration": "kahu naanak taa kaa thir sohaag ||2||43||94||",
      "translation": "says Nanak, is blessed with the eternal happy marriage with the Lord. ||2||43||94||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮੀਠੀ ਆਗਿਆ ਪਿਰ ਕੀ ਲਾਗੀ ॥",
      "transliteration": "meethee aagiaa pir kee laagee ||",
      "translation": "The Order of my Husband Lord seems so sweet to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਉਕਨਿ ਘਰ ਕੀ ਕੰਤਿ ਤਿਆਗੀ ॥",
      "transliteration": "saukan ghar kee ka(n)t tiaagee ||",
      "translation": "My Husband Lord has driven out the one who was my rival.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਿਅ ਸੋਹਾਗਨਿ ਸੀਗਾਰਿ ਕਰੀ ॥",
      "transliteration": "pri sohaagan seegaar karee ||",
      "translation": "My Beloved Husband has decorated me, His happy soul-bride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਨ ਮੇਰੇ ਕੀ ਤਪਤਿ ਹਰੀ ॥੧॥",
      "transliteration": "man mere kee tapat haree ||1||",
      "translation": "He has quieted the burning thirst of my mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਲੋ ਭਇਓ ਪ੍ਰਿਅ ਕਹਿਆ ਮਾਨਿਆ ॥",
      "transliteration": "bhalo bhaio pri kahiaa maaniaa ||",
      "translation": "It is good that I submitted to the Will of my Beloved Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੂਖੁ ਸਹਜੁ ਇਸੁ ਘਰ ਕਾ ਜਾਨਿਆ ॥ ਰਹਾਉ ॥",
      "transliteration": "sookh sahaj is ghar kaa jaaniaa || rahaau ||",
      "translation": "I have realized celestial peace and poise within this home of mine. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਉ ਬੰਦੀ ਪ੍ਰਿਅ ਖਿਜਮਤਦਾਰ ॥",
      "transliteration": "hau ba(n)dee pri khijamatadaar ||",
      "translation": "I am the hand-maiden, the attendant of my Beloved Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਓਹੁ ਅਬਿਨਾਸੀ ਅਗਮ ਅਪਾਰ ॥",
      "transliteration": "ohu abinaasee agam apaar ||",
      "translation": "He is eternal and imperishable, inaccessible and infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਲੇ ਪਖਾ ਪ੍ਰਿਅ ਝਲਉ ਪਾਏ ॥",
      "transliteration": "le pakhaa pri jhalau paae ||",
      "translation": "Holding the fan, sitting at His Feet, I wave it over my Beloved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਾਗਿ ਗਏ ਪੰਚ ਦੂਤ ਲਾਵੇ ॥੨॥",
      "transliteration": "bhaag gae pa(n)ch doot laave ||2||",
      "translation": "The five demons who tortured me have run away. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਾ ਮੈ ਕੁਲੁ ਨਾ ਸੋਭਾਵੰਤ ॥",
      "transliteration": "naa mai kul naa sobhaava(n)t ||",
      "translation": "I am not from a noble family, and I am not beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਿਆ ਜਾਨਾ ਕਿਉ ਭਾਨੀ ਕੰਤ ॥",
      "transliteration": "kiaa jaanaa kiu bhaanee ka(n)t ||",
      "translation": "What do I know? Why am I pleasing to my Beloved?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੋਹਿ ਅਨਾਥ ਗਰੀਬ ਨਿਮਾਨੀ ॥",
      "transliteration": "mohi anaath gareeb nimaanee ||",
      "translation": "I am a poor orphan, destitute and dishonored.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੰਤ ਪਕਰਿ ਹਮ ਕੀਨੀ ਰਾਨੀ ॥੩॥",
      "transliteration": "ka(n)t pakar ham keenee raanee ||3||",
      "translation": "My Husband took me in, and made me His queen. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਬ ਮੁਖਿ ਪ੍ਰੀਤਮੁ ਸਾਜਨੁ ਲਾਗਾ ॥",
      "transliteration": "jab mukh preetam saajan laagaa ||",
      "translation": "When I saw my Beloved's face before me,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਮੇਰਾ ਧਨੁ ਸੋਹਾਗਾ ॥",
      "transliteration": "sookh sahaj meraa dhan sohaagaa ||",
      "translation": "I became so happy and peaceful; my married life was blessed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਮੋਰੀ ਪੂਰਨ ਆਸਾ ॥",
      "transliteration": "kahu naanak moree pooran aasaa ||",
      "translation": "Says Nanak, my desires are fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਤਿਗੁਰ ਮੇਲੀ ਪ੍ਰਭ ਗੁਣਤਾਸਾ ॥੪॥੧॥੯੫॥",
      "transliteration": "satigur melee prabh gunataasaa ||4||1||95||",
      "translation": "The True Guru has united me with God, the treasure of excellence. ||4||1||95||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਾਥੈ ਤ੍ਰਿਕੁਟੀ ਦ੍ਰਿਸਟਿ ਕਰੂਰਿ ॥",
      "transliteration": "maathai trikutee drisat karoor ||",
      "translation": "A frown creases her forehead, and her look is evil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬੋਲੈ ਕਉੜਾ ਜਿਹਬਾ ਕੀ ਫੂੜਿ ॥",
      "transliteration": "bolai kauRaa jihabaa kee phooR ||",
      "translation": "Her speech is bitter, and her tongue is rude.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਦਾ ਭੂਖੀ ਪਿਰੁ ਜਾਨੈ ਦੂਰਿ ॥੧॥",
      "transliteration": "sadaa bhookhee pir jaanai door ||1||",
      "translation": "She is always hungry, and she believes her Husband to be far away. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਐਸੀ ਇਸਤ੍ਰੀ ਇਕ ਰਾਮਿ ਉਪਾਈ ॥",
      "transliteration": "aisee isatree ik raam upaaee ||",
      "translation": "Such is Maya, the woman, which the One Lord has created.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਉਨਿ ਸਭੁ ਜਗੁ ਖਾਇਆ ਹਮ ਗੁਰਿ ਰਾਖੇ ਮੇਰੇ ਭਾਈ ॥ ਰਹਾਉ ॥",
      "transliteration": "un sabh jag khaaiaa ham gur raakhe mere bhaaee || rahaau ||",
      "translation": "She is devouring the whole world, but the Guru has saved me, O my Siblings of Destiny. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਾਇ ਠਗਉਲੀ ਸਭੁ ਜਗੁ ਜੋਹਿਆ ॥",
      "transliteration": "paai thagaulee sabh jag johiaa ||",
      "translation": "Administering her poisons, she has overcome the whole world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਬਿਸਨੁ ਮਹਾਦੇਉ ਮੋਹਿਆ ॥",
      "transliteration": "brahamaa bisan mahaadeu mohiaa ||",
      "translation": "She has bewitched Brahma, Vishnu and Shiva.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਮਿ ਲਗੇ ਸੇ ਸੋਹਿਆ ॥੨॥",
      "transliteration": "guramukh naam lage se sohiaa ||2||",
      "translation": "Only those Gurmukhs who are attuned to the Naam are blessed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਵਰਤ ਨੇਮ ਕਰਿ ਥਾਕੇ ਪੁਨਹਚਰਨਾ ॥",
      "transliteration": "varat nem kar thaake punahacharanaa ||",
      "translation": "Performing fasts, religious observances and atonements, the mortals have grown weary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਟ ਤੀਰਥ ਭਵੇ ਸਭ ਧਰਨਾ ॥",
      "transliteration": "tat teerath bhave sabh dharanaa ||",
      "translation": "They wander over the entire planet, on pilgrimages to the banks of sacred rivers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੇ ਉਬਰੇ ਜਿ ਸਤਿਗੁਰ ਕੀ ਸਰਨਾ ॥੩॥",
      "transliteration": "se ubare j satigur kee saranaa ||3||",
      "translation": "But they alone are saved, who seek the Sanctuary of the True Guru. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਮਾਇਆ ਮੋਹਿ ਸਭੋ ਜਗੁ ਬਾਧਾ ॥",
      "transliteration": "maaiaa mohi sabho jag baadhaa ||",
      "translation": "Attached to Maya, the whole world is in bondage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਉਮੈ ਪਚੈ ਮਨਮੁਖ ਮੂਰਾਖਾ ॥",
      "transliteration": "haumai pachai manamukh mooraakhaa ||",
      "translation": "The foolish self-willed manmukhs are consumed by their egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰ ਨਾਨਕ ਬਾਹ ਪਕਰਿ ਹਮ ਰਾਖਾ ॥੪॥੨॥੯੬॥",
      "transliteration": "gur naanak baah pakar ham raakhaa ||4||2||96||",
      "translation": "Taking me by the arm, Guru Nanak has saved me. ||4||2||96||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਰਬ ਦੂਖ ਜਬ ਬਿਸਰਹਿ ਸੁਆਮੀ ॥",
      "transliteration": "sarab dookh jab bisarahi suaamee ||",
      "translation": "Everything is painful, when one forgets the Lord Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਈਹਾ ਊਹਾ ਕਾਮਿ ਨ ਪ੍ਰਾਨੀ ॥੧॥",
      "transliteration": "eehaa oohaa kaam na praanee ||1||",
      "translation": "Here and hereafter, such a mortal is useless. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0394_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸੰਤ ਤ੍ਰਿਪਤਾਸੇ ਹਰਿ ਹਰਿ ਧੵਾਇ ॥",
      "transliteration": "sa(n)t tripataase har har dhyaai ||",
      "translation": "The Saints are satisfied, meditating on the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 394,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
