{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 395,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0395_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਅਪੁਨੈ ਨਾਇ ਲਾਏ ਸਰਬ ਸੂਖ ਪ੍ਰਭ ਤੁਮਰੀ ਰਜਾਇ ॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa apunai naai laae sarab sookh prabh tumaree rajaai || rahaau ||",
      "translation": "Bestowing Your Mercy, God, You attach us to Your Name; all peace comes by Your Will. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੰਗਿ ਹੋਵਤ ਕਉ ਜਾਨਤ ਦੂਰਿ ॥",
      "transliteration": "sa(n)g hovat kau jaanat door ||",
      "translation": "The Lord is Ever-present; one who deems Him to be far away,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੋ ਜਨੁ ਮਰਤਾ ਨਿਤ ਨਿਤ ਝੂਰਿ ॥੨॥",
      "transliteration": "so jan marataa nit nit jhoor ||2||",
      "translation": "Dies again and again, repenting. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਿਨਿ ਸਭੁ ਕਿਛੁ ਦੀਆ ਤਿਸੁ ਚਿਤਵਤ ਨਾਹਿ ॥",
      "transliteration": "jin sabh kichh deeaa tis chitavat naahi ||",
      "translation": "The mortals do not remember the One, who has given them everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਹਾ ਬਿਖਿਆ ਮਹਿ ਦਿਨੁ ਰੈਨਿ ਜਾਹਿ ॥੩॥",
      "transliteration": "mahaa bikhiaa mahi din rain jaahi ||3||",
      "translation": "Engrossed in such terrible corruption, their days and nights waste away. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਪ੍ਰਭੁ ਸਿਮਰਹੁ ਏਕ ॥",
      "transliteration": "kahu naanak prabh simarahu ek ||",
      "translation": "Says Nanak, meditate in remembrance of the One Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗਤਿ ਪਾਈਐ ਗੁਰ ਪੂਰੇ ਟੇਕ ॥੪॥੩॥੯੭॥",
      "transliteration": "gat paaeeai gur poore tek ||4||3||97||",
      "translation": "Salvation is obtained, in the Shelter of the Perfect Guru. ||4||3||97||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਮਨੁ ਤਨੁ ਸਭੁ ਹਰਿਆ ॥",
      "transliteration": "naam japat man tan sabh hariaa ||",
      "translation": "Meditating on the Naam, the Name of the Lord, the mind and body are totally rejuvenated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਲਮਲ ਦੋਖ ਸਗਲ ਪਰਹਰਿਆ ॥੧॥",
      "transliteration": "kalamal dokh sagal parahariaa ||1||",
      "translation": "All sins and sorrows are washed away. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੋਈ ਦਿਵਸੁ ਭਲਾ ਮੇਰੇ ਭਾਈ ॥",
      "transliteration": "soee divas bhalaa mere bhaaee ||",
      "translation": "How blessed is that day, O my Siblings of Destiny,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਗੁਨ ਗਾਇ ਪਰਮ ਗਤਿ ਪਾਈ ॥ ਰਹਾਉ ॥",
      "transliteration": "har gun gaai param gat paaee || rahaau ||",
      "translation": "when the Glorious Praises of the Lord are sung, and the supreme status is obtained. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਧ ਜਨਾ ਕੇ ਪੂਜੇ ਪੈਰ ॥",
      "transliteration": "saadh janaa ke pooje pair ||",
      "translation": "Worshipping the feet of the Holy Saints,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਿਟੇ ਉਪਦ੍ਰਹ ਮਨ ਤੇ ਬੈਰ ॥੨॥",
      "transliteration": "mite upadrah man te bair ||2||",
      "translation": "troubles and hatred are eliminated from the mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਮਿਲਿ ਝਗਰੁ ਚੁਕਾਇਆ ॥",
      "transliteration": "gur poore mil jhagar chukaaiaa ||",
      "translation": "Meeting with the Perfect Guru, conflict is ended,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪੰਚ ਦੂਤ ਸਭਿ ਵਸਗਤਿ ਆਇਆ ॥੩॥",
      "transliteration": "pa(n)ch doot sabh vasagat aaiaa ||3||",
      "translation": "and the five demons are totally subdued. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਸੁ ਮਨਿ ਵਸਿਆ ਹਰਿ ਕਾ ਨਾਮੁ ॥",
      "transliteration": "jis man vasiaa har kaa naam ||",
      "translation": "One whose mind is filled with the Name of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਨਕ ਤਿਸੁ ਊਪਰਿ ਕੁਰਬਾਨ ॥੪॥੪॥੯੮॥",
      "transliteration": "naanak tis oopar kurabaan ||4||4||98||",
      "translation": "O Nanak - I am a sacrifice to him. ||4||4||98||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗਾਵਿ ਲੇਹਿ ਤੂ ਗਾਵਨਹਾਰੇ ॥",
      "transliteration": "gaav lehi too gaavanahaare ||",
      "translation": "O singer, sing of the One,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੀਅ ਪਿੰਡ ਕੇ ਪ੍ਰਾਨ ਅਧਾਰੇ ॥",
      "transliteration": "jee pi(n)d ke praan adhaare ||",
      "translation": "who is the Support of the soul, the body and the breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਾ ਕੀ ਸੇਵਾ ਸਰਬ ਸੁਖ ਪਾਵਹਿ ॥",
      "transliteration": "jaa kee sevaa sarab sukh paavahi ||",
      "translation": "Serving Him, all peace is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਵਰ ਕਾਹੂ ਪਹਿ ਬਹੁੜਿ ਨ ਜਾਵਹਿ ॥੧॥",
      "transliteration": "avar kaahoo pahi bahuR na jaavahi ||1||",
      "translation": "You shall no longer go to any other. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਦਾ ਅਨੰਦ ਅਨੰਦੀ ਸਾਹਿਬੁ ਗੁਨ ਨਿਧਾਨ ਨਿਤ ਨਿਤ ਜਾਪੀਐ ॥",
      "transliteration": "sadaa ana(n)d ana(n)dee saahib gun nidhaan nit nit jaapeeai ||",
      "translation": "My Blissful Lord Master is forever in bliss; meditate continually and forever, on the Lord, the treasure of excellence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਲਿਹਾਰੀ ਤਿਸੁ ਸੰਤ ਪਿਆਰੇ ਜਿਸੁ ਪ੍ਰਸਾਦਿ ਪ੍ਰਭੁ ਮਨਿ ਵਾਸੀਐ ॥ ਰਹਾਉ ॥",
      "transliteration": "balihaaree tis sa(n)t piaare jis prasaad prabh man vaaseeai || rahaau ||",
      "translation": "I am a sacrifice to the Beloved Saints; by their kind favor, God comes to dwell in the mind. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾ ਕਾ ਦਾਨੁ ਨਿਖੂਟੈ ਨਾਹੀ ॥",
      "transliteration": "jaa kaa daan nikhootai naahee ||",
      "translation": "His gifts are never exhausted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭਲੀ ਭਾਤਿ ਸਭ ਸਹਜਿ ਸਮਾਹੀ ॥",
      "transliteration": "bhalee bhaat sabh sahaj samaahee ||",
      "translation": "In His subtle way, He easily absorbs all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾ ਕੀ ਬਖਸ ਨ ਮੇਟੈ ਕੋਈ ॥",
      "transliteration": "jaa kee bakhas na metai koee ||",
      "translation": "His benevolence cannot be erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਨਿ ਵਾਸਾਈਐ ਸਾਚਾ ਸੋਈ ॥੨॥",
      "transliteration": "man vaasaaeeai saachaa soee ||2||",
      "translation": "So enshrine that True Lord within your mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਗਲ ਸਮਗ੍ਰੀ ਗ੍ਰਿਹ ਜਾ ਕੈ ਪੂਰਨ ॥",
      "transliteration": "sagal samagree grih jaa kai pooran ||",
      "translation": "His house is filled with all sorts of articles;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪ੍ਰਭ ਕੇ ਸੇਵਕ ਦੂਖ ਨ ਝੂਰਨ ॥",
      "transliteration": "prabh ke sevak dookh na jhooran ||",
      "translation": "God's servants never suffer pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਓਟਿ ਗਹੀ ਨਿਰਭਉ ਪਦੁ ਪਾਈਐ ॥",
      "transliteration": "ot gahee nirabhau pad paaeeai ||",
      "translation": "Holding to His Support, the state of fearless dignity is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਾਸਿ ਸਾਸਿ ਸੋ ਗੁਨ ਨਿਧਿ ਗਾਈਐ ॥੩॥",
      "transliteration": "saas saas so gun nidh gaaeeai ||3||",
      "translation": "With each and every breath, sing of the Lord, the treasure of excellence. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੂਰਿ ਨ ਹੋਈ ਕਤਹੂ ਜਾਈਐ ॥",
      "transliteration": "door na hoee katahoo jaaeeai ||",
      "translation": "He is not far from us, wherever we go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਤਾ ਹਰਿ ਹਰਿ ਪਾਈਐ ॥",
      "transliteration": "nadar kare taa har har paaeeai ||",
      "translation": "When He shows His Mercy, we obtain the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਰਦਾਸਿ ਕਰੀ ਪੂਰੇ ਗੁਰ ਪਾਸਿ ॥",
      "transliteration": "aradaas karee poore gur paas ||",
      "translation": "I offer this prayer to the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕੁ ਮੰਗੈ ਹਰਿ ਧਨੁ ਰਾਸਿ ॥੪॥੫॥੯੯॥",
      "transliteration": "naanak ma(n)gai har dhan raas ||4||5||99||",
      "translation": "Nanak begs for the treasure of the Lord's Name. ||4||5||99||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪ੍ਰਥਮੇ ਮਿਟਿਆ ਤਨ ਕਾ ਦੂਖ ॥",
      "transliteration": "prathame mitiaa tan kaa dookh ||",
      "translation": "First, the pains of the body vanish;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਨ ਸਗਲ ਕਉ ਹੋਆ ਸੂਖੁ ॥",
      "transliteration": "man sagal kau hoaa sookh ||",
      "translation": "then, the mind becomes totally peaceful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਗੁਰ ਦੀਨੋ ਨਾਉ ॥",
      "transliteration": "kar kirapaa gur deeno naau ||",
      "translation": "In His Mercy, the Guru bestows the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਲਿ ਬਲਿ ਤਿਸੁ ਸਤਿਗੁਰ ਕਉ ਜਾਉ ॥੧॥",
      "transliteration": "bal bal tis satigur kau jaau ||1||",
      "translation": "I am a sacrifice, a sacrifice to that True Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੁਰੁ ਪੂਰਾ ਪਾਇਓ ਮੇਰੇ ਭਾਈ ॥",
      "transliteration": "gur pooraa paaio mere bhaaee ||",
      "translation": "I have obtained the Perfect Guru, O my Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰੋਗ ਸੋਗ ਸਭ ਦੂਖ ਬਿਨਾਸੇ ਸਤਿਗੁਰ ਕੀ ਸਰਣਾਈ ॥ ਰਹਾਉ ॥",
      "transliteration": "rog sog sabh dookh binaase satigur kee saranaaee || rahaau ||",
      "translation": "All illness, sorrows and sufferings are dispelled, in the Sanctuary of the True Guru. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਨ ਹਿਰਦੈ ਵਸਾਏ ॥",
      "transliteration": "gur ke charan hiradai vasaae ||",
      "translation": "The feet of the Guru abide within my heart;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਨ ਚਿੰਤਤ ਸਗਲੇ ਫਲ ਪਾਏ ॥",
      "transliteration": "man chi(n)tat sagale phal paae ||",
      "translation": "I have received all the fruits of my heart's desires.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਗਨਿ ਬੁਝੀ ਸਭ ਹੋਈ ਸਾਂਤਿ ॥",
      "transliteration": "agan bujhee sabh hoee saa(n)t ||",
      "translation": "The fire is extinguished, and I am totally peaceful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਗੁਰਿ ਕੀਨੀ ਦਾਤਿ ॥੨॥",
      "transliteration": "kar kirapaa gur keenee daat ||2||",
      "translation": "Showering His Mercy, the Guru has given this gift. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਿਥਾਵੇ ਕਉ ਗੁਰਿ ਦੀਨੋ ਥਾਨੁ ॥",
      "transliteration": "nithaave kau gur deeno thaan ||",
      "translation": "The Guru has given shelter to the shelterless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਿਮਾਨੇ ਕਉ ਗੁਰਿ ਕੀਨੋ ਮਾਨੁ ॥",
      "transliteration": "nimaane kau gur keeno maan ||",
      "translation": "The Guru has given honor to the dishonored.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬੰਧਨ ਕਾਟਿ ਸੇਵਕ ਕਰਿ ਰਾਖੇ ॥",
      "transliteration": "ba(n)dhan kaat sevak kar raakhe ||",
      "translation": "Shattering his bonds, the Guru has saved His servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਬਾਨੀ ਰਸਨਾ ਚਾਖੇ ॥੩॥",
      "transliteration": "a(n)mrit baanee rasanaa chaakhe ||3||",
      "translation": "I taste with my tongue the Ambrosial Bani of His Word. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਵਡੈ ਭਾਗਿ ਪੂਜ ਗੁਰ ਚਰਨਾ ॥",
      "transliteration": "vadai bhaag pooj gur charanaa ||",
      "translation": "By great good fortune, I worship the Guru's feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0395_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਗਲ ਤਿਆਗਿ ਪਾਈ ਪ੍ਰਭ ਸਰਨਾ ॥",
      "transliteration": "sagal tiaag paaee prabh saranaa ||",
      "translation": "Forsaking everything, I have obtained God's Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 395,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
