{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 409,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0409_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਜਿ ਮਾਨ ਮੋਹ ਵਿਕਾਰ ਮਿਥਿਆ ਜਪਿ ਰਾਮ ਰਾਮ ਰਾਮ ॥",
      "transliteration": "taj maan moh vikaar mithiaa jap raam raam raam ||",
      "translation": "Renounce pride, attachment, corruption and falsehood, and chant the Name of the Lord, Raam, Raam, Raam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਨ ਸੰਤਨਾ ਕੈ ਚਰਨਿ ਲਾਗੁ ॥੧॥",
      "transliteration": "man sa(n)tanaa kai charan laag ||1||",
      "translation": "O mortal, attach yourself to the Feet of the Saints. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਭ ਗੋਪਾਲ ਦੀਨ ਦਇਆਲ ਪਤਿਤ ਪਾਵਨ ਪਾਰਬ੍ਰਹਮ ਹਰਿ ਚਰਣ ਸਿਮਰਿ ਜਾਗੁ ॥",
      "transliteration": "prabh gopaal deen daiaal patit paavan paarabraham har charan simar jaag ||",
      "translation": "God is the Sustainer of the world, Merciful to the meek, the Purifier of sinners, the Transcendent Lord God. Awaken, and meditate on His Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਰਿ ਭਗਤਿ ਨਾਨਕ ਪੂਰਨ ਭਾਗੁ ॥੨॥੪॥੧੫੫॥",
      "transliteration": "kar bhagat naanak pooran bhaag ||2||4||155||",
      "translation": "Perform His devotional worship, O Nanak, and your destiny shall be fulfilled. ||2||4||155||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaa mahalaa 5 ||",
      "translation": "Aasaa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਰਖ ਸੋਗ ਬੈਰਾਗ ਅਨੰਦੀ ਖੇਲੁ ਰੀ ਦਿਖਾਇਓ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "harakh sog bairaag ana(n)dee khel ree dikhaaio ||1|| rahaau ||",
      "translation": "Pleasure and pain, detachment and ecstasy - the Lord has revealed His Play. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਖਿਨਹੂੰ ਭੈ ਨਿਰਭੈ ਖਿਨਹੂੰ ਖਿਨਹੂੰ ਉਠਿ ਧਾਇਓ ॥",
      "transliteration": "khinahoo(n) bhai nirabhai khinahoo(n) khinahoo(n) uth dhaaio ||",
      "translation": "One moment, the mortal is in fear, and the next moment he is fearless; in a moment, he gets up and departs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਖਿਨਹੂੰ ਰਸ ਭੋਗਨ ਖਿਨਹੂੰ ਖਿਨਹੂ ਤਜਿ ਜਾਇਓ ॥੧॥",
      "transliteration": "khinahoo(n) ras bhogan khinahoo(n) khinahoo taj jaaio ||1||",
      "translation": "One moment, he enjoys pleasures, and the next moment, he leaves and goes away. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਖਿਨਹੂੰ ਜੋਗ ਤਾਪ ਬਹੁ ਪੂਜਾ ਖਿਨਹੂੰ ਭਰਮਾਇਓ ॥",
      "transliteration": "khinahoo(n) jog taap bahu poojaa khinahoo(n) bharamaaio ||",
      "translation": "One moment, he practices Yoga and intense meditation, and all sorts of worship; the next moment, he wanders in doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਖਿਨਹੂੰ ਕਿਰਪਾ ਸਾਧੂ ਸੰਗ ਨਾਨਕ ਹਰਿ ਰੰਗੁ ਲਾਇਓ ॥੨॥੫॥੧੫੬॥",
      "transliteration": "khinahoo(n) kirapaa saadhoo sa(n)g naanak har ra(n)g laaio ||2||5||156||",
      "translation": "One moment, O Nanak, the Lord bestows His Mercy and blesses him with His Love, in the Saadh Sangat, the Company of the Holy. ||2||5||156||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਗੁ ਆਸਾ ਮਹਲਾ ੫ ਘਰੁ ੧੭ ਆਸਾਵਰੀ ॥",
      "transliteration": "raag aasaa mahalaa 5 ghar 17 aasaavaree ||",
      "translation": "Raag Aasaa, Fifth Mehl, Seventeenth House, Aasaavaree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੋਬਿੰਦ ਗੋਬਿੰਦ ਕਰਿ ਹਾਂ ॥",
      "transliteration": "gobi(n)d gobi(n)d kar haa(n) ||",
      "translation": "Meditate on the Lord, the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਮਨਿ ਪਿਆਰਿ ਹਾਂ ॥",
      "transliteration": "har har man piaar haa(n) ||",
      "translation": "Cherish the Beloved Lord, Har, Har, in your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰਿ ਕਹਿਆ ਸੁ ਚਿਤਿ ਧਰਿ ਹਾਂ ॥",
      "transliteration": "gur kahiaa s chit dhar haa(n) ||",
      "translation": "The Guru says to install it in your consciousness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਨ ਸਿਉ ਤੋਰਿ ਫੇਰਿ ਹਾਂ ॥",
      "transliteration": "an siu tor pher haa(n) ||",
      "translation": "Turn away from others, and turn to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਐਸੇ ਲਾਲਨੁ ਪਾਇਓ ਰੀ ਸਖੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aise laalan paaio ree sakhee ||1|| rahaau ||",
      "translation": "Thus you shall obtain your Beloved, O my companion. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪੰਕਜ ਮੋਹ ਸਰਿ ਹਾਂ ॥",
      "transliteration": "pa(n)kaj moh sar haa(n) ||",
      "translation": "In the pool of the world is the mud of attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪਗੁ ਨਹੀ ਚਲੈ ਹਰਿ ਹਾਂ ॥",
      "transliteration": "pag nahee chalai har haa(n) ||",
      "translation": "Stuck in it, his feet cannot walk towards the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗਹਡਿਓ ਮੂੜ ਨਰਿ ਹਾਂ ॥",
      "transliteration": "gahadio mooR nar haa(n) ||",
      "translation": "The fool is stuck;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਨਿਨ ਉਪਾਵ ਕਰਿ ਹਾਂ ॥",
      "transliteration": "anin upaav kar haa(n) ||",
      "translation": "he cannot do anything else.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਉ ਨਿਕਸੈ ਸਰਨਿ ਪੈ ਰੀ ਸਖੀ ॥੧॥",
      "transliteration": "tau nikasai saran pai ree sakhee ||1||",
      "translation": "Only by entering the Lord's Sanctuary, O my companion, will you be released. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਥਿਰ ਥਿਰ ਚਿਤ ਥਿਰ ਹਾਂ ॥",
      "transliteration": "thir thir chit thir haa(n) ||",
      "translation": "Thus your consciousness shall be stable and steady and firm.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਨੁ ਗ੍ਰਿਹੁ ਸਮਸਰਿ ਹਾਂ ॥",
      "transliteration": "ban grihu samasar haa(n) ||",
      "translation": "Wilderness and household are the same.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅੰਤਰਿ ਏਕ ਪਿਰ ਹਾਂ ॥",
      "transliteration": "a(n)tar ek pir haa(n) ||",
      "translation": "Deep within dwells the One Husband Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਾਹਰਿ ਅਨੇਕ ਧਰਿ ਹਾਂ ॥",
      "transliteration": "baahar anek dhar haa(n) ||",
      "translation": "outwardly, there are many distractions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਾਜਨ ਜੋਗੁ ਕਰਿ ਹਾਂ ॥",
      "transliteration": "raajan jog kar haa(n) ||",
      "translation": "Practice Raja Yoga, the Yoga of meditation and success.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਲੋਗ ਅਲੋਗੀ ਰੀ ਸਖੀ ॥੨॥੧॥੧੫੭॥",
      "transliteration": "kahu naanak log alogee ree sakhee ||2||1||157||",
      "translation": "Says Nanak, this is the way to dwell with the people, and yet remain apart from them. ||2||1||157||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਸਾਵਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaavaree mahalaa 5 ||",
      "translation": "Aasaavaree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਨਸਾ ਏਕ ਮਾਨਿ ਹਾਂ ॥",
      "transliteration": "manasaa ek maan haa(n) ||",
      "translation": "Cherish one desire only:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗੁਰ ਸਿਉ ਨੇਤ ਧਿਆਨਿ ਹਾਂ ॥",
      "transliteration": "gur siu net dhiaan haa(n) ||",
      "translation": "meditate continually on the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦ੍ਰਿੜੁ ਸੰਤ ਮੰਤ ਗਿਆਨਿ ਹਾਂ ॥",
      "transliteration": "driR sa(n)t ma(n)t giaan haa(n) ||",
      "translation": "Install the wisdom of the Saints' Mantra.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੇਵਾ ਗੁਰ ਚਰਾਨਿ ਹਾਂ ॥",
      "transliteration": "sevaa gur charaan haa(n) ||",
      "translation": "Serve the Feet of the Guru,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਉ ਮਿਲੀਐ ਗੁਰ ਕ੍ਰਿਪਾਨਿ ਮੇਰੇ ਮਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tau mileeai gur kripaan mere manaa ||1|| rahaau ||",
      "translation": "and you shall meet Him, by Guru's Grace, O my mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਟੂਟੇ ਅਨ ਭਰਾਨਿ ਹਾਂ ॥",
      "transliteration": "toote an bharaan haa(n) ||",
      "translation": "All doubts are dispelled,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਵਿਓ ਸਰਬ ਥਾਨਿ ਹਾਂ ॥",
      "transliteration": "ravio sarab thaan haa(n) ||",
      "translation": "and the Lord is seen to be pervading all places.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਲਹਿਓ ਜਮ ਭਇਆਨਿ ਹਾਂ ॥",
      "transliteration": "lahio jam bhaiaan haa(n) ||",
      "translation": "The fear of death is dispelled,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪਾਇਓ ਪੇਡ ਥਾਨਿ ਹਾਂ ॥",
      "transliteration": "paaio ped thaan haa(n) ||",
      "translation": "and the primal place is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਉ ਚੂਕੀ ਸਗਲ ਕਾਨਿ ॥੧॥",
      "transliteration": "tau chookee sagal kaan ||1||",
      "translation": "Then, all subservience is removed. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲਹਨੋ ਜਿਸੁ ਮਥਾਨਿ ਹਾਂ ॥",
      "transliteration": "lahano jis mathaan haa(n) ||",
      "translation": "One who has such destiny recorded upon his forehead, obtains it;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੈ ਪਾਵਕ ਪਾਰਿ ਪਰਾਨਿ ਹਾਂ ॥",
      "transliteration": "bhai paavak paar paraan haa(n) ||",
      "translation": "he crosses over the terrifying ocean of fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਿਜ ਘਰਿ ਤਿਸਹਿ ਥਾਨਿ ਹਾਂ ॥",
      "transliteration": "nij ghar tisahi thaan haa(n) ||",
      "translation": "He obtains a place in the home of his own self,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਰਿ ਰਸ ਰਸਹਿ ਮਾਨਿ ਹਾਂ ॥",
      "transliteration": "har ras rasahi maan haa(n) ||",
      "translation": "and enjoys the most sublime essence of the Lord's essence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਲਾਥੀ ਤਿਸ ਭੁਖਾਨਿ ਹਾਂ ॥",
      "transliteration": "laathee tis bhukhaan haa(n) ||",
      "translation": "His hunger is appeased;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਸਹਜਿ ਸਮਾਇਓ ਰੇ ਮਨਾ ॥੨॥੨॥੧੫੮॥",
      "transliteration": "naanak sahaj samaaio re manaa ||2||2||158||",
      "translation": "Nanak, he is absorbed in celestial peace, O my mind. ||2||2||158||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਸਾਵਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaavaree mahalaa 5 ||",
      "translation": "Aasaavaree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਹਰਿ ਗੁਨੀ ਹਾਂ ॥",
      "transliteration": "har har har gunee haa(n) ||",
      "translation": "Sing the Praises of the Lord, Har, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਪੀਐ ਸਹਜ ਧੁਨੀ ਹਾਂ ॥",
      "transliteration": "japeeai sahaj dhunee haa(n) ||",
      "translation": "Meditate on the celestial music.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਾਧੂ ਰਸਨ ਭਨੀ ਹਾਂ ॥",
      "transliteration": "saadhoo rasan bhanee haa(n) ||",
      "translation": "The tongues of the holy Saints repeat it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਛੂਟਨ ਬਿਧਿ ਸੁਨੀ ਹਾਂ ॥",
      "transliteration": "chhootan bidh sunee haa(n) ||",
      "translation": "I have heard that this is the way to emancipation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪਾਈਐ ਵਡ ਪੁਨੀ ਮੇਰੇ ਮਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "paaeeai vad punee mere manaa ||1|| rahaau ||",
      "translation": "This is found by the greatest merit, O my mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਖੋਜਹਿ ਜਨ ਮੁਨੀ ਹਾਂ ॥",
      "transliteration": "khojahi jan munee haa(n) ||",
      "translation": "The silent sages search for Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸ੍ਰਬ ਕਾ ਪ੍ਰਭ ਧਨੀ ਹਾਂ ॥",
      "transliteration": "srab kaa prabh dhanee haa(n) ||",
      "translation": "God is the Master of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਦੁਲਭ ਕਲਿ ਦੁਨੀ ਹਾਂ ॥",
      "transliteration": "dulabh kal dunee haa(n) ||",
      "translation": "It is so difficult to find Him in this world, in this Dark Age of Kali Yuga.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਦੂਖ ਬਿਨਾਸਨੀ ਹਾਂ ॥",
      "transliteration": "dookh binaasanee haa(n) ||",
      "translation": "He is the Dispeller of distress.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਪ੍ਰਭ ਪੂਰਨ ਆਸਨੀ ਮੇਰੇ ਮਨਾ ॥੧॥",
      "transliteration": "prabh pooran aasanee mere manaa ||1||",
      "translation": "God is the Fulfiller of desires, O my mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0409_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮਨ ਸੋ ਸੇਵੀਐ ਹਾਂ ॥",
      "transliteration": "man so seveeai haa(n) ||",
      "translation": "O my mind, serve Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 409,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
