{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 410,
  "lineCount": 75,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0410_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਲਖ ਅਭੇਵੀਐ ਹਾਂ ॥",
      "transliteration": "alakh abheveeai haa(n) ||",
      "translation": "He is unknowable and inscrutable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਾਂ ਸਿਉ ਪ੍ਰੀਤਿ ਕਰਿ ਹਾਂ ॥",
      "transliteration": "taa(n) siu preet kar haa(n) ||",
      "translation": "Enshrine love for Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਨਸਿ ਨ ਜਾਇ ਮਰਿ ਹਾਂ ॥",
      "transliteration": "binas na jaai mar haa(n) ||",
      "translation": "He does not perish, or go away, or die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰ ਤੇ ਜਾਨਿਆ ਹਾਂ ॥",
      "transliteration": "gur te jaaniaa haa(n) ||",
      "translation": "He is known only through the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਨਕ ਮਨੁ ਮਾਨਿਆ ਮੇਰੇ ਮਨਾ ॥੨॥੩॥੧੫੯॥",
      "transliteration": "naanak man maaniaa mere manaa ||2||3||159||",
      "translation": "Nanak, my mind is satisfied with the Lord, O my mind. ||2||3||159||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਸਾਵਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaavaree mahalaa 5 ||",
      "translation": "Aasaavaree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਏਕਾ ਓਟ ਗਹੁ ਹਾਂ ॥",
      "transliteration": "ekaa ot gahu haa(n) ||",
      "translation": "Grab hold of the Support of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਕਹੁ ਹਾਂ ॥",
      "transliteration": "gur kaa sabad kahu haa(n) ||",
      "translation": "Chant the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਗਿਆ ਸਤਿ ਸਹੁ ਹਾਂ ॥",
      "transliteration": "aagiaa sat sahu haa(n) ||",
      "translation": "Submit to the Order of the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨਹਿ ਨਿਧਾਨੁ ਲਹੁ ਹਾਂ ॥",
      "transliteration": "manahi nidhaan lahu haa(n) ||",
      "translation": "Receive the treasure in your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੁਖਹਿ ਸਮਾਈਐ ਮੇਰੇ ਮਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sukhahi samaaeeai mere manaa ||1|| rahaau ||",
      "translation": "Thus you shall be absorbed in peace, O my mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੀਵਤ ਜੋ ਮਰੈ ਹਾਂ ॥",
      "transliteration": "jeevat jo marai haa(n) ||",
      "translation": "One who is dead while yet alive,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੁਤਰੁ ਸੋ ਤਰੈ ਹਾਂ ॥",
      "transliteration": "dutar so tarai haa(n) ||",
      "translation": "crosses over the terrifying world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਭ ਕੀ ਰੇਨੁ ਹੋਇ ਹਾਂ ॥",
      "transliteration": "sabh kee ren hoi haa(n) ||",
      "translation": "One who becomes the dust of all",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਿਰਭਉ ਕਹਉ ਸੋਇ ਹਾਂ ॥",
      "transliteration": "nirabhau kahau soi haa(n) ||",
      "translation": "he alone is called fearless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਿਟੇ ਅੰਦੇਸਿਆ ਹਾਂ ॥",
      "transliteration": "mite a(n)desiaa haa(n) ||",
      "translation": "His anxieties are removed",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੰਤ ਉਪਦੇਸਿਆ ਮੇਰੇ ਮਨਾ ॥੧॥",
      "transliteration": "sa(n)t upadesiaa mere manaa ||1||",
      "translation": "by the Teachings of the Saints, O my mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਸੁ ਜਨ ਨਾਮ ਸੁਖੁ ਹਾਂ ॥",
      "transliteration": "jis jan naam sukh haa(n) ||",
      "translation": "That humble being, who takes happiness in the Naam, the Name of the Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਿਸੁ ਨਿਕਟਿ ਨ ਕਦੇ ਦੁਖੁ ਹਾਂ ॥",
      "transliteration": "tis nikat na kade dukh haa(n) ||",
      "translation": "pain never draws near him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੋ ਹਰਿ ਹਰਿ ਜਸੁ ਸੁਨੇ ਹਾਂ ॥",
      "transliteration": "jo har har jas sune haa(n) ||",
      "translation": "One who listens to the Praise of the Lord, Har, Har,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਭੁ ਕੋ ਤਿਸੁ ਮੰਨੇ ਹਾਂ ॥",
      "transliteration": "sabh ko tis ma(n)ne haa(n) ||",
      "translation": "is obeyed by all men.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਫਲੁ ਸੁ ਆਇਆ ਹਾਂ ॥",
      "transliteration": "saphal s aaiaa haa(n) ||",
      "translation": "How fortunate it is that he came into the world;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਨਕ ਪ੍ਰਭ ਭਾਇਆ ਮੇਰੇ ਮਨਾ ॥੨॥੪॥੧੬੦॥",
      "transliteration": "naanak prabh bhaaiaa mere manaa ||2||4||160||",
      "translation": "Nanak, he is pleasing to God, O my mind. ||2||4||160||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਸਾਵਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaavaree mahalaa 5 ||",
      "translation": "Aasaavaree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਿਲਿ ਹਰਿ ਜਸੁ ਗਾਈਐ ਹਾਂ ॥",
      "transliteration": "mil har jas gaaeeai haa(n) ||",
      "translation": "Meeting together, let us sing the Praises of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਰਮ ਪਦੁ ਪਾਈਐ ਹਾਂ ॥",
      "transliteration": "param pad paaeeai haa(n) ||",
      "translation": "and attain the supreme state.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਉਆ ਰਸ ਜੋ ਬਿਧੇ ਹਾਂ ॥",
      "transliteration": "uaa ras jo bidhe haa(n) ||",
      "translation": "Those who obtain that sublime essence,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਾ ਕਉ ਸਗਲ ਸਿਧੇ ਹਾਂ ॥",
      "transliteration": "taa kau sagal sidhe haa(n) ||",
      "translation": "obtain all of the spiritual powers of the Siddhas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਨਦਿਨੁ ਜਾਗਿਆ ਹਾਂ ॥",
      "transliteration": "anadin jaagiaa haa(n) ||",
      "translation": "They remain awake and aware night and day;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਾਨਕ ਬਡਭਾਗਿਆ ਮੇਰੇ ਮਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naanak badabhaagiaa mere manaa ||1|| rahaau ||",
      "translation": "Nanak, they are blessed by great good fortune, O my mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੰਤ ਪਗ ਧੋਈਐ ਹਾਂ ॥",
      "transliteration": "sa(n)t pag dhoeeai haa(n) ||",
      "translation": "Let us wash the feet of the Saints;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੁਰਮਤਿ ਖੋਈਐ ਹਾਂ ॥",
      "transliteration": "duramat khoeeai haa(n) ||",
      "translation": "our evil-mindedness shall be cleansed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦਾਸਹ ਰੇਨੁ ਹੋਇ ਹਾਂ ॥",
      "transliteration": "daasah ren hoi haa(n) ||",
      "translation": "Becoming the dust of the feet of the Lord's slaves,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਿਆਪੈ ਦੁਖੁ ਨ ਕੋਇ ਹਾਂ ॥",
      "transliteration": "biaapai dukh na koi haa(n) ||",
      "translation": "one shall not be afflicted with pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਗਤਾਂ ਸਰਨਿ ਪਰੁ ਹਾਂ ॥",
      "transliteration": "bhagataa(n) saran par haa(n) ||",
      "translation": "Taking to the Sanctuary of His devotees,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਨਮਿ ਨ ਕਦੇ ਮਰੁ ਹਾਂ ॥",
      "transliteration": "janam na kade mar haa(n) ||",
      "translation": "he is no longer subject to birth and death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਸਥਿਰੁ ਸੇ ਭਏ ਹਾਂ ॥",
      "transliteration": "asathir se bhae haa(n) ||",
      "translation": "They alone become eternal,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਜਿਨੑ ਜਪਿ ਲਏ ਮੇਰੇ ਮਨਾ ॥੧॥",
      "transliteration": "har har jinh jap lae mere manaa ||1||",
      "translation": "who chant the Name of the Lord, Har, Har, O my mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਾਜਨੁ ਮੀਤੁ ਤੂੰ ਹਾਂ ॥",
      "transliteration": "saajan meet too(n) haa(n) ||",
      "translation": "You are my Friend, my Best Friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾਮੁ ਦ੍ਰਿੜਾਇ ਮੂੰ ਹਾਂ ॥",
      "transliteration": "naam driRaai moo(n) haa(n) ||",
      "translation": "Please, implant the Naam, the Name of the Lord, within me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਿਸੁ ਬਿਨੁ ਨਾਹਿ ਕੋਇ ਹਾਂ ॥",
      "transliteration": "tis bin naahi koi haa(n) ||",
      "translation": "Without Him, there is not any other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਨਹਿ ਅਰਾਧਿ ਸੋਇ ਹਾਂ ॥",
      "transliteration": "manahi araadh soi haa(n) ||",
      "translation": "Within my mind, I worship Him in adoration.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਿਮਖ ਨ ਵੀਸਰੈ ਹਾਂ ॥",
      "transliteration": "nimakh na veesarai haa(n) ||",
      "translation": "I do not forget Him, even for an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਸੁ ਬਿਨੁ ਕਿਉ ਸਰੈ ਹਾਂ ॥",
      "transliteration": "tis bin kiu sarai haa(n) ||",
      "translation": "How can I live without Him?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰ ਕਉ ਕੁਰਬਾਨੁ ਜਾਉ ਹਾਂ ॥",
      "transliteration": "gur kau kurabaan jaau haa(n) ||",
      "translation": "I am a sacrifice to the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕੁ ਜਪੇ ਨਾਉ ਮੇਰੇ ਮਨਾ ॥੨॥੫॥੧੬੧॥",
      "transliteration": "naanak jape naau mere manaa ||2||5||161||",
      "translation": "Nanak, chant the Name, O my mind. ||2||5||161||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਸਾਵਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "aasaavaree mahalaa 5 ||",
      "translation": "Aasaavaree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਾਰਨ ਕਰਨ ਤੂੰ ਹਾਂ ॥",
      "transliteration": "kaaran karan too(n) haa(n) ||",
      "translation": "You are the Creator, the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਵਰੁ ਨਾ ਸੁਝੈ ਮੂੰ ਹਾਂ ॥",
      "transliteration": "avar naa sujhai moo(n) haa(n) ||",
      "translation": "I cannot think of any other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਰਹਿ ਸੁ ਹੋਈਐ ਹਾਂ ॥",
      "transliteration": "karahi s hoeeai haa(n) ||",
      "translation": "Whatever You do, comes to pass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਹਜਿ ਸੁਖਿ ਸੋਈਐ ਹਾਂ ॥",
      "transliteration": "sahaj sukh soeeai haa(n) ||",
      "translation": "I sleep in peace and poise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਧੀਰਜ ਮਨਿ ਭਏ ਹਾਂ ॥",
      "transliteration": "dheeraj man bhae haa(n) ||",
      "translation": "My mind has become patient,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਪ੍ਰਭ ਕੈ ਦਰਿ ਪਏ ਮੇਰੇ ਮਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "prabh kai dar pae mere manaa ||1|| rahaau ||",
      "translation": "since I fell at God's Door, O my mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਾਧੂ ਸੰਗਮੇ ਹਾਂ ॥",
      "transliteration": "saadhoo sa(n)game haa(n) ||",
      "translation": "Joining the Saadh Sangat, the Company of the Holy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪੂਰਨ ਸੰਜਮੇ ਹਾਂ ॥",
      "transliteration": "pooran sa(n)jame haa(n) ||",
      "translation": "I gained perfect control over my senses.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਜਬ ਤੇ ਛੁਟੇ ਆਪ ਹਾਂ ॥",
      "transliteration": "jab te chhute aap haa(n) ||",
      "translation": "Ever since I rid myself of my self-conceit,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਬ ਤੇ ਮਿਟੇ ਤਾਪ ਹਾਂ ॥",
      "transliteration": "tab te mite taap haa(n) ||",
      "translation": "my sufferings have ended.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਿਰਪਾ ਧਾਰੀਆ ਹਾਂ ॥",
      "transliteration": "kirapaa dhaareeaa haa(n) ||",
      "translation": "He has showered His Mercy upon me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਪਤਿ ਰਖੁ ਬਨਵਾਰੀਆ ਮੇਰੇ ਮਨਾ ॥੧॥",
      "transliteration": "pat rakh banavaareeaa mere manaa ||1||",
      "translation": "The Creator Lord has preserved my honor, O my mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਇਹੁ ਸੁਖੁ ਜਾਨੀਐ ਹਾਂ ॥",
      "transliteration": "ihu sukh jaaneeai haa(n) ||",
      "translation": "Know that this is the only peace;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਹਰਿ ਕਰੇ ਸੁ ਮਾਨੀਐ ਹਾਂ ॥",
      "transliteration": "har kare s maaneeai haa(n) ||",
      "translation": "accept whatever the Lord does.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਮੰਦਾ ਨਾਹਿ ਕੋਇ ਹਾਂ ॥",
      "transliteration": "ma(n)daa naahi koi haa(n) ||",
      "translation": "No one is bad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਸੰਤ ਕੀ ਰੇਨ ਹੋਇ ਹਾਂ ॥",
      "transliteration": "sa(n)t kee ren hoi haa(n) ||",
      "translation": "Become the dust of the Feet of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਆਪੇ ਜਿਸੁ ਰਖੈ ਹਾਂ ॥",
      "transliteration": "aape jis rakhai haa(n) ||",
      "translation": "He Himself preserves those",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਹਰਿ ਅੰਮ੍ਰਿਤੁ ਸੋ ਚਖੈ ਮੇਰੇ ਮਨਾ ॥੨॥",
      "transliteration": "har a(n)mrit so chakhai mere manaa ||2||",
      "translation": "who taste the Ambrosial Nectar of the Lord, O my mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਜਿਸ ਕਾ ਨਾਹਿ ਕੋਇ ਹਾਂ ॥",
      "transliteration": "jis kaa naahi koi haa(n) ||",
      "translation": "One who has no one to call his own",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0067",
      "lineIndex": 67,
      "gurmukhi": "ਤਿਸ ਕਾ ਪ੍ਰਭੂ ਸੋਇ ਹਾਂ ॥",
      "transliteration": "tis kaa prabhoo soi haa(n) ||",
      "translation": "God belongs to him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0068",
      "lineIndex": 68,
      "gurmukhi": "ਅੰਤਰਗਤਿ ਬੁਝੈ ਹਾਂ ॥",
      "transliteration": "a(n)taragat bujhai haa(n) ||",
      "translation": "God knows the state of our innermost being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0069",
      "lineIndex": 69,
      "gurmukhi": "ਸਭੁ ਕਿਛੁ ਤਿਸੁ ਸੁਝੈ ਹਾਂ ॥",
      "transliteration": "sabh kichh tis sujhai haa(n) ||",
      "translation": "He knows everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0070",
      "lineIndex": 70,
      "gurmukhi": "ਪਤਿਤ ਉਧਾਰਿ ਲੇਹੁ ਹਾਂ ॥",
      "transliteration": "patit udhaar lehu haa(n) ||",
      "translation": "Please, Lord, save the sinners.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0071",
      "lineIndex": 71,
      "gurmukhi": "ਨਾਨਕ ਅਰਦਾਸਿ ਏਹੁ ਮੇਰੇ ਮਨਾ ॥੩॥੬॥੧੬੨॥",
      "transliteration": "naanak aradaas ehu mere manaa ||3||6||162||",
      "translation": "This is Nanak's prayer, O my mind. ||3||6||162||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0072",
      "lineIndex": 72,
      "gurmukhi": "ਆਸਾਵਰੀ ਮਹਲਾ ੫ ਇਕਤੁਕਾ ॥",
      "transliteration": "aasaavaree mahalaa 5 ikatukaa ||",
      "translation": "Aasaavaree, Fifth Mehl, Ek-Thukay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0073",
      "lineIndex": 73,
      "gurmukhi": "ਓਇ ਪਰਦੇਸੀਆ ਹਾਂ ॥",
      "transliteration": "oi paradeseeaa haa(n) ||",
      "translation": "O my stranger soul,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0074",
      "lineIndex": 74,
      "gurmukhi": "ਸੁਨਤ ਸੰਦੇਸਿਆ ਹਾਂ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sunat sa(n)desiaa haa(n) ||1|| rahaau ||",
      "translation": "listen to the call. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0410_line_0075",
      "lineIndex": 75,
      "gurmukhi": "ਜਾ ਸਿਉ ਰਚਿ ਰਹੇ ਹਾਂ ॥",
      "transliteration": "jaa siu rach rahe haa(n) ||",
      "translation": "Whatever you are attached to,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 410,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
