{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 411,
  "lineCount": 50,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0411_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਭ ਕਉ ਤਜਿ ਗਏ ਹਾਂ ॥",
      "transliteration": "sabh kau taj gae haa(n) ||",
      "translation": "you shall have to leave it all behind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁਪਨਾ ਜਿਉ ਭਏ ਹਾਂ ॥",
      "transliteration": "supanaa jiu bhae haa(n) ||",
      "translation": "These things seem like only a dream,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਰਿ ਨਾਮੁ ਜਿਨੑਿ ਲਏ ॥੧॥",
      "transliteration": "har naam jinhi lae ||1||",
      "translation": "to one who takes the Lord's Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਰਿ ਤਜਿ ਅਨ ਲਗੇ ਹਾਂ ॥",
      "transliteration": "har taj an lage haa(n) ||",
      "translation": "Forsaking the Lord, and clinging to another,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਨਮਹਿ ਮਰਿ ਭਗੇ ਹਾਂ ॥",
      "transliteration": "janamahi mar bhage haa(n) ||",
      "translation": "they run toward death and reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਜਨਿ ਲਹੇ ਹਾਂ ॥",
      "transliteration": "har har jan lahe haa(n) ||",
      "translation": "But those humble beings, who attach themselves to the Lord, Har, Har,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੀਵਤ ਸੇ ਰਹੇ ਹਾਂ ॥",
      "transliteration": "jeevat se rahe haa(n) ||",
      "translation": "continue to live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਸਹਿ ਕ੍ਰਿਪਾਲੁ ਹੋਇ ਹਾਂ ॥",
      "transliteration": "jisahi kripaal hoi haa(n) ||",
      "translation": "One who is blessed with the Lord's Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਨਕ ਭਗਤੁ ਸੋਇ ॥੨॥੭॥੧੬੩॥੨੩੨॥",
      "transliteration": "naanak bhagat soi ||2||7||163||232||",
      "translation": "O Nanak, becomes His devotee. ||2||7||163||232||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਗੁ ਆਸਾ ਮਹਲਾ ੯ ॥",
      "transliteration": "raag aasaa mahalaa 9 ||",
      "translation": "Raag Aasaa, Ninth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਿਰਥਾ ਕਹਉ ਕਉਨ ਸਿਉ ਮਨ ਕੀ ॥",
      "transliteration": "birathaa kahau kaun siu man kee ||",
      "translation": "Who should I tell the condition of the mind?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲੋਭਿ ਗ੍ਰਸਿਓ ਦਸ ਹੂ ਦਿਸ ਧਾਵਤ ਆਸਾ ਲਾਗਿਓ ਧਨ ਕੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "lobh grasio das hoo dis dhaavat aasaa laagio dhan kee ||1|| rahaau ||",
      "translation": "Engrossed in greed, running around in the ten directions, you hold to your hopes of wealth. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੁਖ ਕੈ ਹੇਤਿ ਬਹੁਤੁ ਦੁਖੁ ਪਾਵਤ ਸੇਵ ਕਰਤ ਜਨ ਜਨ ਕੀ ॥",
      "transliteration": "sukh kai het bahut dukh paavat sev karat jan jan kee ||",
      "translation": "For the sake of pleasure, you suffer such great pain, and you have to serve each and every person.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੁਆਰਹਿ ਦੁਆਰਿ ਸੁਆਨ ਜਿਉ ਡੋਲਤ ਨਹ ਸੁਧ ਰਾਮ ਭਜਨ ਕੀ ॥੧॥",
      "transliteration": "duaarahi duaar suaan jiu dolat nah sudh raam bhajan kee ||1||",
      "translation": "You wander from door to door like a dog, unconscious of the Lord's meditation. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਾਨਸ ਜਨਮ ਅਕਾਰਥ ਖੋਵਤ ਲਾਜ ਨ ਲੋਕ ਹਸਨ ਕੀ ॥",
      "transliteration": "maanas janam akaarath khovat laaj na lok hasan kee ||",
      "translation": "You lose this human life in vain, and You are not even ashamed when others laugh at you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਜਸੁ ਕਿਉ ਨਹੀ ਗਾਵਤ ਕੁਮਤਿ ਬਿਨਾਸੈ ਤਨ ਕੀ ॥੨॥੧॥੨੩੩॥",
      "transliteration": "naanak har jas kiu nahee gaavat kumat binaasai tan kee ||2||1||233||",
      "translation": "O Nanak, why not sing the Lord's Praises, so that you may be rid of the body's evil disposition? ||2||1||233||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਾਗੁ ਆਸਾ ਮਹਲਾ ੧ ਅਸਟਪਦੀਆ ਘਰੁ ੨ ॥",
      "transliteration": "raag aasaa mahalaa 1 asatapadeeaa ghar 2 ||",
      "translation": "Raag Aasaa, First Mehl, Ashtpadheeyaa, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਉਤਰਿ ਅਵਘਟਿ ਸਰਵਰਿ ਨੑਾਵੈ ॥",
      "transliteration": "utar avaghat saravar nhaavai ||",
      "translation": "He descends the treacherous precipice, to bathe in the cleansing pool;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਕੈ ਨ ਬੋਲੈ ਹਰਿ ਗੁਣ ਗਾਵੈ ॥",
      "transliteration": "bakai na bolai har gun gaavai ||",
      "translation": "without speaking or saying anything, he sings the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਲੁ ਆਕਾਸੀ ਸੁੰਨਿ ਸਮਾਵੈ ॥",
      "transliteration": "jal aakaasee su(n)n samaavai ||",
      "translation": "Like water vapor in the sky, he remains absorbed in the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਸੁ ਸਤੁ ਝੋਲਿ ਮਹਾ ਰਸੁ ਪਾਵੈ ॥੧॥",
      "transliteration": "ras sat jhol mahaa ras paavai ||1||",
      "translation": "He churns the true pleasures to obtain the supreme nectar. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਐਸਾ ਗਿਆਨੁ ਸੁਨਹੁ ਅਭ ਮੋਰੇ ॥",
      "transliteration": "aisaa giaan sunahu abh more ||",
      "translation": "Listen to such spiritual wisdom, O my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭਰਿਪੁਰਿ ਧਾਰਿ ਰਹਿਆ ਸਭ ਠਉਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bharipur dhaar rahiaa sabh thaure ||1|| rahaau ||",
      "translation": "The Lord is totally pervading and permeating all places. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਚੁ ਬ੍ਰਤੁ ਨੇਮੁ ਨ ਕਾਲੁ ਸੰਤਾਵੈ ॥",
      "transliteration": "sach brat nem na kaal sa(n)taavai ||",
      "translation": "One who makes Truthfulness his fast and religious vows, does not suffer the pain of death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਤਿਗੁਰ ਸਬਦਿ ਕਰੋਧੁ ਜਲਾਵੈ ॥",
      "transliteration": "satigur sabad karodh jalaavai ||",
      "translation": "Through the Word of the Guru's Shabad, he burns away his anger.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗਗਨਿ ਨਿਵਾਸਿ ਸਮਾਧਿ ਲਗਾਵੈ ॥",
      "transliteration": "gagan nivaas samaadh lagaavai ||",
      "translation": "He dwells in the Tenth Gate, immersed in the Samaadhi of deep meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪਾਰਸੁ ਪਰਸਿ ਪਰਮ ਪਦੁ ਪਾਵੈ ॥੨॥",
      "transliteration": "paaras paras param pad paavai ||2||",
      "translation": "Touching the philosopher's stone, he obtains the supreme status. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਚੁ ਮਨ ਕਾਰਣਿ ਤਤੁ ਬਿਲੋਵੈ ॥",
      "transliteration": "sach man kaaran tat bilovai ||",
      "translation": "For the benefit of the mind, churn the true essence of reality;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੁਭਰ ਸਰਵਰਿ ਮੈਲੁ ਨ ਧੋਵੈ ॥",
      "transliteration": "subhar saravar mail na dhovai ||",
      "translation": "bathing in the over-flowing tank of nectar, filth is washed away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੈ ਸਿਉ ਰਾਤਾ ਤੈਸੋ ਹੋਵੈ ॥",
      "transliteration": "jai siu raataa taiso hovai ||",
      "translation": "We become like the One with whom we are imbued.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਪੇ ਕਰਤਾ ਕਰੇ ਸੁ ਹੋਵੈ ॥੩॥",
      "transliteration": "aape karataa kare s hovai ||3||",
      "translation": "Whatever the Creator does, comes to pass. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰ ਹਿਵ ਸੀਤਲੁ ਅਗਨਿ ਬੁਝਾਵੈ ॥",
      "transliteration": "gur hiv seetal agan bujhaavai ||",
      "translation": "The Guru is cool and soothing like ice; He puts out the fire of the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੇਵਾ ਸੁਰਤਿ ਬਿਭੂਤ ਚੜਾਵੈ ॥",
      "transliteration": "sevaa surat bibhoot chaRaavai ||",
      "translation": "Smear your body with the ashes of dedicated service,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦਰਸਨੁ ਆਪਿ ਸਹਜ ਘਰਿ ਆਵੈ ॥",
      "transliteration": "darasan aap sahaj ghar aavai ||",
      "translation": "and live in the home of peace - make this your religious order.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਿਰਮਲ ਬਾਣੀ ਨਾਦੁ ਵਜਾਵੈ ॥੪॥",
      "transliteration": "niramal baanee naad vajaavai ||4||",
      "translation": "Let the Immaculate Bani of the Word be your playing of the flute. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅੰਤਰਿ ਗਿਆਨੁ ਮਹਾ ਰਸੁ ਸਾਰਾ ॥",
      "transliteration": "a(n)tar giaan mahaa ras saaraa ||",
      "translation": "Spiritual wisdom within is the supreme, sublime nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੀਰਥ ਮਜਨੁ ਗੁਰ ਵੀਚਾਰਾ ॥",
      "transliteration": "teerath majan gur veechaaraa ||",
      "translation": "Contemplation of the Guru is one's bathing at holy places of pilgrimage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅੰਤਰਿ ਪੂਜਾ ਥਾਨੁ ਮੁਰਾਰਾ ॥",
      "transliteration": "a(n)tar poojaa thaan muraaraa ||",
      "translation": "Worship and adoration within is the Lord's dwelling.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੋਤੀ ਜੋਤਿ ਮਿਲਾਵਣਹਾਰਾ ॥੫॥",
      "transliteration": "jotee jot milaavanahaaraa ||5||",
      "translation": "He is the One who blends one's light with the Divine Light. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਸਿ ਰਸਿਆ ਮਤਿ ਏਕੈ ਭਾਇ ॥",
      "transliteration": "ras rasiaa mat ekai bhaai ||",
      "translation": "He delights in the delightful wisdom of loving the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਖਤ ਨਿਵਾਸੀ ਪੰਚ ਸਮਾਇ ॥",
      "transliteration": "takhat nivaasee pa(n)ch samaai ||",
      "translation": "He is one of the self-elect - he merges with the Lord, who occupies the throne.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਾਰ ਕਮਾਈ ਖਸਮ ਰਜਾਇ ॥",
      "transliteration": "kaar kamaaee khasam rajaai ||",
      "translation": "He performs his works in obedience to the Will of his Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਵਿਗਤ ਨਾਥੁ ਨ ਲਖਿਆ ਜਾਇ ॥੬॥",
      "transliteration": "avigat naath na lakhiaa jaai ||6||",
      "translation": "The Unknowable Lord cannot be understood. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਲ ਮਹਿ ਉਪਜੈ ਜਲ ਤੇ ਦੂਰਿ ॥",
      "transliteration": "jal mahi upajai jal te door ||",
      "translation": "The lotus originates in the water, and yet it remains distinct from the water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਲ ਮਹਿ ਜੋਤਿ ਰਹਿਆ ਭਰਪੂਰਿ ॥",
      "transliteration": "jal mahi jot rahiaa bharapoor ||",
      "translation": "Just so, the Divine Light pervades and permeates the water of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿਸੁ ਨੇੜੈ ਕਿਸੁ ਆਖਾ ਦੂਰਿ ॥",
      "transliteration": "kis neRai kis aakhaa door ||",
      "translation": "Who is near, and who is far away?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਿਧਿ ਗੁਣ ਗਾਵਾ ਦੇਖਿ ਹਦੂਰਿ ॥੭॥",
      "transliteration": "nidh gun gaavaa dekh hadoor ||7||",
      "translation": "I sing the Glories of the Lord, the treasure of virtue; I behold Him ever-present. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0411_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਅੰਤਰਿ ਬਾਹਰਿ ਅਵਰੁ ਨ ਕੋਇ ॥",
      "transliteration": "a(n)tar baahar avar na koi ||",
      "translation": "Inwardly and outwardly, there is none other than Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 411,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
