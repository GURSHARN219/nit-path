{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 412,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0412_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੋ ਫੁਨਿ ਹੋਇ ॥",
      "transliteration": "jo tis bhaavai so phun hoi ||",
      "translation": "Whatever pleases Him, comes to pass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁਣਿ ਭਰਥਰਿ ਨਾਨਕੁ ਕਹੈ ਬੀਚਾਰੁ ॥",
      "transliteration": "sun bharathar naanak kahai beechaar ||",
      "translation": "Listen, O Bharthari Yogi - Nanak speaks after deliberation;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਿਰਮਲ ਨਾਮੁ ਮੇਰਾ ਆਧਾਰੁ ॥੮॥੧॥",
      "transliteration": "niramal naam meraa aadhaar ||8||1||",
      "translation": "the Immaculate Name is my only Support. ||8||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਭਿ ਜਪ ਸਭਿ ਤਪ ਸਭ ਚਤੁਰਾਈ ॥",
      "transliteration": "sabh jap sabh tap sabh chaturaaee ||",
      "translation": "All meditation, all austerities, and all clever tricks,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਊਝੜਿ ਭਰਮੈ ਰਾਹਿ ਨ ਪਾਈ ॥",
      "transliteration": "oojhaR bharamai raahi na paaee ||",
      "translation": "lead one to wander in the wilderness, but he does not find the Path.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਿਨੁ ਬੂਝੇ ਕੋ ਥਾਇ ਨ ਪਾਈ ॥",
      "transliteration": "bin boojhe ko thaai na paaee ||",
      "translation": "Without understanding, he is not approved;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਮ ਬਿਹੂਣੈ ਮਾਥੇ ਛਾਈ ॥੧॥",
      "transliteration": "naam bihoonai maathe chhaaee ||1||",
      "translation": "without the Naam, the Name of the Lord, ashes are thrown upon one's head. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਾਚ ਧਣੀ ਜਗੁ ਆਇ ਬਿਨਾਸਾ ॥",
      "transliteration": "saach dhanee jag aai binaasaa ||",
      "translation": "True is the Master; the world comes and goes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਛੂਟਸਿ ਪ੍ਰਾਣੀ ਗੁਰਮੁਖਿ ਦਾਸਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "chhootas praanee guramukh daasaa ||1|| rahaau ||",
      "translation": "The mortal is emancipated, as Gurmukh, as the Lord's slave. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਗੁ ਮੋਹਿ ਬਾਧਾ ਬਹੁਤੀ ਆਸਾ ॥",
      "transliteration": "jag mohi baadhaa bahutee aasaa ||",
      "translation": "The world is bound by its attachments to the many desires.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰਮਤੀ ਇਕਿ ਭਏ ਉਦਾਸਾ ॥",
      "transliteration": "guramatee ik bhae udaasaa ||",
      "translation": "Through the Guru's Teachings, some become free of desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅੰਤਰਿ ਨਾਮੁ ਕਮਲੁ ਪਰਗਾਸਾ ॥",
      "transliteration": "a(n)tar naam kamal paragaasaa ||",
      "translation": "Within them is the Naam, and their heart lotus blossoms forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਿਨੑ ਕਉ ਨਾਹੀ ਜਮ ਕੀ ਤ੍ਰਾਸਾ ॥੨॥",
      "transliteration": "tinh kau naahee jam kee traasaa ||2||",
      "translation": "They have no fear of death. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਗੁ ਤ੍ਰਿਅ ਜਿਤੁ ਕਾਮਣਿ ਹਿਤਕਾਰੀ ॥",
      "transliteration": "jag tri jit kaaman hitakaaree ||",
      "translation": "The men of the world are conquered by woman; they love the ladies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪੁਤ੍ਰ ਕਲਤ੍ਰ ਲਗਿ ਨਾਮੁ ਵਿਸਾਰੀ ॥",
      "transliteration": "putr kalatr lag naam visaaree ||",
      "translation": "Attached to children and wife, they forget the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਰਥਾ ਜਨਮੁ ਗਵਾਇਆ ਬਾਜੀ ਹਾਰੀ ॥",
      "transliteration": "birathaa janam gavaaiaa baajee haaree ||",
      "translation": "They waste this human life in vain, and lose the game in the gamble.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵੇ ਕਰਣੀ ਸਾਰੀ ॥੩॥",
      "transliteration": "satigur seve karanee saaree ||3||",
      "translation": "Serving the True Guru is the best occupation. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਾਹਰਹੁ ਹਉਮੈ ਕਹੈ ਕਹਾਏ ॥",
      "transliteration": "baaharahu haumai kahai kahaae ||",
      "translation": "One who speaks egotistically in public,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅੰਦਰਹੁ ਮੁਕਤੁ ਲੇਪੁ ਕਦੇ ਨ ਲਾਏ ॥",
      "transliteration": "a(n)darahu mukat lep kade na laae ||",
      "translation": "never attains liberation within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਾਇਆ ਮੋਹੁ ਗੁਰ ਸਬਦਿ ਜਲਾਏ ॥",
      "transliteration": "maaiaa mohu gur sabad jalaae ||",
      "translation": "One who burns away his attachment to Maya, by the Word of the Guru's Shabad,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਿਰਮਲ ਨਾਮੁ ਸਦ ਹਿਰਦੈ ਧਿਆਏ ॥੪॥",
      "transliteration": "niramal naam sad hiradai dhiaae ||4||",
      "translation": "meditates forever within his heart on the Immaculate Naam. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਧਾਵਤੁ ਰਾਖੈ ਠਾਕਿ ਰਹਾਏ ॥",
      "transliteration": "dhaavat raakhai thaak rahaae ||",
      "translation": "He restrains his wandering mind, and keeps it under control.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਿਖ ਸੰਗਤਿ ਕਰਮਿ ਮਿਲਾਏ ॥",
      "transliteration": "sikh sa(n)gat karam milaae ||",
      "translation": "The company of such a Sikh is obtained only by Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰ ਬਿਨੁ ਭੂਲੋ ਆਵੈ ਜਾਏ ॥",
      "transliteration": "gur bin bhoolo aavai jaae ||",
      "translation": "Without the Guru, he goes astray and continues coming and going.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਸੰਜੋਗਿ ਮਿਲਾਏ ॥੫॥",
      "transliteration": "nadar kare sa(n)jog milaae ||5||",
      "translation": "Bestowing His Mercy, the Lord unites him in Union. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰੂੜੋ ਕਹਉ ਨ ਕਹਿਆ ਜਾਈ ॥",
      "transliteration": "rooRo kahau na kahiaa jaaee ||",
      "translation": "I cannot describe the Beauteous Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਕਥ ਕਥਉ ਨਹ ਕੀਮਤਿ ਪਾਈ ॥",
      "transliteration": "akath kathau nah keemat paaee ||",
      "translation": "I speak the unspoken; I cannot estimate His value.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਭ ਦੁਖ ਤੇਰੇ ਸੂਖ ਰਜਾਈ ॥",
      "transliteration": "sabh dukh tere sookh rajaaee ||",
      "translation": "All pain and pleasure come by Your Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਭਿ ਦੁਖ ਮੇਟੇ ਸਾਚੈ ਨਾਈ ॥੬॥",
      "transliteration": "sabh dukh mete saachai naaee ||6||",
      "translation": "All pain is eradicated by the True Name. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਰ ਬਿਨੁ ਵਾਜਾ ਪਗ ਬਿਨੁ ਤਾਲਾ ॥",
      "transliteration": "kar bin vaajaa pag bin taalaa ||",
      "translation": "He plays the instrument without hands, and dances without feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੇ ਸਬਦੁ ਬੁਝੈ ਤਾ ਸਚੁ ਨਿਹਾਲਾ ॥",
      "transliteration": "je sabad bujhai taa sach nihaalaa ||",
      "translation": "But if he understands the Word of the Shabad, then he shall behold the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅੰਤਰਿ ਸਾਚੁ ਸਭੇ ਸੁਖ ਨਾਲਾ ॥",
      "transliteration": "a(n)tar saach sabhe sukh naalaa ||",
      "translation": "With the True Lord within the self, all happiness comes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਰਾਖੈ ਰਖਵਾਲਾ ॥੭॥",
      "transliteration": "nadar kare raakhai rakhavaalaa ||7||",
      "translation": "Showering His Mercy, the Preserving Lord preserves him. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤ੍ਰਿਭਵਣ ਸੂਝੈ ਆਪੁ ਗਵਾਵੈ ॥",
      "transliteration": "tribhavan soojhai aap gavaavai ||",
      "translation": "He understands the three worlds; he eliminates his self-conceit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਾਣੀ ਬੂਝੈ ਸਚਿ ਸਮਾਵੈ ॥",
      "transliteration": "baanee boojhai sach samaavai ||",
      "translation": "He understands the Bani of the Word, and he is absorbed into the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਬਦੁ ਵੀਚਾਰੇ ਏਕ ਲਿਵ ਤਾਰਾ ॥",
      "transliteration": "sabad veechaare ek liv taaraa ||",
      "translation": "Contemplating the Shabad, he enshrines love for the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਨਕ ਧੰਨੁ ਸਵਾਰਣਹਾਰਾ ॥੮॥੨॥",
      "transliteration": "naanak dha(n)n savaaranahaaraa ||8||2||",
      "translation": "O Nanak, blessed is the Lord, the Embellisher. ||8||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲੇਖ ਅਸੰਖ ਲਿਖਿ ਲਿਖਿ ਮਾਨੁ ॥",
      "transliteration": "lekh asa(n)kh likh likh maan ||",
      "translation": "There are innumerable writings; those who write them take pride in them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਨਿ ਮਾਨਿਐ ਸਚੁ ਸੁਰਤਿ ਵਖਾਨੁ ॥",
      "transliteration": "man maaniai sach surat vakhaan ||",
      "translation": "When one's mind accepts the Truth, he understands, and speaks of it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਥਨੀ ਬਦਨੀ ਪੜਿ ਪੜਿ ਭਾਰੁ ॥",
      "transliteration": "kathanee badanee paR paR bhaar ||",
      "translation": "Words, spoken and read again and again, are useless loads.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਲੇਖ ਅਸੰਖ ਅਲੇਖੁ ਅਪਾਰੁ ॥੧॥",
      "transliteration": "lekh asa(n)kh alekh apaar ||1||",
      "translation": "There are innumerable writings, but the Infinite Lord remains unwritten. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਐਸਾ ਸਾਚਾ ਤੂੰ ਏਕੋ ਜਾਣੁ ॥",
      "transliteration": "aisaa saachaa too(n) eko jaan ||",
      "translation": "Know that such a True Lord is the One and only.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੰਮਣੁ ਮਰਣਾ ਹੁਕਮੁ ਪਛਾਣੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ja(n)man maranaa hukam pachhaan ||1|| rahaau ||",
      "translation": "Understand that birth and death come according to the Lord's Will. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਾਇਆ ਮੋਹਿ ਜਗੁ ਬਾਧਾ ਜਮਕਾਲਿ ॥",
      "transliteration": "maaiaa mohi jag baadhaa jamakaal ||",
      "translation": "Because of attachment to Maya, the world is bound by the Messenger of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਾਂਧਾ ਛੂਟੈ ਨਾਮੁ ਸਮੑਾਲਿ ॥",
      "transliteration": "baa(n)dhaa chhootai naam samhaal ||",
      "translation": "These bonds are released when one remembers the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੁਰੁ ਸੁਖਦਾਤਾ ਅਵਰੁ ਨ ਭਾਲਿ ॥",
      "transliteration": "gur sukhadaataa avar na bhaal ||",
      "translation": "The Guru is the Giver of peace; do not look for any other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹਲਤਿ ਪਲਤਿ ਨਿਬਹੀ ਤੁਧੁ ਨਾਲਿ ॥੨॥",
      "transliteration": "halat palat nibahee tudh naal ||2||",
      "translation": "In this world, and the next, He shall stand by you. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਬਦਿ ਮਰੈ ਤਾਂ ਏਕ ਲਿਵ ਲਾਏ ॥",
      "transliteration": "sabad marai taa(n) ek liv laae ||",
      "translation": "One who dies in the Word of the Shabad, embraces love for the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਚਰੁ ਚਰੈ ਤਾਂ ਭਰਮੁ ਚੁਕਾਏ ॥",
      "transliteration": "achar charai taa(n) bharam chukaae ||",
      "translation": "One who eats the uneatable, has his doubts dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜੀਵਨ ਮੁਕਤੁ ਮਨਿ ਨਾਮੁ ਵਸਾਏ ॥",
      "transliteration": "jeevan mukat man naam vasaae ||",
      "translation": "He is Jivan Mukta - liberated while yet alive; the Naam abides in his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਹੋਇ ਤ ਸਚਿ ਸਮਾਏ ॥੩॥",
      "transliteration": "guramukh hoi ta sach samaae ||3||",
      "translation": "Becoming Gurmukh, he merges into the True Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਿਨਿ ਧਰ ਸਾਜੀ ਗਗਨੁ ਅਕਾਸੁ ॥",
      "transliteration": "jin dhar saajee gagan akaas ||",
      "translation": "The One who created the earth and the Akaashic ethers of the sky,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਿਨਿ ਸਭ ਥਾਪੀ ਥਾਪਿ ਉਥਾਪਿ ॥",
      "transliteration": "jin sabh thaapee thaap uthaap ||",
      "translation": "established all; He establishes and disestablishes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਰਬ ਨਿਰੰਤਰਿ ਆਪੇ ਆਪਿ ॥",
      "transliteration": "sarab nira(n)tar aape aap ||",
      "translation": "He Himself is permeating all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਕਿਸੈ ਨ ਪੂਛੇ ਬਖਸੇ ਆਪਿ ॥੪॥",
      "transliteration": "kisai na poochhe bakhase aap ||4||",
      "translation": "He does not consult anyone; He Himself forgives. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤੂ ਪੁਰੁ ਸਾਗਰੁ ਮਾਣਕ ਹੀਰੁ ॥",
      "transliteration": "too pur saagar maanak heer ||",
      "translation": "You are the Ocean, over-flowing with jewels and rubies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0412_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਤੂ ਨਿਰਮਲੁ ਸਚੁ ਗੁਣੀ ਗਹੀਰੁ ॥",
      "transliteration": "too niramal sach gunee gaheer ||",
      "translation": "You are immaculate and pure, the true treasure of virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 412,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
