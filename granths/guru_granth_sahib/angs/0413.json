{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 413,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0413_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁਖੁ ਮਾਨੈ ਭੇਟੈ ਗੁਰ ਪੀਰੁ ॥",
      "transliteration": "sukh maanai bhetai gur peer ||",
      "translation": "Peace is enjoyed, meeting the Guru, the Spiritual Teacher.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਏਕੋ ਸਾਹਿਬੁ ਏਕੁ ਵਜੀਰੁ ॥੫॥",
      "transliteration": "eko saahib ek vajeer ||5||",
      "translation": "The Lord is the only Master; He is the only Minister. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਗੁ ਬੰਦੀ ਮੁਕਤੇ ਹਉ ਮਾਰੀ ॥",
      "transliteration": "jag ba(n)dee mukate hau maaree ||",
      "translation": "The world is held in bondage; he alone is emancipated, who conquers his ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਗਿ ਗਿਆਨੀ ਵਿਰਲਾ ਆਚਾਰੀ ॥",
      "transliteration": "jag giaanee viralaa aachaaree ||",
      "translation": "How rare in the world is that wise person, who practices this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਗਿ ਪੰਡਿਤੁ ਵਿਰਲਾ ਵੀਚਾਰੀ ॥",
      "transliteration": "jag pa(n)dit viralaa veechaaree ||",
      "translation": "How rare in this world is that scholar who reflects upon this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰੁ ਭੇਟੇ ਸਭ ਫਿਰੈ ਅਹੰਕਾਰੀ ॥੬॥",
      "transliteration": "bin satigur bhete sabh phirai aha(n)kaaree ||6||",
      "translation": "Without meeting the True Guru, all wander in ego. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਗੁ ਦੁਖੀਆ ਸੁਖੀਆ ਜਨੁ ਕੋਇ ॥",
      "transliteration": "jag dukheeaa sukheeaa jan koi ||",
      "translation": "The world is unhappy; only a few are happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਗੁ ਰੋਗੀ ਭੋਗੀ ਗੁਣ ਰੋਇ ॥",
      "transliteration": "jag rogee bhogee gun roi ||",
      "translation": "The world is diseased, from its indulgences; it weeps over its lost virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਗੁ ਉਪਜੈ ਬਿਨਸੈ ਪਤਿ ਖੋਇ ॥",
      "transliteration": "jag upajai binasai pat khoi ||",
      "translation": "The world wells up, and then subsides, losing its honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਹੋਵੈ ਬੂਝੈ ਸੋਇ ॥੭॥",
      "transliteration": "guramukh hovai boojhai soi ||7||",
      "translation": "He alone, who becomes Gurmukh, understands. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਹਘੋ ਮੋਲਿ ਭਾਰਿ ਅਫਾਰੁ ॥",
      "transliteration": "mahagho mol bhaar aphaar ||",
      "translation": "His price is so costly; His weight is unbearable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਟਲ ਅਛਲੁ ਗੁਰਮਤੀ ਧਾਰੁ ॥",
      "transliteration": "atal achhal guramatee dhaar ||",
      "translation": "He is immovable and undeceivable; enshrine Him in your mind, through the Guru's Teachings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਾਇ ਮਿਲੈ ਭਾਵੈ ਭਇਕਾਰੁ ॥",
      "transliteration": "bhaai milai bhaavai bhaikaar ||",
      "translation": "Meet Him through love, become pleasing to Him, and act in fear of Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਨਕੁ ਨੀਚੁ ਕਹੈ ਬੀਚਾਰੁ ॥੮॥੩॥",
      "transliteration": "naanak neech kahai beechaar ||8||3||",
      "translation": "Nanak the lowly says this, after deep contemplation. ||8||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਏਕੁ ਮਰੈ ਪੰਚੇ ਮਿਲਿ ਰੋਵਹਿ ॥",
      "transliteration": "ek marai pa(n)che mil rovahi ||",
      "translation": "When someone dies, the five passions meet and mourn his death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਉਮੈ ਜਾਇ ਸਬਦਿ ਮਲੁ ਧੋਵਹਿ ॥",
      "transliteration": "haumai jaai sabad mal dhovahi ||",
      "translation": "Overcoming self-conceit, he washes off his filth with the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਮਝਿ ਸੂਝਿ ਸਹਜ ਘਰਿ ਹੋਵਹਿ ॥",
      "transliteration": "samajh soojh sahaj ghar hovahi ||",
      "translation": "One who knows and understands, enters the home of peace and poise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਿਨੁ ਬੂਝੇ ਸਗਲੀ ਪਤਿ ਖੋਵਹਿ ॥੧॥",
      "transliteration": "bin boojhe sagalee pat khovahi ||1||",
      "translation": "Without understanding, he loses all his honor. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਉਣੁ ਮਰੈ ਕਉਣੁ ਰੋਵੈ ਓਹੀ ॥",
      "transliteration": "kaun marai kaun rovai ohee ||",
      "translation": "Who dies, and who weeps for him?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਰਣ ਕਾਰਣ ਸਭਸੈ ਸਿਰਿ ਤੋਹੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "karan kaaran sabhasai sir tohee ||1|| rahaau ||",
      "translation": "O Lord, Creator, Cause of causes, You are over the heads of all. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੂਏ ਕਉ ਰੋਵੈ ਦੁਖੁ ਕੋਇ ॥",
      "transliteration": "mooe kau rovai dukh koi ||",
      "translation": "Who weeps over the pain of the dead?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋ ਰੋਵੈ ਜਿਸੁ ਬੇਦਨ ਹੋਇ ॥",
      "transliteration": "so rovai jis bedan hoi ||",
      "translation": "Those who weep, do so over their own troubles.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਿਸੁ ਬੀਤੀ ਜਾਣੈ ਪ੍ਰਭ ਸੋਇ ॥",
      "transliteration": "jis beetee jaanai prabh soi ||",
      "translation": "God knows the condition of those who are so affected.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਪੇ ਕਰਤਾ ਕਰੇ ਸੁ ਹੋਇ ॥੨॥",
      "transliteration": "aape karataa kare s hoi ||2||",
      "translation": "Whatever the Creator does, comes to pass. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੀਵਤ ਮਰਣਾ ਤਾਰੇ ਤਰਣਾ ॥",
      "transliteration": "jeevat maranaa taare taranaa ||",
      "translation": "One who remains dead while yet alive, is saved, and saves others as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੈ ਜਗਦੀਸ ਪਰਮ ਗਤਿ ਸਰਣਾ ॥",
      "transliteration": "jai jagadees param gat saranaa ||",
      "translation": "Celebrate the Victory of the Lord; taking to His Sanctuary, the supreme status is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹਉ ਬਲਿਹਾਰੀ ਸਤਿਗੁਰ ਚਰਣਾ ॥",
      "transliteration": "hau balihaaree satigur charanaa ||",
      "translation": "I am a sacrifice to the feet of the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰੁ ਬੋਹਿਥੁ ਸਬਦਿ ਭੈ ਤਰਣਾ ॥੩॥",
      "transliteration": "gur bohith sabad bhai taranaa ||3||",
      "translation": "The Guru is the boat; through the Shabad of His Word, the terrifying world-ocean is crossed over. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਿਰਭਉ ਆਪਿ ਨਿਰੰਤਰਿ ਜੋਤਿ ॥",
      "transliteration": "nirabhau aap nira(n)tar jot ||",
      "translation": "He Himself is Fearless; His Divine Light is contained in all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਸੂਤਕੁ ਜਗਿ ਛੋਤਿ ॥",
      "transliteration": "bin naavai sootak jag chhot ||",
      "translation": "Without the Name, the world is defiled and untouchable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੁਰਮਤਿ ਬਿਨਸੈ ਕਿਆ ਕਹਿ ਰੋਤਿ ॥",
      "transliteration": "duramat binasai kiaa kahi rot ||",
      "translation": "Through evil-mindedness, they are ruined; why should they cry out and weep?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਨਮਿ ਮੂਏ ਬਿਨੁ ਭਗਤਿ ਸਰੋਤਿ ॥੪॥",
      "transliteration": "janam mooe bin bhagat sarot ||4||",
      "translation": "They are born only to die, without hearing the music of devotional worship. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮੂਏ ਕਉ ਸਚੁ ਰੋਵਹਿ ਮੀਤ ॥",
      "transliteration": "mooe kau sach rovahi meet ||",
      "translation": "Only one's true friends mourn one's death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤ੍ਰੈ ਗੁਣ ਰੋਵਹਿ ਨੀਤਾ ਨੀਤ ॥",
      "transliteration": "trai gun rovahi neetaa neet ||",
      "translation": "Those under the sway of the three dispositions continue to mourn on and on.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦੁਖੁ ਸੁਖੁ ਪਰਹਰਿ ਸਹਜਿ ਸੁਚੀਤ ॥",
      "transliteration": "dukh sukh parahar sahaj sucheet ||",
      "translation": "Disregarding pain and pleasure, center your consciousness on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਸਉਪਉ ਕ੍ਰਿਸਨ ਪਰੀਤਿ ॥੫॥",
      "transliteration": "tan man saupau krisan pareet ||5||",
      "translation": "Dedicate your body and mind to the Love of the Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭੀਤਰਿ ਏਕੁ ਅਨੇਕ ਅਸੰਖ ॥",
      "transliteration": "bheetar ek anek asa(n)kh ||",
      "translation": "The One Lord dwells within the various and countless beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਬਹੁ ਸੰਖ ਅਸੰਖ ॥",
      "transliteration": "karam dharam bahu sa(n)kh asa(n)kh ||",
      "translation": "There are so many rituals and religious faiths, their number is innumerable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਨੁ ਭੈ ਭਗਤੀ ਜਨਮੁ ਬਿਰੰਥ ॥",
      "transliteration": "bin bhai bhagatee janam bira(n)th ||",
      "translation": "Without the Fear of God, and devotional worship, one's life is in vain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਗਾਵਹਿ ਮਿਲਿ ਪਰਮਾਰੰਥ ॥੬॥",
      "transliteration": "har gun gaavahi mil paramaara(n)th ||6||",
      "translation": "Singing the Glorious Praises of the Lord, the supreme wealth is obtained. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਪਿ ਮਰੈ ਮਾਰੇ ਭੀ ਆਪਿ ॥",
      "transliteration": "aap marai maare bhee aap ||",
      "translation": "He Himself dies, and He Himself kills.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਪਿ ਉਪਾਏ ਥਾਪਿ ਉਥਾਪਿ ॥",
      "transliteration": "aap upaae thaap uthaap ||",
      "translation": "He Himself establishes, and having established, disestablishes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸ੍ਰਿਸਟਿ ਉਪਾਈ ਜੋਤੀ ਤੂ ਜਾਤਿ ॥",
      "transliteration": "srisat upaaee jotee too jaat ||",
      "translation": "He created the Universe, and by His Divine Nature, instilled His Divine Light into it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਬਦੁ ਵੀਚਾਰਿ ਮਿਲਣੁ ਨਹੀ ਭ੍ਰਾਤਿ ॥੭॥",
      "transliteration": "sabad veechaar milan nahee bhraat ||7||",
      "translation": "One who reflects upon the Word of the Shabad, meets the Lord, without doubt. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੂਤਕੁ ਅਗਨਿ ਭਖੈ ਜਗੁ ਖਾਇ ॥",
      "transliteration": "sootak agan bhakhai jag khaai ||",
      "translation": "Pollution is the burning fire, which is consuming the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੂਤਕੁ ਜਲਿ ਥਲਿ ਸਭ ਹੀ ਥਾਇ ॥",
      "transliteration": "sootak jal thal sabh hee thaai ||",
      "translation": "Pollution is in the water, upon the land, and everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਨਕ ਸੂਤਕਿ ਜਨਮਿ ਮਰੀਜੈ ॥",
      "transliteration": "naanak sootak janam mareejai ||",
      "translation": "O Nanak, people are born and die in pollution.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਹਰਿ ਰਸੁ ਪੀਜੈ ॥੮॥੪॥",
      "transliteration": "gur parasaadee har ras peejai ||8||4||",
      "translation": "By Guru's Grace, they drink in the Lord's sublime elixir. ||8||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਰਾਗੁ ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "raag aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਆਪੁ ਵੀਚਾਰੈ ਸੁ ਪਰਖੇ ਹੀਰਾ ॥",
      "transliteration": "aap veechaarai s parakhe heeraa ||",
      "translation": "One who contemplates his own self, tests the worth of the jewel.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਏਕ ਦ੍ਰਿਸਟਿ ਤਾਰੇ ਗੁਰ ਪੂਰਾ ॥",
      "transliteration": "ek drisat taare gur pooraa ||",
      "translation": "With a single glance, the Perfect Guru saves him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰੁ ਮਾਨੈ ਮਨ ਤੇ ਮਨੁ ਧੀਰਾ ॥੧॥",
      "transliteration": "gur maanai man te man dheeraa ||1||",
      "translation": "When the Guru is pleased, one's mind comforts itself. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਐਸਾ ਸਾਹੁ ਸਰਾਫੀ ਕਰੈ ॥",
      "transliteration": "aisaa saahu saraaphee karai ||",
      "translation": "He is such a banker, who tests us.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸਾਚੀ ਨਦਰਿ ਏਕ ਲਿਵ ਤਰੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saachee nadar ek liv tarai ||1|| rahaau ||",
      "translation": "By His True Glance of Grace, we are blessed with the Love of the One Lord, and are saved. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਪੂੰਜੀ ਨਾਮੁ ਨਿਰੰਜਨ ਸਾਰੁ ॥",
      "transliteration": "poo(n)jee naam nira(n)jan saar ||",
      "translation": "The capital of the Naam is immaculate and sublime.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਨਿਰਮਲੁ ਸਾਚਿ ਰਤਾ ਪੈਕਾਰੁ ॥",
      "transliteration": "niramal saach rataa paikaar ||",
      "translation": "That peddler is rendered pure, who is imbued with the Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸਿਫਤਿ ਸਹਜ ਘਰਿ ਗੁਰੁ ਕਰਤਾਰੁ ॥੨॥",
      "transliteration": "siphat sahaj ghar gur karataar ||2||",
      "translation": "Praising the Lord, in the house of poise, he attains the Guru, the Creator. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਆਸਾ ਮਨਸਾ ਸਬਦਿ ਜਲਾਏ ॥",
      "transliteration": "aasaa manasaa sabad jalaae ||",
      "translation": "One who burns away hope and desire through the Word of the Shabad,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਰਾਮ ਨਰਾਇਣੁ ਕਹੈ ਕਹਾਏ ॥",
      "transliteration": "raam naraain kahai kahaae ||",
      "translation": "chants the Lord's Name, and inspires others to chant it as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0413_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਗੁਰ ਤੇ ਵਾਟ ਮਹਲੁ ਘਰੁ ਪਾਏ ॥੩॥",
      "transliteration": "gur te vaat mahal ghar paae ||3||",
      "translation": "Through the Guru, he finds the Path home, to the Mansion of the Lord's Presence. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 413,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
