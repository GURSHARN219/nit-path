{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 414,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0414_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕੰਚਨ ਕਾਇਆ ਜੋਤਿ ਅਨੂਪੁ ॥",
      "transliteration": "ka(n)chan kaaiaa jot anoop ||",
      "translation": "His body becomes golden, by the Lord's Incomparable Light.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤ੍ਰਿਭਵਣ ਦੇਵਾ ਸਗਲ ਸਰੂਪੁ ॥",
      "transliteration": "tribhavan devaa sagal saroop ||",
      "translation": "He beholds the divine beauty in all the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੈ ਸੋ ਧਨੁ ਪਲੈ ਸਾਚੁ ਅਖੂਟੁ ॥੪॥",
      "transliteration": "mai so dhan palai saach akhoot ||4||",
      "translation": "That inexhaustible wealth of Truth is now in my lap. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪੰਚ ਤੀਨਿ ਨਵ ਚਾਰਿ ਸਮਾਵੈ ॥",
      "transliteration": "pa(n)ch teen nav chaar samaavai ||",
      "translation": "In the five elements, the three worlds, the nine regions and the four directions, the Lord is pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਧਰਣਿ ਗਗਨੁ ਕਲ ਧਾਰਿ ਰਹਾਵੈ ॥",
      "transliteration": "dharan gagan kal dhaar rahaavai ||",
      "translation": "He supports the earth and the sky, exercising His almighty power.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਾਹਰਿ ਜਾਤਉ ਉਲਟਿ ਪਰਾਵੈ ॥੫॥",
      "transliteration": "baahar jaatau ulat paraavai ||5||",
      "translation": "He turns the outgoing mind around. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੂਰਖੁ ਹੋਇ ਨ ਆਖੀ ਸੂਝੈ ॥",
      "transliteration": "moorakh hoi na aakhee soojhai ||",
      "translation": "The fool does not realize what he sees with his eyes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਹਵਾ ਰਸੁ ਨਹੀ ਕਹਿਆ ਬੂਝੈ ॥",
      "transliteration": "jihavaa ras nahee kahiaa boojhai ||",
      "translation": "He does not taste with his tongue, and does not understand what is said.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਖੁ ਕਾ ਮਾਤਾ ਜਗ ਸਿਉ ਲੂਝੈ ॥੬॥",
      "transliteration": "bikh kaa maataa jag siu loojhai ||6||",
      "translation": "Intoxicated with poison, he argues with the world. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਊਤਮ ਸੰਗਤਿ ਊਤਮੁ ਹੋਵੈ ॥",
      "transliteration": "ootam sa(n)gat ootam hovai ||",
      "translation": "In the uplifting society, one is uplifted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਣ ਕਉ ਧਾਵੈ ਅਵਗਣ ਧੋਵੈ ॥",
      "transliteration": "gun kau dhaavai avagan dhovai ||",
      "translation": "He chases after virtue and washes off his sins.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਸੇਵੇ ਸਹਜੁ ਨ ਹੋਵੈ ॥੭॥",
      "transliteration": "bin gur seve sahaj na hovai ||7||",
      "translation": "Without serving the Guru, celestial poise is not obtained. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹੀਰਾ ਨਾਮੁ ਜਵੇਹਰ ਲਾਲੁ ॥",
      "transliteration": "heeraa naam javehar laal ||",
      "translation": "The Naam, the Name of the Lord, is a diamond, a jewel, a ruby.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਨੁ ਮੋਤੀ ਹੈ ਤਿਸ ਕਾ ਮਾਲੁ ॥",
      "transliteration": "man motee hai tis kaa maal ||",
      "translation": "The pearl of the mind is the inner wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਪਰਖੈ ਨਦਰਿ ਨਿਹਾਲੁ ॥੮॥੫॥",
      "transliteration": "naanak parakhai nadar nihaal ||8||5||",
      "translation": "O Nanak, the Lord tests us, and blesses us with His Glance of Grace. ||8||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਗਿਆਨੁ ਧਿਆਨੁ ਮਨਿ ਮਾਨੁ ॥",
      "transliteration": "guramukh giaan dhiaan man maan ||",
      "translation": "The Gurmukh obtains spiritual wisdom, meditation and satisfaction of the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਮਹਲੀ ਮਹਲੁ ਪਛਾਨੁ ॥",
      "transliteration": "guramukh mahalee mahal pachhaan ||",
      "translation": "The Gurmukh realizes the Mansion of the Lord's Presence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸੁਰਤਿ ਸਬਦੁ ਨੀਸਾਨੁ ॥੧॥",
      "transliteration": "guramukh surat sabad neesaan ||1||",
      "translation": "The Gurmukh is attuned to the Word of the Shabad, as his Insignia. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਐਸੇ ਪ੍ਰੇਮ ਭਗਤਿ ਵੀਚਾਰੀ ॥",
      "transliteration": "aise prem bhagat veechaaree ||",
      "translation": "Such is the loving devotional worship of the Lord's contemplation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਚਾ ਨਾਮੁ ਮੁਰਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "guramukh saachaa naam muraaree ||1|| rahaau ||",
      "translation": "The Gurmukh realizes the True Name, the Destroyer of ego. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਨਿਰਮਲੁ ਥਾਨਿ ਸੁਥਾਨੁ ॥",
      "transliteration": "ahinis niramal thaan suthaan ||",
      "translation": "Day and night, he remains immaculately pure, and abides in the sublime place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤੀਨ ਭਵਨ ਨਿਹਕੇਵਲ ਗਿਆਨੁ ॥",
      "transliteration": "teen bhavan nihakeval giaan ||",
      "translation": "He gains the wisdom of the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਾਚੇ ਗੁਰ ਤੇ ਹੁਕਮੁ ਪਛਾਨੁ ॥੨॥",
      "transliteration": "saache gur te hukam pachhaan ||2||",
      "translation": "Through the True Guru, the Command of the Lord's Will is realized. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਾਚਾ ਹਰਖੁ ਨਾਹੀ ਤਿਸੁ ਸੋਗੁ ॥",
      "transliteration": "saachaa harakh naahee tis sog ||",
      "translation": "He enjoys true pleasure, and suffers no pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਗਿਆਨੁ ਮਹਾ ਰਸੁ ਭੋਗੁ ॥",
      "transliteration": "a(n)mrit giaan mahaa ras bhog ||",
      "translation": "He enjoys the ambrosial wisdom, and the highest sublime essence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੰਚ ਸਮਾਈ ਸੁਖੀ ਸਭੁ ਲੋਗੁ ॥੩॥",
      "transliteration": "pa(n)ch samaaee sukhee sabh log ||3||",
      "translation": "He overcomes the five evil passions, and becomes the happiest of all men. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਗਲੀ ਜੋਤਿ ਤੇਰਾ ਸਭੁ ਕੋਈ ॥",
      "transliteration": "sagalee jot teraa sabh koee ||",
      "translation": "Your Divine Light is contained in all; everyone belongs to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਪੇ ਜੋੜਿ ਵਿਛੋੜੇ ਸੋਈ ॥",
      "transliteration": "aape joR vichhoRe soee ||",
      "translation": "You Yourself join and separate again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਪੇ ਕਰਤਾ ਕਰੇ ਸੁ ਹੋਈ ॥੪॥",
      "transliteration": "aape karataa kare s hoee ||4||",
      "translation": "Whatever the Creator does, comes to pass. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਢਾਹਿ ਉਸਾਰੇ ਹੁਕਮਿ ਸਮਾਵੈ ॥",
      "transliteration": "dhaahi usaare hukam samaavai ||",
      "translation": "He demolishes, and He builds; by His Order, he merges us into Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹੁਕਮੋ ਵਰਤੈ ਜੋ ਤਿਸੁ ਭਾਵੈ ॥",
      "transliteration": "hukamo varatai jo tis bhaavai ||",
      "translation": "Whatever is pleasing to His Will, happens.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰ ਬਿਨੁ ਪੂਰਾ ਕੋਇ ਨ ਪਾਵੈ ॥੫॥",
      "transliteration": "gur bin pooraa koi na paavai ||5||",
      "translation": "Without the Guru, no one obtains the Perfect Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਾਲਕ ਬਿਰਧਿ ਨ ਸੁਰਤਿ ਪਰਾਨਿ ॥",
      "transliteration": "baalak biradh na surat paraan ||",
      "translation": "In childhood and old age, he does not understand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਰਿ ਜੋਬਨਿ ਬੂਡੈ ਅਭਿਮਾਨਿ ॥",
      "transliteration": "bhar joban boodai abhimaan ||",
      "translation": "In the prime of youth, he is drowned in his pride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਕਿਆ ਲਹਸਿ ਨਿਦਾਨਿ ॥੬॥",
      "transliteration": "bin naavai kiaa lahas nidaan ||6||",
      "translation": "Without the Name, what can the fool obtain? ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਸ ਕਾ ਅਨੁ ਧਨੁ ਸਹਜਿ ਨ ਜਾਨਾ ॥",
      "transliteration": "jis kaa an dhan sahaj na jaanaa ||",
      "translation": "He does not know the One who blesses him with nourishment and wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭਰਮਿ ਭੁਲਾਨਾ ਫਿਰਿ ਪਛੁਤਾਨਾ ॥",
      "transliteration": "bharam bhulaanaa phir pachhutaanaa ||",
      "translation": "Deluded by doubt, he later regrets and repents.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗਲਿ ਫਾਹੀ ਬਉਰਾ ਬਉਰਾਨਾ ॥੭॥",
      "transliteration": "gal phaahee bauraa bauraanaa ||7||",
      "translation": "The noose of death is around the neck of that crazy madman. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬੂਡਤ ਜਗੁ ਦੇਖਿਆ ਤਉ ਡਰਿ ਭਾਗੇ ॥",
      "transliteration": "boodat jag dekhiaa tau dar bhaage ||",
      "translation": "I saw the world drowning, and I ran away in fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਰਾਖੇ ਸੇ ਵਡਭਾਗੇ ॥",
      "transliteration": "satigur raakhe se vadabhaage ||",
      "translation": "How very fortunate are those who have been saved by the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਨਕ ਗੁਰ ਕੀ ਚਰਣੀ ਲਾਗੇ ॥੮॥੬॥",
      "transliteration": "naanak gur kee charanee laage ||8||6||",
      "translation": "O Nanak, they are attached to the feet of the Guru. ||8||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗਾਵਹਿ ਗੀਤੇ ਚੀਤਿ ਅਨੀਤੇ ॥",
      "transliteration": "gaavahi geete cheet aneete ||",
      "translation": "They sing religious songs, but their consciousness is wicked.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਾਗ ਸੁਣਾਇ ਕਹਾਵਹਿ ਬੀਤੇ ॥",
      "transliteration": "raag sunaai kahaavahi beete ||",
      "translation": "They sing the songs, and call themselves divine,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਮਨਿ ਝੂਠੁ ਅਨੀਤੇ ॥੧॥",
      "transliteration": "bin naavai man jhooth aneete ||1||",
      "translation": "but without the Name, their minds are false and wicked. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਹਾ ਚਲਹੁ ਮਨ ਰਹਹੁ ਘਰੇ ॥",
      "transliteration": "kahaa chalahu man rahahu ghare ||",
      "translation": "Where are you going? O mind, remain in your own home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਰਾਮ ਨਾਮਿ ਤ੍ਰਿਪਤਾਸੇ ਖੋਜਤ ਪਾਵਹੁ ਸਹਜਿ ਹਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "guramukh raam naam tripataase khojat paavahu sahaj hare ||1|| rahaau ||",
      "translation": "The Gurmukhs are satisfied with the Lord's Name; searching, they easily find the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਮਨਿ ਮੋਹੁ ਸਰੀਰਾ ॥",
      "transliteration": "kaam krodh man mohu sareeraa ||",
      "translation": "Sexual desire, anger and emotional attachment fill the mind and body;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਲਬੁ ਲੋਭੁ ਅਹੰਕਾਰੁ ਸੁ ਪੀਰਾ ॥",
      "transliteration": "lab lobh aha(n)kaar s peeraa ||",
      "translation": "greed and egotism lead only to pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਬਿਨੁ ਕਿਉ ਮਨੁ ਧੀਰਾ ॥੨॥",
      "transliteration": "raam naam bin kiu man dheeraa ||2||",
      "translation": "How can the mind be comforted without the Lord's Name? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅੰਤਰਿ ਨਾਵਣੁ ਸਾਚੁ ਪਛਾਣੈ ॥",
      "transliteration": "a(n)tar naavan saach pachhaanai ||",
      "translation": "One who cleanses himself within, knows the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅੰਤਰ ਕੀ ਗਤਿ ਗੁਰਮੁਖਿ ਜਾਣੈ ॥",
      "transliteration": "a(n)tar kee gat guramukh jaanai ||",
      "translation": "The Gurmukh knows the condition of his innermost being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਾਚ ਸਬਦ ਬਿਨੁ ਮਹਲੁ ਨ ਪਛਾਣੈ ॥੩॥",
      "transliteration": "saach sabad bin mahal na pachhaanai ||3||",
      "translation": "Without the True Word of the Shabad, the Mansion of the Lord's Presence is not realized. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਿਰੰਕਾਰ ਮਹਿ ਆਕਾਰੁ ਸਮਾਵੈ ॥",
      "transliteration": "nira(n)kaar mahi aakaar samaavai ||",
      "translation": "One who merges his form into the Formless Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਅਕਲ ਕਲਾ ਸਚੁ ਸਾਚਿ ਟਿਕਾਵੈ ॥",
      "transliteration": "akal kalaa sach saach tikaavai ||",
      "translation": "abides in the True Lord, the Powerful, beyond power.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸੋ ਨਰੁ ਗਰਭ ਜੋਨਿ ਨਹੀ ਆਵੈ ॥੪॥",
      "transliteration": "so nar garabh jon nahee aavai ||4||",
      "translation": "Such a person does not enter into the womb of reincarnation again. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0414_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਹਾਂ ਨਾਮੁ ਮਿਲੈ ਤਹ ਜਾਉ ॥",
      "transliteration": "jahaa(n) naam milai tah jaau ||",
      "translation": "Go there, where you may obtain the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 414,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
