{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 415,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0415_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਕਰਮ ਕਮਾਉ ॥",
      "transliteration": "gur parasaadee karam kamaau ||",
      "translation": "By Guru's Grace, perform good deeds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਮੇ ਰਾਤਾ ਹਰਿ ਗੁਣ ਗਾਉ ॥੫॥",
      "transliteration": "naame raataa har gun gaau ||5||",
      "translation": "Imbued with the Naam, sing the Glorious Praises of the Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੁਰ ਸੇਵਾ ਤੇ ਆਪੁ ਪਛਾਤਾ ॥",
      "transliteration": "gur sevaa te aap pachhaataa ||",
      "translation": "Serving the Guru, I have come to understand myself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਵਸਿਆ ਸੁਖਦਾਤਾ ॥",
      "transliteration": "a(n)mrit naam vasiaa sukhadaataa ||",
      "translation": "The Ambrosial Naam, the Giver of Peace, abides within my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਨਦਿਨੁ ਬਾਣੀ ਨਾਮੇ ਰਾਤਾ ॥੬॥",
      "transliteration": "anadin baanee naame raataa ||6||",
      "translation": "Night and day, I am imbued with the Word of the Guru's Bani, and the Naam. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੇਰਾ ਪ੍ਰਭੁ ਲਾਏ ਤਾ ਕੋ ਲਾਗੈ ॥",
      "transliteration": "meraa prabh laae taa ko laagai ||",
      "translation": "When my God attaches someone to Him, only then is that person attached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਉਮੈ ਮਾਰੇ ਸਬਦੇ ਜਾਗੈ ॥",
      "transliteration": "haumai maare sabade jaagai ||",
      "translation": "Conquering ego, he remains awake to the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਐਥੈ ਓਥੈ ਸਦਾ ਸੁਖੁ ਆਗੈ ॥੭॥",
      "transliteration": "aithai othai sadaa sukh aagai ||7||",
      "translation": "Here and hereafter, he enjoys lasting peace. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਨੁ ਚੰਚਲੁ ਬਿਧਿ ਨਾਹੀ ਜਾਣੈ ॥",
      "transliteration": "man cha(n)chal bidh naahee jaanai ||",
      "translation": "The fickle mind does not know the way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨਮੁਖਿ ਮੈਲਾ ਸਬਦੁ ਨ ਪਛਾਣੈ ॥",
      "transliteration": "manamukh mailaa sabad na pachhaanai ||",
      "translation": "The filthy self-willed manmukh does not understand the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਿਰਮਲੁ ਨਾਮੁ ਵਖਾਣੈ ॥੮॥",
      "transliteration": "guramukh niramal naam vakhaanai ||8||",
      "translation": "The Gurmukh chants the Immaculate Naam. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਜੀਉ ਆਗੈ ਕਰੀ ਅਰਦਾਸਿ ॥",
      "transliteration": "har jeeu aagai karee aradaas ||",
      "translation": "I offer my prayer to the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਧੂ ਜਨ ਸੰਗਤਿ ਹੋਇ ਨਿਵਾਸੁ ॥",
      "transliteration": "saadhoo jan sa(n)gat hoi nivaas ||",
      "translation": "that I might dwell in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿਲਵਿਖ ਦੁਖ ਕਾਟੇ ਹਰਿ ਨਾਮੁ ਪ੍ਰਗਾਸੁ ॥੯॥",
      "transliteration": "kilavikh dukh kaate har naam pragaas ||9||",
      "translation": "There, sins and sufferings are erased, and one is illumined with the Lord's Name. ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਰਿ ਬੀਚਾਰੁ ਆਚਾਰੁ ਪਰਾਤਾ ॥",
      "transliteration": "kar beechaar aachaar paraataa ||",
      "translation": "In reflective meditation, I have come to love good conduct.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਤਿਗੁਰ ਬਚਨੀ ਏਕੋ ਜਾਤਾ ॥",
      "transliteration": "satigur bachanee eko jaataa ||",
      "translation": "Through the Word of the True Guru, I recognize the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਨਕ ਰਾਮ ਨਾਮਿ ਮਨੁ ਰਾਤਾ ॥੧੦॥੭॥",
      "transliteration": "naanak raam naam man raataa ||10||7||",
      "translation": "O Nanak, my mind is imbued with the Lord's Name. ||10||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਨੁ ਮੈਗਲੁ ਸਾਕਤੁ ਦੇਵਾਨਾ ॥",
      "transliteration": "man maigal saakat devaanaa ||",
      "translation": "The mind of the faithless cynic is like a crazy elephant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਨ ਖੰਡਿ ਮਾਇਆ ਮੋਹਿ ਹੈਰਾਨਾ ॥",
      "transliteration": "ban kha(n)d maaiaa mohi hairaanaa ||",
      "translation": "It wanders around the forest, distracted by attachment to Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਤ ਉਤ ਜਾਹਿ ਕਾਲ ਕੇ ਚਾਪੇ ॥",
      "transliteration": "it ut jaahi kaal ke chaape ||",
      "translation": "It goes here and there, hounded by death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਖੋਜਿ ਲਹੈ ਘਰੁ ਆਪੇ ॥੧॥",
      "transliteration": "guramukh khoj lahai ghar aape ||1||",
      "translation": "The Gurmukh seeks, and finds his own home. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਿਨੁ ਗੁਰਸਬਦੈ ਮਨੁ ਨਹੀ ਠਉਰਾ ॥",
      "transliteration": "bin gurasabadai man nahee thauraa ||",
      "translation": "Without the Word of the Guru's Shabad, the mind finds no place of rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਿਮਰਹੁ ਰਾਮ ਨਾਮੁ ਅਤਿ ਨਿਰਮਲੁ ਅਵਰ ਤਿਆਗਹੁ ਹਉਮੈ ਕਉਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "simarahu raam naam at niramal avar tiaagahu haumai kauraa ||1|| rahaau ||",
      "translation": "Remember in meditation the Lord's Name, the most pure and sublime; renounce your bitter egotism. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਮੁਗਧੁ ਕਹਹੁ ਕਿਉ ਰਹਸੀ ॥",
      "transliteration": "ihu man mugadh kahahu kiu rahasee ||",
      "translation": "Tell me, how can this stupid mind be rescued?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਿਨੁ ਸਮਝੇ ਜਮ ਕਾ ਦੁਖੁ ਸਹਸੀ ॥",
      "transliteration": "bin samajhe jam kaa dukh sahasee ||",
      "translation": "Without understanding, it shall suffer the pains of death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਆਪੇ ਬਖਸੇ ਸਤਿਗੁਰੁ ਮੇਲੈ ॥",
      "transliteration": "aape bakhase satigur melai ||",
      "translation": "The Lord Himself forgives us, and unites us with the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਾਲੁ ਕੰਟਕੁ ਮਾਰੇ ਸਚੁ ਪੇਲੈ ॥੨॥",
      "transliteration": "kaal ka(n)tak maare sach pelai ||2||",
      "translation": "The True Lord conquers and overcomes the tortures of death. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਕਰਮਾ ਇਹੁ ਮਨੁ ਧਰਮਾ ॥",
      "transliteration": "ihu man karamaa ihu man dharamaa ||",
      "translation": "This mind commits its deeds of karma, and this mind follows the Dharma.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਪੰਚ ਤਤੁ ਤੇ ਜਨਮਾ ॥",
      "transliteration": "ihu man pa(n)ch tat te janamaa ||",
      "translation": "This mind is born of the five elements.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਾਕਤੁ ਲੋਭੀ ਇਹੁ ਮਨੁ ਮੂੜਾ ॥",
      "transliteration": "saakat lobhee ihu man mooRaa ||",
      "translation": "This foolish mind is perverted and greedy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਮੁ ਜਪੈ ਮਨੁ ਰੂੜਾ ॥੩॥",
      "transliteration": "guramukh naam japai man rooRaa ||3||",
      "translation": "Chanting the Naam, the mind of the Gurmukh becomes beautiful. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਮਨੁ ਅਸਥਾਨੇ ਸੋਈ ॥",
      "transliteration": "guramukh man asathaane soee ||",
      "translation": "The mind of the Gurmukh finds the Lord's home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਤ੍ਰਿਭਵਣਿ ਸੋਝੀ ਹੋਈ ॥",
      "transliteration": "guramukh tribhavan sojhee hoee ||",
      "translation": "The Gurmukh comes to know the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਜੋਗੀ ਭੋਗੀ ਤਪੁ ਤਾਪੈ ॥",
      "transliteration": "ihu man jogee bhogee tap taapai ||",
      "translation": "This mind is a Yogi, an enjoyer, a practicer of austerities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਚੀਨੑੈ ਹਰਿ ਪ੍ਰਭੁ ਆਪੈ ॥੪॥",
      "transliteration": "guramukh cheenhai har prabh aapai ||4||",
      "translation": "The Gurmukh understands the Lord God Himself. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਨੁ ਬੈਰਾਗੀ ਹਉਮੈ ਤਿਆਗੀ ॥",
      "transliteration": "man bairaagee haumai tiaagee ||",
      "translation": "This mind is a detached renunciate, forsaking egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਮਨਸਾ ਦੁਬਿਧਾ ਲਾਗੀ ॥",
      "transliteration": "ghat ghat manasaa dubidhaa laagee ||",
      "translation": "Desire and duality afflict each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਮ ਰਸਾਇਣੁ ਗੁਰਮੁਖਿ ਚਾਖੈ ॥",
      "transliteration": "raam rasaain guramukh chaakhai ||",
      "translation": "The Gurmukh drinks in the Lord's sublime essence;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦਰਿ ਘਰਿ ਮਹਲੀ ਹਰਿ ਪਤਿ ਰਾਖੈ ॥੫॥",
      "transliteration": "dar ghar mahalee har pat raakhai ||5||",
      "translation": "at His Door, in the Mansion of the Lord's Presence, He preserves his honor. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਰਾਜਾ ਸੂਰ ਸੰਗ੍ਰਾਮਿ ॥",
      "transliteration": "ihu man raajaa soor sa(n)graam ||",
      "translation": "This mind is the king, the hero of cosmic battles.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਨਿਰਭਉ ਗੁਰਮੁਖਿ ਨਾਮਿ ॥",
      "transliteration": "ihu man nirabhau guramukh naam ||",
      "translation": "The mind of the Gurmukh becomes fearless through the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਾਰੇ ਪੰਚ ਅਪੁਨੈ ਵਸਿ ਕੀਏ ॥",
      "transliteration": "maare pa(n)ch apunai vas keee ||",
      "translation": "Overpowering and subduing the five passions,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਉਮੈ ਗ੍ਰਾਸਿ ਇਕਤੁ ਥਾਇ ਕੀਏ ॥੬॥",
      "transliteration": "haumai graas ikat thaai keee ||6||",
      "translation": "holding ego in its grip, it confines them to one place. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਰਾਗ ਸੁਆਦ ਅਨ ਤਿਆਗੇ ॥",
      "transliteration": "guramukh raag suaad an tiaage ||",
      "translation": "The Gurmukh renounces other songs and tastes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਇਹੁ ਮਨੁ ਭਗਤੀ ਜਾਗੇ ॥",
      "transliteration": "guramukh ihu man bhagatee jaage ||",
      "translation": "The mind of the Gurmukh is awakened to devotion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਨਹਦ ਸੁਣਿ ਮਾਨਿਆ ਸਬਦੁ ਵੀਚਾਰੀ ॥",
      "transliteration": "anahad sun maaniaa sabad veechaaree ||",
      "translation": "Hearing the unstruck music of the sound current, this mind contemplates the Shabad, and accepts it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਆਤਮੁ ਚੀਨੑਿ ਭਏ ਨਿਰੰਕਾਰੀ ॥੭॥",
      "transliteration": "aatam cheenhi bhae nira(n)kaaree ||7||",
      "translation": "Understanding itself, this soul becomes attuned to the Formless Lord. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਨਿਰਮਲੁ ਦਰਿ ਘਰਿ ਸੋਈ ॥",
      "transliteration": "ihu man niramal dar ghar soee ||",
      "translation": "This mind becomes immaculately pure, in the Court and the Home of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਭਗਤਿ ਭਾਉ ਧੁਨਿ ਹੋਈ ॥",
      "transliteration": "guramukh bhagat bhaau dhun hoee ||",
      "translation": "The Gurmukh shows his love through loving devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਹਰਿ ਜਸੁ ਗੁਰ ਪਰਸਾਦਿ ॥",
      "transliteration": "ahinis har jas gur parasaad ||",
      "translation": "Night and day, by Guru's Grace, sing the Lord's Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਸੋ ਪ੍ਰਭੁ ਆਦਿ ਜੁਗਾਦਿ ॥੮॥",
      "transliteration": "ghat ghat so prabh aad jugaad ||8||",
      "translation": "God dwells in each and every heart, since the very beginning of time, and throughout the ages. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਰਾਮ ਰਸਾਇਣਿ ਇਹੁ ਮਨੁ ਮਾਤਾ ॥",
      "transliteration": "raam rasaain ihu man maataa ||",
      "translation": "This mind is intoxicated with the sublime essence of the Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਰਬ ਰਸਾਇਣੁ ਗੁਰਮੁਖਿ ਜਾਤਾ ॥",
      "transliteration": "sarab rasaain guramukh jaataa ||",
      "translation": "The Gurmukh realizes the essence of totality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਭਗਤਿ ਹੇਤੁ ਗੁਰ ਚਰਣ ਨਿਵਾਸਾ ॥",
      "transliteration": "bhagat het gur charan nivaasaa ||",
      "translation": "For the sake of devotional worship, he dwells at the Guru's Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0415_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਜਨ ਕੇ ਦਾਸਨਿ ਦਾਸਾ ॥੯॥੮॥",
      "transliteration": "naanak har jan ke daasan daasaa ||9||8||",
      "translation": "Nanak is the humble servant of the slave of the Lord's slaves. ||9||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 415,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
