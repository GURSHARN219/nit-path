{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 416,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0416_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ॥",
      "transliteration": "aasaa mahalaa 1 ||",
      "translation": "Aasaa, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਨੁ ਬਿਨਸੈ ਧਨੁ ਕਾ ਕੋ ਕਹੀਐ ॥",
      "transliteration": "tan binasai dhan kaa ko kaheeai ||",
      "translation": "When the body perishes, whose wealth is it?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਰਾਮ ਨਾਮੁ ਕਤ ਲਹੀਐ ॥",
      "transliteration": "bin gur raam naam kat laheeai ||",
      "translation": "Without the Guru, how can the Lord's Name be obtained?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਧਨੁ ਸੰਗਿ ਸਖਾਈ ॥",
      "transliteration": "raam naam dhan sa(n)g sakhaaee ||",
      "translation": "The wealth of the Lord's Name is my Companion and Helper.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਨਿਰਮਲੁ ਹਰਿ ਲਿਵ ਲਾਈ ॥੧॥",
      "transliteration": "ahinis niramal har liv laaee ||1||",
      "translation": "Night and day, center your loving attention on the Immaculate Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਬਿਨੁ ਕਵਨੁ ਹਮਾਰਾ ॥",
      "transliteration": "raam naam bin kavan hamaaraa ||",
      "translation": "Without the Lord's Name, who is ours?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਖ ਦੁਖ ਸਮ ਕਰਿ ਨਾਮੁ ਨ ਛੋਡਉ ਆਪੇ ਬਖਸਿ ਮਿਲਾਵਣਹਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sukh dukh sam kar naam na chhodau aape bakhas milaavanahaaraa ||1|| rahaau ||",
      "translation": "I look upon pleasure and pain alike; I shall not forsake the Naam, the Name of the Lord. The Lord Himself forgives me, and blends me with Himself. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਨਿਕ ਕਾਮਨੀ ਹੇਤੁ ਗਵਾਰਾ ॥",
      "transliteration": "kanik kaamanee het gavaaraa ||",
      "translation": "The fool loves gold and women.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੁਬਿਧਾ ਲਾਗੇ ਨਾਮੁ ਵਿਸਾਰਾ ॥",
      "transliteration": "dubidhaa laage naam visaaraa ||",
      "translation": "Attached to duality, he has forgotten the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਸੁ ਤੂੰ ਬਖਸਹਿ ਨਾਮੁ ਜਪਾਇ ॥",
      "transliteration": "jis too(n) bakhasahi naam japaai ||",
      "translation": "O Lord, he alone chants the Naam, whom You have forgiven.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੂਤੁ ਨ ਲਾਗਿ ਸਕੈ ਗੁਨ ਗਾਇ ॥੨॥",
      "transliteration": "doot na laag sakai gun gaai ||2||",
      "translation": "Death cannot touch one who sings the Glorious Praises of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਗੁਰੁ ਦਾਤਾ ਰਾਮ ਗੁਪਾਲਾ ॥",
      "transliteration": "har gur daataa raam gupaalaa ||",
      "translation": "The Lord, the Guru, is the Giver; the Lord, the Sustainer of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਉ ਭਾਵੈ ਤਿਉ ਰਾਖੁ ਦਇਆਲਾ ॥",
      "transliteration": "jiu bhaavai tiu raakh daiaalaa ||",
      "translation": "If it is pleasing to Your Will, please preserve me, O Merciful Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਰਾਮੁ ਮੇਰੈ ਮਨਿ ਭਾਇਆ ॥",
      "transliteration": "guramukh raam merai man bhaaiaa ||",
      "translation": "As Gurmukh, my mind is pleased with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰੋਗ ਮਿਟੇ ਦੁਖੁ ਠਾਕਿ ਰਹਾਇਆ ॥੩॥",
      "transliteration": "rog mite dukh thaak rahaaiaa ||3||",
      "translation": "My diseases are cured, and my pains are taken away. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਵਰੁ ਨ ਅਉਖਧੁ ਤੰਤ ਨ ਮੰਤਾ ॥",
      "transliteration": "avar na aukhadh ta(n)t na ma(n)taa ||",
      "translation": "There is no other medicine, Tantric charm or mantra.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਸਿਮਰਣੁ ਕਿਲਵਿਖ ਹੰਤਾ ॥",
      "transliteration": "har har simaran kilavikh ha(n)taa ||",
      "translation": "Meditative remembrance upon the Lord, Har, Har, destroys sins.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤੂੰ ਆਪਿ ਭੁਲਾਵਹਿ ਨਾਮੁ ਵਿਸਾਰਿ ॥",
      "transliteration": "too(n) aap bhulaavahi naam visaar ||",
      "translation": "You Yourself cause us to stray from the path, and forget the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤੂੰ ਆਪੇ ਰਾਖਹਿ ਕਿਰਪਾ ਧਾਰਿ ॥੪॥",
      "transliteration": "too(n) aape raakhahi kirapaa dhaar ||4||",
      "translation": "Showering Your Mercy, You Yourself save us. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰੋਗੁ ਭਰਮੁ ਭੇਦੁ ਮਨਿ ਦੂਜਾ ॥",
      "transliteration": "rog bharam bhed man doojaa ||",
      "translation": "The mind is diseased with doubt, superstition and duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਰ ਬਿਨੁ ਭਰਮਿ ਜਪਹਿ ਜਪੁ ਦੂਜਾ ॥",
      "transliteration": "gur bin bharam japahi jap doojaa ||",
      "translation": "Without the Guru, it dwells in doubt, and contemplates duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਦਿ ਪੁਰਖ ਗੁਰ ਦਰਸ ਨ ਦੇਖਹਿ ॥",
      "transliteration": "aad purakh gur daras na dekhahi ||",
      "translation": "The Guru reveals the Darshan, the Blessed Vision of the Primal Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਵਿਣੁ ਗੁਰਸਬਦੈ ਜਨਮੁ ਕਿ ਲੇਖਹਿ ॥੫॥",
      "transliteration": "vin gurasabadai janam k lekhahi ||5||",
      "translation": "Without the Word of the Guru's Shabad, what use is human life? ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੇਖਿ ਅਚਰਜੁ ਰਹੇ ਬਿਸਮਾਦਿ ॥",
      "transliteration": "dekh acharaj rahe bisamaad ||",
      "translation": "Beholding the Marvellous Lord, I am wonder-struck and astonished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਸੁਰ ਨਰ ਸਹਜ ਸਮਾਧਿ ॥",
      "transliteration": "ghat ghat sur nar sahaj samaadh ||",
      "translation": "In each and every heart, of the angels and holy men, He dwells in celestial Samaadhi.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭਰਿਪੁਰਿ ਧਾਰਿ ਰਹੇ ਮਨ ਮਾਹੀ ॥",
      "transliteration": "bharipur dhaar rahe man maahee ||",
      "translation": "I have enshrined the All-pervading Lord within my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੁਮ ਸਮਸਰਿ ਅਵਰੁ ਕੋ ਨਾਹੀ ॥੬॥",
      "transliteration": "tum samasar avar ko naahee ||6||",
      "translation": "There is no one else equal to You. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾ ਕੀ ਭਗਤਿ ਹੇਤੁ ਮੁਖਿ ਨਾਮੁ ॥",
      "transliteration": "jaa kee bhagat het mukh naam ||",
      "translation": "For the sake of devotional worship, we chant Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੰਤ ਭਗਤ ਕੀ ਸੰਗਤਿ ਰਾਮੁ ॥",
      "transliteration": "sa(n)t bhagat kee sa(n)gat raam ||",
      "translation": "The Lord's devotees dwell in the Society of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬੰਧਨ ਤੋਰੇ ਸਹਜਿ ਧਿਆਨੁ ॥",
      "transliteration": "ba(n)dhan tore sahaj dhiaan ||",
      "translation": "Breaking his bonds, one comes to meditate on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਛੂਟੈ ਗੁਰਮੁਖਿ ਹਰਿ ਗੁਰ ਗਿਆਨੁ ॥੭॥",
      "transliteration": "chhootai guramukh har gur giaan ||7||",
      "translation": "The Gurmukhs are emancipated, by the Guru-given knowledge of the Lord. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾ ਜਮਦੂਤ ਦੂਖੁ ਤਿਸੁ ਲਾਗੈ ॥",
      "transliteration": "naa jamadoot dookh tis laagai ||",
      "translation": "The Messenger of Death cannot touch him with pain;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜੋ ਜਨੁ ਰਾਮ ਨਾਮਿ ਲਿਵ ਜਾਗੈ ॥",
      "transliteration": "jo jan raam naam liv jaagai ||",
      "translation": "the Lord's humble servant remains awake to the Love of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਗਤਿ ਵਛਲੁ ਭਗਤਾ ਹਰਿ ਸੰਗਿ ॥",
      "transliteration": "bhagat vachhal bhagataa har sa(n)g ||",
      "translation": "The Lord is the Lover of His devotees; He dwells with His devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕ ਮੁਕਤਿ ਭਏ ਹਰਿ ਰੰਗਿ ॥੮॥੯॥",
      "transliteration": "naanak mukat bhae har ra(n)g ||8||9||",
      "translation": "O Nanak, they are liberated, through the Love of the Lord. ||8||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਸਾ ਮਹਲਾ ੧ ਇਕਤੁਕੀ ॥",
      "transliteration": "aasaa mahalaa 1 ikatukee ||",
      "translation": "Aasaa, First Mehl, Ik-Tukee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰੁ ਸੇਵੇ ਸੋ ਠਾਕੁਰ ਜਾਨੈ ॥",
      "transliteration": "gur seve so thaakur jaanai ||",
      "translation": "One who serves the Guru, knows his Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੂਖੁ ਮਿਟੈ ਸਚੁ ਸਬਦਿ ਪਛਾਨੈ ॥੧॥",
      "transliteration": "dookh mitai sach sabad pachhaanai ||1||",
      "translation": "His pains are erased, and he realizes the True Word of the Shabad. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਮੁ ਜਪਹੁ ਮੇਰੀ ਸਖੀ ਸਖੈਨੀ ॥",
      "transliteration": "raam japahu meree sakhee sakhainee ||",
      "translation": "Meditate on the Lord, O my friends and companions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵਿ ਦੇਖਹੁ ਪ੍ਰਭੁ ਨੈਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "satigur sev dekhahu prabh nainee ||1|| rahaau ||",
      "translation": "Serving the True Guru, you shall behold God with your eyes. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬੰਧਨ ਮਾਤ ਪਿਤਾ ਸੰਸਾਰਿ ॥",
      "transliteration": "ba(n)dhan maat pitaa sa(n)saar ||",
      "translation": "People are entangled with mother, father and the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬੰਧਨ ਸੁਤ ਕੰਨਿਆ ਅਰੁ ਨਾਰਿ ॥੨॥",
      "transliteration": "ba(n)dhan sut ka(n)niaa ar naar ||2||",
      "translation": "They are entangled with sons, daughters and spouses. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬੰਧਨ ਕਰਮ ਧਰਮ ਹਉ ਕੀਆ ॥",
      "transliteration": "ba(n)dhan karam dharam hau keeaa ||",
      "translation": "They are entangled with religious rituals, and religious faith, acting in ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬੰਧਨ ਪੁਤੁ ਕਲਤੁ ਮਨਿ ਬੀਆ ॥੩॥",
      "transliteration": "ba(n)dhan put kalat man beeaa ||3||",
      "translation": "They are entangled with sons, wives and others in their minds. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬੰਧਨ ਕਿਰਖੀ ਕਰਹਿ ਕਿਰਸਾਨ ॥",
      "transliteration": "ba(n)dhan kirakhee karahi kirasaan ||",
      "translation": "The farmers are entangled by farming.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਉਮੈ ਡੰਨੁ ਸਹੈ ਰਾਜਾ ਮੰਗੈ ਦਾਨ ॥੪॥",
      "transliteration": "haumai da(n)n sahai raajaa ma(n)gai daan ||4||",
      "translation": "People suffer punishment in ego, and the Lord King exacts the penalty from them. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬੰਧਨ ਸਉਦਾ ਅਣਵੀਚਾਰੀ ॥",
      "transliteration": "ba(n)dhan saudaa anaveechaaree ||",
      "translation": "They are entangled in trade without contemplation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਪਤਿ ਨਾਹੀ ਮਾਇਆ ਮੋਹ ਪਸਾਰੀ ॥੫॥",
      "transliteration": "tipat naahee maaiaa moh pasaaree ||5||",
      "translation": "They are not satisfied by attachment to the expanse of Maya. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬੰਧਨ ਸਾਹ ਸੰਚਹਿ ਧਨੁ ਜਾਇ ॥",
      "transliteration": "ba(n)dhan saah sa(n)chahi dhan jaai ||",
      "translation": "They are entangled with that wealth, amassed by bankers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਭਗਤਿ ਨ ਪਵਈ ਥਾਇ ॥੬॥",
      "transliteration": "bin har bhagat na pavaee thaai ||6||",
      "translation": "Without devotion to the Lord, they do not become acceptable. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬੰਧਨ ਬੇਦੁ ਬਾਦੁ ਅਹੰਕਾਰ ॥",
      "transliteration": "ba(n)dhan bed baad aha(n)kaar ||",
      "translation": "They are entangled with the Vedas, religious discussions and egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਬੰਧਨਿ ਬਿਨਸੈ ਮੋਹ ਵਿਕਾਰ ॥੭॥",
      "transliteration": "ba(n)dhan binasai moh vikaar ||7||",
      "translation": "They are entangled, and perish in attachment and corruption. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾਨਕ ਰਾਮ ਨਾਮ ਸਰਣਾਈ ॥",
      "transliteration": "naanak raam naam saranaaee ||",
      "translation": "Nanak seeks the Sanctuary of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0416_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਰਾਖੇ ਬੰਧੁ ਨ ਪਾਈ ॥੮॥੧੦॥",
      "transliteration": "satigur raakhe ba(n)dh na paaee ||8||10||",
      "translation": "One who is saved by the True Guru, does not suffer entanglement. ||8||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 416,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
