{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 463,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0463_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਹਲਾ ੨ ॥",
      "transliteration": "mahalaa 2 ||",
      "translation": "Second Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜੇ ਸਉ ਚੰਦਾ ਉਗਵਹਿ ਸੂਰਜ ਚੜਹਿ ਹਜਾਰ ॥",
      "transliteration": "je sau cha(n)daa ugavahi sooraj chaRahi hajaar ||",
      "translation": "If a hundred moons were to rise, and a thousand suns appeared,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਏਤੇ ਚਾਨਣ ਹੋਦਿਆਂ ਗੁਰ ਬਿਨੁ ਘੋਰ ਅੰਧਾਰ ॥੨॥",
      "transliteration": "ete chaanan hodiaa(n) gur bin ghor a(n)dhaar ||2||",
      "translation": "even with such light, there would still be pitch darkness without the Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਃ ੧ ॥",
      "transliteration": "mah 1 ||",
      "translation": "First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਨਕ ਗੁਰੂ ਨ ਚੇਤਨੀ ਮਨਿ ਆਪਣੈ ਸੁਚੇਤ ॥",
      "transliteration": "naanak guroo na chetanee man aapanai suchet ||",
      "translation": "O Nanak, those who do not think of the Guru, and who think of themselves as clever,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਛੁਟੇ ਤਿਲ ਬੂਆੜ ਜਿਉ ਸੁੰਞੇ ਅੰਦਰਿ ਖੇਤ ॥",
      "transliteration": "chhute til booaaR jiu su(n)nje a(n)dar khet ||",
      "translation": "shall be left abandoned in the field, like the scattered sesame.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਖੇਤੈ ਅੰਦਰਿ ਛੁਟਿਆ ਕਹੁ ਨਾਨਕ ਸਉ ਨਾਹ ॥",
      "transliteration": "khetai a(n)dar chhutiaa kahu naanak sau naah ||",
      "translation": "They are abandoned in the field, says Nanak, and they have a hundred masters to please.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਫਲੀਅਹਿ ਫੁਲੀਅਹਿ ਬਪੁੜੇ ਭੀ ਤਨ ਵਿਚਿ ਸੁਆਹ ॥੩॥",
      "transliteration": "phaleeahi phuleeahi bapuRe bhee tan vich suaah ||3||",
      "translation": "The wretches bear fruit and flower, but within their bodies, they are filled with ashes. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਪੀਨੑੈ ਆਪੁ ਸਾਜਿਓ ਆਪੀਨੑੈ ਰਚਿਓ ਨਾਉ ॥",
      "transliteration": "aapeenhai aap saajio aapeenhai rachio naau ||",
      "translation": "He Himself created Himself; He Himself assumed His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੁਯੀ ਕੁਦਰਤਿ ਸਾਜੀਐ ਕਰਿ ਆਸਣੁ ਡਿਠੋ ਚਾਉ ॥",
      "transliteration": "duyee kudarat saajeeai kar aasan ditho chaau ||",
      "translation": "Secondly, He fashioned the creation; seated within the creation, He beholds it with delight.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦਾਤਾ ਕਰਤਾ ਆਪਿ ਤੂੰ ਤੁਸਿ ਦੇਵਹਿ ਕਰਹਿ ਪਸਾਉ ॥",
      "transliteration": "daataa karataa aap too(n) tus devahi karahi pasaau ||",
      "translation": "You Yourself are the Giver and the Creator; by Your Pleasure, You bestow Your Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੂੰ ਜਾਣੋਈ ਸਭਸੈ ਦੇ ਲੈਸਹਿ ਜਿੰਦੁ ਕਵਾਉ ॥",
      "transliteration": "too(n) jaanoee sabhasai de laisahi ji(n)d kavaau ||",
      "translation": "You are the Knower of all; You give life, and take it away again with a word.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰਿ ਆਸਣੁ ਡਿਠੋ ਚਾਉ ॥੧॥",
      "transliteration": "kar aasan ditho chaau ||1||",
      "translation": "Seated within the creation, You behold it with delight. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਲੋਕੁ ਮਃ ੧ ॥",
      "transliteration": "salok mah 1 ||",
      "translation": "Salok, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਚੇ ਤੇਰੇ ਖੰਡ ਸਚੇ ਬ੍ਰਹਮੰਡ ॥",
      "transliteration": "sache tere kha(n)d sache brahama(n)d ||",
      "translation": "True are Your worlds, True are Your solar Systems.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਚੇ ਤੇਰੇ ਲੋਅ ਸਚੇ ਆਕਾਰ ॥",
      "transliteration": "sache tere lo sache aakaar ||",
      "translation": "True are Your realms, True is Your creation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਚੇ ਤੇਰੇ ਕਰਣੇ ਸਰਬ ਬੀਚਾਰ ॥",
      "transliteration": "sache tere karane sarab beechaar ||",
      "translation": "True are Your actions, and all Your deliberations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਚਾ ਤੇਰਾ ਅਮਰੁ ਸਚਾ ਦੀਬਾਣੁ ॥",
      "transliteration": "sachaa teraa amar sachaa deebaan ||",
      "translation": "True is Your Command, and True is Your Court.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਚਾ ਤੇਰਾ ਹੁਕਮੁ ਸਚਾ ਫੁਰਮਾਣੁ ॥",
      "transliteration": "sachaa teraa hukam sachaa phuramaan ||",
      "translation": "True is the Command of Your Will, True is Your Order.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਚਾ ਤੇਰਾ ਕਰਮੁ ਸਚਾ ਨੀਸਾਣੁ ॥",
      "transliteration": "sachaa teraa karam sachaa neesaan ||",
      "translation": "True is Your Mercy, True is Your Insignia.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਚੇ ਤੁਧੁ ਆਖਹਿ ਲਖ ਕਰੋੜਿ ॥",
      "transliteration": "sache tudh aakhahi lakh karoR ||",
      "translation": "Hundreds of thousands and millions call You True.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਚੈ ਸਭਿ ਤਾਣਿ ਸਚੈ ਸਭਿ ਜੋਰਿ ॥",
      "transliteration": "sachai sabh taan sachai sabh jor ||",
      "translation": "In the True Lord is all power, in the True Lord is all might.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਚੀ ਤੇਰੀ ਸਿਫਤਿ ਸਚੀ ਸਾਲਾਹ ॥",
      "transliteration": "sachee teree siphat sachee saalaah ||",
      "translation": "True is Your Praise, True is Your Adoration.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਚੀ ਤੇਰੀ ਕੁਦਰਤਿ ਸਚੇ ਪਾਤਿਸਾਹ ॥",
      "transliteration": "sachee teree kudarat sache paatisaah ||",
      "translation": "True is Your almighty creative power, True King.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਨਕ ਸਚੁ ਧਿਆਇਨਿ ਸਚੁ ॥",
      "transliteration": "naanak sach dhiaain sach ||",
      "translation": "O Nanak, true are those who meditate on the True One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੋ ਮਰਿ ਜੰਮੇ ਸੁ ਕਚੁ ਨਿਕਚੁ ॥੧॥",
      "transliteration": "jo mar ja(n)me s kach nikach ||1||",
      "translation": "Those who are subject to birth and death are totally false. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਃ ੧ ॥",
      "transliteration": "mah 1 ||",
      "translation": "First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਵਡੀ ਵਡਿਆਈ ਜਾ ਵਡਾ ਨਾਉ ॥",
      "transliteration": "vadee vadiaaee jaa vadaa naau ||",
      "translation": "Great is His greatness, as great as His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਵਡੀ ਵਡਿਆਈ ਜਾ ਸਚੁ ਨਿਆਉ ॥",
      "transliteration": "vadee vadiaaee jaa sach niaau ||",
      "translation": "Great is His greatness, as True is His justice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਵਡੀ ਵਡਿਆਈ ਜਾ ਨਿਹਚਲ ਥਾਉ ॥",
      "transliteration": "vadee vadiaaee jaa nihachal thaau ||",
      "translation": "Great is His greatness, as permanent as His Throne.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਵਡੀ ਵਡਿਆਈ ਜਾਣੈ ਆਲਾਉ ॥",
      "transliteration": "vadee vadiaaee jaanai aalaau ||",
      "translation": "Great is His greatness, as He knows our utterances.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਵਡੀ ਵਡਿਆਈ ਬੁਝੈ ਸਭਿ ਭਾਉ ॥",
      "transliteration": "vadee vadiaaee bujhai sabh bhaau ||",
      "translation": "Great is His greatness, as He understands all our affections.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਵਡੀ ਵਡਿਆਈ ਜਾ ਪੁਛਿ ਨ ਦਾਤਿ ॥",
      "transliteration": "vadee vadiaaee jaa puchh na daat ||",
      "translation": "Great is His greatness, as He gives without being asked.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਵਡੀ ਵਡਿਆਈ ਜਾ ਆਪੇ ਆਪਿ ॥",
      "transliteration": "vadee vadiaaee jaa aape aap ||",
      "translation": "Great is His greatness, as He Himself is all-in-all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਨਕ ਕਾਰ ਨ ਕਥਨੀ ਜਾਇ ॥",
      "transliteration": "naanak kaar na kathanee jaai ||",
      "translation": "O Nanak, His actions cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕੀਤਾ ਕਰਣਾ ਸਰਬ ਰਜਾਇ ॥੨॥",
      "transliteration": "keetaa karanaa sarab rajaai ||2||",
      "translation": "Whatever He has done, or will do, is all by His Own Will. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਹਲਾ ੨ ॥",
      "transliteration": "mahalaa 2 ||",
      "translation": "Second Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਹੁ ਜਗੁ ਸਚੈ ਕੀ ਹੈ ਕੋਠੜੀ ਸਚੇ ਕਾ ਵਿਚਿ ਵਾਸੁ ॥",
      "transliteration": "ihu jag sachai kee hai kothaRee sache kaa vich vaas ||",
      "translation": "This world is the room of the True Lord; within it is the dwelling of the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਇਕਨੑਾ ਹੁਕਮਿ ਸਮਾਇ ਲਏ ਇਕਨੑਾ ਹੁਕਮੇ ਕਰੇ ਵਿਣਾਸੁ ॥",
      "transliteration": "ikanhaa hukam samaai lae ikanhaa hukame kare vinaas ||",
      "translation": "By His Command, some are merged into Him, and some, by His Command, are destroyed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਕਨੑਾ ਭਾਣੈ ਕਢਿ ਲਏ ਇਕਨੑਾ ਮਾਇਆ ਵਿਚਿ ਨਿਵਾਸੁ ॥",
      "transliteration": "ikanhaa bhaanai kadh lae ikanhaa maaiaa vich nivaas ||",
      "translation": "Some, by the Pleasure of His Will, are lifted up out of Maya, while others are made to dwell within it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਏਵ ਭਿ ਆਖਿ ਨ ਜਾਪਈ ਜਿ ਕਿਸੈ ਆਣੇ ਰਾਸਿ ॥",
      "transliteration": "ev bh aakh na jaapaee j kisai aane raas ||",
      "translation": "No one can say who will be rescued.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਜਾਣੀਐ ਜਾ ਕਉ ਆਪਿ ਕਰੇ ਪਰਗਾਸੁ ॥੩॥",
      "transliteration": "naanak guramukh jaaneeai jaa kau aap kare paragaas ||3||",
      "translation": "O Nanak, he alone is known as Gurmukh, unto whom the Lord reveals Himself. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਜੀਅ ਉਪਾਇ ਕੈ ਲਿਖਿ ਨਾਵੈ ਧਰਮੁ ਬਹਾਲਿਆ ॥",
      "transliteration": "naanak jee upaai kai likh naavai dharam bahaaliaa ||",
      "translation": "O Nanak, having created the souls, the Lord installed the Righteous Judge of Dharma to read and record their accounts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਓਥੈ ਸਚੇ ਹੀ ਸਚਿ ਨਿਬੜੈ ਚੁਣਿ ਵਖਿ ਕਢੇ ਜਜਮਾਲਿਆ ॥",
      "transliteration": "othai sache hee sach nibaRai chun vakh kadhe jajamaaliaa ||",
      "translation": "There, only the Truth is judged true; the sinners are picked out and separated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਥਾਉ ਨ ਪਾਇਨਿ ਕੂੜਿਆਰ ਮੁਹ ਕਾਲੑੈ ਦੋਜਕਿ ਚਾਲਿਆ ॥",
      "transliteration": "thaau na paain kooRiaar muh kaalhai dojak chaaliaa ||",
      "translation": "The false find no place there, and they go to hell with their faces blackened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤੇਰੈ ਨਾਇ ਰਤੇ ਸੇ ਜਿਣਿ ਗਏ ਹਾਰਿ ਗਏ ਸਿ ਠਗਣ ਵਾਲਿਆ ॥",
      "transliteration": "terai naai rate se jin gae haar gae s thagan vaaliaa ||",
      "translation": "Those who are imbued with Your Name win, while the cheaters lose.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਲਿਖਿ ਨਾਵੈ ਧਰਮੁ ਬਹਾਲਿਆ ॥੨॥",
      "transliteration": "likh naavai dharam bahaaliaa ||2||",
      "translation": "The Lord installed the Righteous Judge of Dharma to read and record the accounts. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਲੋਕ ਮਃ ੧ ॥",
      "transliteration": "salok mah 1 ||",
      "translation": "Salok, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਵਿਸਮਾਦੁ ਨਾਦ ਵਿਸਮਾਦੁ ਵੇਦ ॥",
      "transliteration": "visamaad naad visamaad ved ||",
      "translation": "Wonderful is the sound current of the Naad, wonderful is the knowledge of the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਵਿਸਮਾਦੁ ਜੀਅ ਵਿਸਮਾਦੁ ਭੇਦ ॥",
      "transliteration": "visamaad jee visamaad bhed ||",
      "translation": "Wonderful are the beings, wonderful are the species.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਵਿਸਮਾਦੁ ਰੂਪ ਵਿਸਮਾਦੁ ਰੰਗ ॥",
      "transliteration": "visamaad roop visamaad ra(n)g ||",
      "translation": "Wonderful are the forms, wonderful are the colors.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0463_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਵਿਸਮਾਦੁ ਨਾਗੇ ਫਿਰਹਿ ਜੰਤ ॥",
      "transliteration": "visamaad naage phirahi ja(n)t ||",
      "translation": "Wonderful are the beings who wander around naked.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 463,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
