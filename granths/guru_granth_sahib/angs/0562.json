{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 562,
  "lineCount": 43,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0562_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਧਨੁ ਧੰਨੁ ਗੁਰੂ ਗੁਰ ਸਤਿਗੁਰੁ ਪੂਰਾ ਨਾਨਕ ਮਨਿ ਆਸ ਪੁਜਾਏ ॥੪॥",
      "transliteration": "dhan dha(n)n guroo gur satigur pooraa naanak man aas pujaae ||4||",
      "translation": "Hail, hail unto the Guru, the Guru, the Perfect True Guru, who fulfills Nanak's heart's desires. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਰੁ ਸਜਣੁ ਮੇਰਾ ਮੇਲਿ ਹਰੇ ਜਿਤੁ ਮਿਲਿ ਹਰਿ ਨਾਮੁ ਧਿਆਵਾ ॥",
      "transliteration": "gur sajan meraa mel hare jit mil har naam dhiaavaa ||",
      "translation": "O Lord, let me meet the Guru, my best friend; meeting Him, I meditate on the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੁਰ ਸਤਿਗੁਰ ਪਾਸਹੁ ਹਰਿ ਗੋਸਟਿ ਪੂਛਾਂ ਕਰਿ ਸਾਂਝੀ ਹਰਿ ਗੁਣ ਗਾਵਾਂ ॥",
      "transliteration": "gur satigur paasahu har gosat poochhaa(n) kar saa(n)jhee har gun gaavaa(n) ||",
      "translation": "I seek the Lord's sermon from the Guru, the True Guru; joining with Him, I sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਣ ਗਾਵਾ ਨਿਤ ਨਿਤ ਸਦ ਹਰਿ ਕੇ ਮਨੁ ਜੀਵੈ ਨਾਮੁ ਸੁਣਿ ਤੇਰਾ ॥",
      "transliteration": "gun gaavaa nit nit sad har ke man jeevai naam sun teraa ||",
      "translation": "Each and every day, forever, I sing the Lord's Praises; my mind lives by hearing Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਨਕ ਜਿਤੁ ਵੇਲਾ ਵਿਸਰੈ ਮੇਰਾ ਸੁਆਮੀ ਤਿਤੁ ਵੇਲੈ ਮਰਿ ਜਾਇ ਜੀਉ ਮੇਰਾ ॥੫॥",
      "transliteration": "naanak jit velaa visarai meraa suaamee tit velai mar jaai jeeu meraa ||5||",
      "translation": "O Nanak, that moment when I forget my Lord and Master - at that moment, my soul dies. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਰਿ ਵੇਖਣ ਕਉ ਸਭੁ ਕੋਈ ਲੋਚੈ ਸੋ ਵੇਖੈ ਜਿਸੁ ਆਪਿ ਵਿਖਾਲੇ ॥",
      "transliteration": "har vekhan kau sabh koee lochai so vekhai jis aap vikhaale ||",
      "translation": "Everyone longs to see the Lord, but he alone sees Him, whom the Lord causes to see Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਿਸ ਨੋ ਨਦਰਿ ਕਰੇ ਮੇਰਾ ਪਿਆਰਾ ਸੋ ਹਰਿ ਹਰਿ ਸਦਾ ਸਮਾਲੇ ॥",
      "transliteration": "jis no nadar kare meraa piaaraa so har har sadaa samaale ||",
      "translation": "One upon whom my Beloved bestows His Glance of Grace, cherishes the Lord, Har, Har forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੋ ਹਰਿ ਹਰਿ ਨਾਮੁ ਸਦਾ ਸਦਾ ਸਮਾਲੇ ਜਿਸੁ ਸਤਗੁਰੁ ਪੂਰਾ ਮੇਰਾ ਮਿਲਿਆ ॥",
      "transliteration": "so har har naam sadaa sadaa samaale jis satagur pooraa meraa miliaa ||",
      "translation": "He alone cherishes the Lord, Har, Har, forever and ever, who meets my Perfect True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਜਨ ਹਰਿ ਇਕੇ ਹੋਏ ਹਰਿ ਜਪਿ ਹਰਿ ਸੇਤੀ ਰਲਿਆ ॥੬॥੧॥੩॥",
      "transliteration": "naanak har jan har ike hoe har jap har setee raliaa ||6||1||3||",
      "translation": "O Nanak, the Lord's humble servant and the Lord become One; meditating on the Lord, he blends with the Lord. ||6||1||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਵਡਹੰਸੁ ਮਹਲਾ ੫ ਘਰੁ ੧ ॥",
      "transliteration": "vadaha(n)s mahalaa 5 ghar 1 ||",
      "translation": "Wadahans, Fifth Mehl, First House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਤਿ ਊਚਾ ਤਾ ਕਾ ਦਰਬਾਰਾ ॥",
      "transliteration": "at oochaa taa kaa darabaaraa ||",
      "translation": "His Darbaar, His Court, is the most lofty and exalted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅੰਤੁ ਨਾਹੀ ਕਿਛੁ ਪਾਰਾਵਾਰਾ ॥",
      "transliteration": "a(n)t naahee kichh paaraavaaraa ||",
      "translation": "It has no end or limitations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੋਟਿ ਕੋਟਿ ਕੋਟਿ ਲਖ ਧਾਵੈ ॥",
      "transliteration": "kot kot kot lakh dhaavai ||",
      "translation": "Millions, millions, tens of millions seek,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਕੁ ਤਿਲੁ ਤਾ ਕਾ ਮਹਲੁ ਨ ਪਾਵੈ ॥੧॥",
      "transliteration": "ik til taa kaa mahal na paavai ||1||",
      "translation": "but they cannot find even a tiny bit of His Mansion. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਹਾਵੀ ਕਉਣੁ ਸੁ ਵੇਲਾ ਜਿਤੁ ਪ੍ਰਭ ਮੇਲਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "suhaavee kaun s velaa jit prabh melaa ||1|| rahaau ||",
      "translation": "What is that auspicious moment, when God is met? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਲਾਖ ਭਗਤ ਜਾ ਕਉ ਆਰਾਧਹਿ ॥",
      "transliteration": "laakh bhagat jaa kau aaraadhahi ||",
      "translation": "Tens of thousands of devotees worship Him in adoration.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਲਾਖ ਤਪੀਸਰ ਤਪੁ ਹੀ ਸਾਧਹਿ ॥",
      "transliteration": "laakh tapeesar tap hee saadhahi ||",
      "translation": "Tens of thousands of ascetics practice austere discipline.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਲਾਖ ਜੋਗੀਸਰ ਕਰਤੇ ਜੋਗਾ ॥",
      "transliteration": "laakh jogeesar karate jogaa ||",
      "translation": "Tens of thousands of Yogis practice Yoga.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਲਾਖ ਭੋਗੀਸਰ ਭੋਗਹਿ ਭੋਗਾ ॥੨॥",
      "transliteration": "laakh bhogeesar bhogahi bhogaa ||2||",
      "translation": "Tens of thousands of pleasure seekers seek pleasure. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਵਸਹਿ ਜਾਣਹਿ ਥੋਰਾ ॥",
      "transliteration": "ghat ghat vasahi jaanahi thoraa ||",
      "translation": "He dwells in each and every heart, but only a few know this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹੈ ਕੋਈ ਸਾਜਣੁ ਪਰਦਾ ਤੋਰਾ ॥",
      "transliteration": "hai koee saajan paradaa toraa ||",
      "translation": "Is there any friend who can rip apart the screen of separation?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਰਉ ਜਤਨ ਜੇ ਹੋਇ ਮਿਹਰਵਾਨਾ ॥",
      "transliteration": "karau jatan je hoi miharavaanaa ||",
      "translation": "I can only make the effort, if the Lord is merciful to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਾ ਕਉ ਦੇਈ ਜੀਉ ਕੁਰਬਾਨਾ ॥੩॥",
      "transliteration": "taa kau deee jeeu kurabaanaa ||3||",
      "translation": "I sacrifice my body and soul to Him. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਫਿਰਤ ਫਿਰਤ ਸੰਤਨ ਪਹਿ ਆਇਆ ॥",
      "transliteration": "phirat phirat sa(n)tan pahi aaiaa ||",
      "translation": "After wandering around for so long, I have finally come to the Saints;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੂਖ ਭ੍ਰਮੁ ਹਮਾਰਾ ਸਗਲ ਮਿਟਾਇਆ ॥",
      "transliteration": "dookh bhram hamaaraa sagal mitaaiaa ||",
      "translation": "all of my pains and doubts have been eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਹਲਿ ਬੁਲਾਇਆ ਪ੍ਰਭ ਅੰਮ੍ਰਿਤੁ ਭੂੰਚਾ ॥",
      "transliteration": "mahal bulaaiaa prabh a(n)mrit bhoo(n)chaa ||",
      "translation": "God summoned me to the Mansion of His Presence, and blessed me with the Ambrosial Nectar of His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਪ੍ਰਭੁ ਮੇਰਾ ਊਚਾ ॥੪॥੧॥",
      "transliteration": "kahu naanak prabh meraa oochaa ||4||1||",
      "translation": "Says Nanak, my God is lofty and exalted. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਵਡਹੰਸੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "vadaha(n)s mahalaa 5 ||",
      "translation": "Wadahans, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਧਨੁ ਸੁ ਵੇਲਾ ਜਿਤੁ ਦਰਸਨੁ ਕਰਣਾ ॥",
      "transliteration": "dhan s velaa jit darasan karanaa ||",
      "translation": "Blessed is that time, when the Blessed Vision of His Darshan is given;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਉ ਬਲਿਹਾਰੀ ਸਤਿਗੁਰ ਚਰਣਾ ॥੧॥",
      "transliteration": "hau balihaaree satigur charanaa ||1||",
      "translation": "I am a sacrifice to the feet of the True Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੀਅ ਕੇ ਦਾਤੇ ਪ੍ਰੀਤਮ ਪ੍ਰਭ ਮੇਰੇ ॥",
      "transliteration": "jee ke daate preetam prabh mere ||",
      "translation": "You are the Giver of souls, O my Beloved God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਨੁ ਜੀਵੈ ਪ੍ਰਭ ਨਾਮੁ ਚਿਤੇਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "man jeevai prabh naam chitere ||1|| rahaau ||",
      "translation": "My soul lives by reflecting upon the Name of God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਚੁ ਮੰਤ੍ਰੁ ਤੁਮਾਰਾ ਅੰਮ੍ਰਿਤ ਬਾਣੀ ॥",
      "transliteration": "sach ma(n)tr tumaaraa a(n)mrit baanee ||",
      "translation": "True is Your Mantra, Ambrosial is the Bani of Your Word.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੀਤਲ ਪੁਰਖ ਦ੍ਰਿਸਟਿ ਸੁਜਾਣੀ ॥੨॥",
      "transliteration": "seetal purakh drisat sujaanee ||2||",
      "translation": "Cooling and soothing is Your Presence, all-knowing is Your gaze. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਚੁ ਹੁਕਮੁ ਤੁਮਾਰਾ ਤਖਤਿ ਨਿਵਾਸੀ ॥",
      "transliteration": "sach hukam tumaaraa takhat nivaasee ||",
      "translation": "True is Your Command; You sit upon the eternal throne.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਇ ਨ ਜਾਵੈ ਮੇਰਾ ਪ੍ਰਭੁ ਅਬਿਨਾਸੀ ॥੩॥",
      "transliteration": "aai na jaavai meraa prabh abinaasee ||3||",
      "translation": "My eternal God does not come or go. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੁਮ ਮਿਹਰਵਾਨ ਦਾਸ ਹਮ ਦੀਨਾ ॥",
      "transliteration": "tum miharavaan daas ham deenaa ||",
      "translation": "You are the Merciful Master; I am Your humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 562,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0562_line_0039",
