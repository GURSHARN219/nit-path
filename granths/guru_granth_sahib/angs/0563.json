{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 563,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0563_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਪਿ ਜੀਵਾ ਪ੍ਰਭ ਚਰਣ ਤੁਮਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jap jeevaa prabh charan tumaare ||1|| rahaau ||",
      "translation": "I live by meditating on Your Feet, God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦਇਆਲ ਪੁਰਖ ਮੇਰੇ ਪ੍ਰਭ ਦਾਤੇ ॥",
      "transliteration": "daiaal purakh mere prabh daate ||",
      "translation": "O my Merciful and Almighty God, O Great Giver,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਿਸਹਿ ਜਨਾਵਹੁ ਤਿਨਹਿ ਤੁਮ ਜਾਤੇ ॥੨॥",
      "transliteration": "jisahi janaavahu tinahi tum jaate ||2||",
      "translation": "he alone knows You, whom You so bless. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਜਾਈ ਬਲਿਹਾਰੀ ॥",
      "transliteration": "sadaa sadaa jaaee balihaaree ||",
      "translation": "Forever and ever, I am a sacrifice to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਤ ਉਤ ਦੇਖਉ ਓਟ ਤੁਮਾਰੀ ॥੩॥",
      "transliteration": "it ut dekhau ot tumaaree ||3||",
      "translation": "Here and hereafter, I seek Your Protection. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੋਹਿ ਨਿਰਗੁਣ ਗੁਣੁ ਕਿਛੂ ਨ ਜਾਤਾ ॥",
      "transliteration": "mohi niragun gun kichhoo na jaataa ||",
      "translation": "I am without virtue; I know none of Your Glorious Virtues.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਨਕ ਸਾਧੂ ਦੇਖਿ ਮਨੁ ਰਾਤਾ ॥੪॥੩॥",
      "transliteration": "naanak saadhoo dekh man raataa ||4||3||",
      "translation": "O Nanak, seeing the Holy Saint, my mind is imbued with You. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਵਡਹੰਸੁ ਮਃ ੫ ॥",
      "transliteration": "vadaha(n)s mah 5 ||",
      "translation": "Wadahans, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅੰਤਰਜਾਮੀ ਸੋ ਪ੍ਰਭੁ ਪੂਰਾ ॥",
      "transliteration": "a(n)tarajaamee so prabh pooraa ||",
      "translation": "God is perfect - He is the Inner-knower, the Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦਾਨੁ ਦੇਇ ਸਾਧੂ ਕੀ ਧੂਰਾ ॥੧॥",
      "transliteration": "daan dei saadhoo kee dhooraa ||1||",
      "translation": "He blesses us with the gift of the dust of the feet of the Saints. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਦੀਨ ਦਇਆਲਾ ॥",
      "transliteration": "kar kirapaa prabh deen daiaalaa ||",
      "translation": "Bless me with Your Grace, God, O Merciful to the meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੇਰੀ ਓਟ ਪੂਰਨ ਗੋਪਾਲਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "teree ot pooran gopaalaa ||1|| rahaau ||",
      "translation": "I seek Your Protection, O Perfect Lord, Sustainer of the World. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ ਰਹਿਆ ਭਰਪੂਰੇ ॥",
      "transliteration": "jal thal maheeal rahiaa bharapoore ||",
      "translation": "He is totally pervading and permeating the water, the land and the sky.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਿਕਟਿ ਵਸੈ ਨਾਹੀ ਪ੍ਰਭੁ ਦੂਰੇ ॥੨॥",
      "transliteration": "nikat vasai naahee prabh doore ||2||",
      "translation": "God is near at hand, not far away. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਸ ਨੋ ਨਦਰਿ ਕਰੇ ਸੋ ਧਿਆਏ ॥",
      "transliteration": "jis no nadar kare so dhiaae ||",
      "translation": "One whom He blesses with His Grace, meditates on Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਆਠ ਪਹਰ ਹਰਿ ਕੇ ਗੁਣ ਗਾਏ ॥੩॥",
      "transliteration": "aath pahar har ke gun gaae ||3||",
      "translation": "Twenty-four hours a day, he sings the Glorious Praises of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਸਗਲੇ ਪ੍ਰਤਿਪਾਰੇ ॥",
      "transliteration": "jee ja(n)t sagale pratipaare ||",
      "translation": "He cherishes and sustains all beings and creatures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਰਨਿ ਪਰਿਓ ਨਾਨਕ ਹਰਿ ਦੁਆਰੇ ॥੪॥੪॥",
      "transliteration": "saran pario naanak har duaare ||4||4||",
      "translation": "Nanak seeks the Sanctuary of the Lord's Door. ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਵਡਹੰਸੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "vadaha(n)s mahalaa 5 ||",
      "translation": "Wadahans, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤੂ ਵਡ ਦਾਤਾ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "too vad daataa a(n)tarajaamee ||",
      "translation": "You are the Great Giver, the Inner-knower, the Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਭ ਮਹਿ ਰਵਿਆ ਪੂਰਨ ਪ੍ਰਭ ਸੁਆਮੀ ॥੧॥",
      "transliteration": "sabh mahi raviaa pooran prabh suaamee ||1||",
      "translation": "God, the Perfect Lord and Master, is permeating and pervading in all. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮੇਰੇ ਪ੍ਰਭ ਪ੍ਰੀਤਮ ਨਾਮੁ ਅਧਾਰਾ ॥",
      "transliteration": "mere prabh preetam naam adhaaraa ||",
      "translation": "The Name of my Beloved God is my only support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਉ ਸੁਣਿ ਸੁਣਿ ਜੀਵਾ ਨਾਮੁ ਤੁਮਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "hau sun sun jeevaa naam tumaaraa ||1|| rahaau ||",
      "translation": "I live by hearing, continually hearing Your Name. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੇਰੀ ਸਰਣਿ ਸਤਿਗੁਰ ਮੇਰੇ ਪੂਰੇ ॥",
      "transliteration": "teree saran satigur mere poore ||",
      "translation": "I seek Your Sanctuary, O my Perfect True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਨੁ ਨਿਰਮਲੁ ਹੋਇ ਸੰਤਾ ਧੂਰੇ ॥੨॥",
      "transliteration": "man niramal hoi sa(n)taa dhoore ||2||",
      "translation": "My mind is purified by the dust of the Saints. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਹਿਰਦੈ ਉਰਿ ਧਾਰੇ ॥",
      "transliteration": "charan kamal hiradai ur dhaare ||",
      "translation": "I have enshrined His Lotus Feet within my heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੇਰੇ ਦਰਸਨ ਕਉ ਜਾਈ ਬਲਿਹਾਰੇ ॥੩॥",
      "transliteration": "tere darasan kau jaaee balihaare ||3||",
      "translation": "I am a sacrifice to the Blessed Vision of Your Darshan. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਤੇਰੇ ਗੁਣ ਗਾਵਾ ॥",
      "transliteration": "kar kirapaa tere gun gaavaa ||",
      "translation": "Show mercy unto me, that I may sing Your Glorious Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਜਪਤ ਸੁਖੁ ਪਾਵਾ ॥੪॥੫॥",
      "transliteration": "naanak naam japat sukh paavaa ||4||5||",
      "translation": "O Nanak, chanting the Naam, the Name of the Lord, I obtain peace. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਵਡਹੰਸੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "vadaha(n)s mahalaa 5 ||",
      "translation": "Wadahans, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਹਰਿ ਅੰਮ੍ਰਿਤੁ ਪੀਜੈ ॥",
      "transliteration": "saadhasa(n)g har a(n)mrit peejai ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, drink in the Ambrosial Nectar of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾ ਜੀਉ ਮਰੈ ਨ ਕਬਹੂ ਛੀਜੈ ॥੧॥",
      "transliteration": "naa jeeu marai na kabahoo chheejai ||1||",
      "translation": "The soul does not die, nor does it ever waste away. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਵਡਭਾਗੀ ਗੁਰੁ ਪੂਰਾ ਪਾਈਐ ॥",
      "transliteration": "vadabhaagee gur pooraa paaeeai ||",
      "translation": "By great good fortune, one meets the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਪ੍ਰਭੂ ਧਿਆਈਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur kirapaa te prabhoo dhiaaeeai ||1|| rahaau ||",
      "translation": "By Guru's Grace, one meditates on God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਤਨ ਜਵਾਹਰ ਹਰਿ ਮਾਣਕ ਲਾਲਾ ॥",
      "transliteration": "ratan javaahar har maanak laalaa ||",
      "translation": "The Lord is the jewel, the pearl, the gem, the diamond.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਪ੍ਰਭ ਭਏ ਨਿਹਾਲਾ ॥੨॥",
      "transliteration": "simar simar prabh bhae nihaalaa ||2||",
      "translation": "Meditating, meditating in remembrance on God, I am in ecstasy. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਤ ਕਤ ਪੇਖਉ ਸਾਧੂ ਸਰਣਾ ॥",
      "transliteration": "jat kat pekhau saadhoo saranaa ||",
      "translation": "Wherever I look, I see the Sanctuary of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਗਾਇ ਨਿਰਮਲ ਮਨੁ ਕਰਣਾ ॥੩॥",
      "transliteration": "har gun gaai niramal man karanaa ||3||",
      "translation": "Singing the Glorious Praises of the Lord, my soul becomes immaculately pure. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਘਟ ਘਟ ਅੰਤਰਿ ਮੇਰਾ ਸੁਆਮੀ ਵੂਠਾ ॥",
      "transliteration": "ghat ghat a(n)tar meraa suaamee voothaa ||",
      "translation": "Within each and every heart, dwells my Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਪਾਇਆ ਪ੍ਰਭੁ ਤੂਠਾ ॥੪॥੬॥",
      "transliteration": "naanak naam paaiaa prabh toothaa ||4||6||",
      "translation": "O Nanak, one obtains the Naam, the Name of the Lord, when God bestows His Mercy. ||4||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਵਡਹੰਸੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "vadaha(n)s mahalaa 5 ||",
      "translation": "Wadahans, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਵਿਸਰੁ ਨਾਹੀ ਪ੍ਰਭ ਦੀਨ ਦਇਆਲਾ ॥",
      "transliteration": "visar naahee prabh deen daiaalaa ||",
      "translation": "Do not forget me, O God, Merciful to the meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੇਰੀ ਸਰਣਿ ਪੂਰਨ ਕਿਰਪਾਲਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "teree saran pooran kirapaalaa ||1|| rahaau ||",
      "translation": "I seek Your Sanctuary, O Perfect, Compassionate Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਹ ਚਿਤਿ ਆਵਹਿ ਸੋ ਥਾਨੁ ਸੁਹਾਵਾ ॥",
      "transliteration": "jah chit aavahi so thaan suhaavaa ||",
      "translation": "Wherever You come to mind, that place is blessed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਿਤੁ ਵੇਲਾ ਵਿਸਰਹਿ ਤਾ ਲਾਗੈ ਹਾਵਾ ॥੧॥",
      "transliteration": "jit velaa visarahi taa laagai haavaa ||1||",
      "translation": "The moment I forget You, I am stricken with regret. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤੇਰੇ ਜੀਅ ਤੂ ਸਦ ਹੀ ਸਾਥੀ ॥",
      "transliteration": "tere jee too sad hee saathee ||",
      "translation": "All beings are Yours; You are their constant companion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੰਸਾਰ ਸਾਗਰ ਤੇ ਕਢੁ ਦੇ ਹਾਥੀ ॥੨॥",
      "transliteration": "sa(n)saar saagar te kadh de haathee ||2||",
      "translation": "Please, give me Your hand, and pull me up out of this world-ocean. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਆਵਣੁ ਜਾਣਾ ਤੁਮ ਹੀ ਕੀਆ ॥",
      "transliteration": "aavan jaanaa tum hee keeaa ||",
      "translation": "Coming and going are by Your Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਿਸੁ ਤੂ ਰਾਖਹਿ ਤਿਸੁ ਦੂਖੁ ਨ ਥੀਆ ॥੩॥",
      "transliteration": "jis too raakhahi tis dookh na theeaa ||3||",
      "translation": "One whom You save is not afflicted by suffering. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤੂ ਏਕੋ ਸਾਹਿਬੁ ਅਵਰੁ ਨ ਹੋਰਿ ॥",
      "transliteration": "too eko saahib avar na hor ||",
      "translation": "You are the One and only Lord and Master; there is no other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬਿਨਉ ਕਰੈ ਨਾਨਕੁ ਕਰ ਜੋਰਿ ॥੪॥੭॥",
      "transliteration": "binau karai naanak kar jor ||4||7||",
      "translation": "Nanak offers this prayer with his palms pressed together. ||4||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਵਡਹੰਸੁ ਮਃ ੫ ॥",
      "transliteration": "vadaha(n)s mah 5 ||",
      "translation": "Wadahans, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤੂ ਜਾਣਾਇਹਿ ਤਾ ਕੋਈ ਜਾਣੈ ॥",
      "transliteration": "too jaanaaihi taa koee jaanai ||",
      "translation": "When You allow Yourself to be known, then we know You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤੇਰਾ ਦੀਆ ਨਾਮੁ ਵਖਾਣੈ ॥੧॥",
      "transliteration": "teraa deeaa naam vakhaanai ||1||",
      "translation": "We chant Your Name, which You have given to us. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0563_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤੂ ਅਚਰਜੁ ਕੁਦਰਤਿ ਤੇਰੀ ਬਿਸਮਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "too acharaj kudarat teree bisamaa ||1|| rahaau ||",
      "translation": "You are wonderful! Your creative potency is amazing! ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 563,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
