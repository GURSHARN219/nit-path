{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 621,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0621_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਟਲ ਬਚਨੁ ਨਾਨਕ ਗੁਰ ਤੇਰਾ ਸਫਲ ਕਰੁ ਮਸਤਕਿ ਧਾਰਿਆ ॥੨॥੨੧॥੪੯॥",
      "transliteration": "atal bachan naanak gur teraa saphal kar masatak dhaariaa ||2||21||49||",
      "translation": "Your Word is eternal, O Guru Nanak; You placed Your Hand of blessing upon my forehead. ||2||21||49||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੀਅ ਜੰਤ੍ਰ ਸਭਿ ਤਿਸ ਕੇ ਕੀਏ ਸੋਈ ਸੰਤ ਸਹਾਈ ॥",
      "transliteration": "jee ja(n)tr sabh tis ke keee soee sa(n)t sahaaee ||",
      "translation": "All beings and creatures were created by Him; He alone is the support and friend of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਪੁਨੇ ਸੇਵਕ ਕੀ ਆਪੇ ਰਾਖੈ ਪੂਰਨ ਭਈ ਬਡਾਈ ॥੧॥",
      "transliteration": "apune sevak kee aape raakhai pooran bhaee badaaee ||1||",
      "translation": "He Himself preserves the honor of His servants; their glorious greatness becomes perfect. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਪੂਰਾ ਮੇਰੈ ਨਾਲਿ ॥",
      "transliteration": "paarabraham pooraa merai naal ||",
      "translation": "The Perfect Supreme Lord God is always with me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਪੂਰੀ ਸਭ ਰਾਖੀ ਹੋਏ ਸਰਬ ਦਇਆਲ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur poorai pooree sabh raakhee hoe sarab daiaal ||1|| rahaau ||",
      "translation": "The Perfect Guru has perfectly and totally protected me, and now everyone is kind and compassionate to me. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਨਦਿਨੁ ਨਾਨਕੁ ਨਾਮੁ ਧਿਆਏ ਜੀਅ ਪ੍ਰਾਨ ਕਾ ਦਾਤਾ ॥",
      "transliteration": "anadin naanak naam dhiaae jee praan kaa daataa ||",
      "translation": "Night and day, Nanak meditates on the Naam, the Name of the Lord; He is the Giver of the soul, and the breath of life itself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਪੁਨੇ ਦਾਸ ਕਉ ਕੰਠਿ ਲਾਇ ਰਾਖੈ ਜਿਉ ਬਾਰਿਕ ਪਿਤ ਮਾਤਾ ॥੨॥੨੨॥੫੦॥",
      "transliteration": "apune daas kau ka(n)th laai raakhai jiu baarik pit maataa ||2||22||50||",
      "translation": "He hugs His slave close in His loving embrace, like the mother and father hug their child. ||2||22||50||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ਘਰੁ ੩ ਚਉਪਦੇ ॥",
      "transliteration": "sorath mahalaa 5 ghar 3 chaupade ||",
      "translation": "Sorat'h, Fifth Mehl, Third House, Chau-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਿਲਿ ਪੰਚਹੁ ਨਹੀ ਸਹਸਾ ਚੁਕਾਇਆ ॥",
      "transliteration": "mil pa(n)chahu nahee sahasaa chukaaiaa ||",
      "translation": "Meeting with the council, my doubts were not dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਿਕਦਾਰਹੁ ਨਹ ਪਤੀਆਇਆ ॥",
      "transliteration": "sikadaarahu nah pateeaaiaa ||",
      "translation": "The chiefs did not give me satisfaction.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਉਮਰਾਵਹੁ ਆਗੈ ਝੇਰਾ ॥",
      "transliteration": "umaraavahu aagai jheraa ||",
      "translation": "I presented my dispute to the noblemen as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਿਲਿ ਰਾਜਨ ਰਾਮ ਨਿਬੇਰਾ ॥੧॥",
      "transliteration": "mil raajan raam niberaa ||1||",
      "translation": "But it was only settled by meeting with the King, my Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਬ ਢੂਢਨ ਕਤਹੁ ਨ ਜਾਈ ॥",
      "transliteration": "ab dhoodhan katahu na jaaee ||",
      "translation": "Now, I do not go searching anywhere else,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੋਬਿਦ ਭੇਟੇ ਗੁਰ ਗੋਸਾਈ ॥ ਰਹਾਉ ॥",
      "transliteration": "gobid bhete gur gosaaee || rahaau ||",
      "translation": "because I have met the Guru, the Lord of the Universe. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਇਆ ਪ੍ਰਭ ਦਰਬਾਰਾ ॥",
      "transliteration": "aaiaa prabh darabaaraa ||",
      "translation": "When I came to God's Darbaar, His Holy Court,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਸਗਲੀ ਮਿਟੀ ਪੂਕਾਰਾ ॥",
      "transliteration": "taa sagalee mitee pookaaraa ||",
      "translation": "then all of my cries and complaints were settled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਲਬਧਿ ਆਪਣੀ ਪਾਈ ॥",
      "transliteration": "labadh aapanee paaee ||",
      "translation": "Now that I have attained what I had sought,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਕਤ ਆਵੈ ਕਤ ਜਾਈ ॥੨॥",
      "transliteration": "taa kat aavai kat jaaee ||2||",
      "translation": "where should I come and where should I go? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਹ ਸਾਚ ਨਿਆਇ ਨਿਬੇਰਾ ॥",
      "transliteration": "tah saach niaai niberaa ||",
      "translation": "There, true justice is administered.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਊਹਾ ਸਮ ਠਾਕੁਰੁ ਸਮ ਚੇਰਾ ॥",
      "transliteration": "oohaa sam thaakur sam cheraa ||",
      "translation": "There, the Lord Master and His disciple are one and the same.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅੰਤਰਜਾਮੀ ਜਾਨੈ ॥",
      "transliteration": "a(n)tarajaamee jaanai ||",
      "translation": "The Inner-knower, the Searcher of hearts, knows.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਿਨੁ ਬੋਲਤ ਆਪਿ ਪਛਾਨੈ ॥੩॥",
      "transliteration": "bin bolat aap pachhaanai ||3||",
      "translation": "Without our speaking, He understands. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਰਬ ਥਾਨ ਕੋ ਰਾਜਾ ॥",
      "transliteration": "sarab thaan ko raajaa ||",
      "translation": "He is the King of all places.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਹ ਅਨਹਦ ਸਬਦ ਅਗਾਜਾ ॥",
      "transliteration": "tah anahad sabad agaajaa ||",
      "translation": "There, the unstruck melody of the Shabad resounds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਿਸੁ ਪਹਿ ਕਿਆ ਚਤੁਰਾਈ ॥",
      "transliteration": "tis pahi kiaa chaturaaee ||",
      "translation": "Of what use is cleverness when dealing with Him?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਿਲੁ ਨਾਨਕ ਆਪੁ ਗਵਾਈ ॥੪॥੧॥੫੧॥",
      "transliteration": "mil naanak aap gavaaee ||4||1||51||",
      "translation": "Meeting with Him, O Nanak, one loses his self-conceit. ||4||1||51||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਿਰਦੈ ਨਾਮੁ ਵਸਾਇਹੁ ॥",
      "transliteration": "hiradai naam vasaaihu ||",
      "translation": "Enshrine the Naam, the Name of the Lord, within your heart;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਘਰਿ ਬੈਠੇ ਗੁਰੂ ਧਿਆਇਹੁ ॥",
      "transliteration": "ghar baithe guroo dhiaaihu ||",
      "translation": "sitting within your own home, meditate on the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਸਚੁ ਕਹਿਆ ॥",
      "transliteration": "gur poorai sach kahiaa ||",
      "translation": "The Perfect Guru has spoken the Truth;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੋ ਸੁਖੁ ਸਾਚਾ ਲਹਿਆ ॥੧॥",
      "transliteration": "so sukh saachaa lahiaa ||1||",
      "translation": "the True Peace is obtained only from the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਪੁਨਾ ਹੋਇਓ ਗੁਰੁ ਮਿਹਰਵਾਨਾ ॥",
      "transliteration": "apunaa hoio gur miharavaanaa ||",
      "translation": "My Guru has become merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਨਦ ਸੂਖ ਕਲਿਆਣ ਮੰਗਲ ਸਿਉ ਘਰਿ ਆਏ ਕਰਿ ਇਸਨਾਨਾ ॥ ਰਹਾਉ ॥",
      "transliteration": "anad sookh kaliaan ma(n)gal siu ghar aae kar isanaanaa || rahaau ||",
      "translation": "In bliss, peace, pleasure and joy, I have returned to my own home, after my purifying bath. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਾਚੀ ਗੁਰ ਵਡਿਆਈ ॥",
      "transliteration": "saachee gur vadiaaee ||",
      "translation": "True is the glorious greatness of the Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਾ ਕੀ ਕੀਮਤਿ ਕਹਣੁ ਨ ਜਾਈ ॥",
      "transliteration": "taa kee keemat kahan na jaaee ||",
      "translation": "His worth cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਿਰਿ ਸਾਹਾ ਪਾਤਿਸਾਹਾ ॥",
      "transliteration": "sir saahaa paatisaahaa ||",
      "translation": "He is the Supreme Overlord of kings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰ ਭੇਟਤ ਮਨਿ ਓਮਾਹਾ ॥੨॥",
      "transliteration": "gur bhetat man omaahaa ||2||",
      "translation": "Meeting with the Guru, the mind is enraptured. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਗਲ ਪਰਾਛਤ ਲਾਥੇ ॥",
      "transliteration": "sagal paraachhat laathe ||",
      "translation": "All sins are washed away,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਿਲਿ ਸਾਧਸੰਗਤਿ ਕੈ ਸਾਥੇ ॥",
      "transliteration": "mil saadhasa(n)gat kai saathe ||",
      "translation": "meeting with the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਣ ਨਿਧਾਨ ਹਰਿ ਨਾਮਾ ॥",
      "transliteration": "gun nidhaan har naamaa ||",
      "translation": "The Lord's Name is the treasure of excellence;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਪਿ ਪੂਰਨ ਹੋਏ ਕਾਮਾ ॥੩॥",
      "transliteration": "jap pooran hoe kaamaa ||3||",
      "translation": "chanting it, one's affairs are perfectly resolved. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰਿ ਕੀਨੋ ਮੁਕਤਿ ਦੁਆਰਾ ॥",
      "transliteration": "gur keeno mukat duaaraa ||",
      "translation": "The Guru has opened the door of liberation,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਭ ਸ੍ਰਿਸਟਿ ਕਰੈ ਜੈਕਾਰਾ ॥",
      "transliteration": "sabh srisat karai jaikaaraa ||",
      "translation": "and the entire world applauds Him with cheers of victory.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕ ਪ੍ਰਭੁ ਮੇਰੈ ਸਾਥੇ ॥",
      "transliteration": "naanak prabh merai saathe ||",
      "translation": "O Nanak, God is always with me;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਨਮ ਮਰਣ ਭੈ ਲਾਥੇ ॥੪॥੨॥੫੨॥",
      "transliteration": "janam maran bhai laathe ||4||2||52||",
      "translation": "my fears of birth and death are gone. ||4||2||52||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਕਿਰਪਾ ਧਾਰੀ ॥",
      "transliteration": "gur poorai kirapaa dhaaree ||",
      "translation": "The Perfect Guru has granted His Grace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪ੍ਰਭਿ ਪੂਰੀ ਲੋਚ ਹਮਾਰੀ ॥",
      "transliteration": "prabh pooree loch hamaaree ||",
      "translation": "and God has fulfilled my desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਰਿ ਇਸਨਾਨੁ ਗ੍ਰਿਹਿ ਆਏ ॥",
      "transliteration": "kar isanaan grihi aae ||",
      "translation": "After taking my bath of purification, I returned to my home,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਨਦ ਮੰਗਲ ਸੁਖ ਪਾਏ ॥੧॥",
      "transliteration": "anad ma(n)gal sukh paae ||1||",
      "translation": "and I found bliss, happiness and peace. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੰਤਹੁ ਰਾਮ ਨਾਮਿ ਨਿਸਤਰੀਐ ॥",
      "transliteration": "sa(n)tahu raam naam nisatareeai ||",
      "translation": "O Saints, salvation comes from the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0621_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਊਠਤ ਬੈਠਤ ਹਰਿ ਹਰਿ ਧਿਆਈਐ ਅਨਦਿਨੁ ਸੁਕ੍ਰਿਤੁ ਕਰੀਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "oothat baithat har har dhiaaeeai anadin sukrit kareeai ||1|| rahaau ||",
      "translation": "While standing up and sitting down, meditate on the Lord's Name. Night and day, do good deeds. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 621,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
