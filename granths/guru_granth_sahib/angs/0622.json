{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 622,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0622_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੰਤ ਕਾ ਮਾਰਗੁ ਧਰਮ ਕੀ ਪਉੜੀ ਕੋ ਵਡਭਾਗੀ ਪਾਏ ॥",
      "transliteration": "sa(n)t kaa maarag dharam kee pauRee ko vadabhaagee paae ||",
      "translation": "The way of the Saints is the ladder of righteous living, found only by great good fortune.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੋਟਿ ਜਨਮ ਕੇ ਕਿਲਬਿਖ ਨਾਸੇ ਹਰਿ ਚਰਣੀ ਚਿਤੁ ਲਾਏ ॥੨॥",
      "transliteration": "kot janam ke kilabikh naase har charanee chit laae ||2||",
      "translation": "The sins of millions of incarnations are washed away, by focusing your consciousness on the Lord's feet. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਉਸਤਤਿ ਕਰਹੁ ਸਦਾ ਪ੍ਰਭ ਅਪਨੇ ਜਿਨਿ ਪੂਰੀ ਕਲ ਰਾਖੀ ॥",
      "transliteration": "usatat karahu sadaa prabh apane jin pooree kal raakhee ||",
      "translation": "So sing the Praises of your God forever; His almighty power is perfect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਸਭਿ ਭਏ ਪਵਿਤ੍ਰਾ ਸਤਿਗੁਰ ਕੀ ਸਚੁ ਸਾਖੀ ॥੩॥",
      "transliteration": "jee ja(n)t sabh bhae pavitraa satigur kee sach saakhee ||3||",
      "translation": "All beings and creatures are purified, listening to the True Teachings of the True Guru. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਿਘਨ ਬਿਨਾਸਨ ਸਭਿ ਦੁਖ ਨਾਸਨ ਸਤਿਗੁਰਿ ਨਾਮੁ ਦ੍ਰਿੜਾਇਆ ॥",
      "transliteration": "bighan binaasan sabh dukh naasan satigur naam driRaaiaa ||",
      "translation": "The True Guru has implanted the Naam, the Name of the Lord, within me; it is the Eliminator of obstructions, the Destroyer of all pains.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਖੋਏ ਪਾਪ ਭਏ ਸਭਿ ਪਾਵਨ ਜਨ ਨਾਨਕ ਸੁਖਿ ਘਰਿ ਆਇਆ ॥੪॥੩॥੫੩॥",
      "transliteration": "khoe paap bhae sabh paavan jan naanak sukh ghar aaiaa ||4||3||53||",
      "translation": "All of my sins were erased, and I have been purified; servant Nanak has returned to his home of peace. ||4||3||53||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਾਹਿਬੁ ਗੁਨੀ ਗਹੇਰਾ ॥",
      "transliteration": "saahib gunee gaheraa ||",
      "translation": "O Lord Master, You are the ocean of excellence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਘਰੁ ਲਸਕਰੁ ਸਭੁ ਤੇਰਾ ॥",
      "transliteration": "ghar lasakar sabh teraa ||",
      "translation": "My home and all my possessions are Yours.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਖਵਾਲੇ ਗੁਰ ਗੋਪਾਲਾ ॥",
      "transliteration": "rakhavaale gur gopaalaa ||",
      "translation": "The Guru, the Lord of the world, is my Savior.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਭਿ ਜੀਅ ਭਏ ਦਇਆਲਾ ॥੧॥",
      "transliteration": "sabh jee bhae daiaalaa ||1||",
      "translation": "All beings have become kind and compassionate to me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਪਿ ਅਨਦਿ ਰਹਉ ਗੁਰ ਚਰਣਾ ॥",
      "transliteration": "jap anad rahau gur charanaa ||",
      "translation": "Meditating on the Guru's feet, I am in bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਉ ਕਤਹਿ ਨਹੀ ਪ੍ਰਭ ਸਰਣਾ ॥ ਰਹਾਉ ॥",
      "transliteration": "bhau katahi nahee prabh saranaa || rahaau ||",
      "translation": "There is no fear at all, in God's Sanctuary. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤੇਰਿਆ ਦਾਸਾ ਰਿਦੈ ਮੁਰਾਰੀ ॥",
      "transliteration": "teriaa daasaa ridai muraaree ||",
      "translation": "You dwell in the hearts of Your slaves, Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪ੍ਰਭਿ ਅਬਿਚਲ ਨੀਵ ਉਸਾਰੀ ॥",
      "transliteration": "prabh abichal neev usaaree ||",
      "translation": "God has laid the eternal foundation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਲੁ ਧਨੁ ਤਕੀਆ ਤੇਰਾ ॥",
      "transliteration": "bal dhan takeeaa teraa ||",
      "translation": "You are my strength, wealth and support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤੂ ਭਾਰੋ ਠਾਕੁਰੁ ਮੇਰਾ ॥੨॥",
      "transliteration": "too bhaaro thaakur meraa ||2||",
      "translation": "You are my Almighty Lord and Master. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਨਿ ਜਿਨਿ ਸਾਧਸੰਗੁ ਪਾਇਆ ॥",
      "transliteration": "jin jin saadhasa(n)g paaiaa ||",
      "translation": "Whoever finds the Saadh Sangat, the Company of the Holy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋ ਪ੍ਰਭਿ ਆਪਿ ਤਰਾਇਆ ॥",
      "transliteration": "so prabh aap taraaiaa ||",
      "translation": "is saved by God Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਨਾਮ ਰਸੁ ਦੀਆ ॥",
      "transliteration": "kar kirapaa naam ras deeaa ||",
      "translation": "By His Grace, He has blessed me with the sublime essence of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕੁਸਲ ਖੇਮ ਸਭ ਥੀਆ ॥੩॥",
      "transliteration": "kusal khem sabh theeaa ||3||",
      "translation": "All joy and pleasure then came to me. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹੋਏ ਪ੍ਰਭੂ ਸਹਾਈ ॥",
      "transliteration": "hoe prabhoo sahaaee ||",
      "translation": "God became my helper and my best friend;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਭ ਉਠਿ ਲਾਗੀ ਪਾਈ ॥",
      "transliteration": "sabh uth laagee paaee ||",
      "translation": "everyone rises up and bows down at my feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਾਸਿ ਸਾਸਿ ਪ੍ਰਭੁ ਧਿਆਈਐ ॥",
      "transliteration": "saas saas prabh dhiaaeeai ||",
      "translation": "With each and every breath, meditate on God;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਰਿ ਮੰਗਲੁ ਨਾਨਕ ਗਾਈਐ ॥੪॥੪॥੫੪॥",
      "transliteration": "har ma(n)gal naanak gaaeeai ||4||4||54||",
      "translation": "O Nanak, sing the songs of joy to the Lord. ||4||4||54||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਆਨੰਦਾ ॥",
      "transliteration": "sookh sahaj aana(n)daa ||",
      "translation": "Celestial peace and bliss have come,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪ੍ਰਭੁ ਮਿਲਿਓ ਮਨਿ ਭਾਵੰਦਾ ॥",
      "transliteration": "prabh milio man bhaava(n)daa ||",
      "translation": "meeting God, who is so pleasing to my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪੂਰੈ ਗੁਰਿ ਕਿਰਪਾ ਧਾਰੀ ॥",
      "transliteration": "poorai gur kirapaa dhaaree ||",
      "translation": "The Perfect Guru showered me with His Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਾ ਗਤਿ ਭਈ ਹਮਾਰੀ ॥੧॥",
      "transliteration": "taa gat bhaee hamaaree ||1||",
      "translation": "and I attained salvation. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਰਿ ਕੀ ਪ੍ਰੇਮ ਭਗਤਿ ਮਨੁ ਲੀਨਾ ॥",
      "transliteration": "har kee prem bhagat man leenaa ||",
      "translation": "My mind is absorbed in loving devotional worship of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਿਤ ਬਾਜੇ ਅਨਹਤ ਬੀਨਾ ॥ ਰਹਾਉ ॥",
      "transliteration": "nit baaje anahat beenaa || rahaau ||",
      "translation": "and the unstruck melody of the celestial sound current ever resounds within me. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰਿ ਚਰਣ ਕੀ ਓਟ ਸਤਾਣੀ ॥",
      "transliteration": "har charan kee ot sataanee ||",
      "translation": "The Lord's feet are my all-powerful shelter and support;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਭ ਚੂਕੀ ਕਾਣਿ ਲੋਕਾਣੀ ॥",
      "transliteration": "sabh chookee kaan lokaanee ||",
      "translation": "my dependence on other people is totally finished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਗਜੀਵਨੁ ਦਾਤਾ ਪਾਇਆ ॥",
      "transliteration": "jagajeevan daataa paaiaa ||",
      "translation": "I have found the Life of the world, the Great Giver;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਰਿ ਰਸਕਿ ਰਸਕਿ ਗੁਣ ਗਾਇਆ ॥੨॥",
      "transliteration": "har rasak rasak gun gaaiaa ||2||",
      "translation": "in joyful rapture, I sing the Glorious Praises of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪ੍ਰਭ ਕਾਟਿਆ ਜਮ ਕਾ ਫਾਸਾ ॥",
      "transliteration": "prabh kaatiaa jam kaa phaasaa ||",
      "translation": "God has cut away the noose of death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨ ਪੂਰਨ ਹੋਈ ਆਸਾ ॥",
      "transliteration": "man pooran hoee aasaa ||",
      "translation": "My mind's desires have been fulfilled;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਹ ਪੇਖਾ ਤਹ ਸੋਈ ॥",
      "transliteration": "jah pekhaa tah soee ||",
      "translation": "wherever I look, He is there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਰਿ ਪ੍ਰਭ ਬਿਨੁ ਅਵਰੁ ਨ ਕੋਈ ॥੩॥",
      "transliteration": "har prabh bin avar na koee ||3||",
      "translation": "Without the Lord God, there is no other at all. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭਿ ਰਾਖੇ ॥",
      "transliteration": "kar kirapaa prabh raakhe ||",
      "translation": "In His Mercy, God has protected and preserved me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਭਿ ਜਨਮ ਜਨਮ ਦੁਖ ਲਾਥੇ ॥",
      "transliteration": "sabh janam janam dukh laathe ||",
      "translation": "I am rid of all the pains of countless incarnations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਿਰਭਉ ਨਾਮੁ ਧਿਆਇਆ ॥",
      "transliteration": "nirabhau naam dhiaaiaa ||",
      "translation": "I have meditated on the Naam, the Name of the Fearless Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਟਲ ਸੁਖੁ ਨਾਨਕ ਪਾਇਆ ॥੪॥੫॥੫੫॥",
      "transliteration": "atal sukh naanak paaiaa ||4||5||55||",
      "translation": "O Nanak, I have found eternal peace. ||4||5||55||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਠਾਢਿ ਪਾਈ ਕਰਤਾਰੇ ॥",
      "transliteration": "thaadh paaee karataare ||",
      "translation": "The Creator has brought utter peace to my home;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਾਪੁ ਛੋਡਿ ਗਇਆ ਪਰਵਾਰੇ ॥",
      "transliteration": "taap chhod gaiaa paravaare ||",
      "translation": "the fever has left my family.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਹੈ ਰਾਖੀ ॥",
      "transliteration": "gur poorai hai raakhee ||",
      "translation": "The Perfect Guru has saved us.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਰਣਿ ਸਚੇ ਕੀ ਤਾਕੀ ॥੧॥",
      "transliteration": "saran sache kee taakee ||1||",
      "translation": "I sought the Sanctuary of the True Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪਰਮੇਸਰੁ ਆਪਿ ਹੋਆ ਰਖਵਾਲਾ ॥",
      "transliteration": "paramesar aap hoaa rakhavaalaa ||",
      "translation": "The Transcendent Lord Himself has become my Protector.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਾਂਤਿ ਸਹਜ ਸੁਖ ਖਿਨ ਮਹਿ ਉਪਜੇ ਮਨੁ ਹੋਆ ਸਦਾ ਸੁਖਾਲਾ ॥ ਰਹਾਉ ॥",
      "transliteration": "saa(n)t sahaj sukh khin mahi upaje man hoaa sadaa sukhaalaa || rahaau ||",
      "translation": "Tranquility, intuitive peace and poise welled up in an instant, and my mind was comforted forever. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਦੀਓ ਦਾਰੂ ॥",
      "transliteration": "har har naam deeo daaroo ||",
      "translation": "The Lord, Har, Har, gave me the medicine of His Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਿਨਿ ਸਗਲਾ ਰੋਗੁ ਬਿਦਾਰੂ ॥",
      "transliteration": "tin sagalaa rog bidaaroo ||",
      "translation": "which has cured all disease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਅਪਣੀ ਕਿਰਪਾ ਧਾਰੀ ॥",
      "transliteration": "apanee kirapaa dhaaree ||",
      "translation": "He extended His Mercy to me,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤਿਨਿ ਸਗਲੀ ਬਾਤ ਸਵਾਰੀ ॥੨॥",
      "transliteration": "tin sagalee baat savaaree ||2||",
      "translation": "and resolved all these affairs. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਪ੍ਰਭਿ ਅਪਨਾ ਬਿਰਦੁ ਸਮਾਰਿਆ ॥",
      "transliteration": "prabh apanaa birad samaariaa ||",
      "translation": "God confirmed His loving nature;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਹਮਰਾ ਗੁਣੁ ਅਵਗੁਣੁ ਨ ਬੀਚਾਰਿਆ ॥",
      "transliteration": "hamaraa gun avagun na beechaariaa ||",
      "translation": "He did not take my merits or demerits into account.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0622_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਭਇਓ ਸਾਖੀ ॥",
      "transliteration": "gur kaa sabad bhaio saakhee ||",
      "translation": "The Word of the Guru's Shabad has become manifest,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 622,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
