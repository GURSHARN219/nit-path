{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 623,
  "lineCount": 62,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0623_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਿਨਿ ਸਗਲੀ ਲਾਜ ਰਾਖੀ ॥੩॥",
      "transliteration": "tin sagalee laaj raakhee ||3||",
      "translation": "and through it, my honor was totally preserved. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬੋਲਾਇਆ ਬੋਲੀ ਤੇਰਾ ॥",
      "transliteration": "bolaaiaa bolee teraa ||",
      "translation": "I speak as You cause me to speak;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤੂ ਸਾਹਿਬੁ ਗੁਣੀ ਗਹੇਰਾ ॥",
      "transliteration": "too saahib gunee gaheraa ||",
      "translation": "O Lord and Master, You are the ocean of excellence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਪਿ ਨਾਨਕ ਨਾਮੁ ਸਚੁ ਸਾਖੀ ॥",
      "transliteration": "jap naanak naam sach saakhee ||",
      "translation": "Nanak chants the Naam, the Name of the Lord, according to the Teachings of Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਪੁਨੇ ਦਾਸ ਕੀ ਪੈਜ ਰਾਖੀ ॥੪॥੬॥੫੬॥",
      "transliteration": "apune daas kee paij raakhee ||4||6||56||",
      "translation": "God preserves the honor of His slaves. ||4||6||56||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਵਿਚਿ ਕਰਤਾ ਪੁਰਖੁ ਖਲੋਆ ॥",
      "transliteration": "vich karataa purakh khaloaa ||",
      "translation": "The Creator Lord Himself stood between us,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਵਾਲੁ ਨ ਵਿੰਗਾ ਹੋਆ ॥",
      "transliteration": "vaal na vi(n)gaa hoaa ||",
      "translation": "and not a hair upon my head was touched.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਜਨੁ ਗੁਰ ਆਂਦਾ ਰਾਸੇ ॥",
      "transliteration": "majan gur aa(n)daa raase ||",
      "translation": "The Guru made my cleansing bath successful;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਪਿ ਹਰਿ ਹਰਿ ਕਿਲਵਿਖ ਨਾਸੇ ॥੧॥",
      "transliteration": "jap har har kilavikh naase ||1||",
      "translation": "meditating on the Lord, Har, Har, my sins were erased. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੰਤਹੁ ਰਾਮਦਾਸ ਸਰੋਵਰੁ ਨੀਕਾ ॥",
      "transliteration": "sa(n)tahu raamadaas sarovar neekaa ||",
      "translation": "O Saints, the purifying pool of Ram Das is sublime.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੋ ਨਾਵੈ ਸੋ ਕੁਲੁ ਤਰਾਵੈ ਉਧਾਰੁ ਹੋਆ ਹੈ ਜੀ ਕਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jo naavai so kul taraavai udhaar hoaa hai jee kaa ||1|| rahaau ||",
      "translation": "Whoever bathes in it, his family and ancestry are saved, and his soul is saved as well. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੈ ਜੈ ਕਾਰੁ ਜਗੁ ਗਾਵੈ ॥",
      "transliteration": "jai jai kaar jag gaavai ||",
      "translation": "The world sings cheers of victory,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਨ ਚਿੰਦਿਅੜੇ ਫਲ ਪਾਵੈ ॥",
      "transliteration": "man chi(n)diaRe phal paavai ||",
      "translation": "and the fruits of his mind's desires are obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਹੀ ਸਲਾਮਤਿ ਨਾਇ ਆਏ ॥",
      "transliteration": "sahee salaamat naai aae ||",
      "translation": "Whoever comes and bathes here,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਪਣਾ ਪ੍ਰਭੂ ਧਿਆਏ ॥੨॥",
      "transliteration": "apanaa prabhoo dhiaae ||2||",
      "translation": "And meditates on his God, is safe and sound. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੰਤ ਸਰੋਵਰ ਨਾਵੈ ॥",
      "transliteration": "sa(n)t sarovar naavai ||",
      "translation": "One who bathes in the healing pool of the Saints,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੋ ਜਨੁ ਪਰਮ ਗਤਿ ਪਾਵੈ ॥",
      "transliteration": "so jan param gat paavai ||",
      "translation": "that humble being obtains the supreme status.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਰੈ ਨ ਆਵੈ ਜਾਈ ॥",
      "transliteration": "marai na aavai jaaee ||",
      "translation": "He does not die, or come and go in reincarnation;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਧਿਆਈ ॥੩॥",
      "transliteration": "har har naam dhiaaee ||3||",
      "translation": "he meditates on the Name of the Lord, Har, Har. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਹੁ ਬ੍ਰਹਮ ਬਿਚਾਰੁ ਸੁ ਜਾਨੈ ॥",
      "transliteration": "ihu braham bichaar s jaanai ||",
      "translation": "He alone knows this about God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਸੁ ਦਇਆਲੁ ਹੋਇ ਭਗਵਾਨੈ ॥",
      "transliteration": "jis daiaal hoi bhagavaanai ||",
      "translation": "whom God blesses with His kindness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਾਬਾ ਨਾਨਕ ਪ੍ਰਭ ਸਰਣਾਈ ॥",
      "transliteration": "baabaa naanak prabh saranaaee ||",
      "translation": "Baba Nanak seeks the Sanctuary of God;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਭ ਚਿੰਤਾ ਗਣਤ ਮਿਟਾਈ ॥੪॥੭॥੫੭॥",
      "transliteration": "sabh chi(n)taa ganat mitaaee ||4||7||57||",
      "translation": "all his worries and anxieties are dispelled. ||4||7||57||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮਿ ਨਿਬਾਹੀ ਪੂਰੀ ॥",
      "transliteration": "paarabraham nibaahee pooree ||",
      "translation": "The Supreme Lord God has stood by me and fulfilled me,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਾਈ ਬਾਤ ਨ ਰਹੀਆ ਊਰੀ ॥",
      "transliteration": "kaaee baat na raheeaa ooree ||",
      "translation": "and nothing is left unfinished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੁਰਿ ਚਰਨ ਲਾਇ ਨਿਸਤਾਰੇ ॥",
      "transliteration": "gur charan laai nisataare ||",
      "translation": "Attached to the Guru's feet, I am saved;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਸਮੑਾਰੇ ॥੧॥",
      "transliteration": "har har naam samhaare ||1||",
      "translation": "I contemplate and cherish the Name of the Lord, Har, Har. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਪਨੇ ਦਾਸ ਕਾ ਸਦਾ ਰਖਵਾਲਾ ॥",
      "transliteration": "apane daas kaa sadaa rakhavaalaa ||",
      "translation": "He is forever the Savior of His slaves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਅਪੁਨੇ ਕਰਿ ਰਾਖੇ ਮਾਤ ਪਿਤਾ ਜਿਉ ਪਾਲਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa apune kar raakhe maat pitaa jiu paalaa ||1|| rahaau ||",
      "translation": "Bestowing His Mercy, He made me His own and preserved me; like a mother or father, He cherishes me. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਵਡਭਾਗੀ ਸਤਿਗੁਰੁ ਪਾਇਆ ॥",
      "transliteration": "vadabhaagee satigur paaiaa ||",
      "translation": "By great good fortune, I found the True Guru,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਨਿ ਜਮ ਕਾ ਪੰਥੁ ਮਿਟਾਇਆ ॥",
      "transliteration": "jin jam kaa pa(n)th mitaaiaa ||",
      "translation": "who obliterated the path of the Messenger of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਰਿ ਭਗਤਿ ਭਾਇ ਚਿਤੁ ਲਾਗਾ ॥",
      "transliteration": "har bhagat bhaai chit laagaa ||",
      "translation": "My consciousness is focused on loving, devotional worship of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਪਿ ਜੀਵਹਿ ਸੇ ਵਡਭਾਗਾ ॥੨॥",
      "transliteration": "jap jeevahi se vadabhaagaa ||2||",
      "translation": "One who lives in this meditation is very fortunate indeed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਰਿ ਅੰਮ੍ਰਿਤ ਬਾਣੀ ਗਾਵੈ ॥",
      "transliteration": "har a(n)mrit baanee gaavai ||",
      "translation": "He sings the Ambrosial Word of the Guru's Bani,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਾਧਾ ਕੀ ਧੂਰੀ ਨਾਵੈ ॥",
      "transliteration": "saadhaa kee dhooree naavai ||",
      "translation": "and bathes in the dust of the feet of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਪੁਨਾ ਨਾਮੁ ਆਪੇ ਦੀਆ ॥",
      "transliteration": "apunaa naam aape deeaa ||",
      "translation": "He Himself bestows His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪ੍ਰਭ ਕਰਣਹਾਰ ਰਖਿ ਲੀਆ ॥੩॥",
      "transliteration": "prabh karanahaar rakh leeaa ||3||",
      "translation": "God, the Creator, saves us. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਰਿ ਦਰਸਨ ਪ੍ਰਾਨ ਅਧਾਰਾ ॥",
      "transliteration": "har darasan praan adhaaraa ||",
      "translation": "The Blessed Vision of the Lord's Darshan is the support of the breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਹੁ ਪੂਰਨ ਬਿਮਲ ਬੀਚਾਰਾ ॥",
      "transliteration": "ihu pooran bimal beechaaraa ||",
      "translation": "This is the perfect, pure wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "kar kirapaa a(n)tarajaamee ||",
      "translation": "The Inner-knower, the Searcher of hearts, has granted His Mercy;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦਾਸ ਨਾਨਕ ਸਰਣਿ ਸੁਆਮੀ ॥੪॥੮॥੫੮॥",
      "transliteration": "daas naanak saran suaamee ||4||8||58||",
      "translation": "slave Nanak seeks the Sanctuary of his Lord and Master. ||4||8||58||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਚਰਨੀ ਲਾਇਆ ॥",
      "transliteration": "gur poorai charanee laaiaa ||",
      "translation": "The Perfect Guru has attached me to His feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਸਹਾਈ ਪਾਇਆ ॥",
      "transliteration": "har sa(n)g sahaaee paaiaa ||",
      "translation": "I have obtained the Lord as my companion, my support, my best friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਹ ਜਾਈਐ ਤਹਾ ਸੁਹੇਲੇ ॥",
      "transliteration": "jah jaaeeai tahaa suhele ||",
      "translation": "Wherever I go, I am happy there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭਿ ਮੇਲੇ ॥੧॥",
      "transliteration": "kar kirapaa prabh mele ||1||",
      "translation": "By His Kind Mercy, God united me with Himself. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਗਾਵਹੁ ਸਦਾ ਸੁਭਾਈ ॥",
      "transliteration": "har gun gaavahu sadaa subhaaee ||",
      "translation": "So sing forever the Glorious Praises of the Lord with loving devotion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਮਨ ਚਿੰਦੇ ਸਗਲੇ ਫਲ ਪਾਵਹੁ ਜੀਅ ਕੈ ਸੰਗਿ ਸਹਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "man chi(n)de sagale phal paavahu jee kai sa(n)g sahaaee ||1|| rahaau ||",
      "translation": "You shall obtain all the fruits of your mind's desires, and the Lord shall become the companion and the support of your soul. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਾਰਾਇਣ ਪ੍ਰਾਣ ਅਧਾਰਾ ॥",
      "transliteration": "naaraain praan adhaaraa ||",
      "translation": "The Lord is the support of the breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਹਮ ਸੰਤ ਜਨਾਂ ਰੇਨਾਰਾ ॥",
      "transliteration": "ham sa(n)t janaa(n) renaaraa ||",
      "translation": "I am the dust of the feet of the Holy people.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਪਤਿਤ ਪੁਨੀਤ ਕਰਿ ਲੀਨੇ ॥",
      "transliteration": "patit puneet kar leene ||",
      "translation": "I am a sinner, but the Lord made me pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਹਰਿ ਜਸੁ ਦੀਨੇ ॥੨॥",
      "transliteration": "kar kirapaa har jas deene ||2||",
      "translation": "By His Kind Mercy, the Lord blessed me with His Praises. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਕਰੇ ਪ੍ਰਤਿਪਾਲਾ ॥",
      "transliteration": "paarabraham kare pratipaalaa ||",
      "translation": "The Supreme Lord God cherishes and nurtures me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਦ ਜੀਅ ਸੰਗਿ ਰਖਵਾਲਾ ॥",
      "transliteration": "sad jee sa(n)g rakhavaalaa ||",
      "translation": "He is always with me, the Protector of my soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਹਰਿ ਦਿਨੁ ਰੈਨਿ ਕੀਰਤਨੁ ਗਾਈਐ ॥",
      "transliteration": "har din rain keeratan gaaeeai ||",
      "translation": "Singing the Kirtan of the Lord's Praises day and night,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਬਹੁੜਿ ਨ ਜੋਨੀ ਪਾਈਐ ॥੩॥",
      "transliteration": "bahuR na jonee paaeeai ||3||",
      "translation": "I shall not be consigned to reincarnation again. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜਿਸੁ ਦੇਵੈ ਪੁਰਖੁ ਬਿਧਾਤਾ ॥",
      "transliteration": "jis devai purakh bidhaataa ||",
      "translation": "One who is blessed by the Primal Lord, the Architect of Destiny,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਹਰਿ ਰਸੁ ਤਿਨ ਹੀ ਜਾਤਾ ॥",
      "transliteration": "har ras tin hee jaataa ||",
      "translation": "realizes the subtle essence of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਜਮਕੰਕਰੁ ਨੇੜਿ ਨ ਆਇਆ ॥",
      "transliteration": "jamaka(n)kar neR na aaiaa ||",
      "translation": "The Messenger of Death does not come near him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0623_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਸੁਖੁ ਨਾਨਕ ਸਰਣੀ ਪਾਇਆ ॥੪॥੯॥੫੯॥",
      "transliteration": "sukh naanak saranee paaiaa ||4||9||59||",
      "translation": "In the Lord's Sanctuary, Nanak has found peace. ||4||9||59||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 623,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
