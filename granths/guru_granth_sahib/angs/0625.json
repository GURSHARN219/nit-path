      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਿਤੁ ਪਾਰਬ੍ਰਹਮੁ ਚਿਤਿ ਆਇਆ ॥",
      "transliteration": "jit paarabraham chit aaiaa ||",
      "translation": "The Supreme Lord God has established that home,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0048",
