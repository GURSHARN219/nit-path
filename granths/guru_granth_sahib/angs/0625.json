{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 625,
  "lineCount": 48,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0625_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹੋਇ ਦਇਆਲੁ ਕਿਰਪਾਲੁ ਪ੍ਰਭੁ ਠਾਕੁਰੁ ਆਪੇ ਸੁਣੈ ਬੇਨੰਤੀ ॥",
      "transliteration": "hoi daiaal kirapaal prabh thaakur aape sunai bena(n)tee ||",
      "translation": "Becoming kind and compassionate, God the Lord and Master Himself listens to my prayer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪੂਰਾ ਸਤਗੁਰੁ ਮੇਲਿ ਮਿਲਾਵੈ ਸਭ ਚੂਕੈ ਮਨ ਕੀ ਚਿੰਤੀ ॥",
      "transliteration": "pooraa satagur mel milaavai sabh chookai man kee chi(n)tee ||",
      "translation": "He unites me in Union with the Perfect True Guru, and all the cares and anxieties of my mind are dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਅਵਖਦੁ ਮੁਖਿ ਪਾਇਆ ਜਨ ਨਾਨਕ ਸੁਖਿ ਵਸੰਤੀ ॥੪॥੧੨॥੬੨॥",
      "transliteration": "har har naam avakhad mukh paaiaa jan naanak sukh vasa(n)tee ||4||12||62||",
      "translation": "The Lord, Har, Har, has placed the medicine of the Naam into my mouth; servant Nanak abides in peace. ||4||12||62||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਪ੍ਰਭ ਭਏ ਅਨੰਦਾ ਦੁਖ ਕਲੇਸ ਸਭਿ ਨਾਠੇ ॥",
      "transliteration": "simar simar prabh bhae ana(n)daa dukh kales sabh naathe ||",
      "translation": "Remembering, remembering God in meditation, bliss ensues, and one is rid of all suffering and pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਨ ਗਾਵਤ ਧਿਆਵਤ ਪ੍ਰਭੁ ਅਪਨਾ ਕਾਰਜ ਸਗਲੇ ਸਾਂਠੇ ॥੧॥",
      "transliteration": "gun gaavat dhiaavat prabh apanaa kaaraj sagale saa(n)the ||1||",
      "translation": "Singing the Glorious Praises of God, and meditating on Him, all my affairs are brought into harmony. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਗਜੀਵਨ ਨਾਮੁ ਤੁਮਾਰਾ ॥",
      "transliteration": "jagajeevan naam tumaaraa ||",
      "translation": "Your Name is the Life of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਦੀਓ ਉਪਦੇਸਾ ਜਪਿ ਭਉਜਲੁ ਪਾਰਿ ਉਤਾਰਾ ॥ ਰਹਾਉ ॥",
      "transliteration": "gur poore deeo upadesaa jap bhaujal paar utaaraa || rahaau ||",
      "translation": "The Perfect Guru has taught me, that by meditating, I cross over the terrifying world-ocean. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤੂਹੈ ਮੰਤ੍ਰੀ ਸੁਨਹਿ ਪ੍ਰਭ ਤੂਹੈ ਸਭੁ ਕਿਛੁ ਕਰਣੈਹਾਰਾ ॥",
      "transliteration": "toohai ma(n)tree sunahi prabh toohai sabh kichh karanaihaaraa ||",
      "translation": "You are Your own advisor; You hear everything, God, and You do everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤੂ ਆਪੇ ਦਾਤਾ ਆਪੇ ਭੁਗਤਾ ਕਿਆ ਇਹੁ ਜੰਤੁ ਵਿਚਾਰਾ ॥੨॥",
      "transliteration": "too aape daataa aape bhugataa kiaa ihu ja(n)t vichaaraa ||2||",
      "translation": "You Yourself are the Giver, and You Yourself are the Enjoyer. What can this poor creature do? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਿਆ ਗੁਣ ਤੇਰੇ ਆਖਿ ਵਖਾਣੀ ਕੀਮਤਿ ਕਹਣੁ ਨ ਜਾਈ ॥",
      "transliteration": "kiaa gun tere aakh vakhaanee keemat kahan na jaaee ||",
      "translation": "Which of Your Glorious Virtues should I describe and speak of? Your value cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪੇਖਿ ਪੇਖਿ ਜੀਵੈ ਪ੍ਰਭੁ ਅਪਨਾ ਅਚਰਜੁ ਤੁਮਹਿ ਵਡਾਈ ॥੩॥",
      "transliteration": "pekh pekh jeevai prabh apanaa acharaj tumahi vadaaee ||3||",
      "translation": "I live by beholding, beholding You, O God. Your glorious greatness is wonderful and amazing! ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਾਰਿ ਅਨੁਗ੍ਰਹੁ ਆਪਿ ਪ੍ਰਭ ਸ੍ਵਾਮੀ ਪਤਿ ਮਤਿ ਕੀਨੀ ਪੂਰੀ ॥",
      "transliteration": "dhaar anugrahu aap prabh svaamee pat mat keenee pooree ||",
      "translation": "Granting His Grace, God my Lord and Master Himself saved my honor, and my intellect has been made perfect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਨਾਨਕ ਬਲਿਹਾਰੀ ਬਾਛਉ ਸੰਤਾ ਧੂਰੀ ॥੪॥੧੩॥੬੩॥",
      "transliteration": "sadaa sadaa naanak balihaaree baachhau sa(n)taa dhooree ||4||13||63||",
      "translation": "Forever and ever, Nanak is a sacrifice, longing for the dust of the feet of the Saints. ||4||13||63||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੋਰਠਿ ਮਃ ੫ ॥",
      "transliteration": "sorath mah 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰੁ ਪੂਰਾ ਨਮਸਕਾਰੇ ॥",
      "transliteration": "gur pooraa namasakaare ||",
      "translation": "I bow in reverence to the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪ੍ਰਭਿ ਸਭੇ ਕਾਜ ਸਵਾਰੇ ॥",
      "transliteration": "prabh sabhe kaaj savaare ||",
      "translation": "God has resolved all my affairs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹਰਿ ਅਪਣੀ ਕਿਰਪਾ ਧਾਰੀ ॥",
      "transliteration": "har apanee kirapaa dhaaree ||",
      "translation": "The Lord has showered me with His Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪ੍ਰਭ ਪੂਰਨ ਪੈਜ ਸਵਾਰੀ ॥੧॥",
      "transliteration": "prabh pooran paij savaaree ||1||",
      "translation": "God has perfectly preserved my honor. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਪਨੇ ਦਾਸ ਕੋ ਭਇਓ ਸਹਾਈ ॥",
      "transliteration": "apane daas ko bhaio sahaaee ||",
      "translation": "He has become the help and support of His slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਗਲ ਮਨੋਰਥ ਕੀਨੇ ਕਰਤੈ ਊਣੀ ਬਾਤ ਨ ਕਾਈ ॥ ਰਹਾਉ ॥",
      "transliteration": "sagal manorath keene karatai oonee baat na kaaee || rahaau ||",
      "translation": "The Creator has achieved all my goals, and now, nothing is lacking. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਰਤੈ ਪੁਰਖਿ ਤਾਲੁ ਦਿਵਾਇਆ ॥",
      "transliteration": "karatai purakh taal divaaiaa ||",
      "translation": "The Creator Lord has caused the pool of nectar to be constructed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਿਛੈ ਲਗਿ ਚਲੀ ਮਾਇਆ ॥",
      "transliteration": "pichhai lag chalee maaiaa ||",
      "translation": "The wealth of Maya follows in my footsteps,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੋਟਿ ਨ ਕਤਹੂ ਆਵੈ ॥",
      "transliteration": "tot na katahoo aavai ||",
      "translation": "and now, nothing is lacking at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੇਰੇ ਪੂਰੇ ਸਤਗੁਰ ਭਾਵੈ ॥੨॥",
      "transliteration": "mere poore satagur bhaavai ||2||",
      "translation": "This is pleasing to my Perfect True Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਦਇਆਲਾ ॥",
      "transliteration": "simar simar daiaalaa ||",
      "translation": "Remembering, remembering the Merciful Lord in meditation,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਭਿ ਜੀਅ ਭਏ ਕਿਰਪਾਲਾ ॥",
      "transliteration": "sabh jee bhae kirapaalaa ||",
      "translation": "all beings have become kind and compassionate to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੈ ਜੈ ਕਾਰੁ ਗੁਸਾਈ ॥",
      "transliteration": "jai jai kaar gusaaee ||",
      "translation": "Hail! Hail to the Lord of the world,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਨਿ ਪੂਰੀ ਬਣਤ ਬਣਾਈ ॥੩॥",
      "transliteration": "jin pooree banat banaaee ||3||",
      "translation": "who created the perfect creation. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੂ ਭਾਰੋ ਸੁਆਮੀ ਮੋਰਾ ॥",
      "transliteration": "too bhaaro suaamee moraa ||",
      "translation": "You are my Great Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਹੁ ਪੁੰਨੁ ਪਦਾਰਥੁ ਤੇਰਾ ॥",
      "transliteration": "ihu pu(n)n padaarath teraa ||",
      "translation": "These blessings and wealth are Yours.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਏਕੁ ਧਿਆਇਆ ॥",
      "transliteration": "jan naanak ek dhiaaiaa ||",
      "translation": "Servant Nanak has meditated on the One Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਰਬ ਫਲਾ ਪੁੰਨੁ ਪਾਇਆ ॥੪॥੧੪॥੬੪॥",
      "transliteration": "sarab phalaa pu(n)n paaiaa ||4||14||64||",
      "translation": "he has obtained the fruitful rewards for all good deeds. ||4||14||64||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ਘਰੁ ੩ ਦੁਪਦੇ ॥",
      "transliteration": "sorath mahalaa 5 ghar 3 dupade ||",
      "translation": "Sorat'h, Fifth Mehl, Third House, Dho-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਾਮਦਾਸ ਸਰੋਵਰਿ ਨਾਤੇ ॥",
      "transliteration": "raamadaas sarovar naate ||",
      "translation": "Bathing in the nectar tank of Ram Das,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਭਿ ਉਤਰੇ ਪਾਪ ਕਮਾਤੇ ॥",
      "transliteration": "sabh utare paap kamaate ||",
      "translation": "all sins are erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਿਰਮਲ ਹੋਏ ਕਰਿ ਇਸਨਾਨਾ ॥",
      "transliteration": "niramal hoe kar isanaanaa ||",
      "translation": "One becomes immaculately pure, taking this cleansing bath.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਕੀਨੇ ਦਾਨਾ ॥੧॥",
      "transliteration": "gur poorai keene daanaa ||1||",
      "translation": "The Perfect Guru has bestowed this gift. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਭਿ ਕੁਸਲ ਖੇਮ ਪ੍ਰਭਿ ਧਾਰੇ ॥",
      "transliteration": "sabh kusal khem prabh dhaare ||",
      "translation": "God has blessed all with peace and pleasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਹੀ ਸਲਾਮਤਿ ਸਭਿ ਥੋਕ ਉਬਾਰੇ ਗੁਰ ਕਾ ਸਬਦੁ ਵੀਚਾਰੇ ॥ ਰਹਾਉ ॥",
      "transliteration": "sahee salaamat sabh thok ubaare gur kaa sabad veechaare || rahaau ||",
      "translation": "Everything is safe and sound, as we contemplate the Word of the Guru's Shabad. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਮਲੁ ਲਾਥੀ ॥",
      "transliteration": "saadhasa(n)g mal laathee ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, filth is washed off.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਭਇਓ ਸਾਥੀ ॥",
      "transliteration": "paarabraham bhaio saathee ||",
      "translation": "The Supreme Lord God has become our friend and helper.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਧਿਆਇਆ ॥",
      "transliteration": "naanak naam dhiaaiaa ||",
      "translation": "Nanak meditates on the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਦਿ ਪੁਰਖ ਪ੍ਰਭੁ ਪਾਇਆ ॥੨॥੧॥੬੫॥",
      "transliteration": "aad purakh prabh paaiaa ||2||1||65||",
      "translation": "He has found God, the Primal Being. ||2||1||65||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 625,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0625_line_0046",
