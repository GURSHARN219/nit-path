{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 626,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0626_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁਖ ਸਾਗਰੁ ਗੁਰੁ ਪਾਇਆ ॥",
      "transliteration": "sukh saagar gur paaiaa ||",
      "translation": "I found the Guru, the ocean of peace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਾ ਸਹਸਾ ਸਗਲ ਮਿਟਾਇਆ ॥੧॥",
      "transliteration": "taa sahasaa sagal mitaaiaa ||1||",
      "translation": "And all my doubts were dispelled. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਰਿ ਕੇ ਨਾਮ ਕੀ ਵਡਿਆਈ ॥",
      "transliteration": "har ke naam kee vadiaaee ||",
      "translation": "This is the glorious greatness of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਠ ਪਹਰ ਗੁਣ ਗਾਈ ॥",
      "transliteration": "aath pahar gun gaaee ||",
      "translation": "Twenty-four hours a day, I sing His Glorious Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਤੇ ਪਾਈ ॥ ਰਹਾਉ ॥",
      "transliteration": "gur poore te paaee || rahaau ||",
      "translation": "I obtained this from the Perfect Guru. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਅਕਥ ਕਹਾਣੀ ॥",
      "transliteration": "prabh kee akath kahaanee ||",
      "translation": "God's sermon is inexpressible.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਨ ਬੋਲਹਿ ਅੰਮ੍ਰਿਤ ਬਾਣੀ ॥",
      "transliteration": "jan bolahi a(n)mrit baanee ||",
      "translation": "His humble servants speak words of Ambrosial Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਵਖਾਣੀ ॥",
      "transliteration": "naanak daas vakhaanee ||",
      "translation": "Slave Nanak has spoken.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਤੇ ਜਾਣੀ ॥੨॥੨॥੬੬॥",
      "transliteration": "gur poore te jaanee ||2||2||66||",
      "translation": "Through the Perfect Guru, it is known. ||2||2||66||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਗੈ ਸੁਖੁ ਗੁਰਿ ਦੀਆ ॥",
      "transliteration": "aagai sukh gur deeaa ||",
      "translation": "The Guru has blessed me with peace here,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਾਛੈ ਕੁਸਲ ਖੇਮ ਗੁਰਿ ਕੀਆ ॥",
      "transliteration": "paachhai kusal khem gur keeaa ||",
      "translation": "and the Guru has arranged peace and pleasure for me hereafter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਰਬ ਨਿਧਾਨ ਸੁਖ ਪਾਇਆ ॥",
      "transliteration": "sarab nidhaan sukh paaiaa ||",
      "translation": "I have all treasures and comforts,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗੁਰੁ ਅਪੁਨਾ ਰਿਦੈ ਧਿਆਇਆ ॥੧॥",
      "transliteration": "gur apunaa ridai dhiaaiaa ||1||",
      "translation": "meditating on the Guru in my heart. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਪਨੇ ਸਤਿਗੁਰ ਕੀ ਵਡਿਆਈ ॥",
      "transliteration": "apane satigur kee vadiaaee ||",
      "translation": "This is the glorious greatness of my True Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਨ ਇਛੇ ਫਲ ਪਾਈ ॥",
      "transliteration": "man ichhe phal paaee ||",
      "translation": "I have obtained the fruits of my mind's desires.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੰਤਹੁ ਦਿਨੁ ਦਿਨੁ ਚੜੈ ਸਵਾਈ ॥ ਰਹਾਉ ॥",
      "transliteration": "sa(n)tahu din din chaRai savaaee || rahaau ||",
      "translation": "O Saints, His Glory increases day by day. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਸਭਿ ਭਏ ਦਇਆਲਾ ਪ੍ਰਭਿ ਅਪਨੇ ਕਰਿ ਦੀਨੇ ॥",
      "transliteration": "jee ja(n)t sabh bhae daiaalaa prabh apane kar deene ||",
      "translation": "All beings and creatures have become kind and compassionate to me; my God has made them so.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਹਜ ਸੁਭਾਇ ਮਿਲੇ ਗੋਪਾਲਾ ਨਾਨਕ ਸਾਚਿ ਪਤੀਨੇ ॥੨॥੩॥੬੭॥",
      "transliteration": "sahaj subhaai mile gopaalaa naanak saach pateene ||2||3||67||",
      "translation": "Nanak has met with the Lord of the world with intuitive ease, and with Truth, he is pleased. ||2||3||67||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਰਖਵਾਰੇ ॥",
      "transliteration": "gur kaa sabad rakhavaare ||",
      "translation": "The Word of the Guru's Shabad is my Saving Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚਉਕੀ ਚਉਗਿਰਦ ਹਮਾਰੇ ॥",
      "transliteration": "chaukee chaugirad hamaare ||",
      "translation": "It is a guardian posted on all four sides around me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਾਮ ਨਾਮਿ ਮਨੁ ਲਾਗਾ ॥",
      "transliteration": "raam naam man laagaa ||",
      "translation": "My mind is attached to the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਮੁ ਲਜਾਇ ਕਰਿ ਭਾਗਾ ॥੧॥",
      "transliteration": "jam lajaai kar bhaagaa ||1||",
      "translation": "The Messenger of Death has run away in shame. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰਭ ਜੀ ਤੂ ਮੇਰੋ ਸੁਖਦਾਤਾ ॥",
      "transliteration": "prabh jee too mero sukhadaataa ||",
      "translation": "O Dear Lord, You are my Giver of peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬੰਧਨ ਕਾਟਿ ਕਰੇ ਮਨੁ ਨਿਰਮਲੁ ਪੂਰਨ ਪੁਰਖੁ ਬਿਧਾਤਾ ॥ ਰਹਾਉ ॥",
      "transliteration": "ba(n)dhan kaat kare man niramal pooran purakh bidhaataa || rahaau ||",
      "translation": "The Perfect Lord, the Architect of Destiny, has shattered my bonds, and made my mind immaculately pure. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਨਕ ਪ੍ਰਭੁ ਅਬਿਨਾਸੀ ॥",
      "transliteration": "naanak prabh abinaasee ||",
      "translation": "O Nanak, God is eternal and imperishable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਾ ਕੀ ਸੇਵ ਨ ਬਿਰਥੀ ਜਾਸੀ ॥",
      "transliteration": "taa kee sev na birathee jaasee ||",
      "translation": "Service to Him shall never go unrewarded.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਨਦ ਕਰਹਿ ਤੇਰੇ ਦਾਸਾ ॥",
      "transliteration": "anad karahi tere daasaa ||",
      "translation": "Your slaves are in bliss;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਪਿ ਪੂਰਨ ਹੋਈ ਆਸਾ ॥੨॥੪॥੬੮॥",
      "transliteration": "jap pooran hoee aasaa ||2||4||68||",
      "translation": "chanting and meditating, their desires are fulfilled. ||2||4||68||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰ ਅਪੁਨੇ ਬਲਿਹਾਰੀ ॥",
      "transliteration": "gur apune balihaaree ||",
      "translation": "I am a sacrifice to my Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਨਿ ਪੂਰਨ ਪੈਜ ਸਵਾਰੀ ॥",
      "transliteration": "jin pooran paij savaaree ||",
      "translation": "He has totally preserved my honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਨ ਚਿੰਦਿਆ ਫਲੁ ਪਾਇਆ ॥",
      "transliteration": "man chi(n)diaa phal paaiaa ||",
      "translation": "I have obtained the fruits of my mind's desires.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪ੍ਰਭੁ ਅਪੁਨਾ ਸਦਾ ਧਿਆਇਆ ॥੧॥",
      "transliteration": "prabh apunaa sadaa dhiaaiaa ||1||",
      "translation": "I meditate forever on my God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੰਤਹੁ ਤਿਸੁ ਬਿਨੁ ਅਵਰੁ ਨ ਕੋਈ ॥",
      "transliteration": "sa(n)tahu tis bin avar na koee ||",
      "translation": "O Saints, without Him, there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਰਣ ਕਾਰਣ ਪ੍ਰਭੁ ਸੋਈ ॥ ਰਹਾਉ ॥",
      "transliteration": "karan kaaran prabh soee || rahaau ||",
      "translation": "He is God, the Cause of causes. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਭਿ ਅਪਨੈ ਵਰ ਦੀਨੇ ॥",
      "transliteration": "prabh apanai var deene ||",
      "translation": "My God has given me His Blessing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਗਲ ਜੀਅ ਵਸਿ ਕੀਨੇ ॥",
      "transliteration": "sagal jee vas keene ||",
      "translation": "He has made all creatures subject to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਨਾਮੁ ਧਿਆਇਆ ॥",
      "transliteration": "jan naanak naam dhiaaiaa ||",
      "translation": "Servant Nanak meditates on the Naam, the Name of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਾ ਸਗਲੇ ਦੂਖ ਮਿਟਾਇਆ ॥੨॥੫॥੬੯॥",
      "transliteration": "taa sagale dookh mitaaiaa ||2||5||69||",
      "translation": "and all his sorrows depart. ||2||5||69||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਾਪੁ ਗਵਾਇਆ ਗੁਰਿ ਪੂਰੇ ॥",
      "transliteration": "taap gavaaiaa gur poore ||",
      "translation": "The Perfect Guru has dispelled the fever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਵਾਜੇ ਅਨਹਦ ਤੂਰੇ ॥",
      "transliteration": "vaaje anahad toore ||",
      "translation": "The unstruck melody of the sound current resounds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਰਬ ਕਲਿਆਣ ਪ੍ਰਭਿ ਕੀਨੇ ॥",
      "transliteration": "sarab kaliaan prabh keene ||",
      "translation": "God has bestowed all comforts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਆਪਿ ਦੀਨੇ ॥੧॥",
      "transliteration": "kar kirapaa aap deene ||1||",
      "translation": "In His Mercy, He Himself has given them. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬੇਦਨ ਸਤਿਗੁਰਿ ਆਪਿ ਗਵਾਈ ॥",
      "transliteration": "bedan satigur aap gavaaee ||",
      "translation": "The True Guru Himself has eradicated the disease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਿਖ ਸੰਤ ਸਭਿ ਸਰਸੇ ਹੋਏ ਹਰਿ ਹਰਿ ਨਾਮੁ ਧਿਆਈ ॥ ਰਹਾਉ ॥",
      "transliteration": "sikh sa(n)t sabh sarase hoe har har naam dhiaaee || rahaau ||",
      "translation": "All the Sikhs and Saints are filled with joy, meditating on the Name of the Lord, Har, Har. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜੋ ਮੰਗਹਿ ਸੋ ਲੇਵਹਿ ॥",
      "transliteration": "jo ma(n)gahi so levahi ||",
      "translation": "They obtain that which they ask for.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪ੍ਰਭ ਅਪਣਿਆ ਸੰਤਾ ਦੇਵਹਿ ॥",
      "transliteration": "prabh apaniaa sa(n)taa devahi ||",
      "translation": "God gives to His Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਰਿ ਗੋਵਿਦੁ ਪ੍ਰਭਿ ਰਾਖਿਆ ॥",
      "transliteration": "har govid prabh raakhiaa ||",
      "translation": "God saved Hargobind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਸਾਚੁ ਸੁਭਾਖਿਆ ॥੨॥੬॥੭੦॥",
      "transliteration": "jan naanak saach subhaakhiaa ||2||6||70||",
      "translation": "Servant Nanak speaks the Truth. ||2||6||70||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੋਈ ਕਰਾਇ ਜੋ ਤੁਧੁ ਭਾਵੈ ॥",
      "transliteration": "soee karaai jo tudh bhaavai ||",
      "translation": "You make me do what pleases You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮੋਹਿ ਸਿਆਣਪ ਕਛੂ ਨ ਆਵੈ ॥",
      "transliteration": "mohi siaanap kachhoo na aavai ||",
      "translation": "I have no cleverness at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਹਮ ਬਾਰਿਕ ਤਉ ਸਰਣਾਈ ॥",
      "transliteration": "ham baarik tau saranaaee ||",
      "translation": "I am just a child - I seek Your Protection.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਪ੍ਰਭਿ ਆਪੇ ਪੈਜ ਰਖਾਈ ॥੧॥",
      "transliteration": "prabh aape paij rakhaaee ||1||",
      "translation": "God Himself preserves my honor. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਮੇਰਾ ਮਾਤ ਪਿਤਾ ਹਰਿ ਰਾਇਆ ॥",
      "transliteration": "meraa maat pitaa har raaiaa ||",
      "translation": "The Lord is my King; He is my mother and father.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਤਿਪਾਲਣ ਲਾਗਾ ਕਰਂੀ ਤੇਰਾ ਕਰਾਇਆ ॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa pratipaalan laagaa kara(n)ee teraa karaaiaa || rahaau ||",
      "translation": "In Your Mercy, You cherish me; I do whatever You make me do. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਤੇਰੇ ਧਾਰੇ ॥",
      "transliteration": "jee ja(n)t tere dhaare ||",
      "translation": "The beings and creatures are Your creation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0626_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਪ੍ਰਭ ਡੋਰੀ ਹਾਥਿ ਤੁਮਾਰੇ ॥",
      "transliteration": "prabh doree haath tumaare ||",
      "translation": "O God, their reins are in Your hands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 626,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
