{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 627,
  "lineCount": 62,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0627_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿ ਕਰਾਵੈ ਸੋ ਕਰਣਾ ॥",
      "transliteration": "j karaavai so karanaa ||",
      "translation": "Whatever You cause us to do, we do.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਤੇਰੀ ਸਰਣਾ ॥੨॥੭॥੭੧॥",
      "transliteration": "naanak daas teree saranaa ||2||7||71||",
      "translation": "Nanak, Your slave, seeks Your Protection. ||2||7||71||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਰਿ ਨਾਮੁ ਰਿਦੈ ਪਰੋਇਆ ॥",
      "transliteration": "har naam ridai paroiaa ||",
      "translation": "I have woven the Lord's Name into the fabric of my heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਭੁ ਕਾਜੁ ਹਮਾਰਾ ਹੋਇਆ ॥",
      "transliteration": "sabh kaaj hamaaraa hoiaa ||",
      "translation": "All my affairs are resolved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪ੍ਰਭ ਚਰਣੀ ਮਨੁ ਲਾਗਾ ॥",
      "transliteration": "prabh charanee man laagaa ||",
      "translation": "His mind is attached to God's feet,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪੂਰਨ ਜਾ ਕੇ ਭਾਗਾ ॥੧॥",
      "transliteration": "pooran jaa ke bhaagaa ||1||",
      "translation": "whose destiny is perfect. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਿਲਿ ਸਾਧਸੰਗਿ ਹਰਿ ਧਿਆਇਆ ॥",
      "transliteration": "mil saadhasa(n)g har dhiaaiaa ||",
      "translation": "Joining the Saadh Sangat, the Company of the Holy, I meditate on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਠ ਪਹਰ ਅਰਾਧਿਓ ਹਰਿ ਹਰਿ ਮਨ ਚਿੰਦਿਆ ਫਲੁ ਪਾਇਆ ॥ ਰਹਾਉ ॥",
      "transliteration": "aath pahar araadhio har har man chi(n)diaa phal paaiaa || rahaau ||",
      "translation": "Twenty-four hours a day, I worship and adore the Lord, Har, Har; I have obtained the fruits of my mind's desires. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਰਾ ਪੂਰਬਲਾ ਅੰਕੁਰੁ ਜਾਗਿਆ ॥",
      "transliteration": "paraa poorabalaa a(n)kur jaagiaa ||",
      "translation": "The seeds of my past actions have sprouted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਮ ਨਾਮਿ ਮਨੁ ਲਾਗਿਆ ॥",
      "transliteration": "raam naam man laagiaa ||",
      "translation": "My mind is attached to the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਨਿ ਤਨਿ ਹਰਿ ਦਰਸਿ ਸਮਾਵੈ ॥",
      "transliteration": "man tan har daras samaavai ||",
      "translation": "My mind and body are absorbed into the Blessed Vision of the Lord's Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਸਚੇ ਗੁਣ ਗਾਵੈ ॥੨॥੮॥੭੨॥",
      "transliteration": "naanak daas sache gun gaavai ||2||8||72||",
      "translation": "Slave Nanak sings the Glorious Praises of the True Lord. ||2||8||72||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰ ਮਿਲਿ ਪ੍ਰਭੂ ਚਿਤਾਰਿਆ ॥",
      "transliteration": "gur mil prabhoo chitaariaa ||",
      "translation": "Meeting with the Guru, I contemplate God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਾਰਜ ਸਭਿ ਸਵਾਰਿਆ ॥",
      "transliteration": "kaaraj sabh savaariaa ||",
      "translation": "All of my affairs have been resolved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੰਦਾ ਕੋ ਨ ਅਲਾਏ ॥",
      "transliteration": "ma(n)daa ko na alaae ||",
      "translation": "No one speaks ill of me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਭ ਜੈ ਜੈ ਕਾਰੁ ਸੁਣਾਏ ॥੧॥",
      "transliteration": "sabh jai jai kaar sunaae ||1||",
      "translation": "Everyone congratulates me on my victory. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੰਤਹੁ ਸਾਚੀ ਸਰਣਿ ਸੁਆਮੀ ॥",
      "transliteration": "sa(n)tahu saachee saran suaamee ||",
      "translation": "O Saints, I seek the True Sanctuary of the Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਸਭਿ ਹਾਥਿ ਤਿਸੈ ਕੈ ਸੋ ਪ੍ਰਭੁ ਅੰਤਰਜਾਮੀ ॥ ਰਹਾਉ ॥",
      "transliteration": "jee ja(n)t sabh haath tisai kai so prabh a(n)tarajaamee || rahaau ||",
      "translation": "All beings and creatures are in His hands; He is God, the Inner-knower, the Searcher of hearts. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਰਤਬ ਸਭਿ ਸਵਾਰੇ ॥",
      "transliteration": "karatab sabh savaare ||",
      "translation": "He has resolved all of my affairs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਭਿ ਅਪੁਨਾ ਬਿਰਦੁ ਸਮਾਰੇ ॥",
      "transliteration": "prabh apunaa birad samaare ||",
      "translation": "God has confirmed His innate nature.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਤਿਤ ਪਾਵਨ ਪ੍ਰਭ ਨਾਮਾ ॥",
      "transliteration": "patit paavan prabh naamaa ||",
      "translation": "God's Name is the Purifier of sinners.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਸਦ ਕੁਰਬਾਨਾ ॥੨॥੯॥੭੩॥",
      "transliteration": "jan naanak sad kurabaanaa ||2||9||73||",
      "translation": "Servant Nanak is forever a sacrifice to Him. ||2||9||73||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮਿ ਸਾਜਿ ਸਵਾਰਿਆ ॥",
      "transliteration": "paarabraham saaj savaariaa ||",
      "translation": "The Supreme Lord God created and embellished him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਹੁ ਲਹੁੜਾ ਗੁਰੂ ਉਬਾਰਿਆ ॥",
      "transliteration": "ihu lahuRaa guroo ubaariaa ||",
      "translation": "The Guru has saved this small child.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਨਦ ਕਰਹੁ ਪਿਤ ਮਾਤਾ ॥",
      "transliteration": "anad karahu pit maataa ||",
      "translation": "So celebrate and be happy, father and mother.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪਰਮੇਸਰੁ ਜੀਅ ਕਾ ਦਾਤਾ ॥੧॥",
      "transliteration": "paramesar jee kaa daataa ||1||",
      "translation": "The Transcendent Lord is the Giver of souls. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁਭ ਚਿਤਵਨਿ ਦਾਸ ਤੁਮਾਰੇ ॥",
      "transliteration": "subh chitavan daas tumaare ||",
      "translation": "Your slaves, O Lord, focus on pure thoughts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਖਹਿ ਪੈਜ ਦਾਸ ਅਪੁਨੇ ਕੀ ਕਾਰਜ ਆਪਿ ਸਵਾਰੇ ॥ ਰਹਾਉ ॥",
      "transliteration": "raakhahi paij daas apune kee kaaraj aap savaare || rahaau ||",
      "translation": "You preserve the honor of Your slaves, and You Yourself arrange their affairs. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੇਰਾ ਪ੍ਰਭੁ ਪਰਉਪਕਾਰੀ ॥",
      "transliteration": "meraa prabh paraupakaaree ||",
      "translation": "My God is so benevolent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪੂਰਨ ਕਲ ਜਿਨਿ ਧਾਰੀ ॥",
      "transliteration": "pooran kal jin dhaaree ||",
      "translation": "His Almighty Power is manifest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਨਕ ਸਰਣੀ ਆਇਆ ॥",
      "transliteration": "naanak saranee aaiaa ||",
      "translation": "Nanak has come to His Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਨ ਚਿੰਦਿਆ ਫਲੁ ਪਾਇਆ ॥੨॥੧੦॥੭੪॥",
      "transliteration": "man chi(n)diaa phal paaiaa ||2||10||74||",
      "translation": "He has obtained the fruits of his mind's desires. ||2||10||74||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਹਰਿ ਜਾਪੇ ॥",
      "transliteration": "sadaa sadaa har jaape ||",
      "translation": "Forever and ever, I chant the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਭ ਬਾਲਕ ਰਾਖੇ ਆਪੇ ॥",
      "transliteration": "prabh baalak raakhe aape ||",
      "translation": "God Himself has saved my child.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੀਤਲਾ ਠਾਕਿ ਰਹਾਈ ॥",
      "transliteration": "seetalaa thaak rahaaee ||",
      "translation": "He healed him from the smallpox.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਘਨ ਗਏ ਹਰਿ ਨਾਈ ॥੧॥",
      "transliteration": "bighan gae har naaee ||1||",
      "translation": "My troubles have been removed through the Lord's Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮੇਰਾ ਪ੍ਰਭੁ ਹੋਆ ਸਦਾ ਦਇਆਲਾ ॥",
      "transliteration": "meraa prabh hoaa sadaa daiaalaa ||",
      "translation": "My God is forever Merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਰਦਾਸਿ ਸੁਣੀ ਭਗਤ ਅਪੁਨੇ ਕੀ ਸਭ ਜੀਅ ਭਇਆ ਕਿਰਪਾਲਾ ॥ ਰਹਾਉ ॥",
      "transliteration": "aradaas sunee bhagat apune kee sabh jee bhaiaa kirapaalaa || rahaau ||",
      "translation": "He heard the prayer of His devotee, and now all beings are kind and compassionate to him. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪ੍ਰਭ ਕਰਣ ਕਾਰਣ ਸਮਰਾਥਾ ॥",
      "transliteration": "prabh karan kaaran samaraathaa ||",
      "translation": "God is Almighty, the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਸਭੁ ਦੁਖੁ ਲਾਥਾ ॥",
      "transliteration": "har simarat sabh dukh laathaa ||",
      "translation": "Remembering the Lord in meditation, all pains and sorrows vanish.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਪਣੇ ਦਾਸ ਕੀ ਸੁਣੀ ਬੇਨੰਤੀ ॥",
      "transliteration": "apane daas kee sunee bena(n)tee ||",
      "translation": "He has heard the prayer of His slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਭ ਨਾਨਕ ਸੁਖਿ ਸਵੰਤੀ ॥੨॥੧੧॥੭੫॥",
      "transliteration": "sabh naanak sukh sava(n)tee ||2||11||75||",
      "translation": "O Nanak, now everyone sleeps in peace. ||2||11||75||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਪਨਾ ਗੁਰੂ ਧਿਆਏ ॥",
      "transliteration": "apanaa guroo dhiaae ||",
      "translation": "I meditated on my Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮਿਲਿ ਕੁਸਲ ਸੇਤੀ ਘਰਿ ਆਏ ॥",
      "transliteration": "mil kusal setee ghar aae ||",
      "translation": "I met with Him, and returned home in joy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਮੈ ਕੀ ਵਡਿਆਈ ॥",
      "transliteration": "naamai kee vadiaaee ||",
      "translation": "This is the glorious greatness of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤਿਸੁ ਕੀਮਤਿ ਕਹਣੁ ਨ ਜਾਈ ॥੧॥",
      "transliteration": "tis keemat kahan na jaaee ||1||",
      "translation": "Its value cannot be estimated. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੰਤਹੁ ਹਰਿ ਹਰਿ ਹਰਿ ਆਰਾਧਹੁ ॥",
      "transliteration": "sa(n)tahu har har har aaraadhahu ||",
      "translation": "O Saints, worship and adore the Lord, Har, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਹਰਿ ਆਰਾਧਿ ਸਭੋ ਕਿਛੁ ਪਾਈਐ ਕਾਰਜ ਸਗਲੇ ਸਾਧਹੁ ॥ ਰਹਾਉ ॥",
      "transliteration": "har aaraadh sabho kichh paaeeai kaaraj sagale saadhahu || rahaau ||",
      "translation": "Worship the Lord in adoration, and you shall obtain everything; your affairs shall all be resolved. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪ੍ਰੇਮ ਭਗਤਿ ਪ੍ਰਭ ਲਾਗੀ ॥",
      "transliteration": "prem bhagat prabh laagee ||",
      "translation": "He alone is attached in loving devotion to God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸੋ ਪਾਏ ਜਿਸੁ ਵਡਭਾਗੀ ॥",
      "transliteration": "so paae jis vadabhaagee ||",
      "translation": "who realizes his great destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਨਾਮੁ ਧਿਆਇਆ ॥",
      "transliteration": "jan naanak naam dhiaaiaa ||",
      "translation": "Servant Nanak meditates on the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਿਨਿ ਸਰਬ ਸੁਖਾ ਫਲ ਪਾਇਆ ॥੨॥੧੨॥੭੬॥",
      "transliteration": "tin sarab sukhaa phal paaiaa ||2||12||76||",
      "translation": "He obtains the rewards of all joys and peace. ||2||12||76||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਪਰਮੇਸਰਿ ਦਿਤਾ ਬੰਨਾ ॥",
      "transliteration": "paramesar ditaa ba(n)naa ||",
      "translation": "The Transcendent Lord has given me His support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਦੁਖ ਰੋਗ ਕਾ ਡੇਰਾ ਭੰਨਾ ॥",
      "transliteration": "dukh rog kaa deraa bha(n)naa ||",
      "translation": "The house of pain and disease has been demolished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਅਨਦ ਕਰਹਿ ਨਰ ਨਾਰੀ ॥",
      "transliteration": "anad karahi nar naaree ||",
      "translation": "The men and women celebrate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0627_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਪ੍ਰਭਿ ਕਿਰਪਾ ਧਾਰੀ ॥੧॥",
      "transliteration": "har har prabh kirapaa dhaaree ||1||",
      "translation": "The Lord God, Har, Har, has extended His Mercy. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 627,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
