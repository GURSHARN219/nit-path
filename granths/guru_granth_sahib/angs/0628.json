{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 628,
  "lineCount": 53,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0628_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੰਤਹੁ ਸੁਖੁ ਹੋਆ ਸਭ ਥਾਈ ॥",
      "transliteration": "sa(n)tahu sukh hoaa sabh thaaee ||",
      "translation": "O Saints, there is peace everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਪੂਰਨ ਪਰਮੇਸਰੁ ਰਵਿ ਰਹਿਆ ਸਭਨੀ ਜਾਈ ॥ ਰਹਾਉ ॥",
      "transliteration": "paarabraham pooran paramesar rav rahiaa sabhanee jaaee || rahaau ||",
      "translation": "The Supreme Lord God, the Perfect Transcendent Lord, is pervading everywhere. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਧੁਰ ਕੀ ਬਾਣੀ ਆਈ ॥",
      "transliteration": "dhur kee baanee aaee ||",
      "translation": "The Bani of His Word emanated from the Primal Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਿਨਿ ਸਗਲੀ ਚਿੰਤ ਮਿਟਾਈ ॥",
      "transliteration": "tin sagalee chi(n)t mitaaee ||",
      "translation": "It eradicates all anxiety.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦਇਆਲ ਪੁਰਖ ਮਿਹਰਵਾਨਾ ॥",
      "transliteration": "daiaal purakh miharavaanaa ||",
      "translation": "The Lord is merciful, kind and compassionate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਰਿ ਨਾਨਕ ਸਾਚੁ ਵਖਾਨਾ ॥੨॥੧੩॥੭੭॥",
      "transliteration": "har naanak saach vakhaanaa ||2||13||77||",
      "translation": "Nanak chants the Naam, the Name of the True Lord. ||2||13||77||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਐਥੈ ਓਥੈ ਰਖਵਾਲਾ ॥",
      "transliteration": "aithai othai rakhavaalaa ||",
      "translation": "Here and hereafter, He is our Savior.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪ੍ਰਭ ਸਤਿਗੁਰ ਦੀਨ ਦਇਆਲਾ ॥",
      "transliteration": "prabh satigur deen daiaalaa ||",
      "translation": "God, the True Guru, is Merciful to the meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦਾਸ ਅਪਨੇ ਆਪਿ ਰਾਖੇ ॥",
      "transliteration": "daas apane aap raakhe ||",
      "translation": "He Himself protects His slaves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਸਬਦੁ ਸੁਭਾਖੇ ॥੧॥",
      "transliteration": "ghat ghat sabad subhaakhe ||1||",
      "translation": "In each and every heart, the Beautiful Word of His Shabad resounds. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਣ ਊਪਰਿ ਬਲਿ ਜਾਈ ॥",
      "transliteration": "gur ke charan oopar bal jaaee ||",
      "translation": "I am a sacrifice to the Guru's Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦਿਨਸੁ ਰੈਨਿ ਸਾਸਿ ਸਾਸਿ ਸਮਾਲੀ ਪੂਰਨੁ ਸਭਨੀ ਥਾਈ ॥ ਰਹਾਉ ॥",
      "transliteration": "dinas rain saas saas samaalee pooran sabhanee thaaee || rahaau ||",
      "translation": "Day and night, with each and every breath, I remember Him; He is totally pervading and permeating all places. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਪਿ ਸਹਾਈ ਹੋਆ ॥",
      "transliteration": "aap sahaaee hoaa ||",
      "translation": "He Himself has become my help and support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਚੇ ਦਾ ਸਚਾ ਢੋਆ ॥",
      "transliteration": "sache daa sachaa dhoaa ||",
      "translation": "True is the support of the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤੇਰੀ ਭਗਤਿ ਵਡਿਆਈ ॥",
      "transliteration": "teree bhagat vadiaaee ||",
      "translation": "Glorious and great is devotional worship to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪਾਈ ਨਾਨਕ ਪ੍ਰਭ ਸਰਣਾਈ ॥੨॥੧੪॥੭੮॥",
      "transliteration": "paaee naanak prabh saranaaee ||2||14||78||",
      "translation": "Nanak has found God's Sanctuary. ||2||14||78||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਤਿਗੁਰ ਪੂਰੇ ਭਾਣਾ ॥",
      "transliteration": "satigur poore bhaanaa ||",
      "translation": "When it was pleasing to the Perfect True Guru,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਜਪਿਆ ਨਾਮੁ ਰਮਾਣਾ ॥",
      "transliteration": "taa japiaa naam ramaanaa ||",
      "translation": "then I chanted the Naam, the Name of the Pervading Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੋਬਿੰਦ ਕਿਰਪਾ ਧਾਰੀ ॥",
      "transliteration": "gobi(n)d kirapaa dhaaree ||",
      "translation": "The Lord of the Universe extended His Mercy to me,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਭਿ ਰਾਖੀ ਪੈਜ ਹਮਾਰੀ ॥੧॥",
      "transliteration": "prabh raakhee paij hamaaree ||1||",
      "translation": "and God saved my honor. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਰਿ ਕੇ ਚਰਨ ਸਦਾ ਸੁਖਦਾਈ ॥",
      "transliteration": "har ke charan sadaa sukhadaaee ||",
      "translation": "The Lord's feet are forever peace-giving.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੋ ਇਛਹਿ ਸੋਈ ਫਲੁ ਪਾਵਹਿ ਬਿਰਥੀ ਆਸ ਨ ਜਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jo ichhahi soee phal paavahi birathee aas na jaaee ||1|| rahaau ||",
      "translation": "Whatever fruit one desires, he receives; his hopes shall not go in vain. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਕਰੇ ਜਿਸੁ ਪ੍ਰਾਨਪਤਿ ਦਾਤਾ ਸੋਈ ਸੰਤੁ ਗੁਣ ਗਾਵੈ ॥",
      "transliteration": "kripaa kare jis praanapat daataa soee sa(n)t gun gaavai ||",
      "translation": "That Saint, unto whom the Lord of Life, the Great Giver, extends His Mercy - he alone sings the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪ੍ਰੇਮ ਭਗਤਿ ਤਾ ਕਾ ਮਨੁ ਲੀਣਾ ਪਾਰਬ੍ਰਹਮ ਮਨਿ ਭਾਵੈ ॥੨॥",
      "transliteration": "prem bhagat taa kaa man leenaa paarabraham man bhaavai ||2||",
      "translation": "His soul is absorbed in loving devotional worship; his mind is pleasing to the Supreme Lord God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਆਠ ਪਹਰ ਹਰਿ ਕਾ ਜਸੁ ਰਵਣਾ ਬਿਖੈ ਠਗਉਰੀ ਲਾਥੀ ॥",
      "transliteration": "aath pahar har kaa jas ravanaa bikhai thagauree laathee ||",
      "translation": "Twenty-four hours a day, he chants the Praises of the Lord, and the bitter poison does not affect him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੰਗਿ ਮਿਲਾਇ ਲੀਆ ਮੇਰੈ ਕਰਤੈ ਸੰਤ ਸਾਧ ਭਏ ਸਾਥੀ ॥੩॥",
      "transliteration": "sa(n)g milaai leeaa merai karatai sa(n)t saadh bhae saathee ||3||",
      "translation": "My Creator Lord has united me with Himself, and the Holy Saints have become my companions. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਰੁ ਗਹਿ ਲੀਨੇ ਸਰਬਸੁ ਦੀਨੇ ਆਪਹਿ ਆਪੁ ਮਿਲਾਇਆ ॥",
      "transliteration": "kar gahi leene sarabas deene aapahi aap milaaiaa ||",
      "translation": "Taking me by the hand, He has given me everything, and blended me with Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਸਰਬ ਥੋਕ ਪੂਰਨ ਪੂਰਾ ਸਤਿਗੁਰੁ ਪਾਇਆ ॥੪॥੧੫॥੭੯॥",
      "transliteration": "kahu naanak sarab thok pooran pooraa satigur paaiaa ||4||15||79||",
      "translation": "Says Nanak, everything has been perfectly resolved; I have found the Perfect True Guru. ||4||15||79||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗਰੀਬੀ ਗਦਾ ਹਮਾਰੀ ॥",
      "transliteration": "gareebee gadaa hamaaree ||",
      "translation": "Humility is my spiked club.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਖੰਨਾ ਸਗਲ ਰੇਨੁ ਛਾਰੀ ॥",
      "transliteration": "kha(n)naa sagal ren chhaaree ||",
      "translation": "My dagger is to be the dust of all men's feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਸੁ ਆਗੈ ਕੋ ਨ ਟਿਕੈ ਵੇਕਾਰੀ ॥",
      "transliteration": "is aagai ko na tikai vekaaree ||",
      "translation": "No evil-doer can withstand these weapons.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਏਹ ਗਲ ਸਾਰੀ ॥੧॥",
      "transliteration": "gur poore eh gal saaree ||1||",
      "translation": "The Perfect Guru has given me this understanding. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਸੰਤਨ ਕੀ ਓਟਾ ॥",
      "transliteration": "har har naam sa(n)tan kee otaa ||",
      "translation": "The Name of the Lord, Har, Har, is the support and shelter of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੋ ਸਿਮਰੈ ਤਿਸ ਕੀ ਗਤਿ ਹੋਵੈ ਉਧਰਹਿ ਸਗਲੇ ਕੋਟਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jo simarai tis kee gat hovai udharahi sagale kotaa ||1|| rahaau ||",
      "translation": "One who remembers the Lord in meditation, is emancipated; millions have been saved in this way. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੰਤ ਸੰਗਿ ਜਸੁ ਗਾਇਆ ॥",
      "transliteration": "sa(n)t sa(n)g jas gaaiaa ||",
      "translation": "In the Society of the Saints, I sing His Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਹੁ ਪੂਰਨ ਹਰਿ ਧਨੁ ਪਾਇਆ ॥",
      "transliteration": "ihu pooran har dhan paaiaa ||",
      "translation": "I have found this, the perfect wealth of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਆਪੁ ਮਿਟਾਇਆ ॥",
      "transliteration": "kahu naanak aap mitaaiaa ||",
      "translation": "Says Nanak, I have eradicated my self-conceit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਭੁ ਪਾਰਬ੍ਰਹਮੁ ਨਦਰੀ ਆਇਆ ॥੨॥੧੬॥੮੦॥",
      "transliteration": "sabh paarabraham nadaree aaiaa ||2||16||80||",
      "translation": "I see the Supreme Lord God everywhere. ||2||16||80||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਪੂਰੀ ਕੀਨੀ ॥",
      "transliteration": "gur poorai pooree keenee ||",
      "translation": "The Perfect Guru has done it perfectly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਖਸ ਅਪੁਨੀ ਕਰਿ ਦੀਨੀ ॥",
      "transliteration": "bakhas apunee kar deenee ||",
      "translation": "He blessed me with forgiveness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਿਤ ਅਨੰਦ ਸੁਖ ਪਾਇਆ ॥",
      "transliteration": "nit ana(n)d sukh paaiaa ||",
      "translation": "I have found lasting peace and bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਥਾਵ ਸਗਲੇ ਸੁਖੀ ਵਸਾਇਆ ॥੧॥",
      "transliteration": "thaav sagale sukhee vasaaiaa ||1||",
      "translation": "Everywhere, the people dwell in peace. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਰਿ ਕੀ ਭਗਤਿ ਫਲ ਦਾਤੀ ॥",
      "transliteration": "har kee bhagat phal daatee ||",
      "translation": "Devotional worship to the Lord is what gives rewards.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਕਿਰਪਾ ਕਰਿ ਦੀਨੀ ਵਿਰਲੈ ਕਿਨ ਹੀ ਜਾਤੀ ॥ ਰਹਾਉ ॥",
      "transliteration": "gur poorai kirapaa kar deenee viralai kin hee jaatee || rahaau ||",
      "translation": "The Perfect Guru, by His Grace, gave it to me; how rare are those who know this. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰਬਾਣੀ ਗਾਵਹ ਭਾਈ ॥",
      "transliteration": "gurabaanee gaavah bhaaee ||",
      "translation": "Sing the Word of the Guru's Bani, O Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਓਹ ਸਫਲ ਸਦਾ ਸੁਖਦਾਈ ॥",
      "transliteration": "oh saphal sadaa sukhadaaee ||",
      "translation": "That is always rewarding and peace-giving.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਧਿਆਇਆ ॥",
      "transliteration": "naanak naam dhiaaiaa ||",
      "translation": "Nanak has meditated on the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪੂਰਬਿ ਲਿਖਿਆ ਪਾਇਆ ॥੨॥੧੭॥੮੧॥",
      "transliteration": "poorab likhiaa paaiaa ||2||17||81||",
      "translation": "He has realized his pre-ordained destiny. ||2||17||81||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0628_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 628,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
