{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 629,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0629_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੁਰੁ ਪੂਰਾ ਆਰਾਧੇ ॥",
      "transliteration": "gur pooraa aaraadhe ||",
      "translation": "I worship and adore the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਾਰਜ ਸਗਲੇ ਸਾਧੇ ॥",
      "transliteration": "kaaraj sagale saadhe ||",
      "translation": "All my affairs have been resolved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਗਲ ਮਨੋਰਥ ਪੂਰੇ ॥",
      "transliteration": "sagal manorath poore ||",
      "translation": "All desires have been fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਾਜੇ ਅਨਹਦ ਤੂਰੇ ॥੧॥",
      "transliteration": "baaje anahad toore ||1||",
      "translation": "The unstruck melody of the sound current resounds. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੰਤਹੁ ਰਾਮੁ ਜਪਤ ਸੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "sa(n)tahu raam japat sukh paaiaa ||",
      "translation": "O Saints, meditating on the Lord, we obtain peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੰਤ ਅਸਥਾਨਿ ਬਸੇ ਸੁਖ ਸਹਜੇ ਸਗਲੇ ਦੂਖ ਮਿਟਾਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sa(n)t asathaan base sukh sahaje sagale dookh mitaaiaa ||1|| rahaau ||",
      "translation": "In the home of the Saints, celestial peace is pervading; all pain and suffering is dispelled. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕੀ ਬਾਣੀ ॥",
      "transliteration": "gur poore kee baanee ||",
      "translation": "The Word of the Perfect Guru's Bani",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਮਨਿ ਭਾਣੀ ॥",
      "transliteration": "paarabraham man bhaanee ||",
      "translation": "is pleasing to the Mind of the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਨਕ ਦਾਸਿ ਵਖਾਣੀ ॥",
      "transliteration": "naanak daas vakhaanee ||",
      "translation": "Slave Nanak speaks",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਿਰਮਲ ਅਕਥ ਕਹਾਣੀ ॥੨॥੧੮॥੮੨॥",
      "transliteration": "niramal akath kahaanee ||2||18||82||",
      "translation": "the Unspoken, immaculate sermon of the Lord. ||2||18||82||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭੂਖੇ ਖਾਵਤ ਲਾਜ ਨ ਆਵੈ ॥",
      "transliteration": "bhookhe khaavat laaj na aavai ||",
      "translation": "The hungry man is not ashamed to eat.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਉ ਹਰਿ ਜਨੁ ਹਰਿ ਗੁਣ ਗਾਵੈ ॥੧॥",
      "transliteration": "tiu har jan har gun gaavai ||1||",
      "translation": "Just so, the humble servant of the Lord sings the Glorious Praises of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਪਨੇ ਕਾਜ ਕਉ ਕਿਉ ਅਲਕਾਈਐ ॥",
      "transliteration": "apane kaaj kau kiu alakaaeeai ||",
      "translation": "Why are you so lazy in your own affairs?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਤੁ ਸਿਮਰਨਿ ਦਰਗਹ ਮੁਖੁ ਊਜਲ ਸਦਾ ਸਦਾ ਸੁਖੁ ਪਾਈਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jit simaran daragah mukh oojal sadaa sadaa sukh paaeeai ||1|| rahaau ||",
      "translation": "Remembering Him in meditation, your face shall be radiant in the Court of the Lord; you shall find peace, forever and ever. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਉ ਕਾਮੀ ਕਾਮਿ ਲੁਭਾਵੈ ॥",
      "transliteration": "jiu kaamee kaam lubhaavai ||",
      "translation": "Just as the lustful man is enticed by lust,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਿਉ ਹਰਿ ਦਾਸ ਹਰਿ ਜਸੁ ਭਾਵੈ ॥੨॥",
      "transliteration": "tiu har daas har jas bhaavai ||2||",
      "translation": "so is the Lord's slave pleased with the Lord's Praise. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਉ ਮਾਤਾ ਬਾਲਿ ਲਪਟਾਵੈ ॥",
      "transliteration": "jiu maataa baal lapataavai ||",
      "translation": "Just as the mother holds her baby close,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਿਉ ਗਿਆਨੀ ਨਾਮੁ ਕਮਾਵੈ ॥੩॥",
      "transliteration": "tiu giaanee naam kamaavai ||3||",
      "translation": "so does the spiritual person cherish the Naam, the Name of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਤੇ ਪਾਵੈ ॥",
      "transliteration": "gur poore te paavai ||",
      "translation": "This is obtained from the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਨਾਮੁ ਧਿਆਵੈ ॥੪॥੧੯॥੮੩॥",
      "transliteration": "jan naanak naam dhiaavai ||4||19||83||",
      "translation": "Servant Nanak meditates on the Naam, the Name of the Lord. ||4||19||83||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੁਖ ਸਾਂਦਿ ਘਰਿ ਆਇਆ ॥",
      "transliteration": "sukh saa(n)d ghar aaiaa ||",
      "translation": "Safe and sound, I have returned home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਿੰਦਕ ਕੈ ਮੁਖਿ ਛਾਇਆ ॥",
      "transliteration": "ni(n)dak kai mukh chhaaiaa ||",
      "translation": "The slanderer's face is blackened with ashes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪੂਰੈ ਗੁਰਿ ਪਹਿਰਾਇਆ ॥",
      "transliteration": "poorai gur pahiraaiaa ||",
      "translation": "The Perfect Guru has dressed in robes of honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਿਨਸੇ ਦੁਖ ਸਬਾਇਆ ॥੧॥",
      "transliteration": "binase dukh sabaaiaa ||1||",
      "translation": "All my pains and sufferings are over. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੰਤਹੁ ਸਾਚੇ ਕੀ ਵਡਿਆਈ ॥",
      "transliteration": "sa(n)tahu saache kee vadiaaee ||",
      "translation": "O Saints, this is the glorious greatness of the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਿਨਿ ਅਚਰਜ ਸੋਭ ਬਣਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jin acharaj sobh banaaee ||1|| rahaau ||",
      "translation": "He has created such wonder and glory! ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬੋਲੇ ਸਾਹਿਬ ਕੈ ਭਾਣੈ ॥",
      "transliteration": "bole saahib kai bhaanai ||",
      "translation": "I speak according to the Will of my Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦਾਸੁ ਬਾਣੀ ਬ੍ਰਹਮੁ ਵਖਾਣੈ ॥",
      "transliteration": "daas baanee braham vakhaanai ||",
      "translation": "God's slave chants the Word of His Bani.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾਨਕ ਪ੍ਰਭ ਸੁਖਦਾਈ ॥",
      "transliteration": "naanak prabh sukhadaaee ||",
      "translation": "O Nanak, God is the Giver of peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਨਿ ਪੂਰੀ ਬਣਤ ਬਣਾਈ ॥੨॥੨੦॥੮੪॥",
      "transliteration": "jin pooree banat banaaee ||2||20||84||",
      "translation": "He has created the perfect creation. ||2||20||84||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪ੍ਰਭੁ ਅਪੁਨਾ ਰਿਦੈ ਧਿਆਏ ॥",
      "transliteration": "prabh apunaa ridai dhiaae ||",
      "translation": "Within my heart, I meditate on God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਘਰਿ ਸਹੀ ਸਲਾਮਤਿ ਆਏ ॥",
      "transliteration": "ghar sahee salaamat aae ||",
      "translation": "I have returned home safe and sound.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੰਤੋਖੁ ਭਇਆ ਸੰਸਾਰੇ ॥",
      "transliteration": "sa(n)tokh bhaiaa sa(n)saare ||",
      "translation": "The world has become contented.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਲੈ ਤਾਰੇ ॥੧॥",
      "transliteration": "gur poorai lai taare ||1||",
      "translation": "The Perfect Guru has saved me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੰਤਹੁ ਪ੍ਰਭੁ ਮੇਰਾ ਸਦਾ ਦਇਆਲਾ ॥",
      "transliteration": "sa(n)tahu prabh meraa sadaa daiaalaa ||",
      "translation": "O Saints, my God is forever merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਪਨੇ ਭਗਤ ਕੀ ਗਣਤ ਨ ਗਣਈ ਰਾਖੈ ਬਾਲ ਗੁਪਾਲਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "apane bhagat kee ganat na ganaee raakhai baal gupaalaa ||1|| rahaau ||",
      "translation": "The Lord of the world does not call His devotee to account; He protects His children. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਰਿ ਨਾਮੁ ਰਿਦੈ ਉਰਿ ਧਾਰੇ ॥",
      "transliteration": "har naam ridai ur dhaare ||",
      "translation": "I have enshrined the Lord's Name within my heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਿਨਿ ਸਭੇ ਥੋਕ ਸਵਾਰੇ ॥",
      "transliteration": "tin sabhe thok savaare ||",
      "translation": "He has resolved all my affairs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਤੁਸਿ ਦੀਆ ॥",
      "transliteration": "gur poorai tus deeaa ||",
      "translation": "The Perfect Guru was pleased, and blessed me,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਫਿਰਿ ਨਾਨਕ ਦੂਖੁ ਨ ਥੀਆ ॥੨॥੨੧॥੮੫॥",
      "transliteration": "phir naanak dookh na theeaa ||2||21||85||",
      "translation": "and now, Nanak shall never again suffer pain. ||2||21||85||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਰਿ ਮਨਿ ਤਨਿ ਵਸਿਆ ਸੋਈ ॥",
      "transliteration": "har man tan vasiaa soee ||",
      "translation": "The Lord abides in my mind and body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੈ ਜੈ ਕਾਰੁ ਕਰੇ ਸਭੁ ਕੋਈ ॥",
      "transliteration": "jai jai kaar kare sabh koee ||",
      "translation": "Everyone congratulates me on my victory.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕੀ ਵਡਿਆਈ ॥",
      "transliteration": "gur poore kee vadiaaee ||",
      "translation": "This is the glorious greatness of the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਾ ਕੀ ਕੀਮਤਿ ਕਹੀ ਨ ਜਾਈ ॥੧॥",
      "transliteration": "taa kee keemat kahee na jaaee ||1||",
      "translation": "His value cannot be described. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹਉ ਕੁਰਬਾਨੁ ਜਾਈ ਤੇਰੇ ਨਾਵੈ ॥",
      "transliteration": "hau kurabaan jaaee tere naavai ||",
      "translation": "I am a sacrifice to Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਸ ਨੋ ਬਖਸਿ ਲੈਹਿ ਮੇਰੇ ਪਿਆਰੇ ਸੋ ਜਸੁ ਤੇਰਾ ਗਾਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jis no bakhas laihi mere piaare so jas teraa gaavai ||1|| rahaau ||",
      "translation": "He alone, whom You have forgiven, O my Beloved, sings Your Praises. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤੂੰ ਭਾਰੋ ਸੁਆਮੀ ਮੇਰਾ ॥",
      "transliteration": "too(n) bhaaro suaamee meraa ||",
      "translation": "You are my Great Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੰਤਾਂ ਭਰਵਾਸਾ ਤੇਰਾ ॥",
      "transliteration": "sa(n)taa(n) bharavaasaa teraa ||",
      "translation": "You are the support of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾਨਕ ਪ੍ਰਭ ਸਰਣਾਈ ॥",
      "transliteration": "naanak prabh saranaaee ||",
      "translation": "Nanak has entered God's Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮੁਖਿ ਨਿੰਦਕ ਕੈ ਛਾਈ ॥੨॥੨੨॥੮੬॥",
      "transliteration": "mukh ni(n)dak kai chhaaee ||2||22||86||",
      "translation": "The faces of the slanderers are blackened with ashes. ||2||22||86||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸੋਰਠਿ ਮਹਲਾ ੫ ॥",
      "transliteration": "sorath mahalaa 5 ||",
      "translation": "Sorat'h, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਆਗੈ ਸੁਖੁ ਮੇਰੇ ਮੀਤਾ ॥",
      "transliteration": "aagai sukh mere meetaa ||",
      "translation": "Peace in this world, O my friends,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਪਾਛੇ ਆਨਦੁ ਪ੍ਰਭਿ ਕੀਤਾ ॥",
      "transliteration": "paachhe aanad prabh keetaa ||",
      "translation": "and bliss in the world hereafter - God has given me this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਪਰਮੇਸੁਰਿ ਬਣਤ ਬਣਾਈ ॥",
      "transliteration": "paramesur banat banaaee ||",
      "translation": "The Transcendent Lord has arranged these arrangements;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਫਿਰਿ ਡੋਲਤ ਕਤਹੂ ਨਾਹੀ ॥੧॥",
      "transliteration": "phir dolat katahoo naahee ||1||",
      "translation": "I shall never waver again. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸਾਚੇ ਸਾਹਿਬ ਸਿਉ ਮਨੁ ਮਾਨਿਆ ॥",
      "transliteration": "saache saahib siu man maaniaa ||",
      "translation": "My mind is pleased with the True Lord Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0629_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਹਰਿ ਸਰਬ ਨਿਰੰਤਰਿ ਜਾਨਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har sarab nira(n)tar jaaniaa ||1|| rahaau ||",
      "translation": "I know the Lord to be pervading all. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 629,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
