{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 655,
  "lineCount": 63,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0655_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਜਨ ਭਏ ਖਾਲਸੇ ਪ੍ਰੇਮ ਭਗਤਿ ਜਿਹ ਜਾਨੀ ॥੪॥੩॥",
      "transliteration": "kahu kabeer jan bhae khaalase prem bhagat jih jaanee ||4||3||",
      "translation": "Says Kabeer, those humble people become pure - they become Khalsa - who know the Lord's loving devotional worship. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਘਰੁ ੨ ॥",
      "transliteration": "ghar 2 ||",
      "translation": "Second House||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੁਇ ਦੁਇ ਲੋਚਨ ਪੇਖਾ ॥",
      "transliteration": "dui dui lochan pekhaa ||",
      "translation": "With both of my eyes, I look around;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਉ ਹਰਿ ਬਿਨੁ ਅਉਰੁ ਨ ਦੇਖਾ ॥",
      "transliteration": "hau har bin aur na dekhaa ||",
      "translation": "I don't see anything except the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨੈਨ ਰਹੇ ਰੰਗੁ ਲਾਈ ॥",
      "transliteration": "nain rahe ra(n)g laaee ||",
      "translation": "My eyes gaze lovingly upon Him,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਬ ਬੇ ਗਲ ਕਹਨੁ ਨ ਜਾਈ ॥੧॥",
      "transliteration": "ab be gal kahan na jaaee ||1||",
      "translation": "and now, I cannot speak of anything else. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਮਰਾ ਭਰਮੁ ਗਇਆ ਭਉ ਭਾਗਾ ॥",
      "transliteration": "hamaraa bharam gaiaa bhau bhaagaa ||",
      "translation": "My doubts were removed, and my fear ran away,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਬ ਰਾਮ ਨਾਮ ਚਿਤੁ ਲਾਗਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jab raam naam chit laagaa ||1|| rahaau ||",
      "translation": "when my consciousness became attached to the Lord's Name. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਾਜੀਗਰ ਡੰਕ ਬਜਾਈ ॥",
      "transliteration": "baajeegar da(n)k bajaaee ||",
      "translation": "When the magician beats his tambourine,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਭ ਖਲਕ ਤਮਾਸੇ ਆਈ ॥",
      "transliteration": "sabh khalak tamaase aaee ||",
      "translation": "everyone comes to see the show.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਾਜੀਗਰ ਸ੍ਵਾਂਗੁ ਸਕੇਲਾ ॥",
      "transliteration": "baajeegar svaa(n)g sakelaa ||",
      "translation": "When the magician winds up his show,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਪਨੇ ਰੰਗ ਰਵੈ ਅਕੇਲਾ ॥੨॥",
      "transliteration": "apane ra(n)g ravai akelaa ||2||",
      "translation": "then he enjoys its play all alone. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਥਨੀ ਕਹਿ ਭਰਮੁ ਨ ਜਾਈ ॥",
      "transliteration": "kathanee kahi bharam na jaaee ||",
      "translation": "By preaching sermons, one's doubt is not dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਭ ਕਥਿ ਕਥਿ ਰਹੀ ਲੁਕਾਈ ॥",
      "transliteration": "sabh kath kath rahee lukaaee ||",
      "translation": "Everyone is tired of preaching and teaching.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਾ ਕਉ ਗੁਰਮੁਖਿ ਆਪਿ ਬੁਝਾਈ ॥",
      "transliteration": "jaa kau guramukh aap bujhaaee ||",
      "translation": "The Lord causes the Gurmukh to understand;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਾ ਕੇ ਹਿਰਦੈ ਰਹਿਆ ਸਮਾਈ ॥੩॥",
      "transliteration": "taa ke hiradai rahiaa samaaee ||3||",
      "translation": "his heart remains permeated with the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰ ਕਿੰਚਤ ਕਿਰਪਾ ਕੀਨੀ ॥",
      "transliteration": "gur ki(n)chat kirapaa keenee ||",
      "translation": "When the Guru grants even a bit of His Grace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਭੁ ਤਨੁ ਮਨੁ ਦੇਹ ਹਰਿ ਲੀਨੀ ॥",
      "transliteration": "sabh tan man deh har leenee ||",
      "translation": "one's body, mind and entire being are absorbed into the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਰੰਗਿ ਰਾਤਾ ॥",
      "transliteration": "kahi kabeer ra(n)g raataa ||",
      "translation": "Says Kabeer, I am imbued with the Lord's Love;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਿਲਿਓ ਜਗਜੀਵਨ ਦਾਤਾ ॥੪॥੪॥",
      "transliteration": "milio jagajeevan daataa ||4||4||",
      "translation": "I have met with the Life of the world, the Great Giver. ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾ ਕੇ ਨਿਗਮ ਦੂਧ ਕੇ ਠਾਟਾ ॥",
      "transliteration": "jaa ke nigam doodh ke thaataa ||",
      "translation": "Let the sacred scriptures be your milk and cream,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਮੁੰਦੁ ਬਿਲੋਵਨ ਕਉ ਮਾਟਾ ॥",
      "transliteration": "samu(n)d bilovan kau maataa ||",
      "translation": "and the ocean of the mind the churning vat.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਾ ਕੀ ਹੋਹੁ ਬਿਲੋਵਨਹਾਰੀ ॥",
      "transliteration": "taa kee hohu bilovanahaaree ||",
      "translation": "Be the butter-churner of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਿਉ ਮੇਟੈ ਗੋ ਛਾਛਿ ਤੁਹਾਰੀ ॥੧॥",
      "transliteration": "kiu metai go chhaachh tuhaaree ||1||",
      "translation": "and your buttermilk shall not be wasted. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚੇਰੀ ਤੂ ਰਾਮੁ ਨ ਕਰਸਿ ਭਤਾਰਾ ॥",
      "transliteration": "cheree too raam na karas bhataaraa ||",
      "translation": "O soul-bride slave, why don't you take the Lord as your Husband?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਗਜੀਵਨ ਪ੍ਰਾਨ ਅਧਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jagajeevan praan adhaaraa ||1|| rahaau ||",
      "translation": "He is the Life of the world, the Support of the breath of life. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੇਰੇ ਗਲਹਿ ਤਉਕੁ ਪਗ ਬੇਰੀ ॥",
      "transliteration": "tere galahi tauk pag beree ||",
      "translation": "The chain is around your neck, and the cuffs are on your feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੂ ਘਰ ਘਰ ਰਮਈਐ ਫੇਰੀ ॥",
      "transliteration": "too ghar ghar ramaeeai pheree ||",
      "translation": "The Lord has sent you wandering around from house to house.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੂ ਅਜਹੁ ਨ ਚੇਤਸਿ ਚੇਰੀ ॥",
      "transliteration": "too ajahu na chetas cheree ||",
      "translation": "And still, you do not meditate on the Lord, O soul-bride, slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੂ ਜਮਿ ਬਪੁਰੀ ਹੈ ਹੇਰੀ ॥੨॥",
      "transliteration": "too jam bapuree hai heree ||2||",
      "translation": "Death is watching you, O wretched woman. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪ੍ਰਭ ਕਰਨ ਕਰਾਵਨਹਾਰੀ ॥",
      "transliteration": "prabh karan karaavanahaaree ||",
      "translation": "The Lord God is the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿਆ ਚੇਰੀ ਹਾਥ ਬਿਚਾਰੀ ॥",
      "transliteration": "kiaa cheree haath bichaaree ||",
      "translation": "What is in the hands of the poor soul-bride, the slave?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੋਈ ਸੋਈ ਜਾਗੀ ॥",
      "transliteration": "soee soee jaagee ||",
      "translation": "She awakens from her slumber,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਿਤੁ ਲਾਈ ਤਿਤੁ ਲਾਗੀ ॥੩॥",
      "transliteration": "jit laaee tit laagee ||3||",
      "translation": "and she becomes attached to whatever the Lord attaches her. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚੇਰੀ ਤੈ ਸੁਮਤਿ ਕਹਾਂ ਤੇ ਪਾਈ ॥",
      "transliteration": "cheree tai sumat kahaa(n) te paaee ||",
      "translation": "O soul-bride, slave, where did you obtain that wisdom,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਾ ਤੇ ਭ੍ਰਮ ਕੀ ਲੀਕ ਮਿਟਾਈ ॥",
      "transliteration": "jaa te bhram kee leek mitaaee ||",
      "translation": "by which you erased your inscription of doubt?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁ ਰਸੁ ਕਬੀਰੈ ਜਾਨਿਆ ॥",
      "transliteration": "s ras kabeerai jaaniaa ||",
      "translation": "Kabeer has tasted that subtle essence;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੇਰੋ ਗੁਰ ਪ੍ਰਸਾਦਿ ਮਨੁ ਮਾਨਿਆ ॥੪॥੫॥",
      "transliteration": "mero gur prasaad man maaniaa ||4||5||",
      "translation": "by Guru's Grace, his mind is reconciled with the Lord. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਿਹ ਬਾਝੁ ਨ ਜੀਆ ਜਾਈ ॥",
      "transliteration": "jih baajh na jeeaa jaaee ||",
      "translation": "Without Him, we cannot even live;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਉ ਮਿਲੈ ਤ ਘਾਲ ਅਘਾਈ ॥",
      "transliteration": "jau milai ta ghaal aghaaee ||",
      "translation": "when we meet Him, then our task is completed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਦ ਜੀਵਨੁ ਭਲੋ ਕਹਾਂਹੀ ॥",
      "transliteration": "sad jeevan bhalo kahaa(n)hee ||",
      "translation": "People say it is good to live forever,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮੂਏ ਬਿਨੁ ਜੀਵਨੁ ਨਾਹੀ ॥੧॥",
      "transliteration": "mooe bin jeevan naahee ||1||",
      "translation": "but without dying, there is no life. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਬ ਕਿਆ ਕਥੀਐ ਗਿਆਨੁ ਬੀਚਾਰਾ ॥",
      "transliteration": "ab kiaa katheeai giaan beechaaraa ||",
      "translation": "So now, what sort wisdom should I contemplate and preach?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਿਜ ਨਿਰਖਤ ਗਤ ਬਿਉਹਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "nij nirakhat gat biuhaaraa ||1|| rahaau ||",
      "translation": "As I watch, worldly things dissipate. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਘਸਿ ਕੁੰਕਮ ਚੰਦਨੁ ਗਾਰਿਆ ॥",
      "transliteration": "ghas ku(n)kam cha(n)dan gaariaa ||",
      "translation": "Saffron is ground up, and mixed with sandalwood;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਿਨੁ ਨੈਨਹੁ ਜਗਤੁ ਨਿਹਾਰਿਆ ॥",
      "transliteration": "bin nainahu jagat nihaariaa ||",
      "translation": "without eyes, the world is seen.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪੂਤਿ ਪਿਤਾ ਇਕੁ ਜਾਇਆ ॥",
      "transliteration": "poot pitaa ik jaaiaa ||",
      "translation": "The son has given birth to his father;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਿਨੁ ਠਾਹਰ ਨਗਰੁ ਬਸਾਇਆ ॥੨॥",
      "transliteration": "bin thaahar nagar basaaiaa ||2||",
      "translation": "without a place, the city has been established. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਾਚਕ ਜਨ ਦਾਤਾ ਪਾਇਆ ॥",
      "transliteration": "jaachak jan daataa paaiaa ||",
      "translation": "The humble beggar has found the Great Giver,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੋ ਦੀਆ ਨ ਜਾਈ ਖਾਇਆ ॥",
      "transliteration": "so deeaa na jaaee khaaiaa ||",
      "translation": "but he is unable to eat what he has been given.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਛੋਡਿਆ ਜਾਇ ਨ ਮੂਕਾ ॥",
      "transliteration": "chhodiaa jaai na mookaa ||",
      "translation": "He cannot leave it alone, but it is never exhausted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਉਰਨ ਪਹਿ ਜਾਨਾ ਚੂਕਾ ॥੩॥",
      "transliteration": "auran pahi jaanaa chookaa ||3||",
      "translation": "He shall not go to beg from others any longer. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜੋ ਜੀਵਨ ਮਰਨਾ ਜਾਨੈ ॥",
      "transliteration": "jo jeevan maranaa jaanai ||",
      "translation": "Those select few, who know how to die while yet alive,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੋ ਪੰਚ ਸੈਲ ਸੁਖ ਮਾਨੈ ॥",
      "transliteration": "so pa(n)ch sail sukh maanai ||",
      "translation": "Enjoy great peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਬੀਰੈ ਸੋ ਧਨੁ ਪਾਇਆ ॥",
      "transliteration": "kabeerai so dhan paaiaa ||",
      "translation": "Kabeer has found that wealth;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਹਰਿ ਭੇਟਤ ਆਪੁ ਮਿਟਾਇਆ ॥੪॥੬॥",
      "transliteration": "har bhetat aap mitaaiaa ||4||6||",
      "translation": "meeting with the Lord, he has erased his self-conceit. ||4||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਕਿਆ ਪੜੀਐ ਕਿਆ ਗੁਨੀਐ ॥",
      "transliteration": "kiaa paReeai kiaa guneeai ||",
      "translation": "What use is it to read, and what use is it to study?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਕਿਆ ਬੇਦ ਪੁਰਾਨਾਂ ਸੁਨੀਐ ॥",
      "transliteration": "kiaa bed puraanaa(n) suneeai ||",
      "translation": "What use is it to listen to the Vedas and the Puraanas?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਪੜੇ ਸੁਨੇ ਕਿਆ ਹੋਈ ॥",
      "transliteration": "paRe sune kiaa hoee ||",
      "translation": "What use is reading and listening,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜਉ ਸਹਜ ਨ ਮਿਲਿਓ ਸੋਈ ॥੧॥",
      "transliteration": "jau sahaj na milio soee ||1||",
      "translation": "if celestial peace is not attained? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਨ ਜਪਸਿ ਗਵਾਰਾ ॥",
      "transliteration": "har kaa naam na japas gavaaraa ||",
      "translation": "The fool does not chant the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਕਿਆ ਸੋਚਹਿ ਬਾਰੰ ਬਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kiaa sochahi baara(n) baaraa ||1|| rahaau ||",
      "translation": "So what does he think of, over and over again? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0655_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਅੰਧਿਆਰੇ ਦੀਪਕੁ ਚਹੀਐ ॥",
      "transliteration": "a(n)dhiaare deepak chaheeai ||",
      "translation": "In the darkness, we need a lamp",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 655,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
