{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 656,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0656_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਕ ਬਸਤੁ ਅਗੋਚਰ ਲਹੀਐ ॥",
      "transliteration": "ik basat agochar laheeai ||",
      "translation": "to find the incomprehensible thing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਸਤੁ ਅਗੋਚਰ ਪਾਈ ॥",
      "transliteration": "basat agochar paaee ||",
      "translation": "I have found this incomprehensible thing;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਘਟਿ ਦੀਪਕੁ ਰਹਿਆ ਸਮਾਈ ॥੨॥",
      "transliteration": "ghat deepak rahiaa samaaee ||2||",
      "translation": "my mind is illuminated and enlightened. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਅਬ ਜਾਨਿਆ ॥",
      "transliteration": "kahi kabeer ab jaaniaa ||",
      "translation": "Says Kabeer, now I know Him;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਬ ਜਾਨਿਆ ਤਉ ਮਨੁ ਮਾਨਿਆ ॥",
      "transliteration": "jab jaaniaa tau man maaniaa ||",
      "translation": "since I know Him, my mind is pleased and appeased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਨ ਮਾਨੇ ਲੋਗੁ ਨ ਪਤੀਜੈ ॥",
      "transliteration": "man maane log na pateejai ||",
      "translation": "My mind is pleased and appeased, and yet, people do not believe it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨ ਪਤੀਜੈ ਤਉ ਕਿਆ ਕੀਜੈ ॥੩॥੭॥",
      "transliteration": "na pateejai tau kiaa keejai ||3||7||",
      "translation": "They do not believe it, so what can I do? ||3||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹ੍ਰਿਦੈ ਕਪਟੁ ਮੁਖ ਗਿਆਨੀ ॥",
      "transliteration": "hridai kapat mukh giaanee ||",
      "translation": "In his heart there is deception, and yet in his mouth are words of wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਝੂਠੇ ਕਹਾ ਬਿਲੋਵਸਿ ਪਾਨੀ ॥੧॥",
      "transliteration": "jhoothe kahaa bilovas paanee ||1||",
      "translation": "You are false - why are you churning water? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਂਇਆ ਮਾਂਜਸਿ ਕਉਨ ਗੁਨਾਂ ॥",
      "transliteration": "kaa(n)iaa maa(n)jas kaun gunaa(n) ||",
      "translation": "Why do you bother to wash your body?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਉ ਘਟ ਭੀਤਰਿ ਹੈ ਮਲਨਾਂ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jau ghat bheetar hai malanaa(n) ||1|| rahaau ||",
      "translation": "Your heart is still full of filth. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਲਉਕੀ ਅਠਸਠਿ ਤੀਰਥ ਨੑਾਈ ॥",
      "transliteration": "laukee athasath teerath nhaaee ||",
      "translation": "The gourd may be washed at the sixty-eight sacred shrines,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਉਰਾਪਨੁ ਤਊ ਨ ਜਾਈ ॥੨॥",
      "transliteration": "kauraapan taoo na jaaee ||2||",
      "translation": "but even then, its bitterness is not removed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਬੀਚਾਰੀ ॥",
      "transliteration": "kahi kabeer beechaaree ||",
      "translation": "Says Kabeer after deep contemplation,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਵ ਸਾਗਰੁ ਤਾਰਿ ਮੁਰਾਰੀ ॥੩॥੮॥",
      "transliteration": "bhav saagar taar muraaree ||3||8||",
      "translation": "please help me cross over the terrifying world-ocean, O Lord, O Destroyer of ego. ||3||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੋਰਠਿ ॥",
      "transliteration": "sorath ||",
      "translation": "Sorat'h:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਹੁ ਪਰਪੰਚ ਕਰਿ ਪਰ ਧਨੁ ਲਿਆਵੈ ॥",
      "transliteration": "bahu parapa(n)ch kar par dhan liaavai ||",
      "translation": "Practicing great hypocrisy, he acquires the wealth of others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੁਤ ਦਾਰਾ ਪਹਿ ਆਨਿ ਲੁਟਾਵੈ ॥੧॥",
      "transliteration": "sut daaraa pahi aan lutaavai ||1||",
      "translation": "Returning home, he squanders it on his wife and children. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਨ ਮੇਰੇ ਭੂਲੇ ਕਪਟੁ ਨ ਕੀਜੈ ॥",
      "transliteration": "man mere bhoole kapat na keejai ||",
      "translation": "O my mind, do not practice deception, even inadvertently.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅੰਤਿ ਨਿਬੇਰਾ ਤੇਰੇ ਜੀਅ ਪਹਿ ਲੀਜੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "a(n)t niberaa tere jee pahi leejai ||1|| rahaau ||",
      "translation": "In the end, your own soul shall have to answer for its account. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਛਿਨੁ ਛਿਨੁ ਤਨੁ ਛੀਜੈ ਜਰਾ ਜਨਾਵੈ ॥",
      "transliteration": "chhin chhin tan chheejai jaraa janaavai ||",
      "translation": "Moment by moment, the body is wearing away, and old age is asserting itself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਬ ਤੇਰੀ ਓਕ ਕੋਈ ਪਾਨੀਓ ਨ ਪਾਵੈ ॥੨॥",
      "transliteration": "tab teree ok koee paaneeo na paavai ||2||",
      "translation": "And then, when you are old, no one shall pour water into your cup. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਹਤੁ ਕਬੀਰੁ ਕੋਈ ਨਹੀ ਤੇਰਾ ॥",
      "transliteration": "kahat kabeer koee nahee teraa ||",
      "translation": "Says Kabeer, no one belongs to you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਿਰਦੈ ਰਾਮੁ ਕੀ ਨ ਜਪਹਿ ਸਵੇਰਾ ॥੩॥੯॥",
      "transliteration": "hiradai raam kee na japahi saveraa ||3||9||",
      "translation": "Why not chant the Lord's Name in your heart, when you are still young? ||3||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੰਤਹੁ ਮਨ ਪਵਨੈ ਸੁਖੁ ਬਨਿਆ ॥",
      "transliteration": "sa(n)tahu man pavanai sukh baniaa ||",
      "translation": "O Saints, my windy mind has now become peaceful and still.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਿਛੁ ਜੋਗੁ ਪਰਾਪਤਿ ਗਨਿਆ ॥ ਰਹਾਉ ॥",
      "transliteration": "kichh jog paraapat ganiaa || rahaau ||",
      "translation": "It seems that I have learned something of the science of Yoga. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੁਰਿ ਦਿਖਲਾਈ ਮੋਰੀ ॥",
      "transliteration": "gur dikhalaaee moree ||",
      "translation": "The Guru has shown me the hole,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਤੁ ਮਿਰਗ ਪੜਤ ਹੈ ਚੋਰੀ ॥",
      "transliteration": "jit mirag paRat hai choree ||",
      "translation": "through which the deer carefully enters.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮੂੰਦਿ ਲੀਏ ਦਰਵਾਜੇ ॥",
      "transliteration": "moo(n)d leee daravaaje ||",
      "translation": "I have now closed off the doors,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਾਜੀਅਲੇ ਅਨਹਦ ਬਾਜੇ ॥੧॥",
      "transliteration": "baajeeale anahad baaje ||1||",
      "translation": "and the unstruck celestial sound current resounds. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕੁੰਭ ਕਮਲੁ ਜਲਿ ਭਰਿਆ ॥",
      "transliteration": "ku(n)bh kamal jal bhariaa ||",
      "translation": "The pitcher of my heart-lotus is filled with water;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਲੁ ਮੇਟਿਆ ਊਭਾ ਕਰਿਆ ॥",
      "transliteration": "jal metiaa oobhaa kariaa ||",
      "translation": "I have spilled out the water, and set it upright.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਜਨ ਜਾਨਿਆ ॥",
      "transliteration": "kahu kabeer jan jaaniaa ||",
      "translation": "Says Kabeer, the Lord's humble servant, this I know.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਉ ਜਾਨਿਆ ਤਉ ਮਨੁ ਮਾਨਿਆ ॥੨॥੧੦॥",
      "transliteration": "jau jaaniaa tau man maaniaa ||2||10||",
      "translation": "Now that I know this, my mind is pleased and appeased. ||2||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਾਗੁ ਸੋਰਠਿ ॥",
      "transliteration": "raag sorath ||",
      "translation": "Raag Sorat'h:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭੂਖੇ ਭਗਤਿ ਨ ਕੀਜੈ ॥",
      "transliteration": "bhookhe bhagat na keejai ||",
      "translation": "I am so hungry, I cannot perform devotional worship service.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਯਹ ਮਾਲਾ ਅਪਨੀ ਲੀਜੈ ॥",
      "transliteration": "yah maalaa apanee leejai ||",
      "translation": "Here, Lord, take back Your mala.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਉ ਮਾਂਗਉ ਸੰਤਨ ਰੇਨਾ ॥",
      "transliteration": "hau maa(n)gau sa(n)tan renaa ||",
      "translation": "I beg for the dust of the feet of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮੈ ਨਾਹੀ ਕਿਸੀ ਕਾ ਦੇਨਾ ॥੧॥",
      "transliteration": "mai naahee kisee kaa denaa ||1||",
      "translation": "I do not owe anyone anything. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਾਧੋ ਕੈਸੀ ਬਨੈ ਤੁਮ ਸੰਗੇ ॥",
      "transliteration": "maadho kaisee banai tum sa(n)ge ||",
      "translation": "O Lord, how can I be with You?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਪਿ ਨ ਦੇਹੁ ਤ ਲੇਵਉ ਮੰਗੇ ॥ ਰਹਾਉ ॥",
      "transliteration": "aap na dehu ta levau ma(n)ge || rahaau ||",
      "translation": "If You do not give me Yourself, then I shall beg until I get You. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੁਇ ਸੇਰ ਮਾਂਗਉ ਚੂਨਾ ॥",
      "transliteration": "dui ser maa(n)gau choonaa ||",
      "translation": "I ask for two kilos of flour,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਾਉ ਘੀਉ ਸੰਗਿ ਲੂਨਾ ॥",
      "transliteration": "paau gheeu sa(n)g loonaa ||",
      "translation": "and half a pound of ghee, and salt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਧ ਸੇਰੁ ਮਾਂਗਉ ਦਾਲੇ ॥",
      "transliteration": "adh ser maa(n)gau daale ||",
      "translation": "I ask for a pound of beans,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੋ ਕਉ ਦੋਨਉ ਵਖਤ ਜਿਵਾਲੇ ॥੨॥",
      "transliteration": "mo kau donau vakhat jivaale ||2||",
      "translation": "which I shall eat twice a day. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਖਾਟ ਮਾਂਗਉ ਚਉਪਾਈ ॥",
      "transliteration": "khaat maa(n)gau chaupaaee ||",
      "translation": "I ask for a cot, with four legs,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਿਰਹਾਨਾ ਅਵਰ ਤੁਲਾਈ ॥",
      "transliteration": "sirahaanaa avar tulaaee ||",
      "translation": "and a pillow and mattress.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਊਪਰ ਕਉ ਮਾਂਗਉ ਖੀਂਧਾ ॥",
      "transliteration": "oopar kau maa(n)gau khee(n)dhaa ||",
      "translation": "I ask for a quilt to cover myself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤੇਰੀ ਭਗਤਿ ਕਰੈ ਜਨੁ ਥਂੀਧਾ ॥੩॥",
      "transliteration": "teree bhagat karai jan tha(n)eedhaa ||3||",
      "translation": "Your humble servant shall perform Your devotional worship service with love. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮੈ ਨਾਹੀ ਕੀਤਾ ਲਬੋ ॥",
      "transliteration": "mai naahee keetaa labo ||",
      "translation": "I have no greed;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਇਕੁ ਨਾਉ ਤੇਰਾ ਮੈ ਫਬੋ ॥",
      "transliteration": "ik naau teraa mai phabo ||",
      "translation": "Your Name is the only ornament I wish for.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਮਨੁ ਮਾਨਿਆ ॥",
      "transliteration": "kahi kabeer man maaniaa ||",
      "translation": "Says Kabeer, my mind is pleased and appeased;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮਨੁ ਮਾਨਿਆ ਤਉ ਹਰਿ ਜਾਨਿਆ ॥੪॥੧੧॥",
      "transliteration": "man maaniaa tau har jaaniaa ||4||11||",
      "translation": "now that my mind is pleased and appeased, I have come to know the Lord. ||4||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਰਾਗੁ ਸੋਰਠਿ ਬਾਣੀ ਭਗਤ ਨਾਮਦੇ ਜੀ ਕੀ ਘਰੁ ੨ ॥",
      "transliteration": "raag sorath baanee bhagat naamade jee kee ghar 2 ||",
      "translation": "Raag Sorat'h, The Word Of Devotee Naam Dayv Jee, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਬ ਦੇਖਾ ਤਬ ਗਾਵਾ ॥",
      "transliteration": "jab dekhaa tab gaavaa ||",
      "translation": "When I see Him, I sing His Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0656_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤਉ ਜਨ ਧੀਰਜੁ ਪਾਵਾ ॥੧॥",
      "transliteration": "tau jan dheeraj paavaa ||1||",
      "translation": "Then I, his humble servant, become patient. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 656,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
