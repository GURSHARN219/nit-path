{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 657,
  "lineCount": 48,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0657_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਦਿ ਸਮਾਇਲੋ ਰੇ ਸਤਿਗੁਰੁ ਭੇਟਿਲੇ ਦੇਵਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naad samaailo re satigur bhetile devaa ||1|| rahaau ||",
      "translation": "Meeting the Divine True Guru, I merge into the sound current of the Naad. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਹ ਝਿਲਿ ਮਿਲਿ ਕਾਰੁ ਦਿਸੰਤਾ ॥",
      "transliteration": "jah jhil mil kaar disa(n)taa ||",
      "translation": "Where the dazzling white light is seen,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਹ ਅਨਹਦ ਸਬਦ ਬਜੰਤਾ ॥",
      "transliteration": "tah anahad sabad baja(n)taa ||",
      "translation": "there the unstruck sound current of the Shabad resounds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੋਤੀ ਜੋਤਿ ਸਮਾਨੀ ॥",
      "transliteration": "jotee jot samaanee ||",
      "translation": "One's light merges in the Light;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮੈ ਗੁਰ ਪਰਸਾਦੀ ਜਾਨੀ ॥੨॥",
      "transliteration": "mai gur parasaadee jaanee ||2||",
      "translation": "by Guru's Grace, I know this. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਤਨ ਕਮਲ ਕੋਠਰੀ ॥",
      "transliteration": "ratan kamal kotharee ||",
      "translation": "The jewels are in the treasure chamber of the heart-lotus.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚਮਕਾਰ ਬੀਜੁਲ ਤਹੀ ॥",
      "transliteration": "chamakaar beejul tahee ||",
      "translation": "They sparkle and glitter like lightning.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨੇਰੈ ਨਾਹੀ ਦੂਰਿ ॥",
      "transliteration": "nerai naahee door ||",
      "translation": "The Lord is near at hand, not far away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਿਜ ਆਤਮੈ ਰਹਿਆ ਭਰਪੂਰਿ ॥੩॥",
      "transliteration": "nij aatamai rahiaa bharapoor ||3||",
      "translation": "He is totally permeating and pervading in my soul. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਹ ਅਨਹਤ ਸੂਰ ਉਜੵਾਰਾ ॥",
      "transliteration": "jah anahat soor ujyaaraa ||",
      "translation": "Where the light of the undying sun shines,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਹ ਦੀਪਕ ਜਲੈ ਛੰਛਾਰਾ ॥",
      "transliteration": "tah deepak jalai chha(n)chhaaraa ||",
      "translation": "the light of burning lamps seems insignificant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਜਾਨਿਆ ॥",
      "transliteration": "gur parasaadee jaaniaa ||",
      "translation": "By Guru's Grace, I know this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਨੁ ਨਾਮਾ ਸਹਜ ਸਮਾਨਿਆ ॥੪॥੧॥",
      "transliteration": "jan naamaa sahaj samaaniaa ||4||1||",
      "translation": "Servant Naam Dayv is absorbed in the Celestial Lord. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਘਰੁ ੪ ਸੋਰਠਿ ॥",
      "transliteration": "ghar 4 sorath ||",
      "translation": "Fourth House, Sorat'h:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਾੜ ਪੜੋਸਣਿ ਪੂਛਿ ਲੇ ਨਾਮਾ ਕਾ ਪਹਿ ਛਾਨਿ ਛਵਾਈ ਹੋ ॥",
      "transliteration": "paaR paRosan poochh le naamaa kaa pahi chhaan chhavaaee ho ||",
      "translation": "The woman next door asked Naam Dayv, \"Who built your house?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤੋ ਪਹਿ ਦੁਗਣੀ ਮਜੂਰੀ ਦੈਹਉ ਮੋ ਕਉ ਬੇਢੀ ਦੇਹੁ ਬਤਾਈ ਹੋ ॥੧॥",
      "transliteration": "to pahi duganee majooree daihau mo kau bedhee dehu bataaee ho ||1||",
      "translation": "I shall pay him double wages. Tell me, who is your carpenter?\" ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰੀ ਬਾਈ ਬੇਢੀ ਦੇਨੁ ਨ ਜਾਈ ॥",
      "transliteration": "ree baaee bedhee den na jaaee ||",
      "translation": "O sister, I cannot give this carpenter to you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੇਖੁ ਬੇਢੀ ਰਹਿਓ ਸਮਾਈ ॥",
      "transliteration": "dekh bedhee rahio samaaee ||",
      "translation": "Behold, my carpenter is pervading everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਮਾਰੈ ਬੇਢੀ ਪ੍ਰਾਨ ਅਧਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "hamaarai bedhee praan adhaaraa ||1|| rahaau ||",
      "translation": "My carpenter is the Support of the breath of life. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬੇਢੀ ਪ੍ਰੀਤਿ ਮਜੂਰੀ ਮਾਂਗੈ ਜਉ ਕੋਊ ਛਾਨਿ ਛਵਾਵੈ ਹੋ ॥",
      "transliteration": "bedhee preet majooree maa(n)gai jau kooo chhaan chhavaavai ho ||",
      "translation": "This carpenter demands the wages of love, if someone wants Him to build their house.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਲੋਗ ਕੁਟੰਬ ਸਭਹੁ ਤੇ ਤੋਰੈ ਤਉ ਆਪਨ ਬੇਢੀ ਆਵੈ ਹੋ ॥੨॥",
      "transliteration": "log kuta(n)b sabhahu te torai tau aapan bedhee aavai ho ||2||",
      "translation": "When one breaks his ties with all the people and relatives, then the carpenter comes of His own accord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਐਸੋ ਬੇਢੀ ਬਰਨਿ ਨ ਸਾਕਉ ਸਭ ਅੰਤਰ ਸਭ ਠਾਂਈ ਹੋ ॥",
      "transliteration": "aiso bedhee baran na saakau sabh a(n)tar sabh thaa(n)ee ho ||",
      "translation": "I cannot describe such a carpenter, who is contained in everything, everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੂੰਗੈ ਮਹਾ ਅੰਮ੍ਰਿਤ ਰਸੁ ਚਾਖਿਆ ਪੂਛੇ ਕਹਨੁ ਨ ਜਾਈ ਹੋ ॥੩॥",
      "transliteration": "goo(n)gai mahaa a(n)mrit ras chaakhiaa poochhe kahan na jaaee ho ||3||",
      "translation": "The mute tastes the most sublime ambrosial nectar, but if you ask him to describe it, he cannot. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬੇਢੀ ਕੇ ਗੁਣ ਸੁਨਿ ਰੀ ਬਾਈ ਜਲਧਿ ਬਾਂਧਿ ਧ੍ਰੂ ਥਾਪਿਓ ਹੋ ॥",
      "transliteration": "bedhee ke gun sun ree baaee jaladh baa(n)dh dhroo thaapio ho ||",
      "translation": "Listen to the virtues of this carpenter, O sister; He stopped the oceans, and established Dhroo as the pole star.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਮੇ ਕੇ ਸੁਆਮੀ ਸੀਅ ਬਹੋਰੀ ਲੰਕ ਭਭੀਖਣ ਆਪਿਓ ਹੋ ॥੪॥੨॥",
      "transliteration": "naame ke suaamee see bahoree la(n)k bhabheekhan aapio ho ||4||2||",
      "translation": "Naam Dayv's Lord Master brought Sita back, and gave Sri Lanka to Bhabheekhan. ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੋਰਠਿ ਘਰੁ ੩ ॥",
      "transliteration": "sorath ghar 3 ||",
      "translation": "Sorat'h, Third House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਣਮੜਿਆ ਮੰਦਲੁ ਬਾਜੈ ॥",
      "transliteration": "anamaRiaa ma(n)dal baajai ||",
      "translation": "The skinless drum plays.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਿਨੁ ਸਾਵਣ ਘਨਹਰੁ ਗਾਜੈ ॥",
      "transliteration": "bin saavan ghanahar gaajai ||",
      "translation": "Without the rainy season, the clouds shake with thunder.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਾਦਲ ਬਿਨੁ ਬਰਖਾ ਹੋਈ ॥",
      "transliteration": "baadal bin barakhaa hoee ||",
      "translation": "Without clouds, the rain falls,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਉ ਤਤੁ ਬਿਚਾਰੈ ਕੋਈ ॥੧॥",
      "transliteration": "jau tat bichaarai koee ||1||",
      "translation": "if one contemplates the essence of reality. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੋ ਕਉ ਮਿਲਿਓ ਰਾਮੁ ਸਨੇਹੀ ॥",
      "transliteration": "mo kau milio raam sanehee ||",
      "translation": "I have met my Beloved Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਹ ਮਿਲਿਐ ਦੇਹ ਸੁਦੇਹੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jih miliai deh sudehee ||1|| rahaau ||",
      "translation": "Meeting with Him, my body is made beauteous and sublime. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਿਲਿ ਪਾਰਸ ਕੰਚਨੁ ਹੋਇਆ ॥",
      "transliteration": "mil paaras ka(n)chan hoiaa ||",
      "translation": "Touching the philosopher's stone, I have been transformed into gold.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮੁਖ ਮਨਸਾ ਰਤਨੁ ਪਰੋਇਆ ॥",
      "transliteration": "mukh manasaa ratan paroiaa ||",
      "translation": "I have threaded the jewels into my mouth and mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਿਜ ਭਾਉ ਭਇਆ ਭ੍ਰਮੁ ਭਾਗਾ ॥",
      "transliteration": "nij bhaau bhaiaa bhram bhaagaa ||",
      "translation": "I love Him as my own, and my doubt has been dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰ ਪੂਛੇ ਮਨੁ ਪਤੀਆਗਾ ॥੨॥",
      "transliteration": "gur poochhe man pateeaagaa ||2||",
      "translation": "Seeking the Guru's guidance, my mind is content. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਲ ਭੀਤਰਿ ਕੁੰਭ ਸਮਾਨਿਆ ॥",
      "transliteration": "jal bheetar ku(n)bh samaaniaa ||",
      "translation": "The water is contained within the pitcher;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭ ਰਾਮੁ ਏਕੁ ਕਰਿ ਜਾਨਿਆ ॥",
      "transliteration": "sabh raam ek kar jaaniaa ||",
      "translation": "I know that the One Lord is contained in all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰ ਚੇਲੇ ਹੈ ਮਨੁ ਮਾਨਿਆ ॥",
      "transliteration": "gur chele hai man maaniaa ||",
      "translation": "The mind of the disciple has faith in the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਨ ਨਾਮੈ ਤਤੁ ਪਛਾਨਿਆ ॥੩॥੩॥",
      "transliteration": "jan naamai tat pachhaaniaa ||3||3||",
      "translation": "Servant Naam Dayv understands the essence of reality. ||3||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਾਗੁ ਸੋਰਠਿ ਬਾਣੀ ਭਗਤ ਰਵਿਦਾਸ ਜੀ ਕੀ ॥",
      "transliteration": "raag sorath baanee bhagat ravidaas jee kee ||",
      "translation": "Raag Sorat'h, The Word Of Devotee Ravi Daas Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਬ ਹਮ ਹੋਤੇ ਤਬ ਤੂ ਨਾਹੀ ਅਬ ਤੂਹੀ ਮੈ ਨਾਹੀ ॥",
      "transliteration": "jab ham hote tab too naahee ab toohee mai naahee ||",
      "translation": "When I am in my ego, then You are not with me. Now that You are with me, there is no egotism within me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਨਲ ਅਗਮ ਜੈਸੇ ਲਹਰਿ ਮਇ ਓਦਧਿ ਜਲ ਕੇਵਲ ਜਲ ਮਾਂਹੀ ॥੧॥",
      "transliteration": "anal agam jaise lahar mai odadh jal keval jal maa(n)hee ||1||",
      "translation": "The wind may raise up huge waves in the vast ocean, but they are just water in water. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਾਧਵੇ ਕਿਆ ਕਹੀਐ ਭ੍ਰਮੁ ਐਸਾ ॥",
      "transliteration": "maadhave kiaa kaheeai bhram aisaa ||",
      "translation": "O Lord, what can I say about such an illusion?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੈਸਾ ਮਾਨੀਐ ਹੋਇ ਨ ਤੈਸਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaisaa maaneeai hoi na taisaa ||1|| rahaau ||",
      "translation": "Things are not as they seem. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਰਪਤਿ ਏਕੁ ਸਿੰਘਾਸਨਿ ਸੋਇਆ ਸੁਪਨੇ ਭਇਆ ਭਿਖਾਰੀ ॥",
      "transliteration": "narapat ek si(n)ghaasan soiaa supane bhaiaa bhikhaaree ||",
      "translation": "It is like the king, who falls asleep upon his throne, and dreams that he is a beggar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0657_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਛਤ ਰਾਜ ਬਿਛੁਰਤ ਦੁਖੁ ਪਾਇਆ ਸੋ ਗਤਿ ਭਈ ਹਮਾਰੀ ॥੨॥",
      "transliteration": "achhat raaj bichhurat dukh paaiaa so gat bhaee hamaaree ||2||",
      "translation": "His kingdom is intact, but separated from it, he suffers in sorrow. Such is my own condition. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 657,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
