{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 661,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0661_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਬ ਲਗੁ ਦੁਨੀਆ ਰਹੀਐ ਨਾਨਕ ਕਿਛੁ ਸੁਣੀਐ ਕਿਛੁ ਕਹੀਐ ॥",
      "transliteration": "jab lag duneeaa raheeai naanak kichh suneeai kichh kaheeai ||",
      "translation": "As long as we are in this world, O Nanak, we should listen, and speak of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭਾਲਿ ਰਹੇ ਹਮ ਰਹਣੁ ਨ ਪਾਇਆ ਜੀਵਤਿਆ ਮਰਿ ਰਹੀਐ ॥੫॥੨॥",
      "transliteration": "bhaal rahe ham rahan na paaiaa jeevatiaa mar raheeai ||5||2||",
      "translation": "I have searched, but I have found no way to remain here; so, remain dead while yet alive. ||5||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੧ ਘਰੁ ਦੂਜਾ ॥",
      "transliteration": "dhanaasaree mahalaa 1 ghar doojaa ||",
      "translation": "Dhanaasaree, First Mehl, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿਉ ਸਿਮਰੀ ਸਿਵਰਿਆ ਨਹੀ ਜਾਇ ॥",
      "transliteration": "kiu simaree sivariaa nahee jaai ||",
      "translation": "How can I remember the Lord in meditation? I cannot meditate on Him in remembrance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਪੈ ਹਿਆਉ ਜੀਅੜਾ ਬਿਲਲਾਇ ॥",
      "transliteration": "tapai hiaau jeeaRaa bilalaai ||",
      "translation": "My heart is burning, and my soul is crying out in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਿਰਜਿ ਸਵਾਰੇ ਸਾਚਾ ਸੋਇ ॥",
      "transliteration": "siraj savaare saachaa soi ||",
      "translation": "The True Lord creates and adorns.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਿਸੁ ਵਿਸਰਿਐ ਚੰਗਾ ਕਿਉ ਹੋਇ ॥੧॥",
      "transliteration": "tis visariai cha(n)gaa kiu hoi ||1||",
      "translation": "Forgetting Him, how can one be good? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਿਕਮਤਿ ਹੁਕਮਿ ਨ ਪਾਇਆ ਜਾਇ ॥",
      "transliteration": "hikamat hukam na paaiaa jaai ||",
      "translation": "By clever tricks and commands, He cannot be found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿਉ ਕਰਿ ਸਾਚਿ ਮਿਲਉ ਮੇਰੀ ਮਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kiu kar saach milau meree maai ||1|| rahaau ||",
      "translation": "How am I to meet my True Lord, O my mother? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਵਖਰੁ ਨਾਮੁ ਦੇਖਣ ਕੋਈ ਜਾਇ ॥",
      "transliteration": "vakhar naam dekhan koee jaai ||",
      "translation": "How rare is the one who goes out, and searches for the merchandise of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾ ਕੋ ਚਾਖੈ ਨਾ ਕੋ ਖਾਇ ॥",
      "transliteration": "naa ko chaakhai naa ko khaai ||",
      "translation": "No one tastes it, and no one eats it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਲੋਕਿ ਪਤੀਣੈ ਨਾ ਪਤਿ ਹੋਇ ॥",
      "transliteration": "lok pateenai naa pat hoi ||",
      "translation": "Honor is not obtained by trying to please other people.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾ ਪਤਿ ਰਹੈ ਰਾਖੈ ਜਾ ਸੋਇ ॥੨॥",
      "transliteration": "taa pat rahai raakhai jaa soi ||2||",
      "translation": "One's honor is preserved, only if the Lord preserves it. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਹ ਦੇਖਾ ਤਹ ਰਹਿਆ ਸਮਾਇ ॥",
      "transliteration": "jah dekhaa tah rahiaa samaai ||",
      "translation": "Wherever I look, there I see Him, pervading and permeating.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤੁਧੁ ਬਿਨੁ ਦੂਜੀ ਨਾਹੀ ਜਾਇ ॥",
      "transliteration": "tudh bin doojee naahee jaai ||",
      "translation": "Without You, I have no other place of rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੇ ਕੋ ਕਰੇ ਕੀਤੈ ਕਿਆ ਹੋਇ ॥",
      "transliteration": "je ko kare keetai kiaa hoi ||",
      "translation": "He may try, but what can anyone do by his own doing?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਸ ਨੋ ਬਖਸੇ ਸਾਚਾ ਸੋਇ ॥੩॥",
      "transliteration": "jis no bakhase saachaa soi ||3||",
      "translation": "He alone is blessed, whom the True Lord forgives. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹੁਣਿ ਉਠਿ ਚਲਣਾ ਮੁਹਤਿ ਕਿ ਤਾਲਿ ॥",
      "transliteration": "hun uth chalanaa muhat k taal ||",
      "translation": "Now, I shall have to get up and depart, in an instant, in the clapping of hands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਿਆ ਮੁਹੁ ਦੇਸਾ ਗੁਣ ਨਹੀ ਨਾਲਿ ॥",
      "transliteration": "kiaa muhu desaa gun nahee naal ||",
      "translation": "What face will I show the Lord? I have no virtue at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੈਸੀ ਨਦਰਿ ਕਰੇ ਤੈਸਾ ਹੋਇ ॥",
      "transliteration": "jaisee nadar kare taisaa hoi ||",
      "translation": "As is the Lord's Glance of Grace, so it is.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਵਿਣੁ ਨਦਰੀ ਨਾਨਕ ਨਹੀ ਕੋਇ ॥੪॥੧॥੩॥",
      "transliteration": "vin nadaree naanak nahee koi ||4||1||3||",
      "translation": "Without His Glance of Grace, O Nanak, no one is blessed. ||4||1||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "dhanaasaree mahalaa 1 ||",
      "translation": "Dhanaasaree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਤਾ ਸਿਮਰਿਆ ਜਾਇ ॥",
      "transliteration": "nadar kare taa simariaa jaai ||",
      "translation": "If the Lord bestows His Glance of Grace, then one remembers Him in meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਤਮਾ ਦ੍ਰਵੈ ਰਹੈ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "aatamaa dravai rahai liv laai ||",
      "translation": "The soul is softened, and he remains absorbed in the Lord's Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਤਮਾ ਪਰਾਤਮਾ ਏਕੋ ਕਰੈ ॥",
      "transliteration": "aatamaa paraatamaa eko karai ||",
      "translation": "His soul and the Supreme Soul become one.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅੰਤਰ ਕੀ ਦੁਬਿਧਾ ਅੰਤਰਿ ਮਰੈ ॥੧॥",
      "transliteration": "a(n)tar kee dubidhaa a(n)tar marai ||1||",
      "translation": "The duality of the inner mind is overcome. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਪਾਇਆ ਜਾਇ ॥",
      "transliteration": "gur parasaadee paaiaa jaai ||",
      "translation": "By Guru's Grace, God is found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਰਿ ਸਿਉ ਚਿਤੁ ਲਾਗੈ ਫਿਰਿ ਕਾਲੁ ਨ ਖਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har siu chit laagai phir kaal na khaai ||1|| rahaau ||",
      "translation": "One's consciousness is attached to the Lord, and so Death does not devour him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਚਿ ਸਿਮਰਿਐ ਹੋਵੈ ਪਰਗਾਸੁ ॥",
      "transliteration": "sach simariai hovai paragaas ||",
      "translation": "Remembering the True Lord in meditation, one is enlightened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਾ ਤੇ ਬਿਖਿਆ ਮਹਿ ਰਹੈ ਉਦਾਸੁ ॥",
      "transliteration": "taa te bikhiaa mahi rahai udaas ||",
      "translation": "Then, in the midst of Maya, he remains detached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਤਿਗੁਰ ਕੀ ਐਸੀ ਵਡਿਆਈ ॥",
      "transliteration": "satigur kee aisee vadiaaee ||",
      "translation": "Such is the Glory of the True Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪੁਤ੍ਰ ਕਲਤ੍ਰ ਵਿਚੇ ਗਤਿ ਪਾਈ ॥੨॥",
      "transliteration": "putr kalatr viche gat paaee ||2||",
      "translation": "in the midst of children and spouses, they attain emancipation. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਐਸੀ ਸੇਵਕੁ ਸੇਵਾ ਕਰੈ ॥",
      "transliteration": "aisee sevak sevaa karai ||",
      "translation": "Such is the service which the Lord's servant performs,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਸ ਕਾ ਜੀਉ ਤਿਸੁ ਆਗੈ ਧਰੈ ॥",
      "transliteration": "jis kaa jeeu tis aagai dharai ||",
      "translation": "that he dedicates his soul to the Lord, to whom it belongs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਾਹਿਬ ਭਾਵੈ ਸੋ ਪਰਵਾਣੁ ॥",
      "transliteration": "saahib bhaavai so paravaan ||",
      "translation": "One who is pleasing to the Lord and Master is acceptable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੋ ਸੇਵਕੁ ਦਰਗਹ ਪਾਵੈ ਮਾਣੁ ॥੩॥",
      "transliteration": "so sevak daragah paavai maan ||3||",
      "translation": "Such a servant obtains honor in the Court of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਤਿਗੁਰ ਕੀ ਮੂਰਤਿ ਹਿਰਦੈ ਵਸਾਏ ॥",
      "transliteration": "satigur kee moorat hiradai vasaae ||",
      "translation": "He enshrines the image of the True Guru in his heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੋ ਇਛੈ ਸੋਈ ਫਲੁ ਪਾਏ ॥",
      "transliteration": "jo ichhai soee phal paae ||",
      "translation": "He obtains the rewards which he desires.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਾਚਾ ਸਾਹਿਬੁ ਕਿਰਪਾ ਕਰੈ ॥",
      "transliteration": "saachaa saahib kirapaa karai ||",
      "translation": "The True Lord and Master grants His Grace;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੋ ਸੇਵਕੁ ਜਮ ਤੇ ਕੈਸਾ ਡਰੈ ॥੪॥",
      "transliteration": "so sevak jam te kaisaa darai ||4||",
      "translation": "how can such a servant be afraid of death? ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਨਤਿ ਨਾਨਕੁ ਕਰੇ ਵੀਚਾਰੁ ॥",
      "transliteration": "bhanat naanak kare veechaar ||",
      "translation": "Prays Nanak, practice contemplation,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਾਚੀ ਬਾਣੀ ਸਿਉ ਧਰੇ ਪਿਆਰੁ ॥",
      "transliteration": "saachee baanee siu dhare piaar ||",
      "translation": "and enshrine love for the True Word of His Bani.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਾ ਕੋ ਪਾਵੈ ਮੋਖ ਦੁਆਰੁ ॥",
      "transliteration": "taa ko paavai mokh duaar ||",
      "translation": "Then, you shall find the Gate of Salvation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਪੁ ਤਪੁ ਸਭੁ ਇਹੁ ਸਬਦੁ ਹੈ ਸਾਰੁ ॥੫॥੨॥੪॥",
      "transliteration": "jap tap sabh ihu sabad hai saar ||5||2||4||",
      "translation": "This Shabad is the most excellent of all chanting and austere meditations. ||5||2||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "dhanaasaree mahalaa 1 ||",
      "translation": "Dhanaasaree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੀਉ ਤਪਤੁ ਹੈ ਬਾਰੋ ਬਾਰ ॥",
      "transliteration": "jeeu tapat hai baaro baar ||",
      "translation": "My soul burns, over and over again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਪਿ ਤਪਿ ਖਪੈ ਬਹੁਤੁ ਬੇਕਾਰ ॥",
      "transliteration": "tap tap khapai bahut bekaar ||",
      "translation": "Burning and burning, it is ruined, and it falls into evil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜੈ ਤਨਿ ਬਾਣੀ ਵਿਸਰਿ ਜਾਇ ॥",
      "transliteration": "jai tan baanee visar jaai ||",
      "translation": "That body, which forgets the Word of the Guru's Bani,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਉ ਪਕਾ ਰੋਗੀ ਵਿਲਲਾਇ ॥੧॥",
      "transliteration": "jiu pakaa rogee vilalaai ||1||",
      "translation": "cries out in pain, like a chronic patient. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬਹੁਤਾ ਬੋਲਣੁ ਝਖਣੁ ਹੋਇ ॥",
      "transliteration": "bahutaa bolan jhakhan hoi ||",
      "translation": "To speak too much and babble is useless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਵਿਣੁ ਬੋਲੇ ਜਾਣੈ ਸਭੁ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "vin bole jaanai sabh soi ||1|| rahaau ||",
      "translation": "Even without our speaking, He knows everything. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਿਨਿ ਕਨ ਕੀਤੇ ਅਖੀ ਨਾਕੁ ॥",
      "transliteration": "jin kan keete akhee naak ||",
      "translation": "He created our ears, eyes and nose.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0661_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਿਨਿ ਜਿਹਵਾ ਦਿਤੀ ਬੋਲੇ ਤਾਤੁ ॥",
      "transliteration": "jin jihavaa ditee bole taat ||",
      "translation": "He gave us our tongue to speak so fluently.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 661,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
