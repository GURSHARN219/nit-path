{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 662,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0662_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਨਿ ਮਨੁ ਰਾਖਿਆ ਅਗਨੀ ਪਾਇ ॥",
      "transliteration": "jin man raakhiaa aganee paai ||",
      "translation": "He preserved the mind in the fire of the womb;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਵਾਜੈ ਪਵਣੁ ਆਖੈ ਸਭ ਜਾਇ ॥੨॥",
      "transliteration": "vaajai pavan aakhai sabh jaai ||2||",
      "translation": "at His Command, the wind blows everywhere. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੇਤਾ ਮੋਹੁ ਪਰੀਤਿ ਸੁਆਦ ॥",
      "transliteration": "jetaa mohu pareet suaad ||",
      "translation": "These worldly attachments, loves and pleasurable tastes,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਭਾ ਕਾਲਖ ਦਾਗਾ ਦਾਗ ॥",
      "transliteration": "sabhaa kaalakh daagaa daag ||",
      "translation": "all are just black stains.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦਾਗ ਦੋਸ ਮੁਹਿ ਚਲਿਆ ਲਾਇ ॥",
      "transliteration": "daag dos muhi chaliaa laai ||",
      "translation": "One who departs, with these black stains of sin on his face",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦਰਗਹ ਬੈਸਣ ਨਾਹੀ ਜਾਇ ॥੩॥",
      "transliteration": "daragah baisan naahee jaai ||3||",
      "translation": "shall find no place to sit in the Court of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਰਮਿ ਮਿਲੈ ਆਖਣੁ ਤੇਰਾ ਨਾਉ ॥",
      "transliteration": "karam milai aakhan teraa naau ||",
      "translation": "By Your Grace, we chant Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਤੁ ਲਗਿ ਤਰਣਾ ਹੋਰੁ ਨਹੀ ਥਾਉ ॥",
      "transliteration": "jit lag taranaa hor nahee thaau ||",
      "translation": "Becoming attached to it, one is saved; there is no other way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੇ ਕੋ ਡੂਬੈ ਫਿਰਿ ਹੋਵੈ ਸਾਰ ॥",
      "transliteration": "je ko doobai phir hovai saar ||",
      "translation": "Even if one is drowning, still, he may be saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਨਕ ਸਾਚਾ ਸਰਬ ਦਾਤਾਰ ॥੪॥੩॥੫॥",
      "transliteration": "naanak saachaa sarab daataar ||4||3||5||",
      "translation": "O Nanak, the True Lord is the Giver of all. ||4||3||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "dhanaasaree mahalaa 1 ||",
      "translation": "Dhanaasaree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਚੋਰੁ ਸਲਾਹੇ ਚੀਤੁ ਨ ਭੀਜੈ ॥",
      "transliteration": "chor salaahe cheet na bheejai ||",
      "translation": "If a thief praises someone, his mind is not pleased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੇ ਬਦੀ ਕਰੇ ਤਾ ਤਸੂ ਨ ਛੀਜੈ ॥",
      "transliteration": "je badee kare taa tasoo na chheejai ||",
      "translation": "If a thief curses him, no damage is done.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੋਰ ਕੀ ਹਾਮਾ ਭਰੇ ਨ ਕੋਇ ॥",
      "transliteration": "chor kee haamaa bhare na koi ||",
      "translation": "No one will take responsibility for a thief.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੋਰੁ ਕੀਆ ਚੰਗਾ ਕਿਉ ਹੋਇ ॥੧॥",
      "transliteration": "chor keeaa cha(n)gaa kiu hoi ||1||",
      "translation": "How can a thief's actions be good? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੁਣਿ ਮਨ ਅੰਧੇ ਕੁਤੇ ਕੂੜਿਆਰ ॥",
      "transliteration": "sun man a(n)dhe kute kooRiaar ||",
      "translation": "Listen, O mind, you blind, false dog!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਨੁ ਬੋਲੇ ਬੂਝੀਐ ਸਚਿਆਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin bole boojheeai sachiaar ||1|| rahaau ||",
      "translation": "Even without your speaking, the Lord knows and understands. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚੋਰੁ ਸੁਆਲਿਉ ਚੋਰੁ ਸਿਆਣਾ ॥",
      "transliteration": "chor suaaliu chor siaanaa ||",
      "translation": "A thief may be handsome, and a thief may be wise,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਖੋਟੇ ਕਾ ਮੁਲੁ ਏਕੁ ਦੁਗਾਣਾ ॥",
      "transliteration": "khote kaa mul ek dugaanaa ||",
      "translation": "but he is still just a counterfeit coin, worth only a shell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੇ ਸਾਥਿ ਰਖੀਐ ਦੀਜੈ ਰਲਾਇ ॥",
      "transliteration": "je saath rakheeai deejai ralaai ||",
      "translation": "If it is kept and mixed with other coins,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾ ਪਰਖੀਐ ਖੋਟਾ ਹੋਇ ਜਾਇ ॥੨॥",
      "transliteration": "jaa parakheeai khotaa hoi jaai ||2||",
      "translation": "it will be found to be false, when the coins are inspected. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੈਸਾ ਕਰੇ ਸੁ ਤੈਸਾ ਪਾਵੈ ॥",
      "transliteration": "jaisaa kare s taisaa paavai ||",
      "translation": "As one acts, so does he receive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਪਿ ਬੀਜਿ ਆਪੇ ਹੀ ਖਾਵੈ ॥",
      "transliteration": "aap beej aape hee khaavai ||",
      "translation": "As he plants, so does he eat.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੇ ਵਡਿਆਈਆ ਆਪੇ ਖਾਇ ॥",
      "transliteration": "je vadiaaeeaa aape khaai ||",
      "translation": "He may praise himself gloriously,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੇਹੀ ਸੁਰਤਿ ਤੇਹੈ ਰਾਹਿ ਜਾਇ ॥੩॥",
      "transliteration": "jehee surat tehai raahi jaai ||3||",
      "translation": "but still, according to his understanding, so is the path he must follow. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੇ ਸਉ ਕੂੜੀਆ ਕੂੜੁ ਕਬਾੜੁ ॥",
      "transliteration": "je sau kooReeaa kooR kabaaR ||",
      "translation": "He may tell hundreds of lies to conceal his falsehood,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭਾਵੈ ਸਭੁ ਆਖਉ ਸੰਸਾਰੁ ॥",
      "transliteration": "bhaavai sabh aakhau sa(n)saar ||",
      "translation": "and all the world may call him good.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੁਧੁ ਭਾਵੈ ਅਧੀ ਪਰਵਾਣੁ ॥",
      "transliteration": "tudh bhaavai adhee paravaan ||",
      "translation": "If it pleases You, Lord, even the foolish are approved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਨਕ ਜਾਣੈ ਜਾਣੁ ਸੁਜਾਣੁ ॥੪॥੪॥੬॥",
      "transliteration": "naanak jaanai jaan sujaan ||4||4||6||",
      "translation": "O Nanak, the Lord is wise, knowing, all-knowing. ||4||4||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "dhanaasaree mahalaa 1 ||",
      "translation": "Dhanaasaree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਾਇਆ ਕਾਗਦੁ ਮਨੁ ਪਰਵਾਣਾ ॥",
      "transliteration": "kaaiaa kaagad man paravaanaa ||",
      "translation": "The body is the paper, and the mind is the inscription written upon it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਿਰ ਕੇ ਲੇਖ ਨ ਪੜੈ ਇਆਣਾ ॥",
      "transliteration": "sir ke lekh na paRai iaanaa ||",
      "translation": "The ignorant fool does not read what is written on his forehead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦਰਗਹ ਘੜੀਅਹਿ ਤੀਨੇ ਲੇਖ ॥",
      "transliteration": "daragah ghaReeahi teene lekh ||",
      "translation": "In the Court of the Lord, three inscriptions are recorded.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਖੋਟਾ ਕਾਮਿ ਨ ਆਵੈ ਵੇਖੁ ॥੧॥",
      "transliteration": "khotaa kaam na aavai vekh ||1||",
      "translation": "Behold, the counterfeit coin is worthless there. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕ ਜੇ ਵਿਚਿ ਰੁਪਾ ਹੋਇ ॥",
      "transliteration": "naanak je vich rupaa hoi ||",
      "translation": "O Nanak, if there is silver in it,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਖਰਾ ਖਰਾ ਆਖੈ ਸਭੁ ਕੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kharaa kharaa aakhai sabh koi ||1|| rahaau ||",
      "translation": "then everyone proclaims, \"It is genuine, it is genuine.\" ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਾਦੀ ਕੂੜੁ ਬੋਲਿ ਮਲੁ ਖਾਇ ॥",
      "transliteration": "kaadee kooR bol mal khaai ||",
      "translation": "The Qazi tells lies and eats filth;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬ੍ਰਾਹਮਣੁ ਨਾਵੈ ਜੀਆ ਘਾਇ ॥",
      "transliteration": "braahaman naavai jeeaa ghaai ||",
      "translation": "the Brahmin kills and then takes cleansing baths.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੋਗੀ ਜੁਗਤਿ ਨ ਜਾਣੈ ਅੰਧੁ ॥",
      "transliteration": "jogee jugat na jaanai a(n)dh ||",
      "translation": "The Yogi is blind, and does not know the Way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤੀਨੇ ਓਜਾੜੇ ਕਾ ਬੰਧੁ ॥੨॥",
      "transliteration": "teene ojaaRe kaa ba(n)dh ||2||",
      "translation": "The three of them devise their own destruction. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੋ ਜੋਗੀ ਜੋ ਜੁਗਤਿ ਪਛਾਣੈ ॥",
      "transliteration": "so jogee jo jugat pachhaanai ||",
      "translation": "He alone is a Yogi, who understands the Way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਏਕੋ ਜਾਣੈ ॥",
      "transliteration": "gur parasaadee eko jaanai ||",
      "translation": "By Guru's Grace, he knows the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਾਜੀ ਸੋ ਜੋ ਉਲਟੀ ਕਰੈ ॥",
      "transliteration": "kaajee so jo ulatee karai ||",
      "translation": "He alone is a Qazi, who turns away from the world,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਜੀਵਤੁ ਮਰੈ ॥",
      "transliteration": "gur parasaadee jeevat marai ||",
      "translation": "and who, by Guru's Grace, remains dead while yet alive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੋ ਬ੍ਰਾਹਮਣੁ ਜੋ ਬ੍ਰਹਮੁ ਬੀਚਾਰੈ ॥",
      "transliteration": "so braahaman jo braham beechaarai ||",
      "translation": "He alone is a Brahmin, who contemplates God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਪਿ ਤਰੈ ਸਗਲੇ ਕੁਲ ਤਾਰੈ ॥੩॥",
      "transliteration": "aap tarai sagale kul taarai ||3||",
      "translation": "He saves himself, and saves all his generations as well. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦਾਨਸਬੰਦੁ ਸੋਈ ਦਿਲਿ ਧੋਵੈ ॥",
      "transliteration": "daanasaba(n)d soee dil dhovai ||",
      "translation": "One who cleanses his own mind is wise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੁਸਲਮਾਣੁ ਸੋਈ ਮਲੁ ਖੋਵੈ ॥",
      "transliteration": "musalamaan soee mal khovai ||",
      "translation": "One who cleanses himself of impurity is a Muslim.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਪੜਿਆ ਬੂਝੈ ਸੋ ਪਰਵਾਣੁ ॥",
      "transliteration": "paRiaa boojhai so paravaan ||",
      "translation": "One who reads and understands is acceptable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਸੁ ਸਿਰਿ ਦਰਗਹ ਕਾ ਨੀਸਾਣੁ ॥੪॥੫॥੭॥",
      "transliteration": "jis sir daragah kaa neesaan ||4||5||7||",
      "translation": "Upon his forehead is the Insignia of the Court of the Lord. ||4||5||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੧ ਘਰੁ ੩ ॥",
      "transliteration": "dhanaasaree mahalaa 1 ghar 3 ||",
      "translation": "Dhanaasaree, First Mehl, Third House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਾਲੁ ਨਾਹੀ ਜੋਗੁ ਨਾਹੀ ਨਾਹੀ ਸਤ ਕਾ ਢਬੁ ॥",
      "transliteration": "kaal naahee jog naahee naahee sat kaa dhab ||",
      "translation": "No, no, this is not the time, when people know the way to Yoga and Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਥਾਨਸਟ ਜਗ ਭਰਿਸਟ ਹੋਏ ਡੂਬਤਾ ਇਵ ਜਗੁ ॥੧॥",
      "transliteration": "thaanasat jag bharisat hoe doobataa iv jag ||1||",
      "translation": "The holy places of worship in the world are polluted, and so the world is drowning. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਲ ਮਹਿ ਰਾਮ ਨਾਮੁ ਸਾਰੁ ॥",
      "transliteration": "kal mahi raam naam saar ||",
      "translation": "In this Dark Age of Kali Yuga, the Lord's Name is the most sublime.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਅਖੀ ਤ ਮੀਟਹਿ ਨਾਕ ਪਕੜਹਿ ਠਗਣ ਕਉ ਸੰਸਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "akhee ta meetahi naak pakaRahi thagan kau sa(n)saar ||1|| rahaau ||",
      "translation": "Some people try to deceive the world by closing their eyes and holding their nostrils closed. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0662_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਆਂਟ ਸੇਤੀ ਨਾਕੁ ਪਕੜਹਿ ਸੂਝਤੇ ਤਿਨਿ ਲੋਅ ॥",
      "transliteration": "aa(n)t setee naak pakaRahi soojhate tin lo ||",
      "translation": "They close off their nostrils with their fingers, and claim to see the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 662,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
