{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 664,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0664_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਮਿਲੈ ਮਨੁ ਮਾਨਿਆ ॥੪॥੧॥",
      "transliteration": "naanak naam milai man maaniaa ||4||1||",
      "translation": "O Nanak, obtains the Naam; his mind is pleased and appeased. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "dhanaasaree mahalaa 3 ||",
      "translation": "Dhanaasaree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਰਿ ਨਾਮੁ ਧਨੁ ਨਿਰਮਲੁ ਅਤਿ ਅਪਾਰਾ ॥",
      "transliteration": "har naam dhan niramal at apaaraa ||",
      "translation": "The wealth of the Lord's Name is immaculate, and absolutely infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਭਰੇ ਭੰਡਾਰਾ ॥",
      "transliteration": "gur kai sabad bhare bha(n)daaraa ||",
      "translation": "The Word of the Guru's Shabad is over-flowing with treasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਮ ਧਨ ਬਿਨੁ ਹੋਰ ਸਭ ਬਿਖੁ ਜਾਣੁ ॥",
      "transliteration": "naam dhan bin hor sabh bikh jaan ||",
      "translation": "Know that, except for the wealth of the Name, all other wealth is poison.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਾਇਆ ਮੋਹਿ ਜਲੈ ਅਭਿਮਾਨੁ ॥੧॥",
      "transliteration": "maaiaa mohi jalai abhimaan ||1||",
      "translation": "The egotistical people are burning in their attachment to Maya. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਹਰਿ ਰਸੁ ਚਾਖੈ ਕੋਇ ॥",
      "transliteration": "guramukh har ras chaakhai koi ||",
      "translation": "How rare is that Gurmukh who tastes the sublime essence of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਿਸੁ ਸਦਾ ਅਨੰਦੁ ਹੋਵੈ ਦਿਨੁ ਰਾਤੀ ਪੂਰੈ ਭਾਗਿ ਪਰਾਪਤਿ ਹੋਇ ॥ ਰਹਾਉ ॥",
      "transliteration": "tis sadaa ana(n)d hovai din raatee poorai bhaag paraapat hoi || rahaau ||",
      "translation": "He is always in bliss, day and night; through perfect good destiny, he obtains the Name. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਬਦੁ ਦੀਪਕੁ ਵਰਤੈ ਤਿਹੁ ਲੋਇ ॥",
      "transliteration": "sabad deepak varatai tihu loi ||",
      "translation": "The Word of the Shabad is a lamp, illuminating the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੋ ਚਾਖੈ ਸੋ ਨਿਰਮਲੁ ਹੋਇ ॥",
      "transliteration": "jo chaakhai so niramal hoi ||",
      "translation": "One who tastes it, becomes immaculate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਿਰਮਲ ਨਾਮਿ ਹਉਮੈ ਮਲੁ ਧੋਇ ॥",
      "transliteration": "niramal naam haumai mal dhoi ||",
      "translation": "The immaculate Naam, the Name of the Lord, washes off the filth of ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਾਚੀ ਭਗਤਿ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥੨॥",
      "transliteration": "saachee bhagat sadaa sukh hoi ||2||",
      "translation": "True devotional worship brings lasting peace. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਨਿ ਹਰਿ ਰਸੁ ਚਾਖਿਆ ਸੋ ਹਰਿ ਜਨੁ ਲੋਗੁ ॥",
      "transliteration": "jin har ras chaakhiaa so har jan log ||",
      "translation": "One who tastes the sublime essence of the Lord is the Lord's humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਿਸੁ ਸਦਾ ਹਰਖੁ ਨਾਹੀ ਕਦੇ ਸੋਗੁ ॥",
      "transliteration": "tis sadaa harakh naahee kade sog ||",
      "translation": "He is forever happy; he is never sad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਆਪਿ ਮੁਕਤੁ ਅਵਰਾ ਮੁਕਤੁ ਕਰਾਵੈ ॥",
      "transliteration": "aap mukat avaraa mukat karaavai ||",
      "translation": "He himself is liberated, and he liberates others as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਰਿ ਨਾਮੁ ਜਪੈ ਹਰਿ ਤੇ ਸੁਖੁ ਪਾਵੈ ॥੩॥",
      "transliteration": "har naam japai har te sukh paavai ||3||",
      "translation": "He chants the Lord's Name, and through the Lord, he finds peace. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰ ਸਭ ਮੁਈ ਬਿਲਲਾਇ ॥",
      "transliteration": "bin satigur sabh muee bilalaai ||",
      "translation": "Without the True Guru, everyone dies, crying out in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਨਦਿਨੁ ਦਾਝਹਿ ਸਾਤਿ ਨ ਪਾਇ ॥",
      "transliteration": "anadin daajhahi saat na paai ||",
      "translation": "Night and day, they burn, and find no peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮਿਲੈ ਸਭੁ ਤ੍ਰਿਸਨ ਬੁਝਾਏ ॥",
      "transliteration": "satigur milai sabh trisan bujhaae ||",
      "translation": "But meeting the True Guru, all thirst is quenched.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਸਾਂਤਿ ਸੁਖੁ ਪਾਏ ॥੪॥੨॥",
      "transliteration": "naanak naam saa(n)t sukh paae ||4||2||",
      "translation": "O Nanak, through the Naam, one finds peace and tranquility. ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "dhanaasaree mahalaa 3 ||",
      "translation": "Dhanaasaree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਦਾ ਧਨੁ ਅੰਤਰਿ ਨਾਮੁ ਸਮਾਲੇ ॥",
      "transliteration": "sadaa dhan a(n)tar naam samaale ||",
      "translation": "Gather in and cherish forever the wealth of the Lord's Name, deep within;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਜਿਨਹਿ ਪ੍ਰਤਿਪਾਲੇ ॥",
      "transliteration": "jee ja(n)t jinahi pratipaale ||",
      "translation": "He cherishes and nurtures all beings and creatures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮੁਕਤਿ ਪਦਾਰਥੁ ਤਿਨ ਕਉ ਪਾਏ ॥",
      "transliteration": "mukat padaarath tin kau paae ||",
      "translation": "They alone obtain the treasure of Liberation,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਰਿ ਕੈ ਨਾਮਿ ਰਤੇ ਲਿਵ ਲਾਏ ॥੧॥",
      "transliteration": "har kai naam rate liv laae ||1||",
      "translation": "who are lovingly imbued with, and focused on the Lord's Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੁਰ ਸੇਵਾ ਤੇ ਹਰਿ ਨਾਮੁ ਧਨੁ ਪਾਵੈ ॥",
      "transliteration": "gur sevaa te har naam dhan paavai ||",
      "translation": "Serving the Guru, one obtains the wealth of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅੰਤਰਿ ਪਰਗਾਸੁ ਹਰਿ ਨਾਮੁ ਧਿਆਵੈ ॥ ਰਹਾਉ ॥",
      "transliteration": "a(n)tar paragaas har naam dhiaavai || rahaau ||",
      "translation": "He is illumined and enlightened within, and he meditates on the Lord's Name. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਹੁ ਹਰਿ ਰੰਗੁ ਗੂੜਾ ਧਨ ਪਿਰ ਹੋਇ ॥",
      "transliteration": "ihu har ra(n)g gooRaa dhan pir hoi ||",
      "translation": "This love for the Lord is like the love of the bride for her husband.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਾਂਤਿ ਸੀਗਾਰੁ ਰਾਵੇ ਪ੍ਰਭੁ ਸੋਇ ॥",
      "transliteration": "saa(n)t seegaar raave prabh soi ||",
      "translation": "God ravishes and enjoys the soul-bride who is adorned with peace and tranquility.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਉਮੈ ਵਿਚਿ ਪ੍ਰਭੁ ਕੋਇ ਨ ਪਾਏ ॥",
      "transliteration": "haumai vich prabh koi na paae ||",
      "translation": "No one finds God through egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੂਲਹੁ ਭੁਲਾ ਜਨਮੁ ਗਵਾਏ ॥੨॥",
      "transliteration": "moolahu bhulaa janam gavaae ||2||",
      "translation": "Wandering away from the Primal Lord, the root of all, one wastes his life in vain. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰ ਤੇ ਸਾਤਿ ਸਹਜ ਸੁਖੁ ਬਾਣੀ ॥",
      "transliteration": "gur te saat sahaj sukh baanee ||",
      "translation": "Tranquility, celestial peace, pleasure and the Word of His Bani come from the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੇਵਾ ਸਾਚੀ ਨਾਮਿ ਸਮਾਣੀ ॥",
      "transliteration": "sevaa saachee naam samaanee ||",
      "translation": "True is that service, which leads one to merge in the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਬਦਿ ਮਿਲੈ ਪ੍ਰੀਤਮੁ ਸਦਾ ਧਿਆਏ ॥",
      "transliteration": "sabad milai preetam sadaa dhiaae ||",
      "translation": "Blessed with the Word of the Shabad, he meditates forever on the Lord, the Beloved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਾਚ ਨਾਮਿ ਵਡਿਆਈ ਪਾਏ ॥੩॥",
      "transliteration": "saach naam vadiaaee paae ||3||",
      "translation": "Through the True Name, glorious greatness is obtained. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਪੇ ਕਰਤਾ ਜੁਗਿ ਜੁਗਿ ਸੋਇ ॥",
      "transliteration": "aape karataa jug jug soi ||",
      "translation": "The Creator Himself abides throughout the ages.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਮੇਲਾਵਾ ਹੋਇ ॥",
      "transliteration": "nadar kare melaavaa hoi ||",
      "translation": "If He casts His Glance of Grace, then we meet Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗੁਰਬਾਣੀ ਤੇ ਹਰਿ ਮੰਨਿ ਵਸਾਏ ॥",
      "transliteration": "gurabaanee te har ma(n)n vasaae ||",
      "translation": "Through the Word of Gurbani, the Lord comes to dwell in the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਨਕ ਸਾਚਿ ਰਤੇ ਪ੍ਰਭਿ ਆਪਿ ਮਿਲਾਏ ॥੪॥੩॥",
      "transliteration": "naanak saach rate prabh aap milaae ||4||3||",
      "translation": "O Nanak, God unites with Himself those who are imbued with Truth. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੩ ਤੀਜਾ ॥",
      "transliteration": "dhanaasaree mahalaa 3 teejaa ||",
      "translation": "Dhanaasaree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਗੁ ਮੈਲਾ ਮੈਲੋ ਹੋਇ ਜਾਇ ॥",
      "transliteration": "jag mailaa mailo hoi jaai ||",
      "translation": "The world is polluted, and those in the world become polluted as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਵੈ ਜਾਇ ਦੂਜੈ ਲੋਭਾਇ ॥",
      "transliteration": "aavai jaai doojai lobhaai ||",
      "translation": "In attachment to duality, it comes and goes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੂਜੈ ਭਾਇ ਸਭ ਪਰਜ ਵਿਗੋਈ ॥",
      "transliteration": "doojai bhaai sabh paraj vigoee ||",
      "translation": "This love of duality has ruined the entire world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮਨਮੁਖਿ ਚੋਟਾ ਖਾਇ ਅਪੁਨੀ ਪਤਿ ਖੋਈ ॥੧॥",
      "transliteration": "manamukh chotaa khaai apunee pat khoee ||1||",
      "translation": "The self-willed manmukh suffers punishment, and forfeits his honor. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰ ਸੇਵਾ ਤੇ ਜਨੁ ਨਿਰਮਲੁ ਹੋਇ ॥",
      "transliteration": "gur sevaa te jan niramal hoi ||",
      "translation": "Serving the Guru, one becomes immaculate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅੰਤਰਿ ਨਾਮੁ ਵਸੈ ਪਤਿ ਊਤਮ ਹੋਇ ॥ ਰਹਾਉ ॥",
      "transliteration": "a(n)tar naam vasai pat ootam hoi || rahaau ||",
      "translation": "He enshrines the Naam, the Name of the Lord, within, and his state becomes exalted. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਉਬਰੇ ਹਰਿ ਸਰਣਾਈ ॥",
      "transliteration": "guramukh ubare har saranaaee ||",
      "translation": "The Gurmukhs are saved, taking to the Lord's Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਮ ਨਾਮਿ ਰਾਤੇ ਭਗਤਿ ਦ੍ਰਿੜਾਈ ॥",
      "transliteration": "raam naam raate bhagat driRaaee ||",
      "translation": "Attuned to the Lord's Name, they commit themselves to devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਭਗਤਿ ਕਰੇ ਜਨੁ ਵਡਿਆਈ ਪਾਏ ॥",
      "transliteration": "bhagat kare jan vadiaaee paae ||",
      "translation": "The Lord's humble servant performs devotional worship, and is blessed with greatness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਾਚਿ ਰਤੇ ਸੁਖ ਸਹਜਿ ਸਮਾਏ ॥੨॥",
      "transliteration": "saach rate sukh sahaj samaae ||2||",
      "translation": "Attuned to Truth, he is absorbed in celestial peace. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਾਚੇ ਕਾ ਗਾਹਕੁ ਵਿਰਲਾ ਕੋ ਜਾਣੁ ॥",
      "transliteration": "saache kaa gaahak viralaa ko jaan ||",
      "translation": "Know that one who purchases the True Name is very rare.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਆਪੁ ਪਛਾਣੁ ॥",
      "transliteration": "gur kai sabad aap pachhaan ||",
      "translation": "Through the Word of the Guru's Shabad, he comes to understand himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਾਚੀ ਰਾਸਿ ਸਾਚਾ ਵਾਪਾਰੁ ॥",
      "transliteration": "saachee raas saachaa vaapaar ||",
      "translation": "True is his capital, and true is his trade.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੋ ਧੰਨੁ ਪੁਰਖੁ ਜਿਸੁ ਨਾਮਿ ਪਿਆਰੁ ॥੩॥",
      "transliteration": "so dha(n)n purakh jis naam piaar ||3||",
      "translation": "Blessed is that person, who loves the Naam. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤਿਨਿ ਪ੍ਰਭਿ ਸਾਚੈ ਇਕਿ ਸਚਿ ਲਾਏ ॥",
      "transliteration": "tin prabh saachai ik sach laae ||",
      "translation": "God, the True Lord, has attached some to His True Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0664_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਊਤਮ ਬਾਣੀ ਸਬਦੁ ਸੁਣਾਏ ॥",
      "transliteration": "ootam baanee sabad sunaae ||",
      "translation": "They listen to the most sublime Word of His Bani, and the Word of His Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 664,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
