{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 665,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0665_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪ੍ਰਭ ਸਾਚੇ ਕੀ ਸਾਚੀ ਕਾਰ ॥",
      "transliteration": "prabh saache kee saachee kaar ||",
      "translation": "True is service to the True Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਸਵਾਰਣਹਾਰ ॥੪॥੪॥",
      "transliteration": "naanak naam savaaranahaar ||4||4||",
      "translation": "O Nanak, the Naam is the Embellisher. ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "dhanaasaree mahalaa 3 ||",
      "translation": "Dhanaasaree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੋ ਹਰਿ ਸੇਵਹਿ ਤਿਨ ਬਲਿ ਜਾਉ ॥",
      "transliteration": "jo har sevahi tin bal jaau ||",
      "translation": "I am a sacrifice to those who serve the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਨ ਹਿਰਦੈ ਸਾਚੁ ਸਚਾ ਮੁਖਿ ਨਾਉ ॥",
      "transliteration": "tin hiradai saach sachaa mukh naau ||",
      "translation": "The Truth is in their hearts, and the True Name is on their lips.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਾਚੋ ਸਾਚੁ ਸਮਾਲਿਹੁ ਦੁਖੁ ਜਾਇ ॥",
      "transliteration": "saacho saach samaalihu dukh jaai ||",
      "translation": "Dwelling upon the Truest of the True, their pains are dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਾਚੈ ਸਬਦਿ ਵਸੈ ਮਨਿ ਆਇ ॥੧॥",
      "transliteration": "saachai sabad vasai man aai ||1||",
      "translation": "Through the True Word of the Shabad, the Lord comes to dwell in their minds. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰਬਾਣੀ ਸੁਣਿ ਮੈਲੁ ਗਵਾਏ ॥",
      "transliteration": "gurabaanee sun mail gavaae ||",
      "translation": "Listening to the Word of Gurbani, filth is washed off,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਹਜੇ ਹਰਿ ਨਾਮੁ ਮੰਨਿ ਵਸਾਏ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sahaje har naam ma(n)n vasaae ||1|| rahaau ||",
      "translation": "and they naturally enshrine the Lord's Name in their minds. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕੂੜੁ ਕੁਸਤੁ ਤ੍ਰਿਸਨਾ ਅਗਨਿ ਬੁਝਾਏ ॥",
      "transliteration": "kooR kusat trisanaa agan bujhaae ||",
      "translation": "One who conquers fraud, deceit and the fire of desire",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅੰਤਰਿ ਸਾਂਤਿ ਸਹਜਿ ਸੁਖੁ ਪਾਏ ॥",
      "transliteration": "a(n)tar saa(n)t sahaj sukh paae ||",
      "translation": "finds tranquility, peace and pleasure within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰ ਕੈ ਭਾਣੈ ਚਲੈ ਤਾ ਆਪੁ ਜਾਇ ॥",
      "transliteration": "gur kai bhaanai chalai taa aap jaai ||",
      "translation": "If one walks in harmony with the Guru's Will, he eliminates his self-conceit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਚੁ ਮਹਲੁ ਪਾਏ ਹਰਿ ਗੁਣ ਗਾਇ ॥੨॥",
      "transliteration": "saach mahal paae har gun gaai ||2||",
      "translation": "He finds the True Mansion of the Lord's Presence, singing the Glorious Praises of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨ ਸਬਦੁ ਬੂਝੈ ਨ ਜਾਣੈ ਬਾਣੀ ॥",
      "transliteration": "na sabad boojhai na jaanai baanee ||",
      "translation": "The blind, self-willed manmukh does not understand the Shabad; he does not know the Word of the Guru's Bani,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਨਮੁਖਿ ਅੰਧੇ ਦੁਖਿ ਵਿਹਾਣੀ ॥",
      "transliteration": "manamukh a(n)dhe dukh vihaanee ||",
      "translation": "and so he passes his life in misery.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਭੇਟੇ ਤਾ ਸੁਖੁ ਪਾਏ ॥",
      "transliteration": "satigur bhete taa sukh paae ||",
      "translation": "But if he meets the True Guru, then he finds peace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਉਮੈ ਵਿਚਹੁ ਠਾਕਿ ਰਹਾਏ ॥੩॥",
      "transliteration": "haumai vichahu thaak rahaae ||3||",
      "translation": "and the ego within is silenced. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਿਸ ਨੋ ਕਹੀਐ ਦਾਤਾ ਇਕੁ ਸੋਇ ॥",
      "transliteration": "kis no kaheeai daataa ik soi ||",
      "translation": "Who else should I speak to? The One Lord is the Giver of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿਰਪਾ ਕਰੇ ਸਬਦਿ ਮਿਲਾਵਾ ਹੋਇ ॥",
      "transliteration": "kirapaa kare sabad milaavaa hoi ||",
      "translation": "When He grants His Grace, then we obtain the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਿਲਿ ਪ੍ਰੀਤਮ ਸਾਚੇ ਗੁਣ ਗਾਵਾ ॥",
      "transliteration": "mil preetam saache gun gaavaa ||",
      "translation": "Meeting with my Beloved, I sing the Glorious Praises of the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਨਕ ਸਾਚੇ ਸਾਚਾ ਭਾਵਾ ॥੪॥੫॥",
      "transliteration": "naanak saache saachaa bhaavaa ||4||5||",
      "translation": "O Nanak, becoming truthful, I have become pleasing to the True Lord. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "dhanaasaree mahalaa 3 ||",
      "translation": "Dhanaasaree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਨੁ ਮਰੈ ਧਾਤੁ ਮਰਿ ਜਾਇ ॥",
      "transliteration": "man marai dhaat mar jaai ||",
      "translation": "When the mind is conquered, its turbulent wanderings are stopped.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਿਨੁ ਮਨ ਮੂਏ ਕੈਸੇ ਹਰਿ ਪਾਇ ॥",
      "transliteration": "bin man mooe kaise har paai ||",
      "translation": "Without conquering the mind, how can the Lord be found?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਮਰੈ ਦਾਰੂ ਜਾਣੈ ਕੋਇ ॥",
      "transliteration": "ihu man marai daaroo jaanai koi ||",
      "translation": "Rare is the one who knows the medicine to conquer the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨੁ ਸਬਦਿ ਮਰੈ ਬੂਝੈ ਜਨੁ ਸੋਇ ॥੧॥",
      "transliteration": "man sabad marai boojhai jan soi ||1||",
      "translation": "The mind is conquered through the Word of the Shabad; this is known to the Lord's humble servant. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਿਸ ਨੋ ਬਖਸੇ ਹਰਿ ਦੇ ਵਡਿਆਈ ॥",
      "transliteration": "jis no bakhase har de vadiaaee ||",
      "translation": "The Lord forgives him, and blesses him with glory.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਵਸੈ ਮਨਿ ਆਈ ॥ ਰਹਾਉ ॥",
      "transliteration": "gur parasaad vasai man aaee || rahaau ||",
      "translation": "By Guru's Grace, the Lord comes to dwell in the mind. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਕਰਣੀ ਕਾਰ ਕਮਾਵੈ ॥",
      "transliteration": "guramukh karanee kaar kamaavai ||",
      "translation": "The Gurmukh does good deeds,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਾ ਇਸੁ ਮਨ ਕੀ ਸੋਝੀ ਪਾਵੈ ॥",
      "transliteration": "taa is man kee sojhee paavai ||",
      "translation": "and so, he comes to understand this mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਨੁ ਮੈ ਮਤੁ ਮੈਗਲ ਮਿਕਦਾਰਾ ॥",
      "transliteration": "man mai mat maigal mikadaaraa ||",
      "translation": "The mind is intoxicated, like the elephant with wine.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰੁ ਅੰਕਸੁ ਮਾਰਿ ਜੀਵਾਲਣਹਾਰਾ ॥੨॥",
      "transliteration": "gur a(n)kas maar jeevaalanahaaraa ||2||",
      "translation": "The Guru places the harness upon it, and rejuvenates it. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਨੁ ਅਸਾਧੁ ਸਾਧੈ ਜਨੁ ਕੋਈ ॥",
      "transliteration": "man asaadh saadhai jan koee ||",
      "translation": "The mind is undisciplined; only a rare few can discipline it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਚਰੁ ਚਰੈ ਤਾ ਨਿਰਮਲੁ ਹੋਈ ॥",
      "transliteration": "achar charai taa niramal hoee ||",
      "translation": "If someone eats the uneatable, then he becomes immaculate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਇਹੁ ਮਨੁ ਲਇਆ ਸਵਾਰਿ ॥",
      "transliteration": "guramukh ihu man laiaa savaar ||",
      "translation": "As Gurmukh, his mind is embellished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਉਮੈ ਵਿਚਹੁ ਤਜੈ ਵਿਕਾਰ ॥੩॥",
      "transliteration": "haumai vichahu tajai vikaar ||3||",
      "translation": "Egotism and corruption are eradicated from within. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੋ ਧੁਰਿ ਰਖਿਅਨੁ ਮੇਲਿ ਮਿਲਾਇ ॥",
      "transliteration": "jo dhur rakhian mel milaai ||",
      "translation": "Those whom the Primal Lord keeps united in His Union,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਦੇ ਨ ਵਿਛੁੜਹਿ ਸਬਦਿ ਸਮਾਇ ॥",
      "transliteration": "kade na vichhuRahi sabad samaai ||",
      "translation": "shall never be separated from Him; they are merged in the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਪਣੀ ਕਲਾ ਆਪੇ ਪ੍ਰਭੁ ਜਾਣੈ ॥",
      "transliteration": "aapanee kalaa aape prabh jaanai ||",
      "translation": "Only God Himself knows His own power.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਨਾਮੁ ਪਛਾਣੈ ॥੪॥੬॥",
      "transliteration": "naanak guramukh naam pachhaanai ||4||6||",
      "translation": "O Nanak, the Gurmukh realizes the Naam, the Name of the Lord. ||4||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੩ ॥",
      "transliteration": "dhanaasaree mahalaa 3 ||",
      "translation": "Dhanaasaree, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਾਚਾ ਧਨੁ ਸੰਚਹਿ ਮੂਰਖ ਗਾਵਾਰ ॥",
      "transliteration": "kaachaa dhan sa(n)chahi moorakh gaavaar ||",
      "translation": "The ignorant fools amass false wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਨਮੁਖ ਭੂਲੇ ਅੰਧ ਗਾਵਾਰ ॥",
      "transliteration": "manamukh bhoole a(n)dh gaavaar ||",
      "translation": "The blind, foolish, self-willed manmukhs have gone astray.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਿਖਿਆ ਕੈ ਧਨਿ ਸਦਾ ਦੁਖੁ ਹੋਇ ॥",
      "transliteration": "bikhiaa kai dhan sadaa dukh hoi ||",
      "translation": "Poisonous wealth brings constant pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾ ਸਾਥਿ ਜਾਇ ਨ ਪਰਾਪਤਿ ਹੋਇ ॥੧॥",
      "transliteration": "naa saath jaai na paraapat hoi ||1||",
      "translation": "It will not go with you, and it will not yield any profit. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਾਚਾ ਧਨੁ ਗੁਰਮਤੀ ਪਾਏ ॥",
      "transliteration": "saachaa dhan guramatee paae ||",
      "translation": "True wealth is obtained through the Guru's Teachings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਾਚਾ ਧਨੁ ਫੁਨਿ ਆਵੈ ਜਾਏ ॥ ਰਹਾਉ ॥",
      "transliteration": "kaachaa dhan phun aavai jaae || rahaau ||",
      "translation": "False wealth continues coming and going. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਨਮੁਖਿ ਭੂਲੇ ਸਭਿ ਮਰਹਿ ਗਵਾਰ ॥",
      "transliteration": "manamukh bhoole sabh marahi gavaar ||",
      "translation": "The foolish self-willed manmukhs all go astray and die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਭਵਜਲਿ ਡੂਬੇ ਨ ਉਰਵਾਰਿ ਨ ਪਾਰਿ ॥",
      "transliteration": "bhavajal doobe na uravaar na paar ||",
      "translation": "They drown in the terrifying world-ocean, and they cannot reach either this shore, or the one beyond.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਭੇਟੇ ਪੂਰੈ ਭਾਗਿ ॥",
      "transliteration": "satigur bhete poorai bhaag ||",
      "translation": "But by perfect destiny, they meet the True Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਾਚਿ ਰਤੇ ਅਹਿਨਿਸਿ ਬੈਰਾਗਿ ॥੨॥",
      "transliteration": "saach rate ahinis bairaag ||2||",
      "translation": "imbued with the True Name, day and night, they remain detached from the world. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਚਹੁ ਜੁਗ ਮਹਿ ਅੰਮ੍ਰਿਤੁ ਸਾਚੀ ਬਾਣੀ ॥",
      "transliteration": "chahu jug mahi a(n)mrit saachee baanee ||",
      "translation": "Throughout the four ages, the True Bani of His Word is Ambrosial Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਪੂਰੈ ਭਾਗਿ ਹਰਿ ਨਾਮਿ ਸਮਾਣੀ ॥",
      "transliteration": "poorai bhaag har naam samaanee ||",
      "translation": "By perfect destiny, one is absorbed in the True Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਿਧ ਸਾਧਿਕ ਤਰਸਹਿ ਸਭਿ ਲੋਇ ॥",
      "transliteration": "sidh saadhik tarasahi sabh loi ||",
      "translation": "The Siddhas, the seekers and all men long for the Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪੂਰੈ ਭਾਗਿ ਪਰਾਪਤਿ ਹੋਇ ॥੩॥",
      "transliteration": "poorai bhaag paraapat hoi ||3||",
      "translation": "It is obtained only by perfect destiny. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਭੁ ਕਿਛੁ ਸਾਚਾ ਸਾਚਾ ਹੈ ਸੋਇ ॥",
      "transliteration": "sabh kichh saachaa saachaa hai soi ||",
      "translation": "The True Lord is everything; He is True.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਊਤਮ ਬ੍ਰਹਮੁ ਪਛਾਣੈ ਕੋਇ ॥",
      "transliteration": "ootam braham pachhaanai koi ||",
      "translation": "Only a few realize the exalted Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0665_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸਚੁ ਸਾਚਾ ਸਚੁ ਆਪਿ ਦ੍ਰਿੜਾਏ ॥",
      "transliteration": "sach saachaa sach aap driRaae ||",
      "translation": "He is the Truest of the True; He Himself implants the True Name within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 665,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
