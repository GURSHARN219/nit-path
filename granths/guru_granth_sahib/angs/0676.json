{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 676,
  "lineCount": 49,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0676_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਾਣੁ ਮਾਣੁ ਦੀਬਾਣੁ ਸਾਚਾ ਨਾਨਕ ਕੀ ਪ੍ਰਭ ਟੇਕ ॥੪॥੨॥੨੦॥",
      "transliteration": "taan maan deebaan saachaa naanak kee prabh tek ||4||2||20||",
      "translation": "The True Lord is Nanak's strength, honor and support; He alone is his protection. ||4||2||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "dhanaasaree mahalaa 5 ||",
      "translation": "Dhanaasaree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਫਿਰਤ ਫਿਰਤ ਭੇਟੇ ਜਨ ਸਾਧੂ ਪੂਰੈ ਗੁਰਿ ਸਮਝਾਇਆ ॥",
      "transliteration": "phirat phirat bhete jan saadhoo poorai gur samajhaaiaa ||",
      "translation": "Wandering and roaming around, I met the Holy Perfect Guru, who has taught me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਨ ਸਗਲ ਬਿਧਿ ਕਾਂਮਿ ਨ ਆਵੈ ਹਰਿ ਹਰਿ ਨਾਮੁ ਧਿਆਇਆ ॥੧॥",
      "transliteration": "aan sagal bidh kaa(n)m na aavai har har naam dhiaaiaa ||1||",
      "translation": "All other devices did not work, so I meditate on the Name of the Lord, Har, Har. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਾ ਤੇ ਮੋਹਿ ਧਾਰੀ ਓਟ ਗੋਪਾਲ ॥",
      "transliteration": "taa te mohi dhaaree ot gopaal ||",
      "translation": "For this reason, I sought the Protection and Support of my Lord, the Cherisher of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਰਨਿ ਪਰਿਓ ਪੂਰਨ ਪਰਮੇਸੁਰ ਬਿਨਸੇ ਸਗਲ ਜੰਜਾਲ ॥ ਰਹਾਉ ॥",
      "transliteration": "saran pario pooran paramesur binase sagal ja(n)jaal || rahaau ||",
      "translation": "I sought the Sanctuary of the Perfect Transcendent Lord, and all my entanglements were dissolved. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਰਗ ਮਿਰਤ ਪਇਆਲ ਭੂ ਮੰਡਲ ਸਗਲ ਬਿਆਪੇ ਮਾਇ ॥",
      "transliteration": "surag mirat paiaal bhoo ma(n)dal sagal biaape maai ||",
      "translation": "Paradise, the earth, the nether regions of the underworld, and the globe of the world - all are engrossed in Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੀਅ ਉਧਾਰਨ ਸਭ ਕੁਲ ਤਾਰਨ ਹਰਿ ਹਰਿ ਨਾਮੁ ਧਿਆਇ ॥੨॥",
      "transliteration": "jee udhaaran sabh kul taaran har har naam dhiaai ||2||",
      "translation": "To save your soul, and liberate all your ancestors, meditate on the Name of the Lord, Har, Har. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਨਿਰੰਜਨੁ ਗਾਈਐ ਪਾਈਐ ਸਰਬ ਨਿਧਾਨਾ ॥",
      "transliteration": "naanak naam nira(n)jan gaaeeai paaeeai sarab nidhaanaa ||",
      "translation": "O Nanak, singing the Naam, the Name of the Immaculate Lord, all treasures are obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਦੇਇ ਸੁਆਮੀ ਬਿਰਲੇ ਕਾਹੂ ਜਾਨਾ ॥੩॥੩॥੨੧॥",
      "transliteration": "kar kirapaa jis dei suaamee birale kaahoo jaanaa ||3||3||21||",
      "translation": "Only that rare person, whom the Lord and Master blesses with His Grace, comes to know this. ||3||3||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੫ ਘਰੁ ੨ ਚਉਪਦੇ ॥",
      "transliteration": "dhanaasaree mahalaa 5 ghar 2 chaupade ||",
      "translation": "Dhanaasaree, Fifth Mehl, Second House, Chau-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਛੋਡਿ ਜਾਹਿ ਸੇ ਕਰਹਿ ਪਰਾਲ ॥",
      "transliteration": "chhod jaahi se karahi paraal ||",
      "translation": "You shall have to abandon the straw which you have collected.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਾਮਿ ਨ ਆਵਹਿ ਸੇ ਜੰਜਾਲ ॥",
      "transliteration": "kaam na aavahi se ja(n)jaal ||",
      "translation": "These entanglements shall be of no use to you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੰਗਿ ਨ ਚਾਲਹਿ ਤਿਨ ਸਿਉ ਹੀਤ ॥",
      "transliteration": "sa(n)g na chaalahi tin siu heet ||",
      "translation": "You are in love with those things that will not go with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੋ ਬੈਰਾਈ ਸੇਈ ਮੀਤ ॥੧॥",
      "transliteration": "jo bairaaee seee meet ||1||",
      "translation": "You think that your enemies are friends. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਐਸੇ ਭਰਮਿ ਭੁਲੇ ਸੰਸਾਰਾ ॥",
      "transliteration": "aise bharam bhule sa(n)saaraa ||",
      "translation": "In such confusion, the world has gone astray.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਨਮੁ ਪਦਾਰਥੁ ਖੋਇ ਗਵਾਰਾ ॥ ਰਹਾਉ ॥",
      "transliteration": "janam padaarath khoi gavaaraa || rahaau ||",
      "translation": "The foolish mortal wastes this precious human life. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਾਚੁ ਧਰਮੁ ਨਹੀ ਭਾਵੈ ਡੀਠਾ ॥",
      "transliteration": "saach dharam nahee bhaavai deethaa ||",
      "translation": "He does not like to see Truth and righteousness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਝੂਠ ਧੋਹ ਸਿਉ ਰਚਿਓ ਮੀਠਾ ॥",
      "transliteration": "jhooth dhoh siu rachio meethaa ||",
      "translation": "He is attached to falsehood and deception; they seem sweet to him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦਾਤਿ ਪਿਆਰੀ ਵਿਸਰਿਆ ਦਾਤਾਰਾ ॥",
      "transliteration": "daat piaaree visariaa daataaraa ||",
      "translation": "He loves gifts, but he forgets the Giver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਾਣੈ ਨਾਹੀ ਮਰਣੁ ਵਿਚਾਰਾ ॥੨॥",
      "transliteration": "jaanai naahee maran vichaaraa ||2||",
      "translation": "The wretched creature does not even think of death. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਵਸਤੁ ਪਰਾਈ ਕਉ ਉਠਿ ਰੋਵੈ ॥",
      "transliteration": "vasat paraaee kau uth rovai ||",
      "translation": "He cries for the possessions of others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਸਗਲਾ ਈ ਖੋਵੈ ॥",
      "transliteration": "karam dharam sagalaa ee khovai ||",
      "translation": "He forfeits all the merits of his good deeds and religion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹੁਕਮੁ ਨ ਬੂਝੈ ਆਵਣ ਜਾਣੇ ॥",
      "transliteration": "hukam na boojhai aavan jaane ||",
      "translation": "He does not understand the Hukam of the Lord's Command, and so he continues coming and going in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਾਪ ਕਰੈ ਤਾ ਪਛੋਤਾਣੇ ॥੩॥",
      "transliteration": "paap karai taa pachhotaane ||3||",
      "translation": "He sins, and then regrets and repents. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੋ ਤੁਧੁ ਭਾਵੈ ਸੋ ਪਰਵਾਣੁ ॥",
      "transliteration": "jo tudh bhaavai so paravaan ||",
      "translation": "Whatever pleases You, Lord, that alone is acceptable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੇਰੇ ਭਾਣੇ ਨੋ ਕੁਰਬਾਣੁ ॥",
      "transliteration": "tere bhaane no kurabaan ||",
      "translation": "I am a sacrifice to Your Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਨਕੁ ਗਰੀਬੁ ਬੰਦਾ ਜਨੁ ਤੇਰਾ ॥",
      "transliteration": "naanak gareeb ba(n)daa jan teraa ||",
      "translation": "Poor Nanak is Your slave, Your humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਾਖਿ ਲੇਇ ਸਾਹਿਬੁ ਪ੍ਰਭੁ ਮੇਰਾ ॥੪॥੧॥੨੨॥",
      "transliteration": "raakh lei saahib prabh meraa ||4||1||22||",
      "translation": "Save me, O my Lord God Master! ||4||1||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "dhanaasaree mahalaa 5 ||",
      "translation": "Dhanaasaree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੋਹਿ ਮਸਕੀਨ ਪ੍ਰਭੁ ਨਾਮੁ ਅਧਾਰੁ ॥",
      "transliteration": "mohi masakeen prabh naam adhaar ||",
      "translation": "I am meek and poor; the Name of God is my only Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਖਾਟਣ ਕਉ ਹਰਿ ਹਰਿ ਰੋਜਗਾਰੁ ॥",
      "transliteration": "khaatan kau har har rojagaar ||",
      "translation": "The Name of the Lord, Har, Har, is my occupation and earnings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੰਚਣ ਕਉ ਹਰਿ ਏਕੋ ਨਾਮੁ ॥",
      "transliteration": "sa(n)chan kau har eko naam ||",
      "translation": "I gather only the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਲਤਿ ਪਲਤਿ ਤਾ ਕੈ ਆਵੈ ਕਾਮ ॥੧॥",
      "transliteration": "halat palat taa kai aavai kaam ||1||",
      "translation": "It is useful in both this world and the next. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਪ੍ਰਭ ਰੰਗਿ ਅਪਾਰ ॥",
      "transliteration": "naam rate prabh ra(n)g apaar ||",
      "translation": "Imbued with the Love of the Lord God's Infinite Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਾਧ ਗਾਵਹਿ ਗੁਣ ਏਕ ਨਿਰੰਕਾਰ ॥ ਰਹਾਉ ॥",
      "transliteration": "saadh gaavahi gun ek nira(n)kaar || rahaau ||",
      "translation": "the Holy Saints sing the Glorious Praises of the One Lord, the Formless Lord. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਾਧ ਕੀ ਸੋਭਾ ਅਤਿ ਮਸਕੀਨੀ ॥",
      "transliteration": "saadh kee sobhaa at masakeenee ||",
      "translation": "The Glory of the Holy Saints comes from their total humility.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੰਤ ਵਡਾਈ ਹਰਿ ਜਸੁ ਚੀਨੀ ॥",
      "transliteration": "sa(n)t vadaaee har jas cheenee ||",
      "translation": "The Saints realize that their greatness rests in the Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਨਦੁ ਸੰਤਨ ਕੈ ਭਗਤਿ ਗੋਵਿੰਦ ॥",
      "transliteration": "anad sa(n)tan kai bhagat govi(n)d ||",
      "translation": "Meditating on the Lord of the Universe, the Saints are in bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੂਖੁ ਸੰਤਨ ਕੈ ਬਿਨਸੀ ਚਿੰਦ ॥੨॥",
      "transliteration": "sookh sa(n)tan kai binasee chi(n)d ||2||",
      "translation": "The Saints find peace, and their anxieties are dispelled. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਹ ਸਾਧ ਸੰਤਨ ਹੋਵਹਿ ਇਕਤ੍ਰ ॥",
      "transliteration": "jah saadh sa(n)tan hovahi ikatr ||",
      "translation": "Wherever the Holy Saints gather,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਹ ਹਰਿ ਜਸੁ ਗਾਵਹਿ ਨਾਦ ਕਵਿਤ ॥",
      "transliteration": "tah har jas gaavahi naad kavit ||",
      "translation": "there they sing the Praises of the Lord, in music and poetry.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਾਧ ਸਭਾ ਮਹਿ ਅਨਦ ਬਿਸ੍ਰਾਮ ॥",
      "transliteration": "saadh sabhaa mahi anad bisraam ||",
      "translation": "In the Society of the Saints, there is bliss and peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਉਨ ਸੰਗੁ ਸੋ ਪਾਏ ਜਿਸੁ ਮਸਤਕਿ ਕਰਾਮ ॥੩॥",
      "transliteration": "un sa(n)g so paae jis masatak karaam ||3||",
      "translation": "They alone obtain this Society, upon whose foreheads such destiny is written. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੁਇ ਕਰ ਜੋੜਿ ਕਰੀ ਅਰਦਾਸਿ ॥",
      "transliteration": "dui kar joR karee aradaas ||",
      "translation": "With my palms pressed together, I offer my prayer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚਰਨ ਪਖਾਰਿ ਕਹਾਂ ਗੁਣਤਾਸ ॥",
      "transliteration": "charan pakhaar kahaa(n) gunataas ||",
      "translation": "I wash their feet, and chant the Praises of the Lord, the treasure of virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪ੍ਰਭ ਦਇਆਲ ਕਿਰਪਾਲ ਹਜੂਰਿ ॥",
      "transliteration": "prabh daiaal kirapaal hajoor ||",
      "translation": "O God, merciful and compassionate, let me remain in Your Presence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0676_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਨਕੁ ਜੀਵੈ ਸੰਤਾ ਧੂਰਿ ॥੪॥੨॥੨੩॥",
      "transliteration": "naanak jeevai sa(n)taa dhoor ||4||2||23||",
      "translation": "Nanak lives, in the dust of the Saints. ||4||2||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 676,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
