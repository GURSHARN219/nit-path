{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 684,
  "lineCount": 45,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0684_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਜਾ ਕਾ ਮਨੁ ਰਾਪੈ ॥",
      "transliteration": "charan kamal jaa kaa man raapai ||",
      "translation": "One whose mind is imbued with the Lord's lotus feet",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੋਗ ਅਗਨਿ ਤਿਸੁ ਜਨ ਨ ਬਿਆਪੈ ॥੨॥",
      "transliteration": "sog agan tis jan na biaapai ||2||",
      "translation": "is not afflicted by the fire of sorrow. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਾਗਰੁ ਤਰਿਆ ਸਾਧੂ ਸੰਗੇ ॥",
      "transliteration": "saagar tariaa saadhoo sa(n)ge ||",
      "translation": "He crosses over the world-ocean in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਿਰਭਉ ਨਾਮੁ ਜਪਹੁ ਹਰਿ ਰੰਗੇ ॥੩॥",
      "transliteration": "nirabhau naam japahu har ra(n)ge ||3||",
      "translation": "He chants the Name of the Fearless Lord, and is imbued with the Lord's Love. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਰ ਧਨ ਦੋਖ ਕਿਛੁ ਪਾਪ ਨ ਫੇੜੇ ॥",
      "transliteration": "par dhan dokh kichh paap na pheRe ||",
      "translation": "One who does not steal the wealth of others, who does not commit evil deeds or sinful acts",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਮ ਜੰਦਾਰੁ ਨ ਆਵੈ ਨੇੜੇ ॥੪॥",
      "transliteration": "jam ja(n)daar na aavai neRe ||4||",
      "translation": "- the Messenger of Death does not even approach him. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤ੍ਰਿਸਨਾ ਅਗਨਿ ਪ੍ਰਭਿ ਆਪਿ ਬੁਝਾਈ ॥",
      "transliteration": "trisanaa agan prabh aap bujhaaee ||",
      "translation": "God Himself quenches the fires of desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਨਕ ਉਧਰੇ ਪ੍ਰਭ ਸਰਣਾਈ ॥੫॥੧॥੫੫॥",
      "transliteration": "naanak udhare prabh saranaaee ||5||1||55||",
      "translation": "O Nanak, in God's Sanctuary, one is saved. ||5||1||55||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "dhanaasaree mahalaa 5 ||",
      "translation": "Dhanaasaree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤ੍ਰਿਪਤਿ ਭਈ ਸਚੁ ਭੋਜਨੁ ਖਾਇਆ ॥",
      "transliteration": "tripat bhaee sach bhojan khaaiaa ||",
      "translation": "I am satisfied and satiated, eating the food of Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਨਿ ਤਨਿ ਰਸਨਾ ਨਾਮੁ ਧਿਆਇਆ ॥੧॥",
      "transliteration": "man tan rasanaa naam dhiaaiaa ||1||",
      "translation": "With my mind, body and tongue, I meditate on the Naam, the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੀਵਨਾ ਹਰਿ ਜੀਵਨਾ ॥",
      "transliteration": "jeevanaa har jeevanaa ||",
      "translation": "Life, spiritual life, is in the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੀਵਨੁ ਹਰਿ ਜਪਿ ਸਾਧਸੰਗਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jeevan har jap saadhasa(n)g ||1|| rahaau ||",
      "translation": "Spiritual life consists of chanting the Lord's Name in the Saadh Sangat, the Company of the Holy. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਨਿਕ ਪ੍ਰਕਾਰੀ ਬਸਤ੍ਰ ਓਢਾਏ ॥",
      "transliteration": "anik prakaaree basatr odhaae ||",
      "translation": "He is dressed in robes of all sorts,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਨਦਿਨੁ ਕੀਰਤਨੁ ਹਰਿ ਗੁਨ ਗਾਏ ॥੨॥",
      "transliteration": "anadin keeratan har gun gaae ||2||",
      "translation": "if he sings the Kirtan of the Lord's Glorious Praises, day and night. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਸਤੀ ਰਥ ਅਸੁ ਅਸਵਾਰੀ ॥",
      "transliteration": "hasatee rath as asavaaree ||",
      "translation": "He rides upon elephants, chariots and horses,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰਿ ਕਾ ਮਾਰਗੁ ਰਿਦੈ ਨਿਹਾਰੀ ॥੩॥",
      "transliteration": "har kaa maarag ridai nihaaree ||3||",
      "translation": "if he sees the Lord's Path within his own heart. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਨ ਤਨ ਅੰਤਰਿ ਚਰਨ ਧਿਆਇਆ ॥",
      "transliteration": "man tan a(n)tar charan dhiaaiaa ||",
      "translation": "Meditating on the Lord's Feet, deep within his mind and body,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਰਿ ਸੁਖ ਨਿਧਾਨ ਨਾਨਕ ਦਾਸਿ ਪਾਇਆ ॥੪॥੨॥੫੬॥",
      "transliteration": "har sukh nidhaan naanak daas paaiaa ||4||2||56||",
      "translation": "slave Nanak has found the Lord, the treasure of peace. ||4||2||56||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "dhanaasaree mahalaa 5 ||",
      "translation": "Dhanaasaree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਨ ਜੀਅ ਕਾ ਨਿਸਤਾਰਾ ॥",
      "transliteration": "gur ke charan jee kaa nisataaraa ||",
      "translation": "The Guru's feet emancipate the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਮੁੰਦੁ ਸਾਗਰੁ ਜਿਨਿ ਖਿਨ ਮਹਿ ਤਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "samu(n)d saagar jin khin mahi taaraa ||1|| rahaau ||",
      "translation": "They carry it across the world-ocean in an instant. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕੋਈ ਹੋਆ ਕ੍ਰਮ ਰਤੁ ਕੋਈ ਤੀਰਥ ਨਾਇਆ ॥",
      "transliteration": "koee hoaa kram rat koee teerath naaiaa ||",
      "translation": "Some love rituals, and some bathe at sacred shrines of pilgrimage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦਾਸੀੰ ਹਰਿ ਕਾ ਨਾਮੁ ਧਿਆਇਆ ॥੧॥",
      "transliteration": "daasee(n) har kaa naam dhiaaiaa ||1||",
      "translation": "The Lord's slaves meditate on His Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬੰਧਨ ਕਾਟਨਹਾਰੁ ਸੁਆਮੀ ॥",
      "transliteration": "ba(n)dhan kaatanahaar suaamee ||",
      "translation": "The Lord Master is the Breaker of bonds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਨ ਨਾਨਕੁ ਸਿਮਰੈ ਅੰਤਰਜਾਮੀ ॥੨॥੩॥੫੭॥",
      "transliteration": "jan naanak simarai a(n)tarajaamee ||2||3||57||",
      "translation": "Servant Nanak meditates in remembrance on the Lord, the Inner-knower, the Searcher of hearts. ||2||3||57||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "dhanaasaree mahalaa 5 ||",
      "translation": "Dhanaasaree, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਿਤੈ ਪ੍ਰਕਾਰਿ ਨ ਤੂਟਉ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "kitai prakaar na tootau preet ||",
      "translation": "The lifestyle of Your slave is so pure,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦਾਸ ਤੇਰੇ ਕੀ ਨਿਰਮਲ ਰੀਤਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "daas tere kee niramal reet ||1|| rahaau ||",
      "translation": "That nothing can break his love for You. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੀਅ ਪ੍ਰਾਨ ਮਨ ਧਨ ਤੇ ਪਿਆਰਾ ॥",
      "transliteration": "jee praan man dhan te piaaraa ||",
      "translation": "He is more dear to me than my soul, my breath of life, my mind and my wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਉਮੈ ਬੰਧੁ ਹਰਿ ਦੇਵਣਹਾਰਾ ॥੧॥",
      "transliteration": "haumai ba(n)dh har devanahaaraa ||1||",
      "translation": "The Lord is the Giver, the Restrainer of the ego. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਸਿਉ ਲਾਗਉ ਨੇਹੁ ॥",
      "transliteration": "charan kamal siu laagau nehu ||",
      "translation": "I am in love with the Lord's lotus feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਨਕ ਕੀ ਬੇਨੰਤੀ ਏਹ ॥੨॥੪॥੫੮॥",
      "transliteration": "naanak kee bena(n)tee eh ||2||4||58||",
      "translation": "This alone is Nanak's prayer. ||2||4||58||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੯ ॥",
      "transliteration": "dhanaasaree mahalaa 9 ||",
      "translation": "Dhanaasaree, Ninth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਾਹੇ ਰੇ ਬਨ ਖੋਜਨ ਜਾਈ ॥",
      "transliteration": "kaahe re ban khojan jaaee ||",
      "translation": "Why do you go looking for Him in the forest?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਰਬ ਨਿਵਾਸੀ ਸਦਾ ਅਲੇਪਾ ਤੋਹੀ ਸੰਗਿ ਸਮਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sarab nivaasee sadaa alepaa tohee sa(n)g samaaee ||1|| rahaau ||",
      "translation": "Although he is unattached, he dwells everywhere. He is always with you as your companion. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪੁਹਪ ਮਧਿ ਜਿਉ ਬਾਸੁ ਬਸਤੁ ਹੈ ਮੁਕਰ ਮਾਹਿ ਜੈਸੇ ਛਾਈ ॥",
      "transliteration": "puhap madh jiu baas basat hai mukar maahi jaise chhaaee ||",
      "translation": "Like the fragrance which remains in the flower, and like the reflection in the mirror,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੈਸੇ ਹੀ ਹਰਿ ਬਸੇ ਨਿਰੰਤਰਿ ਘਟ ਹੀ ਖੋਜਹੁ ਭਾਈ ॥੧॥",
      "transliteration": "taise hee har base nira(n)tar ghat hee khojahu bhaaee ||1||",
      "translation": "the Lord dwells deep within; search for Him within your own heart, O Siblings of Destiny. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਾਹਰਿ ਭੀਤਰਿ ਏਕੋ ਜਾਨਹੁ ਇਹੁ ਗੁਰ ਗਿਆਨੁ ਬਤਾਈ ॥",
      "transliteration": "baahar bheetar eko jaanahu ihu gur giaan bataaee ||",
      "translation": "Outside and inside, know that there is only the One Lord; the Guru has imparted this wisdom to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਬਿਨੁ ਆਪਾ ਚੀਨੈ ਮਿਟੈ ਨ ਭ੍ਰਮ ਕੀ ਕਾਈ ॥੨॥੧॥",
      "transliteration": "jan naanak bin aapaa cheenai mitai na bhram kee kaaee ||2||1||",
      "translation": "O servant Nanak, without knowing one's own self, the moss of doubt is not removed. ||2||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੯ ॥",
      "transliteration": "dhanaasaree mahalaa 9 ||",
      "translation": "Dhanaasaree, Ninth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਾਧੋ ਇਹੁ ਜਗੁ ਭਰਮ ਭੁਲਾਨਾ ॥",
      "transliteration": "saadho ihu jag bharam bhulaanaa ||",
      "translation": "O Holy people, this world is deluded by doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਕਾ ਸਿਮਰਨੁ ਛੋਡਿਆ ਮਾਇਆ ਹਾਥਿ ਬਿਕਾਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raam naam kaa simaran chhodiaa maaiaa haath bikaanaa ||1|| rahaau ||",
      "translation": "It has forsaken the meditative remembrance of the Lord's Name, and sold itself out to Maya. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0684_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਭਾਈ ਸੁਤ ਬਨਿਤਾ ਤਾ ਕੈ ਰਸਿ ਲਪਟਾਨਾ ॥",
      "transliteration": "maat pitaa bhaaee sut banitaa taa kai ras lapataanaa ||",
      "translation": "Mother, father, siblings, children and spouse - he is entangled in their love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 684,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
