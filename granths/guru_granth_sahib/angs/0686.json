{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 686,
  "lineCount": 52,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0686_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਨਮੁ ਪਦਾਰਥੁ ਦੁਬਿਧਾ ਖੋਵੈ ॥",
      "transliteration": "janam padaarath dubidhaa khovai ||",
      "translation": "He wastes this precious human life through duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਪੁ ਨ ਚੀਨਸਿ ਭ੍ਰਮਿ ਭ੍ਰਮਿ ਰੋਵੈ ॥੬॥",
      "transliteration": "aap na cheenas bhram bhram rovai ||6||",
      "translation": "He does not know his own self, and trapped by doubts, he cries out in pain. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਹਤਉ ਪੜਤਉ ਸੁਣਤਉ ਏਕ ॥",
      "transliteration": "kahatau paRatau sunatau ek ||",
      "translation": "Speak, read and hear of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਧੀਰਜ ਧਰਮੁ ਧਰਣੀਧਰ ਟੇਕ ॥",
      "transliteration": "dheeraj dharam dharaneedhar tek ||",
      "translation": "The Support of the earth shall bless you with courage, righteousness and protection.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਤੁ ਸਤੁ ਸੰਜਮੁ ਰਿਦੈ ਸਮਾਏ ॥",
      "transliteration": "jat sat sa(n)jam ridai samaae ||",
      "translation": "Chastity, purity and self-restraint are infused into the heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਉਥੇ ਪਦ ਕਉ ਜੇ ਮਨੁ ਪਤੀਆਏ ॥੭॥",
      "transliteration": "chauthe pad kau je man pateeaae ||7||",
      "translation": "when one centers his mind in the fourth state. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਾਚੇ ਨਿਰਮਲ ਮੈਲੁ ਨ ਲਾਗੈ ॥",
      "transliteration": "saache niramal mail na laagai ||",
      "translation": "They are immaculate and true, and filth does not stick to them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਭਰਮ ਭਉ ਭਾਗੈ ॥",
      "transliteration": "gur kai sabad bharam bhau bhaagai ||",
      "translation": "Through the Word of the Guru's Shabad, their doubt and fear depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੂਰਤਿ ਮੂਰਤਿ ਆਦਿ ਅਨੂਪੁ ॥",
      "transliteration": "soorat moorat aad anoop ||",
      "translation": "The form and personality of the Primal Lord are incomparably beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਨਕੁ ਜਾਚੈ ਸਾਚੁ ਸਰੂਪੁ ॥੮॥੧॥",
      "transliteration": "naanak jaachai saach saroop ||8||1||",
      "translation": "Nanak begs for the Lord, the Embodiment of Truth. ||8||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "dhanaasaree mahalaa 1 ||",
      "translation": "Dhanaasaree, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਹਜਿ ਮਿਲੈ ਮਿਲਿਆ ਪਰਵਾਣੁ ॥",
      "transliteration": "sahaj milai miliaa paravaan ||",
      "translation": "That union with the Lord is acceptable, which is united in intuitive poise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾ ਤਿਸੁ ਮਰਣੁ ਨ ਆਵਣੁ ਜਾਣੁ ॥",
      "transliteration": "naa tis maran na aavan jaan ||",
      "translation": "Thereafter, one does not die, and does not come and go in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਠਾਕੁਰ ਮਹਿ ਦਾਸੁ ਦਾਸ ਮਹਿ ਸੋਇ ॥",
      "transliteration": "thaakur mahi daas daas mahi soi ||",
      "translation": "The Lord's slave is in the Lord, and the Lord is in His slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਹ ਦੇਖਾ ਤਹ ਅਵਰੁ ਨ ਕੋਇ ॥੧॥",
      "transliteration": "jah dekhaa tah avar na koi ||1||",
      "translation": "Wherever I look, I see none other than the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਭਗਤਿ ਸਹਜ ਘਰੁ ਪਾਈਐ ॥",
      "transliteration": "guramukh bhagat sahaj ghar paaeeai ||",
      "translation": "The Gurmukhs worship the Lord, and find His celestial home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਭੇਟੇ ਮਰਿ ਆਈਐ ਜਾਈਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin gur bhete mar aaeeai jaaeeai ||1|| rahaau ||",
      "translation": "Without meeting the Guru, they die, and come and go in reincarnation. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੋ ਗੁਰੁ ਕਰਉ ਜਿ ਸਾਚੁ ਦ੍ਰਿੜਾਵੈ ॥",
      "transliteration": "so gur karau j saach driRaavai ||",
      "translation": "So make Him your Guru, who implants the Truth within you,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਕਥੁ ਕਥਾਵੈ ਸਬਦਿ ਮਿਲਾਵੈ ॥",
      "transliteration": "akath kathaavai sabad milaavai ||",
      "translation": "who leads you to speak the Unspoken Speech, and who merges you in the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਰਿ ਕੇ ਲੋਗ ਅਵਰ ਨਹੀ ਕਾਰਾ ॥",
      "transliteration": "har ke log avar nahee kaaraa ||",
      "translation": "God's people have no other work to do;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਾਚਉ ਠਾਕੁਰੁ ਸਾਚੁ ਪਿਆਰਾ ॥੨॥",
      "transliteration": "saachau thaakur saach piaaraa ||2||",
      "translation": "they love the True Lord and Master, and they love the Truth. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਨ ਮਹਿ ਮਨੂਆ ਮਨ ਮਹਿ ਸਾਚਾ ॥",
      "transliteration": "tan mahi manooaa man mahi saachaa ||",
      "translation": "The mind is in the body, and the True Lord is in the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋ ਸਾਚਾ ਮਿਲਿ ਸਾਚੇ ਰਾਚਾ ॥",
      "transliteration": "so saachaa mil saache raachaa ||",
      "translation": "Merging into the True Lord, one is absorbed into Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੇਵਕੁ ਪ੍ਰਭ ਕੈ ਲਾਗੈ ਪਾਇ ॥",
      "transliteration": "sevak prabh kai laagai paai ||",
      "translation": "God's servant bows at His feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਪੂਰਾ ਮਿਲੈ ਮਿਲਾਇ ॥੩॥",
      "transliteration": "satigur pooraa milai milaai ||3||",
      "translation": "Meeting the True Guru, one meets with the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਪਿ ਦਿਖਾਵੈ ਆਪੇ ਦੇਖੈ ॥",
      "transliteration": "aap dikhaavai aape dekhai ||",
      "translation": "He Himself watches over us, and He Himself makes us see.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਠਿ ਨ ਪਤੀਜੈ ਨਾ ਬਹੁ ਭੇਖੈ ॥",
      "transliteration": "hath na pateejai naa bahu bhekhai ||",
      "translation": "He is not pleased by stubborn-mindedness, nor by various religious robes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਘੜਿ ਭਾਡੇ ਜਿਨਿ ਅੰਮ੍ਰਿਤੁ ਪਾਇਆ ॥",
      "transliteration": "ghaR bhaade jin a(n)mrit paaiaa ||",
      "translation": "He fashioned the body-vessels, and infused the Ambrosial Nectar into them;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪ੍ਰੇਮ ਭਗਤਿ ਪ੍ਰਭਿ ਮਨੁ ਪਤੀਆਇਆ ॥੪॥",
      "transliteration": "prem bhagat prabh man pateeaaiaa ||4||",
      "translation": "God's Mind is pleased only by loving devotional worship. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪੜਿ ਪੜਿ ਭੂਲਹਿ ਚੋਟਾ ਖਾਹਿ ॥",
      "transliteration": "paR paR bhoolahi chotaa khaahi ||",
      "translation": "Reading and studying, one becomes confused, and suffers punishment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਹੁਤੁ ਸਿਆਣਪ ਆਵਹਿ ਜਾਹਿ ॥",
      "transliteration": "bahut siaanap aavahi jaahi ||",
      "translation": "By great cleverness, one is consigned to coming and going in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਮੁ ਜਪੈ ਭਉ ਭੋਜਨੁ ਖਾਇ ॥",
      "transliteration": "naam japai bhau bhojan khaai ||",
      "translation": "One who chants the Naam, the Name of the Lord, and eats the food of the Fear of God",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸੇਵਕ ਰਹੇ ਸਮਾਇ ॥੫॥",
      "transliteration": "guramukh sevak rahe samaai ||5||",
      "translation": "becomes Gurmukh, the Lord's servant, and remains absorbed in the Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪੂਜਿ ਸਿਲਾ ਤੀਰਥ ਬਨ ਵਾਸਾ ॥",
      "transliteration": "pooj silaa teerath ban vaasaa ||",
      "translation": "He worships stones, dwells at sacred shrines of pilgrimage and in the jungles,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਰਮਤ ਡੋਲਤ ਭਏ ਉਦਾਸਾ ॥",
      "transliteration": "bharamat dolat bhae udaasaa ||",
      "translation": "wanders, roams around and becomes a renunciate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਨਿ ਮੈਲੈ ਸੂਚਾ ਕਿਉ ਹੋਇ ॥",
      "transliteration": "man mailai soochaa kiu hoi ||",
      "translation": "But his mind is still filthy - how can he become pure?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਾਚਿ ਮਿਲੈ ਪਾਵੈ ਪਤਿ ਸੋਇ ॥੬॥",
      "transliteration": "saach milai paavai pat soi ||6||",
      "translation": "One who meets the True Lord obtains honor. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਚਾਰਾ ਵੀਚਾਰੁ ਸਰੀਰਿ ॥",
      "transliteration": "aachaaraa veechaar sareer ||",
      "translation": "One who embodies good conduct and contemplative meditation,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਦਿ ਜੁਗਾਦਿ ਸਹਜਿ ਮਨੁ ਧੀਰਿ ॥",
      "transliteration": "aad jugaad sahaj man dheer ||",
      "translation": "his mind abides in intuitive poise and contentment, since the beginning of time, and throughout the ages.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਲ ਪੰਕਜ ਮਹਿ ਕੋਟਿ ਉਧਾਰੇ ॥",
      "transliteration": "pal pa(n)kaj mahi kot udhaare ||",
      "translation": "In the twinkling of an eye, he saves millions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਗੁਰੁ ਮੇਲਿ ਪਿਆਰੇ ॥੭॥",
      "transliteration": "kar kirapaa gur mel piaare ||7||",
      "translation": "Have mercy on me, O my Beloved, and let me meet the Guru. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਿਸੁ ਆਗੈ ਪ੍ਰਭ ਤੁਧੁ ਸਾਲਾਹੀ ॥",
      "transliteration": "kis aagai prabh tudh saalaahee ||",
      "translation": "Unto whom, O God, should I praise You?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੁਧੁ ਬਿਨੁ ਦੂਜਾ ਮੈ ਕੋ ਨਾਹੀ ॥",
      "transliteration": "tudh bin doojaa mai ko naahee ||",
      "translation": "Without You, there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਉ ਤੁਧੁ ਭਾਵੈ ਤਿਉ ਰਾਖੁ ਰਜਾਇ ॥",
      "transliteration": "jiu tudh bhaavai tiu raakh rajaai ||",
      "translation": "As it pleases You, keep me under Your Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਸਹਜਿ ਭਾਇ ਗੁਣ ਗਾਇ ॥੮॥੨॥",
      "transliteration": "naanak sahaj bhaai gun gaai ||8||2||",
      "translation": "Nanak, with intuitive poise and natural love, sings Your Glorious Praises. ||8||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਧਨਾਸਰੀ ਮਹਲਾ ੫ ਘਰੁ ੬ ਅਸਟਪਦੀ ॥",
      "transliteration": "dhanaasaree mahalaa 5 ghar 6 asatapadee ||",
      "translation": "Dhanaasaree, Fifth Mehl, Sixth House, Ashtapadee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜੋ ਜੋ ਜੂਨੀ ਆਇਓ ਤਿਹ ਤਿਹ ਉਰਝਾਇਓ ਮਾਣਸ ਜਨਮੁ ਸੰਜੋਗਿ ਪਾਇਆ ॥",
      "transliteration": "jo jo joonee aaio tih tih urajhaaio maanas janam sa(n)jog paaiaa ||",
      "translation": "Whoever is born into the world, is entangled in it; human birth is obtained only by good destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤਾ ਕੀ ਹੈ ਓਟ ਸਾਧ ਰਾਖਹੁ ਦੇ ਕਰਿ ਹਾਥ ਕਰਿ ਕਿਰਪਾ ਮੇਲਹੁ ਹਰਿ ਰਾਇਆ ॥੧॥",
      "transliteration": "taa kee hai ot saadh raakhahu de kar haath kar kirapaa melahu har raaiaa ||1||",
      "translation": "I look to Your support, O Holy Saint; give me Your hand, and protect me. By Your Grace, let me meet the Lord, my King. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਅਨਿਕ ਜਨਮ ਭ੍ਰਮਿ ਥਿਤਿ ਨਹੀ ਪਾਈ ॥",
      "transliteration": "anik janam bhram thit nahee paaee ||",
      "translation": "I wandered through countless incarnations, but I did not find stability anywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਰਉ ਸੇਵਾ ਗੁਰ ਲਾਗਉ ਚਰਨ ਗੋਵਿੰਦ ਜੀ ਕਾ ਮਾਰਗੁ ਦੇਹੁ ਜੀ ਬਤਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "karau sevaa gur laagau charan govi(n)d jee kaa maarag dehu jee bataaee ||1|| rahaau ||",
      "translation": "I serve the Guru, and I fall at His feet, praying, \"O Dear Lord of the Universe, please, show me the way.\" ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0686_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਨਿਕ ਉਪਾਵ ਕਰਉ ਮਾਇਆ ਕਉ ਬਚਿਤਿ ਧਰਉ ਮੇਰੀ ਮੇਰੀ ਕਰਤ ਸਦ ਹੀ ਵਿਹਾਵੈ ॥",
      "transliteration": "anik upaav karau maaiaa kau bachit dharau meree meree karat sad hee vihaavai ||",
      "translation": "I have tried so many things to acquire the wealth of Maya, and to cherish it in my mind; I have passed my life constantly crying out, \"Mine, mine!\"",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 686,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
