{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 737,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0737_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਸ ਨੋ ਲਾਇ ਲਏ ਸੋ ਲਾਗੈ ॥",
      "transliteration": "jis no laai lae so laagai ||",
      "translation": "He alone is attached, whom the Lord Himself attaches.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗਿਆਨ ਰਤਨੁ ਅੰਤਰਿ ਤਿਸੁ ਜਾਗੈ ॥",
      "transliteration": "giaan ratan a(n)tar tis jaagai ||",
      "translation": "The jewel of spiritual wisdom is awakened deep within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੁਰਮਤਿ ਜਾਇ ਪਰਮ ਪਦੁ ਪਾਏ ॥",
      "transliteration": "duramat jaai param pad paae ||",
      "translation": "Evil-mindedness is eradicated, and the supreme status is attained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਨਾਮੁ ਧਿਆਏ ॥੩॥",
      "transliteration": "gur parasaadee naam dhiaae ||3||",
      "translation": "By Guru's Grace, meditate on the Naam, the Name of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੁਇ ਕਰ ਜੋੜਿ ਕਰਉ ਅਰਦਾਸਿ ॥",
      "transliteration": "dui kar joR karau aradaas ||",
      "translation": "Pressing my palms together, I offer my prayer;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੁਧੁ ਭਾਵੈ ਤਾ ਆਣਹਿ ਰਾਸਿ ॥",
      "transliteration": "tudh bhaavai taa aanahi raas ||",
      "translation": "if it pleases You, Lord, please bless me and fulfill me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਅਪਨੀ ਭਗਤੀ ਲਾਇ ॥",
      "transliteration": "kar kirapaa apanee bhagatee laai ||",
      "translation": "Grant Your Mercy, Lord, and bless me with devotion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਪ੍ਰਭੁ ਸਦਾ ਧਿਆਇ ॥੪॥੨॥",
      "transliteration": "jan naanak prabh sadaa dhiaai ||4||2||",
      "translation": "Servant Nanak meditates on God forever. ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਧਨੁ ਸੋਹਾਗਨਿ ਜੋ ਪ੍ਰਭੂ ਪਛਾਨੈ ॥",
      "transliteration": "dhan sohaagan jo prabhoo pachhaanai ||",
      "translation": "Blessed is that soul-bride, who realizes God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਾਨੈ ਹੁਕਮੁ ਤਜੈ ਅਭਿਮਾਨੈ ॥",
      "transliteration": "maanai hukam tajai abhimaanai ||",
      "translation": "She obeys the Hukam of His Order, and abandons her self-conceit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪ੍ਰਿਅ ਸਿਉ ਰਾਤੀ ਰਲੀਆ ਮਾਨੈ ॥੧॥",
      "transliteration": "pri siu raatee raleeaa maanai ||1||",
      "translation": "Imbued with her Beloved, she celebrates in delight. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁਨਿ ਸਖੀਏ ਪ੍ਰਭ ਮਿਲਣ ਨੀਸਾਨੀ ॥",
      "transliteration": "sun sakheee prabh milan neesaanee ||",
      "translation": "Listen, O my companions - these are the signs on the Path to meet God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਅਰਪਿ ਤਜਿ ਲਾਜ ਲੋਕਾਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "man tan arap taj laaj lokaanee ||1|| rahaau ||",
      "translation": "Dedicate your mind and body to Him; stop living to please others. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਖੀ ਸਹੇਲੀ ਕਉ ਸਮਝਾਵੈ ॥",
      "transliteration": "sakhee sahelee kau samajhaavai ||",
      "translation": "One soul-bride counsels another,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੋਈ ਕਮਾਵੈ ਜੋ ਪ੍ਰਭ ਭਾਵੈ ॥",
      "transliteration": "soee kamaavai jo prabh bhaavai ||",
      "translation": "to do only that which pleases God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਾ ਸੋਹਾਗਣਿ ਅੰਕਿ ਸਮਾਵੈ ॥੨॥",
      "transliteration": "saa sohaagan a(n)k samaavai ||2||",
      "translation": "Such a soul-bride merges into the Being of God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗਰਬਿ ਗਹੇਲੀ ਮਹਲੁ ਨ ਪਾਵੈ ॥",
      "transliteration": "garab gahelee mahal na paavai ||",
      "translation": "One who is in the grip of pride does not obtain the Mansion of the Lord's Presence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਫਿਰਿ ਪਛੁਤਾਵੈ ਜਬ ਰੈਣਿ ਬਿਹਾਵੈ ॥",
      "transliteration": "phir pachhutaavai jab rain bihaavai ||",
      "translation": "She regrets and repents, when her life-night passes away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਰਮਹੀਣਿ ਮਨਮੁਖਿ ਦੁਖੁ ਪਾਵੈ ॥੩॥",
      "transliteration": "karamaheen manamukh dukh paavai ||3||",
      "translation": "The unfortunate self-willed manmukhs suffer in pain. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਨਉ ਕਰੀ ਜੇ ਜਾਣਾ ਦੂਰਿ ॥",
      "transliteration": "binau karee je jaanaa door ||",
      "translation": "I pray to God, but I think that He is far away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਭੁ ਅਬਿਨਾਸੀ ਰਹਿਆ ਭਰਪੂਰਿ ॥",
      "transliteration": "prabh abinaasee rahiaa bharapoor ||",
      "translation": "God is imperishable and eternal; He is pervading and permeating everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਨੁ ਨਾਨਕੁ ਗਾਵੈ ਦੇਖਿ ਹਦੂਰਿ ॥੪॥੩॥",
      "transliteration": "jan naanak gaavai dekh hadoor ||4||3||",
      "translation": "Servant Nanak sings of Him; I see Him Ever-present everywhere. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗ੍ਰਿਹੁ ਵਸਿ ਗੁਰਿ ਕੀਨਾ ਹਉ ਘਰ ਕੀ ਨਾਰਿ ॥",
      "transliteration": "grihu vas gur keenaa hau ghar kee naar ||",
      "translation": "The Giver has put this household of my being under my own control. I am now the mistress of the Lord's Home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦਸ ਦਾਸੀ ਕਰਿ ਦੀਨੀ ਭਤਾਰਿ ॥",
      "transliteration": "das daasee kar deenee bhataar ||",
      "translation": "My Husband Lord has made the ten senses and organs of actions my slaves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਗਲ ਸਮਗ੍ਰੀ ਮੈ ਘਰ ਕੀ ਜੋੜੀ ॥",
      "transliteration": "sagal samagree mai ghar kee joRee ||",
      "translation": "I have gathered together all the faculties and facilities of this house.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਆਸ ਪਿਆਸੀ ਪਿਰ ਕਉ ਲੋੜੀ ॥੧॥",
      "transliteration": "aas piaasee pir kau loRee ||1||",
      "translation": "I am thirsty with desire and longing for my Husband Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਵਨ ਕਹਾ ਗੁਨ ਕੰਤ ਪਿਆਰੇ ॥",
      "transliteration": "kavan kahaa gun ka(n)t piaare ||",
      "translation": "What Glorious Virtues of my Beloved Husband Lord should I describe?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁਘੜ ਸਰੂਪ ਦਇਆਲ ਮੁਰਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sughaR saroop daiaal muraare ||1|| rahaau ||",
      "translation": "He is All-knowing, totally beautiful and merciful; He is the Destroyer of ego. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਤੁ ਸੀਗਾਰੁ ਭਉ ਅੰਜਨੁ ਪਾਇਆ ॥",
      "transliteration": "sat seegaar bhau a(n)jan paaiaa ||",
      "translation": "I am adorned with Truth, and I have applied the mascara of the Fear of God to my eyes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਤੰਬੋਲੁ ਮੁਖਿ ਖਾਇਆ ॥",
      "transliteration": "a(n)mrit naam ta(n)bol mukh khaaiaa ||",
      "translation": "I have chewed the betel-leaf of the Ambrosial Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੰਗਨ ਬਸਤ੍ਰ ਗਹਨੇ ਬਨੇ ਸੁਹਾਵੇ ॥",
      "transliteration": "ka(n)gan basatr gahane bane suhaave ||",
      "translation": "My bracelets, robes and ornaments beautifully adorn me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਧਨ ਸਭ ਸੁਖ ਪਾਵੈ ਜਾਂ ਪਿਰੁ ਘਰਿ ਆਵੈ ॥੨॥",
      "transliteration": "dhan sabh sukh paavai jaa(n) pir ghar aavai ||2||",
      "translation": "The soul-bride becomes totally happy, when her Husband Lord comes to her home. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਣ ਕਾਮਣ ਕਰਿ ਕੰਤੁ ਰੀਝਾਇਆ ॥",
      "transliteration": "gun kaaman kar ka(n)t reejhaaiaa ||",
      "translation": "By the charms of virtue, I have enticed and fascinated my Husband Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਵਸਿ ਕਰਿ ਲੀਨਾ ਗੁਰਿ ਭਰਮੁ ਚੁਕਾਇਆ ॥",
      "transliteration": "vas kar leenaa gur bharam chukaaiaa ||",
      "translation": "He is under my power - the Guru has dispelled my doubts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਭ ਤੇ ਊਚਾ ਮੰਦਰੁ ਮੇਰਾ ॥",
      "transliteration": "sabh te oochaa ma(n)dar meraa ||",
      "translation": "My mansion is lofty and elevated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭ ਕਾਮਣਿ ਤਿਆਗੀ ਪ੍ਰਿਉ ਪ੍ਰੀਤਮੁ ਮੇਰਾ ॥੩॥",
      "transliteration": "sabh kaaman tiaagee priu preetam meraa ||3||",
      "translation": "Renouncing all other brides, my Beloved has become my lover. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪ੍ਰਗਟਿਆ ਸੂਰੁ ਜੋਤਿ ਉਜੀਆਰਾ ॥",
      "transliteration": "pragatiaa soor jot ujeeaaraa ||",
      "translation": "The sun has risen, and its light shines brightly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੇਜ ਵਿਛਾਈ ਸਰਧ ਅਪਾਰਾ ॥",
      "transliteration": "sej vichhaaee saradh apaaraa ||",
      "translation": "I have prepared my bed with infinite care and faith.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਵ ਰੰਗ ਲਾਲੁ ਸੇਜ ਰਾਵਣ ਆਇਆ ॥",
      "transliteration": "nav ra(n)g laal sej raavan aaiaa ||",
      "translation": "My Darling Beloved is new and fresh; He has come to my bed to enjoy me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਪਿਰ ਧਨ ਮਿਲਿ ਸੁਖੁ ਪਾਇਆ ॥੪॥੪॥",
      "transliteration": "jan naanak pir dhan mil sukh paaiaa ||4||4||",
      "translation": "O Servant Nanak, my Husband Lord has come; the soul-bride has found peace. ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਉਮਕਿਓ ਹੀਉ ਮਿਲਨ ਪ੍ਰਭ ਤਾਈ ॥",
      "transliteration": "umakio heeu milan prabh taaee ||",
      "translation": "An intense yearning to meet God has welled up in my heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਖੋਜਤ ਚਰਿਓ ਦੇਖਉ ਪ੍ਰਿਅ ਜਾਈ ॥",
      "transliteration": "khojat chario dekhau pri jaaee ||",
      "translation": "I have gone out searching to find my Beloved Husband Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੁਨਤ ਸਦੇਸਰੋ ਪ੍ਰਿਅ ਗ੍ਰਿਹਿ ਸੇਜ ਵਿਛਾਈ ॥",
      "transliteration": "sunat sadesaro pri grihi sej vichhaaee ||",
      "translation": "Hearing news of my Beloved, I have laid out my bed in my home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭ੍ਰਮਿ ਭ੍ਰਮਿ ਆਇਓ ਤਉ ਨਦਰਿ ਨ ਪਾਈ ॥੧॥",
      "transliteration": "bhram bhram aaio tau nadar na paaee ||1||",
      "translation": "Wandering, wandering all around, I came, but I did not even see Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿਨ ਬਿਧਿ ਹੀਅਰੋ ਧੀਰੈ ਨਿਮਾਨੋ ॥",
      "transliteration": "kin bidh heearo dheerai nimaano ||",
      "translation": "How can this poor heart be comforted?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮਿਲੁ ਸਾਜਨ ਹਉ ਤੁਝੁ ਕੁਰਬਾਨੋ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mil saajan hau tujh kurabaano ||1|| rahaau ||",
      "translation": "Come and meet me, O Friend; I am a sacrifice to You. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਏਕਾ ਸੇਜ ਵਿਛੀ ਧਨ ਕੰਤਾ ॥",
      "transliteration": "ekaa sej vichhee dhan ka(n)taa ||",
      "translation": "One bed is spread out for the bride and her Husband Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਧਨ ਸੂਤੀ ਪਿਰੁ ਸਦ ਜਾਗੰਤਾ ॥",
      "transliteration": "dhan sootee pir sad jaaga(n)taa ||",
      "translation": "The bride is asleep, while her Husband Lord is always awake.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪੀਓ ਮਦਰੋ ਧਨ ਮਤਵੰਤਾ ॥",
      "transliteration": "peeo madaro dhan matava(n)taa ||",
      "translation": "The bride is intoxicated, as if she has drunk wine.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਧਨ ਜਾਗੈ ਜੇ ਪਿਰੁ ਬੋਲੰਤਾ ॥੨॥",
      "transliteration": "dhan jaagai je pir bola(n)taa ||2||",
      "translation": "The soul-bride only awakens when her Husband Lord calls to her. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਭਈ ਨਿਰਾਸੀ ਬਹੁਤੁ ਦਿਨ ਲਾਗੇ ॥",
      "transliteration": "bhaee niraasee bahut din laage ||",
      "translation": "She has lost hope - so many days have passed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0737_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਦੇਸ ਦਿਸੰਤਰ ਮੈ ਸਗਲੇ ਝਾਗੇ ॥",
      "transliteration": "des disa(n)tar mai sagale jhaage ||",
      "translation": "I have travelled through all the lands and the countries.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 737,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
