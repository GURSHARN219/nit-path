{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 739,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0739_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਮੋਹਿ ਸਾਧਸੰਗੁ ਦੀਜੈ ॥੪॥",
      "transliteration": "kar kirapaa mohi saadhasa(n)g deejai ||4||",
      "translation": "Have Mercy upon me, and bless me with the Saadh Sangat, the Company of the Holy. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਉ ਕਿਛੁ ਪਾਈਐ ਜਉ ਹੋਈਐ ਰੇਨਾ ॥",
      "transliteration": "tau kichh paaeeai jau hoeeai renaa ||",
      "translation": "He alone obtains something, who becomes the dust under the feet of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਿਸਹਿ ਬੁਝਾਏ ਤਿਸੁ ਨਾਮੁ ਲੈਨਾ ॥੧॥ ਰਹਾਉ ॥੨॥੮॥",
      "transliteration": "jisahi bujhaae tis naam lainaa ||1|| rahaau ||2||8||",
      "translation": "And he alone repeats the Naam, whom God causes to understand. ||1||Pause||2||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਘਰ ਮਹਿ ਠਾਕੁਰੁ ਨਦਰਿ ਨ ਆਵੈ ॥",
      "transliteration": "ghar mahi thaakur nadar na aavai ||",
      "translation": "Within the home of his own self, he does not even come to see his Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗਲ ਮਹਿ ਪਾਹਣੁ ਲੈ ਲਟਕਾਵੈ ॥੧॥",
      "transliteration": "gal mahi paahan lai latakaavai ||1||",
      "translation": "And yet, around his neck, he hangs a stone god. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਰਮੇ ਭੂਲਾ ਸਾਕਤੁ ਫਿਰਤਾ ॥",
      "transliteration": "bharame bhoolaa saakat phirataa ||",
      "translation": "The faithless cynic wanders around, deluded by doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨੀਰੁ ਬਿਰੋਲੈ ਖਪਿ ਖਪਿ ਮਰਤਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "neer birolai khap khap marataa ||1|| rahaau ||",
      "translation": "He churns water, and after wasting his life away, he dies. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਿਸੁ ਪਾਹਣ ਕਉ ਠਾਕੁਰੁ ਕਹਤਾ ॥",
      "transliteration": "jis paahan kau thaakur kahataa ||",
      "translation": "That stone, which he calls his god,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਓਹੁ ਪਾਹਣੁ ਲੈ ਉਸ ਕਉ ਡੁਬਤਾ ॥੨॥",
      "transliteration": "ohu paahan lai us kau dubataa ||2||",
      "translation": "that stone pulls him down and drowns him. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਨਹਗਾਰ ਲੂਣ ਹਰਾਮੀ ॥",
      "transliteration": "gunahagaar loon haraamee ||",
      "translation": "O sinner, you are untrue to your own self;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪਾਹਣ ਨਾਵ ਨ ਪਾਰਗਿਰਾਮੀ ॥੩॥",
      "transliteration": "paahan naav na paaragiraamee ||3||",
      "translation": "a boat of stone will not carry you across. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੁਰ ਮਿਲਿ ਨਾਨਕ ਠਾਕੁਰੁ ਜਾਤਾ ॥",
      "transliteration": "gur mil naanak thaakur jaataa ||",
      "translation": "Meeting the Guru, O Nanak, I know my Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ ਪੂਰਨ ਬਿਧਾਤਾ ॥੪॥੩॥੯॥",
      "transliteration": "jal thal maheeal pooran bidhaataa ||4||3||9||",
      "translation": "The Perfect Architect of Destiny is pervading and permeating the water, the land and the sky. ||4||3||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਲਾਲਨੁ ਰਾਵਿਆ ਕਵਨ ਗਤੀ ਰੀ ॥",
      "transliteration": "laalan raaviaa kavan gatee ree ||",
      "translation": "How have you enjoyed your Dear Beloved?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਖੀ ਬਤਾਵਹੁ ਮੁਝਹਿ ਮਤੀ ਰੀ ॥੧॥",
      "transliteration": "sakhee bataavahu mujhahi matee ree ||1||",
      "translation": "O sister, please teach me, please show me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੂਹਬ ਸੂਹਬ ਸੂਹਵੀ ॥",
      "transliteration": "soohab soohab soohavee ||",
      "translation": "Crimson, crimson, crimson",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਪਨੇ ਪ੍ਰੀਤਮ ਕੈ ਰੰਗਿ ਰਤੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "apane preetam kai ra(n)g ratee ||1|| rahaau ||",
      "translation": "- this is the color of the soul-bride who is imbued with the Love of her Beloved. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਾਵ ਮਲੋਵਉ ਸੰਗਿ ਨੈਨ ਭਤੀਰੀ ॥",
      "transliteration": "paav malovau sa(n)g nain bhateeree ||",
      "translation": "I wash Your Feet with my eye-lashes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਹਾ ਪਠਾਵਹੁ ਜਾਂਉ ਤਤੀ ਰੀ ॥੨॥",
      "transliteration": "jahaa pathaavahu jaa(n)u tatee ree ||2||",
      "translation": "Wherever You send me, there I will go. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਪ ਤਪ ਸੰਜਮ ਦੇਉ ਜਤੀ ਰੀ ॥",
      "transliteration": "jap tap sa(n)jam deu jatee ree ||",
      "translation": "I would trade meditation, austerity, self-discipline and celibacy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਇਕ ਨਿਮਖ ਮਿਲਾਵਹੁ ਮੋਹਿ ਪ੍ਰਾਨਪਤੀ ਰੀ ॥੩॥",
      "transliteration": "ik nimakh milaavahu mohi praanapatee ree ||3||",
      "translation": "if I could only meet the Lord of my life, for even an instant. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਾਣੁ ਤਾਣੁ ਅਹੰਬੁਧਿ ਹਤੀ ਰੀ ॥",
      "transliteration": "maan taan aha(n)budh hatee ree ||",
      "translation": "She who eradicates her self-conceit, power and arrogant intellect,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਾ ਨਾਨਕ ਸੋਹਾਗਵਤੀ ਰੀ ॥੪॥੪॥੧੦॥",
      "transliteration": "saa naanak sohaagavatee ree ||4||4||10||",
      "translation": "O Nanak, is the true soul-bride. ||4||4||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੂੰ ਜੀਵਨੁ ਤੂੰ ਪ੍ਰਾਨ ਅਧਾਰਾ ॥",
      "transliteration": "too(n) jeevan too(n) praan adhaaraa ||",
      "translation": "You are my Life, the very Support of my breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੁਝ ਹੀ ਪੇਖਿ ਪੇਖਿ ਮਨੁ ਸਾਧਾਰਾ ॥੧॥",
      "transliteration": "tujh hee pekh pekh man saadhaaraa ||1||",
      "translation": "Gazing upon You, beholding You, my mind is soothed and comforted. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੂੰ ਸਾਜਨੁ ਤੂੰ ਪ੍ਰੀਤਮੁ ਮੇਰਾ ॥",
      "transliteration": "too(n) saajan too(n) preetam meraa ||",
      "translation": "You are my Friend, You are my Beloved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਚਿਤਹਿ ਨ ਬਿਸਰਹਿ ਕਾਹੂ ਬੇਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "chitahi na bisarahi kaahoo beraa ||1|| rahaau ||",
      "translation": "I shall never forget You. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬੈ ਖਰੀਦੁ ਹਉ ਦਾਸਰੋ ਤੇਰਾ ॥",
      "transliteration": "bai khareed hau daasaro teraa ||",
      "translation": "I am Your indentured servant; I am Your slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤੂੰ ਭਾਰੋ ਠਾਕੁਰੁ ਗੁਣੀ ਗਹੇਰਾ ॥੨॥",
      "transliteration": "too(n) bhaaro thaakur gunee gaheraa ||2||",
      "translation": "You are my Great Lord and Master, the treasure of excellence. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੋਟਿ ਦਾਸ ਜਾ ਕੈ ਦਰਬਾਰੇ ॥",
      "transliteration": "kot daas jaa kai darabaare ||",
      "translation": "There are millions of servants in Your Court - Your Royal Darbaar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਿਮਖ ਨਿਮਖ ਵਸੈ ਤਿਨੑ ਨਾਲੇ ॥੩॥",
      "transliteration": "nimakh nimakh vasai tinh naale ||3||",
      "translation": "Each and every instant, You dwell with them. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਉ ਕਿਛੁ ਨਾਹੀ ਸਭੁ ਕਿਛੁ ਤੇਰਾ ॥",
      "transliteration": "hau kichh naahee sabh kichh teraa ||",
      "translation": "I am nothing; everything is Yours.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਓਤਿ ਪੋਤਿ ਨਾਨਕ ਸੰਗਿ ਬਸੇਰਾ ॥੪॥੫॥੧੧॥",
      "transliteration": "ot pot naanak sa(n)g baseraa ||4||5||11||",
      "translation": "Through and through, You abide with Nanak. ||4||5||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੂਖ ਮਹਲ ਜਾ ਕੇ ਊਚ ਦੁਆਰੇ ॥",
      "transliteration": "sookh mahal jaa ke ooch duaare ||",
      "translation": "His Mansions are so comfortable, and His gates are so lofty.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਾ ਮਹਿ ਵਾਸਹਿ ਭਗਤ ਪਿਆਰੇ ॥੧॥",
      "transliteration": "taa mahi vaasahi bhagat piaare ||1||",
      "translation": "Within them, His beloved devotees dwell. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਹਜ ਕਥਾ ਪ੍ਰਭ ਕੀ ਅਤਿ ਮੀਠੀ ॥",
      "transliteration": "sahaj kathaa prabh kee at meethee ||",
      "translation": "The Natural Speech of God is so very sweet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਵਿਰਲੈ ਕਾਹੂ ਨੇਤ੍ਰਹੁ ਡੀਠੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "viralai kaahoo netrahu deethee ||1|| rahaau ||",
      "translation": "How rare is that person, who sees it with his eyes. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਹ ਗੀਤ ਨਾਦ ਅਖਾਰੇ ਸੰਗਾ ॥",
      "transliteration": "tah geet naad akhaare sa(n)gaa ||",
      "translation": "There, in the arena of the congregation, the divine music of the Naad, the sound current, is sung.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਊਹਾ ਸੰਤ ਕਰਹਿ ਹਰਿ ਰੰਗਾ ॥੨॥",
      "transliteration": "oohaa sa(n)t karahi har ra(n)gaa ||2||",
      "translation": "There, the Saints celebrate with their Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਹ ਮਰਣੁ ਨ ਜੀਵਣੁ ਸੋਗੁ ਨ ਹਰਖਾ ॥",
      "transliteration": "tah maran na jeevan sog na harakhaa ||",
      "translation": "Neither birth nor death is there, neither pain nor pleasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਾਚ ਨਾਮ ਕੀ ਅੰਮ੍ਰਿਤ ਵਰਖਾ ॥੩॥",
      "transliteration": "saach naam kee a(n)mrit varakhaa ||3||",
      "translation": "The Ambrosial Nectar of the True Name rains down there. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਹਜ ਕਥਾ ਇਹ ਗੁਰ ਤੇ ਜਾਣੀ ॥",
      "transliteration": "guhaj kathaa ih gur te jaanee ||",
      "translation": "From the Guru, I have come to know the mystery of this speech.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਨਕੁ ਬੋਲੈ ਹਰਿ ਹਰਿ ਬਾਣੀ ॥੪॥੬॥੧੨॥",
      "transliteration": "naanak bolai har har baanee ||4||6||12||",
      "translation": "Nanak speaks the Bani of the Lord, Har, Har. ||4||6||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਾ ਕੈ ਦਰਸਿ ਪਾਪ ਕੋਟਿ ਉਤਾਰੇ ॥",
      "transliteration": "jaa kai daras paap kot utaare ||",
      "translation": "By the Blessed Vision of their Darshan, millions of sins are erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਭੇਟਤ ਸੰਗਿ ਇਹੁ ਭਵਜਲੁ ਤਾਰੇ ॥੧॥",
      "transliteration": "bhetat sa(n)g ihu bhavajal taare ||1||",
      "translation": "Meeting with them, this terrifying world-ocean is crossed over||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਓਇ ਸਾਜਨ ਓਇ ਮੀਤ ਪਿਆਰੇ ॥",
      "transliteration": "oi saajan oi meet piaare ||",
      "translation": "They are my companions, and they are my dear friends,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜੋ ਹਮ ਕਉ ਹਰਿ ਨਾਮੁ ਚਿਤਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jo ham kau har naam chitaare ||1|| rahaau ||",
      "translation": "who inspire me to remember the Lord's Name. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਾ ਕਾ ਸਬਦੁ ਸੁਨਤ ਸੁਖ ਸਾਰੇ ॥",
      "transliteration": "jaa kaa sabad sunat sukh saare ||",
      "translation": "Hearing the Word of His Shabad, I am totally at peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਾ ਕੀ ਟਹਲ ਜਮਦੂਤ ਬਿਦਾਰੇ ॥੨॥",
      "transliteration": "jaa kee tahal jamadoot bidaare ||2||",
      "translation": "When I serve Him, the Messenger of Death is chased away. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਾ ਕੀ ਧੀਰਕ ਇਸੁ ਮਨਹਿ ਸਧਾਰੇ ॥",
      "transliteration": "jaa kee dheerak is manahi sadhaare ||",
      "translation": "His comfort and consolation soothes and supports my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਜਾ ਕੈ ਸਿਮਰਣਿ ਮੁਖ ਉਜਲਾਰੇ ॥੩॥",
      "transliteration": "jaa kai simaran mukh ujalaare ||3||",
      "translation": "Remembering Him in meditation, my face is radiant and bright. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਪ੍ਰਭ ਕੇ ਸੇਵਕ ਪ੍ਰਭਿ ਆਪਿ ਸਵਾਰੇ ॥",
      "transliteration": "prabh ke sevak prabh aap savaare ||",
      "translation": "God embellishes and supports His servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0739_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸਰਣਿ ਨਾਨਕ ਤਿਨੑ ਸਦ ਬਲਿਹਾਰੇ ॥੪॥੭॥੧੩॥",
      "transliteration": "saran naanak tinh sad balihaare ||4||7||13||",
      "translation": "Nanak seeks the Protection of their Sanctuary; he is forever a sacrifice to them. ||4||7||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 739,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
