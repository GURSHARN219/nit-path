{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 740,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0740_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਹਣੁ ਨ ਪਾਵਹਿ ਸੁਰਿ ਨਰ ਦੇਵਾ ॥",
      "transliteration": "rahan na paavahi sur nar devaa ||",
      "translation": "The angelic beings and demi-gods are not permitted to remain here.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਊਠਿ ਸਿਧਾਰੇ ਕਰਿ ਮੁਨਿ ਜਨ ਸੇਵਾ ॥੧॥",
      "transliteration": "ooth sidhaare kar mun jan sevaa ||1||",
      "translation": "The silent sages and humble servants also must arise and depart. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੀਵਤ ਪੇਖੇ ਜਿਨੑੀ ਹਰਿ ਹਰਿ ਧਿਆਇਆ ॥",
      "transliteration": "jeevat pekhe jinhee har har dhiaaiaa ||",
      "translation": "Only those who meditate on the Lord, Har, Har, are seen to live on.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਤਿਨੑੀ ਦਰਸਨੁ ਪਾਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saadhasa(n)g tinhee darasan paaiaa ||1|| rahaau ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, they obtain the Blessed Vision of the Lord's Darshan. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਾਦਿਸਾਹ ਸਾਹ ਵਾਪਾਰੀ ਮਰਨਾ ॥",
      "transliteration": "baadisaah saah vaapaaree maranaa ||",
      "translation": "Kings, emperors and merchants must die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੋ ਦੀਸੈ ਸੋ ਕਾਲਹਿ ਖਰਨਾ ॥੨॥",
      "transliteration": "jo deesai so kaalahi kharanaa ||2||",
      "translation": "Whoever is seen shall be consumed by death. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕੂੜੈ ਮੋਹਿ ਲਪਟਿ ਲਪਟਾਨਾ ॥",
      "transliteration": "kooRai mohi lapat lapataanaa ||",
      "translation": "Mortal beings are entangled, clinging to false worldly attachments.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਛੋਡਿ ਚਲਿਆ ਤਾ ਫਿਰਿ ਪਛੁਤਾਨਾ ॥੩॥",
      "transliteration": "chhod chaliaa taa phir pachhutaanaa ||3||",
      "translation": "And when they must leave them behind, then they regret and grieve. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਨਿਧਾਨ ਨਾਨਕ ਕਉ ਕਰਹੁ ਦਾਤਿ ॥",
      "transliteration": "kripaa nidhaan naanak kau karahu daat ||",
      "translation": "O Lord, O treasure of mercy, please bless Nanak with this gift,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਮੁ ਤੇਰਾ ਜਪੀ ਦਿਨੁ ਰਾਤਿ ॥੪॥੮॥੧੪॥",
      "transliteration": "naam teraa japee din raat ||4||8||14||",
      "translation": "that he may chant Your Name, day and night. ||4||8||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਘਟ ਘਟ ਅੰਤਰਿ ਤੁਮਹਿ ਬਸਾਰੇ ॥",
      "transliteration": "ghat ghat a(n)tar tumahi basaare ||",
      "translation": "You dwell deep within the heart of each and every being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਗਲ ਸਮਗ੍ਰੀ ਸੂਤਿ ਤੁਮਾਰੇ ॥੧॥",
      "transliteration": "sagal samagree soot tumaare ||1||",
      "translation": "The entire universe is strung on Your Thread. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤੂੰ ਪ੍ਰੀਤਮ ਤੂੰ ਪ੍ਰਾਨ ਅਧਾਰੇ ॥",
      "transliteration": "too(n) preetam too(n) praan adhaare ||",
      "translation": "You are my Beloved, the Support of my breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤੁਮ ਹੀ ਪੇਖਿ ਪੇਖਿ ਮਨੁ ਬਿਗਸਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tum hee pekh pekh man bigasaare ||1|| rahaau ||",
      "translation": "Beholding You, gazing upon You, my mind blossoms forth. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਨਿਕ ਜੋਨਿ ਭ੍ਰਮਿ ਭ੍ਰਮਿ ਭ੍ਰਮਿ ਹਾਰੇ ॥",
      "transliteration": "anik jon bhram bhram bhram haare ||",
      "translation": "Wandering, wandering, wandering through countless incarnations, I have grown so weary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਓਟ ਗਹੀ ਅਬ ਸਾਧ ਸੰਗਾਰੇ ॥੨॥",
      "transliteration": "ot gahee ab saadh sa(n)gaare ||2||",
      "translation": "Now, I hold tight to the Saadh Sangat, the Company of the Holy. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਗਮ ਅਗੋਚਰੁ ਅਲਖ ਅਪਾਰੇ ॥",
      "transliteration": "agam agochar alakh apaare ||",
      "translation": "You are inaccessible, incomprehensible, invisible and infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਨਕੁ ਸਿਮਰੈ ਦਿਨੁ ਰੈਨਾਰੇ ॥੩॥੯॥੧੫॥",
      "transliteration": "naanak simarai din rainaare ||3||9||15||",
      "translation": "Nanak remembers You in meditation, day and night. ||3||9||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਵਨ ਕਾਜ ਮਾਇਆ ਵਡਿਆਈ ॥",
      "transliteration": "kavan kaaj maaiaa vadiaaee ||",
      "translation": "What is the use of the glory of Maya?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾ ਕਉ ਬਿਨਸਤ ਬਾਰ ਨ ਕਾਈ ॥੧॥",
      "transliteration": "jaa kau binasat baar na kaaee ||1||",
      "translation": "It disappears in no time at all. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਹੁ ਸੁਪਨਾ ਸੋਵਤ ਨਹੀ ਜਾਨੈ ॥",
      "transliteration": "ihu supanaa sovat nahee jaanai ||",
      "translation": "This is a dream, but the sleeper does not know it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਚੇਤ ਬਿਵਸਥਾ ਮਹਿ ਲਪਟਾਨੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "achet bivasathaa mahi lapataanai ||1|| rahaau ||",
      "translation": "In his unconscious state, he clings to it. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਹਾ ਮੋਹਿ ਮੋਹਿਓ ਗਾਵਾਰਾ ॥",
      "transliteration": "mahaa mohi mohio gaavaaraa ||",
      "translation": "The poor fool is enticed by the great attachments of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੇਖਤ ਪੇਖਤ ਊਠਿ ਸਿਧਾਰਾ ॥੨॥",
      "transliteration": "pekhat pekhat ooth sidhaaraa ||2||",
      "translation": "Gazing upon them, watching them, he must still arise and depart. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਊਚ ਤੇ ਊਚ ਤਾ ਕਾ ਦਰਬਾਰਾ ॥",
      "transliteration": "ooch te ooch taa kaa darabaaraa ||",
      "translation": "The Royal Court of His Darbaar is the highest of the high.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਈ ਜੰਤ ਬਿਨਾਹਿ ਉਪਾਰਾ ॥੩॥",
      "transliteration": "kaee ja(n)t binaahi upaaraa ||3||",
      "translation": "He creates and destroys countless beings. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੂਸਰ ਹੋਆ ਨਾ ਕੋ ਹੋਈ ॥",
      "transliteration": "doosar hoaa naa ko hoee ||",
      "translation": "There has never been any other, and there shall never be.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਪਿ ਨਾਨਕ ਪ੍ਰਭ ਏਕੋ ਸੋਈ ॥੪॥੧੦॥੧੬॥",
      "transliteration": "jap naanak prabh eko soee ||4||10||16||",
      "translation": "O Nanak, meditate on the One God. ||4||10||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਤਾ ਕਉ ਹਉ ਜੀਵਾ ॥",
      "transliteration": "simar simar taa kau hau jeevaa ||",
      "translation": "Meditating, meditating in remembrance on Him, I live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚਰਣ ਕਮਲ ਤੇਰੇ ਧੋਇ ਧੋਇ ਪੀਵਾ ॥੧॥",
      "transliteration": "charan kamal tere dhoi dhoi peevaa ||1||",
      "translation": "I wash Your Lotus Feet, and drink in the wash water. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੋ ਹਰਿ ਮੇਰਾ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "so har meraa a(n)tarajaamee ||",
      "translation": "He is my Lord, the Inner-knower, the Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਗਤ ਜਨਾ ਕੈ ਸੰਗਿ ਸੁਆਮੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bhagat janaa kai sa(n)g suaamee ||1|| rahaau ||",
      "translation": "My Lord and Master abides with His humble devotees. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਣਿ ਸੁਣਿ ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਧਿਆਵਾ ॥",
      "transliteration": "sun sun a(n)mrit naam dhiaavaa ||",
      "translation": "Hearing, hearing Your Ambrosial Naam, I meditate on it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਠ ਪਹਰ ਤੇਰੇ ਗੁਣ ਗਾਵਾ ॥੨॥",
      "transliteration": "aath pahar tere gun gaavaa ||2||",
      "translation": "Twenty-four hours a day, I sing Your Glorious Praises. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪੇਖਿ ਪੇਖਿ ਲੀਲਾ ਮਨਿ ਆਨੰਦਾ ॥",
      "transliteration": "pekh pekh leelaa man aana(n)daa ||",
      "translation": "Beholding, beholding Your divine play, my mind is in bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਣ ਅਪਾਰ ਪ੍ਰਭ ਪਰਮਾਨੰਦਾ ॥੩॥",
      "transliteration": "gun apaar prabh paramaana(n)daa ||3||",
      "translation": "Your Glorious Virtues are infinite, O God, O Lord of supreme bliss. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਾ ਕੈ ਸਿਮਰਨਿ ਕਛੁ ਭਉ ਨ ਬਿਆਪੈ ॥",
      "transliteration": "jaa kai simaran kachh bhau na biaapai ||",
      "translation": "Meditating in remembrance on Him, fear cannot touch me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਨਾਨਕ ਹਰਿ ਜਾਪੈ ॥੪॥੧੧॥੧੭॥",
      "transliteration": "sadaa sadaa naanak har jaapai ||4||11||17||",
      "translation": "Forever and ever, Nanak meditates on the Lord. ||4||11||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰ ਕੈ ਬਚਨਿ ਰਿਦੈ ਧਿਆਨੁ ਧਾਰੀ ॥",
      "transliteration": "gur kai bachan ridai dhiaan dhaaree ||",
      "translation": "Within my heart, I meditate on the Word of the Guru's Teachings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਸਨਾ ਜਾਪੁ ਜਪਉ ਬਨਵਾਰੀ ॥੧॥",
      "transliteration": "rasanaa jaap japau banavaaree ||1||",
      "translation": "With my tongue, I chant the Chant of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਫਲ ਮੂਰਤਿ ਦਰਸਨ ਬਲਿਹਾਰੀ ॥",
      "transliteration": "saphal moorat darasan balihaaree ||",
      "translation": "The image of His vision is fruitful; I am a sacrifice to it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚਰਣ ਕਮਲ ਮਨ ਪ੍ਰਾਣ ਅਧਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "charan kamal man praan adhaaree ||1|| rahaau ||",
      "translation": "His Lotus Feet are the Support of the mind, the Support of the very breath of life. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਜਨਮ ਮਰਣ ਨਿਵਾਰੀ ॥",
      "transliteration": "saadhasa(n)g janam maran nivaaree ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, the cycle of birth and death is ended.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਕਥਾ ਸੁਣਿ ਕਰਨ ਅਧਾਰੀ ॥੨॥",
      "transliteration": "a(n)mrit kathaa sun karan adhaaree ||2||",
      "translation": "To hear the Ambrosial Sermon is the support of my ears. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਲੋਭ ਮੋਹ ਤਜਾਰੀ ॥",
      "transliteration": "kaam krodh lobh moh tajaaree ||",
      "translation": "I have renounced sexual desire, anger, greed and emotional attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਦ੍ਰਿੜੁ ਨਾਮ ਦਾਨੁ ਇਸਨਾਨੁ ਸੁਚਾਰੀ ॥੩॥",
      "transliteration": "driR naam daan isanaan suchaaree ||3||",
      "translation": "I have enshrined the Naam within myself, with charity, true cleansing and righteous conduct. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਇਹੁ ਤਤੁ ਬੀਚਾਰੀ ॥",
      "transliteration": "kahu naanak ihu tat beechaaree ||",
      "translation": "Says Nanak, I have contemplated this essence of reality;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਜਪਿ ਪਾਰਿ ਉਤਾਰੀ ॥੪॥੧੨॥੧੮॥",
      "transliteration": "raam naam jap paar utaaree ||4||12||18||",
      "translation": "chanting the Name of the Lord, I am carried across. ||4||12||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0740_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਲੋਭਿ ਮੋਹਿ ਮਗਨ ਅਪਰਾਧੀ ॥",
      "transliteration": "lobh mohi magan aparaadhee ||",
      "translation": "The sinner is absorbed in greed and emotional attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 740,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
