{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 741,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0741_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਰਣਹਾਰ ਕੀ ਸੇਵ ਨ ਸਾਧੀ ॥੧॥",
      "transliteration": "karanahaar kee sev na saadhee ||1||",
      "translation": "He has not performed any service to the Creator Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪਤਿਤ ਪਾਵਨ ਪ੍ਰਭ ਨਾਮ ਤੁਮਾਰੇ ॥",
      "transliteration": "patit paavan prabh naam tumaare ||",
      "translation": "O God, Your Name is the Purifier of sinners.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਾਖਿ ਲੇਹੁ ਮੋਹਿ ਨਿਰਗੁਨੀਆਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raakh lehu mohi niraguneeaare ||1|| rahaau ||",
      "translation": "I am worthless - please save me! ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤੂੰ ਦਾਤਾ ਪ੍ਰਭ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "too(n) daataa prabh a(n)tarajaamee ||",
      "translation": "O God, You are the Great Giver, the Inner-knower, the Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਾਚੀ ਦੇਹ ਮਾਨੁਖ ਅਭਿਮਾਨੀ ॥੨॥",
      "transliteration": "kaachee deh maanukh abhimaanee ||2||",
      "translation": "The body of the egotistical human is perishable. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੁਆਦ ਬਾਦ ਈਰਖ ਮਦ ਮਾਇਆ ॥",
      "transliteration": "suaad baad eerakh mad maaiaa ||",
      "translation": "Tastes and pleasures, conflicts and jealousy, and intoxication with Maya",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਇਨ ਸੰਗਿ ਲਾਗਿ ਰਤਨ ਜਨਮੁ ਗਵਾਇਆ ॥੩॥",
      "transliteration": "in sa(n)g laag ratan janam gavaaiaa ||3||",
      "translation": "- attached to these, the jewel of human life is wasted. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੁਖ ਭੰਜਨ ਜਗਜੀਵਨ ਹਰਿ ਰਾਇਆ ॥",
      "transliteration": "dukh bha(n)jan jagajeevan har raaiaa ||",
      "translation": "The Sovereign Lord King is the Destroyer of pain, the Life of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਗਲ ਤਿਆਗਿ ਨਾਨਕੁ ਸਰਣਾਇਆ ॥੪॥੧੩॥੧੯॥",
      "transliteration": "sagal tiaag naanak saranaaiaa ||4||13||19||",
      "translation": "Forsaking everything, Nanak has entered His Sanctuary. ||4||13||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪੇਖਤ ਚਾਖਤ ਕਹੀਅਤ ਅੰਧਾ ਸੁਨੀਅਤ ਸੁਨੀਐ ਨਾਹੀ ॥",
      "transliteration": "pekhat chaakhat kaheeat a(n)dhaa suneeat suneeai naahee ||",
      "translation": "He sees with his eyes, but he is called blind; he hears, but he does not hear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਿਕਟਿ ਵਸਤੁ ਕਉ ਜਾਣੈ ਦੂਰੇ ਪਾਪੀ ਪਾਪ ਕਮਾਹੀ ॥੧॥",
      "transliteration": "nikat vasat kau jaanai doore paapee paap kamaahee ||1||",
      "translation": "And the One who dwells near at hand, he thinks that He is far away; the sinner is committing sins. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੋ ਕਿਛੁ ਕਰਿ ਜਿਤੁ ਛੁਟਹਿ ਪਰਾਨੀ ॥",
      "transliteration": "so kichh kar jit chhutahi paraanee ||",
      "translation": "Do only those deeds which will save you, O mortal being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਪਿ ਅੰਮ੍ਰਿਤ ਬਾਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har har naam jap a(n)mrit baanee ||1|| rahaau ||",
      "translation": "Chant the Name of the Lord, Har, Har, and the Ambrosial Word of His Bani. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਘੋਰ ਮਹਲ ਸਦਾ ਰੰਗਿ ਰਾਤਾ ॥",
      "transliteration": "ghor mahal sadaa ra(n)g raataa ||",
      "translation": "You are forever imbued with the love of horses and mansions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੰਗਿ ਤੁਮੑਾਰੈ ਕਛੂ ਨ ਜਾਤਾ ॥੨॥",
      "transliteration": "sa(n)g tumhaarai kachhoo na jaataa ||2||",
      "translation": "Nothing shall go along with you. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਖਹਿ ਪੋਚਾਰਿ ਮਾਟੀ ਕਾ ਭਾਂਡਾ ॥",
      "transliteration": "rakhahi pochaar maatee kaa bhaa(n)daa ||",
      "translation": "You may clean and decorate the vessel of clay,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਤਿ ਕੁਚੀਲ ਮਿਲੈ ਜਮ ਡਾਂਡਾ ॥੩॥",
      "transliteration": "at kucheel milai jam daa(n)daa ||3||",
      "translation": "but it is so very filthy; it shall receive its punishment from the Messenger of Death. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧਿ ਲੋਭਿ ਮੋਹਿ ਬਾਧਾ ॥",
      "transliteration": "kaam krodh lobh mohi baadhaa ||",
      "translation": "You are bound by sexual desire, anger, greed and emotional attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਹਾ ਗਰਤ ਮਹਿ ਨਿਘਰਤ ਜਾਤਾ ॥੪॥",
      "transliteration": "mahaa garat mahi nigharat jaataa ||4||",
      "translation": "You are sinking down into the great pit. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਨਕ ਕੀ ਅਰਦਾਸਿ ਸੁਣੀਜੈ ॥",
      "transliteration": "naanak kee aradaas suneejai ||",
      "translation": "Hear this prayer of Nanak, O Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਡੂਬਤ ਪਾਹਨ ਪ੍ਰਭ ਮੇਰੇ ਲੀਜੈ ॥੫॥੧੪॥੨੦॥",
      "transliteration": "doobat paahan prabh mere leejai ||5||14||20||",
      "translation": "I am a stone, sinking down - please, rescue me! ||5||14||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੀਵਤ ਮਰੈ ਬੁਝੈ ਪ੍ਰਭੁ ਸੋਇ ॥",
      "transliteration": "jeevat marai bujhai prabh soi ||",
      "translation": "One who remains dead while yet alive understands God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਕਰਮਿ ਪਰਾਪਤਿ ਹੋਇ ॥੧॥",
      "transliteration": "tis jan karam paraapat hoi ||1||",
      "translation": "He meets that humble being according to the karma of his past actions. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੁਣਿ ਸਾਜਨ ਇਉ ਦੁਤਰੁ ਤਰੀਐ ॥",
      "transliteration": "sun saajan iu dutar tareeai ||",
      "translation": "Listen, O friend - this is how to cross over the terrifying world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਿਲਿ ਸਾਧੂ ਹਰਿ ਨਾਮੁ ਉਚਰੀਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mil saadhoo har naam uchareeai ||1|| rahaau ||",
      "translation": "Meet with the Holy, and chant the Lord's Name||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਏਕ ਬਿਨਾ ਦੂਜਾ ਨਹੀ ਜਾਨੈ ॥",
      "transliteration": "ek binaa doojaa nahee jaanai ||",
      "translation": "There is no other to know, except for the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਘਟ ਘਟ ਅੰਤਰਿ ਪਾਰਬ੍ਰਹਮੁ ਪਛਾਨੈ ॥੨॥",
      "transliteration": "ghat ghat a(n)tar paarabraham pachhaanai ||2||",
      "translation": "So realize that the Supreme Lord God is within each and every heart. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕਰੈ ਸੋਈ ਭਲ ਮਾਨੈ ॥",
      "transliteration": "jo kichh karai soee bhal maanai ||",
      "translation": "Whatever He does, accept that as good.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਦਿ ਅੰਤ ਕੀ ਕੀਮਤਿ ਜਾਨੈ ॥੩॥",
      "transliteration": "aad a(n)t kee keemat jaanai ||3||",
      "translation": "Know the value of the beginning and the end. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਤਿਸੁ ਜਨ ਬਲਿਹਾਰੀ ॥",
      "transliteration": "kahu naanak tis jan balihaaree ||",
      "translation": "Says Nanak, I am a sacrifice to that humble being,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਾ ਕੈ ਹਿਰਦੈ ਵਸਹਿ ਮੁਰਾਰੀ ॥੪॥੧੫॥੨੧॥",
      "transliteration": "jaa kai hiradai vasahi muraaree ||4||15||21||",
      "translation": "within whose heart the Lord dwells. ||4||15||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰੁ ਪਰਮੇਸਰੁ ਕਰਣੈਹਾਰੁ ॥",
      "transliteration": "gur paramesar karanaihaar ||",
      "translation": "The Guru is the Transcendent Lord, the Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਗਲ ਸ੍ਰਿਸਟਿ ਕਉ ਦੇ ਆਧਾਰੁ ॥੧॥",
      "transliteration": "sagal srisat kau de aadhaar ||1||",
      "translation": "He gives His Support to the entire Universe. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਣ ਕਮਲ ਮਨ ਧਿਆਇ ॥",
      "transliteration": "gur ke charan kamal man dhiaai ||",
      "translation": "Meditate within your mind on the Lotus Feet of the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੂਖੁ ਦਰਦੁ ਇਸੁ ਤਨ ਤੇ ਜਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dookh darad is tan te jaai ||1|| rahaau ||",
      "translation": "Pain and suffering shall leave this body. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭਵਜਲਿ ਡੂਬਤ ਸਤਿਗੁਰੁ ਕਾਢੈ ॥",
      "transliteration": "bhavajal doobat satigur kaadhai ||",
      "translation": "The True Guru saves the drowning being from the terrifying world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕਾ ਟੂਟਾ ਗਾਢੈ ॥੨॥",
      "transliteration": "janam janam kaa tootaa gaadhai ||2||",
      "translation": "He reunites those who were separated for countless incarnations. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੁਰ ਕੀ ਸੇਵਾ ਕਰਹੁ ਦਿਨੁ ਰਾਤਿ ॥",
      "transliteration": "gur kee sevaa karahu din raat ||",
      "translation": "Serve the Guru, day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਮਨਿ ਆਵੈ ਸਾਂਤਿ ॥੩॥",
      "transliteration": "sookh sahaj man aavai saa(n)t ||3||",
      "translation": "Your mind shall come to have peace, pleasure and poise. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਤਿਗੁਰ ਕੀ ਰੇਣੁ ਵਡਭਾਗੀ ਪਾਵੈ ॥",
      "transliteration": "satigur kee ren vadabhaagee paavai ||",
      "translation": "By great good fortune, one obtains the dust of the feet of the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਗੁਰ ਕਉ ਸਦ ਬਲਿ ਜਾਵੈ ॥੪॥੧੬॥੨੨॥",
      "transliteration": "naanak gur kau sad bal jaavai ||4||16||22||",
      "translation": "Nanak is forever a sacrifice to the True Guru. ||4||16||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰ ਅਪੁਨੇ ਊਪਰਿ ਬਲਿ ਜਾਈਐ ॥",
      "transliteration": "gur apune oopar bal jaaeeai ||",
      "translation": "I am a sacrifice to my True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਠ ਪਹਰ ਹਰਿ ਹਰਿ ਜਸੁ ਗਾਈਐ ॥੧॥",
      "transliteration": "aath pahar har har jas gaaeeai ||1||",
      "translation": "Twenty-four hours a day, I sing the Praises of the Lord, Har, Har. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਿਮਰਉ ਸੋ ਪ੍ਰਭੁ ਅਪਨਾ ਸੁਆਮੀ ॥",
      "transliteration": "simarau so prabh apanaa suaamee ||",
      "translation": "Meditate in remembrance on God, your Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਗਲ ਘਟਾ ਕਾ ਅੰਤਰਜਾਮੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sagal ghataa kaa a(n)tarajaamee ||1|| rahaau ||",
      "translation": "He is the Inner-knower, the Searcher of all hearts. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਚਰਣ ਕਮਲ ਸਿਉ ਲਾਗੀ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "charan kamal siu laagee preet ||",
      "translation": "So love the Lord's Lotus Feet,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਾਚੀ ਪੂਰਨ ਨਿਰਮਲ ਰੀਤਿ ॥੨॥",
      "transliteration": "saachee pooran niramal reet ||2||",
      "translation": "and live a lifestyle which is true, perfect and spotless. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਵਸੈ ਮਨ ਮਾਹੀ ॥",
      "transliteration": "sa(n)t prasaad vasai man maahee ||",
      "translation": "By the Grace of the Saints, the Lord comes to dwell within the mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਕਿਲਵਿਖ ਜਾਹੀ ॥੩॥",
      "transliteration": "janam janam ke kilavikh jaahee ||3||",
      "translation": "and the sins of countless incarnations are eradicated. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਦੀਨ ਦਇਆਲਾ ॥",
      "transliteration": "kar kirapaa prabh deen daiaalaa ||",
      "translation": "Please be Merciful, O God, O Merciful to the meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0741_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਨਕੁ ਮਾਗੈ ਸੰਤ ਰਵਾਲਾ ॥੪॥੧੭॥੨੩॥",
      "transliteration": "naanak maagai sa(n)t ravaalaa ||4||17||23||",
      "translation": "Nanak begs for the dust of the Saints. ||4||17||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 741,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
