{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 742,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0742_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦਰਸਨੁ ਦੇਖਿ ਜੀਵਾ ਗੁਰ ਤੇਰਾ ॥",
      "transliteration": "darasan dekh jeevaa gur teraa ||",
      "translation": "Gazing upon the Blessed Vision of Your Darshan, I live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪੂਰਨ ਕਰਮੁ ਹੋਇ ਪ੍ਰਭ ਮੇਰਾ ॥੧॥",
      "transliteration": "pooran karam hoi prabh meraa ||1||",
      "translation": "My karma is perfect, O my God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਹ ਬੇਨੰਤੀ ਸੁਣਿ ਪ੍ਰਭ ਮੇਰੇ ॥",
      "transliteration": "ih bena(n)tee sun prabh mere ||",
      "translation": "Please, listen to this prayer, O my God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੇਹਿ ਨਾਮੁ ਕਰਿ ਅਪਣੇ ਚੇਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dehi naam kar apane chere ||1|| rahaau ||",
      "translation": "Please bless me with Your Name, and make me Your chaylaa, Your disciple. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਪਣੀ ਸਰਣਿ ਰਾਖੁ ਪ੍ਰਭ ਦਾਤੇ ॥",
      "transliteration": "apanee saran raakh prabh daate ||",
      "translation": "Please keep me under Your Protection, O God, O Great Giver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਕਿਨੈ ਵਿਰਲੈ ਜਾਤੇ ॥੨॥",
      "transliteration": "gur prasaad kinai viralai jaate ||2||",
      "translation": "By Guru's Grace, a few people understand this. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੁਨਹੁ ਬਿਨਉ ਪ੍ਰਭ ਮੇਰੇ ਮੀਤਾ ॥",
      "transliteration": "sunahu binau prabh mere meetaa ||",
      "translation": "Please hear my prayer, O God, my Friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚਰਣ ਕਮਲ ਵਸਹਿ ਮੇਰੈ ਚੀਤਾ ॥੩॥",
      "transliteration": "charan kamal vasahi merai cheetaa ||3||",
      "translation": "May Your Lotus Feet abide within my consciousness. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਨਕੁ ਏਕ ਕਰੈ ਅਰਦਾਸਿ ॥",
      "transliteration": "naanak ek karai aradaas ||",
      "translation": "Nanak makes one prayer:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਵਿਸਰੁ ਨਾਹੀ ਪੂਰਨ ਗੁਣਤਾਸਿ ॥੪॥੧੮॥੨੪॥",
      "transliteration": "visar naahee pooran gunataas ||4||18||24||",
      "translation": "may I never forget You, O perfect treasure of virtue. ||4||18||24||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮੀਤੁ ਸਾਜਨੁ ਸੁਤ ਬੰਧਪ ਭਾਈ ॥",
      "transliteration": "meet saajan sut ba(n)dhap bhaaee ||",
      "translation": "He is my friend, companion, child, relative and sibling.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਤ ਕਤ ਪੇਖਉ ਹਰਿ ਸੰਗਿ ਸਹਾਈ ॥੧॥",
      "transliteration": "jat kat pekhau har sa(n)g sahaaee ||1||",
      "translation": "Wherever I look, I see the Lord as my companion and helper. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਤਿ ਮੇਰੀ ਪਤਿ ਮੇਰੀ ਧਨੁ ਹਰਿ ਨਾਮੁ ॥",
      "transliteration": "jat meree pat meree dhan har naam ||",
      "translation": "The Lord's Name is my social status, my honor and wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਆਨੰਦ ਬਿਸਰਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sookh sahaj aana(n)d bisaraam ||1|| rahaau ||",
      "translation": "He is my pleasure, poise, bliss and peace. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਜਪਿ ਪਹਿਰਿ ਸਨਾਹ ॥",
      "transliteration": "paarabraham jap pahir sanaah ||",
      "translation": "I have strapped on the armor of meditation on the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕੋਟਿ ਆਵਧ ਤਿਸੁ ਬੇਧਤ ਨਾਹਿ ॥੨॥",
      "transliteration": "kot aavadh tis bedhat naahi ||2||",
      "translation": "It cannot be pierced, even by millions of weapons. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਰਿ ਚਰਨ ਸਰਣ ਗੜ ਕੋਟ ਹਮਾਰੈ ॥",
      "transliteration": "har charan saran gaR kot hamaarai ||",
      "translation": "The Sanctuary of the Lord's Feet is my fortress and battlement.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਾਲੁ ਕੰਟਕੁ ਜਮੁ ਤਿਸੁ ਨ ਬਿਦਾਰੈ ॥੩॥",
      "transliteration": "kaal ka(n)tak jam tis na bidaarai ||3||",
      "translation": "The Messenger of Death, the torturer, cannot demolish it. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਸਦਾ ਬਲਿਹਾਰੀ ॥",
      "transliteration": "naanak daas sadaa balihaaree ||",
      "translation": "Slave Nanak is forever a sacrifice",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੇਵਕ ਸੰਤ ਰਾਜਾ ਰਾਮ ਮੁਰਾਰੀ ॥੪॥੧੯॥੨੫॥",
      "transliteration": "sevak sa(n)t raajaa raam muraaree ||4||19||25||",
      "translation": "to the selfless servants and Saints of the Sovereign Lord, the Destroyer of ego. ||4||19||25||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਣ ਗੋਪਾਲ ਪ੍ਰਭ ਕੇ ਨਿਤ ਗਾਹਾ ॥",
      "transliteration": "gun gopaal prabh ke nit gaahaa ||",
      "translation": "Where the Glorious Praises of God, the Lord of the world are continually sung,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਨਦ ਬਿਨੋਦ ਮੰਗਲ ਸੁਖ ਤਾਹਾ ॥੧॥",
      "transliteration": "anad binod ma(n)gal sukh taahaa ||1||",
      "translation": "there is bliss, joy, happiness and peace. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚਲੁ ਸਖੀਏ ਪ੍ਰਭੁ ਰਾਵਣ ਜਾਹਾ ॥",
      "transliteration": "chal sakheee prabh raavan jaahaa ||",
      "translation": "Come, O my companions - let us go and enjoy God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਾਧ ਜਨਾ ਕੀ ਚਰਣੀ ਪਾਹਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saadh janaa kee charanee paahaa ||1|| rahaau ||",
      "translation": "Let us fall at the feet of the holy, humble beings. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਰਿ ਬੇਨਤੀ ਜਨ ਧੂਰਿ ਬਾਛਾਹਾ ॥",
      "transliteration": "kar benatee jan dhoor baachhaahaa ||",
      "translation": "I pray for the dust of the feet of the humble.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਕਿਲਵਿਖ ਲਾਹਾਂ ॥੨॥",
      "transliteration": "janam janam ke kilavikh laahaa(n) ||2||",
      "translation": "It shall wash away the sins of countless incarnations. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਪ੍ਰਾਣ ਜੀਉ ਅਰਪਾਹਾ ॥",
      "transliteration": "man tan praan jeeu arapaahaa ||",
      "translation": "I dedicate my mind, body, breath of life and soul to God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਿ ਸਿਮਰਿ ਮਾਨੁ ਮੋਹੁ ਕਟਾਹਾਂ ॥੩॥",
      "transliteration": "har simar simar maan mohu kataahaa(n) ||3||",
      "translation": "Remembering the Lord in meditation, I have eradicated pride and emotional attachment. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੀਨ ਦਇਆਲ ਕਰਹੁ ਉਤਸਾਹਾ ॥",
      "transliteration": "deen daiaal karahu utasaahaa ||",
      "translation": "O Lord, O Merciful to the meek, please give me faith and confidence,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਹਰਿ ਸਰਣਿ ਸਮਾਹਾ ॥੪॥੨੦॥੨੬॥",
      "transliteration": "naanak daas har saran samaahaa ||4||20||26||",
      "translation": "so that slave Nanak may remain absorbed in Your Sanctuary. ||4||20||26||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬੈਕੁੰਠ ਨਗਰੁ ਜਹਾ ਸੰਤ ਵਾਸਾ ॥",
      "transliteration": "baiku(n)th nagar jahaa sa(n)t vaasaa ||",
      "translation": "The city of heaven is where the Saints dwell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰਭ ਚਰਣ ਕਮਲ ਰਿਦ ਮਾਹਿ ਨਿਵਾਸਾ ॥੧॥",
      "transliteration": "prabh charan kamal rid maahi nivaasaa ||1||",
      "translation": "They enshrine the Lotus Feet of God within their hearts. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਣਿ ਮਨ ਤਨ ਤੁਝੁ ਸੁਖੁ ਦਿਖਲਾਵਉ ॥",
      "transliteration": "sun man tan tujh sukh dikhalaavau ||",
      "translation": "Listen, O my mind and body, and let me show you the way to find peace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਰਿ ਅਨਿਕ ਬਿੰਜਨ ਤੁਝੁ ਭੋਗ ਭੁੰਚਾਵਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har anik bi(n)jan tujh bhog bhu(n)chaavau ||1|| rahaau ||",
      "translation": "so that you may eat and enjoy the various delicacies of the Lord||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਭੁੰਚੁ ਮਨ ਮਾਹੀ ॥",
      "transliteration": "a(n)mrit naam bhu(n)ch man maahee ||",
      "translation": "Taste the Ambrosial Nectar of the Naam, the Name of the Lord, within your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਚਰਜ ਸਾਦ ਤਾ ਕੇ ਬਰਨੇ ਨ ਜਾਹੀ ॥੨॥",
      "transliteration": "acharaj saad taa ke barane na jaahee ||2||",
      "translation": "Its taste is wondrous - it cannot be described. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਲੋਭੁ ਮੂਆ ਤ੍ਰਿਸਨਾ ਬੁਝਿ ਥਾਕੀ ॥",
      "transliteration": "lobh mooaa trisanaa bujh thaakee ||",
      "translation": "Your greed shall die, and your thirst shall be quenched.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕੀ ਸਰਣਿ ਜਨ ਤਾਕੀ ॥੩॥",
      "transliteration": "paarabraham kee saran jan taakee ||3||",
      "translation": "The humble beings seek the Sanctuary of the Supreme Lord God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਭੈ ਮੋਹ ਨਿਵਾਰੇ ॥",
      "transliteration": "janam janam ke bhai moh nivaare ||",
      "translation": "The Lord dispels the fears and attachments of countless incarnations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਪ੍ਰਭ ਕਿਰਪਾ ਧਾਰੇ ॥੪॥੨੧॥੨੭॥",
      "transliteration": "naanak daas prabh kirapaa dhaare ||4||21||27||",
      "translation": "God has showered His Mercy and Grace upon slave Nanak. ||4||21||27||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਨਿਕ ਬੀਂਗ ਦਾਸ ਕੇ ਪਰਹਰਿਆ ॥",
      "transliteration": "anik bee(n)g daas ke parahariaa ||",
      "translation": "God covers the many shortcomings of His slaves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭਿ ਅਪਨਾ ਕਰਿਆ ॥੧॥",
      "transliteration": "kar kirapaa prabh apanaa kariaa ||1||",
      "translation": "Granting His Mercy, God makes them His own. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤੁਮਹਿ ਛਡਾਇ ਲੀਓ ਜਨੁ ਅਪਨਾ ॥",
      "transliteration": "tumahi chhadaai leeo jan apanaa ||",
      "translation": "You emancipate Your humble servant,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਉਰਝਿ ਪਰਿਓ ਜਾਲੁ ਜਗੁ ਸੁਪਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "urajh pario jaal jag supanaa ||1|| rahaau ||",
      "translation": "and rescue him from the noose of the world, which is just a dream. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪਰਬਤ ਦੋਖ ਮਹਾ ਬਿਕਰਾਲਾ ॥",
      "transliteration": "parabat dokh mahaa bikaraalaa ||",
      "translation": "Even huge mountains of sin and corruption",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਦੂਰਿ ਕੀਏ ਦਇਆਲਾ ॥੨॥",
      "transliteration": "khin mahi door keee daiaalaa ||2||",
      "translation": "are removed in an instant by the Merciful Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੋਗ ਰੋਗ ਬਿਪਤਿ ਅਤਿ ਭਾਰੀ ॥",
      "transliteration": "sog rog bipat at bhaaree ||",
      "translation": "Sorrow, disease and the most terrible calamities",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਦੂਰਿ ਭਈ ਜਪਿ ਨਾਮੁ ਮੁਰਾਰੀ ॥੩॥",
      "transliteration": "door bhaee jap naam muraaree ||3||",
      "translation": "are removed by meditating on the Naam, the Name of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0742_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਦ੍ਰਿਸਟਿ ਧਾਰਿ ਲੀਨੋ ਲੜਿ ਲਾਇ ॥",
      "transliteration": "drisat dhaar leeno laR laai ||",
      "translation": "Bestowing His Glance of Grace, He attaches us to the hem of His robe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 742,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
