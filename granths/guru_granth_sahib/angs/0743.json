{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 743,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0743_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਰਿ ਚਰਣ ਗਹੇ ਨਾਨਕ ਸਰਣਾਇ ॥੪॥੨੨॥੨੮॥",
      "transliteration": "har charan gahe naanak saranaai ||4||22||28||",
      "translation": "Grasping the Lord's Feet, O Nanak, we enter His Sanctuary. ||4||22||28||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੀਨੁ ਛਡਾਇ ਦੁਨੀ ਜੋ ਲਾਏ ॥",
      "transliteration": "deen chhadaai dunee jo laae ||",
      "translation": "One who withdraws from God's Path, and attaches himself to the world,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦੁਹੀ ਸਰਾਈ ਖੁਨਾਮੀ ਕਹਾਏ ॥੧॥",
      "transliteration": "duhee saraaee khunaamee kahaae ||1||",
      "translation": "is known as a sinner in both worlds. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੋ ਪਰਵਾਣੁ ॥",
      "transliteration": "jo tis bhaavai so paravaan ||",
      "translation": "He alone is approved, who pleases the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਪਣੀ ਕੁਦਰਤਿ ਆਪੇ ਜਾਣੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aapanee kudarat aape jaan ||1|| rahaau ||",
      "translation": "Only He Himself knows His creative omnipotence. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਚਾ ਧਰਮੁ ਪੁੰਨੁ ਭਲਾ ਕਰਾਏ ॥",
      "transliteration": "sachaa dharam pu(n)n bhalaa karaae ||",
      "translation": "One who practices truth, righteous living, charity and good deeds,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੀਨ ਕੈ ਤੋਸੈ ਦੁਨੀ ਨ ਜਾਏ ॥੨॥",
      "transliteration": "deen kai tosai dunee na jaae ||2||",
      "translation": "has the supplies for God's Path. Worldly success shall not fail him. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਰਬ ਨਿਰੰਤਰਿ ਏਕੋ ਜਾਗੈ ॥",
      "transliteration": "sarab nira(n)tar eko jaagai ||",
      "translation": "Within and among all, the One Lord is awake.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਤੁ ਜਿਤੁ ਲਾਇਆ ਤਿਤੁ ਤਿਤੁ ਕੋ ਲਾਗੈ ॥੩॥",
      "transliteration": "jit jit laaiaa tit tit ko laagai ||3||",
      "translation": "As He attaches us, so are we attached. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਗਮ ਅਗੋਚਰੁ ਸਚੁ ਸਾਹਿਬੁ ਮੇਰਾ ॥",
      "transliteration": "agam agochar sach saahib meraa ||",
      "translation": "You are inaccessible and unfathomable, O my True Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਨਕੁ ਬੋਲੈ ਬੋਲਾਇਆ ਤੇਰਾ ॥੪॥੨੩॥੨੯॥",
      "transliteration": "naanak bolai bolaaiaa teraa ||4||23||29||",
      "translation": "Nanak speaks as You inspire him to speak. ||4||23||29||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪ੍ਰਾਤਹਕਾਲਿ ਹਰਿ ਨਾਮੁ ਉਚਾਰੀ ॥",
      "transliteration": "praatahakaal har naam uchaaree ||",
      "translation": "In the early hours of the morning, I chant the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਈਤ ਊਤ ਕੀ ਓਟ ਸਵਾਰੀ ॥੧॥",
      "transliteration": "eet oot kee ot savaaree ||1||",
      "translation": "I have fashioned a shelter for myself, hear and hereafter. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਜਪੀਐ ਹਰਿ ਨਾਮ ॥",
      "transliteration": "sadaa sadaa japeeai har naam ||",
      "translation": "Forever and ever, I chant the Lord's Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪੂਰਨ ਹੋਵਹਿ ਮਨ ਕੇ ਕਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "pooran hovahi man ke kaam ||1|| rahaau ||",
      "translation": "and the desires of my mind are fulfilled. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪ੍ਰਭੁ ਅਬਿਨਾਸੀ ਰੈਣਿ ਦਿਨੁ ਗਾਉ ॥",
      "transliteration": "prabh abinaasee rain din gaau ||",
      "translation": "Sing the Praises of the Eternal, Imperishable Lord God, night and day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੀਵਤ ਮਰਤ ਨਿਹਚਲੁ ਪਾਵਹਿ ਥਾਉ ॥੨॥",
      "transliteration": "jeevat marat nihachal paavahi thaau ||2||",
      "translation": "In life, and in death, you shall find your eternal, unchanging home. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋ ਸਾਹੁ ਸੇਵਿ ਜਿਤੁ ਤੋਟਿ ਨ ਆਵੈ ॥",
      "transliteration": "so saahu sev jit tot na aavai ||",
      "translation": "So serve the Sovereign Lord, and you shall never lack anything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਖਾਤ ਖਰਚਤ ਸੁਖਿ ਅਨਦਿ ਵਿਹਾਵੈ ॥੩॥",
      "transliteration": "khaat kharachat sukh anad vihaavai ||3||",
      "translation": "While eating and consuming, you shall pass your life in peace. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਗਜੀਵਨ ਪੁਰਖੁ ਸਾਧਸੰਗਿ ਪਾਇਆ ॥",
      "transliteration": "jagajeevan purakh saadhasa(n)g paaiaa ||",
      "translation": "O Life of the World, O Primal Being, I have found the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਨਾਨਕ ਨਾਮੁ ਧਿਆਇਆ ॥੪॥੨੪॥੩੦॥",
      "transliteration": "gur prasaad naanak naam dhiaaiaa ||4||24||30||",
      "translation": "By Guru's Grace, O Nanak, I meditate on the Naam, the Name of the Lord. ||4||24||30||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਜਬ ਭਏ ਦਇਆਲ ॥",
      "transliteration": "gur poore jab bhae daiaal ||",
      "translation": "When the Perfect Guru becomes merciful,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਦੁਖ ਬਿਨਸੇ ਪੂਰਨ ਭਈ ਘਾਲ ॥੧॥",
      "transliteration": "dukh binase pooran bhaee ghaal ||1||",
      "translation": "my pains are taken away, and my works are perfectly completed. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੇਖਿ ਪੇਖਿ ਜੀਵਾ ਦਰਸੁ ਤੁਮੑਾਰਾ ॥",
      "transliteration": "pekh pekh jeevaa daras tumhaaraa ||",
      "translation": "Gazing upon, beholding the Blessed Vision of Your Darshan, I live;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚਰਣ ਕਮਲ ਜਾਈ ਬਲਿਹਾਰਾ ॥",
      "transliteration": "charan kamal jaaee balihaaraa ||",
      "translation": "I am a sacrifice to Your Lotus Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੁਝ ਬਿਨੁ ਠਾਕੁਰ ਕਵਨੁ ਹਮਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tujh bin thaakur kavan hamaaraa ||1|| rahaau ||",
      "translation": "Without You, O my Lord and Master, who belongs to me? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਸਿਉ ਪ੍ਰੀਤਿ ਬਣਿ ਆਈ ॥",
      "transliteration": "saadhasa(n)gat siu preet ban aaee ||",
      "translation": "I have fallen in love with the Saadh Sangat, the Company of the Holy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪੂਰਬ ਕਰਮਿ ਲਿਖਤ ਧੁਰਿ ਪਾਈ ॥੨॥",
      "transliteration": "poorab karam likhat dhur paaee ||2||",
      "translation": "by the karma of my past actions and my pre-ordained destiny. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਪਿ ਹਰਿ ਹਰਿ ਨਾਮੁ ਅਚਰਜੁ ਪਰਤਾਪ ॥",
      "transliteration": "jap har har naam acharaj parataap ||",
      "translation": "Chant the Name of the Lord, Har, Har; how wondrous is His glory!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਾਲਿ ਨ ਸਾਕਹਿ ਤੀਨੇ ਤਾਪ ॥੩॥",
      "transliteration": "jaal na saakahi teene taap ||3||",
      "translation": "The three types of illness cannot consume it. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਿਮਖ ਨ ਬਿਸਰਹਿ ਹਰਿ ਚਰਣ ਤੁਮੑਾਰੇ ॥",
      "transliteration": "nimakh na bisarahi har charan tumhaare ||",
      "translation": "May I never forget, even for an instant, the Lord's Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕੁ ਮਾਗੈ ਦਾਨੁ ਪਿਆਰੇ ॥੪॥੨੫॥੩੧॥",
      "transliteration": "naanak maagai daan piaare ||4||25||31||",
      "translation": "Nanak begs for this gift, O my Beloved. ||4||25||31||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੇ ਸੰਜੋਗ ਕਰਹੁ ਮੇਰੇ ਪਿਆਰੇ ॥",
      "transliteration": "se sa(n)jog karahu mere piaare ||",
      "translation": "May there be such an auspicious time, O my Beloved,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਤੁ ਰਸਨਾ ਹਰਿ ਨਾਮੁ ਉਚਾਰੇ ॥੧॥",
      "transliteration": "jit rasanaa har naam uchaare ||1||",
      "translation": "when, with my tongue, I may chant the Lord's Name||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੁਣਿ ਬੇਨਤੀ ਪ੍ਰਭ ਦੀਨ ਦਇਆਲਾ ॥",
      "transliteration": "sun benatee prabh deen daiaalaa ||",
      "translation": "Hear my prayer, O God, O Merciful to the meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਾਧ ਗਾਵਹਿ ਗੁਣ ਸਦਾ ਰਸਾਲਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saadh gaavahi gun sadaa rasaalaa ||1|| rahaau ||",
      "translation": "The Holy Saints ever sing the Glorious Praises of the Lord, the Source of Nectar. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੀਵਨ ਰੂਪੁ ਸਿਮਰਣੁ ਪ੍ਰਭ ਤੇਰਾ ॥",
      "transliteration": "jeevan roop simaran prabh teraa ||",
      "translation": "Your meditation and remembrance is life-giving, God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਸੁ ਕ੍ਰਿਪਾ ਕਰਹਿ ਬਸਹਿ ਤਿਸੁ ਨੇਰਾ ॥੨॥",
      "transliteration": "jis kripaa karahi basahi tis neraa ||2||",
      "translation": "You dwell near those upon whom You show mercy. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਨ ਕੀ ਭੂਖ ਤੇਰਾ ਨਾਮੁ ਅਹਾਰੁ ॥",
      "transliteration": "jan kee bhookh teraa naam ahaar ||",
      "translation": "Your Name is the food to satisfy the hunger of Your humble servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤੂੰ ਦਾਤਾ ਪ੍ਰਭ ਦੇਵਣਹਾਰੁ ॥੩॥",
      "transliteration": "too(n) daataa prabh devanahaar ||3||",
      "translation": "You are the Great Giver, O Lord God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਾਮ ਰਮਤ ਸੰਤਨ ਸੁਖੁ ਮਾਨਾ ॥",
      "transliteration": "raam ramat sa(n)tan sukh maanaa ||",
      "translation": "The Saints take pleasure in repeating the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕ ਦੇਵਨਹਾਰ ਸੁਜਾਨਾ ॥੪॥੨੬॥੩੨॥",
      "transliteration": "naanak devanahaar sujaanaa ||4||26||32||",
      "translation": "O Nanak, the Lord, the Great Giver, is All-knowing. ||4||26||32||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਹਤੀ ਜਾਤ ਕਦੇ ਦ੍ਰਿਸਟਿ ਨ ਧਾਰਤ ॥",
      "transliteration": "bahatee jaat kade drisat na dhaarat ||",
      "translation": "Your life is slipping away, but you never even notice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮਿਥਿਆ ਮੋਹ ਬੰਧਹਿ ਨਿਤ ਪਾਰਚ ॥੧॥",
      "transliteration": "mithiaa moh ba(n)dhahi nit paarach ||1||",
      "translation": "You are constantly entangled in false attachments and conflicts. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਮਾਧਵੇ ਭਜੁ ਦਿਨ ਨਿਤ ਰੈਣੀ ॥",
      "transliteration": "maadhave bhaj din nit rainee ||",
      "translation": "Meditate, vibrate constantly, day and night, on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਨਮੁ ਪਦਾਰਥੁ ਜੀਤਿ ਹਰਿ ਸਰਣੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "janam padaarath jeet har saranee ||1|| rahaau ||",
      "translation": "You shall be victorious in this priceless human life, in the Protection of the Lord's Sanctuary. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਰਤ ਬਿਕਾਰ ਦੋਊ ਕਰ ਝਾਰਤ ॥",
      "transliteration": "karat bikaar dooo kar jhaarat ||",
      "translation": "You eagerly commit sins and practice corruption,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਰਾਮ ਰਤਨੁ ਰਿਦ ਤਿਲੁ ਨਹੀ ਧਾਰਤ ॥੨॥",
      "transliteration": "raam ratan rid til nahee dhaarat ||2||",
      "translation": "But you do not enshrine the jewel of the Lord's Name within your heart, even for an instant. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0743_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਭਰਣ ਪੋਖਣ ਸੰਗਿ ਅਉਧ ਬਿਹਾਣੀ ॥",
      "transliteration": "bharan pokhan sa(n)g audh bihaanee ||",
      "translation": "Feeding and pampering your body, your life is passing away,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 743,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
