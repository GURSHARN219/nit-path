{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 744,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0744_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੈ ਜਗਦੀਸ ਕੀ ਗਤਿ ਨਹੀ ਜਾਣੀ ॥੩॥",
      "transliteration": "jai jagadees kee gat nahee jaanee ||3||",
      "translation": "but you do not experience the state of victory of the Lord of the Universe. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਰਣਿ ਸਮਰਥ ਅਗੋਚਰ ਸੁਆਮੀ ॥",
      "transliteration": "saran samarath agochar suaamee ||",
      "translation": "So enter the Sanctuary of the All-powerful, Unfathomable Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਉਧਰੁ ਨਾਨਕ ਪ੍ਰਭ ਅੰਤਰਜਾਮੀ ॥੪॥੨੭॥੩੩॥",
      "transliteration": "udhar naanak prabh a(n)tarajaamee ||4||27||33||",
      "translation": "O God, O Searcher of hearts, please, save Nanak! ||4||27||33||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਤਰੈ ਭੈ ਸਾਗਰੁ ॥",
      "transliteration": "saadhasa(n)g tarai bhai saagar ||",
      "translation": "Cross over the terrifying world-ocean in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਸਿਮਰਿ ਰਤਨਾਗਰੁ ॥੧॥",
      "transliteration": "har har naam simar ratanaagar ||1||",
      "translation": "Remember in meditation the Name of the Lord, Har, Har, the source of jewels. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਜੀਵਾ ਨਾਰਾਇਣ ॥",
      "transliteration": "simar simar jeevaa naaraain ||",
      "translation": "Remembering, remembering the Lord in meditation, I live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੂਖ ਰੋਗ ਸੋਗ ਸਭਿ ਬਿਨਸੇ ਗੁਰ ਪੂਰੇ ਮਿਲਿ ਪਾਪ ਤਜਾਇਣ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dookh rog sog sabh binase gur poore mil paap tajaain ||1|| rahaau ||",
      "translation": "All pain, disease and suffering is dispelled, meeting the Perfect Guru; sin has been eradicated. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੀਵਨ ਪਦਵੀ ਹਰਿ ਕਾ ਨਾਉ ॥",
      "transliteration": "jeevan padavee har kaa naau ||",
      "translation": "The immortal status is obtained through the Name of the Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਨਿਰਮਲੁ ਸਾਚੁ ਸੁਆਉ ॥੨॥",
      "transliteration": "man tan niramal saach suaau ||2||",
      "translation": "the mind and body become spotless and pure, which is the true purpose of life. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਠ ਪਹਰ ਪਾਰਬ੍ਰਹਮੁ ਧਿਆਈਐ ॥",
      "transliteration": "aath pahar paarabraham dhiaaeeai ||",
      "translation": "Twenty-four hours a day, meditate on the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪੂਰਬਿ ਲਿਖਤੁ ਹੋਇ ਤਾ ਪਾਈਐ ॥੩॥",
      "transliteration": "poorab likhat hoi taa paaeeai ||3||",
      "translation": "By pre-ordained destiny, the Name is obtained. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਰਣਿ ਪਏ ਜਪਿ ਦੀਨ ਦਇਆਲਾ ॥",
      "transliteration": "saran pae jap deen daiaalaa ||",
      "translation": "I have entered His Sanctuary, and I meditate on the Lord, Merciful to the meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਨਕੁ ਜਾਚੈ ਸੰਤ ਰਵਾਲਾ ॥੪॥੨੮॥੩੪॥",
      "transliteration": "naanak jaachai sa(n)t ravaalaa ||4||28||34||",
      "translation": "Nanak longs for the dust of the Saints. ||4||28||34||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਘਰ ਕਾ ਕਾਜੁ ਨ ਜਾਣੀ ਰੂੜਾ ॥",
      "transliteration": "ghar kaa kaaj na jaanee rooRaa ||",
      "translation": "The beautiful one does not know the work of his own home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਝੂਠੈ ਧੰਧੈ ਰਚਿਓ ਮੂੜਾ ॥੧॥",
      "transliteration": "jhoothai dha(n)dhai rachio mooRaa ||1||",
      "translation": "The fool is engrossed in false attachments. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਤੁ ਤੂੰ ਲਾਵਹਿ ਤਿਤੁ ਤਿਤੁ ਲਗਨਾ ॥",
      "transliteration": "jit too(n) laavahi tit tit laganaa ||",
      "translation": "As You attach us, so we are attached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਾ ਤੂੰ ਦੇਹਿ ਤੇਰਾ ਨਾਉ ਜਪਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaa too(n) dehi teraa naau japanaa ||1|| rahaau ||",
      "translation": "When You bless us with Your Name, we chant it. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਰਿ ਕੇ ਦਾਸ ਹਰਿ ਸੇਤੀ ਰਾਤੇ ॥",
      "transliteration": "har ke daas har setee raate ||",
      "translation": "The Lord's slaves are imbued with the Love of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਾਮ ਰਸਾਇਣਿ ਅਨਦਿਨੁ ਮਾਤੇ ॥੨॥",
      "transliteration": "raam rasaain anadin maate ||2||",
      "translation": "They are intoxicated with the Lord, night and day. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਾਹ ਪਕਰਿ ਪ੍ਰਭਿ ਆਪੇ ਕਾਢੇ ॥",
      "transliteration": "baah pakar prabh aape kaadhe ||",
      "translation": "Reaching out to grasp hold of our arms, God lifts us up.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਟੂਟੇ ਗਾਢੇ ॥੩॥",
      "transliteration": "janam janam ke toote gaadhe ||3||",
      "translation": "Separated for countless incarnations, we are united with Him again. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਉਧਰੁ ਸੁਆਮੀ ਪ੍ਰਭ ਕਿਰਪਾ ਧਾਰੇ ॥",
      "transliteration": "udhar suaamee prabh kirapaa dhaare ||",
      "translation": "Save me, O God, O my Lord and Master - shower me with Your Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਹਰਿ ਸਰਣਿ ਦੁਆਰੇ ॥੪॥੨੯॥੩੫॥",
      "transliteration": "naanak daas har saran duaare ||4||29||35||",
      "translation": "Slave Nanak seeks Sanctuary at Your Door, O Lord. ||4||29||35||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਨਿਹਚਲੁ ਘਰੁ ਪਾਇਆ ॥",
      "transliteration": "sa(n)t prasaad nihachal ghar paaiaa ||",
      "translation": "By the Grace of the Saints, I have found my eternal home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਰਬ ਸੂਖ ਫਿਰਿ ਨਹੀ ਡੋੁਲਾਇਆ ॥੧॥",
      "transliteration": "sarab sookh phir nahee doulaaiaa ||1||",
      "translation": "I have found total peace, and I shall not waver again. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰੂ ਧਿਆਇ ਹਰਿ ਚਰਨ ਮਨਿ ਚੀਨੑੇ ॥",
      "transliteration": "guroo dhiaai har charan man cheenhe ||",
      "translation": "I meditate on the Guru, and the Lord's Feet, within my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਾ ਤੇ ਕਰਤੈ ਅਸਥਿਰੁ ਕੀਨੑੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "taa te karatai asathir keenhe ||1|| rahaau ||",
      "translation": "In this way, the Creator Lord has made me steady and stable. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗੁਣ ਗਾਵਤ ਅਚੁਤ ਅਬਿਨਾਸੀ ॥",
      "transliteration": "gun gaavat achut abinaasee ||",
      "translation": "I sing the Glorious Praises of the unchanging, eternal Lord God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਤੇ ਕਾਟੀ ਜਮ ਕੀ ਫਾਸੀ ॥੨॥",
      "transliteration": "taa te kaatee jam kee phaasee ||2||",
      "translation": "and the noose of death is snapped. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਲੀਨੇ ਲੜਿ ਲਾਏ ॥",
      "transliteration": "kar kirapaa leene laR laae ||",
      "translation": "Showering His Mercy, he has attached me to the hem of His robe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਦਾ ਅਨਦੁ ਨਾਨਕ ਗੁਣ ਗਾਏ ॥੩॥੩੦॥੩੬॥",
      "transliteration": "sadaa anad naanak gun gaae ||3||30||36||",
      "translation": "In constant bliss, Nanak sings His Glorious Praises. ||3||30||36||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਬਚਨ ਸਾਧ ਕੀ ਬਾਣੀ ॥",
      "transliteration": "a(n)mrit bachan saadh kee baanee ||",
      "translation": "The Words, the Teachings of the Holy Saints, are Ambrosial Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੋ ਜੋ ਜਪੈ ਤਿਸ ਕੀ ਗਤਿ ਹੋਵੈ ਹਰਿ ਹਰਿ ਨਾਮੁ ਨਿਤ ਰਸਨ ਬਖਾਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jo jo japai tis kee gat hovai har har naam nit rasan bakhaanee ||1|| rahaau ||",
      "translation": "Whoever meditates on the Lord's Name is emancipated; he chants the Name of the Lord, Har, Har, with his tongue. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਲੀ ਕਾਲ ਕੇ ਮਿਟੇ ਕਲੇਸਾ ॥",
      "transliteration": "kalee kaal ke mite kalesaa ||",
      "translation": "The pains and sufferings of the Dark Age of Kali Yuga are eradicated,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਏਕੋ ਨਾਮੁ ਮਨ ਮਹਿ ਪਰਵੇਸਾ ॥੧॥",
      "transliteration": "eko naam man mahi paravesaa ||1||",
      "translation": "when the One Name abides within the mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਾਧੂ ਧੂਰਿ ਮੁਖਿ ਮਸਤਕਿ ਲਾਈ ॥",
      "transliteration": "saadhoo dhoor mukh masatak laaee ||",
      "translation": "I apply the dust of the feet of the Holy to my face and forehead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਨਕ ਉਧਰੇ ਹਰਿ ਗੁਰ ਸਰਣਾਈ ॥੨॥੩੧॥੩੭॥",
      "transliteration": "naanak udhare har gur saranaaee ||2||31||37||",
      "translation": "Nanak has been saved, in the Sanctuary of the Guru, the Lord. ||2||31||37||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ਘਰੁ ੩ ॥",
      "transliteration": "soohee mahalaa 5 ghar 3 ||",
      "translation": "Soohee, Fifth Mehl: Third House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੋਬਿੰਦਾ ਗੁਣ ਗਾਉ ਦਇਆਲਾ ॥",
      "transliteration": "gobi(n)daa gun gaau daiaalaa ||",
      "translation": "I sing the Glorious Praises of the Lord of the Universe, the Merciful Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦਰਸਨੁ ਦੇਹੁ ਪੂਰਨ ਕਿਰਪਾਲਾ ॥ ਰਹਾਉ ॥",
      "transliteration": "darasan dehu pooran kirapaalaa || rahaau ||",
      "translation": "Please, bless me with the Blessed Vision of Your Darshan, O Perfect, Compassionate Lord. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਤੁਮ ਹੀ ਪ੍ਰਤਿਪਾਲਾ ॥",
      "transliteration": "kar kirapaa tum hee pratipaalaa ||",
      "translation": "Please, grant Your Grace, and cherish me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਸਭੁ ਤੁਮਰਾ ਮਾਲਾ ॥੧॥",
      "transliteration": "jeeu pi(n)d sabh tumaraa maalaa ||1||",
      "translation": "My soul and body are all Your property. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਚਲੈ ਜਪਿ ਨਾਲਾ ॥",
      "transliteration": "a(n)mrit naam chalai jap naalaa ||",
      "translation": "Only meditation on the Ambrosial Naam, the Name of the Lord, will go along with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਨਕੁ ਜਾਚੈ ਸੰਤ ਰਵਾਲਾ ॥੨॥੩੨॥੩੮॥",
      "transliteration": "naanak jaachai sa(n)t ravaalaa ||2||32||38||",
      "translation": "Nanak begs for the dust of the Saints. ||2||32||38||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਿਸੁ ਬਿਨੁ ਦੂਜਾ ਅਵਰੁ ਨ ਕੋਈ ॥",
      "transliteration": "tis bin doojaa avar na koee ||",
      "translation": "Without Him, there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਆਪੇ ਥੰਮੈ ਸਚਾ ਸੋਈ ॥੧॥",
      "transliteration": "aape tha(n)mai sachaa soee ||1||",
      "translation": "The True Lord Himself is our anchor. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਮੇਰਾ ਆਧਾਰੁ ॥",
      "transliteration": "har har naam meraa aadhaar ||",
      "translation": "The Name of the Lord, Har, Har, is our only support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਰਣ ਕਾਰਣ ਸਮਰਥੁ ਅਪਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "karan kaaran samarath apaar ||1|| rahaau ||",
      "translation": "The Creator, the Cause of causes, is All-powerful and Infinite. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਭ ਰੋਗ ਮਿਟਾਵੇ ਨਵਾ ਨਿਰੋਆ ॥",
      "transliteration": "sabh rog mitaave navaa niroaa ||",
      "translation": "He has eradicated all illness, and healed me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0744_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਨਕ ਰਖਾ ਆਪੇ ਹੋਆ ॥੨॥੩੩॥੩੯॥",
      "transliteration": "naanak rakhaa aape hoaa ||2||33||39||",
      "translation": "O Nanak, He Himself has become my Savior. ||2||33||39||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 744,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
