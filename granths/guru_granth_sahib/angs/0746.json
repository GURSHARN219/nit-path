{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 746,
  "lineCount": 47,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0746_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਗੁ ਸੂਹੀ ਮਹਲਾ ੫ ਘਰੁ ੫ ਪੜਤਾਲ ॥",
      "transliteration": "raag soohee mahalaa 5 ghar 5 paRataal ||",
      "translation": "Raag Soohee, Fifth Mehl, Fifth House, Partaal:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰੀਤਿ ਪ੍ਰੀਤਿ ਗੁਰੀਆ ਮੋਹਨ ਲਾਲਨਾ ॥",
      "transliteration": "preet preet gureeaa mohan laalanaa ||",
      "translation": "Love of the enticing Beloved Lord is the most glorious love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਪਿ ਮਨ ਗੋਬਿੰਦ ਏਕੈ ਅਵਰੁ ਨਹੀ ਕੋ ਲੇਖੈ ਸੰਤ ਲਾਗੁ ਮਨਹਿ ਛਾਡੁ ਦੁਬਿਧਾ ਕੀ ਕੁਰੀਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jap man gobi(n)d ekai avar nahee ko lekhai sa(n)t laag manahi chhaad dubidhaa kee kureeaa ||1|| rahaau ||",
      "translation": "Meditate, O mind, on the One Lord of the Universe - nothing else is of any account. Attach your mind to the Saints, and abandon the path of duality. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਿਰਗੁਨ ਹਰੀਆ ਸਰਗੁਨ ਧਰੀਆ ਅਨਿਕ ਕੋਠਰੀਆ ਭਿੰਨ ਭਿੰਨ ਭਿੰਨ ਭਿਨ ਕਰੀਆ ॥",
      "transliteration": "niragun hareeaa saragun dhareeaa anik kothareeaa bhi(n)n bhi(n)n bhi(n)n bhin kareeaa ||",
      "translation": "The Lord is absolute and unmanifest; He has assumed the most sublime manifestation. He has fashioned countless body chambers of many, varied, different, myriad forms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਵਿਚਿ ਮਨ ਕੋਟਵਰੀਆ ॥",
      "transliteration": "vich man kotavareeaa ||",
      "translation": "Within them, the mind is the policeman;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਿਜ ਮੰਦਰਿ ਪਿਰੀਆ ॥",
      "transliteration": "nij ma(n)dar pireeaa ||",
      "translation": "my Beloved lives in the temple of my inner self.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਹਾ ਆਨਦ ਕਰੀਆ ॥",
      "transliteration": "tahaa aanad kareeaa ||",
      "translation": "He plays there in ecstasy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਹ ਮਰੀਆ ਨਹ ਜਰੀਆ ॥੧॥",
      "transliteration": "nah mareeaa nah jareeaa ||1||",
      "translation": "He does not die, and he never grows old. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿਰਤਨਿ ਜੁਰੀਆ ਬਹੁ ਬਿਧਿ ਫਿਰੀਆ ਪਰ ਕਉ ਹਿਰੀਆ ॥",
      "transliteration": "kiratan jureeaa bahu bidh phireeaa par kau hireeaa ||",
      "translation": "He is engrossed in worldly activities, wandering around in various ways. He steals the property of others,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਖਨਾ ਘਿਰੀਆ ॥",
      "transliteration": "bikhanaa ghireeaa ||",
      "translation": "and is surrounded by corruption and sin.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਬ ਸਾਧੂ ਸੰਗਿ ਪਰੀਆ ॥",
      "transliteration": "ab saadhoo sa(n)g pareeaa ||",
      "translation": "But now, he joins the Saadh Sangat, the Company of the Holy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਰਿ ਦੁਆਰੈ ਖਰੀਆ ॥",
      "transliteration": "har duaarai khareeaa ||",
      "translation": "and stands before the Lord's Gate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦਰਸਨੁ ਕਰੀਆ ॥",
      "transliteration": "darasan kareeaa ||",
      "translation": "He obtains the Blessed Vision of the Lord's Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਗੁਰ ਮਿਰੀਆ ॥",
      "transliteration": "naanak gur mireeaa ||",
      "translation": "Nanak has met the Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਹੁਰਿ ਨ ਫਿਰੀਆ ॥੨॥੧॥੪੪॥",
      "transliteration": "bahur na phireeaa ||2||1||44||",
      "translation": "he shall not be reincarnated again. ||2||1||44||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਾਸਿ ਮੰਡਲੁ ਕੀਨੋ ਆਖਾਰਾ ॥",
      "transliteration": "raas ma(n)dal keeno aakhaaraa ||",
      "translation": "The Lord has made this world a stage;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਗਲੋ ਸਾਜਿ ਰਖਿਓ ਪਾਸਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sagalo saaj rakhio paasaaraa ||1|| rahaau ||",
      "translation": "He fashioned the expanse of the entire creation. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਰੂਪ ਰੰਗ ਆਪਾਰਾ ॥",
      "transliteration": "bahu bidh roop ra(n)g aapaaraa ||",
      "translation": "He fashioned it in various ways, with limitless colors and forms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪੇਖੈ ਖੁਸੀ ਭੋਗ ਨਹੀ ਹਾਰਾ ॥",
      "transliteration": "pekhai khusee bhog nahee haaraa ||",
      "translation": "He watches over it with joy, and He never tires of enjoying it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਭਿ ਰਸ ਲੈਤ ਬਸਤ ਨਿਰਾਰਾ ॥੧॥",
      "transliteration": "sabh ras lait basat niraaraa ||1||",
      "translation": "He enjoys all the delights, and yet He remains unattached. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਰਨੁ ਚਿਹਨੁ ਨਾਹੀ ਮੁਖੁ ਨ ਮਾਸਾਰਾ ॥",
      "transliteration": "baran chihan naahee mukh na maasaaraa ||",
      "translation": "He has no color, no sign, no mouth and no beard.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਹਨੁ ਨ ਜਾਈ ਖੇਲੁ ਤੁਹਾਰਾ ॥",
      "transliteration": "kahan na jaaee khel tuhaaraa ||",
      "translation": "I cannot describe Your play.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਨਕ ਰੇਣ ਸੰਤ ਚਰਨਾਰਾ ॥੨॥੨॥੪੫॥",
      "transliteration": "naanak ren sa(n)t charanaaraa ||2||2||45||",
      "translation": "Nanak is the dust of the feet of the Saints. ||2||2||45||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੂਹੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "soohee mahalaa 5 ||",
      "translation": "Soohee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਉ ਮੈ ਆਇਆ ਸਰਨੀ ਆਇਆ ॥",
      "transliteration": "tau mai aaiaa saranee aaiaa ||",
      "translation": "I have come to You. I have come to Your Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭਰੋਸੈ ਆਇਆ ਕਿਰਪਾ ਆਇਆ ॥",
      "transliteration": "bharosai aaiaa kirapaa aaiaa ||",
      "translation": "I have come to place my faith in You. I have come seeking Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਉ ਭਾਵੈ ਤਿਉ ਰਾਖਹੁ ਸੁਆਮੀ ਮਾਰਗੁ ਗੁਰਹਿ ਪਠਾਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jiu bhaavai tiu raakhahu suaamee maarag gurahi pathaaiaa ||1|| rahaau ||",
      "translation": "If it pleases You, save me, O my Lord and Master. The Guru has placed me upon the Path. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਹਾ ਦੁਤਰੁ ਮਾਇਆ ॥",
      "transliteration": "mahaa dutar maaiaa ||",
      "translation": "Maya is very treacherous and difficult to pass through.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੈਸੇ ਪਵਨੁ ਝੁਲਾਇਆ ॥੧॥",
      "transliteration": "jaise pavan jhulaaiaa ||1||",
      "translation": "It is like a violent wind-storm. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੁਨਿ ਸੁਨਿ ਹੀ ਡਰਾਇਆ ॥",
      "transliteration": "sun sun hee daraaiaa ||",
      "translation": "I am so afraid to hear",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਰਰੋ ਧ੍ਰਮਰਾਇਆ ॥੨॥",
      "transliteration": "kararo dhramaraaiaa ||2||",
      "translation": "that the Righteous Judge of Dharma is so strict and stern. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗ੍ਰਿਹ ਅੰਧ ਕੂਪਾਇਆ ॥",
      "transliteration": "grih a(n)dh koopaaiaa ||",
      "translation": "The world is a deep, dark pit;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪਾਵਕੁ ਸਗਰਾਇਆ ॥੩॥",
      "transliteration": "paavak sagaraaiaa ||3||",
      "translation": "it is all on fire. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਹੀ ਓਟ ਸਾਧਾਇਆ ॥",
      "transliteration": "gahee ot saadhaaiaa ||",
      "translation": "I have grasped the Support of the Holy Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਧਿਆਇਆ ॥",
      "transliteration": "naanak har dhiaaiaa ||",
      "translation": "Nanak meditates on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਬ ਮੈ ਪੂਰਾ ਪਾਇਆ ॥੪॥੩॥੪੬॥",
      "transliteration": "ab mai pooraa paaiaa ||4||3||46||",
      "translation": "Now, I have found the Perfect Lord. ||4||3||46||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਗੁ ਸੂਹੀ ਮਹਲਾ ੫ ਘਰੁ ੬ ॥",
      "transliteration": "raag soohee mahalaa 5 ghar 6 ||",
      "translation": "Raag Soohee, Fifth Mehl, Sixth House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਤਿਗੁਰ ਪਾਸਿ ਬੇਨੰਤੀਆ ਮਿਲੈ ਨਾਮੁ ਆਧਾਰਾ ॥",
      "transliteration": "satigur paas bena(n)teeaa milai naam aadhaaraa ||",
      "translation": "I offer this prayer to the True Guru, to bless me with the sustenance of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤੁਠਾ ਸਚਾ ਪਾਤਿਸਾਹੁ ਤਾਪੁ ਗਇਆ ਸੰਸਾਰਾ ॥੧॥",
      "transliteration": "tuthaa sachaa paatisaahu taap gaiaa sa(n)saaraa ||1||",
      "translation": "When the True King is pleased, the world is rid of its diseases. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭਗਤਾ ਕੀ ਟੇਕ ਤੂੰ ਸੰਤਾ ਕੀ ਓਟ ਤੂੰ ਸਚਾ ਸਿਰਜਨਹਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bhagataa kee tek too(n) sa(n)taa kee ot too(n) sachaa sirajanahaaraa ||1|| rahaau ||",
      "translation": "You are the Support of Your devotees, and the Shelter of the Saints, O True Creator Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਚੁ ਤੇਰੀ ਸਾਮਗਰੀ ਸਚੁ ਤੇਰਾ ਦਰਬਾਰਾ ॥",
      "transliteration": "sach teree saamagaree sach teraa darabaaraa ||",
      "translation": "True are Your devices, and True is Your Court.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਚੁ ਤੇਰੇ ਖਾਜੀਨਿਆ ਸਚੁ ਤੇਰਾ ਪਾਸਾਰਾ ॥੨॥",
      "transliteration": "sach tere khaajeeniaa sach teraa paasaaraa ||2||",
      "translation": "True are Your treasures, and True is Your expanse. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤੇਰਾ ਰੂਪੁ ਅਗੰਮੁ ਹੈ ਅਨੂਪੁ ਤੇਰਾ ਦਰਸਾਰਾ ॥",
      "transliteration": "teraa roop aga(n)m hai anoop teraa darasaaraa ||",
      "translation": "Your Form is inaccessible, and Your Vision is incomparably beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0746_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਉ ਕੁਰਬਾਣੀ ਤੇਰਿਆ ਸੇਵਕਾ ਜਿਨੑ ਹਰਿ ਨਾਮੁ ਪਿਆਰਾ ॥੩॥",
      "transliteration": "hau kurabaanee teriaa sevakaa jinh har naam piaaraa ||3||",
      "translation": "I am a sacrifice to Your servants; they love Your Name, O Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 746,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
