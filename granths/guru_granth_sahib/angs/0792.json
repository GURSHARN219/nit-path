{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 792,
  "lineCount": 50,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0792_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਿਉ ਨ ਮਰੀਜੈ ਰੋਇ ਜਾ ਲਗੁ ਚਿਤਿ ਨ ਆਵਹੀ ॥੧॥",
      "transliteration": "kiu na mareejai roi jaa lag chit na aavahee ||1||",
      "translation": "I might as well just die crying, if You will not come into my mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਃ ੨ ॥",
      "transliteration": "mah 2 ||",
      "translation": "Second Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਾਂ ਸੁਖੁ ਤਾ ਸਹੁ ਰਾਵਿਓ ਦੁਖਿ ਭੀ ਸੰਮੑਾਲਿਓਇ ॥",
      "transliteration": "jaa(n) sukh taa sahu raavio dukh bhee sa(n)mhaalioi ||",
      "translation": "When there is peace and pleasure, that is the time to remember your Husband Lord. In times of suffering and pain, remember Him then as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਨਕੁ ਕਹੈ ਸਿਆਣੀਏ ਇਉ ਕੰਤ ਮਿਲਾਵਾ ਹੋਇ ॥੨॥",
      "transliteration": "naanak kahai siaaneee iu ka(n)t milaavaa hoi ||2||",
      "translation": "Says Nanak, O wise bride, this is the way to meet your Husband Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਉ ਕਿਆ ਸਾਲਾਹੀ ਕਿਰਮ ਜੰਤੁ ਵਡੀ ਤੇਰੀ ਵਡਿਆਈ ॥",
      "transliteration": "hau kiaa saalaahee kiram ja(n)t vadee teree vadiaaee ||",
      "translation": "I am a worm - how can I praise You, O Lord; Your glorious greatness is so great!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੂ ਅਗਮ ਦਇਆਲੁ ਅਗੰਮੁ ਹੈ ਆਪਿ ਲੈਹਿ ਮਿਲਾਈ ॥",
      "transliteration": "too agam daiaal aga(n)m hai aap laihi milaaee ||",
      "translation": "You are inaccessible, merciful and unapproachable; You Yourself unite us with Yourself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮੈ ਤੁਝ ਬਿਨੁ ਬੇਲੀ ਕੋ ਨਹੀ ਤੂ ਅੰਤਿ ਸਖਾਈ ॥",
      "transliteration": "mai tujh bin belee ko nahee too a(n)t sakhaaee ||",
      "translation": "I have no other friend except You; in the end, You alone will be my Companion and Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੋ ਤੇਰੀ ਸਰਣਾਗਤੀ ਤਿਨ ਲੈਹਿ ਛਡਾਈ ॥",
      "transliteration": "jo teree saranaagatee tin laihi chhadaaee ||",
      "translation": "You save those who enter Your Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਨਕ ਵੇਪਰਵਾਹੁ ਹੈ ਤਿਸੁ ਤਿਲੁ ਨ ਤਮਾਈ ॥੨੦॥੧॥",
      "transliteration": "naanak veparavaahu hai tis til na tamaaee ||20||1||",
      "translation": "O Nanak, He is care-free; He has no greed at all. ||20||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਗੁ ਸੂਹੀ ਬਾਣੀ ਸ੍ਰੀ ਕਬੀਰ ਜੀਉ ਤਥਾ ਸਭਨਾ ਭਗਤਾ ਕੀ ॥ ਕਬੀਰ ਕੇ ॥",
      "transliteration": "raag soohee baanee sree kabeer jeeu tathaa sabhanaa bhagataa kee || kabeer ke ||",
      "translation": "Raag Soohee, The Word Of Kabeer Jee, And Other Devotees. Of Kabeer",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਵਤਰਿ ਆਇ ਕਹਾ ਤੁਮ ਕੀਨਾ ॥",
      "transliteration": "avatar aai kahaa tum keenaa ||",
      "translation": "Since your birth, what have you done?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਮ ਕੋ ਨਾਮੁ ਨ ਕਬਹੂ ਲੀਨਾ ॥੧॥",
      "transliteration": "raam ko naam na kabahoo leenaa ||1||",
      "translation": "You have never even chanted the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਾਮ ਨ ਜਪਹੁ ਕਵਨ ਮਤਿ ਲਾਗੇ ॥",
      "transliteration": "raam na japahu kavan mat laage ||",
      "translation": "You have not meditated on the Lord; what thoughts are you attached to?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਰਿ ਜਇਬੇ ਕਉ ਕਿਆ ਕਰਹੁ ਅਭਾਗੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mar jaibe kau kiaa karahu abhaage ||1|| rahaau ||",
      "translation": "What preparations are you making for your death, O unfortunate one? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੁਖ ਸੁਖ ਕਰਿ ਕੈ ਕੁਟੰਬੁ ਜੀਵਾਇਆ ॥",
      "transliteration": "dukh sukh kar kai kuta(n)b jeevaaiaa ||",
      "translation": "Through pain and pleasure, you have taken care of your family.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਰਤੀ ਬਾਰ ਇਕਸਰ ਦੁਖੁ ਪਾਇਆ ॥੨॥",
      "transliteration": "maratee baar ikasar dukh paaiaa ||2||",
      "translation": "But at the time of death, you shall have to endure the agony all alone. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕੰਠ ਗਹਨ ਤਬ ਕਰਨ ਪੁਕਾਰਾ ॥",
      "transliteration": "ka(n)th gahan tab karan pukaaraa ||",
      "translation": "When you are seized by the neck, then you shall cry out.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਆਗੇ ਤੇ ਨ ਸੰਮੑਾਰਾ ॥੩॥੧॥",
      "transliteration": "kahi kabeer aage te na sa(n)mhaaraa ||3||1||",
      "translation": "Says Kabeer, why didn't you remember the Lord before this? ||3||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੂਹੀ ਕਬੀਰ ਜੀ ॥",
      "transliteration": "soohee kabeer jee ||",
      "translation": "Soohee, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਥਰਹਰ ਕੰਪੈ ਬਾਲਾ ਜੀਉ ॥",
      "transliteration": "tharahar ka(n)pai baalaa jeeu ||",
      "translation": "My innocent soul trembles and shakes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾ ਜਾਨਉ ਕਿਆ ਕਰਸੀ ਪੀਉ ॥੧॥",
      "transliteration": "naa jaanau kiaa karasee peeu ||1||",
      "translation": "I do not know how my Husband Lord will deal with me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰੈਨਿ ਗਈ ਮਤ ਦਿਨੁ ਭੀ ਜਾਇ ॥",
      "transliteration": "rain gaee mat din bhee jaai ||",
      "translation": "The night of my youth has passed away; will the day of old age also pass away?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭਵਰ ਗਏ ਬਗ ਬੈਠੇ ਆਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bhavar gae bag baithe aai ||1|| rahaau ||",
      "translation": "My dark hairs, like bumble bees, have gone away, and grey hairs, like cranes, have settled upon my head. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਾਚੈ ਕਰਵੈ ਰਹੈ ਨ ਪਾਨੀ ॥",
      "transliteration": "kaachai karavai rahai na paanee ||",
      "translation": "Water does not remain in the unbaked clay pot;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੰਸੁ ਚਲਿਆ ਕਾਇਆ ਕੁਮਲਾਨੀ ॥੨॥",
      "transliteration": "ha(n)s chaliaa kaaiaa kumalaanee ||2||",
      "translation": "when the soul-swan departs, the body withers away. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕੁਆਰ ਕੰਨਿਆ ਜੈਸੇ ਕਰਤ ਸੀਗਾਰਾ ॥",
      "transliteration": "kuaar ka(n)niaa jaise karat seegaaraa ||",
      "translation": "I decorate myself like a young virgin;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਿਉ ਰਲੀਆ ਮਾਨੈ ਬਾਝੁ ਭਤਾਰਾ ॥੩॥",
      "transliteration": "kiu raleeaa maanai baajh bhataaraa ||3||",
      "translation": "but how can I enjoy pleasures, without my Husband Lord? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਾਗ ਉਡਾਵਤ ਭੁਜਾ ਪਿਰਾਨੀ ॥",
      "transliteration": "kaag udaavat bhujaa piraanee ||",
      "translation": "My arm is tired, driving away the crows.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਇਹ ਕਥਾ ਸਿਰਾਨੀ ॥੪॥੨॥",
      "transliteration": "kahi kabeer ih kathaa siraanee ||4||2||",
      "translation": "Says Kabeer, this is the way the story of my life ends. ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੂਹੀ ਕਬੀਰ ਜੀਉ ॥",
      "transliteration": "soohee kabeer jeeu ||",
      "translation": "Soohee, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਮਲੁ ਸਿਰਾਨੋ ਲੇਖਾ ਦੇਨਾ ॥",
      "transliteration": "amal siraano lekhaa denaa ||",
      "translation": "Your time of service is at its end, and you will have to give your account.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਏ ਕਠਿਨ ਦੂਤ ਜਮ ਲੇਨਾ ॥",
      "transliteration": "aae kathin doot jam lenaa ||",
      "translation": "The hard-hearted Messenger of Death has come to take you away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਿਆ ਤੈ ਖਟਿਆ ਕਹਾ ਗਵਾਇਆ ॥",
      "transliteration": "kiaa tai khatiaa kahaa gavaaiaa ||",
      "translation": "What have you earned, and what have you lost?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚਲਹੁ ਸਿਤਾਬ ਦੀਬਾਨਿ ਬੁਲਾਇਆ ॥੧॥",
      "transliteration": "chalahu sitaab deebaan bulaaiaa ||1||",
      "translation": "Come immediately! You are summoned to His Court! ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚਲੁ ਦਰਹਾਲੁ ਦੀਵਾਨਿ ਬੁਲਾਇਆ ॥",
      "transliteration": "chal darahaal deevaan bulaaiaa ||",
      "translation": "Get going! Come just as you are! You have been summoned to His Court.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਰਿ ਫੁਰਮਾਨੁ ਦਰਗਹ ਕਾ ਆਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har phuramaan daragah kaa aaiaa ||1|| rahaau ||",
      "translation": "The Order has come from the Court of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਰਉ ਅਰਦਾਸਿ ਗਾਵ ਕਿਛੁ ਬਾਕੀ ॥",
      "transliteration": "karau aradaas gaav kichh baakee ||",
      "translation": "I pray to the Messenger of Death: please, I still have some outstanding debts to collect in the village.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲੇਉ ਨਿਬੇਰਿ ਆਜੁ ਕੀ ਰਾਤੀ ॥",
      "transliteration": "leu niber aaj kee raatee ||",
      "translation": "I will collect them tonight;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਿਛੁ ਭੀ ਖਰਚੁ ਤੁਮੑਾਰਾ ਸਾਰਉ ॥",
      "transliteration": "kichh bhee kharach tumhaaraa saarau ||",
      "translation": "I will also pay you something for your expenses,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੁਬਹ ਨਿਵਾਜ ਸਰਾਇ ਗੁਜਾਰਉ ॥੨॥",
      "transliteration": "subah nivaaj saraai gujaarau ||2||",
      "translation": "and I will recite my morning prayers on the way. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਜਾ ਕਉ ਹਰਿ ਰੰਗੁ ਲਾਗਾ ॥",
      "transliteration": "saadhasa(n)g jaa kau har ra(n)g laagaa ||",
      "translation": "Blessed, blessed is the most fortunate servant of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਧਨੁ ਧਨੁ ਸੋ ਜਨੁ ਪੁਰਖੁ ਸਭਾਗਾ ॥",
      "transliteration": "dhan dhan so jan purakh sabhaagaa ||",
      "translation": "Who is imbued with the Lord's Love, in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਈਤ ਊਤ ਜਨ ਸਦਾ ਸੁਹੇਲੇ ॥",
      "transliteration": "eet oot jan sadaa suhele ||",
      "translation": "Here and there, the humble servants of the Lord are always happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਨਮੁ ਪਦਾਰਥੁ ਜੀਤਿ ਅਮੋਲੇ ॥੩॥",
      "transliteration": "janam padaarath jeet amole ||3||",
      "translation": "They win the priceless treasure of this human life. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਾਗਤੁ ਸੋਇਆ ਜਨਮੁ ਗਵਾਇਆ ॥",
      "transliteration": "jaagat soiaa janam gavaaiaa ||",
      "translation": "When he is awake, he is sleeping, and so he loses this life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਾਲੁ ਧਨੁ ਜੋਰਿਆ ਭਇਆ ਪਰਾਇਆ ॥",
      "transliteration": "maal dhan joriaa bhaiaa paraaiaa ||",
      "translation": "The property and wealth he has accumulated passes on to someone else.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਤੇਈ ਨਰ ਭੂਲੇ ॥",
      "transliteration": "kahu kabeer teee nar bhoole ||",
      "translation": "Says Kabeer, those people are deluded,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0792_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਖਸਮੁ ਬਿਸਾਰਿ ਮਾਟੀ ਸੰਗਿ ਰੂਲੇ ॥੪॥੩॥",
      "transliteration": "khasam bisaar maatee sa(n)g roole ||4||3||",
      "translation": "who forget their Lord and Master, and roll in the dust. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 792,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
