{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 801,
  "lineCount": 53,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0801_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਰਿ ਭਰਿਪੁਰੇ ਰਹਿਆ ॥ ਜਲਿ ਥਲੇ ਰਾਮ ਨਾਮੁ ॥ ਨਿਤ ਗਾਈਐ ਹਰਿ ਦੂਖ ਬਿਸਾਰਨੋ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har bharipure rahiaa || jal thale raam naam || nit gaaeeai har dookh bisaarano ||1|| rahaau ||",
      "translation": "The Lord is totally permeating and pervading everywhere; The Name of the Lord is pervading the water and the land. So sing continuously of the Lord, the Dispeller of pain. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਰਿ ਕੀਆ ਹੈ ਸਫਲ ਜਨਮੁ ਹਮਾਰਾ ॥",
      "transliteration": "har keeaa hai saphal janam hamaaraa ||",
      "translation": "The Lord has made my life fruitful and rewarding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਰਿ ਜਪਿਆ ਹਰਿ ਦੂਖ ਬਿਸਾਰਨਹਾਰਾ ॥",
      "transliteration": "har japiaa har dookh bisaaranahaaraa ||",
      "translation": "I meditate on the Lord, the Dispeller of pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰੁ ਭੇਟਿਆ ਹੈ ਮੁਕਤਿ ਦਾਤਾ ॥",
      "transliteration": "gur bhetiaa hai mukat daataa ||",
      "translation": "I have met the Guru, the Giver of liberation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਰਿ ਕੀਈ ਹਮਾਰੀ ਸਫਲ ਜਾਤਾ ॥",
      "transliteration": "har keeee hamaaree saphal jaataa ||",
      "translation": "The Lord has made my life's journey fruitful and rewarding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਿਲਿ ਸੰਗਤੀ ਗੁਨ ਗਾਵਨੋ ॥੧॥",
      "transliteration": "mil sa(n)gatee gun gaavano ||1||",
      "translation": "Joining the Sangat, the Holy Congregation, I sing the Glorious Praises of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਨ ਰਾਮ ਨਾਮ ਕਰਿ ਆਸਾ ॥",
      "transliteration": "man raam naam kar aasaa ||",
      "translation": "O mortal, place your hopes in the Name of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭਾਉ ਦੂਜਾ ਬਿਨਸਿ ਬਿਨਾਸਾ ॥",
      "transliteration": "bhaau doojaa binas binaasaa ||",
      "translation": "and your love of duality shall simply vanish.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਵਿਚਿ ਆਸਾ ਹੋਇ ਨਿਰਾਸੀ ॥",
      "transliteration": "vich aasaa hoi niraasee ||",
      "translation": "One who, in hope, remains unattached to hope,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੋ ਜਨੁ ਮਿਲਿਆ ਹਰਿ ਪਾਸੀ ॥",
      "transliteration": "so jan miliaa har paasee ||",
      "translation": "such a humble being meets with his Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕੋਈ ਰਾਮ ਨਾਮ ਗੁਨ ਗਾਵਨੋ ॥",
      "transliteration": "koee raam naam gun gaavano ||",
      "translation": "And one who sings the Glorious Praises of the Lord's Name",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਨੁ ਨਾਨਕੁ ਤਿਸੁ ਪਗਿ ਲਾਵਨੋ ॥੨॥੧॥੭॥੪॥੬॥੭॥੧੭॥",
      "transliteration": "jan naanak tis pag laavano ||2||1||7||4||6||7||17||",
      "translation": "- servant Nanak falls at his feet. ||2||1||7||4||6||7||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਗੁ ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ਚਉਪਦੇ ਘਰੁ ੧ ॥",
      "transliteration": "raag bilaaval mahalaa 5 chaupade ghar 1 ||",
      "translation": "Raag Bilaaval, Fifth Mehl, Chau-Padhay, First House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਦਰੀ ਆਵੈ ਤਿਸੁ ਸਿਉ ਮੋਹੁ ॥",
      "transliteration": "nadaree aavai tis siu mohu ||",
      "translation": "He is attached to what he sees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿਉ ਮਿਲੀਐ ਪ੍ਰਭ ਅਬਿਨਾਸੀ ਤੋਹਿ ॥",
      "transliteration": "kiu mileeai prabh abinaasee tohi ||",
      "translation": "How can I meet You, O Imperishable God?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਮੋਹਿ ਮਾਰਗਿ ਪਾਵਹੁ ॥",
      "transliteration": "kar kirapaa mohi maarag paavahu ||",
      "translation": "Have Mercy upon me, and place me upon the Path;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਕੈ ਅੰਚਲਿ ਲਾਵਹੁ ॥੧॥",
      "transliteration": "saadhasa(n)gat kai a(n)chal laavahu ||1||",
      "translation": "let me be attached to the hem of the robe of the Saadh Sangat, the Company of the Holy. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਿਉ ਤਰੀਐ ਬਿਖਿਆ ਸੰਸਾਰੁ ॥",
      "transliteration": "kiu tareeai bikhiaa sa(n)saar ||",
      "translation": "How can I cross over the poisonous world-ocean?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਬੋਹਿਥੁ ਪਾਵੈ ਪਾਰਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "satigur bohith paavai paar ||1|| rahaau ||",
      "translation": "The True Guru is the boat to carry us across. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਵਨ ਝੁਲਾਰੇ ਮਾਇਆ ਦੇਇ ॥",
      "transliteration": "pavan jhulaare maaiaa dei ||",
      "translation": "The wind of Maya blows and shakes us,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹਰਿ ਕੇ ਭਗਤ ਸਦਾ ਥਿਰੁ ਸੇਇ ॥",
      "transliteration": "har ke bhagat sadaa thir sei ||",
      "translation": "but the Lord's devotees remain ever-stable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਰਖ ਸੋਗ ਤੇ ਰਹਹਿ ਨਿਰਾਰਾ ॥",
      "transliteration": "harakh sog te rahahi niraaraa ||",
      "translation": "They remain unaffected by pleasure and pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਿਰ ਊਪਰਿ ਆਪਿ ਗੁਰੂ ਰਖਵਾਰਾ ॥੨॥",
      "transliteration": "sir oopar aap guroo rakhavaaraa ||2||",
      "translation": "The Guru Himself is the Savior above their heads. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪਾਇਆ ਵੇੜੁ ਮਾਇਆ ਸਰਬ ਭੁਇਅੰਗਾ ॥",
      "transliteration": "paaiaa veR maaiaa sarab bhuia(n)gaa ||",
      "translation": "Maya, the snake, holds all in her coils.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਉਮੈ ਪਚੇ ਦੀਪਕ ਦੇਖਿ ਪਤੰਗਾ ॥",
      "transliteration": "haumai pache deepak dekh pata(n)gaa ||",
      "translation": "They burn to death in egotism, like the moth lured by seeing the flame.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਗਲ ਸੀਗਾਰ ਕਰੇ ਨਹੀ ਪਾਵੈ ॥",
      "transliteration": "sagal seegaar kare nahee paavai ||",
      "translation": "They make all sorts of decorations, but they do not find the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾ ਹੋਇ ਕ੍ਰਿਪਾਲੁ ਤਾ ਗੁਰੂ ਮਿਲਾਵੈ ॥੩॥",
      "transliteration": "jaa hoi kripaal taa guroo milaavai ||3||",
      "translation": "When the Guru becomes Merciful, He leads them to meet the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਉ ਫਿਰਉ ਉਦਾਸੀ ਮੈ ਇਕੁ ਰਤਨੁ ਦਸਾਇਆ ॥",
      "transliteration": "hau phirau udaasee mai ik ratan dasaaiaa ||",
      "translation": "I wander around, sad and depressed, seeking the jewel of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਿਰਮੋਲਕੁ ਹੀਰਾ ਮਿਲੈ ਨ ਉਪਾਇਆ ॥",
      "transliteration": "niramolak heeraa milai na upaaiaa ||",
      "translation": "This priceless jewel is not obtained by any efforts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਰਿ ਕਾ ਮੰਦਰੁ ਤਿਸੁ ਮਹਿ ਲਾਲੁ ॥",
      "transliteration": "har kaa ma(n)dar tis mahi laal ||",
      "translation": "That jewel is within the body, the Temple of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰਿ ਖੋਲਿਆ ਪੜਦਾ ਦੇਖਿ ਭਈ ਨਿਹਾਲੁ ॥੪॥",
      "transliteration": "gur kholiaa paRadaa dekh bhaee nihaal ||4||",
      "translation": "The Guru has torn away the veil of illusion, and beholding the jewel, I am delighted. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਨਿ ਚਾਖਿਆ ਤਿਸੁ ਆਇਆ ਸਾਦੁ ॥",
      "transliteration": "jin chaakhiaa tis aaiaa saad ||",
      "translation": "One who has tasted it, comes to know its flavor;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਿਉ ਗੂੰਗਾ ਮਨ ਮਹਿ ਬਿਸਮਾਦੁ ॥",
      "transliteration": "jiu goo(n)gaa man mahi bisamaad ||",
      "translation": "he is like the mute, whose mind is filled with wonder.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਨਦ ਰੂਪੁ ਸਭੁ ਨਦਰੀ ਆਇਆ ॥",
      "transliteration": "aanad roop sabh nadaree aaiaa ||",
      "translation": "I see the Lord, the source of bliss, everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਹਰਿ ਗੁਣ ਆਖਿ ਸਮਾਇਆ ॥੫॥੧॥",
      "transliteration": "jan naanak har gun aakh samaaiaa ||5||1||",
      "translation": "Servant Nanak speaks the Glorious Praises of the Lord, and merges in Him. ||5||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਰਬ ਕਲਿਆਣ ਕੀਏ ਗੁਰਦੇਵ ॥",
      "transliteration": "sarab kaliaan keee guradev ||",
      "translation": "The Divine Guru has blessed me with total happiness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੇਵਕੁ ਅਪਨੀ ਲਾਇਓ ਸੇਵ ॥",
      "transliteration": "sevak apanee laaio sev ||",
      "translation": "He has linked His servant to His service.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਘਨੁ ਨ ਲਾਗੈ ਜਪਿ ਅਲਖ ਅਭੇਵ ॥੧॥",
      "transliteration": "bighan na laagai jap alakh abhev ||1||",
      "translation": "No obstacles block my path, meditating on the incomprehensible, inscrutable Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਧਰਤਿ ਪੁਨੀਤ ਭਈ ਗੁਨ ਗਾਏ ॥",
      "transliteration": "dharat puneet bhaee gun gaae ||",
      "translation": "The soil has been sanctified, singing the Glories of His Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੁਰਤੁ ਗਇਆ ਹਰਿ ਨਾਮੁ ਧਿਆਏ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "durat gaiaa har naam dhiaae ||1|| rahaau ||",
      "translation": "The sins are eradicated, meditating on the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਭਨੀ ਥਾਂਈ ਰਵਿਆ ਆਪਿ ॥",
      "transliteration": "sabhanee thaa(n)ee raviaa aap ||",
      "translation": "He Himself is pervading everywhere;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਆਦਿ ਜੁਗਾਦਿ ਜਾ ਕਾ ਵਡ ਪਰਤਾਪੁ ॥",
      "transliteration": "aad jugaad jaa kaa vad parataap ||",
      "translation": "from the very beginning, and throughout the ages, His Glory has been radiantly manifest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਨ ਹੋਇ ਸੰਤਾਪੁ ॥੨॥",
      "transliteration": "gur parasaad na hoi sa(n)taap ||2||",
      "translation": "By Guru's Grace, sorrow does not touch me. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਨ ਲਗੇ ਮਨਿ ਮੀਠੇ ॥",
      "transliteration": "gur ke charan lage man meethe ||",
      "translation": "The Guru's Feet seem so sweet to my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਿਰਬਿਘਨ ਹੋਇ ਸਭ ਥਾਂਈ ਵੂਠੇ ॥",
      "transliteration": "nirabighan hoi sabh thaa(n)ee voothe ||",
      "translation": "He is unobstructed, dwelling everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਭਿ ਸੁਖ ਪਾਏ ਸਤਿਗੁਰ ਤੂਠੇ ॥੩॥",
      "transliteration": "sabh sukh paae satigur toothe ||3||",
      "translation": "I found total peace, when the Guru was pleased. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਪ੍ਰਭ ਭਏ ਰਖਵਾਲੇ ॥",
      "transliteration": "paarabraham prabh bhae rakhavaale ||",
      "translation": "The Supreme Lord God has become my Savior.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਥੈ ਕਿਥੈ ਦੀਸਹਿ ਨਾਲੇ ॥",
      "transliteration": "jithai kithai deesahi naale ||",
      "translation": "Wherever I look, I see Him there with me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਖਸਮਿ ਪ੍ਰਤਿਪਾਲੇ ॥੪॥੨॥",
      "transliteration": "naanak daas khasam pratipaale ||4||2||",
      "translation": "O Nanak, the Lord and Master protects and cherishes His slaves. ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0801_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੁਖ ਨਿਧਾਨ ਪ੍ਰੀਤਮ ਪ੍ਰਭ ਮੇਰੇ ॥",
      "transliteration": "sukh nidhaan preetam prabh mere ||",
      "translation": "You are the treasure of peace, O my Beloved God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 801,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
