{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 804,
  "lineCount": 52,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0804_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਾਮਿ ਕ੍ਰੋਧਿ ਲੋਭਿ ਮੋਹਿ ਮਨੁ ਲੀਨਾ ॥",
      "transliteration": "kaam krodh lobh mohi man leenaa ||",
      "translation": "The mind is engrossed in sexual desire, anger, greed and emotional attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬੰਧਨ ਕਾਟਿ ਮੁਕਤਿ ਗੁਰਿ ਕੀਨਾ ॥੨॥",
      "transliteration": "ba(n)dhan kaat mukat gur keenaa ||2||",
      "translation": "Breaking my bonds, the Guru has liberated me. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੁਖ ਸੁਖ ਕਰਤ ਜਨਮਿ ਫੁਨਿ ਮੂਆ ॥",
      "transliteration": "dukh sukh karat janam phun mooaa ||",
      "translation": "Experiencing pain and pleasure, one is born, only to die again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਗੁਰਿ ਆਸ੍ਰਮੁ ਦੀਆ ॥੩॥",
      "transliteration": "charan kamal gur aasram deeaa ||3||",
      "translation": "The Lotus Feet of the Guru bring peace and shelter. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਗਨਿ ਸਾਗਰ ਬੂਡਤ ਸੰਸਾਰਾ ॥",
      "transliteration": "agan saagar boodat sa(n)saaraa ||",
      "translation": "The world is drowning in the ocean of fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਨਕ ਬਾਹ ਪਕਰਿ ਸਤਿਗੁਰਿ ਨਿਸਤਾਰਾ ॥੪॥੩॥੮॥",
      "transliteration": "naanak baah pakar satigur nisataaraa ||4||3||8||",
      "translation": "O Nanak, holding me by the arm, the True Guru has saved me. ||4||3||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਧਨੁ ਅਰਪਉ ਸਭੁ ਅਪਨਾ ॥",
      "transliteration": "tan man dhan arapau sabh apanaa ||",
      "translation": "Body, mind, wealth and everything, I surrender to my Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਵਨ ਸੁ ਮਤਿ ਜਿਤੁ ਹਰਿ ਹਰਿ ਜਪਨਾ ॥੧॥",
      "transliteration": "kavan s mat jit har har japanaa ||1||",
      "translation": "What is that wisdom, by which I may come to chant the Name of the Lord, Har, Har? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਰਿ ਆਸਾ ਆਇਓ ਪ੍ਰਭ ਮਾਗਨਿ ॥",
      "transliteration": "kar aasaa aaio prabh maagan ||",
      "translation": "Nurturing hope, I have come to beg from God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੁਮੑ ਪੇਖਤ ਸੋਭਾ ਮੇਰੈ ਆਗਨਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tumh pekhat sobhaa merai aagan ||1|| rahaau ||",
      "translation": "Gazing upon You, the courtyard of my heart is embellished. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਨਿਕ ਜੁਗਤਿ ਕਰਿ ਬਹੁਤੁ ਬੀਚਾਰਉ ॥",
      "transliteration": "anik jugat kar bahut beechaarau ||",
      "translation": "Trying several methods, I reflect deeply upon the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਇਸੁ ਮਨਹਿ ਉਧਾਰਉ ॥੨॥",
      "transliteration": "saadhasa(n)g is manahi udhaarau ||2||",
      "translation": "In the Saadh Sangat, the Company of the Holy, this mind is saved. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮਤਿ ਬੁਧਿ ਸੁਰਤਿ ਨਾਹੀ ਚਤੁਰਾਈ ॥",
      "transliteration": "mat budh surat naahee chaturaaee ||",
      "translation": "I have neither intelligence, wisdom, common sense nor cleverness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਾ ਮਿਲੀਐ ਜਾ ਲਏ ਮਿਲਾਈ ॥੩॥",
      "transliteration": "taa mileeai jaa lae milaaee ||3||",
      "translation": "I meet You, only if You lead me to meet You. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨੈਨ ਸੰਤੋਖੇ ਪ੍ਰਭ ਦਰਸਨੁ ਪਾਇਆ ॥",
      "transliteration": "nain sa(n)tokhe prabh darasan paaiaa ||",
      "translation": "My eyes are content, gazing upon the Blessed Vision of God's Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਸਫਲੁ ਸੋ ਆਇਆ ॥੪॥੪॥੯॥",
      "transliteration": "kahu naanak saphal so aaiaa ||4||4||9||",
      "translation": "Says Nanak, such a life is fruitful and rewarding. ||4||4||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਸੁਤ ਸਾਥਿ ਨ ਮਾਇਆ ॥",
      "transliteration": "maat pitaa sut saath na maaiaa ||",
      "translation": "Mother, father, children and the wealth of Maya, will not go along with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਸਭੁ ਦੂਖੁ ਮਿਟਾਇਆ ॥੧॥",
      "transliteration": "saadhasa(n)g sabh dookh mitaaiaa ||1||",
      "translation": "In the Saadh Sangat, the Company of the Holy, all pain is dispelled. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਵਿ ਰਹਿਆ ਪ੍ਰਭੁ ਸਭ ਮਹਿ ਆਪੇ ॥",
      "transliteration": "rav rahiaa prabh sabh mahi aape ||",
      "translation": "God Himself is pervading, and permeating all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹਰਿ ਜਪੁ ਰਸਨਾ ਦੁਖੁ ਨ ਵਿਆਪੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har jap rasanaa dukh na viaape ||1|| rahaau ||",
      "translation": "Chant the Name of the Lord with your tongue, and pain will not afflict you. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਿਖਾ ਭੂਖ ਬਹੁ ਤਪਤਿ ਵਿਆਪਿਆ ॥",
      "transliteration": "tikhaa bhookh bahu tapat viaapiaa ||",
      "translation": "One who is afflicted by the terrible fire of thirst and desire,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੀਤਲ ਭਏ ਹਰਿ ਹਰਿ ਜਸੁ ਜਾਪਿਆ ॥੨॥",
      "transliteration": "seetal bhae har har jas jaapiaa ||2||",
      "translation": "becomes cool, chanting the Praises of the Lord, Har, Har. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕੋਟਿ ਜਤਨ ਸੰਤੋਖੁ ਨ ਪਾਇਆ ॥",
      "transliteration": "kot jatan sa(n)tokh na paaiaa ||",
      "translation": "By millions of efforts, peace is not obtained;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨੁ ਤ੍ਰਿਪਤਾਨਾ ਹਰਿ ਗੁਣ ਗਾਇਆ ॥੩॥",
      "transliteration": "man tripataanaa har gun gaaiaa ||3||",
      "translation": "the mind is satisfied only by singing the Glorious Praises of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੇਹੁ ਭਗਤਿ ਪ੍ਰਭ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "dehu bhagat prabh a(n)tarajaamee ||",
      "translation": "Please bless me with devotion, O God, O Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਕੀ ਬੇਨੰਤੀ ਸੁਆਮੀ ॥੪॥੫॥੧੦॥",
      "transliteration": "naanak kee bena(n)tee suaamee ||4||5||10||",
      "translation": "This is Nanak's prayer, O Lord and Master. ||4||5||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗੁਰੁ ਪੂਰਾ ਵਡਭਾਗੀ ਪਾਈਐ ॥",
      "transliteration": "gur pooraa vadabhaagee paaeeai ||",
      "translation": "By great good fortune, the Perfect Guru is found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਿਲਿ ਸਾਧੂ ਹਰਿ ਨਾਮੁ ਧਿਆਈਐ ॥੧॥",
      "transliteration": "mil saadhoo har naam dhiaaeeai ||1||",
      "translation": "Meeting with the Holy Saints, meditate on the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਪ੍ਰਭ ਤੇਰੀ ਸਰਨਾ ॥",
      "transliteration": "paarabraham prabh teree saranaa ||",
      "translation": "O Supreme Lord God, I seek Your Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਿਲਬਿਖ ਕਾਟੈ ਭਜੁ ਗੁਰ ਕੇ ਚਰਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kilabikh kaatai bhaj gur ke charanaa ||1|| rahaau ||",
      "translation": "Meditating on the Guru's Feet, sinful mistakes are erased. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਵਰਿ ਕਰਮ ਸਭਿ ਲੋਕਾਚਾਰ ॥",
      "transliteration": "avar karam sabh lokaachaar ||",
      "translation": "All other rituals are just worldly affairs;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਿਲਿ ਸਾਧੂ ਸੰਗਿ ਹੋਇ ਉਧਾਰ ॥੨॥",
      "transliteration": "mil saadhoo sa(n)g hoi udhaar ||2||",
      "translation": "joining the Saadh Sangat, the Company of the Holy, one is saved. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਿੰਮ੍ਰਿਤਿ ਸਾਸਤ ਬੇਦ ਬੀਚਾਰੇ ॥",
      "transliteration": "si(n)mrit saasat bed beechaare ||",
      "translation": "One may contemplate the Simritees, Shaastras and Vedas,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਪੀਐ ਨਾਮੁ ਜਿਤੁ ਪਾਰਿ ਉਤਾਰੇ ॥੩॥",
      "transliteration": "japeeai naam jit paar utaare ||3||",
      "translation": "but only by chanting the Naam, the Name of the Lord, is one saved and carried across. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਕਉ ਪ੍ਰਭ ਕਿਰਪਾ ਕਰੀਐ ॥",
      "transliteration": "jan naanak kau prabh kirapaa kareeai ||",
      "translation": "Have Mercy upon servant Nanak, O God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਾਧੂ ਧੂਰਿ ਮਿਲੈ ਨਿਸਤਰੀਐ ॥੪॥੬॥੧੧॥",
      "transliteration": "saadhoo dhoor milai nisatareeai ||4||6||11||",
      "translation": "and bless him with the dust of the feet of the Holy, that he may be emancipated. ||4||6||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਰਿਦੇ ਮਹਿ ਚੀਨਾ ॥",
      "transliteration": "gur kaa sabad ride mahi cheenaa ||",
      "translation": "I contemplate the Word of the Guru's Shabad within my heart;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਗਲ ਮਨੋਰਥ ਪੂਰਨ ਆਸੀਨਾ ॥੧॥",
      "transliteration": "sagal manorath pooran aaseenaa ||1||",
      "translation": "all my hopes and desires are fulfilled. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਕਾ ਮੁਖੁ ਊਜਲੁ ਕੀਨਾ ॥",
      "transliteration": "sa(n)t janaa kaa mukh oojal keenaa ||",
      "translation": "The faces of the humble Saints are radiant and bright;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਅਪੁਨਾ ਨਾਮੁ ਦੀਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa apunaa naam deenaa ||1|| rahaau ||",
      "translation": "the Lord has mercifully blessed them with the Naam, the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅੰਧ ਕੂਪ ਤੇ ਕਰੁ ਗਹਿ ਲੀਨਾ ॥",
      "transliteration": "a(n)dh koop te kar gahi leenaa ||",
      "translation": "Holding them by the hand, He has lifted them up out of the deep, dark pit,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੈ ਜੈ ਕਾਰੁ ਜਗਤਿ ਪ੍ਰਗਟੀਨਾ ॥੨॥",
      "transliteration": "jai jai kaar jagat pragateenaa ||2||",
      "translation": "and their victory is celebrated throughout the world. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨੀਚਾ ਤੇ ਊਚ ਊਨ ਪੂਰੀਨਾ ॥",
      "transliteration": "neechaa te ooch oon pooreenaa ||",
      "translation": "He elevates and exalts the lowly, and fills the empty.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਮਹਾ ਰਸੁ ਲੀਨਾ ॥੩॥",
      "transliteration": "a(n)mrit naam mahaa ras leenaa ||3||",
      "translation": "They receive the supreme, sublime essence of the Ambrosial Naam. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮਨ ਤਨ ਨਿਰਮਲ ਪਾਪ ਜਲਿ ਖੀਨਾ ॥",
      "transliteration": "man tan niramal paap jal kheenaa ||",
      "translation": "The mind and body are made immaculate and pure, and sins are burnt to ashes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਪ੍ਰਭ ਭਏ ਪ੍ਰਸੀਨਾ ॥੪॥੭॥੧੨॥",
      "transliteration": "kahu naanak prabh bhae praseenaa ||4||7||12||",
      "translation": "Says Nanak, God is pleased with me. ||4||7||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0804_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਗਲ ਮਨੋਰਥ ਪਾਈਅਹਿ ਮੀਤਾ ॥",
      "transliteration": "sagal manorath paaeeahi meetaa ||",
      "translation": "All desires are fulfilled, O my friend,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 804,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
