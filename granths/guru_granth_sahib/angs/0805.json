{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 805,
  "lineCount": 51,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0805_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਸਿਉ ਲਾਈਐ ਚੀਤਾ ॥੧॥",
      "transliteration": "charan kamal siu laaeeai cheetaa ||1||",
      "translation": "lovingly centering your consciousness on the Lord's Lotus Feet. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਹਉ ਬਲਿਹਾਰੀ ਜੋ ਪ੍ਰਭੂ ਧਿਆਵਤ ॥",
      "transliteration": "hau balihaaree jo prabhoo dhiaavat ||",
      "translation": "I am a sacrifice to those who meditate on God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਲਨਿ ਬੁਝੈ ਹਰਿ ਹਰਿ ਗੁਨ ਗਾਵਤ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jalan bujhai har har gun gaavat ||1|| rahaau ||",
      "translation": "The fire of desire is quenched, singing the Glorious Praises of the Lord, Har, Har. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਫਲ ਜਨਮੁ ਹੋਵਤ ਵਡਭਾਗੀ ॥",
      "transliteration": "saphal janam hovat vadabhaagee ||",
      "translation": "One's life become fruitful and rewarding, by great good fortune.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਰਾਮਹਿ ਲਿਵ ਲਾਗੀ ॥੨॥",
      "transliteration": "saadhasa(n)g raamahi liv laagee ||2||",
      "translation": "In the Saadh Sangat, the Company of the Holy, enshrine love for the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਤਿ ਪਤਿ ਧਨੁ ਸੁਖ ਸਹਜ ਅਨੰਦਾ ॥",
      "transliteration": "mat pat dhan sukh sahaj ana(n)daa ||",
      "translation": "Wisdom, honor, wealth, peace and celestial bliss are attained,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਇਕ ਨਿਮਖ ਨ ਵਿਸਰਹੁ ਪਰਮਾਨੰਦਾ ॥੩॥",
      "transliteration": "ik nimakh na visarahu paramaana(n)daa ||3||",
      "translation": "If one does not forget the Lord of supreme bliss, even for an instant. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਰਿ ਦਰਸਨ ਕੀ ਮਨਿ ਪਿਆਸ ਘਨੇਰੀ ॥",
      "transliteration": "har darasan kee man piaas ghaneree ||",
      "translation": "My mind is so very thirsty for the Blessed Vision of the Lord's Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਨਤਿ ਨਾਨਕ ਸਰਣਿ ਪ੍ਰਭ ਤੇਰੀ ॥੪॥੮॥੧੩॥",
      "transliteration": "bhanat naanak saran prabh teree ||4||8||13||",
      "translation": "Prays Nanak, O God, I seek Your Sanctuary. ||4||8||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੋਹਿ ਨਿਰਗੁਨ ਸਭ ਗੁਣਹ ਬਿਹੂਨਾ ॥",
      "transliteration": "mohi niragun sabh gunah bihoonaa ||",
      "translation": "I am worthless, totally lacking all virtues.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦਇਆ ਧਾਰਿ ਅਪੁਨਾ ਕਰਿ ਲੀਨਾ ॥੧॥",
      "transliteration": "daiaa dhaar apunaa kar leenaa ||1||",
      "translation": "Bless me with Your Mercy, and make me Your Own. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮੇਰਾ ਮਨੁ ਤਨੁ ਹਰਿ ਗੋਪਾਲਿ ਸੁਹਾਇਆ ॥",
      "transliteration": "meraa man tan har gopaal suhaaiaa ||",
      "translation": "My mind and body are embellished by the Lord, the Lord of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭੁ ਘਰ ਮਹਿ ਆਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa prabh ghar mahi aaiaa ||1|| rahaau ||",
      "translation": "Granting His Mercy, God has come into the home of my heart. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਗਤਿ ਵਛਲ ਭੈ ਕਾਟਨਹਾਰੇ ॥",
      "transliteration": "bhagat vachhal bhai kaatanahaare ||",
      "translation": "He is the Lover and Protector of His devotees, the Destroyer of fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੰਸਾਰ ਸਾਗਰ ਅਬ ਉਤਰੇ ਪਾਰੇ ॥੨॥",
      "transliteration": "sa(n)saar saagar ab utare paare ||2||",
      "translation": "Now, I have been carried across the world-ocean. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪਤਿਤ ਪਾਵਨ ਪ੍ਰਭ ਬਿਰਦੁ ਬੇਦਿ ਲੇਖਿਆ ॥",
      "transliteration": "patit paavan prabh birad bed lekhiaa ||",
      "translation": "It is God's Way to purify sinners, say the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਸੋ ਨੈਨਹੁ ਪੇਖਿਆ ॥੩॥",
      "transliteration": "paarabraham so nainahu pekhiaa ||3||",
      "translation": "I have seen the Supreme Lord with my eyes. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਪ੍ਰਗਟੇ ਨਾਰਾਇਣ ॥",
      "transliteration": "saadhasa(n)g pragate naaraain ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, the Lord becomes manifest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਸਭਿ ਦੂਖ ਪਲਾਇਣ ॥੪॥੯॥੧੪॥",
      "transliteration": "naanak daas sabh dookh palaain ||4||9||14||",
      "translation": "O slave Nanak, all pains are relieved. ||4||9||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਵਨੁ ਜਾਨੈ ਪ੍ਰਭ ਤੁਮੑਰੀ ਸੇਵਾ ॥",
      "transliteration": "kavan jaanai prabh tumhree sevaa ||",
      "translation": "Who can know the value of serving You, God?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪ੍ਰਭ ਅਵਿਨਾਸੀ ਅਲਖ ਅਭੇਵਾ ॥੧॥",
      "transliteration": "prabh avinaasee alakh abhevaa ||1||",
      "translation": "God is imperishable, invisible and incomprehensible. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਣ ਬੇਅੰਤ ਪ੍ਰਭ ਗਹਿਰ ਗੰਭੀਰੇ ॥",
      "transliteration": "gun bea(n)t prabh gahir ga(n)bheere ||",
      "translation": "His Glorious Virtues are infinite; God is profound and unfathomable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਊਚ ਮਹਲ ਸੁਆਮੀ ਪ੍ਰਭ ਮੇਰੇ ॥",
      "transliteration": "ooch mahal suaamee prabh mere ||",
      "translation": "The Mansion of God, my Lord and Master, is lofty and high.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤੂ ਅਪਰੰਪਰ ਠਾਕੁਰ ਮੇਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "too apara(n)par thaakur mere ||1|| rahaau ||",
      "translation": "You are unlimited, O my Lord and Master. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਏਕਸ ਬਿਨੁ ਨਾਹੀ ਕੋ ਦੂਜਾ ॥",
      "transliteration": "ekas bin naahee ko doojaa ||",
      "translation": "There is no other than the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੁਮੑ ਹੀ ਜਾਨਹੁ ਅਪਨੀ ਪੂਜਾ ॥੨॥",
      "transliteration": "tumh hee jaanahu apanee poojaa ||2||",
      "translation": "You alone know Your worship and adoration. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਪਹੁ ਕਛੂ ਨ ਹੋਵਤ ਭਾਈ ॥",
      "transliteration": "aapahu kachhoo na hovat bhaaee ||",
      "translation": "No one can do anything by himself, O Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਸੁ ਪ੍ਰਭੁ ਦੇਵੈ ਸੋ ਨਾਮੁ ਪਾਈ ॥੩॥",
      "transliteration": "jis prabh devai so naam paaee ||3||",
      "translation": "He alone obtains the Naam, the Name of the Lord, unto whom God bestows it. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜੋ ਜਨੁ ਪ੍ਰਭ ਭਾਇਆ ॥",
      "transliteration": "kahu naanak jo jan prabh bhaaiaa ||",
      "translation": "Says Nanak, that humble being who pleases God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਣ ਨਿਧਾਨ ਪ੍ਰਭੁ ਤਿਨ ਹੀ ਪਾਇਆ ॥੪॥੧੦॥੧੫॥",
      "transliteration": "gun nidhaan prabh tin hee paaiaa ||4||10||15||",
      "translation": "he alone finds God, the treasure of virtue. ||4||10||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਾਤ ਗਰਭ ਮਹਿ ਹਾਥ ਦੇ ਰਾਖਿਆ ॥",
      "transliteration": "maat garabh mahi haath de raakhiaa ||",
      "translation": "Extending His Hand, the Lord protected you in your mother's womb.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਰਿ ਰਸੁ ਛੋਡਿ ਬਿਖਿਆ ਫਲੁ ਚਾਖਿਆ ॥੧॥",
      "transliteration": "har ras chhod bikhiaa phal chaakhiaa ||1||",
      "translation": "Renouncing the sublime essence of the Lord, you have tasted the fruit of poison. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਜੁ ਗੋਬਿਦ ਸਭ ਛੋਡਿ ਜੰਜਾਲ ॥",
      "transliteration": "bhaj gobid sabh chhod ja(n)jaal ||",
      "translation": "Meditate, vibrate on the Lord of the Universe, and renounce all entanglements.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਬ ਜਮੁ ਆਇ ਸੰਘਾਰੈ ਮੂੜੇ ਤਬ ਤਨੁ ਬਿਨਸਿ ਜਾਇ ਬੇਹਾਲ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jab jam aai sa(n)ghaarai mooRe tab tan binas jaai behaal ||1|| rahaau ||",
      "translation": "When the Messenger of Death comes to murder you, O fool, then your body will be shattered and helplessly crumble. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਧਨੁ ਅਪਨਾ ਕਰਿ ਥਾਪਿਆ ॥",
      "transliteration": "tan man dhan apanaa kar thaapiaa ||",
      "translation": "You hold onto your body, mind and wealth as your own,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਰਨਹਾਰੁ ਇਕ ਨਿਮਖ ਨ ਜਾਪਿਆ ॥੨॥",
      "transliteration": "karanahaar ik nimakh na jaapiaa ||2||",
      "translation": "and you do not meditate on the Creator Lord, even for an instant. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਹਾ ਮੋਹ ਅੰਧ ਕੂਪ ਪਰਿਆ ॥",
      "transliteration": "mahaa moh a(n)dh koop pariaa ||",
      "translation": "You have fallen into the deep, dark pit of great attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਮਾਇਆ ਪਟਲਿ ਬਿਸਰਿਆ ॥੩॥",
      "transliteration": "paarabraham maaiaa patal bisariaa ||3||",
      "translation": "Caught in the illusion of Maya, you have forgotten the Supreme Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਵਡੈ ਭਾਗਿ ਪ੍ਰਭ ਕੀਰਤਨੁ ਗਾਇਆ ॥",
      "transliteration": "vadai bhaag prabh keeratan gaaiaa ||",
      "translation": "By great good fortune, one sings the Kirtan of God's Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੰਤਸੰਗਿ ਨਾਨਕ ਪ੍ਰਭੁ ਪਾਇਆ ॥੪॥੧੧॥੧੬॥",
      "transliteration": "sa(n)tasa(n)g naanak prabh paaiaa ||4||11||16||",
      "translation": "In the Society of the Saints, Nanak has found God. ||4||11||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਸੁਤ ਬੰਧਪ ਭਾਈ ॥",
      "transliteration": "maat pitaa sut ba(n)dhap bhaaee ||",
      "translation": "Mother, father, children, relatives and siblings",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕ ਹੋਆ ਪਾਰਬ੍ਰਹਮੁ ਸਹਾਈ ॥੧॥",
      "transliteration": "naanak hoaa paarabraham sahaaee ||1||",
      "translation": "- O Nanak, the Supreme Lord is our help and support. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਆਨੰਦ ਘਣੇ ॥",
      "transliteration": "sookh sahaj aana(n)d ghane ||",
      "translation": "He blesses us with peace, and abundant celestial bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੁਰੁ ਪੂਰਾ ਪੂਰੀ ਜਾ ਕੀ ਬਾਣੀ ਅਨਿਕ ਗੁਣਾ ਜਾ ਕੇ ਜਾਹਿ ਨ ਗਣੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur pooraa pooree jaa kee baanee anik gunaa jaa ke jaahi na gane ||1|| rahaau ||",
      "translation": "Perfect is the Bani, the Word of the Perfect Guru. His Virtues are so many, they cannot be counted. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਗਲ ਸਰੰਜਾਮ ਕਰੇ ਪ੍ਰਭੁ ਆਪੇ ॥",
      "transliteration": "sagal sara(n)jaam kare prabh aape ||",
      "translation": "God Himself makes all arrangements.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਭਏ ਮਨੋਰਥ ਸੋ ਪ੍ਰਭੁ ਜਾਪੇ ॥੨॥",
      "transliteration": "bhae manorath so prabh jaape ||2||",
      "translation": "Meditating on God, desires are fulfilled. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0805_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਰਥ ਧਰਮ ਕਾਮ ਮੋਖ ਕਾ ਦਾਤਾ ॥",
      "transliteration": "arath dharam kaam mokh kaa daataa ||",
      "translation": "He is the Giver of wealth, Dharmic faith, pleasure and liberation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 805,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
