{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 806,
  "lineCount": 46,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0806_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪੂਰੀ ਭਈ ਸਿਮਰਿ ਸਿਮਰਿ ਬਿਧਾਤਾ ॥੩॥",
      "transliteration": "pooree bhaee simar simar bidhaataa ||3||",
      "translation": "Meditating, meditating in remembrance on the Creator Lord, the Architect of Destiny, I am fulfilled. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਨਾਨਕਿ ਰੰਗੁ ਮਾਣਿਆ ॥",
      "transliteration": "saadhasa(n)g naanak ra(n)g maaniaa ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, Nanak enjoys the Lord's Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਘਰਿ ਆਇਆ ਪੂਰੈ ਗੁਰਿ ਆਣਿਆ ॥੪॥੧੨॥੧੭॥",
      "transliteration": "ghar aaiaa poorai gur aaniaa ||4||12||17||",
      "translation": "He has returned home, with the Perfect Guru. ||4||12||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸ੍ਰਬ ਨਿਧਾਨ ਪੂਰਨ ਗੁਰਦੇਵ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "srab nidhaan pooran guradev ||1|| rahaau ||",
      "translation": "All treasures come from the Perfect Divine Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਪਤ ਨਰ ਜੀਵੇ ॥",
      "transliteration": "har har naam japat nar jeeve ||",
      "translation": "Chanting the Name of the Lord, Har, Har, the man lives.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਰਿ ਖੁਆਰੁ ਸਾਕਤ ਨਰ ਥੀਵੇ ॥੧॥",
      "transliteration": "mar khuaar saakat nar theeve ||1||",
      "translation": "The faithless cynic dies in shame and misery. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਹੋਆ ਰਖਵਾਰਾ ॥",
      "transliteration": "raam naam hoaa rakhavaaraa ||",
      "translation": "The Name of the Lord has become my Protector.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਝਖ ਮਾਰਉ ਸਾਕਤੁ ਵੇਚਾਰਾ ॥੨॥",
      "transliteration": "jhakh maarau saakat vechaaraa ||2||",
      "translation": "The wretched, faithless cynic makes only useless efforts. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਿੰਦਾ ਕਰਿ ਕਰਿ ਪਚਹਿ ਘਨੇਰੇ ॥",
      "transliteration": "ni(n)daa kar kar pachahi ghanere ||",
      "translation": "Spreading slander, many have been ruined.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਿਰਤਕ ਫਾਸ ਗਲੈ ਸਿਰਿ ਪੈਰੇ ॥੩॥",
      "transliteration": "miratak phaas galai sir paire ||3||",
      "translation": "Their necks, heads and feet are tied by death's noose. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਪਹਿ ਜਨ ਨਾਮ ॥",
      "transliteration": "kahu naanak japahi jan naam ||",
      "translation": "Says Nanak, the humble devotees chant the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਾ ਕੇ ਨਿਕਟਿ ਨ ਆਵੈ ਜਾਮ ॥੪॥੧੩॥੧੮॥",
      "transliteration": "taa ke nikat na aavai jaam ||4||13||18||",
      "translation": "The Messenger of Death does not even approach them. ||4||13||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਗੁ ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ਘਰੁ ੪ ਦੁਪਦੇ ॥",
      "transliteration": "raag bilaaval mahalaa 5 ghar 4 dupade ||",
      "translation": "Raag Bilaaval, Fifth Mehl, Fourth House, Dho-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਵਨ ਸੰਜੋਗ ਮਿਲਉ ਪ੍ਰਭ ਅਪਨੇ ॥",
      "transliteration": "kavan sa(n)jog milau prabh apane ||",
      "translation": "What blessed destiny will lead me to meet my God?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪਲੁ ਪਲੁ ਨਿਮਖ ਸਦਾ ਹਰਿ ਜਪਨੇ ॥੧॥",
      "transliteration": "pal pal nimakh sadaa har japane ||1||",
      "translation": "Each and every moment and instant, I continually meditate on the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਪ੍ਰਭ ਕੇ ਨਿਤ ਧਿਆਵਉ ॥",
      "transliteration": "charan kamal prabh ke nit dhiaavau ||",
      "translation": "I meditate continually on the Lotus Feet of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਵਨ ਸੁ ਮਤਿ ਜਿਤੁ ਪ੍ਰੀਤਮੁ ਪਾਵਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kavan s mat jit preetam paavau ||1|| rahaau ||",
      "translation": "What wisdom will lead me to attain my Beloved? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਐਸੀ ਕ੍ਰਿਪਾ ਕਰਹੁ ਪ੍ਰਭ ਮੇਰੇ ॥",
      "transliteration": "aisee kripaa karahu prabh mere ||",
      "translation": "Please, bless me with such Mercy, O my God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਰਿ ਨਾਨਕ ਬਿਸਰੁ ਨ ਕਾਹੂ ਬੇਰੇ ॥੨॥੧॥੧੯॥",
      "transliteration": "har naanak bisar na kaahoo bere ||2||1||19||",
      "translation": "that Nanak may never, ever forget You. ||2||1||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਪ੍ਰਭ ਹਿਰਦੈ ਧਿਆਏ ॥",
      "transliteration": "charan kamal prabh hiradai dhiaae ||",
      "translation": "Within my heart, I meditate on the Lotus Feet of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰੋਗ ਗਏ ਸਗਲੇ ਸੁਖ ਪਾਏ ॥੧॥",
      "transliteration": "rog gae sagale sukh paae ||1||",
      "translation": "Disease is gone, and I have found total peace. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰਿ ਦੁਖੁ ਕਾਟਿਆ ਦੀਨੋ ਦਾਨੁ ॥",
      "transliteration": "gur dukh kaatiaa deeno daan ||",
      "translation": "The Guru relieved my sufferings, and blessed me with the gift.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਫਲ ਜਨਮੁ ਜੀਵਨ ਪਰਵਾਨੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saphal janam jeevan paravaan ||1|| rahaau ||",
      "translation": "My birth has been rendered fruitful, and my life is approved. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਕਥ ਕਥਾ ਅੰਮ੍ਰਿਤ ਪ੍ਰਭ ਬਾਨੀ ॥",
      "transliteration": "akath kathaa a(n)mrit prabh baanee ||",
      "translation": "The Ambrosial Bani of God's Word is the Unspoken Speech.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਪਿ ਜੀਵੇ ਗਿਆਨੀ ॥੨॥੨॥੨੦॥",
      "transliteration": "kahu naanak jap jeeve giaanee ||2||2||20||",
      "translation": "Says Nanak, the spiritually wise live by meditating on God. ||2||2||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਂਤਿ ਪਾਈ ਗੁਰਿ ਸਤਿਗੁਰਿ ਪੂਰੇ ॥",
      "transliteration": "saa(n)t paaee gur satigur poore ||",
      "translation": "The Guru, the Perfect True Guru, has blessed me with peace and tranquility.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੁਖ ਉਪਜੇ ਬਾਜੇ ਅਨਹਦ ਤੂਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sukh upaje baaje anahad toore ||1|| rahaau ||",
      "translation": "Peace and joy have welled up, and the mystical trumpets of the unstruck sound current vibrate. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾਪ ਪਾਪ ਸੰਤਾਪ ਬਿਨਾਸੇ ॥",
      "transliteration": "taap paap sa(n)taap binaase ||",
      "translation": "Sufferings, sins and afflictions have been dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਕਿਲਵਿਖ ਸਭਿ ਨਾਸੇ ॥੧॥",
      "transliteration": "har simarat kilavikh sabh naase ||1||",
      "translation": "Remembering the Lord in meditation, all sinful mistakes have been erased. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਨਦੁ ਕਰਹੁ ਮਿਲਿ ਸੁੰਦਰ ਨਾਰੀ ॥",
      "transliteration": "anad karahu mil su(n)dar naaree ||",
      "translation": "Joining together, O beautiful soul-brides, celebrate and make merry.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰਿ ਨਾਨਕਿ ਮੇਰੀ ਪੈਜ ਸਵਾਰੀ ॥੨॥੩॥੨੧॥",
      "transliteration": "gur naanak meree paij savaaree ||2||3||21||",
      "translation": "Guru Nanak has saved my honor. ||2||3||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮਮਤਾ ਮੋਹ ਧ੍ਰੋਹ ਮਦਿ ਮਾਤਾ ਬੰਧਨਿ ਬਾਧਿਆ ਅਤਿ ਬਿਕਰਾਲ ॥",
      "transliteration": "mamataa moh dhroh mad maataa ba(n)dhan baadhiaa at bikaraal ||",
      "translation": "Intoxicated with the wine of attachment, love of worldly possessions and deceit, and bound in bondage, he is wild and hideous.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦਿਨੁ ਦਿਨੁ ਛਿਜਤ ਬਿਕਾਰ ਕਰਤ ਅਉਧ ਫਾਹੀ ਫਾਥਾ ਜਮ ਕੈ ਜਾਲ ॥੧॥",
      "transliteration": "din din chhijat bikaar karat audh phaahee phaathaa jam kai jaal ||1||",
      "translation": "Day by day, his life is winding down; practicing sin and corruption, he is trapped by the noose of Death. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੇਰੀ ਸਰਣਿ ਪ੍ਰਭ ਦੀਨ ਦਇਆਲਾ ॥",
      "transliteration": "teree saran prabh deen daiaalaa ||",
      "translation": "I seek Your Sanctuary, O God, Merciful to the meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਹਾ ਬਿਖਮ ਸਾਗਰੁ ਅਤਿ ਭਾਰੀ ਉਧਰਹੁ ਸਾਧੂ ਸੰਗਿ ਰਵਾਲਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mahaa bikham saagar at bhaaree udharahu saadhoo sa(n)g ravaalaa ||1|| rahaau ||",
      "translation": "I have crossed over the terrible, treacherous, enormous world-ocean, with the dust of the Saadh Sangat, the Company of the Holy. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰਭ ਸੁਖਦਾਤੇ ਸਮਰਥ ਸੁਆਮੀ ਜੀਉ ਪਿੰਡੁ ਸਭੁ ਤੁਮਰਾ ਮਾਲ ॥",
      "transliteration": "prabh sukhadaate samarath suaamee jeeu pi(n)d sabh tumaraa maal ||",
      "translation": "O God, Giver of peace, All-powerful Lord and Master, my soul, body and all wealth are Yours.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭ੍ਰਮ ਕੇ ਬੰਧਨ ਕਾਟਹੁ ਪਰਮੇਸਰ ਨਾਨਕ ਕੇ ਪ੍ਰਭ ਸਦਾ ਕ੍ਰਿਪਾਲ ॥੨॥੪॥੨੨॥",
      "transliteration": "bhram ke ba(n)dhan kaatahu paramesar naanak ke prabh sadaa kripaal ||2||4||22||",
      "translation": "Please, break my bonds of doubt, O Transcendent Lord, forever Merciful God of Nanak. ||2||4||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਗਲ ਅਨੰਦੁ ਕੀਆ ਪਰਮੇਸਰਿ ਅਪਣਾ ਬਿਰਦੁ ਸਮੑਾਰਿਆ ॥",
      "transliteration": "sagal ana(n)d keeaa paramesar apanaa birad samhaariaa ||",
      "translation": "The Transcendent Lord has brought bliss to all; He has confirmed His Natural Way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਾਧ ਜਨਾ ਹੋਏ ਕਿਰਪਾਲਾ ਬਿਗਸੇ ਸਭਿ ਪਰਵਾਰਿਆ ॥੧॥",
      "transliteration": "saadh janaa hoe kirapaalaa bigase sabh paravaariaa ||1||",
      "translation": "He has become Merciful to the humble, holy Saints, and all my relatives blossom forth in joy. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0806_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਾਰਜੁ ਸਤਿਗੁਰਿ ਆਪਿ ਸਵਾਰਿਆ ॥",
      "transliteration": "kaaraj satigur aap savaariaa ||",
      "translation": "The True Guru Himself has resolved my affairs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 806,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
