{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 832,
  "lineCount": 51,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0832_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੧ ॥",
      "transliteration": "bilaaval mahalaa 1 ||",
      "translation": "Bilaaval, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਨ ਕਾ ਕਹਿਆ ਮਨਸਾ ਕਰੈ ॥",
      "transliteration": "man kaa kahiaa manasaa karai ||",
      "translation": "The human acts according to the wishes of the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਪੁੰਨੁ ਪਾਪੁ ਉਚਰੈ ॥",
      "transliteration": "ihu man pu(n)n paap ucharai ||",
      "translation": "This mind feeds on virtue and vice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਾਇਆ ਮਦਿ ਮਾਤੇ ਤ੍ਰਿਪਤਿ ਨ ਆਵੈ ॥",
      "transliteration": "maaiaa mad maate tripat na aavai ||",
      "translation": "Intoxicated with the wine of Maya, satisfaction never comes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤ੍ਰਿਪਤਿ ਮੁਕਤਿ ਮਨਿ ਸਾਚਾ ਭਾਵੈ ॥੧॥",
      "transliteration": "tripat mukat man saachaa bhaavai ||1||",
      "translation": "Satisfaction and liberation come, only to one whose mind is pleasing to the True Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਨੁ ਧਨੁ ਕਲਤੁ ਸਭੁ ਦੇਖੁ ਅਭਿਮਾਨਾ ॥",
      "transliteration": "tan dhan kalat sabh dekh abhimaanaa ||",
      "translation": "Gazing upon his body, wealth, wife and all his possessions, he is proud.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਕਿਛੁ ਸੰਗਿ ਨ ਜਾਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin naavai kichh sa(n)g na jaanaa ||1|| rahaau ||",
      "translation": "But without the Name of the Lord, nothing shall go along with him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕੀਚਹਿ ਰਸ ਭੋਗ ਖੁਸੀਆ ਮਨ ਕੇਰੀ ॥",
      "transliteration": "keechahi ras bhog khuseeaa man keree ||",
      "translation": "He enjoys tastes, pleasures and joys in his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਧਨੁ ਲੋਕਾਂ ਤਨੁ ਭਸਮੈ ਢੇਰੀ ॥",
      "transliteration": "dhan lokaa(n) tan bhasamai dheree ||",
      "translation": "But his wealth will pass on to other people, and his body will be reduced to ashes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਖਾਕੂ ਖਾਕੁ ਰਲੈ ਸਭੁ ਫੈਲੁ ॥",
      "transliteration": "khaakoo khaak ralai sabh phail ||",
      "translation": "The entire expanse, like dust, shall mix with dust.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਨੁ ਸਬਦੈ ਨਹੀ ਉਤਰੈ ਮੈਲੁ ॥੨॥",
      "transliteration": "bin sabadai nahee utarai mail ||2||",
      "translation": "Without the Word of the Shabad, his filth is not removed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੀਤ ਰਾਗ ਘਨ ਤਾਲ ਸਿ ਕੂਰੇ ॥",
      "transliteration": "geet raag ghan taal s koore ||",
      "translation": "The various songs, tunes and rhythms are false.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤ੍ਰਿਹੁ ਗੁਣ ਉਪਜੈ ਬਿਨਸੈ ਦੂਰੇ ॥",
      "transliteration": "trihu gun upajai binasai doore ||",
      "translation": "Trapped by the three qualities, people come and go, far from the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੂਜੀ ਦੁਰਮਤਿ ਦਰਦੁ ਨ ਜਾਇ ॥",
      "transliteration": "doojee duramat darad na jaai ||",
      "translation": "In duality, the pain of their evil-mindedness does not leave them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਛੂਟੈ ਗੁਰਮੁਖਿ ਦਾਰੂ ਗੁਣ ਗਾਇ ॥੩॥",
      "transliteration": "chhootai guramukh daaroo gun gaai ||3||",
      "translation": "But the Gurmukh is emancipated by taking the medicine, and singing the Glorious Praises of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਧੋਤੀ ਊਜਲ ਤਿਲਕੁ ਗਲਿ ਮਾਲਾ ॥",
      "transliteration": "dhotee oojal tilak gal maalaa ||",
      "translation": "He may wear a clean loin-cloth, apply the ceremonial mark to his forehead, and wear a mala around his neck;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅੰਤਰਿ ਕ੍ਰੋਧੁ ਪੜਹਿ ਨਾਟ ਸਾਲਾ ॥",
      "transliteration": "a(n)tar krodh paRahi naat saalaa ||",
      "translation": "but if there is anger within him, he is merely reading his part, like an actor in a play.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮੁ ਵਿਸਾਰਿ ਮਾਇਆ ਮਦੁ ਪੀਆ ॥",
      "transliteration": "naam visaar maaiaa mad peeaa ||",
      "translation": "Forgetting the Naam, the Name of the Lord, he drinks in the wine of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਭਗਤਿ ਨਾਹੀ ਸੁਖੁ ਥੀਆ ॥੪॥",
      "transliteration": "bin gur bhagat naahee sukh theeaa ||4||",
      "translation": "Without devotional worship to the Guru, there is no peace. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੂਕਰ ਸੁਆਨ ਗਰਧਭ ਮੰਜਾਰਾ ॥",
      "transliteration": "sookar suaan garadhabh ma(n)jaaraa ||",
      "translation": "The human is a pig, a dog, a donkey, a cat,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਸੂ ਮਲੇਛ ਨੀਚ ਚੰਡਾਲਾ ॥",
      "transliteration": "pasoo malechh neech cha(n)daalaa ||",
      "translation": "a beast, a filthy, lowly wretch, an outcast,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰ ਤੇ ਮੁਹੁ ਫੇਰੇ ਤਿਨੑ ਜੋਨਿ ਭਵਾਈਐ ॥",
      "transliteration": "gur te muhu phere tinh jon bhavaaeeai ||",
      "translation": "if he turns his face away from the Guru. He shall wander in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬੰਧਨਿ ਬਾਧਿਆ ਆਈਐ ਜਾਈਐ ॥੫॥",
      "transliteration": "ba(n)dhan baadhiaa aaeeai jaaeeai ||5||",
      "translation": "Bound in bondage, he comes and goes. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਰ ਸੇਵਾ ਤੇ ਲਹੈ ਪਦਾਰਥੁ ॥",
      "transliteration": "gur sevaa te lahai padaarath ||",
      "translation": "Serving the Guru, the treasure is found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਿਰਦੈ ਨਾਮੁ ਸਦਾ ਕਿਰਤਾਰਥੁ ॥",
      "transliteration": "hiradai naam sadaa kirataarath ||",
      "translation": "With the Naam in the heart, one always prospers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਾਚੀ ਦਰਗਹ ਪੂਛ ਨ ਹੋਇ ॥",
      "transliteration": "saachee daragah poochh na hoi ||",
      "translation": "And in the Court of the True Lord, you shall not called to account.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਾਨੇ ਹੁਕਮੁ ਸੀਝੈ ਦਰਿ ਸੋਇ ॥੬॥",
      "transliteration": "maane hukam seejhai dar soi ||6||",
      "translation": "One who obeys the Hukam of the Lord's Command, is approved at the Lord's Door. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮਿਲੈ ਤ ਤਿਸ ਕਉ ਜਾਣੈ ॥",
      "transliteration": "satigur milai ta tis kau jaanai ||",
      "translation": "Meeting the True Guru, one knows the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਹੈ ਰਜਾਈ ਹੁਕਮੁ ਪਛਾਣੈ ॥",
      "transliteration": "rahai rajaaee hukam pachhaanai ||",
      "translation": "Understanding the Hukam of His Command, one acts according to His Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹੁਕਮੁ ਪਛਾਣਿ ਸਚੈ ਦਰਿ ਵਾਸੁ ॥",
      "transliteration": "hukam pachhaan sachai dar vaas ||",
      "translation": "Understanding the Hukam of His Command, he dwells in the Court of the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਾਲ ਬਿਕਾਲ ਸਬਦਿ ਭਏ ਨਾਸੁ ॥੭॥",
      "transliteration": "kaal bikaal sabad bhae naas ||7||",
      "translation": "Through the Shabad, death and birth are ended. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰਹੈ ਅਤੀਤੁ ਜਾਣੈ ਸਭੁ ਤਿਸ ਕਾ ॥",
      "transliteration": "rahai ateet jaanai sabh tis kaa ||",
      "translation": "He remains detached, knowing that everything belongs to God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਅਰਪੈ ਹੈ ਇਹੁ ਜਿਸ ਕਾ ॥",
      "transliteration": "tan man arapai hai ihu jis kaa ||",
      "translation": "He dedicates his body and mind unto the One who owns them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾ ਓਹੁ ਆਵੈ ਨਾ ਓਹੁ ਜਾਇ ॥",
      "transliteration": "naa ohu aavai naa ohu jaai ||",
      "translation": "He does not come, and he does not go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕ ਸਾਚੇ ਸਾਚਿ ਸਮਾਇ ॥੮॥੨॥",
      "transliteration": "naanak saache saach samaai ||8||2||",
      "translation": "O Nanak, absorbed in Truth, he merges in the True Lord. ||8||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੩ ਅਸਟਪਦੀ ਘਰੁ ੧੦ ॥",
      "transliteration": "bilaaval mahalaa 3 asatapadee ghar 10 ||",
      "translation": "Bilaaval, Third Mehl, Ashtpadheeyaa, Tenth House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਗੁ ਕਊਆ ਮੁਖਿ ਚੁੰਚ ਗਿਆਨੁ ॥",
      "transliteration": "jag kaooaa mukh chu(n)ch giaan ||",
      "translation": "The world is like a crow; with its beak, it croaks spiritual wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅੰਤਰਿ ਲੋਭੁ ਝੂਠੁ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "a(n)tar lobh jhooth abhimaan ||",
      "translation": "But deep within there is greed, falsehood and pride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਪਾਜੁ ਲਹਗੁ ਨਿਦਾਨਿ ॥੧॥",
      "transliteration": "bin naavai paaj lahag nidaan ||1||",
      "translation": "Without the Name of the Lord, your thin outer covering shall wear off, you fool. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਤਿਗੁਰ ਸੇਵਿ ਨਾਮੁ ਵਸੈ ਮਨਿ ਚੀਤਿ ॥",
      "transliteration": "satigur sev naam vasai man cheet ||",
      "translation": "Serving the True Guru, the Naam shall dwell in your conscious mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰੁ ਭੇਟੇ ਹਰਿ ਨਾਮੁ ਚੇਤਾਵੈ ਬਿਨੁ ਨਾਵੈ ਹੋਰ ਝੂਠੁ ਪਰੀਤਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur bhete har naam chetaavai bin naavai hor jhooth pareet ||1|| rahaau ||",
      "translation": "Meeting with the Guru, the Name of the Lord comes to mind. Without the Name, other loves are false. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੁਰਿ ਕਹਿਆ ਸਾ ਕਾਰ ਕਮਾਵਹੁ ॥",
      "transliteration": "gur kahiaa saa kaar kamaavahu ||",
      "translation": "So do that work, which the Guru tells you to do.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਬਦੁ ਚੀਨੑਿ ਸਹਜ ਘਰਿ ਆਵਹੁ ॥",
      "transliteration": "sabad cheenhi sahaj ghar aavahu ||",
      "translation": "Contemplating the Word of the Shabad, you shall come to the home of celestial bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਾਚੈ ਨਾਇ ਵਡਾਈ ਪਾਵਹੁ ॥੨॥",
      "transliteration": "saachai naai vadaaee paavahu ||2||",
      "translation": "Through the True Name, you shall obtain glorious greatness. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਪਿ ਨ ਬੂਝੈ ਲੋਕ ਬੁਝਾਵੈ ॥",
      "transliteration": "aap na boojhai lok bujhaavai ||",
      "translation": "One who does not understand his own self, but still tries to instruct others,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਨ ਕਾ ਅੰਧਾ ਅੰਧੁ ਕਮਾਵੈ ॥",
      "transliteration": "man kaa a(n)dhaa a(n)dh kamaavai ||",
      "translation": "is mentally blind, and acts in blindness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦਰੁ ਘਰੁ ਮਹਲੁ ਠਉਰੁ ਕੈਸੇ ਪਾਵੈ ॥੩॥",
      "transliteration": "dar ghar mahal thaur kaise paavai ||3||",
      "translation": "How can he ever find a home and a place of rest, in the Mansion of the Lord's Presence? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹਰਿ ਜੀਉ ਸੇਵੀਐ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "har jeeu seveeai a(n)tarajaamee ||",
      "translation": "Serve the Dear Lord, the Inner-knower, the Searcher of hearts;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਘਟ ਘਟ ਅੰਤਰਿ ਜਿਸ ਕੀ ਜੋਤਿ ਸਮਾਨੀ ॥",
      "transliteration": "ghat ghat a(n)tar jis kee jot samaanee ||",
      "translation": "deep within each and every heart, His Light is shining forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0832_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤਿਸੁ ਨਾਲਿ ਕਿਆ ਚਲੈ ਪਹਨਾਮੀ ॥੪॥",
      "transliteration": "tis naal kiaa chalai pahanaamee ||4||",
      "translation": "How can anyone hide anything from Him? ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 832,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
