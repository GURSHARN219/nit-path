{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 837,
  "lineCount": 49,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0837_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੇਜ ਏਕ ਏਕੋ ਪ੍ਰਭੁ ਠਾਕੁਰੁ ਮਹਲੁ ਨ ਪਾਵੈ ਮਨਮੁਖ ਭਰਮਈਆ ॥",
      "transliteration": "sej ek eko prabh thaakur mahal na paavai manamukh bharamaeeaa ||",
      "translation": "There is one bed for the soul-bride, and the same bed for God, her Lord and Master. The self-willed manmukh does not obtain the Mansion of the Lord's Presence; she wanders around, in limbo.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਰੁ ਗੁਰੁ ਕਰਤ ਸਰਣਿ ਜੇ ਆਵੈ ਪ੍ਰਭੁ ਆਇ ਮਿਲੈ ਖਿਨੁ ਢੀਲ ਨ ਪਈਆ ॥੫॥",
      "transliteration": "gur gur karat saran je aavai prabh aai milai khin dheel na paeeaa ||5||",
      "translation": "Uttering, \"Guru, Guru\", she seeks His Sanctuary; so God comes to meet her, without a moment's delay. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਰਿ ਕਰਿ ਕਿਰਿਆਚਾਰ ਵਧਾਏ ਮਨਿ ਪਾਖੰਡ ਕਰਮੁ ਕਪਟ ਲੋਭਈਆ ॥",
      "transliteration": "kar kar kiriaachaar vadhaae man paakha(n)d karam kapat lobhaeeaa ||",
      "translation": "One may perform many rituals, but the mind is filled with hypocrisy, evil deeds and greed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬੇਸੁਆ ਕੈ ਘਰਿ ਬੇਟਾ ਜਨਮਿਆ ਪਿਤਾ ਤਾਹਿ ਕਿਆ ਨਾਮੁ ਸਦਈਆ ॥੬॥",
      "transliteration": "besuaa kai ghar betaa janamiaa pitaa taahi kiaa naam sadaeeaa ||6||",
      "translation": "When a son is born in the house of a prostitute, who can tell the name of his father? ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪੂਰਬ ਜਨਮਿ ਭਗਤਿ ਕਰਿ ਆਏ ਗੁਰਿ ਹਰਿ ਹਰਿ ਹਰਿ ਹਰਿ ਭਗਤਿ ਜਮਈਆ ॥",
      "transliteration": "poorab janam bhagat kar aae gur har har har har bhagat jamaeeaa ||",
      "translation": "Because of devotional worship in my past incarnations, I have been born into this life. The Guru has inspired me to worship the Lord, Har, Har, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭਗਤਿ ਭਗਤਿ ਕਰਤੇ ਹਰਿ ਪਾਇਆ ਜਾ ਹਰਿ ਹਰਿ ਹਰਿ ਹਰਿ ਨਾਮਿ ਸਮਈਆ ॥੭॥",
      "transliteration": "bhagat bhagat karate har paaiaa jaa har har har har naam samaeeaa ||7||",
      "translation": "Worshipping, worshipping Him with devotion, I found the Lord, and then I merged into the Name of the Lord, Har, Har, Har, Har. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪ੍ਰਭਿ ਆਣਿ ਆਣਿ ਮਹਿੰਦੀ ਪੀਸਾਈ ਆਪੇ ਘੋਲਿ ਘੋਲਿ ਅੰਗਿ ਲਈਆ ॥",
      "transliteration": "prabh aan aan mahi(n)dee peesaaee aape ghol ghol a(n)g laeeaa ||",
      "translation": "God Himself came and ground the henna leaves into powder, and applied it to my body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਨ ਕਉ ਠਾਕੁਰਿ ਕਿਰਪਾ ਧਾਰੀ ਬਾਹ ਪਕਰਿ ਨਾਨਕ ਕਢਿ ਲਈਆ ॥੮॥੬॥੨॥੧॥੬॥੯॥",
      "transliteration": "jin kau thaakur kirapaa dhaaree baah pakar naanak kadh laeeaa ||8||6||2||1||6||9||",
      "translation": "Our Lord and Master showers His Mercy upon us, and grasps hold of our arms; O Nanak, He lifts us up and saves us. ||8||6||9||2||1||6||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਾਗੁ ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ਅਸਟਪਦੀ ਘਰੁ ੧੨ ॥",
      "transliteration": "raag bilaaval mahalaa 5 asatapadee ghar 12 ||",
      "translation": "Raag Bilaaval, Fifth Mehl, Ashtpadheeyaa, Twelfth House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਉਪਮਾ ਜਾਤ ਨ ਕਹੀ ਮੇਰੇ ਪ੍ਰਭ ਕੀ ਉਪਮਾ ਜਾਤ ਨ ਕਹੀ ॥",
      "transliteration": "upamaa jaat na kahee mere prabh kee upamaa jaat na kahee ||",
      "translation": "I cannot express the Praises of my God; I cannot express His Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਜਿ ਆਨ ਸਰਣਿ ਗਹੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "taj aan saran gahee ||1|| rahaau ||",
      "translation": "I have abandoned all others, seeking His Sanctuary. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪ੍ਰਭ ਚਰਨ ਕਮਲ ਅਪਾਰ ॥",
      "transliteration": "prabh charan kamal apaar ||",
      "translation": "God's Lotus Feet are Infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਉ ਜਾਉ ਸਦ ਬਲਿਹਾਰ ॥",
      "transliteration": "hau jaau sad balihaar ||",
      "translation": "I am forever a sacrifice to Them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਨਿ ਪ੍ਰੀਤਿ ਲਾਗੀ ਤਾਹਿ ॥",
      "transliteration": "man preet laagee taahi ||",
      "translation": "My mind is in love with Them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਜਿ ਆਨ ਕਤਹਿ ਨ ਜਾਹਿ ॥੧॥",
      "transliteration": "taj aan katahi na jaahi ||1||",
      "translation": "If I were to abandon Them, there is nowhere else I could go. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰਿ ਨਾਮ ਰਸਨਾ ਕਹਨ ॥",
      "transliteration": "har naam rasanaa kahan ||",
      "translation": "I chant the Lord's Name with my tongue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਲ ਪਾਪ ਕਲਮਲ ਦਹਨ ॥",
      "transliteration": "mal paap kalamal dahan ||",
      "translation": "The filth of my sins and evil mistakes is burnt off.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੜਿ ਨਾਵ ਸੰਤ ਉਧਾਰਿ ॥",
      "transliteration": "chaR naav sa(n)t udhaar ||",
      "translation": "Climbing aboard the Boat of the Saints, I am emancipated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭੈ ਤਰੇ ਸਾਗਰ ਪਾਰਿ ॥੨॥",
      "transliteration": "bhai tare saagar paar ||2||",
      "translation": "I have been carried across the terrifying world-ocean. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਨਿ ਡੋਰਿ ਪ੍ਰੇਮ ਪਰੀਤਿ ॥",
      "transliteration": "man dor prem pareet ||",
      "translation": "My mind is tied to the Lord with the string of love and devotion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਹ ਸੰਤ ਨਿਰਮਲ ਰੀਤਿ ॥",
      "transliteration": "ih sa(n)t niramal reet ||",
      "translation": "This is the Immaculate Way of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਜਿ ਗਏ ਪਾਪ ਬਿਕਾਰ ॥",
      "transliteration": "taj gae paap bikaar ||",
      "translation": "They forsake sin and corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਰਿ ਮਿਲੇ ਪ੍ਰਭ ਨਿਰੰਕਾਰ ॥੩॥",
      "transliteration": "har mile prabh nira(n)kaar ||3||",
      "translation": "They meet the Formless Lord God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪ੍ਰਭ ਪੇਖੀਐ ਬਿਸਮਾਦ ॥",
      "transliteration": "prabh pekheeai bisamaad ||",
      "translation": "Gazing upon God, I am wonderstruck.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਚਖਿ ਅਨਦ ਪੂਰਨ ਸਾਦ ॥",
      "transliteration": "chakh anad pooran saad ||",
      "translation": "I taste the Perfect Flavor of Bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਹ ਡੋਲੀਐ ਇਤ ਊਤ ॥",
      "transliteration": "nah doleeai it oot ||",
      "translation": "I do not waver or wander here or there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪ੍ਰਭ ਬਸੇ ਹਰਿ ਹਰਿ ਚੀਤ ॥੪॥",
      "transliteration": "prabh base har har cheet ||4||",
      "translation": "The Lord God, Har, Har, dwells within my consciousness. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਨੑ ਨਾਹਿ ਨਰਕ ਨਿਵਾਸੁ ॥",
      "transliteration": "tinh naahi narak nivaas ||",
      "translation": "Those who constantly remember God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਿਤ ਸਿਮਰਿ ਪ੍ਰਭ ਗੁਣਤਾਸੁ ॥",
      "transliteration": "nit simar prabh gunataas ||",
      "translation": "The treasure of virtue, will never go to hell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤੇ ਜਮੁ ਨ ਪੇਖਹਿ ਨੈਨ ॥",
      "transliteration": "te jam na pekhahi nain ||",
      "translation": "Those who listen, fascinated, to the Unstruck Sound-Current of the Word,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੁਨਿ ਮੋਹੇ ਅਨਹਤ ਬੈਨ ॥੫॥",
      "transliteration": "sun mohe anahat bain ||5||",
      "translation": "Will never have to see the Messenger of Death with their eyes. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰਿ ਸਰਣਿ ਸੂਰ ਗੁਪਾਲ ॥",
      "transliteration": "har saran soor gupaal ||",
      "translation": "I seek the Sanctuary of the Lord, the Heroic Lord of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪ੍ਰਭ ਭਗਤ ਵਸਿ ਦਇਆਲ ॥",
      "transliteration": "prabh bhagat vas daiaal ||",
      "translation": "The Merciful Lord God is under the power of His devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਰਿ ਨਿਗਮ ਲਹਹਿ ਨ ਭੇਵ ॥",
      "transliteration": "har nigam lahahi na bhev ||",
      "translation": "The Vedas do not know the Mystery of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਿਤ ਕਰਹਿ ਮੁਨਿ ਜਨ ਸੇਵ ॥੬॥",
      "transliteration": "nit karahi mun jan sev ||6||",
      "translation": "The silent sages constantly serve Him. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੁਖ ਦੀਨ ਦਰਦ ਨਿਵਾਰ ॥",
      "transliteration": "dukh deen darad nivaar ||",
      "translation": "He is the Destroyer of the pains and sorrows of the poor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾ ਕੀ ਮਹਾ ਬਿਖੜੀ ਕਾਰ ॥",
      "transliteration": "jaa kee mahaa bikhaRee kaar ||",
      "translation": "It is so very difficult to serve Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਾ ਕੀ ਮਿਤਿ ਨ ਜਾਨੈ ਕੋਇ ॥",
      "transliteration": "taa kee mit na jaanai koi ||",
      "translation": "No one knows His limits.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ ਸੋਇ ॥੭॥",
      "transliteration": "jal thal maheeal soi ||7||",
      "translation": "He is pervading the water, the land and the sky. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰਿ ਬੰਦਨਾ ਲਖ ਬਾਰ ॥",
      "transliteration": "kar ba(n)danaa lakh baar ||",
      "translation": "Hundreds of thousands of times, I humbly bow to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਥਕਿ ਪਰਿਓ ਪ੍ਰਭ ਦਰਬਾਰ ॥",
      "transliteration": "thak pario prabh darabaar ||",
      "translation": "I have grown weary, and I have collapsed at God's Door.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪ੍ਰਭ ਕਰਹੁ ਸਾਧੂ ਧੂਰਿ ॥",
      "transliteration": "prabh karahu saadhoo dhoor ||",
      "translation": "O God, make me the dust of the feet of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਮਨਸਾ ਪੂਰਿ ॥੮॥੧॥",
      "transliteration": "naanak manasaa poor ||8||1||",
      "translation": "Please fulfill this, Nanak's wish. ||8||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "bilaaval mahalaa 5 ||",
      "translation": "Bilaaval, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਭ ਜਨਮ ਮਰਨ ਨਿਵਾਰਿ ॥",
      "transliteration": "prabh janam maran nivaar ||",
      "translation": "God, please release me from birth and death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਾਰਿ ਪਰਿਓ ਦੁਆਰਿ ॥",
      "transliteration": "haar pario duaar ||",
      "translation": "I have grown weary, and collapsed at Your door.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗਹਿ ਚਰਨ ਸਾਧੂ ਸੰਗ ॥",
      "transliteration": "gahi charan saadhoo sa(n)g ||",
      "translation": "I grasp Your Feet, in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0837_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮਨ ਮਿਸਟ ਹਰਿ ਹਰਿ ਰੰਗ ॥",
      "transliteration": "man misat har har ra(n)g ||",
      "translation": "The Love of the Lord, Har, Har, is sweet to my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 837,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
