{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 838,
  "lineCount": 66,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0838_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਰਿ ਦਇਆ ਲੇਹੁ ਲੜਿ ਲਾਇ ॥",
      "transliteration": "kar daiaa lehu laR laai ||",
      "translation": "Be Merciful, and attach me to the hem of Your robe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਨਕਾ ਨਾਮੁ ਧਿਆਇ ॥੧॥",
      "transliteration": "naanakaa naam dhiaai ||1||",
      "translation": "Nanak meditates on the Naam, the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੀਨਾ ਨਾਥ ਦਇਆਲ ਮੇਰੇ ਸੁਆਮੀ ਦੀਨਾ ਨਾਥ ਦਇਆਲ ॥",
      "transliteration": "deenaa naath daiaal mere suaamee deenaa naath daiaal ||",
      "translation": "O Merciful Master of the meek, You are my Lord and Master, O Merciful Master of the meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਾਚਉ ਸੰਤ ਰਵਾਲ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaachau sa(n)t ravaal ||1|| rahaau ||",
      "translation": "I yearn for the dust of the feet of the Saints. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੰਸਾਰੁ ਬਿਖਿਆ ਕੂਪ ॥",
      "transliteration": "sa(n)saar bikhiaa koop ||",
      "translation": "The world is a pit of poison,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਮ ਅਗਿਆਨ ਮੋਹਤ ਘੂਪ ॥",
      "transliteration": "tam agiaan mohat ghoop ||",
      "translation": "filled with the utter darkness of ignorance and emotional attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗਹਿ ਭੁਜਾ ਪ੍ਰਭ ਜੀ ਲੇਹੁ ॥",
      "transliteration": "gahi bhujaa prabh jee lehu ||",
      "translation": "Please take my hand, and save me, Dear God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਰਿ ਨਾਮੁ ਅਪੁਨਾ ਦੇਹੁ ॥",
      "transliteration": "har naam apunaa dehu ||",
      "translation": "Please bless me with Your Name, Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪ੍ਰਭ ਤੁਝ ਬਿਨਾ ਨਹੀ ਠਾਉ ॥",
      "transliteration": "prabh tujh binaa nahee thaau ||",
      "translation": "Without You, God, I have no place at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਨਕਾ ਬਲਿ ਬਲਿ ਜਾਉ ॥੨॥",
      "transliteration": "naanakaa bal bal jaau ||2||",
      "translation": "Nanak is a sacrifice, a sacrifice to You. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਲੋਭਿ ਮੋਹਿ ਬਾਧੀ ਦੇਹ ॥",
      "transliteration": "lobh mohi baadhee deh ||",
      "translation": "The human body is in the grip of greed and attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਿਨੁ ਭਜਨ ਹੋਵਤ ਖੇਹ ॥",
      "transliteration": "bin bhajan hovat kheh ||",
      "translation": "Without meditating and vibrating upon the Lord, it is reduced to ashes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਮਦੂਤ ਮਹਾ ਭਇਆਨ ॥",
      "transliteration": "jamadoot mahaa bhaiaan ||",
      "translation": "The Messenger of Death is dreadful and horrible.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚਿਤ ਗੁਪਤ ਕਰਮਹਿ ਜਾਨ ॥",
      "transliteration": "chit gupat karamahi jaan ||",
      "translation": "The recording scribes of the conscious and the unconscious, Chitr and Gupt, know all actions and karma.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦਿਨੁ ਰੈਨਿ ਸਾਖਿ ਸੁਨਾਇ ॥",
      "transliteration": "din rain saakh sunaai ||",
      "translation": "Day and night, they bear witness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਨਕਾ ਹਰਿ ਸਰਨਾਇ ॥੩॥",
      "transliteration": "naanakaa har saranaai ||3||",
      "translation": "Nanak seeks the Sanctuary of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਭੈ ਭੰਜਨਾ ਮੁਰਾਰਿ ॥",
      "transliteration": "bhai bha(n)janaa muraar ||",
      "translation": "O Lord, Destroyer of fear and egotism,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਰਿ ਦਇਆ ਪਤਿਤ ਉਧਾਰਿ ॥",
      "transliteration": "kar daiaa patit udhaar ||",
      "translation": "be merciful, and save the sinners.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੇਰੇ ਦੋਖ ਗਨੇ ਨ ਜਾਹਿ ॥",
      "transliteration": "mere dokh gane na jaahi ||",
      "translation": "My sins cannot even be counted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਰਿ ਬਿਨਾ ਕਤਹਿ ਸਮਾਹਿ ॥",
      "transliteration": "har binaa katahi samaahi ||",
      "translation": "Without the Lord, who can hide them?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗਹਿ ਓਟ ਚਿਤਵੀ ਨਾਥ ॥",
      "transliteration": "gahi ot chitavee naath ||",
      "translation": "I thought of Your Support, and seized it, O my Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਨਕਾ ਦੇ ਰਖੁ ਹਾਥ ॥੪॥",
      "transliteration": "naanakaa de rakh haath ||4||",
      "translation": "Please, give Nanak Your hand and save him, Lord! ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਨਿਧੇ ਗੋਪਾਲ ॥",
      "transliteration": "har gun nidhe gopaal ||",
      "translation": "The Lord, the treasure of virtue, the Lord of the world,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਰਬ ਘਟ ਪ੍ਰਤਿਪਾਲ ॥",
      "transliteration": "sarab ghat pratipaal ||",
      "translation": "cherishes and and sustains every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਨਿ ਪ੍ਰੀਤਿ ਦਰਸਨ ਪਿਆਸ ॥",
      "transliteration": "man preet darasan piaas ||",
      "translation": "My mind is thirsty for Your Love, and the Blessed Vision of Your Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੋਬਿੰਦ ਪੂਰਨ ਆਸ ॥",
      "transliteration": "gobi(n)d pooran aas ||",
      "translation": "O Lord of the Universe, please fulfill my hopes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਕ ਨਿਮਖ ਰਹਨੁ ਨ ਜਾਇ ॥",
      "transliteration": "ik nimakh rahan na jaai ||",
      "translation": "I cannot survive, even for an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਵਡ ਭਾਗਿ ਨਾਨਕ ਪਾਇ ॥੫॥",
      "transliteration": "vad bhaag naanak paai ||5||",
      "translation": "By great good fortune, Nanak has found the Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪ੍ਰਭ ਤੁਝ ਬਿਨਾ ਨਹੀ ਹੋਰ ॥",
      "transliteration": "prabh tujh binaa nahee hor ||",
      "translation": "Without You, God, there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਨਿ ਪ੍ਰੀਤਿ ਚੰਦ ਚਕੋਰ ॥",
      "transliteration": "man preet cha(n)d chakor ||",
      "translation": "My mind loves You, as the partridge loves the moon,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਉ ਮੀਨ ਜਲ ਸਿਉ ਹੇਤੁ ॥",
      "transliteration": "jiu meen jal siu het ||",
      "translation": "as the fish loves the water,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਲਿ ਕਮਲ ਭਿੰਨੁ ਨ ਭੇਤੁ ॥",
      "transliteration": "al kamal bhi(n)n na bhet ||",
      "translation": "as the bee and the lotus cannot be separated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਉ ਚਕਵੀ ਸੂਰਜ ਆਸ ॥",
      "transliteration": "jiu chakavee sooraj aas ||",
      "translation": "As the chakvi bird longs for the sun,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਨਕ ਚਰਨ ਪਿਆਸ ॥੬॥",
      "transliteration": "naanak charan piaas ||6||",
      "translation": "so does Nanak thirst for the Lord's feet. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਉ ਤਰੁਨਿ ਭਰਤ ਪਰਾਨ ॥",
      "transliteration": "jiu tarun bharat paraan ||",
      "translation": "As the young bride places the hopes of her life in her husband,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਉ ਲੋਭੀਐ ਧਨੁ ਦਾਨੁ ॥",
      "transliteration": "jiu lobheeai dhan daan ||",
      "translation": "as the greedy person looks upon the gift of wealth,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਉ ਦੂਧ ਜਲਹਿ ਸੰਜੋਗੁ ॥",
      "transliteration": "jiu doodh jalahi sa(n)jog ||",
      "translation": "as milk is joined to water,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਉ ਮਹਾ ਖੁਧਿਆਰਥ ਭੋਗੁ ॥",
      "transliteration": "jiu mahaa khudhiaarath bhog ||",
      "translation": "as food is to the very hungry man,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਿਉ ਮਾਤ ਪੂਤਹਿ ਹੇਤੁ ॥",
      "transliteration": "jiu maat pootahi het ||",
      "translation": "and as the mother loves her son,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਿ ਨਾਨਕ ਨੇਤ ॥੭॥",
      "transliteration": "har simar naanak net ||7||",
      "translation": "so does Nanak constantly remember the Lord in meditation. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਿਉ ਦੀਪ ਪਤਨ ਪਤੰਗ ॥",
      "transliteration": "jiu deep patan pata(n)g ||",
      "translation": "As the moth falls into the lamp,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਉ ਚੋਰੁ ਹਿਰਤ ਨਿਸੰਗ ॥",
      "transliteration": "jiu chor hirat nisa(n)g ||",
      "translation": "as the thief steals without hesitation,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮੈਗਲਹਿ ਕਾਮੈ ਬੰਧੁ ॥",
      "transliteration": "maigalahi kaamai ba(n)dh ||",
      "translation": "as the elephant is trapped by its sexual urges,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਉ ਗ੍ਰਸਤ ਬਿਖਈ ਧੰਧੁ ॥",
      "transliteration": "jiu grasat bikhaee dha(n)dh ||",
      "translation": "as the sinner is caught in his sins,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਿਉ ਜੂਆਰ ਬਿਸਨੁ ਨ ਜਾਇ ॥",
      "transliteration": "jiu jooaar bisan na jaai ||",
      "translation": "as the gambler's addiction does not leave him,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਰਿ ਨਾਨਕ ਇਹੁ ਮਨੁ ਲਾਇ ॥੮॥",
      "transliteration": "har naanak ihu man laai ||8||",
      "translation": "so is this mind of Nanak's attached to the Lord. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕੁਰੰਕ ਨਾਦੈ ਨੇਹੁ ॥",
      "transliteration": "kura(n)k naadai nehu ||",
      "translation": "As the deer loves the sound of the bell,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚਾਤ੍ਰਿਕੁ ਚਾਹਤ ਮੇਹੁ ॥",
      "transliteration": "chaatrik chaahat mehu ||",
      "translation": "and as the song-bird longs for the rain,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਨ ਜੀਵਨਾ ਸਤਸੰਗਿ ॥",
      "transliteration": "jan jeevanaa satasa(n)g ||",
      "translation": "the Lord's humble servant lives in the Society of the Saints,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗੋਬਿਦੁ ਭਜਨਾ ਰੰਗਿ ॥",
      "transliteration": "gobid bhajanaa ra(n)g ||",
      "translation": "lovingly meditating and vibrating upon the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਰਸਨਾ ਬਖਾਨੈ ਨਾਮੁ ॥",
      "transliteration": "rasanaa bakhaanai naam ||",
      "translation": "My tongue chants the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾਨਕ ਦਰਸਨ ਦਾਨੁ ॥੯॥",
      "transliteration": "naanak darasan daan ||9||",
      "translation": "Please bless Nanak with the gift of the Blessed Vision of Your Darshan. ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਨ ਗਾਇ ਸੁਨਿ ਲਿਖਿ ਦੇਇ ॥",
      "transliteration": "gun gaai sun likh dei ||",
      "translation": "One who sings the Glorious Praises of the Lord, and hears them, and writes them,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੋ ਸਰਬ ਫਲ ਹਰਿ ਲੇਇ ॥",
      "transliteration": "so sarab phal har lei ||",
      "translation": "receives all fruits and rewards from the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕੁਲ ਸਮੂਹ ਕਰਤ ਉਧਾਰੁ ॥",
      "transliteration": "kul samooh karat udhaar ||",
      "translation": "He saves all his ancestors and generations,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸੰਸਾਰੁ ਉਤਰਸਿ ਪਾਰਿ ॥",
      "transliteration": "sa(n)saar utaras paar ||",
      "translation": "and crosses over the world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਹਰਿ ਚਰਨ ਬੋਹਿਥ ਤਾਹਿ ॥",
      "transliteration": "har charan bohith taahi ||",
      "translation": "The Lord's Feet are the boat to carry him across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਮਿਲਿ ਸਾਧਸੰਗਿ ਜਸੁ ਗਾਹਿ ॥",
      "transliteration": "mil saadhasa(n)g jas gaahi ||",
      "translation": "Joining the Saadh Sangat, the Company of the Holy, he sings the Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਹਰਿ ਪੈਜ ਰਖੈ ਮੁਰਾਰਿ ॥",
      "transliteration": "har paij rakhai muraar ||",
      "translation": "The Lord protects his honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਹਰਿ ਨਾਨਕ ਸਰਨਿ ਦੁਆਰਿ ॥੧੦॥੨॥",
      "transliteration": "har naanak saran duaar ||10||2||",
      "translation": "Nanak seeks the Sanctuary of the Lord's door. ||10||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੧ ਥਿਤੀ ਘਰੁ ੧੦ ਜਤਿ ॥",
      "transliteration": "bilaaval mahalaa 1 thitee ghar 10 jat ||",
      "translation": "Bilaaval, First Mehl, T'hitee ~ The Lunar Days, Tenth House, To The Drum-Beat Jat:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਏਕਮ ਏਕੰਕਾਰੁ ਨਿਰਾਲਾ ॥",
      "transliteration": "ekam eka(n)kaar niraalaa ||",
      "translation": "The First Day: The One Universal Creator is unique,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0064",
      "lineIndex": 64,
      "gurmukhi": "ਅਮਰੁ ਅਜੋਨੀ ਜਾਤਿ ਨ ਜਾਲਾ ॥",
      "transliteration": "amar ajonee jaat na jaalaa ||",
      "translation": "immortal, unborn, beyond social class or involvement.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0065",
      "lineIndex": 65,
      "gurmukhi": "ਅਗਮ ਅਗੋਚਰੁ ਰੂਪੁ ਨ ਰੇਖਿਆ ॥",
      "transliteration": "agam agochar roop na rekhiaa ||",
      "translation": "He is inaccessible and unfathomable, with no form or feature.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0838_line_0066",
      "lineIndex": 66,
      "gurmukhi": "ਖੋਜਤ ਖੋਜਤ ਘਟਿ ਘਟਿ ਦੇਖਿਆ ॥",
      "transliteration": "khojat khojat ghat ghat dekhiaa ||",
      "translation": "Searching, searching, I have seen Him in each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 838,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
