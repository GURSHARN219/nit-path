{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 839,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0839_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜੋ ਦੇਖਿ ਦਿਖਾਵੈ ਤਿਸ ਕਉ ਬਲਿ ਜਾਈ ॥",
      "transliteration": "jo dekh dikhaavai tis kau bal jaaee ||",
      "translation": "I am a sacrifice to one who sees, and inspires others to see Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਪਰਮ ਪਦੁ ਪਾਈ ॥੧॥",
      "transliteration": "gur parasaad param pad paaee ||1||",
      "translation": "By Guru's Grace, I have obtained the supreme status. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਿਆ ਜਪੁ ਜਾਪਉ ਬਿਨੁ ਜਗਦੀਸੈ ॥",
      "transliteration": "kiaa jap jaapau bin jagadeesai ||",
      "translation": "Whose Name should I chant, and meditate on, except the Lord of the Universe?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਮਹਲੁ ਘਰੁ ਦੀਸੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur kai sabad mahal ghar deesai ||1|| rahaau ||",
      "translation": "Through the Word of the Guru's Shabad, the Mansion of the Lord's Presence is revealed within the home of one's own heart. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੂਜੈ ਭਾਇ ਲਗੇ ਪਛੁਤਾਣੇ ॥",
      "transliteration": "doojai bhaai lage pachhutaane ||",
      "translation": "The Second Day: Those who are in love with another, come to regret and repent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਮ ਦਰਿ ਬਾਧੇ ਆਵਣ ਜਾਣੇ ॥",
      "transliteration": "jam dar baadhe aavan jaane ||",
      "translation": "The are tied up at Death's door, and continue coming and going.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿਆ ਲੈ ਆਵਹਿ ਕਿਆ ਲੇ ਜਾਹਿ ॥",
      "transliteration": "kiaa lai aavahi kiaa le jaahi ||",
      "translation": "What have they brought, and what will they take with them when they go?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਿਰਿ ਜਮਕਾਲੁ ਸਿ ਚੋਟਾ ਖਾਹਿ ॥",
      "transliteration": "sir jamakaal s chotaa khaahi ||",
      "translation": "The Messenger of Death looms over their heads, and they endure his beating.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਨੁ ਗੁਰਸਬਦ ਨ ਛੂਟਸਿ ਕੋਇ ॥",
      "transliteration": "bin gurasabad na chhootas koi ||",
      "translation": "Without the Word of the Guru's Shabad, no one finds release.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਾਖੰਡਿ ਕੀਨੑੈ ਮੁਕਤਿ ਨ ਹੋਇ ॥੨॥",
      "transliteration": "paakha(n)d keenhai mukat na hoi ||2||",
      "translation": "Practicing hypocrisy, no one finds liberation. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਪੇ ਸਚੁ ਕੀਆ ਕਰ ਜੋੜਿ ॥",
      "transliteration": "aape sach keeaa kar joR ||",
      "translation": "The True Lord Himself created the universe, joining the elements together.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅੰਡਜ ਫੋੜਿ ਜੋੜਿ ਵਿਛੋੜਿ ॥",
      "transliteration": "a(n)daj phoR joR vichhoR ||",
      "translation": "Breaking the cosmic egg, He united, and separated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧਰਤਿ ਅਕਾਸੁ ਕੀਏ ਬੈਸਣ ਕਉ ਥਾਉ ॥",
      "transliteration": "dharat akaas keee baisan kau thaau ||",
      "translation": "He made the earth and the sky into places to live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਤਿ ਦਿਨੰਤੁ ਕੀਏ ਭਉ ਭਾਉ ॥",
      "transliteration": "raat dina(n)t keee bhau bhaau ||",
      "translation": "He created day and night, fear and love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਨਿ ਕੀਏ ਕਰਿ ਵੇਖਣਹਾਰਾ ॥",
      "transliteration": "jin keee kar vekhanahaaraa ||",
      "translation": "The One who created the Creation, also watches over it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਵਰੁ ਨ ਦੂਜਾ ਸਿਰਜਣਹਾਰਾ ॥੩॥",
      "transliteration": "avar na doojaa sirajanahaaraa ||3||",
      "translation": "There is no other Creator Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤ੍ਰਿਤੀਆ ਬ੍ਰਹਮਾ ਬਿਸਨੁ ਮਹੇਸਾ ॥",
      "transliteration": "triteeaa brahamaa bisan mahesaa ||",
      "translation": "The Third Day: He created Brahma, Vishnu and Shiva,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੇਵੀ ਦੇਵ ਉਪਾਏ ਵੇਸਾ ॥",
      "transliteration": "devee dev upaae vesaa ||",
      "translation": "the gods, goddesses and various manifestations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੋਤੀ ਜਾਤੀ ਗਣਤ ਨ ਆਵੈ ॥",
      "transliteration": "jotee jaatee ganat na aavai ||",
      "translation": "The lights and forms cannot be counted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਨਿ ਸਾਜੀ ਸੋ ਕੀਮਤਿ ਪਾਵੈ ॥",
      "transliteration": "jin saajee so keemat paavai ||",
      "translation": "The One who fashioned them, knows their value.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕੀਮਤਿ ਪਾਇ ਰਹਿਆ ਭਰਪੂਰਿ ॥",
      "transliteration": "keemat paai rahiaa bharapoor ||",
      "translation": "He evaluates them, and totally pervades them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਿਸੁ ਨੇੜੈ ਕਿਸੁ ਆਖਾ ਦੂਰਿ ॥੪॥",
      "transliteration": "kis neRai kis aakhaa door ||4||",
      "translation": "Who is close, and who is far away? ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਉਥਿ ਉਪਾਏ ਚਾਰੇ ਬੇਦਾ ॥",
      "transliteration": "chauth upaae chaare bedaa ||",
      "translation": "The Fourth Day: He created the four Vedas,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਖਾਣੀ ਚਾਰੇ ਬਾਣੀ ਭੇਦਾ ॥",
      "transliteration": "khaanee chaare baanee bhedaa ||",
      "translation": "the four sources of creation, and distinct forms of speech.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਸਟ ਦਸਾ ਖਟੁ ਤੀਨਿ ਉਪਾਏ ॥",
      "transliteration": "asat dasaa khat teen upaae ||",
      "translation": "He created the eighteen Puraanas, the six Shaastras and the three qualities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੋ ਬੂਝੈ ਜਿਸੁ ਆਪਿ ਬੁਝਾਏ ॥",
      "transliteration": "so boojhai jis aap bujhaae ||",
      "translation": "He alone understands, whom the Lord causes to understand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੀਨਿ ਸਮਾਵੈ ਚਉਥੈ ਵਾਸਾ ॥",
      "transliteration": "teen samaavai chauthai vaasaa ||",
      "translation": "One who overcomes the three qualities, dwells in the fourth state.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪ੍ਰਣਵਤਿ ਨਾਨਕ ਹਮ ਤਾ ਕੇ ਦਾਸਾ ॥੫॥",
      "transliteration": "pranavat naanak ham taa ke daasaa ||5||",
      "translation": "Prays Nanak, I am his slave. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪੰਚਮੀ ਪੰਚ ਭੂਤ ਬੇਤਾਲਾ ॥",
      "transliteration": "pa(n)chamee pa(n)ch bhoot betaalaa ||",
      "translation": "The Fifth Day: The five elements are demons.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਪਿ ਅਗੋਚਰੁ ਪੁਰਖੁ ਨਿਰਾਲਾ ॥",
      "transliteration": "aap agochar purakh niraalaa ||",
      "translation": "The Lord Himself is unfathomable and detached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਕਿ ਭ੍ਰਮਿ ਭੂਖੇ ਮੋਹ ਪਿਆਸੇ ॥",
      "transliteration": "ik bhram bhookhe moh piaase ||",
      "translation": "Some are gripped by doubt, hunger, emotional attachment and desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਕਿ ਰਸੁ ਚਾਖਿ ਸਬਦਿ ਤ੍ਰਿਪਤਾਸੇ ॥",
      "transliteration": "ik ras chaakh sabad tripataase ||",
      "translation": "Some taste the sublime essence of the Shabad, and are satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਕਿ ਰੰਗਿ ਰਾਤੇ ਇਕਿ ਮਰਿ ਧੂਰਿ ॥",
      "transliteration": "ik ra(n)g raate ik mar dhoor ||",
      "translation": "Some are imbued with the Lord's Love, while some die, and are reduced to dust.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਕਿ ਦਰਿ ਘਰਿ ਸਾਚੈ ਦੇਖਿ ਹਦੂਰਿ ॥੬॥",
      "transliteration": "ik dar ghar saachai dekh hadoor ||6||",
      "translation": "Some attain the Court and the Mansion of the True Lord, and behold Him, ever-present. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਝੂਠੇ ਕਉ ਨਾਹੀ ਪਤਿ ਨਾਉ ॥",
      "transliteration": "jhoothe kau naahee pat naau ||",
      "translation": "The false one has no honor or fame;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਬਹੁ ਨ ਸੂਚਾ ਕਾਲਾ ਕਾਉ ॥",
      "transliteration": "kabahu na soochaa kaalaa kaau ||",
      "translation": "like the black crow, he never becomes pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਿੰਜਰਿ ਪੰਖੀ ਬੰਧਿਆ ਕੋਇ ॥",
      "transliteration": "pi(n)jar pa(n)khee ba(n)dhiaa koi ||",
      "translation": "He is like the bird, imprisoned in a cage;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਛੇਰੀਂ ਭਰਮੈ ਮੁਕਤਿ ਨ ਹੋਇ ॥",
      "transliteration": "chheree(n) bharamai mukat na hoi ||",
      "translation": "he paces back and forth behind the bars, but he is not released.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਉ ਛੂਟੈ ਜਾ ਖਸਮੁ ਛਡਾਏ ॥",
      "transliteration": "tau chhootai jaa khasam chhadaae ||",
      "translation": "He alone is emancipated, whom the Lord and Master emancipates.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਰਮਤਿ ਮੇਲੇ ਭਗਤਿ ਦ੍ਰਿੜਾਏ ॥੭॥",
      "transliteration": "guramat mele bhagat driRaae ||7||",
      "translation": "He follows the Guru's Teachings, and enshrines devotional worship. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਖਸਟੀ ਖਟੁ ਦਰਸਨ ਪ੍ਰਭ ਸਾਜੇ ॥",
      "transliteration": "khasatee khat darasan prabh saaje ||",
      "translation": "The Sixth Day: God organized the six systems of Yoga.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਨਹਦ ਸਬਦੁ ਨਿਰਾਲਾ ਵਾਜੇ ॥",
      "transliteration": "anahad sabad niraalaa vaaje ||",
      "translation": "The unstruck sound current of the Shabad vibrates of itself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੇ ਪ੍ਰਭ ਭਾਵੈ ਤਾ ਮਹਲਿ ਬੁਲਾਵੈ ॥",
      "transliteration": "je prabh bhaavai taa mahal bulaavai ||",
      "translation": "If God wills it so, then one is summoned to the Mansion of His Presence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਬਦੇ ਭੇਦੇ ਤਉ ਪਤਿ ਪਾਵੈ ॥",
      "transliteration": "sabade bhede tau pat paavai ||",
      "translation": "One who is pierced through by the Shabad, obtains honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਰਿ ਕਰਿ ਵੇਸ ਖਪਹਿ ਜਲਿ ਜਾਵਹਿ ॥",
      "transliteration": "kar kar ves khapahi jal jaavahi ||",
      "translation": "Those who wear religious robes burn, and are ruined.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਾਚੈ ਸਾਚੇ ਸਾਚਿ ਸਮਾਵਹਿ ॥੮॥",
      "transliteration": "saachai saache saach samaavahi ||8||",
      "translation": "Through Truth, the truthful ones merge into the True Lord. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਪਤਮੀ ਸਤੁ ਸੰਤੋਖੁ ਸਰੀਰਿ ॥",
      "transliteration": "sapatamee sat sa(n)tokh sareer ||",
      "translation": "The Seventh Day: When the body is imbued with Truth and contentment,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਾਤ ਸਮੁੰਦ ਭਰੇ ਨਿਰਮਲ ਨੀਰਿ ॥",
      "transliteration": "saat samu(n)d bhare niramal neer ||",
      "translation": "the seven seas within are filled with the Immaculate Water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮਜਨੁ ਸੀਲੁ ਸਚੁ ਰਿਦੈ ਵੀਚਾਰਿ ॥",
      "transliteration": "majan seel sach ridai veechaar ||",
      "translation": "Bathing in good conduct, and contemplating the True Lord within the heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਪਾਵੈ ਸਭਿ ਪਾਰਿ ॥",
      "transliteration": "gur kai sabad paavai sabh paar ||",
      "translation": "one obtains the Word of the Guru's Shabad, and carries everyone across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮਨਿ ਸਾਚਾ ਮੁਖਿ ਸਾਚਉ ਭਾਇ ॥",
      "transliteration": "man saachaa mukh saachau bhaai ||",
      "translation": "With the True Lord in the mind, and the True Lord lovingly on one's lips,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਚੁ ਨੀਸਾਣੈ ਠਾਕ ਨ ਪਾਇ ॥੯॥",
      "transliteration": "sach neesaanai thaak na paai ||9||",
      "translation": "one is blessed with the banner of Truth, and meets with no obstructions. ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅਸਟਮੀ ਅਸਟ ਸਿਧਿ ਬੁਧਿ ਸਾਧੈ ॥",
      "transliteration": "asatamee asat sidh budh saadhai ||",
      "translation": "The Eighth Day: The eight miraculous powers come when one subdues his own mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਚੁ ਨਿਹਕੇਵਲੁ ਕਰਮਿ ਅਰਾਧੈ ॥",
      "transliteration": "sach nihakeval karam araadhai ||",
      "translation": "and contemplates the True Lord through pure actions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪਉਣ ਪਾਣੀ ਅਗਨੀ ਬਿਸਰਾਉ ॥",
      "transliteration": "paun paanee aganee bisaraau ||",
      "translation": "Forget the three qualities of wind, water and fire,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਤਹੀ ਨਿਰੰਜਨੁ ਸਾਚੋ ਨਾਉ ॥",
      "transliteration": "tahee nira(n)jan saacho naau ||",
      "translation": "and concentrate on the pure True Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਿਸੁ ਮਹਿ ਮਨੂਆ ਰਹਿਆ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "tis mahi manooaa rahiaa liv laai ||",
      "translation": "That human who remains lovingly focused on the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਪ੍ਰਣਵਤਿ ਨਾਨਕੁ ਕਾਲੁ ਨ ਖਾਇ ॥੧੦॥",
      "transliteration": "pranavat naanak kaal na khaai ||10||",
      "translation": "prays Nanak, shall not be consumed by death. ||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਨਾਉ ਨਉਮੀ ਨਵੇ ਨਾਥ ਨਵ ਖੰਡਾ ॥",
      "transliteration": "naau naumee nave naath nav kha(n)daa ||",
      "translation": "The Ninth Day: The Name is the supreme almighty Master of the nine masters of Yoga,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0839_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਨਾਥੁ ਮਹਾ ਬਲਵੰਡਾ ॥",
      "transliteration": "ghat ghat naath mahaa balava(n)daa ||",
      "translation": "The nine realms of the earth, and each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 839,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
