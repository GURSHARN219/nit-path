{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 840,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0840_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਈ ਪੂਤਾ ਇਹੁ ਜਗੁ ਸਾਰਾ ॥",
      "transliteration": "aaee pootaa ihu jag saaraa ||",
      "translation": "This whole world is the child of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪ੍ਰਭ ਆਦੇਸੁ ਆਦਿ ਰਖਵਾਰਾ ॥",
      "transliteration": "prabh aades aad rakhavaaraa ||",
      "translation": "I bow in submission to God, my Protector from the very beginning of time.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਦਿ ਜੁਗਾਦੀ ਹੈ ਭੀ ਹੋਗੁ ॥",
      "transliteration": "aad jugaadee hai bhee hog ||",
      "translation": "He was in the beginning, He has been throughout the ages, He is now, and He shall always be.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਓਹੁ ਅਪਰੰਪਰੁ ਕਰਣੈ ਜੋਗੁ ॥੧੧॥",
      "transliteration": "ohu apara(n)par karanai jog ||11||",
      "translation": "He is unlimited, and capable of doing everything. ||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦਸਮੀ ਨਾਮੁ ਦਾਨੁ ਇਸਨਾਨੁ ॥",
      "transliteration": "dasamee naam daan isanaan ||",
      "translation": "The Tenth Day: Meditate on the Naam, give to charity, and purify yourself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਨਦਿਨੁ ਮਜਨੁ ਸਚਾ ਗੁਣ ਗਿਆਨੁ ॥",
      "transliteration": "anadin majan sachaa gun giaan ||",
      "translation": "Night and day, bathe in spiritual wisdom and the Glorious Virtues of the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਚਿ ਮੈਲੁ ਨ ਲਾਗੈ ਭ੍ਰਮੁ ਭਉ ਭਾਗੈ ॥",
      "transliteration": "sach mail na laagai bhram bhau bhaagai ||",
      "translation": "Truth cannot be polluted; doubt and fear run away from it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਿਲਮੁ ਨ ਤੂਟਸਿ ਕਾਚੈ ਤਾਗੈ ॥",
      "transliteration": "bilam na tootas kaachai taagai ||",
      "translation": "The flimsy thread breaks in an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਿਉ ਤਾਗਾ ਜਗੁ ਏਵੈ ਜਾਣਹੁ ॥",
      "transliteration": "jiu taagaa jag evai jaanahu ||",
      "translation": "Know that the world is just like this thread.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਸਥਿਰੁ ਚੀਤੁ ਸਾਚਿ ਰੰਗੁ ਮਾਣਹੁ ॥੧੨॥",
      "transliteration": "asathir cheet saach ra(n)g maanahu ||12||",
      "translation": "Your consciousness shall become steady and stable, enjoying the Love of the True Lord. ||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਏਕਾਦਸੀ ਇਕੁ ਰਿਦੈ ਵਸਾਵੈ ॥",
      "transliteration": "ekaadasee ik ridai vasaavai ||",
      "translation": "The Eleventh Day: Enshrine the One Lord within your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਿੰਸਾ ਮਮਤਾ ਮੋਹੁ ਚੁਕਾਵੈ ॥",
      "transliteration": "hi(n)saa mamataa mohu chukaavai ||",
      "translation": "Eradicate cruelty, egotism and emotional attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਫਲੁ ਪਾਵੈ ਬ੍ਰਤੁ ਆਤਮ ਚੀਨੈ ॥",
      "transliteration": "phal paavai brat aatam cheenai ||",
      "translation": "Earn the fruitful rewards, by observing the fast of knowing your own self.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਾਖੰਡਿ ਰਾਚਿ ਤਤੁ ਨਹੀ ਬੀਨੈ ॥",
      "transliteration": "paakha(n)d raach tat nahee beenai ||",
      "translation": "One who is engrossed in hypocrisy, does not see the true essence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਿਰਮਲੁ ਨਿਰਾਹਾਰੁ ਨਿਹਕੇਵਲੁ ॥",
      "transliteration": "niramal niraahaar nihakeval ||",
      "translation": "The Lord is immaculate, self-sustaining and unattached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੂਚੈ ਸਾਚੇ ਨਾ ਲਾਗੈ ਮਲੁ ॥੧੩॥",
      "transliteration": "soochai saache naa laagai mal ||13||",
      "translation": "The Pure, True Lord cannot be polluted. ||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਹ ਦੇਖਉ ਤਹ ਏਕੋ ਏਕਾ ॥",
      "transliteration": "jah dekhau tah eko ekaa ||",
      "translation": "Wherever I look, I see the One Lord there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹੋਰਿ ਜੀਅ ਉਪਾਏ ਵੇਕੋ ਵੇਕਾ ॥",
      "transliteration": "hor jee upaae veko vekaa ||",
      "translation": "He created the other beings, of many and various kinds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਫਲੋਹਾਰ ਕੀਏ ਫਲੁ ਜਾਇ ॥",
      "transliteration": "phalohaar keee phal jaai ||",
      "translation": "Eating only fruits, one loses the fruits of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਸ ਕਸ ਖਾਏ ਸਾਦੁ ਗਵਾਇ ॥",
      "transliteration": "ras kas khaae saad gavaai ||",
      "translation": "Eating only delicacies of various sorts, one loses the true taste.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕੂੜੈ ਲਾਲਚਿ ਲਪਟੈ ਲਪਟਾਇ ॥",
      "transliteration": "kooRai laalach lapatai lapataai ||",
      "translation": "In fraud and greed, people are engrossed and entangled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਛੂਟੈ ਗੁਰਮੁਖਿ ਸਾਚੁ ਕਮਾਇ ॥੧੪॥",
      "transliteration": "chhootai guramukh saach kamaai ||14||",
      "translation": "The Gurmukh is emancipated, practicing Truth. ||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੁਆਦਸਿ ਮੁਦ੍ਰਾ ਮਨੁ ਅਉਧੂਤਾ ॥",
      "transliteration": "duaadas mudraa man audhootaa ||",
      "translation": "The Twelfth Day: One whose mind is not attached to the twelve signs,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਜਾਗਹਿ ਕਬਹਿ ਨ ਸੂਤਾ ॥",
      "transliteration": "ahinis jaagahi kabahi na sootaa ||",
      "translation": "remains awake day and night, and never sleeps.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਾਗਤੁ ਜਾਗਿ ਰਹੈ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "jaagat jaag rahai liv laai ||",
      "translation": "He remains awake and aware, lovingly centered on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੁਰ ਪਰਚੈ ਤਿਸੁ ਕਾਲੁ ਨ ਖਾਇ ॥",
      "transliteration": "gur parachai tis kaal na khaai ||",
      "translation": "With faith in the Guru, he is not consumed by death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਤੀਤ ਭਏ ਮਾਰੇ ਬੈਰਾਈ ॥",
      "transliteration": "ateet bhae maare bairaaee ||",
      "translation": "Those who become detached, and conquer the five enemies",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪ੍ਰਣਵਤਿ ਨਾਨਕ ਤਹ ਲਿਵ ਲਾਈ ॥੧੫॥",
      "transliteration": "pranavat naanak tah liv laaee ||15||",
      "translation": "- prays Nanak, they are lovingly absorbed in the Lord. ||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੁਆਦਸੀ ਦਇਆ ਦਾਨੁ ਕਰਿ ਜਾਣੈ ॥",
      "transliteration": "duaadasee daiaa daan kar jaanai ||",
      "translation": "The Twelfth Day: Know, and practice, compassion and charity.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਾਹਰਿ ਜਾਤੋ ਭੀਤਰਿ ਆਣੈ ॥",
      "transliteration": "baahar jaato bheetar aanai ||",
      "translation": "Bring your out-going mind back home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਰਤੀ ਬਰਤ ਰਹੈ ਨਿਹਕਾਮ ॥",
      "transliteration": "baratee barat rahai nihakaam ||",
      "translation": "Observe the fast of remaining free of desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਜਪਾ ਜਾਪੁ ਜਪੈ ਮੁਖਿ ਨਾਮ ॥",
      "transliteration": "ajapaa jaap japai mukh naam ||",
      "translation": "Chant the unchanted Chant of the Naam with your mouth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤੀਨਿ ਭਵਣ ਮਹਿ ਏਕੋ ਜਾਣੈ ॥",
      "transliteration": "teen bhavan mahi eko jaanai ||",
      "translation": "Know that the One Lord is contained in the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਭਿ ਸੁਚਿ ਸੰਜਮ ਸਾਚੁ ਪਛਾਣੈ ॥੧੬॥",
      "transliteration": "sabh such sa(n)jam saach pachhaanai ||16||",
      "translation": "Purity and self-discipline are all contained in knowing the Truth. ||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤੇਰਸਿ ਤਰਵਰ ਸਮੁਦ ਕਨਾਰੈ ॥",
      "transliteration": "teras taravar samud kanaarai ||",
      "translation": "The Thirteenth Day: He is like a tree on the sea-shore.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਮੂਲੁ ਸਿਖਰਿ ਲਿਵ ਤਾਰੈ ॥",
      "transliteration": "a(n)mrit mool sikhar liv taarai ||",
      "translation": "But his roots can become immortal, if his mind is attuned to the Lord's Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਡਰ ਡਰਿ ਮਰੈ ਨ ਬੂਡੈ ਕੋਇ ॥",
      "transliteration": "dar dar marai na boodai koi ||",
      "translation": "Then, he will not die of fear or anxiety, and he will never drown.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਿਡਰੁ ਬੂਡਿ ਮਰੈ ਪਤਿ ਖੋਇ ॥",
      "transliteration": "nidar bood marai pat khoi ||",
      "translation": "Without the Fear of God, he drowns and dies, and loses his honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਡਰ ਮਹਿ ਘਰੁ ਘਰ ਮਹਿ ਡਰੁ ਜਾਣੈ ॥",
      "transliteration": "dar mahi ghar ghar mahi dar jaanai ||",
      "translation": "With the Fear of God in his heart, and his heart in the Fear of God, he knows God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਖਤਿ ਨਿਵਾਸੁ ਸਚੁ ਮਨਿ ਭਾਣੈ ॥੧੭॥",
      "transliteration": "takhat nivaas sach man bhaanai ||17||",
      "translation": "He sits on the throne, and becomes pleasing to the Mind of the True Lord. ||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਉਦਸਿ ਚਉਥੇ ਥਾਵਹਿ ਲਹਿ ਪਾਵੈ ॥",
      "transliteration": "chaudas chauthe thaavahi lahi paavai ||",
      "translation": "The Fourteenth Day: One who enters into the fourth state,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਾਜਸ ਤਾਮਸ ਸਤ ਕਾਲ ਸਮਾਵੈ ॥",
      "transliteration": "raajas taamas sat kaal samaavai ||",
      "translation": "overcomes time, and the three qualities of raajas, taamas and satva.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਸੀਅਰ ਕੈ ਘਰਿ ਸੂਰੁ ਸਮਾਵੈ ॥",
      "transliteration": "saseear kai ghar soor samaavai ||",
      "translation": "Then the sun enters into the house of the moon,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੋਗ ਜੁਗਤਿ ਕੀ ਕੀਮਤਿ ਪਾਵੈ ॥",
      "transliteration": "jog jugat kee keemat paavai ||",
      "translation": "and one knows the value of the technology of Yoga.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚਉਦਸਿ ਭਵਨ ਪਾਤਾਲ ਸਮਾਏ ॥",
      "transliteration": "chaudas bhavan paataal samaae ||",
      "translation": "He remains lovingly focused on God, who is permeating the fourteen worlds,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਖੰਡ ਬ੍ਰਹਮੰਡ ਰਹਿਆ ਲਿਵ ਲਾਏ ॥੧੮॥",
      "transliteration": "kha(n)d brahama(n)d rahiaa liv laae ||18||",
      "translation": "The nether regions of the underworld, the galaxies and solar systems. ||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਮਾਵਸਿਆ ਚੰਦੁ ਗੁਪਤੁ ਗੈਣਾਰਿ ॥",
      "transliteration": "amaavasiaa cha(n)d gupat gainaar ||",
      "translation": "Amaavas - The Night of the New Moon: The moon is hidden in the sky.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬੂਝਹੁ ਗਿਆਨੀ ਸਬਦੁ ਬੀਚਾਰਿ ॥",
      "transliteration": "boojhahu giaanee sabad beechaar ||",
      "translation": "O wise one, understand and contemplate the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਸੀਅਰੁ ਗਗਨਿ ਜੋਤਿ ਤਿਹੁ ਲੋਈ ॥",
      "transliteration": "saseear gagan jot tihu loee ||",
      "translation": "The moon in the sky illuminates the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਰਿ ਕਰਿ ਵੇਖੈ ਕਰਤਾ ਸੋਈ ॥",
      "transliteration": "kar kar vekhai karataa soee ||",
      "translation": "Creating the creation, the Creator beholds it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗੁਰ ਤੇ ਦੀਸੈ ਸੋ ਤਿਸ ਹੀ ਮਾਹਿ ॥",
      "transliteration": "gur te deesai so tis hee maahi ||",
      "translation": "One who sees, through the Guru, merges into Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਨਮੁਖਿ ਭੂਲੇ ਆਵਹਿ ਜਾਹਿ ॥੧੯॥",
      "transliteration": "manamukh bhoole aavahi jaahi ||19||",
      "translation": "The self-willed manmukhs are deluded, coming and going in reincarnation. ||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਘਰੁ ਦਰੁ ਥਾਪਿ ਥਿਰੁ ਥਾਨਿ ਸੁਹਾਵੈ ॥",
      "transliteration": "ghar dar thaap thir thaan suhaavai ||",
      "translation": "One who establishes his home within his own heart, obtains the most beautiful, permanent place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਆਪੁ ਪਛਾਣੈ ਜਾ ਸਤਿਗੁਰੁ ਪਾਵੈ ॥",
      "transliteration": "aap pachhaanai jaa satigur paavai ||",
      "translation": "One comes to understand his own self, when he finds the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਹ ਆਸਾ ਤਹ ਬਿਨਸਿ ਬਿਨਾਸਾ ॥",
      "transliteration": "jah aasaa tah binas binaasaa ||",
      "translation": "Wherever there is hope, there is destruction and desolation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਫੂਟੈ ਖਪਰੁ ਦੁਬਿਧਾ ਮਨਸਾ ॥",
      "transliteration": "phootai khapar dubidhaa manasaa ||",
      "translation": "The bowl of duality and selfishness breaks.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮਮਤਾ ਜਾਲ ਤੇ ਰਹੈ ਉਦਾਸਾ ॥",
      "transliteration": "mamataa jaal te rahai udaasaa ||",
      "translation": "Prays Nanak, I am the slave of that one,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0840_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਪ੍ਰਣਵਤਿ ਨਾਨਕ ਹਮ ਤਾ ਕੇ ਦਾਸਾ ॥੨੦॥੧॥",
      "transliteration": "pranavat naanak ham taa ke daasaa ||20||1||",
      "translation": "Who remains detached amidst the traps of attachment. ||20||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 840,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
