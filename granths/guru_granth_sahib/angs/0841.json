{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 841,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0841_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੩ ਵਾਰ ਸਤ ਘਰੁ ੧੦ ॥",
      "transliteration": "bilaaval mahalaa 3 vaar sat ghar 10 ||",
      "translation": "Bilaaval, Third Mehl, The Seven Days, Tenth House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਦਿਤ ਵਾਰਿ ਆਦਿ ਪੁਰਖੁ ਹੈ ਸੋਈ ॥",
      "transliteration": "aadit vaar aad purakh hai soee ||",
      "translation": "Sunday: He, the Lord, is the Primal Being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਪੇ ਵਰਤੈ ਅਵਰੁ ਨ ਕੋਈ ॥",
      "transliteration": "aape varatai avar na koee ||",
      "translation": "He Himself is the Pervading Lord; there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਓਤਿ ਪੋਤਿ ਜਗੁ ਰਹਿਆ ਪਰੋਈ ॥",
      "transliteration": "ot pot jag rahiaa paroee ||",
      "translation": "Through and through, He is woven into the fabric of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਪੇ ਕਰਤਾ ਕਰੈ ਸੁ ਹੋਈ ॥",
      "transliteration": "aape karataa karai s hoee ||",
      "translation": "Whatever the Creator Himself does, that alone happens.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਸਦਾ ਸੁਖੁ ਹੋਈ ॥",
      "transliteration": "naam rate sadaa sukh hoee ||",
      "translation": "Imbued with the Naam, the Name of the Lord, one is forever in peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਵਿਰਲਾ ਬੂਝੈ ਕੋਈ ॥੧॥",
      "transliteration": "guramukh viralaa boojhai koee ||1||",
      "translation": "But how rare is the one, who, as Gurmukh, understands this. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਿਰਦੈ ਜਪਨੀ ਜਪਉ ਗੁਣਤਾਸਾ ॥",
      "transliteration": "hiradai japanee japau gunataasaa ||",
      "translation": "Within my heart, I chant the Chant of the Lord, the treasure of virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਰਿ ਅਗਮ ਅਗੋਚਰੁ ਅਪਰੰਪਰ ਸੁਆਮੀ ਜਨ ਪਗਿ ਲਗਿ ਧਿਆਵਉ ਹੋਇ ਦਾਸਨਿ ਦਾਸਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har agam agochar apara(n)par suaamee jan pag lag dhiaavau hoi daasan daasaa ||1|| rahaau ||",
      "translation": "The Lord, my Lord and Master, is inaccessible, unfathomable and unlimited. Grasping the feet of the Lord's humble servants, I meditate on Him, and become the slave of His slaves. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੋਮਵਾਰਿ ਸਚਿ ਰਹਿਆ ਸਮਾਇ ॥",
      "transliteration": "somavaar sach rahiaa samaai ||",
      "translation": "Monday: The True Lord is permeating and pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਿਸ ਕੀ ਕੀਮਤਿ ਕਹੀ ਨ ਜਾਇ ॥",
      "transliteration": "tis kee keemat kahee na jaai ||",
      "translation": "His value cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਖਿ ਆਖਿ ਰਹੇ ਸਭਿ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "aakh aakh rahe sabh liv laai ||",
      "translation": "Talking and speaking about Him, all keep themselves lovingly focused on Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਸੁ ਦੇਵੈ ਤਿਸੁ ਪਲੈ ਪਾਇ ॥",
      "transliteration": "jis devai tis palai paai ||",
      "translation": "Devotion falls into the laps of those whom He so blesses.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਗਮ ਅਗੋਚਰੁ ਲਖਿਆ ਨ ਜਾਇ ॥",
      "transliteration": "agam agochar lakhiaa na jaai ||",
      "translation": "He is inaccessible and unfathomable; He cannot be seen.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਹਰਿ ਰਹਿਆ ਸਮਾਇ ॥੨॥",
      "transliteration": "gur kai sabad har rahiaa samaai ||2||",
      "translation": "Through the Word of the Guru's Shabad, the Lord is seen to be permeating and pervading everywhere. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੰਗਲਿ ਮਾਇਆ ਮੋਹੁ ਉਪਾਇਆ ॥",
      "transliteration": "ma(n)gal maaiaa mohu upaaiaa ||",
      "translation": "Tuesday: The Lord created love and attachment to Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਪੇ ਸਿਰਿ ਸਿਰਿ ਧੰਧੈ ਲਾਇਆ ॥",
      "transliteration": "aape sir sir dha(n)dhai laaiaa ||",
      "translation": "He Himself has enjoined each and every being to their tasks.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਪਿ ਬੁਝਾਏ ਸੋਈ ਬੂਝੈ ॥",
      "transliteration": "aap bujhaae soee boojhai ||",
      "translation": "He alone understands, whom the Lord causes to understand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਦਰੁ ਘਰੁ ਸੂਝੈ ॥",
      "transliteration": "gur kai sabad dar ghar soojhai ||",
      "translation": "Through the Word of the Guru's Shabad, one understands his heart and home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪ੍ਰੇਮ ਭਗਤਿ ਕਰੇ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "prem bhagat kare liv laai ||",
      "translation": "He worships the Lord in loving devotion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹਉਮੈ ਮਮਤਾ ਸਬਦਿ ਜਲਾਇ ॥੩॥",
      "transliteration": "haumai mamataa sabad jalaai ||3||",
      "translation": "His egotism and self-conceit are burnt away by the Shabad. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬੁਧਵਾਰਿ ਆਪੇ ਬੁਧਿ ਸਾਰੁ ॥",
      "transliteration": "budhavaar aape budh saar ||",
      "translation": "Wednesday: He Himself bestows sublime understanding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਕਰਣੀ ਸਬਦੁ ਵੀਚਾਰੁ ॥",
      "transliteration": "guramukh karanee sabad veechaar ||",
      "translation": "The Gurmukh does good deeds, and contemplates the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਮਨੁ ਨਿਰਮਲੁ ਹੋਇ ॥",
      "transliteration": "naam rate man niramal hoi ||",
      "translation": "Imbued with the Naam, the Name of the Lord, the mind become pure and immaculate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਗਾਵੈ ਹਉਮੈ ਮਲੁ ਖੋਇ ॥",
      "transliteration": "har gun gaavai haumai mal khoi ||",
      "translation": "He sings the Glorious Glorious Praises of the Lord, and washes off the filth of egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦਰਿ ਸਚੈ ਸਦ ਸੋਭਾ ਪਾਏ ॥",
      "transliteration": "dar sachai sad sobhaa paae ||",
      "translation": "In the Court of the True Lord, he obtains lasting glory.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਗੁਰ ਸਬਦਿ ਸੁਹਾਏ ॥੪॥",
      "transliteration": "naam rate gur sabad suhaae ||4||",
      "translation": "Imbued with the Naam, he is embellished with the Word of the Guru's Shabad. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਲਾਹਾ ਨਾਮੁ ਪਾਏ ਗੁਰ ਦੁਆਰਿ ॥",
      "transliteration": "laahaa naam paae gur duaar ||",
      "translation": "The profit of the Naam is obtained through the Door of the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਪੇ ਦੇਵੈ ਦੇਵਣਹਾਰੁ ॥",
      "transliteration": "aape devai devanahaar ||",
      "translation": "The Great Giver Himself gives it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੋ ਦੇਵੈ ਤਿਸ ਕਉ ਬਲਿ ਜਾਈਐ ॥",
      "transliteration": "jo devai tis kau bal jaaeeai ||",
      "translation": "I am a sacrifice to the One who gives it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਆਪੁ ਗਵਾਈਐ ॥",
      "transliteration": "gur parasaadee aap gavaaeeai ||",
      "translation": "By Guru's Grace, self-conceit is eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਰਖਹੁ ਉਰ ਧਾਰਿ ॥",
      "transliteration": "naanak naam rakhahu ur dhaar ||",
      "translation": "O Nanak, enshrine the Naam within your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੇਵਣਹਾਰੇ ਕਉ ਜੈਕਾਰੁ ॥੫॥",
      "transliteration": "devanahaare kau jaikaar ||5||",
      "translation": "I celebrate the victory of the Lord, the Great Giver. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਵੀਰਵਾਰਿ ਵੀਰ ਭਰਮਿ ਭੁਲਾਏ ॥",
      "transliteration": "veeravaar veer bharam bhulaae ||",
      "translation": "Thursday: The fifty-two warriors were deluded by doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰੇਤ ਭੂਤ ਸਭਿ ਦੂਜੈ ਲਾਏ ॥",
      "transliteration": "pret bhoot sabh doojai laae ||",
      "translation": "All the goblins and demons are attached to duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਪਿ ਉਪਾਏ ਕਰਿ ਵੇਖੈ ਵੇਕਾ ॥",
      "transliteration": "aap upaae kar vekhai vekaa ||",
      "translation": "God Himself created them, and sees each one distinct.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭਨਾ ਕਰਤੇ ਤੇਰੀ ਟੇਕਾ ॥",
      "transliteration": "sabhanaa karate teree tekaa ||",
      "translation": "O Creator Lord, You are the Support of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਤੇਰੀ ਸਰਣਾਈ ॥",
      "transliteration": "jee ja(n)t teree saranaaee ||",
      "translation": "The beings and creatures are under Your protection.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੋ ਮਿਲੈ ਜਿਸੁ ਲੈਹਿ ਮਿਲਾਈ ॥੬॥",
      "transliteration": "so milai jis laihi milaaee ||6||",
      "translation": "He alone meets You, whom You Yourself meet. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੁਕ੍ਰਵਾਰਿ ਪ੍ਰਭੁ ਰਹਿਆ ਸਮਾਈ ॥",
      "transliteration": "sukravaar prabh rahiaa samaaee ||",
      "translation": "Friday: God is permeating and pervading everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਪਿ ਉਪਾਇ ਸਭ ਕੀਮਤਿ ਪਾਈ ॥",
      "transliteration": "aap upaai sabh keemat paaee ||",
      "translation": "He Himself created all, and appraises the value of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਹੋਵੈ ਸੁ ਕਰੈ ਬੀਚਾਰੁ ॥",
      "transliteration": "guramukh hovai s karai beechaar ||",
      "translation": "One who become Gurmukh, contemplates the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਚੁ ਸੰਜਮੁ ਕਰਣੀ ਹੈ ਕਾਰ ॥",
      "transliteration": "sach sa(n)jam karanee hai kaar ||",
      "translation": "He practices truth and self-restraint.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਵਰਤੁ ਨੇਮੁ ਨਿਤਾਪ੍ਰਤਿ ਪੂਜਾ ॥",
      "transliteration": "varat nem nitaaprat poojaa ||",
      "translation": "Without genuine understanding, all fasts,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਿਨੁ ਬੂਝੇ ਸਭੁ ਭਾਉ ਹੈ ਦੂਜਾ ॥੭॥",
      "transliteration": "bin boojhe sabh bhaau hai doojaa ||7||",
      "translation": "Religious rituals and daily worship services lead only to the love of duality. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਛਨਿਛਰਵਾਰਿ ਸਉਣ ਸਾਸਤ ਬੀਚਾਰੁ ॥",
      "transliteration": "chhanichharavaar saun saasat beechaar ||",
      "translation": "Saturday: Contemplating good omens and the Shaastras,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹਉਮੈ ਮੇਰਾ ਭਰਮੈ ਸੰਸਾਰੁ ॥",
      "transliteration": "haumai meraa bharamai sa(n)saar ||",
      "translation": "in egotism and self-conceit, the world wanders in delusion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮਨਮੁਖੁ ਅੰਧਾ ਦੂਜੈ ਭਾਇ ॥",
      "transliteration": "manamukh a(n)dhaa doojai bhaai ||",
      "translation": "The blind, self-willed manmukh in engrossed in the love of duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਮ ਦਰਿ ਬਾਧਾ ਚੋਟਾ ਖਾਇ ॥",
      "transliteration": "jam dar baadhaa chotaa khaai ||",
      "translation": "Bound and gagged at death's door, he is beaten and punished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਸਦਾ ਸੁਖੁ ਪਾਏ ॥",
      "transliteration": "gur parasaadee sadaa sukh paae ||",
      "translation": "By Guru's Grace, one finds lasting peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਚੁ ਕਰਣੀ ਸਾਚਿ ਲਿਵ ਲਾਏ ॥੮॥",
      "transliteration": "sach karanee saach liv laae ||8||",
      "translation": "He practices Truth, and lovingly focuses on the Truth. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵਹਿ ਸੇ ਵਡਭਾਗੀ ॥",
      "transliteration": "satigur sevahi se vadabhaagee ||",
      "translation": "Those who serve the True Guru are very fortunate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਹਉਮੈ ਮਾਰਿ ਸਚਿ ਲਿਵ ਲਾਗੀ ॥",
      "transliteration": "haumai maar sach liv laagee ||",
      "translation": "Conquering their ego, they embrace love for the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0841_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤੇਰੈ ਰੰਗਿ ਰਾਤੇ ਸਹਜਿ ਸੁਭਾਇ ॥",
      "transliteration": "terai ra(n)g raate sahaj subhaai ||",
      "translation": "They are automatically imbued with Your Love, O Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 841,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
