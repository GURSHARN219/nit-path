{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 842,
  "lineCount": 63,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0842_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤੂ ਸੁਖਦਾਤਾ ਲੈਹਿ ਮਿਲਾਇ ॥",
      "transliteration": "too sukhadaataa laihi milaai ||",
      "translation": "You are the Giver of peace; You merge them into Yourself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਏਕਸ ਤੇ ਦੂਜਾ ਨਾਹੀ ਕੋਇ ॥",
      "transliteration": "ekas te doojaa naahee koi ||",
      "translation": "Everything comes from the One and only Lord; there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਬੂਝੈ ਸੋਝੀ ਹੋਇ ॥੯॥",
      "transliteration": "guramukh boojhai sojhee hoi ||9||",
      "translation": "The Gurmukh realizes this, and understands. ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪੰਦ੍ਰਹ ਥਿਤਂੀ ਤੈ ਸਤ ਵਾਰ ॥",
      "transliteration": "pa(n)drah thita(n)ee tai sat vaar ||",
      "translation": "The fifteen lunar days, the seven days of the week,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਾਹਾ ਰੁਤੀ ਆਵਹਿ ਵਾਰ ਵਾਰ ॥",
      "transliteration": "maahaa rutee aavahi vaar vaar ||",
      "translation": "the months, seasons, days and nights, come over and over again;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦਿਨਸੁ ਰੈਣਿ ਤਿਵੈ ਸੰਸਾਰੁ ॥",
      "transliteration": "dinas rain tivai sa(n)saar ||",
      "translation": "so the world goes on.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਵਾ ਗਉਣੁ ਕੀਆ ਕਰਤਾਰਿ ॥",
      "transliteration": "aavaa gaun keeaa karataar ||",
      "translation": "Coming and going were created by the Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਿਹਚਲੁ ਸਾਚੁ ਰਹਿਆ ਕਲ ਧਾਰਿ ॥",
      "transliteration": "nihachal saach rahiaa kal dhaar ||",
      "translation": "The True Lord remains steady and stable, by His almighty power.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਬੂਝੈ ਕੋ ਸਬਦੁ ਵੀਚਾਰਿ ॥੧੦॥੧॥",
      "transliteration": "naanak guramukh boojhai ko sabad veechaar ||10||1||",
      "translation": "O Nanak, how rare is that Gurmukh who understands, and contemplates the Naam, the Name of the Lord. ||10||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "bilaaval mahalaa 3 ||",
      "translation": "Bilaaval, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਦਿ ਪੁਰਖੁ ਆਪੇ ਸ੍ਰਿਸਟਿ ਸਾਜੇ ॥",
      "transliteration": "aad purakh aape srisat saaje ||",
      "translation": "The Primal Lord Himself formed the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਮਾਇਆ ਮੋਹਿ ਪਾਜੇ ॥",
      "transliteration": "jee ja(n)t maaiaa mohi paaje ||",
      "translation": "The beings and creatures are engrossed in emotional attachment to Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੂਜੈ ਭਾਇ ਪਰਪੰਚਿ ਲਾਗੇ ॥",
      "transliteration": "doojai bhaai parapa(n)ch laage ||",
      "translation": "In the love of duality, they are attached to the illusory material world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਵਹਿ ਜਾਵਹਿ ਮਰਹਿ ਅਭਾਗੇ ॥",
      "transliteration": "aavahi jaavahi marahi abhaage ||",
      "translation": "The unfortunate ones die, and continue to come and go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਭੇਟਿਐ ਸੋਝੀ ਪਾਇ ॥",
      "transliteration": "satigur bhetiai sojhee paai ||",
      "translation": "Meeting with the True Guru, understanding is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਰਪੰਚੁ ਚੂਕੈ ਸਚਿ ਸਮਾਇ ॥੧॥",
      "transliteration": "parapa(n)ch chookai sach samaai ||1||",
      "translation": "Then, the illusion of the material world is shattered, and one merges in Truth. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਾ ਕੈ ਮਸਤਕਿ ਲਿਖਿਆ ਲੇਖੁ ॥",
      "transliteration": "jaa kai masatak likhiaa lekh ||",
      "translation": "One who has such pre-ordained destiny inscribed upon his forehead",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਾ ਕੈ ਮਨਿ ਵਸਿਆ ਪ੍ਰਭੁ ਏਕੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "taa kai man vasiaa prabh ek ||1|| rahaau ||",
      "translation": "- the One God abides within his mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸ੍ਰਿਸਟਿ ਉਪਾਇ ਆਪੇ ਸਭੁ ਵੇਖੈ ॥",
      "transliteration": "srisat upaai aape sabh vekhai ||",
      "translation": "He created the Universe, and He Himself beholds all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕੋਇ ਨ ਮੇਟੈ ਤੇਰੈ ਲੇਖੈ ॥",
      "transliteration": "koi na metai terai lekhai ||",
      "translation": "No one can erase Your record, Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਿਧ ਸਾਧਿਕ ਜੇ ਕੋ ਕਹੈ ਕਹਾਏ ॥",
      "transliteration": "sidh saadhik je ko kahai kahaae ||",
      "translation": "If someone calls himself a Siddha or a seeker,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭਰਮੇ ਭੂਲਾ ਆਵੈ ਜਾਏ ॥",
      "transliteration": "bharame bhoolaa aavai jaae ||",
      "translation": "he is deluded by doubt, and will continue coming and going.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵੈ ਸੋ ਜਨੁ ਬੂਝੈ ॥",
      "transliteration": "satigur sevai so jan boojhai ||",
      "translation": "That humble being alone understands, who serves the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਉਮੈ ਮਾਰੇ ਤਾ ਦਰੁ ਸੂਝੈ ॥੨॥",
      "transliteration": "haumai maare taa dar soojhai ||2||",
      "translation": "Conquering his ego, he finds the Lord's Door. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਏਕਸੁ ਤੇ ਸਭੁ ਦੂਜਾ ਹੂਆ ॥",
      "transliteration": "ekas te sabh doojaa hooaa ||",
      "translation": "From the One Lord, all others were formed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਏਕੋ ਵਰਤੈ ਅਵਰੁ ਨ ਬੀਆ ॥",
      "transliteration": "eko varatai avar na beeaa ||",
      "translation": "The One Lord is pervading everywhere; there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੂਜੇ ਤੇ ਜੇ ਏਕੋ ਜਾਣੈ ॥",
      "transliteration": "dooje te je eko jaanai ||",
      "translation": "Renouncing duality, one comes to know the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਹਰਿ ਦਰਿ ਨੀਸਾਣੈ ॥",
      "transliteration": "gur kai sabad har dar neesaanai ||",
      "translation": "Through the Word of the Guru's Shabad, one knows the Lord's Door, and His Banner.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਭੇਟੇ ਤਾ ਏਕੋ ਪਾਏ ॥",
      "transliteration": "satigur bhete taa eko paae ||",
      "translation": "Meeting the True Guru, one finds the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਵਿਚਹੁ ਦੂਜਾ ਠਾਕਿ ਰਹਾਏ ॥੩॥",
      "transliteration": "vichahu doojaa thaak rahaae ||3||",
      "translation": "Duality is subdued within. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਸ ਦਾ ਸਾਹਿਬੁ ਡਾਢਾ ਹੋਇ ॥",
      "transliteration": "jis daa saahib daadhaa hoi ||",
      "translation": "One who belongs to the All-powerful Lord and Master",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਿਸ ਨੋ ਮਾਰਿ ਨ ਸਾਕੈ ਕੋਇ ॥",
      "transliteration": "tis no maar na saakai koi ||",
      "translation": "no one can destroy him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਾਹਿਬ ਕੀ ਸੇਵਕੁ ਰਹੈ ਸਰਣਾਈ ॥",
      "transliteration": "saahib kee sevak rahai saranaaee ||",
      "translation": "The Lord's servant remains under His protection;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਪੇ ਬਖਸੇ ਦੇ ਵਡਿਆਈ ॥",
      "transliteration": "aape bakhase de vadiaaee ||",
      "translation": "The Lord Himself forgives him, and blesses him with glorious greatness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਿਸ ਤੇ ਊਪਰਿ ਨਾਹੀ ਕੋਇ ॥",
      "transliteration": "tis te oopar naahee koi ||",
      "translation": "There is none higher than Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਉਣੁ ਡਰੈ ਡਰੁ ਕਿਸ ਕਾ ਹੋਇ ॥੪॥",
      "transliteration": "kaun darai dar kis kaa hoi ||4||",
      "translation": "Why should he be afraid? What should he ever fear? ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰਮਤੀ ਸਾਂਤਿ ਵਸੈ ਸਰੀਰ ॥",
      "transliteration": "guramatee saa(n)t vasai sareer ||",
      "translation": "Through the Guru's Teachings, peace and tranquility abide within the body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਬਦੁ ਚੀਨੑਿ ਫਿਰਿ ਲਗੈ ਨ ਪੀਰ ॥",
      "transliteration": "sabad cheenhi phir lagai na peer ||",
      "translation": "Remember the Word of the Shabad, and you shall never suffer pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਵੈ ਨ ਜਾਇ ਨਾ ਦੁਖੁ ਪਾਏ ॥",
      "transliteration": "aavai na jaai naa dukh paae ||",
      "translation": "You shall not have to come or go, or suffer in sorrow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾਮੇ ਰਾਤੇ ਸਹਜਿ ਸਮਾਏ ॥",
      "transliteration": "naame raate sahaj samaae ||",
      "translation": "Imbued with the Naam, the Name of the Lord, you shall merge in celestial peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਵੇਖੈ ਹਦੂਰਿ ॥",
      "transliteration": "naanak guramukh vekhai hadoor ||",
      "translation": "O Nanak, the Gurmukh beholds Him ever-present, close at hand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮੇਰਾ ਪ੍ਰਭੁ ਸਦ ਰਹਿਆ ਭਰਪੂਰਿ ॥੫॥",
      "transliteration": "meraa prabh sad rahiaa bharapoor ||5||",
      "translation": "My God is always fully pervading everywhere. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਕਿ ਸੇਵਕ ਇਕਿ ਭਰਮਿ ਭੁਲਾਏ ॥",
      "transliteration": "ik sevak ik bharam bhulaae ||",
      "translation": "Some are selfless servants, while others wander, deluded by doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਆਪੇ ਕਰੇ ਹਰਿ ਆਪਿ ਕਰਾਏ ॥",
      "transliteration": "aape kare har aap karaae ||",
      "translation": "The Lord Himself does, and causes everything to be done.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਏਕੋ ਵਰਤੈ ਅਵਰੁ ਨ ਕੋਇ ॥",
      "transliteration": "eko varatai avar na koi ||",
      "translation": "The One Lord is all-pervading; there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਨਿ ਰੋਸੁ ਕੀਜੈ ਜੇ ਦੂਜਾ ਹੋਇ ॥",
      "transliteration": "man ros keejai je doojaa hoi ||",
      "translation": "The mortal might complain, if there were any other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵੇ ਕਰਣੀ ਸਾਰੀ ॥",
      "transliteration": "satigur seve karanee saaree ||",
      "translation": "Serve the True Guru; this is the most excellent action.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦਰਿ ਸਾਚੈ ਸਾਚੇ ਵੀਚਾਰੀ ॥੬॥",
      "transliteration": "dar saachai saache veechaaree ||6||",
      "translation": "In the Court of the True Lord, you shall be judged true. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਥਿਤੀ ਵਾਰ ਸਭਿ ਸਬਦਿ ਸੁਹਾਏ ॥",
      "transliteration": "thitee vaar sabh sabad suhaae ||",
      "translation": "All the lunar days, and the days of the week are beautiful, when one contemplates the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵੇ ਤਾ ਫਲੁ ਪਾਏ ॥",
      "transliteration": "satigur seve taa phal paae ||",
      "translation": "If one serves the True Guru, he obtains the fruits of his rewards.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਥਿਤੀ ਵਾਰ ਸਭਿ ਆਵਹਿ ਜਾਹਿ ॥",
      "transliteration": "thitee vaar sabh aavahi jaahi ||",
      "translation": "The omens and days all come and go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰਸਬਦੁ ਨਿਹਚਲੁ ਸਦਾ ਸਚਿ ਸਮਾਹਿ ॥",
      "transliteration": "gurasabad nihachal sadaa sach samaahi ||",
      "translation": "But the Word of the Guru's Shabad is eternal and unchanging. Through it, one merges in the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਥਿਤੀ ਵਾਰ ਤਾ ਜਾ ਸਚਿ ਰਾਤੇ ॥",
      "transliteration": "thitee vaar taa jaa sach raate ||",
      "translation": "The days are auspicious, when one is imbued with Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਸਭਿ ਭਰਮਹਿ ਕਾਚੇ ॥੭॥",
      "transliteration": "bin naavai sabh bharamahi kaache ||7||",
      "translation": "Without the Name, all the false ones wander deluded. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮਨਮੁਖ ਮਰਹਿ ਮਰਿ ਬਿਗਤੀ ਜਾਹਿ ॥",
      "transliteration": "manamukh marahi mar bigatee jaahi ||",
      "translation": "The self-willed manmukhs die, and dead, they fall into the most evil state.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਏਕੁ ਨ ਚੇਤਹਿ ਦੂਜੈ ਲੋਭਾਹਿ ॥",
      "transliteration": "ek na chetahi doojai lobhaahi ||",
      "translation": "They do not remember the One Lord; they are deluded by duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਅਚੇਤ ਪਿੰਡੀ ਅਗਿਆਨ ਅੰਧਾਰੁ ॥",
      "transliteration": "achet pi(n)dee agiaan a(n)dhaar ||",
      "translation": "The human body is unconscious, ignorant and blind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਬਿਨੁ ਸਬਦੈ ਕਿਉ ਪਾਏ ਪਾਰੁ ॥",
      "transliteration": "bin sabadai kiu paae paar ||",
      "translation": "Without the Word of the Shabad, how can anyone cross over?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਆਪਿ ਉਪਾਏ ਉਪਾਵਣਹਾਰੁ ॥",
      "transliteration": "aap upaae upaavanahaar ||",
      "translation": "The Creator Himself creates.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਆਪੇ ਕੀਤੋਨੁ ਗੁਰ ਵੀਚਾਰੁ ॥੮॥",
      "transliteration": "aape keeton gur veechaar ||8||",
      "translation": "He Himself contemplates the Guru's Word. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਬਹੁਤੇ ਭੇਖ ਕਰਹਿ ਭੇਖਧਾਰੀ ॥",
      "transliteration": "bahute bhekh karahi bhekhadhaaree ||",
      "translation": "The religious fanatics wear all sorts of religious robes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਭਵਿ ਭਵਿ ਭਰਮਹਿ ਕਾਚੀ ਸਾਰੀ ॥",
      "transliteration": "bhav bhav bharamahi kaachee saaree ||",
      "translation": "They roll around and wander around, like the false dice on the board.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0842_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਐਥੈ ਸੁਖੁ ਨ ਆਗੈ ਹੋਇ ॥",
      "transliteration": "aithai sukh na aagai hoi ||",
      "translation": "They find no peace, here or hereafter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 842,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
