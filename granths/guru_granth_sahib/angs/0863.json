{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 863,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0863_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਲਾਲ ਨਾਮ ਜਾ ਕੈ ਭਰੇ ਭੰਡਾਰ ॥",
      "transliteration": "laal naam jaa kai bhare bha(n)daar ||",
      "translation": "His treasure is overflowing with the rubies of the Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਗਲ ਘਟਾ ਦੇਵੈ ਆਧਾਰ ॥੩॥",
      "transliteration": "sagal ghataa devai aadhaar ||3||",
      "translation": "He gives Support to all hearts. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਤਿ ਪੁਰਖੁ ਜਾ ਕੋ ਹੈ ਨਾਉ ॥",
      "transliteration": "sat purakh jaa ko hai naau ||",
      "translation": "The Name is the True Primal Being;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਿਟਹਿ ਕੋਟਿ ਅਘ ਨਿਮਖ ਜਸੁ ਗਾਉ ॥",
      "transliteration": "mitahi kot agh nimakh jas gaau ||",
      "translation": "millions of sins are washed away in an instant, singing His Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਾਲ ਸਖਾਈ ਭਗਤਨ ਕੋ ਮੀਤ ॥",
      "transliteration": "baal sakhaaee bhagatan ko meet ||",
      "translation": "The Lord God is your best friend, your playmate from earliest childhood.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪ੍ਰਾਨ ਅਧਾਰ ਨਾਨਕ ਹਿਤ ਚੀਤ ॥੪॥੧॥੩॥",
      "transliteration": "praan adhaar naanak hit cheet ||4||1||3||",
      "translation": "He is the Support of the breath of life; O Nanak, He is love, He is consciousness. ||4||1||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਮ ਸੰਗਿ ਕੀਨੋ ਬਿਉਹਾਰੁ ॥",
      "transliteration": "naam sa(n)g keeno biuhaar ||",
      "translation": "I trade in the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਮੋੁ ਹੀ ਇਸੁ ਮਨ ਕਾ ਅਧਾਰੁ ॥",
      "transliteration": "naamou hee is man kaa adhaar ||",
      "translation": "The Naam is the Support of the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਮੋ ਹੀ ਚਿਤਿ ਕੀਨੀ ਓਟ ॥",
      "transliteration": "naamo hee chit keenee ot ||",
      "translation": "My consciousness takes to the Shelter of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਮਿਟਹਿ ਪਾਪ ਕੋਟਿ ॥੧॥",
      "transliteration": "naam japat mitahi paap kot ||1||",
      "translation": "Chanting the Naam, millions of sins are erased. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਸਿ ਦੀਈ ਹਰਿ ਏਕੋ ਨਾਮੁ ॥",
      "transliteration": "raas deeee har eko naam ||",
      "translation": "The Lord has blessed me with the wealth of the Naam, the Name of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਨ ਕਾ ਇਸਟੁ ਗੁਰ ਸੰਗਿ ਧਿਆਨੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "man kaa isat gur sa(n)g dhiaan ||1|| rahaau ||",
      "translation": "The wish of my mind is to meditate on the Naam, in association with the Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੇ ਜੀਅ ਕੀ ਰਾਸਿ ॥",
      "transliteration": "naam hamaare jee kee raas ||",
      "translation": "The Naam is the wealth of my soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਮੋ ਸੰਗੀ ਜਤ ਕਤ ਜਾਤ ॥",
      "transliteration": "naamo sa(n)gee jat kat jaat ||",
      "translation": "Wherever I go, the Naam is with me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਮੋ ਹੀ ਮਨਿ ਲਾਗਾ ਮੀਠਾ ॥",
      "transliteration": "naamo hee man laagaa meethaa ||",
      "translation": "The Naam is sweet to my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਲਿ ਥਲਿ ਸਭ ਮਹਿ ਨਾਮੋ ਡੀਠਾ ॥੨॥",
      "transliteration": "jal thal sabh mahi naamo deethaa ||2||",
      "translation": "In the water, on the land, and everywhere, I see the Naam. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮੇ ਦਰਗਹ ਮੁਖ ਉਜਲੇ ॥",
      "transliteration": "naame daragah mukh ujale ||",
      "translation": "Through the Naam, one's face becomes radiant in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਮੇ ਸਗਲੇ ਕੁਲ ਉਧਰੇ ॥",
      "transliteration": "naame sagale kul udhare ||",
      "translation": "Through the Naam, all one's generations are saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਮਿ ਹਮਾਰੇ ਕਾਰਜ ਸੀਧ ॥",
      "transliteration": "naam hamaare kaaraj seedh ||",
      "translation": "Through the Naam, my affairs are resolved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਮ ਸੰਗਿ ਇਹੁ ਮਨੂਆ ਗੀਧ ॥੩॥",
      "transliteration": "naam sa(n)g ihu manooaa geedh ||3||",
      "translation": "My mind is accustomed to the Naam. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਮੇ ਹੀ ਹਮ ਨਿਰਭਉ ਭਏ ॥",
      "transliteration": "naame hee ham nirabhau bhae ||",
      "translation": "Through the Naam, I have become fearless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਮੇ ਆਵਨ ਜਾਵਨ ਰਹੇ ॥",
      "transliteration": "naame aavan jaavan rahe ||",
      "translation": "Through the Naam, my comings and goings have ceased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਮੇਲੇ ਗੁਣਤਾਸ ॥",
      "transliteration": "gur poorai mele gunataas ||",
      "translation": "The Perfect Guru has united me with the Lord, the treasure of virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਸੁਖਿ ਸਹਜਿ ਨਿਵਾਸੁ ॥੪॥੨॥੪॥",
      "transliteration": "kahu naanak sukh sahaj nivaas ||4||2||4||",
      "translation": "Says Nanak, I dwell in celestial peace. ||4||2||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਿਮਾਨੇ ਕਉ ਜੋ ਦੇਤੋ ਮਾਨੁ ॥",
      "transliteration": "nimaane kau jo deto maan ||",
      "translation": "He grants honor to the dishonored,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਗਲ ਭੂਖੇ ਕਉ ਕਰਤਾ ਦਾਨੁ ॥",
      "transliteration": "sagal bhookhe kau karataa daan ||",
      "translation": "and gives gifts to all the hungry;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗਰਭ ਘੋਰ ਮਹਿ ਰਾਖਨਹਾਰੁ ॥",
      "transliteration": "garabh ghor mahi raakhanahaar ||",
      "translation": "he protects those in the terrible womb.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਿਸੁ ਠਾਕੁਰ ਕਉ ਸਦਾ ਨਮਸਕਾਰੁ ॥੧॥",
      "transliteration": "tis thaakur kau sadaa namasakaar ||1||",
      "translation": "So humbly bow forever to that Lord and Master. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਐਸੋ ਪ੍ਰਭੁ ਮਨ ਮਾਹਿ ਧਿਆਇ ॥",
      "transliteration": "aiso prabh man maahi dhiaai ||",
      "translation": "Meditate on such a God in your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਘਟਿ ਅਵਘਟਿ ਜਤ ਕਤਹਿ ਸਹਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ghat avaghat jat katahi sahaai ||1|| rahaau ||",
      "translation": "He shall be your help and support everywhere, in good times and bad. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰੰਕੁ ਰਾਉ ਜਾ ਕੈ ਏਕ ਸਮਾਨਿ ॥",
      "transliteration": "ra(n)k raau jaa kai ek samaan ||",
      "translation": "The beggar and the king are all the same to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕੀਟ ਹਸਤਿ ਸਗਲ ਪੂਰਾਨ ॥",
      "transliteration": "keet hasat sagal pooraan ||",
      "translation": "He sustains and fulfills both the ant and the elephant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬੀਓ ਪੂਛਿ ਨ ਮਸਲਤਿ ਧਰੈ ॥",
      "transliteration": "beeo poochh na masalat dharai ||",
      "translation": "He does not consult or seek anyone's advice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕਰੈ ਸੁ ਆਪਹਿ ਕਰੈ ॥੨॥",
      "transliteration": "jo kichh karai s aapahi karai ||2||",
      "translation": "Whatever He does, He does Himself. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਾ ਕਾ ਅੰਤੁ ਨ ਜਾਨਸਿ ਕੋਇ ॥",
      "transliteration": "jaa kaa a(n)t na jaanas koi ||",
      "translation": "No one knows His limit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਪੇ ਆਪਿ ਨਿਰੰਜਨੁ ਸੋਇ ॥",
      "transliteration": "aape aap nira(n)jan soi ||",
      "translation": "He Himself is the Immaculate Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਪਿ ਅਕਾਰੁ ਆਪਿ ਨਿਰੰਕਾਰੁ ॥",
      "transliteration": "aap akaar aap nira(n)kaar ||",
      "translation": "He Himself is formed, and He Himself is formless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਘਟ ਘਟ ਘਟਿ ਸਭ ਘਟ ਆਧਾਰੁ ॥੩॥",
      "transliteration": "ghat ghat ghat sabh ghat aadhaar ||3||",
      "translation": "In the heart, in each and every heart, He is the Support of all hearts. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਮ ਰੰਗਿ ਭਗਤ ਭਏ ਲਾਲ ॥",
      "transliteration": "naam ra(n)g bhagat bhae laal ||",
      "translation": "Through the Love of the Naam, the Name of the Lord, the devotees become His Beloveds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਸੁ ਕਰਤੇ ਸੰਤ ਸਦਾ ਨਿਹਾਲ ॥",
      "transliteration": "jas karate sa(n)t sadaa nihaal ||",
      "translation": "Singing the Praises of the Creator, the Saints are forever in bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਮ ਰੰਗਿ ਜਨ ਰਹੇ ਅਘਾਇ ॥",
      "transliteration": "naam ra(n)g jan rahe aghaai ||",
      "translation": "Through the Love of the Naam, the Lord's humble servants remain satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਤਿਨ ਜਨ ਲਾਗੈ ਪਾਇ ॥੪॥੩॥੫॥",
      "transliteration": "naanak tin jan laagai paai ||4||3||5||",
      "translation": "Nanak falls at the feet of those humble servants of the Lord. ||4||3||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਾ ਕੈ ਸੰਗਿ ਇਹੁ ਮਨੁ ਨਿਰਮਲੁ ॥",
      "transliteration": "jaa kai sa(n)g ihu man niramal ||",
      "translation": "Associating with them, this mind becomes immaculate and pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਾ ਕੈ ਸੰਗਿ ਹਰਿ ਹਰਿ ਸਿਮਰਨੁ ॥",
      "transliteration": "jaa kai sa(n)g har har simaran ||",
      "translation": "Associating with them, one meditates in remembrance on the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਾ ਕੈ ਸੰਗਿ ਕਿਲਬਿਖ ਹੋਹਿ ਨਾਸ ॥",
      "transliteration": "jaa kai sa(n)g kilabikh hohi naas ||",
      "translation": "Associating with them, all the sins are erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਾ ਕੈ ਸੰਗਿ ਰਿਦੈ ਪਰਗਾਸ ॥੧॥",
      "transliteration": "jaa kai sa(n)g ridai paragaas ||1||",
      "translation": "Associating with them, the heart is illumined. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੇ ਸੰਤਨ ਹਰਿ ਕੇ ਮੇਰੇ ਮੀਤ ॥",
      "transliteration": "se sa(n)tan har ke mere meet ||",
      "translation": "Those Saints of the Lord are my friends.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕੇਵਲ ਨਾਮੁ ਗਾਈਐ ਜਾ ਕੈ ਨੀਤ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "keval naam gaaeeai jaa kai neet ||1|| rahaau ||",
      "translation": "It is their custom to sing only the Naam, the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਾ ਕੈ ਮੰਤ੍ਰਿ ਹਰਿ ਹਰਿ ਮਨਿ ਵਸੈ ॥",
      "transliteration": "jaa kai ma(n)tr har har man vasai ||",
      "translation": "By their mantra, the Lord, Har, Har, dwells in the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਾ ਕੈ ਉਪਦੇਸਿ ਭਰਮੁ ਭਉ ਨਸੈ ॥",
      "transliteration": "jaa kai upades bharam bhau nasai ||",
      "translation": "By their teachings, doubt and fear are dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਾ ਕੈ ਕੀਰਤਿ ਨਿਰਮਲ ਸਾਰ ॥",
      "transliteration": "jaa kai keerat niramal saar ||",
      "translation": "By their kirtan, they become immaculate and sublime.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਾ ਕੀ ਰੇਨੁ ਬਾਂਛੈ ਸੰਸਾਰ ॥੨॥",
      "transliteration": "jaa kee ren baa(n)chhai sa(n)saar ||2||",
      "translation": "The world longs for the dust of their feet. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕੋਟਿ ਪਤਿਤ ਜਾ ਕੈ ਸੰਗਿ ਉਧਾਰ ॥",
      "transliteration": "kot patit jaa kai sa(n)g udhaar ||",
      "translation": "Millions of sinners are saved by associating with them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਏਕੁ ਨਿਰੰਕਾਰੁ ਜਾ ਕੈ ਨਾਮ ਅਧਾਰ ॥",
      "transliteration": "ek nira(n)kaar jaa kai naam adhaar ||",
      "translation": "They have the Support of the Name of the One Formless Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸਰਬ ਜੀਆਂ ਕਾ ਜਾਨੈ ਭੇਉ ॥",
      "transliteration": "sarab jeeaa(n) kaa jaanai bheu ||",
      "translation": "He knows the secrets of all beings;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਨਿਧਾਨ ਨਿਰੰਜਨ ਦੇਉ ॥੩॥",
      "transliteration": "kripaa nidhaan nira(n)jan deu ||3||",
      "translation": "He is the treasure of mercy, the divine immaculate Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਜਬ ਭਏ ਕ੍ਰਿਪਾਲ ॥",
      "transliteration": "paarabraham jab bhae kripaal ||",
      "translation": "When the Supreme Lord God becomes merciful,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0863_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਤਬ ਭੇਟੇ ਗੁਰ ਸਾਧ ਦਇਆਲ ॥",
      "transliteration": "tab bhete gur saadh daiaal ||",
      "translation": "then one meets the Merciful Holy Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 863,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
