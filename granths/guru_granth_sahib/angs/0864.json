{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 864,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0864_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦਿਨੁ ਰੈਣਿ ਨਾਨਕੁ ਨਾਮੁ ਧਿਆਏ ॥",
      "transliteration": "din rain naanak naam dhiaae ||",
      "translation": "Day and night, Nanak meditates on the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਆਨੰਦ ਹਰਿ ਨਾਏ ॥੪॥੪॥੬॥",
      "transliteration": "sookh sahaj aana(n)d har naae ||4||4||6||",
      "translation": "Through the Lord's Name, he is blessed with peace, poise and bliss. ||4||4||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰ ਕੀ ਮੂਰਤਿ ਮਨ ਮਹਿ ਧਿਆਨੁ ॥",
      "transliteration": "gur kee moorat man mahi dhiaan ||",
      "translation": "Meditate on the image of the Guru within your mind;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਮੰਤ੍ਰੁ ਮਨੁ ਮਾਨ ॥",
      "transliteration": "gur kai sabad ma(n)tr man maan ||",
      "translation": "let your mind accept the Word of the Guru's Shabad, and His Mantra.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਨ ਰਿਦੈ ਲੈ ਧਾਰਉ ॥",
      "transliteration": "gur ke charan ridai lai dhaarau ||",
      "translation": "Enshrine the Guru's feet within your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਰੁ ਪਾਰਬ੍ਰਹਮੁ ਸਦਾ ਨਮਸਕਾਰਉ ॥੧॥",
      "transliteration": "gur paarabraham sadaa namasakaarau ||1||",
      "translation": "Bow in humility forever before the Guru, the Supreme Lord God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਤ ਕੋ ਭਰਮਿ ਭੁਲੈ ਸੰਸਾਰਿ ॥",
      "transliteration": "mat ko bharam bhulai sa(n)saar ||",
      "translation": "Let no one wander in doubt in the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰ ਬਿਨੁ ਕੋਇ ਨ ਉਤਰਸਿ ਪਾਰਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur bin koi na utaras paar ||1|| rahaau ||",
      "translation": "Without the Guru, no one can cross over. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭੂਲੇ ਕਉ ਗੁਰਿ ਮਾਰਗਿ ਪਾਇਆ ॥",
      "transliteration": "bhoole kau gur maarag paaiaa ||",
      "translation": "The Guru shows the Path to those who have wandered off.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਵਰ ਤਿਆਗਿ ਹਰਿ ਭਗਤੀ ਲਾਇਆ ॥",
      "transliteration": "avar tiaag har bhagatee laaiaa ||",
      "translation": "He leads them to renounce others, and attaches them to devotional worship of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਨਮ ਮਰਨ ਕੀ ਤ੍ਰਾਸ ਮਿਟਾਈ ॥",
      "transliteration": "janam maran kee traas mitaaee ||",
      "translation": "He obliterates the fear of birth and death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕੀ ਬੇਅੰਤ ਵਡਾਈ ॥੨॥",
      "transliteration": "gur poore kee bea(n)t vadaaee ||2||",
      "translation": "The glorious greatness of the Perfect Guru is endless. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਊਰਧ ਕਮਲ ਬਿਗਾਸ ॥",
      "transliteration": "gur prasaad ooradh kamal bigaas ||",
      "translation": "By Guru's Grace, the inverted heart-lotus blossoms forth,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅੰਧਕਾਰ ਮਹਿ ਭਇਆ ਪ੍ਰਗਾਸ ॥",
      "transliteration": "a(n)dhakaar mahi bhaiaa pragaas ||",
      "translation": "and the Light shines forth in the darkness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਨਿ ਕੀਆ ਸੋ ਗੁਰ ਤੇ ਜਾਨਿਆ ॥",
      "transliteration": "jin keeaa so gur te jaaniaa ||",
      "translation": "Through the Guru, know the One who created you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਮੁਗਧ ਮਨੁ ਮਾਨਿਆ ॥੩॥",
      "transliteration": "gur kirapaa te mugadh man maaniaa ||3||",
      "translation": "By the Guru's Mercy, the foolish mind comes to believe. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰੁ ਕਰਤਾ ਗੁਰੁ ਕਰਣੈ ਜੋਗੁ ॥",
      "transliteration": "gur karataa gur karanai jog ||",
      "translation": "The Guru is the Creator; the Guru has the power to do everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੁਰੁ ਪਰਮੇਸਰੁ ਹੈ ਭੀ ਹੋਗੁ ॥",
      "transliteration": "gur paramesar hai bhee hog ||",
      "translation": "The Guru is the Transcendent Lord; He is, and always shall be.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਪ੍ਰਭਿ ਇਹੈ ਜਨਾਈ ॥",
      "transliteration": "kahu naanak prabh ihai janaaee ||",
      "translation": "Says Nanak, God has inspired me to know this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਮੁਕਤਿ ਨ ਪਾਈਐ ਭਾਈ ॥੪॥੫॥੭॥",
      "transliteration": "bin gur mukat na paaeeai bhaaee ||4||5||7||",
      "translation": "Without the Guru, liberation is not obtained, O Siblings of Destiny. ||4||5||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਰੂ ਗੁਰੂ ਗੁਰੁ ਕਰਿ ਮਨ ਮੋਰ ॥",
      "transliteration": "guroo guroo gur kar man mor ||",
      "translation": "Chant Guru, Guru, Guru, O my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਰੂ ਬਿਨਾ ਮੈ ਨਾਹੀ ਹੋਰ ॥",
      "transliteration": "guroo binaa mai naahee hor ||",
      "translation": "I have no other than the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰ ਕੀ ਟੇਕ ਰਹਹੁ ਦਿਨੁ ਰਾਤਿ ॥",
      "transliteration": "gur kee tek rahahu din raat ||",
      "translation": "I lean upon the Support of the Guru, day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾ ਕੀ ਕੋਇ ਨ ਮੇਟੈ ਦਾਤਿ ॥੧॥",
      "transliteration": "jaa kee koi na metai daat ||1||",
      "translation": "No one can decrease His bounty. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗੁਰੁ ਪਰਮੇਸਰੁ ਏਕੋ ਜਾਣੁ ॥",
      "transliteration": "gur paramesar eko jaan ||",
      "translation": "Know that the Guru and the Transcendent Lord are One.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੋ ਪਰਵਾਣੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jo tis bhaavai so paravaan ||1|| rahaau ||",
      "translation": "Whatever pleases Him is acceptable and approved. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰ ਚਰਣੀ ਜਾ ਕਾ ਮਨੁ ਲਾਗੈ ॥",
      "transliteration": "gur charanee jaa kaa man laagai ||",
      "translation": "One whose mind is attached to the Guru's feet",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੂਖੁ ਦਰਦੁ ਭ੍ਰਮੁ ਤਾ ਕਾ ਭਾਗੈ ॥",
      "transliteration": "dookh darad bhram taa kaa bhaagai ||",
      "translation": "his pains, sufferings and doubts run away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗੁਰ ਕੀ ਸੇਵਾ ਪਾਏ ਮਾਨੁ ॥",
      "transliteration": "gur kee sevaa paae maan ||",
      "translation": "Serving the Guru, honor is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰ ਊਪਰਿ ਸਦਾ ਕੁਰਬਾਨੁ ॥੨॥",
      "transliteration": "gur oopar sadaa kurabaan ||2||",
      "translation": "I am forever a sacrifice to the Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰ ਕਾ ਦਰਸਨੁ ਦੇਖਿ ਨਿਹਾਲ ॥",
      "transliteration": "gur kaa darasan dekh nihaal ||",
      "translation": "Gazing upon the Blessed Vision of the Guru's Darshan, I am exalted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰ ਕੇ ਸੇਵਕ ਕੀ ਪੂਰਨ ਘਾਲ ॥",
      "transliteration": "gur ke sevak kee pooran ghaal ||",
      "translation": "The work of the Guru's servant is perfect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰ ਕੇ ਸੇਵਕ ਕਉ ਦੁਖੁ ਨ ਬਿਆਪੈ ॥",
      "transliteration": "gur ke sevak kau dukh na biaapai ||",
      "translation": "Pain does not afflict the Guru's servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰ ਕਾ ਸੇਵਕੁ ਦਹ ਦਿਸਿ ਜਾਪੈ ॥੩॥",
      "transliteration": "gur kaa sevak dah dis jaapai ||3||",
      "translation": "The Guru's servant is famous in the ten directions. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰ ਕੀ ਮਹਿਮਾ ਕਥਨੁ ਨ ਜਾਇ ॥",
      "transliteration": "gur kee mahimaa kathan na jaai ||",
      "translation": "The Guru's glory cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਗੁਰੁ ਰਹਿਆ ਸਮਾਇ ॥",
      "transliteration": "paarabraham gur rahiaa samaai ||",
      "translation": "The Guru remains absorbed in the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਾ ਕੇ ਪੂਰੇ ਭਾਗ ॥",
      "transliteration": "kahu naanak jaa ke poore bhaag ||",
      "translation": "Says Nanak, one who is blessed with perfect destiny",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਰ ਚਰਣੀ ਤਾ ਕਾ ਮਨੁ ਲਾਗ ॥੪॥੬॥੮॥",
      "transliteration": "gur charanee taa kaa man laag ||4||6||8||",
      "translation": "- his mind is attached to the Guru's feet. ||4||6||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰੁ ਮੇਰੀ ਪੂਜਾ ਗੁਰੁ ਗੋਬਿੰਦੁ ॥",
      "transliteration": "gur meree poojaa gur gobi(n)d ||",
      "translation": "I worship and adore my Guru; the Guru is the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੁਰੁ ਮੇਰਾ ਪਾਰਬ੍ਰਹਮੁ ਗੁਰੁ ਭਗਵੰਤੁ ॥",
      "transliteration": "gur meraa paarabraham gur bhagava(n)t ||",
      "translation": "My Guru is the Supreme Lord God; the Guru is the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰੁ ਮੇਰਾ ਦੇਉ ਅਲਖ ਅਭੇਉ ॥",
      "transliteration": "gur meraa deu alakh abheu ||",
      "translation": "My Guru is divine, invisible and mysterious.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਰਬ ਪੂਜ ਚਰਨ ਗੁਰ ਸੇਉ ॥੧॥",
      "transliteration": "sarab pooj charan gur seu ||1||",
      "translation": "I serve at the Guru's feet, which are worshipped by all. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰ ਬਿਨੁ ਅਵਰੁ ਨਾਹੀ ਮੈ ਥਾਉ ॥",
      "transliteration": "gur bin avar naahee mai thaau ||",
      "translation": "Without the Guru, I have no other place at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਨਦਿਨੁ ਜਪਉ ਗੁਰੂ ਗੁਰ ਨਾਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "anadin japau guroo gur naau ||1|| rahaau ||",
      "translation": "Night and day, I chant the Name of Guru, Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੁਰੁ ਮੇਰਾ ਗਿਆਨੁ ਗੁਰੁ ਰਿਦੈ ਧਿਆਨੁ ॥",
      "transliteration": "gur meraa giaan gur ridai dhiaan ||",
      "translation": "The Guru is my spiritual wisdom, the Guru is the meditation within my heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰੁ ਗੋਪਾਲੁ ਪੁਰਖੁ ਭਗਵਾਨੁ ॥",
      "transliteration": "gur gopaal purakh bhagavaan ||",
      "translation": "The Guru is the Lord of the World, the Primal Being, the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗੁਰ ਕੀ ਸਰਣਿ ਰਹਉ ਕਰ ਜੋਰਿ ॥",
      "transliteration": "gur kee saran rahau kar jor ||",
      "translation": "With my palms pressed together, I remain in the Guru's Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗੁਰੂ ਬਿਨਾ ਮੈ ਨਾਹੀ ਹੋਰੁ ॥੨॥",
      "transliteration": "guroo binaa mai naahee hor ||2||",
      "translation": "Without the Guru, I have no other at all. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰੁ ਬੋਹਿਥੁ ਤਾਰੇ ਭਵ ਪਾਰਿ ॥",
      "transliteration": "gur bohith taare bhav paar ||",
      "translation": "The Guru is the boat to cross over the terrifying world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰ ਸੇਵਾ ਜਮ ਤੇ ਛੁਟਕਾਰਿ ॥",
      "transliteration": "gur sevaa jam te chhutakaar ||",
      "translation": "Serving the Guru, one is released from the Messenger of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਅੰਧਕਾਰ ਮਹਿ ਗੁਰ ਮੰਤ੍ਰੁ ਉਜਾਰਾ ॥",
      "transliteration": "a(n)dhakaar mahi gur ma(n)tr ujaaraa ||",
      "translation": "In the darkness, the Guru's Mantra shines forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਗੁਰ ਕੈ ਸੰਗਿ ਸਗਲ ਨਿਸਤਾਰਾ ॥੩॥",
      "transliteration": "gur kai sa(n)g sagal nisataaraa ||3||",
      "translation": "With the Guru, all are saved. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਗੁਰੁ ਪੂਰਾ ਪਾਈਐ ਵਡਭਾਗੀ ॥",
      "transliteration": "gur pooraa paaeeai vadabhaagee ||",
      "translation": "The Perfect Guru is found, by great good fortune.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗੁਰ ਕੀ ਸੇਵਾ ਦੂਖੁ ਨ ਲਾਗੀ ॥",
      "transliteration": "gur kee sevaa dookh na laagee ||",
      "translation": "Serving the Guru, pain does not afflict anyone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਨ ਮੇਟੈ ਕੋਇ ॥",
      "transliteration": "gur kaa sabad na metai koi ||",
      "translation": "No one can erase the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0864_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਗੁਰੁ ਨਾਨਕੁ ਨਾਨਕੁ ਹਰਿ ਸੋਇ ॥੪॥੭॥੯॥",
      "transliteration": "gur naanak naanak har soi ||4||7||9||",
      "translation": "Nanak is the Guru; Nanak is the Lord Himself. ||4||7||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 864,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
