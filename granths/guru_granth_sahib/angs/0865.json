{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 865,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0865_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਾਮ ਰਾਮ ਸੰਗਿ ਕਰਿ ਬਿਉਹਾਰ ॥",
      "transliteration": "raam raam sa(n)g kar biuhaar ||",
      "translation": "Deal and trade only with the Lord, Raam, Raam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਾਮ ਰਾਮ ਰਾਮ ਪ੍ਰਾਨ ਅਧਾਰ ॥",
      "transliteration": "raam raam raam praan adhaar ||",
      "translation": "The Lord, Raam, Raam, Raam, is the Support of the breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਾਮ ਰਾਮ ਰਾਮ ਕੀਰਤਨੁ ਗਾਇ ॥",
      "transliteration": "raam raam raam keeratan gaai ||",
      "translation": "Sing the Kirtan of the Praises of the Lord, Raam, Raam, Raam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਮਤ ਰਾਮੁ ਸਭ ਰਹਿਓ ਸਮਾਇ ॥੧॥",
      "transliteration": "ramat raam sabh rahio samaai ||1||",
      "translation": "The Lord is ever-present, all-pervading. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਮਿਲਿ ਬੋਲਹੁ ਰਾਮ ॥",
      "transliteration": "sa(n)t janaa mil bolahu raam ||",
      "translation": "Joining the humble Saints, chant the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਭ ਤੇ ਨਿਰਮਲ ਪੂਰਨ ਕਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sabh te niramal pooran kaam ||1|| rahaau ||",
      "translation": "This is the most immaculate and perfect occupation of all. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਮ ਰਾਮ ਧਨੁ ਸੰਚਿ ਭੰਡਾਰ ॥",
      "transliteration": "raam raam dhan sa(n)ch bha(n)daar ||",
      "translation": "Gather the treasure, the wealth of the Lord, Raam, Raam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਾਮ ਰਾਮ ਰਾਮ ਕਰਿ ਆਹਾਰ ॥",
      "transliteration": "raam raam raam kar aahaar ||",
      "translation": "Let your sustenance be the Lord, Raam, Raam, Raam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਾਮ ਰਾਮ ਵੀਸਰਿ ਨਹੀ ਜਾਇ ॥",
      "transliteration": "raam raam veesar nahee jaai ||",
      "translation": "Never forget the Lord, Raam, Raam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਗੁਰਿ ਦੀਆ ਬਤਾਇ ॥੨॥",
      "transliteration": "kar kirapaa gur deeaa bataai ||2||",
      "translation": "In His Mercy, the Guru has revealed this to me. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਮ ਰਾਮ ਰਾਮ ਸਦਾ ਸਹਾਇ ॥",
      "transliteration": "raam raam raam sadaa sahaai ||",
      "translation": "The Lord, Raam, Raam, Raam, is always our help and support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਮ ਰਾਮ ਰਾਮ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "raam raam raam liv laai ||",
      "translation": "Embrace love for the Lord, Raam, Raam, Raam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਮ ਰਾਮ ਜਪਿ ਨਿਰਮਲ ਭਏ ॥",
      "transliteration": "raam raam jap niramal bhae ||",
      "translation": "Through the Lord, Raam, Raam, Raam, I have become immaculate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਕਿਲਬਿਖ ਗਏ ॥੩॥",
      "transliteration": "janam janam ke kilabikh gae ||3||",
      "translation": "The sins of countless incarnations have been taken away. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਮਤ ਰਾਮ ਜਨਮ ਮਰਣੁ ਨਿਵਾਰੈ ॥",
      "transliteration": "ramat raam janam maran nivaarai ||",
      "translation": "Uttering the Lord's Name, birth and death are finished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਉਚਰਤ ਰਾਮ ਭੈ ਪਾਰਿ ਉਤਾਰੈ ॥",
      "transliteration": "ucharat raam bhai paar utaarai ||",
      "translation": "Repeating the Lord's Name, one crosses over the terrifying world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਭ ਤੇ ਊਚ ਰਾਮ ਪਰਗਾਸ ॥",
      "transliteration": "sabh te ooch raam paragaas ||",
      "translation": "The Luminous Lord is the highest of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਿਸਿ ਬਾਸੁਰ ਜਪਿ ਨਾਨਕ ਦਾਸ ॥੪॥੮॥੧੦॥",
      "transliteration": "nis baasur jap naanak daas ||4||8||10||",
      "translation": "Night and day, servant Nanak meditates on Him. ||4||8||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਉਨ ਕਉ ਖਸਮਿ ਕੀਨੀ ਠਾਕਹਾਰੇ ॥",
      "transliteration": "un kau khasam keenee thaakahaare ||",
      "translation": "My Lord and Master has held back the five demons.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦਾਸ ਸੰਗ ਤੇ ਮਾਰਿ ਬਿਦਾਰੇ ॥",
      "transliteration": "daas sa(n)g te maar bidaare ||",
      "translation": "He conquered them, and scared them away from the Lord's slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੋਬਿੰਦ ਭਗਤ ਕਾ ਮਹਲੁ ਨ ਪਾਇਆ ॥",
      "transliteration": "gobi(n)d bhagat kaa mahal na paaiaa ||",
      "translation": "They cannot find the mansion of the Lord's devotee.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਾਮ ਜਨਾ ਮਿਲਿ ਮੰਗਲੁ ਗਾਇਆ ॥੧॥",
      "transliteration": "raam janaa mil ma(n)gal gaaiaa ||1||",
      "translation": "Joining together, the Lord's humble servants sing the songs of joy. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਗਲ ਸ੍ਰਿਸਟਿ ਕੇ ਪੰਚ ਸਿਕਦਾਰ ॥",
      "transliteration": "sagal srisat ke pa(n)ch sikadaar ||",
      "translation": "The five demons are the rulers of the whole world,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਮ ਭਗਤ ਕੇ ਪਾਨੀਹਾਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raam bhagat ke paaneehaar ||1|| rahaau ||",
      "translation": "but they are just water-carriers for the Lord's devotee. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਗਤ ਪਾਸ ਤੇ ਲੇਤੇ ਦਾਨੁ ॥",
      "transliteration": "jagat paas te lete daan ||",
      "translation": "They collect taxes from the world,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੋਬਿੰਦ ਭਗਤ ਕਉ ਕਰਹਿ ਸਲਾਮੁ ॥",
      "transliteration": "gobi(n)d bhagat kau karahi salaam ||",
      "translation": "but they bow in subservience to God's devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਲੂਟਿ ਲੇਹਿ ਸਾਕਤ ਪਤਿ ਖੋਵਹਿ ॥",
      "transliteration": "loot lehi saakat pat khovahi ||",
      "translation": "They plunder and dishonor the faithless cynics,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਧ ਜਨਾ ਪਗ ਮਲਿ ਮਲਿ ਧੋਵਹਿ ॥੨॥",
      "transliteration": "saadh janaa pag mal mal dhovahi ||2||",
      "translation": "but they massage and wash the feet of the Holy. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪੰਚ ਪੂਤ ਜਣੇ ਇਕ ਮਾਇ ॥",
      "transliteration": "pa(n)ch poot jane ik maai ||",
      "translation": "The One Mother gave birth to the five sons,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਉਤਭੁਜ ਖੇਲੁ ਕਰਿ ਜਗਤ ਵਿਆਇ ॥",
      "transliteration": "utabhuj khel kar jagat viaai ||",
      "translation": "and began the play of the created world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤੀਨਿ ਗੁਣਾ ਕੈ ਸੰਗਿ ਰਚਿ ਰਸੇ ॥",
      "transliteration": "teen gunaa kai sa(n)g rach rase ||",
      "translation": "With the three qualities joined together, they celebrate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਨ ਕਉ ਛੋਡਿ ਊਪਰਿ ਜਨ ਬਸੇ ॥੩॥",
      "transliteration": "in kau chhod oopar jan base ||3||",
      "translation": "Renouncing these three qualities, the Lord's humble servants rise above them. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਨ ਲੀਏ ਛਡਾਇ ॥",
      "transliteration": "kar kirapaa jan leee chhadaai ||",
      "translation": "In His Mercy, He saves His humble servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਸ ਕੇ ਸੇ ਤਿਨਿ ਰਖੇ ਹਟਾਇ ॥",
      "transliteration": "jis ke se tin rakhe hataai ||",
      "translation": "They belong to Him, and so He saves them by driving out the five.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਭਗਤਿ ਪ੍ਰਭ ਸਾਰੁ ॥",
      "transliteration": "kahu naanak bhagat prabh saar ||",
      "translation": "Says Nanak, devotion to God is noble and sublime.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਿਨੁ ਭਗਤੀ ਸਭ ਹੋਇ ਖੁਆਰੁ ॥੪॥੯॥੧੧॥",
      "transliteration": "bin bhagatee sabh hoi khuaar ||4||9||11||",
      "translation": "Without devotion, all just waste away uselessly. ||4||9||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਲਿ ਕਲੇਸ ਮਿਟੇ ਹਰਿ ਨਾਇ ॥",
      "transliteration": "kal kales mite har naai ||",
      "translation": "Suffering and troubles are eradicated by the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੁਖ ਬਿਨਸੇ ਸੁਖ ਕੀਨੋ ਠਾਉ ॥",
      "transliteration": "dukh binase sukh keeno thaau ||",
      "translation": "Pain is dispelled, and peace takes its place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਪਿ ਜਪਿ ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਅਘਾਏ ॥",
      "transliteration": "jap jap a(n)mrit naam aghaae ||",
      "translation": "Meditating, chanting the Ambrosial Naam, the Name of the Lord, I am satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਸਗਲ ਫਲ ਪਾਏ ॥੧॥",
      "transliteration": "sa(n)t prasaad sagal phal paae ||1||",
      "translation": "By the Grace of the Saints, I have received all fruitful rewards. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਾਮ ਜਪਤ ਜਨ ਪਾਰਿ ਪਰੇ ॥",
      "transliteration": "raam japat jan paar pare ||",
      "translation": "Meditating on the Lord, His humble servant is carried across,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਪਾਪ ਹਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "janam janam ke paap hare ||1|| rahaau ||",
      "translation": "and the sins of countless incarnations are taken away. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਨ ਰਿਦੈ ਉਰਿ ਧਾਰੇ ॥",
      "transliteration": "gur ke charan ridai ur dhaare ||",
      "translation": "I have enshrined the Guru's feet within my heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਗਨਿ ਸਾਗਰ ਤੇ ਉਤਰੇ ਪਾਰੇ ॥",
      "transliteration": "agan saagar te utare paare ||",
      "translation": "and crossed over the ocean of fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਨਮ ਮਰਣ ਸਭ ਮਿਟੀ ਉਪਾਧਿ ॥",
      "transliteration": "janam maran sabh mitee upaadh ||",
      "translation": "All the painful diseases of birth and death have been eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਪ੍ਰਭ ਸਿਉ ਲਾਗੀ ਸਹਜਿ ਸਮਾਧਿ ॥੨॥",
      "transliteration": "prabh siu laagee sahaj samaadh ||2||",
      "translation": "I am attached to God in celestial Samaadhi. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਥਾਨ ਥਨੰਤਰਿ ਏਕੋ ਸੁਆਮੀ ॥",
      "transliteration": "thaan thana(n)tar eko suaamee ||",
      "translation": "In all places and interspaces, the One, our Lord and Master is contained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਗਲ ਘਟਾ ਕਾ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "sagal ghataa kaa a(n)tarajaamee ||",
      "translation": "He is the Inner-knower of all hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਾ ਕਉ ਮਤਿ ਦੇਇ ॥",
      "transliteration": "kar kirapaa jaa kau mat dei ||",
      "translation": "One whom the Lord blesses with understanding,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਆਠ ਪਹਰ ਪ੍ਰਭ ਕਾ ਨਾਉ ਲੇਇ ॥੩॥",
      "transliteration": "aath pahar prabh kaa naau lei ||3||",
      "translation": "chants the Name of God, twenty-four hours a day. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਾ ਕੈ ਅੰਤਰਿ ਵਸੈ ਪ੍ਰਭੁ ਆਪਿ ॥",
      "transliteration": "jaa kai a(n)tar vasai prabh aap ||",
      "translation": "Deep within, God Himself abides;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤਾ ਕੈ ਹਿਰਦੈ ਹੋਇ ਪ੍ਰਗਾਸੁ ॥",
      "transliteration": "taa kai hiradai hoi pragaas ||",
      "translation": "within his heart, the Divine Light shines forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਭਗਤਿ ਭਾਇ ਹਰਿ ਕੀਰਤਨੁ ਕਰੀਐ ॥",
      "transliteration": "bhagat bhaai har keeratan kareeai ||",
      "translation": "With loving devotion, sing the Kirtan of the Lord's Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਪਿ ਪਾਰਬ੍ਰਹਮੁ ਨਾਨਕ ਨਿਸਤਰੀਐ ॥੪॥੧੦॥੧੨॥",
      "transliteration": "jap paarabraham naanak nisatareeai ||4||10||12||",
      "translation": "Meditate on the Supreme Lord God, O Nanak, and you shall be saved. ||4||10||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0865_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 865,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
