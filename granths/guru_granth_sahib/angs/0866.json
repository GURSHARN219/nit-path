{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 866,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0866_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਨ ਕਮਲ ਨਮਸਕਾਰਿ ॥",
      "transliteration": "gur ke charan kamal namasakaar ||",
      "translation": "Bow in humility to the lotus feet of the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਇਸੁ ਤਨ ਤੇ ਮਾਰਿ ॥",
      "transliteration": "kaam krodh is tan te maar ||",
      "translation": "Eliminate sexual desire and anger from this body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹੋਇ ਰਹੀਐ ਸਗਲ ਕੀ ਰੀਨਾ ॥",
      "transliteration": "hoi raheeai sagal kee reenaa ||",
      "translation": "Be the dust of all,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਰਮਈਆ ਸਭ ਮਹਿ ਚੀਨਾ ॥੧॥",
      "transliteration": "ghat ghat ramaeeaa sabh mahi cheenaa ||1||",
      "translation": "and see the Lord in each and every heart, in all. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਨ ਬਿਧਿ ਰਮਹੁ ਗੋਪਾਲ ਗੋੁਬਿੰਦੁ ॥",
      "transliteration": "in bidh ramahu gopaal goubi(n)d ||",
      "translation": "In this way, dwell upon the Lord of the World, the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਨੁ ਧਨੁ ਪ੍ਰਭ ਕਾ ਪ੍ਰਭ ਕੀ ਜਿੰਦੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tan dhan prabh kaa prabh kee ji(n)d ||1|| rahaau ||",
      "translation": "My body and wealth belong to God; my soul belongs to God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਠ ਪਹਰ ਹਰਿ ਕੇ ਗੁਣ ਗਾਉ ॥",
      "transliteration": "aath pahar har ke gun gaau ||",
      "translation": "Twenty-four hours a day, sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੀਅ ਪ੍ਰਾਨ ਕੋ ਇਹੈ ਸੁਆਉ ॥",
      "transliteration": "jee praan ko ihai suaau ||",
      "translation": "This is the purpose of human life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਜਿ ਅਭਿਮਾਨੁ ਜਾਨੁ ਪ੍ਰਭੁ ਸੰਗਿ ॥",
      "transliteration": "taj abhimaan jaan prabh sa(n)g ||",
      "translation": "Renounce your egotistical pride, and know that God is with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਾਧ ਪ੍ਰਸਾਦਿ ਹਰਿ ਸਿਉ ਮਨੁ ਰੰਗਿ ॥੨॥",
      "transliteration": "saadh prasaad har siu man ra(n)g ||2||",
      "translation": "By the Grace of the Holy, let your mind be imbued with the Lord's Love. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਨਿ ਤੂੰ ਕੀਆ ਤਿਸ ਕਉ ਜਾਨੁ ॥",
      "transliteration": "jin too(n) keeaa tis kau jaan ||",
      "translation": "Know the One who created you,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਆਗੈ ਦਰਗਹ ਪਾਵੈ ਮਾਨੁ ॥",
      "transliteration": "aagai daragah paavai maan ||",
      "translation": "and in the world hereafter you shall be honored in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਨਿਰਮਲ ਹੋਇ ਨਿਹਾਲੁ ॥",
      "transliteration": "man tan niramal hoi nihaal ||",
      "translation": "Your mind and body will be immaculate and blissful;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਸਨਾ ਨਾਮੁ ਜਪਤ ਗੋਪਾਲ ॥੩॥",
      "transliteration": "rasanaa naam japat gopaal ||3||",
      "translation": "chant the Name of the Lord of the Universe with your tongue. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਮੇਰੇ ਦੀਨ ਦਇਆਲਾ ॥",
      "transliteration": "kar kirapaa mere deen daiaalaa ||",
      "translation": "Grant Your Kind Mercy, O my Lord, Merciful to the meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਾਧੂ ਕੀ ਮਨੁ ਮੰਗੈ ਰਵਾਲਾ ॥",
      "transliteration": "saadhoo kee man ma(n)gai ravaalaa ||",
      "translation": "My mind begs for the dust of the feet of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹੋਹੁ ਦਇਆਲ ਦੇਹੁ ਪ੍ਰਭ ਦਾਨੁ ॥",
      "transliteration": "hohu daiaal dehu prabh daan ||",
      "translation": "Be merciful, and bless me with this gift,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਨਕੁ ਜਪਿ ਜੀਵੈ ਪ੍ਰਭ ਨਾਮੁ ॥੪॥੧੧॥੧੩॥",
      "transliteration": "naanak jap jeevai prabh naam ||4||11||13||",
      "translation": "that Nanak may live, chanting God's Name. ||4||11||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਧੂਪ ਦੀਪ ਸੇਵਾ ਗੋਪਾਲ ॥",
      "transliteration": "dhoop deep sevaa gopaal ||",
      "translation": "My incense and lamps are my service to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਨਿਕ ਬਾਰ ਬੰਦਨ ਕਰਤਾਰ ॥",
      "transliteration": "anik baar ba(n)dan karataar ||",
      "translation": "Time and time again, I humbly bow to the Creator.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਸਰਣਿ ਗਹੀ ਸਭ ਤਿਆਗਿ ॥",
      "transliteration": "prabh kee saran gahee sabh tiaag ||",
      "translation": "I have renounced everything, and grasped the Sanctuary of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਰ ਸੁਪ੍ਰਸੰਨ ਭਏ ਵਡਭਾਗਿ ॥੧॥",
      "transliteration": "gur suprasa(n)n bhae vadabhaag ||1||",
      "translation": "By great good fortune, the Guru has become pleased and satisfied with me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਠ ਪਹਰ ਗਾਈਐ ਗੋਬਿੰਦੁ ॥",
      "transliteration": "aath pahar gaaeeai gobi(n)d ||",
      "translation": "Twenty-four hours a day, I sing of the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਨੁ ਧਨੁ ਪ੍ਰਭ ਕਾ ਪ੍ਰਭ ਕੀ ਜਿੰਦੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tan dhan prabh kaa prabh kee ji(n)d ||1|| rahaau ||",
      "translation": "My body and wealth belong to God; my soul belongs to God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਰਮਤ ਭਏ ਆਨੰਦ ॥",
      "transliteration": "har gun ramat bhae aana(n)d ||",
      "translation": "Chanting the Glorious Praises of the Lord, I am in bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਪੂਰਨ ਬਖਸੰਦ ॥",
      "transliteration": "paarabraham pooran bakhasa(n)d ||",
      "translation": "The Supreme Lord God is the Perfect Forgiver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਨ ਸੇਵਾ ਲਾਏ ॥",
      "transliteration": "kar kirapaa jan sevaa laae ||",
      "translation": "Granting His Mercy, He has linked His humble servants to His service.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਨਮ ਮਰਣ ਦੁਖ ਮੇਟਿ ਮਿਲਾਏ ॥੨॥",
      "transliteration": "janam maran dukh met milaae ||2||",
      "translation": "He has rid me of the pains of birth and death, and merged me with Himself. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਇਹੁ ਤਤੁ ਗਿਆਨੁ ॥",
      "transliteration": "karam dharam ihu tat giaan ||",
      "translation": "This is the essence of karma, righteous conduct and spiritual wisdom,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਜਪੀਐ ਹਰਿ ਨਾਮੁ ॥",
      "transliteration": "saadhasa(n)g japeeai har naam ||",
      "translation": "to chant the Lord's Name in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਾਗਰ ਤਰਿ ਬੋਹਿਥ ਪ੍ਰਭ ਚਰਣ ॥",
      "transliteration": "saagar tar bohith prabh charan ||",
      "translation": "God's Feet are the boat to cross over the world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅੰਤਰਜਾਮੀ ਪ੍ਰਭ ਕਾਰਣ ਕਰਣ ॥੩॥",
      "transliteration": "a(n)tarajaamee prabh kaaran karan ||3||",
      "translation": "God, the Inner-knower, is the Cause of causes. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਖਿ ਲੀਏ ਅਪਨੀ ਕਿਰਪਾ ਧਾਰਿ ॥",
      "transliteration": "raakh leee apanee kirapaa dhaar ||",
      "translation": "Showering His Mercy, He Himself has saved me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪੰਚ ਦੂਤ ਭਾਗੇ ਬਿਕਰਾਲ ॥",
      "transliteration": "pa(n)ch doot bhaage bikaraal ||",
      "translation": "The five hideous demons have run away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੂਐ ਜਨਮੁ ਨ ਕਬਹੂ ਹਾਰਿ ॥",
      "transliteration": "jooai janam na kabahoo haar ||",
      "translation": "Do not lose your life in the gamble.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕ ਕਾ ਅੰਗੁ ਕੀਆ ਕਰਤਾਰਿ ॥੪॥੧੨॥੧੪॥",
      "transliteration": "naanak kaa a(n)g keeaa karataar ||4||12||14||",
      "translation": "The Creator Lord has taken Nanak's side. ||4||12||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਸੁਖ ਅਨਦ ਕਰੇਇ ॥",
      "transliteration": "kar kirapaa sukh anad karei ||",
      "translation": "In His Mercy, He has blessed me with peace and bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਾਲਕ ਰਾਖਿ ਲੀਏ ਗੁਰਦੇਵਿ ॥",
      "transliteration": "baalak raakh leee guradev ||",
      "translation": "The Divine Guru has saved His child.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰਭ ਕਿਰਪਾਲ ਦਇਆਲ ਗੋੁਬਿੰਦ ॥",
      "transliteration": "prabh kirapaal daiaal goubi(n)d ||",
      "translation": "God is kind and compassionate; He is the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਸਗਲੇ ਬਖਸਿੰਦ ॥੧॥",
      "transliteration": "jee ja(n)t sagale bakhasi(n)d ||1||",
      "translation": "He forgives all beings and creatures. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੇਰੀ ਸਰਣਿ ਪ੍ਰਭ ਦੀਨ ਦਇਆਲ ॥",
      "transliteration": "teree saran prabh deen daiaal ||",
      "translation": "I seek Your Sanctuary, O God, O Merciful to the meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਜਪਿ ਸਦਾ ਨਿਹਾਲ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "paarabraham jap sadaa nihaal ||1|| rahaau ||",
      "translation": "Meditating on the Supreme Lord God, I am forever in ecstasy. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪ੍ਰਭ ਦਇਆਲ ਦੂਸਰ ਕੋਈ ਨਾਹੀ ॥",
      "transliteration": "prabh daiaal doosar koee naahee ||",
      "translation": "There is no other like the Merciful Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਘਟ ਘਟ ਅੰਤਰਿ ਸਰਬ ਸਮਾਹੀ ॥",
      "transliteration": "ghat ghat a(n)tar sarab samaahee ||",
      "translation": "He is contained deep within each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਪਨੇ ਦਾਸ ਕਾ ਹਲਤੁ ਪਲਤੁ ਸਵਾਰੈ ॥",
      "transliteration": "apane daas kaa halat palat savaarai ||",
      "translation": "He embellishes His slave, here and hereafter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਤਿਤ ਪਾਵਨ ਪ੍ਰਭ ਬਿਰਦੁ ਤੁਮੑਾਰੈ ॥੨॥",
      "transliteration": "patit paavan prabh birad tumhaarai ||2||",
      "translation": "It is Your nature, God, to purify sinners. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਉਖਧ ਕੋਟਿ ਸਿਮਰਿ ਗੋਬਿੰਦ ॥",
      "transliteration": "aukhadh kot simar gobi(n)d ||",
      "translation": "Meditation on the Lord of the Universe is the medicine to cure millions of illnesses.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤੰਤੁ ਮੰਤੁ ਭਜੀਐ ਭਗਵੰਤ ॥",
      "transliteration": "ta(n)t ma(n)t bhajeeai bhagava(n)t ||",
      "translation": "My Tantra and Mantra is to meditate, to vibrate upon the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਰੋਗ ਸੋਗ ਮਿਟੇ ਪ੍ਰਭ ਧਿਆਏ ॥",
      "transliteration": "rog sog mite prabh dhiaae ||",
      "translation": "Illnesses and pains are dispelled, meditating on God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਨ ਬਾਂਛਤ ਪੂਰਨ ਫਲ ਪਾਏ ॥੩॥",
      "transliteration": "man baa(n)chhat pooran phal paae ||3||",
      "translation": "The fruits of the mind's desires are fulfilled. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਰਨ ਕਾਰਨ ਸਮਰਥ ਦਇਆਰ ॥",
      "transliteration": "karan kaaran samarath daiaar ||",
      "translation": "He is the Cause of causes, the All-powerful Merciful Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਰਬ ਨਿਧਾਨ ਮਹਾ ਬੀਚਾਰ ॥",
      "transliteration": "sarab nidhaan mahaa beechaar ||",
      "translation": "Contemplating Him is the greatest of all treasures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਨਕ ਬਖਸਿ ਲੀਏ ਪ੍ਰਭਿ ਆਪਿ ॥",
      "transliteration": "naanak bakhas leee prabh aap ||",
      "translation": "God Himself has forgiven Nanak;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਏਕੋ ਹਰਿ ਜਾਪਿ ॥੪॥੧੩॥੧੫॥",
      "transliteration": "sadaa sadaa eko har jaap ||4||13||15||",
      "translation": "forever and ever, he chants the Name of the One Lord. ||4||13||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0866_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਪਹੁ ਮੇਰੇ ਮੀਤ ॥",
      "transliteration": "har har naam japahu mere meet ||",
      "translation": "Chant the Name of the Lord, Har, Har, O my friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 866,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
