{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 867,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0867_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਿਰਮਲ ਹੋਇ ਤੁਮੑਾਰਾ ਚੀਤ ॥",
      "transliteration": "niramal hoi tumhaaraa cheet ||",
      "translation": "Your consciousness shall become immaculate and pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਨ ਤਨ ਕੀ ਸਭ ਮਿਟੈ ਬਲਾਇ ॥",
      "transliteration": "man tan kee sabh mitai balaai ||",
      "translation": "All the misfortunes of your mind and body shall be taken away,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੂਖੁ ਅੰਧੇਰਾ ਸਗਲਾ ਜਾਇ ॥੧॥",
      "transliteration": "dookh a(n)dheraa sagalaa jaai ||1||",
      "translation": "and all your pain and darkness will be dispelled. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਗਾਵਤ ਤਰੀਐ ਸੰਸਾਰੁ ॥",
      "transliteration": "har gun gaavat tareeai sa(n)saar ||",
      "translation": "Singing the Glorious Praises of the Lord, cross over the world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਵਡਭਾਗੀ ਪਾਈਐ ਪੁਰਖੁ ਅਪਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "vadabhaagee paaeeai purakh apaar ||1|| rahaau ||",
      "translation": "By great good fortune, one attains the Infinite Lord, the Primal Being. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੋ ਜਨੁ ਕਰੈ ਕੀਰਤਨੁ ਗੋਪਾਲ ॥",
      "transliteration": "jo jan karai keeratan gopaal ||",
      "translation": "The Messenger of Death cannot even touch that humble being,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਿਸ ਕਉ ਪੋਹਿ ਨ ਸਕੈ ਜਮਕਾਲੁ ॥",
      "transliteration": "tis kau pohi na sakai jamakaal ||",
      "translation": "Who sings the Kirtan of the Lord's Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਗ ਮਹਿ ਆਇਆ ਸੋ ਪਰਵਾਣੁ ॥",
      "transliteration": "jag mahi aaiaa so paravaan ||",
      "translation": "The Gurmukh realizes his Lord and Master;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਅਪਨਾ ਖਸਮੁ ਪਛਾਣੁ ॥੨॥",
      "transliteration": "guramukh apanaa khasam pachhaan ||2||",
      "translation": "His coming into this world is approved. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਗਾਵੈ ਸੰਤ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "har gun gaavai sa(n)t prasaad ||",
      "translation": "He sings the Glorious Praises of the Lord, by the Grace of the Saints;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਮਿਟਹਿ ਉਨਮਾਦ ॥",
      "transliteration": "kaam krodh mitahi unamaad ||",
      "translation": "his sexual desire, anger and madness are eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਦਾ ਹਜੂਰਿ ਜਾਣੁ ਭਗਵੰਤ ॥",
      "transliteration": "sadaa hajoor jaan bhagava(n)t ||",
      "translation": "He knows the Lord God to be ever-present.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਕਾ ਪੂਰਨ ਮੰਤ ॥੩॥",
      "transliteration": "poore gur kaa pooran ma(n)t ||3||",
      "translation": "This is the Perfect Teaching of the Perfect Guru. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਹਰਿ ਧਨੁ ਖਾਟਿ ਕੀਏ ਭੰਡਾਰ ॥",
      "transliteration": "har dhan khaat keee bha(n)daar ||",
      "translation": "He earns the treasure of the Lord's wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਿਲਿ ਸਤਿਗੁਰ ਸਭਿ ਕਾਜ ਸਵਾਰ ॥",
      "transliteration": "mil satigur sabh kaaj savaar ||",
      "translation": "Meeting with the True Guru, all his affairs are resolved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਰਿ ਕੇ ਨਾਮ ਰੰਗ ਸੰਗਿ ਜਾਗਾ ॥",
      "transliteration": "har ke naam ra(n)g sa(n)g jaagaa ||",
      "translation": "He is awake and aware in the Love of the Lord's Name;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰਿ ਚਰਣੀ ਨਾਨਕ ਮਨੁ ਲਾਗਾ ॥੪॥੧੪॥੧੬॥",
      "transliteration": "har charanee naanak man laagaa ||4||14||16||",
      "translation": "O Nanak, his mind is attached to the Lord's Feet. ||4||14||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭਵ ਸਾਗਰ ਬੋਹਿਥ ਹਰਿ ਚਰਣ ॥",
      "transliteration": "bhav saagar bohith har charan ||",
      "translation": "The Lord's Feet are the boat to cross over the terrifying world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਿਮਰਤ ਨਾਮੁ ਨਾਹੀ ਫਿਰਿ ਮਰਣ ॥",
      "transliteration": "simarat naam naahee phir maran ||",
      "translation": "Meditating in remembrance on the Naam, the Name of the Lord, he does not die again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਰਮਤ ਨਾਹੀ ਜਮ ਪੰਥ ॥",
      "transliteration": "har gun ramat naahee jam pa(n)th ||",
      "translation": "Chanting the Glorious Praises of the Lord, he does not have to walk on the Path of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਹਾ ਬੀਚਾਰ ਪੰਚ ਦੂਤਹ ਮੰਥ ॥੧॥",
      "transliteration": "mahaa beechaar pa(n)ch dootah ma(n)th ||1||",
      "translation": "Contemplating the Supreme Lord, the five demons are conquered. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਉ ਸਰਣਾਈ ਪੂਰਨ ਨਾਥ ॥",
      "transliteration": "tau saranaaee pooran naath ||",
      "translation": "I have entered Your Sanctuary, O Perfect Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜੰਤ ਅਪਨੇ ਕਉ ਦੀਜਹਿ ਹਾਥ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ja(n)t apane kau deejahi haath ||1|| rahaau ||",
      "translation": "Please give Your hand to Your creatures. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਿਮ੍ਰਿਤਿ ਸਾਸਤ੍ਰ ਬੇਦ ਪੁਰਾਣ ॥",
      "transliteration": "simrit saasatr bed puraan ||",
      "translation": "The Simritees, Shaastras, Vedas and Puraanas",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕਾ ਕਰਹਿ ਵਖਿਆਣ ॥",
      "transliteration": "paarabraham kaa karahi vakhiaan ||",
      "translation": "expound upon the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੋਗੀ ਜਤੀ ਬੈਸਨੋ ਰਾਮਦਾਸ ॥",
      "transliteration": "jogee jatee baisano raamadaas ||",
      "translation": "The Yogis, celibates, Vaishnavs and followers of Ram Das",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਿਤਿ ਨਾਹੀ ਬ੍ਰਹਮ ਅਬਿਨਾਸ ॥੨॥",
      "transliteration": "mit naahee braham abinaas ||2||",
      "translation": "cannot find the limits of the Eternal Lord God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਰਣ ਪਲਾਹ ਕਰਹਿ ਸਿਵ ਦੇਵ ॥",
      "transliteration": "karan palaah karahi siv dev ||",
      "translation": "Shiva and the gods lament and moan,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਿਲੁ ਨਹੀ ਬੂਝਹਿ ਅਲਖ ਅਭੇਵ ॥",
      "transliteration": "til nahee boojhahi alakh abhev ||",
      "translation": "but they do not understand even a tiny bit of the unseen and unknown Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪ੍ਰੇਮ ਭਗਤਿ ਜਿਸੁ ਆਪੇ ਦੇਇ ॥",
      "transliteration": "prem bhagat jis aape dei ||",
      "translation": "One whom the Lord Himself blesses with loving devotional worship,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਗ ਮਹਿ ਵਿਰਲੇ ਕੇਈ ਕੇਇ ॥੩॥",
      "transliteration": "jag mahi virale keee kei ||3||",
      "translation": "is very rare in this world. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੋਹਿ ਨਿਰਗੁਣ ਗੁਣੁ ਕਿਛਹੂ ਨਾਹਿ ॥",
      "transliteration": "mohi niragun gun kichhahoo naahi ||",
      "translation": "I am worthless, with absolutely no virtue at all;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਰਬ ਨਿਧਾਨ ਤੇਰੀ ਦ੍ਰਿਸਟੀ ਮਾਹਿ ॥",
      "transliteration": "sarab nidhaan teree drisatee maahi ||",
      "translation": "all treasures are in Your Glance of Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕੁ ਦੀਨੁ ਜਾਚੈ ਤੇਰੀ ਸੇਵ ॥",
      "transliteration": "naanak deen jaachai teree sev ||",
      "translation": "Nanak, the meek, desires only to serve You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਦੀਜੈ ਗੁਰਦੇਵ ॥੪॥੧੫॥੧੭॥",
      "transliteration": "kar kirapaa deejai guradev ||4||15||17||",
      "translation": "Please be merciful, and grant him this blessing, O Divine Guru. ||4||15||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੰਤ ਕਾ ਲੀਆ ਧਰਤਿ ਬਿਦਾਰਉ ॥",
      "transliteration": "sa(n)t kaa leeaa dharat bidaarau ||",
      "translation": "One who is cursed by the Saints, is thrown down on the ground.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੰਤ ਕਾ ਨਿੰਦਕੁ ਅਕਾਸ ਤੇ ਟਾਰਉ ॥",
      "transliteration": "sa(n)t kaa ni(n)dak akaas te taarau ||",
      "translation": "The slanderer of the Saints is thrown down from the skies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੰਤ ਕਉ ਰਾਖਉ ਅਪਨੇ ਜੀਅ ਨਾਲਿ ॥",
      "transliteration": "sa(n)t kau raakhau apane jee naal ||",
      "translation": "I hold the Saints close to my soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੰਤ ਉਧਾਰਉ ਤਤਖਿਣ ਤਾਲਿ ॥੧॥",
      "transliteration": "sa(n)t udhaarau tatakhin taal ||1||",
      "translation": "The Saints are saved instantaneously. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੋਈ ਸੰਤੁ ਜਿ ਭਾਵੈ ਰਾਮ ॥",
      "transliteration": "soee sa(n)t j bhaavai raam ||",
      "translation": "He alone is a Saint, who is pleasing to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੰਤ ਗੋਬਿੰਦ ਕੈ ਏਕੈ ਕਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sa(n)t gobi(n)d kai ekai kaam ||1|| rahaau ||",
      "translation": "The Saints, and God, have only one job to do. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੰਤ ਕੈ ਊਪਰਿ ਦੇਇ ਪ੍ਰਭੁ ਹਾਥ ॥",
      "transliteration": "sa(n)t kai oopar dei prabh haath ||",
      "translation": "God gives His hand to shelter the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੰਤ ਕੈ ਸੰਗਿ ਬਸੈ ਦਿਨੁ ਰਾਤਿ ॥",
      "transliteration": "sa(n)t kai sa(n)g basai din raat ||",
      "translation": "He dwells with His Saints, day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਾਸਿ ਸਾਸਿ ਸੰਤਹ ਪ੍ਰਤਿਪਾਲਿ ॥",
      "transliteration": "saas saas sa(n)tah pratipaal ||",
      "translation": "With each and every breath, He cherishes His Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੰਤ ਕਾ ਦੋਖੀ ਰਾਜ ਤੇ ਟਾਲਿ ॥੨॥",
      "transliteration": "sa(n)t kaa dokhee raaj te taal ||2||",
      "translation": "He takes the power away from the enemies of the Saints. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੰਤ ਕੀ ਨਿੰਦਾ ਕਰਹੁ ਨ ਕੋਇ ॥",
      "transliteration": "sa(n)t kee ni(n)daa karahu na koi ||",
      "translation": "Let no one slander the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜੋ ਨਿੰਦੈ ਤਿਸ ਕਾ ਪਤਨੁ ਹੋਇ ॥",
      "transliteration": "jo ni(n)dai tis kaa patan hoi ||",
      "translation": "Whoever slanders them, will be destroyed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਸ ਕਉ ਰਾਖੈ ਸਿਰਜਨਹਾਰੁ ॥",
      "transliteration": "jis kau raakhai sirajanahaar ||",
      "translation": "One who is protected by the Creator Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਝਖ ਮਾਰਉ ਸਗਲ ਸੰਸਾਰੁ ॥੩॥",
      "transliteration": "jhakh maarau sagal sa(n)saar ||3||",
      "translation": "cannot be harmed, no matter how much the whole world may try. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪ੍ਰਭ ਅਪਨੇ ਕਾ ਭਇਆ ਬਿਸਾਸੁ ॥",
      "transliteration": "prabh apane kaa bhaiaa bisaas ||",
      "translation": "I place my faith in my God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਸਭੁ ਤਿਸ ਕੀ ਰਾਸਿ ॥",
      "transliteration": "jeeu pi(n)d sabh tis kee raas ||",
      "translation": "My soul and body all belong to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਉਪਜੀ ਪਰਤੀਤਿ ॥",
      "transliteration": "naanak kau upajee parateet ||",
      "translation": "This is the faith which inspires Nanak:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮਨਮੁਖ ਹਾਰ ਗੁਰਮੁਖ ਸਦ ਜੀਤਿ ॥੪॥੧੬॥੧੮॥",
      "transliteration": "manamukh haar guramukh sad jeet ||4||16||18||",
      "translation": "the self-willed manmukhs will fail, while the Gurmukhs will always win. ||4||16||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਨਾਮੁ ਨਿਰੰਜਨੁ ਨੀਰਿ ਨਰਾਇਣ ॥",
      "transliteration": "naam nira(n)jan neer naraain ||",
      "translation": "The Name of the Immaculate Lord is the Ambrosial Water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0867_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਰਸਨਾ ਸਿਮਰਤ ਪਾਪ ਬਿਲਾਇਣ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "rasanaa simarat paap bilaain ||1|| rahaau ||",
      "translation": "Chanting it with the tongue, sins are washed away. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 867,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
