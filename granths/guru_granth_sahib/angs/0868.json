{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 868,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0868_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਰਾਇਣ ਸਭ ਮਾਹਿ ਨਿਵਾਸ ॥",
      "transliteration": "naaraain sabh maahi nivaas ||",
      "translation": "The Lord abides in everyone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਰਾਇਣ ਘਟਿ ਘਟਿ ਪਰਗਾਸ ॥",
      "transliteration": "naaraain ghat ghat paragaas ||",
      "translation": "The Lord illumines each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਰਾਇਣ ਕਹਤੇ ਨਰਕਿ ਨ ਜਾਹਿ ॥",
      "transliteration": "naaraain kahate narak na jaahi ||",
      "translation": "Chanting the Lord's Name, one does not fall into hell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਰਾਇਣ ਸੇਵਿ ਸਗਲ ਫਲ ਪਾਹਿ ॥੧॥",
      "transliteration": "naaraain sev sagal phal paahi ||1||",
      "translation": "Serving the Lord, all fruitful rewards are obtained. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਰਾਇਣ ਮਨ ਮਾਹਿ ਅਧਾਰ ॥",
      "transliteration": "naaraain man maahi adhaar ||",
      "translation": "Within my mind is the Support of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਰਾਇਣ ਬੋਹਿਥ ਸੰਸਾਰ ॥",
      "transliteration": "naaraain bohith sa(n)saar ||",
      "translation": "The Lord is the boat to cross over the world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਰਾਇਣ ਕਹਤ ਜਮੁ ਭਾਗਿ ਪਲਾਇਣ ॥",
      "transliteration": "naaraain kahat jam bhaag palaain ||",
      "translation": "Chant the Lord's Name, and the Messenger of Death will run away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਰਾਇਣ ਦੰਤ ਭਾਨੇ ਡਾਇਣ ॥੨॥",
      "transliteration": "naaraain da(n)t bhaane daain ||2||",
      "translation": "The Lord breaks the teeth of Maya, the witch. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਰਾਇਣ ਸਦ ਸਦ ਬਖਸਿੰਦ ॥",
      "transliteration": "naaraain sad sad bakhasi(n)d ||",
      "translation": "The Lord is forever and ever the Forgiver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਰਾਇਣ ਕੀਨੇ ਸੂਖ ਅਨੰਦ ॥",
      "transliteration": "naaraain keene sookh ana(n)d ||",
      "translation": "The Lord blesses us with peace and bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਰਾਇਣ ਪ੍ਰਗਟ ਕੀਨੋ ਪਰਤਾਪ ॥",
      "transliteration": "naaraain pragat keeno parataap ||",
      "translation": "The Lord has revealed His glory.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਰਾਇਣ ਸੰਤ ਕੋ ਮਾਈ ਬਾਪ ॥੩॥",
      "transliteration": "naaraain sa(n)t ko maaee baap ||3||",
      "translation": "The Lord is the mother and father of His Saint. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਰਾਇਣ ਸਾਧਸੰਗਿ ਨਰਾਇਣ ॥",
      "transliteration": "naaraain saadhasa(n)g naraain ||",
      "translation": "The Lord, the Lord, is in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਾਰੰ ਬਾਰ ਨਰਾਇਣ ਗਾਇਣ ॥",
      "transliteration": "baara(n) baar naraain gaain ||",
      "translation": "Time and time again, I sing the Lord's Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਸਤੁ ਅਗੋਚਰ ਗੁਰ ਮਿਲਿ ਲਹੀ ॥",
      "transliteration": "basat agochar gur mil lahee ||",
      "translation": "Meeting with the Guru, I have attained the incomprehensible object.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਰਾਇਣ ਓਟ ਨਾਨਕ ਦਾਸ ਗਹੀ ॥੪॥੧੭॥੧੯॥",
      "transliteration": "naaraain ot naanak daas gahee ||4||17||19||",
      "translation": "Slave Nanak has grasped the Support of the Lord. ||4||17||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਾ ਕਉ ਰਾਖੈ ਰਾਖਣਹਾਰੁ ॥",
      "transliteration": "jaa kau raakhai raakhanahaar ||",
      "translation": "One who is protected by the Protector Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਿਸ ਕਾ ਅੰਗੁ ਕਰੇ ਨਿਰੰਕਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tis kaa a(n)g kare nira(n)kaar ||1|| rahaau ||",
      "translation": "- the Formless Lord is on his side. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਾਤ ਗਰਭ ਮਹਿ ਅਗਨਿ ਨ ਜੋਹੈ ॥",
      "transliteration": "maat garabh mahi agan na johai ||",
      "translation": "In the mother's womb, the fire does not touch him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਲੋਭੁ ਮੋਹੁ ਨ ਪੋਹੈ ॥",
      "transliteration": "kaam krodh lobh mohu na pohai ||",
      "translation": "Sexual desire, anger, greed and emotional attachment do not affect him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਜਪੈ ਨਿਰੰਕਾਰੁ ॥",
      "transliteration": "saadhasa(n)g japai nira(n)kaar ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, he meditates on the Formless Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਿੰਦਕ ਕੈ ਮੁਹਿ ਲਾਗੈ ਛਾਰੁ ॥੧॥",
      "transliteration": "ni(n)dak kai muhi laagai chhaar ||1||",
      "translation": "Dust is thrown into the faces of the slanderers. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਾਮ ਕਵਚੁ ਦਾਸ ਕਾ ਸੰਨਾਹੁ ॥",
      "transliteration": "raam kavach daas kaa sa(n)naahu ||",
      "translation": "The Lord's protective spell is the armor of His slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੂਤ ਦੁਸਟ ਤਿਸੁ ਪੋਹਤ ਨਾਹਿ ॥",
      "transliteration": "doot dusat tis pohat naahi ||",
      "translation": "The wicked, evil demons cannot even touch him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੋ ਜੋ ਗਰਬੁ ਕਰੇ ਸੋ ਜਾਇ ॥",
      "transliteration": "jo jo garab kare so jaai ||",
      "translation": "Whoever indulges in egotistical pride, shall waste away to ruin.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਰੀਬ ਦਾਸ ਕੀ ਪ੍ਰਭੁ ਸਰਣਾਇ ॥੨॥",
      "transliteration": "gareeb daas kee prabh saranaai ||2||",
      "translation": "God is the Sanctuary of His humble slave. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੋ ਜੋ ਸਰਣਿ ਪਇਆ ਹਰਿ ਰਾਇ ॥",
      "transliteration": "jo jo saran paiaa har raai ||",
      "translation": "Whoever enters the Sanctuary of the Sovereign Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੋ ਦਾਸੁ ਰਖਿਆ ਅਪਣੈ ਕੰਠਿ ਲਾਇ ॥",
      "transliteration": "so daas rakhiaa apanai ka(n)th laai ||",
      "translation": "- He saves that slave, hugging him close in His embrace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੇ ਕੋ ਬਹੁਤੁ ਕਰੇ ਅਹੰਕਾਰੁ ॥",
      "transliteration": "je ko bahut kare aha(n)kaar ||",
      "translation": "Whoever takes great pride in himself,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਓਹੁ ਖਿਨ ਮਹਿ ਰੁਲਤਾ ਖਾਕੂ ਨਾਲਿ ॥੩॥",
      "transliteration": "ohu khin mahi rulataa khaakoo naal ||3||",
      "translation": "in an instant, shall be like dust mixing with dust. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹੈ ਭੀ ਸਾਚਾ ਹੋਵਣਹਾਰੁ ॥",
      "transliteration": "hai bhee saachaa hovanahaar ||",
      "translation": "The True Lord is, and shall always be.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਜਾਈਁ ਬਲਿਹਾਰ ॥",
      "transliteration": "sadaa sadaa jaaee(n) balihaar ||",
      "translation": "Forever and ever, I am a sacrifice to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਪਣੇ ਦਾਸ ਰਖੇ ਕਿਰਪਾ ਧਾਰਿ ॥",
      "transliteration": "apane daas rakhe kirapaa dhaar ||",
      "translation": "Granting His Mercy, He saves His slaves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕ ਕੇ ਪ੍ਰਭ ਪ੍ਰਾਣ ਅਧਾਰ ॥੪॥੧੮॥੨੦॥",
      "transliteration": "naanak ke prabh praan adhaar ||4||18||20||",
      "translation": "God is the Support of Nanak's breath of life. ||4||18||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਚਰਜ ਕਥਾ ਮਹਾ ਅਨੂਪ ॥",
      "transliteration": "acharaj kathaa mahaa anoop ||",
      "translation": "Wondrous and beautiful is the description of the beauty of the Supreme Soul,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਾਤਮਾ ਪਾਰਬ੍ਰਹਮ ਕਾ ਰੂਪੁ ॥ ਰਹਾਉ ॥",
      "transliteration": "praatamaa paarabraham kaa roop || rahaau ||",
      "translation": "The Supreme Lord God. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾ ਇਹੁ ਬੂਢਾ ਨਾ ਇਹੁ ਬਾਲਾ ॥",
      "transliteration": "naa ihu boodhaa naa ihu baalaa ||",
      "translation": "He is not old; He is not young.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾ ਇਸੁ ਦੂਖੁ ਨਹੀ ਜਮ ਜਾਲਾ ॥",
      "transliteration": "naa is dookh nahee jam jaalaa ||",
      "translation": "He is not in pain; He is not caught in Death's noose.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾ ਇਹੁ ਬਿਨਸੈ ਨਾ ਇਹੁ ਜਾਇ ॥",
      "transliteration": "naa ihu binasai naa ihu jaai ||",
      "translation": "He does not die; He does not go away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਦਿ ਜੁਗਾਦੀ ਰਹਿਆ ਸਮਾਇ ॥੧॥",
      "transliteration": "aad jugaadee rahiaa samaai ||1||",
      "translation": "In the beginning, and throughout the ages, He is permeating everywhere. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾ ਇਸੁ ਉਸਨੁ ਨਹੀ ਇਸੁ ਸੀਤੁ ॥",
      "transliteration": "naa is usan nahee is seet ||",
      "translation": "He is not hot; He is not cold.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾ ਇਸੁ ਦੁਸਮਨੁ ਨਾ ਇਸੁ ਮੀਤੁ ॥",
      "transliteration": "naa is dusaman naa is meet ||",
      "translation": "He has no enemy; He has no friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾ ਇਸੁ ਹਰਖੁ ਨਹੀ ਇਸੁ ਸੋਗੁ ॥",
      "transliteration": "naa is harakh nahee is sog ||",
      "translation": "He is not happy; He is not sad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਭੁ ਕਿਛੁ ਇਸ ਕਾ ਇਹੁ ਕਰਨੈ ਜੋਗੁ ॥੨॥",
      "transliteration": "sabh kichh is kaa ihu karanai jog ||2||",
      "translation": "Everything belongs to Him; He can do anything. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾ ਇਸੁ ਬਾਪੁ ਨਹੀ ਇਸੁ ਮਾਇਆ ॥",
      "transliteration": "naa is baap nahee is maaiaa ||",
      "translation": "He has no father; He has no mother.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਹੁ ਅਪਰੰਪਰੁ ਹੋਤਾ ਆਇਆ ॥",
      "transliteration": "ihu apara(n)par hotaa aaiaa ||",
      "translation": "He is beyond the beyond, and has always been so.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਪਾਪ ਪੁੰਨ ਕਾ ਇਸੁ ਲੇਪੁ ਨ ਲਾਗੈ ॥",
      "transliteration": "paap pu(n)n kaa is lep na laagai ||",
      "translation": "He is not affected by virtue or vice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਘਟ ਘਟ ਅੰਤਰਿ ਸਦ ਹੀ ਜਾਗੈ ॥੩॥",
      "transliteration": "ghat ghat a(n)tar sad hee jaagai ||3||",
      "translation": "Deep within each and every heart, He is always awake and aware. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤੀਨਿ ਗੁਣਾ ਇਕ ਸਕਤਿ ਉਪਾਇਆ ॥",
      "transliteration": "teen gunaa ik sakat upaaiaa ||",
      "translation": "From the three qualities, the one mechanism of Maya was produced.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਹਾ ਮਾਇਆ ਤਾ ਕੀ ਹੈ ਛਾਇਆ ॥",
      "transliteration": "mahaa maaiaa taa kee hai chhaaiaa ||",
      "translation": "The great Maya is only His shadow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅਛਲ ਅਛੇਦ ਅਭੇਦ ਦਇਆਲ ॥",
      "transliteration": "achhal achhed abhed daiaal ||",
      "translation": "He is undeceivable, impenetrable, unfathomable and merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਦੀਨ ਦਇਆਲ ਸਦਾ ਕਿਰਪਾਲ ॥",
      "transliteration": "deen daiaal sadaa kirapaal ||",
      "translation": "He is merciful to the meek, forever compassionate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤਾ ਕੀ ਗਤਿ ਮਿਤਿ ਕਛੂ ਨ ਪਾਇ ॥",
      "transliteration": "taa kee gat mit kachhoo na paai ||",
      "translation": "His state and limits cannot ever be known.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0868_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕੈ ਬਲਿ ਬਲਿ ਜਾਇ ॥੪॥੧੯॥੨੧॥",
      "transliteration": "naanak taa kai bal bal jaai ||4||19||21||",
      "translation": "Nanak is a sacrifice, a sacrifice to Him. ||4||19||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 868,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
