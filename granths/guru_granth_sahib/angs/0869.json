{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 869,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0869_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੋਂਡ ਮਹਲਾ ੫ ॥",
      "transliteration": "go(n)d mahalaa 5 ||",
      "translation": "Gond, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੰਤਨ ਕੈ ਬਲਿਹਾਰੈ ਜਾਉ ॥",
      "transliteration": "sa(n)tan kai balihaarai jaau ||",
      "translation": "I am a sacrifice to the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੰਤਨ ਕੈ ਸੰਗਿ ਰਾਮ ਗੁਨ ਗਾਉ ॥",
      "transliteration": "sa(n)tan kai sa(n)g raam gun gaau ||",
      "translation": "Associating with the Saints, I sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਕਿਲਵਿਖ ਸਭਿ ਗਏ ॥",
      "transliteration": "sa(n)t prasaad kilavikh sabh gae ||",
      "translation": "By the Grace of the Saints, all the sins are taken away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੰਤ ਸਰਣਿ ਵਡਭਾਗੀ ਪਏ ॥੧॥",
      "transliteration": "sa(n)t saran vadabhaagee pae ||1||",
      "translation": "By great good fortune, one finds the Sanctuary of the Saints. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਮੁ ਜਪਤ ਕਛੁ ਬਿਘਨੁ ਨ ਵਿਆਪੈ ॥",
      "transliteration": "raam japat kachh bighan na viaapai ||",
      "translation": "Meditating on the Lord, no obstacles will block your way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਅਪੁਨਾ ਪ੍ਰਭੁ ਜਾਪੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur prasaad apunaa prabh jaapai ||1|| rahaau ||",
      "translation": "By Guru's Grace, meditate on God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਜਬ ਹੋਇ ਦਇਆਲ ॥",
      "transliteration": "paarabraham jab hoi daiaal ||",
      "translation": "When the Supreme Lord God becomes merciful,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਾਧੂ ਜਨ ਕੀ ਕਰੈ ਰਵਾਲ ॥",
      "transliteration": "saadhoo jan kee karai ravaal ||",
      "translation": "he makes me the dust of the feet of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਇਸੁ ਤਨ ਤੇ ਜਾਇ ॥",
      "transliteration": "kaam krodh is tan te jaai ||",
      "translation": "Sexual desire and anger leave his body,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਮ ਰਤਨੁ ਵਸੈ ਮਨਿ ਆਇ ॥੨॥",
      "transliteration": "raam ratan vasai man aai ||2||",
      "translation": "and the Lord, the jewel, comes to dwell in his mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਫਲੁ ਜਨਮੁ ਤਾਂ ਕਾ ਪਰਵਾਣੁ ॥",
      "transliteration": "saphal janam taa(n) kaa paravaan ||",
      "translation": "Fruitful and approved is the life of one",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਨਿਕਟਿ ਕਰਿ ਜਾਣੁ ॥",
      "transliteration": "paarabraham nikat kar jaan ||",
      "translation": "who knows the Supreme Lord God to be close.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਭਾਇ ਭਗਤਿ ਪ੍ਰਭ ਕੀਰਤਨਿ ਲਾਗੈ ॥",
      "transliteration": "bhaai bhagat prabh keeratan laagai ||",
      "translation": "One who is committed to loving devotional worship of God, and the Kirtan of His Praises,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕਾ ਸੋਇਆ ਜਾਗੈ ॥੩॥",
      "transliteration": "janam janam kaa soiaa jaagai ||3||",
      "translation": "awakens from the sleep of countless incarnations. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਜਨ ਕਾ ਆਧਾਰੁ ॥",
      "transliteration": "charan kamal jan kaa aadhaar ||",
      "translation": "The Lord's Lotus Feet are the Support of His humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਣ ਗੋਵਿੰਦ ਰਉਂ ਸਚੁ ਵਾਪਾਰੁ ॥",
      "transliteration": "gun govi(n)d rau(n) sach vaapaar ||",
      "translation": "To chant the Praises of the Lord of the Universe is the true trade.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦਾਸ ਜਨਾ ਕੀ ਮਨਸਾ ਪੂਰਿ ॥",
      "transliteration": "daas janaa kee manasaa poor ||",
      "translation": "Please fulfill the hopes of Your humble slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਸੁਖੁ ਪਾਵੈ ਜਨ ਧੂਰਿ ॥੪॥੨੦॥੨੨॥੬॥੨੮॥",
      "transliteration": "naanak sukh paavai jan dhoor ||4||20||22||6||28||",
      "translation": "Nanak finds peace in the dust of the feet of the humble. ||4||20||22||6||28||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਗੁ ਗੋਂਡ ਅਸਟਪਦੀਆ ਮਹਲਾ ੫ ਘਰੁ ੨ ॥",
      "transliteration": "raag go(n)d asatapadeeaa mahalaa 5 ghar 2 ||",
      "translation": "Raag Gond, Ashtpadheeyaa, Fifth Mehl, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਰਿ ਨਮਸਕਾਰ ਪੂਰੇ ਗੁਰਦੇਵ ॥",
      "transliteration": "kar namasakaar poore guradev ||",
      "translation": "Humbly bow to the Perfect Divine Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਫਲ ਮੂਰਤਿ ਸਫਲ ਜਾ ਕੀ ਸੇਵ ॥",
      "transliteration": "saphal moorat saphal jaa kee sev ||",
      "translation": "Fruitful is His image, and fruitful is service to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅੰਤਰਜਾਮੀ ਪੁਰਖੁ ਬਿਧਾਤਾ ॥",
      "transliteration": "a(n)tarajaamee purakh bidhaataa ||",
      "translation": "He is the Inner-knower, the Searcher of hearts, the Architect of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਠ ਪਹਰ ਨਾਮ ਰੰਗਿ ਰਾਤਾ ॥੧॥",
      "transliteration": "aath pahar naam ra(n)g raataa ||1||",
      "translation": "Twenty-four hours a day, he remains imbued with the love of the Naam, the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੁਰੁ ਗੋਬਿੰਦ ਗੁਰੂ ਗੋਪਾਲ ॥",
      "transliteration": "gur gobi(n)d guroo gopaal ||",
      "translation": "The Guru is the Lord of the Universe, the Guru is the Lord of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਪਨੇ ਦਾਸ ਕਉ ਰਾਖਨਹਾਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "apane daas kau raakhanahaar ||1|| rahaau ||",
      "translation": "He is the Saving Grace of His slaves. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪਾਤਿਸਾਹ ਸਾਹ ਉਮਰਾਉ ਪਤੀਆਏ ॥",
      "transliteration": "paatisaah saah umaraau pateeaae ||",
      "translation": "He satisfies the kings, emperors and nobles.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੁਸਟ ਅਹੰਕਾਰੀ ਮਾਰਿ ਪਚਾਏ ॥",
      "transliteration": "dusat aha(n)kaaree maar pachaae ||",
      "translation": "He destroys the egotistical villains.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਿੰਦਕ ਕੈ ਮੁਖਿ ਕੀਨੋ ਰੋਗੁ ॥",
      "transliteration": "ni(n)dak kai mukh keeno rog ||",
      "translation": "He puts illness into the mouths of the slanderers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੈ ਜੈ ਕਾਰੁ ਕਰੈ ਸਭੁ ਲੋਗੁ ॥੨॥",
      "transliteration": "jai jai kaar karai sabh log ||2||",
      "translation": "All the people celebrate His victory. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੰਤਨ ਕੈ ਮਨਿ ਮਹਾ ਅਨੰਦੁ ॥",
      "transliteration": "sa(n)tan kai man mahaa ana(n)d ||",
      "translation": "Supreme bliss fills the minds of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੰਤ ਜਪਹਿ ਗੁਰਦੇਉ ਭਗਵੰਤੁ ॥",
      "transliteration": "sa(n)t japahi guradeu bhagava(n)t ||",
      "translation": "The Saints meditate on the Divine Guru, the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੰਗਤਿ ਕੇ ਮੁਖ ਊਜਲ ਭਏ ॥",
      "transliteration": "sa(n)gat ke mukh oojal bhae ||",
      "translation": "The faces of His companions become radiant and bright.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਗਲ ਥਾਨ ਨਿੰਦਕ ਕੇ ਗਏ ॥੩॥",
      "transliteration": "sagal thaan ni(n)dak ke gae ||3||",
      "translation": "The slanderers lose all places of rest. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਾਸਿ ਸਾਸਿ ਜਨੁ ਸਦਾ ਸਲਾਹੇ ॥",
      "transliteration": "saas saas jan sadaa salaahe ||",
      "translation": "With each and every breath, the Lord's humble slaves praise Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਗੁਰ ਬੇਪਰਵਾਹੇ ॥",
      "transliteration": "paarabraham gur beparavaahe ||",
      "translation": "The Supreme Lord God and the Guru are care-free.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਗਲ ਭੈ ਮਿਟੇ ਜਾ ਕੀ ਸਰਨਿ ॥",
      "transliteration": "sagal bhai mite jaa kee saran ||",
      "translation": "All fears are eradicated, in His Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਿੰਦਕ ਮਾਰਿ ਪਾਏ ਸਭਿ ਧਰਨਿ ॥੪॥",
      "transliteration": "ni(n)dak maar paae sabh dharan ||4||",
      "translation": "Smashing all the slanderers, the Lord knocks them to the ground. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਨ ਕੀ ਨਿੰਦਾ ਕਰੈ ਨ ਕੋਇ ॥",
      "transliteration": "jan kee ni(n)daa karai na koi ||",
      "translation": "Let no one slander the Lord's humble servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੋ ਕਰੈ ਸੋ ਦੁਖੀਆ ਹੋਇ ॥",
      "transliteration": "jo karai so dukheeaa hoi ||",
      "translation": "Whoever does so, will be miserable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਠ ਪਹਰ ਜਨੁ ਏਕੁ ਧਿਆਏ ॥",
      "transliteration": "aath pahar jan ek dhiaae ||",
      "translation": "Twenty-four hours a day, the Lord's humble servant meditates on Him alone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਮੂਆ ਤਾ ਕੈ ਨਿਕਟਿ ਨ ਜਾਏ ॥੫॥",
      "transliteration": "jamooaa taa kai nikat na jaae ||5||",
      "translation": "The Messenger of Death does not even approach him. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਨ ਨਿਰਵੈਰ ਨਿੰਦਕ ਅਹੰਕਾਰੀ ॥",
      "transliteration": "jan niravair ni(n)dak aha(n)kaaree ||",
      "translation": "The Lord's humble servant has no vengeance. The slanderer is egotistical.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਨ ਭਲ ਮਾਨਹਿ ਨਿੰਦਕ ਵੇਕਾਰੀ ॥",
      "transliteration": "jan bhal maanahi ni(n)dak vekaaree ||",
      "translation": "The Lord's humble servant wishes well, while the slanderer dwells on evil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਿਖਿ ਸਤਿਗੁਰੂ ਧਿਆਇਆ ॥",
      "transliteration": "gur kai sikh satiguroo dhiaaiaa ||",
      "translation": "The Sikh of the Guru meditates on the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਨ ਉਬਰੇ ਨਿੰਦਕ ਨਰਕਿ ਪਾਇਆ ॥੬॥",
      "transliteration": "jan ubare ni(n)dak narak paaiaa ||6||",
      "translation": "The Lord's humble servants are saved, while the slanderer is cast into hell. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੁਣਿ ਸਾਜਨ ਮੇਰੇ ਮੀਤ ਪਿਆਰੇ ॥",
      "transliteration": "sun saajan mere meet piaare ||",
      "translation": "Listen, O my beloved friends and companions:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਤਿ ਬਚਨ ਵਰਤਹਿ ਹਰਿ ਦੁਆਰੇ ॥",
      "transliteration": "sat bachan varatahi har duaare ||",
      "translation": "these words shall be true in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜੈਸਾ ਕਰੇ ਸੁ ਤੈਸਾ ਪਾਏ ॥",
      "transliteration": "jaisaa kare s taisaa paae ||",
      "translation": "As you plant, so shall you harvest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਭਿਮਾਨੀ ਕੀ ਜੜ ਸਰਪਰ ਜਾਏ ॥੭॥",
      "transliteration": "abhimaanee kee jaR sarapar jaae ||7||",
      "translation": "The proud, egotistical person will surely be uprooted. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨੀਧਰਿਆ ਸਤਿਗੁਰ ਧਰ ਤੇਰੀ ॥",
      "transliteration": "needhariaa satigur dhar teree ||",
      "translation": "O True Guru, You are the Support of the unsupported.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਰਾਖਹੁ ਜਨ ਕੇਰੀ ॥",
      "transliteration": "kar kirapaa raakhahu jan keree ||",
      "translation": "Be merciful, and save Your humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਤਿਸੁ ਗੁਰ ਬਲਿਹਾਰੀ ॥",
      "transliteration": "kahu naanak tis gur balihaaree ||",
      "translation": "Says Nanak, I am a sacrifice to the Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0869_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਾ ਕੈ ਸਿਮਰਨਿ ਪੈਜ ਸਵਾਰੀ ॥੮॥੧॥੨੯॥",
      "transliteration": "jaa kai simaran paij savaaree ||8||1||29||",
      "translation": "remembering Him in meditation, my honor has been saved. ||8||1||29||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 869,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
