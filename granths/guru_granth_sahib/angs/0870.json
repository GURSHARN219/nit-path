{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 870,
  "lineCount": 47,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0870_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਗੁ ਗੋਂਡ ਬਾਣੀ ਭਗਤਾ ਕੀ ॥ ਕਬੀਰ ਜੀ ਘਰੁ ੧ ॥",
      "transliteration": "raag go(n)d baanee bhagataa kee || kabeer jee ghar 1 ||",
      "translation": "Raag Gond, The Word Of The Devotees. Kabeer Jee, First House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੰਤੁ ਮਿਲੈ ਕਿਛੁ ਸੁਨੀਐ ਕਹੀਐ ॥",
      "transliteration": "sa(n)t milai kichh suneeai kaheeai ||",
      "translation": "When you meet a Saint, talk to him and listen.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਿਲੈ ਅਸੰਤੁ ਮਸਟਿ ਕਰਿ ਰਹੀਐ ॥੧॥",
      "transliteration": "milai asa(n)t masat kar raheeai ||1||",
      "translation": "Meeting with an unsaintly person, just remain silent. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਾਬਾ ਬੋਲਨਾ ਕਿਆ ਕਹੀਐ ॥",
      "transliteration": "baabaa bolanaa kiaa kaheeai ||",
      "translation": "O father, if I speak, what words should I utter?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੈਸੇ ਰਾਮ ਨਾਮ ਰਵਿ ਰਹੀਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaise raam naam rav raheeai ||1|| rahaau ||",
      "translation": "Speak such words, by which you may remain absorbed in the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੰਤਨ ਸਿਉ ਬੋਲੇ ਉਪਕਾਰੀ ॥",
      "transliteration": "sa(n)tan siu bole upakaaree ||",
      "translation": "Speaking with the Saints, one becomes generous.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮੂਰਖ ਸਿਉ ਬੋਲੇ ਝਖ ਮਾਰੀ ॥੨॥",
      "transliteration": "moorakh siu bole jhakh maaree ||2||",
      "translation": "To speak with a fool is to babble uselessly. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬੋਲਤ ਬੋਲਤ ਬਢਹਿ ਬਿਕਾਰਾ ॥",
      "transliteration": "bolat bolat badhahi bikaaraa ||",
      "translation": "By speaking and only speaking, corruption only increases.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਨੁ ਬੋਲੇ ਕਿਆ ਕਰਹਿ ਬੀਚਾਰਾ ॥੩॥",
      "transliteration": "bin bole kiaa karahi beechaaraa ||3||",
      "translation": "If I do not speak, what can the poor wretch do? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਛੂਛਾ ਘਟੁ ਬੋਲੈ ॥",
      "transliteration": "kahu kabeer chhoochhaa ghat bolai ||",
      "translation": "Says Kabeer, the empty pitcher makes noise,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਭਰਿਆ ਹੋਇ ਸੁ ਕਬਹੁ ਨ ਡੋਲੈ ॥੪॥੧॥",
      "transliteration": "bhariaa hoi s kabahu na dolai ||4||1||",
      "translation": "but that which is full makes no sound. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਰੂ ਮਰੈ ਨਰੁ ਕਾਮਿ ਨ ਆਵੈ ॥",
      "transliteration": "naroo marai nar kaam na aavai ||",
      "translation": "When a man dies, he is of no use to anyone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਸੂ ਮਰੈ ਦਸ ਕਾਜ ਸਵਾਰੈ ॥੧॥",
      "transliteration": "pasoo marai das kaaj savaarai ||1||",
      "translation": "But when an animal dies, it is used in ten ways. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਪਨੇ ਕਰਮ ਕੀ ਗਤਿ ਮੈ ਕਿਆ ਜਾਨਉ ॥",
      "transliteration": "apane karam kee gat mai kiaa jaanau ||",
      "translation": "What do I know, about the state of my karma?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੈ ਕਿਆ ਜਾਨਉ ਬਾਬਾ ਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mai kiaa jaanau baabaa re ||1|| rahaau ||",
      "translation": "What do I know, O Baba? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹਾਡ ਜਲੇ ਜੈਸੇ ਲਕਰੀ ਕਾ ਤੂਲਾ ॥",
      "transliteration": "haad jale jaise lakaree kaa toolaa ||",
      "translation": "His bones burn, like a bundle of logs;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕੇਸ ਜਲੇ ਜੈਸੇ ਘਾਸ ਕਾ ਪੂਲਾ ॥੨॥",
      "transliteration": "kes jale jaise ghaas kaa poolaa ||2||",
      "translation": "his hair burns like a bale of hay. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਤਬ ਹੀ ਨਰੁ ਜਾਗੈ ॥",
      "transliteration": "kahu kabeer tab hee nar jaagai ||",
      "translation": "Says Kabeer, the man wakes up,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਮ ਕਾ ਡੰਡੁ ਮੂੰਡ ਮਹਿ ਲਾਗੈ ॥੩॥੨॥",
      "transliteration": "jam kaa da(n)d moo(n)d mahi laagai ||3||2||",
      "translation": "only when the Messenger of Death hits him over the head with his club. ||3||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਆਕਾਸਿ ਗਗਨੁ ਪਾਤਾਲਿ ਗਗਨੁ ਹੈ ਚਹੁ ਦਿਸਿ ਗਗਨੁ ਰਹਾਇਲੇ ॥",
      "transliteration": "aakaas gagan paataal gagan hai chahu dis gagan rahaaile ||",
      "translation": "The Celestial Lord is in the Akaashic ethers of the skies, the Celestial Lord is in the nether regions of the underworld; in the four directions, the Celestial Lord is pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਨਦ ਮੂਲੁ ਸਦਾ ਪੁਰਖੋਤਮੁ ਘਟੁ ਬਿਨਸੈ ਗਗਨੁ ਨ ਜਾਇਲੇ ॥੧॥",
      "transliteration": "aanad mool sadaa purakhotam ghat binasai gagan na jaaile ||1||",
      "translation": "The Supreme Lord God is forever the source of bliss. When the vessel of the body perishes, the Celestial Lord does not perish. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੋਹਿ ਬੈਰਾਗੁ ਭਇਓ ॥",
      "transliteration": "mohi bairaag bhaio ||",
      "translation": "I have become sad,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਇਹੁ ਜੀਉ ਆਇ ਕਹਾ ਗਇਓ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ihu jeeu aai kahaa gaio ||1|| rahaau ||",
      "translation": "wondering where the soul comes from, and where it goes. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੰਚ ਤਤੁ ਮਿਲਿ ਕਾਇਆ ਕੀਨੑੀ ਤਤੁ ਕਹਾ ਤੇ ਕੀਨੁ ਰੇ ॥",
      "transliteration": "pa(n)ch tat mil kaaiaa keenhee tat kahaa te keen re ||",
      "translation": "The body is formed from the union of the five tatvas; but where were the five tatvas created?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਰਮ ਬਧ ਤੁਮ ਜੀਉ ਕਹਤ ਹੌ ਕਰਮਹਿ ਕਿਨਿ ਜੀਉ ਦੀਨੁ ਰੇ ॥੨॥",
      "transliteration": "karam badh tum jeeu kahat hau karamahi kin jeeu deen re ||2||",
      "translation": "You say that the soul is tied to its karma, but who gave karma to the body? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਰਿ ਮਹਿ ਤਨੁ ਹੈ ਤਨ ਮਹਿ ਹਰਿ ਹੈ ਸਰਬ ਨਿਰੰਤਰਿ ਸੋਇ ਰੇ ॥",
      "transliteration": "har mahi tan hai tan mahi har hai sarab nira(n)tar soi re ||",
      "translation": "The body is contained in the Lord, and the Lord is contained in the body. He is permeating within all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਰਾਮ ਨਾਮੁ ਨ ਛੋਡਉ ਸਹਜੇ ਹੋਇ ਸੁ ਹੋਇ ਰੇ ॥੩॥੩॥",
      "transliteration": "kahi kabeer raam naam na chhodau sahaje hoi s hoi re ||3||3||",
      "translation": "Says Kabeer, I shall not renounce the Lord's Name. I shall accept whatever happens. ||3||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਗੁ ਗੋਂਡ ਬਾਣੀ ਕਬੀਰ ਜੀਉ ਕੀ ਘਰੁ ੨ ॥",
      "transliteration": "raag go(n)d baanee kabeer jeeu kee ghar 2 ||",
      "translation": "Raag Gond, The Word Of Kabeer Jee, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭੁਜਾ ਬਾਂਧਿ ਭਿਲਾ ਕਰਿ ਡਾਰਿਓ ॥",
      "transliteration": "bhujaa baa(n)dh bhilaa kar daario ||",
      "translation": "They tied my arms, bundled me up, and threw me before an elephant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਸਤੀ ਕ੍ਰੋਪਿ ਮੂੰਡ ਮਹਿ ਮਾਰਿਓ ॥",
      "transliteration": "hasatee krop moo(n)d mahi maario ||",
      "translation": "The elephant driver struck him on the head, and infuriated him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਸਤਿ ਭਾਗਿ ਕੈ ਚੀਸਾ ਮਾਰੈ ॥",
      "transliteration": "hasat bhaag kai cheesaa maarai ||",
      "translation": "But the elephant ran away, trumpeting,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਆ ਮੂਰਤਿ ਕੈ ਹਉ ਬਲਿਹਾਰੈ ॥੧॥",
      "transliteration": "iaa moorat kai hau balihaarai ||1||",
      "translation": "\"I am a sacrifice to this image of the Lord.\" ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਹਿ ਮੇਰੇ ਠਾਕੁਰ ਤੁਮਰਾ ਜੋਰੁ ॥",
      "transliteration": "aahi mere thaakur tumaraa jor ||",
      "translation": "O my Lord and Master, You are my strength.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਾਜੀ ਬਕਿਬੋ ਹਸਤੀ ਤੋਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kaajee bakibo hasatee tor ||1|| rahaau ||",
      "translation": "The Qazi shouted at the driver to drive the elephant on. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰੇ ਮਹਾਵਤ ਤੁਝੁ ਡਾਰਉ ਕਾਟਿ ॥",
      "transliteration": "re mahaavat tujh daarau kaat ||",
      "translation": "He yelled out, \"O driver, I shall cut you into pieces.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਇਸਹਿ ਤੁਰਾਵਹੁ ਘਾਲਹੁ ਸਾਟਿ ॥",
      "transliteration": "isahi turaavahu ghaalahu saat ||",
      "translation": "Hit him, and drive him on!\"",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਸਤਿ ਨ ਤੋਰੈ ਧਰੈ ਧਿਆਨੁ ॥",
      "transliteration": "hasat na torai dharai dhiaan ||",
      "translation": "But the elephant did not move; instead, he began to meditate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਵਾ ਕੈ ਰਿਦੈ ਬਸੈ ਭਗਵਾਨੁ ॥੨॥",
      "transliteration": "vaa kai ridai basai bhagavaan ||2||",
      "translation": "The Lord God abides within his mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿਆ ਅਪਰਾਧੁ ਸੰਤ ਹੈ ਕੀਨੑਾ ॥",
      "transliteration": "kiaa aparaadh sa(n)t hai keenhaa ||",
      "translation": "What sin has this Saint committed,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਾਂਧਿ ਪੋਟ ਕੁੰਚਰ ਕਉ ਦੀਨੑਾ ॥",
      "transliteration": "baa(n)dh pot ku(n)char kau deenhaa ||",
      "translation": "that you have made him into a bundle and thrown him before the elephant?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕੁੰਚਰੁ ਪੋਟ ਲੈ ਲੈ ਨਮਸਕਾਰੈ ॥",
      "transliteration": "ku(n)char pot lai lai namasakaarai ||",
      "translation": "Lifting up the bundle, the elephant bows down before it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬੂਝੀ ਨਹੀ ਕਾਜੀ ਅੰਧਿਆਰੈ ॥੩॥",
      "transliteration": "boojhee nahee kaajee a(n)dhiaarai ||3||",
      "translation": "The Qazi could not understand it; he was blind. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0870_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤੀਨਿ ਬਾਰ ਪਤੀਆ ਭਰਿ ਲੀਨਾ ॥",
      "transliteration": "teen baar pateeaa bhar leenaa ||",
      "translation": "Three times, he tried to do it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 870,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
