{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 871,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0871_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਨ ਕਠੋਰੁ ਅਜਹੂ ਨ ਪਤੀਨਾ ॥",
      "transliteration": "man kathor ajahoo na pateenaa ||",
      "translation": "Even then, his hardened mind was not satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਹਮਰਾ ਗੋਬਿੰਦੁ ॥",
      "transliteration": "kahi kabeer hamaraa gobi(n)d ||",
      "translation": "Says Kabeer, such is my Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚਉਥੇ ਪਦ ਮਹਿ ਜਨ ਕੀ ਜਿੰਦੁ ॥੪॥੧॥੪॥",
      "transliteration": "chauthe pad mahi jan kee ji(n)d ||4||1||4||",
      "translation": "The soul of His humble servant dwells in the fourth state. ||4||1||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾ ਇਹੁ ਮਾਨਸੁ ਨਾ ਇਹੁ ਦੇਉ ॥",
      "transliteration": "naa ihu maanas naa ihu deu ||",
      "translation": "It is not human, and it is not a god.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾ ਇਹੁ ਜਤੀ ਕਹਾਵੈ ਸੇਉ ॥",
      "transliteration": "naa ihu jatee kahaavai seu ||",
      "translation": "It is not called celibate, or a worshipper of Shiva.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾ ਇਹੁ ਜੋਗੀ ਨਾ ਅਵਧੂਤਾ ॥",
      "transliteration": "naa ihu jogee naa avadhootaa ||",
      "translation": "It is not a Yogi, and it is not a hermit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾ ਇਸੁ ਮਾਇ ਨ ਕਾਹੂ ਪੂਤਾ ॥੧॥",
      "transliteration": "naa is maai na kaahoo pootaa ||1||",
      "translation": "It is not a mother, or anyone's son. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇਆ ਮੰਦਰ ਮਹਿ ਕੌਨ ਬਸਾਈ ॥",
      "transliteration": "iaa ma(n)dar mahi kaun basaaee ||",
      "translation": "Then what is it, which dwells in this temple of the body?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਾ ਕਾ ਅੰਤੁ ਨ ਕੋਊ ਪਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "taa kaa a(n)t na kooo paaee ||1|| rahaau ||",
      "translation": "No one can find its limits. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾ ਇਹੁ ਗਿਰਹੀ ਨਾ ਓਦਾਸੀ ॥",
      "transliteration": "naa ihu girahee naa odaasee ||",
      "translation": "It is not a house-holder, and it is not a renouncer of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾ ਇਹੁ ਰਾਜ ਨ ਭੀਖ ਮੰਗਾਸੀ ॥",
      "transliteration": "naa ihu raaj na bheekh ma(n)gaasee ||",
      "translation": "It is not a king, and it is not a beggar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾ ਇਸੁ ਪਿੰਡੁ ਨ ਰਕਤੂ ਰਾਤੀ ॥",
      "transliteration": "naa is pi(n)d na rakatoo raatee ||",
      "translation": "It has no body, no drop of blood.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾ ਇਹੁ ਬ੍ਰਹਮਨੁ ਨਾ ਇਹੁ ਖਾਤੀ ॥੨॥",
      "transliteration": "naa ihu brahaman naa ihu khaatee ||2||",
      "translation": "It is not a Brahmin, and it is not a Kh'shaatriya. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾ ਇਹੁ ਤਪਾ ਕਹਾਵੈ ਸੇਖੁ ॥",
      "transliteration": "naa ihu tapaa kahaavai sekh ||",
      "translation": "It is not called a man of austere self-discipline, or a Shaykh.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾ ਇਹੁ ਜੀਵੈ ਨ ਮਰਤਾ ਦੇਖੁ ॥",
      "transliteration": "naa ihu jeevai na marataa dekh ||",
      "translation": "It does not live, and it is not seen to die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਸੁ ਮਰਤੇ ਕਉ ਜੇ ਕੋਊ ਰੋਵੈ ॥",
      "transliteration": "is marate kau je kooo rovai ||",
      "translation": "If someone cries over its death,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੋ ਰੋਵੈ ਸੋਈ ਪਤਿ ਖੋਵੈ ॥੩॥",
      "transliteration": "jo rovai soee pat khovai ||3||",
      "translation": "that person loses his honor. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਮੈ ਡਗਰੋ ਪਾਇਆ ॥",
      "transliteration": "gur prasaad mai dagaro paaiaa ||",
      "translation": "By Guru's Grace, I have found the Path.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੀਵਨ ਮਰਨੁ ਦੋਊ ਮਿਟਵਾਇਆ ॥",
      "transliteration": "jeevan maran dooo mitavaaiaa ||",
      "translation": "Birth and death have both been erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਇਹੁ ਰਾਮ ਕੀ ਅੰਸੁ ॥",
      "transliteration": "kahu kabeer ihu raam kee a(n)s ||",
      "translation": "Says Kabeer, this is formed of the same essence as the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਸ ਕਾਗਦ ਪਰ ਮਿਟੈ ਨ ਮੰਸੁ ॥੪॥੨॥੫॥",
      "transliteration": "jas kaagad par mitai na ma(n)s ||4||2||5||",
      "translation": "It is like the ink on the paper which cannot be erased. ||4||2||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤੂਟੇ ਤਾਗੇ ਨਿਖੁਟੀ ਪਾਨਿ ॥",
      "transliteration": "toote taage nikhutee paan ||",
      "translation": "The threads are broken, and the starch has run out.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦੁਆਰ ਊਪਰਿ ਝਿਲਕਾਵਹਿ ਕਾਨ ॥",
      "transliteration": "duaar oopar jhilakaavahi kaan ||",
      "translation": "Bare reeds glisten at the front door.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕੂਚ ਬਿਚਾਰੇ ਫੂਏ ਫਾਲ ॥",
      "transliteration": "kooch bichaare phooe phaal ||",
      "translation": "The poor brushes are scattered in pieces.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਆ ਮੁੰਡੀਆ ਸਿਰਿ ਚਢਿਬੋ ਕਾਲ ॥੧॥",
      "transliteration": "iaa mu(n)deeaa sir chadhibo kaal ||1||",
      "translation": "Death has entered this shaven head. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਹੁ ਮੁੰਡੀਆ ਸਗਲੋ ਦ੍ਰਬੁ ਖੋਈ ॥",
      "transliteration": "ihu mu(n)deeaa sagalo drab khoee ||",
      "translation": "This shaven-headed mendicant has wasted all his wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਵਤ ਜਾਤ ਨਾਕ ਸਰ ਹੋਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aavat jaat naak sar hoee ||1|| rahaau ||",
      "translation": "All this coming and going has irritated him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੁਰੀ ਨਾਰਿ ਕੀ ਛੋਡੀ ਬਾਤਾ ॥",
      "transliteration": "turee naar kee chhodee baataa ||",
      "translation": "He has given up all talk of his weaving equipment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਵਾ ਕਾ ਮਨੁ ਰਾਤਾ ॥",
      "transliteration": "raam naam vaa kaa man raataa ||",
      "translation": "His mind is attuned to the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਲਰਿਕੀ ਲਰਿਕਨ ਖੈਬੋ ਨਾਹਿ ॥",
      "transliteration": "larikee larikan khaibo naahi ||",
      "translation": "His daughters and sons have nothing to eat,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੁੰਡੀਆ ਅਨਦਿਨੁ ਧਾਪੇ ਜਾਹਿ ॥੨॥",
      "transliteration": "mu(n)deeaa anadin dhaape jaahi ||2||",
      "translation": "while the shaven-headed mendicants night and day eat their fill. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਇਕ ਦੁਇ ਮੰਦਰਿ ਇਕ ਦੁਇ ਬਾਟ ॥",
      "transliteration": "ik dui ma(n)dar ik dui baat ||",
      "translation": "One or two are in the house, and one or two more are on the way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਮ ਕਉ ਸਾਥਰੁ ਉਨ ਕਉ ਖਾਟ ॥",
      "transliteration": "ham kau saathar un kau khaat ||",
      "translation": "We sleep on the floor, while they sleep in the beds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੂਡ ਪਲੋਸਿ ਕਮਰ ਬਧਿ ਪੋਥੀ ॥",
      "transliteration": "mood palos kamar badh pothee ||",
      "translation": "They rub their bare heads, and carry prayer-books in their waist-bands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਮ ਕਉ ਚਾਬਨੁ ਉਨ ਕਉ ਰੋਟੀ ॥੩॥",
      "transliteration": "ham kau chaaban un kau rotee ||3||",
      "translation": "We get dry grains, while they get loaves of bread. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੁੰਡੀਆ ਮੁੰਡੀਆ ਹੂਏ ਏਕ ॥",
      "transliteration": "mu(n)deeaa mu(n)deeaa hooe ek ||",
      "translation": "He will become one of these shaven-headed mendicants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਏ ਮੁੰਡੀਆ ਬੂਡਤ ਕੀ ਟੇਕ ॥",
      "transliteration": "e mu(n)deeaa boodat kee tek ||",
      "translation": "They are the support of the drowning.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੁਨਿ ਅੰਧਲੀ ਲੋਈ ਬੇਪੀਰਿ ॥",
      "transliteration": "sun a(n)dhalee loee bepeer ||",
      "translation": "Listen, O blind and unguided Loi:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਇਨੑ ਮੁੰਡੀਅਨ ਭਜਿ ਸਰਨਿ ਕਬੀਰ ॥੪॥੩॥੬॥",
      "transliteration": "inh mu(n)deean bhaj saran kabeer ||4||3||6||",
      "translation": "Kabeer has taken shelter with these shaven-headed mendicants. ||4||3||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਖਸਮੁ ਮਰੈ ਤਉ ਨਾਰਿ ਨ ਰੋਵੈ ॥",
      "transliteration": "khasam marai tau naar na rovai ||",
      "translation": "When her husband dies, the woman does not cry.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਉਸੁ ਰਖਵਾਰਾ ਅਉਰੋ ਹੋਵੈ ॥",
      "transliteration": "us rakhavaaraa auro hovai ||",
      "translation": "Someone else becomes her protector.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਖਵਾਰੇ ਕਾ ਹੋਇ ਬਿਨਾਸ ॥",
      "transliteration": "rakhavaare kaa hoi binaas ||",
      "translation": "When this protector dies,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਗੈ ਨਰਕੁ ਈਹਾ ਭੋਗ ਬਿਲਾਸ ॥੧॥",
      "transliteration": "aagai narak eehaa bhog bilaas ||1||",
      "translation": "he falls into the world of hell hereafter, for the sexual pleasures he enjoyed in this world. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਏਕ ਸੁਹਾਗਨਿ ਜਗਤ ਪਿਆਰੀ ॥",
      "transliteration": "ek suhaagan jagat piaaree ||",
      "translation": "The world loves only the one bride, Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਗਲੇ ਜੀਅ ਜੰਤ ਕੀ ਨਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sagale jee ja(n)t kee naaree ||1|| rahaau ||",
      "translation": "She is the wife of all beings and creatures. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੋਹਾਗਨਿ ਗਲਿ ਸੋਹੈ ਹਾਰੁ ॥",
      "transliteration": "sohaagan gal sohai haar ||",
      "translation": "With her necklace around her neck, this bride looks beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੰਤ ਕਉ ਬਿਖੁ ਬਿਗਸੈ ਸੰਸਾਰੁ ॥",
      "transliteration": "sa(n)t kau bikh bigasai sa(n)saar ||",
      "translation": "She is poison to the Saint, but the world is delighted with her.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਰਿ ਸੀਗਾਰੁ ਬਹੈ ਪਖਿਆਰੀ ॥",
      "transliteration": "kar seegaar bahai pakhiaaree ||",
      "translation": "Adorning herself, she sits like a prostitute.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੰਤ ਕੀ ਠਿਠਕੀ ਫਿਰੈ ਬਿਚਾਰੀ ॥੨॥",
      "transliteration": "sa(n)t kee thithakee phirai bichaaree ||2||",
      "translation": "Cursed by the Saints, she wanders around like a wretch. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੰਤ ਭਾਗਿ ਓਹ ਪਾਛੈ ਪਰੈ ॥",
      "transliteration": "sa(n)t bhaag oh paachhai parai ||",
      "translation": "She runs around, chasing after the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਮਾਰਹੁ ਡਰੈ ॥",
      "transliteration": "gur parasaadee maarahu darai ||",
      "translation": "She is afraid of being beaten by those blessed with the Guru's Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸਾਕਤ ਕੀ ਓਹ ਪਿੰਡ ਪਰਾਇਣਿ ॥",
      "transliteration": "saakat kee oh pi(n)d paraain ||",
      "translation": "She is the body, the breath of life, of the faithless cynics.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਹਮ ਕਉ ਦ੍ਰਿਸਟਿ ਪਰੈ ਤ੍ਰਖਿ ਡਾਇਣਿ ॥੩॥",
      "transliteration": "ham kau drisat parai trakh daain ||3||",
      "translation": "She appears to me like a blood-thirsty witch. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਹਮ ਤਿਸ ਕਾ ਬਹੁ ਜਾਨਿਆ ਭੇਉ ॥",
      "transliteration": "ham tis kaa bahu jaaniaa bheu ||",
      "translation": "I know her secrets well",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਬ ਹੂਏ ਕ੍ਰਿਪਾਲ ਮਿਲੇ ਗੁਰਦੇਉ ॥",
      "transliteration": "jab hooe kripaal mile guradeu ||",
      "translation": "in His Mercy, the Divine Guru met me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਅਬ ਬਾਹਰਿ ਪਰੀ ॥",
      "transliteration": "kahu kabeer ab baahar paree ||",
      "translation": "Says Kabeer, now I have thrown her out.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0871_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸੰਸਾਰੈ ਕੈ ਅੰਚਲਿ ਲਰੀ ॥੪॥੪॥੭॥",
      "transliteration": "sa(n)saarai kai a(n)chal laree ||4||4||7||",
      "translation": "She clings to the skirt of the world. ||4||4||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 871,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
