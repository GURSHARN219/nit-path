{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 872,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0872_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗ੍ਰਿਹਿ ਸੋਭਾ ਜਾ ਕੈ ਰੇ ਨਾਹਿ ॥",
      "transliteration": "grihi sobhaa jaa kai re naahi ||",
      "translation": "When someone's household has no glory,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਵਤ ਪਹੀਆ ਖੂਧੇ ਜਾਹਿ ॥",
      "transliteration": "aavat paheeaa khoodhe jaahi ||",
      "translation": "the guests who come there depart still hungry.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਵਾ ਕੈ ਅੰਤਰਿ ਨਹੀ ਸੰਤੋਖੁ ॥",
      "transliteration": "vaa kai a(n)tar nahee sa(n)tokh ||",
      "translation": "Deep within, there is no contentment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਿਨੁ ਸੋਹਾਗਨਿ ਲਾਗੈ ਦੋਖੁ ॥੧॥",
      "transliteration": "bin sohaagan laagai dokh ||1||",
      "translation": "Without his bride, the wealth of Maya, he suffers in pain. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਧਨੁ ਸੋਹਾਗਨਿ ਮਹਾ ਪਵੀਤ ॥",
      "transliteration": "dhan sohaagan mahaa paveet ||",
      "translation": "So praise this bride, which can shake the consciousness",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਪੇ ਤਪੀਸਰ ਡੋਲੈ ਚੀਤ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tape tapeesar dolai cheet ||1|| rahaau ||",
      "translation": "Of even the most dedicated ascetics and sages. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੋਹਾਗਨਿ ਕਿਰਪਨ ਕੀ ਪੂਤੀ ॥",
      "transliteration": "sohaagan kirapan kee pootee ||",
      "translation": "This bride is the daughter of a wretched miser.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੇਵਕ ਤਜਿ ਜਗਤ ਸਿਉ ਸੂਤੀ ॥",
      "transliteration": "sevak taj jagat siu sootee ||",
      "translation": "Abandoning the Lord's servant, she sleeps with the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਾਧੂ ਕੈ ਠਾਢੀ ਦਰਬਾਰਿ ॥",
      "transliteration": "saadhoo kai thaadhee darabaar ||",
      "translation": "Standing at the door of the holy man,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਰਨਿ ਤੇਰੀ ਮੋ ਕਉ ਨਿਸਤਾਰਿ ॥੨॥",
      "transliteration": "saran teree mo kau nisataar ||2||",
      "translation": "she says, \"I have come to your sanctuary; now save me!\" ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੋਹਾਗਨਿ ਹੈ ਅਤਿ ਸੁੰਦਰੀ ॥",
      "transliteration": "sohaagan hai at su(n)daree ||",
      "translation": "This bride is so beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਗ ਨੇਵਰ ਛਨਕ ਛਨਹਰੀ ॥",
      "transliteration": "pag nevar chhanak chhanaharee ||",
      "translation": "The bells on her ankles make soft music.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਉ ਲਗੁ ਪ੍ਰਾਨ ਤਊ ਲਗੁ ਸੰਗੇ ॥",
      "transliteration": "jau lag praan taoo lag sa(n)ge ||",
      "translation": "As long as there is the breath of life in the man, she remains attached to him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਹਿ ਤ ਚਲੀ ਬੇਗਿ ਉਠਿ ਨੰਗੇ ॥੩॥",
      "transliteration": "naahi ta chalee beg uth na(n)ge ||3||",
      "translation": "But when it is no more, she quickly gets up and departs, bare-footed. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੋਹਾਗਨਿ ਭਵਨ ਤ੍ਰੈ ਲੀਆ ॥",
      "transliteration": "sohaagan bhavan trai leeaa ||",
      "translation": "This bride has conquered the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦਸ ਅਠ ਪੁਰਾਣ ਤੀਰਥ ਰਸ ਕੀਆ ॥",
      "transliteration": "das ath puraan teerath ras keeaa ||",
      "translation": "The eighteen Puraanas and the sacred shrines of pilgrimage love her as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਬਿਸਨੁ ਮਹੇਸਰ ਬੇਧੇ ॥",
      "transliteration": "brahamaa bisan mahesar bedhe ||",
      "translation": "She pierced the hearts of Brahma, Shiva and Vishnu.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਡੇ ਭੂਪਤਿ ਰਾਜੇ ਹੈ ਛੇਧੇ ॥੪॥",
      "transliteration": "bade bhoopat raaje hai chhedhe ||4||",
      "translation": "She destroyed the great emperors and kings of the world. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋਹਾਗਨਿ ਉਰਵਾਰਿ ਨ ਪਾਰਿ ॥",
      "transliteration": "sohaagan uravaar na paar ||",
      "translation": "This bride has no restraint or limits.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪਾਂਚ ਨਾਰਦ ਕੈ ਸੰਗਿ ਬਿਧਵਾਰਿ ॥",
      "transliteration": "paa(n)ch naarad kai sa(n)g bidhavaar ||",
      "translation": "She is in collusion with the five thieving passions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਾਂਚ ਨਾਰਦ ਕੇ ਮਿਟਵੇ ਫੂਟੇ ॥",
      "transliteration": "paa(n)ch naarad ke mitave phoote ||",
      "translation": "When the clay pot of these five passions bursts,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਗੁਰ ਕਿਰਪਾ ਛੂਟੇ ॥੫॥੫॥੮॥",
      "transliteration": "kahu kabeer gur kirapaa chhoote ||5||5||8||",
      "translation": "then, says Kabeer, by Guru's Mercy, one is released. ||5||5||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੈਸੇ ਮੰਦਰ ਮਹਿ ਬਲਹਰ ਨਾ ਠਾਹਰੈ ॥",
      "transliteration": "jaise ma(n)dar mahi balahar naa thaaharai ||",
      "translation": "As the house will not stand when the supporting beams are removed from within it,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਕੈਸੇ ਪਾਰਿ ਉਤਰੈ ॥",
      "transliteration": "naam binaa kaise paar utarai ||",
      "translation": "just so, without the Naam, the Name of the Lord, how can anyone be carried across?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕੁੰਭ ਬਿਨਾ ਜਲੁ ਨਾ ਟੀਕਾਵੈ ॥",
      "transliteration": "ku(n)bh binaa jal naa teekaavai ||",
      "translation": "Without the pitcher, the water is not contained;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਾਧੂ ਬਿਨੁ ਐਸੇ ਅਬਗਤੁ ਜਾਵੈ ॥੧॥",
      "transliteration": "saadhoo bin aise abagat jaavai ||1||",
      "translation": "just so, without the Holy Saint, the mortal departs in misery. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾਰਉ ਤਿਸੈ ਜੁ ਰਾਮੁ ਨ ਚੇਤੈ ॥",
      "transliteration": "jaarau tisai j raam na chetai ||",
      "translation": "One who does not remember the Lord - let him burn;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਨ ਮਨ ਰਮਤ ਰਹੈ ਮਹਿ ਖੇਤੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tan man ramat rahai mahi khetai ||1|| rahaau ||",
      "translation": "his body and mind have remained absorbed in this field of the world. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੈਸੇ ਹਲਹਰ ਬਿਨਾ ਜਿਮੀ ਨਹੀ ਬੋਈਐ ॥",
      "transliteration": "jaise halahar binaa jimee nahee boeeai ||",
      "translation": "Without a farmer, the land is not planted;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੂਤ ਬਿਨਾ ਕੈਸੇ ਮਣੀ ਪਰੋਈਐ ॥",
      "transliteration": "soot binaa kaise manee paroeeai ||",
      "translation": "without a thread, how can the beads be strung?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਘੁੰਡੀ ਬਿਨੁ ਕਿਆ ਗੰਠਿ ਚੜ੍ਹਾਈਐ ॥",
      "transliteration": "ghu(n)dee bin kiaa ga(n)th chaRhaaeeai ||",
      "translation": "Without a loop, how can the knot be tied?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਾਧੂ ਬਿਨੁ ਤੈਸੇ ਅਬਗਤੁ ਜਾਈਐ ॥੨॥",
      "transliteration": "saadhoo bin taise abagat jaaeeai ||2||",
      "translation": "Just so, without the Holy Saint, the mortal departs in misery. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜੈਸੇ ਮਾਤ ਪਿਤਾ ਬਿਨੁ ਬਾਲੁ ਨ ਹੋਈ ॥",
      "transliteration": "jaise maat pitaa bin baal na hoee ||",
      "translation": "Without a mother or father there is no child;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿੰਬ ਬਿਨਾ ਕੈਸੇ ਕਪਰੇ ਧੋਈ ॥",
      "transliteration": "bi(n)b binaa kaise kapare dhoee ||",
      "translation": "just so, without water, how can the clothes be washed?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਘੋਰ ਬਿਨਾ ਕੈਸੇ ਅਸਵਾਰ ॥",
      "transliteration": "ghor binaa kaise asavaar ||",
      "translation": "Without a horse, how can there be a rider?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਾਧੂ ਬਿਨੁ ਨਾਹੀ ਦਰਵਾਰ ॥੩॥",
      "transliteration": "saadhoo bin naahee daravaar ||3||",
      "translation": "Without the Holy Saint, one cannot reach the Court of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੈਸੇ ਬਾਜੇ ਬਿਨੁ ਨਹੀ ਲੀਜੈ ਫੇਰੀ ॥",
      "transliteration": "jaise baaje bin nahee leejai pheree ||",
      "translation": "Just as without music, there is no dancing,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਖਸਮਿ ਦੁਹਾਗਨਿ ਤਜਿ ਅਉਹੇਰੀ ॥",
      "transliteration": "khasam duhaagan taj auheree ||",
      "translation": "the bride rejected by her husband is dishonored.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਹੈ ਕਬੀਰੁ ਏਕੈ ਕਰਿ ਕਰਨਾ ॥",
      "transliteration": "kahai kabeer ekai kar karanaa ||",
      "translation": "Says Kabeer, do this one thing:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਹੋਇ ਬਹੁਰਿ ਨਹੀ ਮਰਨਾ ॥੪॥੬॥੯॥",
      "transliteration": "guramukh hoi bahur nahee maranaa ||4||6||9||",
      "translation": "become Gurmukh, and you shall never die again. ||4||6||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕੂਟਨੁ ਸੋਇ ਜੁ ਮਨ ਕਉ ਕੂਟੈ ॥",
      "transliteration": "kootan soi j man kau kootai ||",
      "translation": "He alone is a pimp, who pounds down his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਨ ਕੂਟੈ ਤਉ ਜਮ ਤੇ ਛੂਟੈ ॥",
      "transliteration": "man kootai tau jam te chhootai ||",
      "translation": "Pounding down his mind, he escapes from the Messenger of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕੁਟਿ ਕੁਟਿ ਮਨੁ ਕਸਵਟੀ ਲਾਵੈ ॥",
      "transliteration": "kut kut man kasavatee laavai ||",
      "translation": "Pounding and beating his mind, he puts it to the test;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੋ ਕੂਟਨੁ ਮੁਕਤਿ ਬਹੁ ਪਾਵੈ ॥੧॥",
      "transliteration": "so kootan mukat bahu paavai ||1||",
      "translation": "such a pimp attains total liberation. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੂਟਨੁ ਕਿਸੈ ਕਹਹੁ ਸੰਸਾਰ ॥",
      "transliteration": "kootan kisai kahahu sa(n)saar ||",
      "translation": "Who is called a pimp in this world?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਗਲ ਬੋਲਨ ਕੇ ਮਾਹਿ ਬੀਚਾਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sagal bolan ke maahi beechaar ||1|| rahaau ||",
      "translation": "In all speech, one must carefully consider. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਚਨੁ ਸੋਇ ਜੁ ਮਨ ਸਿਉ ਨਾਚੈ ॥",
      "transliteration": "naachan soi j man siu naachai ||",
      "translation": "He alone is a dancer, who dances with his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਝੂਠਿ ਨ ਪਤੀਐ ਪਰਚੈ ਸਾਚੈ ॥",
      "transliteration": "jhooth na pateeai parachai saachai ||",
      "translation": "The Lord is not satisfied with falsehood; He is pleased only with Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਇਸੁ ਮਨ ਆਗੇ ਪੂਰੈ ਤਾਲ ॥",
      "transliteration": "is man aage poorai taal ||",
      "translation": "So play the beat of the drum in the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਇਸੁ ਨਾਚਨ ਕੇ ਮਨ ਰਖਵਾਲ ॥੨॥",
      "transliteration": "is naachan ke man rakhavaal ||2||",
      "translation": "The Lord is the Protector of the dancer with such a mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਬਜਾਰੀ ਸੋ ਜੁ ਬਜਾਰਹਿ ਸੋਧੈ ॥",
      "transliteration": "bajaaree so j bajaarahi sodhai ||",
      "translation": "She alone is a street-dancer, who cleanses her body-street,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪਾਂਚ ਪਲੀਤਹ ਕਉ ਪਰਬੋਧੈ ॥",
      "transliteration": "paa(n)ch paleetah kau parabodhai ||",
      "translation": "and educates the five passions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਉ ਨਾਇਕ ਕੀ ਭਗਤਿ ਪਛਾਨੈ ॥",
      "transliteration": "nau naaik kee bhagat pachhaanai ||",
      "translation": "She who embraces devotional worship for the Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸੋ ਬਾਜਾਰੀ ਹਮ ਗੁਰ ਮਾਨੇ ॥੩॥",
      "transliteration": "so baajaaree ham gur maane ||3||",
      "translation": "- I accept such a street-dancer as my Guru. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤਸਕਰੁ ਸੋਇ ਜਿ ਤਾਤਿ ਨ ਕਰੈ ॥",
      "transliteration": "tasakar soi j taat na karai ||",
      "translation": "He alone is a thief, who is above envy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਇੰਦ੍ਰੀ ਕੈ ਜਤਨਿ ਨਾਮੁ ਉਚਰੈ ॥",
      "transliteration": "i(n)dree kai jatan naam ucharai ||",
      "translation": "and who uses his sense organs to chant the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਹਮ ਐਸੇ ਲਖਨ ॥",
      "transliteration": "kahu kabeer ham aise lakhan ||",
      "translation": "Says Kabeer, these are the qualities of the one",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0872_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਧੰਨੁ ਗੁਰਦੇਵ ਅਤਿ ਰੂਪ ਬਿਚਖਨ ॥੪॥੭॥੧੦॥",
      "transliteration": "dha(n)n guradev at roop bichakhan ||4||7||10||",
      "translation": "I know as my Blessed Divine Guru, who is the most beautiful and wise. ||4||7||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 872,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
