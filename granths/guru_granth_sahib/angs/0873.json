{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 873,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0873_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਧੰਨੁ ਗੁਪਾਲ ਧੰਨੁ ਗੁਰਦੇਵ ॥",
      "transliteration": "dha(n)n gupaal dha(n)n guradev ||",
      "translation": "Blessed is the Lord of the World. Blessed is the Divine Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਧੰਨੁ ਅਨਾਦਿ ਭੂਖੇ ਕਵਲੁ ਟਹਕੇਵ ॥",
      "transliteration": "dha(n)n anaad bhookhe kaval tahakev ||",
      "translation": "Blessed is that grain, by which the heart-lotus of the hungry blossoms forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਧਨੁ ਓਇ ਸੰਤ ਜਿਨ ਐਸੀ ਜਾਨੀ ॥",
      "transliteration": "dhan oi sa(n)t jin aisee jaanee ||",
      "translation": "Blessed are those Saints, who know this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਨ ਕਉ ਮਿਲਿਬੋ ਸਾਰਿੰਗਪਾਨੀ ॥੧॥",
      "transliteration": "tin kau milibo saari(n)gapaanee ||1||",
      "translation": "Meeting with them, one meets the Lord, the Sustainer of the World. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਦਿ ਪੁਰਖ ਤੇ ਹੋਇ ਅਨਾਦਿ ॥",
      "transliteration": "aad purakh te hoi anaad ||",
      "translation": "This grain comes from the Primal Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਪੀਐ ਨਾਮੁ ਅੰਨ ਕੈ ਸਾਦਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "japeeai naam a(n)n kai saad ||1|| rahaau ||",
      "translation": "One chants the Naam, the Name of the Lord, only when he tastes this grain. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਪੀਐ ਨਾਮੁ ਜਪੀਐ ਅੰਨੁ ॥",
      "transliteration": "japeeai naam japeeai a(n)n ||",
      "translation": "Meditate on the Naam, and meditate on this grain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅੰਭੈ ਕੈ ਸੰਗਿ ਨੀਕਾ ਵੰਨੁ ॥",
      "transliteration": "a(n)bhai kai sa(n)g neekaa va(n)n ||",
      "translation": "Mixed with water, its taste becomes sublime.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅੰਨੈ ਬਾਹਰਿ ਜੋ ਨਰ ਹੋਵਹਿ ॥",
      "transliteration": "a(n)nai baahar jo nar hovahi ||",
      "translation": "One who abstains from this grain,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੀਨਿ ਭਵਨ ਮਹਿ ਅਪਨੀ ਖੋਵਹਿ ॥੨॥",
      "transliteration": "teen bhavan mahi apanee khovahi ||2||",
      "translation": "loses his honor in the three worlds. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਛੋਡਹਿ ਅੰਨੁ ਕਰਹਿ ਪਾਖੰਡ ॥",
      "transliteration": "chhodahi a(n)n karahi paakha(n)d ||",
      "translation": "One who discards this grain, is practicing hypocrisy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾ ਸੋਹਾਗਨਿ ਨਾ ਓਹਿ ਰੰਡ ॥",
      "transliteration": "naa sohaagan naa ohi ra(n)d ||",
      "translation": "She is neither a happy soul-bride, nor a widow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਗ ਮਹਿ ਬਕਤੇ ਦੂਧਾਧਾਰੀ ॥",
      "transliteration": "jag mahi bakate doodhaadhaaree ||",
      "translation": "Those who claim in this world that they live on milk alone,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਪਤੀ ਖਾਵਹਿ ਵਟਿਕਾ ਸਾਰੀ ॥੩॥",
      "transliteration": "gupatee khaavahi vatikaa saaree ||3||",
      "translation": "secretly eat whole loads of food. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅੰਨੈ ਬਿਨਾ ਨ ਹੋਇ ਸੁਕਾਲੁ ॥",
      "transliteration": "a(n)nai binaa na hoi sukaal ||",
      "translation": "Without this grain, time does not pass in peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਜਿਐ ਅੰਨਿ ਨ ਮਿਲੈ ਗੁਪਾਲੁ ॥",
      "transliteration": "tajiai a(n)n na milai gupaal ||",
      "translation": "Forsaking this grain, one does not meet the Lord of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਹਮ ਐਸੇ ਜਾਨਿਆ ॥",
      "transliteration": "kahu kabeer ham aise jaaniaa ||",
      "translation": "Says Kabeer, this I know:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਧੰਨੁ ਅਨਾਦਿ ਠਾਕੁਰ ਮਨੁ ਮਾਨਿਆ ॥੪॥੮॥੧੧॥",
      "transliteration": "dha(n)n anaad thaakur man maaniaa ||4||8||11||",
      "translation": "blessed is that grain, which brings faith in the Lord and Master to the mind. ||4||8||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਗੁ ਗੋਂਡ ਬਾਣੀ ਨਾਮਦੇਉ ਜੀ ਕੀ ਘਰੁ ੧ ॥",
      "transliteration": "raag go(n)d baanee naamadeu jee kee ghar 1 ||",
      "translation": "Raag Gond, The Word Of Naam Dayv Jee, First House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਸੁਮੇਧ ਜਗਨੇ ॥",
      "transliteration": "asumedh jagane ||",
      "translation": "The ritual sacrifice of horses,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤੁਲਾ ਪੁਰਖ ਦਾਨੇ ॥",
      "transliteration": "tulaa purakh daane ||",
      "translation": "giving one's weight in gold to charities,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪ੍ਰਾਗ ਇਸਨਾਨੇ ॥੧॥",
      "transliteration": "praag isanaane ||1||",
      "translation": "and ceremonial cleansing baths -||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਉ ਨ ਪੁਜਹਿ ਹਰਿ ਕੀਰਤਿ ਨਾਮਾ ॥",
      "transliteration": "tau na pujahi har keerat naamaa ||",
      "translation": "These are not equal to singing the Praises of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਪੁਨੇ ਰਾਮਹਿ ਭਜੁ ਰੇ ਮਨ ਆਲਸੀਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "apune raamahi bhaj re man aalaseeaa ||1|| rahaau ||",
      "translation": "Meditate on your Lord, you lazy man! ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗਇਆ ਪਿੰਡੁ ਭਰਤਾ ॥",
      "transliteration": "gaiaa pi(n)d bharataa ||",
      "translation": "Offering sweet rice at Gaya,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਨਾਰਸਿ ਅਸਿ ਬਸਤਾ ॥",
      "transliteration": "banaaras as basataa ||",
      "translation": "living on the river banks at Benares,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੁਖਿ ਬੇਦ ਚਤੁਰ ਪੜਤਾ ॥੨॥",
      "transliteration": "mukh bed chatur paRataa ||2||",
      "translation": "reciting the four Vedas by heart;||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਗਲ ਧਰਮ ਅਛਿਤਾ ॥",
      "transliteration": "sagal dharam achhitaa ||",
      "translation": "Completing all religious rituals,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗੁਰ ਗਿਆਨ ਇੰਦ੍ਰੀ ਦ੍ਰਿੜਤਾ ॥",
      "transliteration": "gur giaan i(n)dree driRataa ||",
      "translation": "restraining sexual passion by the spiritual wisdom given by the Guru,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਖਟੁ ਕਰਮ ਸਹਿਤ ਰਹਤਾ ॥੩॥",
      "transliteration": "khat karam sahit rahataa ||3||",
      "translation": "and performing the six rituals;||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਿਵਾ ਸਕਤਿ ਸੰਬਾਦੰ ॥",
      "transliteration": "sivaa sakat sa(n)baada(n) ||",
      "translation": "Expounding on Shiva and Shakti",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਨ ਛੋਡਿ ਛੋਡਿ ਸਗਲ ਭੇਦੰ ॥",
      "transliteration": "man chhod chhod sagal bheda(n) ||",
      "translation": "O man, renounce and abandon all these things.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਗੋਬਿੰਦੰ ॥",
      "transliteration": "simar simar gobi(n)da(n) ||",
      "translation": "Meditate, meditate in remembrance on the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਜੁ ਨਾਮਾ ਤਰਸਿ ਭਵ ਸਿੰਧੰ ॥੪॥੧॥",
      "transliteration": "bhaj naamaa taras bhav si(n)dha(n) ||4||1||",
      "translation": "Meditate, O Naam Dayv, and cross over the terrifying world-ocean. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਦ ਭ੍ਰਮੇ ਜੈਸੇ ਮਿਰਗਾਏ ॥",
      "transliteration": "naad bhrame jaise miragaae ||",
      "translation": "The deer is lured by the sound of the hunter's bell;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪ੍ਰਾਨ ਤਜੇ ਵਾ ਕੋ ਧਿਆਨੁ ਨ ਜਾਏ ॥੧॥",
      "transliteration": "praan taje vaa ko dhiaan na jaae ||1||",
      "translation": "it loses its life, but it cannot stop thinking about it. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਐਸੇ ਰਾਮਾ ਐਸੇ ਹੇਰਉ ॥",
      "transliteration": "aise raamaa aise herau ||",
      "translation": "In the same way, I look upon my Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਰਾਮੁ ਛੋਡਿ ਚਿਤੁ ਅਨਤ ਨ ਫੇਰਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raam chhod chit anat na pherau ||1|| rahaau ||",
      "translation": "I will not abandon my Lord, and turn my thoughts to another. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਉ ਮੀਨਾ ਹੇਰੈ ਪਸੂਆਰਾ ॥",
      "transliteration": "jiu meenaa herai pasooaaraa ||",
      "translation": "As the fisherman looks upon the fish,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੋਨਾ ਗਢਤੇ ਹਿਰੈ ਸੁਨਾਰਾ ॥੨॥",
      "transliteration": "sonaa gadhate hirai sunaaraa ||2||",
      "translation": "and the goldsmith looks upon the gold he fashions;||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਉ ਬਿਖਈ ਹੇਰੈ ਪਰ ਨਾਰੀ ॥",
      "transliteration": "jiu bikhaee herai par naaree ||",
      "translation": "As the man driven by sex looks upon another man's wife,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਉਡਾ ਡਾਰਤ ਹਿਰੈ ਜੁਆਰੀ ॥੩॥",
      "transliteration": "kaudaa daarat hirai juaaree ||3||",
      "translation": "and the gambler looks upon the throwing of the dice -||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਹ ਜਹ ਦੇਖਉ ਤਹ ਤਹ ਰਾਮਾ ॥",
      "transliteration": "jah jah dekhau tah tah raamaa ||",
      "translation": "In the same way, wherever Naam Dayv looks, he sees the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਰਿ ਕੇ ਚਰਨ ਨਿਤ ਧਿਆਵੈ ਨਾਮਾ ॥੪॥੨॥",
      "transliteration": "har ke charan nit dhiaavai naamaa ||4||2||",
      "translation": "Naam Dayv meditates continuously on the Feet of the Lord. ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮੋ ਕਉ ਤਾਰਿ ਲੇ ਰਾਮਾ ਤਾਰਿ ਲੇ ॥",
      "transliteration": "mo kau taar le raamaa taar le ||",
      "translation": "Carry me across, O Lord, carry me across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਮੈ ਅਜਾਨੁ ਜਨੁ ਤਰਿਬੇ ਨ ਜਾਨਉ ਬਾਪ ਬੀਠੁਲਾ ਬਾਹ ਦੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mai ajaan jan taribe na jaanau baap beethulaa baah de ||1|| rahaau ||",
      "translation": "I am ignorant, and I do not know how to swim. O my Beloved Father, please give me Your arm. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਰ ਤੇ ਸੁਰ ਹੋਇ ਜਾਤ ਨਿਮਖ ਮੈ ਸਤਿਗੁਰ ਬੁਧਿ ਸਿਖਲਾਈ ॥",
      "transliteration": "nar te sur hoi jaat nimakh mai satigur budh sikhalaaee ||",
      "translation": "I have been transformed from a mortal being into an angel, in an instant; the True Guru has taught me this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਰ ਤੇ ਉਪਜਿ ਸੁਰਗ ਕਉ ਜੀਤਿਓ ਸੋ ਅਵਖਧ ਮੈ ਪਾਈ ॥੧॥",
      "transliteration": "nar te upaj surag kau jeetio so avakhadh mai paaee ||1||",
      "translation": "Born of human flesh, I have conquered the heavens; such is the medicine I was given. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਹਾ ਜਹਾ ਧੂਅ ਨਾਰਦੁ ਟੇਕੇ ਨੈਕੁ ਟਿਕਾਵਹੁ ਮੋਹਿ ॥",
      "transliteration": "jahaa jahaa dhoo naarad teke naik tikaavahu mohi ||",
      "translation": "Please place me where You placed Dhroo and Naarad, O my Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0873_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤੇਰੇ ਨਾਮ ਅਵਿਲੰਬਿ ਬਹੁਤੁ ਜਨ ਉਧਰੇ ਨਾਮੇ ਕੀ ਨਿਜ ਮਤਿ ਏਹ ॥੨॥੩॥",
      "transliteration": "tere naam avila(n)b bahut jan udhare naame kee nij mat eh ||2||3||",
      "translation": "With the Support of Your Name, so many have been saved; this is Naam Dayv's understanding. ||2||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 873,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
