{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 874,
  "lineCount": 52,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0874_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮੋਹਿ ਲਾਗਤੀ ਤਾਲਾਬੇਲੀ ॥",
      "transliteration": "mohi laagatee taalaabelee ||",
      "translation": "I am restless and unhappy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਛਰੇ ਬਿਨੁ ਗਾਇ ਅਕੇਲੀ ॥੧॥",
      "transliteration": "bachhare bin gaai akelee ||1||",
      "translation": "Without her calf, the cow is lonely. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਾਨੀਆ ਬਿਨੁ ਮੀਨੁ ਤਲਫੈ ॥",
      "transliteration": "paaneeaa bin meen talaphai ||",
      "translation": "Without water, the fish writhes in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਐਸੇ ਰਾਮ ਨਾਮਾ ਬਿਨੁ ਬਾਪੁਰੋ ਨਾਮਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aise raam naamaa bin baapuro naamaa ||1|| rahaau ||",
      "translation": "So is poor Naam Dayv without the Lord's Name. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੈਸੇ ਗਾਇ ਕਾ ਬਾਛਾ ਛੂਟਲਾ ॥",
      "transliteration": "jaise gaai kaa baachhaa chhootalaa ||",
      "translation": "Like the cow's calf, which, when let loose,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਥਨ ਚੋਖਤਾ ਮਾਖਨੁ ਘੂਟਲਾ ॥੨॥",
      "transliteration": "than chokhataa maakhan ghootalaa ||2||",
      "translation": "sucks at her udders and drinks her milk -||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਮਦੇਉ ਨਾਰਾਇਨੁ ਪਾਇਆ ॥",
      "transliteration": "naamadeu naaraain paaiaa ||",
      "translation": "So has Naam Dayv found the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰੁ ਭੇਟਤ ਅਲਖੁ ਲਖਾਇਆ ॥੩॥",
      "transliteration": "gur bhetat alakh lakhaaiaa ||3||",
      "translation": "Meeting the Guru, I have seen the Unseen Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੈਸੇ ਬਿਖੈ ਹੇਤ ਪਰ ਨਾਰੀ ॥",
      "transliteration": "jaise bikhai het par naaree ||",
      "translation": "As the man driven by sex wants another man's wife,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਐਸੇ ਨਾਮੇ ਪ੍ਰੀਤਿ ਮੁਰਾਰੀ ॥੪॥",
      "transliteration": "aise naame preet muraaree ||4||",
      "translation": "so does Naam Dayv love the Lord. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੈਸੇ ਤਾਪਤੇ ਨਿਰਮਲ ਘਾਮਾ ॥",
      "transliteration": "jaise taapate niramal ghaamaa ||",
      "translation": "As the earth burns in the dazzling sunlight,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੈਸੇ ਰਾਮ ਨਾਮਾ ਬਿਨੁ ਬਾਪੁਰੋ ਨਾਮਾ ॥੫॥੪॥",
      "transliteration": "taise raam naamaa bin baapuro naamaa ||5||4||",
      "translation": "so does poor Naam Dayv burn without the Lord's Name. ||5||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਗੁ ਗੋਂਡ ਬਾਣੀ ਨਾਮਦੇਉ ਜੀਉ ਕੀ ਘਰੁ ੨ ॥",
      "transliteration": "raag go(n)d baanee naamadeu jeeu kee ghar 2 ||",
      "translation": "Raag Gond, The Word Of Naam Dayv Jee, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਕਰਤ ਮਿਟੇ ਸਭਿ ਭਰਮਾ ॥",
      "transliteration": "har har karat mite sabh bharamaa ||",
      "translation": "Chanting the Name of the Lord, Har, Har, all doubts are dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰਿ ਕੋ ਨਾਮੁ ਲੈ ਊਤਮ ਧਰਮਾ ॥",
      "transliteration": "har ko naam lai ootam dharamaa ||",
      "translation": "Chanting the Name of the Lord is the highest religion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਕਰਤ ਜਾਤਿ ਕੁਲ ਹਰੀ ॥",
      "transliteration": "har har karat jaat kul haree ||",
      "translation": "Chanting the Name of the Lord, Har, Har, erases social classes and ancestral pedigrees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋ ਹਰਿ ਅੰਧੁਲੇ ਕੀ ਲਾਕਰੀ ॥੧॥",
      "transliteration": "so har a(n)dhule kee laakaree ||1||",
      "translation": "The Lord is the walking stick of the blind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਰਏ ਨਮਸਤੇ ਹਰਏ ਨਮਹ ॥",
      "transliteration": "harae namasate harae namah ||",
      "translation": "I bow to the Lord, I humbly bow to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਕਰਤ ਨਹੀ ਦੁਖੁ ਜਮਹ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har har karat nahee dukh jamah ||1|| rahaau ||",
      "translation": "Chanting the Name of the Lord, Har, Har, you will not be tormented by the Messenger of Death. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹਰਿ ਹਰਨਾਕਸ ਹਰੇ ਪਰਾਨ ॥",
      "transliteration": "har haranaakas hare paraan ||",
      "translation": "The Lord took the life of Harnaakhash,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਜੈਮਲ ਕੀਓ ਬੈਕੁੰਠਹਿ ਥਾਨ ॥",
      "transliteration": "ajaimal keeo baiku(n)thahi thaan ||",
      "translation": "and gave Ajaamal a place in heaven.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੂਆ ਪੜਾਵਤ ਗਨਿਕਾ ਤਰੀ ॥",
      "transliteration": "sooaa paRaavat ganikaa taree ||",
      "translation": "Teaching a parrot to speak the Lord's Name, Ganika the prostitute was saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੋ ਹਰਿ ਨੈਨਹੁ ਕੀ ਪੂਤਰੀ ॥੨॥",
      "transliteration": "so har nainahu kee pootaree ||2||",
      "translation": "That Lord is the light of my eyes. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਕਰਤ ਪੂਤਨਾ ਤਰੀ ॥",
      "transliteration": "har har karat pootanaa taree ||",
      "translation": "Chanting the Name of the Lord, Har, Har, Pootna was saved,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਾਲ ਘਾਤਨੀ ਕਪਟਹਿ ਭਰੀ ॥",
      "transliteration": "baal ghaatanee kapatahi bharee ||",
      "translation": "even though she was a deceitful child-killer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਿਮਰਨ ਦ੍ਰੋਪਦ ਸੁਤ ਉਧਰੀ ॥",
      "transliteration": "simaran dropad sut udharee ||",
      "translation": "Contemplating the Lord, Dropadi was saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗਊਤਮ ਸਤੀ ਸਿਲਾ ਨਿਸਤਰੀ ॥੩॥",
      "transliteration": "gaootam satee silaa nisataree ||3||",
      "translation": "Gautam's wife, turned to stone, was saved. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕੇਸੀ ਕੰਸ ਮਥਨੁ ਜਿਨਿ ਕੀਆ ॥",
      "transliteration": "kesee ka(n)s mathan jin keeaa ||",
      "translation": "The Lord, who killed Kaysee and Kans,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੀਅ ਦਾਨੁ ਕਾਲੀ ਕਉ ਦੀਆ ॥",
      "transliteration": "jee daan kaalee kau deeaa ||",
      "translation": "gave the gift of life to Kali.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪ੍ਰਣਵੈ ਨਾਮਾ ਐਸੋ ਹਰੀ ॥",
      "transliteration": "pranavai naamaa aiso haree ||",
      "translation": "Prays Naam Dayv, such is my Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਭੈ ਅਪਦਾ ਟਰੀ ॥੪॥੧॥੫॥",
      "transliteration": "jaas japat bhai apadaa taree ||4||1||5||",
      "translation": "meditating on Him, fear and suffering are dispelled. ||4||1||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭੈਰਉ ਭੂਤ ਸੀਤਲਾ ਧਾਵੈ ॥",
      "transliteration": "bhairau bhoot seetalaa dhaavai ||",
      "translation": "One who chases after the god Bhairau, evil spirits and the goddess of smallpox,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਖਰ ਬਾਹਨੁ ਉਹੁ ਛਾਰੁ ਉਡਾਵੈ ॥੧॥",
      "transliteration": "khar baahan uhu chhaar udaavai ||1||",
      "translation": "is riding on a donkey, kicking up the dust. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਉ ਤਉ ਏਕੁ ਰਮਈਆ ਲੈਹਉ ॥",
      "transliteration": "hau tau ek ramaeeaa laihau ||",
      "translation": "I take only the Name of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਨ ਦੇਵ ਬਦਲਾਵਨਿ ਦੈਹਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aan dev badalaavan daihau ||1|| rahaau ||",
      "translation": "I have given away all other gods in exchange for Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਿਵ ਸਿਵ ਕਰਤੇ ਜੋ ਨਰੁ ਧਿਆਵੈ ॥",
      "transliteration": "siv siv karate jo nar dhiaavai ||",
      "translation": "That man who chants \"Shiva, Shiva\", and meditates on him,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਰਦ ਚਢੇ ਡਉਰੂ ਢਮਕਾਵੈ ॥੨॥",
      "transliteration": "barad chadhe dauroo dhamakaavai ||2||",
      "translation": "is riding on a bull, shaking a tambourine. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਹਾ ਮਾਈ ਕੀ ਪੂਜਾ ਕਰੈ ॥",
      "transliteration": "mahaa maaee kee poojaa karai ||",
      "translation": "One who worships the Great Goddess Maya",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਰ ਸੈ ਨਾਰਿ ਹੋਇ ਅਉਤਰੈ ॥੩॥",
      "transliteration": "nar sai naar hoi autarai ||3||",
      "translation": "will be reincarnated as a woman, and not a man. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੂ ਕਹੀਅਤ ਹੀ ਆਦਿ ਭਵਾਨੀ ॥",
      "transliteration": "too kaheeat hee aad bhavaanee ||",
      "translation": "You are called the Primal Goddess.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮੁਕਤਿ ਕੀ ਬਰੀਆ ਕਹਾ ਛਪਾਨੀ ॥੪॥",
      "transliteration": "mukat kee bareeaa kahaa chhapaanee ||4||",
      "translation": "At the time of liberation, where will you hide then? ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰਮਤਿ ਰਾਮ ਨਾਮ ਗਹੁ ਮੀਤਾ ॥",
      "transliteration": "guramat raam naam gahu meetaa ||",
      "translation": "Follow the Guru's Teachings, and hold tight to the Lord's Name, O friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਣਵੈ ਨਾਮਾ ਇਉ ਕਹੈ ਗੀਤਾ ॥੫॥੨॥੬॥",
      "transliteration": "pranavai naamaa iu kahai geetaa ||5||2||6||",
      "translation": "Thus prays Naam Dayv, and so says the Gita as well. ||5||2||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਿਲਾਵਲੁ ਗੋਂਡ ॥",
      "transliteration": "bilaaval go(n)d ||",
      "translation": "Bilaaval Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਆਜੁ ਨਾਮੇ ਬੀਠਲੁ ਦੇਖਿਆ ਮੂਰਖ ਕੋ ਸਮਝਾਊ ਰੇ ॥ ਰਹਾਉ ॥",
      "transliteration": "aaj naame beethal dekhiaa moorakh ko samajhaaoo re || rahaau ||",
      "translation": "Today, Naam Dayv saw the Lord, and so I will instruct the ignorant. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਪਾਂਡੇ ਤੁਮਰੀ ਗਾਇਤ੍ਰੀ ਲੋਧੇ ਕਾ ਖੇਤੁ ਖਾਤੀ ਥੀ ॥",
      "transliteration": "paa(n)de tumaree gaaitree lodhe kaa khet khaatee thee ||",
      "translation": "O Pandit, O religious scholar, your Gayatri was grazing in the fields.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਲੈ ਕਰਿ ਠੇਗਾ ਟਗਰੀ ਤੋਰੀ ਲਾਂਗਤ ਲਾਂਗਤ ਜਾਤੀ ਥੀ ॥੧॥",
      "transliteration": "lai kar thegaa tagaree toree laa(n)gat laa(n)gat jaatee thee ||1||",
      "translation": "Taking a stick, the farmer broke its leg, and now it walks with a limp. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪਾਂਡੇ ਤੁਮਰਾ ਮਹਾਦੇਉ ਧਉਲੇ ਬਲਦ ਚੜਿਆ ਆਵਤੁ ਦੇਖਿਆ ਥਾ ॥",
      "transliteration": "paa(n)de tumaraa mahaadeu dhaule balad chaRiaa aavat dekhiaa thaa ||",
      "translation": "O Pandit, I saw your great god Shiva, riding along on a white bull.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0874_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮੋਦੀ ਕੇ ਘਰ ਖਾਣਾ ਪਾਕਾ ਵਾ ਕਾ ਲੜਕਾ ਮਾਰਿਆ ਥਾ ॥੨॥",
      "transliteration": "modee ke ghar khaanaa paakaa vaa kaa laRakaa maariaa thaa ||2||",
      "translation": "In the merchant's house, a banquet was prepared for him - he killed the merchant's son. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 874,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
