{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 875,
  "lineCount": 45,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0875_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਾਂਡੇ ਤੁਮਰਾ ਰਾਮਚੰਦੁ ਸੋ ਭੀ ਆਵਤੁ ਦੇਖਿਆ ਥਾ ॥",
      "transliteration": "paa(n)de tumaraa raamacha(n)d so bhee aavat dekhiaa thaa ||",
      "translation": "O Pandit, I saw your Raam Chand coming too",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਾਵਨ ਸੇਤੀ ਸਰਬਰ ਹੋਈ ਘਰ ਕੀ ਜੋਇ ਗਵਾਈ ਥੀ ॥੩॥",
      "transliteration": "raavan setee sarabar hoee ghar kee joi gavaaee thee ||3||",
      "translation": "; he lost his wife, fighting a war against Raawan. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਿੰਦੂ ਅੰਨੑਾ ਤੁਰਕੂ ਕਾਣਾ ॥",
      "transliteration": "hi(n)doo a(n)nhaa turakoo kaanaa ||",
      "translation": "The Hindu is sightless; the Muslim has only one eye.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਦੁਹਾਂ ਤੇ ਗਿਆਨੀ ਸਿਆਣਾ ॥",
      "transliteration": "duhaa(n) te giaanee siaanaa ||",
      "translation": "The spiritual teacher is wiser than both of them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਿੰਦੂ ਪੂਜੈ ਦੇਹੁਰਾ ਮੁਸਲਮਾਣੁ ਮਸੀਤਿ ॥",
      "transliteration": "hi(n)doo poojai dehuraa musalamaan maseet ||",
      "translation": "The Hindu worships at the temple, the Muslim at the mosque.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਮੇ ਸੋਈ ਸੇਵਿਆ ਜਹ ਦੇਹੁਰਾ ਨ ਮਸੀਤਿ ॥੪॥੩॥੭॥",
      "transliteration": "naame soee seviaa jah dehuraa na maseet ||4||3||7||",
      "translation": "Naam Dayv serves that Lord, who is not limited to either the temple or the mosque. ||4||3||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਾਗੁ ਗੋਂਡ ਬਾਣੀ ਰਵਿਦਾਸ ਜੀਉ ਕੀ ਘਰੁ ੨ ॥",
      "transliteration": "raag go(n)d baanee ravidaas jeeu kee ghar 2 ||",
      "translation": "Raag Gond, The Word Of Ravi Daas Jee, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮੁਕੰਦ ਮੁਕੰਦ ਜਪਹੁ ਸੰਸਾਰ ॥",
      "transliteration": "muka(n)d muka(n)d japahu sa(n)saar ||",
      "translation": "Meditate on the Lord Mukanday, the Liberator, O people of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਨੁ ਮੁਕੰਦ ਤਨੁ ਹੋਇ ਅਉਹਾਰ ॥",
      "transliteration": "bin muka(n)d tan hoi auhaar ||",
      "translation": "Without Mukanday, the body shall be reduced to ashes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੋਈ ਮੁਕੰਦੁ ਮੁਕਤਿ ਕਾ ਦਾਤਾ ॥",
      "transliteration": "soee muka(n)d mukat kaa daataa ||",
      "translation": "Mukanday is the Giver of liberation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੋਈ ਮੁਕੰਦੁ ਹਮਰਾ ਪਿਤ ਮਾਤਾ ॥੧॥",
      "transliteration": "soee muka(n)d hamaraa pit maataa ||1||",
      "translation": "Mukanday is my father and mother. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੀਵਤ ਮੁਕੰਦੇ ਮਰਤ ਮੁਕੰਦੇ ॥",
      "transliteration": "jeevat muka(n)de marat muka(n)de ||",
      "translation": "Meditate on Mukanday in life, and meditate on Mukanday in death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਾ ਕੇ ਸੇਵਕ ਕਉ ਸਦਾ ਅਨੰਦੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "taa ke sevak kau sadaa ana(n)de ||1|| rahaau ||",
      "translation": "His servant is blissful forever. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮੁਕੰਦ ਮੁਕੰਦ ਹਮਾਰੇ ਪ੍ਰਾਨੰ ॥",
      "transliteration": "muka(n)d muka(n)d hamaare praana(n) ||",
      "translation": "The Lord, Mukanday, is my breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਪਿ ਮੁਕੰਦ ਮਸਤਕਿ ਨੀਸਾਨੰ ॥",
      "transliteration": "jap muka(n)d masatak neesaana(n) ||",
      "translation": "Meditating on Mukanday, one's forehead will bear the Lord's insignia of approval.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੇਵ ਮੁਕੰਦ ਕਰੈ ਬੈਰਾਗੀ ॥",
      "transliteration": "sev muka(n)d karai bairaagee ||",
      "translation": "The renunciate serves Mukanday.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੋਈ ਮੁਕੰਦੁ ਦੁਰਬਲ ਧਨੁ ਲਾਧੀ ॥੨॥",
      "transliteration": "soee muka(n)d durabal dhan laadhee ||2||",
      "translation": "Mukanday is the wealth of the poor and forlorn. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਏਕੁ ਮੁਕੰਦੁ ਕਰੈ ਉਪਕਾਰੁ ॥",
      "transliteration": "ek muka(n)d karai upakaar ||",
      "translation": "When the One Liberator does me a favor,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਮਰਾ ਕਹਾ ਕਰੈ ਸੰਸਾਰੁ ॥",
      "transliteration": "hamaraa kahaa karai sa(n)saar ||",
      "translation": "then what can the world do to me?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮੇਟੀ ਜਾਤਿ ਹੂਏ ਦਰਬਾਰਿ ॥",
      "transliteration": "metee jaat hooe darabaar ||",
      "translation": "Erasing my social status, I have entered His Court.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤੁਹੀ ਮੁਕੰਦ ਜੋਗ ਜੁਗ ਤਾਰਿ ॥੩॥",
      "transliteration": "tuhee muka(n)d jog jug taar ||3||",
      "translation": "You, Mukanday, are potent throughout the four ages. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਉਪਜਿਓ ਗਿਆਨੁ ਹੂਆ ਪਰਗਾਸ ॥",
      "transliteration": "upajio giaan hooaa paragaas ||",
      "translation": "Spiritual wisdom has welled up, and I have been enlightened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਲੀਨੇ ਕੀਟ ਦਾਸ ॥",
      "transliteration": "kar kirapaa leene keet daas ||",
      "translation": "In His Mercy, the Lord has made this worm His slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਹੁ ਰਵਿਦਾਸ ਅਬ ਤ੍ਰਿਸਨਾ ਚੂਕੀ ॥",
      "transliteration": "kahu ravidaas ab trisanaa chookee ||",
      "translation": "Says Ravi Daas, now my thirst is quenched;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਪਿ ਮੁਕੰਦ ਸੇਵਾ ਤਾਹੂ ਕੀ ॥੪॥੧॥",
      "transliteration": "jap muka(n)d sevaa taahoo kee ||4||1||",
      "translation": "I meditate on Mukanday the Liberator, and I serve Him. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗੋਂਡ ॥",
      "transliteration": "go(n)d ||",
      "translation": "Gond:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੇ ਓਹੁ ਅਠਸਠਿ ਤੀਰਥ ਨੑਾਵੈ ॥",
      "transliteration": "je ohu athasath teerath nhaavai ||",
      "translation": "Someone may bathe at the sixty-eight sacred shrines of pilgrimage,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜੇ ਓਹੁ ਦੁਆਦਸ ਸਿਲਾ ਪੂਜਾਵੈ ॥",
      "transliteration": "je ohu duaadas silaa poojaavai ||",
      "translation": "and worship the twelve Shiva-lingam stones,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੇ ਓਹੁ ਕੂਪ ਤਟਾ ਦੇਵਾਵੈ ॥",
      "transliteration": "je ohu koop tataa devaavai ||",
      "translation": "and dig wells and pools,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਰੈ ਨਿੰਦ ਸਭ ਬਿਰਥਾ ਜਾਵੈ ॥੧॥",
      "transliteration": "karai ni(n)d sabh birathaa jaavai ||1||",
      "translation": "but if he indulges in slander, then all of this is useless. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਾਧ ਕਾ ਨਿੰਦਕੁ ਕੈਸੇ ਤਰੈ ॥",
      "transliteration": "saadh kaa ni(n)dak kaise tarai ||",
      "translation": "How can the slanderer of the Holy Saints be saved?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਰਪਰ ਜਾਨਹੁ ਨਰਕ ਹੀ ਪਰੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sarapar jaanahu narak hee parai ||1|| rahaau ||",
      "translation": "Know for certain, that he shall go to hell. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੇ ਓਹੁ ਗ੍ਰਹਨ ਕਰੈ ਕੁਲਖੇਤਿ ॥",
      "transliteration": "je ohu grahan karai kulakhet ||",
      "translation": "Someone may bathe at Kuruk-shaytra during a solar eclipse,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਰਪੈ ਨਾਰਿ ਸੀਗਾਰ ਸਮੇਤਿ ॥",
      "transliteration": "arapai naar seegaar samet ||",
      "translation": "and give his decorated wife in offering,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਗਲੀ ਸਿੰਮ੍ਰਿਤਿ ਸ੍ਰਵਨੀ ਸੁਨੈ ॥",
      "transliteration": "sagalee si(n)mrit sravanee sunai ||",
      "translation": "and listen to all the Simritees,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਰੈ ਨਿੰਦ ਕਵਨੈ ਨਹੀ ਗੁਨੈ ॥੨॥",
      "transliteration": "karai ni(n)d kavanai nahee gunai ||2||",
      "translation": "but if he indulges in slander, these are of no account. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੇ ਓਹੁ ਅਨਿਕ ਪ੍ਰਸਾਦ ਕਰਾਵੈ ॥",
      "transliteration": "je ohu anik prasaad karaavai ||",
      "translation": "Someone may give countless feasts,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭੂਮਿ ਦਾਨ ਸੋਭਾ ਮੰਡਪਿ ਪਾਵੈ ॥",
      "transliteration": "bhoom daan sobhaa ma(n)dap paavai ||",
      "translation": "and donate land, and build splendid buildings;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਪਨਾ ਬਿਗਾਰਿ ਬਿਰਾਂਨਾ ਸਾਂਢੈ ॥",
      "transliteration": "apanaa bigaar biraa(n)naa saa(n)dhai ||",
      "translation": "he may neglect his own affairs to work for others,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰੈ ਨਿੰਦ ਬਹੁ ਜੋਨੀ ਹਾਂਢੈ ॥੩॥",
      "transliteration": "karai ni(n)d bahu jonee haa(n)dhai ||3||",
      "translation": "but if he indulges in slander, he shall wander in countless incarnations. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਿੰਦਾ ਕਹਾ ਕਰਹੁ ਸੰਸਾਰਾ ॥",
      "transliteration": "ni(n)daa kahaa karahu sa(n)saaraa ||",
      "translation": "Why do you indulge in slander, O people of the world?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਿੰਦਕ ਕਾ ਪਰਗਟਿ ਪਾਹਾਰਾ ॥",
      "transliteration": "ni(n)dak kaa paragat paahaaraa ||",
      "translation": "The emptiness of the slanderer is soon exposed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਿੰਦਕੁ ਸੋਧਿ ਸਾਧਿ ਬੀਚਾਰਿਆ ॥",
      "transliteration": "ni(n)dak sodh saadh beechaariaa ||",
      "translation": "I have thought, and determined the fate of the slanderer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 875,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0875_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਹੁ ਰਵਿਦਾਸ ਪਾਪੀ ਨਰਕਿ ਸਿਧਾਰਿਆ ॥੪॥੨॥੧੧॥੭॥੨॥੪੯॥ ਜੋੜੁ ॥",
      "transliteration": "kahu ravidaas paapee narak sidhaariaa ||4||2||11||7||2||49|| joR ||",
      "translation": "Says Ravi Daas, he is a sinner; he shall go to hell. ||4||2||11||7||2||49|| Total||",
