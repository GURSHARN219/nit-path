{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 878,
  "lineCount": 52,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0878_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਛਿਅ ਦਰਸਨ ਕੀ ਸੋਝੀ ਪਾਇ ॥੪॥੫॥",
      "transliteration": "chhi darasan kee sojhee paai ||4||5||",
      "translation": "has the wisdom of the six Shaastras. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "raamakalee mahalaa 1 ||",
      "translation": "Raamkalee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਮ ਡੋਲਤ ਬੇੜੀ ਪਾਪ ਭਰੀ ਹੈ ਪਵਣੁ ਲਗੈ ਮਤੁ ਜਾਈ ॥",
      "transliteration": "ham dolat beRee paap bharee hai pavan lagai mat jaaee ||",
      "translation": "My boat is wobbly and unsteady; it is filled with sins. The wind is rising - what if it tips over?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਨਮੁਖ ਸਿਧ ਭੇਟਣ ਕਉ ਆਏ ਨਿਹਚਉ ਦੇਹਿ ਵਡਿਆਈ ॥੧॥",
      "transliteration": "sanamukh sidh bhetan kau aae nihachau dehi vadiaaee ||1||",
      "translation": "As sunmukh, I have turned to the Guru; O my Perfect Master; please be sure to bless me with Your glorious greatness. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਰ ਤਾਰਿ ਤਾਰਣਹਾਰਿਆ ॥",
      "transliteration": "gur taar taaranahaariaa ||",
      "translation": "O Guru, my Saving Grace, please carry me across the world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦੇਹਿ ਭਗਤਿ ਪੂਰਨ ਅਵਿਨਾਸੀ ਹਉ ਤੁਝ ਕਉ ਬਲਿਹਾਰਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dehi bhagat pooran avinaasee hau tujh kau balihaariaa ||1|| rahaau ||",
      "translation": "Bless me with devotion to the perfect, imperishable Lord God; I am a sacrifice to You. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਿਧ ਸਾਧਿਕ ਜੋਗੀ ਅਰੁ ਜੰਗਮ ਏਕੁ ਸਿਧੁ ਜਿਨੀ ਧਿਆਇਆ ॥",
      "transliteration": "sidh saadhik jogee ar ja(n)gam ek sidh jinee dhiaaiaa ||",
      "translation": "He alone is a Siddha, a seeker, a Yogi, a wandering pilgrim, who meditates on the One Perfect Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪਰਸਤ ਪੈਰ ਸਿਝਤ ਤੇ ਸੁਆਮੀ ਅਖਰੁ ਜਿਨ ਕਉ ਆਇਆ ॥੨॥",
      "transliteration": "parasat pair sijhat te suaamee akhar jin kau aaiaa ||2||",
      "translation": "Touching the feet of the Lord Master, they are emancipated; they come to receive the Word of the Teachings. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਪ ਤਪ ਸੰਜਮ ਕਰਮ ਨ ਜਾਨਾ ਨਾਮੁ ਜਪੀ ਪ੍ਰਭ ਤੇਰਾ ॥",
      "transliteration": "jap tap sa(n)jam karam na jaanaa naam japee prabh teraa ||",
      "translation": "I know nothing of charity, meditation, self-discipline or religious rituals; I only chant Your Name, God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰੁ ਪਰਮੇਸਰੁ ਨਾਨਕ ਭੇਟਿਓ ਸਾਚੈ ਸਬਦਿ ਨਿਬੇਰਾ ॥੩॥੬॥",
      "transliteration": "gur paramesar naanak bhetio saachai sabad niberaa ||3||6||",
      "translation": "Nanak has met the Guru, the Transcendent Lord God; through the True Word of His Shabad, he is set free. ||3||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "raamakalee mahalaa 1 ||",
      "translation": "Raamkalee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁਰਤੀ ਸੁਰਤਿ ਰਲਾਈਐ ਏਤੁ ॥",
      "transliteration": "suratee surat ralaaeeai et ||",
      "translation": "Focus your consciousness in deep absorption on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਨੁ ਕਰਿ ਤੁਲਹਾ ਲੰਘਹਿ ਜੇਤੁ ॥",
      "transliteration": "tan kar tulahaa la(n)ghahi jet ||",
      "translation": "Make your body a raft, to cross over.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅੰਤਰਿ ਭਾਹਿ ਤਿਸੈ ਤੂ ਰਖੁ ॥",
      "transliteration": "a(n)tar bhaahi tisai too rakh ||",
      "translation": "Deep within is the fire of desire; keep it in check.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਦੀਵਾ ਬਲੈ ਅਥਕੁ ॥੧॥",
      "transliteration": "ahinis deevaa balai athak ||1||",
      "translation": "Day and night, that lamp shall burn unceasingly. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਐਸਾ ਦੀਵਾ ਨੀਰਿ ਤਰਾਇ ॥",
      "transliteration": "aisaa deevaa neer taraai ||",
      "translation": "Float such a lamp upon the water;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਤੁ ਦੀਵੈ ਸਭ ਸੋਝੀ ਪਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jit deevai sabh sojhee paai ||1|| rahaau ||",
      "translation": "this lamp will bring total understanding. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹਛੀ ਮਿਟੀ ਸੋਝੀ ਹੋਇ ॥",
      "transliteration": "hachhee mitee sojhee hoi ||",
      "translation": "This understanding is good clay;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਾ ਕਾ ਕੀਆ ਮਾਨੈ ਸੋਇ ॥",
      "transliteration": "taa kaa keeaa maanai soi ||",
      "translation": "a lamp made of such clay is acceptable to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਰਣੀ ਤੇ ਕਰਿ ਚਕਹੁ ਢਾਲਿ ॥",
      "transliteration": "karanee te kar chakahu dhaal ||",
      "translation": "So shape this lamp on the wheel of good actions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਐਥੈ ਓਥੈ ਨਿਬਹੀ ਨਾਲਿ ॥੨॥",
      "transliteration": "aithai othai nibahee naal ||2||",
      "translation": "In this world and in the next, this lamp shall be with you. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਪੇ ਨਦਰਿ ਕਰੇ ਜਾ ਸੋਇ ॥",
      "transliteration": "aape nadar kare jaa soi ||",
      "translation": "When He Himself grants His Grace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਵਿਰਲਾ ਬੂਝੈ ਕੋਇ ॥",
      "transliteration": "guramukh viralaa boojhai koi ||",
      "translation": "then, as Gurmukh, one may understand Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਤੁ ਘਟਿ ਦੀਵਾ ਨਿਹਚਲੁ ਹੋਇ ॥",
      "transliteration": "tit ghat deevaa nihachal hoi ||",
      "translation": "Within the heart, this lamp is permanently lit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪਾਣੀ ਮਰੈ ਨ ਬੁਝਾਇਆ ਜਾਇ ॥",
      "transliteration": "paanee marai na bujhaaiaa jaai ||",
      "translation": "It is not extinguished by water or wind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਐਸਾ ਦੀਵਾ ਨੀਰਿ ਤਰਾਇ ॥੩॥",
      "transliteration": "aisaa deevaa neer taraai ||3||",
      "translation": "Such a lamp will carry you across the water. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਡੋਲੈ ਵਾਉ ਨ ਵਡਾ ਹੋਇ ॥",
      "transliteration": "dolai vaau na vadaa hoi ||",
      "translation": "Wind does not shake it, or put it out.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾਪੈ ਜਿਉ ਸਿੰਘਾਸਣਿ ਲੋਇ ॥",
      "transliteration": "jaapai jiu si(n)ghaasan loi ||",
      "translation": "Its light reveals the Divine Throne.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਖਤ੍ਰੀ ਬ੍ਰਾਹਮਣੁ ਸੂਦੁ ਕਿ ਵੈਸੁ ॥",
      "transliteration": "khatree braahaman sood k vais ||",
      "translation": "The Kh'shaatriyas, Brahmins, Soodras and Vaishyas",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਿਰਤਿ ਨ ਪਾਈਆ ਗਣੀ ਸਹੰਸ ॥",
      "transliteration": "nirat na paaeeaa ganee saha(n)s ||",
      "translation": "cannot find its value, even by thousands of calculations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਐਸਾ ਦੀਵਾ ਬਾਲੇ ਕੋਇ ॥",
      "transliteration": "aisaa deevaa baale koi ||",
      "translation": "If any of them lights such a lamp,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਨਕ ਸੋ ਪਾਰੰਗਤਿ ਹੋਇ ॥੪॥੭॥",
      "transliteration": "naanak so paara(n)gat hoi ||4||7||",
      "translation": "O Nanak, he is emancipated. ||4||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "raamakalee mahalaa 1 ||",
      "translation": "Raamkalee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੁਧਨੋ ਨਿਵਣੁ ਮੰਨਣੁ ਤੇਰਾ ਨਾਉ ॥",
      "transliteration": "tudhano nivan ma(n)nan teraa naau ||",
      "translation": "To place one's faith in Your Name, Lord, is true worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਾਚੁ ਭੇਟ ਬੈਸਣ ਕਉ ਥਾਉ ॥",
      "transliteration": "saach bhet baisan kau thaau ||",
      "translation": "With an offering of Truth, one obtains a place to sit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਤੁ ਸੰਤੋਖੁ ਹੋਵੈ ਅਰਦਾਸਿ ॥",
      "transliteration": "sat sa(n)tokh hovai aradaas ||",
      "translation": "If a prayer is offered with truth and contentment,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਾ ਸੁਣਿ ਸਦਿ ਬਹਾਲੇ ਪਾਸਿ ॥੧॥",
      "transliteration": "taa sun sad bahaale paas ||1||",
      "translation": "the Lord will hear it, and call him in to sit by Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਨਕ ਬਿਰਥਾ ਕੋਇ ਨ ਹੋਇ ॥",
      "transliteration": "naanak birathaa koi na hoi ||",
      "translation": "O Nanak, no one returns empty-handed;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਐਸੀ ਦਰਗਹ ਸਾਚਾ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aisee daragah saachaa soi ||1|| rahaau ||",
      "translation": "such is the Court of the True Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪ੍ਰਾਪਤਿ ਪੋਤਾ ਕਰਮੁ ਪਸਾਉ ॥",
      "transliteration": "praapat potaa karam pasaau ||",
      "translation": "The treasure I seek is the gift of Your Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੂ ਦੇਵਹਿ ਮੰਗਤ ਜਨ ਚਾਉ ॥",
      "transliteration": "too devahi ma(n)gat jan chaau ||",
      "translation": "Please bless this humble beggar - this is what I seek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਾਡੈ ਭਾਉ ਪਵੈ ਤਿਤੁ ਆਇ ॥",
      "transliteration": "bhaadai bhaau pavai tit aai ||",
      "translation": "Please, pour Your Love into the cup of my heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਧੁਰਿ ਤੈ ਛੋਡੀ ਕੀਮਤਿ ਪਾਇ ॥੨॥",
      "transliteration": "dhur tai chhodee keemat paai ||2||",
      "translation": "This is Your pre-determined value. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਨਿ ਕਿਛੁ ਕੀਆ ਸੋ ਕਿਛੁ ਕਰੈ ॥",
      "transliteration": "jin kichh keeaa so kichh karai ||",
      "translation": "The One who created everything, does everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਪਨੀ ਕੀਮਤਿ ਆਪੇ ਧਰੈ ॥",
      "transliteration": "apanee keemat aape dharai ||",
      "translation": "He Himself appraises His own value.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਰਗਟੁ ਹੋਆ ਹਰਿ ਰਾਇ ॥",
      "transliteration": "guramukh paragat hoaa har raai ||",
      "translation": "The Sovereign Lord King becomes manifest to the Gurmukh.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾ ਕੋ ਆਵੈ ਨਾ ਕੋ ਜਾਇ ॥੩॥",
      "transliteration": "naa ko aavai naa ko jaai ||3||",
      "translation": "He does not come, and He does not go. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਲੋਕੁ ਧਿਕਾਰੁ ਕਹੈ ਮੰਗਤ ਜਨ ਮਾਗਤ ਮਾਨੁ ਨ ਪਾਇਆ ॥",
      "transliteration": "lok dhikaar kahai ma(n)gat jan maagat maan na paaiaa ||",
      "translation": "People curse at the beggar; by begging, he does not receive honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਹ ਕੀਆ ਗਲਾ ਦਰ ਕੀਆ ਬਾਤਾ ਤੈ ਤਾ ਕਹਣੁ ਕਹਾਇਆ ॥੪॥੮॥",
      "transliteration": "sah keeaa galaa dar keeaa baataa tai taa kahan kahaaiaa ||4||8||",
      "translation": "O Lord, You inspire me to speak Your Words, and tell the Story of Your Court. ||4||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "raamakalee mahalaa 1 ||",
      "translation": "Raamkalee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਾਗਰ ਮਹਿ ਬੂੰਦ ਬੂੰਦ ਮਹਿ ਸਾਗਰੁ ਕਵਣੁ ਬੁਝੈ ਬਿਧਿ ਜਾਣੈ ॥",
      "transliteration": "saagar mahi boo(n)d boo(n)d mahi saagar kavan bujhai bidh jaanai ||",
      "translation": "The drop is in the ocean, and the ocean is in the drop. Who understands, and knows this?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0878_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਉਤਭੁਜ ਚਲਤ ਆਪਿ ਕਰਿ ਚੀਨੈ ਆਪੇ ਤਤੁ ਪਛਾਣੈ ॥੧॥",
      "transliteration": "utabhuj chalat aap kar cheenai aape tat pachhaanai ||1||",
      "translation": "He Himself creates the wondrous play of the world. He Himself contemplates it, and understands its true essence. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 878,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
