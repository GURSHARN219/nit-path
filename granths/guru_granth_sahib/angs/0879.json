{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 879,
  "lineCount": 46,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0879_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਐਸਾ ਗਿਆਨੁ ਬੀਚਾਰੈ ਕੋਈ ॥",
      "transliteration": "aisaa giaan beechaarai koee ||",
      "translation": "How rare are those who contemplate this spiritual wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਿਸ ਤੇ ਮੁਕਤਿ ਪਰਮ ਗਤਿ ਹੋਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tis te mukat param gat hoee ||1|| rahaau ||",
      "translation": "Through this, the supreme state of liberation is attained. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦਿਨ ਮਹਿ ਰੈਣਿ ਰੈਣਿ ਮਹਿ ਦਿਨੀਅਰੁ ਉਸਨ ਸੀਤ ਬਿਧਿ ਸੋਈ ॥",
      "transliteration": "din mahi rain rain mahi dineear usan seet bidh soee ||",
      "translation": "The night is in the day, and the day is in the night. The same is true of hot and cold.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਾ ਕੀ ਗਤਿ ਮਿਤਿ ਅਵਰੁ ਨ ਜਾਣੈ ਗੁਰ ਬਿਨੁ ਸਮਝ ਨ ਹੋਈ ॥੨॥",
      "transliteration": "taa kee gat mit avar na jaanai gur bin samajh na hoee ||2||",
      "translation": "No one else knows His state and extent; without the Guru, this is not understood. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪੁਰਖ ਮਹਿ ਨਾਰਿ ਨਾਰਿ ਮਹਿ ਪੁਰਖਾ ਬੂਝਹੁ ਬ੍ਰਹਮ ਗਿਆਨੀ ॥",
      "transliteration": "purakh mahi naar naar mahi purakhaa boojhahu braham giaanee ||",
      "translation": "The female is in the male, and the male is in the female. Understand this, O God-realized being!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਧੁਨਿ ਮਹਿ ਧਿਆਨੁ ਧਿਆਨ ਮਹਿ ਜਾਨਿਆ ਗੁਰਮੁਖਿ ਅਕਥ ਕਹਾਨੀ ॥੩॥",
      "transliteration": "dhun mahi dhiaan dhiaan mahi jaaniaa guramukh akath kahaanee ||3||",
      "translation": "The meditation is in the music, and knowledge is in meditation. Become Gurmukh, and speak the Unspoken Speech. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਨ ਮਹਿ ਜੋਤਿ ਜੋਤਿ ਮਹਿ ਮਨੂਆ ਪੰਚ ਮਿਲੇ ਗੁਰ ਭਾਈ ॥",
      "transliteration": "man mahi jot jot mahi manooaa pa(n)ch mile gur bhaaee ||",
      "translation": "The Light is in the mind, and the mind is in the Light. The Guru brings the five senses together, like brothers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਨਕ ਤਿਨ ਕੈ ਸਦ ਬਲਿਹਾਰੀ ਜਿਨ ਏਕ ਸਬਦਿ ਲਿਵ ਲਾਈ ॥੪॥੯॥",
      "transliteration": "naanak tin kai sad balihaaree jin ek sabad liv laaee ||4||9||",
      "translation": "Nanak is forever a sacrifice to those who enshrine love for the One Word of the Shabad. ||4||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "raamakalee mahalaa 1 ||",
      "translation": "Raamkalee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਾ ਹਰਿ ਪ੍ਰਭਿ ਕਿਰਪਾ ਧਾਰੀ ॥",
      "transliteration": "jaa har prabh kirapaa dhaaree ||",
      "translation": "When the Lord God showered His Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਹਉਮੈ ਵਿਚਹੁ ਮਾਰੀ ॥",
      "transliteration": "taa haumai vichahu maaree ||",
      "translation": "egotism was eradicated from within me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੋ ਸੇਵਕਿ ਰਾਮ ਪਿਆਰੀ ॥",
      "transliteration": "so sevak raam piaaree ||",
      "translation": "That humble servant who contemplates the",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੋ ਗੁਰਸਬਦੀ ਬੀਚਾਰੀ ॥੧॥",
      "transliteration": "jo gurasabadee beechaaree ||1||",
      "translation": "Word of the Guru's Shabad, is very dear to the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੋ ਹਰਿ ਜਨੁ ਹਰਿ ਪ੍ਰਭ ਭਾਵੈ ॥",
      "transliteration": "so har jan har prabh bhaavai ||",
      "translation": "That humble servant of the Lord is pleasing to his Lord God;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਭਗਤਿ ਕਰੇ ਦਿਨੁ ਰਾਤੀ ਲਾਜ ਛੋਡਿ ਹਰਿ ਕੇ ਗੁਣ ਗਾਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ahinis bhagat kare din raatee laaj chhod har ke gun gaavai ||1|| rahaau ||",
      "translation": "day and night, he performs devotional worship, day and night. Disregarding his own honor, he sings the Glorious Praises of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਧੁਨਿ ਵਾਜੇ ਅਨਹਦ ਘੋਰਾ ॥",
      "transliteration": "dhun vaaje anahad ghoraa ||",
      "translation": "The unstruck melody of the sound current resonates and resounds;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਨੁ ਮਾਨਿਆ ਹਰਿ ਰਸਿ ਮੋਰਾ ॥",
      "transliteration": "man maaniaa har ras moraa ||",
      "translation": "my mind is appeased by the subtle essence of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰ ਪੂਰੈ ਸਚੁ ਸਮਾਇਆ ॥",
      "transliteration": "gur poorai sach samaaiaa ||",
      "translation": "Through the Perfect Guru, I am absorbed in Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੁਰੁ ਆਦਿ ਪੁਰਖੁ ਹਰਿ ਪਾਇਆ ॥੨॥",
      "transliteration": "gur aad purakh har paaiaa ||2||",
      "translation": "Through the Guru, I have found the Lord, the Primal Being. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਭਿ ਨਾਦ ਬੇਦ ਗੁਰਬਾਣੀ ॥",
      "transliteration": "sabh naad bed gurabaanee ||",
      "translation": "Gurbani is the sound current of the Naad, the Vedas, everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਨੁ ਰਾਤਾ ਸਾਰਿਗਪਾਣੀ ॥",
      "transliteration": "man raataa saarigapaanee ||",
      "translation": "My mind is attuned to the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਹ ਤੀਰਥ ਵਰਤ ਤਪ ਸਾਰੇ ॥",
      "transliteration": "tah teerath varat tap saare ||",
      "translation": "He is my sacred shrine of pilgrimage, fasting and austere self-discipline.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਰ ਮਿਲਿਆ ਹਰਿ ਨਿਸਤਾਰੇ ॥੩॥",
      "transliteration": "gur miliaa har nisataare ||3||",
      "translation": "The Lord saves, and carries across, those who meet with the Guru. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਹ ਆਪੁ ਗਇਆ ਭਉ ਭਾਗਾ ॥",
      "transliteration": "jah aap gaiaa bhau bhaagaa ||",
      "translation": "One whose self-conceit is gone, sees his fears run away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰ ਚਰਣੀ ਸੇਵਕੁ ਲਾਗਾ ॥",
      "transliteration": "gur charanee sevak laagaa ||",
      "translation": "That servant grasps the Guru's feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੁਰਿ ਸਤਿਗੁਰਿ ਭਰਮੁ ਚੁਕਾਇਆ ॥",
      "transliteration": "gur satigur bharam chukaaiaa ||",
      "translation": "The Guru, the True Guru, has expelled my doubts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਸਬਦਿ ਮਿਲਾਇਆ ॥੪॥੧੦॥",
      "transliteration": "kahu naanak sabad milaaiaa ||4||10||",
      "translation": "Says Nanak, I have merged into the Word of the Shabad. ||4||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "raamakalee mahalaa 1 ||",
      "translation": "Raamkalee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਛਾਦਨੁ ਭੋਜਨੁ ਮਾਗਤੁ ਭਾਗੈ ॥",
      "transliteration": "chhaadan bhojan maagat bhaagai ||",
      "translation": "He runs around, begging for clothes and food.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਖੁਧਿਆ ਦੁਸਟ ਜਲੈ ਦੁਖੁ ਆਗੈ ॥",
      "transliteration": "khudhiaa dusat jalai dukh aagai ||",
      "translation": "He burns with hunger and corruption, and will suffer in the world hereafter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗੁਰਮਤਿ ਨਹੀ ਲੀਨੀ ਦੁਰਮਤਿ ਪਤਿ ਖੋਈ ॥",
      "transliteration": "guramat nahee leenee duramat pat khoee ||",
      "translation": "He does not follow the Guru's Teachings; through his evil-mindedness, he loses his honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰਮਤਿ ਭਗਤਿ ਪਾਵੈ ਜਨੁ ਕੋਈ ॥੧॥",
      "transliteration": "guramat bhagat paavai jan koee ||1||",
      "translation": "Only through the Guru's Teachings will such a person become devoted. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜੋਗੀ ਜੁਗਤਿ ਸਹਜ ਘਰਿ ਵਾਸੈ ॥",
      "transliteration": "jogee jugat sahaj ghar vaasai ||",
      "translation": "The way of the Yogi is to dwell in the celestial home of bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਏਕ ਦ੍ਰਿਸਟਿ ਏਕੋ ਕਰਿ ਦੇਖਿਆ ਭੀਖਿਆ ਭਾਇ ਸਬਦਿ ਤ੍ਰਿਪਤਾਸੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ek drisat eko kar dekhiaa bheekhiaa bhaai sabad tripataasai ||1|| rahaau ||",
      "translation": "He looks impartially, equally upon all. He receives the charity of the Lord's Love, and the Word of the Shabad, and so he is satisfied. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪੰਚ ਬੈਲ ਗਡੀਆ ਦੇਹ ਧਾਰੀ ॥",
      "transliteration": "pa(n)ch bail gadeeaa deh dhaaree ||",
      "translation": "The five bulls, the senses, pull the wagon of the body around.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਾਮ ਕਲਾ ਨਿਬਹੈ ਪਤਿ ਸਾਰੀ ॥",
      "transliteration": "raam kalaa nibahai pat saaree ||",
      "translation": "By the Lord's power, one's honor is preserved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਧਰ ਤੂਟੀ ਗਾਡੋ ਸਿਰ ਭਾਰਿ ॥",
      "transliteration": "dhar tootee gaado sir bhaar ||",
      "translation": "But when the axle breaks, the wagon falls and crashes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਲਕਰੀ ਬਿਖਰਿ ਜਰੀ ਮੰਝ ਭਾਰਿ ॥੨॥",
      "transliteration": "lakaree bikhar jaree ma(n)jh bhaar ||2||",
      "translation": "It falls apart, like a pile of logs. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਵੀਚਾਰਿ ਜੋਗੀ ॥",
      "transliteration": "gur kaa sabad veechaar jogee ||",
      "translation": "Contemplate the Word of the Guru's Shabad, Yogi.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੁਖੁ ਸੁਖੁ ਸਮ ਕਰਣਾ ਸੋਗ ਬਿਓਗੀ ॥",
      "transliteration": "dukh sukh sam karanaa sog biogee ||",
      "translation": "Look upon pain and pleasure as one and the same, sorrow and separation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੁਗਤਿ ਨਾਮੁ ਗੁਰ ਸਬਦਿ ਬੀਚਾਰੀ ॥",
      "transliteration": "bhugat naam gur sabad beechaaree ||",
      "translation": "Let your food be contemplative meditation upon the Naam, the Name of the Lord, and the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਸਥਿਰੁ ਕੰਧੁ ਜਪੈ ਨਿਰੰਕਾਰੀ ॥੩॥",
      "transliteration": "asathir ka(n)dh japai nira(n)kaaree ||3||",
      "translation": "Your wall shall be permanent, by meditating on the Formless Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਹਜ ਜਗੋਟਾ ਬੰਧਨ ਤੇ ਛੂਟਾ ॥",
      "transliteration": "sahaj jagotaa ba(n)dhan te chhootaa ||",
      "translation": "Wear the loin-cloth of poise, and be free of entanglements.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਗੁਰਸਬਦੀ ਲੂਟਾ ॥",
      "transliteration": "kaam krodh gurasabadee lootaa ||",
      "translation": "The Guru's Word shall release you from sexual desire and anger.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਨ ਮਹਿ ਮੁੰਦ੍ਰਾ ਹਰਿ ਗੁਰ ਸਰਣਾ ॥",
      "transliteration": "man mahi mu(n)draa har gur saranaa ||",
      "translation": "In your mind, let your ear-rings be the Sanctuary of the Guru, the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0879_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕ ਰਾਮ ਭਗਤਿ ਜਨ ਤਰਣਾ ॥੪॥੧੧॥",
      "transliteration": "naanak raam bhagat jan taranaa ||4||11||",
      "translation": "O Nanak, worshipping the Lord in deep devotion, the humble are carried across. ||4||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 879,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
