{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 885,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0885_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਓਅੰਕਾਰਿ ਏਕ ਧੁਨਿ ਏਕੈ ਏਕੈ ਰਾਗੁ ਅਲਾਪੈ ॥",
      "transliteration": "oa(n)kaar ek dhun ekai ekai raag alaapai ||",
      "translation": "He sings the song of the One Universal Creator; he sings the tune of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਏਕਾ ਦੇਸੀ ਏਕੁ ਦਿਖਾਵੈ ਏਕੋ ਰਹਿਆ ਬਿਆਪੈ ॥",
      "transliteration": "ekaa desee ek dikhaavai eko rahiaa biaapai ||",
      "translation": "He lives in the land of the One Lord, shows the way to the One Lord, and remains attuned to the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਏਕਾ ਸੁਰਤਿ ਏਕਾ ਹੀ ਸੇਵਾ ਏਕੋ ਗੁਰ ਤੇ ਜਾਪੈ ॥੧॥",
      "transliteration": "ekaa surat ekaa hee sevaa eko gur te jaapai ||1||",
      "translation": "He centers his consciousness on the One Lord, and serves only the One Lord, who is known through the Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਲੋ ਭਲੋ ਰੇ ਕੀਰਤਨੀਆ ॥",
      "transliteration": "bhalo bhalo re keerataneeaa ||",
      "translation": "Blessed and good is such a kirtanee, who sings such Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਮ ਰਮਾ ਰਾਮਾ ਗੁਨ ਗਾਉ ॥",
      "transliteration": "raam ramaa raamaa gun gaau ||",
      "translation": "He sings the Glorious Praises of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਛੋਡਿ ਮਾਇਆ ਕੇ ਧੰਧ ਸੁਆਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "chhod maaiaa ke dha(n)dh suaau ||1|| rahaau ||",
      "translation": "and renounces the entanglements and pursuits of Maya. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪੰਚ ਬਜਿਤ੍ਰ ਕਰੇ ਸੰਤੋਖਾ ਸਾਤ ਸੁਰਾ ਲੈ ਚਾਲੈ ॥",
      "transliteration": "pa(n)ch bajitr kare sa(n)tokhaa saat suraa lai chaalai ||",
      "translation": "He makes the five virtues, like contentment, his musical instruments, and plays the seven notes of the love of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਾਜਾ ਮਾਣੁ ਤਾਣੁ ਤਜਿ ਤਾਨਾ ਪਾਉ ਨ ਬੀਗਾ ਘਾਲੈ ॥",
      "transliteration": "baajaa maan taan taj taanaa paau na beegaa ghaalai ||",
      "translation": "The notes he plays are the renunciation of pride and power; his feet keep the beat on the straight path.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਫੇਰੀ ਫੇਰੁ ਨ ਹੋਵੈ ਕਬ ਹੀ ਏਕੁ ਸਬਦੁ ਬੰਧਿ ਪਾਲੈ ॥੨॥",
      "transliteration": "pheree pher na hovai kab hee ek sabad ba(n)dh paalai ||2||",
      "translation": "He does not enter the cycle of reincarnation ever again; he keeps the One Word of the Shabad tied to the hem of his robe. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਰਦੀ ਨਰਹਰ ਜਾਣਿ ਹਦੂਰੇ ॥",
      "transliteration": "naaradee narahar jaan hadoore ||",
      "translation": "To play like Naarad, is to know that the Lord is ever-present.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਘੂੰਘਰ ਖੜਕੁ ਤਿਆਗਿ ਵਿਸੂਰੇ ॥",
      "transliteration": "ghoo(n)ghar khaRak tiaag visoore ||",
      "translation": "The tinkling of the ankle bells is the shedding of sorrows and worries.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਹਜ ਅਨੰਦ ਦਿਖਾਵੈ ਭਾਵੈ ॥",
      "transliteration": "sahaj ana(n)d dikhaavai bhaavai ||",
      "translation": "The dramatic gestures of acting are celestial bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਏਹੁ ਨਿਰਤਿਕਾਰੀ ਜਨਮਿ ਨ ਆਵੈ ॥੩॥",
      "transliteration": "ehu niratikaaree janam na aavai ||3||",
      "translation": "Such a dancer is not reincarnated again. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੇ ਕੋ ਅਪਨੇ ਠਾਕੁਰ ਭਾਵੈ ॥",
      "transliteration": "je ko apane thaakur bhaavai ||",
      "translation": "If anyone, out of millions of people, becomes pleasing to his Lord and Master,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕੋਟਿ ਮਧਿ ਏਹੁ ਕੀਰਤਨੁ ਗਾਵੈ ॥",
      "transliteration": "kot madh ehu keeratan gaavai ||",
      "translation": "He sings the Lord's Praises in this way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਕੀ ਜਾਵਉ ਟੇਕ ॥",
      "transliteration": "saadhasa(n)gat kee jaavau tek ||",
      "translation": "I have taken the Support of the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਤਿਸੁ ਕੀਰਤਨੁ ਏਕ ॥੪॥੮॥",
      "transliteration": "kahu naanak tis keeratan ek ||4||8||",
      "translation": "Says Nanak, the Kirtan of the One Lord's Praises are sung there. ||4||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕੋਈ ਬੋਲੈ ਰਾਮ ਰਾਮ ਕੋਈ ਖੁਦਾਇ ॥",
      "transliteration": "koee bolai raam raam koee khudaai ||",
      "translation": "Some call Him, 'Raam, Raam', and some call Him, 'Khudaa-i'.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕੋਈ ਸੇਵੈ ਗੁਸਈਆ ਕੋਈ ਅਲਾਹਿ ॥੧॥",
      "transliteration": "koee sevai gusaeeaa koee alaahi ||1||",
      "translation": "Some serve Him as 'Gusain', others as 'Allaah'. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਾਰਣ ਕਰਣ ਕਰੀਮ ॥",
      "transliteration": "kaaran karan kareem ||",
      "translation": "He is the Cause of causes, the Generous Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਿਰਪਾ ਧਾਰਿ ਰਹੀਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kirapaa dhaar raheem ||1|| rahaau ||",
      "translation": "He showers His Grace and Mercy upon us. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕੋਈ ਨਾਵੈ ਤੀਰਥਿ ਕੋਈ ਹਜ ਜਾਇ ॥",
      "transliteration": "koee naavai teerath koee haj jaai ||",
      "translation": "Some bathe at sacred shrines of pilgrimage, and some make the pilgrimage to Mecca.|",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕੋਈ ਕਰੈ ਪੂਜਾ ਕੋਈ ਸਿਰੁ ਨਿਵਾਇ ॥੨॥",
      "transliteration": "koee karai poojaa koee sir nivaai ||2||",
      "translation": "Some perform devotional worship services, and some bow their heads in prayer. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕੋਈ ਪੜੈ ਬੇਦ ਕੋਈ ਕਤੇਬ ॥",
      "transliteration": "koee paRai bed koee kateb ||",
      "translation": "Some read the Vedas, and some the Koran.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕੋਈ ਓਢੈ ਨੀਲ ਕੋਈ ਸੁਪੇਦ ॥੩॥",
      "transliteration": "koee odhai neel koee suped ||3||",
      "translation": "Some wear blue robes, and some wear white. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕੋਈ ਕਹੈ ਤੁਰਕੁ ਕੋਈ ਕਹੈ ਹਿੰਦੂ ॥",
      "transliteration": "koee kahai turak koee kahai hi(n)doo ||",
      "translation": "Some call themselves Muslim, and some call themselves Hindu.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕੋਈ ਬਾਛੈ ਭਿਸਤੁ ਕੋਈ ਸੁਰਗਿੰਦੂ ॥੪॥",
      "transliteration": "koee baachhai bhisat koee suragi(n)doo ||4||",
      "translation": "Some yearn for paradise, and others long for heaven. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਿਨਿ ਹੁਕਮੁ ਪਛਾਤਾ ॥",
      "transliteration": "kahu naanak jin hukam pachhaataa ||",
      "translation": "Says Nanak, one who realizes the Hukam of God's Will,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪ੍ਰਭ ਸਾਹਿਬ ਕਾ ਤਿਨਿ ਭੇਦੁ ਜਾਤਾ ॥੫॥੯॥",
      "transliteration": "prabh saahib kaa tin bhed jaataa ||5||9||",
      "translation": "knows the secrets of his Lord and Master. ||5||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪਵਨੈ ਮਹਿ ਪਵਨੁ ਸਮਾਇਆ ॥",
      "transliteration": "pavanai mahi pavan samaaiaa ||",
      "translation": "The wind merges into the wind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੋਤੀ ਮਹਿ ਜੋਤਿ ਰਲਿ ਜਾਇਆ ॥",
      "transliteration": "jotee mahi jot ral jaaiaa ||",
      "translation": "The light blends into the light.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਾਟੀ ਮਾਟੀ ਹੋਈ ਏਕ ॥",
      "transliteration": "maatee maatee hoee ek ||",
      "translation": "The dust becomes one with the dust.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰੋਵਨਹਾਰੇ ਕੀ ਕਵਨ ਟੇਕ ॥੧॥",
      "transliteration": "rovanahaare kee kavan tek ||1||",
      "translation": "What support is there for the one who is lamenting? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਉਨੁ ਮੂਆ ਰੇ ਕਉਨੁ ਮੂਆ ॥",
      "transliteration": "kaun mooaa re kaun mooaa ||",
      "translation": "Who has died? O, who has died?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬ੍ਰਹਮ ਗਿਆਨੀ ਮਿਲਿ ਕਰਹੁ ਬੀਚਾਰਾ ਇਹੁ ਤਉ ਚਲਤੁ ਭਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "braham giaanee mil karahu beechaaraa ihu tau chalat bhaiaa ||1|| rahaau ||",
      "translation": "O God-realized beings, meet together and consider this. What a wondrous thing has happened! ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਗਲੀ ਕਿਛੁ ਖਬਰਿ ਨ ਪਾਈ ॥",
      "transliteration": "agalee kichh khabar na paaee ||",
      "translation": "No one knows what happens after death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰੋਵਨਹਾਰੁ ਭਿ ਊਠਿ ਸਿਧਾਈ ॥",
      "transliteration": "rovanahaar bh ooth sidhaaee ||",
      "translation": "The one who is lamenting will also arise and depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭਰਮ ਮੋਹ ਕੇ ਬਾਂਧੇ ਬੰਧ ॥",
      "transliteration": "bharam moh ke baa(n)dhe ba(n)dh ||",
      "translation": "Mortal beings are bound by the bonds of doubt and attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੁਪਨੁ ਭਇਆ ਭਖਲਾਏ ਅੰਧ ॥੨॥",
      "transliteration": "supan bhaiaa bhakhalaae a(n)dh ||2||",
      "translation": "When life becomes a dream, the blind man babbles and grieves in vain. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਹੁ ਤਉ ਰਚਨੁ ਰਚਿਆ ਕਰਤਾਰਿ ॥",
      "transliteration": "ihu tau rachan rachiaa karataar ||",
      "translation": "The Creator Lord created this creation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਆਵਤ ਜਾਵਤ ਹੁਕਮਿ ਅਪਾਰਿ ॥",
      "transliteration": "aavat jaavat hukam apaar ||",
      "translation": "It comes and goes, subject to the Will of the Infinite Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਹ ਕੋ ਮੂਆ ਨ ਮਰਣੈ ਜੋਗੁ ॥",
      "transliteration": "nah ko mooaa na maranai jog ||",
      "translation": "No one dies; no one is capable of dying.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਹ ਬਿਨਸੈ ਅਬਿਨਾਸੀ ਹੋਗੁ ॥੩॥",
      "transliteration": "nah binasai abinaasee hog ||3||",
      "translation": "The soul does not perish; it is imperishable. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੋ ਇਹੁ ਜਾਣਹੁ ਸੋ ਇਹੁ ਨਾਹਿ ॥",
      "transliteration": "jo ihu jaanahu so ihu naahi ||",
      "translation": "That which is known, does not exist.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਾਨਣਹਾਰੇ ਕਉ ਬਲਿ ਜਾਉ ॥",
      "transliteration": "jaananahaare kau bal jaau ||",
      "translation": "I am a sacrifice to the one who knows this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰਿ ਭਰਮੁ ਚੁਕਾਇਆ ॥",
      "transliteration": "kahu naanak gur bharam chukaaiaa ||",
      "translation": "Says Nanak, the Guru has dispelled my doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾ ਕੋਈ ਮਰੈ ਨ ਆਵੈ ਜਾਇਆ ॥੪॥੧੦॥",
      "transliteration": "naa koee marai na aavai jaaiaa ||4||10||",
      "translation": "No one dies; no one comes or goes. ||4||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਪਿ ਗੋਬਿੰਦੁ ਗੋਪਾਲ ਲਾਲੁ ॥",
      "transliteration": "jap gobi(n)d gopaal laal ||",
      "translation": "Meditate on the Lord of the Universe, the Beloved Lord of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਸਿਮਰਿ ਤੂ ਜੀਵਹਿ ਫਿਰਿ ਨ ਖਾਈ ਮਹਾ ਕਾਲੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raam naam simar too jeevahi phir na khaaee mahaa kaal ||1|| rahaau ||",
      "translation": "Meditating in remembrance on the Lord's Name, you shall live, and the Great Death shall not consume you ever again. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0885_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕੋਟਿ ਜਨਮ ਭ੍ਰਮਿ ਭ੍ਰਮਿ ਭ੍ਰਮਿ ਆਇਓ ॥",
      "transliteration": "kot janam bhram bhram bhram aaio ||",
      "translation": "Through millions of incarnations, you have come, wandering, wandering, wandering.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 885,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
