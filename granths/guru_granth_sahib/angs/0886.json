{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 886,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0886_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਡੈ ਭਾਗਿ ਸਾਧਸੰਗੁ ਪਾਇਓ ॥੧॥",
      "transliteration": "badai bhaag saadhasa(n)g paaio ||1||",
      "translation": "By the highest destiny, you found the Saadh Sangat, the Company of the Holy. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਪੂਰੇ ਨਾਹੀ ਉਧਾਰੁ ॥",
      "transliteration": "bin gur poore naahee udhaar ||",
      "translation": "Without the Perfect Guru, no one is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਾਬਾ ਨਾਨਕੁ ਆਖੈ ਏਹੁ ਬੀਚਾਰੁ ॥੨॥੧੧॥",
      "transliteration": "baabaa naanak aakhai ehu beechaar ||2||11||",
      "translation": "This is what Baba Nanak says, after deep reflection. ||2||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਾਗੁ ਰਾਮਕਲੀ ਮਹਲਾ ੫ ਘਰੁ ੨ ॥",
      "transliteration": "raag raamakalee mahalaa 5 ghar 2 ||",
      "translation": "Raag Raamkalee, Fifth Mehl, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਾਰਿ ਪੁਕਾਰਹਿ ਨਾ ਤੂ ਮਾਨਹਿ ॥",
      "transliteration": "chaar pukaarahi naa too maanahi ||",
      "translation": "The four Vedas proclaim it, but you don't believe them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਖਟੁ ਭੀ ਏਕਾ ਬਾਤ ਵਖਾਨਹਿ ॥",
      "transliteration": "khat bhee ekaa baat vakhaanahi ||",
      "translation": "The six Shaastras also say one thing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦਸ ਅਸਟੀ ਮਿਲਿ ਏਕੋ ਕਹਿਆ ॥",
      "transliteration": "das asatee mil eko kahiaa ||",
      "translation": "The eighteen Puraanas all speak of the One God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤਾ ਭੀ ਜੋਗੀ ਭੇਦੁ ਨ ਲਹਿਆ ॥੧॥",
      "transliteration": "taa bhee jogee bhed na lahiaa ||1||",
      "translation": "Even so, Yogi, you do not understand this mystery. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿੰਕੁਰੀ ਅਨੂਪ ਵਾਜੈ ॥",
      "transliteration": "ki(n)kuree anoop vaajai ||",
      "translation": "The celestial harp plays the incomparable melody,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੋਗੀਆ ਮਤਵਾਰੋ ਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jogeeaa matavaaro re ||1|| rahaau ||",
      "translation": "but in your intoxication, you do not hear it, O Yogi. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪ੍ਰਥਮੇ ਵਸਿਆ ਸਤ ਕਾ ਖੇੜਾ ॥",
      "transliteration": "prathame vasiaa sat kaa kheRaa ||",
      "translation": "In the first age, the Golden Age, the village of truth was inhabited.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤ੍ਰਿਤੀਏ ਮਹਿ ਕਿਛੁ ਭਇਆ ਦੁਤੇੜਾ ॥",
      "transliteration": "triteee mahi kichh bhaiaa duteRaa ||",
      "translation": "In the Silver Age of Traytaa Yuga, things began to decline.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੁਤੀਆ ਅਰਧੋ ਅਰਧਿ ਸਮਾਇਆ ॥",
      "transliteration": "duteeaa aradho aradh samaaiaa ||",
      "translation": "In the Brass Age of Dwaapur Yuga, half of it was gone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਏਕੁ ਰਹਿਆ ਤਾ ਏਕੁ ਦਿਖਾਇਆ ॥੨॥",
      "transliteration": "ek rahiaa taa ek dikhaaiaa ||2||",
      "translation": "Now, only one leg of Truth remains, and the One Lord is revealed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਏਕੈ ਸੂਤਿ ਪਰੋਏ ਮਣੀਏ ॥",
      "transliteration": "ekai soot paroe maneee ||",
      "translation": "The beads are strung upon the one thread.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗਾਠੀ ਭਿਨਿ ਭਿਨਿ ਭਿਨਿ ਭਿਨਿ ਤਣੀਏ ॥",
      "transliteration": "gaathee bhin bhin bhin bhin taneee ||",
      "translation": "By means of many, various, diverse knots, they are tied, and kept separate on the string.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਫਿਰਤੀ ਮਾਲਾ ਬਹੁ ਬਿਧਿ ਭਾਇ ॥",
      "transliteration": "phiratee maalaa bahu bidh bhaai ||",
      "translation": "The beads of the mala are lovingly chanted upon in many ways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਖਿੰਚਿਆ ਸੂਤੁ ਤ ਆਈ ਥਾਇ ॥੩॥",
      "transliteration": "khi(n)chiaa soot ta aaee thaai ||3||",
      "translation": "When the thread is pulled out, the beads come together in one place. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਹੁ ਮਹਿ ਏਕੈ ਮਟੁ ਹੈ ਕੀਆ ॥",
      "transliteration": "chahu mahi ekai mat hai keeaa ||",
      "translation": "Throughout the four ages, the One Lord made the body His temple.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਹ ਬਿਖੜੇ ਥਾਨ ਅਨਿਕ ਖਿੜਕੀਆ ॥",
      "transliteration": "tah bikhaRe thaan anik khiRakeeaa ||",
      "translation": "It is a treacherous place, with several windows.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਖੋਜਤ ਖੋਜਤ ਦੁਆਰੇ ਆਇਆ ॥",
      "transliteration": "khojat khojat duaare aaiaa ||",
      "translation": "Searching and searching, one comes to the Lord's door.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਾ ਨਾਨਕ ਜੋਗੀ ਮਹਲੁ ਘਰੁ ਪਾਇਆ ॥੪॥",
      "transliteration": "taa naanak jogee mahal ghar paaiaa ||4||",
      "translation": "Then, O Nanak, the Yogi attains a home in the Mansion of the Lord's Presence. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਉ ਕਿੰਕੁਰੀ ਆਨੂਪ ਵਾਜੈ ॥",
      "transliteration": "iu ki(n)kuree aanoop vaajai ||",
      "translation": "Thus, the celestial harp plays the incomparable melody;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁਣਿ ਜੋਗੀ ਕੈ ਮਨਿ ਮੀਠੀ ਲਾਗੈ ॥੧॥ ਰਹਾਉ ਦੂਜਾ ॥੧॥੧੨॥",
      "transliteration": "sun jogee kai man meethee laagai ||1|| rahaau doojaa ||1||12||",
      "translation": "hearing it, the Yogi's mind finds it sweet. ||1||Second Pause||1||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤਾਗਾ ਕਰਿ ਕੈ ਲਾਈ ਥਿਗਲੀ ॥",
      "transliteration": "taagaa kar kai laaee thigalee ||",
      "translation": "The body is a patch-work of threads.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਲਉ ਨਾੜੀ ਸੂਆ ਹੈ ਅਸਤੀ ॥",
      "transliteration": "lau naaRee sooaa hai asatee ||",
      "translation": "The muscles are stitched together with the needles of the bones.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅੰਭੈ ਕਾ ਕਰਿ ਡੰਡਾ ਧਰਿਆ ॥",
      "transliteration": "a(n)bhai kaa kar da(n)daa dhariaa ||",
      "translation": "The Lord has erected a pillar of water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਿਆ ਤੂ ਜੋਗੀ ਗਰਬਹਿ ਪਰਿਆ ॥੧॥",
      "transliteration": "kiaa too jogee garabahi pariaa ||1||",
      "translation": "O Yogi, why are you so proud? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਪਿ ਨਾਥੁ ਦਿਨੁ ਰੈਨਾਈ ॥",
      "transliteration": "jap naath din rainaaee ||",
      "translation": "Meditate on your Lord Master, day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤੇਰੀ ਖਿੰਥਾ ਦੋ ਦਿਹਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "teree khi(n)thaa do dihaaee ||1|| rahaau ||",
      "translation": "The patched coat of the body shall last for only a few days. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗਹਰੀ ਬਿਭੂਤ ਲਾਇ ਬੈਠਾ ਤਾੜੀ ॥",
      "transliteration": "gaharee bibhoot laai baithaa taaRee ||",
      "translation": "Smearing ashes on your body, you sit in a deep meditative trance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮੇਰੀ ਤੇਰੀ ਮੁੰਦ੍ਰਾ ਧਾਰੀ ॥",
      "transliteration": "meree teree mu(n)draa dhaaree ||",
      "translation": "You wear the ear-rings of 'mine and yours'.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਾਗਹਿ ਟੂਕਾ ਤ੍ਰਿਪਤਿ ਨ ਪਾਵੈ ॥",
      "transliteration": "maagahi tookaa tripat na paavai ||",
      "translation": "You beg for bread, but you are not satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਥੁ ਛੋਡਿ ਜਾਚਹਿ ਲਾਜ ਨ ਆਵੈ ॥੨॥",
      "transliteration": "naath chhod jaachahi laaj na aavai ||2||",
      "translation": "Abandoning your Lord Master, you beg from others; you should feel ashamed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚਲ ਚਿਤ ਜੋਗੀ ਆਸਣੁ ਤੇਰਾ ॥",
      "transliteration": "chal chit jogee aasan teraa ||",
      "translation": "Your consciousness is restless, Yogi, as you sit in your Yogic postures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਿੰਙੀ ਵਾਜੈ ਨਿਤ ਉਦਾਸੇਰਾ ॥",
      "transliteration": "si(n)ngee vaajai nit udaaseraa ||",
      "translation": "You blow your horn, but still feel sad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰ ਗੋਰਖ ਕੀ ਤੈ ਬੂਝ ਨ ਪਾਈ ॥",
      "transliteration": "gur gorakh kee tai boojh na paaee ||",
      "translation": "You do not understand Gorakh, your guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਫਿਰਿ ਫਿਰਿ ਜੋਗੀ ਆਵੈ ਜਾਈ ॥੩॥",
      "transliteration": "phir phir jogee aavai jaaee ||3||",
      "translation": "Again and again, Yogi, you come and go. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਿਸ ਨੋ ਹੋਆ ਨਾਥੁ ਕ੍ਰਿਪਾਲਾ ॥",
      "transliteration": "jis no hoaa naath kripaalaa ||",
      "translation": "He, unto whom the Master shows Mercy",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਹਰਾਸਿ ਹਮਾਰੀ ਗੁਰ ਗੋਪਾਲਾ ॥",
      "transliteration": "raharaas hamaaree gur gopaalaa ||",
      "translation": "unto Him, the Guru, the Lord of the World, I offer my prayer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਮੈ ਖਿੰਥਾ ਨਾਮੈ ਬਸਤਰੁ ॥",
      "transliteration": "naamai khi(n)thaa naamai basatar ||",
      "translation": "One who has the Name as his patched coat, and the Name as his robe,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਜੋਗੀ ਹੋਆ ਅਸਥਿਰੁ ॥੪॥",
      "transliteration": "jan naanak jogee hoaa asathir ||4||",
      "translation": "O servant Nanak, such a Yogi is steady and stable. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਉ ਜਪਿਆ ਨਾਥੁ ਦਿਨੁ ਰੈਨਾਈ ॥",
      "transliteration": "iu japiaa naath din rainaaee ||",
      "translation": "One who meditates on the Master in this way, night and day,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹੁਣਿ ਪਾਇਆ ਗੁਰੁ ਗੋਸਾਈ ॥੧॥ ਰਹਾਉ ਦੂਜਾ ॥੨॥੧੩॥",
      "transliteration": "hun paaiaa gur gosaaee ||1|| rahaau doojaa ||2||13||",
      "translation": "finds the Guru, the Lord of the World, in this life. ||1||Second Pause||2||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਸੋਈ ॥",
      "transliteration": "karan karaavan soee ||",
      "translation": "He is the Creator, the Cause of causes;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਆਨ ਨ ਦੀਸੈ ਕੋਈ ॥",
      "transliteration": "aan na deesai koee ||",
      "translation": "I do not see any other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਠਾਕੁਰੁ ਮੇਰਾ ਸੁਘੜੁ ਸੁਜਾਨਾ ॥",
      "transliteration": "thaakur meraa sughaR sujaanaa ||",
      "translation": "My Lord and Master is wise and all-knowing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਮਿਲਿਆ ਰੰਗੁ ਮਾਨਾ ॥੧॥",
      "transliteration": "guramukh miliaa ra(n)g maanaa ||1||",
      "translation": "Meeting with the Gurmukh, I enjoy His Love. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਐਸੋ ਰੇ ਹਰਿ ਰਸੁ ਮੀਠਾ ॥",
      "transliteration": "aiso re har ras meethaa ||",
      "translation": "Such is the sweet, subtle essence of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਕਿਨੈ ਵਿਰਲੈ ਡੀਠਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "guramukh kinai viralai deethaa ||1|| rahaau ||",
      "translation": "How rare are those who, as Gurmukh, taste it. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0886_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨਿਰਮਲ ਜੋਤਿ ਅੰਮ੍ਰਿਤੁ ਹਰਿ ਨਾਮ ॥",
      "transliteration": "niramal jot a(n)mrit har naam ||",
      "translation": "The Light of the Ambrosial Name of the Lord is immaculate and pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 886,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
