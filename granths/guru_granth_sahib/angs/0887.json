{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 887,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0887_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪੀਵਤ ਅਮਰ ਭਏ ਨਿਹਕਾਮ ॥",
      "transliteration": "peevat amar bhae nihakaam ||",
      "translation": "Drinking it in, one becomes immortal and free of desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਸੀਤਲੁ ਅਗਨਿ ਨਿਵਾਰੀ ॥",
      "transliteration": "tan man seetal agan nivaaree ||",
      "translation": "The body and mind are cooled and soothed, and the fire is extinguished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਨਦ ਰੂਪ ਪ੍ਰਗਟੇ ਸੰਸਾਰੀ ॥੨॥",
      "transliteration": "anad roop pragate sa(n)saaree ||2||",
      "translation": "Such a being is the embodiment of bliss, famous throughout the world. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿਆ ਦੇਵਉ ਜਾ ਸਭੁ ਕਿਛੁ ਤੇਰਾ ॥",
      "transliteration": "kiaa devau jaa sabh kichh teraa ||",
      "translation": "What can I offer You, Lord? Everything belongs to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਦ ਬਲਿਹਾਰਿ ਜਾਉ ਲਖ ਬੇਰਾ ॥",
      "transliteration": "sad balihaar jaau lakh beraa ||",
      "translation": "I am forever a sacrifice to You, hundreds of thousands of times.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਜੀਉ ਪਿੰਡੁ ਦੇ ਸਾਜਿਆ ॥",
      "transliteration": "tan man jeeu pi(n)d de saajiaa ||",
      "translation": "You blessed me, and fashioned my body, mind and soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਨੀਚੁ ਨਿਵਾਜਿਆ ॥੩॥",
      "transliteration": "gur kirapaa te neech nivaajiaa ||3||",
      "translation": "By Guru's Grace, this lowly being was exalted. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਖੋਲਿ ਕਿਵਾਰਾ ਮਹਲਿ ਬੁਲਾਇਆ ॥",
      "transliteration": "khol kivaaraa mahal bulaaiaa ||",
      "translation": "Opening the door, You summoned me to the Mansion of Your Presence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੈਸਾ ਸਾ ਤੈਸਾ ਦਿਖਲਾਇਆ ॥",
      "transliteration": "jaisaa saa taisaa dikhalaaiaa ||",
      "translation": "As You are, so You have revealed Yourself to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਸਭੁ ਪੜਦਾ ਤੂਟਾ ॥",
      "transliteration": "kahu naanak sabh paRadaa tootaa ||",
      "translation": "Says Nanak, the screen is totally torn away;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਉ ਤੇਰਾ ਤੂ ਮੈ ਮਨਿ ਵੂਠਾ ॥੪॥੩॥੧੪॥",
      "transliteration": "hau teraa too mai man voothaa ||4||3||14||",
      "translation": "I am Yours, and You are enshrined within my mind. ||4||3||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੇਵਕੁ ਲਾਇਓ ਅਪੁਨੀ ਸੇਵ ॥",
      "transliteration": "sevak laaio apunee sev ||",
      "translation": "He has linked His servant to His service.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਨਾਮੁ ਦੀਓ ਮੁਖਿ ਦੇਵ ॥",
      "transliteration": "a(n)mrit naam deeo mukh dev ||",
      "translation": "The Divine Guru has poured the Ambrosial Naam, the Name of the Lord, into his mouth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਗਲੀ ਚਿੰਤਾ ਆਪਿ ਨਿਵਾਰੀ ॥",
      "transliteration": "sagalee chi(n)taa aap nivaaree ||",
      "translation": "He has subdued all his anxiety.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਿਸੁ ਗੁਰ ਕਉ ਹਉ ਸਦ ਬਲਿਹਾਰੀ ॥੧॥",
      "transliteration": "tis gur kau hau sad balihaaree ||1||",
      "translation": "I am forever a sacrifice to that Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਾਜ ਹਮਾਰੇ ਪੂਰੇ ਸਤਗੁਰ ॥",
      "transliteration": "kaaj hamaare poore satagur ||",
      "translation": "The True Guru has perfectly resolved my affairs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਾਜੇ ਅਨਹਦ ਤੂਰੇ ਸਤਗੁਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "baaje anahad toore satagur ||1|| rahaau ||",
      "translation": "The True Guru vibrates the unstruck melody of the sound current. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਹਿਮਾ ਜਾ ਕੀ ਗਹਿਰ ਗੰਭੀਰ ॥",
      "transliteration": "mahimaa jaa kee gahir ga(n)bheer ||",
      "translation": "His Glory is profound and unfathomable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹੋਇ ਨਿਹਾਲੁ ਦੇਇ ਜਿਸੁ ਧੀਰ ॥",
      "transliteration": "hoi nihaal dei jis dheer ||",
      "translation": "One whom He blesses with patience becomes blissful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾ ਕੇ ਬੰਧਨ ਕਾਟੇ ਰਾਇ ॥",
      "transliteration": "jaa ke ba(n)dhan kaate raai ||",
      "translation": "One whose bonds are shattered by the Sovereign Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੋ ਨਰੁ ਬਹੁਰਿ ਨ ਜੋਨੀ ਪਾਇ ॥੨॥",
      "transliteration": "so nar bahur na jonee paai ||2||",
      "translation": "is not cast into the womb of reincarnation again. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾ ਕੈ ਅੰਤਰਿ ਪ੍ਰਗਟਿਓ ਆਪ ॥",
      "transliteration": "jaa kai a(n)tar pragatio aap ||",
      "translation": "One who is illuminated by the Lord's radiance within,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਾ ਕਉ ਨਾਹੀ ਦੂਖ ਸੰਤਾਪ ॥",
      "transliteration": "taa kau naahee dookh sa(n)taap ||",
      "translation": "is not touched by pain and sorrow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਲਾਲੁ ਰਤਨੁ ਤਿਸੁ ਪਾਲੈ ਪਰਿਆ ॥",
      "transliteration": "laal ratan tis paalai pariaa ||",
      "translation": "He holds in his robe the gems and jewels.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਗਲ ਕੁਟੰਬ ਓਹੁ ਜਨੁ ਲੈ ਤਰਿਆ ॥੩॥",
      "transliteration": "sagal kuta(n)b ohu jan lai tariaa ||3||",
      "translation": "That humble being is saved, along with all his generations. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾ ਕਿਛੁ ਭਰਮੁ ਨ ਦੁਬਿਧਾ ਦੂਜਾ ॥",
      "transliteration": "naa kichh bharam na dubidhaa doojaa ||",
      "translation": "He has no doubt, double-mindedness or duality at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਏਕੋ ਏਕੁ ਨਿਰੰਜਨ ਪੂਜਾ ॥",
      "transliteration": "eko ek nira(n)jan poojaa ||",
      "translation": "He worships and adores the One Immaculate Lord alone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਤ ਕਤ ਦੇਖਉ ਆਪਿ ਦਇਆਲ ॥",
      "transliteration": "jat kat dekhau aap daiaal ||",
      "translation": "Wherever I look, I see the Merciful Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਪ੍ਰਭ ਮਿਲੇ ਰਸਾਲ ॥੪॥੪॥੧੫॥",
      "transliteration": "kahu naanak prabh mile rasaal ||4||4||15||",
      "translation": "Says Nanak, I have found God, the source of nectar. ||4||4||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਨ ਤੇ ਛੁਟਕੀ ਅਪਨੀ ਧਾਰੀ ॥",
      "transliteration": "tan te chhutakee apanee dhaaree ||",
      "translation": "My self-conceit has been eliminated from my body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਆਗਿਆ ਲਗੀ ਪਿਆਰੀ ॥",
      "transliteration": "prabh kee aagiaa lagee piaaree ||",
      "translation": "The Will of God is dear to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕਰੈ ਸੁ ਮਨਿ ਮੇਰੈ ਮੀਠਾ ॥",
      "transliteration": "jo kichh karai s man merai meethaa ||",
      "translation": "Whatever He does, seems sweet to my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਾ ਇਹੁ ਅਚਰਜੁ ਨੈਨਹੁ ਡੀਠਾ ॥੧॥",
      "transliteration": "taa ihu acharaj nainahu deethaa ||1||",
      "translation": "And then, these eyes behold the wondrous Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਬ ਮੋਹਿ ਜਾਨੀ ਰੇ ਮੇਰੀ ਗਈ ਬਲਾਇ ॥",
      "transliteration": "ab mohi jaanee re meree gaee balaai ||",
      "translation": "Now, I have become wise and my demons are gone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬੁਝਿ ਗਈ ਤ੍ਰਿਸਨ ਨਿਵਾਰੀ ਮਮਤਾ ਗੁਰਿ ਪੂਰੈ ਲੀਓ ਸਮਝਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bujh gaee trisan nivaaree mamataa gur poorai leeo samajhaai ||1|| rahaau ||",
      "translation": "My thirst is quenched, and my attachment is dispelled. The Perfect Guru has instructed me. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਰਾਖਿਓ ਗੁਰਿ ਸਰਨਾ ॥",
      "transliteration": "kar kirapaa raakhio gur saranaa ||",
      "translation": "In His Mercy, the Guru has kept me under His protection.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰਿ ਪਕਰਾਏ ਹਰਿ ਕੇ ਚਰਨਾ ॥",
      "transliteration": "gur pakaraae har ke charanaa ||",
      "translation": "The Guru has attached me to the Lord's Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬੀਸ ਬਿਸੁਏ ਜਾ ਮਨ ਠਹਰਾਨੇ ॥",
      "transliteration": "bees bisue jaa man thaharaane ||",
      "translation": "When the mind is totally held in check,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੁਰ ਪਾਰਬ੍ਰਹਮ ਏਕੈ ਹੀ ਜਾਨੇ ॥੨॥",
      "transliteration": "gur paarabraham ekai hee jaane ||2||",
      "translation": "one sees the Guru and the Supreme Lord God as one and the same. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੋ ਜੋ ਕੀਨੋ ਹਮ ਤਿਸ ਕੇ ਦਾਸ ॥",
      "transliteration": "jo jo keeno ham tis ke daas ||",
      "translation": "Whoever You have created, I am his slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪ੍ਰਭ ਮੇਰੇ ਕੋ ਸਗਲ ਨਿਵਾਸ ॥",
      "transliteration": "prabh mere ko sagal nivaas ||",
      "translation": "My God dwells in all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾ ਕੋ ਦੂਤੁ ਨਹੀ ਬੈਰਾਈ ॥",
      "transliteration": "naa ko doot nahee bairaaee ||",
      "translation": "I have no enemies, no adversaries.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਲਿ ਮਿਲਿ ਚਾਲੇ ਏਕੈ ਭਾਈ ॥੩॥",
      "transliteration": "gal mil chaale ekai bhaaee ||3||",
      "translation": "I walk arm in arm, like brothers, with all. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਾ ਕਉ ਗੁਰਿ ਹਰਿ ਦੀਏ ਸੂਖਾ ॥",
      "transliteration": "jaa kau gur har deee sookhaa ||",
      "translation": "One whom the Guru, the Lord, blesses with peace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਾ ਕਉ ਬਹੁਰਿ ਨ ਲਾਗਹਿ ਦੂਖਾ ॥",
      "transliteration": "taa kau bahur na laagahi dookhaa ||",
      "translation": "does not suffer in pain any longer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਆਪੇ ਆਪਿ ਸਰਬ ਪ੍ਰਤਿਪਾਲ ॥",
      "transliteration": "aape aap sarab pratipaal ||",
      "translation": "He Himself cherishes all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਨਕ ਰਾਤਉ ਰੰਗਿ ਗੋਪਾਲ ॥੪॥੫॥੧੬॥",
      "transliteration": "naanak raatau ra(n)g gopaal ||4||5||16||",
      "translation": "Nanak is imbued with the love of the Lord of the World. ||4||5||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮੁਖ ਤੇ ਪੜਤਾ ਟੀਕਾ ਸਹਿਤ ॥",
      "transliteration": "mukh te paRataa teekaa sahit ||",
      "translation": "You read the scriptures, and the commentaries,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਹਿਰਦੈ ਰਾਮੁ ਨਹੀ ਪੂਰਨ ਰਹਤ ॥",
      "transliteration": "hiradai raam nahee pooran rahat ||",
      "translation": "but the Perfect Lord does not dwell in your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਉਪਦੇਸੁ ਕਰੇ ਕਰਿ ਲੋਕ ਦ੍ਰਿੜਾਵੈ ॥",
      "transliteration": "upades kare kar lok driRaavai ||",
      "translation": "You preach to others to have faith,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਅਪਨਾ ਕਹਿਆ ਆਪਿ ਨ ਕਮਾਵੈ ॥੧॥",
      "transliteration": "apanaa kahiaa aap na kamaavai ||1||",
      "translation": "but you do not practice what you preach. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪੰਡਿਤ ਬੇਦੁ ਬੀਚਾਰਿ ਪੰਡਿਤ ॥",
      "transliteration": "pa(n)dit bed beechaar pa(n)dit ||",
      "translation": "O Pandit, O religious scholar, contemplate the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਮਨ ਕਾ ਕ੍ਰੋਧੁ ਨਿਵਾਰਿ ਪੰਡਿਤ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "man kaa krodh nivaar pa(n)dit ||1|| rahaau ||",
      "translation": "Eradicate anger from your mind, O Pandit. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0887_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਆਗੈ ਰਾਖਿਓ ਸਾਲ ਗਿਰਾਮੁ ॥",
      "transliteration": "aagai raakhio saal giraam ||",
      "translation": "You place your stone god before yourself,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 887,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
