{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 888,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0888_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਨੁ ਕੀਨੋ ਦਹ ਦਿਸ ਬਿਸ੍ਰਾਮੁ ॥",
      "transliteration": "man keeno dah dis bisraam ||",
      "translation": "but your mind wanders in the ten directions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਿਲਕੁ ਚਰਾਵੈ ਪਾਈ ਪਾਇ ॥",
      "transliteration": "tilak charaavai paaee paai ||",
      "translation": "You apply a ceremonial tilak mark to its forehead, and fall at its feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਲੋਕ ਪਚਾਰਾ ਅੰਧੁ ਕਮਾਇ ॥੨॥",
      "transliteration": "lok pachaaraa a(n)dh kamaai ||2||",
      "translation": "You try to appease the people, and act blindly. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਖਟੁ ਕਰਮਾ ਅਰੁ ਆਸਣੁ ਧੋਤੀ ॥",
      "transliteration": "khat karamaa ar aasan dhotee ||",
      "translation": "You perform the six religious rituals, and sit wearing your loin-cloth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਾਗਠਿ ਗ੍ਰਿਹਿ ਪੜੈ ਨਿਤ ਪੋਥੀ ॥",
      "transliteration": "bhaagath grihi paRai nit pothee ||",
      "translation": "In the homes of the wealthy, you read the prayer book.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮਾਲਾ ਫੇਰੈ ਮੰਗੈ ਬਿਭੂਤ ॥",
      "transliteration": "maalaa pherai ma(n)gai bibhoot ||",
      "translation": "You chant on your mala, and beg for money.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਕੋਇ ਨ ਤਰਿਓ ਮੀਤ ॥੩॥",
      "transliteration": "ih bidh koi na tario meet ||3||",
      "translation": "No one has ever been saved in this way, friend. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੋ ਪੰਡਿਤੁ ਗੁਰਸਬਦੁ ਕਮਾਇ ॥",
      "transliteration": "so pa(n)dit gurasabad kamaai ||",
      "translation": "He alone is a Pandit, who lives the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤ੍ਰੈ ਗੁਣ ਕੀ ਓਸੁ ਉਤਰੀ ਮਾਇ ॥",
      "transliteration": "trai gun kee os utaree maai ||",
      "translation": "Maya, of the three qualities, leaves him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚਤੁਰ ਬੇਦ ਪੂਰਨ ਹਰਿ ਨਾਇ ॥",
      "transliteration": "chatur bed pooran har naai ||",
      "translation": "The four Vedas are completely contained within the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਨਕ ਤਿਸ ਕੀ ਸਰਣੀ ਪਾਇ ॥੪॥੬॥੧੭॥",
      "transliteration": "naanak tis kee saranee paai ||4||6||17||",
      "translation": "Nanak seeks His Sanctuary. ||4||6||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕੋਟਿ ਬਿਘਨ ਨਹੀ ਆਵਹਿ ਨੇਰਿ ॥",
      "transliteration": "kot bighan nahee aavahi ner ||",
      "translation": "Millions of troubles do not come near him;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਨਿਕ ਮਾਇਆ ਹੈ ਤਾ ਕੀ ਚੇਰਿ ॥",
      "transliteration": "anik maaiaa hai taa kee cher ||",
      "translation": "the many manifestations of Maya are his hand-maidens;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਨਿਕ ਪਾਪ ਤਾ ਕੇ ਪਾਨੀਹਾਰ ॥",
      "transliteration": "anik paap taa ke paaneehaar ||",
      "translation": "countless sins are his water-carriers;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾ ਕਉ ਮਇਆ ਭਈ ਕਰਤਾਰ ॥੧॥",
      "transliteration": "jaa kau maiaa bhaee karataar ||1||",
      "translation": "he is blessed with the Grace of the Creator Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਸਹਿ ਸਹਾਈ ਹੋਇ ਭਗਵਾਨ ॥",
      "transliteration": "jisahi sahaaee hoi bhagavaan ||",
      "translation": "One who has the Lord God as his help and support",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਨਿਕ ਜਤਨ ਉਆ ਕੈ ਸਰੰਜਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "anik jatan uaa kai sara(n)jaam ||1|| rahaau ||",
      "translation": "- all his efforts are fulfilled. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਰਤਾ ਰਾਖੈ ਕੀਤਾ ਕਉਨੁ ॥",
      "transliteration": "karataa raakhai keetaa kaun ||",
      "translation": "He is protected by the Creator Lord; what harm can anyone do to him?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕੀਰੀ ਜੀਤੋ ਸਗਲਾ ਭਵਨੁ ॥",
      "transliteration": "keeree jeeto sagalaa bhavan ||",
      "translation": "Even an ant can conquer the whole world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬੇਅੰਤ ਮਹਿਮਾ ਤਾ ਕੀ ਕੇਤਕ ਬਰਨ ॥",
      "transliteration": "bea(n)t mahimaa taa kee ketak baran ||",
      "translation": "His glory is endless; how can I describe it?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਲਿ ਬਲਿ ਜਾਈਐ ਤਾ ਕੇ ਚਰਨ ॥੨॥",
      "transliteration": "bal bal jaaeeai taa ke charan ||2||",
      "translation": "I am a sacrifice, a devoted sacrifice, to His feet. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਿਨ ਹੀ ਕੀਆ ਜਪੁ ਤਪੁ ਧਿਆਨੁ ॥",
      "transliteration": "tin hee keeaa jap tap dhiaan ||",
      "translation": "He alone performs worship, austerities and meditation;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਨਿਕ ਪ੍ਰਕਾਰ ਕੀਆ ਤਿਨਿ ਦਾਨੁ ॥",
      "transliteration": "anik prakaar keeaa tin daan ||",
      "translation": "he alone is a giver to various charities;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭਗਤੁ ਸੋਈ ਕਲਿ ਮਹਿ ਪਰਵਾਨੁ ॥",
      "transliteration": "bhagat soee kal mahi paravaan ||",
      "translation": "he alone is approved in this Dark Age of Kali Yuga,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾ ਕਉ ਠਾਕੁਰਿ ਦੀਆ ਮਾਨੁ ॥੩॥",
      "transliteration": "jaa kau thaakur deeaa maan ||3||",
      "translation": "whom the Lord Master blesses with honor. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਮਿਲਿ ਭਏ ਪ੍ਰਗਾਸ ॥",
      "transliteration": "saadhasa(n)g mil bhae pragaas ||",
      "translation": "Joining the Saadh Sangat, the Company of the Holy, I am enlightened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਹਜ ਸੂਖ ਆਸ ਨਿਵਾਸ ॥",
      "transliteration": "sahaj sookh aas nivaas ||",
      "translation": "I have found celestial peace, and my hopes are fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪੂਰੈ ਸਤਿਗੁਰਿ ਦੀਆ ਬਿਸਾਸ ॥",
      "transliteration": "poorai satigur deeaa bisaas ||",
      "translation": "The Perfect True Guru has blessed me with faith.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਾਨਕ ਹੋਏ ਦਾਸਨਿ ਦਾਸ ॥੪॥੭॥੧੮॥",
      "transliteration": "naanak hoe daasan daas ||4||7||18||",
      "translation": "Nanak is the slave of His slaves. ||4||7||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੋਸੁ ਨ ਦੀਜੈ ਕਾਹੂ ਲੋਗ ॥",
      "transliteration": "dos na deejai kaahoo log ||",
      "translation": "Don't blame others, O people;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜੋ ਕਮਾਵਨੁ ਸੋਈ ਭੋਗ ॥",
      "transliteration": "jo kamaavan soee bhog ||",
      "translation": "as you plant, so shall you harvest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਪਨ ਕਰਮ ਆਪੇ ਹੀ ਬੰਧ ॥",
      "transliteration": "aapan karam aape hee ba(n)dh ||",
      "translation": "By your actions, you have bound yourself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਵਨੁ ਜਾਵਨੁ ਮਾਇਆ ਧੰਧ ॥੧॥",
      "transliteration": "aavan jaavan maaiaa dha(n)dh ||1||",
      "translation": "You come and go, entangled in Maya. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਐਸੀ ਜਾਨੀ ਸੰਤ ਜਨੀ ॥",
      "transliteration": "aisee jaanee sa(n)t janee ||",
      "translation": "Such is the understanding of the Saintly people.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਰਗਾਸੁ ਭਇਆ ਪੂਰੇ ਗੁਰ ਬਚਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "paragaas bhaiaa poore gur bachanee ||1|| rahaau ||",
      "translation": "You shall be enlightened, through the Word of the Perfect Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਨੁ ਧਨੁ ਕਲਤੁ ਮਿਥਿਆ ਬਿਸਥਾਰ ॥",
      "transliteration": "tan dhan kalat mithiaa bisathaar ||",
      "translation": "Body, wealth, spouse and ostentatious displays are false.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹੈਵਰ ਗੈਵਰ ਚਾਲਨਹਾਰ ॥",
      "transliteration": "haivar gaivar chaalanahaar ||",
      "translation": "Horses and elephants will pass away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਾਜ ਰੰਗ ਰੂਪ ਸਭਿ ਕੂਰ ॥",
      "transliteration": "raaj ra(n)g roop sabh koor ||",
      "translation": "Power, pleasures and beauty are all false.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਹੋਇ ਜਾਸੀ ਧੂਰ ॥੨॥",
      "transliteration": "naam binaa hoi jaasee dhoor ||2||",
      "translation": "Without the Naam, the Name of the Lord, everything is reduced to dust. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਰਮਿ ਭੂਲੇ ਬਾਦਿ ਅਹੰਕਾਰੀ ॥",
      "transliteration": "bharam bhoole baad aha(n)kaaree ||",
      "translation": "The egotistical people are deluded by useless doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੰਗਿ ਨਾਹੀ ਰੇ ਸਗਲ ਪਸਾਰੀ ॥",
      "transliteration": "sa(n)g naahee re sagal pasaaree ||",
      "translation": "Of all this expanse, nothing shall go along with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੋਗ ਹਰਖ ਮਹਿ ਦੇਹ ਬਿਰਧਾਨੀ ॥",
      "transliteration": "sog harakh mahi deh biradhaanee ||",
      "translation": "Through pleasure and pain, the body is growing old.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਾਕਤ ਇਵ ਹੀ ਕਰਤ ਬਿਹਾਨੀ ॥੩॥",
      "transliteration": "saakat iv hee karat bihaanee ||3||",
      "translation": "Doing these things, the faithless cynics are passing their lives. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਅੰਮ੍ਰਿਤੁ ਕਲਿ ਮਾਹਿ ॥",
      "transliteration": "har kaa naam a(n)mrit kal maahi ||",
      "translation": "The Name of the Lord is Ambrosial Nectar in this Dark Age of Kali Yuga.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਏਹੁ ਨਿਧਾਨਾ ਸਾਧੂ ਪਾਹਿ ॥",
      "transliteration": "ehu nidhaanaa saadhoo paahi ||",
      "translation": "This treasure is obtained from the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਨਕ ਗੁਰੁ ਗੋਵਿਦੁ ਜਿਸੁ ਤੂਠਾ ॥",
      "transliteration": "naanak gur govid jis toothaa ||",
      "translation": "O Nanak, whoever pleases the Guru,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਰਮਈਆ ਤਿਨ ਹੀ ਡੀਠਾ ॥੪॥੮॥੧੯॥",
      "transliteration": "ghat ghat ramaeeaa tin hee deethaa ||4||8||19||",
      "translation": "the Lord of the Universe, beholds the Lord in each and every heart. ||4||8||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪੰਚ ਸਬਦ ਤਹ ਪੂਰਨ ਨਾਦ ॥",
      "transliteration": "pa(n)ch sabad tah pooran naad ||",
      "translation": "The Panch Shabad, the five primal sounds, echo the perfect sound current of the Naad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਨਹਦ ਬਾਜੇ ਅਚਰਜ ਬਿਸਮਾਦ ॥",
      "transliteration": "anahad baaje acharaj bisamaad ||",
      "translation": "The wondrous, amazing unstruck melody vibrates.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕੇਲ ਕਰਹਿ ਸੰਤ ਹਰਿ ਲੋਗ ॥",
      "transliteration": "kel karahi sa(n)t har log ||",
      "translation": "The Saintly people play there with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਪੂਰਨ ਨਿਰਜੋਗ ॥੧॥",
      "transliteration": "paarabraham pooran nirajog ||1||",
      "translation": "They remain totally detached, absorbed in the Supreme Lord God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਆਨੰਦ ਭਵਨ ॥",
      "transliteration": "sookh sahaj aana(n)d bhavan ||",
      "translation": "It is the realm of celestial peace and bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਬੈਸਿ ਗੁਣ ਗਾਵਹਿ ਤਹ ਰੋਗ ਸੋਗ ਨਹੀ ਜਨਮ ਮਰਨ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saadhasa(n)g bais gun gaavahi tah rog sog nahee janam maran ||1|| rahaau ||",
      "translation": "The Saadh Sangat, the Company of the Holy, sits and sings the Glorious Praises of the Lord. There is no disease or sorrow there, no birth or death. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਊਹਾ ਸਿਮਰਹਿ ਕੇਵਲ ਨਾਮੁ ॥",
      "transliteration": "oohaa simarahi keval naam ||",
      "translation": "There, they meditate only on the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਬਿਰਲੇ ਪਾਵਹਿ ਓਹੁ ਬਿਸ੍ਰਾਮੁ ॥",
      "transliteration": "birale paavahi ohu bisraam ||",
      "translation": "How rare are those who find this place of rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0888_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਭੋਜਨੁ ਭਾਉ ਕੀਰਤਨ ਆਧਾਰੁ ॥",
      "transliteration": "bhojan bhaau keeratan aadhaar ||",
      "translation": "The love of God is their food, and the Kirtan of the Lord's Praise is their support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 888,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
