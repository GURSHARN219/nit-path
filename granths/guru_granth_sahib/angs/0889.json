{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 889,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0889_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਿਹਚਲ ਆਸਨੁ ਬੇਸੁਮਾਰੁ ॥੨॥",
      "transliteration": "nihachal aasan besumaar ||2||",
      "translation": "They obtain a permanent seat in the infinite. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਡਿਗਿ ਨ ਡੋਲੈ ਕਤਹੂ ਨ ਧਾਵੈ ॥",
      "transliteration": "dig na dolai katahoo na dhaavai ||",
      "translation": "No one falls there, or wavers, or goes anywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਕੋ ਇਹੁ ਮਹਲੁ ਪਾਵੈ ॥",
      "transliteration": "gur prasaad ko ihu mahal paavai ||",
      "translation": "By Guru's Grace, some find this mansion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭ੍ਰਮ ਭੈ ਮੋਹ ਨ ਮਾਇਆ ਜਾਲ ॥",
      "transliteration": "bhram bhai moh na maaiaa jaal ||",
      "translation": "They are not touched by doubt, fear, attachment or the traps of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੁੰਨ ਸਮਾਧਿ ਪ੍ਰਭੂ ਕਿਰਪਾਲ ॥੩॥",
      "transliteration": "su(n)n samaadh prabhoo kirapaal ||3||",
      "translation": "They enter the deepest state of Samaadhi, through the kind mercy of God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਾ ਕਾ ਅੰਤੁ ਨ ਪਾਰਾਵਾਰੁ ॥",
      "transliteration": "taa kaa a(n)t na paaraavaar ||",
      "translation": "He has no end or limitation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਪੇ ਗੁਪਤੁ ਆਪੇ ਪਾਸਾਰੁ ॥",
      "transliteration": "aape gupat aape paasaar ||",
      "translation": "He Himself is unmanifest, and He Himself is manifest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਾ ਕੈ ਅੰਤਰਿ ਹਰਿ ਹਰਿ ਸੁਆਦੁ ॥",
      "transliteration": "jaa kai a(n)tar har har suaad ||",
      "translation": "One who enjoys the taste of the Lord, Har, Har, deep within himself,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਹਨੁ ਨ ਜਾਈ ਨਾਨਕ ਬਿਸਮਾਦੁ ॥੪॥੯॥੨੦॥",
      "transliteration": "kahan na jaaee naanak bisamaad ||4||9||20||",
      "translation": "O Nanak, his wondrous state cannot be described. ||4||9||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭੇਟਤ ਸੰਗਿ ਪਾਰਬ੍ਰਹਮੁ ਚਿਤਿ ਆਇਆ ॥",
      "transliteration": "bhetat sa(n)g paarabraham chit aaiaa ||",
      "translation": "Meeting with the Sangat, the Congregation, the Supreme Lord God has come into my consciousness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੰਗਤਿ ਕਰਤ ਸੰਤੋਖੁ ਮਨਿ ਪਾਇਆ ॥",
      "transliteration": "sa(n)gat karat sa(n)tokh man paaiaa ||",
      "translation": "In the Sangat, my mind has found contentment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੰਤਹ ਚਰਨ ਮਾਥਾ ਮੇਰੋ ਪਉਤ ॥",
      "transliteration": "sa(n)tah charan maathaa mero paut ||",
      "translation": "I touch my forehead to the feet of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਨਿਕ ਬਾਰ ਸੰਤਹ ਡੰਡਉਤ ॥੧॥",
      "transliteration": "anik baar sa(n)tah da(n)daut ||1||",
      "translation": "Countless times, I humbly bow to the Saints. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਸੰਤਨ ਕੈ ਬਲਿਹਾਰੀ ॥",
      "transliteration": "ihu man sa(n)tan kai balihaaree ||",
      "translation": "This mind is a sacrifice to the Saints;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾ ਕੀ ਓਟ ਗਹੀ ਸੁਖੁ ਪਾਇਆ ਰਾਖੇ ਕਿਰਪਾ ਧਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaa kee ot gahee sukh paaiaa raakhe kirapaa dhaaree ||1|| rahaau ||",
      "translation": "holding tight to their support, I have found peace, and in their mercy, they have protected me. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੰਤਹ ਚਰਣ ਧੋਇ ਧੋਇ ਪੀਵਾ ॥",
      "transliteration": "sa(n)tah charan dhoi dhoi peevaa ||",
      "translation": "I wash the feet of the Saints, and drink in that water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੰਤਹ ਦਰਸੁ ਪੇਖਿ ਪੇਖਿ ਜੀਵਾ ॥",
      "transliteration": "sa(n)tah daras pekh pekh jeevaa ||",
      "translation": "Gazing upon the Blessed Vision of the Saints' Darshan, I live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੰਤਹ ਕੀ ਮੇਰੈ ਮਨਿ ਆਸ ॥",
      "transliteration": "sa(n)tah kee merai man aas ||",
      "translation": "My mind rests its hopes in the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੰਤ ਹਮਾਰੀ ਨਿਰਮਲ ਰਾਸਿ ॥੨॥",
      "transliteration": "sa(n)t hamaaree niramal raas ||2||",
      "translation": "The Saints are my immaculate wealth. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੰਤ ਹਮਾਰਾ ਰਾਖਿਆ ਪੜਦਾ ॥",
      "transliteration": "sa(n)t hamaaraa raakhiaa paRadaa ||",
      "translation": "The Saints have covered my faults.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਮੋਹਿ ਕਬਹੂ ਨ ਕੜਦਾ ॥",
      "transliteration": "sa(n)t prasaad mohi kabahoo na kaRadaa ||",
      "translation": "By the Grace of the Saints, I am no longer tormented.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੰਤਹ ਸੰਗੁ ਦੀਆ ਕਿਰਪਾਲ ॥",
      "transliteration": "sa(n)tah sa(n)g deeaa kirapaal ||",
      "translation": "The Merciful Lord has blessed me with the Saints' Congregation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੰਤ ਸਹਾਈ ਭਏ ਦਇਆਲ ॥੩॥",
      "transliteration": "sa(n)t sahaaee bhae daiaal ||3||",
      "translation": "The Compassionate Saints have become my help and support. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁਰਤਿ ਮਤਿ ਬੁਧਿ ਪਰਗਾਸੁ ॥",
      "transliteration": "surat mat budh paragaas ||",
      "translation": "My consciousness, intellect and wisdom have been enlightened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗਹਿਰ ਗੰਭੀਰ ਅਪਾਰ ਗੁਣਤਾਸੁ ॥",
      "transliteration": "gahir ga(n)bheer apaar gunataas ||",
      "translation": "The Lord is profound, unfathomable, infinite, the treasure of virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਸਗਲੇ ਪ੍ਰਤਿਪਾਲ ॥",
      "transliteration": "jee ja(n)t sagale pratipaal ||",
      "translation": "He cherishes all beings and creatures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਸੰਤਹ ਦੇਖਿ ਨਿਹਾਲ ॥੪॥੧੦॥੨੧॥",
      "transliteration": "naanak sa(n)tah dekh nihaal ||4||10||21||",
      "translation": "Nanak is enraptured, seeing the Saints. ||4||10||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੇਰੈ ਕਾਜਿ ਨ ਗ੍ਰਿਹੁ ਰਾਜੁ ਮਾਲੁ ॥",
      "transliteration": "terai kaaj na grihu raaj maal ||",
      "translation": "Your home, power and wealth will be of no use to you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤੇਰੈ ਕਾਜਿ ਨ ਬਿਖੈ ਜੰਜਾਲੁ ॥",
      "transliteration": "terai kaaj na bikhai ja(n)jaal ||",
      "translation": "Your corrupt worldly entanglements will be of no use to you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਸਟ ਮੀਤ ਜਾਣੁ ਸਭ ਛਲੈ ॥",
      "transliteration": "isat meet jaan sabh chhalai ||",
      "translation": "Know that all your dear friends are fake.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਸੰਗਿ ਤੇਰੈ ਚਲੈ ॥੧॥",
      "transliteration": "har har naam sa(n)g terai chalai ||1||",
      "translation": "Only the Name of the Lord, Har, Har, will go along with you. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਗੁਣ ਗਾਇ ਲੇ ਮੀਤਾ ਹਰਿ ਸਿਮਰਤ ਤੇਰੀ ਲਾਜ ਰਹੈ ॥",
      "transliteration": "raam naam gun gaai le meetaa har simarat teree laaj rahai ||",
      "translation": "Sing the Glorious Praises of the Lord's Name, O friend; remembering the Lord in meditation, your honor shall be saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਜਮੁ ਕਛੁ ਨ ਕਹੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har simarat jam kachh na kahai ||1|| rahaau ||",
      "translation": "Remembering the Lord in meditation, the Messenger of Death will not touch you. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਸਗਲ ਨਿਰਾਰਥ ਕਾਮ ॥",
      "transliteration": "bin har sagal niraarath kaam ||",
      "translation": "Without the Lord, all pursuits are useless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਇਨਾ ਰੁਪਾ ਮਾਟੀ ਦਾਮ ॥",
      "transliteration": "suinaa rupaa maatee daam ||",
      "translation": "Gold, silver and wealth are just dust.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਜਾਪਿ ਮਨ ਸੁਖਾ ॥",
      "transliteration": "gur kaa sabad jaap man sukhaa ||",
      "translation": "Chanting the Word of the Guru's Shabad, your mind shall be at peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਈਹਾ ਊਹਾ ਤੇਰੋ ਊਜਲ ਮੁਖਾ ॥੨॥",
      "transliteration": "eehaa oohaa tero oojal mukhaa ||2||",
      "translation": "Here and hereafter, your face shall be radiant and bright. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਰਿ ਕਰਿ ਥਾਕੇ ਵਡੇ ਵਡੇਰੇ ॥",
      "transliteration": "kar kar thaake vade vadere ||",
      "translation": "Even the greatest of the great worked and worked until they were exhausted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਿਨ ਹੀ ਨ ਕੀਏ ਕਾਜ ਮਾਇਆ ਪੂਰੇ ॥",
      "transliteration": "kin hee na keee kaaj maaiaa poore ||",
      "translation": "None of them ever accomplished the tasks of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਪੈ ਜਨੁ ਕੋਇ ॥",
      "transliteration": "har har naam japai jan koi ||",
      "translation": "Any humble being who chants the Name of the Lord, Har, Har,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਾ ਕੀ ਆਸਾ ਪੂਰਨ ਹੋਇ ॥੩॥",
      "transliteration": "taa kee aasaa pooran hoi ||3||",
      "translation": "will have all his hopes fulfilled. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਰਿ ਭਗਤਨ ਕੋ ਨਾਮੁ ਅਧਾਰੁ ॥",
      "transliteration": "har bhagatan ko naam adhaar ||",
      "translation": "The Naam, the Name of the Lord, is the anchor and support of the Lord's devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੰਤੀ ਜੀਤਾ ਜਨਮੁ ਅਪਾਰੁ ॥",
      "transliteration": "sa(n)tee jeetaa janam apaar ||",
      "translation": "The Saints are victorious in this priceless human life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਰਿ ਸੰਤੁ ਕਰੇ ਸੋਈ ਪਰਵਾਣੁ ॥",
      "transliteration": "har sa(n)t kare soee paravaan ||",
      "translation": "Whatever the Lord's Saint does, is approved and accepted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਨਕ ਦਾਸੁ ਤਾ ਕੈ ਕੁਰਬਾਣੁ ॥੪॥੧੧॥੨੨॥",
      "transliteration": "naanak daas taa kai kurabaan ||4||11||22||",
      "translation": "Slave Nanak is a sacrifice to him. ||4||11||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਿੰਚਹਿ ਦਰਬੁ ਦੇਹਿ ਦੁਖੁ ਲੋਗ ॥",
      "transliteration": "si(n)chahi darab dehi dukh log ||",
      "translation": "You gather wealth by exploiting people.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤੇਰੈ ਕਾਜਿ ਨ ਅਵਰਾ ਜੋਗ ॥",
      "transliteration": "terai kaaj na avaraa jog ||",
      "translation": "It is of no use to you; it was meant for others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਰਿ ਅਹੰਕਾਰੁ ਹੋਇ ਵਰਤਹਿ ਅੰਧ ॥",
      "transliteration": "kar aha(n)kaar hoi varatahi a(n)dh ||",
      "translation": "You practice egotism, and act like a blind man.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਮ ਕੀ ਜੇਵੜੀ ਤੂ ਆਗੈ ਬੰਧ ॥੧॥",
      "transliteration": "jam kee jevaRee too aagai ba(n)dh ||1||",
      "translation": "In the world hereafter, you shall be tied to the leash of the Messenger of Death. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਛਾਡਿ ਵਿਡਾਣੀ ਤਾਤਿ ਮੂੜੇ ॥",
      "transliteration": "chhaad vidaanee taat mooRe ||",
      "translation": "Give up your envy of others, you fool!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਈਹਾ ਬਸਨਾ ਰਾਤਿ ਮੂੜੇ ॥",
      "transliteration": "eehaa basanaa raat mooRe ||",
      "translation": "You only live here for a night, you fool!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮਾਇਆ ਕੇ ਮਾਤੇ ਤੈ ਉਠਿ ਚਲਨਾ ॥",
      "transliteration": "maaiaa ke maate tai uth chalanaa ||",
      "translation": "You are intoxicated with Maya, but you must soon arise and depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਰਾਚਿ ਰਹਿਓ ਤੂ ਸੰਗਿ ਸੁਪਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raach rahio too sa(n)g supanaa ||1|| rahaau ||",
      "translation": "You are totally involved in the dream. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਬਾਲ ਬਿਵਸਥਾ ਬਾਰਿਕੁ ਅੰਧ ॥",
      "transliteration": "baal bivasathaa baarik a(n)dh ||",
      "translation": "In his childhood, the child is blind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0889_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਭਰਿ ਜੋਬਨਿ ਲਾਗਾ ਦੁਰਗੰਧ ॥",
      "transliteration": "bhar joban laagaa duraga(n)dh ||",
      "translation": "In the fullness of youth, he is involved in foul-smelling sins.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 889,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
