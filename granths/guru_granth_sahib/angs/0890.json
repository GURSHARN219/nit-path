{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 890,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0890_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤ੍ਰਿਤੀਅ ਬਿਵਸਥਾ ਸਿੰਚੇ ਮਾਇ ॥",
      "transliteration": "tritee bivasathaa si(n)che maai ||",
      "translation": "In the third stage of life, he gathers the wealth of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਰਧਿ ਭਇਆ ਛੋਡਿ ਚਲਿਓ ਪਛੁਤਾਇ ॥੨॥",
      "transliteration": "biradh bhaiaa chhod chalio pachhutaai ||2||",
      "translation": "And when he grows old, he must leave all this; he departs regretting and repenting. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚਿਰੰਕਾਲ ਪਾਈ ਦ੍ਰੁਲਭ ਦੇਹ ॥",
      "transliteration": "chira(n)kaal paaee drulabh deh ||",
      "translation": "After a very long time, one obtains this precious human body, so difficult to obtain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਮ ਬਿਹੂਣੀ ਹੋਈ ਖੇਹ ॥",
      "transliteration": "naam bihoonee hoee kheh ||",
      "translation": "Without the Naam, the Name of the Lord, it is reduced to dust.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਸੂ ਪਰੇਤ ਮੁਗਧ ਤੇ ਬੁਰੀ ॥",
      "transliteration": "pasoo paret mugadh te buree ||",
      "translation": "Worse than a beast, a demon or an idiot,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਿਸਹਿ ਨ ਬੂਝੈ ਜਿਨਿ ਏਹ ਸਿਰੀ ॥੩॥",
      "transliteration": "tisahi na boojhai jin eh siree ||3||",
      "translation": "is that one who does not understand who created him. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੁਣਿ ਕਰਤਾਰ ਗੋਵਿੰਦ ਗੋਪਾਲ ॥",
      "transliteration": "sun karataar govi(n)d gopaal ||",
      "translation": "Listen, O Creator Lord, Lord of the Universe, Lord of the World,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੀਨ ਦਇਆਲ ਸਦਾ ਕਿਰਪਾਲ ॥",
      "transliteration": "deen daiaal sadaa kirapaal ||",
      "translation": "Merciful to the meek, forever compassionate",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤੁਮਹਿ ਛਡਾਵਹੁ ਛੁਟਕਹਿ ਬੰਧ ॥",
      "transliteration": "tumahi chhadaavahu chhutakahi ba(n)dh ||",
      "translation": "If You emancipate the human, then his bonds are broken.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਖਸਿ ਮਿਲਾਵਹੁ ਨਾਨਕ ਜਗ ਅੰਧ ॥੪॥੧੨॥੨੩॥",
      "transliteration": "bakhas milaavahu naanak jag a(n)dh ||4||12||23||",
      "translation": "O Nanak, the people of world are blind; please, Lord, forgive them, and unite them with Yourself. ||4||12||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਰਿ ਸੰਜੋਗੁ ਬਨਾਈ ਕਾਛਿ ॥",
      "transliteration": "kar sa(n)jog banaaee kaachh ||",
      "translation": "Joining the elements together, the robe of the body is fashioned.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਸੁ ਸੰਗਿ ਰਹਿਓ ਇਆਨਾ ਰਾਚਿ ॥",
      "transliteration": "tis sa(n)g rahio iaanaa raach ||",
      "translation": "The ignorant fool is engrossed in it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪ੍ਰਤਿਪਾਰੈ ਨਿਤ ਸਾਰਿ ਸਮਾਰੈ ॥",
      "transliteration": "pratipaarai nit saar samaarai ||",
      "translation": "He cherishes it, and constantly takes care of it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅੰਤ ਕੀ ਬਾਰ ਊਠਿ ਸਿਧਾਰੈ ॥੧॥",
      "transliteration": "a(n)t kee baar ooth sidhaarai ||1||",
      "translation": "But at the very last moment, he must arise and depart. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਸਭੁ ਝੂਠੁ ਪਰਾਨੀ ॥",
      "transliteration": "naam binaa sabh jhooth paraanee ||",
      "translation": "Without the Naam, the Name of the Lord, everything is false, O mortal.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੋਵਿਦ ਭਜਨ ਬਿਨੁ ਅਵਰ ਸੰਗਿ ਰਾਤੇ ਤੇ ਸਭਿ ਮਾਇਆ ਮੂਠੁ ਪਰਾਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "govid bhajan bin avar sa(n)g raate te sabh maaiaa mooth paraanee ||1|| rahaau ||",
      "translation": "Those who do not vibrate and meditate on the Lord of the Universe, but instead are imbued with other things, - all those mortals are plundered by Maya. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤੀਰਥ ਨਾਇ ਨ ਉਤਰਸਿ ਮੈਲੁ ॥",
      "transliteration": "teerath naai na utaras mail ||",
      "translation": "Bathing at sacred shrines of pilgrimage, filth is not washed off.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਰਮ ਧਰਮ ਸਭਿ ਹਉਮੈ ਫੈਲੁ ॥",
      "transliteration": "karam dharam sabh haumai phail ||",
      "translation": "Religious rituals are all just egotistical displays.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਲੋਕ ਪਚਾਰੈ ਗਤਿ ਨਹੀ ਹੋਇ ॥",
      "transliteration": "lok pachaarai gat nahee hoi ||",
      "translation": "By pleasing and appeasing people, no one is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਮ ਬਿਹੂਣੇ ਚਲਸਹਿ ਰੋਇ ॥੨॥",
      "transliteration": "naam bihoone chalasahi roi ||2||",
      "translation": "Without the Naam, they shall depart weeping. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਨਾਮ ਨ ਟੂਟਸਿ ਪਟਲ ॥",
      "transliteration": "bin har naam na tootas patal ||",
      "translation": "Without the Lord's Name, the screen is not torn away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋਧੇ ਸਾਸਤ੍ਰ ਸਿਮ੍ਰਿਤਿ ਸਗਲ ॥",
      "transliteration": "sodhe saasatr simrit sagal ||",
      "translation": "I have studied all the Shaastras and Simritees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੋ ਨਾਮੁ ਜਪੈ ਜਿਸੁ ਆਪਿ ਜਪਾਏ ॥",
      "transliteration": "so naam japai jis aap japaae ||",
      "translation": "He alone chants the Naam, whom the Lord Himself inspires to chant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਗਲ ਫਲਾ ਸੇ ਸੂਖਿ ਸਮਾਏ ॥੩॥",
      "transliteration": "sagal phalaa se sookh samaae ||3||",
      "translation": "He obtains all fruits and rewards, and merges in peace. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਖਨਹਾਰੇ ਰਾਖਹੁ ਆਪਿ ॥",
      "transliteration": "raakhanahaare raakhahu aap ||",
      "translation": "O Savior Lord, please save me!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਗਲ ਸੁਖਾ ਪ੍ਰਭ ਤੁਮਰੈ ਹਾਥਿ ॥",
      "transliteration": "sagal sukhaa prabh tumarai haath ||",
      "translation": "All peace and comforts are in Your Hand, God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਿਤੁ ਲਾਵਹਿ ਤਿਤੁ ਲਾਗਹ ਸੁਆਮੀ ॥",
      "transliteration": "jit laavahi tit laagah suaamee ||",
      "translation": "Whatever you attach me to, to that I am attached, O my Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਨਕ ਸਾਹਿਬੁ ਅੰਤਰਜਾਮੀ ॥੪॥੧੩॥੨੪॥",
      "transliteration": "naanak saahib a(n)tarajaamee ||4||13||24||",
      "translation": "O Nanak, the Lord is the Inner-knower, the Searcher of hearts. ||4||13||24||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕਰੈ ਸੋਈ ਸੁਖੁ ਜਾਨਾ ॥",
      "transliteration": "jo kichh karai soee sukh jaanaa ||",
      "translation": "Whatever He does makes me happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਨੁ ਅਸਮਝੁ ਸਾਧਸੰਗਿ ਪਤੀਆਨਾ ॥",
      "transliteration": "man asamajh saadhasa(n)g pateeaanaa ||",
      "translation": "The ignorant mind is encouraged, in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਡੋਲਨ ਤੇ ਚੂਕਾ ਠਹਰਾਇਆ ॥",
      "transliteration": "dolan te chookaa thaharaaiaa ||",
      "translation": "Now, it does not waver at all; it has become stable and steady.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਤਿ ਮਾਹਿ ਲੇ ਸਤਿ ਸਮਾਇਆ ॥੧॥",
      "transliteration": "sat maahi le sat samaaiaa ||1||",
      "translation": "Receiving Truth, it is merged in the True Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੂਖੁ ਗਇਆ ਸਭੁ ਰੋਗੁ ਗਇਆ ॥",
      "transliteration": "dookh gaiaa sabh rog gaiaa ||",
      "translation": "Pain is gone, and all illness is gone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਆਗਿਆ ਮਨ ਮਹਿ ਮਾਨੀ ਮਹਾ ਪੁਰਖ ਕਾ ਸੰਗੁ ਭਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "prabh kee aagiaa man mahi maanee mahaa purakh kaa sa(n)g bhaiaa ||1|| rahaau ||",
      "translation": "I have accepted the Will of God in my mind, associating with the Great Person, the Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਗਲ ਪਵਿਤ੍ਰ ਸਰਬ ਨਿਰਮਲਾ ॥",
      "transliteration": "sagal pavitr sarab niramalaa ||",
      "translation": "All is pure; all is immaculate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੋ ਵਰਤਾਏ ਸੋਈ ਭਲਾ ॥",
      "transliteration": "jo varataae soee bhalaa ||",
      "translation": "Whatever exists is good.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਹ ਰਾਖੈ ਸੋਈ ਮੁਕਤਿ ਥਾਨੁ ॥",
      "transliteration": "jah raakhai soee mukat thaan ||",
      "translation": "Wherever He keeps me, that is the place of liberation for me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੋ ਜਪਾਏ ਸੋਈ ਨਾਮੁ ॥੨॥",
      "transliteration": "jo japaae soee naam ||2||",
      "translation": "Whatever He makes me chant, is His Name. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਠਸਠਿ ਤੀਰਥ ਜਹ ਸਾਧ ਪਗ ਧਰਹਿ ॥",
      "transliteration": "athasath teerath jah saadh pag dharahi ||",
      "translation": "That is the sixty-eight sacred shrines of pilgrimage, where the Holy place their feet,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਹ ਬੈਕੁੰਠੁ ਜਹ ਨਾਮੁ ਉਚਰਹਿ ॥",
      "transliteration": "tah baiku(n)th jah naam ucharahi ||",
      "translation": "and that is heaven, where the Naam is chanted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਰਬ ਅਨੰਦ ਜਬ ਦਰਸਨੁ ਪਾਈਐ ॥",
      "transliteration": "sarab ana(n)d jab darasan paaeeai ||",
      "translation": "All bliss comes, when one obtains the Blessed Vision of the Lord's Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਾਮ ਗੁਣਾ ਨਿਤ ਨਿਤ ਹਰਿ ਗਾਈਐ ॥੩॥",
      "transliteration": "raam gunaa nit nit har gaaeeai ||3||",
      "translation": "I sing continuously, continually, the Glorious Praises of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਪੇ ਘਟਿ ਘਟਿ ਰਹਿਆ ਬਿਆਪਿ ॥",
      "transliteration": "aape ghat ghat rahiaa biaap ||",
      "translation": "The Lord Himself is pervading in each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦਇਆਲ ਪੁਰਖ ਪਰਗਟ ਪਰਤਾਪ ॥",
      "transliteration": "daiaal purakh paragat parataap ||",
      "translation": "The glory of the Merciful Lord is radiant and manifest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਪਟ ਖੁਲਾਨੇ ਭ੍ਰਮ ਨਾਠੇ ਦੂਰੇ ॥",
      "transliteration": "kapat khulaane bhram naathe doore ||",
      "translation": "The shutters are opened, and doubts have run away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਗੁਰ ਭੇਟੇ ਪੂਰੇ ॥੪॥੧੪॥੨੫॥",
      "transliteration": "naanak kau gur bhete poore ||4||14||25||",
      "translation": "Nanak has met with the Perfect Guru. ||4||14||25||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕੋਟਿ ਜਾਪ ਤਾਪ ਬਿਸ੍ਰਾਮ ॥",
      "transliteration": "kot jaap taap bisraam ||",
      "translation": "Millions of meditations and austerities rest in him,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਰਿਧਿ ਬੁਧਿ ਸਿਧਿ ਸੁਰ ਗਿਆਨ ॥",
      "transliteration": "ridh budh sidh sur giaan ||",
      "translation": "along with wealth, wisdom, miraculous spiritual powers and angelic spiritual insight.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਨਿਕ ਰੂਪ ਰੰਗ ਭੋਗ ਰਸੈ ॥",
      "transliteration": "anik roop ra(n)g bhog rasai ||",
      "translation": "He enjoys the various shows and forms, pleasures and delicacies;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਮੁ ਨਿਮਖ ਰਿਦੈ ਵਸੈ ॥੧॥",
      "transliteration": "guramukh naam nimakh ridai vasai ||1||",
      "translation": "the Naam, the Name of the Lord, dwells within the heart of the Gurmukh. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਹਰਿ ਕੇ ਨਾਮ ਕੀ ਵਡਿਆਈ ॥",
      "transliteration": "har ke naam kee vadiaaee ||",
      "translation": "Such is the glorious greatness of the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕੀਮਤਿ ਕਹਣੁ ਨ ਜਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "keemat kahan na jaaee ||1|| rahaau ||",
      "translation": "Its value cannot be described. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0890_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸੂਰਬੀਰ ਧੀਰਜ ਮਤਿ ਪੂਰਾ ॥",
      "transliteration": "soorabeer dheeraj mat pooraa ||",
      "translation": "He alone is brave, patient and perfectly wise;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 890,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
