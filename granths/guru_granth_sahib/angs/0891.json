{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 891,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0891_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਹਜ ਸਮਾਧਿ ਧੁਨਿ ਗਹਿਰ ਗੰਭੀਰਾ ॥",
      "transliteration": "sahaj samaadh dhun gahir ga(n)bheeraa ||",
      "translation": "he is intuitively in Samaadhi, profound and unfathomable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਦਾ ਮੁਕਤੁ ਤਾ ਕੇ ਪੂਰੇ ਕਾਮ ॥",
      "transliteration": "sadaa mukat taa ke poore kaam ||",
      "translation": "He is liberated forever and all his affairs are perfectly resolved;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਾ ਕੈ ਰਿਦੈ ਵਸੈ ਹਰਿ ਨਾਮ ॥੨॥",
      "transliteration": "jaa kai ridai vasai har naam ||2||",
      "translation": "the Lord's Name abides within his heart. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਗਲ ਸੂਖ ਆਨੰਦ ਅਰੋਗ ॥",
      "transliteration": "sagal sookh aana(n)d arog ||",
      "translation": "He is totally peaceful, blissful and healthy;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਮਦਰਸੀ ਪੂਰਨ ਨਿਰਜੋਗ ॥",
      "transliteration": "samadarasee pooran nirajog ||",
      "translation": "he looks upon all impartially, and is perfectly detached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਇ ਨ ਜਾਇ ਡੋਲੈ ਕਤ ਨਾਹੀ ॥",
      "transliteration": "aai na jaai dolai kat naahee ||",
      "translation": "He does not come and go, and he never wavers;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਾ ਕੈ ਨਾਮੁ ਬਸੈ ਮਨ ਮਾਹੀ ॥੩॥",
      "transliteration": "jaa kai naam basai man maahee ||3||",
      "translation": "the Naam abides in his mind. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੀਨ ਦਇਆਲ ਗੋੁਪਾਲ ਗੋਵਿੰਦ ॥",
      "transliteration": "deen daiaal goupaal govi(n)d ||",
      "translation": "God is Merciful to the meek; He is the Lord of the World, the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਜਪੀਐ ਉਤਰੈ ਚਿੰਦ ॥",
      "transliteration": "guramukh japeeai utarai chi(n)d ||",
      "translation": "The Gurmukh meditates on Him, and his worries are gone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਗੁਰਿ ਦੀਆ ਨਾਮੁ ॥",
      "transliteration": "naanak kau gur deeaa naam ||",
      "translation": "The Guru has blessed Nanak with the Naam;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੰਤਨ ਕੀ ਟਹਲ ਸੰਤ ਕਾ ਕਾਮੁ ॥੪॥੧੫॥੨੬॥",
      "transliteration": "sa(n)tan kee tahal sa(n)t kaa kaam ||4||15||26||",
      "translation": "he serves the Saints, and works for the Saints. ||4||15||26||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬੀਜ ਮੰਤ੍ਰੁ ਹਰਿ ਕੀਰਤਨੁ ਗਾਉ ॥",
      "transliteration": "beej ma(n)tr har keeratan gaau ||",
      "translation": "Sing the Kirtan of the Lord's Praises, and the Beej Mantra, the Seed Mantra.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਗੈ ਮਿਲੀ ਨਿਥਾਵੇ ਥਾਉ ॥",
      "transliteration": "aagai milee nithaave thaau ||",
      "translation": "Even the homeless find a home in the world hereafter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕੀ ਚਰਣੀ ਲਾਗੁ ॥",
      "transliteration": "gur poore kee charanee laag ||",
      "translation": "Fall at the feet of the Perfect Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕਾ ਸੋਇਆ ਜਾਗੁ ॥੧॥",
      "transliteration": "janam janam kaa soiaa jaag ||1||",
      "translation": "you have slept for so many incarnations - wake up! ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਜਾਪੁ ਜਪਲਾ ॥",
      "transliteration": "har har jaap japalaa ||",
      "translation": "Chant the Chant of the Lord's Name, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਹਿਰਦੈ ਵਾਸੈ ਭਉਜਲੁ ਪਾਰਿ ਪਰਲਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur kirapaa te hiradai vaasai bhaujal paar paralaa ||1|| rahaau ||",
      "translation": "By Guru's Grace, it shall be enshrined within your heart, and you shall cross over the terrifying world-ocean. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਮੁ ਨਿਧਾਨੁ ਧਿਆਇ ਮਨ ਅਟਲ ॥",
      "transliteration": "naam nidhaan dhiaai man atal ||",
      "translation": "Meditate on the eternal treasure of the Naam, the Name of the Lord, O mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਛੂਟਹਿ ਮਾਇਆ ਕੇ ਪਟਲ ॥",
      "transliteration": "taa chhootahi maaiaa ke patal ||",
      "translation": "and then, the screen of Maya shall be torn away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਅੰਮ੍ਰਿਤ ਰਸੁ ਪੀਉ ॥",
      "transliteration": "gur kaa sabad a(n)mrit ras peeu ||",
      "translation": "Drink in the Ambrosial Nectar of the Guru's Shabad,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਾ ਤੇਰਾ ਹੋਇ ਨਿਰਮਲ ਜੀਉ ॥੨॥",
      "transliteration": "taa teraa hoi niramal jeeu ||2||",
      "translation": "and then your soul shall be rendered immaculate and pure. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋਧਤ ਸੋਧਤ ਸੋਧਿ ਬੀਚਾਰਾ ॥",
      "transliteration": "sodhat sodhat sodh beechaaraa ||",
      "translation": "Searching, searching, searching, I have realized",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਭਗਤਿ ਨਹੀ ਛੁਟਕਾਰਾ ॥",
      "transliteration": "bin har bhagat nahee chhutakaaraa ||",
      "translation": "that without devotional worship of the Lord, no one is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੋ ਹਰਿ ਭਜਨੁ ਸਾਧ ਕੈ ਸੰਗਿ ॥",
      "transliteration": "so har bhajan saadh kai sa(n)g ||",
      "translation": "So vibrate, and meditate on that Lord in the Saadh Sangat, the Company of the Holy;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਰਾਪੈ ਹਰਿ ਕੈ ਰੰਗਿ ॥੩॥",
      "transliteration": "man tan raapai har kai ra(n)g ||3||",
      "translation": "your mind and body shall be imbued with love for the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਛੋਡਿ ਸਿਆਣਪ ਬਹੁ ਚਤੁਰਾਈ ॥",
      "transliteration": "chhod siaanap bahu chaturaaee ||",
      "translation": "Renounce all your cleverness and trickery.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਨ ਬਿਨੁ ਹਰਿ ਨਾਵੈ ਜਾਇ ਨ ਕਾਈ ॥",
      "transliteration": "man bin har naavai jaai na kaaee ||",
      "translation": "O mind, without the Lord's Name, there is no place of rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦਇਆ ਧਾਰੀ ਗੋਵਿਦ ਗੋੁਸਾਈ ॥",
      "transliteration": "daiaa dhaaree govid gousaaee ||",
      "translation": "The Lord of the Universe, the Lord of the World, has taken pity on me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਨਕ ਟੇਕ ਟਿਕਾਈ ॥੪॥੧੬॥੨੭॥",
      "transliteration": "har har naanak tek tikaaee ||4||16||27||",
      "translation": "Nanak seeks the protection and support of the Lord, Har, Har. ||4||16||27||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੰਤ ਕੈ ਸੰਗਿ ਰਾਮ ਰੰਗ ਕੇਲ ॥",
      "transliteration": "sa(n)t kai sa(n)g raam ra(n)g kel ||",
      "translation": "In the Saints' Congregation, play joyfully with the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਗੈ ਜਮ ਸਿਉ ਹੋਇ ਨ ਮੇਲ ॥",
      "transliteration": "aagai jam siu hoi na mel ||",
      "translation": "and you will not have to meet the Messenger of Death hereafter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਹੰਬੁਧਿ ਕਾ ਭਇਆ ਬਿਨਾਸ ॥",
      "transliteration": "aha(n)budh kaa bhaiaa binaas ||",
      "translation": "Your egotistical intellect shall be dispelled,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੁਰਮਤਿ ਹੋਈ ਸਗਲੀ ਨਾਸ ॥੧॥",
      "transliteration": "duramat hoee sagalee naas ||1||",
      "translation": "and your evil-mindedness will be totally taken away. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਗੁਣ ਗਾਇ ਪੰਡਿਤ ॥",
      "transliteration": "raam naam gun gaai pa(n)dit ||",
      "translation": "Sing the Glorious Praises of the Lord's Name, O Pandit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਰਮ ਕਾਂਡ ਅਹੰਕਾਰੁ ਨ ਕਾਜੈ ਕੁਸਲ ਸੇਤੀ ਘਰਿ ਜਾਹਿ ਪੰਡਿਤ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "karam kaa(n)d aha(n)kaar na kaajai kusal setee ghar jaahi pa(n)dit ||1|| rahaau ||",
      "translation": "Religious rituals and egotism are of no use at all. You shall go home with happiness, O Pandit. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਰਿ ਕਾ ਜਸੁ ਨਿਧਿ ਲੀਆ ਲਾਭ ॥",
      "transliteration": "har kaa jas nidh leeaa laabh ||",
      "translation": "I have earned the profit, the wealth of the Lord's praise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪੂਰਨ ਭਏ ਮਨੋਰਥ ਸਾਭ ॥",
      "transliteration": "pooran bhae manorath saabh ||",
      "translation": "All my hopes have been fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੁਖੁ ਨਾਠਾ ਸੁਖੁ ਘਰ ਮਹਿ ਆਇਆ ॥",
      "transliteration": "dukh naathaa sukh ghar mahi aaiaa ||",
      "translation": "Pain has left me, and peace has come to my home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਕਮਲੁ ਬਿਗਸਾਇਆ ॥੨॥",
      "transliteration": "sa(n)t prasaad kamal bigasaaiaa ||2||",
      "translation": "By the Grace of the Saints, my heart-lotus blossoms forth. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਮ ਰਤਨੁ ਜਿਨਿ ਪਾਇਆ ਦਾਨੁ ॥",
      "transliteration": "naam ratan jin paaiaa daan ||",
      "translation": "One who is blessed with the gift of the jewel of the Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਹੋਏ ਸਗਲ ਨਿਧਾਨ ॥",
      "transliteration": "tis jan hoe sagal nidhaan ||",
      "translation": "obtains all treasures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੰਤੋਖੁ ਆਇਆ ਮਨਿ ਪੂਰਾ ਪਾਇ ॥",
      "transliteration": "sa(n)tokh aaiaa man pooraa paai ||",
      "translation": "His mind becomes content, finding the Perfect Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਫਿਰਿ ਫਿਰਿ ਮਾਗਨ ਕਾਹੇ ਜਾਇ ॥੩॥",
      "transliteration": "phir phir maagan kaahe jaai ||3||",
      "translation": "Why should he ever go begging again? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਰਿ ਕੀ ਕਥਾ ਸੁਨਤ ਪਵਿਤ ॥",
      "transliteration": "har kee kathaa sunat pavit ||",
      "translation": "Hearing the Lord's sermon, he becomes pure and holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਿਹਵਾ ਬਕਤ ਪਾਈ ਗਤਿ ਮਤਿ ॥",
      "transliteration": "jihavaa bakat paaee gat mat ||",
      "translation": "Chanting it with his tongue, he finds the way to salvation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੋ ਪਰਵਾਣੁ ਜਿਸੁ ਰਿਦੈ ਵਸਾਈ ॥",
      "transliteration": "so paravaan jis ridai vasaaee ||",
      "translation": "He alone is approved, who enshrines the Lord within his heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਨਕ ਤੇ ਜਨ ਊਤਮ ਭਾਈ ॥੪॥੧੭॥੨੮॥",
      "transliteration": "naanak te jan ootam bhaaee ||4||17||28||",
      "translation": "Nanak: such a humble being is exalted, O Siblings of Destiny. ||4||17||28||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗਹੁ ਕਰਿ ਪਕਰੀ ਨ ਆਈ ਹਾਥਿ ॥",
      "transliteration": "gahu kar pakaree na aaee haath ||",
      "translation": "No matter how hard you try to grab it, it does not come into your hands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪ੍ਰੀਤਿ ਕਰੀ ਚਾਲੀ ਨਹੀ ਸਾਥਿ ॥",
      "transliteration": "preet karee chaalee nahee saath ||",
      "translation": "No matter how much you may love it, it does not go along with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਉ ਤਿਆਗਿ ਦਈ ॥",
      "transliteration": "kahu naanak jau tiaag daee ||",
      "translation": "Says Nanak, when you abandon it,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਬ ਓਹ ਚਰਣੀ ਆਇ ਪਈ ॥੧॥",
      "transliteration": "tab oh charanee aai paee ||1||",
      "translation": "then it comes and falls at your feet. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸੁਣਿ ਸੰਤਹੁ ਨਿਰਮਲ ਬੀਚਾਰ ॥",
      "transliteration": "sun sa(n)tahu niramal beechaar ||",
      "translation": "Listen, O Saints: this is the pure philosophy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0891_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਬਿਨੁ ਗਤਿ ਨਹੀ ਕਾਈ ਗੁਰੁ ਪੂਰਾ ਭੇਟਤ ਉਧਾਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raam naam bin gat nahee kaaee gur pooraa bhetat udhaar ||1|| rahaau ||",
      "translation": "Without the Lord's Name, there is no salvation. Meeting with the Perfect Guru, one is saved. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 891,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
