{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 892,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0892_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਬ ਉਸ ਕਉ ਕੋਈ ਦੇਵੈ ਮਾਨੁ ॥",
      "transliteration": "jab us kau koee devai maan ||",
      "translation": "When someone tries to appease her,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਬ ਆਪਸ ਊਪਰਿ ਰਖੈ ਗੁਮਾਨੁ ॥",
      "transliteration": "tab aapas oopar rakhai gumaan ||",
      "translation": "then she takes pride in herself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਬ ਉਸ ਕਉ ਕੋਈ ਮਨਿ ਪਰਹਰੈ ॥",
      "transliteration": "jab us kau koee man paraharai ||",
      "translation": "But when someone puts her out of his thoughts,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਬ ਓਹ ਸੇਵਕਿ ਸੇਵਾ ਕਰੈ ॥੨॥",
      "transliteration": "tab oh sevak sevaa karai ||2||",
      "translation": "then she serves him like a slave. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮੁਖਿ ਬੇਰਾਵੈ ਅੰਤਿ ਠਗਾਵੈ ॥",
      "transliteration": "mukh beraavai a(n)t thagaavai ||",
      "translation": "She seems to please, but in the end, she deceives.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਕਤੁ ਠਉਰ ਓਹ ਕਹੀ ਨ ਸਮਾਵੈ ॥",
      "transliteration": "ikat thaur oh kahee na samaavai ||",
      "translation": "She does not remain in any one place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਉਨਿ ਮੋਹੇ ਬਹੁਤੇ ਬ੍ਰਹਮੰਡ ॥",
      "transliteration": "un mohe bahute brahama(n)d ||",
      "translation": "She has bewitched a great many worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਮ ਜਨੀ ਕੀਨੀ ਖੰਡ ਖੰਡ ॥੩॥",
      "transliteration": "raam janee keenee kha(n)d kha(n)d ||3||",
      "translation": "The Lord's humble servants cut her apart into pieces. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੋ ਮਾਗੈ ਸੋ ਭੂਖਾ ਰਹੈ ॥",
      "transliteration": "jo maagai so bhookhaa rahai ||",
      "translation": "Whoever begs from her remains hungry.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਇਸੁ ਸੰਗਿ ਰਾਚੈ ਸੁ ਕਛੂ ਨ ਲਹੈ ॥",
      "transliteration": "is sa(n)g raachai s kachhoo na lahai ||",
      "translation": "Whoever is infatuated with her obtains nothing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਸਹਿ ਤਿਆਗਿ ਸਤਸੰਗਤਿ ਕਰੈ ॥",
      "transliteration": "isahi tiaag satasa(n)gat karai ||",
      "translation": "But one who renounces her, and joins the Society of the Saints,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਵਡਭਾਗੀ ਨਾਨਕ ਓਹੁ ਤਰੈ ॥੪॥੧੮॥੨੯॥",
      "transliteration": "vadabhaagee naanak ohu tarai ||4||18||29||",
      "translation": "by great good fortune, O Nanak, is saved. ||4||18||29||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਤਮ ਰਾਮੁ ਸਰਬ ਮਹਿ ਪੇਖੁ ॥",
      "transliteration": "aatam raam sarab mahi pekh ||",
      "translation": "See the Lord, the Universal Soul, in all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪੂਰਨ ਪੂਰਿ ਰਹਿਆ ਪ੍ਰਭ ਏਕੁ ॥",
      "transliteration": "pooran poor rahiaa prabh ek ||",
      "translation": "The One God is perfect, and all-pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਤਨੁ ਅਮੋਲੁ ਰਿਦੇ ਮਹਿ ਜਾਨੁ ॥",
      "transliteration": "ratan amol ride mahi jaan ||",
      "translation": "Know that the priceless jewel is within your own heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਪਨੀ ਵਸਤੁ ਤੂ ਆਪਿ ਪਛਾਨੁ ॥੧॥",
      "transliteration": "apanee vasat too aap pachhaan ||1||",
      "translation": "Realize that your essence is within your own self. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪੀ ਅੰਮ੍ਰਿਤੁ ਸੰਤਨ ਪਰਸਾਦਿ ॥",
      "transliteration": "pee a(n)mrit sa(n)tan parasaad ||",
      "translation": "Drink in the Ambrosial Nectar, by the Grace of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਵਡੇ ਭਾਗ ਹੋਵਹਿ ਤਉ ਪਾਈਐ ਬਿਨੁ ਜਿਹਵਾ ਕਿਆ ਜਾਣੈ ਸੁਆਦੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "vade bhaag hovahi tau paaeeai bin jihavaa kiaa jaanai suaad ||1|| rahaau ||",
      "translation": "One who is blessed with high destiny, obtains it. Without a tongue, how can one know the taste? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਠ ਦਸ ਬੇਦ ਸੁਨੇ ਕਹ ਡੋਰਾ ॥",
      "transliteration": "ath das bed sune kah doraa ||",
      "translation": "How can a deaf person listen to the eighteen Puraanas and the Vedas?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕੋਟਿ ਪ੍ਰਗਾਸ ਨ ਦਿਸੈ ਅੰਧੇਰਾ ॥",
      "transliteration": "kot pragaas na disai a(n)dheraa ||",
      "translation": "The blind man cannot see even a million lights.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪਸੂ ਪਰੀਤਿ ਘਾਸ ਸੰਗਿ ਰਚੈ ॥",
      "transliteration": "pasoo pareet ghaas sa(n)g rachai ||",
      "translation": "The beast loves grass, and remains attached to it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਿਸੁ ਨਹੀ ਬੁਝਾਵੈ ਸੋ ਕਿਤੁ ਬਿਧਿ ਬੁਝੈ ॥੨॥",
      "transliteration": "jis nahee bujhaavai so kit bidh bujhai ||2||",
      "translation": "One who has not been taught - how can he understand? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਾਨਣਹਾਰੁ ਰਹਿਆ ਪ੍ਰਭੁ ਜਾਨਿ ॥",
      "transliteration": "jaananahaar rahiaa prabh jaan ||",
      "translation": "God, the Knower, knows all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਓਤਿ ਪੋਤਿ ਭਗਤਨ ਸੰਗਾਨਿ ॥",
      "transliteration": "ot pot bhagatan sa(n)gaan ||",
      "translation": "He is with His devotees, through and through.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਿਗਸਿ ਬਿਗਸਿ ਅਪੁਨਾ ਪ੍ਰਭੁ ਗਾਵਹਿ ॥",
      "transliteration": "bigas bigas apunaa prabh gaavahi ||",
      "translation": "Those who sing God's Praises with joy and delight,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਨਕ ਤਿਨ ਜਮ ਨੇੜਿ ਨ ਆਵਹਿ ॥੩॥੧੯॥੩੦॥",
      "transliteration": "naanak tin jam neR na aavahi ||3||19||30||",
      "translation": "O Nanak - the Messenger of Death does not even approach them. ||3||19||30||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੀਨੋ ਨਾਮੁ ਕੀਓ ਪਵਿਤੁ ॥",
      "transliteration": "deeno naam keeo pavit ||",
      "translation": "Blessing me with His Name, He has purified and sanctified me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਰਿ ਧਨੁ ਰਾਸਿ ਨਿਰਾਸ ਇਹ ਬਿਤੁ ॥",
      "transliteration": "har dhan raas niraas ih bit ||",
      "translation": "The Lord's wealth is my capital. False hope has left me; this is my wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਾਟੀ ਬੰਧਿ ਹਰਿ ਸੇਵਾ ਲਾਏ ॥",
      "transliteration": "kaatee ba(n)dh har sevaa laae ||",
      "translation": "Breaking my bonds, the Lord has linked me to His service.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਭਗਤਿ ਰਾਮ ਗੁਣ ਗਾਏ ॥੧॥",
      "transliteration": "har har bhagat raam gun gaae ||1||",
      "translation": "I am a devotee of the Lord, Har, Har; I sing the Glorious Praises of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਾਜੇ ਅਨਹਦ ਬਾਜਾ ॥",
      "transliteration": "baaje anahad baajaa ||",
      "translation": "The unstruck sound current vibrates and resounds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਸਕਿ ਰਸਕਿ ਗੁਣ ਗਾਵਹਿ ਹਰਿ ਜਨ ਅਪਨੈ ਗੁਰਦੇਵਿ ਨਿਵਾਜਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "rasak rasak gun gaavahi har jan apanai guradev nivaajaa ||1|| rahaau ||",
      "translation": "The Lord's humble servants sing His Glorious Praises with love and delight; they are honored by the Divine Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਇ ਬਨਿਓ ਪੂਰਬਲਾ ਭਾਗੁ ॥",
      "transliteration": "aai banio poorabalaa bhaag ||",
      "translation": "My pre-ordained destiny has been activated;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕਾ ਸੋਇਆ ਜਾਗੁ ॥",
      "transliteration": "janam janam kaa soiaa jaag ||",
      "translation": "I have awakened from the sleep of countless incarnations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗਈ ਗਿਲਾਨਿ ਸਾਧ ਕੈ ਸੰਗਿ ॥",
      "transliteration": "gaee gilaan saadh kai sa(n)g ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, my aversion is gone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਰਾਤੋ ਹਰਿ ਕੈ ਰੰਗਿ ॥੨॥",
      "transliteration": "man tan raato har kai ra(n)g ||2||",
      "translation": "My mind and body are imbued with love for the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਖੇ ਰਾਖਨਹਾਰ ਦਇਆਲ ॥",
      "transliteration": "raakhe raakhanahaar daiaal ||",
      "translation": "The Merciful Savior Lord has saved me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾ ਕਿਛੁ ਸੇਵਾ ਨਾ ਕਿਛੁ ਘਾਲ ॥",
      "transliteration": "naa kichh sevaa naa kichh ghaal ||",
      "translation": "I have no service or work to my credit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭਿ ਕੀਨੀ ਦਇਆ ॥",
      "transliteration": "kar kirapaa prabh keenee daiaa ||",
      "translation": "In His Mercy, God has taken pity on me;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬੂਡਤ ਦੁਖ ਮਹਿ ਕਾਢਿ ਲਇਆ ॥੩॥",
      "transliteration": "boodat dukh mahi kaadh laiaa ||3||",
      "translation": "He lifted me up and pulled me out, when I was suffering in pain. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁਣਿ ਸੁਣਿ ਉਪਜਿਓ ਮਨ ਮਹਿ ਚਾਉ ॥",
      "transliteration": "sun sun upajio man mahi chaau ||",
      "translation": "Listening, listening to His Praises, joy has welled up within my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਆਠ ਪਹਰ ਹਰਿ ਕੇ ਗੁਣ ਗਾਉ ॥",
      "transliteration": "aath pahar har ke gun gaau ||",
      "translation": "Twenty-four hours a day, I sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗਾਵਤ ਗਾਵਤ ਪਰਮ ਗਤਿ ਪਾਈ ॥",
      "transliteration": "gaavat gaavat param gat paaee ||",
      "translation": "Singing, singing His Praises, I have obtained the supreme status.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਨਾਨਕ ਲਿਵ ਲਾਈ ॥੪॥੨੦॥੩੧॥",
      "transliteration": "gur prasaad naanak liv laaee ||4||20||31||",
      "translation": "By Guru's Grace, Nanak is lovingly focused on the Lord. ||4||20||31||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਉਡੀ ਬਦਲੈ ਤਿਆਗੈ ਰਤਨੁ ॥",
      "transliteration": "kaudee badalai tiaagai ratan ||",
      "translation": "In exchange for a shell, he gives up a jewel.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਛੋਡਿ ਜਾਇ ਤਾਹੂ ਕਾ ਜਤਨੁ ॥",
      "transliteration": "chhod jaai taahoo kaa jatan ||",
      "translation": "He tries to get what he must give up.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੋ ਸੰਚੈ ਜੋ ਹੋਛੀ ਬਾਤ ॥",
      "transliteration": "so sa(n)chai jo hochhee baat ||",
      "translation": "He collects those things which are worthless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮਾਇਆ ਮੋਹਿਆ ਟੇਢਉ ਜਾਤ ॥੧॥",
      "transliteration": "maaiaa mohiaa tedhau jaat ||1||",
      "translation": "Enticed by Maya, he takes the crooked path. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਭਾਗੇ ਤੈ ਲਾਜ ਨਾਹੀ ॥",
      "transliteration": "abhaage tai laaj naahee ||",
      "translation": "You unfortunate man - have you no shame?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੁਖ ਸਾਗਰ ਪੂਰਨ ਪਰਮੇਸਰੁ ਹਰਿ ਨ ਚੇਤਿਓ ਮਨ ਮਾਹੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sukh saagar pooran paramesar har na chetio man maahee ||1|| rahaau ||",
      "translation": "You do not remember in your mind the ocean of peace, the perfect Transcendent Lord God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਕਉਰਾ ਬਿਖਿਆ ਮੀਠੀ ॥",
      "transliteration": "a(n)mrit kauraa bikhiaa meethee ||",
      "translation": "Nectar seems bitter to you, and poison is sweet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸਾਕਤ ਕੀ ਬਿਧਿ ਨੈਨਹੁ ਡੀਠੀ ॥",
      "transliteration": "saakat kee bidh nainahu deethee ||",
      "translation": "Such is your condition, you faithless cynic, which I have seen with my own eyes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0892_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕੂੜਿ ਕਪਟਿ ਅਹੰਕਾਰਿ ਰੀਝਾਨਾ ॥",
      "transliteration": "kooR kapat aha(n)kaar reejhaanaa ||",
      "translation": "You are fond of falsehood, fraud and egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 892,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
