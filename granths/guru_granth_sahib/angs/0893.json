{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 893,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0893_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਮੁ ਸੁਨਤ ਜਨੁ ਬਿਛੂਅ ਡਸਾਨਾ ॥੨॥",
      "transliteration": "naam sunat jan bichhoo dasaanaa ||2||",
      "translation": "If you hear the Naam, the Name of the Lord, you feel like you have been stung by a scorpion. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਾਇਆ ਕਾਰਣਿ ਸਦ ਹੀ ਝੂਰੈ ॥",
      "transliteration": "maaiaa kaaran sad hee jhoorai ||",
      "translation": "You continually yearn for Maya,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਨਿ ਮੁਖਿ ਕਬਹਿ ਨ ਉਸਤਤਿ ਕਰੈ ॥",
      "transliteration": "man mukh kabahi na usatat karai ||",
      "translation": "and you never chant the Lord's Praises with your mouth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਿਰਭਉ ਨਿਰੰਕਾਰ ਦਾਤਾਰੁ ॥",
      "transliteration": "nirabhau nira(n)kaar daataar ||",
      "translation": "The Lord is fearless and formless; He is the Great Giver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਸੁ ਸਿਉ ਪ੍ਰੀਤਿ ਨ ਕਰੈ ਗਵਾਰੁ ॥੩॥",
      "transliteration": "tis siu preet na karai gavaar ||3||",
      "translation": "But you do not love Him, you fool! ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਭ ਸਾਹਾ ਸਿਰਿ ਸਾਚਾ ਸਾਹੁ ॥",
      "transliteration": "sabh saahaa sir saachaa saahu ||",
      "translation": "God, the True King, is above the heads of all kings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਵੇਮੁਹਤਾਜੁ ਪੂਰਾ ਪਾਤਿਸਾਹੁ ॥",
      "transliteration": "vemuhataaj pooraa paatisaahu ||",
      "translation": "He is the independent, perfect Lord King.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮੋਹ ਮਗਨ ਲਪਟਿਓ ਭ੍ਰਮ ਗਿਰਹ ॥",
      "transliteration": "moh magan lapatio bhram girah ||",
      "translation": "People are intoxicated by emotional attachment, entangled in doubt and family life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਨਕ ਤਰੀਐ ਤੇਰੀ ਮਿਹਰ ॥੪॥੨੧॥੩੨॥",
      "transliteration": "naanak tareeai teree mihar ||4||21||32||",
      "translation": "Nanak: they are saved only by Your Mercy, Lord. ||4||21||32||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰੈਣਿ ਦਿਨਸੁ ਜਪਉ ਹਰਿ ਨਾਉ ॥",
      "transliteration": "rain dinas japau har naau ||",
      "translation": "Night and day, I chant the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਆਗੈ ਦਰਗਹ ਪਾਵਉ ਥਾਉ ॥",
      "transliteration": "aagai daragah paavau thaau ||",
      "translation": "Hereafter, I shall obtain a seat in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਦਾ ਅਨੰਦੁ ਨ ਹੋਵੀ ਸੋਗੁ ॥",
      "transliteration": "sadaa ana(n)d na hovee sog ||",
      "translation": "I am in bliss forever; I have no sorrow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਬਹੂ ਨ ਬਿਆਪੈ ਹਉਮੈ ਰੋਗੁ ॥੧॥",
      "transliteration": "kabahoo na biaapai haumai rog ||1||",
      "translation": "The disease of ego never afflicts me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਖੋਜਹੁ ਸੰਤਹੁ ਹਰਿ ਬ੍ਰਹਮ ਗਿਆਨੀ ॥",
      "transliteration": "khojahu sa(n)tahu har braham giaanee ||",
      "translation": "O Saints of the Lord, seek out those who know God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਿਸਮਨ ਬਿਸਮ ਭਏ ਬਿਸਮਾਦਾ ਪਰਮ ਗਤਿ ਪਾਵਹਿ ਹਰਿ ਸਿਮਰਿ ਪਰਾਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bisaman bisam bhae bisamaadaa param gat paavahi har simar paraanee ||1|| rahaau ||",
      "translation": "You shall be wonderstruck with wonder at the wonderful Lord; meditate in remembrance on the Lord, O mortal, and obtain the supreme status. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗਨਿ ਮਿਨਿ ਦੇਖਹੁ ਸਗਲ ਬੀਚਾਰਿ ॥",
      "transliteration": "gan min dekhahu sagal beechaar ||",
      "translation": "Calculating, measuring, and thinking in every way,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਕੋ ਸਕੈ ਨ ਤਾਰਿ ॥",
      "transliteration": "naam binaa ko sakai na taar ||",
      "translation": "see that without the Naam, no one can be carried across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਗਲ ਉਪਾਵ ਨ ਚਾਲਹਿ ਸੰਗਿ ॥",
      "transliteration": "sagal upaav na chaalahi sa(n)g ||",
      "translation": "Of all your efforts, none will go along with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਵਜਲੁ ਤਰੀਐ ਪ੍ਰਭ ਕੈ ਰੰਗਿ ॥੨॥",
      "transliteration": "bhavajal tareeai prabh kai ra(n)g ||2||",
      "translation": "You can cross over the terrifying world-ocean only through the love of God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੇਹੀ ਧੋਇ ਨ ਉਤਰੈ ਮੈਲੁ ॥",
      "transliteration": "dehee dhoi na utarai mail ||",
      "translation": "By merely washing the body, one's filth is not removed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹਉਮੈ ਬਿਆਪੈ ਦੁਬਿਧਾ ਫੈਲੁ ॥",
      "transliteration": "haumai biaapai dubidhaa phail ||",
      "translation": "Afflicted by egotism, duality only increases.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਅਉਖਧੁ ਜੋ ਜਨੁ ਖਾਇ ॥",
      "transliteration": "har har aukhadh jo jan khaai ||",
      "translation": "That humble being who takes the medicine of the Name of the Lord, Har, Har",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਾ ਕਾ ਰੋਗੁ ਸਗਲ ਮਿਟਿ ਜਾਇ ॥੩॥",
      "transliteration": "taa kaa rog sagal mit jaai ||3||",
      "translation": "- all his diseases are eradicated. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪਾਰਬ੍ਰਹਮ ਦਇਆਲ ॥",
      "transliteration": "kar kirapaa paarabraham daiaal ||",
      "translation": "Take pity on me, O merciful, Supreme Lord God;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨ ਤੇ ਕਬਹੁ ਨ ਬਿਸਰੁ ਗੋੁਪਾਲ ॥",
      "transliteration": "man te kabahu na bisar goupaal ||",
      "translation": "let me never forget the Lord of the World from my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੇਰੇ ਦਾਸ ਕੀ ਹੋਵਾ ਧੂਰਿ ॥",
      "transliteration": "tere daas kee hovaa dhoor ||",
      "translation": "Let me be the dust of the feet of Your slaves;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਕੀ ਪ੍ਰਭ ਸਰਧਾ ਪੂਰਿ ॥੪॥੨੨॥੩੩॥",
      "transliteration": "naanak kee prabh saradhaa poor ||4||22||33||",
      "translation": "O God, please fulfill Nanak's hope. ||4||22||33||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੇਰੀ ਸਰਣਿ ਪੂਰੇ ਗੁਰਦੇਵ ॥",
      "transliteration": "teree saran poore guradev ||",
      "translation": "You are my Protection, O perfect Divine Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤੁਧੁ ਬਿਨੁ ਦੂਜਾ ਨਾਹੀ ਕੋਇ ॥",
      "transliteration": "tudh bin doojaa naahee koi ||",
      "translation": "There is no other than You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤੂ ਸਮਰਥੁ ਪੂਰਨ ਪਾਰਬ੍ਰਹਮੁ ॥",
      "transliteration": "too samarath pooran paarabraham ||",
      "translation": "You are all-powerful, O perfect Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੋ ਧਿਆਏ ਪੂਰਾ ਜਿਸੁ ਕਰਮੁ ॥੧॥",
      "transliteration": "so dhiaae pooraa jis karam ||1||",
      "translation": "He alone meditates on You, whose karma is perfect. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਰਣ ਤਾਰਣ ਪ੍ਰਭ ਤੇਰੋ ਨਾਉ ॥",
      "transliteration": "taran taaran prabh tero naau ||",
      "translation": "You Name, God, is the boat to carry us across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਏਕਾ ਸਰਣਿ ਗਹੀ ਮਨ ਮੇਰੈ ਤੁਧੁ ਬਿਨੁ ਦੂਜਾ ਨਾਹੀ ਠਾਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ekaa saran gahee man merai tudh bin doojaa naahee thaau ||1|| rahaau ||",
      "translation": "My mind has grasped Your protection alone. Other than You, I have no place of rest at all. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਪਿ ਜਪਿ ਜੀਵਾ ਤੇਰਾ ਨਾਉ ॥",
      "transliteration": "jap jap jeevaa teraa naau ||",
      "translation": "Chanting, meditating on Your Name, I live,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਗੈ ਦਰਗਹ ਪਾਵਉ ਠਾਉ ॥",
      "transliteration": "aagai daragah paavau thaau ||",
      "translation": "and hereafter, I will obtain a seat in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਦੂਖੁ ਅੰਧੇਰਾ ਮਨ ਤੇ ਜਾਇ ॥",
      "transliteration": "dookh a(n)dheraa man te jaai ||",
      "translation": "Pain and darkness are gone from my mind;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੁਰਮਤਿ ਬਿਨਸੈ ਰਾਚੈ ਹਰਿ ਨਾਇ ॥੨॥",
      "transliteration": "duramat binasai raachai har naai ||2||",
      "translation": "my evil-mindedness is dispelled, and I am absorbed in the Lord's Name. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਸਿਉ ਲਾਗੀ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "charan kamal siu laagee preet ||",
      "translation": "I have enshrined love for the Lord's lotus feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕੀ ਨਿਰਮਲ ਰੀਤਿ ॥",
      "transliteration": "gur poore kee niramal reet ||",
      "translation": "The lifestyle of the Perfect Guru is immaculate and pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭਉ ਭਾਗਾ ਨਿਰਭਉ ਮਨਿ ਬਸੈ ॥",
      "transliteration": "bhau bhaagaa nirabhau man basai ||",
      "translation": "My fear has run away, and the fearless Lord dwells within my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਰਸਨਾ ਨਿਤ ਜਪੈ ॥੩॥",
      "transliteration": "a(n)mrit naam rasanaa nit japai ||3||",
      "translation": "My tongue continually chants the Ambrosial Naam, the Name of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕੋਟਿ ਜਨਮ ਕੇ ਕਾਟੇ ਫਾਹੇ ॥",
      "transliteration": "kot janam ke kaate phaahe ||",
      "translation": "The nooses of millions of incarnations are cut away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪਾਇਆ ਲਾਭੁ ਸਚਾ ਧਨੁ ਲਾਹੇ ॥",
      "transliteration": "paaiaa laabh sachaa dhan laahe ||",
      "translation": "I have obtained the profit of the true wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤੋਟਿ ਨ ਆਵੈ ਅਖੁਟ ਭੰਡਾਰ ॥",
      "transliteration": "tot na aavai akhut bha(n)daar ||",
      "translation": "This treasure is inexhaustible; it will never run out.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਨਕ ਭਗਤ ਸੋਹਹਿ ਹਰਿ ਦੁਆਰ ॥੪॥੨੩॥੩੪॥",
      "transliteration": "naanak bhagat sohahi har duaar ||4||23||34||",
      "translation": "O Nanak, the devotees look beautiful in the Court of the Lord. ||4||23||34||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਰਤਨ ਜਵੇਹਰ ਨਾਮ ॥",
      "transliteration": "ratan javehar naam ||",
      "translation": "The Naam, the Name of the Lord, is a jewel, a ruby.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਤੁ ਸੰਤੋਖੁ ਗਿਆਨ ॥",
      "transliteration": "sat sa(n)tokh giaan ||",
      "translation": "It brings Truth, contentment and spiritual wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਦਇਆ ਕਾ ਪੋਤਾ ॥",
      "transliteration": "sookh sahaj daiaa kaa potaa ||",
      "translation": "The Lord entrusts the treasures of peace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਹਰਿ ਭਗਤਾ ਹਵਾਲੈ ਹੋਤਾ ॥੧॥",
      "transliteration": "har bhagataa havaalai hotaa ||1||",
      "translation": "Intuition and kindness to His devotees. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮੇਰੇ ਰਾਮ ਕੋ ਭੰਡਾਰੁ ॥",
      "transliteration": "mere raam ko bha(n)daar ||",
      "translation": "This is the treasure of my Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਖਾਤ ਖਰਚਿ ਕਛੁ ਤੋਟਿ ਨ ਆਵੈ ਅੰਤੁ ਨਹੀ ਹਰਿ ਪਾਰਾਵਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "khaat kharach kachh tot na aavai a(n)t nahee har paaraavaar ||1|| rahaau ||",
      "translation": "Consuming and expending it, it is never used up. The Lord has no end or limitation. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕੀਰਤਨੁ ਨਿਰਮੋਲਕ ਹੀਰਾ ॥",
      "transliteration": "keeratan niramolak heeraa ||",
      "translation": "The Kirtan of the Lord's Praise is a priceless diamond.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਆਨੰਦ ਗੁਣੀ ਗਹੀਰਾ ॥",
      "transliteration": "aana(n)d gunee gaheeraa ||",
      "translation": "It is the ocean of bliss and virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਅਨਹਦ ਬਾਣੀ ਪੂੰਜੀ ॥",
      "transliteration": "anahad baanee poo(n)jee ||",
      "translation": "In the Word of the Guru's Bani is the wealth of the unstruck sound current.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0893_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸੰਤਨ ਹਥਿ ਰਾਖੀ ਕੂੰਜੀ ॥੨॥",
      "transliteration": "sa(n)tan hath raakhee koo(n)jee ||2||",
      "translation": "The Saints hold the key to it in their hands. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 893,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
