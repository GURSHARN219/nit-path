{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 894,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0894_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁੰਨ ਸਮਾਧਿ ਗੁਫਾ ਤਹ ਆਸਨੁ ॥",
      "transliteration": "su(n)n samaadh guphaa tah aasan ||",
      "translation": "They sit there, in the cave of deep Samaadhi;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੇਵਲ ਬ੍ਰਹਮ ਪੂਰਨ ਤਹ ਬਾਸਨੁ ॥",
      "transliteration": "keval braham pooran tah baasan ||",
      "translation": "the unique, perfect Lord God dwells there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭਗਤ ਸੰਗਿ ਪ੍ਰਭੁ ਗੋਸਟਿ ਕਰਤ ॥",
      "transliteration": "bhagat sa(n)g prabh gosat karat ||",
      "translation": "God holds conversations with His devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਹ ਹਰਖ ਨ ਸੋਗ ਨ ਜਨਮ ਨ ਮਰਤ ॥੩॥",
      "transliteration": "tah harakh na sog na janam na marat ||3||",
      "translation": "There is no pleasure or pain, no birth or death there. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਆਪਿ ਦਿਵਾਇਆ ॥",
      "transliteration": "kar kirapaa jis aap divaaiaa ||",
      "translation": "One whom the Lord Himself blesses with His Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਤਿਨਿ ਹਰਿ ਧਨੁ ਪਾਇਆ ॥",
      "transliteration": "saadhasa(n)g tin har dhan paaiaa ||",
      "translation": "obtains the Lord's wealth in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦਇਆਲ ਪੁਰਖ ਨਾਨਕ ਅਰਦਾਸਿ ॥",
      "transliteration": "daiaal purakh naanak aradaas ||",
      "translation": "Nanak prays to the merciful Primal Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਰਿ ਮੇਰੀ ਵਰਤਣਿ ਹਰਿ ਮੇਰੀ ਰਾਸਿ ॥੪॥੨੪॥੩੫॥",
      "transliteration": "har meree varatan har meree raas ||4||24||35||",
      "translation": "the Lord is my merchandise, and the Lord is my capital. ||4||24||35||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਹਿਮਾ ਨ ਜਾਨਹਿ ਬੇਦ ॥",
      "transliteration": "mahimaa na jaanahi bed ||",
      "translation": "The Vedas do not know His greatness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬ੍ਰਹਮੇ ਨਹੀ ਜਾਨਹਿ ਭੇਦ ॥",
      "transliteration": "brahame nahee jaanahi bhed ||",
      "translation": "Brahma does not know His mystery.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਵਤਾਰ ਨ ਜਾਨਹਿ ਅੰਤੁ ॥",
      "transliteration": "avataar na jaanahi a(n)t ||",
      "translation": "Incarnated beings do not know His limit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਰਮੇਸਰੁ ਪਾਰਬ੍ਰਹਮ ਬੇਅੰਤੁ ॥੧॥",
      "transliteration": "paramesar paarabraham bea(n)t ||1||",
      "translation": "The Transcendent Lord, the Supreme Lord God, is infinite. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਪਨੀ ਗਤਿ ਆਪਿ ਜਾਨੈ ॥",
      "transliteration": "apanee gat aap jaanai ||",
      "translation": "Only He Himself knows His own state.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁਣਿ ਸੁਣਿ ਅਵਰ ਵਖਾਨੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sun sun avar vakhaanai ||1|| rahaau ||",
      "translation": "Others speak of Him only by hearsay. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੰਕਰਾ ਨਹੀ ਜਾਨਹਿ ਭੇਵ ॥",
      "transliteration": "sa(n)karaa nahee jaanahi bhev ||",
      "translation": "Shiva does not know His mystery.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਖੋਜਤ ਹਾਰੇ ਦੇਵ ॥",
      "transliteration": "khojat haare dev ||",
      "translation": "The gods gave grown weary of searching for Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦੇਵੀਆ ਨਹੀ ਜਾਨੈ ਮਰਮ ॥",
      "transliteration": "deveeaa nahee jaanai maram ||",
      "translation": "The goddesses do not know His mystery.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਭ ਊਪਰਿ ਅਲਖ ਪਾਰਬ੍ਰਹਮ ॥੨॥",
      "transliteration": "sabh oopar alakh paarabraham ||2||",
      "translation": "Above all is the unseen, Supreme Lord God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਪਨੈ ਰੰਗਿ ਕਰਤਾ ਕੇਲ ॥",
      "transliteration": "apanai ra(n)g karataa kel ||",
      "translation": "The Creator Lord plays His own plays.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਪਿ ਬਿਛੋਰੈ ਆਪੇ ਮੇਲ ॥",
      "transliteration": "aap bichhorai aape mel ||",
      "translation": "He Himself separates, and He Himself unites.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਕਿ ਭਰਮੇ ਇਕਿ ਭਗਤੀ ਲਾਏ ॥",
      "transliteration": "ik bharame ik bhagatee laae ||",
      "translation": "Some wander around, while others are linked to His devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਪਣਾ ਕੀਆ ਆਪਿ ਜਣਾਏ ॥੩॥",
      "transliteration": "apanaa keeaa aap janaae ||3||",
      "translation": "By His actions, He makes Himself known. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੰਤਨ ਕੀ ਸੁਣਿ ਸਾਚੀ ਸਾਖੀ ॥",
      "transliteration": "sa(n)tan kee sun saachee saakhee ||",
      "translation": "Listen to the true story of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੋ ਬੋਲਹਿ ਜੋ ਪੇਖਹਿ ਆਖੀ ॥",
      "transliteration": "so bolahi jo pekhahi aakhee ||",
      "translation": "They speak only of what they see with their eyes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਹੀ ਲੇਪੁ ਤਿਸੁ ਪੁੰਨਿ ਨ ਪਾਪਿ ॥",
      "transliteration": "nahee lep tis pu(n)n na paap ||",
      "translation": "He is not involved with virtue or vice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਨਕ ਕਾ ਪ੍ਰਭੁ ਆਪੇ ਆਪਿ ॥੪॥੨੫॥੩੬॥",
      "transliteration": "naanak kaa prabh aape aap ||4||25||36||",
      "translation": "Nanak's God is Himself all-in-all. ||4||25||36||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਿਛਹੂ ਕਾਜੁ ਨ ਕੀਓ ਜਾਨਿ ॥",
      "transliteration": "kichhahoo kaaj na keeo jaan ||",
      "translation": "I have not tried to do anything through knowledge.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁਰਤਿ ਮਤਿ ਨਾਹੀ ਕਿਛੁ ਗਿਆਨਿ ॥",
      "transliteration": "surat mat naahee kichh giaan ||",
      "translation": "I have no knowledge, intelligence or spiritual wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾਪ ਤਾਪ ਸੀਲ ਨਹੀ ਧਰਮ ॥",
      "transliteration": "jaap taap seel nahee dharam ||",
      "translation": "I have not practiced chanting, deep meditation, humility or righteousness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿਛੂ ਨ ਜਾਨਉ ਕੈਸਾ ਕਰਮ ॥੧॥",
      "transliteration": "kichhoo na jaanau kaisaa karam ||1||",
      "translation": "I know nothing of such good karma. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਠਾਕੁਰ ਪ੍ਰੀਤਮ ਪ੍ਰਭ ਮੇਰੇ ॥",
      "transliteration": "thaakur preetam prabh mere ||",
      "translation": "O my Beloved God, my Lord and Master,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੁਝ ਬਿਨੁ ਦੂਜਾ ਅਵਰੁ ਨ ਕੋਈ ਭੂਲਹ ਚੂਕਹ ਪ੍ਰਭ ਤੇਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tujh bin doojaa avar na koee bhoolah chookah prabh tere ||1|| rahaau ||",
      "translation": "there is none other than You. Even though I wander and make mistakes, I am still Yours, God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਿਧਿ ਨ ਬੁਧਿ ਨ ਸਿਧਿ ਪ੍ਰਗਾਸੁ ॥",
      "transliteration": "ridh na budh na sidh pragaas ||",
      "translation": "I have no wealth, no intelligence, no miraculous spiritual powers; I am not enlightened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿਖੈ ਬਿਆਧਿ ਕੇ ਗਾਵ ਮਹਿ ਬਾਸੁ ॥",
      "transliteration": "bikhai biaadh ke gaav mahi baas ||",
      "translation": "I dwell in the village of corruption and sickness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਰਣਹਾਰ ਮੇਰੇ ਪ੍ਰਭ ਏਕ ॥",
      "transliteration": "karanahaar mere prabh ek ||",
      "translation": "O my One Creator Lord God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਮ ਤੇਰੇ ਕੀ ਮਨ ਮਹਿ ਟੇਕ ॥੨॥",
      "transliteration": "naam tere kee man mahi tek ||2||",
      "translation": "Your Name is the support of my mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੁਣਿ ਸੁਣਿ ਜੀਵਉ ਮਨਿ ਇਹੁ ਬਿਸ੍ਰਾਮੁ ॥",
      "transliteration": "sun sun jeevau man ihu bisraam ||",
      "translation": "Hearing, hearing Your Name, I live; this is my mind's consolation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਾਪ ਖੰਡਨ ਪ੍ਰਭ ਤੇਰੋ ਨਾਮੁ ॥",
      "transliteration": "paap kha(n)dan prabh tero naam ||",
      "translation": "Your Name, God, is the Destroyer of sins.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੂ ਅਗਨਤੁ ਜੀਅ ਕਾ ਦਾਤਾ ॥",
      "transliteration": "too aganat jee kaa daataa ||",
      "translation": "You, O Limitless Lord, are the Giver of the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਸਹਿ ਜਣਾਵਹਿ ਤਿਨਿ ਤੂ ਜਾਤਾ ॥੩॥",
      "transliteration": "jisahi janaavahi tin too jaataa ||3||",
      "translation": "He alone knows You, unto whom You reveal Yourself. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੋ ਉਪਾਇਓ ਤਿਸੁ ਤੇਰੀ ਆਸ ॥",
      "transliteration": "jo upaaio tis teree aas ||",
      "translation": "Whoever has been created, rests his hopes in You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਗਲ ਅਰਾਧਹਿ ਪ੍ਰਭ ਗੁਣਤਾਸ ॥",
      "transliteration": "sagal araadhahi prabh gunataas ||",
      "translation": "All worship and adore You, God, O treasure of excellence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਤੇਰੈ ਕੁਰਬਾਣੁ ॥",
      "transliteration": "naanak daas terai kurabaan ||",
      "translation": "Slave Nanak is a sacrifice to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬੇਅੰਤ ਸਾਹਿਬੁ ਮੇਰਾ ਮਿਹਰਵਾਣੁ ॥੪॥੨੬॥੩੭॥",
      "transliteration": "bea(n)t saahib meraa miharavaan ||4||26||37||",
      "translation": "My merciful Lord and Master is infinite. ||4||26||37||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਖਨਹਾਰ ਦਇਆਲ ॥",
      "transliteration": "raakhanahaar daiaal ||",
      "translation": "The Savior Lord is merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕੋਟਿ ਭਵ ਖੰਡੇ ਨਿਮਖ ਖਿਆਲ ॥",
      "transliteration": "kot bhav kha(n)de nimakh khiaal ||",
      "translation": "Millions of incarnations are eradicated in an instant, contemplating the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਗਲ ਅਰਾਧਹਿ ਜੰਤ ॥",
      "transliteration": "sagal araadhahi ja(n)t ||",
      "translation": "All beings worship and adore Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮਿਲੀਐ ਪ੍ਰਭ ਗੁਰ ਮਿਲਿ ਮੰਤ ॥੧॥",
      "transliteration": "mileeai prabh gur mil ma(n)t ||1||",
      "translation": "Receiving the Guru's Mantra, one meets God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜੀਅਨ ਕੋ ਦਾਤਾ ਮੇਰਾ ਪ੍ਰਭੁ ॥",
      "transliteration": "jeean ko daataa meraa prabh ||",
      "translation": "My God is the Giver of souls.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਪੂਰਨ ਪਰਮੇਸੁਰ ਸੁਆਮੀ ਘਟਿ ਘਟਿ ਰਾਤਾ ਮੇਰਾ ਪ੍ਰਭੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "pooran paramesur suaamee ghat ghat raataa meraa prabh ||1|| rahaau ||",
      "translation": "The Perfect Transcendent Lord Master, my God, imbues each and every heart. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਾ ਕੀ ਗਹੀ ਮਨ ਓਟ ॥",
      "transliteration": "taa kee gahee man ot ||",
      "translation": "My mind has grasped His Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਬੰਧਨ ਤੇ ਹੋਈ ਛੋਟ ॥",
      "transliteration": "ba(n)dhan te hoee chhot ||",
      "translation": "My bonds have been shattered.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਹਿਰਦੈ ਜਪਿ ਪਰਮਾਨੰਦ ॥",
      "transliteration": "hiradai jap paramaana(n)d ||",
      "translation": "Within my heart, I meditate on the Lord, the embodiment of supreme bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮਨ ਮਾਹਿ ਭਏ ਅਨੰਦ ॥੨॥",
      "transliteration": "man maahi bhae ana(n)d ||2||",
      "translation": "My mind is filled with ecstasy. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤਾਰਣ ਤਰਣ ਹਰਿ ਸਰਣ ॥",
      "transliteration": "taaran taran har saran ||",
      "translation": "The Lord's Sanctuary is the boat to carry us across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0894_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜੀਵਨ ਰੂਪ ਹਰਿ ਚਰਣ ॥",
      "transliteration": "jeevan roop har charan ||",
      "translation": "The Lord's Feet are the embodiment of life itself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 894,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
