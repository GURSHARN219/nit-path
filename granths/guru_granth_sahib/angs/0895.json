{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 895,
  "lineCount": 63,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0895_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੰਤਨ ਕੇ ਪ੍ਰਾਣ ਅਧਾਰ ॥",
      "transliteration": "sa(n)tan ke praan adhaar ||",
      "translation": "They are the Support of the breath of life of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਊਚੇ ਤੇ ਊਚ ਅਪਾਰ ॥੩॥",
      "transliteration": "ooche te ooch apaar ||3||",
      "translation": "God is infinite, the highest of the high. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੁ ਮਤਿ ਸਾਰੁ ਜਿਤੁ ਹਰਿ ਸਿਮਰੀਜੈ ॥",
      "transliteration": "s mat saar jit har simareejai ||",
      "translation": "That mind is excellent and sublime, which meditates in remembrance on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਆਪੇ ਦੀਜੈ ॥",
      "transliteration": "kar kirapaa jis aape deejai ||",
      "translation": "In His Mercy, the Lord Himself bestows it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਆਨੰਦ ਹਰਿ ਨਾਉ ॥",
      "transliteration": "sookh sahaj aana(n)d har naau ||",
      "translation": "Peace, intuitive poise and bliss are found in the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਨਕ ਜਪਿਆ ਗੁਰ ਮਿਲਿ ਨਾਉ ॥੪॥੨੭॥੩੮॥",
      "transliteration": "naanak japiaa gur mil naau ||4||27||38||",
      "translation": "Meeting with the Guru, Nanak chants the Name. ||4||27||38||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਗਲ ਸਿਆਨਪ ਛਾਡਿ ॥",
      "transliteration": "sagal siaanap chhaad ||",
      "translation": "Abandon all your clever tricks.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਰਿ ਸੇਵਾ ਸੇਵਕ ਸਾਜਿ ॥",
      "transliteration": "kar sevaa sevak saaj ||",
      "translation": "Become His servant, and serve Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਪਨਾ ਆਪੁ ਸਗਲ ਮਿਟਾਇ ॥",
      "transliteration": "apanaa aap sagal mitaai ||",
      "translation": "Totally erase your self-conceit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਨ ਚਿੰਦੇ ਸੇਈ ਫਲ ਪਾਇ ॥੧॥",
      "transliteration": "man chi(n)de seee phal paai ||1||",
      "translation": "You shall obtain the fruits of your mind's desires. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹੋਹੁ ਸਾਵਧਾਨ ਅਪੁਨੇ ਗੁਰ ਸਿਉ ॥",
      "transliteration": "hohu saavadhaan apune gur siu ||",
      "translation": "Be awake and aware with your Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਸਾ ਮਨਸਾ ਪੂਰਨ ਹੋਵੈ ਪਾਵਹਿ ਸਗਲ ਨਿਧਾਨ ਗੁਰ ਸਿਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aasaa manasaa pooran hovai paavahi sagal nidhaan gur siu ||1|| rahaau ||",
      "translation": "Your hopes and desires shall be fulfilled, and you shall obtain all treasures from the Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੂਜਾ ਨਹੀ ਜਾਨੈ ਕੋਇ ॥",
      "transliteration": "doojaa nahee jaanai koi ||",
      "translation": "Let no one think that God and Guru are separate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਤਗੁਰੁ ਨਿਰੰਜਨੁ ਸੋਇ ॥",
      "transliteration": "satagur nira(n)jan soi ||",
      "translation": "The True Guru is the Immaculate Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਾਨੁਖ ਕਾ ਕਰਿ ਰੂਪੁ ਨ ਜਾਨੁ ॥",
      "transliteration": "maanukh kaa kar roop na jaan ||",
      "translation": "Do not believe that He is a mere human being;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਿਲੀ ਨਿਮਾਨੇ ਮਾਨੁ ॥੨॥",
      "transliteration": "milee nimaane maan ||2||",
      "translation": "He gives honor to the dishonored. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰ ਕੀ ਹਰਿ ਟੇਕ ਟਿਕਾਇ ॥",
      "transliteration": "gur kee har tek tikaai ||",
      "translation": "Hold tight to the Support of the Guru, the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਵਰ ਆਸਾ ਸਭ ਲਾਹਿ ॥",
      "transliteration": "avar aasaa sabh laahi ||",
      "translation": "Give up all other hopes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਮਾਗੁ ਨਿਧਾਨੁ ॥",
      "transliteration": "har kaa naam maag nidhaan ||",
      "translation": "Ask for the treasure of the Name of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤਾ ਦਰਗਹ ਪਾਵਹਿ ਮਾਨੁ ॥੩॥",
      "transliteration": "taa daragah paavahi maan ||3||",
      "translation": "and then you shall be honored in the Court of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰ ਕਾ ਬਚਨੁ ਜਪਿ ਮੰਤੁ ॥",
      "transliteration": "gur kaa bachan jap ma(n)t ||",
      "translation": "Chant the Mantra of the Guru's Word.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਏਹਾ ਭਗਤਿ ਸਾਰ ਤਤੁ ॥",
      "transliteration": "ehaa bhagat saar tat ||",
      "translation": "This is the essence of true devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਤਿਗੁਰ ਭਏ ਦਇਆਲ ॥",
      "transliteration": "satigur bhae daiaal ||",
      "translation": "When the True Guru becomes merciful,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਨਿਹਾਲ ॥੪॥੨੮॥੩੯॥",
      "transliteration": "naanak daas nihaal ||4||28||39||",
      "translation": "slave Nanak is enraptured. ||4||28||39||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੋਵੈ ਸੋਈ ਭਲ ਮਾਨੁ ॥",
      "transliteration": "hovai soee bhal maan ||",
      "translation": "Whatever happens, accept that as good.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਆਪਨਾ ਤਜਿ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "aapanaa taj abhimaan ||",
      "translation": "Leave your egotistical pride behind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦਿਨੁ ਰੈਨਿ ਸਦਾ ਗੁਨ ਗਾਉ ॥",
      "transliteration": "din rain sadaa gun gaau ||",
      "translation": "Day and night, continually sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪੂਰਨ ਏਹੀ ਸੁਆਉ ॥੧॥",
      "transliteration": "pooran ehee suaau ||1||",
      "translation": "This is the perfect purpose of human life. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਨੰਦ ਕਰਿ ਸੰਤ ਹਰਿ ਜਪਿ ॥",
      "transliteration": "aana(n)d kar sa(n)t har jap ||",
      "translation": "Meditate on the Lord, O Saints, and be in bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਛਾਡਿ ਸਿਆਨਪ ਬਹੁ ਚਤੁਰਾਈ ਗੁਰ ਕਾ ਜਪਿ ਮੰਤੁ ਨਿਰਮਲ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "chhaad siaanap bahu chaturaaee gur kaa jap ma(n)t niramal ||1|| rahaau ||",
      "translation": "Renounce your cleverness and all your tricks. Chant the Immaculate Chant of the Guru's Mantra. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਏਕ ਕੀ ਕਰਿ ਆਸ ਭੀਤਰਿ ॥",
      "transliteration": "ek kee kar aas bheetar ||",
      "translation": "Place the hopes of your mind in the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਿਰਮਲ ਜਪਿ ਨਾਮੁ ਹਰਿ ਹਰਿ ॥",
      "transliteration": "niramal jap naam har har ||",
      "translation": "Chant the Immaculate Name of the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਨ ਨਮਸਕਾਰਿ ॥",
      "transliteration": "gur ke charan namasakaar ||",
      "translation": "Bow down to the Guru's Feet,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਵਜਲੁ ਉਤਰਹਿ ਪਾਰਿ ॥੨॥",
      "transliteration": "bhavajal utarahi paar ||2||",
      "translation": "and cross over the terrifying world-ocean. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਦੇਵਨਹਾਰ ਦਾਤਾਰ ॥",
      "transliteration": "devanahaar daataar ||",
      "translation": "The Lord God is the Great Giver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅੰਤੁ ਨ ਪਾਰਾਵਾਰ ॥",
      "transliteration": "a(n)t na paaraavaar ||",
      "translation": "He has no end or limitation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾ ਕੈ ਘਰਿ ਸਰਬ ਨਿਧਾਨ ॥",
      "transliteration": "jaa kai ghar sarab nidhaan ||",
      "translation": "All treasures are in His home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਾਖਨਹਾਰ ਨਿਦਾਨ ॥੩॥",
      "transliteration": "raakhanahaar nidaan ||3||",
      "translation": "He will be your Saving Grace in the end. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਨਕ ਪਾਇਆ ਏਹੁ ਨਿਧਾਨ ॥",
      "transliteration": "naanak paaiaa ehu nidhaan ||",
      "translation": "Nanak has obtained this treasure,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਹਰੇ ਹਰਿ ਨਿਰਮਲ ਨਾਮ ॥",
      "transliteration": "hare har niramal naam ||",
      "translation": "the immaculate Name of the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੋ ਜਪੈ ਤਿਸ ਕੀ ਗਤਿ ਹੋਇ ॥",
      "transliteration": "jo japai tis kee gat hoi ||",
      "translation": "Whoever chants it, is emancipated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਕਰਮਿ ਪਰਾਪਤਿ ਹੋਇ ॥੪॥੨੯॥੪੦॥",
      "transliteration": "naanak karam paraapat hoi ||4||29||40||",
      "translation": "It is obtained only by His Grace. ||4||29||40||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੁਲਭ ਦੇਹ ਸਵਾਰਿ ॥",
      "transliteration": "dulabh deh savaar ||",
      "translation": "Make this invaluable human life fruitful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਾਹਿ ਨ ਦਰਗਹ ਹਾਰਿ ॥",
      "transliteration": "jaahi na daragah haar ||",
      "translation": "You shall not be destroyed when you go to the Lord's Court.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹਲਤਿ ਪਲਤਿ ਤੁਧੁ ਹੋਇ ਵਡਿਆਈ ॥",
      "transliteration": "halat palat tudh hoi vadiaaee ||",
      "translation": "In this world and the next, you shall obtain honor and glory.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅੰਤ ਕੀ ਬੇਲਾ ਲਏ ਛਡਾਈ ॥੧॥",
      "transliteration": "a(n)t kee belaa lae chhadaaee ||1||",
      "translation": "At the very last moment, He will save you. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਰਾਮ ਕੇ ਗੁਨ ਗਾਉ ॥",
      "transliteration": "raam ke gun gaau ||",
      "translation": "Sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਲਤੁ ਪਲਤੁ ਹੋਹਿ ਦੋਵੈ ਸੁਹੇਲੇ ਅਚਰਜ ਪੁਰਖੁ ਧਿਆਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "halat palat hohi dovai suhele acharaj purakh dhiaau ||1|| rahaau ||",
      "translation": "In both this world and the next, you shall be embellished with beauty, meditating on the wondrous Primal Lord God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਊਠਤ ਬੈਠਤ ਹਰਿ ਜਾਪੁ ॥",
      "transliteration": "oothat baithat har jaap ||",
      "translation": "While standing up and sitting down, meditate on the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬਿਨਸੈ ਸਗਲ ਸੰਤਾਪੁ ॥",
      "transliteration": "binasai sagal sa(n)taap ||",
      "translation": "and all your troubles shall depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਬੈਰੀ ਸਭਿ ਹੋਵਹਿ ਮੀਤ ॥",
      "transliteration": "bairee sabh hovahi meet ||",
      "translation": "All your enemies will become friends.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਿਰਮਲੁ ਤੇਰਾ ਹੋਵੈ ਚੀਤ ॥੨॥",
      "transliteration": "niramal teraa hovai cheet ||2||",
      "translation": "Your consciousness shall be immaculate and pure. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਭ ਤੇ ਊਤਮ ਇਹੁ ਕਰਮੁ ॥",
      "transliteration": "sabh te ootam ihu karam ||",
      "translation": "This is the most exalted deed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸਗਲ ਧਰਮ ਮਹਿ ਸ੍ਰੇਸਟ ਧਰਮੁ ॥",
      "transliteration": "sagal dharam mahi sresat dharam ||",
      "translation": "Of all faiths, this is the most sublime and excellent faith.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨਿ ਤੇਰਾ ਹੋਇ ਉਧਾਰੁ ॥",
      "transliteration": "har simaran teraa hoi udhaar ||",
      "translation": "Meditating in remembrance on the Lord, you shall be saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕਾ ਉਤਰੈ ਭਾਰੁ ॥੩॥",
      "transliteration": "janam janam kaa utarai bhaar ||3||",
      "translation": "You shall be rid of the burden of countless incarnations. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਪੂਰਨ ਤੇਰੀ ਹੋਵੈ ਆਸ ॥",
      "transliteration": "pooran teree hovai aas ||",
      "translation": "Your hopes shall be fulfilled,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਜਮ ਕੀ ਕਟੀਐ ਤੇਰੀ ਫਾਸ ॥",
      "transliteration": "jam kee kateeai teree phaas ||",
      "translation": "and the noose of the Messenger of Death will be cut away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਗੁਰ ਕਾ ਉਪਦੇਸੁ ਸੁਨੀਜੈ ॥",
      "transliteration": "gur kaa upades suneejai ||",
      "translation": "So listen to the Guru's Teachings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0895_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਨਾਨਕ ਸੁਖਿ ਸਹਜਿ ਸਮੀਜੈ ॥੪॥੩੦॥੪੧॥",
      "transliteration": "naanak sukh sahaj sameejai ||4||30||41||",
      "translation": "O Nanak, you shall be absorbed in celestial peace. ||4||30||41||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 895,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
