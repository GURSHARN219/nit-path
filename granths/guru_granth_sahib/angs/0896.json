{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 896,
  "lineCount": 62,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0896_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਸ ਕੀ ਤਿਸ ਕੀ ਕਰਿ ਮਾਨੁ ॥",
      "transliteration": "jis kee tis kee kar maan ||",
      "translation": "Honor the One, to whom everything belongs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਪਨ ਲਾਹਿ ਗੁਮਾਨੁ ॥",
      "transliteration": "aapan laahi gumaan ||",
      "translation": "Leave your egotistical pride behind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਿਸ ਕਾ ਤੂ ਤਿਸ ਕਾ ਸਭੁ ਕੋਇ ॥",
      "transliteration": "jis kaa too tis kaa sabh koi ||",
      "translation": "You belong to Him; everyone belongs to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਸਹਿ ਅਰਾਧਿ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥੧॥",
      "transliteration": "tisahi araadh sadaa sukh hoi ||1||",
      "translation": "Worship and adore Him, and you shall be at peace forever. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਹੇ ਭ੍ਰਮਿ ਭ੍ਰਮਹਿ ਬਿਗਾਨੇ ॥",
      "transliteration": "kaahe bhram bhramahi bigaane ||",
      "translation": "Why do you wander in doubt, you fool?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਕਿਛੁ ਕਾਮਿ ਨ ਆਵੈ ਮੇਰਾ ਮੇਰਾ ਕਰਿ ਬਹੁਤੁ ਪਛੁਤਾਨੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naam binaa kichh kaam na aavai meraa meraa kar bahut pachhutaane ||1|| rahaau ||",
      "translation": "Without the Naam, the Name of the Lord, nothing is of any use at all. Crying out, 'Mine, mine', a great many have departed, regretfully repenting. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੋ ਜੋ ਕਰੈ ਸੋਈ ਮਾਨਿ ਲੇਹੁ ॥",
      "transliteration": "jo jo karai soee maan lehu ||",
      "translation": "Whatever the Lord has done, accept that as good.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਨੁ ਮਾਨੇ ਰਲਿ ਹੋਵਹਿ ਖੇਹ ॥",
      "transliteration": "bin maane ral hovahi kheh ||",
      "translation": "Without accepting, you shall mingle with dust.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤਿਸ ਕਾ ਭਾਣਾ ਲਾਗੈ ਮੀਠਾ ॥",
      "transliteration": "tis kaa bhaanaa laagai meethaa ||",
      "translation": "His Will seems sweet to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਵਿਰਲੇ ਮਨਿ ਵੂਠਾ ॥੨॥",
      "transliteration": "gur prasaad virale man voothaa ||2||",
      "translation": "By Guru's Grace, He comes to dwell in the mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਵੇਪਰਵਾਹੁ ਅਗੋਚਰੁ ਆਪਿ ॥",
      "transliteration": "veparavaahu agochar aap ||",
      "translation": "He Himself is carefree and independent, imperceptible.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਠ ਪਹਰ ਮਨ ਤਾ ਕਉ ਜਾਪਿ ॥",
      "transliteration": "aath pahar man taa kau jaap ||",
      "translation": "Twenty-four hours a day, O mind, meditate on Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਸੁ ਚਿਤਿ ਆਏ ਬਿਨਸਹਿ ਦੁਖਾ ॥",
      "transliteration": "jis chit aae binasahi dukhaa ||",
      "translation": "When He comes into the consciousness, pain is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹਲਤਿ ਪਲਤਿ ਤੇਰਾ ਊਜਲ ਮੁਖਾ ॥੩॥",
      "transliteration": "halat palat teraa oojal mukhaa ||3||",
      "translation": "Here and hereafter, your face shall be radiant and bright. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਉਨ ਕਉਨ ਉਧਰੇ ਗੁਨ ਗਾਇ ॥",
      "transliteration": "kaun kaun udhare gun gaai ||",
      "translation": "Who, and how many have been saved, singing the Glorious Praises of the Lord?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗਨਣੁ ਨ ਜਾਈ ਕੀਮ ਨ ਪਾਇ ॥",
      "transliteration": "ganan na jaaee keem na paai ||",
      "translation": "They cannot be counted or evaluated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬੂਡਤ ਲੋਹ ਸਾਧਸੰਗਿ ਤਰੈ ॥",
      "transliteration": "boodat loh saadhasa(n)g tarai ||",
      "translation": "Even the sinking iron is saved, in the Saadh Sangat, the Company of the Holy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਜਿਸਹਿ ਪਰਾਪਤਿ ਕਰੈ ॥੪॥੩੧॥੪੨॥",
      "transliteration": "naanak jisahi paraapat karai ||4||31||42||",
      "translation": "O Nanak, as His Grace is received. ||4||31||42||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਨ ਮਾਹਿ ਜਾਪਿ ਭਗਵੰਤੁ ॥",
      "transliteration": "man maahi jaap bhagava(n)t ||",
      "translation": "In your mind, meditate on the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਇਹੁ ਦੀਨੋ ਮੰਤੁ ॥",
      "transliteration": "gur poorai ihu deeno ma(n)t ||",
      "translation": "This is the Teaching given by the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਿਟੇ ਸਗਲ ਭੈ ਤ੍ਰਾਸ ॥",
      "transliteration": "mite sagal bhai traas ||",
      "translation": "All fears and terrors are taken away,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪੂਰਨ ਹੋਈ ਆਸ ॥੧॥",
      "transliteration": "pooran hoee aas ||1||",
      "translation": "and your hopes shall be fulfilled. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਫਲ ਸੇਵਾ ਗੁਰਦੇਵਾ ॥",
      "transliteration": "saphal sevaa guradevaa ||",
      "translation": "Service to the Divine Guru is fruitful and rewarding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕੀਮਤਿ ਕਿਛੁ ਕਹਣੁ ਨ ਜਾਈ ਸਾਚੇ ਸਚੁ ਅਲਖ ਅਭੇਵਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "keemat kichh kahan na jaaee saache sach alakh abhevaa ||1|| rahaau ||",
      "translation": "His value cannot be described; the True Lord is unseen and mysterious. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਆਪਿ ॥",
      "transliteration": "karan karaavan aap ||",
      "translation": "He Himself is the Doer, the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਿਸ ਕਉ ਸਦਾ ਮਨ ਜਾਪਿ ॥",
      "transliteration": "tis kau sadaa man jaap ||",
      "translation": "Meditate on Him forever, O my mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਸ ਕੀ ਸੇਵਾ ਕਰਿ ਨੀਤ ॥",
      "transliteration": "tis kee sevaa kar neet ||",
      "translation": "And continually serve Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਚੁ ਸਹਜੁ ਸੁਖੁ ਪਾਵਹਿ ਮੀਤ ॥੨॥",
      "transliteration": "sach sahaj sukh paavahi meet ||2||",
      "translation": "You shall be blessed with truth, intuition and peace, O my friend. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਾਹਿਬੁ ਮੇਰਾ ਅਤਿ ਭਾਰਾ ॥",
      "transliteration": "saahib meraa at bhaaraa ||",
      "translation": "My Lord and Master is so very great.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਥਾਪਿ ਉਥਾਪਨਹਾਰਾ ॥",
      "transliteration": "khin mahi thaap uthaapanahaaraa ||",
      "translation": "In an instant, He establishes and disestablishes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਿਸੁ ਬਿਨੁ ਅਵਰੁ ਨ ਕੋਈ ॥",
      "transliteration": "tis bin avar na koee ||",
      "translation": "There is no other than Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਨ ਕਾ ਰਾਖਾ ਸੋਈ ॥੩॥",
      "transliteration": "jan kaa raakhaa soee ||3||",
      "translation": "He is the Saving Grace of His humble servant. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਅਰਦਾਸਿ ਸੁਣੀਜੈ ॥",
      "transliteration": "kar kirapaa aradaas suneejai ||",
      "translation": "Please take pity on me, and hear my prayer,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਪਣੇ ਸੇਵਕ ਕਉ ਦਰਸਨੁ ਦੀਜੈ ॥",
      "transliteration": "apane sevak kau darasan deejai ||",
      "translation": "that Your servant may behold the Blessed Vision of Your Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕ ਜਾਪੀ ਜਪੁ ਜਾਪੁ ॥",
      "transliteration": "naanak jaapee jap jaap ||",
      "translation": "Nanak chants the Chant of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭ ਤੇ ਊਚ ਜਾ ਕਾ ਪਰਤਾਪੁ ॥੪॥੩੨॥੪੩॥",
      "transliteration": "sabh te ooch jaa kaa parataap ||4||32||43||",
      "translation": "whose glory and radiance are the highest of all. ||4||32||43||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਰਥਾ ਭਰਵਾਸਾ ਲੋਕ ॥",
      "transliteration": "birathaa bharavaasaa lok ||",
      "translation": "Reliance on mortal man is useless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਠਾਕੁਰ ਪ੍ਰਭ ਤੇਰੀ ਟੇਕ ॥",
      "transliteration": "thaakur prabh teree tek ||",
      "translation": "O God, my Lord and Master, You are my only Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਵਰ ਛੂਟੀ ਸਭ ਆਸ ॥",
      "transliteration": "avar chhootee sabh aas ||",
      "translation": "I have discarded all other hopes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਚਿੰਤ ਠਾਕੁਰ ਭੇਟੇ ਗੁਣਤਾਸ ॥੧॥",
      "transliteration": "achi(n)t thaakur bhete gunataas ||1||",
      "translation": "I have met with my carefree Lord and Master, the treasure of virtue. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਏਕੋ ਨਾਮੁ ਧਿਆਇ ਮਨ ਮੇਰੇ ॥",
      "transliteration": "eko naam dhiaai man mere ||",
      "translation": "Meditate on the Name of the Lord alone, O my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਾਰਜੁ ਤੇਰਾ ਹੋਵੈ ਪੂਰਾ ਹਰਿ ਹਰਿ ਹਰਿ ਗੁਣ ਗਾਇ ਮਨ ਮੇਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kaaraj teraa hovai pooraa har har har gun gaai man mere ||1|| rahaau ||",
      "translation": "Your affairs shall be perfectly resolved; sing the Glorious Praises of the Lord, Har, Har, Har, O my mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤੁਮ ਹੀ ਕਾਰਨ ਕਰਨ ॥",
      "transliteration": "tum hee kaaran karan ||",
      "translation": "You are the Doer, the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਹਰਿ ਸਰਨ ॥",
      "transliteration": "charan kamal har saran ||",
      "translation": "Your lotus feet, Lord, are my Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਨਿ ਤਨਿ ਹਰਿ ਓਹੀ ਧਿਆਇਆ ॥",
      "transliteration": "man tan har ohee dhiaaiaa ||",
      "translation": "I meditate on the Lord in my mind and body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਆਨੰਦ ਹਰਿ ਰੂਪ ਦਿਖਾਇਆ ॥੨॥",
      "transliteration": "aana(n)d har roop dikhaaiaa ||2||",
      "translation": "The blissful Lord has revealed His form to me. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਿਸ ਹੀ ਕੀ ਓਟ ਸਦੀਵ ॥",
      "transliteration": "tis hee kee ot sadeev ||",
      "translation": "I seek His eternal support;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਾ ਕੇ ਕੀਨੇ ਹੈ ਜੀਵ ॥",
      "transliteration": "jaa ke keene hai jeev ||",
      "translation": "He is the Creator of all beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਿਮਰਤ ਹਰਿ ਕਰਤ ਨਿਧਾਨ ॥",
      "transliteration": "simarat har karat nidhaan ||",
      "translation": "Remembering the Lord in meditation, the treasure is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਰਾਖਨਹਾਰ ਨਿਦਾਨ ॥੩॥",
      "transliteration": "raakhanahaar nidaan ||3||",
      "translation": "At the very last instant, He shall be your Savior. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਰਬ ਕੀ ਰੇਣ ਹੋਵੀਜੈ ॥",
      "transliteration": "sarab kee ren hoveejai ||",
      "translation": "Be the dust of all men's feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਆਪੁ ਮਿਟਾਇ ਮਿਲੀਜੈ ॥",
      "transliteration": "aap mitaai mileejai ||",
      "translation": "Eradicate self-conceit, and merge in the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਅਨਦਿਨੁ ਧਿਆਈਐ ਨਾਮੁ ॥",
      "transliteration": "anadin dhiaaeeai naam ||",
      "translation": "Night and day, meditate on the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸਫਲ ਨਾਨਕ ਇਹੁ ਕਾਮੁ ॥੪॥੩੩॥੪੪॥",
      "transliteration": "saphal naanak ihu kaam ||4||33||44||",
      "translation": "O Nanak, this is the most rewarding activity. ||4||33||44||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਕਾਰਨ ਕਰਨ ਕਰੀਮ ॥",
      "transliteration": "kaaran karan kareem ||",
      "translation": "He is the Doer, the Cause of causes, the bountiful Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸਰਬ ਪ੍ਰਤਿਪਾਲ ਰਹੀਮ ॥",
      "transliteration": "sarab pratipaal raheem ||",
      "translation": "The merciful Lord cherishes all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਅਲਹ ਅਲਖ ਅਪਾਰ ॥",
      "transliteration": "alah alakh apaar ||",
      "translation": "The Lord is unseen and infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0896_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਖੁਦਿ ਖੁਦਾਇ ਵਡ ਬੇਸੁਮਾਰ ॥੧॥",
      "transliteration": "khud khudaai vad besumaar ||1||",
      "translation": "God is great and endless. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 896,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
