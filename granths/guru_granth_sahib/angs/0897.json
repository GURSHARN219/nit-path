{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 897,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0897_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਓੁਂ ਨਮੋ ਭਗਵੰਤ ਗੁਸਾਈ ॥",
      "transliteration": "ou(n) namo bhagava(n)t gusaaee ||",
      "translation": "I humbly pray to invoke the Universal Lord God, the Lord of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਖਾਲਕੁ ਰਵਿ ਰਹਿਆ ਸਰਬ ਠਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "khaalak rav rahiaa sarab thaaee ||1|| rahaau ||",
      "translation": "The Creator Lord is all-pervading, everywhere. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਗੰਨਾਥ ਜਗਜੀਵਨ ਮਾਧੋ ॥",
      "transliteration": "jaga(n)naath jagajeevan maadho ||",
      "translation": "He is the Lord of the Universe, the Life of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਉ ਭੰਜਨ ਰਿਦ ਮਾਹਿ ਅਰਾਧੋ ॥",
      "transliteration": "bhau bha(n)jan rid maahi araadho ||",
      "translation": "Within your heart, worship and adore the Destroyer of fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਿਖੀਕੇਸ ਗੋਪਾਲ ਗੋੁਵਿੰਦ ॥",
      "transliteration": "rikheekes gopaal gouvi(n)d ||",
      "translation": "The Master Rishi of the senses, Lord of the World, Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪੂਰਨ ਸਰਬਤ੍ਰ ਮੁਕੰਦ ॥੨॥",
      "transliteration": "pooran sarabatr muka(n)d ||2||",
      "translation": "He is perfect, ever-present everywhere, the Liberator. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਿਹਰਵਾਨ ਮਉਲਾ ਤੂਹੀ ਏਕ ॥",
      "transliteration": "miharavaan maulaa toohee ek ||",
      "translation": "You are the One and only merciful Master,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪੀਰ ਪੈਕਾਂਬਰ ਸੇਖ ॥",
      "transliteration": "peer paikaa(n)bar sekh ||",
      "translation": "spiritual teacher, prophet, religious teacher.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦਿਲਾ ਕਾ ਮਾਲਕੁ ਕਰੇ ਹਾਕੁ ॥",
      "transliteration": "dilaa kaa maalak kare haak ||",
      "translation": "Master of hearts, Dispenser of justice,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕੁਰਾਨ ਕਤੇਬ ਤੇ ਪਾਕੁ ॥੩॥",
      "transliteration": "kuraan kateb te paak ||3||",
      "translation": "more sacred than the Koran and the Bible. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਰਾਇਣ ਨਰਹਰ ਦਇਆਲ ॥",
      "transliteration": "naaraain narahar daiaal ||",
      "translation": "The Lord is powerful and merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਮਤ ਰਾਮ ਘਟ ਘਟ ਆਧਾਰ ॥",
      "transliteration": "ramat raam ghat ghat aadhaar ||",
      "translation": "The all-pervading Lord is the support of each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਾਸੁਦੇਵ ਬਸਤ ਸਭ ਠਾਇ ॥",
      "transliteration": "baasudev basat sabh thaai ||",
      "translation": "The luminous Lord dwells everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਲੀਲਾ ਕਿਛੁ ਲਖੀ ਨ ਜਾਇ ॥੪॥",
      "transliteration": "leelaa kichh lakhee na jaai ||4||",
      "translation": "His play cannot be known. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਿਹਰ ਦਇਆ ਕਰਿ ਕਰਨੈਹਾਰ ॥",
      "transliteration": "mihar daiaa kar karanaihaar ||",
      "translation": "Be kind and compassionate to me, O Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭਗਤਿ ਬੰਦਗੀ ਦੇਹਿ ਸਿਰਜਣਹਾਰ ॥",
      "transliteration": "bhagat ba(n)dagee dehi sirajanahaar ||",
      "translation": "Bless me with devotion and meditation, O Lord Creator.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰਿ ਖੋਏ ਭਰਮ ॥",
      "transliteration": "kahu naanak gur khoe bharam ||",
      "translation": "Says Nanak, the Guru has rid me of doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਏਕੋ ਅਲਹੁ ਪਾਰਬ੍ਰਹਮ ॥੫॥੩੪॥੪੫॥",
      "transliteration": "eko alahu paarabraham ||5||34||45||",
      "translation": "The Muslim God Allah and the Hindu God Paarbrahm are one and the same. ||5||34||45||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕੋਟਿ ਜਨਮ ਕੇ ਬਿਨਸੇ ਪਾਪ ॥",
      "transliteration": "kot janam ke binase paap ||",
      "translation": "The sins of millions of incarnations are eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਜਪਤ ਨਾਹੀ ਸੰਤਾਪ ॥",
      "transliteration": "har har japat naahee sa(n)taap ||",
      "translation": "Meditating on the Lord, Har, Har, pain will not afflict you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਨ ਕਮਲ ਮਨਿ ਵਸੇ ॥",
      "transliteration": "gur ke charan kamal man vase ||",
      "translation": "When the Lord's lotus feet are enshrined in the mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਹਾ ਬਿਕਾਰ ਤਨ ਤੇ ਸਭਿ ਨਸੇ ॥੧॥",
      "transliteration": "mahaa bikaar tan te sabh nase ||1||",
      "translation": "all terrible evils are taken away from the body. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੋਪਾਲ ਕੋ ਜਸੁ ਗਾਉ ਪ੍ਰਾਣੀ ॥",
      "transliteration": "gopaal ko jas gaau praanee ||",
      "translation": "Sing the Praise of the Lord of the World, O mortal being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਕਥ ਕਥਾ ਸਾਚੀ ਪ੍ਰਭ ਪੂਰਨ ਜੋਤੀ ਜੋਤਿ ਸਮਾਣੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "akath kathaa saachee prabh pooran jotee jot samaanee ||1|| rahaau ||",
      "translation": "The Unspoken Speech of the True Lord God is perfect. Dwelling upon it, one's light merges into the Light. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤ੍ਰਿਸਨਾ ਭੂਖ ਸਭ ਨਾਸੀ ॥",
      "transliteration": "trisanaa bhookh sabh naasee ||",
      "translation": "Hunger and thirst are totally quenched;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਜਪਿਆ ਅਬਿਨਾਸੀ ॥",
      "transliteration": "sa(n)t prasaad japiaa abinaasee ||",
      "translation": "by the Grace of the Saints, meditate on the immortal Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰੈਨਿ ਦਿਨਸੁ ਪ੍ਰਭ ਸੇਵ ਕਮਾਨੀ ॥",
      "transliteration": "rain dinas prabh sev kamaanee ||",
      "translation": "Night and day, serve God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਰਿ ਮਿਲਣੈ ਕੀ ਏਹ ਨੀਸਾਨੀ ॥੨॥",
      "transliteration": "har milanai kee eh neesaanee ||2||",
      "translation": "This is the sign that one has met with the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਿਟੇ ਜੰਜਾਲ ਹੋਏ ਪ੍ਰਭ ਦਇਆਲ ॥",
      "transliteration": "mite ja(n)jaal hoe prabh daiaal ||",
      "translation": "Worldly entanglements are ended, when God becomes merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗੁਰ ਕਾ ਦਰਸਨੁ ਦੇਖਿ ਨਿਹਾਲ ॥",
      "transliteration": "gur kaa darasan dekh nihaal ||",
      "translation": "Gazing upon the Blessed Vision of the Guru's Darshan, I am enraptured.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪਰਾ ਪੂਰਬਲਾ ਕਰਮੁ ਬਣਿ ਆਇਆ ॥",
      "transliteration": "paraa poorabalaa karam ban aaiaa ||",
      "translation": "My perfect pre-destined karma has been activated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰਿ ਕੇ ਗੁਣ ਨਿਤ ਰਸਨਾ ਗਾਇਆ ॥੩॥",
      "transliteration": "har ke gun nit rasanaa gaaiaa ||3||",
      "translation": "With my tongue, I continually sing the Glorious Praises of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਰਿ ਕੇ ਸੰਤ ਸਦਾ ਪਰਵਾਣੁ ॥",
      "transliteration": "har ke sa(n)t sadaa paravaan ||",
      "translation": "The Saints of the Lord are accepted and approved forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਮਸਤਕਿ ਨੀਸਾਣੁ ॥",
      "transliteration": "sa(n)t janaa masatak neesaan ||",
      "translation": "The foreheads of the Saintly people are marked with the Lord's insignia.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦਾਸ ਕੀ ਰੇਣੁ ਪਾਏ ਜੇ ਕੋਇ ॥",
      "transliteration": "daas kee ren paae je koi ||",
      "translation": "One who is blessed with the dust of the feet of the Lord's slave,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕ ਤਿਸ ਕੀ ਪਰਮ ਗਤਿ ਹੋਇ ॥੪॥੩੫॥੪੬॥",
      "transliteration": "naanak tis kee param gat hoi ||4||35||46||",
      "translation": "O Nanak, obtains the supreme status. ||4||35||46||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦਰਸਨ ਕਉ ਜਾਈਐ ਕੁਰਬਾਨੁ ॥",
      "transliteration": "darasan kau jaaeeai kurabaan ||",
      "translation": "Let yourself be a sacrifice to the Blessed Vision of the Lord's Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਹਿਰਦੈ ਧਰਿ ਧਿਆਨੁ ॥",
      "transliteration": "charan kamal hiradai dhar dhiaan ||",
      "translation": "Focus your heart's meditation on the Lord's lotus feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਧੂਰਿ ਸੰਤਨ ਕੀ ਮਸਤਕਿ ਲਾਇ ॥",
      "transliteration": "dhoor sa(n)tan kee masatak laai ||",
      "translation": "Apply the dust of the feet of the Saints to your forehead,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੀ ਦੁਰਮਤਿ ਮਲੁ ਜਾਇ ॥੧॥",
      "transliteration": "janam janam kee duramat mal jaai ||1||",
      "translation": "and the filthy evil-mindedness of countless incarnations will be washed off. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਿਸੁ ਭੇਟਤ ਮਿਟੈ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "jis bhetat mitai abhimaan ||",
      "translation": "Meeting Him, egotistical pride is eradicated,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਸਭੁ ਨਦਰੀ ਆਵੈ ਕਰਿ ਕਿਰਪਾ ਪੂਰਨ ਭਗਵਾਨ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "paarabraham sabh nadaree aavai kar kirapaa pooran bhagavaan ||1|| rahaau ||",
      "translation": "and you will come to see the Supreme Lord God in all. The Perfect Lord God has showered His Mercy. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰ ਕੀ ਕੀਰਤਿ ਜਪੀਐ ਹਰਿ ਨਾਉ ॥",
      "transliteration": "gur kee keerat japeeai har naau ||",
      "translation": "This is the Guru's Praise, to chant the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰ ਕੀ ਭਗਤਿ ਸਦਾ ਗੁਣ ਗਾਉ ॥",
      "transliteration": "gur kee bhagat sadaa gun gaau ||",
      "translation": "This is devotion to the Guru, to sing forever the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਰ ਕੀ ਸੁਰਤਿ ਨਿਕਟਿ ਕਰਿ ਜਾਨੁ ॥",
      "transliteration": "gur kee surat nikat kar jaan ||",
      "translation": "This is contemplation upon the Guru, to know that the Lord is close at hand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਸਤਿ ਕਰਿ ਮਾਨੁ ॥੨॥",
      "transliteration": "gur kaa sabad sat kar maan ||2||",
      "translation": "Accept the Word of the Guru's Shabad as Truth. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰ ਬਚਨੀ ਸਮਸਰਿ ਸੁਖ ਦੂਖ ॥",
      "transliteration": "gur bachanee samasar sukh dookh ||",
      "translation": "Through the Word of the Guru's Teachings, look upon pleasure and pain as one and the same.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਦੇ ਨ ਬਿਆਪੈ ਤ੍ਰਿਸਨਾ ਭੂਖ ॥",
      "transliteration": "kade na biaapai trisanaa bhookh ||",
      "translation": "Hunger and thirst shall never afflict you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮਨਿ ਸੰਤੋਖੁ ਸਬਦਿ ਗੁਰ ਰਾਜੇ ॥",
      "transliteration": "man sa(n)tokh sabad gur raaje ||",
      "translation": "The mind becomes content and satisfied through the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਪਿ ਗੋਬਿੰਦੁ ਪੜਦੇ ਸਭਿ ਕਾਜੇ ॥੩॥",
      "transliteration": "jap gobi(n)d paRade sabh kaaje ||3||",
      "translation": "Meditate on the Lord of the Universe, and He will cover all your faults. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰੁ ਪਰਮੇਸਰੁ ਗੁਰੁ ਗੋਵਿੰਦੁ ॥",
      "transliteration": "gur paramesar gur govi(n)d ||",
      "translation": "The Guru is the Supreme Lord God; the Guru is the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗੁਰੁ ਦਾਤਾ ਦਇਆਲ ਬਖਸਿੰਦੁ ॥",
      "transliteration": "gur daataa daiaal bakhasi(n)d ||",
      "translation": "The Guru is the Great Giver, merciful and forgiving.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਗੁਰ ਚਰਨੀ ਜਾ ਕਾ ਮਨੁ ਲਾਗਾ ॥",
      "transliteration": "gur charanee jaa kaa man laagaa ||",
      "translation": "One whose mind is attached to the Guru's feet,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0897_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਤਿਸੁ ਪੂਰਨ ਭਾਗਾ ॥੪॥੩੬॥੪੭॥",
      "transliteration": "naanak daas tis pooran bhaagaa ||4||36||47||",
      "translation": "O slave Nanak, is blessed with perfect destiny. ||4||36||47||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 897,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
