{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 898,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0898_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਿਸੁ ਭਰਵਾਸੈ ਬਿਚਰਹਿ ਭਵਨ ॥",
      "transliteration": "kis bharavaasai bicharahi bhavan ||",
      "translation": "What supports you in this world?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੂੜ ਮੁਗਧ ਤੇਰਾ ਸੰਗੀ ਕਵਨ ॥",
      "transliteration": "mooR mugadh teraa sa(n)gee kavan ||",
      "translation": "You ignorant fool, who is your companion?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਾਮੁ ਸੰਗੀ ਤਿਸੁ ਗਤਿ ਨਹੀ ਜਾਨਹਿ ॥",
      "transliteration": "raam sa(n)gee tis gat nahee jaanahi ||",
      "translation": "The Lord is your only companion; no one knows His condition.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪੰਚ ਬਟਵਾਰੇ ਸੇ ਮੀਤ ਕਰਿ ਮਾਨਹਿ ॥੧॥",
      "transliteration": "pa(n)ch batavaare se meet kar maanahi ||1||",
      "translation": "You look upon the five thieves as your friends. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੋ ਘਰੁ ਸੇਵਿ ਜਿਤੁ ਉਧਰਹਿ ਮੀਤ ॥",
      "transliteration": "so ghar sev jit udharahi meet ||",
      "translation": "Serve that home, which will save you, my friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਣ ਗੋਵਿੰਦ ਰਵੀਅਹਿ ਦਿਨੁ ਰਾਤੀ ਸਾਧਸੰਗਿ ਕਰਿ ਮਨ ਕੀ ਪ੍ਰੀਤਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gun govi(n)d raveeahi din raatee saadhasa(n)g kar man kee preet ||1|| rahaau ||",
      "translation": "Chant the Glorious Praises of the Lord of the Universe, day and night; in the Saadh Sangat, the Company of the Holy, love Him in your mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਨਮੁ ਬਿਹਾਨੋ ਅਹੰਕਾਰਿ ਅਰੁ ਵਾਦਿ ॥",
      "transliteration": "janam bihaano aha(n)kaar ar vaad ||",
      "translation": "This human life is passing away in egotism and conflict.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤ੍ਰਿਪਤਿ ਨ ਆਵੈ ਬਿਖਿਆ ਸਾਦਿ ॥",
      "transliteration": "tripat na aavai bikhiaa saad ||",
      "translation": "You are not satisfied; such is the flavor of sin.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭਰਮਤ ਭਰਮਤ ਮਹਾ ਦੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "bharamat bharamat mahaa dukh paaiaa ||",
      "translation": "Wandering and roaming around, you suffer terrible pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਰੀ ਨ ਜਾਈ ਦੁਤਰ ਮਾਇਆ ॥੨॥",
      "transliteration": "taree na jaaee dutar maaiaa ||2||",
      "translation": "You cannot cross over the impassable sea of Maya. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਾਮਿ ਨ ਆਵੈ ਸੁ ਕਾਰ ਕਮਾਵੈ ॥",
      "transliteration": "kaam na aavai s kaar kamaavai ||",
      "translation": "You do the deeds which do not help you at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਪਿ ਬੀਜਿ ਆਪੇ ਹੀ ਖਾਵੈ ॥",
      "transliteration": "aap beej aape hee khaavai ||",
      "translation": "As you plant, so shall you harvest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਖਨ ਕਉ ਦੂਸਰ ਨਹੀ ਕੋਇ ॥",
      "transliteration": "raakhan kau doosar nahee koi ||",
      "translation": "There is none other than the Lord to save you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਉ ਨਿਸਤਰੈ ਜਉ ਕਿਰਪਾ ਹੋਇ ॥੩॥",
      "transliteration": "tau nisatarai jau kirapaa hoi ||3||",
      "translation": "You will be saved, only if God grants His Grace. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਤਿਤ ਪੁਨੀਤ ਪ੍ਰਭ ਤੇਰੋ ਨਾਮੁ ॥",
      "transliteration": "patit puneet prabh tero naam ||",
      "translation": "Your Name, God, is the Purifier of sinners.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਪਨੇ ਦਾਸ ਕਉ ਕੀਜੈ ਦਾਨੁ ॥",
      "transliteration": "apane daas kau keejai daan ||",
      "translation": "Please bless Your slave with that gift.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਗਤਿ ਕਰਿ ਮੇਰੀ ॥",
      "transliteration": "kar kirapaa prabh gat kar meree ||",
      "translation": "Please grant Your Grace, God, and emancipate me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਰਣਿ ਗਹੀ ਨਾਨਕ ਪ੍ਰਭ ਤੇਰੀ ॥੪॥੩੭॥੪੮॥",
      "transliteration": "saran gahee naanak prabh teree ||4||37||48||",
      "translation": "Nanak has grasped Your Sanctuary, God. ||4||37||48||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਹ ਲੋਕੇ ਸੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "ih loke sukh paaiaa ||",
      "translation": "I have found peace in this world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਹੀ ਭੇਟਤ ਧਰਮ ਰਾਇਆ ॥",
      "transliteration": "nahee bhetat dharam raaiaa ||",
      "translation": "I will not have to appear before the Righteous Judge of Dharma to give my account.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਰਿ ਦਰਗਹ ਸੋਭਾਵੰਤ ॥",
      "transliteration": "har daragah sobhaava(n)t ||",
      "translation": "I will be respected in the Court of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਫੁਨਿ ਗਰਭਿ ਨਾਹੀ ਬਸੰਤ ॥੧॥",
      "transliteration": "phun garabh naahee basa(n)t ||1||",
      "translation": "and I will not have to enter the womb of reincarnation ever again. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਾਨੀ ਸੰਤ ਕੀ ਮਿਤ੍ਰਾਈ ॥",
      "transliteration": "jaanee sa(n)t kee mitraaee ||",
      "translation": "Now, I know the value of friendship with the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਦੀਨੋ ਹਰਿ ਨਾਮਾ ਪੂਰਬਿ ਸੰਜੋਗਿ ਮਿਲਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa deeno har naamaa poorab sa(n)jog milaaee ||1|| rahaau ||",
      "translation": "In His Mercy, the Lord has blessed me with His Name. My pre-ordained destiny has been fulfilled. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗੁਰ ਕੈ ਚਰਣਿ ਚਿਤੁ ਲਾਗਾ ॥",
      "transliteration": "gur kai charan chit laagaa ||",
      "translation": "My consciousness is attached to the Guru's feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਧੰਨਿ ਧੰਨਿ ਸੰਜੋਗੁ ਸਭਾਗਾ ॥",
      "transliteration": "dha(n)n dha(n)n sa(n)jog sabhaagaa ||",
      "translation": "Blessed, blessed is this fortunate time of union.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੰਤ ਕੀ ਧੂਰਿ ਲਾਗੀ ਮੇਰੈ ਮਾਥੇ ॥",
      "transliteration": "sa(n)t kee dhoor laagee merai maathe ||",
      "translation": "I have applied the dust of the Saints' feet to my forehead,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਿਲਵਿਖ ਦੁਖ ਸਗਲੇ ਮੇਰੇ ਲਾਥੇ ॥੨॥",
      "transliteration": "kilavikh dukh sagale mere laathe ||2||",
      "translation": "and all my sins and pains have been eradicated. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਾਧ ਕੀ ਸਚੁ ਟਹਲ ਕਮਾਨੀ ॥",
      "transliteration": "saadh kee sach tahal kamaanee ||",
      "translation": "Performing true service to the Holy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਬ ਹੋਏ ਮਨ ਸੁਧ ਪਰਾਨੀ ॥",
      "transliteration": "tab hoe man sudh paraanee ||",
      "translation": "the mortal's mind is purified.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਨ ਕਾ ਸਫਲ ਦਰਸੁ ਡੀਠਾ ॥",
      "transliteration": "jan kaa saphal daras deethaa ||",
      "translation": "I have seen the fruitful vision of the Lord's humble slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਮੁ ਪ੍ਰਭੂ ਕਾ ਘਟਿ ਘਟਿ ਵੂਠਾ ॥੩॥",
      "transliteration": "naam prabhoo kaa ghat ghat voothaa ||3||",
      "translation": "God's Name dwells within each and every heart. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਿਟਾਨੇ ਸਭਿ ਕਲਿ ਕਲੇਸ ॥",
      "transliteration": "mitaane sabh kal kales ||",
      "translation": "All my troubles and sufferings have been taken away;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਸ ਤੇ ਉਪਜੇ ਤਿਸੁ ਮਹਿ ਪਰਵੇਸ ॥",
      "transliteration": "jis te upaje tis mahi paraves ||",
      "translation": "I have merged into the One, from whom I originated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪ੍ਰਗਟੇ ਆਨੂਪ ਗੋੁਵਿੰਦ ॥",
      "transliteration": "pragate aanoop gouvi(n)d ||",
      "translation": "The Lord of the Universe, incomparably beautiful, has become merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਭ ਪੂਰੇ ਨਾਨਕ ਬਖਸਿੰਦ ॥੪॥੩੮॥੪੯॥",
      "transliteration": "prabh poore naanak bakhasi(n)d ||4||38||49||",
      "translation": "O Nanak, God is perfect and forgiving. ||4||38||49||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗਊ ਕਉ ਚਾਰੇ ਸਾਰਦੂਲੁ ॥",
      "transliteration": "gaoo kau chaare saaradool ||",
      "translation": "The tiger leads the cow to the pasture,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਉਡੀ ਕਾ ਲਖ ਹੂਆ ਮੂਲੁ ॥",
      "transliteration": "kaudee kaa lakh hooaa mool ||",
      "translation": "the shell is worth thousands of dollars,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਕਰੀ ਕਉ ਹਸਤੀ ਪ੍ਰਤਿਪਾਲੇ ॥",
      "transliteration": "bakaree kau hasatee pratipaale ||",
      "translation": "and the elephant nurses the goat,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਪਨਾ ਪ੍ਰਭੁ ਨਦਰਿ ਨਿਹਾਲੇ ॥੧॥",
      "transliteration": "apanaa prabh nadar nihaale ||1||",
      "translation": "when God bestows His Glance of Grace. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਨਿਧਾਨ ਪ੍ਰੀਤਮ ਪ੍ਰਭ ਮੇਰੇ ॥",
      "transliteration": "kripaa nidhaan preetam prabh mere ||",
      "translation": "You are the treasure of mercy, O my Beloved Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਰਨਿ ਨ ਸਾਕਉ ਬਹੁ ਗੁਨ ਤੇਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "baran na saakau bahu gun tere ||1|| rahaau ||",
      "translation": "I cannot even describe Your many Glorious Virtues. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੀਸਤ ਮਾਸੁ ਨ ਖਾਇ ਬਿਲਾਈ ॥",
      "transliteration": "deesat maas na khaai bilaaee ||",
      "translation": "The cat sees the meat, but does not eat it,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਹਾ ਕਸਾਬਿ ਛੁਰੀ ਸਟਿ ਪਾਈ ॥",
      "transliteration": "mahaa kasaab chhuree sat paaee ||",
      "translation": "and the great butcher throws away his knife;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਰਣਹਾਰ ਪ੍ਰਭੁ ਹਿਰਦੈ ਵੂਠਾ ॥",
      "transliteration": "karanahaar prabh hiradai voothaa ||",
      "translation": "the Creator Lord God abides in the heart;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਫਾਥੀ ਮਛੁਲੀ ਕਾ ਜਾਲਾ ਤੂਟਾ ॥੨॥",
      "transliteration": "phaathee machhulee kaa jaalaa tootaa ||2||",
      "translation": "the net holding the fish breaks apart. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੂਕੇ ਕਾਸਟ ਹਰੇ ਚਲੂਲ ॥",
      "transliteration": "sooke kaasat hare chalool ||",
      "translation": "The dry wood blossoms forth in greenery and red flowers;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਊਚੈ ਥਲਿ ਫੂਲੇ ਕਮਲ ਅਨੂਪ ॥",
      "transliteration": "oochai thal phoole kamal anoop ||",
      "translation": "in the high desert, the beautiful lotus flower blooms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਗਨਿ ਨਿਵਾਰੀ ਸਤਿਗੁਰ ਦੇਵ ॥",
      "transliteration": "agan nivaaree satigur dev ||",
      "translation": "The Divine True Guru puts out the fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੇਵਕੁ ਅਪਨੀ ਲਾਇਓ ਸੇਵ ॥੩॥",
      "transliteration": "sevak apanee laaio sev ||3||",
      "translation": "He links His servant to His service. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਅਕਿਰਤਘਣਾ ਕਾ ਕਰੇ ਉਧਾਰੁ ॥",
      "transliteration": "akirataghanaa kaa kare udhaar ||",
      "translation": "He saves even the ungrateful;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪ੍ਰਭੁ ਮੇਰਾ ਹੈ ਸਦਾ ਦਇਆਰੁ ॥",
      "transliteration": "prabh meraa hai sadaa daiaar ||",
      "translation": "my God is forever merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਕਾ ਸਦਾ ਸਹਾਈ ॥",
      "transliteration": "sa(n)t janaa kaa sadaa sahaaee ||",
      "translation": "He is forever the helper and support of the humble Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਨਾਨਕ ਸਰਣਾਈ ॥੪॥੩੯॥੫੦॥",
      "transliteration": "charan kamal naanak saranaaee ||4||39||50||",
      "translation": "Nanak has found the Sanctuary of His lotus feet. ||4||39||50||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0898_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 898,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
