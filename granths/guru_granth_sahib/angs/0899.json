{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 899,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0899_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪੰਚ ਸਿੰਘ ਰਾਖੇ ਪ੍ਰਭਿ ਮਾਰਿ ॥",
      "transliteration": "pa(n)ch si(n)gh raakhe prabh maar ||",
      "translation": "God killed the five tigers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦਸ ਬਿਘਿਆੜੀ ਲਈ ਨਿਵਾਰਿ ॥",
      "transliteration": "das bighiaaRee laee nivaar ||",
      "translation": "He has driven out the ten wolves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤੀਨਿ ਆਵਰਤ ਕੀ ਚੂਕੀ ਘੇਰ ॥",
      "transliteration": "teen aavarat kee chookee gher ||",
      "translation": "The three whirl-pools have stopped spinning.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਚੂਕੇ ਭੈ ਫੇਰ ॥੧॥",
      "transliteration": "saadhasa(n)g chooke bhai pher ||1||",
      "translation": "In the Saadh Sangat, the Company of the Holy, the fear of reincarnation is gone. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਜੀਵਾ ਗੋਵਿੰਦ ॥",
      "transliteration": "simar simar jeevaa govi(n)d ||",
      "translation": "Meditating, meditating in remembrance on the Lord of the Universe, I live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਰਾਖਿਓ ਦਾਸੁ ਅਪਨਾ ਸਦਾ ਸਦਾ ਸਾਚਾ ਬਖਸਿੰਦ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa raakhio daas apanaa sadaa sadaa saachaa bakhasi(n)d ||1|| rahaau ||",
      "translation": "In His Mercy, He protects His slave; the True Lord is forever and ever the forgiver. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦਾਝਿ ਗਏ ਤ੍ਰਿਣ ਪਾਪ ਸੁਮੇਰ ॥",
      "transliteration": "daajh gae trin paap sumer ||",
      "translation": "The mountain of sin is burnt down, like straw,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਪਿ ਜਪਿ ਨਾਮੁ ਪੂਜੇ ਪ੍ਰਭ ਪੈਰ ॥",
      "transliteration": "jap jap naam pooje prabh pair ||",
      "translation": "by chanting and meditating on the Name, and worshipping God's feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਨਦ ਰੂਪ ਪ੍ਰਗਟਿਓ ਸਭ ਥਾਨਿ ॥",
      "transliteration": "anad roop pragatio sabh thaan ||",
      "translation": "God, the embodiment of bliss, becomes manifest everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪ੍ਰੇਮ ਭਗਤਿ ਜੋਰੀ ਸੁਖ ਮਾਨਿ ॥੨॥",
      "transliteration": "prem bhagat joree sukh maan ||2||",
      "translation": "Linked to His loving devotional worship, I enjoy peace. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਾਗਰੁ ਤਰਿਓ ਬਾਛਰ ਖੋਜ ॥",
      "transliteration": "saagar tario baachhar khoj ||",
      "translation": "I have crossed over the world-ocean, as if it were no bigger than a calf's footprint on the ground.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਖੇਦੁ ਨ ਪਾਇਓ ਨਹ ਫੁਨਿ ਰੋਜ ॥",
      "transliteration": "khed na paaio nah phun roj ||",
      "translation": "I shall never again have to endure suffering or grief.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਿੰਧੁ ਸਮਾਇਓ ਘਟੁਕੇ ਮਾਹਿ ॥",
      "transliteration": "si(n)dh samaaio ghatuke maahi ||",
      "translation": "The ocean is contained in the pitcher.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਰਣਹਾਰ ਕਉ ਕਿਛੁ ਅਚਰਜੁ ਨਾਹਿ ॥੩॥",
      "transliteration": "karanahaar kau kichh acharaj naahi ||3||",
      "translation": "This is not such an amazing thing for the Creator to do. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਉ ਛੂਟਉ ਤਉ ਜਾਇ ਪਇਆਲ ॥",
      "transliteration": "jau chhootau tau jaai paiaal ||",
      "translation": "When I am separated from Him, then I am consigned to the nether regions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਉ ਕਾਢਿਓ ਤਉ ਨਦਰਿ ਨਿਹਾਲ ॥",
      "transliteration": "jau kaadhio tau nadar nihaal ||",
      "translation": "When He lifts me up and pulls me out, then I am enraptured by His Glance of Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪਾਪ ਪੁੰਨ ਹਮਰੈ ਵਸਿ ਨਾਹਿ ॥",
      "transliteration": "paap pu(n)n hamarai vas naahi ||",
      "translation": "Vice and virtue are not under my control.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰਸਕਿ ਰਸਕਿ ਨਾਨਕ ਗੁਣ ਗਾਹਿ ॥੪॥੪੦॥੫੧॥",
      "transliteration": "rasak rasak naanak gun gaahi ||4||40||51||",
      "translation": "With love and affection, Nanak sings His Glorious Praises. ||4||40||51||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾ ਤਨੁ ਤੇਰਾ ਨਾ ਮਨੁ ਤੋਹਿ ॥",
      "transliteration": "naa tan teraa naa man tohi ||",
      "translation": "Neither your body nor your mind belong to you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਾਇਆ ਮੋਹਿ ਬਿਆਪਿਆ ਧੋਹਿ ॥",
      "transliteration": "maaiaa mohi biaapiaa dhohi ||",
      "translation": "Attached to Maya, you are entangled in fraud.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕੁਦਮ ਕਰੈ ਗਾਡਰ ਜਿਉ ਛੇਲ ॥",
      "transliteration": "kudam karai gaadar jiu chhel ||",
      "translation": "You play like a baby lamb.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਚਿੰਤੁ ਜਾਲੁ ਕਾਲੁ ਚਕ੍ਰੁ ਪੇਲ ॥੧॥",
      "transliteration": "achi(n)t jaal kaal chakr pel ||1||",
      "translation": "But suddenly, Death will catch you in its noose. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਰਿ ਚਰਨ ਕਮਲ ਸਰਨਾਇ ਮਨਾ ॥",
      "transliteration": "har charan kamal saranaai manaa ||",
      "translation": "Seek the Sanctuary of the Lord's lotus feet, O my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਜਪਿ ਸੰਗਿ ਸਹਾਈ ਗੁਰਮੁਖਿ ਪਾਵਹਿ ਸਾਚੁ ਧਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raam naam jap sa(n)g sahaaee guramukh paavahi saach dhanaa ||1|| rahaau ||",
      "translation": "Chant the Name of the Lord, which will be your help and support. As Gurmukh, you shall obtain the true wealth. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਊਨੇ ਕਾਜ ਨ ਹੋਵਤ ਪੂਰੇ ॥",
      "transliteration": "oone kaaj na hovat poore ||",
      "translation": "Your unfinished worldly affairs will never be resolved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਾਮਿ ਕ੍ਰੋਧਿ ਮਦਿ ਸਦ ਹੀ ਝੂਰੇ ॥",
      "transliteration": "kaam krodh mad sad hee jhoore ||",
      "translation": "You shall always regret your sexual desire, anger and pride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਰੈ ਬਿਕਾਰ ਜੀਅਰੇ ਕੈ ਤਾਈ ॥",
      "transliteration": "karai bikaar jeeare kai taaee ||",
      "translation": "You act in corruption in order to survive,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗਾਫਲ ਸੰਗਿ ਨ ਤਸੂਆ ਜਾਈ ॥੨॥",
      "transliteration": "gaaphal sa(n)g na tasooaa jaaee ||2||",
      "translation": "but not even an iota will go along with you, you ignorant fool! ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਧਰਤ ਧੋਹ ਅਨਿਕ ਛਲ ਜਾਨੈ ॥",
      "transliteration": "dharat dhoh anik chhal jaanai ||",
      "translation": "You practice deception, and you know many tricks;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਉਡੀ ਕਉਡੀ ਕਉ ਖਾਕੁ ਸਿਰਿ ਛਾਨੈ ॥",
      "transliteration": "kaudee kaudee kau khaak sir chhaanai ||",
      "translation": "for the sake of mere shells, you throw dust upon your head.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਨਿ ਦੀਆ ਤਿਸੈ ਨ ਚੇਤੈ ਮੂਲਿ ॥",
      "transliteration": "jin deeaa tisai na chetai mool ||",
      "translation": "You never even think of the One who gave you life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਿਥਿਆ ਲੋਭੁ ਨ ਉਤਰੈ ਸੂਲੁ ॥੩॥",
      "transliteration": "mithiaa lobh na utarai sool ||3||",
      "translation": "The pain of false greed never leaves you. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਜਬ ਭਏ ਦਇਆਲ ॥",
      "transliteration": "paarabraham jab bhae daiaal ||",
      "translation": "When the Supreme Lord God becomes merciful,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਹੋਆ ਸਾਧ ਰਵਾਲ ॥",
      "transliteration": "ihu man hoaa saadh ravaal ||",
      "translation": "this mind becomes the dust of the feet of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹਸਤ ਕਮਲ ਲੜਿ ਲੀਨੋ ਲਾਇ ॥",
      "transliteration": "hasat kamal laR leeno laai ||",
      "translation": "With His lotus hands, He has attached us to the hem of His robe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕ ਸਾਚੈ ਸਾਚਿ ਸਮਾਇ ॥੪॥੪੧॥੫੨॥",
      "transliteration": "naanak saachai saach samaai ||4||41||52||",
      "translation": "Nanak merges in the Truest of the True. ||4||41||52||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਰਾਜਾ ਰਾਮ ਕੀ ਸਰਣਾਇ ॥",
      "transliteration": "raajaa raam kee saranaai ||",
      "translation": "I seek the Sanctuary of the Sovereign Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਿਰਭਉ ਭਏ ਗੋਬਿੰਦ ਗੁਨ ਗਾਵਤ ਸਾਧਸੰਗਿ ਦੁਖੁ ਜਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "nirabhau bhae gobi(n)d gun gaavat saadhasa(n)g dukh jaai ||1|| rahaau ||",
      "translation": "I have become fearless, singing the Glorious Praises of the Lord of the Universe. In the Saadh Sangat, the Company of the Holy, my pains have been taken away. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਾ ਕੈ ਰਾਮੁ ਬਸੈ ਮਨ ਮਾਹੀ ॥",
      "transliteration": "jaa kai raam basai man maahee ||",
      "translation": "That person, within whose mind the Lord abides,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੋ ਜਨੁ ਦੁਤਰੁ ਪੇਖਤ ਨਾਹੀ ॥",
      "transliteration": "so jan dutar pekhat naahee ||",
      "translation": "does not see the impassible world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਗਲੇ ਕਾਜ ਸਵਾਰੇ ਅਪਨੇ ॥",
      "transliteration": "sagale kaaj savaare apane ||",
      "translation": "All one's affairs are resolved,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਰਸਨ ਨਿਤ ਜਪਨੇ ॥੧॥",
      "transliteration": "har har naam rasan nit japane ||1||",
      "translation": "by chanting continually the Name of the Lord, Har, Har. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਿਸ ਕੈ ਮਸਤਕਿ ਹਾਥੁ ਗੁਰੁ ਧਰੈ ॥",
      "transliteration": "jis kai masatak haath gur dharai ||",
      "translation": "Why should His slave feel any anxiety?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੋ ਦਾਸੁ ਅਦੇਸਾ ਕਾਹੇ ਕਰੈ ॥",
      "transliteration": "so daas adesaa kaahe karai ||",
      "translation": "The Guru places His hand upon my forehead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਨਮ ਮਰਣ ਕੀ ਚੂਕੀ ਕਾਣਿ ॥",
      "transliteration": "janam maran kee chookee kaan ||",
      "translation": "The fear of birth and death is dispelled;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਊਪਰਿ ਕੁਰਬਾਣ ॥੨॥",
      "transliteration": "poore gur oopar kurabaan ||2||",
      "translation": "I am a sacrifice to the Perfect Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰੁ ਪਰਮੇਸਰੁ ਭੇਟਿ ਨਿਹਾਲ ॥",
      "transliteration": "gur paramesar bhet nihaal ||",
      "translation": "I am enraptured, meeting with the Guru, the Transcendent Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੋ ਦਰਸਨੁ ਪਾਏ ਜਿਸੁ ਹੋਇ ਦਇਆਲੁ ॥",
      "transliteration": "so darasan paae jis hoi daiaal ||",
      "translation": "He alone obtains the Blessed Vision of the Lord's Darshan, who is blessed by His Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਜਿਸੁ ਕਿਰਪਾ ਕਰੈ ॥",
      "transliteration": "paarabraham jis kirapaa karai ||",
      "translation": "One who is blessed by the Grace of the Supreme Lord God,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਸੋ ਭਵਜਲੁ ਤਰੈ ॥੩॥",
      "transliteration": "saadhasa(n)g so bhavajal tarai ||3||",
      "translation": "crosses over the terrifying world-ocean in the Saadh Sangat, the Company of the Holy. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਪੀਵਹੁ ਸਾਧ ਪਿਆਰੇ ॥",
      "transliteration": "a(n)mrit peevahu saadh piaare ||",
      "translation": "Drink in the Ambrosial Nectar, O Beloved Holy people.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮੁਖ ਊਜਲ ਸਾਚੈ ਦਰਬਾਰੇ ॥",
      "transliteration": "mukh oojal saachai darabaare ||",
      "translation": "Your face shall be radiant and bright in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਅਨਦ ਕਰਹੁ ਤਜਿ ਸਗਲ ਬਿਕਾਰ ॥",
      "transliteration": "anad karahu taj sagal bikaar ||",
      "translation": "Celebrate and be blissful, and abandon all corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0899_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਜਪਿ ਉਤਰਹੁ ਪਾਰਿ ॥੪॥੪੨॥੫੩॥",
      "transliteration": "naanak har jap utarahu paar ||4||42||53||",
      "translation": "O Nanak, meditate on the Lord and cross over. ||4||42||53||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 899,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
