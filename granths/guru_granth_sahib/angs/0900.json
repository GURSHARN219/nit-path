{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 900,
  "lineCount": 49,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0900_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਈੰਧਨ ਤੇ ਬੈਸੰਤਰੁ ਭਾਗੈ ॥",
      "transliteration": "ee(n)dhan te baisa(n)tar bhaagai ||",
      "translation": "The fire runs away from the fuel.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਾਟੀ ਕਉ ਜਲੁ ਦਹ ਦਿਸ ਤਿਆਗੈ ॥",
      "transliteration": "maatee kau jal dah dis tiaagai ||",
      "translation": "The water runs away from the dust in all directions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਊਪਰਿ ਚਰਨ ਤਲੈ ਆਕਾਸੁ ॥",
      "transliteration": "oopar charan talai aakaas ||",
      "translation": "The feet are above, and the sky is beneath.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਘਟ ਮਹਿ ਸਿੰਧੁ ਕੀਓ ਪਰਗਾਸੁ ॥੧॥",
      "transliteration": "ghat mahi si(n)dh keeo paragaas ||1||",
      "translation": "The ocean appears in the cup. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਐਸਾ ਸੰਮ੍ਰਥੁ ਹਰਿ ਜੀਉ ਆਪਿ ॥",
      "transliteration": "aisaa sa(n)mrath har jeeu aap ||",
      "translation": "Such is our all-powerful dear Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਿਮਖ ਨ ਬਿਸਰੈ ਜੀਅ ਭਗਤਨ ਕੈ ਆਠ ਪਹਰ ਮਨ ਤਾ ਕਉ ਜਾਪਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "nimakh na bisarai jee bhagatan kai aath pahar man taa kau jaap ||1|| rahaau ||",
      "translation": "His devotees do not forget Him, even for an instant. Twenty-four hours a day, O mind, meditate on Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪ੍ਰਥਮੇ ਮਾਖਨੁ ਪਾਛੈ ਦੂਧੁ ॥",
      "transliteration": "prathame maakhan paachhai doodh ||",
      "translation": "First comes the butter, and then the milk.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮੈਲੂ ਕੀਨੋ ਸਾਬੁਨੁ ਸੂਧੁ ॥",
      "transliteration": "mailoo keeno saabun soodh ||",
      "translation": "The dirt cleans the soap.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭੈ ਤੇ ਨਿਰਭਉ ਡਰਤਾ ਫਿਰੈ ॥",
      "transliteration": "bhai te nirabhau darataa phirai ||",
      "translation": "The fearless are afraid of fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹੋਂਦੀ ਕਉ ਅਣਹੋਂਦੀ ਹਿਰੈ ॥੨॥",
      "transliteration": "ho(n)dee kau anaho(n)dee hirai ||2||",
      "translation": "The living are killed by the dead. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੇਹੀ ਗੁਪਤ ਬਿਦੇਹੀ ਦੀਸੈ ॥",
      "transliteration": "dehee gupat bidehee deesai ||",
      "translation": "The visible body is hidden, and the etheric body is seen.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਗਲੇ ਸਾਜਿ ਕਰਤ ਜਗਦੀਸੈ ॥",
      "transliteration": "sagale saaj karat jagadeesai ||",
      "translation": "The Lord of the world does all these things.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਠਗਣਹਾਰ ਅਣਠਗਦਾ ਠਾਗੈ ॥",
      "transliteration": "thaganahaar anathagadaa thaagai ||",
      "translation": "The one who is cheated, is not cheated by the cheat.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਿਨੁ ਵਖਰ ਫਿਰਿ ਫਿਰਿ ਉਠਿ ਲਾਗੈ ॥੩॥",
      "transliteration": "bin vakhar phir phir uth laagai ||3||",
      "translation": "With no merchandise, the trader trades again and again. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੰਤ ਸਭਾ ਮਿਲਿ ਕਰਹੁ ਬਖਿਆਣ ॥",
      "transliteration": "sa(n)t sabhaa mil karahu bakhiaan ||",
      "translation": "So join the Society of the Saints, and chant the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਿੰਮ੍ਰਿਤਿ ਸਾਸਤ ਬੇਦ ਪੁਰਾਣ ॥",
      "transliteration": "si(n)mrit saasat bed puraan ||",
      "translation": "So say the Simritees, Shaastras, Vedas and Puraanas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬ੍ਰਹਮ ਬੀਚਾਰੁ ਬੀਚਾਰੇ ਕੋਇ ॥",
      "transliteration": "braham beechaar beechaare koi ||",
      "translation": "Rare are those who contemplate and meditate on God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕੀ ਪਰਮ ਗਤਿ ਹੋਇ ॥੪॥੪੩॥੫੪॥",
      "transliteration": "naanak taa kee param gat hoi ||4||43||54||",
      "translation": "O Nanak, they attain the supreme status. ||4||43||54||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੋ ਥੀਆ ॥",
      "transliteration": "jo tis bhaavai so theeaa ||",
      "translation": "Whatever pleases Him happens.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਹਰਿ ਕੀ ਸਰਣਾਈ ਪ੍ਰਭ ਬਿਨੁ ਨਾਹੀ ਆਨ ਬੀਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sadaa sadaa har kee saranaaee prabh bin naahee aan beeaa ||1|| rahaau ||",
      "translation": "Forever and ever, I seek the Sanctuary of the Lord.There is none other than God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪੁਤੁ ਕਲਤ੍ਰੁ ਲਖਿਮੀ ਦੀਸੈ ਇਨ ਮਹਿ ਕਿਛੂ ਨ ਸੰਗਿ ਲੀਆ ॥",
      "transliteration": "put kalatr lakhimee deesai in mahi kichhoo na sa(n)g leeaa ||",
      "translation": "You look upon your children, spouse and wealth; none of these will go along with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਿਖੈ ਠਗਉਰੀ ਖਾਇ ਭੁਲਾਨਾ ਮਾਇਆ ਮੰਦਰੁ ਤਿਆਗਿ ਗਇਆ ॥੧॥",
      "transliteration": "bikhai thagauree khaai bhulaanaa maaiaa ma(n)dar tiaag gaiaa ||1||",
      "translation": "Eating the poisonous potion, you have gone astray. You will have to go, and leave Maya and your mansions. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਿੰਦਾ ਕਰਿ ਕਰਿ ਬਹੁਤੁ ਵਿਗੂਤਾ ਗਰਭ ਜੋਨਿ ਮਹਿ ਕਿਰਤਿ ਪਇਆ ॥",
      "transliteration": "ni(n)daa kar kar bahut vigootaa garabh jon mahi kirat paiaa ||",
      "translation": "Slandering others, you are totally ruined; because of your past actions, you shall be consigned to the womb of reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪੁਰਬ ਕਮਾਣੇ ਛੋਡਹਿ ਨਾਹੀ ਜਮਦੂਤਿ ਗ੍ਰਾਸਿਓ ਮਹਾ ਭਇਆ ॥੨॥",
      "transliteration": "purab kamaane chhodahi naahee jamadoot graasio mahaa bhaiaa ||2||",
      "translation": "Your past actions will not just go away; the most horrible Messenger of Death shall seize you. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬੋਲੈ ਝੂਠੁ ਕਮਾਵੈ ਅਵਰਾ ਤ੍ਰਿਸਨ ਨ ਬੂਝੈ ਬਹੁਤੁ ਹਇਆ ॥",
      "transliteration": "bolai jhooth kamaavai avaraa trisan na boojhai bahut haiaa ||",
      "translation": "You tell lies, and do not practice what you preach. Your desires are not satisfied - what a shame.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਸਾਧ ਰੋਗੁ ਉਪਜਿਆ ਸੰਤ ਦੂਖਨਿ ਦੇਹ ਬਿਨਾਸੀ ਮਹਾ ਖਇਆ ॥੩॥",
      "transliteration": "asaadh rog upajiaa sa(n)t dookhan deh binaasee mahaa khaiaa ||3||",
      "translation": "You have contracted an incurable disease; slandering the Saints, your body is wasting away; you are utterly ruined. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਨਹਿ ਨਿਵਾਜੇ ਤਿਨ ਹੀ ਸਾਜੇ ਆਪੇ ਕੀਨੇ ਸੰਤ ਜਇਆ ॥",
      "transliteration": "jinahi nivaaje tin hee saaje aape keene sa(n)t jaiaa ||",
      "translation": "He embellishes those whom He has fashioned. He Himself gave life to the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਕੰਠਿ ਲਾਇ ਰਾਖੇ ਕਰਿ ਕਿਰਪਾ ਪਾਰਬ੍ਰਹਮ ਮਇਆ ॥੪॥੪੪॥੫੫॥",
      "transliteration": "naanak daas ka(n)th laai raakhe kar kirapaa paarabraham maiaa ||4||44||55||",
      "translation": "O Nanak, He hugs His slaves close in His Embrace. Please grant Your Grace, O Supreme Lord God, and be kind to me as well. ||4||44||55||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਐਸਾ ਪੂਰਾ ਗੁਰਦੇਉ ਸਹਾਈ ॥",
      "transliteration": "aisaa pooraa guradeu sahaaee ||",
      "translation": "Such is the Perfect Divine Guru, my help and support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਾ ਕਾ ਸਿਮਰਨੁ ਬਿਰਥਾ ਨ ਜਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaa kaa simaran birathaa na jaaee ||1|| rahaau ||",
      "translation": "Meditation on Him is not wasted. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦਰਸਨੁ ਪੇਖਤ ਹੋਇ ਨਿਹਾਲੁ ॥",
      "transliteration": "darasan pekhat hoi nihaal ||",
      "translation": "Gazing upon the Blessed Vision of His Darshan, I am enraptured.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾ ਕੀ ਧੂਰਿ ਕਾਟੈ ਜਮ ਜਾਲੁ ॥",
      "transliteration": "jaa kee dhoor kaatai jam jaal ||",
      "translation": "The dust of His feet snaps the noose of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਬਸੇ ਮੇਰੇ ਮਨ ਕੇ ॥",
      "transliteration": "charan kamal base mere man ke ||",
      "translation": "His lotus feet dwell within my mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਾਰਜ ਸਵਾਰੇ ਸਗਲੇ ਤਨ ਕੇ ॥੧॥",
      "transliteration": "kaaraj savaare sagale tan ke ||1||",
      "translation": "and so all the affairs of my body are arranged and resolved. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾ ਕੈ ਮਸਤਕਿ ਰਾਖੈ ਹਾਥੁ ॥",
      "transliteration": "jaa kai masatak raakhai haath ||",
      "translation": "One upon whom He places His Hand, is protected.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪ੍ਰਭੁ ਮੇਰੋ ਅਨਾਥ ਕੋ ਨਾਥੁ ॥",
      "transliteration": "prabh mero anaath ko naath ||",
      "translation": "My God is the Master of the masterless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਤਿਤ ਉਧਾਰਣੁ ਕ੍ਰਿਪਾ ਨਿਧਾਨੁ ॥",
      "transliteration": "patit udhaaran kripaa nidhaan ||",
      "translation": "He is the Savior of sinners, the treasure of mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਜਾਈਐ ਕੁਰਬਾਨੁ ॥੨॥",
      "transliteration": "sadaa sadaa jaaeeai kurabaan ||2||",
      "translation": "Forever and ever, I am a sacrifice to Him. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਿਰਮਲ ਮੰਤੁ ਦੇਇ ਜਿਸੁ ਦਾਨੁ ॥",
      "transliteration": "niramal ma(n)t dei jis daan ||",
      "translation": "One whom He blesses with His Immaculate Mantra,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਜਹਿ ਬਿਕਾਰ ਬਿਨਸੈ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "tajahi bikaar binasai abhimaan ||",
      "translation": "renounces corruption; his egotistical pride is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਏਕੁ ਧਿਆਈਐ ਸਾਧ ਕੈ ਸੰਗਿ ॥",
      "transliteration": "ek dhiaaeeai saadh kai sa(n)g ||",
      "translation": "Meditate on the One Lord in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪਾਪ ਬਿਨਾਸੇ ਨਾਮ ਕੈ ਰੰਗਿ ॥੩॥",
      "transliteration": "paap binaase naam kai ra(n)g ||3||",
      "translation": "Sins are erased, through the love of the Naam, the Name of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰ ਪਰਮੇਸੁਰ ਸਗਲ ਨਿਵਾਸ ॥",
      "transliteration": "gur paramesur sagal nivaas ||",
      "translation": "The Guru, the Transcendent Lord, dwells among all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਰਵਿ ਰਹਿਆ ਗੁਣਤਾਸ ॥",
      "transliteration": "ghat ghat rav rahiaa gunataas ||",
      "translation": "The treasure of virtue pervades and permeates each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦਰਸੁ ਦੇਹਿ ਧਾਰਉ ਪ੍ਰਭ ਆਸ ॥",
      "transliteration": "daras dehi dhaarau prabh aas ||",
      "translation": "Please grant me the Blessed Vision of Your Darshan;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0900_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਿਤ ਨਾਨਕੁ ਚਿਤਵੈ ਸਚੁ ਅਰਦਾਸਿ ॥੪॥੪੫॥੫੬॥",
      "transliteration": "nit naanak chitavai sach aradaas ||4||45||56||",
      "translation": "O God, I place my hopes in You. Nanak continually offers this true prayer. ||4||45||56||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 900,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
