{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 903,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0903_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਖੁ ਗੁਣਾ ਕਲਿ ਆਈਐ ॥",
      "transliteration": "aakh gunaa kal aaeeai ||",
      "translation": "Chant the Praises of the Lord; Kali Yuga has come.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਿਹੁ ਜੁਗ ਕੇਰਾ ਰਹਿਆ ਤਪਾਵਸੁ ਜੇ ਗੁਣ ਦੇਹਿ ਤ ਪਾਈਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tihu jug keraa rahiaa tapaavas je gun dehi ta paaeeai ||1|| rahaau ||",
      "translation": "The justice of the previous three ages is gone. One obtains virtue, only if the Lord bestows it. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਲਿ ਕਲਵਾਲੀ ਸਰਾ ਨਿਬੇੜੀ ਕਾਜੀ ਕ੍ਰਿਸਨਾ ਹੋਆ ॥",
      "transliteration": "kal kalavaalee saraa nibeRee kaajee krisanaa hoaa ||",
      "translation": "In this turbulent age of Kali Yuga, Muslim law decides the cases, and the blue-robed Qazi is the judge.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਾਣੀ ਬ੍ਰਹਮਾ ਬੇਦੁ ਅਥਰਬਣੁ ਕਰਣੀ ਕੀਰਤਿ ਲਹਿਆ ॥੫॥",
      "transliteration": "baanee brahamaa bed atharaban karanee keerat lahiaa ||5||",
      "translation": "The Guru's Bani has taken the place of Brahma's Veda, and the singing of the Lord's Praises are good deeds. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪਤਿ ਵਿਣੁ ਪੂਜਾ ਸਤ ਵਿਣੁ ਸੰਜਮੁ ਜਤ ਵਿਣੁ ਕਾਹੇ ਜਨੇਊ ॥",
      "transliteration": "pat vin poojaa sat vin sa(n)jam jat vin kaahe janeoo ||",
      "translation": "Worship without faith; self-discipline without truthfulness; the ritual of the sacred thread without chastity - what good are these?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਵਹੁ ਧੋਵਹੁ ਤਿਲਕੁ ਚੜਾਵਹੁ ਸੁਚ ਵਿਣੁ ਸੋਚ ਨ ਹੋਈ ॥੬॥",
      "transliteration": "naavahu dhovahu tilak chaRaavahu such vin soch na hoee ||6||",
      "translation": "You may bathe and wash, and apply a ritualistic tilak mark to your forehead, but without inner purity, there is no understanding. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਲਿ ਪਰਵਾਣੁ ਕਤੇਬ ਕੁਰਾਣੁ ॥",
      "transliteration": "kal paravaan kateb kuraan ||",
      "translation": "In Kali Yuga, the Koran and the Bible have become famous.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪੋਥੀ ਪੰਡਿਤ ਰਹੇ ਪੁਰਾਣ ॥",
      "transliteration": "pothee pa(n)dit rahe puraan ||",
      "translation": "The Pandit's scriptures and the Puraanas are not respected.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਨਕ ਨਾਉ ਭਇਆ ਰਹਮਾਣੁ ॥",
      "transliteration": "naanak naau bhaiaa rahamaan ||",
      "translation": "O Nanak, the Lord's Name now is Rehmaan, the Merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਰਿ ਕਰਤਾ ਤੂ ਏਕੋ ਜਾਣੁ ॥੭॥",
      "transliteration": "kar karataa too eko jaan ||7||",
      "translation": "Know that there is only One Creator of the creation. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਮਿਲੈ ਵਡਿਆਈ ਏਦੂ ਉਪਰਿ ਕਰਮੁ ਨਹੀ ॥",
      "transliteration": "naanak naam milai vadiaaee edoo upar karam nahee ||",
      "translation": "Nanak has obtained the glorious greatness of the Naam, the Name of the Lord. There is no action higher than this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੇ ਘਰਿ ਹੋਦੈ ਮੰਗਣਿ ਜਾਈਐ ਫਿਰਿ ਓਲਾਮਾ ਮਿਲੈ ਤਹੀ ॥੮॥੧॥",
      "transliteration": "je ghar hodai ma(n)gan jaaeeai phir olaamaa milai tahee ||8||1||",
      "translation": "If someone goes out to beg for what is already in his own home, then he should be chastised. ||8||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "raamakalee mahalaa 1 ||",
      "translation": "Raamkalee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਗੁ ਪਰਬੋਧਹਿ ਮੜੀ ਬਧਾਵਹਿ ॥",
      "transliteration": "jag parabodhahi maRee badhaavahi ||",
      "translation": "You preach to the world, and set up your house.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਆਸਣੁ ਤਿਆਗਿ ਕਾਹੇ ਸਚੁ ਪਾਵਹਿ ॥",
      "transliteration": "aasan tiaag kaahe sach paavahi ||",
      "translation": "Abandoning your Yogic postures, how will you find the True Lord?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਮਤਾ ਮੋਹੁ ਕਾਮਣਿ ਹਿਤਕਾਰੀ ॥",
      "transliteration": "mamataa mohu kaaman hitakaaree ||",
      "translation": "You are attached to possessiveness and the love of sexual pleasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾ ਅਉਧੂਤੀ ਨਾ ਸੰਸਾਰੀ ॥੧॥",
      "transliteration": "naa audhootee naa sa(n)saaree ||1||",
      "translation": "You are not a renunciate, nor a man of the world. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੋਗੀ ਬੈਸਿ ਰਹਹੁ ਦੁਬਿਧਾ ਦੁਖੁ ਭਾਗੈ ॥",
      "transliteration": "jogee bais rahahu dubidhaa dukh bhaagai ||",
      "translation": "Yogi, remain seated, and the pain of duality will run away from you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਘਰਿ ਘਰਿ ਮਾਗਤ ਲਾਜ ਨ ਲਾਗੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ghar ghar maagat laaj na laagai ||1|| rahaau ||",
      "translation": "You beg from door to door, and you don't feel ashamed. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗਾਵਹਿ ਗੀਤ ਨ ਚੀਨਹਿ ਆਪੁ ॥",
      "transliteration": "gaavahi geet na cheenahi aap ||",
      "translation": "You sing the songs, but you do not understand your own self.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਿਉ ਲਾਗੀ ਨਿਵਰੈ ਪਰਤਾਪੁ ॥",
      "transliteration": "kiu laagee nivarai parataap ||",
      "translation": "How will the burning pain within be relieved?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਰਚੈ ਮਨ ਭਾਇ ॥",
      "transliteration": "gur kai sabad rachai man bhaai ||",
      "translation": "Through the Word of the Guru's Shabad, let your mind be absorbed in the Lord's Love,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਿਖਿਆ ਸਹਜ ਵੀਚਾਰੀ ਖਾਇ ॥੨॥",
      "transliteration": "bhikhiaa sahaj veechaaree khaai ||2||",
      "translation": "and you will intuitively experience the charity of contemplation. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਸਮ ਚੜਾਇ ਕਰਹਿ ਪਾਖੰਡੁ ॥",
      "transliteration": "bhasam chaRaai karahi paakha(n)d ||",
      "translation": "You apply ashes to your body, while acting in hypocrisy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਾਇਆ ਮੋਹਿ ਸਹਹਿ ਜਮ ਡੰਡੁ ॥",
      "transliteration": "maaiaa mohi sahahi jam da(n)d ||",
      "translation": "Attached to Maya, you will be beaten by Death's heavy club.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਫੂਟੈ ਖਾਪਰੁ ਭੀਖ ਨ ਭਾਇ ॥",
      "transliteration": "phootai khaapar bheekh na bhaai ||",
      "translation": "Your begging bowl is broken; it will not hold the charity of the Lord's Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬੰਧਨਿ ਬਾਧਿਆ ਆਵੈ ਜਾਇ ॥੩॥",
      "transliteration": "ba(n)dhan baadhiaa aavai jaai ||3||",
      "translation": "Bound in bondage, you come and go. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਿੰਦੁ ਨ ਰਾਖਹਿ ਜਤੀ ਕਹਾਵਹਿ ॥",
      "transliteration": "bi(n)d na raakhahi jatee kahaavahi ||",
      "translation": "You do not control your seed and semen, and yet you claim to practice abstinence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਾਈ ਮਾਗਤ ਤ੍ਰੈ ਲੋਭਾਵਹਿ ॥",
      "transliteration": "maaee maagat trai lobhaavahi ||",
      "translation": "You beg from Maya, lured by the three qualities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਿਰਦਇਆ ਨਹੀ ਜੋਤਿ ਉਜਾਲਾ ॥",
      "transliteration": "niradaiaa nahee jot ujaalaa ||",
      "translation": "You have no compassion; the Lord's Light does not shine in you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬੂਡਤ ਬੂਡੇ ਸਰਬ ਜੰਜਾਲਾ ॥੪॥",
      "transliteration": "boodat boode sarab ja(n)jaalaa ||4||",
      "translation": "You are drowned, drowned in worldly entanglements. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭੇਖ ਕਰਹਿ ਖਿੰਥਾ ਬਹੁ ਥਟੂਆ ॥",
      "transliteration": "bhekh karahi khi(n)thaa bahu thatooaa ||",
      "translation": "You wear religious robes, and your patched coat assumes many disguises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਝੂਠੋ ਖੇਲੁ ਖੇਲੈ ਬਹੁ ਨਟੂਆ ॥",
      "transliteration": "jhootho khel khelai bahu natooaa ||",
      "translation": "You play all sorts of false tricks, like a juggler.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅੰਤਰਿ ਅਗਨਿ ਚਿੰਤਾ ਬਹੁ ਜਾਰੇ ॥",
      "transliteration": "a(n)tar agan chi(n)taa bahu jaare ||",
      "translation": "The fire of anxiety burns brightly within you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਵਿਣੁ ਕਰਮਾ ਕੈਸੇ ਉਤਰਸਿ ਪਾਰੇ ॥੫॥",
      "transliteration": "vin karamaa kaise utaras paare ||5||",
      "translation": "Without the karma of good actions, how can you cross over? ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੁੰਦ੍ਰਾ ਫਟਕ ਬਨਾਈ ਕਾਨਿ ॥",
      "transliteration": "mu(n)draa phatak banaaee kaan ||",
      "translation": "You make ear-rings of glass to wear in your ears.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮੁਕਤਿ ਨਹੀ ਬਿਦਿਆ ਬਿਗਿਆਨਿ ॥",
      "transliteration": "mukat nahee bidiaa bigiaan ||",
      "translation": "But liberation does not come from learning without understanding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਹਵਾ ਇੰਦ੍ਰੀ ਸਾਦਿ ਲੋੁਭਾਨਾ ॥",
      "transliteration": "jihavaa i(n)dree saad loubhaanaa ||",
      "translation": "You are lured by the tastes of the tongue and sex organs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਸੂ ਭਏ ਨਹੀ ਮਿਟੈ ਨੀਸਾਨਾ ॥੬॥",
      "transliteration": "pasoo bhae nahee mitai neesaanaa ||6||",
      "translation": "You have become a beast; this sign cannot be erased. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤ੍ਰਿਬਿਧਿ ਲੋਗਾ ਤ੍ਰਿਬਿਧਿ ਜੋਗਾ ॥",
      "transliteration": "tribidh logaa tribidh jogaa ||",
      "translation": "The people of the world are entangled in the three modes; the Yogis are entangled in the three modes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਬਦੁ ਵੀਚਾਰੈ ਚੂਕਸਿ ਸੋਗਾ ॥",
      "transliteration": "sabad veechaarai chookas sogaa ||",
      "translation": "Contemplating the Word of the Shabad, sorrows are dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਊਜਲੁ ਸਾਚੁ ਸੁ ਸਬਦੁ ਹੋਇ ॥",
      "transliteration": "oojal saach s sabad hoi ||",
      "translation": "Through the Shabad, one becomes radiant, pure and truthful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੋਗੀ ਜੁਗਤਿ ਵੀਚਾਰੇ ਸੋਇ ॥੭॥",
      "transliteration": "jogee jugat veechaare soi ||7||",
      "translation": "One who contemplates the true lifestyle is a Yogi. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤੁਝ ਪਹਿ ਨਉ ਨਿਧਿ ਤੂ ਕਰਣੈ ਜੋਗੁ ॥",
      "transliteration": "tujh pahi nau nidh too karanai jog ||",
      "translation": "The nine treasures are with You, Lord; You are potent, the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਥਾਪਿ ਉਥਾਪੇ ਕਰੇ ਸੁ ਹੋਗੁ ॥",
      "transliteration": "thaap uthaape kare s hog ||",
      "translation": "You establish and disestablish; whatever You do, happens.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਤੁ ਸਤੁ ਸੰਜਮੁ ਸਚੁ ਸੁਚੀਤੁ ॥",
      "transliteration": "jat sat sa(n)jam sach sucheet ||",
      "translation": "One who practices celibacy, chastity, self-control, truth and pure consciousness",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਨਕ ਜੋਗੀ ਤ੍ਰਿਭਵਣ ਮੀਤੁ ॥੮॥੨॥",
      "transliteration": "naanak jogee tribhavan meet ||8||2||",
      "translation": "- O Nanak, that Yogi is the friend of the three worlds. ||8||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "raamakalee mahalaa 1 ||",
      "translation": "Raamkalee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਖਟੁ ਮਟੁ ਦੇਹੀ ਮਨੁ ਬੈਰਾਗੀ ॥",
      "transliteration": "khat mat dehee man bairaagee ||",
      "translation": "Above the six chakras of the body dwells the detached mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੁਰਤਿ ਸਬਦੁ ਧੁਨਿ ਅੰਤਰਿ ਜਾਗੀ ॥",
      "transliteration": "surat sabad dhun a(n)tar jaagee ||",
      "translation": "Awareness of the vibration of the Word of the Shabad has been awakened deep within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਵਾਜੈ ਅਨਹਦੁ ਮੇਰਾ ਮਨੁ ਲੀਣਾ ॥",
      "transliteration": "vaajai anahad meraa man leenaa ||",
      "translation": "The unstruck melody of the sound current resonates and resounds within; my mind is attuned to it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰ ਬਚਨੀ ਸਚਿ ਨਾਮਿ ਪਤੀਣਾ ॥੧॥",
      "transliteration": "gur bachanee sach naam pateenaa ||1||",
      "translation": "Through the Guru's Teachings, my faith is confirmed in the True Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਪ੍ਰਾਣੀ ਰਾਮ ਭਗਤਿ ਸੁਖੁ ਪਾਈਐ ॥",
      "transliteration": "praanee raam bhagat sukh paaeeai ||",
      "translation": "O mortal, through devotion to the Lord, peace is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0903_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਹਰਿ ਹਰਿ ਮੀਠਾ ਲਾਗੈ ਹਰਿ ਹਰਿ ਨਾਮਿ ਸਮਾਈਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "guramukh har har meethaa laagai har har naam samaaeeai ||1|| rahaau ||",
      "translation": "The Lord, Har, Har, seems sweet to the Gurmukh, who merges in the Name of the Lord, Har, Har. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 903,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
