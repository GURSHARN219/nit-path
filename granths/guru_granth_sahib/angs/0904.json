{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 904,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0904_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਾਇਆ ਮੋਹੁ ਬਿਵਰਜਿ ਸਮਾਏ ॥",
      "transliteration": "maaiaa mohu bivaraj samaae ||",
      "translation": "Eradicating attachment to Maya, one merges into the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਭੇਟੈ ਮੇਲਿ ਮਿਲਾਏ ॥",
      "transliteration": "satigur bhetai mel milaae ||",
      "translation": "Meeting with the True Guru, we unite in His Union.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਮੁ ਰਤਨੁ ਨਿਰਮੋਲਕੁ ਹੀਰਾ ॥",
      "transliteration": "naam ratan niramolak heeraa ||",
      "translation": "The Naam, the Name of the Lord, is a priceless jewel, a diamond.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਿਤੁ ਰਾਤਾ ਮੇਰਾ ਮਨੁ ਧੀਰਾ ॥੨॥",
      "transliteration": "tit raataa meraa man dheeraa ||2||",
      "translation": "Attuned to it, the mind is comforted and encouraged. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਉਮੈ ਮਮਤਾ ਰੋਗੁ ਨ ਲਾਗੈ ॥",
      "transliteration": "haumai mamataa rog na laagai ||",
      "translation": "The diseases of egotism and possessiveness do not afflict",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਾਮ ਭਗਤਿ ਜਮ ਕਾ ਭਉ ਭਾਗੈ ॥",
      "transliteration": "raam bhagat jam kaa bhau bhaagai ||",
      "translation": "one who worships the Lord. Fear of the Messenger of Death runs away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਮੁ ਜੰਦਾਰੁ ਨ ਲਾਗੈ ਮੋਹਿ ॥",
      "transliteration": "jam ja(n)daar na laagai mohi ||",
      "translation": "The Messenger of Death, the enemy of the soul, does not touch me at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਿਰਮਲ ਨਾਮੁ ਰਿਦੈ ਹਰਿ ਸੋਹਿ ॥੩॥",
      "transliteration": "niramal naam ridai har sohi ||3||",
      "translation": "The Immaculate Name of the Lord illuminates my heart. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਬਦੁ ਬੀਚਾਰਿ ਭਏ ਨਿਰੰਕਾਰੀ ॥",
      "transliteration": "sabad beechaar bhae nira(n)kaaree ||",
      "translation": "Contemplating the Shabad, we become Nirankaari - we come to belong to the Formless Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰਮਤਿ ਜਾਗੇ ਦੁਰਮਤਿ ਪਰਹਾਰੀ ॥",
      "transliteration": "guramat jaage duramat parahaaree ||",
      "translation": "Awakening to the Guru's Teachings, evil-mindedness is taken away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਨਦਿਨੁ ਜਾਗਿ ਰਹੇ ਲਿਵ ਲਾਈ ॥",
      "transliteration": "anadin jaag rahe liv laaee ||",
      "translation": "Remaining awake and aware night and day, lovingly focused on the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੀਵਨ ਮੁਕਤਿ ਗਤਿ ਅੰਤਰਿ ਪਾਈ ॥੪॥",
      "transliteration": "jeevan mukat gat a(n)tar paaee ||4||",
      "translation": "one becomes Jivan Mukta - liberated while yet alive. He finds this state deep within himself. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਲਿਪਤ ਗੁਫਾ ਮਹਿ ਰਹਹਿ ਨਿਰਾਰੇ ॥",
      "transliteration": "alipat guphaa mahi rahahi niraare ||",
      "translation": "In the secluded cave, I remain unattached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਸਕਰ ਪੰਚ ਸਬਦਿ ਸੰਘਾਰੇ ॥",
      "transliteration": "tasakar pa(n)ch sabad sa(n)ghaare ||",
      "translation": "With the Word of the Shabad, I have killed the five thieves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪਰ ਘਰ ਜਾਇ ਨ ਮਨੁ ਡੋਲਾਏ ॥",
      "transliteration": "par ghar jaai na man dolaae ||",
      "translation": "My mind does not waver or go to the home of any other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਹਜ ਨਿਰੰਤਰਿ ਰਹਉ ਸਮਾਏ ॥੫॥",
      "transliteration": "sahaj nira(n)tar rahau samaae ||5||",
      "translation": "I remain intuitively absorbed deep within. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਜਾਗਿ ਰਹੇ ਅਉਧੂਤਾ ॥",
      "transliteration": "guramukh jaag rahe audhootaa ||",
      "translation": "As Gurmukh, I remain awake and aware, unattached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਦ ਬੈਰਾਗੀ ਤਤੁ ਪਰੋਤਾ ॥",
      "transliteration": "sad bairaagee tat parotaa ||",
      "translation": "Forever detached, I am woven into the essence of reality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਗੁ ਸੂਤਾ ਮਰਿ ਆਵੈ ਜਾਇ ॥",
      "transliteration": "jag sootaa mar aavai jaai ||",
      "translation": "The world is asleep; it dies, and comes and goes in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਨੁ ਗੁਰਸਬਦ ਨ ਸੋਝੀ ਪਾਇ ॥੬॥",
      "transliteration": "bin gurasabad na sojhee paai ||6||",
      "translation": "Without the Word of the Guru's Shabad, it does not understand. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਨਹਦ ਸਬਦੁ ਵਜੈ ਦਿਨੁ ਰਾਤੀ ॥",
      "transliteration": "anahad sabad vajai din raatee ||",
      "translation": "The unstruck sound current of the Shabad vibrates day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਵਿਗਤ ਕੀ ਗਤਿ ਗੁਰਮੁਖਿ ਜਾਤੀ ॥",
      "transliteration": "avigat kee gat guramukh jaatee ||",
      "translation": "The Gurmukh knows the state of the eternal, unchanging Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਉ ਜਾਨੀ ਜਾ ਸਬਦਿ ਪਛਾਨੀ ॥",
      "transliteration": "tau jaanee jaa sabad pachhaanee ||",
      "translation": "When someone realizes the Shabad, then he truly knows.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਏਕੋ ਰਵਿ ਰਹਿਆ ਨਿਰਬਾਨੀ ॥੭॥",
      "transliteration": "eko rav rahiaa nirabaanee ||7||",
      "translation": "The One Lord is permeating and pervading everywhere in Nirvaanaa. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੁੰਨ ਸਮਾਧਿ ਸਹਜਿ ਮਨੁ ਰਾਤਾ ॥",
      "transliteration": "su(n)n samaadh sahaj man raataa ||",
      "translation": "My mind is intuitively absorbed in the state of deepest Samaadhi;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਜਿ ਹਉ ਲੋਭਾ ਏਕੋ ਜਾਤਾ ॥",
      "transliteration": "taj hau lobhaa eko jaataa ||",
      "translation": "renouncing egotism and greed, I have come to know the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗੁਰ ਚੇਲੇ ਅਪਨਾ ਮਨੁ ਮਾਨਿਆ ॥",
      "transliteration": "gur chele apanaa man maaniaa ||",
      "translation": "When the disciple's mind accepts the Guru,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਦੂਜਾ ਮੇਟਿ ਸਮਾਨਿਆ ॥੮॥੩॥",
      "transliteration": "naanak doojaa met samaaniaa ||8||3||",
      "translation": "O Nanak, duality is eradicated, and he merges in the Lord. ||8||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "raamakalee mahalaa 1 ||",
      "translation": "Raamkalee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਹਾ ਗਣਹਿ ਨ ਕਰਹਿ ਬੀਚਾਰੁ ॥",
      "transliteration": "saahaa ganahi na karahi beechaar ||",
      "translation": "You calculate the auspicious days, but you do not understand",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਾਹੇ ਊਪਰਿ ਏਕੰਕਾਰੁ ॥",
      "transliteration": "saahe oopar eka(n)kaar ||",
      "translation": "that the One Creator Lord is above these auspicious days.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਸੁ ਗੁਰੁ ਮਿਲੈ ਸੋਈ ਬਿਧਿ ਜਾਣੈ ॥",
      "transliteration": "jis gur milai soee bidh jaanai ||",
      "translation": "He alone knows the way, who meets the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰਮਤਿ ਹੋਇ ਤ ਹੁਕਮੁ ਪਛਾਣੈ ॥੧॥",
      "transliteration": "guramat hoi ta hukam pachhaanai ||1||",
      "translation": "When one follows the Guru's Teachings, then he realizes the Hukam of God's Command. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਝੂਠੁ ਨ ਬੋਲਿ ਪਾਡੇ ਸਚੁ ਕਹੀਐ ॥",
      "transliteration": "jhooth na bol paade sach kaheeai ||",
      "translation": "Do not tell lies, O Pandit; O religious scholar, speak the Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਉਮੈ ਜਾਇ ਸਬਦਿ ਘਰੁ ਲਹੀਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "haumai jaai sabad ghar laheeai ||1|| rahaau ||",
      "translation": "When egotism is eradicated through the Word of the Shabad, then one finds His home. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਣਿ ਗਣਿ ਜੋਤਕੁ ਕਾਂਡੀ ਕੀਨੀ ॥",
      "transliteration": "gan gan jotak kaa(n)dee keenee ||",
      "translation": "Calculating and counting, the astrologer draws the horoscope.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪੜੈ ਸੁਣਾਵੈ ਤਤੁ ਨ ਚੀਨੀ ॥",
      "transliteration": "paRai sunaavai tat na cheenee ||",
      "translation": "He studies it and announces it, but he does not understand reality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭਸੈ ਊਪਰਿ ਗੁਰਸਬਦੁ ਬੀਚਾਰੁ ॥",
      "transliteration": "sabhasai oopar gurasabad beechaar ||",
      "translation": "Understand, that the Word of the Guru's Shabad is above all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹੋਰ ਕਥਨੀ ਬਦਉ ਨ ਸਗਲੀ ਛਾਰੁ ॥੨॥",
      "transliteration": "hor kathanee badau na sagalee chhaar ||2||",
      "translation": "Do not speak of anything else; it is all just ashes. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾਵਹਿ ਧੋਵਹਿ ਪੂਜਹਿ ਸੈਲਾ ॥",
      "transliteration": "naavahi dhovahi poojahi sailaa ||",
      "translation": "You bathe, wash, and worship stones.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਰਾਤੇ ਮੈਲੋ ਮੈਲਾ ॥",
      "transliteration": "bin har raate mailo mailaa ||",
      "translation": "But without being imbued with the Lord, you are the filthiest of the filthy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗਰਬੁ ਨਿਵਾਰਿ ਮਿਲੈ ਪ੍ਰਭੁ ਸਾਰਥਿ ॥",
      "transliteration": "garab nivaar milai prabh saarath ||",
      "translation": "Subduing your pride, you shall receive the supreme wealth of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮੁਕਤਿ ਪ੍ਰਾਨ ਜਪਿ ਹਰਿ ਕਿਰਤਾਰਥਿ ॥੩॥",
      "transliteration": "mukat praan jap har kirataarath ||3||",
      "translation": "The mortal is liberated and emancipated, meditating on the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਵਾਚੈ ਵਾਦੁ ਨ ਬੇਦੁ ਬੀਚਾਰੈ ॥",
      "transliteration": "vaachai vaad na bed beechaarai ||",
      "translation": "You study the arguments, but do not contemplate the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਆਪਿ ਡੁਬੈ ਕਿਉ ਪਿਤਰਾ ਤਾਰੈ ॥",
      "transliteration": "aap dubai kiu pitaraa taarai ||",
      "translation": "You drown yourself - how will you save your ancestors?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਬ੍ਰਹਮੁ ਚੀਨੈ ਜਨੁ ਕੋਇ ॥",
      "transliteration": "ghat ghat braham cheenai jan koi ||",
      "translation": "How rare is that person who realizes that God is in each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮਿਲੈ ਤ ਸੋਝੀ ਹੋਇ ॥੪॥",
      "transliteration": "satigur milai ta sojhee hoi ||4||",
      "translation": "When one meets the True Guru, then he understands. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗਣਤ ਗਣੀਐ ਸਹਸਾ ਦੁਖੁ ਜੀਐ ॥",
      "transliteration": "ganat ganeeai sahasaa dukh jeeai ||",
      "translation": "Making his calculations, cynicism and suffering afflict his soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰ ਕੀ ਸਰਣਿ ਪਵੈ ਸੁਖੁ ਥੀਐ ॥",
      "transliteration": "gur kee saran pavai sukh theeai ||",
      "translation": "Seeking the Sanctuary of the Guru, peace is found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਰਿ ਅਪਰਾਧ ਸਰਣਿ ਹਮ ਆਇਆ ॥",
      "transliteration": "kar aparaadh saran ham aaiaa ||",
      "translation": "I sinned and made mistakes, but now I seek Your Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗੁਰ ਹਰਿ ਭੇਟੇ ਪੁਰਬਿ ਕਮਾਇਆ ॥੫॥",
      "transliteration": "gur har bhete purab kamaaiaa ||5||",
      "translation": "The Guru led me to meet the Lord, according to my past actions. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰ ਸਰਣਿ ਨ ਆਈਐ ਬ੍ਰਹਮੁ ਨ ਪਾਈਐ ॥",
      "transliteration": "gur saran na aaeeai braham na paaeeai ||",
      "translation": "If one does not enter the Guru's Sanctuary, God cannot be found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਭਰਮਿ ਭੁਲਾਈਐ ਜਨਮਿ ਮਰਿ ਆਈਐ ॥",
      "transliteration": "bharam bhulaaeeai janam mar aaeeai ||",
      "translation": "Deluded by doubt, one is born, only to die, and come back again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਮ ਦਰਿ ਬਾਧਉ ਮਰੈ ਬਿਕਾਰੁ ॥",
      "transliteration": "jam dar baadhau marai bikaar ||",
      "translation": "Dying in corruption, he is bound and gagged at Death's door.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾ ਰਿਦੈ ਨਾਮੁ ਨ ਸਬਦੁ ਅਚਾਰੁ ॥੬॥",
      "transliteration": "naa ridai naam na sabad achaar ||6||",
      "translation": "The Naam, the Name of the Lord, is not in his heart, and he does not act according to the Shabad. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਇਕਿ ਪਾਧੇ ਪੰਡਿਤ ਮਿਸਰ ਕਹਾਵਹਿ ॥",
      "transliteration": "ik paadhe pa(n)dit misar kahaavahi ||",
      "translation": "Some call themselves Pandits, religious scholars and spiritual teachers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0904_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਦੁਬਿਧਾ ਰਾਤੇ ਮਹਲੁ ਨ ਪਾਵਹਿ ॥",
      "transliteration": "dubidhaa raate mahal na paavahi ||",
      "translation": "Tinged with double-mindedness, they do not find the Mansion of the Lord's Presence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 904,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
