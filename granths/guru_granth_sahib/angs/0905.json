{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 905,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0905_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਸੁ ਗੁਰ ਪਰਸਾਦੀ ਨਾਮੁ ਅਧਾਰੁ ॥",
      "transliteration": "jis gur parasaadee naam adhaar ||",
      "translation": "One who takes the Support of the Naam, by Guru's Grace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੋਟਿ ਮਧੇ ਕੋ ਜਨੁ ਆਪਾਰੁ ॥੭॥",
      "transliteration": "kot madhe ko jan aapaar ||7||",
      "translation": "is a rare person, one among millions, incomparable. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਏਕੁ ਬੁਰਾ ਭਲਾ ਸਚੁ ਏਕੈ ॥",
      "transliteration": "ek buraa bhalaa sach ekai ||",
      "translation": "One is bad, and another good, but the One True Lord is contained in all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬੂਝੁ ਗਿਆਨੀ ਸਤਗੁਰ ਕੀ ਟੇਕੈ ॥",
      "transliteration": "boojh giaanee satagur kee tekai ||",
      "translation": "Understand this, O spiritual teacher, through the support of the True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਵਿਰਲੀ ਏਕੋ ਜਾਣਿਆ ॥",
      "transliteration": "guramukh viralee eko jaaniaa ||",
      "translation": "rare indeed is that Gurmukh, who realizes the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਵਣੁ ਜਾਣਾ ਮੇਟਿ ਸਮਾਣਿਆ ॥੮॥",
      "transliteration": "aavan jaanaa met samaaniaa ||8||",
      "translation": "His comings and goings cease, and he merges in the Lord. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਿਨ ਕੈ ਹਿਰਦੈ ਏਕੰਕਾਰੁ ॥",
      "transliteration": "jin kai hiradai eka(n)kaar ||",
      "translation": "Those who have the One Universal Creator Lord within their hearts,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਰਬ ਗੁਣੀ ਸਾਚਾ ਬੀਚਾਰੁ ॥",
      "transliteration": "sarab gunee saachaa beechaar ||",
      "translation": "possess all virtues; they contemplate the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰ ਕੈ ਭਾਣੈ ਕਰਮ ਕਮਾਵੈ ॥",
      "transliteration": "gur kai bhaanai karam kamaavai ||",
      "translation": "One who acts in harmony with the Guru's Will,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਨਕ ਸਾਚੇ ਸਾਚਿ ਸਮਾਵੈ ॥੯॥੪॥",
      "transliteration": "naanak saache saach samaavai ||9||4||",
      "translation": "O Nanak, is absorbed in the Truest of the True. ||9||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "raamakalee mahalaa 1 ||",
      "translation": "Raamkalee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਠੁ ਨਿਗ੍ਰਹੁ ਕਰਿ ਕਾਇਆ ਛੀਜੈ ॥",
      "transliteration": "hath nigrahu kar kaaiaa chheejai ||",
      "translation": "Practicing restraint by Hatha Yoga, the body wears away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਵਰਤੁ ਤਪਨੁ ਕਰਿ ਮਨੁ ਨਹੀ ਭੀਜੈ ॥",
      "transliteration": "varat tapan kar man nahee bheejai ||",
      "translation": "The mind is not softened by fasting or austerities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਸਰਿ ਅਵਰੁ ਨ ਪੂਜੈ ॥੧॥",
      "transliteration": "raam naam sar avar na poojai ||1||",
      "translation": "Nothing else is equal to worship of the Lord's Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰੁ ਸੇਵਿ ਮਨਾ ਹਰਿ ਜਨ ਸੰਗੁ ਕੀਜੈ ॥",
      "transliteration": "gur sev manaa har jan sa(n)g keejai ||",
      "translation": "Serve the Guru, O mind, and associate with the humble servants of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਮੁ ਜੰਦਾਰੁ ਜੋਹਿ ਨਹੀ ਸਾਕੈ ਸਰਪਨਿ ਡਸਿ ਨ ਸਕੈ ਹਰਿ ਕਾ ਰਸੁ ਪੀਜੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jam ja(n)daar johi nahee saakai sarapan das na sakai har kaa ras peejai ||1|| rahaau ||",
      "translation": "The tyrannical Messenger of Death cannot touch you, and the serpent of Maya cannot sting you, when you drink in the sublime essence of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਵਾਦੁ ਪੜੈ ਰਾਗੀ ਜਗੁ ਭੀਜੈ ॥",
      "transliteration": "vaad paRai raagee jag bheejai ||",
      "translation": "The world reads the arguments, and is softened only by music.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤ੍ਰੈ ਗੁਣ ਬਿਖਿਆ ਜਨਮਿ ਮਰੀਜੈ ॥",
      "transliteration": "trai gun bikhiaa janam mareejai ||",
      "translation": "In the three modes and corruption, they are born and die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਬਿਨੁ ਦੂਖੁ ਸਹੀਜੈ ॥੨॥",
      "transliteration": "raam naam bin dookh saheejai ||2||",
      "translation": "Without the Lord's Name, they endure suffering and pain. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚਾੜਸਿ ਪਵਨੁ ਸਿੰਘਾਸਨੁ ਭੀਜੈ ॥",
      "transliteration": "chaaRas pavan si(n)ghaasan bheejai ||",
      "translation": "The Yogi draws the breath upwards, and opens the Tenth Gate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਿਉਲੀ ਕਰਮ ਖਟੁ ਕਰਮ ਕਰੀਜੈ ॥",
      "transliteration": "niulee karam khat karam kareejai ||",
      "translation": "He practices inner cleansing and the six rituals of purification.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਬਿਨੁ ਬਿਰਥਾ ਸਾਸੁ ਲੀਜੈ ॥੩॥",
      "transliteration": "raam naam bin birathaa saas leejai ||3||",
      "translation": "But without the Lord's Name, the breath he draws is useless. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅੰਤਰਿ ਪੰਚ ਅਗਨਿ ਕਿਉ ਧੀਰਜੁ ਧੀਜੈ ॥",
      "transliteration": "a(n)tar pa(n)ch agan kiu dheeraj dheejai ||",
      "translation": "The fire of the five passions burns within him; how can he be calm?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅੰਤਰਿ ਚੋਰੁ ਕਿਉ ਸਾਦੁ ਲਹੀਜੈ ॥",
      "transliteration": "a(n)tar chor kiu saad laheejai ||",
      "translation": "The thief is within him; how can he taste the taste?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਹੋਇ ਕਾਇਆ ਗੜੁ ਲੀਜੈ ॥੪॥",
      "transliteration": "guramukh hoi kaaiaa gaR leejai ||4||",
      "translation": "One who becomes Gurmukh conquers the body-fortress. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅੰਤਰਿ ਮੈਲੁ ਤੀਰਥ ਭਰਮੀਜੈ ॥",
      "transliteration": "a(n)tar mail teerath bharameejai ||",
      "translation": "With filth within, he wanders around at places of pilgrimage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਨੁ ਨਹੀ ਸੂਚਾ ਕਿਆ ਸੋਚ ਕਰੀਜੈ ॥",
      "transliteration": "man nahee soochaa kiaa soch kareejai ||",
      "translation": "His mind is not pure, so what is the use of performing ritual cleansings?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਿਰਤੁ ਪਇਆ ਦੋਸੁ ਕਾ ਕਉ ਦੀਜੈ ॥੫॥",
      "transliteration": "kirat paiaa dos kaa kau deejai ||5||",
      "translation": "He carries the karma of his own past actions; who else can he blame? ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅੰਨੁ ਨ ਖਾਹਿ ਦੇਹੀ ਦੁਖੁ ਦੀਜੈ ॥",
      "transliteration": "a(n)n na khaahi dehee dukh deejai ||",
      "translation": "He does not eat food; he tortures his body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਗਿਆਨ ਤ੍ਰਿਪਤਿ ਨਹੀ ਥੀਜੈ ॥",
      "transliteration": "bin gur giaan tripat nahee theejai ||",
      "translation": "Without the Guru's wisdom, he is not satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਨਮੁਖਿ ਜਨਮੈ ਜਨਮਿ ਮਰੀਜੈ ॥੬॥",
      "transliteration": "manamukh janamai janam mareejai ||6||",
      "translation": "The self-willed manmukh is born only to die, and be born again. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਤਿਗੁਰ ਪੂਛਿ ਸੰਗਤਿ ਜਨ ਕੀਜੈ ॥",
      "transliteration": "satigur poochh sa(n)gat jan keejai ||",
      "translation": "Go, and ask the True Guru, and associate with the Lord's humble servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਨੁ ਹਰਿ ਰਾਚੈ ਨਹੀ ਜਨਮਿ ਮਰੀਜੈ ॥",
      "transliteration": "man har raachai nahee janam mareejai ||",
      "translation": "Your mind shall merge into the Lord, and you shall not be reincarnated to die again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਬਿਨੁ ਕਿਆ ਕਰਮੁ ਕੀਜੈ ॥੭॥",
      "transliteration": "raam naam bin kiaa karam keejai ||7||",
      "translation": "Without the Lord's Name, what can anyone do? ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਊਂਦਰ ਦੂੰਦਰ ਪਾਸਿ ਧਰੀਜੈ ॥",
      "transliteration": "oo(n)dar doo(n)dar paas dhareejai ||",
      "translation": "Silence the mouse scurrying around within you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਧੁਰ ਕੀ ਸੇਵਾ ਰਾਮੁ ਰਵੀਜੈ ॥",
      "transliteration": "dhur kee sevaa raam raveejai ||",
      "translation": "Serve the Primal Lord, by chanting the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਮਿਲੈ ਕਿਰਪਾ ਪ੍ਰਭ ਕੀਜੈ ॥੮॥੫॥",
      "transliteration": "naanak naam milai kirapaa prabh keejai ||8||5||",
      "translation": "O Nanak, God blesses us with His Name, when He grants His Grace. ||8||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "raamakalee mahalaa 1 ||",
      "translation": "Raamkalee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅੰਤਰਿ ਉਤਭੁਜੁ ਅਵਰੁ ਨ ਕੋਈ ॥",
      "transliteration": "a(n)tar utabhuj avar na koee ||",
      "translation": "The created Universe emanated from within You; there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੋ ਕਹੀਐ ਸੋ ਪ੍ਰਭ ਤੇ ਹੋਈ ॥",
      "transliteration": "jo kaheeai so prabh te hoee ||",
      "translation": "Whatever is said to be, is from You, O God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੁਗਹ ਜੁਗੰਤਰਿ ਸਾਹਿਬੁ ਸਚੁ ਸੋਈ ॥",
      "transliteration": "jugah juga(n)tar saahib sach soee ||",
      "translation": "He is the True Lord and Master, throughout the ages.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਉਤਪਤਿ ਪਰਲਉ ਅਵਰੁ ਨ ਕੋਈ ॥੧॥",
      "transliteration": "utapat paralau avar na koee ||1||",
      "translation": "Creation and destruction do not come from anyone else. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਐਸਾ ਮੇਰਾ ਠਾਕੁਰੁ ਗਹਿਰ ਗੰਭੀਰੁ ॥",
      "transliteration": "aisaa meraa thaakur gahir ga(n)bheer ||",
      "translation": "Such is my Lord and Master, profound and unfathomable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਨਿ ਜਪਿਆ ਤਿਨ ਹੀ ਸੁਖੁ ਪਾਇਆ ਹਰਿ ਕੈ ਨਾਮਿ ਨ ਲਗੈ ਜਮ ਤੀਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jin japiaa tin hee sukh paaiaa har kai naam na lagai jam teer ||1|| rahaau ||",
      "translation": "Whoever meditates on Him, finds peace. The arrow of the Messenger of Death does not strike one who has the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਮੁ ਰਤਨੁ ਹੀਰਾ ਨਿਰਮੋਲੁ ॥",
      "transliteration": "naam ratan heeraa niramol ||",
      "translation": "The Naam, the Name of the Lord, is a priceless jewel, a diamond.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਾਚਾ ਸਾਹਿਬੁ ਅਮਰੁ ਅਤੋਲੁ ॥",
      "transliteration": "saachaa saahib amar atol ||",
      "translation": "The True Lord Master is immortal and immeasurable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਿਹਵਾ ਸੂਚੀ ਸਾਚਾ ਬੋਲੁ ॥",
      "transliteration": "jihavaa soochee saachaa bol ||",
      "translation": "That tongue which chants the True Name is pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਘਰਿ ਦਰਿ ਸਾਚਾ ਨਾਹੀ ਰੋਲੁ ॥੨॥",
      "transliteration": "ghar dar saachaa naahee rol ||2||",
      "translation": "The True Lord is in the home of the self; there is no doubt about it. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਇਕਿ ਬਨ ਮਹਿ ਬੈਸਹਿ ਡੂਗਰਿ ਅਸਥਾਨੁ ॥",
      "transliteration": "ik ban mahi baisahi doogar asathaan ||",
      "translation": "Some sit in the forests, and some make their home in the mountains.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਮੁ ਬਿਸਾਰਿ ਪਚਹਿ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "naam bisaar pachahi abhimaan ||",
      "translation": "Forgetting the Naam, they rot away in egotistical pride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਕਿਆ ਗਿਆਨ ਧਿਆਨੁ ॥",
      "transliteration": "naam binaa kiaa giaan dhiaan ||",
      "translation": "Without the Naam, what is the use of spiritual wisdom and meditation?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਾਵਹਿ ਦਰਗਹਿ ਮਾਨੁ ॥੩॥",
      "transliteration": "guramukh paavahi daragahi maan ||3||",
      "translation": "The Gurmukhs are honored in the Court of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਹਠੁ ਅਹੰਕਾਰੁ ਕਰੈ ਨਹੀ ਪਾਵੈ ॥",
      "transliteration": "hath aha(n)kaar karai nahee paavai ||",
      "translation": "Acting stubbornly in egotism, one does not find the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0905_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪਾਠ ਪੜੈ ਲੇ ਲੋਕ ਸੁਣਾਵੈ ॥",
      "transliteration": "paath paRai le lok sunaavai ||",
      "translation": "Studying the scriptures, reading them to other people,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 905,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
