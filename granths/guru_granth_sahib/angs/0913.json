{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 913,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0913_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਿਨਹੀ ਕਹਿਆ ਬਾਹ ਬਹੁ ਭਾਈ ॥",
      "transliteration": "kinahee kahiaa baah bahu bhaaee ||",
      "translation": "Some say that they have the arms of their many brothers to protect them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕੋਈ ਕਹੈ ਮੈ ਧਨਹਿ ਪਸਾਰਾ ॥",
      "transliteration": "koee kahai mai dhanahi pasaaraa ||",
      "translation": "Some say that they have great expanses of wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੋਹਿ ਦੀਨ ਹਰਿ ਹਰਿ ਆਧਾਰਾ ॥੪॥",
      "transliteration": "mohi deen har har aadhaaraa ||4||",
      "translation": "I am meek; I have the support of the Lord, Har, Har. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਿਨਹੀ ਘੂਘਰ ਨਿਰਤਿ ਕਰਾਈ ॥",
      "transliteration": "kinahee ghooghar nirat karaaee ||",
      "translation": "Some dance, wearing ankle bells.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਿਨਹੂ ਵਰਤ ਨੇਮ ਮਾਲਾ ਪਾਈ ॥",
      "transliteration": "kinahoo varat nem maalaa paaee ||",
      "translation": "Some fast and take vows, and wear malas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਿਨਹੀ ਤਿਲਕੁ ਗੋਪੀ ਚੰਦਨ ਲਾਇਆ ॥",
      "transliteration": "kinahee tilak gopee cha(n)dan laaiaa ||",
      "translation": "Some apply ceremonial tilak marks to their foreheads.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੋਹਿ ਦੀਨ ਹਰਿ ਹਰਿ ਹਰਿ ਧਿਆਇਆ ॥੫॥",
      "transliteration": "mohi deen har har har dhiaaiaa ||5||",
      "translation": "I am meek; I meditate on the Lord, Har, Har, Har. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿਨਹੀ ਸਿਧ ਬਹੁ ਚੇਟਕ ਲਾਏ ॥",
      "transliteration": "kinahee sidh bahu chetak laae ||",
      "translation": "Some work spells using the miraculous spiritual powers of the Siddhas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਿਨਹੀ ਭੇਖ ਬਹੁ ਥਾਟ ਬਨਾਏ ॥",
      "transliteration": "kinahee bhekh bahu thaat banaae ||",
      "translation": "Some wear various religious robes and establish their authority.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਿਨਹੀ ਤੰਤ ਮੰਤ ਬਹੁ ਖੇਵਾ ॥",
      "transliteration": "kinahee ta(n)t ma(n)t bahu khevaa ||",
      "translation": "Some perform Tantric spells, and chant various mantras.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੋਹਿ ਦੀਨ ਹਰਿ ਹਰਿ ਹਰਿ ਸੇਵਾ ॥੬॥",
      "transliteration": "mohi deen har har har sevaa ||6||",
      "translation": "I am meek; I serve the Lord, Har, Har, Har. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕੋਈ ਚਤੁਰੁ ਕਹਾਵੈ ਪੰਡਿਤ ॥",
      "transliteration": "koee chatur kahaavai pa(n)dit ||",
      "translation": "One calls himself a wise Pandit, a religious scholar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕੋ ਖਟੁ ਕਰਮ ਸਹਿਤ ਸਿਉ ਮੰਡਿਤ ॥",
      "transliteration": "ko khat karam sahit siu ma(n)dit ||",
      "translation": "One performs the six rituals to appease Shiva.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੋਈ ਕਰੈ ਆਚਾਰ ਸੁਕਰਣੀ ॥",
      "transliteration": "koee karai aachaar sukaranee ||",
      "translation": "One maintains the rituals of pure lifestyle, and does good deeds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮੋਹਿ ਦੀਨ ਹਰਿ ਹਰਿ ਹਰਿ ਸਰਣੀ ॥੭॥",
      "transliteration": "mohi deen har har har saranee ||7||",
      "translation": "I am meek; I seek the Sanctuary of the Lord, Har, Har, Har. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਗਲੇ ਕਰਮ ਧਰਮ ਜੁਗ ਸੋਧੇ ॥",
      "transliteration": "sagale karam dharam jug sodhe ||",
      "translation": "I have studied the religions and rituals of all the ages.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਇਹੁ ਮਨੁ ਨ ਪ੍ਰਬੋਧੇ ॥",
      "transliteration": "bin naavai ihu man na prabodhe ||",
      "translation": "Without the Name, this mind is not awakened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਉ ਸਾਧਸੰਗੁ ਪਾਇਆ ॥",
      "transliteration": "kahu naanak jau saadhasa(n)g paaiaa ||",
      "translation": "Says Nanak, when I found the Saadh Sangat, the Company of the Holy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬੂਝੀ ਤ੍ਰਿਸਨਾ ਮਹਾ ਸੀਤਲਾਇਆ ॥੮॥੧॥",
      "transliteration": "boojhee trisanaa mahaa seetalaaiaa ||8||1||",
      "translation": "my thirsty desires were satisfied, and I was totally cooled and soothed. ||8||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਸੁ ਪਾਨੀ ਤੇ ਜਿਨਿ ਤੂ ਘਰਿਆ ॥",
      "transliteration": "is paanee te jin too ghariaa ||",
      "translation": "He created you out of this water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਮਾਟੀ ਕਾ ਲੇ ਦੇਹੁਰਾ ਕਰਿਆ ॥",
      "transliteration": "maatee kaa le dehuraa kariaa ||",
      "translation": "From clay, He fashioned your body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਉਕਤਿ ਜੋਤਿ ਲੈ ਸੁਰਤਿ ਪਰੀਖਿਆ ॥",
      "transliteration": "ukat jot lai surat pareekhiaa ||",
      "translation": "He blessed you with the light of reason and clear consciousness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਾਤ ਗਰਭ ਮਹਿ ਜਿਨਿ ਤੂ ਰਾਖਿਆ ॥੧॥",
      "transliteration": "maat garabh mahi jin too raakhiaa ||1||",
      "translation": "In your mother's womb, He preserved you. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਰਾਖਨਹਾਰੁ ਸਮ੍ਹਾਰਿ ਜਨਾ ॥",
      "transliteration": "raakhanahaar samhaar janaa ||",
      "translation": "Contemplate your Savior Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਗਲੇ ਛੋਡਿ ਬੀਚਾਰ ਮਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sagale chhod beechaar manaa ||1|| rahaau ||",
      "translation": "Give up all others thoughts, O mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਿਨਿ ਦੀਏ ਤੁਧੁ ਬਾਪ ਮਹਤਾਰੀ ॥",
      "transliteration": "jin deee tudh baap mahataaree ||",
      "translation": "He gave you your mother and father;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਿਨਿ ਦੀਏ ਭ੍ਰਾਤ ਪੁਤ ਹਾਰੀ ॥",
      "transliteration": "jin deee bhraat put haaree ||",
      "translation": "he gave you your charming children and siblings;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਨਿ ਦੀਏ ਤੁਧੁ ਬਨਿਤਾ ਅਰੁ ਮੀਤਾ ॥",
      "transliteration": "jin deee tudh banitaa ar meetaa ||",
      "translation": "he gave you your spouse and friends;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਿਸੁ ਠਾਕੁਰ ਕਉ ਰਖਿ ਲੇਹੁ ਚੀਤਾ ॥੨॥",
      "transliteration": "tis thaakur kau rakh lehu cheetaa ||2||",
      "translation": "enshrine that Lord and Master in your consciousness. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਨਿ ਦੀਆ ਤੁਧੁ ਪਵਨੁ ਅਮੋਲਾ ॥",
      "transliteration": "jin deeaa tudh pavan amolaa ||",
      "translation": "He gave you the invaluable air;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਿਨਿ ਦੀਆ ਤੁਧੁ ਨੀਰੁ ਨਿਰਮੋਲਾ ॥",
      "transliteration": "jin deeaa tudh neer niramolaa ||",
      "translation": "He gave you the priceless water;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਨਿ ਦੀਆ ਤੁਧੁ ਪਾਵਕੁ ਬਲਨਾ ॥",
      "transliteration": "jin deeaa tudh paavak balanaa ||",
      "translation": "He gave you burning fire;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਿਸੁ ਠਾਕੁਰ ਕੀ ਰਹੁ ਮਨ ਸਰਨਾ ॥੩॥",
      "transliteration": "tis thaakur kee rahu man saranaa ||3||",
      "translation": "let your mind remain in the Sanctuary of that Lord and Master. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਛਤੀਹ ਅੰਮ੍ਰਿਤ ਜਿਨਿ ਭੋਜਨ ਦੀਏ ॥",
      "transliteration": "chhateeh a(n)mrit jin bhojan deee ||",
      "translation": "He gave you the thirty-six varieties of tasty foods;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅੰਤਰਿ ਥਾਨ ਠਹਰਾਵਨ ਕਉ ਕੀਏ ॥",
      "transliteration": "a(n)tar thaan thaharaavan kau keee ||",
      "translation": "He gave you a place within to hold them;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਸੁਧਾ ਦੀਓ ਬਰਤਨਿ ਬਲਨਾ ॥",
      "transliteration": "basudhaa deeo baratan balanaa ||",
      "translation": "He gave you the earth, and things to use;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਿਸੁ ਠਾਕੁਰ ਕੇ ਚਿਤਿ ਰਖੁ ਚਰਨਾ ॥੪॥",
      "transliteration": "tis thaakur ke chit rakh charanaa ||4||",
      "translation": "enshrine in your consciousness the feet of that Lord and Master. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪੇਖਨ ਕਉ ਨੇਤ੍ਰ ਸੁਨਨ ਕਉ ਕਰਨਾ ॥",
      "transliteration": "pekhan kau netr sunan kau karanaa ||",
      "translation": "He gave you eyes to see, and ears to hear;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਸਤ ਕਮਾਵਨ ਬਾਸਨ ਰਸਨਾ ॥",
      "transliteration": "hasat kamaavan baasan rasanaa ||",
      "translation": "He gave you hands to work with, and a nose and a tongue;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਰਨ ਚਲਨ ਕਉ ਸਿਰੁ ਕੀਨੋ ਮੇਰਾ ॥",
      "transliteration": "charan chalan kau sir keeno meraa ||",
      "translation": "He gave you feet to walk upon, and the crowning glory of your head;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਨ ਤਿਸੁ ਠਾਕੁਰ ਕੇ ਪੂਜਹੁ ਪੈਰਾ ॥੫॥",
      "transliteration": "man tis thaakur ke poojahu pairaa ||5||",
      "translation": "O mind, worship the Feet of that Lord and Master. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਪਵਿਤ੍ਰ ਪਵਿਤ੍ਰੁ ਜਿਨਿ ਤੂ ਕਰਿਆ ॥",
      "transliteration": "apavitr pavitr jin too kariaa ||",
      "translation": "He transformed you from impure to pure;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਗਲ ਜੋਨਿ ਮਹਿ ਤੂ ਸਿਰਿ ਧਰਿਆ ॥",
      "transliteration": "sagal jon mahi too sir dhariaa ||",
      "translation": "He installed you above the heads of all creatures;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਬ ਤੂ ਸੀਝੁ ਭਾਵੈ ਨਹੀ ਸੀਝੈ ॥",
      "transliteration": "ab too seejh bhaavai nahee seejhai ||",
      "translation": "now, you may fulfill your destiny or not;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਾਰਜੁ ਸਵਰੈ ਮਨ ਪ੍ਰਭੁ ਧਿਆਈਜੈ ॥੬॥",
      "transliteration": "kaaraj savarai man prabh dhiaaeejai ||6||",
      "translation": "Your affairs shall be resolved, O mind, meditating on God. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਈਹਾ ਊਹਾ ਏਕੈ ਓਹੀ ॥",
      "transliteration": "eehaa oohaa ekai ohee ||",
      "translation": "Here and there, only the One God exists.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਤ ਕਤ ਦੇਖੀਐ ਤਤ ਤਤ ਤੋਹੀ ॥",
      "transliteration": "jat kat dekheeai tat tat tohee ||",
      "translation": "Wherever I look, there You are.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤਿਸੁ ਸੇਵਤ ਮਨਿ ਆਲਸੁ ਕਰੈ ॥",
      "transliteration": "tis sevat man aalas karai ||",
      "translation": "My mind is reluctant to serve Him;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਸੁ ਵਿਸਰਿਐ ਇਕ ਨਿਮਖ ਨ ਸਰੈ ॥੭॥",
      "transliteration": "jis visariai ik nimakh na sarai ||7||",
      "translation": "forgetting Him, I cannot survive, even for an instant. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਮ ਅਪਰਾਧੀ ਨਿਰਗੁਨੀਆਰੇ ॥",
      "transliteration": "ham aparaadhee niraguneeaare ||",
      "translation": "I am a sinner, without any virtue at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾ ਕਿਛੁ ਸੇਵਾ ਨਾ ਕਰਮਾਰੇ ॥",
      "transliteration": "naa kichh sevaa naa karamaare ||",
      "translation": "I do not serve You, or do any good deeds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰੁ ਬੋਹਿਥੁ ਵਡਭਾਗੀ ਮਿਲਿਆ ॥",
      "transliteration": "gur bohith vadabhaagee miliaa ||",
      "translation": "By great good fortune, I have found the boat - the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਸੰਗਿ ਪਾਥਰ ਤਰਿਆ ॥੮॥੨॥",
      "transliteration": "naanak daas sa(n)g paathar tariaa ||8||2||",
      "translation": "Slave Nanak has crossed over, with Him. ||8||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0913_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਰੰਗ ਰਸ ਰੂਪ ॥",
      "transliteration": "kaahoo bihaavai ra(n)g ras roop ||",
      "translation": "Some pass their lives enjoying pleasures and beauty.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 913,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
