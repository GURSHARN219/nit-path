{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 914,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0914_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਮਾਇ ਬਾਪ ਪੂਤ ॥",
      "transliteration": "kaahoo bihaavai maai baap poot ||",
      "translation": "Some pass their lives with their mothers, fathers and children.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਰਾਜ ਮਿਲਖ ਵਾਪਾਰਾ ॥",
      "transliteration": "kaahoo bihaavai raaj milakh vaapaaraa ||",
      "translation": "Some pass their lives in power, estates and trade.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੰਤ ਬਿਹਾਵੈ ਹਰਿ ਨਾਮ ਅਧਾਰਾ ॥੧॥",
      "transliteration": "sa(n)t bihaavai har naam adhaaraa ||1||",
      "translation": "The Saints pass their lives with the support of the Lord's Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਰਚਨਾ ਸਾਚੁ ਬਨੀ ॥",
      "transliteration": "rachanaa saach banee ||",
      "translation": "The world is the creation of the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਭ ਕਾ ਏਕੁ ਧਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sabh kaa ek dhanee ||1|| rahaau ||",
      "translation": "He alone is the Master of all. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਬੇਦ ਅਰੁ ਬਾਦਿ ॥",
      "transliteration": "kaahoo bihaavai bed ar baad ||",
      "translation": "Some pass their lives in arguments and debates about scriptures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਰਸਨਾ ਸਾਦਿ ॥",
      "transliteration": "kaahoo bihaavai rasanaa saad ||",
      "translation": "Some pass their lives tasting flavors.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਲਪਟਿ ਸੰਗਿ ਨਾਰੀ ॥",
      "transliteration": "kaahoo bihaavai lapat sa(n)g naaree ||",
      "translation": "Some pass their lives attached to women.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੰਤ ਰਚੇ ਕੇਵਲ ਨਾਮ ਮੁਰਾਰੀ ॥੨॥",
      "transliteration": "sa(n)t rache keval naam muraaree ||2||",
      "translation": "The Saints are absorbed only in the Name of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਖੇਲਤ ਜੂਆ ॥",
      "transliteration": "kaahoo bihaavai khelat jooaa ||",
      "translation": "Some pass their lives gambling.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਅਮਲੀ ਹੂਆ ॥",
      "transliteration": "kaahoo bihaavai amalee hooaa ||",
      "translation": "Some pass their lives getting drunk.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਪਰ ਦਰਬ ਚੋੁਰਾਏ ॥",
      "transliteration": "kaahoo bihaavai par darab chouraae ||",
      "translation": "Some pass their lives stealing the property of others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਰਿ ਜਨ ਬਿਹਾਵੈ ਨਾਮ ਧਿਆਏ ॥੩॥",
      "transliteration": "har jan bihaavai naam dhiaae ||3||",
      "translation": "The humble servants of the Lord pass their lives meditating on the Naam. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਜੋਗ ਤਪ ਪੂਜਾ ॥",
      "transliteration": "kaahoo bihaavai jog tap poojaa ||",
      "translation": "Some pass their lives in Yoga, strict meditation, worship and adoration.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਾਹੂ ਰੋਗ ਸੋਗ ਭਰਮੀਜਾ ॥",
      "transliteration": "kaahoo rog sog bharameejaa ||",
      "translation": "Some, in sickness, sorrow and doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਾਹੂ ਪਵਨ ਧਾਰ ਜਾਤ ਬਿਹਾਏ ॥",
      "transliteration": "kaahoo pavan dhaar jaat bihaae ||",
      "translation": "Some pass their lives practicing control of the breath.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੰਤ ਬਿਹਾਵੈ ਕੀਰਤਨੁ ਗਾਏ ॥੪॥",
      "transliteration": "sa(n)t bihaavai keeratan gaae ||4||",
      "translation": "The Saints pass their lives singing the Kirtan of the Lord's Praises. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਦਿਨੁ ਰੈਨਿ ਚਾਲਤ ॥",
      "transliteration": "kaahoo bihaavai din rain chaalat ||",
      "translation": "Some pass their lives walking day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਸੋ ਪਿੜੁ ਮਾਲਤ ॥",
      "transliteration": "kaahoo bihaavai so piR maalat ||",
      "translation": "Some pass their lives on the fields of battle.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਬਾਲ ਪੜਾਵਤ ॥",
      "transliteration": "kaahoo bihaavai baal paRaavat ||",
      "translation": "Some pass their lives teaching children.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੰਤ ਬਿਹਾਵੈ ਹਰਿ ਜਸੁ ਗਾਵਤ ॥੫॥",
      "transliteration": "sa(n)t bihaavai har jas gaavat ||5||",
      "translation": "The Saints pass their lives singing the Lord's Praise. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਨਟ ਨਾਟਿਕ ਨਿਰਤੇ ॥",
      "transliteration": "kaahoo bihaavai nat naatik nirate ||",
      "translation": "Some pass their lives as actors, acting and dancing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਜੀਆਇਹ ਹਿਰਤੇ ॥",
      "transliteration": "kaahoo bihaavai jeeaaih hirate ||",
      "translation": "Some pass their lives taking the lives of others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਰਾਜ ਮਹਿ ਡਰਤੇ ॥",
      "transliteration": "kaahoo bihaavai raaj mahi darate ||",
      "translation": "Some pass their lives ruling by intimidation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੰਤ ਬਿਹਾਵੈ ਹਰਿ ਜਸੁ ਕਰਤੇ ॥੬॥",
      "transliteration": "sa(n)t bihaavai har jas karate ||6||",
      "translation": "The Saints pass their lives chanting the Lord's Praises. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਮਤਾ ਮਸੂਰਤਿ ॥",
      "transliteration": "kaahoo bihaavai mataa masoorat ||",
      "translation": "Some pass their lives counseling and giving advice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਸੇਵਾ ਜਰੂਰਤਿ ॥",
      "transliteration": "kaahoo bihaavai sevaa jaroorat ||",
      "translation": "Some pass their lives forced to serve others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਾਹੂ ਬਿਹਾਵੈ ਸੋਧਤ ਜੀਵਤ ॥",
      "transliteration": "kaahoo bihaavai sodhat jeevat ||",
      "translation": "Some pass their lives exploring life's mysteries.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੰਤ ਬਿਹਾਵੈ ਹਰਿ ਰਸੁ ਪੀਵਤ ॥੭॥",
      "transliteration": "sa(n)t bihaavai har ras peevat ||7||",
      "translation": "The Saints pass their lives drinking in the sublime essence of the Lord. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਤੁ ਕੋ ਲਾਇਆ ਤਿਤ ਹੀ ਲਗਾਨਾ ॥",
      "transliteration": "jit ko laaiaa tit hee lagaanaa ||",
      "translation": "As the Lord attaches us, so we are attached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾ ਕੋ ਮੂੜੁ ਨਹੀ ਕੋ ਸਿਆਨਾ ॥",
      "transliteration": "naa ko mooR nahee ko siaanaa ||",
      "translation": "No one is foolish, and no one is wise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਦੇਵੈ ਨਾਉ ॥",
      "transliteration": "kar kirapaa jis devai naau ||",
      "translation": "Nanak is a sacrifice, a sacrifice to those who are blessed",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕੈ ਬਲਿ ਬਲਿ ਜਾਉ ॥੮॥੩॥",
      "transliteration": "naanak taa kai bal bal jaau ||8||3||",
      "translation": "By His Grace to receive His Name. ||8||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਾਮਕਲੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "raamakalee mahalaa 5 ||",
      "translation": "Raamkalee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦਾਵਾ ਅਗਨਿ ਰਹੇ ਹਰਿ ਬੂਟ ॥",
      "transliteration": "daavaa agan rahe har boot ||",
      "translation": "Even in a forest fire, some trees remain green.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਾਤ ਗਰਭ ਸੰਕਟ ਤੇ ਛੂਟ ॥",
      "transliteration": "maat garabh sa(n)kat te chhoot ||",
      "translation": "The infant is released from the pain of the mother's womb.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਾ ਕਾ ਨਾਮੁ ਸਿਮਰਤ ਭਉ ਜਾਇ ॥",
      "transliteration": "jaa kaa naam simarat bhau jaai ||",
      "translation": "Meditating in remembrance on the Naam, the Name of the Lord, fear is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੈਸੇ ਸੰਤ ਜਨਾ ਰਾਖੈ ਹਰਿ ਰਾਇ ॥੧॥",
      "transliteration": "taise sa(n)t janaa raakhai har raai ||1||",
      "translation": "Just so, the Sovereign Lord protects and saves the Saints. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਐਸੇ ਰਾਖਨਹਾਰ ਦਇਆਲ ॥",
      "transliteration": "aise raakhanahaar daiaal ||",
      "translation": "Such is the Merciful Lord, my Protector.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਤ ਕਤ ਦੇਖਉ ਤੁਮ ਪ੍ਰਤਿਪਾਲ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jat kat dekhau tum pratipaal ||1|| rahaau ||",
      "translation": "Wherever I look, I see You cherishing and nurturing. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਲੁ ਪੀਵਤ ਜਿਉ ਤਿਖਾ ਮਿਟੰਤ ॥",
      "transliteration": "jal peevat jiu tikhaa mita(n)t ||",
      "translation": "As thirst is quenched by drinking water;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਧਨ ਬਿਗਸੈ ਗ੍ਰਿਹਿ ਆਵਤ ਕੰਤ ॥",
      "transliteration": "dhan bigasai grihi aavat ka(n)t ||",
      "translation": "as the bride blossoms forth when her husband comes home;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਲੋਭੀ ਕਾ ਧਨੁ ਪ੍ਰਾਣ ਅਧਾਰੁ ॥",
      "transliteration": "lobhee kaa dhan praan adhaar ||",
      "translation": "as wealth is the support of the greedy person",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਉ ਹਰਿ ਜਨ ਹਰਿ ਹਰਿ ਨਾਮ ਪਿਆਰੁ ॥੨॥",
      "transliteration": "tiu har jan har har naam piaar ||2||",
      "translation": "- just so, the humble servant of the Lord loves the Name of the Lord, Har, Har. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਿਰਸਾਨੀ ਜਿਉ ਰਾਖੈ ਰਖਵਾਲਾ ॥",
      "transliteration": "kirasaanee jiu raakhai rakhavaalaa ||",
      "translation": "As the farmer protects his fields;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਦਇਆ ਜਿਉ ਬਾਲਾ ॥",
      "transliteration": "maat pitaa daiaa jiu baalaa ||",
      "translation": "as the mother and father show compassion to their child;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰੀਤਮੁ ਦੇਖਿ ਪ੍ਰੀਤਮੁ ਮਿਲਿ ਜਾਇ ॥",
      "transliteration": "preetam dekh preetam mil jaai ||",
      "translation": "as the lover merges on seeing the beloved;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਉ ਹਰਿ ਜਨ ਰਾਖੈ ਕੰਠਿ ਲਾਇ ॥੩॥",
      "transliteration": "tiu har jan raakhai ka(n)th laai ||3||",
      "translation": "just so does the Lord hug His humble servant close in His Embrace. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਿਉ ਅੰਧੁਲੇ ਪੇਖਤ ਹੋਇ ਅਨੰਦ ॥",
      "transliteration": "jiu a(n)dhule pekhat hoi ana(n)d ||",
      "translation": "As the blind man is in ecstasy, when he can see again;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗੂੰਗਾ ਬਕਤ ਗਾਵੈ ਬਹੁ ਛੰਦ ॥",
      "transliteration": "goo(n)gaa bakat gaavai bahu chha(n)d ||",
      "translation": "and the mute, when he is able to speak and sing songs;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪਿੰਗੁਲ ਪਰਬਤ ਪਰਤੇ ਪਾਰਿ ॥",
      "transliteration": "pi(n)gul parabat parate paar ||",
      "translation": "and the cripple, being able to climb over the mountain",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਹਰਿ ਕੈ ਨਾਮਿ ਸਗਲ ਉਧਾਰਿ ॥੪॥",
      "transliteration": "har kai naam sagal udhaar ||4||",
      "translation": "- just so, the Name of the Lord saves all. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਿਉ ਪਾਵਕ ਸੰਗਿ ਸੀਤ ਕੋ ਨਾਸ ॥",
      "transliteration": "jiu paavak sa(n)g seet ko naas ||",
      "translation": "As cold is dispelled by fire,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਐਸੇ ਪ੍ਰਾਛਤ ਸੰਤਸੰਗਿ ਬਿਨਾਸ ॥",
      "transliteration": "aise praachhat sa(n)tasa(n)g binaas ||",
      "translation": "sins are driven out in the Society of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਿਉ ਸਾਬੁਨਿ ਕਾਪਰ ਊਜਲ ਹੋਤ ॥",
      "transliteration": "jiu saabun kaapar oojal hot ||",
      "translation": "As cloth is cleaned by soap,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਮ ਜਪਤ ਸਭੁ ਭ੍ਰਮੁ ਭਉ ਖੋਤ ॥੫॥",
      "transliteration": "naam japat sabh bhram bhau khot ||5||",
      "translation": "just so, by chanting the Naam, all doubts and fears are dispelled. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਿਉ ਚਕਵੀ ਸੂਰਜ ਕੀ ਆਸ ॥",
      "transliteration": "jiu chakavee sooraj kee aas ||",
      "translation": "As the chakvi bird longs for the sun,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਿਉ ਚਾਤ੍ਰਿਕ ਬੂੰਦ ਕੀ ਪਿਆਸ ॥",
      "transliteration": "jiu chaatrik boo(n)d kee piaas ||",
      "translation": "as the rainbird thirsts for the rain drop,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਜਿਉ ਕੁਰੰਕ ਨਾਦ ਕਰਨ ਸਮਾਨੇ ॥",
      "transliteration": "jiu kura(n)k naad karan samaane ||",
      "translation": "as the deer's ears are attuned to the sound of the bell,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0914_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਤਿਉ ਹਰਿ ਨਾਮ ਹਰਿ ਜਨ ਮਨਹਿ ਸੁਖਾਨੇ ॥੬॥",
      "transliteration": "tiu har naam har jan manahi sukhaane ||6||",
      "translation": "the Lord's Name is pleasing to the mind of the Lord's humble servant. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 914,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
