{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 931,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0931_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਓਹੁ ਬਿਧਾਤਾ ਮਨੁ ਤਨੁ ਦੇਇ ॥",
      "transliteration": "ohu bidhaataa man tan dei ||",
      "translation": "He is the Architect of Destiny; He blesses us with mind and body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਓਹੁ ਬਿਧਾਤਾ ਮਨਿ ਮੁਖਿ ਸੋਇ ॥",
      "transliteration": "ohu bidhaataa man mukh soi ||",
      "translation": "That Architect of Destiny is in my mind and mouth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਭੁ ਜਗਜੀਵਨੁ ਅਵਰੁ ਨ ਕੋਇ ॥",
      "transliteration": "prabh jagajeevan avar na koi ||",
      "translation": "God is the Life of the world; there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ ਪਤਿ ਹੋਇ ॥੯॥",
      "transliteration": "naanak naam rate pat hoi ||9||",
      "translation": "O Nanak, imbued with the Naam, the Name of the Lord, one is honored. ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰਾਜਨ ਰਾਮ ਰਵੈ ਹਿਤਕਾਰਿ ॥",
      "transliteration": "raajan raam ravai hitakaar ||",
      "translation": "One who lovingly chants the Name of the Sovereign Lord King,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਣ ਮਹਿ ਲੂਝੈ ਮਨੂਆ ਮਾਰਿ ॥",
      "transliteration": "ran mahi loojhai manooaa maar ||",
      "translation": "fights the battle and conquers his own mind;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਾਤਿ ਦਿਨੰਤਿ ਰਹੈ ਰੰਗਿ ਰਾਤਾ ॥",
      "transliteration": "raat dina(n)t rahai ra(n)g raataa ||",
      "translation": "day and night, he remains imbued with the Lord's Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੀਨਿ ਭਵਨ ਜੁਗ ਚਾਰੇ ਜਾਤਾ ॥",
      "transliteration": "teen bhavan jug chaare jaataa ||",
      "translation": "He is famous throughout the three worlds and the four ages.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਿਨਿ ਜਾਤਾ ਸੋ ਤਿਸ ਹੀ ਜੇਹਾ ॥",
      "transliteration": "jin jaataa so tis hee jehaa ||",
      "translation": "One who knows the Lord, becomes like Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਤਿ ਨਿਰਮਾਇਲੁ ਸੀਝਸਿ ਦੇਹਾ ॥",
      "transliteration": "at niramaail seejhas dehaa ||",
      "translation": "He becomes absolutely immaculate, and his body is sanctified.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਹਸੀ ਰਾਮੁ ਰਿਦੈ ਇਕ ਭਾਇ ॥",
      "transliteration": "rahasee raam ridai ik bhaai ||",
      "translation": "His heart is happy, in love with the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅੰਤਰਿ ਸਬਦੁ ਸਾਚਿ ਲਿਵ ਲਾਇ ॥੧੦॥",
      "transliteration": "a(n)tar sabad saach liv laai ||10||",
      "translation": "He lovingly centers his attention deep within upon the True Word of the Shabad. ||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਰੋਸੁ ਨ ਕੀਜੈ ਅੰਮ੍ਰਿਤੁ ਪੀਜੈ ਰਹਣੁ ਨਹੀ ਸੰਸਾਰੇ ॥",
      "transliteration": "ros na keejai a(n)mrit peejai rahan nahee sa(n)saare ||",
      "translation": "Don't be angry - drink in the Ambrosial Nectar; you shall not remain in this world forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਜੇ ਰਾਇ ਰੰਕ ਨਹੀ ਰਹਣਾ ਆਇ ਜਾਇ ਜੁਗ ਚਾਰੇ ॥",
      "transliteration": "raaje raai ra(n)k nahee rahanaa aai jaai jug chaare ||",
      "translation": "The ruling kings and the paupers shall not remain; they come and go, throughout the four ages.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਹਣ ਕਹਣ ਤੇ ਰਹੈ ਨ ਕੋਈ ਕਿਸੁ ਪਹਿ ਕਰਉ ਬਿਨੰਤੀ ॥",
      "transliteration": "rahan kahan te rahai na koee kis pahi karau bina(n)tee ||",
      "translation": "Everyone says that they will remain, but none of them remain; unto whom should I offer my prayer?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਏਕੁ ਸਬਦੁ ਰਾਮ ਨਾਮ ਨਿਰੋਧਰੁ ਗੁਰੁ ਦੇਵੈ ਪਤਿ ਮਤੀ ॥੧੧॥",
      "transliteration": "ek sabad raam naam nirodhar gur devai pat matee ||11||",
      "translation": "The One Shabad, the Name of the Lord, will never fail you; the Guru grants honor and understanding. ||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਲਾਜ ਮਰੰਤੀ ਮਰਿ ਗਈ ਘੂਘਟੁ ਖੋਲਿ ਚਲੀ ॥",
      "transliteration": "laaj mara(n)tee mar gaee ghooghat khol chalee ||",
      "translation": "My shyness and hesitation have died and gone, and I walk with my face unveiled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਾਸੁ ਦਿਵਾਨੀ ਬਾਵਰੀ ਸਿਰ ਤੇ ਸੰਕ ਟਲੀ ॥",
      "transliteration": "saas divaanee baavaree sir te sa(n)k talee ||",
      "translation": "The confusion and doubt from my crazy, insane mother-in-law has been removed from over my head.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪ੍ਰੇਮਿ ਬੁਲਾਈ ਰਲੀ ਸਿਉ ਮਨ ਮਹਿ ਸਬਦੁ ਅਨੰਦੁ ॥",
      "transliteration": "prem bulaaee ralee siu man mahi sabad ana(n)d ||",
      "translation": "My Beloved has summoned me with joyful caresses; my mind is filled with the bliss of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਲਾਲਿ ਰਤੀ ਲਾਲੀ ਭਈ ਗੁਰਮੁਖਿ ਭਈ ਨਿਚਿੰਦੁ ॥੧੨॥",
      "transliteration": "laal ratee laalee bhaee guramukh bhaee nichi(n)d ||12||",
      "translation": "Imbued with the Love of my Beloved, I have become Gurmukh, and carefree. ||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਲਾਹਾ ਨਾਮੁ ਰਤਨੁ ਜਪਿ ਸਾਰੁ ॥",
      "transliteration": "laahaa naam ratan jap saar ||",
      "translation": "Chant the jewel of the Naam, and earn the profit of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਲਬੁ ਲੋਭੁ ਬੁਰਾ ਅਹੰਕਾਰੁ ॥",
      "transliteration": "lab lobh buraa aha(n)kaar ||",
      "translation": "Greed, avarice, evil and egotism;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਲਾੜੀ ਚਾੜੀ ਲਾਇਤਬਾਰੁ ॥",
      "transliteration": "laaRee chaaRee laaitabaar ||",
      "translation": "slander, inuendo and gossip;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮਨਮੁਖੁ ਅੰਧਾ ਮੁਗਧੁ ਗਵਾਰੁ ॥",
      "transliteration": "manamukh a(n)dhaa mugadh gavaar ||",
      "translation": "the self-willed manmukh is blind, foolish and ignorant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਲਾਹੇ ਕਾਰਣਿ ਆਇਆ ਜਗਿ ॥",
      "transliteration": "laahe kaaran aaiaa jag ||",
      "translation": "For the sake of earning the profit of the Lord, the mortal comes into the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹੋਇ ਮਜੂਰੁ ਗਇਆ ਠਗਾਇ ਠਗਿ ॥",
      "transliteration": "hoi majoor gaiaa thagaai thag ||",
      "translation": "But he becomes a mere slave laborer, and is mugged by the mugger, Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਲਾਹਾ ਨਾਮੁ ਪੂੰਜੀ ਵੇਸਾਹੁ ॥",
      "transliteration": "laahaa naam poo(n)jee vesaahu ||",
      "translation": "One who earns the profit of the Naam, with the capital of faith,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਸਚੀ ਪਤਿ ਸਚਾ ਪਾਤਿਸਾਹੁ ॥੧੩॥",
      "transliteration": "naanak sachee pat sachaa paatisaahu ||13||",
      "translation": "O Nanak, is truly honored by the True Supreme King. ||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਇ ਵਿਗੂਤਾ ਜਗੁ ਜਮ ਪੰਥੁ ॥",
      "transliteration": "aai vigootaa jag jam pa(n)th ||",
      "translation": "The world is ruined on the path of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਈ ਨ ਮੇਟਣ ਕੋ ਸਮਰਥੁ ॥",
      "transliteration": "aaee na metan ko samarath ||",
      "translation": "No one has the power to erase Maya's influence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਥਿ ਸੈਲ ਨੀਚ ਘਰਿ ਹੋਇ ॥",
      "transliteration": "aath sail neech ghar hoi ||",
      "translation": "If wealth visits the home of the lowliest clown,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਆਥਿ ਦੇਖਿ ਨਿਵੈ ਜਿਸੁ ਦੋਇ ॥",
      "transliteration": "aath dekh nivai jis doi ||",
      "translation": "seeing that wealth, all pay their respects to him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਥਿ ਹੋਇ ਤਾ ਮੁਗਧੁ ਸਿਆਨਾ ॥",
      "transliteration": "aath hoi taa mugadh siaanaa ||",
      "translation": "Even an idiot is thought of as clever, if he is rich.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭਗਤਿ ਬਿਹੂਨਾ ਜਗੁ ਬਉਰਾਨਾ ॥",
      "transliteration": "bhagat bihoonaa jag bauraanaa ||",
      "translation": "Without devotional worship, the world is insane.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਭ ਮਹਿ ਵਰਤੈ ਏਕੋ ਸੋਇ ॥",
      "transliteration": "sabh mahi varatai eko soi ||",
      "translation": "The One Lord is contained among all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਸ ਨੋ ਕਿਰਪਾ ਕਰੇ ਤਿਸੁ ਪਰਗਟੁ ਹੋਇ ॥੧੪॥",
      "transliteration": "jis no kirapaa kare tis paragat hoi ||14||",
      "translation": "He reveals Himself, unto those whom He blesses with His Grace. ||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੁਗਿ ਜੁਗਿ ਥਾਪਿ ਸਦਾ ਨਿਰਵੈਰੁ ॥",
      "transliteration": "jug jug thaap sadaa niravair ||",
      "translation": "Throughout the ages, the Lord is eternally established; He has no vengeance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਨਮਿ ਮਰਣਿ ਨਹੀ ਧੰਧਾ ਧੈਰੁ ॥",
      "transliteration": "janam maran nahee dha(n)dhaa dhair ||",
      "translation": "He is not subject to birth and death; He is not entangled in worldly affairs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੋ ਦੀਸੈ ਸੋ ਆਪੇ ਆਪਿ ॥",
      "transliteration": "jo deesai so aape aap ||",
      "translation": "Whatever is seen, is the Lord Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਪਿ ਉਪਾਇ ਆਪੇ ਘਟ ਥਾਪਿ ॥",
      "transliteration": "aap upaai aape ghat thaap ||",
      "translation": "Creating Himself, He establishes Himself in the heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਪਿ ਅਗੋਚਰੁ ਧੰਧੈ ਲੋਈ ॥",
      "transliteration": "aap agochar dha(n)dhai loee ||",
      "translation": "He Himself is unfathomable; He links people to their affairs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੋਗ ਜੁਗਤਿ ਜਗਜੀਵਨੁ ਸੋਈ ॥",
      "transliteration": "jog jugat jagajeevan soee ||",
      "translation": "He is the Way of Yoga, the Life of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਰਿ ਆਚਾਰੁ ਸਚੁ ਸੁਖੁ ਹੋਈ ॥",
      "transliteration": "kar aachaar sach sukh hoee ||",
      "translation": "Living a righteous lifestyle, true peace is found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਮ ਵਿਹੂਣਾ ਮੁਕਤਿ ਕਿਵ ਹੋਈ ॥੧੫॥",
      "transliteration": "naam vihoonaa mukat kiv hoee ||15||",
      "translation": "Without the Naam, the Name of the Lord, how can anyone find liberation? ||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਵਿਣੁ ਨਾਵੈ ਵੇਰੋਧੁ ਸਰੀਰ ॥",
      "transliteration": "vin naavai verodh sareer ||",
      "translation": "Without the Name, even one's own body is an enemy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਿਉ ਨ ਮਿਲਹਿ ਕਾਟਹਿ ਮਨ ਪੀਰ ॥",
      "transliteration": "kiu na milahi kaatahi man peer ||",
      "translation": "Why not meet the Lord, and take away the pain of your mind?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਵਾਟ ਵਟਾਊ ਆਵੈ ਜਾਇ ॥",
      "transliteration": "vaat vataaoo aavai jaai ||",
      "translation": "The traveller comes and goes along the highway.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿਆ ਲੇ ਆਇਆ ਕਿਆ ਪਲੈ ਪਾਇ ॥",
      "transliteration": "kiaa le aaiaa kiaa palai paai ||",
      "translation": "What did he bring when he came, and what will he take away when he goes?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਵਿਣੁ ਨਾਵੈ ਤੋਟਾ ਸਭ ਥਾਇ ॥",
      "transliteration": "vin naavai totaa sabh thaai ||",
      "translation": "Without the Name, one loses everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਲਾਹਾ ਮਿਲੈ ਜਾ ਦੇਇ ਬੁਝਾਇ ॥",
      "transliteration": "laahaa milai jaa dei bujhaai ||",
      "translation": "The profit is earned, when the Lord grants understanding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਵਣਜੁ ਵਾਪਾਰੁ ਵਣਜੈ ਵਾਪਾਰੀ ॥",
      "transliteration": "vanaj vaapaar vanajai vaapaaree ||",
      "translation": "In merchandise and trade, the merchant is trading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਵਿਣੁ ਨਾਵੈ ਕੈਸੀ ਪਤਿ ਸਾਰੀ ॥੧੬॥",
      "transliteration": "vin naavai kaisee pat saaree ||16||",
      "translation": "Without the Name, how can one find honor and nobility? ||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਣ ਵੀਚਾਰੇ ਗਿਆਨੀ ਸੋਇ ॥",
      "transliteration": "gun veechaare giaanee soi ||",
      "translation": "One who contemplates the Lord's Virtues is spiritually wise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗੁਣ ਮਹਿ ਗਿਆਨੁ ਪਰਾਪਤਿ ਹੋਇ ॥",
      "transliteration": "gun mahi giaan paraapat hoi ||",
      "translation": "Through His Virtues, one receives spiritual wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਗੁਣਦਾਤਾ ਵਿਰਲਾ ਸੰਸਾਰਿ ॥",
      "transliteration": "gunadaataa viralaa sa(n)saar ||",
      "translation": "How rare in this world, is the Giver of virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਾਚੀ ਕਰਣੀ ਗੁਰ ਵੀਚਾਰਿ ॥",
      "transliteration": "saachee karanee gur veechaar ||",
      "translation": "The True way of life comes through contemplation of the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0931_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਅਗਮ ਅਗੋਚਰੁ ਕੀਮਤਿ ਨਹੀ ਪਾਇ ॥",
      "transliteration": "agam agochar keemat nahee paai ||",
      "translation": "The Lord is inaccessible and unfathomable. His worth cannot be estimated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 931,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
