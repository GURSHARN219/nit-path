{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 932,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0932_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਾ ਮਿਲੀਐ ਜਾ ਲਏ ਮਿਲਾਇ ॥",
      "transliteration": "taa mileeai jaa lae milaai ||",
      "translation": "They alone meet Him, whom the Lord causes to meet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਣਵੰਤੀ ਗੁਣ ਸਾਰੇ ਨੀਤ ॥",
      "transliteration": "gunava(n)tee gun saare neet ||",
      "translation": "The virtuous soul bride continually contemplates His Virtues.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮਤਿ ਮਿਲੀਐ ਮੀਤ ॥੧੭॥",
      "transliteration": "naanak guramat mileeai meet ||17||",
      "translation": "O Nanak, following the Guru's Teachings, one meets the Lord, the true friend. ||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਕਾਇਆ ਕਉ ਗਾਲੈ ॥",
      "transliteration": "kaam krodh kaaiaa kau gaalai ||",
      "translation": "Unfulfilled sexual desire and unresolved anger waste the body away,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਉ ਕੰਚਨ ਸੋਹਾਗਾ ਢਾਲੈ ॥",
      "transliteration": "jiu ka(n)chan sohaagaa dhaalai ||",
      "translation": "as gold is dissolved by borax.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਸਿ ਕਸਵਟੀ ਸਹੈ ਸੁ ਤਾਉ ॥",
      "transliteration": "kas kasavatee sahai s taau ||",
      "translation": "The gold is touched to the touchstone, and tested by fire;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਦਰਿ ਸਰਾਫ ਵੰਨੀ ਸਚੜਾਉ ॥",
      "transliteration": "nadar saraaph va(n)nee sachaRaau ||",
      "translation": "when its pure color shows through, it is pleasing to the eye of the assayer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਗਤੁ ਪਸੂ ਅਹੰ ਕਾਲੁ ਕਸਾਈ ॥",
      "transliteration": "jagat pasoo aha(n) kaal kasaaee ||",
      "translation": "The world is a beast, and arrogent Death is the butcher.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਰਿ ਕਰਤੈ ਕਰਣੀ ਕਰਿ ਪਾਈ ॥",
      "transliteration": "kar karatai karanee kar paaee ||",
      "translation": "The created beings of the Creator receive the karma of their actions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਨਿ ਕੀਤੀ ਤਿਨਿ ਕੀਮਤਿ ਪਾਈ ॥",
      "transliteration": "jin keetee tin keemat paaee ||",
      "translation": "He who created the world, knows its worth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹੋਰ ਕਿਆ ਕਹੀਐ ਕਿਛੁ ਕਹਣੁ ਨ ਜਾਈ ॥੧੮॥",
      "transliteration": "hor kiaa kaheeai kichh kahan na jaaee ||18||",
      "translation": "What else can be said? There is nothing at all to say. ||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਖੋਜਤ ਖੋਜਤ ਅੰਮ੍ਰਿਤੁ ਪੀਆ ॥",
      "transliteration": "khojat khojat a(n)mrit peeaa ||",
      "translation": "Searching, searching, I drink in the Ambrosial Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਖਿਮਾ ਗਹੀ ਮਨੁ ਸਤਗੁਰਿ ਦੀਆ ॥",
      "transliteration": "khimaa gahee man satagur deeaa ||",
      "translation": "I have adopted the way of tolerance, and given my mind to the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਖਰਾ ਖਰਾ ਆਖੈ ਸਭੁ ਕੋਇ ॥",
      "transliteration": "kharaa kharaa aakhai sabh koi ||",
      "translation": "Everyone calls himself true and genuine.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਖਰਾ ਰਤਨੁ ਜੁਗ ਚਾਰੇ ਹੋਇ ॥",
      "transliteration": "kharaa ratan jug chaare hoi ||",
      "translation": "He alone is true, who obtains the jewel throughout the four ages.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਖਾਤ ਪੀਅੰਤ ਮੂਏ ਨਹੀ ਜਾਨਿਆ ॥",
      "transliteration": "khaat peea(n)t mooe nahee jaaniaa ||",
      "translation": "Eating and drinking, one dies, but still does not know.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਮੂਏ ਜਾ ਸਬਦੁ ਪਛਾਨਿਆ ॥",
      "transliteration": "khin mahi mooe jaa sabad pachhaaniaa ||",
      "translation": "He dies in an instant, when he realizes the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਸਥਿਰੁ ਚੀਤੁ ਮਰਨਿ ਮਨੁ ਮਾਨਿਆ ॥",
      "transliteration": "asathir cheet maran man maaniaa ||",
      "translation": "His consciousness becomes permanently stable, and his mind accepts death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਨਾਮੁ ਪਛਾਨਿਆ ॥੧੯॥",
      "transliteration": "gur kirapaa te naam pachhaaniaa ||19||",
      "translation": "By Guru's Grace, he realizes the Naam, the Name of the Lord. ||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗਗਨ ਗੰਭੀਰੁ ਗਗਨੰਤਰਿ ਵਾਸੁ ॥",
      "transliteration": "gagan ga(n)bheer gagana(n)tar vaas ||",
      "translation": "The Profound Lord dwells in the sky of the mind, the Tenth Gate;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਣ ਗਾਵੈ ਸੁਖ ਸਹਜਿ ਨਿਵਾਸੁ ॥",
      "transliteration": "gun gaavai sukh sahaj nivaas ||",
      "translation": "singing His Glorious Praises, one dwells in intuitive poise and peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗਇਆ ਨ ਆਵੈ ਆਇ ਨ ਜਾਇ ॥",
      "transliteration": "gaiaa na aavai aai na jaai ||",
      "translation": "He does not go to come, or come to go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਰਹੈ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "gur parasaad rahai liv laai ||",
      "translation": "By Guru's Grace, he remains lovingly focused on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗਗਨੁ ਅਗੰਮੁ ਅਨਾਥੁ ਅਜੋਨੀ ॥",
      "transliteration": "gagan aga(n)m anaath ajonee ||",
      "translation": "The Lord of the mind-sky is inaccessible, independent and beyond birth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਸਥਿਰੁ ਚੀਤੁ ਸਮਾਧਿ ਸਗੋਨੀ ॥",
      "transliteration": "asathir cheet samaadh sagonee ||",
      "translation": "The most worthy Samaadhi is to keep the consciousness stable, focused on Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰਿ ਨਾਮੁ ਚੇਤਿ ਫਿਰਿ ਪਵਹਿ ਨ ਜੂਨੀ ॥",
      "transliteration": "har naam chet phir pavahi na joonee ||",
      "translation": "Remembering the Lord's Name, one is not subject to reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗੁਰਮਤਿ ਸਾਰੁ ਹੋਰ ਨਾਮ ਬਿਹੂਨੀ ॥੨੦॥",
      "transliteration": "guramat saar hor naam bihoonee ||20||",
      "translation": "The Guru's Teachings are the most Excellent; all other ways lack the Naam, the Name of the Lord. ||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਘਰ ਦਰ ਫਿਰਿ ਥਾਕੀ ਬਹੁਤੇਰੇ ॥",
      "transliteration": "ghar dar phir thaakee bahutere ||",
      "translation": "Wandering to countless doorsteps and homes, I have grown weary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾਤਿ ਅਸੰਖ ਅੰਤ ਨਹੀ ਮੇਰੇ ॥",
      "transliteration": "jaat asa(n)kh a(n)t nahee mere ||",
      "translation": "My incarnations are countless, without limit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕੇਤੇ ਮਾਤ ਪਿਤਾ ਸੁਤ ਧੀਆ ॥",
      "transliteration": "kete maat pitaa sut dheeaa ||",
      "translation": "I have had so many mothers and fathers, sons and daughters.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕੇਤੇ ਗੁਰ ਚੇਲੇ ਫੁਨਿ ਹੂਆ ॥",
      "transliteration": "kete gur chele phun hooaa ||",
      "translation": "I have had so many gurus and disciples.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਾਚੇ ਗੁਰ ਤੇ ਮੁਕਤਿ ਨ ਹੂਆ ॥",
      "transliteration": "kaache gur te mukat na hooaa ||",
      "translation": "Through a false guru, liberation is not found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੇਤੀ ਨਾਰਿ ਵਰੁ ਏਕੁ ਸਮਾਲਿ ॥",
      "transliteration": "ketee naar var ek samaal ||",
      "translation": "There are so many brides of the One Husband Lord - consider this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਮਰਣੁ ਜੀਵਣੁ ਪ੍ਰਭ ਨਾਲਿ ॥",
      "transliteration": "guramukh maran jeevan prabh naal ||",
      "translation": "The Gurmukh dies, and lives with God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦਹ ਦਿਸ ਢੂਢਿ ਘਰੈ ਮਹਿ ਪਾਇਆ ॥",
      "transliteration": "dah dis dhoodh gharai mahi paaiaa ||",
      "translation": "Searching in the ten directions, I found Him within my own home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੇਲੁ ਭਇਆ ਸਤਿਗੁਰੂ ਮਿਲਾਇਆ ॥੨੧॥",
      "transliteration": "mel bhaiaa satiguroo milaaiaa ||21||",
      "translation": "I have met Him; the True Guru has led me to meet Him. ||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਗਾਵੈ ਗੁਰਮੁਖਿ ਬੋਲੈ ॥",
      "transliteration": "guramukh gaavai guramukh bolai ||",
      "translation": "The Gurmukh sings, and the Gurmukh speaks.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਤੋਲਿ ਤੋੁਲਾਵੈ ਤੋਲੈ ॥",
      "transliteration": "guramukh tol toulaavai tolai ||",
      "translation": "The Gurmukh evaluates the value of the Lord, and inspires others to evaluate Him as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਆਵੈ ਜਾਇ ਨਿਸੰਗੁ ॥",
      "transliteration": "guramukh aavai jaai nisa(n)g ||",
      "translation": "The Gurmukh comes and goes without fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਰਹਰਿ ਮੈਲੁ ਜਲਾਇ ਕਲੰਕੁ ॥",
      "transliteration": "parahar mail jalaai kala(n)k ||",
      "translation": "His filth is taken away, and his stains are burnt off.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਦ ਬੇਦ ਬੀਚਾਰੁ ॥",
      "transliteration": "guramukh naad bed beechaar ||",
      "translation": "The Gurmukh contemplates the sound current of the Naad for his Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਮਜਨੁ ਚਜੁ ਅਚਾਰੁ ॥",
      "transliteration": "guramukh majan chaj achaar ||",
      "translation": "The Gurmukh's cleansing bath is the performance of good deeds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਬਦੁ ਅੰਮ੍ਰਿਤੁ ਹੈ ਸਾਰੁ ॥",
      "transliteration": "guramukh sabad a(n)mrit hai saar ||",
      "translation": "For the Gurmukh, the Shabad is the most excellent Ambrosial Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਪਾਵੈ ਪਾਰੁ ॥੨੨॥",
      "transliteration": "naanak guramukh paavai paar ||22||",
      "translation": "O Nanak, the Gurmukh crosses over. ||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਚੰਚਲੁ ਚੀਤੁ ਨ ਰਹਈ ਠਾਇ ॥",
      "transliteration": "cha(n)chal cheet na rahaee thaai ||",
      "translation": "The fickle consciousness does not remain stable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਚੋਰੀ ਮਿਰਗੁ ਅੰਗੂਰੀ ਖਾਇ ॥",
      "transliteration": "choree mirag a(n)gooree khaai ||",
      "translation": "The deer secretly nibbles at the green sprouts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਉਰ ਧਾਰੇ ਚੀਤ ॥",
      "transliteration": "charan kamal ur dhaare cheet ||",
      "translation": "One who enshrines the Lord's lotus feet in his heart and consciousness",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚਿਰੁ ਜੀਵਨੁ ਚੇਤਨੁ ਨਿਤ ਨੀਤ ॥",
      "transliteration": "chir jeevan chetan nit neet ||",
      "translation": "lives long, always remembering the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਚਿੰਤਤ ਹੀ ਦੀਸੈ ਸਭੁ ਕੋਇ ॥",
      "transliteration": "chi(n)tat hee deesai sabh koi ||",
      "translation": "Everyone has worries and cares.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਚੇਤਹਿ ਏਕੁ ਤਹੀ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "chetahi ek tahee sukh hoi ||",
      "translation": "He alone finds peace, who thinks of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਚਿਤਿ ਵਸੈ ਰਾਚੈ ਹਰਿ ਨਾਇ ॥",
      "transliteration": "chit vasai raachai har naai ||",
      "translation": "When the Lord dwells in the consciousness, and one is absorbed in the Lord's Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮੁਕਤਿ ਭਇਆ ਪਤਿ ਸਿਉ ਘਰਿ ਜਾਇ ॥੨੩॥",
      "transliteration": "mukat bhaiaa pat siu ghar jaai ||23||",
      "translation": "one is liberated, and returns home with honor. ||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਛੀਜੈ ਦੇਹ ਖੁਲੈ ਇਕ ਗੰਢਿ ॥",
      "transliteration": "chheejai deh khulai ik ga(n)dh ||",
      "translation": "The body falls apart, when one knot is untied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਛੇਆ ਨਿਤ ਦੇਖਹੁ ਜਗਿ ਹੰਢਿ ॥",
      "transliteration": "chheaa nit dekhahu jag ha(n)dh ||",
      "translation": "Behold, the world is on the decline; it will be totally destroyed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਧੂਪ ਛਾਵ ਜੇ ਸਮ ਕਰਿ ਜਾਣੈ ॥",
      "transliteration": "dhoop chhaav je sam kar jaanai ||",
      "translation": "Only one who looks alike upon sunshine and shade",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਬੰਧਨ ਕਾਟਿ ਮੁਕਤਿ ਘਰਿ ਆਣੈ ॥",
      "transliteration": "ba(n)dhan kaat mukat ghar aanai ||",
      "translation": "has his bonds shattered; he is liberated and returns home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਛਾਇਆ ਛੂਛੀ ਜਗਤੁ ਭੁਲਾਨਾ ॥",
      "transliteration": "chhaaiaa chhoochhee jagat bhulaanaa ||",
      "translation": "Maya is empty and petty; she has defrauded the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਲਿਖਿਆ ਕਿਰਤੁ ਧੁਰੇ ਪਰਵਾਨਾ ॥",
      "transliteration": "likhiaa kirat dhure paravaanaa ||",
      "translation": "Such destiny is pre-ordained by past actions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0932_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਛੀਜੈ ਜੋਬਨੁ ਜਰੂਆ ਸਿਰਿ ਕਾਲੁ ॥",
      "transliteration": "chheejai joban jarooaa sir kaal ||",
      "translation": "Youth is wasting away; old age and death hover above the head.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 932,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
