{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 933,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0933_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਾਇਆ ਛੀਜੈ ਭਈ ਸਿਬਾਲੁ ॥੨੪॥",
      "transliteration": "kaaiaa chheejai bhaee sibaal ||24||",
      "translation": "The body falls apart, like algae upon the water. ||24||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾਪੈ ਆਪਿ ਪ੍ਰਭੂ ਤਿਹੁ ਲੋਇ ॥",
      "transliteration": "jaapai aap prabhoo tihu loi ||",
      "translation": "God Himself appears throughout the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੁਗਿ ਜੁਗਿ ਦਾਤਾ ਅਵਰੁ ਨ ਕੋਇ ॥",
      "transliteration": "jug jug daataa avar na koi ||",
      "translation": "Throughout the ages, He is the Great Giver; there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਿਉ ਭਾਵੈ ਤਿਉ ਰਾਖਹਿ ਰਾਖੁ ॥",
      "transliteration": "jiu bhaavai tiu raakhahi raakh ||",
      "translation": "As it pleases You, You protect and preserve us.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਸੁ ਜਾਚਉ ਦੇਵੈ ਪਤਿ ਸਾਖੁ ॥",
      "transliteration": "jas jaachau devai pat saakh ||",
      "translation": "I ask for the Lord's Praises, which bless me with honor and credit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਾਗਤੁ ਜਾਗਿ ਰਹਾ ਤੁਧੁ ਭਾਵਾ ॥",
      "transliteration": "jaagat jaag rahaa tudh bhaavaa ||",
      "translation": "Remaining awake and aware, I am pleasing to You, O Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਾ ਤੂ ਮੇਲਹਿ ਤਾ ਤੁਝੈ ਸਮਾਵਾ ॥",
      "transliteration": "jaa too melahi taa tujhai samaavaa ||",
      "translation": "When You unite me with Yourself, then I am merged in You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੈ ਜੈ ਕਾਰੁ ਜਪਉ ਜਗਦੀਸ ॥",
      "transliteration": "jai jai kaar japau jagadees ||",
      "translation": "I chant Your Victorious Praises, O Life of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰਮਤਿ ਮਿਲੀਐ ਬੀਸ ਇਕੀਸ ॥੨੫॥",
      "transliteration": "guramat mileeai bees ikees ||25||",
      "translation": "Accepting the Guru's Teachings, one is sure to merge in the One Lord. ||25||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਝਖਿ ਬੋਲਣੁ ਕਿਆ ਜਗ ਸਿਉ ਵਾਦੁ ॥",
      "transliteration": "jhakh bolan kiaa jag siu vaad ||",
      "translation": "Why do you speak such nonsense, and argue with the world?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਝੂਰਿ ਮਰੈ ਦੇਖੈ ਪਰਮਾਦੁ ॥",
      "transliteration": "jhoor marai dekhai paramaad ||",
      "translation": "You shall die repenting, when you see your own insanity.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਨਮਿ ਮੂਏ ਨਹੀ ਜੀਵਣ ਆਸਾ ॥",
      "transliteration": "janam mooe nahee jeevan aasaa ||",
      "translation": "He is born, only to die, but he does not wish to live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਇ ਚਲੇ ਭਏ ਆਸ ਨਿਰਾਸਾ ॥",
      "transliteration": "aai chale bhae aas niraasaa ||",
      "translation": "He comes hopeful, and then goes, without hope.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਝੁਰਿ ਝੁਰਿ ਝਖਿ ਮਾਟੀ ਰਲਿ ਜਾਇ ॥",
      "transliteration": "jhur jhur jhakh maatee ral jaai ||",
      "translation": "Regretting, repenting and grieving, he is dust mixing with dust.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਾਲੁ ਨ ਚਾਂਪੈ ਹਰਿ ਗੁਣ ਗਾਇ ॥",
      "transliteration": "kaal na chaa(n)pai har gun gaai ||",
      "translation": "Death does not chew up one who sings the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਾਈ ਨਵ ਨਿਧਿ ਹਰਿ ਕੈ ਨਾਇ ॥",
      "transliteration": "paaee nav nidh har kai naai ||",
      "translation": "The nine treasures are obtained through the Name of the Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਪੇ ਦੇਵੈ ਸਹਜਿ ਸੁਭਾਇ ॥੨੬॥",
      "transliteration": "aape devai sahaj subhaai ||26||",
      "translation": "the Lord bestows intuitive peace and poise. ||26||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਞਿਆਨੋ ਬੋਲੈ ਆਪੇ ਬੂਝੈ ॥",
      "transliteration": "njiaano bolai aape boojhai ||",
      "translation": "He speaks spiritual wisdom, and He Himself understands it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਪੇ ਸਮਝੈ ਆਪੇ ਸੂਝੈ ॥",
      "transliteration": "aape samajhai aape soojhai ||",
      "translation": "He Himself knows it, and He Himself comprehends it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗੁਰ ਕਾ ਕਹਿਆ ਅੰਕਿ ਸਮਾਵੈ ॥",
      "transliteration": "gur kaa kahiaa a(n)k samaavai ||",
      "translation": "One who takes the Words of the Guru into his very fiber,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਿਰਮਲ ਸੂਚੇ ਸਾਚੋ ਭਾਵੈ ॥",
      "transliteration": "niramal sooche saacho bhaavai ||",
      "translation": "is immaculate and holy, and is pleasing to the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰੁ ਸਾਗਰੁ ਰਤਨੀ ਨਹੀ ਤੋਟ ॥",
      "transliteration": "gur saagar ratanee nahee tot ||",
      "translation": "In the ocean of the Guru, there is no shortage of pearls.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਲਾਲ ਪਦਾਰਥ ਸਾਚੁ ਅਖੋਟ ॥",
      "transliteration": "laal padaarath saach akhot ||",
      "translation": "The treasure of jewels is truly inexhaustible.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਰਿ ਕਹਿਆ ਸਾ ਕਾਰ ਕਮਾਵਹੁ ॥",
      "transliteration": "gur kahiaa saa kaar kamaavahu ||",
      "translation": "Do those deeds which the Guru has ordained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰ ਕੀ ਕਰਣੀ ਕਾਹੇ ਧਾਵਹੁ ॥",
      "transliteration": "gur kee karanee kaahe dhaavahu ||",
      "translation": "Why are you chasing after the Guru's actions?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮਤਿ ਸਾਚਿ ਸਮਾਵਹੁ ॥੨੭॥",
      "transliteration": "naanak guramat saach samaavahu ||27||",
      "translation": "O Nanak, through the Guru's Teachings, merge in the True Lord. ||27||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਟੂਟੈ ਨੇਹੁ ਕਿ ਬੋਲਹਿ ਸਹੀ ॥",
      "transliteration": "tootai nehu k bolahi sahee ||",
      "translation": "Love is broken, when one speaks in defiance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਟੂਟੈ ਬਾਹ ਦੁਹੂ ਦਿਸ ਗਹੀ ॥",
      "transliteration": "tootai baah duhoo dis gahee ||",
      "translation": "The arm is broken, when it is pulled from both sides.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਟੂਟਿ ਪਰੀਤਿ ਗਈ ਬੁਰ ਬੋਲਿ ॥",
      "transliteration": "toot pareet gaee bur bol ||",
      "translation": "Love breaks, when the speech goes sour.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦੁਰਮਤਿ ਪਰਹਰਿ ਛਾਡੀ ਢੋਲਿ ॥",
      "transliteration": "duramat parahar chhaadee dhol ||",
      "translation": "The Husband Lord abandons and leaves behind the evil-minded bride.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਟੂਟੈ ਗੰਠਿ ਪੜੈ ਵੀਚਾਰਿ ॥",
      "transliteration": "tootai ga(n)th paRai veechaar ||",
      "translation": "The broken knot is tied again, through contemplation and meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰਸਬਦੀ ਘਰਿ ਕਾਰਜੁ ਸਾਰਿ ॥",
      "transliteration": "gurasabadee ghar kaaraj saar ||",
      "translation": "Through the Word of the Guru's Shabad, one's affairs are resolved in one's own home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਲਾਹਾ ਸਾਚੁ ਨ ਆਵੈ ਤੋਟਾ ॥",
      "transliteration": "laahaa saach na aavai totaa ||",
      "translation": "One who earns the profit of the True Name, will not lose it again;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤ੍ਰਿਭਵਣ ਠਾਕੁਰੁ ਪ੍ਰੀਤਮੁ ਮੋਟਾ ॥੨੮॥",
      "transliteration": "tribhavan thaakur preetam motaa ||28||",
      "translation": "the Lord and Master of the three worlds is your best friend. ||28||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਠਾਕਹੁ ਮਨੂਆ ਰਾਖਹੁ ਠਾਇ ॥",
      "transliteration": "thaakahu manooaa raakhahu thaai ||",
      "translation": "Control your mind, and keep it in its place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਠਹਕਿ ਮੁਈ ਅਵਗੁਣਿ ਪਛੁਤਾਇ ॥",
      "transliteration": "thahak muee avagun pachhutaai ||",
      "translation": "The world is destroyed by conflict, regretting its sinful mistakes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਠਾਕੁਰੁ ਏਕੁ ਸਬਾਈ ਨਾਰਿ ॥",
      "transliteration": "thaakur ek sabaaee naar ||",
      "translation": "There is one Husband Lord, and all are His brides.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਹੁਤੇ ਵੇਸ ਕਰੇ ਕੂੜਿਆਰਿ ॥",
      "transliteration": "bahute ves kare kooRiaar ||",
      "translation": "The false bride wears many costumes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਰ ਘਰਿ ਜਾਤੀ ਠਾਕਿ ਰਹਾਈ ॥",
      "transliteration": "par ghar jaatee thaak rahaaee ||",
      "translation": "He stops her from going into the homes of others;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਹਲਿ ਬੁਲਾਈ ਠਾਕ ਨ ਪਾਈ ॥",
      "transliteration": "mahal bulaaee thaak na paaee ||",
      "translation": "He summons her to the Mansion of His Presence, and no obstacles block her path.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਬਦਿ ਸਵਾਰੀ ਸਾਚਿ ਪਿਆਰੀ ॥",
      "transliteration": "sabad savaaree saach piaaree ||",
      "translation": "She is embellished with the Word of the Shabad, and is loved by the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਾਈ ਸੋੁਹਾਗਣਿ ਠਾਕੁਰਿ ਧਾਰੀ ॥੨੯॥",
      "transliteration": "saaee souhaagan thaakur dhaaree ||29||",
      "translation": "She is the happy soul bride, who takes the Support of her Lord and Master. ||29||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਡੋਲਤ ਡੋਲਤ ਹੇ ਸਖੀ ਫਾਟੇ ਚੀਰ ਸੀਗਾਰ ॥",
      "transliteration": "dolat dolat he sakhee phaate cheer seegaar ||",
      "translation": "Wandering and roaming around, O my companion, your beautiful robes are torn.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਡਾਹਪਣਿ ਤਨਿ ਸੁਖੁ ਨਹੀ ਬਿਨੁ ਡਰ ਬਿਣਠੀ ਡਾਰ ॥",
      "transliteration": "daahapan tan sukh nahee bin dar binathee daar ||",
      "translation": "In jealousy, the body is not at peace; without the Fear of God, multitudes are ruined.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਡਰਪਿ ਮੁਈ ਘਰਿ ਆਪਣੈ ਡੀਠੀ ਕੰਤਿ ਸੁਜਾਣਿ ॥",
      "transliteration": "darap muee ghar aapanai deethee ka(n)t sujaan ||",
      "translation": "One who remains dead within her own home, through the Fear of God, is looked upon with favor by her all-knowing Husband Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਡਰੁ ਰਾਖਿਆ ਗੁਰਿ ਆਪਣੈ ਨਿਰਭਉ ਨਾਮੁ ਵਖਾਣਿ ॥",
      "transliteration": "dar raakhiaa gur aapanai nirabhau naam vakhaan ||",
      "translation": "She maintains fear of her Guru, and chants the Name of the Fearless Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਡੂਗਰਿ ਵਾਸੁ ਤਿਖਾ ਘਣੀ ਜਬ ਦੇਖਾ ਨਹੀ ਦੂਰਿ ॥",
      "transliteration": "doogar vaas tikhaa ghanee jab dekhaa nahee door ||",
      "translation": "Living on the mountain, I suffer such great thirst; when I see Him, I know that He is not far away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਖਾ ਨਿਵਾਰੀ ਸਬਦੁ ਮੰਨਿ ਅੰਮ੍ਰਿਤੁ ਪੀਆ ਭਰਪੂਰਿ ॥",
      "transliteration": "tikhaa nivaaree sabad ma(n)n a(n)mrit peeaa bharapoor ||",
      "translation": "My thirst is quenched, and I have accepted the Word of the Shabad. I drink my fill of the Ambrosial Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਦੇਹਿ ਦੇਹਿ ਆਖੈ ਸਭੁ ਕੋਈ ਜੈ ਭਾਵੈ ਤੈ ਦੇਇ ॥",
      "transliteration": "dehi dehi aakhai sabh koee jai bhaavai tai dei ||",
      "translation": "Everyone says, \"Give! Give!\" As He pleases, He gives.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗੁਰੂ ਦੁਆਰੈ ਦੇਵਸੀ ਤਿਖਾ ਨਿਵਾਰੈ ਸੋਇ ॥੩੦॥",
      "transliteration": "guroo duaarai devasee tikhaa nivaarai soi ||30||",
      "translation": "Through the Gurdwara, the Guru's Door, He gives, and quenches the thirst. ||30||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਢੰਢੋਲਤ ਢੂਢਤ ਹਉ ਫਿਰੀ ਢਹਿ ਢਹਿ ਪਵਨਿ ਕਰਾਰਿ ॥",
      "transliteration": "dha(n)dholat dhoodhat hau phiree dhahi dhahi pavan karaar ||",
      "translation": "Searching and seeking, I fell down and collapsed upon the bank of the river of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਭਾਰੇ ਢਹਤੇ ਢਹਿ ਪਏ ਹਉਲੇ ਨਿਕਸੇ ਪਾਰਿ ॥",
      "transliteration": "bhaare dhahate dhahi pae haule nikase paar ||",
      "translation": "Those who are heavy with sin sink down, but those who are light swim across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅਮਰ ਅਜਾਚੀ ਹਰਿ ਮਿਲੇ ਤਿਨ ਕੈ ਹਉ ਬਲਿ ਜਾਉ ॥",
      "transliteration": "amar ajaachee har mile tin kai hau bal jaau ||",
      "translation": "I am a sacrifice to those who meet the immortal and immeasurable Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤਿਨ ਕੀ ਧੂੜਿ ਅਘੁਲੀਐ ਸੰਗਤਿ ਮੇਲਿ ਮਿਲਾਉ ॥",
      "transliteration": "tin kee dhooR aghuleeai sa(n)gat mel milaau ||",
      "translation": "The dust of their feet brings emancipation; in their company, we are united in the Lord's Union.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0933_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮਨੁ ਦੀਆ ਗੁਰਿ ਆਪਣੈ ਪਾਇਆ ਨਿਰਮਲ ਨਾਉ ॥",
      "transliteration": "man deeaa gur aapanai paaiaa niramal naau ||",
      "translation": "I gave my mind to my Guru, and received the Immaculate Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 933,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
