{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 941,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0941_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੋ ਬੂਝੈ ਜਿਸੁ ਆਪਿ ਬੁਝਾਏ ਗੁਰ ਕੈ ਸਬਦਿ ਸੁ ਮੁਕਤੁ ਭਇਆ ॥",
      "transliteration": "so boojhai jis aap bujhaae gur kai sabad s mukat bhaiaa ||",
      "translation": "He alone understands, whom the Lord inspires to understand. Through the Word of the Guru's Shabad, one is liberated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਨਕ ਤਾਰੇ ਤਾਰਣਹਾਰਾ ਹਉਮੈ ਦੂਜਾ ਪਰਹਰਿਆ ॥੨੫॥",
      "transliteration": "naanak taare taaranahaaraa haumai doojaa parahariaa ||25||",
      "translation": "O Nanak, the Emancipator emancipates one who drives out egotism and duality. ||25||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਨਮੁਖਿ ਭੂਲੈ ਜਮ ਕੀ ਕਾਣਿ ॥",
      "transliteration": "manamukh bhoolai jam kee kaan ||",
      "translation": "The self-willed manmukhs are deluded, under the shadow of death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਰ ਘਰੁ ਜੋਹੈ ਹਾਣੇ ਹਾਣਿ ॥",
      "transliteration": "par ghar johai haane haan ||",
      "translation": "They look into the homes of others, and lose.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਨਮੁਖਿ ਭਰਮਿ ਭਵੈ ਬੇਬਾਣਿ ॥",
      "transliteration": "manamukh bharam bhavai bebaan ||",
      "translation": "The manmukhs are confused by doubt, wandering in the wilderness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਵੇਮਾਰਗਿ ਮੂਸੈ ਮੰਤ੍ਰਿ ਮਸਾਣਿ ॥",
      "transliteration": "vemaarag moosai ma(n)tr masaan ||",
      "translation": "Having lost their way, they are plundered; they chant their mantras at cremation grounds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਬਦੁ ਨ ਚੀਨੈ ਲਵੈ ਕੁਬਾਣਿ ॥",
      "transliteration": "sabad na cheenai lavai kubaan ||",
      "translation": "They do not think of the Shabad; instead, they utter obscenities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਨਕ ਸਾਚਿ ਰਤੇ ਸੁਖੁ ਜਾਣਿ ॥੨੬॥",
      "transliteration": "naanak saach rate sukh jaan ||26||",
      "translation": "O Nanak, those who are attuned to the Truth know peace. ||26||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਚੇ ਕਾ ਭਉ ਪਾਵੈ ॥",
      "transliteration": "guramukh saache kaa bhau paavai ||",
      "translation": "The Gurmukh lives in the Fear of God, the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਬਾਣੀ ਅਘੜੁ ਘੜਾਵੈ ॥",
      "transliteration": "guramukh baanee aghaR ghaRaavai ||",
      "translation": "Through the Word of the Guru's Bani, the Gurmukh refines the unrefined.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਿਰਮਲ ਹਰਿ ਗੁਣ ਗਾਵੈ ॥",
      "transliteration": "guramukh niramal har gun gaavai ||",
      "translation": "The Gurmukh sings the immaculate, Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਵਿਤ੍ਰੁ ਪਰਮ ਪਦੁ ਪਾਵੈ ॥",
      "transliteration": "guramukh pavitr param pad paavai ||",
      "translation": "The Gurmukh attains the supreme, sanctified status.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਰੋਮਿ ਰੋਮਿ ਹਰਿ ਧਿਆਵੈ ॥",
      "transliteration": "guramukh rom rom har dhiaavai ||",
      "translation": "The Gurmukh meditates on the Lord with every hair of his body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਸਾਚਿ ਸਮਾਵੈ ॥੨੭॥",
      "transliteration": "naanak guramukh saach samaavai ||27||",
      "translation": "O Nanak, the Gurmukh merges in Truth. ||27||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਰਚੈ ਬੇਦ ਬੀਚਾਰੀ ॥",
      "transliteration": "guramukh parachai bed beechaaree ||",
      "translation": "The Gurmukh is pleasing to the True Guru; this is contemplation on the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਰਚੈ ਤਰੀਐ ਤਾਰੀ ॥",
      "transliteration": "guramukh parachai tareeai taaree ||",
      "translation": "Pleasing the True Guru, the Gurmukh is carried across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਰਚੈ ਸੁ ਸਬਦਿ ਗਿਆਨੀ ॥",
      "transliteration": "guramukh parachai s sabad giaanee ||",
      "translation": "Pleasing the True Guru, the Gurmukh receives the spiritual wisdom of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਰਚੈ ਅੰਤਰ ਬਿਧਿ ਜਾਨੀ ॥",
      "transliteration": "guramukh parachai a(n)tar bidh jaanee ||",
      "translation": "Pleasing the True Guru, the Gurmukh comes to know the path within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਾਈਐ ਅਲਖ ਅਪਾਰੁ ॥",
      "transliteration": "guramukh paaeeai alakh apaar ||",
      "translation": "The Gurmukh attains the unseen and infinite Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਮੁਕਤਿ ਦੁਆਰੁ ॥੨੮॥",
      "transliteration": "naanak guramukh mukat duaar ||28||",
      "translation": "O Nanak, the Gurmukh finds the door of liberation. ||28||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਅਕਥੁ ਕਥੈ ਬੀਚਾਰਿ ॥",
      "transliteration": "guramukh akath kathai beechaar ||",
      "translation": "The Gurmukh speaks the unspoken wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਿਬਹੈ ਸਪਰਵਾਰਿ ॥",
      "transliteration": "guramukh nibahai saparavaar ||",
      "translation": "In the midst of his family, the Gurmukh lives a spiritual life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਜਪੀਐ ਅੰਤਰਿ ਪਿਆਰਿ ॥",
      "transliteration": "guramukh japeeai a(n)tar piaar ||",
      "translation": "The Gurmukh lovingly meditates deep within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਾਈਐ ਸਬਦਿ ਅਚਾਰਿ ॥",
      "transliteration": "guramukh paaeeai sabad achaar ||",
      "translation": "The Gurmukh obtains the Shabad, and righteous conduct.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਬਦਿ ਭੇਦਿ ਜਾਣੈ ਜਾਣਾਈ ॥",
      "transliteration": "sabad bhed jaanai jaanaaee ||",
      "translation": "He knows the mystery of the Shabad, and inspires others to know it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਨਕ ਹਉਮੈ ਜਾਲਿ ਸਮਾਈ ॥੨੯॥",
      "transliteration": "naanak haumai jaal samaaee ||29||",
      "translation": "O Nanak, burning away his ego, he merges in the Lord. ||29||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਧਰਤੀ ਸਾਚੈ ਸਾਜੀ ॥",
      "transliteration": "guramukh dharatee saachai saajee ||",
      "translation": "The True Lord fashioned the earth for the sake of the Gurmukhs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਿਸ ਮਹਿ ਓਪਤਿ ਖਪਤਿ ਸੁ ਬਾਜੀ ॥",
      "transliteration": "tis mahi opat khapat s baajee ||",
      "translation": "There, he set in motion the play of creation and destruction.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਰਪੈ ਰੰਗੁ ਲਾਇ ॥",
      "transliteration": "gur kai sabad rapai ra(n)g laai ||",
      "translation": "One who is filled with the Word of the Guru's Shabad enshrines love for the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਚਿ ਰਤਉ ਪਤਿ ਸਿਉ ਘਰਿ ਜਾਇ ॥",
      "transliteration": "saach ratau pat siu ghar jaai ||",
      "translation": "Attuned to the Truth, he goes to his home with honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਾਚ ਸਬਦ ਬਿਨੁ ਪਤਿ ਨਹੀ ਪਾਵੈ ॥",
      "transliteration": "saach sabad bin pat nahee paavai ||",
      "translation": "Without the True Word of the Shabad, no one receives honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਨਕ ਬਿਨੁ ਨਾਵੈ ਕਿਉ ਸਾਚਿ ਸਮਾਵੈ ॥੩੦॥",
      "transliteration": "naanak bin naavai kiu saach samaavai ||30||",
      "translation": "O Nanak, without the Name, how can one be absorbed in Truth? ||30||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਅਸਟ ਸਿਧੀ ਸਭਿ ਬੁਧੀ ॥",
      "transliteration": "guramukh asat sidhee sabh budhee ||",
      "translation": "The Gurmukh obtains the eight miraculous spiritual powers, and all wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਭਵਜਲੁ ਤਰੀਐ ਸਚ ਸੁਧੀ ॥",
      "transliteration": "guramukh bhavajal tareeai sach sudhee ||",
      "translation": "The Gurmukh crosses over the terrifying world-ocean, and obtains true understanding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਰ ਅਪਸਰ ਬਿਧਿ ਜਾਣੈ ॥",
      "transliteration": "guramukh sar apasar bidh jaanai ||",
      "translation": "The Gurmukh knows the ways of truth and untruth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਰਵਿਰਤਿ ਨਰਵਿਰਤਿ ਪਛਾਣੈ ॥",
      "transliteration": "guramukh paravirat naravirat pachhaanai ||",
      "translation": "The Gurmukh knows worldliness and renunciation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਤਾਰੇ ਪਾਰਿ ਉਤਾਰੇ ॥",
      "transliteration": "guramukh taare paar utaare ||",
      "translation": "The Gurmukh crosses over, and carries others across as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਸਬਦਿ ਨਿਸਤਾਰੇ ॥੩੧॥",
      "transliteration": "naanak guramukh sabad nisataare ||31||",
      "translation": "O Nanak, the Gurmukh is emancipated through the Shabad. ||31||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਮੇ ਰਾਤੇ ਹਉਮੈ ਜਾਇ ॥",
      "transliteration": "naame raate haumai jaai ||",
      "translation": "Attuned to the Naam, the Name of the Lord, egotism is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਸਚਿ ਰਹੇ ਸਮਾਇ ॥",
      "transliteration": "naam rate sach rahe samaai ||",
      "translation": "Attuned to the Naam, they remain absorbed in the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਜੋਗ ਜੁਗਤਿ ਬੀਚਾਰੁ ॥",
      "transliteration": "naam rate jog jugat beechaar ||",
      "translation": "Attuned to the Naam, they contemplate the Way of Yoga.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਪਾਵਹਿ ਮੋਖ ਦੁਆਰੁ ॥",
      "transliteration": "naam rate paavahi mokh duaar ||",
      "translation": "Attuned to the Naam, they find the door of liberation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਤ੍ਰਿਭਵਣ ਸੋਝੀ ਹੋਇ ॥",
      "transliteration": "naam rate tribhavan sojhee hoi ||",
      "translation": "Attuned to the Naam, they understand the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥੩੨॥",
      "transliteration": "naanak naam rate sadaa sukh hoi ||32||",
      "translation": "O Nanak, attuned to the Naam, eternal peace is found. ||32||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਸਿਧ ਗੋਸਟਿ ਹੋਇ ॥",
      "transliteration": "naam rate sidh gosat hoi ||",
      "translation": "Attuned to the Naam, they attain Sidh Gosht - conversation with the Siddhas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਸਦਾ ਤਪੁ ਹੋਇ ॥",
      "transliteration": "naam rate sadaa tap hoi ||",
      "translation": "Attuned to the Naam, they practice intense meditation forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਸਚੁ ਕਰਣੀ ਸਾਰੁ ॥",
      "transliteration": "naam rate sach karanee saar ||",
      "translation": "Attuned to the Naam, they live the true and excellent lifestyle.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਗੁਣ ਗਿਆਨ ਬੀਚਾਰੁ ॥",
      "transliteration": "naam rate gun giaan beechaar ||",
      "translation": "Attuned to the Naam, they contemplate the Lord's virtues and spiritual wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਬੋਲੈ ਸਭੁ ਵੇਕਾਰੁ ॥",
      "transliteration": "bin naavai bolai sabh vekaar ||",
      "translation": "Without the Name, all that is spoken is useless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ ਤਿਨ ਕਉ ਜੈਕਾਰੁ ॥੩੩॥",
      "transliteration": "naanak naam rate tin kau jaikaar ||33||",
      "translation": "O Nanak, attuned to the Naam, their victory is celebrated. ||33||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਤੇ ਨਾਮੁ ਪਾਇਆ ਜਾਇ ॥",
      "transliteration": "poore gur te naam paaiaa jaai ||",
      "translation": "Through the Perfect Guru, one obtains the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜੋਗ ਜੁਗਤਿ ਸਚਿ ਰਹੈ ਸਮਾਇ ॥",
      "transliteration": "jog jugat sach rahai samaai ||",
      "translation": "The Way of Yoga is to remain absorbed in Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬਾਰਹ ਮਹਿ ਜੋਗੀ ਭਰਮਾਏ ਸੰਨਿਆਸੀ ਛਿਅ ਚਾਰਿ ॥",
      "transliteration": "baarah mahi jogee bharamaae sa(n)niaasee chhi chaar ||",
      "translation": "The Yogis wander in the twelve schools of Yoga; the Sannyaasis in six and four.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0941_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਜੋ ਮਰਿ ਜੀਵੈ ਸੋ ਪਾਏ ਮੋਖ ਦੁਆਰੁ ॥",
      "transliteration": "gur kai sabad jo mar jeevai so paae mokh duaar ||",
      "translation": "One who remains dead while yet alive, through the Word of the Guru's Shabad, finds the door of liberation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 941,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
