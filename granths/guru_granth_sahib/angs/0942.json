{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 942,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0942_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਿਨੁ ਸਬਦੈ ਸਭਿ ਦੂਜੈ ਲਾਗੇ ਦੇਖਹੁ ਰਿਦੈ ਬੀਚਾਰਿ ॥",
      "transliteration": "bin sabadai sabh doojai laage dekhahu ridai beechaar ||",
      "translation": "Without the Shabad, all are attached to duality. Contemplate this in your heart, and see.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਨਕ ਵਡੇ ਸੇ ਵਡਭਾਗੀ ਜਿਨੀ ਸਚੁ ਰਖਿਆ ਉਰ ਧਾਰਿ ॥੩੪॥",
      "transliteration": "naanak vade se vadabhaagee jinee sach rakhiaa ur dhaar ||34||",
      "translation": "O Nanak, blessed and very fortunate are those who keep the True Lord enshrined in their hearts. ||34||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਰਤਨੁ ਲਹੈ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "guramukh ratan lahai liv laai ||",
      "translation": "The Gurmukh obtains the jewel, lovingly focused on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਰਖੈ ਰਤਨੁ ਸੁਭਾਇ ॥",
      "transliteration": "guramukh parakhai ratan subhaai ||",
      "translation": "The Gurmukh intuitively recognizes the value of this jewel.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਚੀ ਕਾਰ ਕਮਾਇ ॥",
      "transliteration": "guramukh saachee kaar kamaai ||",
      "translation": "The Gurmukh practices Truth in action.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਚੇ ਮਨੁ ਪਤੀਆਇ ॥",
      "transliteration": "guramukh saache man pateeaai ||",
      "translation": "The mind of the Gurmukh is pleased with the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਅਲਖੁ ਲਖਾਏ ਤਿਸੁ ਭਾਵੈ ॥",
      "transliteration": "guramukh alakh lakhaae tis bhaavai ||",
      "translation": "The Gurmukh sees the unseen, when it pleases the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਚੋਟ ਨ ਖਾਵੈ ॥੩੫॥",
      "transliteration": "naanak guramukh chot na khaavai ||35||",
      "translation": "O Nanak, the Gurmukh does not have to endure punishment. ||35||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਮੁ ਦਾਨੁ ਇਸਨਾਨੁ ॥",
      "transliteration": "guramukh naam daan isanaan ||",
      "translation": "The Gurmukh is blessed with the Name, charity and purification.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਲਾਗੈ ਸਹਜਿ ਧਿਆਨੁ ॥",
      "transliteration": "guramukh laagai sahaj dhiaan ||",
      "translation": "The Gurmukh centers his meditation on the celestial Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਾਵੈ ਦਰਗਹ ਮਾਨੁ ॥",
      "transliteration": "guramukh paavai daragah maan ||",
      "translation": "The Gurmukh obtains honor in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਭਉ ਭੰਜਨੁ ਪਰਧਾਨੁ ॥",
      "transliteration": "guramukh bhau bha(n)jan paradhaan ||",
      "translation": "The Gurmukh obtains the Supreme Lord, the Destroyer of fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਕਰਣੀ ਕਾਰ ਕਰਾਏ ॥",
      "transliteration": "guramukh karanee kaar karaae ||",
      "translation": "The Gurmukh does good deeds, an inspires others to do so.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਮੇਲਿ ਮਿਲਾਏ ॥੩੬॥",
      "transliteration": "naanak guramukh mel milaae ||36||",
      "translation": "O Nanak, the Gurmukh unites in the Lord's Union. ||36||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਸਤ੍ਰ ਸਿਮ੍ਰਿਤਿ ਬੇਦ ॥",
      "transliteration": "guramukh saasatr simrit bed ||",
      "translation": "The Gurmukh understands the Simritees, the Shaastras and the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਾਵੈ ਘਟਿ ਘਟਿ ਭੇਦ ॥",
      "transliteration": "guramukh paavai ghat ghat bhed ||",
      "translation": "The Gurmukh knows the secrets of each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਵੈਰ ਵਿਰੋਧ ਗਵਾਵੈ ॥",
      "transliteration": "guramukh vair virodh gavaavai ||",
      "translation": "The Gurmukh eliminates hate and envy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਗਲੀ ਗਣਤ ਮਿਟਾਵੈ ॥",
      "transliteration": "guramukh sagalee ganat mitaavai ||",
      "translation": "The Gurmukh erases all accounting.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਰਾਮ ਨਾਮ ਰੰਗਿ ਰਾਤਾ ॥",
      "transliteration": "guramukh raam naam ra(n)g raataa ||",
      "translation": "The Gurmukh is imbued with love for the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਖਸਮੁ ਪਛਾਤਾ ॥੩੭॥",
      "transliteration": "naanak guramukh khasam pachhaataa ||37||",
      "translation": "O Nanak, the Gurmukh realizes his Lord and Master. ||37||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਭਰਮੈ ਆਵੈ ਜਾਇ ॥",
      "transliteration": "bin gur bharamai aavai jaai ||",
      "translation": "Without the Guru, one wanders, coming and going in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਘਾਲ ਨ ਪਵਈ ਥਾਇ ॥",
      "transliteration": "bin gur ghaal na pavaee thaai ||",
      "translation": "Without the Guru, one's work is useless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਮਨੂਆ ਅਤਿ ਡੋਲਾਇ ॥",
      "transliteration": "bin gur manooaa at dolaai ||",
      "translation": "Without the Guru, the mind is totally unsteady.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਤ੍ਰਿਪਤਿ ਨਹੀ ਬਿਖੁ ਖਾਇ ॥",
      "transliteration": "bin gur tripat nahee bikh khaai ||",
      "translation": "Without the Guru, one is unsatisfied, and eats poison.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਬਿਸੀਅਰੁ ਡਸੈ ਮਰਿ ਵਾਟ ॥",
      "transliteration": "bin gur biseear dasai mar vaat ||",
      "translation": "Without the Guru, one is stung by the poisonous snake of Maya, and dies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਨਕ ਗੁਰ ਬਿਨੁ ਘਾਟੇ ਘਾਟ ॥੩੮॥",
      "transliteration": "naanak gur bin ghaate ghaat ||38||",
      "translation": "O Nanak without the Guru, all is lost. ||38||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਿਸੁ ਗੁਰੁ ਮਿਲੈ ਤਿਸੁ ਪਾਰਿ ਉਤਾਰੈ ॥",
      "transliteration": "jis gur milai tis paar utaarai ||",
      "translation": "One who meets the Guru is carried across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਵਗਣ ਮੇਟੈ ਗੁਣਿ ਨਿਸਤਾਰੈ ॥",
      "transliteration": "avagan metai gun nisataarai ||",
      "translation": "His sins are erased, and he is emancipated through virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੁਕਤਿ ਮਹਾ ਸੁਖ ਗੁਰਸਬਦੁ ਬੀਚਾਰਿ ॥",
      "transliteration": "mukat mahaa sukh gurasabad beechaar ||",
      "translation": "The supreme peace of liberation is attained, contemplating the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਕਦੇ ਨ ਆਵੈ ਹਾਰਿ ॥",
      "transliteration": "guramukh kade na aavai haar ||",
      "translation": "The Gurmukh is never defeated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਨੁ ਹਟੜੀ ਇਹੁ ਮਨੁ ਵਣਜਾਰਾ ॥",
      "transliteration": "tan hataRee ihu man vanajaaraa ||",
      "translation": "In the store of the body, this mind is the merchant;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਨਕ ਸਹਜੇ ਸਚੁ ਵਾਪਾਰਾ ॥੩੯॥",
      "transliteration": "naanak sahaje sach vaapaaraa ||39||",
      "translation": "O Nanak, it deals intuitively in Truth. ||39||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਬਾਂਧਿਓ ਸੇਤੁ ਬਿਧਾਤੈ ॥",
      "transliteration": "guramukh baa(n)dhio set bidhaatai ||",
      "translation": "The Gurmukh is the bridge, built by the Architect of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਲੰਕਾ ਲੂਟੀ ਦੈਤ ਸੰਤਾਪੈ ॥",
      "transliteration": "la(n)kaa lootee dait sa(n)taapai ||",
      "translation": "The demons of passion which plundered Sri Lanka - the body - have been conquered.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਾਮਚੰਦਿ ਮਾਰਿਓ ਅਹਿ ਰਾਵਣੁ ॥",
      "transliteration": "raamacha(n)d maario ahi raavan ||",
      "translation": "Ram Chand - the mind - has slaughtered Raawan - pride;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭੇਦੁ ਬਭੀਖਣ ਗੁਰਮੁਖਿ ਪਰਚਾਇਣੁ ॥",
      "transliteration": "bhed babheekhan guramukh parachaain ||",
      "translation": "the Gurmukh understands the secret revealed by Babheekhan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਇਰਿ ਪਾਹਣ ਤਾਰੇ ॥",
      "transliteration": "guramukh saair paahan taare ||",
      "translation": "The Gurmukh carries even stones across the ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਕੋਟਿ ਤੇਤੀਸ ਉਧਾਰੇ ॥੪੦॥",
      "transliteration": "guramukh kot tetees udhaare ||40||",
      "translation": "The Gurmukh saves millions of people. ||40||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਚੂਕੈ ਆਵਣ ਜਾਣੁ ॥",
      "transliteration": "guramukh chookai aavan jaan ||",
      "translation": "The comings and goings in reincarnation are ended for the Gurmukh.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਦਰਗਹ ਪਾਵੈ ਮਾਣੁ ॥",
      "transliteration": "guramukh daragah paavai maan ||",
      "translation": "The Gurmukh is honored in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਖੋਟੇ ਖਰੇ ਪਛਾਣੁ ॥",
      "transliteration": "guramukh khote khare pachhaan ||",
      "translation": "The Gurmukh distinguishes the true from the false.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਲਾਗੈ ਸਹਜਿ ਧਿਆਨੁ ॥",
      "transliteration": "guramukh laagai sahaj dhiaan ||",
      "translation": "The Gurmukh focuses his meditation on the celestial Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਦਰਗਹ ਸਿਫਤਿ ਸਮਾਇ ॥",
      "transliteration": "guramukh daragah siphat samaai ||",
      "translation": "In the Court of the Lord, the Gurmukh is absorbed in His Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਬੰਧੁ ਨ ਪਾਇ ॥੪੧॥",
      "transliteration": "naanak guramukh ba(n)dh na paai ||41||",
      "translation": "O Nanak, the Gurmukh is not bound by bonds. ||41||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਮੁ ਨਿਰੰਜਨ ਪਾਏ ॥",
      "transliteration": "guramukh naam nira(n)jan paae ||",
      "translation": "The Gurmukh obtains the Name of the Immaculate Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਹਉਮੈ ਸਬਦਿ ਜਲਾਏ ॥",
      "transliteration": "guramukh haumai sabad jalaae ||",
      "translation": "Through the Shabad, the Gurmukh burns away his ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਚੇ ਕੇ ਗੁਣ ਗਾਏ ॥",
      "transliteration": "guramukh saache ke gun gaae ||",
      "translation": "The Gurmukh sings the Glorious Praises of the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਚੈ ਰਹੈ ਸਮਾਏ ॥",
      "transliteration": "guramukh saachai rahai samaae ||",
      "translation": "The Gurmukh remains absorbed in the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਚਿ ਨਾਮਿ ਪਤਿ ਊਤਮ ਹੋਇ ॥",
      "transliteration": "guramukh saach naam pat ootam hoi ||",
      "translation": "Through the True Name, the Gurmukh is honored and exalted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਸਗਲ ਭਵਣ ਕੀ ਸੋਝੀ ਹੋਇ ॥੪੨॥",
      "transliteration": "naanak guramukh sagal bhavan kee sojhee hoi ||42||",
      "translation": "O Nanak, the Gurmukh understands all the worlds. ||42||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਵਣ ਮੂਲੁ ਕਵਣ ਮਤਿ ਵੇਲਾ ॥",
      "transliteration": "kavan mool kavan mat velaa ||",
      "translation": "\"What is the root, the source of all? What teachings hold for these times?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤੇਰਾ ਕਵਣੁ ਗੁਰੂ ਜਿਸ ਕਾ ਤੂ ਚੇਲਾ ॥",
      "transliteration": "teraa kavan guroo jis kaa too chelaa ||",
      "translation": "Who is your guru? Whose disciple are you?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਵਣ ਕਥਾ ਲੇ ਰਹਹੁ ਨਿਰਾਲੇ ॥",
      "transliteration": "kavan kathaa le rahahu niraale ||",
      "translation": "What is that speech, by which you remain unattached?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਬੋਲੈ ਨਾਨਕੁ ਸੁਣਹੁ ਤੁਮ ਬਾਲੇ ॥",
      "transliteration": "bolai naanak sunahu tum baale ||",
      "translation": "Listen to what we say, O Nanak, you little boy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਏਸੁ ਕਥਾ ਕਾ ਦੇਇ ਬੀਚਾਰੁ ॥",
      "transliteration": "es kathaa kaa dei beechaar ||",
      "translation": "Give us your opinion on what we have said.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0942_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਭਵਜਲੁ ਸਬਦਿ ਲੰਘਾਵਣਹਾਰੁ ॥੪੩॥",
      "transliteration": "bhavajal sabad la(n)ghaavanahaar ||43||",
      "translation": "How can the Shabad carry us across the terrifying world-ocean?\" ||43||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 942,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
