{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 943,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0943_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਵਨ ਅਰੰਭੁ ਸਤਿਗੁਰ ਮਤਿ ਵੇਲਾ ॥",
      "transliteration": "pavan ara(n)bh satigur mat velaa ||",
      "translation": "From the air came the beginning. This is the age of the True Guru's Teachings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਬਦੁ ਗੁਰੂ ਸੁਰਤਿ ਧੁਨਿ ਚੇਲਾ ॥",
      "transliteration": "sabad guroo surat dhun chelaa ||",
      "translation": "The Shabad is the Guru, upon whom I lovingly focus my consciousness; I am the chaylaa, the disciple.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਕਥ ਕਥਾ ਲੇ ਰਹਉ ਨਿਰਾਲਾ ॥",
      "transliteration": "akath kathaa le rahau niraalaa ||",
      "translation": "Speaking the Unspoken Speech, I remain unattached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਨਕ ਜੁਗਿ ਜੁਗਿ ਗੁਰ ਗੋਪਾਲਾ ॥",
      "transliteration": "naanak jug jug gur gopaalaa ||",
      "translation": "O Nanak, throughout the ages, the Lord of the World is my Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਏਕੁ ਸਬਦੁ ਜਿਤੁ ਕਥਾ ਵੀਚਾਰੀ ॥",
      "transliteration": "ek sabad jit kathaa veechaaree ||",
      "translation": "I contemplate the sermon of the Shabad, the Word of the One God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਹਉਮੈ ਅਗਨਿ ਨਿਵਾਰੀ ॥੪੪॥",
      "transliteration": "guramukh haumai agan nivaaree ||44||",
      "translation": "The Gurmukh puts out the fire of egotism. ||44||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮੈਣ ਕੇ ਦੰਤ ਕਿਉ ਖਾਈਐ ਸਾਰੁ ॥",
      "transliteration": "main ke da(n)t kiu khaaeeai saar ||",
      "translation": "\"With teeth of wax, how can one chew iron?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਤੁ ਗਰਬੁ ਜਾਇ ਸੁ ਕਵਣੁ ਆਹਾਰੁ ॥",
      "transliteration": "jit garab jaai s kavan aahaar ||",
      "translation": "What is that food, which takes away pride?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਿਵੈ ਕਾ ਘਰੁ ਮੰਦਰੁ ਅਗਨਿ ਪਿਰਾਹਨੁ ॥",
      "transliteration": "hivai kaa ghar ma(n)dar agan piraahan ||",
      "translation": "How can one live in the palace, the home of snow, wearing robes of fire?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਵਨ ਗੁਫਾ ਜਿਤੁ ਰਹੈ ਅਵਾਹਨੁ ॥",
      "transliteration": "kavan guphaa jit rahai avaahan ||",
      "translation": "Where is that cave, within which one may remain unshaken?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇਤ ਉਤ ਕਿਸ ਕਉ ਜਾਣਿ ਸਮਾਵੈ ॥",
      "transliteration": "it ut kis kau jaan samaavai ||",
      "translation": "Who should we know to be pervading here and there?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਵਨ ਧਿਆਨੁ ਮਨੁ ਮਨਹਿ ਸਮਾਵੈ ॥੪੫॥",
      "transliteration": "kavan dhiaan man manahi samaavai ||45||",
      "translation": "What is that meditation, which leads the mind to be absorbed in itself?\" ||45||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਉ ਹਉ ਮੈ ਮੈ ਵਿਚਹੁ ਖੋਵੈ ॥",
      "transliteration": "hau hau mai mai vichahu khovai ||",
      "translation": "Eradicating egotism and individualism from within,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੂਜਾ ਮੇਟੈ ਏਕੋ ਹੋਵੈ ॥",
      "transliteration": "doojaa metai eko hovai ||",
      "translation": "and erasing duality, the mortal becomes one with God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਗੁ ਕਰੜਾ ਮਨਮੁਖੁ ਗਾਵਾਰੁ ॥",
      "transliteration": "jag karaRaa manamukh gaavaar ||",
      "translation": "The world is difficult for the foolish, self-willed manmukh;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਬਦੁ ਕਮਾਈਐ ਖਾਈਐ ਸਾਰੁ ॥",
      "transliteration": "sabad kamaaeeai khaaeeai saar ||",
      "translation": "practicing the Shabad, one chews iron.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅੰਤਰਿ ਬਾਹਰਿ ਏਕੋ ਜਾਣੈ ॥",
      "transliteration": "a(n)tar baahar eko jaanai ||",
      "translation": "Know the One Lord, inside and out.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਨਕ ਅਗਨਿ ਮਰੈ ਸਤਿਗੁਰ ਕੈ ਭਾਣੈ ॥੪੬॥",
      "transliteration": "naanak agan marai satigur kai bhaanai ||46||",
      "translation": "O Nanak, the fire is quenched, through the Pleasure of the True Guru's Will. ||46||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਚ ਭੈ ਰਾਤਾ ਗਰਬੁ ਨਿਵਾਰੈ ॥",
      "transliteration": "sach bhai raataa garab nivaarai ||",
      "translation": "Imbued with the True Fear of God, pride is taken away;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਏਕੋ ਜਾਤਾ ਸਬਦੁ ਵੀਚਾਰੈ ॥",
      "transliteration": "eko jaataa sabad veechaarai ||",
      "translation": "realize that He is One, and contemplate the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਬਦੁ ਵਸੈ ਸਚੁ ਅੰਤਰਿ ਹੀਆ ॥",
      "transliteration": "sabad vasai sach a(n)tar heeaa ||",
      "translation": "With the True Shabad abiding deep within the heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਸੀਤਲੁ ਰੰਗਿ ਰੰਗੀਆ ॥",
      "transliteration": "tan man seetal ra(n)g ra(n)geeaa ||",
      "translation": "the body and mind are cooled and soothed, and colored with the Lord's Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਬਿਖੁ ਅਗਨਿ ਨਿਵਾਰੇ ॥",
      "transliteration": "kaam krodh bikh agan nivaare ||",
      "translation": "The fire of sexual desire, anger and corruption is quenched.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਨਕ ਨਦਰੀ ਨਦਰਿ ਪਿਆਰੇ ॥੪੭॥",
      "transliteration": "naanak nadaree nadar piaare ||47||",
      "translation": "O Nanak, the Beloved bestows His Glance of Grace. ||47||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਵਨ ਮੁਖਿ ਚੰਦੁ ਹਿਵੈ ਘਰੁ ਛਾਇਆ ॥",
      "transliteration": "kavan mukh cha(n)d hivai ghar chhaaiaa ||",
      "translation": "\"The moon of the mind is cool and dark; how is it enlightened?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਵਨ ਮੁਖਿ ਸੂਰਜੁ ਤਪੈ ਤਪਾਇਆ ॥",
      "transliteration": "kavan mukh sooraj tapai tapaaiaa ||",
      "translation": "How does the sun blaze so brilliantly?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਵਨ ਮੁਖਿ ਕਾਲੁ ਜੋਹਤ ਨਿਤ ਰਹੈ ॥",
      "transliteration": "kavan mukh kaal johat nit rahai ||",
      "translation": "How can the constant watchful gaze of Death be turned away?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਵਨ ਬੁਧਿ ਗੁਰਮੁਖਿ ਪਤਿ ਰਹੈ ॥",
      "transliteration": "kavan budh guramukh pat rahai ||",
      "translation": "By what understanding is the honor of the Gurmukh preserved?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਵਨੁ ਜੋਧੁ ਜੋ ਕਾਲੁ ਸੰਘਾਰੈ ॥",
      "transliteration": "kavan jodh jo kaal sa(n)ghaarai ||",
      "translation": "Who is the warrior, who conquers Death?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬੋਲੈ ਬਾਣੀ ਨਾਨਕੁ ਬੀਚਾਰੈ ॥੪੮॥",
      "transliteration": "bolai baanee naanak beechaarai ||48||",
      "translation": "Give us your thoughtful reply, O Nanak.\" ||48||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਬਦੁ ਭਾਖਤ ਸਸਿ ਜੋਤਿ ਅਪਾਰਾ ॥",
      "transliteration": "sabad bhaakhat sas jot apaaraa ||",
      "translation": "Giving voice to the Shabad, the moon of the mind is illuminated with infinity.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਸਿ ਘਰਿ ਸੂਰੁ ਵਸੈ ਮਿਟੈ ਅੰਧਿਆਰਾ ॥",
      "transliteration": "sas ghar soor vasai mitai a(n)dhiaaraa ||",
      "translation": "When the sun dwells in the house of the moon, the darkness is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁਖੁ ਦੁਖੁ ਸਮ ਕਰਿ ਨਾਮੁ ਅਧਾਰਾ ॥",
      "transliteration": "sukh dukh sam kar naam adhaaraa ||",
      "translation": "Pleasure and pain are just the same, when one takes the Support of the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਪੇ ਪਾਰਿ ਉਤਾਰਣਹਾਰਾ ॥",
      "transliteration": "aape paar utaaranahaaraa ||",
      "translation": "He Himself saves, and carries us across.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰ ਪਰਚੈ ਮਨੁ ਸਾਚਿ ਸਮਾਇ ॥",
      "transliteration": "gur parachai man saach samaai ||",
      "translation": "With faith in the Guru, the mind merges in Truth,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪ੍ਰਣਵਤਿ ਨਾਨਕੁ ਕਾਲੁ ਨ ਖਾਇ ॥੪੯॥",
      "transliteration": "pranavat naanak kaal na khaai ||49||",
      "translation": "and then, prays Nanak, one is not consumed by Death. ||49||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਮ ਤਤੁ ਸਭ ਹੀ ਸਿਰਿ ਜਾਪੈ ॥",
      "transliteration": "naam tat sabh hee sir jaapai ||",
      "translation": "The essence of the Naam, the Name of the Lord, is known to be the most exalted and excellent of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਦੁਖੁ ਕਾਲੁ ਸੰਤਾਪੈ ॥",
      "transliteration": "bin naavai dukh kaal sa(n)taapai ||",
      "translation": "Without the Name, one is afflicted by pain and death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਤੋ ਤਤੁ ਮਿਲੈ ਮਨੁ ਮਾਨੈ ॥",
      "transliteration": "tato tat milai man maanai ||",
      "translation": "When one's essence merges into the essence, the mind is satisfied and fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੂਜਾ ਜਾਇ ਇਕਤੁ ਘਰਿ ਆਨੈ ॥",
      "transliteration": "doojaa jaai ikat ghar aanai ||",
      "translation": "Duality is gone, and one enters into the home of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬੋਲੈ ਪਵਨਾ ਗਗਨੁ ਗਰਜੈ ॥",
      "transliteration": "bolai pavanaa gagan garajai ||",
      "translation": "The breath blows across the sky of the Tenth Gate and vibrates.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਨਕ ਨਿਹਚਲੁ ਮਿਲਣੁ ਸਹਜੈ ॥੫੦॥",
      "transliteration": "naanak nihachal milan sahajai ||50||",
      "translation": "O Nanak, the mortal then intuitively meets the eternal, unchanging Lord. ||50||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅੰਤਰਿ ਸੁੰਨੰ ਬਾਹਰਿ ਸੁੰਨੰ ਤ੍ਰਿਭਵਣ ਸੁੰਨ ਮਸੁੰਨੰ ॥",
      "transliteration": "a(n)tar su(n)na(n) baahar su(n)na(n) tribhavan su(n)n masu(n)na(n) ||",
      "translation": "The absolute Lord is deep within; the absolute Lord is outside us as well. The absolute Lord totally fills the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚਉਥੇ ਸੁੰਨੈ ਜੋ ਨਰੁ ਜਾਣੈ ਤਾ ਕਉ ਪਾਪੁ ਨ ਪੁੰਨੰ ॥",
      "transliteration": "chauthe su(n)nai jo nar jaanai taa kau paap na pu(n)na(n) ||",
      "translation": "One who knows the Lord in the fourth state, is not subject to virtue or vice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਸੁੰਨ ਕਾ ਜਾਣੈ ਭੇਉ ॥",
      "transliteration": "ghat ghat su(n)n kaa jaanai bheu ||",
      "translation": "One who knows the mystery of God the Absolute, who pervades each and every heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਦਿ ਪੁਰਖੁ ਨਿਰੰਜਨ ਦੇਉ ॥",
      "transliteration": "aad purakh nira(n)jan deu ||",
      "translation": "Knows the Primal Being, the Immaculate Divine Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੋ ਜਨੁ ਨਾਮ ਨਿਰੰਜਨ ਰਾਤਾ ॥",
      "transliteration": "jo jan naam nira(n)jan raataa ||",
      "translation": "That humble being who is imbued with the Immaculate Naam,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਨਕ ਸੋਈ ਪੁਰਖੁ ਬਿਧਾਤਾ ॥੫੧॥",
      "transliteration": "naanak soee purakh bidhaataa ||51||",
      "translation": "O Nanak, is himself the Primal Lord, the Architect of Destiny. ||51||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੁੰਨੋ ਸੁੰਨੁ ਕਹੈ ਸਭੁ ਕੋਈ ॥",
      "transliteration": "su(n)no su(n)n kahai sabh koee ||",
      "translation": "\"Everyone speaks of the Absolute Lord, the unmanifest void.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਅਨਹਤ ਸੁੰਨੁ ਕਹਾ ਤੇ ਹੋਈ ॥",
      "transliteration": "anahat su(n)n kahaa te hoee ||",
      "translation": "How can one find this absolute void?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅਨਹਤ ਸੁੰਨਿ ਰਤੇ ਸੇ ਕੈਸੇ ॥",
      "transliteration": "anahat su(n)n rate se kaise ||",
      "translation": "Who are they, who are attuned to this absolute void?\"",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਿਸ ਤੇ ਉਪਜੇ ਤਿਸ ਹੀ ਜੈਸੇ ॥",
      "transliteration": "jis te upaje tis hee jaise ||",
      "translation": "They are like the Lord, from whom they originated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਓਇ ਜਨਮਿ ਨ ਮਰਹਿ ਨ ਆਵਹਿ ਜਾਹਿ ॥",
      "transliteration": "oi janam na marahi na aavahi jaahi ||",
      "translation": "They are not born, they do not die; they do not come and go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਮਨੁ ਸਮਝਾਹਿ ॥੫੨॥",
      "transliteration": "naanak guramukh man samajhaahi ||52||",
      "translation": "O Nanak, the Gurmukhs instruct their minds. ||52||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਉ ਸਰ ਸੁਭਰ ਦਸਵੈ ਪੂਰੇ ॥",
      "transliteration": "nau sar subhar dasavai poore ||",
      "translation": "By practicing control over the nine gates, one attains perfect control over the Tenth Gate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਤਹ ਅਨਹਤ ਸੁੰਨ ਵਜਾਵਹਿ ਤੂਰੇ ॥",
      "transliteration": "tah anahat su(n)n vajaavahi toore ||",
      "translation": "There, the unstruck sound current of the absolute Lord vibrates and resounds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸਾਚੈ ਰਾਚੇ ਦੇਖਿ ਹਜੂਰੇ ॥",
      "transliteration": "saachai raache dekh hajoore ||",
      "translation": "Behold the True Lord ever-present, and merge with Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0943_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਸਾਚੁ ਰਹਿਆ ਭਰਪੂਰੇ ॥",
      "transliteration": "ghat ghat saach rahiaa bharapoore ||",
      "translation": "The True Lord is pervading and permeating each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 943,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
