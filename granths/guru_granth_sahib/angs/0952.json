{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 952,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0952_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਵਿਣੁ ਗੁਰ ਪੀਰੈ ਕੋ ਥਾਇ ਨ ਪਾਈ ॥",
      "transliteration": "vin gur peerai ko thaai na paaee ||",
      "translation": "Without the Guru or a spiritual teacher, no one is accepted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਾਹੁ ਦਸਾਇ ਓਥੈ ਕੋ ਜਾਇ ॥",
      "transliteration": "raahu dasaai othai ko jaai ||",
      "translation": "They may be shown the way, but only a few go there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਰਣੀ ਬਾਝਹੁ ਭਿਸਤਿ ਨ ਪਾਇ ॥",
      "transliteration": "karanee baajhahu bhisat na paai ||",
      "translation": "Without the karma of good actions, heaven is not attained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੋਗੀ ਕੈ ਘਰਿ ਜੁਗਤਿ ਦਸਾਈ ॥",
      "transliteration": "jogee kai ghar jugat dasaaee ||",
      "translation": "The Way of Yoga is demonstrated in the Yogi's monastery.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਤੁ ਕਾਰਣਿ ਕਨਿ ਮੁੰਦ੍ਰਾ ਪਾਈ ॥",
      "transliteration": "tit kaaran kan mu(n)draa paaee ||",
      "translation": "They wear ear-rings to show the way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੁੰਦ੍ਰਾ ਪਾਇ ਫਿਰੈ ਸੰਸਾਰਿ ॥",
      "transliteration": "mu(n)draa paai phirai sa(n)saar ||",
      "translation": "Wearing ear-rings, they wander around the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਿਥੈ ਕਿਥੈ ਸਿਰਜਣਹਾਰੁ ॥",
      "transliteration": "jithai kithai sirajanahaar ||",
      "translation": "The Creator Lord is everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੇਤੇ ਜੀਅ ਤੇਤੇ ਵਾਟਾਊ ॥",
      "transliteration": "jete jee tete vaataaoo ||",
      "translation": "There are as many travellers as there are beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੀਰੀ ਆਈ ਢਿਲ ਨ ਕਾਊ ॥",
      "transliteration": "cheeree aaee dhil na kaaoo ||",
      "translation": "When one's death warrant is issued, there is no delay.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਏਥੈ ਜਾਣੈ ਸੁ ਜਾਇ ਸਿਞਾਣੈ ॥",
      "transliteration": "ethai jaanai s jaai sinjaanai ||",
      "translation": "One who knows the Lord here, realizes Him there as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹੋਰੁ ਫਕੜੁ ਹਿੰਦੂ ਮੁਸਲਮਾਣੈ ॥",
      "transliteration": "hor phakaR hi(n)doo musalamaanai ||",
      "translation": "Others, whether Hindu or Muslim, are just babbling.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਭਨਾ ਕਾ ਦਰਿ ਲੇਖਾ ਹੋਇ ॥",
      "transliteration": "sabhanaa kaa dar lekhaa hoi ||",
      "translation": "Everyone's account is read in the Court of the Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਰਣੀ ਬਾਝਹੁ ਤਰੈ ਨ ਕੋਇ ॥",
      "transliteration": "karanee baajhahu tarai na koi ||",
      "translation": "without the karma of good actions, no one crosses over.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਚੋ ਸਚੁ ਵਖਾਣੈ ਕੋਇ ॥",
      "transliteration": "sacho sach vakhaanai koi ||",
      "translation": "One who speaks the True Name of the True Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕ ਅਗੈ ਪੁਛ ਨ ਹੋਇ ॥੨॥",
      "transliteration": "naanak agai puchh na hoi ||2||",
      "translation": "O Nanak, is not called to account hereafter. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਉੜੀ ॥",
      "transliteration": "pauRee ||",
      "translation": "Pauree:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰਿ ਕਾ ਮੰਦਰੁ ਆਖੀਐ ਕਾਇਆ ਕੋਟੁ ਗੜੁ ॥",
      "transliteration": "har kaa ma(n)dar aakheeai kaaiaa kot gaR ||",
      "translation": "The fortress of the body is called the Mansion of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅੰਦਰਿ ਲਾਲ ਜਵੇਹਰੀ ਗੁਰਮੁਖਿ ਹਰਿ ਨਾਮੁ ਪੜੁ ॥",
      "transliteration": "a(n)dar laal javeharee guramukh har naam paR ||",
      "translation": "The rubies and gems are found within it; the Gurmukh chants the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਰਿ ਕਾ ਮੰਦਰੁ ਸਰੀਰੁ ਅਤਿ ਸੋਹਣਾ ਹਰਿ ਹਰਿ ਨਾਮੁ ਦਿੜੁ ॥",
      "transliteration": "har kaa ma(n)dar sareer at sohanaa har har naam diR ||",
      "translation": "The body, the Mansion of the Lord, is very beautiful, when the Name of the Lord, Har, Har, is implanted deep within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਨਮੁਖ ਆਪਿ ਖੁਆਇਅਨੁ ਮਾਇਆ ਮੋਹ ਨਿਤ ਕੜੁ ॥",
      "transliteration": "manamukh aap khuaaian maaiaa moh nit kaR ||",
      "translation": "The self-willed manmukhs ruin themselves; they boil continuously in attachment to Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਭਨਾ ਸਾਹਿਬੁ ਏਕੁ ਹੈ ਪੂਰੈ ਭਾਗਿ ਪਾਇਆ ਜਾਈ ॥੧੧॥",
      "transliteration": "sabhanaa saahib ek hai poorai bhaag paaiaa jaaee ||11||",
      "translation": "The One Lord is the Master of all. He is found only by perfect destiny. ||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਲੋਕ ਮਃ ੧ ॥",
      "transliteration": "salok mah 1 ||",
      "translation": "Salok, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾ ਸਤਿ ਦੁਖੀਆ ਨਾ ਸਤਿ ਸੁਖੀਆ ਨਾ ਸਤਿ ਪਾਣੀ ਜੰਤ ਫਿਰਹਿ ॥",
      "transliteration": "naa sat dukheeaa naa sat sukheeaa naa sat paanee ja(n)t phirahi ||",
      "translation": "There is no Truth in suffering, there is no Truth in comfort. There is no Truth in wandering like animals through the water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾ ਸਤਿ ਮੂੰਡ ਮੁਡਾਈ ਕੇਸੀ ਨਾ ਸਤਿ ਪੜਿਆ ਦੇਸ ਫਿਰਹਿ ॥",
      "transliteration": "naa sat moo(n)d mudaaee kesee naa sat paRiaa des phirahi ||",
      "translation": "There is no Truth in shaving one's head; there is no Truth is studying the scriptures or wandering in foreign lands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾ ਸਤਿ ਰੁਖੀ ਬਿਰਖੀ ਪਥਰ ਆਪੁ ਤਛਾਵਹਿ ਦੁਖ ਸਹਹਿ ॥",
      "transliteration": "naa sat rukhee birakhee pathar aap tachhaavahi dukh sahahi ||",
      "translation": "There is no Truth in trees, plants or stones, in mutilating oneself or suffering in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾ ਸਤਿ ਹਸਤੀ ਬਧੇ ਸੰਗਲ ਨਾ ਸਤਿ ਗਾਈ ਘਾਹੁ ਚਰਹਿ ॥",
      "transliteration": "naa sat hasatee badhe sa(n)gal naa sat gaaee ghaahu charahi ||",
      "translation": "There is no Truth in binding elephants in chains; there is no Truth in grazing cows.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਿਸੁ ਹਥਿ ਸਿਧਿ ਦੇਵੈ ਜੇ ਸੋਈ ਜਿਸ ਨੋ ਦੇਇ ਤਿਸੁ ਆਇ ਮਿਲੈ ॥",
      "transliteration": "jis hath sidh devai je soee jis no dei tis aai milai ||",
      "translation": "He alone grants it, whose hands hold spritual perfection; he alone receives it, unto whom it is given.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਤਾ ਕਉ ਮਿਲੈ ਵਡਾਈ ਜਿਸੁ ਘਟ ਭੀਤਰਿ ਸਬਦੁ ਰਵੈ ॥",
      "transliteration": "naanak taa kau milai vadaaee jis ghat bheetar sabad ravai ||",
      "translation": "O Nanak, he alone is blessed with glorious greatness, whose heart is filled with the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਭਿ ਘਟ ਮੇਰੇ ਹਉ ਸਭਨਾ ਅੰਦਰਿ ਜਿਸਹਿ ਖੁਆਈ ਤਿਸੁ ਕਉਣੁ ਕਹੈ ॥",
      "transliteration": "sabh ghat mere hau sabhanaa a(n)dar jisahi khuaaee tis kaun kahai ||",
      "translation": "God says, all hearts are mine, and I am in all hearts. Who can explain this to one who is confused?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਸਹਿ ਦਿਖਾਲਾ ਵਾਟੜੀ ਤਿਸਹਿ ਭੁਲਾਵੈ ਕਉਣੁ ॥",
      "transliteration": "jisahi dikhaalaa vaataRee tisahi bhulaavai kaun ||",
      "translation": "Who can confuse that being, unto whom I have shown the Way?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਸਹਿ ਭੁਲਾਈ ਪੰਧ ਸਿਰਿ ਤਿਸਹਿ ਦਿਖਾਵੈ ਕਉਣੁ ॥੧॥",
      "transliteration": "jisahi bhulaaee pa(n)dh sir tisahi dikhaavai kaun ||1||",
      "translation": "And who can show the Path to that being whom I have confused since the beginning of time? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮਃ ੧ ॥",
      "transliteration": "mah 1 ||",
      "translation": "First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੋ ਗਿਰਹੀ ਜੋ ਨਿਗ੍ਰਹੁ ਕਰੈ ॥",
      "transliteration": "so girahee jo nigrahu karai ||",
      "translation": "He alone is a householder, who restrains his passions",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਪੁ ਤਪੁ ਸੰਜਮੁ ਭੀਖਿਆ ਕਰੈ ॥",
      "transliteration": "jap tap sa(n)jam bheekhiaa karai ||",
      "translation": "and begs for meditation, austerity and self-discipline.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪੁੰਨ ਦਾਨ ਕਾ ਕਰੇ ਸਰੀਰੁ ॥",
      "transliteration": "pu(n)n daan kaa kare sareer ||",
      "translation": "He gives donations to charity with his body;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੋ ਗਿਰਹੀ ਗੰਗਾ ਕਾ ਨੀਰੁ ॥",
      "transliteration": "so girahee ga(n)gaa kaa neer ||",
      "translation": "such a householder is as pure as the water of the Ganges.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬੋਲੈ ਈਸਰੁ ਸਤਿ ਸਰੂਪੁ ॥",
      "transliteration": "bolai eesar sat saroop ||",
      "translation": "Says Eeshar, the Lord is the embodiment of Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪਰਮ ਤੰਤ ਮਹਿ ਰੇਖ ਨ ਰੂਪੁ ॥੨॥",
      "transliteration": "param ta(n)t mahi rekh na roop ||2||",
      "translation": "The supreme essence of reality has no shape or form. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਃ ੧ ॥",
      "transliteration": "mah 1 ||",
      "translation": "First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੋ ਅਉਧੂਤੀ ਜੋ ਧੂਪੈ ਆਪੁ ॥",
      "transliteration": "so audhootee jo dhoopai aap ||",
      "translation": "He alone is a detached hermit, who burns away his self-conceit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭਿਖਿਆ ਭੋਜਨੁ ਕਰੈ ਸੰਤਾਪੁ ॥",
      "transliteration": "bhikhiaa bhojan karai sa(n)taap ||",
      "translation": "He begs for suffering as his food.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਉਹਠ ਪਟਣ ਮਹਿ ਭੀਖਿਆ ਕਰੈ ॥",
      "transliteration": "auhath patan mahi bheekhiaa karai ||",
      "translation": "In the city of the heart, he begs for charity.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੋ ਅਉਧੂਤੀ ਸਿਵ ਪੁਰਿ ਚੜੈ ॥",
      "transliteration": "so audhootee siv pur chaRai ||",
      "translation": "Such a renunciate ascends to the City of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬੋਲੈ ਗੋਰਖੁ ਸਤਿ ਸਰੂਪੁ ॥",
      "transliteration": "bolai gorakh sat saroop ||",
      "translation": "Says Gorakh, God is the embodiment of Truth;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪਰਮ ਤੰਤ ਮਹਿ ਰੇਖ ਨ ਰੂਪੁ ॥੩॥",
      "transliteration": "param ta(n)t mahi rekh na roop ||3||",
      "translation": "the supreme essence of reality has no shape or form. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਃ ੧ ॥",
      "transliteration": "mah 1 ||",
      "translation": "First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੋ ਉਦਾਸੀ ਜਿ ਪਾਲੇ ਉਦਾਸੁ ॥",
      "transliteration": "so udaasee j paale udaas ||",
      "translation": "He alone is an Udasi, a shaven-headed renunciate, who embraces renunciation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਰਧ ਉਰਧ ਕਰੇ ਨਿਰੰਜਨ ਵਾਸੁ ॥",
      "transliteration": "aradh uradh kare nira(n)jan vaas ||",
      "translation": "He sees the Immaculate Lord dwelling in both the upper and lower regions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਚੰਦ ਸੂਰਜ ਕੀ ਪਾਏ ਗੰਢਿ ॥",
      "transliteration": "cha(n)d sooraj kee paae ga(n)dh ||",
      "translation": "He balances the sun and the moon energies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਿਸੁ ਉਦਾਸੀ ਕਾ ਪੜੈ ਨ ਕੰਧੁ ॥",
      "transliteration": "tis udaasee kaa paRai na ka(n)dh ||",
      "translation": "The body-wall of such an Udasi does not collapse.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬੋਲੈ ਗੋਪੀ ਚੰਦੁ ਸਤਿ ਸਰੂਪੁ ॥",
      "transliteration": "bolai gopee cha(n)d sat saroop ||",
      "translation": "Says Gopi Chand, God is the embodiment of Truth;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪਰਮ ਤੰਤ ਮਹਿ ਰੇਖ ਨ ਰੂਪੁ ॥੪॥",
      "transliteration": "param ta(n)t mahi rekh na roop ||4||",
      "translation": "the supreme essence of reality has no shape or form. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਃ ੧ ॥",
      "transliteration": "mah 1 ||",
      "translation": "First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੋ ਪਾਖੰਡੀ ਜਿ ਕਾਇਆ ਪਖਾਲੇ ॥",
      "transliteration": "so paakha(n)dee j kaaiaa pakhaale ||",
      "translation": "He alone is a Paakhandi, who cleanses his body of filth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਾਇਆ ਕੀ ਅਗਨਿ ਬ੍ਰਹਮੁ ਪਰਜਾਲੇ ॥",
      "transliteration": "kaaiaa kee agan braham parajaale ||",
      "translation": "The fire of his body illuminates God within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0952_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸੁਪਨੈ ਬਿੰਦੁ ਨ ਦੇਈ ਝਰਣਾ ॥",
      "transliteration": "supanai bi(n)d na deee jharanaa ||",
      "translation": "He does not waste his energy in wet dreams.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 952,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
