{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 971,
  "lineCount": 48,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0971_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੋਬਿੰਦ ਹਮ ਐਸੇ ਅਪਰਾਧੀ ॥",
      "transliteration": "gobi(n)d ham aise aparaadhee ||",
      "translation": "O Lord of the Universe, I am such a sinner!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਿਨਿ ਪ੍ਰਭਿ ਜੀਉ ਪਿੰਡੁ ਥਾ ਦੀਆ ਤਿਸ ਕੀ ਭਾਉ ਭਗਤਿ ਨਹੀ ਸਾਧੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jin prabh jeeu pi(n)d thaa deeaa tis kee bhaau bhagat nahee saadhee ||1|| rahaau ||",
      "translation": "God gave me body and soul, but I have not practiced loving devotional worship to Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪਰ ਧਨ ਪਰ ਤਨ ਪਰ ਤੀ ਨਿੰਦਾ ਪਰ ਅਪਬਾਦੁ ਨ ਛੂਟੈ ॥",
      "transliteration": "par dhan par tan par tee ni(n)daa par apabaad na chhootai ||",
      "translation": "Others' wealth, others' bodies, others' wives, others' slander and others' fights - I have not given them up.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਵਾ ਗਵਨੁ ਹੋਤੁ ਹੈ ਫੁਨਿ ਫੁਨਿ ਇਹੁ ਪਰਸੰਗੁ ਨ ਤੂਟੈ ॥੨॥",
      "transliteration": "aavaa gavan hot hai phun phun ihu parasa(n)g na tootai ||2||",
      "translation": "For the sake of these, coming and going in reincarnation happens over and over again, and this story never ends. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਹ ਘਰਿ ਕਥਾ ਹੋਤ ਹਰਿ ਸੰਤਨ ਇਕ ਨਿਮਖ ਨ ਕੀਨੑੋ ਮੈ ਫੇਰਾ ॥",
      "transliteration": "jih ghar kathaa hot har sa(n)tan ik nimakh na keenho mai pheraa ||",
      "translation": "That house, in which the Saints speak of the Lord - I have not visited it, even for an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਲੰਪਟ ਚੋਰ ਦੂਤ ਮਤਵਾਰੇ ਤਿਨ ਸੰਗਿ ਸਦਾ ਬਸੇਰਾ ॥੩॥",
      "transliteration": "la(n)pat chor doot matavaare tin sa(n)g sadaa baseraa ||3||",
      "translation": "Drunkards, thieves, and evil-doers - I constantly dwell with them. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਮਾਇਆ ਮਦ ਮਤਸਰ ਏ ਸੰਪੈ ਮੋ ਮਾਹੀ ॥",
      "transliteration": "kaam krodh maaiaa mad matasar e sa(n)pai mo maahee ||",
      "translation": "Sexual desire, anger, the wine of Maya, and envy - these are what I collect within myself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦਇਆ ਧਰਮੁ ਅਰੁ ਗੁਰ ਕੀ ਸੇਵਾ ਏ ਸੁਪਨੰਤਰਿ ਨਾਹੀ ॥੪॥",
      "transliteration": "daiaa dharam ar gur kee sevaa e supana(n)tar naahee ||4||",
      "translation": "Compassion, righteousness, and service to the Guru - these do not visit me, even in my dreams. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੀਨ ਦਇਆਲ ਕ੍ਰਿਪਾਲ ਦਮੋਦਰ ਭਗਤਿ ਬਛਲ ਭੈ ਹਾਰੀ ॥",
      "transliteration": "deen daiaal kripaal damodar bhagat bachhal bhai haaree ||",
      "translation": "He is merciful to the meek, compassionate and benevolent, the Lover of His devotees, the Destroyer of fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਹਤ ਕਬੀਰ ਭੀਰ ਜਨ ਰਾਖਹੁ ਹਰਿ ਸੇਵਾ ਕਰਉ ਤੁਮੑਾਰੀ ॥੫॥੮॥",
      "transliteration": "kahat kabeer bheer jan raakhahu har sevaa karau tumhaaree ||5||8||",
      "translation": "Says Kabeer, please protect Your humble servant from disaster; O Lord, I serve only You. ||5||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਹ ਸਿਮਰਨਿ ਹੋਇ ਮੁਕਤਿ ਦੁਆਰੁ ॥",
      "transliteration": "jih simaran hoi mukat duaar ||",
      "translation": "Remembering Him in meditation, the door of liberation is found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾਹਿ ਬੈਕੁੰਠਿ ਨਹੀ ਸੰਸਾਰਿ ॥",
      "transliteration": "jaahi baiku(n)th nahee sa(n)saar ||",
      "translation": "You shall go to heaven, and not return to this earth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਿਰਭਉ ਕੈ ਘਰਿ ਬਜਾਵਹਿ ਤੂਰ ॥",
      "transliteration": "nirabhau kai ghar bajaavahi toor ||",
      "translation": "In the home of the Fearless Lord, the celestial trumpets resound.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਨਹਦ ਬਜਹਿ ਸਦਾ ਭਰਪੂਰ ॥੧॥",
      "transliteration": "anahad bajahi sadaa bharapoor ||1||",
      "translation": "The unstruck sound current will vibrate and resonate forever. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਐਸਾ ਸਿਮਰਨੁ ਕਰਿ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "aisaa simaran kar man maahi ||",
      "translation": "Practice such meditative remembrance in your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਿਨੁ ਸਿਮਰਨ ਮੁਕਤਿ ਕਤ ਨਾਹਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin simaran mukat kat naahi ||1|| rahaau ||",
      "translation": "Without this meditative remembrance, liberation will never be found. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਹ ਸਿਮਰਨਿ ਨਾਹੀ ਨਨਕਾਰੁ ॥",
      "transliteration": "jih simaran naahee nanakaar ||",
      "translation": "Remembering Him in meditation, you will meet with no obstruction.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮੁਕਤਿ ਕਰੈ ਉਤਰੈ ਬਹੁ ਭਾਰੁ ॥",
      "transliteration": "mukat karai utarai bahu bhaar ||",
      "translation": "You will be liberated, and the great load will be taken away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਮਸਕਾਰੁ ਕਰਿ ਹਿਰਦੈ ਮਾਹਿ ॥",
      "transliteration": "namasakaar kar hiradai maahi ||",
      "translation": "Bow in humility within your heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਫਿਰਿ ਫਿਰਿ ਤੇਰਾ ਆਵਨੁ ਨਾਹਿ ॥੨॥",
      "transliteration": "phir phir teraa aavan naahi ||2||",
      "translation": "and you will not have to be reincarnated over and over again. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਹ ਸਿਮਰਨਿ ਕਰਹਿ ਤੂ ਕੇਲ ॥",
      "transliteration": "jih simaran karahi too kel ||",
      "translation": "Remember Him in meditation, celebrate and be happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੀਪਕੁ ਬਾਂਧਿ ਧਰਿਓ ਬਿਨੁ ਤੇਲ ॥",
      "transliteration": "deepak baa(n)dh dhario bin tel ||",
      "translation": "God has placed His lamp deep within you, which burns without any oil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋ ਦੀਪਕੁ ਅਮਰਕੁ ਸੰਸਾਰਿ ॥",
      "transliteration": "so deepak amarak sa(n)saar ||",
      "translation": "That lamp makes the world immortal;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਬਿਖੁ ਕਾਢੀਲੇ ਮਾਰਿ ॥੩॥",
      "transliteration": "kaam krodh bikh kaadheele maar ||3||",
      "translation": "it conquers and drives out the poisons of sexual desire and anger. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਿਹ ਸਿਮਰਨਿ ਤੇਰੀ ਗਤਿ ਹੋਇ ॥",
      "transliteration": "jih simaran teree gat hoi ||",
      "translation": "Remembering Him in meditation, you shall obtain salvation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੋ ਸਿਮਰਨੁ ਰਖੁ ਕੰਠਿ ਪਰੋਇ ॥",
      "transliteration": "so simaran rakh ka(n)th paroi ||",
      "translation": "Wear that meditative remembrance as your necklace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੋ ਸਿਮਰਨੁ ਕਰਿ ਨਹੀ ਰਾਖੁ ਉਤਾਰਿ ॥",
      "transliteration": "so simaran kar nahee raakh utaar ||",
      "translation": "Practice that meditative remembrance, and never let it go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਉਤਰਹਿ ਪਾਰਿ ॥੪॥",
      "transliteration": "gur parasaadee utarahi paar ||4||",
      "translation": "By Guru's Grace, you shall cross over. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਹ ਸਿਮਰਨਿ ਨਾਹੀ ਤੁਹਿ ਕਾਨਿ ॥",
      "transliteration": "jih simaran naahee tuhi kaan ||",
      "translation": "Remembering Him in meditation, you shall not be obligated to others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮੰਦਰਿ ਸੋਵਹਿ ਪਟੰਬਰ ਤਾਨਿ ॥",
      "transliteration": "ma(n)dar sovahi pata(n)bar taan ||",
      "translation": "You shall sleep in your mansion, in blankets of silk.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੇਜ ਸੁਖਾਲੀ ਬਿਗਸੈ ਜੀਉ ॥",
      "transliteration": "sej sukhaalee bigasai jeeu ||",
      "translation": "Your soul shall blossom forth in happiness, on this comfortable bed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੋ ਸਿਮਰਨੁ ਤੂ ਅਨਦਿਨੁ ਪੀਉ ॥੫॥",
      "transliteration": "so simaran too anadin peeu ||5||",
      "translation": "So drink in this meditative remembrance, night and day. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਹ ਸਿਮਰਨਿ ਤੇਰੀ ਜਾਇ ਬਲਾਇ ॥",
      "transliteration": "jih simaran teree jaai balaai ||",
      "translation": "Remembering Him in meditation, your troubles will depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਿਹ ਸਿਮਰਨਿ ਤੁਝੁ ਪੋਹੈ ਨ ਮਾਇ ॥",
      "transliteration": "jih simaran tujh pohai na maai ||",
      "translation": "Remembering Him in meditation, Maya will not bother you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਹਰਿ ਹਰਿ ਮਨਿ ਗਾਈਐ ॥",
      "transliteration": "simar simar har har man gaaeeai ||",
      "translation": "Meditate, meditate in remembrance on the Lord, Har, Har, and sing His Praises in your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਹੁ ਸਿਮਰਨੁ ਸਤਿਗੁਰ ਤੇ ਪਾਈਐ ॥੬॥",
      "transliteration": "ihu simaran satigur te paaeeai ||6||",
      "translation": "This meditative remembrance is obtained from the True Guru. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਸਿਮਰਿ ਦਿਨੁ ਰਾਤਿ ॥",
      "transliteration": "sadaa sadaa simar din raat ||",
      "translation": "Forever and ever, remember Him, day and night,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਊਠਤ ਬੈਠਤ ਸਾਸਿ ਗਿਰਾਸਿ ॥",
      "transliteration": "oothat baithat saas giraas ||",
      "translation": "while standing up and sitting down, with every breath and morsel of food.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾਗੁ ਸੋਇ ਸਿਮਰਨ ਰਸ ਭੋਗ ॥",
      "transliteration": "jaag soi simaran ras bhog ||",
      "translation": "While awake and asleep, enjoy the essence of this meditative remembrance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨੁ ਪਾਈਐ ਸੰਜੋਗ ॥੭॥",
      "transliteration": "har simaran paaeeai sa(n)jog ||7||",
      "translation": "The Lord's meditative remembrance is obtained by good destiny. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਿਹ ਸਿਮਰਨਿ ਨਾਹੀ ਤੁਝੁ ਭਾਰ ॥",
      "transliteration": "jih simaran naahee tujh bhaar ||",
      "translation": "Remembering Him in meditation, you shall not be loaded down.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੋ ਸਿਮਰਨੁ ਰਾਮ ਨਾਮ ਅਧਾਰੁ ॥",
      "transliteration": "so simaran raam naam adhaar ||",
      "translation": "Make this meditative remembrance of the Lord's Name your Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਜਾ ਕਾ ਨਹੀ ਅੰਤੁ ॥",
      "transliteration": "kahi kabeer jaa kaa nahee a(n)t ||",
      "translation": "Says Kabeer, He has no limits;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਸ ਕੇ ਆਗੇ ਤੰਤੁ ਨ ਮੰਤੁ ॥੮॥੯॥",
      "transliteration": "tis ke aage ta(n)t na ma(n)t ||8||9||",
      "translation": "no tantras or mantras can be used against Him. ||8||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਾਮਕਲੀ ਘਰੁ ੨ ਬਾਣੀ ਕਬੀਰ ਜੀ ਕੀ ॥",
      "transliteration": "raamakalee ghar 2 baanee kabeer jee kee ||",
      "translation": "Raamkalee, Second House, The Word Of Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬੰਧਚਿ ਬੰਧਨੁ ਪਾਇਆ ॥",
      "transliteration": "ba(n)dhach ba(n)dhan paaiaa ||",
      "translation": "Maya, the Trapper, has sprung her trap.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0971_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੁਕਤੈ ਗੁਰਿ ਅਨਲੁ ਬੁਝਾਇਆ ॥",
      "transliteration": "mukatai gur anal bujhaaiaa ||",
      "translation": "The Guru, the Liberated One, has put out the fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 971,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
