{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 974,
  "lineCount": 47,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0974_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੇਵ ਸੰਸੈ ਗਾਂਠਿ ਨ ਛੂਟੈ ॥",
      "transliteration": "dev sa(n)sai gaa(n)th na chhootai ||",
      "translation": "O Divine Lord, the knot of skepticism cannot be untied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਮਾਇਆ ਮਦ ਮਤਸਰ ਇਨ ਪੰਚਹੁ ਮਿਲਿ ਲੂਟੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kaam krodh maaiaa mad matasar in pa(n)chahu mil loote ||1|| rahaau ||",
      "translation": "Sexual desire, anger, Maya, intoxication and jealousy - these five have combined to plunder the world. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਮ ਬਡ ਕਬਿ ਕੁਲੀਨ ਹਮ ਪੰਡਿਤ ਹਮ ਜੋਗੀ ਸੰਨਿਆਸੀ ॥",
      "transliteration": "ham bad kab kuleen ham pa(n)dit ham jogee sa(n)niaasee ||",
      "translation": "I am a great poet, of noble heritage; I am a Pandit, a religious scholar, a Yogi and a Sannyaasi;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗਿਆਨੀ ਗੁਨੀ ਸੂਰ ਹਮ ਦਾਤੇ ਇਹ ਬੁਧਿ ਕਬਹਿ ਨ ਨਾਸੀ ॥੨॥",
      "transliteration": "giaanee gunee soor ham daate ih budh kabahi na naasee ||2||",
      "translation": "I am a spiritual teacher, a warrior and a giver - such thinking never ends. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਹੁ ਰਵਿਦਾਸ ਸਭੈ ਨਹੀ ਸਮਝਸਿ ਭੂਲਿ ਪਰੇ ਜੈਸੇ ਬਉਰੇ ॥",
      "transliteration": "kahu ravidaas sabhai nahee samajhas bhool pare jaise baure ||",
      "translation": "Says Ravi Daas, no one understands; they all run around, deluded like madmen.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੋਹਿ ਅਧਾਰੁ ਨਾਮੁ ਨਾਰਾਇਨ ਜੀਵਨ ਪ੍ਰਾਨ ਧਨ ਮੋਰੇ ॥੩॥੧॥",
      "transliteration": "mohi adhaar naam naaraain jeevan praan dhan more ||3||1||",
      "translation": "The Lord's Name is my only Support; He is my life, my breath of life, my wealth. ||3||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਾਮਕਲੀ ਬਾਣੀ ਬੇਣੀ ਜੀਉ ਕੀ ॥",
      "transliteration": "raamakalee baanee benee jeeu kee ||",
      "translation": "Raamkalee, The Word Of Baynee Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਇੜਾ ਪਿੰਗੁਲਾ ਅਉਰ ਸੁਖਮਨਾ ਤੀਨਿ ਬਸਹਿ ਇਕ ਠਾਈ ॥",
      "transliteration": "iRaa pi(n)gulaa aur sukhamanaa teen basahi ik thaaee ||",
      "translation": "The energy channels of the Ida, Pingala and Shushmanaa: these three dwell in one place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬੇਣੀ ਸੰਗਮੁ ਤਹ ਪਿਰਾਗੁ ਮਨੁ ਮਜਨੁ ਕਰੇ ਤਿਥਾਈ ॥੧॥",
      "transliteration": "benee sa(n)gam tah piraag man majan kare tithaaee ||1||",
      "translation": "This is the true place of confluence of the three sacred rivers: this is where my mind takes its cleansing bath. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੰਤਹੁ ਤਹਾ ਨਿਰੰਜਨ ਰਾਮੁ ਹੈ ॥",
      "transliteration": "sa(n)tahu tahaa nira(n)jan raam hai ||",
      "translation": "O Saints, the Immaculate Lord dwells there;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰ ਗਮਿ ਚੀਨੈ ਬਿਰਲਾ ਕੋਇ ॥",
      "transliteration": "gur gam cheenai biralaa koi ||",
      "translation": "how rare are those who go to the Guru, and understand this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਹਾਂ ਨਿਰੰਜਨੁ ਰਮਈਆ ਹੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tahaa(n) nira(n)jan ramaeeaa hoi ||1|| rahaau ||",
      "translation": "The all-pervading immaculate Lord is there. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੇਵ ਸਥਾਨੈ ਕਿਆ ਨੀਸਾਣੀ ॥",
      "transliteration": "dev sathaanai kiaa neesaanee ||",
      "translation": "What is the insignia of the Divine Lord's dwelling?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਹ ਬਾਜੇ ਸਬਦ ਅਨਾਹਦ ਬਾਣੀ ॥",
      "transliteration": "tah baaje sabad anaahad baanee ||",
      "translation": "The unstruck sound current of the Shabad vibrates there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਹ ਚੰਦੁ ਨ ਸੂਰਜੁ ਪਉਣੁ ਨ ਪਾਣੀ ॥",
      "transliteration": "tah cha(n)d na sooraj paun na paanee ||",
      "translation": "There is no moon or sun, no air or water there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਾਖੀ ਜਾਗੀ ਗੁਰਮੁਖਿ ਜਾਣੀ ॥੨॥",
      "transliteration": "saakhee jaagee guramukh jaanee ||2||",
      "translation": "The Gurmukh becomes aware, and knows the Teachings. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਉਪਜੈ ਗਿਆਨੁ ਦੁਰਮਤਿ ਛੀਜੈ ॥",
      "transliteration": "upajai giaan duramat chheejai ||",
      "translation": "Spiritual wisdom wells up, and evil-mindedness departs;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਰਸਿ ਗਗਨੰਤਰਿ ਭੀਜੈ ॥",
      "transliteration": "a(n)mrit ras gagana(n)tar bheejai ||",
      "translation": "the nucleus of the mind sky is drenched with Ambrosial Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਏਸੁ ਕਲਾ ਜੋ ਜਾਣੈ ਭੇਉ ॥",
      "transliteration": "es kalaa jo jaanai bheu ||",
      "translation": "One who knows the secret of this device,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੇਟੈ ਤਾਸੁ ਪਰਮ ਗੁਰਦੇਉ ॥੩॥",
      "transliteration": "bhetai taas param guradeu ||3||",
      "translation": "meets the Supreme Divine Guru. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦਸਮ ਦੁਆਰਾ ਅਗਮ ਅਪਾਰਾ ਪਰਮ ਪੁਰਖ ਕੀ ਘਾਟੀ ॥",
      "transliteration": "dasam duaaraa agam apaaraa param purakh kee ghaatee ||",
      "translation": "The Tenth Gate is the home of the inaccessible, infinite Supreme Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਊਪਰਿ ਹਾਟੁ ਹਾਟ ਪਰਿ ਆਲਾ ਆਲੇ ਭੀਤਰਿ ਥਾਤੀ ॥੪॥",
      "transliteration": "oopar haat haat par aalaa aale bheetar thaatee ||4||",
      "translation": "Above the store is a niche, and within this niche is the commodity. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਾਗਤੁ ਰਹੈ ਸੁ ਕਬਹੁ ਨ ਸੋਵੈ ॥",
      "transliteration": "jaagat rahai s kabahu na sovai ||",
      "translation": "One who remains awake, never sleeps.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤੀਨਿ ਤਿਲੋਕ ਸਮਾਧਿ ਪਲੋਵੈ ॥",
      "transliteration": "teen tilok samaadh palovai ||",
      "translation": "The three qualities and the three worlds vanish, in the state of Samaadhi.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬੀਜ ਮੰਤ੍ਰੁ ਲੈ ਹਿਰਦੈ ਰਹੈ ॥",
      "transliteration": "beej ma(n)tr lai hiradai rahai ||",
      "translation": "He takes the Beej Mantra, the Seed Mantra, and keeps it in his heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਨੂਆ ਉਲਟਿ ਸੁੰਨ ਮਹਿ ਗਹੈ ॥੫॥",
      "transliteration": "manooaa ulat su(n)n mahi gahai ||5||",
      "translation": "Turning his mind away from the world, he focuses on the cosmic void of the absolute Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜਾਗਤੁ ਰਹੈ ਨ ਅਲੀਆ ਭਾਖੈ ॥",
      "transliteration": "jaagat rahai na aleeaa bhaakhai ||",
      "translation": "He remains awake, and he does not lie.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪਾਚਉ ਇੰਦ੍ਰੀ ਬਸਿ ਕਰਿ ਰਾਖੈ ॥",
      "transliteration": "paachau i(n)dree bas kar raakhai ||",
      "translation": "He keeps the five sensory organs under his control.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗੁਰ ਕੀ ਸਾਖੀ ਰਾਖੈ ਚੀਤਿ ॥",
      "transliteration": "gur kee saakhee raakhai cheet ||",
      "translation": "He cherishes in his consciousness the Guru's Teachings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਅਰਪੈ ਕ੍ਰਿਸਨ ਪਰੀਤਿ ॥੬॥",
      "transliteration": "man tan arapai krisan pareet ||6||",
      "translation": "He dedicates his mind and body to the Lord's Love. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਰ ਪਲਵ ਸਾਖਾ ਬੀਚਾਰੇ ॥",
      "transliteration": "kar palav saakhaa beechaare ||",
      "translation": "He considers his hands to be the leaves and branches of the tree.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਪਨਾ ਜਨਮੁ ਨ ਜੂਐ ਹਾਰੇ ॥",
      "transliteration": "apanaa janam na jooai haare ||",
      "translation": "He does not lose his life in the gamble.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅਸੁਰ ਨਦੀ ਕਾ ਬੰਧੈ ਮੂਲੁ ॥",
      "transliteration": "asur nadee kaa ba(n)dhai mool ||",
      "translation": "He plugs up the source of the river of evil tendencies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪਛਿਮ ਫੇਰਿ ਚੜਾਵੈ ਸੂਰੁ ॥",
      "transliteration": "pachhim pher chaRaavai soor ||",
      "translation": "Turning away from the west, he makes the sun rise in the east.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਜਰੁ ਜਰੈ ਸੁ ਨਿਝਰੁ ਝਰੈ ॥",
      "transliteration": "ajar jarai s nijhar jharai ||",
      "translation": "He bears the unbearable, and the drops trickle down within;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਗੰਨਾਥ ਸਿਉ ਗੋਸਟਿ ਕਰੈ ॥੭॥",
      "transliteration": "jaga(n)naath siu gosat karai ||7||",
      "translation": "then, he speaks with the Lord of the world. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚਉਮੁਖ ਦੀਵਾ ਜੋਤਿ ਦੁਆਰ ॥",
      "transliteration": "chaumukh deevaa jot duaar ||",
      "translation": "The four-sided lamp illuminates the Tenth Gate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਲੂ ਅਨਤ ਮੂਲੁ ਬਿਚਕਾਰਿ ॥",
      "transliteration": "paloo anat mool bichakaar ||",
      "translation": "The Primal Lord is at the center of the countless leaves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਰਬ ਕਲਾ ਲੇ ਆਪੇ ਰਹੈ ॥",
      "transliteration": "sarab kalaa le aape rahai ||",
      "translation": "He Himself abides there with all His powers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਨੁ ਮਾਣਕੁ ਰਤਨਾ ਮਹਿ ਗੁਹੈ ॥੮॥",
      "transliteration": "man maanak ratanaa mahi guhai ||8||",
      "translation": "He weaves the jewels into the pearl of the mind. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਸਤਕਿ ਪਦਮੁ ਦੁਆਲੈ ਮਣੀ ॥",
      "transliteration": "masatak padam duaalai manee ||",
      "translation": "The lotus is at the forehead, and the jewels surround it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਾਹਿ ਨਿਰੰਜਨੁ ਤ੍ਰਿਭਵਣ ਧਣੀ ॥",
      "transliteration": "maahi nira(n)jan tribhavan dhanee ||",
      "translation": "Within it is the Immaculate Lord, the Master of the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪੰਚ ਸਬਦ ਨਿਰਮਾਇਲ ਬਾਜੇ ॥",
      "transliteration": "pa(n)ch sabad niramaail baaje ||",
      "translation": "The Panch Shabad, the five primal sounds, resound and vibrate their in their purity.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਢੁਲਕੇ ਚਵਰ ਸੰਖ ਘਨ ਗਾਜੇ ॥",
      "transliteration": "dhulake chavar sa(n)kh ghan gaaje ||",
      "translation": "The chauris - the fly brushes wave, and the conch shells blare like thunder.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦਲਿ ਮਲਿ ਦੈਤਹੁ ਗੁਰਮੁਖਿ ਗਿਆਨੁ ॥",
      "transliteration": "dal mal daitahu guramukh giaan ||",
      "translation": "The Gurmukh tramples the demons underfoot with his spiritual wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0974_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬੇਣੀ ਜਾਚੈ ਤੇਰਾ ਨਾਮੁ ॥੯॥੧॥",
      "transliteration": "benee jaachai teraa naam ||9||1||",
      "translation": "Baynee longs for Your Name, Lord. ||9||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 974,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
