{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 987,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_0987_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬੂਝਤ ਦੀਪਕ ਮਿਲਤ ਤਿਲਤ ॥",
      "transliteration": "boojhat deepak milat tilat ||",
      "translation": "It is like oil to the lamp whose flame is dying out.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਲਤ ਅਗਨੀ ਮਿਲਤ ਨੀਰ ॥",
      "transliteration": "jalat aganee milat neer ||",
      "translation": "It is like water poured on the burning fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੈਸੇ ਬਾਰਿਕ ਮੁਖਹਿ ਖੀਰ ॥੧॥",
      "transliteration": "jaise baarik mukhahi kheer ||1||",
      "translation": "It is like milk poured into the baby's mouth. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੈਸੇ ਰਣ ਮਹਿ ਸਖਾ ਭ੍ਰਾਤ ॥",
      "transliteration": "jaise ran mahi sakhaa bhraat ||",
      "translation": "As one's brother becomes a helper on the field of battle;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੈਸੇ ਭੂਖੇ ਭੋਜਨ ਮਾਤ ॥",
      "transliteration": "jaise bhookhe bhojan maat ||",
      "translation": "as one's hunger is satisfied by food;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜੈਸੇ ਕਿਰਖਹਿ ਬਰਸ ਮੇਘ ॥",
      "transliteration": "jaise kirakhahi baras megh ||",
      "translation": "as the cloudburst saves the crops;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੈਸੇ ਪਾਲਨ ਸਰਨਿ ਸੇਂਘ ॥੨॥",
      "transliteration": "jaise paalan saran se(n)gh ||2||",
      "translation": "as one is protected in the tiger's lair;||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗਰੁੜ ਮੁਖਿ ਨਹੀ ਸਰਪ ਤ੍ਰਾਸ ॥",
      "transliteration": "garuR mukh nahee sarap traas ||",
      "translation": "As with the magic spell of Garuda the eagle upon one's lips, one does not fear the snake;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੂਆ ਪਿੰਜਰਿ ਨਹੀ ਖਾਇ ਬਿਲਾਸੁ ॥",
      "transliteration": "sooaa pi(n)jar nahee khaai bilaas ||",
      "translation": "as the cat cannot eat the parrot in its cage;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੈਸੋ ਆਂਡੋ ਹਿਰਦੇ ਮਾਹਿ ॥",
      "transliteration": "jaiso aa(n)do hirade maahi ||",
      "translation": "as the bird cherishes her eggs in her heart;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੈਸੋ ਦਾਨੋ ਚਕੀ ਦਰਾਹਿ ॥੩॥",
      "transliteration": "jaiso daano chakee daraahi ||3||",
      "translation": "as the grains are spared, by sticking to the central post of the mill;||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਹੁਤੁ ਓਪਮਾ ਥੋਰ ਕਹੀ ॥",
      "transliteration": "bahut opamaa thor kahee ||",
      "translation": "Your Glory is so great; I can describe only a tiny bit of it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਰਿ ਅਗਮ ਅਗਮ ਅਗਾਧਿ ਤੁਹੀ ॥",
      "transliteration": "har agam agam agaadh tuhee ||",
      "translation": "O Lord, You are inaccessible, unapproachable and unfathomable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਊਚ ਮੂਚੌ ਬਹੁ ਅਪਾਰ ॥",
      "transliteration": "ooch moochau bahu apaar ||",
      "translation": "You are lofty and high, utterly great and infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਿਮਰਤ ਨਾਨਕ ਤਰੇ ਸਾਰ ॥੪॥੩॥",
      "transliteration": "simarat naanak tare saar ||4||3||",
      "translation": "Meditating in remembrance on the Lord, O Nanak, one is carried across. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਾਲੀ ਗਉੜਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "maalee gauRaa mahalaa 5 ||",
      "translation": "Maalee Gauraa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਹੀ ਹਮਾਰੈ ਸਫਲ ਕਾਜ ॥",
      "transliteration": "ihee hamaarai saphal kaaj ||",
      "translation": "Please let my works be rewarding and fruitful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਪੁਨੇ ਦਾਸ ਕਉ ਲੇਹੁ ਨਿਵਾਜਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "apune daas kau lehu nivaaj ||1|| rahaau ||",
      "translation": "Please cherish and exalt Your slave. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚਰਨ ਸੰਤਹ ਮਾਥ ਮੋਰ ॥",
      "transliteration": "charan sa(n)tah maath mor ||",
      "translation": "I lay my forehead on the feet of the Saints,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨੈਨਿ ਦਰਸੁ ਪੇਖਉ ਨਿਸਿ ਭੋਰ ॥",
      "transliteration": "nain daras pekhau nis bhor ||",
      "translation": "and with my eyes, I gaze upon the Blessed Vision of their Darshan, day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਸਤ ਹਮਰੇ ਸੰਤ ਟਹਲ ॥",
      "transliteration": "hasat hamare sa(n)t tahal ||",
      "translation": "With my hands, I work for the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਾਨ ਮਨੁ ਧਨੁ ਸੰਤ ਬਹਲ ॥੧॥",
      "transliteration": "praan man dhan sa(n)t bahal ||1||",
      "translation": "I dedicate my breath of life, my mind and wealth to the Saints. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੰਤਸੰਗਿ ਮੇਰੇ ਮਨ ਕੀ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "sa(n)tasa(n)g mere man kee preet ||",
      "translation": "My mind loves the Society of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੰਤ ਗੁਨ ਬਸਹਿ ਮੇਰੈ ਚੀਤਿ ॥",
      "transliteration": "sa(n)t gun basahi merai cheet ||",
      "translation": "The Virtues of the Saints abide within my consciousness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੰਤ ਆਗਿਆ ਮਨਹਿ ਮੀਠ ॥",
      "transliteration": "sa(n)t aagiaa manahi meeth ||",
      "translation": "The Will of the Saints is sweet to my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੇਰਾ ਕਮਲੁ ਬਿਗਸੈ ਸੰਤ ਡੀਠ ॥੨॥",
      "transliteration": "meraa kamal bigasai sa(n)t deeth ||2||",
      "translation": "Seeing the Saints, my heart-lotus blossoms forth. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੰਤਸੰਗਿ ਮੇਰਾ ਹੋਇ ਨਿਵਾਸੁ ॥",
      "transliteration": "sa(n)tasa(n)g meraa hoi nivaas ||",
      "translation": "I dwell in the Society of the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੰਤਨ ਕੀ ਮੋਹਿ ਬਹੁਤੁ ਪਿਆਸ ॥",
      "transliteration": "sa(n)tan kee mohi bahut piaas ||",
      "translation": "I have such a great thirst for the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੰਤ ਬਚਨ ਮੇਰੇ ਮਨਹਿ ਮੰਤ ॥",
      "transliteration": "sa(n)t bachan mere manahi ma(n)t ||",
      "translation": "The Words of the Saints are the Mantras of my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਮੇਰੇ ਬਿਖੈ ਹੰਤ ॥੩॥",
      "transliteration": "sa(n)t prasaad mere bikhai ha(n)t ||3||",
      "translation": "By the Grace of the Saints, my corruption is taken away. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੁਕਤਿ ਜੁਗਤਿ ਏਹਾ ਨਿਧਾਨ ॥",
      "transliteration": "mukat jugat ehaa nidhaan ||",
      "translation": "This way of liberation is my treasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪ੍ਰਭ ਦਇਆਲ ਮੋਹਿ ਦੇਵਹੁ ਦਾਨ ॥",
      "transliteration": "prabh daiaal mohi devahu daan ||",
      "translation": "O Merciful God, please bless me with this gift.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਪ੍ਰਭ ਦਇਆ ਧਾਰਿ ॥",
      "transliteration": "naanak kau prabh daiaa dhaar ||",
      "translation": "O God, shower Your Mercy upon Nanak.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਚਰਨ ਸੰਤਨ ਕੇ ਮੇਰੇ ਰਿਦੇ ਮਝਾਰਿ ॥੪॥੪॥",
      "transliteration": "charan sa(n)tan ke mere ride majhaar ||4||4||",
      "translation": "I have enshrined the feet of the Saints within my heart. ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਾਲੀ ਗਉੜਾ ਮਹਲਾ ੫ ॥",
      "transliteration": "maalee gauRaa mahalaa 5 ||",
      "translation": "Maalee Gauraa, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਭ ਕੈ ਸੰਗੀ ਨਾਹੀ ਦੂਰਿ ॥",
      "transliteration": "sabh kai sa(n)gee naahee door ||",
      "translation": "He is with all; He is not far away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨ ਹਾਜਰਾ ਹਜੂਰਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "karan karaavan haajaraa hajoor ||1|| rahaau ||",
      "translation": "He is the Cause of causes, ever-present here and now. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੁਨਤ ਜੀਓ ਜਾਸੁ ਨਾਮੁ ॥",
      "transliteration": "sunat jeeo jaas naam ||",
      "translation": "Hearing His Name, one comes to life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੁਖ ਬਿਨਸੇ ਸੁਖ ਕੀਓ ਬਿਸ੍ਰਾਮੁ ॥",
      "transliteration": "dukh binase sukh keeo bisraam ||",
      "translation": "Pain is dispelled; peace and tranquility come to dwell within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਗਲ ਨਿਧਿ ਹਰਿ ਹਰਿ ਹਰੇ ॥",
      "transliteration": "sagal nidh har har hare ||",
      "translation": "The Lord, Har, Har, is all treasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮੁਨਿ ਜਨ ਤਾ ਕੀ ਸੇਵ ਕਰੇ ॥੧॥",
      "transliteration": "mun jan taa kee sev kare ||1||",
      "translation": "The silent sages serve Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਾ ਕੈ ਘਰਿ ਸਗਲੇ ਸਮਾਹਿ ॥",
      "transliteration": "jaa kai ghar sagale samaahi ||",
      "translation": "Everything is contained in His home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਿਸ ਤੇ ਬਿਰਥਾ ਕੋਇ ਨਾਹਿ ॥",
      "transliteration": "jis te birathaa koi naahi ||",
      "translation": "No one is turned away empty-handed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੀਅ ਜੰਤ੍ਰ ਕਰੇ ਪ੍ਰਤਿਪਾਲ ॥",
      "transliteration": "jee ja(n)tr kare pratipaal ||",
      "translation": "He cherishes all beings and creatures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਸੇਵਹੁ ਕਿਰਪਾਲ ॥੨॥",
      "transliteration": "sadaa sadaa sevahu kirapaal ||2||",
      "translation": "Forever and ever, serve the Merciful Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਦਾ ਧਰਮੁ ਜਾ ਕੈ ਦੀਬਾਣਿ ॥",
      "transliteration": "sadaa dharam jaa kai deebaan ||",
      "translation": "Righteous justice is dispensed in His Court forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬੇਮੁਹਤਾਜ ਨਹੀ ਕਿਛੁ ਕਾਣਿ ॥",
      "transliteration": "bemuhataaj nahee kichh kaan ||",
      "translation": "He is carefree, and owes allegiance to no one.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਭ ਕਿਛੁ ਕਰਨਾ ਆਪਨ ਆਪਿ ॥",
      "transliteration": "sabh kichh karanaa aapan aap ||",
      "translation": "He Himself, by Himself, does everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਰੇ ਮਨ ਮੇਰੇ ਤੂ ਤਾ ਕਉ ਜਾਪਿ ॥੩॥",
      "transliteration": "re man mere too taa kau jaap ||3||",
      "translation": "O my mind, meditate on Him. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਕਉ ਹਉ ਬਲਿਹਾਰ ॥",
      "transliteration": "saadhasa(n)gat kau hau balihaar ||",
      "translation": "I am a sacrifice to the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਾਸੁ ਮਿਲਿ ਹੋਵੈ ਉਧਾਰੁ ॥",
      "transliteration": "jaas mil hovai udhaar ||",
      "translation": "Joining them, I am saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾਮ ਸੰਗਿ ਮਨ ਤਨਹਿ ਰਾਤ ॥",
      "transliteration": "naam sa(n)g man tanahi raat ||",
      "translation": "My mind and body are attuned to the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਪ੍ਰਭਿ ਕਰੀ ਦਾਤਿ ॥੪॥੫॥",
      "transliteration": "naanak kau prabh karee daat ||4||5||",
      "translation": "God has blessed Nanak with this gift. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮਾਲੀ ਗਉੜਾ ਮਹਲਾ ੫ ਦੁਪਦੇ ॥",
      "transliteration": "maalee gauRaa mahalaa 5 dupade ||",
      "translation": "Maalee Gauraa, Fifth Mehl, Dho-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਹਰਿ ਸਮਰਥ ਕੀ ਸਰਨਾ ॥",
      "transliteration": "har samarath kee saranaa ||",
      "translation": "I seek the Sanctuary of the all-powerful Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਧਨੁ ਰਾਸਿ ਮੇਰੀ ਪ੍ਰਭ ਏਕ ਕਾਰਨ ਕਰਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jeeu pi(n)d dhan raas meree prabh ek kaaran karanaa ||1|| rahaau ||",
      "translation": "My soul, body, wealth and capital belong to the One God, the Cause of causes. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸਿਮਰਿ ਸਿਮਰਿ ਸਦਾ ਸੁਖੁ ਪਾਈਐ ਜੀਵਣੈ ਕਾ ਮੂਲੁ ॥",
      "transliteration": "simar simar sadaa sukh paaeeai jeevanai kaa mool ||",
      "translation": "Meditating, meditating in remembrance on Him, I have found everlasting peace. He is the source of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_0987_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਰਵਿ ਰਹਿਆ ਸਰਬਤ ਠਾਈ ਸੂਖਮੋ ਅਸਥੂਲ ॥੧॥",
      "transliteration": "rav rahiaa sarabat thaaee sookhamo asathool ||1||",
      "translation": "He is all-pervading, permeating all places; He is in subtle essence and manifest form. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 987,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
