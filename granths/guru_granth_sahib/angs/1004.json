{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1004,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1004_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਾਝੁ ਗੁਰੂ ਗੁਬਾਰਾ ॥",
      "transliteration": "baajh guroo gubaaraa ||",
      "translation": "Without the Guru, there is only pitch darkness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਿਲਿ ਸਤਿਗੁਰ ਨਿਸਤਾਰਾ ॥੨॥",
      "transliteration": "mil satigur nisataaraa ||2||",
      "translation": "Meeting with the True Guru, one is emancipated. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਉ ਹਉ ਕਰਮ ਕਮਾਣੇ ॥",
      "transliteration": "hau hau karam kamaane ||",
      "translation": "All the deeds done in egotism,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤੇ ਤੇ ਬੰਧ ਗਲਾਣੇ ॥",
      "transliteration": "te te ba(n)dh galaane ||",
      "translation": "are just chains around the neck.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮੇਰੀ ਮੇਰੀ ਧਾਰੀ ॥",
      "transliteration": "meree meree dhaaree ||",
      "translation": "Harboring self-conceit and self-interest",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਓਹਾ ਪੈਰਿ ਲੋਹਾਰੀ ॥",
      "transliteration": "ohaa pair lohaaree ||",
      "translation": "is just like placing chains around one's ankles.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੋ ਗੁਰ ਮਿਲਿ ਏਕੁ ਪਛਾਣੈ ॥",
      "transliteration": "so gur mil ek pachhaanai ||",
      "translation": "He alone meets with the Guru, and realizes the One Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਸੁ ਹੋਵੈ ਭਾਗੁ ਮਥਾਣੈ ॥੩॥",
      "transliteration": "jis hovai bhaag mathaanai ||3||",
      "translation": "who has such destiny written on his forehead. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੋ ਮਿਲਿਆ ਜਿ ਹਰਿ ਮਨਿ ਭਾਇਆ ॥",
      "transliteration": "so miliaa j har man bhaaiaa ||",
      "translation": "He alone meets the Lord, who is pleasing to His Mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੋ ਭੂਲਾ ਜਿ ਪ੍ਰਭੂ ਭੁਲਾਇਆ ॥",
      "transliteration": "so bhoolaa j prabhoo bhulaaiaa ||",
      "translation": "He alone is deluded, who is deluded by God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਹ ਆਪਹੁ ਮੂਰਖੁ ਗਿਆਨੀ ॥",
      "transliteration": "nah aapahu moorakh giaanee ||",
      "translation": "No one, by himself, is ignorant or wise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਿ ਕਰਾਵੈ ਸੁ ਨਾਮੁ ਵਖਾਨੀ ॥",
      "transliteration": "j karaavai s naam vakhaanee ||",
      "translation": "He alone chants the Naam, whom the Lord inspires to do so.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੇਰਾ ਅੰਤੁ ਨ ਪਾਰਾਵਾਰਾ ॥",
      "transliteration": "teraa a(n)t na paaraavaaraa ||",
      "translation": "You have no end or limitation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਸਦ ਬਲਿਹਾਰਾ ॥੪॥੧॥੧੭॥",
      "transliteration": "jan naanak sad balihaaraa ||4||1||17||",
      "translation": "Servant Nanak is forever a sacrifice to You. ||4||1||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਾਰੂ ਮਹਲਾ ੫ ॥",
      "transliteration": "maaroo mahalaa 5 ||",
      "translation": "Maaroo, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮੋਹਨੀ ਮੋਹਿ ਲੀਏ ਤ੍ਰੈ ਗੁਨੀਆ ॥",
      "transliteration": "mohanee mohi leee trai guneeaa ||",
      "translation": "Maya, the enticer, has enticed the world of the three gunas, the three qualities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਲੋਭਿ ਵਿਆਪੀ ਝੂਠੀ ਦੁਨੀਆ ॥",
      "transliteration": "lobh viaapee jhoothee duneeaa ||",
      "translation": "The false world is engrossed in greed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮੇਰੀ ਮੇਰੀ ਕਰਿ ਕੈ ਸੰਚੀ ਅੰਤ ਕੀ ਬਾਰ ਸਗਲ ਲੇ ਛਲੀਆ ॥੧॥",
      "transliteration": "meree meree kar kai sa(n)chee a(n)t kee baar sagal le chhaleeaa ||1||",
      "translation": "Crying out, \"Mine, mine!\" they collect possessions, but in the end, they are all deceived. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਿਰਭਉ ਨਿਰੰਕਾਰੁ ਦਇਅਲੀਆ ॥",
      "transliteration": "nirabhau nira(n)kaar daialeeaa ||",
      "translation": "The Lord is fearless, formless and merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਸਗਲੇ ਪ੍ਰਤਿਪਲੀਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jee ja(n)t sagale pratipaleeaa ||1|| rahaau ||",
      "translation": "He is the Cherisher of all beings and creatures. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਏਕੈ ਸ੍ਰਮੁ ਕਰਿ ਗਾਡੀ ਗਡਹੈ ॥",
      "transliteration": "ekai sram kar gaadee gadahai ||",
      "translation": "Some collect wealth, and bury it in the ground.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਏਕਹਿ ਸੁਪਨੈ ਦਾਮੁ ਨ ਛਡਹੈ ॥",
      "transliteration": "ekahi supanai daam na chhadahai ||",
      "translation": "Some cannot abandon wealth, even in their dreams.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਾਜੁ ਕਮਾਇ ਕਰੀ ਜਿਨਿ ਥੈਲੀ ਤਾ ਕੈ ਸੰਗਿ ਨ ਚੰਚਲਿ ਚਲੀਆ ॥੨॥",
      "transliteration": "raaj kamaai karee jin thailee taa kai sa(n)g na cha(n)chal chaleeaa ||2||",
      "translation": "The king exercises his power, and fills his money-bags, but this fickle companion will not go along with him. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਏਕਹਿ ਪ੍ਰਾਣ ਪਿੰਡ ਤੇ ਪਿਆਰੀ ॥",
      "transliteration": "ekahi praan pi(n)d te piaaree ||",
      "translation": "Some love this wealth even more than their body and breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਏਕ ਸੰਚੀ ਤਜਿ ਬਾਪ ਮਹਤਾਰੀ ॥",
      "transliteration": "ek sa(n)chee taj baap mahataaree ||",
      "translation": "Some collect it, forsaking their fathers and mothers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੁਤ ਮੀਤ ਭ੍ਰਾਤ ਤੇ ਗੁਹਜੀ ਤਾ ਕੈ ਨਿਕਟਿ ਨ ਹੋਈ ਖਲੀਆ ॥੩॥",
      "transliteration": "sut meet bhraat te guhajee taa kai nikat na hoee khaleeaa ||3||",
      "translation": "Some hide it from their children, friends and siblings, but it will not remain with them. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੋਇ ਅਉਧੂਤ ਬੈਠੇ ਲਾਇ ਤਾਰੀ ॥",
      "transliteration": "hoi audhoot baithe laai taaree ||",
      "translation": "Some become hermits, and sit in meditative trances.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੋਗੀ ਜਤੀ ਪੰਡਿਤ ਬੀਚਾਰੀ ॥",
      "transliteration": "jogee jatee pa(n)dit beechaaree ||",
      "translation": "Some are Yogis, celibates, religious scholars and thinkers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗ੍ਰਿਹਿ ਮੜੀ ਮਸਾਣੀ ਬਨ ਮਹਿ ਬਸਤੇ ਊਠਿ ਤਿਨਾ ਕੈ ਲਾਗੀ ਪਲੀਆ ॥੪॥",
      "transliteration": "grihi maRee masaanee ban mahi basate ooth tinaa kai laagee paleeaa ||4||",
      "translation": "Some dwell in homes, graveyards, cremation grounds and forests; but Maya still clings to them there. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਾਟੇ ਬੰਧਨ ਠਾਕੁਰਿ ਜਾ ਕੇ ॥",
      "transliteration": "kaate ba(n)dhan thaakur jaa ke ||",
      "translation": "When the Lord and Master releases one from his bonds,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਬਸਿਓ ਜੀਅ ਤਾ ਕੈ ॥",
      "transliteration": "har har naam basio jee taa kai ||",
      "translation": "the Name of the Lord, Har, Har, comes to dwell in his soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਭਏ ਜਨ ਮੁਕਤੇ ਗਤਿ ਪਾਈ ਨਾਨਕ ਨਦਰਿ ਨਿਹਲੀਆ ॥੫॥੨॥੧੮॥",
      "transliteration": "saadhasa(n)g bhae jan mukate gat paaee naanak nadar nihaleeaa ||5||2||18||",
      "translation": "In the Saadh Sangat, the Company of the Holy, His humble servants are liberated; O Nanak, they are redeemed and enraptured by the Lord's Glance of Grace. ||5||2||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਾਰੂ ਮਹਲਾ ੫ ॥",
      "transliteration": "maaroo mahalaa 5 ||",
      "translation": "Maaroo, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਿਮਰਹੁ ਏਕੁ ਨਿਰੰਜਨ ਸੋਊ ॥",
      "transliteration": "simarahu ek nira(n)jan sooo ||",
      "translation": "Meditate in remembrance on the One Immaculate Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਾ ਤੇ ਬਿਰਥਾ ਜਾਤ ਨ ਕੋਊ ॥",
      "transliteration": "jaa te birathaa jaat na kooo ||",
      "translation": "No one is turned away from Him empty-handed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਾਤ ਗਰਭ ਮਹਿ ਜਿਨਿ ਪ੍ਰਤਿਪਾਰਿਆ ॥",
      "transliteration": "maat garabh mahi jin pratipaariaa ||",
      "translation": "He cherished and preserved you in your mother's womb;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਦੇ ਸਾਜਿ ਸਵਾਰਿਆ ॥",
      "transliteration": "jeeu pi(n)d de saaj savaariaa ||",
      "translation": "He blessed you with body and soul, and embellished you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੋਈ ਬਿਧਾਤਾ ਖਿਨੁ ਖਿਨੁ ਜਪੀਐ ॥",
      "transliteration": "soee bidhaataa khin khin japeeai ||",
      "translation": "Each and every instant, meditate on that Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਿਸੁ ਸਿਮਰਤ ਅਵਗੁਣ ਸਭਿ ਢਕੀਐ ॥",
      "transliteration": "jis simarat avagun sabh dhakeeai ||",
      "translation": "Meditating in remembrance on Him, all faults and mistakes are covered.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚਰਣ ਕਮਲ ਉਰ ਅੰਤਰਿ ਧਾਰਹੁ ॥",
      "transliteration": "charan kamal ur a(n)tar dhaarahu ||",
      "translation": "Enshrine the Lord's lotus feet deep within the nucleus of your self.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਿਖਿਆ ਬਨ ਤੇ ਜੀਉ ਉਧਾਰਹੁ ॥",
      "transliteration": "bikhiaa ban te jeeu udhaarahu ||",
      "translation": "Save your soul from the waters of corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਰਣ ਪਲਾਹ ਮਿਟਹਿ ਬਿਲਲਾਟਾ ॥",
      "transliteration": "karan palaah mitahi bilalaataa ||",
      "translation": "Your cries and shrieks shall be ended;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਪਿ ਗੋਵਿਦ ਭਰਮੁ ਭਉ ਫਾਟਾ ॥",
      "transliteration": "jap govid bharam bhau phaataa ||",
      "translation": "meditating on the Lord of the Universe, your doubts and fears shall be dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਵਿਰਲਾ ਕੋ ਪਾਏ ॥",
      "transliteration": "saadhasa(n)g viralaa ko paae ||",
      "translation": "Rare is that being, who finds the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕੁ ਤਾ ਕੈ ਬਲਿ ਬਲਿ ਜਾਏ ॥੧॥",
      "transliteration": "naanak taa kai bal bal jaae ||1||",
      "translation": "Nanak is a sacrifice, a sacrifice to Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਮਨਿ ਤਨਿ ਆਧਾਰਾ ॥",
      "transliteration": "raam naam man tan aadhaaraa ||",
      "translation": "The Lord's Name is the support of my mind and body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੋ ਸਿਮਰੈ ਤਿਸ ਕਾ ਨਿਸਤਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jo simarai tis kaa nisataaraa ||1|| rahaau ||",
      "translation": "Whoever meditates on Him is emancipated. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਿਥਿਆ ਵਸਤੁ ਸਤਿ ਕਰਿ ਮਾਨੀ ॥",
      "transliteration": "mithiaa vasat sat kar maanee ||",
      "translation": "He believes that the false thing is true.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹਿਤੁ ਲਾਇਓ ਸਠ ਮੂੜ ਅਗਿਆਨੀ ॥",
      "transliteration": "hit laaio sath mooR agiaanee ||",
      "translation": "The ignorant fool falls in love with it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਲੋਭ ਮਦ ਮਾਤਾ ॥",
      "transliteration": "kaam krodh lobh mad maataa ||",
      "translation": "He is intoxicated with the wine of sexual desire, anger and greed;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਉਡੀ ਬਦਲੈ ਜਨਮੁ ਗਵਾਤਾ ॥",
      "transliteration": "kaudee badalai janam gavaataa ||",
      "translation": "he loses this human life in exchance for a mere shell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਪਨਾ ਛੋਡਿ ਪਰਾਇਐ ਰਾਤਾ ॥",
      "transliteration": "apanaa chhod paraaiai raataa ||",
      "translation": "He abandons his own, and loves that of others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਾਇਆ ਮਦ ਮਨ ਤਨ ਸੰਗਿ ਜਾਤਾ ॥",
      "transliteration": "maaiaa mad man tan sa(n)g jaataa ||",
      "translation": "His mind and body are permeated with the intoxication of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਤ੍ਰਿਸਨ ਨ ਬੂਝੈ ਕਰਤ ਕਲੋਲਾ ॥",
      "transliteration": "trisan na boojhai karat kalolaa ||",
      "translation": "His thirsty desires are not quenched, although he indulges in pleasures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਊਣੀ ਆਸ ਮਿਥਿਆ ਸਭਿ ਬੋਲਾ ॥",
      "transliteration": "oonee aas mithiaa sabh bolaa ||",
      "translation": "His hopes are not fulfilled, and all his words are false.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1004_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਆਵਤ ਇਕੇਲਾ ਜਾਤ ਇਕੇਲਾ ॥",
      "transliteration": "aavat ikelaa jaat ikelaa ||",
      "translation": "He comes alone, and he goes alone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1004,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
