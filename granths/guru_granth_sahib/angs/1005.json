{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1005,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1005_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਮ ਤੁਮ ਸੰਗਿ ਝੂਠੇ ਸਭਿ ਬੋਲਾ ॥",
      "transliteration": "ham tum sa(n)g jhoothe sabh bolaa ||",
      "translation": "False is all his talk of me and you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪਾਇ ਠਗਉਰੀ ਆਪਿ ਭੁਲਾਇਓ ॥",
      "transliteration": "paai thagauree aap bhulaaio ||",
      "translation": "The Lord Himself administers the poisonous potion, to mislead and delude.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਨਕ ਕਿਰਤੁ ਨ ਜਾਇ ਮਿਟਾਇਓ ॥੨॥",
      "transliteration": "naanak kirat na jaai mitaaio ||2||",
      "translation": "O Nanak, the the karma of past actions cannot be erased. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਸੁ ਪੰਖੀ ਭੂਤ ਅਰੁ ਪ੍ਰੇਤਾ ॥",
      "transliteration": "pas pa(n)khee bhoot ar pretaa ||",
      "translation": "Beasts, birds, demons and ghosts",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਜੋਨੀ ਫਿਰਤ ਅਨੇਤਾ ॥",
      "transliteration": "bahu bidh jonee phirat anetaa ||",
      "translation": "- in these many ways, the false wander in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਹ ਜਾਨੋ ਤਹ ਰਹਨੁ ਨ ਪਾਵੈ ॥",
      "transliteration": "jah jaano tah rahan na paavai ||",
      "translation": "Wherever they go, they cannot remain there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਥਾਨ ਬਿਹੂਨ ਉਠਿ ਉਠਿ ਫਿਰਿ ਧਾਵੈ ॥",
      "transliteration": "thaan bihoon uth uth phir dhaavai ||",
      "translation": "They have no place of rest; they rise up again and again and run around.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਨਿ ਤਨਿ ਬਾਸਨਾ ਬਹੁਤੁ ਬਿਸਥਾਰਾ ॥",
      "transliteration": "man tan baasanaa bahut bisathaaraa ||",
      "translation": "Their minds and bodies are filled with immense, expansive desires.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਹੰਮੇਵ ਮੂਠੋ ਬੇਚਾਰਾ ॥",
      "transliteration": "aha(n)mev mootho bechaaraa ||",
      "translation": "The poor wretches are cheated by egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਨਿਕ ਦੋਖ ਅਰੁ ਬਹੁਤੁ ਸਜਾਈ ॥",
      "transliteration": "anik dokh ar bahut sajaaee ||",
      "translation": "They are filled with countless sins, and are severely punished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਾ ਕੀ ਕੀਮਤਿ ਕਹਣੁ ਨ ਜਾਈ ॥",
      "transliteration": "taa kee keemat kahan na jaaee ||",
      "translation": "The extent of this cannot be estimated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪ੍ਰਭ ਬਿਸਰਤ ਨਰਕ ਮਹਿ ਪਾਇਆ ॥",
      "transliteration": "prabh bisarat narak mahi paaiaa ||",
      "translation": "Forgetting God, they fall into hell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਹ ਮਾਤ ਨ ਬੰਧੁ ਨ ਮੀਤ ਨ ਜਾਇਆ ॥",
      "transliteration": "tah maat na ba(n)dh na meet na jaaiaa ||",
      "translation": "There are no mothers there, no siblings, no friends and no spouses.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਸ ਕਉ ਹੋਤ ਕ੍ਰਿਪਾਲ ਸੁਆਮੀ ॥",
      "transliteration": "jis kau hot kripaal suaamee ||",
      "translation": "Those humble beings, unto whom the Lord and Master becomes Merciful,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੋ ਜਨੁ ਨਾਨਕ ਪਾਰਗਰਾਮੀ ॥੩॥",
      "transliteration": "so jan naanak paaragaraamee ||3||",
      "translation": "O Nanak, cross over. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭ੍ਰਮਤ ਭ੍ਰਮਤ ਪ੍ਰਭ ਸਰਨੀ ਆਇਆ ॥",
      "transliteration": "bhramat bhramat prabh saranee aaiaa ||",
      "translation": "Rambling and roaming, wandering around, I came to seek the Sanctuary of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੀਨਾ ਨਾਥ ਜਗਤ ਪਿਤ ਮਾਇਆ ॥",
      "transliteration": "deenaa naath jagat pit maaiaa ||",
      "translation": "He is the Master of the meek, the father and mother of the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪ੍ਰਭ ਦਇਆਲ ਦੁਖ ਦਰਦ ਬਿਦਾਰਣ ॥",
      "transliteration": "prabh daiaal dukh darad bidaaran ||",
      "translation": "The Merciful Lord God is the Destroyer of sorrow and suffering.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਸੁ ਭਾਵੈ ਤਿਸ ਹੀ ਨਿਸਤਾਰਣ ॥",
      "transliteration": "jis bhaavai tis hee nisataaran ||",
      "translation": "He emancipates whoever He pleases.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅੰਧ ਕੂਪ ਤੇ ਕਾਢਨਹਾਰਾ ॥",
      "transliteration": "a(n)dh koop te kaadhanahaaraa ||",
      "translation": "He lifts them up and pulls him out of the deep dark pit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪ੍ਰੇਮ ਭਗਤਿ ਹੋਵਤ ਨਿਸਤਾਰਾ ॥",
      "transliteration": "prem bhagat hovat nisataaraa ||",
      "translation": "Emancipation comes through loving devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾਧ ਰੂਪ ਅਪਨਾ ਤਨੁ ਧਾਰਿਆ ॥",
      "transliteration": "saadh roop apanaa tan dhaariaa ||",
      "translation": "The Holy Saint is the very embodiment of the Lord's form.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਹਾ ਅਗਨਿ ਤੇ ਆਪਿ ਉਬਾਰਿਆ ॥",
      "transliteration": "mahaa agan te aap ubaariaa ||",
      "translation": "He Himself saves us from the great fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਪ ਤਪ ਸੰਜਮ ਇਸ ਤੇ ਕਿਛੁ ਨਾਹੀ ॥",
      "transliteration": "jap tap sa(n)jam is te kichh naahee ||",
      "translation": "By myself, I cannot practice meditation, austerities, penance and self-discipline.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਦਿ ਅੰਤਿ ਪ੍ਰਭ ਅਗਮ ਅਗਾਹੀ ॥",
      "transliteration": "aad a(n)t prabh agam agaahee ||",
      "translation": "In the beginning and in the end, God is inaccessible and unfathomable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਮੁ ਦੇਹਿ ਮਾਗੈ ਦਾਸੁ ਤੇਰਾ ॥",
      "transliteration": "naam dehi maagai daas teraa ||",
      "translation": "Please bless me with Your Name, Lord; Your slave begs only for this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਰਿ ਜੀਵਨ ਪਦੁ ਨਾਨਕ ਪ੍ਰਭੁ ਮੇਰਾ ॥੪॥੩॥੧੯॥",
      "transliteration": "har jeevan pad naanak prabh meraa ||4||3||19||",
      "translation": "O Nanak, my Lord God is the Giver of the true state of life. ||4||3||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਾਰੂ ਮਹਲਾ ੫ ॥",
      "transliteration": "maaroo mahalaa 5 ||",
      "translation": "Maaroo, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਤ ਕਉ ਡਹਕਾਵਹੁ ਲੋਗਾ ਮੋਹਨ ਦੀਨ ਕਿਰਪਾਈ ॥੧॥",
      "transliteration": "kat kau dahakaavahu logaa mohan deen kirapaaee ||1||",
      "translation": "Why do you try to deceive others, O people of the world? The Fascinating Lord is Merciful to the meek. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਐਸੀ ਜਾਨਿ ਪਾਈ ॥",
      "transliteration": "aisee jaan paaee ||",
      "translation": "This is what I have come to know.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਰਣਿ ਸੂਰੋ ਗੁਰ ਦਾਤਾ ਰਾਖੈ ਆਪਿ ਵਡਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saran sooro gur daataa raakhai aap vadaaee ||1|| rahaau ||",
      "translation": "The brave and heroic Guru, the Generous Giver, gives Sanctuary and preserves our honor. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਗਤਾ ਕਾ ਆਗਿਆਕਾਰੀ ਸਦਾ ਸਦਾ ਸੁਖਦਾਈ ॥੨॥",
      "transliteration": "bhagataa kaa aagiaakaaree sadaa sadaa sukhadaaee ||2||",
      "translation": "He submits to the Will of His devotees; He is forever and ever the Giver of peace. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਪਨੇ ਕਉ ਕਿਰਪਾ ਕਰੀਅਹੁ ਇਕੁ ਨਾਮੁ ਧਿਆਈ ॥੩॥",
      "transliteration": "apane kau kirapaa kareeahu ik naam dhiaaee ||3||",
      "translation": "Please bless me with Your Mercy, that I may meditate on Your Name alone. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਨਕੁ ਦੀਨੁ ਨਾਮੁ ਮਾਗੈ ਦੁਤੀਆ ਭਰਮੁ ਚੁਕਾਈ ॥੪॥੪॥੨੦॥",
      "transliteration": "naanak deen naam maagai duteeaa bharam chukaaee ||4||4||20||",
      "translation": "Nanak, the meek and humble, begs for the Naam, the Name of the Lord; it eradicates duality and doubt. ||4||4||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਾਰੂ ਮਹਲਾ ੫ ॥",
      "transliteration": "maaroo mahalaa 5 ||",
      "translation": "Maaroo, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮੇਰਾ ਠਾਕੁਰੁ ਅਤਿ ਭਾਰਾ ॥",
      "transliteration": "meraa thaakur at bhaaraa ||",
      "translation": "My Lord and Master is utterly powerful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮੋਹਿ ਸੇਵਕੁ ਬੇਚਾਰਾ ॥੧॥",
      "transliteration": "mohi sevak bechaaraa ||1||",
      "translation": "I am just His poor servant. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੋਹਨੁ ਲਾਲੁ ਮੇਰਾ ਪ੍ਰੀਤਮ ਮਨ ਪ੍ਰਾਨਾ ॥",
      "transliteration": "mohan laal meraa preetam man praanaa ||",
      "translation": "My Enticing Beloved is very dear to my mind and my breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੋ ਕਉ ਦੇਹੁ ਦਾਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mo kau dehu daanaa ||1|| rahaau ||",
      "translation": "He blesses me with His gift. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਗਲੇ ਮੈ ਦੇਖੇ ਜੋਈ ॥",
      "transliteration": "sagale mai dekhe joee ||",
      "translation": "I have seen and tested all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬੀਜਉ ਅਵਰੁ ਨ ਕੋਈ ॥੨॥",
      "transliteration": "beejau avar na koee ||2||",
      "translation": "There is none other than Him. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੀਅਨ ਪ੍ਰਤਿਪਾਲਿ ਸਮਾਹੈ ॥",
      "transliteration": "jeean pratipaal samaahai ||",
      "translation": "He sustains and nurtures all beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹੈ ਹੋਸੀ ਆਹੇ ॥੩॥",
      "transliteration": "hai hosee aahe ||3||",
      "translation": "He was, and shall always be. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਦਇਆ ਮੋਹਿ ਕੀਜੈ ਦੇਵਾ ॥",
      "transliteration": "daiaa mohi keejai devaa ||",
      "translation": "Please bless me with Your Mercy, O Divine Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਲਾਗੋ ਸੇਵਾ ॥੪॥੫॥੨੧॥",
      "transliteration": "naanak laago sevaa ||4||5||21||",
      "translation": "and link Nanak to Your service. ||4||5||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਾਰੂ ਮਹਲਾ ੫ ॥",
      "transliteration": "maaroo mahalaa 5 ||",
      "translation": "Maaroo, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪਤਿਤ ਉਧਾਰਨ ਤਾਰਨ ਬਲਿ ਬਲਿ ਬਲੇ ਬਲਿ ਜਾਈਐ ॥",
      "transliteration": "patit udhaaran taaran bal bal bale bal jaaeeai ||",
      "translation": "The Redeemer of sinners, who carries us across; I am a sacrifice, a sacrifice, a sacrifice, a sacrifice to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਐਸਾ ਕੋਈ ਭੇਟੈ ਸੰਤੁ ਜਿਤੁ ਹਰਿ ਹਰੇ ਹਰਿ ਧਿਆਈਐ ॥੧॥",
      "transliteration": "aisaa koee bhetai sa(n)t jit har hare har dhiaaeeai ||1||",
      "translation": "If only I could meet with such a Saint, who would inspire me to meditate on the Lord, Har, Har, Har. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮੋ ਕਉ ਕੋਇ ਨ ਜਾਨਤ ਕਹੀਅਤ ਦਾਸੁ ਤੁਮਾਰਾ ॥",
      "transliteration": "mo kau koi na jaanat kaheeat daas tumaaraa ||",
      "translation": "No one knows me; I am called Your slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਏਹਾ ਓਟ ਆਧਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ehaa ot aadhaaraa ||1|| rahaau ||",
      "translation": "This is my support and sustenance. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਰਬ ਧਾਰਨ ਪ੍ਰਤਿਪਾਰਨ ਇਕ ਬਿਨਉ ਦੀਨਾ ॥",
      "transliteration": "sarab dhaaran pratipaaran ik binau deenaa ||",
      "translation": "You support and cherish all; I am meek and humble - this is my only prayer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤੁਮਰੀ ਬਿਧਿ ਤੁਮ ਹੀ ਜਾਨਹੁ ਤੁਮ ਜਲ ਹਮ ਮੀਨਾ ॥੨॥",
      "transliteration": "tumaree bidh tum hee jaanahu tum jal ham meenaa ||2||",
      "translation": "You alone know Your Way; You are the water, and I am the fish. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਪੂਰਨ ਬਿਸਥੀਰਨ ਸੁਆਮੀ ਆਹਿ ਆਇਓ ਪਾਛੈ ॥",
      "transliteration": "pooran bisatheeran suaamee aahi aaio paachhai ||",
      "translation": "O Perfect and Expansive Lord and Master, I follow You in love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1005_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਗਲੋ ਭੂ ਮੰਡਲ ਖੰਡਲ ਪ੍ਰਭ ਤੁਮ ਹੀ ਆਛੈ ॥੩॥",
      "transliteration": "sagalo bhoo ma(n)dal kha(n)dal prabh tum hee aachhai ||3||",
      "translation": "O God, You are pervading all the worlds, solar systems and galaxies. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1005,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
