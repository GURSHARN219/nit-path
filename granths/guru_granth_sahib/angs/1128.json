{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1128,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1128_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਇਸੁ ਗਰਬ ਤੇ ਚਲਹਿ ਬਹੁਤੁ ਵਿਕਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "is garab te chalahi bahut vikaaraa ||1|| rahaau ||",
      "translation": "So much sin and corruption comes from this pride. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਚਾਰੇ ਵਰਨ ਆਖੈ ਸਭੁ ਕੋਈ ॥",
      "transliteration": "chaare varan aakhai sabh koee ||",
      "translation": "Everyone says that there are four castes, four social classes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬ੍ਰਹਮੁ ਬਿੰਦ ਤੇ ਸਭ ਓਪਤਿ ਹੋਈ ॥੨॥",
      "transliteration": "braham bi(n)d te sabh opat hoee ||2||",
      "translation": "They all emanate from the drop of God's Seed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਾਟੀ ਏਕ ਸਗਲ ਸੰਸਾਰਾ ॥",
      "transliteration": "maatee ek sagal sa(n)saaraa ||",
      "translation": "The entire universe is made of the same clay.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਭਾਂਡੇ ਘੜੈ ਕੁਮੑਾਰਾ ॥੩॥",
      "transliteration": "bahu bidh bhaa(n)de ghaRai kumhaaraa ||3||",
      "translation": "The Potter has shaped it into all sorts of vessels. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪੰਚ ਤਤੁ ਮਿਲਿ ਦੇਹੀ ਕਾ ਆਕਾਰਾ ॥",
      "transliteration": "pa(n)ch tat mil dehee kaa aakaaraa ||",
      "translation": "The five elements join together, to make up the form of the human body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਘਟਿ ਵਧਿ ਕੋ ਕਰੈ ਬੀਚਾਰਾ ॥੪॥",
      "transliteration": "ghat vadh ko karai beechaaraa ||4||",
      "translation": "Who can say which is less, and which is more? ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਹਤੁ ਨਾਨਕ ਇਹੁ ਜੀਉ ਕਰਮ ਬੰਧੁ ਹੋਈ ॥",
      "transliteration": "kahat naanak ihu jeeu karam ba(n)dh hoee ||",
      "translation": "Says Nanak, this soul is bound by its actions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰ ਭੇਟੇ ਮੁਕਤਿ ਨ ਹੋਈ ॥੫॥੧॥",
      "transliteration": "bin satigur bhete mukat na hoee ||5||1||",
      "translation": "Without meeting the True Guru, it is not liberated. ||5||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੩ ॥",
      "transliteration": "bhairau mahalaa 3 ||",
      "translation": "Bhairao, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੋਗੀ ਗ੍ਰਿਹੀ ਪੰਡਿਤ ਭੇਖਧਾਰੀ ॥",
      "transliteration": "jogee grihee pa(n)dit bhekhadhaaree ||",
      "translation": "The Yogis, the householders, the Pandits, the religious scholars, and the beggars in religious robes",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਏ ਸੂਤੇ ਅਪਣੈ ਅਹੰਕਾਰੀ ॥੧॥",
      "transliteration": "e soote apanai aha(n)kaaree ||1||",
      "translation": "- they are all asleep in egotism. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਾਇਆ ਮਦਿ ਮਾਤਾ ਰਹਿਆ ਸੋਇ ॥",
      "transliteration": "maaiaa mad maataa rahiaa soi ||",
      "translation": "They are asleep, intoxicated with the wine of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾਗਤੁ ਰਹੈ ਨ ਮੂਸੈ ਕੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaagat rahai na moosai koi ||1|| rahaau ||",
      "translation": "Only those who remain awake and aware are not robbed. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੋ ਜਾਗੈ ਜਿਸੁ ਸਤਿਗੁਰੁ ਮਿਲੈ ॥",
      "transliteration": "so jaagai jis satigur milai ||",
      "translation": "One who has met the True Guru, remains awake and aware.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪੰਚ ਦੂਤ ਓਹੁ ਵਸਗਤਿ ਕਰੈ ॥੨॥",
      "transliteration": "pa(n)ch doot ohu vasagat karai ||2||",
      "translation": "Such a person overpowers the five thieves. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੋ ਜਾਗੈ ਜੋ ਤਤੁ ਬੀਚਾਰੈ ॥",
      "transliteration": "so jaagai jo tat beechaarai ||",
      "translation": "One who contemplates the essence of reality remains awake and aware.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਪਿ ਮਰੈ ਅਵਰਾ ਨਹ ਮਾਰੈ ॥੩॥",
      "transliteration": "aap marai avaraa nah maarai ||3||",
      "translation": "He kills his self-conceit, and does not kill anyone else. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੋ ਜਾਗੈ ਜੋ ਏਕੋ ਜਾਣੈ ॥",
      "transliteration": "so jaagai jo eko jaanai ||",
      "translation": "One who knows the One Lord remains awake and aware.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਰਕਿਰਤਿ ਛੋਡੈ ਤਤੁ ਪਛਾਣੈ ॥੪॥",
      "transliteration": "parakirat chhodai tat pachhaanai ||4||",
      "translation": "He abandons the service of others, and realizes the essence of reality. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚਹੁ ਵਰਨਾ ਵਿਚਿ ਜਾਗੈ ਕੋਇ ॥",
      "transliteration": "chahu varanaa vich jaagai koi ||",
      "translation": "Of the four castes, whoever remains awake and aware",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਮੈ ਕਾਲੈ ਤੇ ਛੂਟੈ ਸੋਇ ॥੫॥",
      "transliteration": "jamai kaalai te chhootai soi ||5||",
      "translation": "is released from birth and death. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਹਤ ਨਾਨਕ ਜਨੁ ਜਾਗੈ ਸੋਇ ॥",
      "transliteration": "kahat naanak jan jaagai soi ||",
      "translation": "Says Nanak, that humble being remains awake and aware,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗਿਆਨ ਅੰਜਨੁ ਜਾ ਕੀ ਨੇਤ੍ਰੀ ਹੋਇ ॥੬॥੨॥",
      "transliteration": "giaan a(n)jan jaa kee netree hoi ||6||2||",
      "translation": "who applies the ointment of spiritual wisdom to his eyes. ||6||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੩ ॥",
      "transliteration": "bhairau mahalaa 3 ||",
      "translation": "Bhairao, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾ ਕਉ ਰਾਖੈ ਅਪਣੀ ਸਰਣਾਈ ॥",
      "transliteration": "jaa kau raakhai apanee saranaaee ||",
      "translation": "Whoever the Lord keeps in His Sanctuary,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਾਚੇ ਲਾਗੈ ਸਾਚਾ ਫਲੁ ਪਾਈ ॥੧॥",
      "transliteration": "saache laagai saachaa phal paaee ||1||",
      "translation": "is attached to the Truth, and receives the fruit of Truth. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰੇ ਜਨ ਕੈ ਸਿਉ ਕਰਹੁ ਪੁਕਾਰਾ ॥",
      "transliteration": "re jan kai siu karahu pukaaraa ||",
      "translation": "O mortal, unto whom will you complain?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹੁਕਮੇ ਹੋਆ ਹੁਕਮੇ ਵਰਤਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "hukame hoaa hukame varataaraa ||1|| rahaau ||",
      "translation": "The Hukam of the Lord's Command is pervasive; by the Hukam of His Command, all things happen. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਏਹੁ ਆਕਾਰੁ ਤੇਰਾ ਹੈ ਧਾਰਾ ॥",
      "transliteration": "ehu aakaar teraa hai dhaaraa ||",
      "translation": "This Creation was established by You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਬਿਨਸੈ ਕਰਤ ਨ ਲਾਗੈ ਬਾਰਾ ॥੨॥",
      "transliteration": "khin mahi binasai karat na laagai baaraa ||2||",
      "translation": "In an instant You destroy it, and You create it again without a moment's delay. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਰਿ ਪ੍ਰਸਾਦੁ ਇਕੁ ਖੇਲੁ ਦਿਖਾਇਆ ॥",
      "transliteration": "kar prasaad ik khel dikhaaiaa ||",
      "translation": "By His Grace, He has staged this Play.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਪਰਮ ਪਦੁ ਪਾਇਆ ॥੩॥",
      "transliteration": "gur kirapaa te param pad paaiaa ||3||",
      "translation": "By the Guru's Merciful Grace, I have obtained the supreme status. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹਤ ਨਾਨਕੁ ਮਾਰਿ ਜੀਵਾਲੇ ਸੋਇ ॥",
      "transliteration": "kahat naanak maar jeevaale soi ||",
      "translation": "Says Nanak, He alone kills and revives.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਐਸਾ ਬੂਝਹੁ ਭਰਮਿ ਨ ਭੂਲਹੁ ਕੋਇ ॥੪॥੩॥",
      "transliteration": "aisaa boojhahu bharam na bhoolahu koi ||4||3||",
      "translation": "Understand this well - do not be confused by doubt. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੩ ॥",
      "transliteration": "bhairau mahalaa 3 ||",
      "translation": "Bhairao, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਮੈ ਕਾਮਣਿ ਮੇਰਾ ਕੰਤੁ ਕਰਤਾਰੁ ॥",
      "transliteration": "mai kaaman meraa ka(n)t karataar ||",
      "translation": "I am the bride; the Creator is my Husband Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੇਹਾ ਕਰਾਏ ਤੇਹਾ ਕਰੀ ਸੀਗਾਰੁ ॥੧॥",
      "transliteration": "jehaa karaae tehaa karee seegaar ||1||",
      "translation": "As He inspires me, I adorn myself. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾਂ ਤਿਸੁ ਭਾਵੈ ਤਾਂ ਕਰੇ ਭੋਗੁ ॥",
      "transliteration": "jaa(n) tis bhaavai taa(n) kare bhog ||",
      "translation": "When it pleases Him, He enjoys me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਸਾਚੇ ਸਾਹਿਬ ਜੋਗੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tan man saache saahib jog ||1|| rahaau ||",
      "translation": "I am joined, body and mind, to my True Lord and Master. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਉਸਤਤਿ ਨਿੰਦਾ ਕਰੇ ਕਿਆ ਕੋਈ ॥",
      "transliteration": "usatat ni(n)daa kare kiaa koee ||",
      "translation": "How can anyone praise or slander anyone else?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਾਂ ਆਪੇ ਵਰਤੈ ਏਕੋ ਸੋਈ ॥੨॥",
      "transliteration": "jaa(n) aape varatai eko soee ||2||",
      "translation": "The One Lord Himself is pervading and permeating all. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਪਿਰਮ ਕਸਾਈ ॥",
      "transliteration": "gur parasaadee piram kasaaee ||",
      "translation": "By Guru's Grace, I am attracted by His Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮਿਲਉਗੀ ਦਇਆਲ ਪੰਚ ਸਬਦ ਵਜਾਈ ॥੩॥",
      "transliteration": "milaugee daiaal pa(n)ch sabad vajaaee ||3||",
      "translation": "I shall meet with my Merciful Lord, and vibrate the Panch Shabad, the Five Primal Sounds. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਨਤਿ ਨਾਨਕੁ ਕਰੇ ਕਿਆ ਕੋਇ ॥",
      "transliteration": "bhanat naanak kare kiaa koi ||",
      "translation": "Prays Nanak, what can anyone do?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਸ ਨੋ ਆਪਿ ਮਿਲਾਵੈ ਸੋਇ ॥੪॥੪॥",
      "transliteration": "jis no aap milaavai soi ||4||4||",
      "translation": "He alone meets with the Lord, whom the Lord Himself meets. ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੩ ॥",
      "transliteration": "bhairau mahalaa 3 ||",
      "translation": "Bhairao, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੋ ਮੁਨਿ ਜਿ ਮਨ ਕੀ ਦੁਬਿਧਾ ਮਾਰੇ ॥",
      "transliteration": "so mun j man kee dubidhaa maare ||",
      "translation": "He alone is a silent sage, who subdues his mind's duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਦੁਬਿਧਾ ਮਾਰਿ ਬ੍ਰਹਮੁ ਬੀਚਾਰੇ ॥੧॥",
      "transliteration": "dubidhaa maar braham beechaare ||1||",
      "translation": "Subduing his duality, he contemplates God. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਇਸੁ ਮਨ ਕਉ ਕੋਈ ਖੋਜਹੁ ਭਾਈ ॥",
      "transliteration": "is man kau koee khojahu bhaaee ||",
      "translation": "Let each person examine his own mind, O Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮਨੁ ਖੋਜਤ ਨਾਮੁ ਨਉ ਨਿਧਿ ਪਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "man khojat naam nau nidh paaee ||1|| rahaau ||",
      "translation": "Examine your mind, and you shall obtain the nine treasures of the Naam. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮੂਲੁ ਮੋਹੁ ਕਰਿ ਕਰਤੈ ਜਗਤੁ ਉਪਾਇਆ ॥",
      "transliteration": "mool mohu kar karatai jagat upaaiaa ||",
      "translation": "The Creator created the world, upon the foundation of worldly love and attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਮਤਾ ਲਾਇ ਭਰਮਿ ਭੋੁਲਾਇਆ ॥੨॥",
      "transliteration": "mamataa laai bharam bhoulaaiaa ||2||",
      "translation": "Attaching it to possessiveness, He has led it into confusion with doubt. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਇਸੁ ਮਨ ਤੇ ਸਭ ਪਿੰਡ ਪਰਾਣਾ ॥",
      "transliteration": "is man te sabh pi(n)d paraanaa ||",
      "translation": "From this Mind come all bodies, and the breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1128_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮਨ ਕੈ ਵੀਚਾਰਿ ਹੁਕਮੁ ਬੁਝਿ ਸਮਾਣਾ ॥੩॥",
      "transliteration": "man kai veechaar hukam bujh samaanaa ||3||",
      "translation": "By mental contemplation, the mortal realizes the Hukam of the Lord's Command, and merges in Him. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1128,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
