{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1129,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1129_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਰਮੁ ਹੋਵੈ ਗੁਰੁ ਕਿਰਪਾ ਕਰੈ ॥",
      "transliteration": "karam hovai gur kirapaa karai ||",
      "translation": "When the mortal has good karma, the Guru grants His Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਜਾਗੈ ਇਸੁ ਮਨ ਕੀ ਦੁਬਿਧਾ ਮਰੈ ॥੪॥",
      "transliteration": "ihu man jaagai is man kee dubidhaa marai ||4||",
      "translation": "Then this mind is awakened, and the duality of this mind is subdued. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਨ ਕਾ ਸੁਭਾਉ ਸਦਾ ਬੈਰਾਗੀ ॥",
      "transliteration": "man kaa subhaau sadaa bairaagee ||",
      "translation": "It is the innate nature of the mind to remain forever detached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਭ ਮਹਿ ਵਸੈ ਅਤੀਤੁ ਅਨਰਾਗੀ ॥੫॥",
      "transliteration": "sabh mahi vasai ateet anaraagee ||5||",
      "translation": "The Detached, Dispassionate Lord dwells within all. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਹਤ ਨਾਨਕੁ ਜੋ ਜਾਣੈ ਭੇਉ ॥",
      "transliteration": "kahat naanak jo jaanai bheu ||",
      "translation": "Says Nanak, one who understands this mystery,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਆਦਿ ਪੁਰਖੁ ਨਿਰੰਜਨ ਦੇਉ ॥੬॥੫॥",
      "transliteration": "aad purakh nira(n)jan deu ||6||5||",
      "translation": "becomes the embodiment of the Primal, Immaculate, Divine Lord God. ||6||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੩ ॥",
      "transliteration": "bhairau mahalaa 3 ||",
      "translation": "Bhairao, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਜਗਤ ਨਿਸਤਾਰਾ ॥",
      "transliteration": "raam naam jagat nisataaraa ||",
      "translation": "The world is saved through Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਵਜਲੁ ਪਾਰਿ ਉਤਾਰਣਹਾਰਾ ॥੧॥",
      "transliteration": "bhavajal paar utaaranahaaraa ||1||",
      "translation": "It carries the mortal across the terrifying world-ocean. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਹਰਿ ਨਾਮੁ ਸਮੑਾਲਿ ॥",
      "transliteration": "gur parasaadee har naam samhaal ||",
      "translation": "By Guru's Grace, dwell upon the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਦ ਹੀ ਨਿਬਹੈ ਤੇਰੈ ਨਾਲਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sad hee nibahai terai naal ||1|| rahaau ||",
      "translation": "It shall stand by you forever. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਮੁ ਨ ਚੇਤਹਿ ਮਨਮੁਖ ਗਾਵਾਰਾ ॥",
      "transliteration": "naam na chetahi manamukh gaavaaraa ||",
      "translation": "The foolish self-willed manmukhs do not remember the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਕੈਸੇ ਪਾਵਹਿ ਪਾਰਾ ॥੨॥",
      "transliteration": "bin naavai kaise paavahi paaraa ||2||",
      "translation": "Without the Name, how will they cross over? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਆਪੇ ਦਾਤਿ ਕਰੇ ਦਾਤਾਰੁ ॥",
      "transliteration": "aape daat kare daataar ||",
      "translation": "The Lord, the Great Giver, Himself gives His Gifts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦੇਵਣਹਾਰੇ ਕਉ ਜੈਕਾਰੁ ॥੩॥",
      "transliteration": "devanahaare kau jaikaar ||3||",
      "translation": "Celebrate and praise the Great Giver! ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਸਤਿਗੁਰੂ ਮਿਲਾਏ ॥",
      "transliteration": "nadar kare satiguroo milaae ||",
      "translation": "Granting His Grace, the Lord unites the mortals with the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਨਕ ਹਿਰਦੈ ਨਾਮੁ ਵਸਾਏ ॥੪॥੬॥",
      "transliteration": "naanak hiradai naam vasaae ||4||6||",
      "translation": "O Nanak, the Naam is enshrined within the heart. ||4||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੩ ॥",
      "transliteration": "bhairau mahalaa 3 ||",
      "translation": "Bhairao, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਮੇ ਉਧਰੇ ਸਭਿ ਜਿਤਨੇ ਲੋਅ ॥",
      "transliteration": "naame udhare sabh jitane lo ||",
      "translation": "All people are saved through the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਜਿਨਾ ਪਰਾਪਤਿ ਹੋਇ ॥੧॥",
      "transliteration": "guramukh jinaa paraapat hoi ||1||",
      "translation": "Those who become Gurmukh are blessed to receive It. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਰਿ ਜੀਉ ਅਪਣੀ ਕ੍ਰਿਪਾ ਕਰੇਇ ॥",
      "transliteration": "har jeeu apanee kripaa karei ||",
      "translation": "When the Dear Lord showers His Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਮੁ ਵਡਿਆਈ ਦੇਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "guramukh naam vadiaaee dei ||1|| rahaau ||",
      "translation": "He blesses the Gurmukh with the glorious greatness of the Naam. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਾਮ ਨਾਮਿ ਜਿਨ ਪ੍ਰੀਤਿ ਪਿਆਰੁ ॥",
      "transliteration": "raam naam jin preet piaar ||",
      "translation": "Those who love the Beloved Name of the Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਪਿ ਉਧਰੇ ਸਭਿ ਕੁਲ ਉਧਾਰਣਹਾਰੁ ॥੨॥",
      "transliteration": "aap udhare sabh kul udhaaranahaar ||2||",
      "translation": "save themselves, and save all their ancestors. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਮਨਮੁਖ ਜਮ ਪੁਰਿ ਜਾਹਿ ॥",
      "transliteration": "bin naavai manamukh jam pur jaahi ||",
      "translation": "Without the Name, the self-willed manmukhs go to the City of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਉਖੇ ਹੋਵਹਿ ਚੋਟਾ ਖਾਹਿ ॥੩॥",
      "transliteration": "aukhe hovahi chotaa khaahi ||3||",
      "translation": "They suffer in pain and endure beatings. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਆਪੇ ਕਰਤਾ ਦੇਵੈ ਸੋਇ ॥",
      "transliteration": "aape karataa devai soi ||",
      "translation": "When the Creator Himself gives,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਪਰਾਪਤਿ ਹੋਇ ॥੪॥੭॥",
      "transliteration": "naanak naam paraapat hoi ||4||7||",
      "translation": "O Nanak, then the mortals receive the Naam. ||4||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੩ ॥",
      "transliteration": "bhairau mahalaa 3 ||",
      "translation": "Bhairao, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗੋਵਿੰਦ ਪ੍ਰੀਤਿ ਸਨਕਾਦਿਕ ਉਧਾਰੇ ॥",
      "transliteration": "govi(n)d preet sanakaadik udhaare ||",
      "translation": "Love of the Lord of the Universe saved Sanak and his brother, the sons of Brahma.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਸਬਦਿ ਬੀਚਾਰੇ ॥੧॥",
      "transliteration": "raam naam sabad beechaare ||1||",
      "translation": "They contemplated the Word of the Shabad, and the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹਰਿ ਜੀਉ ਅਪਣੀ ਕਿਰਪਾ ਧਾਰੁ ॥",
      "transliteration": "har jeeu apanee kirapaa dhaar ||",
      "translation": "O Dear Lord, please shower me with Your Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਮੇ ਲਗੈ ਪਿਆਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "guramukh naame lagai piaar ||1|| rahaau ||",
      "translation": "that as Gurmukh, I may embrace love for Your Name. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਅੰਤਰਿ ਪ੍ਰੀਤਿ ਭਗਤਿ ਸਾਚੀ ਹੋਇ ॥",
      "transliteration": "a(n)tar preet bhagat saachee hoi ||",
      "translation": "Whoever has true loving devotional worship deep within his being",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪੂਰੈ ਗੁਰਿ ਮੇਲਾਵਾ ਹੋਇ ॥੨॥",
      "transliteration": "poorai gur melaavaa hoi ||2||",
      "translation": "meets the Lord, through the Perfect Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਿਜ ਘਰਿ ਵਸੈ ਸਹਜਿ ਸੁਭਾਇ ॥",
      "transliteration": "nij ghar vasai sahaj subhaai ||",
      "translation": "He naturally, intuitively dwells within the home of his own inner being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਮੁ ਵਸੈ ਮਨਿ ਆਇ ॥੩॥",
      "transliteration": "guramukh naam vasai man aai ||3||",
      "translation": "The Naam abides within the mind of the Gurmukh. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਪੇ ਵੇਖੈ ਵੇਖਣਹਾਰੁ ॥",
      "transliteration": "aape vekhai vekhanahaar ||",
      "translation": "The Lord, the Seer, Himself sees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਰਖਹੁ ਉਰ ਧਾਰਿ ॥੪॥੮॥",
      "transliteration": "naanak naam rakhahu ur dhaar ||4||8||",
      "translation": "O Nanak, enshrine the Naam within your heart. ||4||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੩ ॥",
      "transliteration": "bhairau mahalaa 3 ||",
      "translation": "Bhairao, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਲਜੁਗ ਮਹਿ ਰਾਮ ਨਾਮੁ ਉਰ ਧਾਰੁ ॥",
      "transliteration": "kalajug mahi raam naam ur dhaar ||",
      "translation": "In this Dark Age of Kali Yuga, enshrine the Lord's Name within your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਮਾਥੈ ਪਾਵੈ ਛਾਰੁ ॥੧॥",
      "transliteration": "bin naavai maathai paavai chhaar ||1||",
      "translation": "Without the Name, ashes will be blown in your face. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਦੁਲਭੁ ਹੈ ਭਾਈ ॥",
      "transliteration": "raam naam dulabh hai bhaaee ||",
      "translation": "The Lord's Name is so difficult to obtain, O Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਵਸੈ ਮਨਿ ਆਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur parasaad vasai man aaee ||1|| rahaau ||",
      "translation": "By Guru's Grace, it comes to dwell in the mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਜਨ ਭਾਲਹਿ ਸੋਇ ॥",
      "transliteration": "raam naam jan bhaalahi soi ||",
      "translation": "That humble being who seeks the Lord's Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਤੇ ਪ੍ਰਾਪਤਿ ਹੋਇ ॥੨॥",
      "transliteration": "poore gur te praapat hoi ||2||",
      "translation": "receives it from the Perfect Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਰਿ ਕਾ ਭਾਣਾ ਮੰਨਹਿ ਸੇ ਜਨ ਪਰਵਾਣੁ ॥",
      "transliteration": "har kaa bhaanaa ma(n)nahi se jan paravaan ||",
      "translation": "Those humble beings who accept the Will of the Lord, are approved and accepted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਨਾਮ ਨੀਸਾਣੁ ॥੩॥",
      "transliteration": "gur kai sabad naam neesaan ||3||",
      "translation": "Through the Word of the Guru's Shabad, they bear the insignia of the Naam, the Name of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੋ ਸੇਵਹੁ ਜੋ ਕਲ ਰਹਿਆ ਧਾਰਿ ॥",
      "transliteration": "so sevahu jo kal rahiaa dhaar ||",
      "translation": "So serve the One, whose power supports the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਨਾਮੁ ਪਿਆਰਿ ॥੪॥੯॥",
      "transliteration": "naanak guramukh naam piaar ||4||9||",
      "translation": "O Nanak, the Gurmukh loves the Naam. ||4||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੩ ॥",
      "transliteration": "bhairau mahalaa 3 ||",
      "translation": "Bhairao, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਲਜੁਗ ਮਹਿ ਬਹੁ ਕਰਮ ਕਮਾਹਿ ॥",
      "transliteration": "kalajug mahi bahu karam kamaahi ||",
      "translation": "In this Dark Age of Kali Yuga, many rituals are performed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾ ਰੁਤਿ ਨ ਕਰਮ ਥਾਇ ਪਾਹਿ ॥੧॥",
      "transliteration": "naa rut na karam thaai paahi ||1||",
      "translation": "But it is not the time for them, and so they are of no use. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਲਜੁਗ ਮਹਿ ਰਾਮ ਨਾਮੁ ਹੈ ਸਾਰੁ ॥",
      "transliteration": "kalajug mahi raam naam hai saar ||",
      "translation": "In Kali Yuga, the Lord's Name is the most sublime.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਾਚਾ ਲਗੈ ਪਿਆਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "guramukh saachaa lagai piaar ||1|| rahaau ||",
      "translation": "As Gurmukh, be lovingly attached to Truth. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਖੋਜਿ ਘਰੈ ਮਹਿ ਪਾਇਆ ॥",
      "transliteration": "tan man khoj gharai mahi paaiaa ||",
      "translation": "Searching my body and mind, I found Him within the home of my own heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1129_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਰਾਮ ਨਾਮਿ ਚਿਤੁ ਲਾਇਆ ॥੨॥",
      "transliteration": "guramukh raam naam chit laaiaa ||2||",
      "translation": "The Gurmukh centers his consciousness on the Lord's Name. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1129,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
