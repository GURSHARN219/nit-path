{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1136,
  "lineCount": 52,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1136_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ਘਰੁ ੧ ॥",
      "transliteration": "bhairau mahalaa 5 ghar 1 ||",
      "translation": "Bhairao, Fifth Mehl, First House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਗਲੀ ਥੀਤਿ ਪਾਸਿ ਡਾਰਿ ਰਾਖੀ ॥",
      "transliteration": "sagalee theet paas daar raakhee ||",
      "translation": "Setting aside all other days,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਸਟਮ ਥੀਤਿ ਗੋਵਿੰਦ ਜਨਮਾ ਸੀ ॥੧॥",
      "transliteration": "asatam theet govi(n)d janamaa see ||1||",
      "translation": "It is said that the Lord was born on the eighth lunar day. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਰਮਿ ਭੂਲੇ ਨਰ ਕਰਤ ਕਚਰਾਇਣ ॥",
      "transliteration": "bharam bhoole nar karat kacharaain ||",
      "translation": "Deluded and confused by doubt, the mortal practices falsehood.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਨਮ ਮਰਣ ਤੇ ਰਹਤ ਨਾਰਾਇਣ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "janam maran te rahat naaraain ||1|| rahaau ||",
      "translation": "The Lord is beyond birth and death. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਰਿ ਪੰਜੀਰੁ ਖਵਾਇਓ ਚੋਰ ॥",
      "transliteration": "kar pa(n)jeer khavaaio chor ||",
      "translation": "You prepare sweet treats and feed them to your stone god.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਓਹੁ ਜਨਮਿ ਨ ਮਰੈ ਰੇ ਸਾਕਤ ਢੋਰ ॥੨॥",
      "transliteration": "ohu janam na marai re saakat dhor ||2||",
      "translation": "God is not born, and He does not die, you foolish, faithless cynic! ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਗਲ ਪਰਾਧ ਦੇਹਿ ਲੋਰੋਨੀ ॥",
      "transliteration": "sagal paraadh dehi loronee ||",
      "translation": "You sing lullabyes to your stone god - this is the source of all your mistakes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੋ ਮੁਖੁ ਜਲਉ ਜਿਤੁ ਕਹਹਿ ਠਾਕੁਰੁ ਜੋਨੀ ॥੩॥",
      "transliteration": "so mukh jalau jit kahahi thaakur jonee ||3||",
      "translation": "Let that mouth be burnt, which says that our Lord and Master is subject to birth. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਨਮਿ ਨ ਮਰੈ ਨ ਆਵੈ ਨ ਜਾਇ ॥",
      "transliteration": "janam na marai na aavai na jaai ||",
      "translation": "He is not born, and He does not die; He does not come and go in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਨਕ ਕਾ ਪ੍ਰਭੁ ਰਹਿਓ ਸਮਾਇ ॥੪॥੧॥",
      "transliteration": "naanak kaa prabh rahio samaai ||4||1||",
      "translation": "The God of Nanak is pervading and permeating everywhere. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਊਠਤ ਸੁਖੀਆ ਬੈਠਤ ਸੁਖੀਆ ॥",
      "transliteration": "oothat sukheeaa baithat sukheeaa ||",
      "translation": "Standing up, I am at peace; sitting down, I am at peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਭਉ ਨਹੀ ਲਾਗੈ ਜਾਂ ਐਸੇ ਬੁਝੀਆ ॥੧॥",
      "transliteration": "bhau nahee laagai jaa(n) aise bujheeaa ||1||",
      "translation": "I feel no fear, because this is what I understand. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰਾਖਾ ਏਕੁ ਹਮਾਰਾ ਸੁਆਮੀ ॥",
      "transliteration": "raakhaa ek hamaaraa suaamee ||",
      "translation": "The One Lord, my Lord and Master, is my Protector.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਗਲ ਘਟਾ ਕਾ ਅੰਤਰਜਾਮੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sagal ghataa kaa a(n)tarajaamee ||1|| rahaau ||",
      "translation": "He is the Inner-knower, the Searcher of Hearts. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੋਇ ਅਚਿੰਤਾ ਜਾਗਿ ਅਚਿੰਤਾ ॥",
      "transliteration": "soi achi(n)taa jaag achi(n)taa ||",
      "translation": "I sleep without worry, and I awake without worry.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਹਾ ਕਹਾਂ ਪ੍ਰਭੁ ਤੂੰ ਵਰਤੰਤਾ ॥੨॥",
      "transliteration": "jahaa kahaa(n) prabh too(n) varata(n)taa ||2||",
      "translation": "You, O God, are pervading everywhere. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਘਰਿ ਸੁਖਿ ਵਸਿਆ ਬਾਹਰਿ ਸੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "ghar sukh vasiaa baahar sukh paaiaa ||",
      "translation": "I dwell in peace in my home, and I am at peace outside.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰਿ ਮੰਤ੍ਰੁ ਦ੍ਰਿੜਾਇਆ ॥੩॥੨॥",
      "transliteration": "kahu naanak gur ma(n)tr driRaaiaa ||3||2||",
      "translation": "Says Nanak, the Guru has implanted His Mantra within me. ||3||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਵਰਤ ਨ ਰਹਉ ਨ ਮਹ ਰਮਦਾਨਾ ॥",
      "transliteration": "varat na rahau na mah ramadaanaa ||",
      "translation": "I do not keep fasts, nor do I observe the month of Ramadaan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਸੁ ਸੇਵੀ ਜੋ ਰਖੈ ਨਿਦਾਨਾ ॥੧॥",
      "transliteration": "tis sevee jo rakhai nidaanaa ||1||",
      "translation": "I serve only the One, who will protect me in the end. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਏਕੁ ਗੁਸਾਈ ਅਲਹੁ ਮੇਰਾ ॥",
      "transliteration": "ek gusaaee alahu meraa ||",
      "translation": "The One Lord, the Lord of the World, is my God Allah.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਿੰਦੂ ਤੁਰਕ ਦੁਹਾਂ ਨੇਬੇਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "hi(n)doo turak duhaa(n) neberaa ||1|| rahaau ||",
      "translation": "He adminsters justice to both Hindus and Muslims. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਜ ਕਾਬੈ ਜਾਉ ਨ ਤੀਰਥ ਪੂਜਾ ॥",
      "transliteration": "haj kaabai jaau na teerath poojaa ||",
      "translation": "I do not make pilgrimages to Mecca, nor do I worship at Hindu sacred shrines.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਏਕੋ ਸੇਵੀ ਅਵਰੁ ਨ ਦੂਜਾ ॥੨॥",
      "transliteration": "eko sevee avar na doojaa ||2||",
      "translation": "I serve the One Lord, and not any other. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪੂਜਾ ਕਰਉ ਨ ਨਿਵਾਜ ਗੁਜਾਰਉ ॥",
      "transliteration": "poojaa karau na nivaaj gujaarau ||",
      "translation": "I do not perform Hindu worship services, nor do I offer the Muslim prayers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਏਕ ਨਿਰੰਕਾਰ ਲੇ ਰਿਦੈ ਨਮਸਕਾਰਉ ॥੩॥",
      "transliteration": "ek nira(n)kaar le ridai namasakaarau ||3||",
      "translation": "I have taken the One Formless Lord into my heart; I humbly worship Him there. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾ ਹਮ ਹਿੰਦੂ ਨ ਮੁਸਲਮਾਨ ॥",
      "transliteration": "naa ham hi(n)doo na musalamaan ||",
      "translation": "I am not a Hindu, nor am I a Muslim.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਲਹ ਰਾਮ ਕੇ ਪਿੰਡੁ ਪਰਾਨ ॥੪॥",
      "transliteration": "alah raam ke pi(n)d paraan ||4||",
      "translation": "My body and breath of life belong to Allah - to Raam - the God of both. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਇਹੁ ਕੀਆ ਵਖਾਨਾ ॥",
      "transliteration": "kahu kabeer ihu keeaa vakhaanaa ||",
      "translation": "Says Kabeer, this is what I say:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰ ਪੀਰ ਮਿਲਿ ਖੁਦਿ ਖਸਮੁ ਪਛਾਨਾ ॥੫॥੩॥",
      "transliteration": "gur peer mil khud khasam pachhaanaa ||5||3||",
      "translation": "meeting with the Guru, my Spiritual Teacher, I realize God, my Lord and Master. ||5||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦਸ ਮਿਰਗੀ ਸਹਜੇ ਬੰਧਿ ਆਨੀ ॥",
      "transliteration": "das miragee sahaje ba(n)dh aanee ||",
      "translation": "I easily tied up the deer - the ten sensory organs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪਾਂਚ ਮਿਰਗ ਬੇਧੇ ਸਿਵ ਕੀ ਬਾਨੀ ॥੧॥",
      "transliteration": "paa(n)ch mirag bedhe siv kee baanee ||1||",
      "translation": "I shot five of the desires with the Word of the Lord's Bani. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੰਤਸੰਗਿ ਲੇ ਚੜਿਓ ਸਿਕਾਰ ॥",
      "transliteration": "sa(n)tasa(n)g le chaRio sikaar ||",
      "translation": "I go out hunting with the Saints,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮ੍ਰਿਗ ਪਕਰੇ ਬਿਨੁ ਘੋਰ ਹਥੀਆਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mrig pakare bin ghor hatheeaar ||1|| rahaau ||",
      "translation": "and we capture the deer without horses or weapons. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਖੇਰ ਬਿਰਤਿ ਬਾਹਰਿ ਆਇਓ ਧਾਇ ॥",
      "transliteration": "aakher birat baahar aaio dhaai ||",
      "translation": "My mind used to run around outside hunting.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਹੇਰਾ ਪਾਇਓ ਘਰ ਕੈ ਗਾਂਇ ॥੨॥",
      "transliteration": "aheraa paaio ghar kai gaa(n)i ||2||",
      "translation": "But now, I have found the game within the home of my body-village. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮ੍ਰਿਗ ਪਕਰੇ ਘਰਿ ਆਣੇ ਹਾਟਿ ॥",
      "transliteration": "mrig pakare ghar aane haat ||",
      "translation": "I caught the deer and brought them home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚੁਖ ਚੁਖ ਲੇ ਗਏ ਬਾਂਢੇ ਬਾਟਿ ॥੩॥",
      "transliteration": "chukh chukh le gae baa(n)dhe baat ||3||",
      "translation": "Dividing them up, I shared them, bit by bit. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਏਹੁ ਅਹੇਰਾ ਕੀਨੋ ਦਾਨੁ ॥",
      "transliteration": "ehu aheraa keeno daan ||",
      "translation": "God has given this gift.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਕੈ ਘਰਿ ਕੇਵਲ ਨਾਮੁ ॥੪॥੪॥",
      "transliteration": "naanak kai ghar keval naam ||4||4||",
      "translation": "Nanak's home is filled with the Naam, the Name of the Lord. ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੇ ਸਉ ਲੋਚਿ ਲੋਚਿ ਖਾਵਾਇਆ ॥",
      "transliteration": "je sau loch loch khaavaaiaa ||",
      "translation": "Even though he may be fed with hundreds of longings and yearnings,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਾਕਤ ਹਰਿ ਹਰਿ ਚੀਤਿ ਨ ਆਇਆ ॥੧॥",
      "transliteration": "saakat har har cheet na aaiaa ||1||",
      "translation": "still the faithless cynic does not remember the Lord, Har, Har. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਕੀ ਲੇਹੁ ਮਤੇ ॥",
      "transliteration": "sa(n)t janaa kee lehu mate ||",
      "translation": "Take in the teachings of the humble Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਪਾਵਹੁ ਪਰਮ ਗਤੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saadhasa(n)g paavahu param gate ||1|| rahaau ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, you shall obtain the supreme status. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪਾਥਰ ਕਉ ਬਹੁ ਨੀਰੁ ਪਵਾਇਆ ॥",
      "transliteration": "paathar kau bahu neer pavaaiaa ||",
      "translation": "Stones may be kept under water for a long time.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1136_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਹ ਭੀਗੈ ਅਧਿਕ ਸੂਕਾਇਆ ॥੨॥",
      "transliteration": "nah bheegai adhik sookaaiaa ||2||",
      "translation": "Even so, they do not absorb the water; they remain hard and dry. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1136,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
