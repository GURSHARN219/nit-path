{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1137,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1137_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਖਟੁ ਸਾਸਤ੍ਰ ਮੂਰਖੈ ਸੁਨਾਇਆ ॥",
      "transliteration": "khat saasatr moorakhai sunaaiaa ||",
      "translation": "The six Shaastras may be read to a fool,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜੈਸੇ ਦਹ ਦਿਸ ਪਵਨੁ ਝੁਲਾਇਆ ॥੩॥",
      "transliteration": "jaise dah dis pavan jhulaaiaa ||3||",
      "translation": "but it is like the wind blowing in the ten directions. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਨੁ ਕਣ ਖਲਹਾਨੁ ਜੈਸੇ ਗਾਹਨ ਪਾਇਆ ॥",
      "transliteration": "bin kan khalahaan jaise gaahan paaiaa ||",
      "translation": "It is like threshing a crop without any corn - nothing is gained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤਿਉ ਸਾਕਤ ਤੇ ਕੋ ਨ ਬਰਾਸਾਇਆ ॥੪॥",
      "transliteration": "tiu saakat te ko na baraasaaiaa ||4||",
      "translation": "In the same way, no benefit comes from the faithless cynic. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਤ ਹੀ ਲਾਗਾ ਜਿਤੁ ਕੋ ਲਾਇਆ ॥",
      "transliteration": "tit hee laagaa jit ko laaiaa ||",
      "translation": "As the Lord attaches them, so are all attached.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਪ੍ਰਭਿ ਬਣਤ ਬਣਾਇਆ ॥੫॥੫॥",
      "transliteration": "kahu naanak prabh banat banaaiaa ||5||5||",
      "translation": "Says Nanak, God has formed such a form. ||5||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੀਉ ਪ੍ਰਾਣ ਜਿਨਿ ਰਚਿਓ ਸਰੀਰ ॥",
      "transliteration": "jeeu praan jin rachio sareer ||",
      "translation": "He created the soul, the breath of life and the body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਿਨਹਿ ਉਪਾਏ ਤਿਸ ਕਉ ਪੀਰ ॥੧॥",
      "transliteration": "jinahi upaae tis kau peer ||1||",
      "translation": "He created all beings, and knows their pains. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰੁ ਗੋਬਿੰਦੁ ਜੀਅ ਕੈ ਕਾਮ ॥",
      "transliteration": "gur gobi(n)d jee kai kaam ||",
      "translation": "The Guru, the Lord of the Universe, is the Helper of the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਲਤਿ ਪਲਤਿ ਜਾ ਕੀ ਸਦ ਛਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "halat palat jaa kee sad chhaam ||1|| rahaau ||",
      "translation": "Here and herafter, He always provides shade. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪ੍ਰਭੁ ਆਰਾਧਨ ਨਿਰਮਲ ਰੀਤਿ ॥",
      "transliteration": "prabh aaraadhan niramal reet ||",
      "translation": "Worship and adoration of God is the pure way of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਬਿਨਸੀ ਬਿਪਰੀਤਿ ॥੨॥",
      "transliteration": "saadhasa(n)g binasee bipareet ||2||",
      "translation": "In the Saadh Sangat, the Company of the Holy, the love of duality vanishes. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੀਤ ਹੀਤ ਧਨੁ ਨਹ ਪਾਰਣਾ ॥",
      "transliteration": "meet heet dhan nah paaranaa ||",
      "translation": "Friends, well-wishers and wealth will not support you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਧੰਨਿ ਧੰਨਿ ਮੇਰੇ ਨਾਰਾਇਣਾ ॥੩॥",
      "transliteration": "dha(n)n dha(n)n mere naaraainaa ||3||",
      "translation": "Blessed, blessed is my Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਨਕੁ ਬੋਲੈ ਅੰਮ੍ਰਿਤ ਬਾਣੀ ॥",
      "transliteration": "naanak bolai a(n)mrit baanee ||",
      "translation": "Nanak utters the Ambrosial Bani of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਏਕ ਬਿਨਾ ਦੂਜਾ ਨਹੀ ਜਾਣੀ ॥੪॥੬॥",
      "transliteration": "ek binaa doojaa nahee jaanee ||4||6||",
      "translation": "Except the One Lord, he does not know any other at all. ||4||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਗੈ ਦਯੁ ਪਾਛੈ ਨਾਰਾਇਣ ॥",
      "transliteration": "aagai day paachhai naaraain ||",
      "translation": "The Lord is in front of me, and the Lord is behind me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮਧਿ ਭਾਗਿ ਹਰਿ ਪ੍ਰੇਮ ਰਸਾਇਣ ॥੧॥",
      "transliteration": "madh bhaag har prem rasaain ||1||",
      "translation": "My Beloved Lord, the Source of Nectar, is in the middle as well. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪ੍ਰਭੂ ਹਮਾਰੈ ਸਾਸਤ੍ਰ ਸਉਣ ॥",
      "transliteration": "prabhoo hamaarai saasatr saun ||",
      "translation": "God is my Shaastra and my favorable omen.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਆਨੰਦ ਗ੍ਰਿਹ ਭਉਣ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sookh sahaj aana(n)d grih bhaun ||1|| rahaau ||",
      "translation": "In His Home and Mansion, I find peace, poise and bliss. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਰਸਨਾ ਨਾਮੁ ਕਰਨ ਸੁਣਿ ਜੀਵੇ ॥",
      "transliteration": "rasanaa naam karan sun jeeve ||",
      "translation": "Chanting the Naam, the Name of the Lord, with my tongue, and hearing it with my ears, I live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪ੍ਰਭੁ ਸਿਮਰਿ ਸਿਮਰਿ ਅਮਰ ਥਿਰੁ ਥੀਵੇ ॥੨॥",
      "transliteration": "prabh simar simar amar thir theeve ||2||",
      "translation": "Meditating, meditating in remembrance on God, I have become eternal, permanent and stable. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਦੂਖ ਨਿਵਾਰੇ ॥",
      "transliteration": "janam janam ke dookh nivaare ||",
      "translation": "The pains of countless lifetimes have been erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਨਹਦ ਸਬਦ ਵਜੇ ਦਰਬਾਰੇ ॥੩॥",
      "transliteration": "anahad sabad vaje darabaare ||3||",
      "translation": "The Unstruck Sound-current of the Shabad, the Word of God, vibrates in the Court of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭਿ ਲੀਏ ਮਿਲਾਏ ॥",
      "transliteration": "kar kirapaa prabh leee milaae ||",
      "translation": "Granting His Grace, God has blended me with Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਨਕ ਪ੍ਰਭ ਸਰਣਾਗਤਿ ਆਏ ॥੪॥੭॥",
      "transliteration": "naanak prabh saranaagat aae ||4||7||",
      "translation": "Nanak has entered the Sanctuary of God. ||4||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕੋਟਿ ਮਨੋਰਥ ਆਵਹਿ ਹਾਥ ॥",
      "transliteration": "kot manorath aavahi haath ||",
      "translation": "It brings millions of desires to fulfillment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਮ ਮਾਰਗ ਕੈ ਸੰਗੀ ਪਾਂਥ ॥੧॥",
      "transliteration": "jam maarag kai sa(n)gee paa(n)th ||1||",
      "translation": "On the Path of Death, It will go with you and help you. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੰਗਾ ਜਲੁ ਗੁਰ ਗੋਬਿੰਦ ਨਾਮ ॥",
      "transliteration": "ga(n)gaa jal gur gobi(n)d naam ||",
      "translation": "The Naam, the Name of the Lord of the Universe, is the holy water of the Ganges.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜੋ ਸਿਮਰੈ ਤਿਸ ਕੀ ਗਤਿ ਹੋਵੈ ਪੀਵਤ ਬਹੁੜਿ ਨ ਜੋਨਿ ਭ੍ਰਮਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jo simarai tis kee gat hovai peevat bahuR na jon bhramaam ||1|| rahaau ||",
      "translation": "Whoever meditates on it, is saved; drinking it in, the mortal does not wander in reincarnation again. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪੂਜਾ ਜਾਪ ਤਾਪ ਇਸਨਾਨ ॥",
      "transliteration": "poojaa jaap taap isanaan ||",
      "translation": "It is my worship, meditation, austerity and cleansing bath.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਿਮਰਤ ਨਾਮ ਭਏ ਨਿਹਕਾਮ ॥੨॥",
      "transliteration": "simarat naam bhae nihakaam ||2||",
      "translation": "Meditating in remembrance on the Naam, I have become free of desire. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਰਾਜ ਮਾਲ ਸਾਦਨ ਦਰਬਾਰ ॥",
      "transliteration": "raaj maal saadan darabaar ||",
      "translation": "It is my domain and empire, wealth, mansion and court.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਿਮਰਤ ਨਾਮ ਪੂਰਨ ਆਚਾਰ ॥੩॥",
      "transliteration": "simarat naam pooran aachaar ||3||",
      "translation": "Meditating in remembrance on the Naam brings perfect conduct. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਇਹੁ ਕੀਆ ਬੀਚਾਰੁ ॥",
      "transliteration": "naanak daas ihu keeaa beechaar ||",
      "translation": "Slave Nanak has deliberated, and has come to this conclusion:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਨਾਮ ਮਿਥਿਆ ਸਭ ਛਾਰੁ ॥੪॥੮॥",
      "transliteration": "bin har naam mithiaa sabh chhaar ||4||8||",
      "translation": "Without the Lord's Name, everything is false and worthless, like ashes. ||4||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਲੇਪੁ ਨ ਲਾਗੋ ਤਿਲ ਕਾ ਮੂਲਿ ॥",
      "transliteration": "lep na laago til kaa mool ||",
      "translation": "The poison had absolutely no harmful effect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੁਸਟੁ ਬ੍ਰਾਹਮਣੁ ਮੂਆ ਹੋਇ ਕੈ ਸੂਲ ॥੧॥",
      "transliteration": "dusat braahaman mooaa hoi kai sool ||1||",
      "translation": "But the wicked Brahmin died in pain. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਰਿ ਜਨ ਰਾਖੇ ਪਾਰਬ੍ਰਹਮਿ ਆਪਿ ॥",
      "transliteration": "har jan raakhe paarabraham aap ||",
      "translation": "The Supreme Lord God Himself has saved His humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਾਪੀ ਮੂਆ ਗੁਰ ਪਰਤਾਪਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "paapee mooaa gur parataap ||1|| rahaau ||",
      "translation": "The sinner died through the Power of the Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਪਣਾ ਖਸਮੁ ਜਨਿ ਆਪਿ ਧਿਆਇਆ ॥",
      "transliteration": "apanaa khasam jan aap dhiaaiaa ||",
      "translation": "The humble servant of the Lord and Master meditates on Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਇਆਣਾ ਪਾਪੀ ਓਹੁ ਆਪਿ ਪਚਾਇਆ ॥੨॥",
      "transliteration": "iaanaa paapee ohu aap pachaaiaa ||2||",
      "translation": "He Himself has destroyed the ignorant sinner. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰਭ ਮਾਤ ਪਿਤਾ ਅਪਣੇ ਦਾਸ ਕਾ ਰਖਵਾਲਾ ॥",
      "transliteration": "prabh maat pitaa apane daas kaa rakhavaalaa ||",
      "translation": "God is the Mother, the Father and the Protector of His slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਿੰਦਕ ਕਾ ਮਾਥਾ ਈਹਾਂ ਊਹਾ ਕਾਲਾ ॥੩॥",
      "transliteration": "ni(n)dak kaa maathaa eehaa(n) oohaa kaalaa ||3||",
      "translation": "The face of the slanderer, here and hereafter, is blackened. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਕੀ ਪਰਮੇਸਰਿ ਸੁਣੀ ਅਰਦਾਸਿ ॥",
      "transliteration": "jan naanak kee paramesar sunee aradaas ||",
      "translation": "The Transcendent Lord has heard the prayer of servant Nanak.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਮਲੇਛੁ ਪਾਪੀ ਪਚਿਆ ਭਇਆ ਨਿਰਾਸੁ ॥੪॥੯॥",
      "transliteration": "malechh paapee pachiaa bhaiaa niraas ||4||9||",
      "translation": "The filthy sinner lost hope and died. ||4||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਖੂਬੁ ਖੂਬੁ ਖੂਬੁ ਖੂਬੁ ਖੂਬੁ ਤੇਰੋ ਨਾਮੁ ॥",
      "transliteration": "khoob khoob khoob khoob khoob tero naam ||",
      "translation": "Excellent, excellent, excellent, excellent, excellent is Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਝੂਠੁ ਝੂਠੁ ਝੂਠੁ ਝੂਠੁ ਦੁਨੀ ਗੁਮਾਨੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jhooth jhooth jhooth jhooth dunee gumaan ||1|| rahaau ||",
      "translation": "False, false, false, false is pride in the world. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1137_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨਗਜ ਤੇਰੇ ਬੰਦੇ ਦੀਦਾਰੁ ਅਪਾਰੁ ॥",
      "transliteration": "nagaj tere ba(n)de deedaar apaar ||",
      "translation": "The glorious vision of Your slaves, O Infinite Lord, is wonderful and beauteous.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1137,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
