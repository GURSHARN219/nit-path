{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1138,
  "lineCount": 46,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1138_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਸਭ ਦੁਨੀਆ ਛਾਰੁ ॥੧॥",
      "transliteration": "naam binaa sabh duneeaa chhaar ||1||",
      "translation": "Without the Naam, the Name of the Lord, the whole world is just ashes. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਚਰਜੁ ਤੇਰੀ ਕੁਦਰਤਿ ਤੇਰੇ ਕਦਮ ਸਲਾਹ ॥",
      "transliteration": "acharaj teree kudarat tere kadam salaah ||",
      "translation": "Your Creative Power is marvellous, and Your Lotus Feet are admirable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗਨੀਵ ਤੇਰੀ ਸਿਫਤਿ ਸਚੇ ਪਾਤਿਸਾਹ ॥੨॥",
      "transliteration": "ganeev teree siphat sache paatisaah ||2||",
      "translation": "Your Praise is priceless, O True King. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨੀਧਰਿਆ ਧਰ ਪਨਹ ਖੁਦਾਇ ॥",
      "transliteration": "needhariaa dhar panah khudaai ||",
      "translation": "God is the Support of the unsupported.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗਰੀਬ ਨਿਵਾਜੁ ਦਿਨੁ ਰੈਣਿ ਧਿਆਇ ॥੩॥",
      "transliteration": "gareeb nivaaj din rain dhiaai ||3||",
      "translation": "Meditate day and night on the Cherisher of the meek and humble. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਖੁਦਿ ਖਸਮ ਮਿਹਰਵਾਨ ॥",
      "transliteration": "naanak kau khud khasam miharavaan ||",
      "translation": "God has been merciful to Nanak.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਲਹੁ ਨ ਵਿਸਰੈ ਦਿਲ ਜੀਅ ਪਰਾਨ ॥੪॥੧੦॥",
      "transliteration": "alahu na visarai dil jee paraan ||4||10||",
      "translation": "May I never forget God; He is my heart, my soul, my breath of life. ||4||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਾਚ ਪਦਾਰਥੁ ਗੁਰਮੁਖਿ ਲਹਹੁ ॥",
      "transliteration": "saach padaarath guramukh lahahu ||",
      "translation": "As Gurmukh, obtain the true wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪ੍ਰਭ ਕਾ ਭਾਣਾ ਸਤਿ ਕਰਿ ਸਹਹੁ ॥੧॥",
      "transliteration": "prabh kaa bhaanaa sat kar sahahu ||1||",
      "translation": "Accept the Will of God as True. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੀਵਤ ਜੀਵਤ ਜੀਵਤ ਰਹਹੁ ॥",
      "transliteration": "jeevat jeevat jeevat rahahu ||",
      "translation": "Live, live, live forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਮ ਰਸਾਇਣੁ ਨਿਤ ਉਠਿ ਪੀਵਹੁ ॥",
      "transliteration": "raam rasaain nit uth peevahu ||",
      "translation": "Rise early each day, and drink in the Nectar of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਹਰਿ ਹਰਿ ਰਸਨਾ ਕਹਹੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har har har har rasanaa kahahu ||1|| rahaau ||",
      "translation": "With your tongue, chant the Name of the Lord, Har, Har, Har, Har. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਲਿਜੁਗ ਮਹਿ ਇਕ ਨਾਮਿ ਉਧਾਰੁ ॥",
      "transliteration": "kalijug mahi ik naam udhaar ||",
      "translation": "In this Dark Age of Kali Yuga, the One Name alone shall save you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਨਕੁ ਬੋਲੈ ਬ੍ਰਹਮ ਬੀਚਾਰੁ ॥੨॥੧੧॥",
      "transliteration": "naanak bolai braham beechaar ||2||11||",
      "translation": "Nanak speaks the wisdom of God. ||2||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵਿ ਸਰਬ ਫਲ ਪਾਏ ॥",
      "transliteration": "satigur sev sarab phal paae ||",
      "translation": "Serving the True Guru, all fruits and rewards are obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੀ ਮੈਲੁ ਮਿਟਾਏ ॥੧॥",
      "transliteration": "janam janam kee mail mitaae ||1||",
      "translation": "The filth of so many lifetimes is washed away. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪਤਿਤ ਪਾਵਨ ਪ੍ਰਭ ਤੇਰੋ ਨਾਉ ॥",
      "transliteration": "patit paavan prabh tero naau ||",
      "translation": "Your Name, God, is the Purifier of sinners.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪੂਰਬਿ ਕਰਮ ਲਿਖੇ ਗੁਣ ਗਾਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "poorab karam likhe gun gaau ||1|| rahaau ||",
      "translation": "Because of the karma of my past deeds, I sing the Glorious Praises of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਾਧੂ ਸੰਗਿ ਹੋਵੈ ਉਧਾਰੁ ॥",
      "transliteration": "saadhoo sa(n)g hovai udhaar ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, I am saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੋਭਾ ਪਾਵੈ ਪ੍ਰਭ ਕੈ ਦੁਆਰ ॥੨॥",
      "transliteration": "sobhaa paavai prabh kai duaar ||2||",
      "translation": "I am blessed with honor in God's Court. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਰਬ ਕਲਿਆਣ ਚਰਣ ਪ੍ਰਭ ਸੇਵਾ ॥",
      "transliteration": "sarab kaliaan charan prabh sevaa ||",
      "translation": "Serving at God's Feet, all comforts are obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਧੂਰਿ ਬਾਛਹਿ ਸਭਿ ਸੁਰਿ ਨਰ ਦੇਵਾ ॥੩॥",
      "transliteration": "dhoor baachhahi sabh sur nar devaa ||3||",
      "translation": "All the angels and demi-gods long for the dust of the feet of such beings. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਨਕ ਪਾਇਆ ਨਾਮ ਨਿਧਾਨੁ ॥",
      "transliteration": "naanak paaiaa naam nidhaan ||",
      "translation": "Nanak has obtained the treasure of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰਿ ਜਪਿ ਜਪਿ ਉਧਰਿਆ ਸਗਲ ਜਹਾਨੁ ॥੪॥੧੨॥",
      "transliteration": "har jap jap udhariaa sagal jahaan ||4||12||",
      "translation": "Chanting and meditating on the Lord, the whole world is saved. ||4||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਪਣੇ ਦਾਸ ਕਉ ਕੰਠਿ ਲਗਾਵੈ ॥",
      "transliteration": "apane daas kau ka(n)th lagaavai ||",
      "translation": "God hugs His slave close in His Embrace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਿੰਦਕ ਕਉ ਅਗਨਿ ਮਹਿ ਪਾਵੈ ॥੧॥",
      "transliteration": "ni(n)dak kau agan mahi paavai ||1||",
      "translation": "He throws the slanderer into the fire. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਾਪੀ ਤੇ ਰਾਖੇ ਨਾਰਾਇਣ ॥",
      "transliteration": "paapee te raakhe naaraain ||",
      "translation": "The Lord saves His servants from the sinners.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪਾਪੀ ਕੀ ਗਤਿ ਕਤਹੂ ਨਾਹੀ ਪਾਪੀ ਪਚਿਆ ਆਪ ਕਮਾਇਣ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "paapee kee gat katahoo naahee paapee pachiaa aap kamaain ||1|| rahaau ||",
      "translation": "No one can save the sinner. The sinner is destroyed by his own actions. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦਾਸ ਰਾਮ ਜੀਉ ਲਾਗੀ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "daas raam jeeu laagee preet ||",
      "translation": "The Lord's slave is in love with the Dear Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਿੰਦਕ ਕੀ ਹੋਈ ਬਿਪਰੀਤਿ ॥੨॥",
      "transliteration": "ni(n)dak kee hoee bipareet ||2||",
      "translation": "The slanderer loves something else. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮਿ ਅਪਣਾ ਬਿਰਦੁ ਪ੍ਰਗਟਾਇਆ ॥",
      "transliteration": "paarabraham apanaa birad pragataaiaa ||",
      "translation": "The Supreme Lord God has revealed His Innate Nature.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੋਖੀ ਅਪਣਾ ਕੀਤਾ ਪਾਇਆ ॥੩॥",
      "transliteration": "dokhee apanaa keetaa paaiaa ||3||",
      "translation": "The evil-doer obtains the fruits of his own actions. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਇ ਨ ਜਾਈ ਰਹਿਆ ਸਮਾਈ ॥",
      "transliteration": "aai na jaaee rahiaa samaaee ||",
      "translation": "God does not come or go; He is All-pervading and permeating.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਹਰਿ ਕੀ ਸਰਣਾਈ ॥੪॥੧੩॥",
      "transliteration": "naanak daas har kee saranaaee ||4||13||",
      "translation": "Slave Nanak seeks the Sanctuary of the Lord. ||4||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਗੁ ਭੈਰਉ ਮਹਲਾ ੫ ਚਉਪਦੇ ਘਰੁ ੨ ॥",
      "transliteration": "raag bhairau mahalaa 5 chaupade ghar 2 ||",
      "translation": "Raag Bhairao, Fifth Mehl, Chau-Padhay, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸ੍ਰੀਧਰ ਮੋਹਨ ਸਗਲ ਉਪਾਵਨ ਨਿਰੰਕਾਰ ਸੁਖਦਾਤਾ ॥",
      "transliteration": "sreedhar mohan sagal upaavan nira(n)kaar sukhadaataa ||",
      "translation": "The Fascinating Lord, the Creator of all, the Formless Lord, is the Giver of Peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਐਸਾ ਪ੍ਰਭੁ ਛੋਡਿ ਕਰਹਿ ਅਨ ਸੇਵਾ ਕਵਨ ਬਿਖਿਆ ਰਸ ਮਾਤਾ ॥੧॥",
      "transliteration": "aisaa prabh chhod karahi an sevaa kavan bikhiaa ras maataa ||1||",
      "translation": "You have abandoned this Lord, and you serve another. Why are you intoxicated with the pleasures of corruption? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰੇ ਮਨ ਮੇਰੇ ਤੂ ਗੋਵਿਦ ਭਾਜੁ ॥",
      "transliteration": "re man mere too govid bhaaj ||",
      "translation": "O my mind, meditate on the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅਵਰ ਉਪਾਵ ਸਗਲ ਮੈ ਦੇਖੇ ਜੋ ਚਿਤਵੀਐ ਤਿਤੁ ਬਿਗਰਸਿ ਕਾਜੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "avar upaav sagal mai dekhe jo chitaveeai tit bigaras kaaj ||1|| rahaau ||",
      "translation": "I have seen all other sorts of efforts; whatever you can think of, will only bring failure. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਠਾਕੁਰੁ ਛੋਡਿ ਦਾਸੀ ਕਉ ਸਿਮਰਹਿ ਮਨਮੁਖ ਅੰਧ ਅਗਿਆਨਾ ॥",
      "transliteration": "thaakur chhod daasee kau simarahi manamukh a(n)dh agiaanaa ||",
      "translation": "The blind, ignorant, self-willed manmukhs forsake their Lord and Master, and dwell on His slave Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਰਿ ਕੀ ਭਗਤਿ ਕਰਹਿ ਤਿਨ ਨਿੰਦਹਿ ਨਿਗੁਰੇ ਪਸੂ ਸਮਾਨਾ ॥੨॥",
      "transliteration": "har kee bhagat karahi tin ni(n)dahi nigure pasoo samaanaa ||2||",
      "translation": "They slander those who worship their Lord; they are like beasts, without a Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1138_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਤਨੁ ਧਨੁ ਸਭੁ ਪ੍ਰਭ ਕਾ ਸਾਕਤ ਕਹਤੇ ਮੇਰਾ ॥",
      "transliteration": "jeeu pi(n)d tan dhan sabh prabh kaa saakat kahate meraa ||",
      "translation": "Soul, life, body and wealth all belong to God, but the faithless cynics claim that they own them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1138,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
