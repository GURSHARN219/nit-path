{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1140,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1140_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਕੇ ਸਭਿ ਕਾਜ ਸਵਾਰਿ ॥",
      "transliteration": "tis jan ke sabh kaaj savaar ||",
      "translation": "all his affairs are resolved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਤਿਸ ਕਾ ਰਾਖਾ ਏਕੋ ਸੋਇ ॥",
      "transliteration": "tis kaa raakhaa eko soi ||",
      "translation": "The One Lord is his Protector.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਅਪੜਿ ਨ ਸਾਕੈ ਕੋਇ ॥੪॥੪॥੧੭॥",
      "transliteration": "jan naanak apaR na saakai koi ||4||4||17||",
      "translation": "O servant Nanak, no one can equal him. ||4||4||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਉ ਕੜੀਐ ਜੇ ਹੋਵੈ ਬਾਹਰਿ ॥",
      "transliteration": "tau kaReeai je hovai baahar ||",
      "translation": "We should feel sad, if God were beyond us.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਉ ਕੜੀਐ ਜੇ ਵਿਸਰੈ ਨਰਹਰਿ ॥",
      "transliteration": "tau kaReeai je visarai narahar ||",
      "translation": "We should feel sad, if we forget the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਉ ਕੜੀਐ ਜੇ ਦੂਜਾ ਭਾਏ ॥",
      "transliteration": "tau kaReeai je doojaa bhaae ||",
      "translation": "We should feel sad, if we are in love with duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਿਆ ਕੜੀਐ ਜਾਂ ਰਹਿਆ ਸਮਾਏ ॥੧॥",
      "transliteration": "kiaa kaReeai jaa(n) rahiaa samaae ||1||",
      "translation": "But why should we feel sad? The Lord is pervading everywhere. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਾਇਆ ਮੋਹਿ ਕੜੇ ਕੜਿ ਪਚਿਆ ॥",
      "transliteration": "maaiaa mohi kaRe kaR pachiaa ||",
      "translation": "In love and attachment to Maya, the mortals are sad, and are consumed by sadness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਭ੍ਰਮਿ ਭ੍ਰਮਿ ਭ੍ਰਮਿ ਖਪਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin naavai bhram bhram bhram khapiaa ||1|| rahaau ||",
      "translation": "Without the Name, they wander and wander and wander, and waste away. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤਉ ਕੜੀਐ ਜੇ ਦੂਜਾ ਕਰਤਾ ॥",
      "transliteration": "tau kaReeai je doojaa karataa ||",
      "translation": "We should feel sad, if there were another Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਉ ਕੜੀਐ ਜੇ ਅਨਿਆਇ ਕੋ ਮਰਤਾ ॥",
      "transliteration": "tau kaReeai je aniaai ko marataa ||",
      "translation": "We should feel sad, if someone dies by injustice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਉ ਕੜੀਐ ਜੇ ਕਿਛੁ ਜਾਣੈ ਨਾਹੀ ॥",
      "transliteration": "tau kaReeai je kichh jaanai naahee ||",
      "translation": "We should feel sad, if something were not known to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿਆ ਕੜੀਐ ਜਾਂ ਭਰਪੂਰਿ ਸਮਾਹੀ ॥੨॥",
      "transliteration": "kiaa kaReeai jaa(n) bharapoor samaahee ||2||",
      "translation": "But why should we feel sad? The Lord is totally permeating everywhere. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਉ ਕੜੀਐ ਜੇ ਕਿਛੁ ਹੋਇ ਧਿਙਾਣੈ ॥",
      "transliteration": "tau kaReeai je kichh hoi dhingaanai ||",
      "translation": "We should feel sad, if God were a tyrant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਉ ਕੜੀਐ ਜੇ ਭੂਲਿ ਰੰਞਾਣੈ ॥",
      "transliteration": "tau kaReeai je bhool ra(n)njaanai ||",
      "translation": "We should feel sad, if He made us suffer by mistake.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰਿ ਕਹਿਆ ਜੋ ਹੋਇ ਸਭੁ ਪ੍ਰਭ ਤੇ ॥",
      "transliteration": "gur kahiaa jo hoi sabh prabh te ||",
      "translation": "The Guru says that whatever happens is all by God's Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਬ ਕਾੜਾ ਛੋਡਿ ਅਚਿੰਤ ਹਮ ਸੋਤੇ ॥੩॥",
      "transliteration": "tab kaaRaa chhod achi(n)t ham sote ||3||",
      "translation": "So I have abandoned sadness, and I now sleep without anxiety. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪ੍ਰਭ ਤੂਹੈ ਠਾਕੁਰੁ ਸਭੁ ਕੋ ਤੇਰਾ ॥",
      "transliteration": "prabh toohai thaakur sabh ko teraa ||",
      "translation": "O God, You alone are my Lord and Master; all belong to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਉ ਭਾਵੈ ਤਿਉ ਕਰਹਿ ਨਿਬੇਰਾ ॥",
      "transliteration": "jiu bhaavai tiu karahi niberaa ||",
      "translation": "According to Your Will, You pass judgement.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੁਤੀਆ ਨਾਸਤਿ ਇਕੁ ਰਹਿਆ ਸਮਾਇ ॥",
      "transliteration": "duteeaa naasat ik rahiaa samaai ||",
      "translation": "There is no other at all; the One Lord is permeating and pervading everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਾਖਹੁ ਪੈਜ ਨਾਨਕ ਸਰਣਾਇ ॥੪॥੫॥੧੮॥",
      "transliteration": "raakhahu paij naanak saranaai ||4||5||18||",
      "translation": "Please save Nanak's honor; I have come to Your Sanctuary. ||4||5||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਿਨੁ ਬਾਜੇ ਕੈਸੋ ਨਿਰਤਿਕਾਰੀ ॥",
      "transliteration": "bin baaje kaiso niratikaaree ||",
      "translation": "Without music, how is one to dance?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਿਨੁ ਕੰਠੈ ਕੈਸੇ ਗਾਵਨਹਾਰੀ ॥",
      "transliteration": "bin ka(n)thai kaise gaavanahaaree ||",
      "translation": "Without a voice, how is one to sing?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੀਲ ਬਿਨਾ ਕੈਸੇ ਬਜੈ ਰਬਾਬ ॥",
      "transliteration": "jeel binaa kaise bajai rabaab ||",
      "translation": "Without strings, how is a guitar to be played?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਬਿਰਥੇ ਸਭਿ ਕਾਜ ॥੧॥",
      "transliteration": "naam binaa birathe sabh kaaj ||1||",
      "translation": "Without the Naam, all affairs are useless. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਕਹਹੁ ਕੋ ਤਰਿਆ ॥",
      "transliteration": "naam binaa kahahu ko tariaa ||",
      "translation": "Without the Naam - tell me: who has ever been saved?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰ ਕੈਸੇ ਪਾਰਿ ਪਰਿਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin satigur kaise paar pariaa ||1|| rahaau ||",
      "translation": "Without the True Guru, how can anyone cross over to the other side? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿਨੁ ਜਿਹਵਾ ਕਹਾ ਕੋ ਬਕਤਾ ॥",
      "transliteration": "bin jihavaa kahaa ko bakataa ||",
      "translation": "Without a tongue, how can anyone speak?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਬਿਨੁ ਸ੍ਰਵਨਾ ਕਹਾ ਕੋ ਸੁਨਤਾ ॥",
      "transliteration": "bin sravanaa kahaa ko sunataa ||",
      "translation": "Without ears, how can anyone hear?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਿਨੁ ਨੇਤ੍ਰਾ ਕਹਾ ਕੋ ਪੇਖੈ ॥",
      "transliteration": "bin netraa kahaa ko pekhai ||",
      "translation": "Without eyes, how can anyone see?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਨਰੁ ਕਹੀ ਨ ਲੇਖੈ ॥੨॥",
      "transliteration": "naam binaa nar kahee na lekhai ||2||",
      "translation": "Without the Naam, the mortal is of no account at all. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਿਨੁ ਬਿਦਿਆ ਕਹਾ ਕੋਈ ਪੰਡਿਤ ॥",
      "transliteration": "bin bidiaa kahaa koee pa(n)dit ||",
      "translation": "Without learning, how can one be a Pandit - a religious scholar?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਿਨੁ ਅਮਰੈ ਕੈਸੇ ਰਾਜ ਮੰਡਿਤ ॥",
      "transliteration": "bin amarai kaise raaj ma(n)dit ||",
      "translation": "Without power, what is the glory of an empire?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿਨੁ ਬੂਝੇ ਕਹਾ ਮਨੁ ਠਹਰਾਨਾ ॥",
      "transliteration": "bin boojhe kahaa man thaharaanaa ||",
      "translation": "Without understanding, how can the mind become steady?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਸਭੁ ਜਗੁ ਬਉਰਾਨਾ ॥੩॥",
      "transliteration": "naam binaa sabh jag bauraanaa ||3||",
      "translation": "Without the Naam, the whole world is insane. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਿਨੁ ਬੈਰਾਗ ਕਹਾ ਬੈਰਾਗੀ ॥",
      "transliteration": "bin bairaag kahaa bairaagee ||",
      "translation": "Without detachment, how can one be a detached hermit?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਿਨੁ ਹਉ ਤਿਆਗਿ ਕਹਾ ਕੋਊ ਤਿਆਗੀ ॥",
      "transliteration": "bin hau tiaag kahaa kooo tiaagee ||",
      "translation": "Without renouncing egotism, how can anyone be a renunciate?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਿਨੁ ਬਸਿ ਪੰਚ ਕਹਾ ਮਨ ਚੂਰੇ ॥",
      "transliteration": "bin bas pa(n)ch kahaa man choore ||",
      "translation": "Without overcoming the five thieves, how can the mind be subdued?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਸਦ ਸਦ ਹੀ ਝੂਰੇ ॥੪॥",
      "transliteration": "naam binaa sad sad hee jhoore ||4||",
      "translation": "Without the Naam, the mortal regrets and repents forever and ever. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਦੀਖਿਆ ਕੈਸੇ ਗਿਆਨੁ ॥",
      "transliteration": "bin gur deekhiaa kaise giaan ||",
      "translation": "Without the Guru's Teachings, how can anyone obtain spiritual wisdom?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਿਨੁ ਪੇਖੇ ਕਹੁ ਕੈਸੋ ਧਿਆਨੁ ॥",
      "transliteration": "bin pekhe kahu kaiso dhiaan ||",
      "translation": "Without seeing - tell me: how can anyone visualize in meditation?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਿਨੁ ਭੈ ਕਥਨੀ ਸਰਬ ਬਿਕਾਰ ॥",
      "transliteration": "bin bhai kathanee sarab bikaar ||",
      "translation": "Without the Fear of God, all speech in useless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਦਰ ਕਾ ਬੀਚਾਰ ॥੫॥੬॥੧੯॥",
      "transliteration": "kahu naanak dar kaa beechaar ||5||6||19||",
      "translation": "Says Nanak, this is the wisdom of the Lord's Court. ||5||6||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਉਮੈ ਰੋਗੁ ਮਾਨੁਖ ਕਉ ਦੀਨਾ ॥",
      "transliteration": "haumai rog maanukh kau deenaa ||",
      "translation": "Mankind is afflicted with the disease of egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਾਮ ਰੋਗਿ ਮੈਗਲੁ ਬਸਿ ਲੀਨਾ ॥",
      "transliteration": "kaam rog maigal bas leenaa ||",
      "translation": "The disease of sexual desire overwhelms the elephant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਦ੍ਰਿਸਟਿ ਰੋਗਿ ਪਚਿ ਮੁਏ ਪਤੰਗਾ ॥",
      "transliteration": "drisat rog pach mue pata(n)gaa ||",
      "translation": "Because of the disease of vision, the moth is burnt to death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਦ ਰੋਗਿ ਖਪਿ ਗਏ ਕੁਰੰਗਾ ॥੧॥",
      "transliteration": "naad rog khap gae kura(n)gaa ||1||",
      "translation": "Because of the disease of the sound of the bell, the deer is lured to its death. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜੋ ਜੋ ਦੀਸੈ ਸੋ ਸੋ ਰੋਗੀ ॥",
      "transliteration": "jo jo deesai so so rogee ||",
      "translation": "Whoever I see is diseased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਰੋਗ ਰਹਿਤ ਮੇਰਾ ਸਤਿਗੁਰੁ ਜੋਗੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "rog rahit meraa satigur jogee ||1|| rahaau ||",
      "translation": "Only my True Guru, the True Yogi, is free of disease. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਿਹਵਾ ਰੋਗਿ ਮੀਨੁ ਗ੍ਰਸਿਆਨੋ ॥",
      "transliteration": "jihavaa rog meen grasiaano ||",
      "translation": "Because of the disease of taste, the fish is caught.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਬਾਸਨ ਰੋਗਿ ਭਵਰੁ ਬਿਨਸਾਨੋ ॥",
      "transliteration": "baasan rog bhavar binasaano ||",
      "translation": "Because of the disease of smell, the bumble bee is destroyed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਹੇਤ ਰੋਗ ਕਾ ਸਗਲ ਸੰਸਾਰਾ ॥",
      "transliteration": "het rog kaa sagal sa(n)saaraa ||",
      "translation": "The whole world is caught in the disease of attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਤ੍ਰਿਬਿਧਿ ਰੋਗ ਮਹਿ ਬਧੇ ਬਿਕਾਰਾ ॥੨॥",
      "transliteration": "tribidh rog mahi badhe bikaaraa ||2||",
      "translation": "In the disease of the three qualities, corruption is multiplied. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਰੋਗੇ ਮਰਤਾ ਰੋਗੇ ਜਨਮੈ ॥",
      "transliteration": "roge marataa roge janamai ||",
      "translation": "In disease the mortals die, and in disease they are born.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1140_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਰੋਗੇ ਫਿਰਿ ਫਿਰਿ ਜੋਨੀ ਭਰਮੈ ॥",
      "transliteration": "roge phir phir jonee bharamai ||",
      "translation": "In disease they wander in reincarnation again and again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1140,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
