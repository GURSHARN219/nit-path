{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1141,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1141_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰੋਗ ਬੰਧ ਰਹਨੁ ਰਤੀ ਨ ਪਾਵੈ ॥",
      "transliteration": "rog ba(n)dh rahan ratee na paavai ||",
      "translation": "Entangled in disease, they cannot stay still, even for an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰ ਰੋਗੁ ਕਤਹਿ ਨ ਜਾਵੈ ॥੩॥",
      "transliteration": "bin satigur rog katahi na jaavai ||3||",
      "translation": "Without the True Guru, the disease is never cured. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮਿ ਜਿਸੁ ਕੀਨੀ ਦਇਆ ॥",
      "transliteration": "paarabraham jis keenee daiaa ||",
      "translation": "When the Supreme Lord God grants His Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਾਹ ਪਕੜਿ ਰੋਗਹੁ ਕਢਿ ਲਇਆ ॥",
      "transliteration": "baah pakaR rogahu kadh laiaa ||",
      "translation": "He grabs hold of the mortal's arm, and pulls him up and out of the disease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੂਟੇ ਬੰਧਨ ਸਾਧਸੰਗੁ ਪਾਇਆ ॥",
      "transliteration": "toote ba(n)dhan saadhasa(n)g paaiaa ||",
      "translation": "Reaching the Saadh Sangat, the Company of the Holy, the mortal's bonds are broken.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰਿ ਰੋਗੁ ਮਿਟਾਇਆ ॥੪॥੭॥੨੦॥",
      "transliteration": "kahu naanak gur rog mitaaiaa ||4||7||20||",
      "translation": "Says Nanak, the Guru cures him of the disease. ||4||7||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਮਹਾ ਅਨੰਦ ॥",
      "transliteration": "cheet aavai taa(n) mahaa ana(n)d ||",
      "translation": "When He comes to mind, then I am in supreme bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਸਭਿ ਦੁਖ ਭੰਜ ॥",
      "transliteration": "cheet aavai taa(n) sabh dukh bha(n)j ||",
      "translation": "When He comes to mind, then all my pains are shattered.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਸਰਧਾ ਪੂਰੀ ॥",
      "transliteration": "cheet aavai taa(n) saradhaa pooree ||",
      "translation": "When He comes to mind, my hopes are fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਕਬਹਿ ਨ ਝੂਰੀ ॥੧॥",
      "transliteration": "cheet aavai taa(n) kabahi na jhooree ||1||",
      "translation": "When He comes to mind, I never feel sadness. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅੰਤਰਿ ਰਾਮ ਰਾਇ ਪ੍ਰਗਟੇ ਆਇ ॥",
      "transliteration": "a(n)tar raam raai pragate aai ||",
      "translation": "Deep within my being, my Sovereign Lord King has revealed Himself to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਦੀਓ ਰੰਗੁ ਲਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur poorai deeo ra(n)g laai ||1|| rahaau ||",
      "translation": "The Perfect Guru has inspired me to love Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਸਰਬ ਕੋ ਰਾਜਾ ॥",
      "transliteration": "cheet aavai taa(n) sarab ko raajaa ||",
      "translation": "When He comes to mind, I am the king of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਪੂਰੇ ਕਾਜਾ ॥",
      "transliteration": "cheet aavai taa(n) poore kaajaa ||",
      "translation": "When He comes to mind, all my affairs are completed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਰੰਗਿ ਗੁਲਾਲ ॥",
      "transliteration": "cheet aavai taa(n) ra(n)g gulaal ||",
      "translation": "When He comes to mind, I am dyed in the deep crimson of His Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਸਦਾ ਨਿਹਾਲ ॥੨॥",
      "transliteration": "cheet aavai taa(n) sadaa nihaal ||2||",
      "translation": "When He comes to mind, I am ecstatic forever. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਸਦ ਧਨਵੰਤਾ ॥",
      "transliteration": "cheet aavai taa(n) sad dhanava(n)taa ||",
      "translation": "When He comes to mind, I am wealthy forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਸਦ ਨਿਭਰੰਤਾ ॥",
      "transliteration": "cheet aavai taa(n) sad nibhara(n)taa ||",
      "translation": "When He comes to mind, I am free of doubt forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਸਭਿ ਰੰਗ ਮਾਣੇ ॥",
      "transliteration": "cheet aavai taa(n) sabh ra(n)g maane ||",
      "translation": "When He comes to mind, then I enjoy all pleasures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਚੂਕੀ ਕਾਣੇ ॥੩॥",
      "transliteration": "cheet aavai taa(n) chookee kaane ||3||",
      "translation": "When He comes to mind, I am rid of fear. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਸਹਜ ਘਰੁ ਪਾਇਆ ॥",
      "transliteration": "cheet aavai taa(n) sahaj ghar paaiaa ||",
      "translation": "When He comes to mind, I find the home of peace and poise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਤਾਂ ਸੁੰਨਿ ਸਮਾਇਆ ॥",
      "transliteration": "cheet aavai taa(n) su(n)n samaaiaa ||",
      "translation": "When He comes to mind, I am absorbed in the Primal Void of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਚੀਤਿ ਆਵੈ ਸਦ ਕੀਰਤਨੁ ਕਰਤਾ ॥",
      "transliteration": "cheet aavai sad keeratan karataa ||",
      "translation": "When He comes to mind, I continually sing the Kirtan of His Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਨੁ ਮਾਨਿਆ ਨਾਨਕ ਭਗਵੰਤਾ ॥੪॥੮॥੨੧॥",
      "transliteration": "man maaniaa naanak bhagava(n)taa ||4||8||21||",
      "translation": "Nanak's mind is pleased and satisfied with the Lord God. ||4||8||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਾਪੁ ਹਮਾਰਾ ਸਦ ਚਰੰਜੀਵੀ ॥",
      "transliteration": "baap hamaaraa sad chara(n)jeevee ||",
      "translation": "My Father is Eternal, forever alive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭਾਈ ਹਮਾਰੇ ਸਦ ਹੀ ਜੀਵੀ ॥",
      "transliteration": "bhaaee hamaare sad hee jeevee ||",
      "translation": "My brothers live forever as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮੀਤ ਹਮਾਰੇ ਸਦਾ ਅਬਿਨਾਸੀ ॥",
      "transliteration": "meet hamaare sadaa abinaasee ||",
      "translation": "My friends are permanent and imperishable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕੁਟੰਬੁ ਹਮਾਰਾ ਨਿਜ ਘਰਿ ਵਾਸੀ ॥੧॥",
      "transliteration": "kuta(n)b hamaaraa nij ghar vaasee ||1||",
      "translation": "My family abides in the home of the self within. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਮ ਸੁਖੁ ਪਾਇਆ ਤਾਂ ਸਭਹਿ ਸੁਹੇਲੇ ॥",
      "transliteration": "ham sukh paaiaa taa(n) sabhahi suhele ||",
      "translation": "I have found peace, and so all are at peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਪਿਤਾ ਸੰਗਿ ਮੇਲੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur poorai pitaa sa(n)g mele ||1|| rahaau ||",
      "translation": "The Perfect Guru has united me with my Father. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮੰਦਰ ਮੇਰੇ ਸਭ ਤੇ ਊਚੇ ॥",
      "transliteration": "ma(n)dar mere sabh te ooche ||",
      "translation": "My mansions are the highest of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦੇਸ ਮੇਰੇ ਬੇਅੰਤ ਅਪੂਛੇ ॥",
      "transliteration": "des mere bea(n)t apoochhe ||",
      "translation": "My countries are infinite and uncountable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਾਜੁ ਹਮਾਰਾ ਸਦ ਹੀ ਨਿਹਚਲੁ ॥",
      "transliteration": "raaj hamaaraa sad hee nihachal ||",
      "translation": "My kingdom is eternally stable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਾਲੁ ਹਮਾਰਾ ਅਖੂਟੁ ਅਬੇਚਲੁ ॥੨॥",
      "transliteration": "maal hamaaraa akhoot abechal ||2||",
      "translation": "My wealth is inexhaustible and permanent. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੋਭਾ ਮੇਰੀ ਸਭ ਜੁਗ ਅੰਤਰਿ ॥",
      "transliteration": "sobhaa meree sabh jug a(n)tar ||",
      "translation": "My glorious reputation resounds throughout the ages.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਾਜ ਹਮਾਰੀ ਥਾਨ ਥਨੰਤਰਿ ॥",
      "transliteration": "baaj hamaaree thaan thana(n)tar ||",
      "translation": "My fame has spread in all places and interspaces.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕੀਰਤਿ ਹਮਰੀ ਘਰਿ ਘਰਿ ਹੋਈ ॥",
      "transliteration": "keerat hamaree ghar ghar hoee ||",
      "translation": "My praises echo in each and every house.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਗਤਿ ਹਮਾਰੀ ਸਭਨੀ ਲੋਈ ॥੩॥",
      "transliteration": "bhagat hamaaree sabhanee loee ||3||",
      "translation": "My devotional worship is known to all people. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਿਤਾ ਹਮਾਰੇ ਪ੍ਰਗਟੇ ਮਾਝ ॥",
      "transliteration": "pitaa hamaare pragate maajh ||",
      "translation": "My Father has revealed Himself within me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪਿਤਾ ਪੂਤ ਰਲਿ ਕੀਨੀ ਸਾਂਝ ॥",
      "transliteration": "pitaa poot ral keenee saa(n)jh ||",
      "translation": "The Father and son have joined together in partnership.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਉ ਪਿਤਾ ਪਤੀਨੇ ॥",
      "transliteration": "kahu naanak jau pitaa pateene ||",
      "translation": "Says Nanak, when my Father is pleased,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਪਿਤਾ ਪੂਤ ਏਕੈ ਰੰਗਿ ਲੀਨੇ ॥੪॥੯॥੨੨॥",
      "transliteration": "pitaa poot ekai ra(n)g leene ||4||9||22||",
      "translation": "then the Father and son are joined together in love, and become one. ||4||9||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਿਰਵੈਰ ਪੁਰਖ ਸਤਿਗੁਰ ਪ੍ਰਭ ਦਾਤੇ ॥",
      "transliteration": "niravair purakh satigur prabh daate ||",
      "translation": "The True Guru, the Primal Being, is free of revenge and hate; He is God, the Great Giver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਮ ਅਪਰਾਧੀ ਤੁਮੑ ਬਖਸਾਤੇ ॥",
      "transliteration": "ham aparaadhee tumh bakhasaate ||",
      "translation": "I am a sinner; You are my Forgiver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਿਸੁ ਪਾਪੀ ਕਉ ਮਿਲੈ ਨ ਢੋਈ ॥",
      "transliteration": "jis paapee kau milai na dhoee ||",
      "translation": "That sinner, who finds no protection anywhere",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਰਣਿ ਆਵੈ ਤਾਂ ਨਿਰਮਲੁ ਹੋਈ ॥੧॥",
      "transliteration": "saran aavai taa(n) niramal hoee ||1||",
      "translation": "- if he comes seeking Your Sanctuary, then he becomes immaculate and pure. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸੁਖੁ ਪਾਇਆ ਸਤਿਗੁਰੂ ਮਨਾਇ ॥",
      "transliteration": "sukh paaiaa satiguroo manaai ||",
      "translation": "Pleasing the True Guru, I have found peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਭ ਫਲ ਪਾਏ ਗੁਰੂ ਧਿਆਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sabh phal paae guroo dhiaai ||1|| rahaau ||",
      "translation": "Meditating on the Guru, I have obtained all fruits and rewards. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਸਤਿਗੁਰ ਆਦੇਸੁ ॥",
      "transliteration": "paarabraham satigur aades ||",
      "translation": "I humbly bow to the Supreme Lord God, the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਤੇਰਾ ਸਭੁ ਤੇਰਾ ਦੇਸੁ ॥",
      "transliteration": "man tan teraa sabh teraa des ||",
      "translation": "My mind and body are Yours; all the world is Yours.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਚੂਕਾ ਪੜਦਾ ਤਾਂ ਨਦਰੀ ਆਇਆ ॥",
      "transliteration": "chookaa paRadaa taa(n) nadaree aaiaa ||",
      "translation": "When the veil of illusion is removed, then I come to see You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਖਸਮੁ ਤੂਹੈ ਸਭਨਾ ਕੇ ਰਾਇਆ ॥੨॥",
      "transliteration": "khasam toohai sabhanaa ke raaiaa ||2||",
      "translation": "You are my Lord and Master; You are the King of all. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਤਿਸੁ ਭਾਣਾ ਸੂਕੇ ਕਾਸਟ ਹਰਿਆ ॥",
      "transliteration": "tis bhaanaa sooke kaasat hariaa ||",
      "translation": "When it pleases Him, even dry wood becomes green.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਿਸੁ ਭਾਣਾ ਤਾਂ ਥਲ ਸਿਰਿ ਸਰਿਆ ॥",
      "transliteration": "tis bhaanaa taa(n) thal sir sariaa ||",
      "translation": "When it pleases Him, rivers flow across the desert sands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਤਿਸੁ ਭਾਣਾ ਤਾਂ ਸਭਿ ਫਲ ਪਾਏ ॥",
      "transliteration": "tis bhaanaa taa(n) sabh phal paae ||",
      "translation": "When it pleases Him, all fruits and rewards are obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1141_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਚਿੰਤ ਗਈ ਲਗਿ ਸਤਿਗੁਰ ਪਾਏ ॥੩॥",
      "transliteration": "chi(n)t gaee lag satigur paae ||3||",
      "translation": "Grasping hold of the Guru's feet, my anxiety is dispelled. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1141,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
