{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1142,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1142_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਰਾਮਖੋਰ ਨਿਰਗੁਣ ਕਉ ਤੂਠਾ ॥",
      "transliteration": "haraamakhor niragun kau toothaa ||",
      "translation": "I am unworthy and ungrateful, but He has been merciful to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਸੀਤਲੁ ਮਨਿ ਅੰਮ੍ਰਿਤੁ ਵੂਠਾ ॥",
      "transliteration": "man tan seetal man a(n)mrit voothaa ||",
      "translation": "My mind and body have been cooled and soothed; the Ambrosial Nectar rains down in my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਗੁਰ ਭਏ ਦਇਆਲਾ ॥",
      "transliteration": "paarabraham gur bhae daiaalaa ||",
      "translation": "The Supreme Lord God, the Guru, has become kind and compassionate to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਦੇਖਿ ਭਏ ਨਿਹਾਲਾ ॥੪॥੧੦॥੨੩॥",
      "transliteration": "naanak daas dekh bhae nihaalaa ||4||10||23||",
      "translation": "Slave Nanak beholds the Lord, enraptured. ||4||10||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮੇਰਾ ਬੇਮੁਹਤਾਜੁ ॥",
      "transliteration": "satigur meraa bemuhataaj ||",
      "translation": "My True Guru is totally independent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਤਿਗੁਰ ਮੇਰੇ ਸਚਾ ਸਾਜੁ ॥",
      "transliteration": "satigur mere sachaa saaj ||",
      "translation": "My True Guru is adorned with Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮੇਰਾ ਸਭਸ ਕਾ ਦਾਤਾ ॥",
      "transliteration": "satigur meraa sabhas kaa daataa ||",
      "translation": "My True Guru is the Giver of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮੇਰਾ ਪੁਰਖੁ ਬਿਧਾਤਾ ॥੧॥",
      "transliteration": "satigur meraa purakh bidhaataa ||1||",
      "translation": "My True Guru is the Primal Creator Lord, the Architect of Destiny. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰ ਜੈਸਾ ਨਾਹੀ ਕੋ ਦੇਵ ॥",
      "transliteration": "gur jaisaa naahee ko dev ||",
      "translation": "There is no deity equal to the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਸੁ ਮਸਤਕਿ ਭਾਗੁ ਸੁ ਲਾਗਾ ਸੇਵ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jis masatak bhaag s laagaa sev ||1|| rahaau ||",
      "translation": "Whoever has good destiny inscribed on his forehead, applies himself to seva - selfless service. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮੇਰਾ ਸਰਬ ਪ੍ਰਤਿਪਾਲੈ ॥",
      "transliteration": "satigur meraa sarab pratipaalai ||",
      "translation": "My True Guru is the Sustainer and Cherisher of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮੇਰਾ ਮਾਰਿ ਜੀਵਾਲੈ ॥",
      "transliteration": "satigur meraa maar jeevaalai ||",
      "translation": "My True Guru kills and revives.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਤਿਗੁਰ ਮੇਰੇ ਕੀ ਵਡਿਆਈ ॥",
      "transliteration": "satigur mere kee vadiaaee ||",
      "translation": "The glorious greatness of my True Guru",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪ੍ਰਗਟੁ ਭਈ ਹੈ ਸਭਨੀ ਥਾਈ ॥੨॥",
      "transliteration": "pragat bhaee hai sabhanee thaaee ||2||",
      "translation": "Has become manifest everywhere. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮੇਰਾ ਤਾਣੁ ਨਿਤਾਣੁ ॥",
      "transliteration": "satigur meraa taan nitaan ||",
      "translation": "My True Guru is the power of the powerless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮੇਰਾ ਘਰਿ ਦੀਬਾਣੁ ॥",
      "transliteration": "satigur meraa ghar deebaan ||",
      "translation": "My True Guru is my home and court.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਤਿਗੁਰ ਕੈ ਹਉ ਸਦ ਬਲਿ ਜਾਇਆ ॥",
      "transliteration": "satigur kai hau sad bal jaaiaa ||",
      "translation": "I am forever a sacrifice to the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪ੍ਰਗਟੁ ਮਾਰਗੁ ਜਿਨਿ ਕਰਿ ਦਿਖਲਾਇਆ ॥੩॥",
      "transliteration": "pragat maarag jin kar dikhalaaiaa ||3||",
      "translation": "He has shown me the path. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਨਿ ਗੁਰੁ ਸੇਵਿਆ ਤਿਸੁ ਭਉ ਨ ਬਿਆਪੈ ॥",
      "transliteration": "jin gur seviaa tis bhau na biaapai ||",
      "translation": "One who serves the Guru is not afflicted with fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਨਿ ਗੁਰੁ ਸੇਵਿਆ ਤਿਸੁ ਦੁਖੁ ਨ ਸੰਤਾਪੈ ॥",
      "transliteration": "jin gur seviaa tis dukh na sa(n)taapai ||",
      "translation": "One who serves the Guru does not suffer in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਨਕ ਸੋਧੇ ਸਿੰਮ੍ਰਿਤਿ ਬੇਦ ॥",
      "transliteration": "naanak sodhe si(n)mrit bed ||",
      "translation": "Nanak has studied the Simritees and the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਗੁਰ ਨਾਹੀ ਭੇਦ ॥੪॥੧੧॥੨੪॥",
      "transliteration": "paarabraham gur naahee bhed ||4||11||24||",
      "translation": "There is no difference between the Supreme Lord God and the Guru. ||4||11||24||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਮਨੁ ਪਰਗਟੁ ਭਇਆ ॥",
      "transliteration": "naam lait man paragat bhaiaa ||",
      "translation": "Repeating the Naam, the Name of the Lord, the mortal is exalted and glorified.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਪਾਪੁ ਤਨ ਤੇ ਗਇਆ ॥",
      "transliteration": "naam lait paap tan te gaiaa ||",
      "translation": "Repeating the Naam, sin is banished from the body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਸਗਲ ਪੁਰਬਾਇਆ ॥",
      "transliteration": "naam lait sagal purabaaiaa ||",
      "translation": "Repeating the Naam, all festivals are celebrated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਅਠਸਠਿ ਮਜਨਾਇਆ ॥੧॥",
      "transliteration": "naam lait athasath majanaaiaa ||1||",
      "translation": "Repeating the Naam, one is cleansed at the sixty-eight sacred shrines. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੀਰਥੁ ਹਮਰਾ ਹਰਿ ਕੋ ਨਾਮੁ ॥",
      "transliteration": "teerath hamaraa har ko naam ||",
      "translation": "My sacred shrine of pilgrimage is the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗੁਰਿ ਉਪਦੇਸਿਆ ਤਤੁ ਗਿਆਨੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur upadesiaa tat giaan ||1|| rahaau ||",
      "translation": "The Guru has instructed me in the true essence of spiritual wisdom. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਦੁਖੁ ਦੂਰਿ ਪਰਾਨਾ ॥",
      "transliteration": "naam lait dukh door paraanaa ||",
      "translation": "Repeating the Naam, the mortal's pains are taken away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਅਤਿ ਮੂੜ ਸੁਗਿਆਨਾ ॥",
      "transliteration": "naam lait at mooR sugiaanaa ||",
      "translation": "Repeating the Naam, the most ignorant people become spiritual teachers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਪਰਗਟਿ ਉਜੀਆਰਾ ॥",
      "transliteration": "naam lait paragat ujeeaaraa ||",
      "translation": "Repeating the Naam, the Divine Light blazes forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਛੁਟੇ ਜੰਜਾਰਾ ॥੨॥",
      "transliteration": "naam lait chhute ja(n)jaaraa ||2||",
      "translation": "Repeating the Naam, one's bonds are broken. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਜਮੁ ਨੇੜਿ ਨ ਆਵੈ ॥",
      "transliteration": "naam lait jam neR na aavai ||",
      "translation": "Repeating the Naam, the Messenger of Death does not draw near.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਦਰਗਹ ਸੁਖੁ ਪਾਵੈ ॥",
      "transliteration": "naam lait daragah sukh paavai ||",
      "translation": "Repeating the Naam, one finds peace in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਪ੍ਰਭੁ ਕਹੈ ਸਾਬਾਸਿ ॥",
      "transliteration": "naam lait prabh kahai saabaas ||",
      "translation": "Repeating the Naam, God gives His Approval.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੀ ਸਾਚੀ ਰਾਸਿ ॥੩॥",
      "transliteration": "naam hamaaree saachee raas ||3||",
      "translation": "The Naam is my true wealth. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰਿ ਉਪਦੇਸੁ ਕਹਿਓ ਇਹੁ ਸਾਰੁ ॥",
      "transliteration": "gur upades kahio ihu saar ||",
      "translation": "The Guru has instructed me in these sublime teachings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਰਿ ਕੀਰਤਿ ਮਨ ਨਾਮੁ ਅਧਾਰੁ ॥",
      "transliteration": "har keerat man naam adhaar ||",
      "translation": "The Kirtan of the Lord's Praises and the Naam are the Support of the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਨਕ ਉਧਰੇ ਨਾਮ ਪੁਨਹਚਾਰ ॥",
      "transliteration": "naanak udhare naam punahachaar ||",
      "translation": "Nanak is saved through the atonement of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਵਰਿ ਕਰਮ ਲੋਕਹ ਪਤੀਆਰ ॥੪॥੧੨॥੨੫॥",
      "transliteration": "avar karam lokah pateeaar ||4||12||25||",
      "translation": "Other actions are just to please and appease the people. ||4||12||25||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਮਸਕਾਰ ਤਾ ਕਉ ਲਖ ਬਾਰ ॥",
      "transliteration": "namasakaar taa kau lakh baar ||",
      "translation": "I bow in humble worship, tens of thousands of times.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਦੀਜੈ ਤਾ ਕਉ ਵਾਰਿ ॥",
      "transliteration": "ihu man deejai taa kau vaar ||",
      "translation": "I offer this mind as a sacrifice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਿਮਰਨਿ ਤਾ ਕੈ ਮਿਟਹਿ ਸੰਤਾਪ ॥",
      "transliteration": "simaran taa kai mitahi sa(n)taap ||",
      "translation": "Meditating in remembrance on Him, sufferings are erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹੋਇ ਅਨੰਦੁ ਨ ਵਿਆਪਹਿ ਤਾਪ ॥੧॥",
      "transliteration": "hoi ana(n)d na viaapahi taap ||1||",
      "translation": "Bliss wells up, and no disease is contracted. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਐਸੋ ਹੀਰਾ ਨਿਰਮਲ ਨਾਮ ॥",
      "transliteration": "aiso heeraa niramal naam ||",
      "translation": "Such is the diamond, the Immaculate Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਾਸੁ ਜਪਤ ਪੂਰਨ ਸਭਿ ਕਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaas japat pooran sabh kaam ||1|| rahaau ||",
      "translation": "Chanting it, all works are perfectly completed. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਾ ਕੀ ਦ੍ਰਿਸਟਿ ਦੁਖ ਡੇਰਾ ਢਹੈ ॥",
      "transliteration": "jaa kee drisat dukh deraa dhahai ||",
      "translation": "Beholding Him, the house of pain is demolished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਸੀਤਲੁ ਮਨਿ ਗਹੈ ॥",
      "transliteration": "a(n)mrit naam seetal man gahai ||",
      "translation": "The mind seizes the cooling, soothing, Ambrosial Nectar of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਅਨਿਕ ਭਗਤ ਜਾ ਕੇ ਚਰਨ ਪੂਜਾਰੀ ॥",
      "transliteration": "anik bhagat jaa ke charan poojaaree ||",
      "translation": "Millions of devotees worship His Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਗਲ ਮਨੋਰਥ ਪੂਰਨਹਾਰੀ ॥੨॥",
      "transliteration": "sagal manorath pooranahaaree ||2||",
      "translation": "He is the Fulfiller of all the mind's desires. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਊਣੇ ਸੁਭਰ ਭਰਿਆ ॥",
      "transliteration": "khin mahi oone subhar bhariaa ||",
      "translation": "In an instant, He fills the empty to over-flowing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਸੂਕੇ ਕੀਨੇ ਹਰਿਆ ॥",
      "transliteration": "khin mahi sooke keene hariaa ||",
      "translation": "In an instant, He transforms the dry into green.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਨਿਥਾਵੇ ਕਉ ਦੀਨੋ ਥਾਨੁ ॥",
      "transliteration": "khin mahi nithaave kau deeno thaan ||",
      "translation": "In an instant, He gives the homeless a home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1142_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਨਿਮਾਣੇ ਕਉ ਦੀਨੋ ਮਾਨੁ ॥੩॥",
      "transliteration": "khin mahi nimaane kau deeno maan ||3||",
      "translation": "In an instant, He bestows honor on the dishonored. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1142,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
