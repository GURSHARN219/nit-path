{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1143,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1143_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਭ ਮਹਿ ਏਕੁ ਰਹਿਆ ਭਰਪੂਰਾ ॥",
      "transliteration": "sabh mahi ek rahiaa bharapooraa ||",
      "translation": "The One Lord is totally pervading and permeating all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੋ ਜਾਪੈ ਜਿਸੁ ਸਤਿਗੁਰੁ ਪੂਰਾ ॥",
      "transliteration": "so jaapai jis satigur pooraa ||",
      "translation": "He alone meditates on the Lord, whose True Guru is Perfect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਰਿ ਕੀਰਤਨੁ ਤਾ ਕੋ ਆਧਾਰੁ ॥",
      "transliteration": "har keeratan taa ko aadhaar ||",
      "translation": "Such a person has the Kirtan of the Lord's Praises for his Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਿਸੁ ਆਪਿ ਦਇਆਰੁ ॥੪॥੧੩॥੨੬॥",
      "transliteration": "kahu naanak jis aap daiaar ||4||13||26||",
      "translation": "Says Nanak, the Lord Himself is merciful to him. ||4||13||26||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੋਹਿ ਦੁਹਾਗਨਿ ਆਪਿ ਸੀਗਾਰੀ ॥",
      "transliteration": "mohi duhaagan aap seegaaree ||",
      "translation": "I was discarded and abandoned, but He has embellished me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰੂਪ ਰੰਗ ਦੇ ਨਾਮਿ ਸਵਾਰੀ ॥",
      "transliteration": "roop ra(n)g de naam savaaree ||",
      "translation": "He has blessed me with beauty and His Love; through His Name, I am exalted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਿਟਿਓ ਦੁਖੁ ਅਰੁ ਸਗਲ ਸੰਤਾਪ ॥",
      "transliteration": "mitio dukh ar sagal sa(n)taap ||",
      "translation": "All my pains and sorrows have been eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਰ ਹੋਏ ਮੇਰੇ ਮਾਈ ਬਾਪ ॥੧॥",
      "transliteration": "gur hoe mere maaee baap ||1||",
      "translation": "The Guru has become my Mother and Father. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਖੀ ਸਹੇਰੀ ਮੇਰੈ ਗ੍ਰਸਤਿ ਅਨੰਦ ॥",
      "transliteration": "sakhee saheree merai grasat ana(n)d ||",
      "translation": "O my friends and companions, my household is in bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਭੇਟੇ ਮੋਹਿ ਕੰਤ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa bhete mohi ka(n)t ||1|| rahaau ||",
      "translation": "Granting His Grace, my Husband Lord has met me. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤਪਤਿ ਬੁਝੀ ਪੂਰਨ ਸਭ ਆਸਾ ॥",
      "transliteration": "tapat bujhee pooran sabh aasaa ||",
      "translation": "The fire of desire has been extinguished, and all my desires have been fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਿਟੇ ਅੰਧੇਰ ਭਏ ਪਰਗਾਸਾ ॥",
      "transliteration": "mite a(n)dher bhae paragaasaa ||",
      "translation": "The darkness has been dispelled, and the Divine Light blazes forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਨਹਦ ਸਬਦ ਅਚਰਜ ਬਿਸਮਾਦ ॥",
      "transliteration": "anahad sabad acharaj bisamaad ||",
      "translation": "The Unstruck Sound-current of the Shabad, the Word of God, is wondrous and amazing!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰੁ ਪੂਰਾ ਪੂਰਾ ਪਰਸਾਦ ॥੨॥",
      "transliteration": "gur pooraa pooraa parasaad ||2||",
      "translation": "Perfect is the Grace of the Perfect Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਾ ਕਉ ਪ੍ਰਗਟ ਭਏ ਗੋਪਾਲ ॥",
      "transliteration": "jaa kau pragat bhae gopaal ||",
      "translation": "That person, unto whom the Lord reveals Himself",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾ ਕੈ ਦਰਸਨਿ ਸਦਾ ਨਿਹਾਲ ॥",
      "transliteration": "taa kai darasan sadaa nihaal ||",
      "translation": "by the Blessed Vision of his Darshan, I am forever enraptured.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਰਬ ਗੁਣਾ ਤਾ ਕੈ ਬਹੁਤੁ ਨਿਧਾਨ ॥",
      "transliteration": "sarab gunaa taa kai bahut nidhaan ||",
      "translation": "He obtains all virtues and so many treasures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਾ ਕਉ ਸਤਿਗੁਰਿ ਦੀਓ ਨਾਮੁ ॥੩॥",
      "transliteration": "jaa kau satigur deeo naam ||3||",
      "translation": "The True Guru blesses him with the Naam, the Name of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਾ ਕਉ ਭੇਟਿਓ ਠਾਕੁਰੁ ਅਪਨਾ ॥",
      "transliteration": "jaa kau bhetio thaakur apanaa ||",
      "translation": "That person who meets with his Lord and Master",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਸੀਤਲੁ ਹਰਿ ਹਰਿ ਜਪਨਾ ॥",
      "transliteration": "man tan seetal har har japanaa ||",
      "translation": "his mind and body are cooled and soothed, chanting the Name of the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜੋ ਜਨ ਪ੍ਰਭ ਭਾਏ ॥",
      "transliteration": "kahu naanak jo jan prabh bhaae ||",
      "translation": "Says Nanak, such a humble being is pleasing to God;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਾ ਕੀ ਰੇਨੁ ਬਿਰਲਾ ਕੋ ਪਾਏ ॥੪॥੧੪॥੨੭॥",
      "transliteration": "taa kee ren biralaa ko paae ||4||14||27||",
      "translation": "only a rare few are blessed with the dust of his feet. ||4||14||27||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਚਿਤਵਤ ਪਾਪ ਨ ਆਲਕੁ ਆਵੈ ॥",
      "transliteration": "chitavat paap na aalak aavai ||",
      "translation": "The mortal does not hesitate to think about sin.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬੇਸੁਆ ਭਜਤ ਕਿਛੁ ਨਹ ਸਰਮਾਵੈ ॥",
      "transliteration": "besuaa bhajat kichh nah saramaavai ||",
      "translation": "He is not ashamed to spend time with prostitutes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਾਰੋ ਦਿਨਸੁ ਮਜੂਰੀ ਕਰੈ ॥",
      "transliteration": "saaro dinas majooree karai ||",
      "translation": "He works all day long,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨ ਕੀ ਵੇਲਾ ਬਜਰ ਸਿਰਿ ਪਰੈ ॥੧॥",
      "transliteration": "har simaran kee velaa bajar sir parai ||1||",
      "translation": "but when it is time to remember the Lord, then a heavy stone falls on his head. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਾਇਆ ਲਗਿ ਭੂਲੋ ਸੰਸਾਰੁ ॥",
      "transliteration": "maaiaa lag bhoolo sa(n)saar ||",
      "translation": "Attached to Maya, the world is deluded and confused.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਆਪਿ ਭੁਲਾਇਆ ਭੁਲਾਵਣਹਾਰੈ ਰਾਚਿ ਰਹਿਆ ਬਿਰਥਾ ਬਿਉਹਾਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aap bhulaaiaa bhulaavanahaarai raach rahiaa birathaa biuhaar ||1|| rahaau ||",
      "translation": "The Deluder Himself has deluded the mortal, and now he is engrossed in worthless worldly affairs. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪੇਖਤ ਮਾਇਆ ਰੰਗ ਬਿਹਾਇ ॥",
      "transliteration": "pekhat maaiaa ra(n)g bihaai ||",
      "translation": "Gazing on Maya's illusion, its pleasures pass away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੜਬੜ ਕਰੈ ਕਉਡੀ ਰੰਗੁ ਲਾਇ ॥",
      "transliteration": "gaRabaR karai kaudee ra(n)g laai ||",
      "translation": "He loves the shell, and ruins his life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅੰਧ ਬਿਉਹਾਰ ਬੰਧ ਮਨੁ ਧਾਵੈ ॥",
      "transliteration": "a(n)dh biuhaar ba(n)dh man dhaavai ||",
      "translation": "Bound to blind worldly affairs, his mind wavers and wanders.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਰਣੈਹਾਰੁ ਨ ਜੀਅ ਮਹਿ ਆਵੈ ॥੨॥",
      "transliteration": "karanaihaar na jee mahi aavai ||2||",
      "translation": "The Creator Lord does not come into his mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਰਤ ਕਰਤ ਇਵ ਹੀ ਦੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "karat karat iv hee dukh paaiaa ||",
      "translation": "Working and working like this, he only obtains pain,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪੂਰਨ ਹੋਤ ਨ ਕਾਰਜ ਮਾਇਆ ॥",
      "transliteration": "pooran hot na kaaraj maaiaa ||",
      "translation": "and his affairs of Maya are never completed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਾਮਿ ਕ੍ਰੋਧਿ ਲੋਭਿ ਮਨੁ ਲੀਨਾ ॥",
      "transliteration": "kaam krodh lobh man leenaa ||",
      "translation": "His mind is saturated with sexual desire, anger and greed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੜਫਿ ਮੂਆ ਜਿਉ ਜਲ ਬਿਨੁ ਮੀਨਾ ॥੩॥",
      "transliteration": "taRaph mooaa jiu jal bin meenaa ||3||",
      "translation": "Wiggling like a fish out of water, he dies. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਿਸ ਕੇ ਰਾਖੇ ਹੋਏ ਹਰਿ ਆਪਿ ॥",
      "transliteration": "jis ke raakhe hoe har aap ||",
      "translation": "One who has the Lord Himself as his Protector,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਸਦਾ ਜਪੁ ਜਾਪਿ ॥",
      "transliteration": "har har naam sadaa jap jaap ||",
      "translation": "chants and meditates forever on the Name of the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਹਰਿ ਕੇ ਗੁਣ ਗਾਇਆ ॥",
      "transliteration": "saadhasa(n)g har ke gun gaaiaa ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, he chants the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਨਕ ਸਤਿਗੁਰੁ ਪੂਰਾ ਪਾਇਆ ॥੪॥੧੫॥੨੮॥",
      "transliteration": "naanak satigur pooraa paaiaa ||4||15||28||",
      "translation": "O Nanak, he has found the Perfect True Guru. ||4||15||28||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਅਪਣੀ ਦਇਆ ਕਰੇ ਸੋ ਪਾਏ ॥",
      "transliteration": "apanee daiaa kare so paae ||",
      "translation": "He alone obtains it, unto whom the Lord shows Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਮੰਨਿ ਵਸਾਏ ॥",
      "transliteration": "har kaa naam ma(n)n vasaae ||",
      "translation": "He enshrines the Name of the Lord in his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਾਚ ਸਬਦੁ ਹਿਰਦੇ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "saach sabad hirade man maahi ||",
      "translation": "With the True Word of the Shabad in his heart and mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੇ ਕਿਲਵਿਖ ਜਾਹਿ ॥੧॥",
      "transliteration": "janam janam ke kilavikh jaahi ||1||",
      "translation": "the sins of countless incarnations vanish. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਜੀਅ ਕੋ ਆਧਾਰੁ ॥",
      "transliteration": "raam naam jee ko aadhaar ||",
      "translation": "The Lord's Name is the Support of the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਜਪਹੁ ਨਿਤ ਭਾਈ ਤਾਰਿ ਲਏ ਸਾਗਰ ਸੰਸਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur parasaad japahu nit bhaaee taar lae saagar sa(n)saar ||1|| rahaau ||",
      "translation": "By Guru's Grace, chant the Name continually, O Siblings of Destiny; It shall carry you across the world-ocean. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਨ ਕਉ ਲਿਖਿਆ ਹਰਿ ਏਹੁ ਨਿਧਾਨੁ ॥",
      "transliteration": "jin kau likhiaa har ehu nidhaan ||",
      "translation": "Those who have this treasure of the Lord's Name written in their destiny,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸੇ ਜਨ ਦਰਗਹ ਪਾਵਹਿ ਮਾਨੁ ॥",
      "transliteration": "se jan daragah paavahi maan ||",
      "translation": "those humble beings are honored in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਆਨੰਦ ਗੁਣ ਗਾਉ ॥",
      "transliteration": "sookh sahaj aana(n)d gun gaau ||",
      "translation": "Singing His Glorious Praises with peace, poise and bliss,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਆਗੈ ਮਿਲੈ ਨਿਥਾਵੇ ਥਾਉ ॥੨॥",
      "transliteration": "aagai milai nithaave thaau ||2||",
      "translation": "even the homeless obtain a home hereafter. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜੁਗਹ ਜੁਗੰਤਰਿ ਇਹੁ ਤਤੁ ਸਾਰੁ ॥",
      "transliteration": "jugah juga(n)tar ihu tat saar ||",
      "translation": "Throughout the ages, this has been the essence of reality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1143_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਣੁ ਸਾਚਾ ਬੀਚਾਰੁ ॥",
      "transliteration": "har simaran saachaa beechaar ||",
      "translation": "Meditate in remembrance on the Lord, and contemplate the Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1143,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
