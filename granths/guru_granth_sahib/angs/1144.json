{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1144,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1144_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਸੁ ਲੜਿ ਲਾਇ ਲਏ ਸੋ ਲਾਗੈ ॥",
      "transliteration": "jis laR laai lae so laagai ||",
      "translation": "He alone is attached to the hem of the Lord's robe, whom the Lord Himself attaches.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕਾ ਸੋਇਆ ਜਾਗੈ ॥੩॥",
      "transliteration": "janam janam kaa soiaa jaagai ||3||",
      "translation": "Asleep for countless incarnations, he now awakens. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤੇਰੇ ਭਗਤ ਭਗਤਨ ਕਾ ਆਪਿ ॥",
      "transliteration": "tere bhagat bhagatan kaa aap ||",
      "translation": "Your devotees belong to You, and You belong to Your devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਪਣੀ ਮਹਿਮਾ ਆਪੇ ਜਾਪਿ ॥",
      "transliteration": "apanee mahimaa aape jaap ||",
      "translation": "You Yourself inspire them to chant Your Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਸਭਿ ਤੇਰੈ ਹਾਥਿ ॥",
      "transliteration": "jee ja(n)t sabh terai haath ||",
      "translation": "All beings and creatures are in Your Hands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਨਕ ਕੇ ਪ੍ਰਭ ਸਦ ਹੀ ਸਾਥਿ ॥੪॥੧੬॥੨੯॥",
      "transliteration": "naanak ke prabh sad hee saath ||4||16||29||",
      "translation": "Nanak's God is always with him. ||4||16||29||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "naam hamaarai a(n)tarajaamee ||",
      "translation": "The Naam, the Name of the Lord, is the Inner-knower of my heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਆਵੈ ਕਾਮੀ ॥",
      "transliteration": "naam hamaarai aavai kaamee ||",
      "translation": "The Naam is so useful to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰੋਮਿ ਰੋਮਿ ਰਵਿਆ ਹਰਿ ਨਾਮੁ ॥",
      "transliteration": "rom rom raviaa har naam ||",
      "translation": "The Lord's Name permeates each and every hair of mine.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਤਿਗੁਰ ਪੂਰੈ ਕੀਨੋ ਦਾਨੁ ॥੧॥",
      "transliteration": "satigur poorai keeno daan ||1||",
      "translation": "The Perfect True Guru has given me this gift. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਾਮੁ ਰਤਨੁ ਮੇਰੈ ਭੰਡਾਰ ॥",
      "transliteration": "naam ratan merai bha(n)daar ||",
      "translation": "The Jewel of the Naam is my treasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਗਮ ਅਮੋਲਾ ਅਪਰ ਅਪਾਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "agam amolaa apar apaar ||1|| rahaau ||",
      "translation": "It is inaccessible, priceless, infinite and incomparable. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਨਿਹਚਲ ਧਨੀ ॥",
      "transliteration": "naam hamaarai nihachal dhanee ||",
      "translation": "The Naam is my unmoving, unchanging Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਾਮ ਕੀ ਮਹਿਮਾ ਸਭ ਮਹਿ ਬਨੀ ॥",
      "transliteration": "naam kee mahimaa sabh mahi banee ||",
      "translation": "The glory of the Naam spreads over the whole world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਪੂਰਾ ਸਾਹੁ ॥",
      "transliteration": "naam hamaarai pooraa saahu ||",
      "translation": "The Naam is my perfect master of wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਬੇਪਰਵਾਹੁ ॥੨॥",
      "transliteration": "naam hamaarai beparavaahu ||2||",
      "translation": "The Naam is my independence. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਭੋਜਨ ਭਾਉ ॥",
      "transliteration": "naam hamaarai bhojan bhaau ||",
      "translation": "The Naam is my food and love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਮਨ ਕਾ ਸੁਆਉ ॥",
      "transliteration": "naam hamaarai man kaa suaau ||",
      "translation": "The Naam is the objective of my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਮੁ ਨ ਵਿਸਰੈ ਸੰਤ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "naam na visarai sa(n)t prasaad ||",
      "translation": "By the Grace of the Saints, I never forget the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਅਨਹਦ ਪੂਰੇ ਨਾਦ ॥੩॥",
      "transliteration": "naam lait anahad poore naad ||3||",
      "translation": "Repeating the Naam, the Unstruck Sound-current of the Naad resounds. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਭ ਕਿਰਪਾ ਤੇ ਨਾਮੁ ਨਉ ਨਿਧਿ ਪਾਈ ॥",
      "transliteration": "prabh kirapaa te naam nau nidh paaee ||",
      "translation": "By God's Grace, I have obtained the nine treasures of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਨਾਮ ਸਿਉ ਬਨਿ ਆਈ ॥",
      "transliteration": "gur kirapaa te naam siu ban aaee ||",
      "translation": "By Guru's Grace, I am tuned in to the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਧਨਵੰਤੇ ਸੇਈ ਪਰਧਾਨ ॥",
      "transliteration": "dhanava(n)te seee paradhaan ||",
      "translation": "They alone are wealthy and supreme,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਨਕ ਜਾ ਕੈ ਨਾਮੁ ਨਿਧਾਨ ॥੪॥੧੭॥੩੦॥",
      "transliteration": "naanak jaa kai naam nidhaan ||4||17||30||",
      "translation": "O Nanak, who have the treasure of the Naam. ||4||17||30||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੂ ਮੇਰਾ ਪਿਤਾ ਤੂਹੈ ਮੇਰਾ ਮਾਤਾ ॥",
      "transliteration": "too meraa pitaa toohai meraa maataa ||",
      "translation": "You are my Father, and You are my Mother.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤੂ ਮੇਰੇ ਜੀਅ ਪ੍ਰਾਨ ਸੁਖਦਾਤਾ ॥",
      "transliteration": "too mere jee praan sukhadaataa ||",
      "translation": "You are my Soul, my Breath of Life, the Giver of Peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੂ ਮੇਰਾ ਠਾਕੁਰੁ ਹਉ ਦਾਸੁ ਤੇਰਾ ॥",
      "transliteration": "too meraa thaakur hau daas teraa ||",
      "translation": "You are my Lord and Master; I am Your slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੁਝ ਬਿਨੁ ਅਵਰੁ ਨਹੀ ਕੋ ਮੇਰਾ ॥੧॥",
      "transliteration": "tujh bin avar nahee ko meraa ||1||",
      "translation": "Without You, I have no one at all. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਕਰਹੁ ਪ੍ਰਭ ਦਾਤਿ ॥",
      "transliteration": "kar kirapaa karahu prabh daat ||",
      "translation": "Please bless me with Your Mercy, God, and give me this gift,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤੁਮੑਰੀ ਉਸਤਤਿ ਕਰਉ ਦਿਨ ਰਾਤਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tumhree usatat karau din raat ||1|| rahaau ||",
      "translation": "that I may sing Your Praises, day and night. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਮ ਤੇਰੇ ਜੰਤ ਤੂ ਬਜਾਵਨਹਾਰਾ ॥",
      "transliteration": "ham tere ja(n)t too bajaavanahaaraa ||",
      "translation": "I am Your musical instrument, and You are the Musician.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਮ ਤੇਰੇ ਭਿਖਾਰੀ ਦਾਨੁ ਦੇਹਿ ਦਾਤਾਰਾ ॥",
      "transliteration": "ham tere bhikhaaree daan dehi daataaraa ||",
      "translation": "I am Your beggar; please bless me with Your charity, O Great Giver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਤਉ ਪਰਸਾਦਿ ਰੰਗ ਰਸ ਮਾਣੇ ॥",
      "transliteration": "tau parasaad ra(n)g ras maane ||",
      "translation": "By Your Grace, I enjoy love and pleasures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਘਟ ਘਟ ਅੰਤਰਿ ਤੁਮਹਿ ਸਮਾਣੇ ॥੨॥",
      "transliteration": "ghat ghat a(n)tar tumahi samaane ||2||",
      "translation": "You are deep within each and every heart. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤੁਮੑਰੀ ਕ੍ਰਿਪਾ ਤੇ ਜਪੀਐ ਨਾਉ ॥",
      "transliteration": "tumhree kripaa te japeeai naau ||",
      "translation": "By Your Grace, I chant the Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਤੁਮਰੇ ਗੁਣ ਗਾਉ ॥",
      "transliteration": "saadhasa(n)g tumare gun gaau ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, I sing Your Glorious Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੁਮੑਰੀ ਦਇਆ ਤੇ ਹੋਇ ਦਰਦ ਬਿਨਾਸੁ ॥",
      "transliteration": "tumhree daiaa te hoi darad binaas ||",
      "translation": "In Your Mercy, You take away our pains.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤੁਮਰੀ ਮਇਆ ਤੇ ਕਮਲ ਬਿਗਾਸੁ ॥੩॥",
      "transliteration": "tumaree maiaa te kamal bigaas ||3||",
      "translation": "By Your Mercy, the heart-lotus blossoms forth. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਉ ਬਲਿਹਾਰਿ ਜਾਉ ਗੁਰਦੇਵ ॥",
      "transliteration": "hau balihaar jaau guradev ||",
      "translation": "I am a sacrifice to the Divine Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਫਲ ਦਰਸਨੁ ਜਾ ਕੀ ਨਿਰਮਲ ਸੇਵ ॥",
      "transliteration": "saphal darasan jaa kee niramal sev ||",
      "translation": "The Blessed Vision of His Darshan is fruitful and rewarding; His service is immaculate and pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦਇਆ ਕਰਹੁ ਠਾਕੁਰ ਪ੍ਰਭ ਮੇਰੇ ॥",
      "transliteration": "daiaa karahu thaakur prabh mere ||",
      "translation": "Be Merciful to me, O my Lord God and Master,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਣ ਗਾਵੈ ਨਾਨਕੁ ਨਿਤ ਤੇਰੇ ॥੪॥੧੮॥੩੧॥",
      "transliteration": "gun gaavai naanak nit tere ||4||18||31||",
      "translation": "that Nanak may continually sing Your Glorious Praises. ||4||18||31||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਭ ਤੇ ਊਚ ਜਾ ਕਾ ਦਰਬਾਰੁ ॥",
      "transliteration": "sabh te ooch jaa kaa darabaar ||",
      "translation": "His Regal Court is the highest of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਤਾ ਕਉ ਜੋਹਾਰੁ ॥",
      "transliteration": "sadaa sadaa taa kau johaar ||",
      "translation": "I humbly bow to Him, forever and ever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਊਚੇ ਤੇ ਊਚਾ ਜਾ ਕਾ ਥਾਨ ॥",
      "transliteration": "ooche te oochaa jaa kaa thaan ||",
      "translation": "His place is the highest of the high.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕੋਟਿ ਅਘਾ ਮਿਟਹਿ ਹਰਿ ਨਾਮ ॥੧॥",
      "transliteration": "kot aghaa mitahi har naam ||1||",
      "translation": "Millions of sins are erased by the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਿਸੁ ਸਰਣਾਈ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "tis saranaaee sadaa sukh hoi ||",
      "translation": "In His Sanctuary, we find eternal peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਾ ਕਉ ਮੇਲੈ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa jaa kau melai soi ||1|| rahaau ||",
      "translation": "He Mercifully unites us with Himself. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਾ ਕੇ ਕਰਤਬ ਲਖੇ ਨ ਜਾਹਿ ॥",
      "transliteration": "jaa ke karatab lakhe na jaahi ||",
      "translation": "His wondrous actions cannot even be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਾ ਕਾ ਭਰਵਾਸਾ ਸਭ ਘਟ ਮਾਹਿ ॥",
      "transliteration": "jaa kaa bharavaasaa sabh ghat maahi ||",
      "translation": "All hearts rest their faith and hope in Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪ੍ਰਗਟ ਭਇਆ ਸਾਧੂ ਕੈ ਸੰਗਿ ॥",
      "transliteration": "pragat bhaiaa saadhoo kai sa(n)g ||",
      "translation": "He is manifest in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਭਗਤ ਅਰਾਧਹਿ ਅਨਦਿਨੁ ਰੰਗਿ ॥੨॥",
      "transliteration": "bhagat araadhahi anadin ra(n)g ||2||",
      "translation": "The devotees lovingly worship and adore Him night and day. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਦੇਦੇ ਤੋਟਿ ਨਹੀ ਭੰਡਾਰ ॥",
      "transliteration": "dede tot nahee bha(n)daar ||",
      "translation": "He gives, but His treasures are never exhausted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਥਾਪਿ ਉਥਾਪਨਹਾਰ ॥",
      "transliteration": "khin mahi thaap uthaapanahaar ||",
      "translation": "In an instant, He establishes and disestablishes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਾ ਕਾ ਹੁਕਮੁ ਨ ਮੇਟੈ ਕੋਇ ॥",
      "transliteration": "jaa kaa hukam na metai koi ||",
      "translation": "No one can erase the Hukam of His Command.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸਿਰਿ ਪਾਤਿਸਾਹਾ ਸਾਚਾ ਸੋਇ ॥੩॥",
      "transliteration": "sir paatisaahaa saachaa soi ||3||",
      "translation": "The True Lord is above the heads of kings. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1144_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜਿਸ ਕੀ ਓਟ ਤਿਸੈ ਕੀ ਆਸਾ ॥",
      "transliteration": "jis kee ot tisai kee aasaa ||",
      "translation": "He is my Anchor and Support; I place my hopes in Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1144,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
