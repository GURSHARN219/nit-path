{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1145,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1145_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੁਖੁ ਸੁਖੁ ਹਮਰਾ ਤਿਸ ਹੀ ਪਾਸਾ ॥",
      "transliteration": "dukh sukh hamaraa tis hee paasaa ||",
      "translation": "I place my pain and pleasure before Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਰਾਖਿ ਲੀਨੋ ਸਭੁ ਜਨ ਕਾ ਪੜਦਾ ॥",
      "transliteration": "raakh leeno sabh jan kaa paRadaa ||",
      "translation": "He covers the faults of His humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਨਕੁ ਤਿਸ ਕੀ ਉਸਤਤਿ ਕਰਦਾ ॥੪॥੧੯॥੩੨॥",
      "transliteration": "naanak tis kee usatat karadaa ||4||19||32||",
      "translation": "Nanak sings His Praises. ||4||19||32||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਰੋਵਨਹਾਰੀ ਰੋਜੁ ਬਨਾਇਆ ॥",
      "transliteration": "rovanahaaree roj banaaiaa ||",
      "translation": "The whiner whines every day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਲਨ ਬਰਤਨ ਕਉ ਸਨਬੰਧੁ ਚਿਤਿ ਆਇਆ ॥",
      "transliteration": "balan baratan kau sanaba(n)dh chit aaiaa ||",
      "translation": "His attachment to his household and entanglements cloud his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬੂਝਿ ਬੈਰਾਗੁ ਕਰੇ ਜੇ ਕੋਇ ॥",
      "transliteration": "boojh bairaag kare je koi ||",
      "translation": "If someone becomes detached through understanding,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਨਮ ਮਰਣ ਫਿਰਿ ਸੋਗੁ ਨ ਹੋਇ ॥੧॥",
      "transliteration": "janam maran phir sog na hoi ||1||",
      "translation": "he will not have to suffer in birth and death again. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਖਿਆ ਕਾ ਸਭੁ ਧੰਧੁ ਪਸਾਰੁ ॥",
      "transliteration": "bikhiaa kaa sabh dha(n)dh pasaar ||",
      "translation": "All of his conflicts are extensions of his corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਵਿਰਲੈ ਕੀਨੋ ਨਾਮ ਅਧਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "viralai keeno naam adhaar ||1|| rahaau ||",
      "translation": "How rare is that person who takes the Naam as his Support. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤ੍ਰਿਬਿਧਿ ਮਾਇਆ ਰਹੀ ਬਿਆਪਿ ॥",
      "transliteration": "tribidh maaiaa rahee biaap ||",
      "translation": "The three-phased Maya infects all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੋ ਲਪਟਾਨੋ ਤਿਸੁ ਦੂਖ ਸੰਤਾਪ ॥",
      "transliteration": "jo lapataano tis dookh sa(n)taap ||",
      "translation": "Whoever clings to it suffers pain and sorrow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੁਖੁ ਨਾਹੀ ਬਿਨੁ ਨਾਮ ਧਿਆਏ ॥",
      "transliteration": "sukh naahee bin naam dhiaae ||",
      "translation": "There is no peace without meditating on the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਮ ਨਿਧਾਨੁ ਬਡਭਾਗੀ ਪਾਏ ॥੨॥",
      "transliteration": "naam nidhaan badabhaagee paae ||2||",
      "translation": "By great good fortune, the treasure of the Naam is received. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸ੍ਵਾਂਗੀ ਸਿਉ ਜੋ ਮਨੁ ਰੀਝਾਵੈ ॥",
      "transliteration": "svaa(n)gee siu jo man reejhaavai ||",
      "translation": "One who loves the actor in his mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸ੍ਵਾਗਿ ਉਤਾਰਿਐ ਫਿਰਿ ਪਛੁਤਾਵੈ ॥",
      "transliteration": "svaag utaariai phir pachhutaavai ||",
      "translation": "later regrets it when the actor takes off his costume.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੇਘ ਕੀ ਛਾਇਆ ਜੈਸੇ ਬਰਤਨਹਾਰ ॥",
      "transliteration": "megh kee chhaaiaa jaise baratanahaar ||",
      "translation": "The shade from a cloud is transitory,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤੈਸੋ ਪਰਪੰਚੁ ਮੋਹ ਬਿਕਾਰ ॥੩॥",
      "transliteration": "taiso parapa(n)ch moh bikaar ||3||",
      "translation": "like the worldly paraphernalia of attachment and corruption. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਏਕ ਵਸਤੁ ਜੇ ਪਾਵੈ ਕੋਇ ॥",
      "transliteration": "ek vasat je paavai koi ||",
      "translation": "If someone is blessed with the singular substance,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪੂਰਨ ਕਾਜੁ ਤਾਹੀ ਕਾ ਹੋਇ ॥",
      "transliteration": "pooran kaaj taahee kaa hoi ||",
      "translation": "then all of his tasks are accomplished to perfection.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਜਿਨਿ ਪਾਇਆ ਨਾਮੁ ॥",
      "transliteration": "gur prasaad jin paaiaa naam ||",
      "translation": "One who obtains the Naam, by Guru's Grace",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਨਕ ਆਇਆ ਸੋ ਪਰਵਾਨੁ ॥੪॥੨੦॥੩੩॥",
      "transliteration": "naanak aaiaa so paravaan ||4||20||33||",
      "translation": "- O Nanak, his coming into the world is certified and approved. ||4||20||33||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੰਤ ਕੀ ਨਿੰਦਾ ਜੋਨੀ ਭਵਨਾ ॥",
      "transliteration": "sa(n)t kee ni(n)daa jonee bhavanaa ||",
      "translation": "Slandering the Saints, the mortal wanders in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੰਤ ਕੀ ਨਿੰਦਾ ਰੋਗੀ ਕਰਨਾ ॥",
      "transliteration": "sa(n)t kee ni(n)daa rogee karanaa ||",
      "translation": "Slandering the Saints, he is diseased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੰਤ ਕੀ ਨਿੰਦਾ ਦੂਖ ਸਹਾਮ ॥",
      "transliteration": "sa(n)t kee ni(n)daa dookh sahaam ||",
      "translation": "Slandering the Saints, he suffers in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਡਾਨੁ ਦੈਤ ਨਿੰਦਕ ਕਉ ਜਾਮ ॥੧॥",
      "transliteration": "daan dait ni(n)dak kau jaam ||1||",
      "translation": "The slanderer is punished by the Messenger of Death. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੰਤਸੰਗਿ ਕਰਹਿ ਜੋ ਬਾਦੁ ॥",
      "transliteration": "sa(n)tasa(n)g karahi jo baad ||",
      "translation": "Those who argue and fight with the Saints",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਿਨ ਨਿੰਦਕ ਨਾਹੀ ਕਿਛੁ ਸਾਦੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tin ni(n)dak naahee kichh saad ||1|| rahaau ||",
      "translation": "- those slanderers find no happiness at all. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਗਤ ਕੀ ਨਿੰਦਾ ਕੰਧੁ ਛੇਦਾਵੈ ॥",
      "transliteration": "bhagat kee ni(n)daa ka(n)dh chhedaavai ||",
      "translation": "Slandering the devotees, the wall of the mortal's body is shattered.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਗਤ ਕੀ ਨਿੰਦਾ ਨਰਕੁ ਭੁੰਚਾਵੈ ॥",
      "transliteration": "bhagat kee ni(n)daa narak bhu(n)chaavai ||",
      "translation": "Slandering the devotees, he suffers in hell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭਗਤ ਕੀ ਨਿੰਦਾ ਗਰਭ ਮਹਿ ਗਲੈ ॥",
      "transliteration": "bhagat kee ni(n)daa garabh mahi galai ||",
      "translation": "Slandering the devotees, he rots in the womb.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਗਤ ਕੀ ਨਿੰਦਾ ਰਾਜ ਤੇ ਟਲੈ ॥੨॥",
      "transliteration": "bhagat kee ni(n)daa raaj te talai ||2||",
      "translation": "Slandering the devotees, he loses his realm and power. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਿੰਦਕ ਕੀ ਗਤਿ ਕਤਹੂ ਨਾਹਿ ॥",
      "transliteration": "ni(n)dak kee gat katahoo naahi ||",
      "translation": "The slanderer finds no salvation at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਪਿ ਬੀਜਿ ਆਪੇ ਹੀ ਖਾਹਿ ॥",
      "transliteration": "aap beej aape hee khaahi ||",
      "translation": "He eats only that which he himself has planted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਚੋਰ ਜਾਰ ਜੂਆਰ ਤੇ ਬੁਰਾ ॥",
      "transliteration": "chor jaar jooaar te buraa ||",
      "translation": "He is worse than a thief, a lecher, or a gambler.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਣਹੋਦਾ ਭਾਰੁ ਨਿੰਦਕਿ ਸਿਰਿ ਧਰਾ ॥੩॥",
      "transliteration": "anahodaa bhaar ni(n)dak sir dharaa ||3||",
      "translation": "The slanderer places an unbearable burden upon his head. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕੇ ਭਗਤ ਨਿਰਵੈਰ ॥",
      "transliteration": "paarabraham ke bhagat niravair ||",
      "translation": "The devotees of the Supreme Lord God are beyond hate and vengeance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੋ ਨਿਸਤਰੈ ਜੋ ਪੂਜੈ ਪੈਰ ॥",
      "transliteration": "so nisatarai jo poojai pair ||",
      "translation": "Whoever worships their feet is emancipated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਦਿ ਪੁਰਖਿ ਨਿੰਦਕੁ ਭੋਲਾਇਆ ॥",
      "transliteration": "aad purakh ni(n)dak bholaaiaa ||",
      "translation": "The Primal Lord God has deluded and confused the slanderer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਨਾਨਕ ਕਿਰਤੁ ਨ ਜਾਇ ਮਿਟਾਇਆ ॥੪॥੨੧॥੩੪॥",
      "transliteration": "naanak kirat na jaai mitaaiaa ||4||21||34||",
      "translation": "O Nanak, the record of one's past actions cannot be erased. ||4||21||34||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਬੇਦ ਅਰੁ ਨਾਦ ॥",
      "transliteration": "naam hamaarai bed ar naad ||",
      "translation": "The Naam, the Name of the Lord, is for me the Vedas and the Sound-current of the Naad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਪੂਰੇ ਕਾਜ ॥",
      "transliteration": "naam hamaarai poore kaaj ||",
      "translation": "Through the Naam, my tasks are perfectly accomplished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਪੂਜਾ ਦੇਵ ॥",
      "transliteration": "naam hamaarai poojaa dev ||",
      "translation": "The Naam is my worship of deities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਗੁਰ ਕੀ ਸੇਵ ॥੧॥",
      "transliteration": "naam hamaarai gur kee sev ||1||",
      "translation": "The Naam is my service to the Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਦ੍ਰਿੜਿਓ ਹਰਿ ਨਾਮੁ ॥",
      "transliteration": "gur poorai driRio har naam ||",
      "translation": "The Perfect Guru has implanted the Naam within me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਭ ਤੇ ਊਤਮੁ ਹਰਿ ਹਰਿ ਕਾਮੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sabh te ootam har har kaam ||1|| rahaau ||",
      "translation": "The highest task of all is the Name of the Lord, Har, Har. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਮਜਨ ਇਸਨਾਨੁ ॥",
      "transliteration": "naam hamaarai majan isanaan ||",
      "translation": "The Naam is my cleansing bath and purification.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਪੂਰਨ ਦਾਨੁ ॥",
      "transliteration": "naam hamaarai pooran daan ||",
      "translation": "The Naam is my perfect donation of charity.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਤੇ ਸਗਲ ਪਵੀਤ ॥",
      "transliteration": "naam lait te sagal paveet ||",
      "translation": "Those who repeat the Naam are totally purified.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਮੇਰੇ ਭਾਈ ਮੀਤ ॥੨॥",
      "transliteration": "naam japat mere bhaaee meet ||2||",
      "translation": "Those who chant the Naam are my friends and Siblings of Destiny. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਸਉਣ ਸੰਜੋਗ ॥",
      "transliteration": "naam hamaarai saun sa(n)jog ||",
      "translation": "The Naam is my auspicious omen and good fortune.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਤ੍ਰਿਪਤਿ ਸੁਭੋਗ ॥",
      "transliteration": "naam hamaarai tripat subhog ||",
      "translation": "The Naam is the sublime food which satisfies me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਸਗਲ ਆਚਾਰ ॥",
      "transliteration": "naam hamaarai sagal aachaar ||",
      "translation": "The Naam is my good conduct.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਮੁ ਹਮਾਰੈ ਨਿਰਮਲ ਬਿਉਹਾਰ ॥੩॥",
      "transliteration": "naam hamaarai niramal biuhaar ||3||",
      "translation": "The Naam is my immaculate occupation. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਾ ਕੈ ਮਨਿ ਵਸਿਆ ਪ੍ਰਭੁ ਏਕੁ ॥",
      "transliteration": "jaa kai man vasiaa prabh ek ||",
      "translation": "All those humble beings whose minds are filled with the One God",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਸਗਲ ਜਨਾ ਕੀ ਹਰਿ ਹਰਿ ਟੇਕ ॥",
      "transliteration": "sagal janaa kee har har tek ||",
      "translation": "have the Support of the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਮਨਿ ਤਨਿ ਨਾਨਕ ਹਰਿ ਗੁਣ ਗਾਉ ॥",
      "transliteration": "man tan naanak har gun gaau ||",
      "translation": "O Nanak, sing the Glorious Praises of the Lord with your mind and body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1145_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਜਿਸੁ ਦੇਵੈ ਨਾਉ ॥੪॥੨੨॥੩੫॥",
      "transliteration": "saadhasa(n)g jis devai naau ||4||22||35||",
      "translation": "In the Saadh Sangat, the Company of the Holy, the Lord bestows His Name. ||4||22||35||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1145,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
