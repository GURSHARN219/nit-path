{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1146,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1146_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਿਰਧਨ ਕਉ ਤੁਮ ਦੇਵਹੁ ਧਨਾ ॥",
      "transliteration": "niradhan kau tum devahu dhanaa ||",
      "translation": "You bless the poor with wealth, O Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਨਿਕ ਪਾਪ ਜਾਹਿ ਨਿਰਮਲ ਮਨਾ ॥",
      "transliteration": "anik paap jaahi niramal manaa ||",
      "translation": "Countless sins are taken away, and the mind becomes immaculate and pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਗਲ ਮਨੋਰਥ ਪੂਰਨ ਕਾਮ ॥",
      "transliteration": "sagal manorath pooran kaam ||",
      "translation": "All the mind's desires are fulfilled, and one's tasks are perfectly accomplished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਗਤ ਅਪੁਨੇ ਕਉ ਦੇਵਹੁ ਨਾਮ ॥੧॥",
      "transliteration": "bhagat apune kau devahu naam ||1||",
      "translation": "You bestow Your Name upon Your devotee. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਫਲ ਸੇਵਾ ਗੋਪਾਲ ਰਾਇ ॥",
      "transliteration": "saphal sevaa gopaal raai ||",
      "translation": "Service to the Lord, our Sovereign King, is fruitful and rewarding.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨਹਾਰ ਸੁਆਮੀ ਤਾ ਤੇ ਬਿਰਥਾ ਕੋਇ ਨ ਜਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "karan karaavanahaar suaamee taa te birathaa koi na jaai ||1|| rahaau ||",
      "translation": "Our Lord and Master is the Creator, the Cause of causes; no one is turned away from His Door empty-handed. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰੋਗੀ ਕਾ ਪ੍ਰਭ ਖੰਡਹੁ ਰੋਗੁ ॥",
      "transliteration": "rogee kaa prabh kha(n)dahu rog ||",
      "translation": "God eradicates the disease from the diseased person.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੁਖੀਏ ਕਾ ਮਿਟਾਵਹੁ ਪ੍ਰਭ ਸੋਗੁ ॥",
      "transliteration": "dukheee kaa mitaavahu prabh sog ||",
      "translation": "God takes away the sorrows of the suffering.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਿਥਾਵੇ ਕਉ ਤੁਮੑ ਥਾਨਿ ਬੈਠਾਵਹੁ ॥",
      "transliteration": "nithaave kau tumh thaan baithaavahu ||",
      "translation": "And those who have no place at all - You seat them upon the place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦਾਸ ਅਪਨੇ ਕਉ ਭਗਤੀ ਲਾਵਹੁ ॥੨॥",
      "transliteration": "daas apane kau bhagatee laavahu ||2||",
      "translation": "You link Your slave to devotional worship. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਿਮਾਣੇ ਕਉ ਪ੍ਰਭ ਦੇਤੋ ਮਾਨੁ ॥",
      "transliteration": "nimaane kau prabh deto maan ||",
      "translation": "God bestows honor on the dishonored.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮੂੜ ਮੁਗਧੁ ਹੋਇ ਚਤੁਰ ਸੁਗਿਆਨੁ ॥",
      "transliteration": "mooR mugadh hoi chatur sugiaan ||",
      "translation": "He makes the foolish and ignorant become clever and wise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਗਲ ਭਇਆਨ ਕਾ ਭਉ ਨਸੈ ॥",
      "transliteration": "sagal bhaiaan kaa bhau nasai ||",
      "translation": "The fear of all fear disappears.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਨ ਅਪਨੇ ਕੈ ਹਰਿ ਮਨਿ ਬਸੈ ॥੩॥",
      "transliteration": "jan apane kai har man basai ||3||",
      "translation": "The Lord dwells within the mind of His humble servant. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਪ੍ਰਭ ਸੂਖ ਨਿਧਾਨ ॥",
      "transliteration": "paarabraham prabh sookh nidhaan ||",
      "translation": "The Supreme Lord God is the Treasure of Peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਤੁ ਗਿਆਨੁ ਹਰਿ ਅੰਮ੍ਰਿਤ ਨਾਮ ॥",
      "transliteration": "tat giaan har a(n)mrit naam ||",
      "translation": "The Ambrosial Name of the Lord is the essence of reality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਸੰਤ ਟਹਲੈ ਲਾਏ ॥",
      "transliteration": "kar kirapaa sa(n)t tahalai laae ||",
      "translation": "Granting His Grace, He enjoins the mortals to serve the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਸਾਧੂ ਸੰਗਿ ਸਮਾਏ ॥੪॥੨੩॥੩੬॥",
      "transliteration": "naanak saadhoo sa(n)g samaae ||4||23||36||",
      "translation": "O Nanak, such a person merges in the Saadh Sangat, the Company of the Holy. ||4||23||36||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੰਤ ਮੰਡਲ ਮਹਿ ਹਰਿ ਮਨਿ ਵਸੈ ॥",
      "transliteration": "sa(n)t ma(n)dal mahi har man vasai ||",
      "translation": "In the Realm of the Saints, the Lord dwells in the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੰਤ ਮੰਡਲ ਮਹਿ ਦੁਰਤੁ ਸਭੁ ਨਸੈ ॥",
      "transliteration": "sa(n)t ma(n)dal mahi durat sabh nasai ||",
      "translation": "In the Realm of the Saints, all sins run away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੰਤ ਮੰਡਲ ਮਹਿ ਨਿਰਮਲ ਰੀਤਿ ॥",
      "transliteration": "sa(n)t ma(n)dal mahi niramal reet ||",
      "translation": "In the Realm of the Saints, one's lifestyle is immaculate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੰਤਸੰਗਿ ਹੋਇ ਏਕ ਪਰੀਤਿ ॥੧॥",
      "transliteration": "sa(n)tasa(n)g hoi ek pareet ||1||",
      "translation": "In the Society of the Saints, one comes to love the One Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੰਤ ਮੰਡਲੁ ਤਹਾ ਕਾ ਨਾਉ ॥",
      "transliteration": "sa(n)t ma(n)dal tahaa kaa naau ||",
      "translation": "That alone is called the Realm of the Saints,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕੇਵਲ ਗੁਣ ਗਾਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "paarabraham keval gun gaau ||1|| rahaau ||",
      "translation": "where only the Glorious Praises of the Supreme Lord God are sung. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੰਤ ਮੰਡਲ ਮਹਿ ਜਨਮ ਮਰਣੁ ਰਹੈ ॥",
      "transliteration": "sa(n)t ma(n)dal mahi janam maran rahai ||",
      "translation": "In the Realm of the Saints, birth and death are ended.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੰਤ ਮੰਡਲ ਮਹਿ ਜਮੁ ਕਿਛੂ ਨ ਕਹੈ ॥",
      "transliteration": "sa(n)t ma(n)dal mahi jam kichhoo na kahai ||",
      "translation": "In the Realm of the Saints, the Messenger of Death cannot touch the mortal.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੰਤਸੰਗਿ ਹੋਇ ਨਿਰਮਲ ਬਾਣੀ ॥",
      "transliteration": "sa(n)tasa(n)g hoi niramal baanee ||",
      "translation": "In the Society of the Saints, one's speech becomes immaculate",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੰਤ ਮੰਡਲ ਮਹਿ ਨਾਮੁ ਵਖਾਣੀ ॥੨॥",
      "transliteration": "sa(n)t ma(n)dal mahi naam vakhaanee ||2||",
      "translation": "In the realm of the saints, the Lord's Name is chanted. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸੰਤ ਮੰਡਲ ਕਾ ਨਿਹਚਲ ਆਸਨੁ ॥",
      "transliteration": "sa(n)t ma(n)dal kaa nihachal aasan ||",
      "translation": "The Realm of the Saints is the eternal, ever-stable place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੰਤ ਮੰਡਲ ਮਹਿ ਪਾਪ ਬਿਨਾਸਨੁ ॥",
      "transliteration": "sa(n)t ma(n)dal mahi paap binaasan ||",
      "translation": "In the Realm of the Saints, sins are destroyed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੰਤ ਮੰਡਲ ਮਹਿ ਨਿਰਮਲ ਕਥਾ ॥",
      "transliteration": "sa(n)t ma(n)dal mahi niramal kathaa ||",
      "translation": "In the Realm of the Saints, the immaculate sermon is spoken.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੰਤਸੰਗਿ ਹਉਮੈ ਦੁਖ ਨਸਾ ॥੩॥",
      "transliteration": "sa(n)tasa(n)g haumai dukh nasaa ||3||",
      "translation": "In the Society of the Saints, the pain of egotism runs away. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੰਤ ਮੰਡਲ ਕਾ ਨਹੀ ਬਿਨਾਸੁ ॥",
      "transliteration": "sa(n)t ma(n)dal kaa nahee binaas ||",
      "translation": "The Realm of the Saints cannot be destroyed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੰਤ ਮੰਡਲ ਮਹਿ ਹਰਿ ਗੁਣਤਾਸੁ ॥",
      "transliteration": "sa(n)t ma(n)dal mahi har gunataas ||",
      "translation": "In the Realm of the Saints, is the Lord, the Treasure of Virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੰਤ ਮੰਡਲ ਠਾਕੁਰ ਬਿਸ੍ਰਾਮੁ ॥",
      "transliteration": "sa(n)t ma(n)dal thaakur bisraam ||",
      "translation": "The Realm of the Saints is the resting place of our Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਨਕ ਓਤਿ ਪੋਤਿ ਭਗਵਾਨੁ ॥੪॥੨੪॥੩੭॥",
      "transliteration": "naanak ot pot bhagavaan ||4||24||37||",
      "translation": "O Nanak, He is woven into the fabric of His devotees, through and through. ||4||24||37||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰੋਗੁ ਕਵਨੁ ਜਾਂ ਰਾਖੈ ਆਪਿ ॥",
      "transliteration": "rog kavan jaa(n) raakhai aap ||",
      "translation": "Why worry about disease, when the Lord Himself protects us?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਹੋਇ ਨ ਦੂਖੁ ਸੰਤਾਪੁ ॥",
      "transliteration": "tis jan hoi na dookh sa(n)taap ||",
      "translation": "That person whom the Lord protects, does not suffer pain and sorrow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਸੁ ਊਪਰਿ ਪ੍ਰਭੁ ਕਿਰਪਾ ਕਰੈ ॥",
      "transliteration": "jis oopar prabh kirapaa karai ||",
      "translation": "That person, upon whom God showers His Mercy",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਿਸੁ ਊਪਰ ਤੇ ਕਾਲੁ ਪਰਹਰੈ ॥੧॥",
      "transliteration": "tis oopar te kaal paraharai ||1||",
      "translation": "- Death hovering above him is turned away. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਦਾ ਸਖਾਈ ਹਰਿ ਹਰਿ ਨਾਮੁ ॥",
      "transliteration": "sadaa sakhaaee har har naam ||",
      "translation": "The Name of the Lord, Har, Har, is forever our Help and Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਿਸੁ ਚੀਤਿ ਆਵੈ ਤਿਸੁ ਸਦਾ ਸੁਖੁ ਹੋਵੈ ਨਿਕਟਿ ਨ ਆਵੈ ਤਾ ਕੈ ਜਾਮੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jis cheet aavai tis sadaa sukh hovai nikat na aavai taa kai jaam ||1|| rahaau ||",
      "translation": "When He comes to mind, the mortal finds lasting peace, and the Messenger of Death cannot even approach him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਬ ਇਹੁ ਨ ਸੋ ਤਬ ਕਿਨਹਿ ਉਪਾਇਆ ॥",
      "transliteration": "jab ihu na so tab kinahi upaaiaa ||",
      "translation": "When this being did not exist, who created him then?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕਵਨ ਮੂਲ ਤੇ ਕਿਆ ਪ੍ਰਗਟਾਇਆ ॥",
      "transliteration": "kavan mool te kiaa pragataaiaa ||",
      "translation": "What has been produced from the source?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਆਪਹਿ ਮਾਰਿ ਆਪਿ ਜੀਵਾਲੈ ॥",
      "transliteration": "aapahi maar aap jeevaalai ||",
      "translation": "He Himself kills, and He Himself rejuvenates.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਪਨੇ ਭਗਤ ਕਉ ਸਦਾ ਪ੍ਰਤਿਪਾਲੈ ॥੨॥",
      "transliteration": "apane bhagat kau sadaa pratipaalai ||2||",
      "translation": "He cherishes His devotees forever. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਭ ਕਿਛੁ ਜਾਣਹੁ ਤਿਸ ਕੈ ਹਾਥ ॥",
      "transliteration": "sabh kichh jaanahu tis kai haath ||",
      "translation": "Know that everything is in His Hands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪ੍ਰਭੁ ਮੇਰੋ ਅਨਾਥ ਕੋ ਨਾਥ ॥",
      "transliteration": "prabh mero anaath ko naath ||",
      "translation": "My God is the Master of the masterless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਦੁਖ ਭੰਜਨੁ ਤਾ ਕਾ ਹੈ ਨਾਉ ॥",
      "transliteration": "dukh bha(n)jan taa kaa hai naau ||",
      "translation": "His Name is the Destroyer of pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੁਖ ਪਾਵਹਿ ਤਿਸ ਕੇ ਗੁਣ ਗਾਉ ॥੩॥",
      "transliteration": "sukh paavahi tis ke gun gaau ||3||",
      "translation": "Singing His Glorious Praises, you shall find peace. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੁਣਿ ਸੁਆਮੀ ਸੰਤਨ ਅਰਦਾਸਿ ॥",
      "transliteration": "sun suaamee sa(n)tan aradaas ||",
      "translation": "O my Lord and Master, please listen to the prayer of Your Saint.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜੀਉ ਪ੍ਰਾਨ ਧਨੁ ਤੁਮੑਰੈ ਪਾਸਿ ॥",
      "transliteration": "jeeu praan dhan tumhrai paas ||",
      "translation": "I place my soul, my breath of life and wealth before You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1146_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਇਹੁ ਜਗੁ ਤੇਰਾ ਸਭ ਤੁਝਹਿ ਧਿਆਏ ॥",
      "transliteration": "ihu jag teraa sabh tujhahi dhiaae ||",
      "translation": "All this world is Yours; it meditates on You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1146,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
