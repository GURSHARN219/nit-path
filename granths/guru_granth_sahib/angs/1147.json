{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1147,
  "lineCount": 60,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1147_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਨਾਨਕ ਸੁਖੁ ਪਾਏ ॥੪॥੨੫॥੩੮॥",
      "transliteration": "kar kirapaa naanak sukh paae ||4||25||38||",
      "translation": "Please shower Nanak with Your Mercy and bless him with peace. ||4||25||38||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤੇਰੀ ਟੇਕ ਰਹਾ ਕਲਿ ਮਾਹਿ ॥",
      "transliteration": "teree tek rahaa kal maahi ||",
      "translation": "With Your Support, I survive in the Dark Age of Kali Yuga.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤੇਰੀ ਟੇਕ ਤੇਰੇ ਗੁਣ ਗਾਹਿ ॥",
      "transliteration": "teree tek tere gun gaahi ||",
      "translation": "With Your Support, I sing Your Glorious Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤੇਰੀ ਟੇਕ ਨ ਪੋਹੈ ਕਾਲੁ ॥",
      "transliteration": "teree tek na pohai kaal ||",
      "translation": "With Your Support, death cannot even touch me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੇਰੀ ਟੇਕ ਬਿਨਸੈ ਜੰਜਾਲੁ ॥੧॥",
      "transliteration": "teree tek binasai ja(n)jaal ||1||",
      "translation": "With Your Support, my entanglements vanish. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦੀਨ ਦੁਨੀਆ ਤੇਰੀ ਟੇਕ ॥",
      "transliteration": "deen duneeaa teree tek ||",
      "translation": "In this world and the next, I have Your Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਭ ਮਹਿ ਰਵਿਆ ਸਾਹਿਬੁ ਏਕ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sabh mahi raviaa saahib ek ||1|| rahaau ||",
      "translation": "The One Lord, our Lord and Master, is all-pervading. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤੇਰੀ ਟੇਕ ਕਰਉ ਆਨੰਦ ॥",
      "transliteration": "teree tek karau aana(n)d ||",
      "translation": "With Your Support, I celebrate blissfully.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤੇਰੀ ਟੇਕ ਜਪਉ ਗੁਰ ਮੰਤ ॥",
      "transliteration": "teree tek japau gur ma(n)t ||",
      "translation": "With Your Support, I chant the Guru's Mantra.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੇਰੀ ਟੇਕ ਤਰੀਐ ਭਉ ਸਾਗਰੁ ॥",
      "transliteration": "teree tek tareeai bhau saagar ||",
      "translation": "With Your Support, I cross over the terrifying world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰਾਖਣਹਾਰੁ ਪੂਰਾ ਸੁਖ ਸਾਗਰੁ ॥੨॥",
      "transliteration": "raakhanahaar pooraa sukh saagar ||2||",
      "translation": "The Perfect Lord, our Protector and Savior, is the Ocean of Peace. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤੇਰੀ ਟੇਕ ਨਾਹੀ ਭਉ ਕੋਇ ॥",
      "transliteration": "teree tek naahee bhau koi ||",
      "translation": "With Your Support, I have no fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅੰਤਰਜਾਮੀ ਸਾਚਾ ਸੋਇ ॥",
      "transliteration": "a(n)tarajaamee saachaa soi ||",
      "translation": "The True Lord is the Inner-knower, the Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤੇਰੀ ਟੇਕ ਤੇਰਾ ਮਨਿ ਤਾਣੁ ॥",
      "transliteration": "teree tek teraa man taan ||",
      "translation": "With Your Support, my mind is filled with Your Power.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਈਹਾਂ ਊਹਾਂ ਤੂ ਦੀਬਾਣੁ ॥੩॥",
      "transliteration": "eehaa(n) oohaa(n) too deebaan ||3||",
      "translation": "Here and there, You are my Court of Appeal. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤੇਰੀ ਟੇਕ ਤੇਰਾ ਭਰਵਾਸਾ ॥",
      "transliteration": "teree tek teraa bharavaasaa ||",
      "translation": "I take Your Support, and place my faith in You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਗਲ ਧਿਆਵਹਿ ਪ੍ਰਭ ਗੁਣਤਾਸਾ ॥",
      "transliteration": "sagal dhiaavahi prabh gunataasaa ||",
      "translation": "All meditate on God, the Treasure of Virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਪਿ ਜਪਿ ਅਨਦੁ ਕਰਹਿ ਤੇਰੇ ਦਾਸਾ ॥",
      "transliteration": "jap jap anad karahi tere daasaa ||",
      "translation": "Chanting and meditating on You, Your slaves celebrate in bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਿਮਰਿ ਨਾਨਕ ਸਾਚੇ ਗੁਣਤਾਸਾ ॥੪॥੨੬॥੩੯॥",
      "transliteration": "simar naanak saache gunataasaa ||4||26||39||",
      "translation": "Nanak meditates in remembrance on the True Lord, the Treasure of Virtue. ||4||26||39||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਥਮੇ ਛੋਡੀ ਪਰਾਈ ਨਿੰਦਾ ॥",
      "transliteration": "prathame chhodee paraaee ni(n)daa ||",
      "translation": "First, I gave up slandering others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਉਤਰਿ ਗਈ ਸਭ ਮਨ ਕੀ ਚਿੰਦਾ ॥",
      "transliteration": "utar gaee sabh man kee chi(n)daa ||",
      "translation": "All the anxiety of my mind was dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਲੋਭੁ ਮੋਹੁ ਸਭੁ ਕੀਨੋ ਦੂਰਿ ॥",
      "transliteration": "lobh mohu sabh keeno door ||",
      "translation": "Greed and attachment were totally banished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪਰਮ ਬੈਸਨੋ ਪ੍ਰਭ ਪੇਖਿ ਹਜੂਰਿ ॥੧॥",
      "transliteration": "param baisano prabh pekh hajoor ||1||",
      "translation": "I see God ever-present, close at hand; I have become a great devotee. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਐਸੋ ਤਿਆਗੀ ਵਿਰਲਾ ਕੋਇ ॥",
      "transliteration": "aiso tiaagee viralaa koi ||",
      "translation": "Such a renunciate is very rare.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਪੈ ਜਨੁ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har har naam japai jan soi ||1|| rahaau ||",
      "translation": "Such a humble servant chants the Name of the Lord, Har, Har. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਹੰਬੁਧਿ ਕਾ ਛੋਡਿਆ ਸੰਗੁ ॥",
      "transliteration": "aha(n)budh kaa chhodiaa sa(n)g ||",
      "translation": "I have forsaken my egotistical intellect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਕਾ ਉਤਰਿਆ ਰੰਗੁ ॥",
      "transliteration": "kaam krodh kaa utariaa ra(n)g ||",
      "translation": "The love of sexual desire and anger has vanished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਾਮ ਧਿਆਏ ਹਰਿ ਹਰਿ ਹਰੇ ॥",
      "transliteration": "naam dhiaae har har hare ||",
      "translation": "I meditate on the Naam, the Name of the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਾਧ ਜਨਾ ਕੈ ਸੰਗਿ ਨਿਸਤਰੇ ॥੨॥",
      "transliteration": "saadh janaa kai sa(n)g nisatare ||2||",
      "translation": "In the Company of the Holy, I am emancipated. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬੈਰੀ ਮੀਤ ਹੋਏ ਸੰਮਾਨ ॥",
      "transliteration": "bairee meet hoe sa(n)maan ||",
      "translation": "Enemy and friend are all the same to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਰਬ ਮਹਿ ਪੂਰਨ ਭਗਵਾਨ ॥",
      "transliteration": "sarab mahi pooran bhagavaan ||",
      "translation": "The Perfect Lord God is permeating all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਆਗਿਆ ਮਾਨਿ ਸੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "prabh kee aagiaa maan sukh paaiaa ||",
      "translation": "Accepting the Will of God, I have found peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਹਰਿ ਨਾਮੁ ਦ੍ਰਿੜਾਇਆ ॥੩॥",
      "transliteration": "gur poorai har naam driRaaiaa ||3||",
      "translation": "The Perfect Guru has implanted the Name of the Lord within me. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਰਾਖੈ ਆਪਿ ॥",
      "transliteration": "kar kirapaa jis raakhai aap ||",
      "translation": "That person, whom the Lord, in His Mercy, saves",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੋਈ ਭਗਤੁ ਜਪੈ ਨਾਮ ਜਾਪ ॥",
      "transliteration": "soee bhagat japai naam jaap ||",
      "translation": "that devotee chants and meditates on the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨਿ ਪ੍ਰਗਾਸੁ ਗੁਰ ਤੇ ਮਤਿ ਲਈ ॥",
      "transliteration": "man pragaas gur te mat laee ||",
      "translation": "That person, whose mind is illumined, and who obtains understanding through the Guru",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਤਾ ਕੀ ਪੂਰੀ ਪਈ ॥੪॥੨੭॥੪੦॥",
      "transliteration": "kahu naanak taa kee pooree paee ||4||27||40||",
      "translation": "- says Nanak, he is totally fulfilled. ||4||27||40||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੁਖੁ ਨਾਹੀ ਬਹੁਤੈ ਧਨਿ ਖਾਟੇ ॥",
      "transliteration": "sukh naahee bahutai dhan khaate ||",
      "translation": "There is no peace in earning lots of money.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੁਖੁ ਨਾਹੀ ਪੇਖੇ ਨਿਰਤਿ ਨਾਟੇ ॥",
      "transliteration": "sukh naahee pekhe nirat naate ||",
      "translation": "There is no peace in watching dances and plays.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੁਖੁ ਨਾਹੀ ਬਹੁ ਦੇਸ ਕਮਾਏ ॥",
      "transliteration": "sukh naahee bahu des kamaae ||",
      "translation": "There is no peace in conquering lots of countries.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਰਬ ਸੁਖਾ ਹਰਿ ਹਰਿ ਗੁਣ ਗਾਏ ॥੧॥",
      "transliteration": "sarab sukhaa har har gun gaae ||1||",
      "translation": "All peace comes from singing the Glorious Praises of the Lord, Har, Har. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਆਨੰਦ ਲਹਹੁ ॥",
      "transliteration": "sookh sahaj aana(n)d lahahu ||",
      "translation": "You shall obtain peace, poise and bliss,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਪਾਈਐ ਵਡਭਾਗੀ ਗੁਰਮੁਖਿ ਹਰਿ ਹਰਿ ਨਾਮੁ ਕਹਹੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saadhasa(n)gat paaeeai vadabhaagee guramukh har har naam kahahu ||1|| rahaau ||",
      "translation": "when you find the Saadh Sangat, the Company of the Holy, by great good fortune. As Gurmukh, utter the Name of the Lord, Har, Har. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬੰਧਨ ਮਾਤ ਪਿਤਾ ਸੁਤ ਬਨਿਤਾ ॥",
      "transliteration": "ba(n)dhan maat pitaa sut banitaa ||",
      "translation": "Mother, father, children and spouse - all place the mortal in bondage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬੰਧਨ ਕਰਮ ਧਰਮ ਹਉ ਕਰਤਾ ॥",
      "transliteration": "ba(n)dhan karam dharam hau karataa ||",
      "translation": "Religious rituals and actions done in ego place the mortal in bondage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬੰਧਨ ਕਾਟਨਹਾਰੁ ਮਨਿ ਵਸੈ ॥",
      "transliteration": "ba(n)dhan kaatanahaar man vasai ||",
      "translation": "If the Lord, the Shatterer of bonds, abides in the mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਉ ਸੁਖੁ ਪਾਵੈ ਨਿਜ ਘਰਿ ਬਸੈ ॥੨॥",
      "transliteration": "tau sukh paavai nij ghar basai ||2||",
      "translation": "then peace is obtained, dwelling in the home of the self deep within. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਭਿ ਜਾਚਿਕ ਪ੍ਰਭ ਦੇਵਨਹਾਰ ॥",
      "transliteration": "sabh jaachik prabh devanahaar ||",
      "translation": "Everyone is a beggar; God is the Great Giver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਣ ਨਿਧਾਨ ਬੇਅੰਤ ਅਪਾਰ ॥",
      "transliteration": "gun nidhaan bea(n)t apaar ||",
      "translation": "The Treasure of Virtue is the Infinite, Endless Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਿਸ ਨੋ ਕਰਮੁ ਕਰੇ ਪ੍ਰਭੁ ਅਪਨਾ ॥",
      "transliteration": "jis no karam kare prabh apanaa ||",
      "translation": "That person, unto whom God grants His Mercy",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਤਿਨੈ ਜਨਿ ਜਪਨਾ ॥੩॥",
      "transliteration": "har har naam tinai jan japanaa ||3||",
      "translation": "- that humble being chants the Name of the Lord, Har, Har. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਗੁਰ ਅਪਨੇ ਆਗੈ ਅਰਦਾਸਿ ॥",
      "transliteration": "gur apane aagai aradaas ||",
      "translation": "I offer my prayer to my Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪੁਰਖ ਗੁਣਤਾਸਿ ॥",
      "transliteration": "kar kirapaa purakh gunataas ||",
      "translation": "O Primal Lord God, Treasure of Virtue, please bless me with Your Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਤੁਮਰੀ ਸਰਣਾਈ ॥",
      "transliteration": "kahu naanak tumaree saranaaee ||",
      "translation": "Says Nanak, I have come to Your Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਿਉ ਭਾਵੈ ਤਿਉ ਰਖਹੁ ਗੁਸਾਈ ॥੪॥੨੮॥੪੧॥",
      "transliteration": "jiu bhaavai tiu rakhahu gusaaee ||4||28||41||",
      "translation": "If it pleases You, please protect me, O Lord of the World. ||4||28||41||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1147_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਗੁਰ ਮਿਲਿ ਤਿਆਗਿਓ ਦੂਜਾ ਭਾਉ ॥",
      "transliteration": "gur mil tiaagio doojaa bhaau ||",
      "translation": "Meeting with the Guru, I have forsaken the love of duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1147,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
