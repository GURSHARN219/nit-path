{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1148,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1148_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਜਪਿਓ ਹਰਿ ਕਾ ਨਾਉ ॥",
      "transliteration": "guramukh japio har kaa naau ||",
      "translation": "As Gurmukh, I chant the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਸਰੀ ਚਿੰਤ ਨਾਮਿ ਰੰਗੁ ਲਾਗਾ ॥",
      "transliteration": "bisaree chi(n)t naam ra(n)g laagaa ||",
      "translation": "My anxiety is gone, and I am in love with the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕਾ ਸੋਇਆ ਜਾਗਾ ॥੧॥",
      "transliteration": "janam janam kaa soiaa jaagaa ||1||",
      "translation": "I was asleep for countless lifetimes, but I have now awakened. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਅਪਨੀ ਸੇਵਾ ਲਾਏ ॥",
      "transliteration": "kar kirapaa apanee sevaa laae ||",
      "translation": "Granting His Grace, He has linked me to His service.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਧੂ ਸੰਗਿ ਸਰਬ ਸੁਖ ਪਾਏ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saadhoo sa(n)g sarab sukh paae ||1|| rahaau ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, all pleasures are found. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰੋਗ ਦੋਖ ਗੁਰ ਸਬਦਿ ਨਿਵਾਰੇ ॥",
      "transliteration": "rog dokh gur sabad nivaare ||",
      "translation": "The Word of the Guru's Shabad has eradicated disease and evil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਮ ਅਉਖਧੁ ਮਨ ਭੀਤਰਿ ਸਾਰੇ ॥",
      "transliteration": "naam aukhadh man bheetar saare ||",
      "translation": "My mind has absorbed the medicine of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰ ਭੇਟਤ ਮਨਿ ਭਇਆ ਅਨੰਦ ॥",
      "transliteration": "gur bhetat man bhaiaa ana(n)d ||",
      "translation": "Meeting with the Guru, my mind is in bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਰਬ ਨਿਧਾਨ ਨਾਮ ਭਗਵੰਤ ॥੨॥",
      "transliteration": "sarab nidhaan naam bhagava(n)t ||2||",
      "translation": "All treasures are in the Name of the Lord God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਨਮ ਮਰਣ ਕੀ ਮਿਟੀ ਜਮ ਤ੍ਰਾਸ ॥",
      "transliteration": "janam maran kee mitee jam traas ||",
      "translation": "My fear of birth and death and the Messenger of Death has been dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਊਂਧ ਕਮਲ ਬਿਗਾਸ ॥",
      "transliteration": "saadhasa(n)gat oo(n)dh kamal bigaas ||",
      "translation": "In the Saadh Sangat, the inverted lotus of my heart has blossomed forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਣ ਗਾਵਤ ਨਿਹਚਲੁ ਬਿਸ੍ਰਾਮ ॥",
      "transliteration": "gun gaavat nihachal bisraam ||",
      "translation": "Singing the Glorious Praises of the Lord, I have found eternal, abiding peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪੂਰਨ ਹੋਏ ਸਗਲੇ ਕਾਮ ॥੩॥",
      "transliteration": "pooran hoe sagale kaam ||3||",
      "translation": "All my tasks are perfectly accomplished. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੁਲਭ ਦੇਹ ਆਈ ਪਰਵਾਨੁ ॥",
      "transliteration": "dulabh deh aaee paravaan ||",
      "translation": "This human body, so difficult to obtain, is approved by the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਫਲ ਹੋਈ ਜਪਿ ਹਰਿ ਹਰਿ ਨਾਮੁ ॥",
      "transliteration": "saphal hoee jap har har naam ||",
      "translation": "Chanting the Name of the Lord, Har, Har, it has become fruitful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਪ੍ਰਭਿ ਕਿਰਪਾ ਕਰੀ ॥",
      "transliteration": "kahu naanak prabh kirapaa karee ||",
      "translation": "Says Nanak, God has blessed me with His Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਾਸਿ ਗਿਰਾਸਿ ਜਪਉ ਹਰਿ ਹਰੀ ॥੪॥੨੯॥੪੨॥",
      "transliteration": "saas giraas japau har haree ||4||29||42||",
      "translation": "With every breath and morsel of food, I meditate on the Lord, Har, Har. ||4||29||42||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਭ ਤੇ ਊਚਾ ਜਾ ਕਾ ਨਾਉ ॥",
      "transliteration": "sabh te oochaa jaa kaa naau ||",
      "translation": "His Name is the Highest of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਤਾ ਕੇ ਗੁਣ ਗਾਉ ॥",
      "transliteration": "sadaa sadaa taa ke gun gaau ||",
      "translation": "Sing His Glorious Praises, forever and ever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਸੁ ਸਿਮਰਤ ਸਗਲਾ ਦੁਖੁ ਜਾਇ ॥",
      "transliteration": "jis simarat sagalaa dukh jaai ||",
      "translation": "Meditating in remembrance on Him, all pain is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਰਬ ਸੂਖ ਵਸਹਿ ਮਨਿ ਆਇ ॥੧॥",
      "transliteration": "sarab sookh vasahi man aai ||1||",
      "translation": "All pleasures come to dwell in the mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਿਮਰਿ ਮਨਾ ਤੂ ਸਾਚਾ ਸੋਇ ॥",
      "transliteration": "simar manaa too saachaa soi ||",
      "translation": "O my mind, meditate in remembrance on the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਲਤਿ ਪਲਤਿ ਤੁਮਰੀ ਗਤਿ ਹੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "halat palat tumaree gat hoi ||1|| rahaau ||",
      "translation": "In this world and the next, you shall be saved. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪੁਰਖ ਨਿਰੰਜਨ ਸਿਰਜਨਹਾਰ ॥",
      "transliteration": "purakh nira(n)jan sirajanahaar ||",
      "translation": "The Immaculate Lord God is the Creator of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਦੇਵੈ ਆਹਾਰ ॥",
      "transliteration": "jee ja(n)t devai aahaar ||",
      "translation": "He gives sustenance to all beings and creatures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕੋਟਿ ਖਤੇ ਖਿਨ ਬਖਸਨਹਾਰ ॥",
      "transliteration": "kot khate khin bakhasanahaar ||",
      "translation": "He forgives millions of sins and mistakes in an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭਗਤਿ ਭਾਇ ਸਦਾ ਨਿਸਤਾਰ ॥੨॥",
      "transliteration": "bhagat bhaai sadaa nisataar ||2||",
      "translation": "Through loving devotional worship, one is emancipated forever. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਾਚਾ ਧਨੁ ਸਾਚੀ ਵਡਿਆਈ ॥",
      "transliteration": "saachaa dhan saachee vadiaaee ||",
      "translation": "True wealth and true glorious greatness,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਤੇ ਨਿਹਚਲ ਮਤਿ ਪਾਈ ॥",
      "transliteration": "gur poore te nihachal mat paaee ||",
      "translation": "and eternal, unchanging wisdom, are obtained from the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਰਾਖਨਹਾਰਾ ॥",
      "transliteration": "kar kirapaa jis raakhanahaaraa ||",
      "translation": "When the Protector, the Savior Lord, bestows His Mercy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਕਾ ਸਗਲ ਮਿਟੈ ਅੰਧਿਆਰਾ ॥੩॥",
      "transliteration": "taa kaa sagal mitai a(n)dhiaaraa ||3||",
      "translation": "all spiritual darkness is dispelled. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਸਿਉ ਲਾਗੋ ਧਿਆਨ ॥",
      "transliteration": "paarabraham siu laago dhiaan ||",
      "translation": "I focus my meditation on the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪੂਰਨ ਪੂਰਿ ਰਹਿਓ ਨਿਰਬਾਨ ॥",
      "transliteration": "pooran poor rahio nirabaan ||",
      "translation": "The Lord of Nirvaanaa is totally pervading and permeating all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭ੍ਰਮ ਭਉ ਮੇਟਿ ਮਿਲੇ ਗੋਪਾਲ ॥",
      "transliteration": "bhram bhau met mile gopaal ||",
      "translation": "Eradicating doubt and fear, I have met the Lord of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਗੁਰ ਭਏ ਦਇਆਲ ॥੪॥੩੦॥੪੩॥",
      "transliteration": "naanak kau gur bhae daiaal ||4||30||43||",
      "translation": "The Guru has become merciful to Nanak. ||4||30||43||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਸੁ ਸਿਮਰਤ ਮਨਿ ਹੋਇ ਪ੍ਰਗਾਸੁ ॥",
      "transliteration": "jis simarat man hoi pragaas ||",
      "translation": "Meditating in remembrance on Him, the mind is illumined.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਿਟਹਿ ਕਲੇਸ ਸੁਖ ਸਹਜਿ ਨਿਵਾਸੁ ॥",
      "transliteration": "mitahi kales sukh sahaj nivaas ||",
      "translation": "Suffering is eradicated, and one comes to dwell in peace and poise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਿਸਹਿ ਪਰਾਪਤਿ ਜਿਸੁ ਪ੍ਰਭੁ ਦੇਇ ॥",
      "transliteration": "tisahi paraapat jis prabh dei ||",
      "translation": "They alone receive it, unto whom God gives it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਕੀ ਪਾਏ ਸੇਵ ॥੧॥",
      "transliteration": "poore gur kee paae sev ||1||",
      "translation": "They are blessed to serve the Perfect Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਰਬ ਸੁਖਾ ਪ੍ਰਭ ਤੇਰੋ ਨਾਉ ॥",
      "transliteration": "sarab sukhaa prabh tero naau ||",
      "translation": "All peace and comfort are in Your Name, God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਆਠ ਪਹਰ ਮੇਰੇ ਮਨ ਗਾਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aath pahar mere man gaau ||1|| rahaau ||",
      "translation": "Twenty-four hours a day, O my mind, sing His Glorious Praises. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੋ ਇਛੈ ਸੋਈ ਫਲੁ ਪਾਏ ॥",
      "transliteration": "jo ichhai soee phal paae ||",
      "translation": "You shall receive the fruits of your desires,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਮੰਨਿ ਵਸਾਏ ॥",
      "transliteration": "har kaa naam ma(n)n vasaae ||",
      "translation": "when the Name of the Lord comes to dwell in the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਵਣ ਜਾਣ ਰਹੇ ਹਰਿ ਧਿਆਇ ॥",
      "transliteration": "aavan jaan rahe har dhiaai ||",
      "translation": "Meditating on the Lord, your comings and goings cease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਭਗਤਿ ਭਾਇ ਪ੍ਰਭ ਕੀ ਲਿਵ ਲਾਇ ॥੨॥",
      "transliteration": "bhagat bhaai prabh kee liv laai ||2||",
      "translation": "Through loving devotional worship, lovingly focus your attention on God. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਬਿਨਸੇ ਕਾਮ ਕ੍ਰੋਧ ਅਹੰਕਾਰ ॥",
      "transliteration": "binase kaam krodh aha(n)kaar ||",
      "translation": "Sexual desire, anger and egotism are dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤੂਟੇ ਮਾਇਆ ਮੋਹ ਪਿਆਰ ॥",
      "transliteration": "toote maaiaa moh piaar ||",
      "translation": "Love and attachment to Maya are broken.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਟੇਕ ਰਹੈ ਦਿਨੁ ਰਾਤਿ ॥",
      "transliteration": "prabh kee tek rahai din raat ||",
      "translation": "Lean on God's Support, day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਕਰੇ ਜਿਸੁ ਦਾਤਿ ॥੩॥",
      "transliteration": "paarabraham kare jis daat ||3||",
      "translation": "The Supreme Lord God has given this gift. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਰਨ ਕਰਾਵਨਹਾਰ ਸੁਆਮੀ ॥",
      "transliteration": "karan karaavanahaar suaamee ||",
      "translation": "Our Lord and Master is the Creator, the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਗਲ ਘਟਾ ਕੇ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "sagal ghataa ke a(n)tarajaamee ||",
      "translation": "He is the Inner-knower, the Searcher of all hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਅਪਨੀ ਸੇਵਾ ਲਾਇ ॥",
      "transliteration": "kar kirapaa apanee sevaa laai ||",
      "translation": "Bless me with Your Grace, Lord, and link me to Your service.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਤੇਰੀ ਸਰਣਾਇ ॥੪॥੩੧॥੪੪॥",
      "transliteration": "naanak daas teree saranaai ||4||31||44||",
      "translation": "Slave Nanak has come to Your Sanctuary. ||4||31||44||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਲਾਜ ਮਰੈ ਜੋ ਨਾਮੁ ਨ ਲੇਵੈ ॥",
      "transliteration": "laaj marai jo naam na levai ||",
      "translation": "One who does not repeat the Naam, the Name of the Lord, shall die of shame.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਨਾਮ ਬਿਹੂਨ ਸੁਖੀ ਕਿਉ ਸੋਵੈ ॥",
      "transliteration": "naam bihoon sukhee kiu sovai ||",
      "translation": "Without the Name, how can he ever sleep in peace?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1148_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨੁ ਛਾਡਿ ਪਰਮ ਗਤਿ ਚਾਹੈ ॥",
      "transliteration": "har simaran chhaad param gat chaahai ||",
      "translation": "The mortal abandons meditative remembrance of the Lord, and then wishes for the state of supreme salvation;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1148,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
