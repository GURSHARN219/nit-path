{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1149,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1149_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮੂਲ ਬਿਨਾ ਸਾਖਾ ਕਤ ਆਹੈ ॥੧॥",
      "transliteration": "mool binaa saakhaa kat aahai ||1||",
      "translation": "but without roots, how can there be any branches? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਰੁ ਗੋਵਿੰਦੁ ਮੇਰੇ ਮਨ ਧਿਆਇ ॥",
      "transliteration": "gur govi(n)d mere man dhiaai ||",
      "translation": "O my mind, meditate on the Guru, the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕੀ ਮੈਲੁ ਉਤਾਰੈ ਬੰਧਨ ਕਾਟਿ ਹਰਿ ਸੰਗਿ ਮਿਲਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "janam janam kee mail utaarai ba(n)dhan kaat har sa(n)g milaai ||1|| rahaau ||",
      "translation": "The filth of countless incarnations shall be washed away. Breaking your bonds, you shall be united with the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਤੀਰਥਿ ਨਾਇ ਕਹਾ ਸੁਚਿ ਸੈਲੁ ॥",
      "transliteration": "teerath naai kahaa such sail ||",
      "translation": "How can a stone be purified by bathing at a sacred shrine of pilgrimage?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਨ ਕਉ ਵਿਆਪੈ ਹਉਮੈ ਮੈਲੁ ॥",
      "transliteration": "man kau viaapai haumai mail ||",
      "translation": "The filth of egotism clings to the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕੋਟਿ ਕਰਮ ਬੰਧਨ ਕਾ ਮੂਲੁ ॥",
      "transliteration": "kot karam ba(n)dhan kaa mool ||",
      "translation": "Millions of rituals and actions taken are the root of entanglements.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਰਿ ਕੇ ਭਜਨ ਬਿਨੁ ਬਿਰਥਾ ਪੂਲੁ ॥੨॥",
      "transliteration": "har ke bhajan bin birathaa pool ||2||",
      "translation": "Without meditating and vibrating on the Lord, the mortal gathers only worthless bundles of straw. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਿਨੁ ਖਾਏ ਬੂਝੈ ਨਹੀ ਭੂਖ ॥",
      "transliteration": "bin khaae boojhai nahee bhookh ||",
      "translation": "Without eating, hunger is not satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਰੋਗੁ ਜਾਇ ਤਾਂ ਉਤਰਹਿ ਦੂਖ ॥",
      "transliteration": "rog jaai taa(n) utarahi dookh ||",
      "translation": "When the disease is cured, then the pain goes away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਲੋਭ ਮੋਹਿ ਬਿਆਪਿਆ ॥",
      "transliteration": "kaam krodh lobh mohi biaapiaa ||",
      "translation": "The mortal is engrossed in sexual desire, anger, greed and attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਨਿ ਪ੍ਰਭਿ ਕੀਨਾ ਸੋ ਪ੍ਰਭੁ ਨਹੀ ਜਾਪਿਆ ॥੩॥",
      "transliteration": "jin prabh keenaa so prabh nahee jaapiaa ||3||",
      "translation": "He does not meditate on God, that God who created him. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਧਨੁ ਧਨੁ ਸਾਧ ਧੰਨੁ ਹਰਿ ਨਾਉ ॥",
      "transliteration": "dhan dhan saadh dha(n)n har naau ||",
      "translation": "Blessed, blessed is the Holy Saint, and blessed is the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਠ ਪਹਰ ਕੀਰਤਨੁ ਗੁਣ ਗਾਉ ॥",
      "transliteration": "aath pahar keeratan gun gaau ||",
      "translation": "Twenty-four hours a day, sing the Kirtan, the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਧਨੁ ਹਰਿ ਭਗਤਿ ਧਨੁ ਕਰਣੈਹਾਰ ॥",
      "transliteration": "dhan har bhagat dhan karanaihaar ||",
      "translation": "Blessed is the devotee of the Lord, and blessed is the Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਰਣਿ ਨਾਨਕ ਪ੍ਰਭ ਪੁਰਖ ਅਪਾਰ ॥੪॥੩੨॥੪੫॥",
      "transliteration": "saran naanak prabh purakh apaar ||4||32||45||",
      "translation": "Nanak seeks the Sanctuary of God, the Primal, the Infinite. ||4||32||45||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰ ਸੁਪ੍ਰਸੰਨ ਹੋਏ ਭਉ ਗਏ ॥",
      "transliteration": "gur suprasa(n)n hoe bhau gae ||",
      "translation": "When the Guru was totally pleased, my fear was taken away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮ ਨਿਰੰਜਨ ਮਨ ਮਹਿ ਲਏ ॥",
      "transliteration": "naam nira(n)jan man mahi lae ||",
      "translation": "I enshrine the Name of the Immaculate Lord within my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਦੀਨ ਦਇਆਲ ਸਦਾ ਕਿਰਪਾਲ ॥",
      "transliteration": "deen daiaal sadaa kirapaal ||",
      "translation": "He is Merciful to the meek, forever Compassionate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਨਸਿ ਗਏ ਸਗਲੇ ਜੰਜਾਲ ॥੧॥",
      "transliteration": "binas gae sagale ja(n)jaal ||1||",
      "translation": "All my entanglements are finished. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੂਖ ਸਹਜ ਆਨੰਦ ਘਨੇ ॥",
      "transliteration": "sookh sahaj aana(n)d ghane ||",
      "translation": "I have found peace, poise, and myriads of pleasures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਮਿਟੇ ਭੈ ਭਰਮਾ ਅੰਮ੍ਰਿਤੁ ਹਰਿ ਹਰਿ ਰਸਨ ਭਨੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saadhasa(n)g mite bhai bharamaa a(n)mrit har har rasan bhane ||1|| rahaau ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, fear and doubt are dispelled. My tongue chants the Ambrosial Name of the Lord, Har, Har. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਸਿਉ ਲਾਗੋ ਹੇਤੁ ॥",
      "transliteration": "charan kamal siu laago het ||",
      "translation": "I have fallen in love with the Lord's Lotus Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਖਿਨ ਮਹਿ ਬਿਨਸਿਓ ਮਹਾ ਪਰੇਤੁ ॥",
      "transliteration": "khin mahi binasio mahaa paret ||",
      "translation": "In an instant, the terrible demons are destroyed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਠ ਪਹਰ ਹਰਿ ਹਰਿ ਜਪੁ ਜਾਪਿ ॥",
      "transliteration": "aath pahar har har jap jaap ||",
      "translation": "Twenty-four hours a day, I meditate and chant the Name of the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਾਖਨਹਾਰ ਗੋਵਿਦ ਗੁਰ ਆਪਿ ॥੨॥",
      "transliteration": "raakhanahaar govid gur aap ||2||",
      "translation": "The Guru is Himself the Savior Lord, the Lord of the Universe. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਪਨੇ ਸੇਵਕ ਕਉ ਸਦਾ ਪ੍ਰਤਿਪਾਰੈ ॥",
      "transliteration": "apane sevak kau sadaa pratipaarai ||",
      "translation": "He Himself cherishes His servant forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭਗਤ ਜਨਾ ਕੇ ਸਾਸ ਨਿਹਾਰੈ ॥",
      "transliteration": "bhagat janaa ke saas nihaarai ||",
      "translation": "He watches over every breath of His humble devotee.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਾਨਸ ਕੀ ਕਹੁ ਕੇਤਕ ਬਾਤ ॥",
      "transliteration": "maanas kee kahu ketak baat ||",
      "translation": "Tell me, what is the nature of human beings?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਮ ਤੇ ਰਾਖੈ ਦੇ ਕਰਿ ਹਾਥ ॥੩॥",
      "transliteration": "jam te raakhai de kar haath ||3||",
      "translation": "The Lord extends His Hand, and saves them from the Messenger of Death. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਿਰਮਲ ਸੋਭਾ ਨਿਰਮਲ ਰੀਤਿ ॥",
      "transliteration": "niramal sobhaa niramal reet ||",
      "translation": "Immaculate is the Glory, and Immaculate is the way of life,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਆਇਆ ਮਨਿ ਚੀਤਿ ॥",
      "transliteration": "paarabraham aaiaa man cheet ||",
      "translation": "of those who remember the Supreme Lord God in their minds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਗੁਰਿ ਦੀਨੋ ਦਾਨੁ ॥",
      "transliteration": "kar kirapaa gur deeno daan ||",
      "translation": "The Guru, in His Mercy, has granted this Gift.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਨਕ ਪਾਇਆ ਨਾਮੁ ਨਿਧਾਨੁ ॥੪॥੩੩॥੪੬॥",
      "transliteration": "naanak paaiaa naam nidhaan ||4||33||46||",
      "translation": "Nanak has obtained the treasure of the Naam, the Name of the Lord. ||4||33||46||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਰਣ ਕਾਰਣ ਸਮਰਥੁ ਗੁਰੁ ਮੇਰਾ ॥",
      "transliteration": "karan kaaran samarath gur meraa ||",
      "translation": "My Guru is the All-powerful Lord, the Creator, the Cause of causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜੀਅ ਪ੍ਰਾਣ ਸੁਖਦਾਤਾ ਨੇਰਾ ॥",
      "transliteration": "jee praan sukhadaataa neraa ||",
      "translation": "He is the Soul, the Breath of Life, the Giver of Peace, always near.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਭੈ ਭੰਜਨ ਅਬਿਨਾਸੀ ਰਾਇ ॥",
      "transliteration": "bhai bha(n)jan abinaasee raai ||",
      "translation": "He is the Destroyer of fear, the Eternal, Unchanging, Sovereign Lord King.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦਰਸਨਿ ਦੇਖਿਐ ਸਭੁ ਦੁਖੁ ਜਾਇ ॥੧॥",
      "transliteration": "darasan dekhiai sabh dukh jaai ||1||",
      "translation": "Gazing upon the Blessed Vision of His Darshan, all fear is dispelled. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਤ ਕਤ ਪੇਖਉ ਤੇਰੀ ਸਰਣਾ ॥",
      "transliteration": "jat kat pekhau teree saranaa ||",
      "translation": "Wherever I look, is the Protection of Your Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਲਿ ਬਲਿ ਜਾਈ ਸਤਿਗੁਰ ਚਰਣਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bal bal jaaee satigur charanaa ||1|| rahaau ||",
      "translation": "I am a sacrifice, a sacrifice to the Feet of the True Guru. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪੂਰਨ ਕਾਮ ਮਿਲੇ ਗੁਰਦੇਵ ॥",
      "transliteration": "pooran kaam mile guradev ||",
      "translation": "My tasks are perfectly accomplished, meeting the Divine Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਭਿ ਫਲਦਾਤਾ ਨਿਰਮਲ ਸੇਵ ॥",
      "transliteration": "sabh phaladaataa niramal sev ||",
      "translation": "He is the Giver of all rewards. Serving Him, I am immaculate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕਰੁ ਗਹਿ ਲੀਨੇ ਅਪੁਨੇ ਦਾਸ ॥",
      "transliteration": "kar gahi leene apune daas ||",
      "translation": "He reaches out with His Hand to His slaves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਰਿਦ ਦੀਓ ਨਿਵਾਸ ॥੨॥",
      "transliteration": "raam naam rid deeo nivaas ||2||",
      "translation": "The Name of the Lord abides in their hearts. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸਦਾ ਅਨੰਦੁ ਨਾਹੀ ਕਿਛੁ ਸੋਗੁ ॥",
      "transliteration": "sadaa ana(n)d naahee kichh sog ||",
      "translation": "They are forever in bliss, and do not suffer at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਦੂਖੁ ਦਰਦੁ ਨਹ ਬਿਆਪੈ ਰੋਗੁ ॥",
      "transliteration": "dookh darad nah biaapai rog ||",
      "translation": "No pain, sorrow or disease afflicts them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਭੁ ਕਿਛੁ ਤੇਰਾ ਤੂ ਕਰਣੈਹਾਰੁ ॥",
      "transliteration": "sabh kichh teraa too karanaihaar ||",
      "translation": "Everything is Yours, O Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਗੁਰ ਅਗਮ ਅਪਾਰ ॥੩॥",
      "transliteration": "paarabraham gur agam apaar ||3||",
      "translation": "The Guru is the Supreme Lord God, the Inaccessible and Infinite. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਿਰਮਲ ਸੋਭਾ ਅਚਰਜ ਬਾਣੀ ॥",
      "transliteration": "niramal sobhaa acharaj baanee ||",
      "translation": "His Glorious Grandeur is immaculate, and the Bani of His Word is wonderful!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਪੂਰਨ ਮਨਿ ਭਾਣੀ ॥",
      "transliteration": "paarabraham pooran man bhaanee ||",
      "translation": "The Perfect Supreme Lord God is pleasing to my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ ਰਵਿਆ ਸੋਇ ॥",
      "transliteration": "jal thal maheeal raviaa soi ||",
      "translation": "He is permeating the waters, the lands and the skies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾਨਕ ਸਭੁ ਕਿਛੁ ਪ੍ਰਭ ਤੇ ਹੋਇ ॥੪॥੩੪॥੪੭॥",
      "transliteration": "naanak sabh kichh prabh te hoi ||4||34||47||",
      "translation": "O Nanak, everything comes from God. ||4||34||47||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1149_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਰਾਤਾ ਰਾਮ ਰੰਗਿ ਚਰਣੇ ॥",
      "transliteration": "man tan raataa raam ra(n)g charane ||",
      "translation": "My mind and body are imbued with the Love of the Lord's Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1149,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
