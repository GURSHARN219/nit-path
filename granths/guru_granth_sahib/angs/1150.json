{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1150,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1150_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਰਬ ਮਨੋਰਥ ਪੂਰਨ ਕਰਣੇ ॥",
      "transliteration": "sarab manorath pooran karane ||",
      "translation": "All the desires of my mind have been perfectly fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਆਠ ਪਹਰ ਗਾਵਤ ਭਗਵੰਤੁ ॥",
      "transliteration": "aath pahar gaavat bhagava(n)t ||",
      "translation": "Twenty-four hours a day, I sing of the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਦੀਨੋ ਪੂਰਾ ਮੰਤੁ ॥੧॥",
      "transliteration": "satigur deeno pooraa ma(n)t ||1||",
      "translation": "The True Guru has imparted this perfect wisdom. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸੋ ਵਡਭਾਗੀ ਜਿਸੁ ਨਾਮਿ ਪਿਆਰੁ ॥",
      "transliteration": "so vadabhaagee jis naam piaar ||",
      "translation": "Very fortunate are those who love the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਿਸ ਕੈ ਸੰਗਿ ਤਰੈ ਸੰਸਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tis kai sa(n)g tarai sa(n)saar ||1|| rahaau ||",
      "translation": "Associating with them, we cross over the world-ocean. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੋਈ ਗਿਆਨੀ ਜਿ ਸਿਮਰੈ ਏਕ ॥",
      "transliteration": "soee giaanee j simarai ek ||",
      "translation": "They are spiritual teachers, who meditate in remembrance on the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੋ ਧਨਵੰਤਾ ਜਿਸੁ ਬੁਧਿ ਬਿਬੇਕ ॥",
      "transliteration": "so dhanava(n)taa jis budh bibek ||",
      "translation": "Wealthy are those who have a discriminating intellect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸੋ ਕੁਲਵੰਤਾ ਜਿ ਸਿਮਰੈ ਸੁਆਮੀ ॥",
      "transliteration": "so kulava(n)taa j simarai suaamee ||",
      "translation": "Noble are those who remember their Lord and Master in meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸੋ ਪਤਿਵੰਤਾ ਜਿ ਆਪੁ ਪਛਾਨੀ ॥੨॥",
      "transliteration": "so pativa(n)taa j aap pachhaanee ||2||",
      "translation": "Honorable are those who understand their own selves. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਪਰਮ ਪਦੁ ਪਾਇਆ ॥",
      "transliteration": "gur parasaad param pad paaiaa ||",
      "translation": "By Guru's Grace, I have obtained the supreme status.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਣ ਗੋੁਪਾਲ ਦਿਨੁ ਰੈਨਿ ਧਿਆਇਆ ॥",
      "transliteration": "gun goupaal din rain dhiaaiaa ||",
      "translation": "Day and night I meditate on the Glories of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੂਟੇ ਬੰਧਨ ਪੂਰਨ ਆਸਾ ॥",
      "transliteration": "toote ba(n)dhan pooran aasaa ||",
      "translation": "My bonds are broken, and my hopes are fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਰਿ ਕੇ ਚਰਣ ਰਿਦ ਮਾਹਿ ਨਿਵਾਸਾ ॥੩॥",
      "transliteration": "har ke charan rid maahi nivaasaa ||3||",
      "translation": "The Feet of the Lord now abide in my heart. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਜਾ ਕੇ ਪੂਰਨ ਕਰਮਾ ॥",
      "transliteration": "kahu naanak jaa ke pooran karamaa ||",
      "translation": "Says Nanak, one whose karma is perfect",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੋ ਜਨੁ ਆਇਆ ਪ੍ਰਭ ਕੀ ਸਰਨਾ ॥",
      "transliteration": "so jan aaiaa prabh kee saranaa ||",
      "translation": "that humble being enters the Sanctuary of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਆਪਿ ਪਵਿਤੁ ਪਾਵਨ ਸਭਿ ਕੀਨੇ ॥",
      "transliteration": "aap pavit paavan sabh keene ||",
      "translation": "He himself is pure, and he sanctifies all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਮ ਰਸਾਇਣੁ ਰਸਨਾ ਚੀਨੑੇ ॥੪॥੩੫॥੪੮॥",
      "transliteration": "raam rasaain rasanaa cheenhe ||4||35||48||",
      "translation": "His tongue chants the Name of the Lord, the Source of Nectar. ||4||35||48||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਕਿਛੁ ਬਿਘਨੁ ਨ ਲਾਗੈ ॥",
      "transliteration": "naam lait kichh bighan na laagai ||",
      "translation": "Repeating the Naam, the Name of the Lord, no obstacles block the way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਮੁ ਸੁਣਤ ਜਮੁ ਦੂਰਹੁ ਭਾਗੈ ॥",
      "transliteration": "naam sunat jam doorahu bhaagai ||",
      "translation": "Listening to the Naam, the Messenger of Death runs far away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਨਾਮੁ ਲੈਤ ਸਭ ਦੂਖਹ ਨਾਸੁ ॥",
      "transliteration": "naam lait sabh dookhah naas ||",
      "translation": "Repeating the Naam, all pains vanish.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਹਰਿ ਚਰਣ ਨਿਵਾਸੁ ॥੧॥",
      "transliteration": "naam japat har charan nivaas ||1||",
      "translation": "Chanting the Naam, the Lord's Lotus Feet dwell within. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਿਰਬਿਘਨ ਭਗਤਿ ਭਜੁ ਹਰਿ ਹਰਿ ਨਾਉ ॥",
      "transliteration": "nirabighan bhagat bhaj har har naau ||",
      "translation": "Meditating, vibrating the Name of the Lord, Har, Har, is unobstructed devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਸਕਿ ਰਸਕਿ ਹਰਿ ਕੇ ਗੁਣ ਗਾਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "rasak rasak har ke gun gaau ||1|| rahaau ||",
      "translation": "Sing the Glorious Praises of the Lord with loving affection and energy. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਕਿਛੁ ਚਾਖੁ ਨ ਜੋਹੈ ॥",
      "transliteration": "har simarat kichh chaakh na johai ||",
      "translation": "Meditating in remembrance on the Lord, the Eye of Death cannot see you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਦੈਤ ਦੇਉ ਨ ਪੋਹੈ ॥",
      "transliteration": "har simarat dait deu na pohai ||",
      "translation": "Meditating in remembrance on the Lord, demons and ghosts shall not touch you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਮੋਹੁ ਮਾਨੁ ਨ ਬਧੈ ॥",
      "transliteration": "har simarat mohu maan na badhai ||",
      "translation": "Meditating in remembrance on the Lord, attachment and pride shall not bind you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਗਰਭ ਜੋਨਿ ਨ ਰੁਧੈ ॥੨॥",
      "transliteration": "har simarat garabh jon na rudhai ||2||",
      "translation": "Meditating in remembrance on the Lord, you shall not be consigned to the womb of reincarnation. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨ ਕੀ ਸਗਲੀ ਬੇਲਾ ॥",
      "transliteration": "har simaran kee sagalee belaa ||",
      "translation": "Any time is a good time to meditate in remembrance on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨੁ ਬਹੁ ਮਾਹਿ ਇਕੇਲਾ ॥",
      "transliteration": "har simaran bahu maahi ikelaa ||",
      "translation": "Among the masses, only a few meditate in remembrance on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾਤਿ ਅਜਾਤਿ ਜਪੈ ਜਨੁ ਕੋਇ ॥",
      "transliteration": "jaat ajaat japai jan koi ||",
      "translation": "Social class or no social class, anyone may meditate on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੋ ਜਾਪੈ ਤਿਸ ਕੀ ਗਤਿ ਹੋਇ ॥੩॥",
      "transliteration": "jo jaapai tis kee gat hoi ||3||",
      "translation": "Whoever meditates on Him is emancipated. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਜਪੀਐ ਸਾਧਸੰਗਿ ॥",
      "transliteration": "har kaa naam japeeai saadhasa(n)g ||",
      "translation": "Chant the Name of the Lord in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਰਿ ਕੇ ਨਾਮ ਕਾ ਪੂਰਨ ਰੰਗੁ ॥",
      "transliteration": "har ke naam kaa pooran ra(n)g ||",
      "translation": "Perfect is the Love of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਪ੍ਰਭ ਕਿਰਪਾ ਧਾਰਿ ॥",
      "transliteration": "naanak kau prabh kirapaa dhaar ||",
      "translation": "O God, shower Your Mercy on Nanak,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਾਸਿ ਸਾਸਿ ਹਰਿ ਦੇਹੁ ਚਿਤਾਰਿ ॥੪॥੩੬॥੪੯॥",
      "transliteration": "saas saas har dehu chitaar ||4||36||49||",
      "translation": "that he may think of you with each and every breath. ||4||36||49||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਪੇ ਸਾਸਤੁ ਆਪੇ ਬੇਦੁ ॥",
      "transliteration": "aape saasat aape bed ||",
      "translation": "He Himself is the Shaastras, and He Himself is the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਆਪੇ ਘਟਿ ਘਟਿ ਜਾਣੈ ਭੇਦੁ ॥",
      "transliteration": "aape ghat ghat jaanai bhed ||",
      "translation": "He knows the secrets of each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜੋਤਿ ਸਰੂਪ ਜਾ ਕੀ ਸਭ ਵਥੁ ॥",
      "transliteration": "jot saroop jaa kee sabh vath ||",
      "translation": "He is the Embodiment of Light; all beings belong to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰਣ ਕਾਰਣ ਪੂਰਨ ਸਮਰਥੁ ॥੧॥",
      "transliteration": "karan kaaran pooran samarath ||1||",
      "translation": "The Creator, the Cause of causes, the Perfect All-powerful Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਓਟ ਗਹਹੁ ਮਨ ਮੇਰੇ ॥",
      "transliteration": "prabh kee ot gahahu man mere ||",
      "translation": "Grab hold of the Support of God, O my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਗੁਰਮੁਖਿ ਆਰਾਧਹੁ ਦੁਸਮਨ ਦੂਖੁ ਨ ਆਵੈ ਨੇਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "charan kamal guramukh aaraadhahu dusaman dookh na aavai nere ||1|| rahaau ||",
      "translation": "As Gurmukh, worship and adore His Lotus Feet; enemies and pains shall not even approach you. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਆਪੇ ਵਣੁ ਤ੍ਰਿਣੁ ਤ੍ਰਿਭਵਣ ਸਾਰੁ ॥",
      "transliteration": "aape van trin tribhavan saar ||",
      "translation": "He Himself is the Essence of the forests and fields, and all the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਾ ਕੈ ਸੂਤਿ ਪਰੋਇਆ ਸੰਸਾਰੁ ॥",
      "transliteration": "jaa kai soot paroiaa sa(n)saar ||",
      "translation": "The universe is strung on His Thread.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਪੇ ਸਿਵ ਸਕਤੀ ਸੰਜੋਗੀ ॥",
      "transliteration": "aape siv sakatee sa(n)jogee ||",
      "translation": "He is the Uniter of Shiva and Shakti - mind and matter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਆਪਿ ਨਿਰਬਾਣੀ ਆਪੇ ਭੋਗੀ ॥੨॥",
      "transliteration": "aap nirabaanee aape bhogee ||2||",
      "translation": "He Himself is in the detachment of Nirvaanaa, and He Himself is the Enjoyer. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਤ ਕਤ ਪੇਖਉ ਤਤ ਤਤ ਸੋਇ ॥",
      "transliteration": "jat kat pekhau tat tat soi ||",
      "translation": "Wherever I look, there He is.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤਿਸੁ ਬਿਨੁ ਦੂਜਾ ਨਾਹੀ ਕੋਇ ॥",
      "transliteration": "tis bin doojaa naahee koi ||",
      "translation": "Without Him, there is no one at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਾਗਰੁ ਤਰੀਐ ਨਾਮ ਕੈ ਰੰਗਿ ॥",
      "transliteration": "saagar tareeai naam kai ra(n)g ||",
      "translation": "In the Love of the Naam, the world-ocean is crossed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗੁਣ ਗਾਵੈ ਨਾਨਕੁ ਸਾਧਸੰਗਿ ॥੩॥",
      "transliteration": "gun gaavai naanak saadhasa(n)g ||3||",
      "translation": "Nanak sings His Glorious Praises in the Saadh Sangat, the Company of the Holy. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮੁਕਤਿ ਭੁਗਤਿ ਜੁਗਤਿ ਵਸਿ ਜਾ ਕੈ ॥",
      "transliteration": "mukat bhugat jugat vas jaa kai ||",
      "translation": "Liberation, the ways and means of enjoyment and union are under His Control.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਊਣਾ ਨਾਹੀ ਕਿਛੁ ਜਨ ਤਾ ਕੈ ॥",
      "transliteration": "oonaa naahee kichh jan taa kai ||",
      "translation": "His humble servant lacks nothing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਜਿਸੁ ਹੋਇ ਸੁਪ੍ਰਸੰਨ ॥",
      "transliteration": "kar kirapaa jis hoi suprasa(n)n ||",
      "translation": "That person, with whom the Lord, in His Mercy, is pleased",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਸੇਈ ਜਨ ਧੰਨ ॥੪॥੩੭॥੫੦॥",
      "transliteration": "naanak daas seee jan dha(n)n ||4||37||50||",
      "translation": "- O slave Nanak, that humble servant is blessed. ||4||37||50||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਭਗਤਾ ਮਨਿ ਆਨੰਦੁ ਗੋਬਿੰਦ ॥",
      "transliteration": "bhagataa man aana(n)d gobi(n)d ||",
      "translation": "The minds of the Lord's devotee are filled with bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1150_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਅਸਥਿਤਿ ਭਏ ਬਿਨਸੀ ਸਭ ਚਿੰਦ ॥",
      "transliteration": "asathit bhae binasee sabh chi(n)d ||",
      "translation": "They become stable and permanent, and all their anxiety is gone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1150,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
