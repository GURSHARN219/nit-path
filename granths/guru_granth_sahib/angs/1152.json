{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1152,
  "lineCount": 50,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1152_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਿੰਦਕ ਕਾ ਕਹਿਆ ਕੋਇ ਨ ਮਾਨੈ ॥",
      "transliteration": "ni(n)dak kaa kahiaa koi na maanai ||",
      "translation": "No one belives what the slanderer says.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਿੰਦਕ ਝੂਠੁ ਬੋਲਿ ਪਛੁਤਾਨੇ ॥",
      "transliteration": "ni(n)dak jhooth bol pachhutaane ||",
      "translation": "The slanderer tells lies, and later regrets and repents.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਾਥ ਪਛੋਰਹਿ ਸਿਰੁ ਧਰਨਿ ਲਗਾਹਿ ॥",
      "transliteration": "haath pachhorahi sir dharan lagaahi ||",
      "translation": "He wrings his hands, and hits his head against the ground.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਿੰਦਕ ਕਉ ਦਈ ਛੋਡੈ ਨਾਹਿ ॥੨॥",
      "transliteration": "ni(n)dak kau daee chhodai naahi ||2||",
      "translation": "The Lord does not forgive the slanderer. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹਰਿ ਕਾ ਦਾਸੁ ਕਿਛੁ ਬੁਰਾ ਨ ਮਾਗੈ ॥",
      "transliteration": "har kaa daas kichh buraa na maagai ||",
      "translation": "The Lord's slave does not wish anyone ill.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਿੰਦਕ ਕਉ ਲਾਗੈ ਦੁਖ ਸਾਂਗੈ ॥",
      "transliteration": "ni(n)dak kau laagai dukh saa(n)gai ||",
      "translation": "The slanderer suffers, as if stabbed by a spear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਗੁਲੇ ਜਿਉ ਰਹਿਆ ਪੰਖ ਪਸਾਰਿ ॥",
      "transliteration": "bagule jiu rahiaa pa(n)kh pasaar ||",
      "translation": "Like a crane, he spreads his feathers, to look like a swan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮੁਖ ਤੇ ਬੋਲਿਆ ਤਾਂ ਕਢਿਆ ਬੀਚਾਰਿ ॥੩॥",
      "transliteration": "mukh te boliaa taa(n) kadhiaa beechaar ||3||",
      "translation": "When he speaks with his mouth, then he is exposed and driven out. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅੰਤਰਜਾਮੀ ਕਰਤਾ ਸੋਇ ॥",
      "transliteration": "a(n)tarajaamee karataa soi ||",
      "translation": "The Creator is the Inner-knower, the Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਹਰਿ ਜਨੁ ਕਰੈ ਸੁ ਨਿਹਚਲੁ ਹੋਇ ॥",
      "transliteration": "har jan karai s nihachal hoi ||",
      "translation": "That person, whom the Lord makes His Own, becomes stable and steady.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਰਿ ਕਾ ਦਾਸੁ ਸਾਚਾ ਦਰਬਾਰਿ ॥",
      "transliteration": "har kaa daas saachaa darabaar ||",
      "translation": "The Lord's slave is true in the Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਕਹਿਆ ਤਤੁ ਬੀਚਾਰਿ ॥੪॥੪੧॥੫੪॥",
      "transliteration": "jan naanak kahiaa tat beechaar ||4||41||54||",
      "translation": "Servant Nanak speaks, after contemplating the essence of reality. ||4||41||54||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਦੁਇ ਕਰ ਜੋਰਿ ਕਰਉ ਅਰਦਾਸਿ ॥",
      "transliteration": "dui kar jor karau aradaas ||",
      "translation": "With my palms pressed together, I offer this prayer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੀਉ ਪਿੰਡੁ ਧਨੁ ਤਿਸ ਕੀ ਰਾਸਿ ॥",
      "transliteration": "jeeu pi(n)d dhan tis kee raas ||",
      "translation": "My soul, body and wealth are His property.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੋਈ ਮੇਰਾ ਸੁਆਮੀ ਕਰਨੈਹਾਰੁ ॥",
      "transliteration": "soee meraa suaamee karanaihaar ||",
      "translation": "He is the Creator, my Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕੋਟਿ ਬਾਰ ਜਾਈ ਬਲਿਹਾਰ ॥੧॥",
      "transliteration": "kot baar jaaee balihaar ||1||",
      "translation": "Millions of times, I am a sacrifice to Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸਾਧੂ ਧੂਰਿ ਪੁਨੀਤ ਕਰੀ ॥",
      "transliteration": "saadhoo dhoor puneet karee ||",
      "translation": "The dust of the feet of the Holy brings purity.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਨ ਕੇ ਬਿਕਾਰ ਮਿਟਹਿ ਪ੍ਰਭ ਸਿਮਰਤ ਜਨਮ ਜਨਮ ਕੀ ਮੈਲੁ ਹਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "man ke bikaar mitahi prabh simarat janam janam kee mail haree ||1|| rahaau ||",
      "translation": "Remembering God in meditation, the mind's corruption is eradicated, and the filth of countless incarnations is washed away. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਾ ਕੈ ਗ੍ਰਿਹ ਮਹਿ ਸਗਲ ਨਿਧਾਨ ॥",
      "transliteration": "jaa kai grih mahi sagal nidhaan ||",
      "translation": "All treasures are in His household.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾ ਕੀ ਸੇਵਾ ਪਾਈਐ ਮਾਨੁ ॥",
      "transliteration": "jaa kee sevaa paaeeai maan ||",
      "translation": "Serving Him, the mortal attains honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਗਲ ਮਨੋਰਥ ਪੂਰਨਹਾਰ ॥",
      "transliteration": "sagal manorath pooranahaar ||",
      "translation": "He is the Fulfiller of the mind's desires.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੀਅ ਪ੍ਰਾਨ ਭਗਤਨ ਆਧਾਰ ॥੨॥",
      "transliteration": "jee praan bhagatan aadhaar ||2||",
      "translation": "He is the Support of the soul and the breath of life of His devotees. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਘਟ ਘਟ ਅੰਤਰਿ ਸਗਲ ਪ੍ਰਗਾਸ ॥",
      "transliteration": "ghat ghat a(n)tar sagal pragaas ||",
      "translation": "His Light shines in each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਪਿ ਜਪਿ ਜੀਵਹਿ ਭਗਤ ਗੁਣਤਾਸ ॥",
      "transliteration": "jap jap jeevahi bhagat gunataas ||",
      "translation": "Chanting and meditating on God, the Treasure of Virtue, His devotees live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਾ ਕੀ ਸੇਵ ਨ ਬਿਰਥੀ ਜਾਇ ॥",
      "transliteration": "jaa kee sev na birathee jaai ||",
      "translation": "Service to Him does not go in vain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਨ ਤਨ ਅੰਤਰਿ ਏਕੁ ਧਿਆਇ ॥੩॥",
      "transliteration": "man tan a(n)tar ek dhiaai ||3||",
      "translation": "Deep within your mind and body, meditate on the One Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੁਰ ਉਪਦੇਸਿ ਦਇਆ ਸੰਤੋਖੁ ॥",
      "transliteration": "gur upades daiaa sa(n)tokh ||",
      "translation": "Following the Guru's Teachings, compassion and contentment are found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਮੁ ਨਿਧਾਨੁ ਨਿਰਮਲੁ ਇਹੁ ਥੋਕੁ ॥",
      "transliteration": "naam nidhaan niramal ihu thok ||",
      "translation": "This Treasure of the Naam, the Name of the Lord, is the immaculate object.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਲੀਜੈ ਲੜਿ ਲਾਇ ॥",
      "transliteration": "kar kirapaa leejai laR laai ||",
      "translation": "Please grant Your Grace, O Lord, and attach me to the hem of Your robe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਨਾਨਕ ਨਿਤ ਧਿਆਇ ॥੪॥੪੨॥੫੫॥",
      "transliteration": "charan kamal naanak nit dhiaai ||4||42||55||",
      "translation": "Nanak meditates continually on the Lord's Lotus Feet. ||4||42||55||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਤਿਗੁਰ ਅਪੁਨੇ ਸੁਨੀ ਅਰਦਾਸਿ ॥",
      "transliteration": "satigur apune sunee aradaas ||",
      "translation": "The True Guru has listened to my prayer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਾਰਜੁ ਆਇਆ ਸਗਲਾ ਰਾਸਿ ॥",
      "transliteration": "kaaraj aaiaa sagalaa raas ||",
      "translation": "All my affairs have been resolved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਨ ਤਨ ਅੰਤਰਿ ਪ੍ਰਭੂ ਧਿਆਇਆ ॥",
      "transliteration": "man tan a(n)tar prabhoo dhiaaiaa ||",
      "translation": "Deep within my mind and body, I meditate on God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਡਰੁ ਸਗਲ ਚੁਕਾਇਆ ॥੧॥",
      "transliteration": "gur poore dar sagal chukaaiaa ||1||",
      "translation": "The Perfect Guru has dispelled all my fears. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਭ ਤੇ ਵਡ ਸਮਰਥ ਗੁਰਦੇਵ ॥",
      "transliteration": "sabh te vad samarath guradev ||",
      "translation": "The All-powerful Divine Guru is the Greatest of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭਿ ਸੁਖ ਪਾਈ ਤਿਸ ਕੀ ਸੇਵ ॥ ਰਹਾਉ ॥",
      "transliteration": "sabh sukh paaee tis kee sev || rahaau ||",
      "translation": "Serving Him, I obtain all comforts. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਾ ਕਾ ਕੀਆ ਸਭੁ ਕਿਛੁ ਹੋਇ ॥",
      "transliteration": "jaa kaa keeaa sabh kichh hoi ||",
      "translation": "Everything is done by Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤਿਸ ਕਾ ਅਮਰੁ ਨ ਮੇਟੈ ਕੋਇ ॥",
      "transliteration": "tis kaa amar na metai koi ||",
      "translation": "No one can erase His Eternal Decree.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਪਰਮੇਸਰੁ ਅਨੂਪੁ ॥",
      "transliteration": "paarabraham paramesar anoop ||",
      "translation": "The Supreme Lord God, the Transcendent Lord, is incomparably beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਫਲ ਮੂਰਤਿ ਗੁਰੁ ਤਿਸ ਕਾ ਰੂਪੁ ॥੨॥",
      "transliteration": "saphal moorat gur tis kaa roop ||2||",
      "translation": "The Guru is the Image of Fulfillment, the Embodiment of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜਾ ਕੈ ਅੰਤਰਿ ਬਸੈ ਹਰਿ ਨਾਮੁ ॥",
      "transliteration": "jaa kai a(n)tar basai har naam ||",
      "translation": "The Name of the Lord abides deep within him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੋ ਜੋ ਪੇਖੈ ਸੁ ਬ੍ਰਹਮ ਗਿਆਨੁ ॥",
      "transliteration": "jo jo pekhai s braham giaan ||",
      "translation": "Wherever he looks, he sees the Wisdom of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬੀਸ ਬਿਸੁਏ ਜਾ ਕੈ ਮਨਿ ਪਰਗਾਸੁ ॥",
      "transliteration": "bees bisue jaa kai man paragaas ||",
      "translation": "His mind is totally enlightened and illuminated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਕੈ ਪਾਰਬ੍ਰਹਮ ਕਾ ਨਿਵਾਸੁ ॥੩॥",
      "transliteration": "tis jan kai paarabraham kaa nivaas ||3||",
      "translation": "Within that person, the Supreme Lord God abides. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਿਸੁ ਗੁਰ ਕਉ ਸਦ ਕਰੀ ਨਮਸਕਾਰ ॥",
      "transliteration": "tis gur kau sad karee namasakaar ||",
      "translation": "I humbly bow to that Guru forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਿਸੁ ਗੁਰ ਕਉ ਸਦ ਜਾਉ ਬਲਿਹਾਰ ॥",
      "transliteration": "tis gur kau sad jaau balihaar ||",
      "translation": "I am forever a sacrifice to that Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਤਿਗੁਰ ਕੇ ਚਰਨ ਧੋਇ ਧੋਇ ਪੀਵਾ ॥",
      "transliteration": "satigur ke charan dhoi dhoi peevaa ||",
      "translation": "I wash the feet of the Guru, and drink in this water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1152_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗੁਰ ਨਾਨਕ ਜਪਿ ਜਪਿ ਸਦ ਜੀਵਾ ॥੪॥੪੩॥੫੬॥",
      "transliteration": "gur naanak jap jap sad jeevaa ||4||43||56||",
      "translation": "Chanting and meditating forever on Guru Nanak, I live. ||4||43||56||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1152,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
