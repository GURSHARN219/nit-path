{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1154,
  "lineCount": 47,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1154_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੩ ਘਰੁ ੨ ॥",
      "transliteration": "bhairau mahalaa 3 ghar 2 ||",
      "translation": "Bhairao, Third Mehl, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤਿਨਿ ਕਰਤੈ ਇਕੁ ਚਲਤੁ ਉਪਾਇਆ ॥",
      "transliteration": "tin karatai ik chalat upaaiaa ||",
      "translation": "The Creator has staged His Wondrous Play.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਨਹਦ ਬਾਣੀ ਸਬਦੁ ਸੁਣਾਇਆ ॥",
      "transliteration": "anahad baanee sabad sunaaiaa ||",
      "translation": "I listen to the Unstruck Sound-current of the Shabad, and the Bani of His Word.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਨਮੁਖਿ ਭੂਲੇ ਗੁਰਮੁਖਿ ਬੁਝਾਇਆ ॥",
      "transliteration": "manamukh bhoole guramukh bujhaaiaa ||",
      "translation": "The self-willed manmukhs are deluded and confused, while the Gurmukhs understand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਰਣੁ ਕਰਤਾ ਕਰਦਾ ਆਇਆ ॥੧॥",
      "transliteration": "kaaran karataa karadaa aaiaa ||1||",
      "translation": "The Creator creates the Cause that causes. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਮੇਰੈ ਅੰਤਰਿ ਧਿਆਨੁ ॥",
      "transliteration": "gur kaa sabad merai a(n)tar dhiaan ||",
      "translation": "Deep within my being, I meditate on the Word of the Guru's Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਉ ਕਬਹੁ ਨ ਛੋਡਉ ਹਰਿ ਕਾ ਨਾਮੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "hau kabahu na chhodau har kaa naam ||1|| rahaau ||",
      "translation": "I shall never forsake the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਿਤਾ ਪ੍ਰਹਲਾਦੁ ਪੜਣ ਪਠਾਇਆ ॥",
      "transliteration": "pitaa prahalaad paRan pathaaiaa ||",
      "translation": "Prahlaad's father sent him to school, to learn to read.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਲੈ ਪਾਟੀ ਪਾਧੇ ਕੈ ਆਇਆ ॥",
      "transliteration": "lai paatee paadhe kai aaiaa ||",
      "translation": "He took his writing tablet and went to the teacher.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਨਹ ਪੜਉ ਅਚਾਰ ॥",
      "transliteration": "naam binaa nah paRau achaar ||",
      "translation": "He said, \"I shall not read anything except the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮੇਰੀ ਪਟੀਆ ਲਿਖਿ ਦੇਹੁ ਗੋਬਿੰਦ ਮੁਰਾਰਿ ॥੨॥",
      "transliteration": "meree pateeaa likh dehu gobi(n)d muraar ||2||",
      "translation": "Write the Lord's Name on my tablet.\" ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪੁਤ੍ਰ ਪ੍ਰਹਿਲਾਦ ਸਿਉ ਕਹਿਆ ਮਾਇ ॥",
      "transliteration": "putr prahilaad siu kahiaa maai ||",
      "translation": "Prahlaad's mother said to her son,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪਰਵਿਰਤਿ ਨ ਪੜਹੁ ਰਹੀ ਸਮਝਾਇ ॥",
      "transliteration": "paravirat na paRahu rahee samajhaai ||",
      "translation": "\"I advise you not to read anything except what you are taught.\"",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਿਰਭਉ ਦਾਤਾ ਹਰਿ ਜੀਉ ਮੇਰੈ ਨਾਲਿ ॥",
      "transliteration": "nirabhau daataa har jeeu merai naal ||",
      "translation": "He answered, \"The Great Giver, my Fearless Lord God is always with me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੇ ਹਰਿ ਛੋਡਉ ਤਉ ਕੁਲਿ ਲਾਗੈ ਗਾਲਿ ॥੩॥",
      "transliteration": "je har chhodau tau kul laagai gaal ||3||",
      "translation": "If I were to forsake the Lord, then my family would be disgraced.\" ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪ੍ਰਹਲਾਦਿ ਸਭਿ ਚਾਟੜੇ ਵਿਗਾਰੇ ॥",
      "transliteration": "prahalaad sabh chaataRe vigaare ||",
      "translation": "\"Prahlaad has corrupted all the other students.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹਮਾਰਾ ਕਹਿਆ ਨ ਸੁਣੈ ਆਪਣੇ ਕਾਰਜ ਸਵਾਰੇ ॥",
      "transliteration": "hamaaraa kahiaa na sunai aapane kaaraj savaare ||",
      "translation": "He does not listen to what I say, and he does his own thing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਭ ਨਗਰੀ ਮਹਿ ਭਗਤਿ ਦ੍ਰਿੜਾਈ ॥",
      "transliteration": "sabh nagaree mahi bhagat driRaaee ||",
      "translation": "He instigated devotional worship in the townspeople.\"",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੁਸਟ ਸਭਾ ਕਾ ਕਿਛੁ ਨ ਵਸਾਈ ॥੪॥",
      "transliteration": "dusat sabhaa kaa kichh na vasaaee ||4||",
      "translation": "The gathering of the wicked people could not do anything against him. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੰਡੈ ਮਰਕੈ ਕੀਈ ਪੂਕਾਰ ॥",
      "transliteration": "sa(n)dai marakai keeee pookaar ||",
      "translation": "Sanda and Marka, his teachers, made the complaint.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਭੇ ਦੈਤ ਰਹੇ ਝਖ ਮਾਰਿ ॥",
      "transliteration": "sabhe dait rahe jhakh maar ||",
      "translation": "All the demons kept trying in vain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭਗਤ ਜਨਾ ਕੀ ਪਤਿ ਰਾਖੈ ਸੋਈ ॥",
      "transliteration": "bhagat janaa kee pat raakhai soee ||",
      "translation": "The Lord protected His humble devotee, and preserved his honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕੀਤੇ ਕੈ ਕਹਿਐ ਕਿਆ ਹੋਈ ॥੫॥",
      "transliteration": "keete kai kahiai kiaa hoee ||5||",
      "translation": "What can be done by mere created beings? ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਿਰਤ ਸੰਜੋਗੀ ਦੈਤਿ ਰਾਜੁ ਚਲਾਇਆ ॥",
      "transliteration": "kirat sa(n)jogee dait raaj chalaaiaa ||",
      "translation": "Because of his past karma, the demon ruled over his kingdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰਿ ਨ ਬੂਝੈ ਤਿਨਿ ਆਪਿ ਭੁਲਾਇਆ ॥",
      "transliteration": "har na boojhai tin aap bhulaaiaa ||",
      "translation": "He did not realize the Lord; the Lord Himself confused him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੁਤ੍ਰ ਪ੍ਰਹਲਾਦ ਸਿਉ ਵਾਦੁ ਰਚਾਇਆ ॥",
      "transliteration": "putr prahalaad siu vaad rachaaiaa ||",
      "translation": "He started an argument with his son Prahlaad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅੰਧਾ ਨ ਬੂਝੈ ਕਾਲੁ ਨੇੜੈ ਆਇਆ ॥੬॥",
      "transliteration": "a(n)dhaa na boojhai kaal neRai aaiaa ||6||",
      "translation": "The blind one did not understand that his death was approaching. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪ੍ਰਹਲਾਦੁ ਕੋਠੇ ਵਿਚਿ ਰਾਖਿਆ ਬਾਰਿ ਦੀਆ ਤਾਲਾ ॥",
      "transliteration": "prahalaad kothe vich raakhiaa baar deeaa taalaa ||",
      "translation": "Prahlaad was placed in a cell, and the door was locked.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਿਰਭਉ ਬਾਲਕੁ ਮੂਲਿ ਨ ਡਰਈ ਮੇਰੈ ਅੰਤਰਿ ਗੁਰ ਗੋਪਾਲਾ ॥",
      "transliteration": "nirabhau baalak mool na daraee merai a(n)tar gur gopaalaa ||",
      "translation": "The fearless child was not afraid at all. He said, \"Within my being, is the Guru, the Lord of the World.\"",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕੀਤਾ ਹੋਵੈ ਸਰੀਕੀ ਕਰੈ ਅਨਹੋਦਾ ਨਾਉ ਧਰਾਇਆ ॥",
      "transliteration": "keetaa hovai sareekee karai anahodaa naau dharaaiaa ||",
      "translation": "The created being tried to compete with his Creator, but he assumed this name in vain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜੋ ਧੁਰਿ ਲਿਖਿਆ ਸੋੁ ਆਇ ਪਹੁਤਾ ਜਨ ਸਿਉ ਵਾਦੁ ਰਚਾਇਆ ॥੭॥",
      "transliteration": "jo dhur likhiaa sou aai pahutaa jan siu vaad rachaaiaa ||7||",
      "translation": "That which was predestined for him has come to pass; he started an argument with the Lord's humble servant. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਪਿਤਾ ਪ੍ਰਹਲਾਦ ਸਿਉ ਗੁਰਜ ਉਠਾਈ ॥",
      "transliteration": "pitaa prahalaad siu guraj uthaaee ||",
      "translation": "The father raised the club to strike down Prahlaad, saying,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਹਾਂ ਤੁਮੑਾਰਾ ਜਗਦੀਸ ਗੁਸਾਈ ॥",
      "transliteration": "kahaa(n) tumhaaraa jagadees gusaaee ||",
      "translation": "\"Where is your God, the Lord of the Universe, now?\"",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਗਜੀਵਨੁ ਦਾਤਾ ਅੰਤਿ ਸਖਾਈ ॥",
      "transliteration": "jagajeevan daataa a(n)t sakhaaee ||",
      "translation": "He replied, \"The Life of the World, the Great Giver, is my Help and Support in the end.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਹ ਦੇਖਾ ਤਹ ਰਹਿਆ ਸਮਾਈ ॥੮॥",
      "transliteration": "jah dekhaa tah rahiaa samaaee ||8||",
      "translation": "Wherever I look, I see Him permeating and prevailing.\" ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਥੰਮੑੁ ਉਪਾੜਿ ਹਰਿ ਆਪੁ ਦਿਖਾਇਆ ॥",
      "transliteration": "tha(n)mh upaaR har aap dikhaaiaa ||",
      "translation": "Tearing down the pillars, the Lord Himself appeared.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਹੰਕਾਰੀ ਦੈਤੁ ਮਾਰਿ ਪਚਾਇਆ ॥",
      "transliteration": "aha(n)kaaree dait maar pachaaiaa ||",
      "translation": "The egotistical demon was killed and destroyed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਭਗਤਾ ਮਨਿ ਆਨੰਦੁ ਵਜੀ ਵਧਾਈ ॥",
      "transliteration": "bhagataa man aana(n)d vajee vadhaaee ||",
      "translation": "The minds of the devotees were filled with bliss, and congratulations poured in.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਪਨੇ ਸੇਵਕ ਕਉ ਦੇ ਵਡਿਆਈ ॥੯॥",
      "transliteration": "apane sevak kau de vadiaaee ||9||",
      "translation": "He blessed His servant with glorious greatness. ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜੰਮਣੁ ਮਰਣਾ ਮੋਹੁ ਉਪਾਇਆ ॥",
      "transliteration": "ja(n)man maranaa mohu upaaiaa ||",
      "translation": "He created birth, death and attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਵਣੁ ਜਾਣਾ ਕਰਤੈ ਲਿਖਿ ਪਾਇਆ ॥",
      "transliteration": "aavan jaanaa karatai likh paaiaa ||",
      "translation": "The Creator has ordained coming and going in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪ੍ਰਹਲਾਦ ਕੈ ਕਾਰਜਿ ਹਰਿ ਆਪੁ ਦਿਖਾਇਆ ॥",
      "transliteration": "prahalaad kai kaaraj har aap dikhaaiaa ||",
      "translation": "For the sake of Prahlaad, the Lord Himself appeared.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਭਗਤਾ ਕਾ ਬੋਲੁ ਆਗੈ ਆਇਆ ॥੧੦॥",
      "transliteration": "bhagataa kaa bol aagai aaiaa ||10||",
      "translation": "The word of the devotee came true. ||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦੇਵ ਕੁਲੀ ਲਖਿਮੀ ਕਉ ਕਰਹਿ ਜੈਕਾਰੁ ॥",
      "transliteration": "dev kulee lakhimee kau karahi jaikaar ||",
      "translation": "The gods proclaimed the victory of Lakshmi, and said,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਾਤਾ ਨਰਸਿੰਘ ਕਾ ਰੂਪੁ ਨਿਵਾਰੁ ॥",
      "transliteration": "maataa narasi(n)gh kaa roop nivaar ||",
      "translation": "\"O mother, make this form of the Man-lion disappear!\"",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1154_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਲਖਿਮੀ ਭਉ ਕਰੈ ਨ ਸਾਕੈ ਜਾਇ ॥",
      "transliteration": "lakhimee bhau karai na saakai jaai ||",
      "translation": "Lakshmi was afraid, and did not approach.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1154,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
