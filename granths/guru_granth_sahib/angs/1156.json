{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1156,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1156_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਸੋ ਸੀਤਲੁ ਹੂਆ ॥",
      "transliteration": "jis naam ridai so seetal hooaa ||",
      "translation": "One who keeps the Naam in his heart becomes cool and calm.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਧ੍ਰਿਗੁ ਜੀਵਣੁ ਮੂਆ ॥੨॥",
      "transliteration": "naam binaa dhrig jeevan mooaa ||2||",
      "translation": "Without the Naam, both life and death are cursed. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਸੋ ਜੀਵਨ ਮੁਕਤਾ ॥",
      "transliteration": "jis naam ridai so jeevan mukataa ||",
      "translation": "One who keeps the Naam in his heart is Jivan-mukta, liberated while yet alive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਤਿਸੁ ਸਭ ਹੀ ਜੁਗਤਾ ॥",
      "transliteration": "jis naam ridai tis sabh hee jugataa ||",
      "translation": "One who keeps the Naam in his heart knows all ways and means.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਤਿਨਿ ਨਉ ਨਿਧਿ ਪਾਈ ॥",
      "transliteration": "jis naam ridai tin nau nidh paaee ||",
      "translation": "One who keeps the Naam in his heart obtains the nine treasures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਭ੍ਰਮਿ ਆਵੈ ਜਾਈ ॥੩॥",
      "transliteration": "naam binaa bhram aavai jaaee ||3||",
      "translation": "Without the Naam, the mortal wanders, coming and going in reincarnation. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਸੋ ਵੇਪਰਵਾਹਾ ॥",
      "transliteration": "jis naam ridai so veparavaahaa ||",
      "translation": "One who keeps the Naam in his heart is carefree and independent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਤਿਸੁ ਸਦ ਹੀ ਲਾਹਾ ॥",
      "transliteration": "jis naam ridai tis sad hee laahaa ||",
      "translation": "One who keeps the Naam in his heart always earns a profit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਤਿਸੁ ਵਡ ਪਰਵਾਰਾ ॥",
      "transliteration": "jis naam ridai tis vad paravaaraa ||",
      "translation": "One who keeps the Naam in his heart has a large family.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਮਨਮੁਖ ਗਾਵਾਰਾ ॥੪॥",
      "transliteration": "naam binaa manamukh gaavaaraa ||4||",
      "translation": "Without the Naam, the mortal is just an ignorant, self-willed manmukh. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਤਿਸੁ ਨਿਹਚਲ ਆਸਨੁ ॥",
      "transliteration": "jis naam ridai tis nihachal aasan ||",
      "translation": "One who keeps the Naam in his heart has a permanent position.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਤਿਸੁ ਤਖਤਿ ਨਿਵਾਸਨੁ ॥",
      "transliteration": "jis naam ridai tis takhat nivaasan ||",
      "translation": "One who keeps the Naam in his heart is seated on the throne.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਸੋ ਸਾਚਾ ਸਾਹੁ ॥",
      "transliteration": "jis naam ridai so saachaa saahu ||",
      "translation": "One who keeps the Naam in his heart is the true king.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਾਮਹੀਣ ਨਾਹੀ ਪਤਿ ਵੇਸਾਹੁ ॥੫॥",
      "transliteration": "naamaheen naahee pat vesaahu ||5||",
      "translation": "Without the Naam, no one has any honor or respect. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਸੋ ਸਭ ਮਹਿ ਜਾਤਾ ॥",
      "transliteration": "jis naam ridai so sabh mahi jaataa ||",
      "translation": "One who keeps the Naam in his heart is famous everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਸੋ ਪੁਰਖੁ ਬਿਧਾਤਾ ॥",
      "transliteration": "jis naam ridai so purakh bidhaataa ||",
      "translation": "One who keeps the Naam in his heart is the Embodiment of the Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਸੋ ਸਭ ਤੇ ਊਚਾ ॥",
      "transliteration": "jis naam ridai so sabh te oochaa ||",
      "translation": "One who keeps the Naam in his heart is the highest of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਭ੍ਰਮਿ ਜੋਨੀ ਮੂਚਾ ॥੬॥",
      "transliteration": "naam binaa bhram jonee moochaa ||6||",
      "translation": "Without the Naam, the mortal wanders in reincarnation. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਤਿਸੁ ਪ੍ਰਗਟਿ ਪਹਾਰਾ ॥",
      "transliteration": "jis naam ridai tis pragat pahaaraa ||",
      "translation": "One who keeps the Naam in his heart sees the Lord manifested in His Creation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਤਿਸੁ ਮਿਟਿਆ ਅੰਧਾਰਾ ॥",
      "transliteration": "jis naam ridai tis mitiaa a(n)dhaaraa ||",
      "translation": "One who keeps the Naam in his heart - his darkness is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਿਸੁ ਨਾਮੁ ਰਿਦੈ ਸੋ ਪੁਰਖੁ ਪਰਵਾਣੁ ॥",
      "transliteration": "jis naam ridai so purakh paravaan ||",
      "translation": "One who keeps the Naam in his heart is approved and accepted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਫਿਰਿ ਆਵਣ ਜਾਣੁ ॥੭॥",
      "transliteration": "naam binaa phir aavan jaan ||7||",
      "translation": "Without the Naam, the mortal continues coming and going in reincarnation. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਿਨਿ ਨਾਮੁ ਪਾਇਆ ਜਿਸੁ ਭਇਓ ਕ੍ਰਿਪਾਲ ॥",
      "transliteration": "tin naam paaiaa jis bhaio kripaal ||",
      "translation": "He alone receives the Naam, who is blessed by the Lord's Mercy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਮਹਿ ਲਖੇ ਗੋੁਪਾਲ ॥",
      "transliteration": "saadhasa(n)gat mahi lakhe goupaal ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, the Lord of the World is understood.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਵਣ ਜਾਣ ਰਹੇ ਸੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "aavan jaan rahe sukh paaiaa ||",
      "translation": "Coming and going in reincarnation ends, and peace is found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਤਤੈ ਤਤੁ ਮਿਲਾਇਆ ॥੮॥੧॥੪॥",
      "transliteration": "kahu naanak tatai tat milaaiaa ||8||1||4||",
      "translation": "Says Nanak, my essence has merged in the Essence of the Lord. ||8||1||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕੋਟਿ ਬਿਸਨ ਕੀਨੇ ਅਵਤਾਰ ॥",
      "transliteration": "kot bisan keene avataar ||",
      "translation": "He created millions of incarnations of Vishnu.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕੋਟਿ ਬ੍ਰਹਮੰਡ ਜਾ ਕੇ ਧ੍ਰਮਸਾਲ ॥",
      "transliteration": "kot brahama(n)d jaa ke dhramasaal ||",
      "translation": "He created millions of universes as places to practice righteousness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕੋਟਿ ਮਹੇਸ ਉਪਾਇ ਸਮਾਏ ॥",
      "transliteration": "kot mahes upaai samaae ||",
      "translation": "He created and destroyed millions of Shivas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕੋਟਿ ਬ੍ਰਹਮੇ ਜਗੁ ਸਾਜਣ ਲਾਏ ॥੧॥",
      "transliteration": "kot brahame jag saajan laae ||1||",
      "translation": "He employed millions of Brahmas to create the worlds. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਐਸੋ ਧਣੀ ਗੁਵਿੰਦੁ ਹਮਾਰਾ ॥",
      "transliteration": "aiso dhanee guvi(n)d hamaaraa ||",
      "translation": "Such is my Lord and Master, the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਰਨਿ ਨ ਸਾਕਉ ਗੁਣ ਬਿਸਥਾਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "baran na saakau gun bisathaaraa ||1|| rahaau ||",
      "translation": "I cannot even describe His Many Virtues. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕੋਟਿ ਮਾਇਆ ਜਾ ਕੈ ਸੇਵਕਾਇ ॥",
      "transliteration": "kot maaiaa jaa kai sevakaai ||",
      "translation": "Millions of Mayas are His maid-servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕੋਟਿ ਜੀਅ ਜਾ ਕੀ ਸਿਹਜਾਇ ॥",
      "transliteration": "kot jee jaa kee sihajaai ||",
      "translation": "Millions of souls are His beds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕੋਟਿ ਉਪਾਰਜਨਾ ਤੇਰੈ ਅੰਗਿ ॥",
      "transliteration": "kot upaarajanaa terai a(n)g ||",
      "translation": "Millions of universes are the limbs of His Being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕੋਟਿ ਭਗਤ ਬਸਤ ਹਰਿ ਸੰਗਿ ॥੨॥",
      "transliteration": "kot bhagat basat har sa(n)g ||2||",
      "translation": "Millions of devotees abide with the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕੋਟਿ ਛਤ੍ਰਪਤਿ ਕਰਤ ਨਮਸਕਾਰ ॥",
      "transliteration": "kot chhatrapat karat namasakaar ||",
      "translation": "Millions of kings with their crowns and canopies bow before Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕੋਟਿ ਇੰਦ੍ਰ ਠਾਢੇ ਹੈ ਦੁਆਰ ॥",
      "transliteration": "kot i(n)dr thaadhe hai duaar ||",
      "translation": "Millions of Indras stand at His Door.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕੋਟਿ ਬੈਕੁੰਠ ਜਾ ਕੀ ਦ੍ਰਿਸਟੀ ਮਾਹਿ ॥",
      "transliteration": "kot baiku(n)th jaa kee drisatee maahi ||",
      "translation": "Millions of heavenly paradises are within the scope of His Vision.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕੋਟਿ ਨਾਮ ਜਾ ਕੀ ਕੀਮਤਿ ਨਾਹਿ ॥੩॥",
      "transliteration": "kot naam jaa kee keemat naahi ||3||",
      "translation": "Millions of His Names cannot even be appraised. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕੋਟਿ ਪੂਰੀਅਤ ਹੈ ਜਾ ਕੈ ਨਾਦ ॥",
      "transliteration": "kot pooreeat hai jaa kai naad ||",
      "translation": "Millions of celestial sounds resound for Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੋਟਿ ਅਖਾਰੇ ਚਲਿਤ ਬਿਸਮਾਦ ॥",
      "transliteration": "kot akhaare chalit bisamaad ||",
      "translation": "His Wondrous Plays are enacted on millions of stages.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕੋਟਿ ਸਕਤਿ ਸਿਵ ਆਗਿਆਕਾਰ ॥",
      "transliteration": "kot sakat siv aagiaakaar ||",
      "translation": "Millions of Shaktis and Shivas are obedient to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕੋਟਿ ਜੀਅ ਦੇਵੈ ਆਧਾਰ ॥੪॥",
      "transliteration": "kot jee devai aadhaar ||4||",
      "translation": "He gives sustenance and support to millions of beings. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕੋਟਿ ਤੀਰਥ ਜਾ ਕੇ ਚਰਨ ਮਝਾਰ ॥",
      "transliteration": "kot teerath jaa ke charan majhaar ||",
      "translation": "In His Feet are millions of sacred shrines of pilgrimage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕੋਟਿ ਪਵਿਤ੍ਰ ਜਪਤ ਨਾਮ ਚਾਰ ॥",
      "transliteration": "kot pavitr japat naam chaar ||",
      "translation": "Millions chant His Sacred and Beautiful Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੋਟਿ ਪੂਜਾਰੀ ਕਰਤੇ ਪੂਜਾ ॥",
      "transliteration": "kot poojaaree karate poojaa ||",
      "translation": "Millions of worshippers worship Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕੋਟਿ ਬਿਸਥਾਰਨੁ ਅਵਰੁ ਨ ਦੂਜਾ ॥੫॥",
      "transliteration": "kot bisathaaran avar na doojaa ||5||",
      "translation": "Millions of expanses are His; there is no other at all. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕੋਟਿ ਮਹਿਮਾ ਜਾ ਕੀ ਨਿਰਮਲ ਹੰਸ ॥",
      "transliteration": "kot mahimaa jaa kee niramal ha(n)s ||",
      "translation": "Millions of swan-souls sing His Immaculate Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕੋਟਿ ਉਸਤਤਿ ਜਾ ਕੀ ਕਰਤ ਬ੍ਰਹਮੰਸ ॥",
      "transliteration": "kot usatat jaa kee karat brahama(n)s ||",
      "translation": "Millions of Brahma's sons sing His Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕੋਟਿ ਪਰਲਉ ਓਪਤਿ ਨਿਮਖ ਮਾਹਿ ॥",
      "transliteration": "kot paralau opat nimakh maahi ||",
      "translation": "He creates and destroys millions, in an instant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕੋਟਿ ਗੁਣਾ ਤੇਰੇ ਗਣੇ ਨ ਜਾਹਿ ॥੬॥",
      "transliteration": "kot gunaa tere gane na jaahi ||6||",
      "translation": "Millions are Your Virtues, Lord - they cannot even be counted. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕੋਟਿ ਗਿਆਨੀ ਕਥਹਿ ਗਿਆਨੁ ॥",
      "transliteration": "kot giaanee kathahi giaan ||",
      "translation": "Millions of spiritual teachers teach His spiritual wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕੋਟਿ ਧਿਆਨੀ ਧਰਤ ਧਿਆਨੁ ॥",
      "transliteration": "kot dhiaanee dharat dhiaan ||",
      "translation": "Millions of meditators focus on His meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1156_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕੋਟਿ ਤਪੀਸਰ ਤਪ ਹੀ ਕਰਤੇ ॥",
      "transliteration": "kot tapeesar tap hee karate ||",
      "translation": "Millions of austere penitents practice austerities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1156,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
