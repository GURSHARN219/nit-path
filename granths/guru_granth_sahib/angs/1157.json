{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1157,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1157_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕੋਟਿ ਮੁਨੀਸਰ ਮੋੁਨਿ ਮਹਿ ਰਹਤੇ ॥੭॥",
      "transliteration": "kot muneesar moun mahi rahate ||7||",
      "translation": "Millions of silent sages dwell in silence. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਵਿਗਤ ਨਾਥੁ ਅਗੋਚਰ ਸੁਆਮੀ ॥",
      "transliteration": "avigat naath agochar suaamee ||",
      "translation": "Our Eternal, Imperishable, Incomprehensible Lord and Master,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪੂਰਿ ਰਹਿਆ ਘਟ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "poor rahiaa ghat a(n)tarajaamee ||",
      "translation": "The Inner-knower, the Searcher of hearts, is permeating all hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਤ ਕਤ ਦੇਖਉ ਤੇਰਾ ਵਾਸਾ ॥",
      "transliteration": "jat kat dekhau teraa vaasaa ||",
      "translation": "Wherever I look, I see Your Dwelling, O Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਗੁਰਿ ਕੀਓ ਪ੍ਰਗਾਸਾ ॥੮॥੨॥੫॥",
      "transliteration": "naanak kau gur keeo pragaasaa ||8||2||5||",
      "translation": "The Guru has blessed Nanak with enlightenment. ||8||2||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭੈਰਉ ਮਹਲਾ ੫ ॥",
      "transliteration": "bhairau mahalaa 5 ||",
      "translation": "Bhairao, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਮੋ ਕਉ ਕੀਨੋ ਦਾਨੁ ॥",
      "transliteration": "satigur mo kau keeno daan ||",
      "translation": "The True Guru has blessed me with this gift.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਮੋਲ ਰਤਨੁ ਹਰਿ ਦੀਨੋ ਨਾਮੁ ॥",
      "transliteration": "amol ratan har deeno naam ||",
      "translation": "He has given me the Priceless Jewel of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਹਜ ਬਿਨੋਦ ਚੋਜ ਆਨੰਤਾ ॥",
      "transliteration": "sahaj binod choj aana(n)taa ||",
      "translation": "Now, I intuitively enjoy endless pleasures and wondrous play.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਨਕ ਕਉ ਪ੍ਰਭੁ ਮਿਲਿਓ ਅਚਿੰਤਾ ॥੧॥",
      "transliteration": "naanak kau prabh milio achi(n)taa ||1||",
      "translation": "God has spontaneously met with Nanak. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਕੀਰਤਿ ਹਰਿ ਸਾਚੀ ॥",
      "transliteration": "kahu naanak keerat har saachee ||",
      "translation": "Says Nanak, True is the Kirtan of the Lord's Praise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਹੁਰਿ ਬਹੁਰਿ ਤਿਸੁ ਸੰਗਿ ਮਨੁ ਰਾਚੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bahur bahur tis sa(n)g man raachee ||1|| rahaau ||",
      "translation": "Again and again, my mind remains immersed in it. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਚਿੰਤ ਹਮਾਰੈ ਭੋਜਨ ਭਾਉ ॥",
      "transliteration": "achi(n)t hamaarai bhojan bhaau ||",
      "translation": "Spontaneously, I feed on the Love of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਚਿੰਤ ਹਮਾਰੈ ਲੀਚੈ ਨਾਉ ॥",
      "transliteration": "achi(n)t hamaarai leechai naau ||",
      "translation": "Spontaneously, I take God's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਚਿੰਤ ਹਮਾਰੈ ਸਬਦਿ ਉਧਾਰ ॥",
      "transliteration": "achi(n)t hamaarai sabad udhaar ||",
      "translation": "Spontaneously, I am saved by the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਚਿੰਤ ਹਮਾਰੈ ਭਰੇ ਭੰਡਾਰ ॥੨॥",
      "transliteration": "achi(n)t hamaarai bhare bha(n)daar ||2||",
      "translation": "Spontaneously, my treasures are filled to overflowing. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਚਿੰਤ ਹਮਾਰੈ ਕਾਰਜ ਪੂਰੇ ॥",
      "transliteration": "achi(n)t hamaarai kaaraj poore ||",
      "translation": "Spontaneously, my works are perfectly accomplished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅਚਿੰਤ ਹਮਾਰੈ ਲਥੇ ਵਿਸੂਰੇ ॥",
      "transliteration": "achi(n)t hamaarai lathe visoore ||",
      "translation": "Spontaneously, I am rid of sorrow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਚਿੰਤ ਹਮਾਰੈ ਬੈਰੀ ਮੀਤਾ ॥",
      "transliteration": "achi(n)t hamaarai bairee meetaa ||",
      "translation": "Spontaneously, my enemies have become friends.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਚਿੰਤੋ ਹੀ ਇਹੁ ਮਨੁ ਵਸਿ ਕੀਤਾ ॥੩॥",
      "transliteration": "achi(n)to hee ihu man vas keetaa ||3||",
      "translation": "Spontaneously, I have brought my mind under control. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਚਿੰਤ ਪ੍ਰਭੂ ਹਮ ਕੀਆ ਦਿਲਾਸਾ ॥",
      "transliteration": "achi(n)t prabhoo ham keeaa dilaasaa ||",
      "translation": "Spontaneously, God has comforted me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਚਿੰਤ ਹਮਾਰੀ ਪੂਰਨ ਆਸਾ ॥",
      "transliteration": "achi(n)t hamaaree pooran aasaa ||",
      "translation": "Spontaneously, my hopes have been fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਚਿੰਤ ਹਮੑਾ ਕਉ ਸਗਲ ਸਿਧਾਂਤੁ ॥",
      "transliteration": "achi(n)t hamhaa kau sagal sidhaa(n)t ||",
      "translation": "Spontaneously, I have totally realized the essence of reality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਚਿੰਤੁ ਹਮ ਕਉ ਗੁਰਿ ਦੀਨੋ ਮੰਤੁ ॥੪॥",
      "transliteration": "achi(n)t ham kau gur deeno ma(n)t ||4||",
      "translation": "Spontaneously, I have been blessed with the Guru's Mantra. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਚਿੰਤ ਹਮਾਰੇ ਬਿਨਸੇ ਬੈਰ ॥",
      "transliteration": "achi(n)t hamaare binase bair ||",
      "translation": "Spontaneously, I am rid of hatred.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਚਿੰਤ ਹਮਾਰੇ ਮਿਟੇ ਅੰਧੇਰ ॥",
      "transliteration": "achi(n)t hamaare mite a(n)dher ||",
      "translation": "Spontaneously, my darkness has been dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਚਿੰਤੋ ਹੀ ਮਨਿ ਕੀਰਤਨੁ ਮੀਠਾ ॥",
      "transliteration": "achi(n)to hee man keeratan meethaa ||",
      "translation": "Spontaneously, the Kirtan of the Lord's Praise seems so sweet to my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਚਿੰਤੋ ਹੀ ਪ੍ਰਭੁ ਘਟਿ ਘਟਿ ਡੀਠਾ ॥੫॥",
      "transliteration": "achi(n)to hee prabh ghat ghat deethaa ||5||",
      "translation": "Spontaneously, I behold God in each and every heart. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਚਿੰਤ ਮਿਟਿਓ ਹੈ ਸਗਲੋ ਭਰਮਾ ॥",
      "transliteration": "achi(n)t mitio hai sagalo bharamaa ||",
      "translation": "Spontaneously, all my doubts have been dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਚਿੰਤ ਵਸਿਓ ਮਨਿ ਸੁਖ ਬਿਸ੍ਰਾਮਾ ॥",
      "transliteration": "achi(n)t vasio man sukh bisraamaa ||",
      "translation": "Spontaneously, peace and celestial harmony fill my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਚਿੰਤ ਹਮਾਰੈ ਅਨਹਤ ਵਾਜੈ ॥",
      "transliteration": "achi(n)t hamaarai anahat vaajai ||",
      "translation": "Spontaneously, the Unstruck Melody of the Sound-current resounds within me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਅਚਿੰਤ ਹਮਾਰੈ ਗੋਬਿੰਦੁ ਗਾਜੈ ॥੬॥",
      "transliteration": "achi(n)t hamaarai gobi(n)d gaajai ||6||",
      "translation": "Spontaneously, the Lord of the Universe has revealed Himself to me. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਚਿੰਤ ਹਮਾਰੈ ਮਨੁ ਪਤੀਆਨਾ ॥",
      "transliteration": "achi(n)t hamaarai man pateeaanaa ||",
      "translation": "Spontaneously, my mind has been pleased and appeased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਿਹਚਲ ਧਨੀ ਅਚਿੰਤੁ ਪਛਾਨਾ ॥",
      "transliteration": "nihachal dhanee achi(n)t pachhaanaa ||",
      "translation": "I have spontaneously realized the Eternal, Unchanging Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਚਿੰਤੋ ਉਪਜਿਓ ਸਗਲ ਬਿਬੇਕਾ ॥",
      "transliteration": "achi(n)to upajio sagal bibekaa ||",
      "translation": "Spontaneously, all wisdom and knowledge has welled up within me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਚਿੰਤ ਚਰੀ ਹਥਿ ਹਰਿ ਹਰਿ ਟੇਕਾ ॥੭॥",
      "transliteration": "achi(n)t charee hath har har tekaa ||7||",
      "translation": "Spontaneously, the Support of the Lord, Har, Har, has come into my hands. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਚਿੰਤ ਪ੍ਰਭੂ ਧੁਰਿ ਲਿਖਿਆ ਲੇਖੁ ॥",
      "transliteration": "achi(n)t prabhoo dhur likhiaa lekh ||",
      "translation": "Spontaneously, God has recorded my pre-ordained destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਚਿੰਤ ਮਿਲਿਓ ਪ੍ਰਭੁ ਠਾਕੁਰੁ ਏਕੁ ॥",
      "transliteration": "achi(n)t milio prabh thaakur ek ||",
      "translation": "Spontaneously, the One Lord and Master God has met me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਚਿੰਤ ਅਚਿੰਤਾ ਸਗਲੀ ਗਈ ॥",
      "transliteration": "chi(n)t achi(n)taa sagalee gaee ||",
      "translation": "Spontaneously, all my cares and worries have been taken away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪ੍ਰਭ ਨਾਨਕ ਨਾਨਕ ਨਾਨਕ ਮਈ ॥੮॥੩॥੬॥",
      "transliteration": "prabh naanak naanak naanak maee ||8||3||6||",
      "translation": "Nanak, Nanak, Nanak, has merged into the Image of God. ||8||3||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਭੈਰਉ ਬਾਣੀ ਭਗਤਾ ਕੀ ॥ ਕਬੀਰ ਜੀਉ ਘਰੁ ੧ ॥",
      "transliteration": "bhairau baanee bhagataa kee || kabeer jeeu ghar 1 ||",
      "translation": "Bhairao, The Word Of The Devotees, Kabeer Jee, First House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਹੁ ਧਨੁ ਮੇਰੇ ਹਰਿ ਕੋ ਨਾਉ ॥",
      "transliteration": "ihu dhan mere har ko naau ||",
      "translation": "The Name of the Lord - this alone is my wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗਾਂਠਿ ਨ ਬਾਧਉ ਬੇਚਿ ਨ ਖਾਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gaa(n)th na baadhau bech na khaau ||1|| rahaau ||",
      "translation": "I do not tie it up to hide it, nor do I sell it to make my living. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਉ ਮੇਰੇ ਖੇਤੀ ਨਾਉ ਮੇਰੇ ਬਾਰੀ ॥",
      "transliteration": "naau mere khetee naau mere baaree ||",
      "translation": "The Name is my crop, and the Name is my field.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਭਗਤਿ ਕਰਉ ਜਨੁ ਸਰਨਿ ਤੁਮੑਾਰੀ ॥੧॥",
      "transliteration": "bhagat karau jan saran tumhaaree ||1||",
      "translation": "As Your humble servant, I perform devotional worship to You; I seek Your Sanctuary. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਉ ਮੇਰੇ ਮਾਇਆ ਨਾਉ ਮੇਰੇ ਪੂੰਜੀ ॥",
      "transliteration": "naau mere maaiaa naau mere poo(n)jee ||",
      "translation": "The Name is Maya and wealth for me; the Name is my capital.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤੁਮਹਿ ਛੋਡਿ ਜਾਨਉ ਨਹੀ ਦੂਜੀ ॥੨॥",
      "transliteration": "tumahi chhod jaanau nahee doojee ||2||",
      "translation": "I do not forsake You; I do not know any other at all. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਉ ਮੇਰੇ ਬੰਧਿਪ ਨਾਉ ਮੇਰੇ ਭਾਈ ॥",
      "transliteration": "naau mere ba(n)dhip naau mere bhaaee ||",
      "translation": "The Name is my family, the Name is my brother.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਉ ਮੇਰੇ ਸੰਗਿ ਅੰਤਿ ਹੋਇ ਸਖਾਈ ॥੩॥",
      "transliteration": "naau mere sa(n)g a(n)t hoi sakhaaee ||3||",
      "translation": "The Name is my companion, who will help me in the end. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮਾਇਆ ਮਹਿ ਜਿਸੁ ਰਖੈ ਉਦਾਸੁ ॥",
      "transliteration": "maaiaa mahi jis rakhai udaas ||",
      "translation": "One whom the Lord keeps detached from Maya",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਹਉ ਤਾ ਕੋ ਦਾਸੁ ॥੪॥੧॥",
      "transliteration": "kahi kabeer hau taa ko daas ||4||1||",
      "translation": "- says Kabeer, I am his slave. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾਂਗੇ ਆਵਨੁ ਨਾਂਗੇ ਜਾਨਾ ॥",
      "transliteration": "naa(n)ge aavan naa(n)ge jaanaa ||",
      "translation": "Naked we come, and naked we go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1157_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕੋਇ ਨ ਰਹਿਹੈ ਰਾਜਾ ਰਾਨਾ ॥੧॥",
      "transliteration": "koi na rahihai raajaa raanaa ||1||",
      "translation": "No one, not even the kings and queens, shall remain. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1157,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
