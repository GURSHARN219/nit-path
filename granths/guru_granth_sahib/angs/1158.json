{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1158,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1158_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਰਾਮੁ ਰਾਜਾ ਨਉ ਨਿਧਿ ਮੇਰੈ ॥",
      "transliteration": "raam raajaa nau nidh merai ||",
      "translation": "The Sovereign Lord is the nine treasures for me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੰਪੈ ਹੇਤੁ ਕਲਤੁ ਧਨੁ ਤੇਰੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sa(n)pai het kalat dhan terai ||1|| rahaau ||",
      "translation": "The possessions and the spouse to which the mortal is lovingly attached, are Your wealth, O Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਵਤ ਸੰਗ ਨ ਜਾਤ ਸੰਗਾਤੀ ॥",
      "transliteration": "aavat sa(n)g na jaat sa(n)gaatee ||",
      "translation": "They do not come with the mortal, and they do not go with him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਹਾ ਭਇਓ ਦਰਿ ਬਾਂਧੇ ਹਾਥੀ ॥੨॥",
      "transliteration": "kahaa bhaio dar baa(n)dhe haathee ||2||",
      "translation": "What good does it do him, if he has elephants tied up at his doorway? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਲੰਕਾ ਗਢੁ ਸੋਨੇ ਕਾ ਭਇਆ ॥",
      "transliteration": "la(n)kaa gadh sone kaa bhaiaa ||",
      "translation": "The fortress of Sri Lanka was made out of gold,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੂਰਖੁ ਰਾਵਨੁ ਕਿਆ ਲੇ ਗਇਆ ॥੩॥",
      "transliteration": "moorakh raavan kiaa le gaiaa ||3||",
      "translation": "but what could the foolish Raawan take with him when he left? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਕਿਛੁ ਗੁਨੁ ਬੀਚਾਰਿ ॥",
      "transliteration": "kahi kabeer kichh gun beechaar ||",
      "translation": "Says Kabeer, think of doing some good deeds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਚਲੇ ਜੁਆਰੀ ਦੁਇ ਹਥ ਝਾਰਿ ॥੪॥੨॥",
      "transliteration": "chale juaaree dui hath jhaar ||4||2||",
      "translation": "In the end, the gambler shall depart empty-handed. ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮੈਲਾ ਬ੍ਰਹਮਾ ਮੈਲਾ ਇੰਦੁ ॥",
      "transliteration": "mailaa brahamaa mailaa i(n)d ||",
      "translation": "Brahma is polluted, and Indra is polluted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਰਵਿ ਮੈਲਾ ਮੈਲਾ ਹੈ ਚੰਦੁ ॥੧॥",
      "transliteration": "rav mailaa mailaa hai cha(n)d ||1||",
      "translation": "The sun is polluted, and the moon is polluted. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮੈਲਾ ਮਲਤਾ ਇਹੁ ਸੰਸਾਰੁ ॥",
      "transliteration": "mailaa malataa ihu sa(n)saar ||",
      "translation": "This world is polluted with pollution.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਇਕੁ ਹਰਿ ਨਿਰਮਲੁ ਜਾ ਕਾ ਅੰਤੁ ਨ ਪਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ik har niramal jaa kaa a(n)t na paar ||1|| rahaau ||",
      "translation": "Only the One Lord is Immaculate; He has no end or limitation. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮੈਲੇ ਬ੍ਰਹਮੰਡਾਇ ਕੈ ਈਸ ॥",
      "transliteration": "maile brahama(n)daai kai ees ||",
      "translation": "The rulers of kingdoms are polluted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੈਲੇ ਨਿਸਿ ਬਾਸੁਰ ਦਿਨ ਤੀਸ ॥੨॥",
      "transliteration": "maile nis baasur din tees ||2||",
      "translation": "Nights and days, and the days of the month are polluted. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮੈਲਾ ਮੋਤੀ ਮੈਲਾ ਹੀਰੁ ॥",
      "transliteration": "mailaa motee mailaa heer ||",
      "translation": "The pearl is polluted, the diamond is polluted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮੈਲਾ ਪਉਨੁ ਪਾਵਕੁ ਅਰੁ ਨੀਰੁ ॥੩॥",
      "transliteration": "mailaa paun paavak ar neer ||3||",
      "translation": "Wind, fire and water are polluted. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮੈਲੇ ਸਿਵ ਸੰਕਰਾ ਮਹੇਸ ॥",
      "transliteration": "maile siv sa(n)karaa mahes ||",
      "translation": "Shiva, Shankara and Mahaysh are polluted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮੈਲੇ ਸਿਧ ਸਾਧਿਕ ਅਰੁ ਭੇਖ ॥੪॥",
      "transliteration": "maile sidh saadhik ar bhekh ||4||",
      "translation": "The Siddhas, seekers and strivers, and those who wear religious robes, are polluted. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੈਲੇ ਜੋਗੀ ਜੰਗਮ ਜਟਾ ਸਹੇਤਿ ॥",
      "transliteration": "maile jogee ja(n)gam jataa sahet ||",
      "translation": "The Yogis and wandering hermits with their matted hair are polluted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਮੈਲੀ ਕਾਇਆ ਹੰਸ ਸਮੇਤਿ ॥੫॥",
      "transliteration": "mailee kaaiaa ha(n)s samet ||5||",
      "translation": "The body, along with the swan-soul, is polluted. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਤੇ ਜਨ ਪਰਵਾਨ ॥",
      "transliteration": "kahi kabeer te jan paravaan ||",
      "translation": "Says Kabeer, those humble beings are approved and pure,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਿਰਮਲ ਤੇ ਜੋ ਰਾਮਹਿ ਜਾਨ ॥੬॥੩॥",
      "transliteration": "niramal te jo raamahi jaan ||6||3||",
      "translation": "Who know the Lord. ||6||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਨੁ ਕਰਿ ਮਕਾ ਕਿਬਲਾ ਕਰਿ ਦੇਹੀ ॥",
      "transliteration": "man kar makaa kibalaa kar dehee ||",
      "translation": "Let your mind be Mecca, and your body the temple of worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬੋਲਨਹਾਰੁ ਪਰਮ ਗੁਰੁ ਏਹੀ ॥੧॥",
      "transliteration": "bolanahaar param gur ehee ||1||",
      "translation": "Let the Supreme Guru be the One who speaks. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਹੁ ਰੇ ਮੁਲਾਂ ਬਾਂਗ ਨਿਵਾਜ ॥",
      "transliteration": "kahu re mulaa(n) baa(n)g nivaaj ||",
      "translation": "O Mullah, utter the call to prayer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਏਕ ਮਸੀਤਿ ਦਸੈ ਦਰਵਾਜ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ek maseet dasai daravaaj ||1|| rahaau ||",
      "translation": "The one mosque has ten doors. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਿਸਿਮਿਲਿ ਤਾਮਸੁ ਭਰਮੁ ਕਦੂਰੀ ॥",
      "transliteration": "misimil taamas bharam kadooree ||",
      "translation": "So slaughter your evil nature, doubt and cruelty;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭਾਖਿ ਲੇ ਪੰਚੈ ਹੋਇ ਸਬੂਰੀ ॥੨॥",
      "transliteration": "bhaakh le pa(n)chai hoi sabooree ||2||",
      "translation": "consume the five demons and you shall be blessed with contentment. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਿੰਦੂ ਤੁਰਕ ਕਾ ਸਾਹਿਬੁ ਏਕ ॥",
      "transliteration": "hi(n)doo turak kaa saahib ek ||",
      "translation": "Hindus and Muslims have the same One Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹ ਕਰੈ ਮੁਲਾਂ ਕਹ ਕਰੈ ਸੇਖ ॥੩॥",
      "transliteration": "kah karai mulaa(n) kah karai sekh ||3||",
      "translation": "What can the Mullah do, and what can the Shaykh do? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਹਉ ਭਇਆ ਦਿਵਾਨਾ ॥",
      "transliteration": "kahi kabeer hau bhaiaa divaanaa ||",
      "translation": "Says Kabeer, I have gone insane.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਮੁਸਿ ਮੁਸਿ ਮਨੂਆ ਸਹਜਿ ਸਮਾਨਾ ॥੪॥੪॥",
      "transliteration": "mus mus manooaa sahaj samaanaa ||4||4||",
      "translation": "Slaughtering, slaughtering my mind, I have merged into the Celestial Lord. ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੰਗਾ ਕੈ ਸੰਗਿ ਸਲਿਤਾ ਬਿਗਰੀ ॥",
      "transliteration": "ga(n)gaa kai sa(n)g salitaa bigaree ||",
      "translation": "When the stream flows into the Ganges,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸੋ ਸਲਿਤਾ ਗੰਗਾ ਹੋਇ ਨਿਬਰੀ ॥੧॥",
      "transliteration": "so salitaa ga(n)gaa hoi nibaree ||1||",
      "translation": "Then it becomes the Ganges. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਿਗਰਿਓ ਕਬੀਰਾ ਰਾਮ ਦੁਹਾਈ ॥",
      "transliteration": "bigario kabeeraa raam duhaaee ||",
      "translation": "Just so, Kabeer has changed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਾਚੁ ਭਇਓ ਅਨ ਕਤਹਿ ਨ ਜਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saach bhaio an katahi na jaaee ||1|| rahaau ||",
      "translation": "He has become the Embodiment of Truth, and he does not go anywhere else. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਚੰਦਨ ਕੈ ਸੰਗਿ ਤਰਵਰੁ ਬਿਗਰਿਓ ॥",
      "transliteration": "cha(n)dan kai sa(n)g taravar bigario ||",
      "translation": "Associating with the sandalwood tree, the tree nearby is changed;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸੋ ਤਰਵਰੁ ਚੰਦਨੁ ਹੋਇ ਨਿਬਰਿਓ ॥੨॥",
      "transliteration": "so taravar cha(n)dan hoi nibario ||2||",
      "translation": "that tree begins to smell just like the sandalwood tree. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਾਰਸ ਕੈ ਸੰਗਿ ਤਾਂਬਾ ਬਿਗਰਿਓ ॥",
      "transliteration": "paaras kai sa(n)g taa(n)baa bigario ||",
      "translation": "Coming into contact with the philosophers' stone, copper is transformed;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੋ ਤਾਂਬਾ ਕੰਚਨੁ ਹੋਇ ਨਿਬਰਿਓ ॥੩॥",
      "transliteration": "so taa(n)baa ka(n)chan hoi nibario ||3||",
      "translation": "that copper is transformed into gold. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੰਤਨ ਸੰਗਿ ਕਬੀਰਾ ਬਿਗਰਿਓ ॥",
      "transliteration": "sa(n)tan sa(n)g kabeeraa bigario ||",
      "translation": "In the Society of the Saints, Kabeer is transformed;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੋ ਕਬੀਰੁ ਰਾਮੈ ਹੋਇ ਨਿਬਰਿਓ ॥੪॥੫॥",
      "transliteration": "so kabeer raamai hoi nibario ||4||5||",
      "translation": "that Kabeer is transformed into the Lord. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਾਥੇ ਤਿਲਕੁ ਹਥਿ ਮਾਲਾ ਬਾਨਾਂ ॥",
      "transliteration": "maathe tilak hath maalaa baanaa(n) ||",
      "translation": "Some apply ceremonial marks to their foreheads, hold malas in their hands, and wear religious robes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਲੋਗਨ ਰਾਮੁ ਖਿਲਉਨਾ ਜਾਨਾਂ ॥੧॥",
      "transliteration": "logan raam khilaunaa jaanaa(n) ||1||",
      "translation": "Some people think that the Lord is a play-thing. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਉ ਹਉ ਬਉਰਾ ਤਉ ਰਾਮ ਤੋਰਾ ॥",
      "transliteration": "jau hau bauraa tau raam toraa ||",
      "translation": "If I am insane, then I am Yours, O Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਲੋਗੁ ਮਰਮੁ ਕਹ ਜਾਨੈ ਮੋਰਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "log maram kah jaanai moraa ||1|| rahaau ||",
      "translation": "How can people know my secret? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤੋਰਉ ਨ ਪਾਤੀ ਪੂਜਉ ਨ ਦੇਵਾ ॥",
      "transliteration": "torau na paatee poojau na devaa ||",
      "translation": "I do not pick leaves as offerings, and I do not worship idols.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਰਾਮ ਭਗਤਿ ਬਿਨੁ ਨਿਹਫਲ ਸੇਵਾ ॥੨॥",
      "transliteration": "raam bhagat bin nihaphal sevaa ||2||",
      "translation": "Without devotional worship of the Lord, service is useless. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਪੂਜਉ ਸਦਾ ਸਦਾ ਮਨਾਵਉ ॥",
      "transliteration": "satigur poojau sadaa sadaa manaavau ||",
      "translation": "I worship the True Guru; forever and ever, I surrender to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਐਸੀ ਸੇਵ ਦਰਗਹ ਸੁਖੁ ਪਾਵਉ ॥੩॥",
      "transliteration": "aisee sev daragah sukh paavau ||3||",
      "translation": "By such service, I find peace in the Court of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਲੋਗੁ ਕਹੈ ਕਬੀਰੁ ਬਉਰਾਨਾ ॥",
      "transliteration": "log kahai kabeer bauraanaa ||",
      "translation": "People say that Kabeer has gone insane.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਬੀਰ ਕਾ ਮਰਮੁ ਰਾਮ ਪਹਿਚਾਨਾਂ ॥੪॥੬॥",
      "transliteration": "kabeer kaa maram raam pahichaanaa(n) ||4||6||",
      "translation": "Only the Lord realizes the secret of Kabeer. ||4||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਉਲਟਿ ਜਾਤਿ ਕੁਲ ਦੋਊ ਬਿਸਾਰੀ ॥",
      "transliteration": "ulat jaat kul dooo bisaaree ||",
      "translation": "Turning away from the world, I have forgotten both my social class and ancestry.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੁੰਨ ਸਹਜ ਮਹਿ ਬੁਨਤ ਹਮਾਰੀ ॥੧॥",
      "transliteration": "su(n)n sahaj mahi bunat hamaaree ||1||",
      "translation": "My weaving now is in the most profound celestial stillness. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1158_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਹਮਰਾ ਝਗਰਾ ਰਹਾ ਨ ਕੋਊ ॥",
      "transliteration": "hamaraa jhagaraa rahaa na kooo ||",
      "translation": "I have no quarrel with anyone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1158,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
