{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1159,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1159_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪੰਡਿਤ ਮੁਲਾਂ ਛਾਡੇ ਦੋਊ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "pa(n)dit mulaa(n) chhaade dooo ||1|| rahaau ||",
      "translation": "I have abandoned both the Pandits, the Hindu religious scholars, and the Mullahs, the Muslim priests. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬੁਨਿ ਬੁਨਿ ਆਪ ਆਪੁ ਪਹਿਰਾਵਉ ॥",
      "transliteration": "bun bun aap aap pahiraavau ||",
      "translation": "I weave and weave, and wear what I weave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਹ ਨਹੀ ਆਪੁ ਤਹਾ ਹੋਇ ਗਾਵਉ ॥੨॥",
      "transliteration": "jah nahee aap tahaa hoi gaavau ||2||",
      "translation": "Where egotism does not exist, there I sing God's Praises. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪੰਡਿਤ ਮੁਲਾਂ ਜੋ ਲਿਖਿ ਦੀਆ ॥",
      "transliteration": "pa(n)dit mulaa(n) jo likh deeaa ||",
      "translation": "Whatever the Pandits and Mullahs have written,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਛਾਡਿ ਚਲੇ ਹਮ ਕਛੂ ਨ ਲੀਆ ॥੩॥",
      "transliteration": "chhaad chale ham kachhoo na leeaa ||3||",
      "translation": "I reject; I do not accept any of it. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਰਿਦੈ ਇਖਲਾਸੁ ਨਿਰਖਿ ਲੇ ਮੀਰਾ ॥",
      "transliteration": "ridai ikhalaas nirakh le meeraa ||",
      "translation": "My heart is pure, and so I have seen the Lord within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਪੁ ਖੋਜਿ ਖੋਜਿ ਮਿਲੇ ਕਬੀਰਾ ॥੪॥੭॥",
      "transliteration": "aap khoj khoj mile kabeeraa ||4||7||",
      "translation": "Searching, searching within the self, Kabeer has met the Lord. ||4||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਿਰਧਨ ਆਦਰੁ ਕੋਈ ਨ ਦੇਇ ॥",
      "transliteration": "niradhan aadar koee na dei ||",
      "translation": "No one respects the poor man.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਲਾਖ ਜਤਨ ਕਰੈ ਓਹੁ ਚਿਤਿ ਨ ਧਰੇਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "laakh jatan karai ohu chit na dharei ||1|| rahaau ||",
      "translation": "He may make thousands of efforts, but no one pays any attention to him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਉ ਨਿਰਧਨੁ ਸਰਧਨ ਕੈ ਜਾਇ ॥",
      "transliteration": "jau niradhan saradhan kai jaai ||",
      "translation": "When the poor man goes to the rich man,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਆਗੇ ਬੈਠਾ ਪੀਠਿ ਫਿਰਾਇ ॥੧॥",
      "transliteration": "aage baithaa peeth phiraai ||1||",
      "translation": "and sits right in front of him, the rich man turns his back on him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਉ ਸਰਧਨੁ ਨਿਰਧਨ ਕੈ ਜਾਇ ॥",
      "transliteration": "jau saradhan niradhan kai jaai ||",
      "translation": "But when the rich man goes to the poor man,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਦੀਆ ਆਦਰੁ ਲੀਆ ਬੁਲਾਇ ॥੨॥",
      "transliteration": "deeaa aadar leeaa bulaai ||2||",
      "translation": "the poor man welcomes him with respect. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਨਿਰਧਨੁ ਸਰਧਨੁ ਦੋਨਉ ਭਾਈ ॥",
      "transliteration": "niradhan saradhan donau bhaaee ||",
      "translation": "The poor man and the rich man are both brothers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਕਲਾ ਨ ਮੇਟੀ ਜਾਈ ॥੩॥",
      "transliteration": "prabh kee kalaa na metee jaaee ||3||",
      "translation": "God's pre-ordained plan cannot be erased. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਨਿਰਧਨੁ ਹੈ ਸੋਈ ॥",
      "transliteration": "kahi kabeer niradhan hai soee ||",
      "translation": "Says Kabeer, he alone is poor,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਾ ਕੇ ਹਿਰਦੈ ਨਾਮੁ ਨ ਹੋਈ ॥੪॥੮॥",
      "transliteration": "jaa ke hiradai naam na hoee ||4||8||",
      "translation": "who does not have the Naam, the Name of the Lord, in his heart. ||4||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰ ਸੇਵਾ ਤੇ ਭਗਤਿ ਕਮਾਈ ॥",
      "transliteration": "gur sevaa te bhagat kamaaee ||",
      "translation": "Serving the Guru, devotional worship is practiced.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਬ ਇਹ ਮਾਨਸ ਦੇਹੀ ਪਾਈ ॥",
      "transliteration": "tab ih maanas dehee paaee ||",
      "translation": "Then, this human body is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਇਸ ਦੇਹੀ ਕਉ ਸਿਮਰਹਿ ਦੇਵ ॥",
      "transliteration": "is dehee kau simarahi dev ||",
      "translation": "Even the gods long for this human body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੋ ਦੇਹੀ ਭਜੁ ਹਰਿ ਕੀ ਸੇਵ ॥੧॥",
      "transliteration": "so dehee bhaj har kee sev ||1||",
      "translation": "So vibrate that human body, and think of serving the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਭਜਹੁ ਗੋੁਬਿੰਦ ਭੂਲਿ ਮਤ ਜਾਹੁ ॥",
      "transliteration": "bhajahu goubi(n)d bhool mat jaahu ||",
      "translation": "Vibrate, and meditate on the Lord of the Universe, and never forget Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਾਨਸ ਜਨਮ ਕਾ ਏਹੀ ਲਾਹੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "maanas janam kaa ehee laahu ||1|| rahaau ||",
      "translation": "This is the blessed opportunity of this human incarnation. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਬ ਲਗੁ ਜਰਾ ਰੋਗੁ ਨਹੀ ਆਇਆ ॥",
      "transliteration": "jab lag jaraa rog nahee aaiaa ||",
      "translation": "As long as the disease of old age has not come to the body,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਬ ਲਗੁ ਕਾਲਿ ਗ੍ਰਸੀ ਨਹੀ ਕਾਇਆ ॥",
      "transliteration": "jab lag kaal grasee nahee kaaiaa ||",
      "translation": "and as long as death has not come and seized the body,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜਬ ਲਗੁ ਬਿਕਲ ਭਈ ਨਹੀ ਬਾਨੀ ॥",
      "transliteration": "jab lag bikal bhaee nahee baanee ||",
      "translation": "and as long as your voice has not lost its power,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭਜਿ ਲੇਹਿ ਰੇ ਮਨ ਸਾਰਿਗਪਾਨੀ ॥੨॥",
      "transliteration": "bhaj lehi re man saarigapaanee ||2||",
      "translation": "O mortal being, vibrate and meditate on the Lord of the World. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਬ ਨ ਭਜਸਿ ਭਜਸਿ ਕਬ ਭਾਈ ॥",
      "transliteration": "ab na bhajas bhajas kab bhaaee ||",
      "translation": "If you do not vibrate and meditate on Him now, when will you, O Sibing of Destiny?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਵੈ ਅੰਤੁ ਨ ਭਜਿਆ ਜਾਈ ॥",
      "transliteration": "aavai a(n)t na bhajiaa jaaee ||",
      "translation": "When the end comes, you will not be able to vibrate and meditate on Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕਰਹਿ ਸੋਈ ਅਬ ਸਾਰੁ ॥",
      "transliteration": "jo kichh karahi soee ab saar ||",
      "translation": "Whatever you have to do - now is the best time to do it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਫਿਰਿ ਪਛੁਤਾਹੁ ਨ ਪਾਵਹੁ ਪਾਰੁ ॥੩॥",
      "transliteration": "phir pachhutaahu na paavahu paar ||3||",
      "translation": "Otherwise, you shall regret and repent afterwards, and you shall not be carried across to the other side. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੋ ਸੇਵਕੁ ਜੋ ਲਾਇਆ ਸੇਵ ॥",
      "transliteration": "so sevak jo laaiaa sev ||",
      "translation": "He alone is a servant, whom the Lord enjoins to His service.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਿਨ ਹੀ ਪਾਏ ਨਿਰੰਜਨ ਦੇਵ ॥",
      "transliteration": "tin hee paae nira(n)jan dev ||",
      "translation": "He alone attains the Immaculate Divine Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰ ਮਿਲਿ ਤਾ ਕੇ ਖੁਲੑੇ ਕਪਾਟ ॥",
      "transliteration": "gur mil taa ke khulhe kapaat ||",
      "translation": "Meeting with the Guru, his doors are opened wide,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਹੁਰਿ ਨ ਆਵੈ ਜੋਨੀ ਬਾਟ ॥੪॥",
      "transliteration": "bahur na aavai jonee baat ||4||",
      "translation": "and he does not have to journey again on the path of reincarnation. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਇਹੀ ਤੇਰਾ ਅਉਸਰੁ ਇਹ ਤੇਰੀ ਬਾਰ ॥",
      "transliteration": "ihee teraa ausar ih teree baar ||",
      "translation": "This is your chance, and this is your time.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਘਟ ਭੀਤਰਿ ਤੂ ਦੇਖੁ ਬਿਚਾਰਿ ॥",
      "transliteration": "ghat bheetar too dekh bichaar ||",
      "translation": "Look deep into your own heart, and reflect on this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਹਤ ਕਬੀਰੁ ਜੀਤਿ ਕੈ ਹਾਰਿ ॥",
      "transliteration": "kahat kabeer jeet kai haar ||",
      "translation": "Says Kabeer, you can win or lose.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਕਹਿਓ ਪੁਕਾਰਿ ਪੁਕਾਰਿ ॥੫॥੧॥੯॥",
      "transliteration": "bahu bidh kahio pukaar pukaar ||5||1||9||",
      "translation": "In so many ways, I have proclaimed this out loud. ||5||1||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਿਵ ਕੀ ਪੁਰੀ ਬਸੈ ਬੁਧਿ ਸਾਰੁ ॥",
      "transliteration": "siv kee puree basai budh saar ||",
      "translation": "In the City of God, sublime understanding prevails.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਹ ਤੁਮੑ ਮਿਲਿ ਕੈ ਕਰਹੁ ਬਿਚਾਰੁ ॥",
      "transliteration": "tah tumh mil kai karahu bichaar ||",
      "translation": "There, you shall meet with the Lord, and reflect on Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਈਤ ਊਤ ਕੀ ਸੋਝੀ ਪਰੈ ॥",
      "transliteration": "eet oot kee sojhee parai ||",
      "translation": "Thus, you shall understand this world and the next.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਉਨੁ ਕਰਮ ਮੇਰਾ ਕਰਿ ਕਰਿ ਮਰੈ ॥੧॥",
      "transliteration": "kaun karam meraa kar kar marai ||1||",
      "translation": "What is the use of claiming that you own everything, if you only die in the end? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਿਜ ਪਦ ਊਪਰਿ ਲਾਗੋ ਧਿਆਨੁ ॥",
      "transliteration": "nij pad oopar laago dhiaan ||",
      "translation": "I focus my meditation on my inner self, deep within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਰਾਜਾ ਰਾਮ ਨਾਮੁ ਮੋਰਾ ਬ੍ਰਹਮ ਗਿਆਨੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raajaa raam naam moraa braham giaan ||1|| rahaau ||",
      "translation": "The Name of the Sovereign Lord is my spiritual wisdom. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮੂਲ ਦੁਆਰੈ ਬੰਧਿਆ ਬੰਧੁ ॥",
      "transliteration": "mool duaarai ba(n)dhiaa ba(n)dh ||",
      "translation": "In the first chakra, the root chakra, I have grasped the reins and tied them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਵਿ ਊਪਰਿ ਗਹਿ ਰਾਖਿਆ ਚੰਦੁ ॥",
      "transliteration": "rav oopar gahi raakhiaa cha(n)d ||",
      "translation": "I have firmly placed the moon above the sun.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਛਮ ਦੁਆਰੈ ਸੂਰਜੁ ਤਪੈ ॥",
      "transliteration": "pachham duaarai sooraj tapai ||",
      "translation": "The sun blazes forth at the western gate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮੇਰ ਡੰਡ ਸਿਰ ਊਪਰਿ ਬਸੈ ॥੨॥",
      "transliteration": "mer da(n)d sir oopar basai ||2||",
      "translation": "Through the central channel of the Shushmanaa, it rises up above my head. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪਸਚਮ ਦੁਆਰੇ ਕੀ ਸਿਲ ਓੜ ॥",
      "transliteration": "pasacham duaare kee sil oR ||",
      "translation": "There is a stone at that western gate,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਤਿਹ ਸਿਲ ਊਪਰਿ ਖਿੜਕੀ ਅਉਰ ॥",
      "transliteration": "tih sil oopar khiRakee aur ||",
      "translation": "and above that stone, is another window.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਖਿੜਕੀ ਊਪਰਿ ਦਸਵਾ ਦੁਆਰੁ ॥",
      "transliteration": "khiRakee oopar dasavaa duaar ||",
      "translation": "Above that window is the Tenth Gate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਤਾ ਕਾ ਅੰਤੁ ਨ ਪਾਰੁ ॥੩॥੨॥੧੦॥",
      "transliteration": "kahi kabeer taa kaa a(n)t na paar ||3||2||10||",
      "translation": "Says Kabeer, it has no end or limitation. ||3||2||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੋ ਮੁਲਾਂ ਜੋ ਮਨ ਸਿਉ ਲਰੈ ॥",
      "transliteration": "so mulaa(n) jo man siu larai ||",
      "translation": "He alone is a Mullah, who struggles with his mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਗੁਰ ਉਪਦੇਸਿ ਕਾਲ ਸਿਉ ਜੁਰੈ ॥",
      "transliteration": "gur upades kaal siu jurai ||",
      "translation": "and through the Guru's Teachings, fights with death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਾਲ ਪੁਰਖ ਕਾ ਮਰਦੈ ਮਾਨੁ ॥",
      "transliteration": "kaal purakh kaa maradai maan ||",
      "translation": "He crushes the pride of the Messenger of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1159_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਿਸੁ ਮੁਲਾ ਕਉ ਸਦਾ ਸਲਾਮੁ ॥੧॥",
      "transliteration": "tis mulaa kau sadaa salaam ||1||",
      "translation": "Unto that Mullah, I ever offer greetings of respect. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1159,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
