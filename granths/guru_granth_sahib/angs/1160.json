{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1160,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1160_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹੈ ਹਜੂਰਿ ਕਤ ਦੂਰਿ ਬਤਾਵਹੁ ॥",
      "transliteration": "hai hajoor kat door bataavahu ||",
      "translation": "God is present, right here at hand; why do you say that He is far away?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦੁੰਦਰ ਬਾਧਹੁ ਸੁੰਦਰ ਪਾਵਹੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "du(n)dar baadhahu su(n)dar paavahu ||1|| rahaau ||",
      "translation": "Tie up your disturbing passions, and find the Beauteous Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਾਜੀ ਸੋ ਜੁ ਕਾਇਆ ਬੀਚਾਰੈ ॥",
      "transliteration": "kaajee so j kaaiaa beechaarai ||",
      "translation": "He alone is a Qazi, who contemplates the human body,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਾਇਆ ਕੀ ਅਗਨਿ ਬ੍ਰਹਮੁ ਪਰਜਾਰੈ ॥",
      "transliteration": "kaaiaa kee agan braham parajaarai ||",
      "translation": "and through the fire of the body, is illumined by God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸੁਪਨੈ ਬਿੰਦੁ ਨ ਦੇਈ ਝਰਨਾ ॥",
      "transliteration": "supanai bi(n)d na deee jharanaa ||",
      "translation": "He does not lose his semen, even in his dreams;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਿਸੁ ਕਾਜੀ ਕਉ ਜਰਾ ਨ ਮਰਨਾ ॥੨॥",
      "transliteration": "tis kaajee kau jaraa na maranaa ||2||",
      "translation": "for such a Qazi, there is no old age or death. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੋ ਸੁਰਤਾਨੁ ਜੁ ਦੁਇ ਸਰ ਤਾਨੈ ॥",
      "transliteration": "so surataan j dui sar taanai ||",
      "translation": "He alone is a sultan and a king, who shoots the two arrows,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਾਹਰਿ ਜਾਤਾ ਭੀਤਰਿ ਆਨੈ ॥",
      "transliteration": "baahar jaataa bheetar aanai ||",
      "translation": "gathers in his outgoing mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਗਨ ਮੰਡਲ ਮਹਿ ਲਸਕਰੁ ਕਰੈ ॥",
      "transliteration": "gagan ma(n)dal mahi lasakar karai ||",
      "translation": "and assembles his army in the realm of the mind's sky, the Tenth Gate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੋ ਸੁਰਤਾਨੁ ਛਤ੍ਰੁ ਸਿਰਿ ਧਰੈ ॥੩॥",
      "transliteration": "so surataan chhatr sir dharai ||3||",
      "translation": "The canopy of royalty waves over such a sultan. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੋਗੀ ਗੋਰਖੁ ਗੋਰਖੁ ਕਰੈ ॥",
      "transliteration": "jogee gorakh gorakh karai ||",
      "translation": "The Yogi cries out, \"Gorakh, Gorakh\".",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਿੰਦੂ ਰਾਮ ਨਾਮੁ ਉਚਰੈ ॥",
      "transliteration": "hi(n)doo raam naam ucharai ||",
      "translation": "The Hindu utters the Name of Raam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮੁਸਲਮਾਨ ਕਾ ਏਕੁ ਖੁਦਾਇ ॥",
      "transliteration": "musalamaan kaa ek khudaai ||",
      "translation": "The Muslim has only One God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਬੀਰ ਕਾ ਸੁਆਮੀ ਰਹਿਆ ਸਮਾਇ ॥੪॥੩॥੧੧॥",
      "transliteration": "kabeer kaa suaamee rahiaa samaai ||4||3||11||",
      "translation": "The Lord and Master of Kabeer is all-pervading. ||4||3||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਹਲਾ ੫ ॥",
      "transliteration": "mahalaa 5 ||",
      "translation": "Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੋ ਪਾਥਰ ਕਉ ਕਹਤੇ ਦੇਵ ॥",
      "transliteration": "jo paathar kau kahate dev ||",
      "translation": "Those who call a stone their god",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾ ਕੀ ਬਿਰਥਾ ਹੋਵੈ ਸੇਵ ॥",
      "transliteration": "taa kee birathaa hovai sev ||",
      "translation": "their service is useless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੋ ਪਾਥਰ ਕੀ ਪਾਂਈ ਪਾਇ ॥",
      "transliteration": "jo paathar kee paa(n)ee paai ||",
      "translation": "Those who fall at the feet of a stone god",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਿਸ ਕੀ ਘਾਲ ਅਜਾਂਈ ਜਾਇ ॥੧॥",
      "transliteration": "tis kee ghaal ajaa(n)ee jaai ||1||",
      "translation": "- their work is wasted in vain. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਠਾਕੁਰੁ ਹਮਰਾ ਸਦ ਬੋਲੰਤਾ ॥",
      "transliteration": "thaakur hamaraa sad bola(n)taa ||",
      "translation": "My Lord and Master speaks forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਰਬ ਜੀਆ ਕਉ ਪ੍ਰਭੁ ਦਾਨੁ ਦੇਤਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sarab jeeaa kau prabh daan detaa ||1|| rahaau ||",
      "translation": "God gives His gifts to all living beings. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅੰਤਰਿ ਦੇਉ ਨ ਜਾਨੈ ਅੰਧੁ ॥",
      "transliteration": "a(n)tar deu na jaanai a(n)dh ||",
      "translation": "The Divine Lord is within the self, but the spiritually blind one does not know this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਭ੍ਰਮ ਕਾ ਮੋਹਿਆ ਪਾਵੈ ਫੰਧੁ ॥",
      "transliteration": "bhram kaa mohiaa paavai pha(n)dh ||",
      "translation": "Deluded by doubt, he is caught in the noose.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨ ਪਾਥਰੁ ਬੋਲੈ ਨਾ ਕਿਛੁ ਦੇਇ ॥",
      "transliteration": "na paathar bolai naa kichh dei ||",
      "translation": "The stone does not speak; it does not give anything to anyone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਫੋਕਟ ਕਰਮ ਨਿਹਫਲ ਹੈ ਸੇਵ ॥੨॥",
      "transliteration": "phokat karam nihaphal hai sev ||2||",
      "translation": "Such religious rituals are useless; such service is fruitless. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੇ ਮਿਰਤਕ ਕਉ ਚੰਦਨੁ ਚੜਾਵੈ ॥",
      "transliteration": "je miratak kau cha(n)dan chaRaavai ||",
      "translation": "If a corpse is anointed with sandalwood oil,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਉਸ ਤੇ ਕਹਹੁ ਕਵਨ ਫਲ ਪਾਵੈ ॥",
      "transliteration": "us te kahahu kavan phal paavai ||",
      "translation": "what good does it do?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੇ ਮਿਰਤਕ ਕਉ ਬਿਸਟਾ ਮਾਹਿ ਰੁਲਾਈ ॥",
      "transliteration": "je miratak kau bisataa maahi rulaaee ||",
      "translation": "If a corpse is rolled in manure,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤਾਂ ਮਿਰਤਕ ਕਾ ਕਿਆ ਘਟਿ ਜਾਈ ॥੩॥",
      "transliteration": "taa(n) miratak kaa kiaa ghat jaaee ||3||",
      "translation": "what does it lose from this? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਹਤ ਕਬੀਰ ਹਉ ਕਹਉ ਪੁਕਾਰਿ ॥",
      "transliteration": "kahat kabeer hau kahau pukaar ||",
      "translation": "Says Kabeer, I proclaim this out loud",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਮਝਿ ਦੇਖੁ ਸਾਕਤ ਗਾਵਾਰ ॥",
      "transliteration": "samajh dekh saakat gaavaar ||",
      "translation": "behold, and understand, you ignorant, faithless cynic.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੂਜੈ ਭਾਇ ਬਹੁਤੁ ਘਰ ਗਾਲੇ ॥",
      "transliteration": "doojai bhaai bahut ghar gaale ||",
      "translation": "The love of duality has ruined countless homes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰਾਮ ਭਗਤ ਹੈ ਸਦਾ ਸੁਖਾਲੇ ॥੪॥੪॥੧੨॥",
      "transliteration": "raam bhagat hai sadaa sukhaale ||4||4||12||",
      "translation": "The Lord's devotees are forever in bliss. ||4||4||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਲ ਮਹਿ ਮੀਨ ਮਾਇਆ ਕੇ ਬੇਧੇ ॥",
      "transliteration": "jal mahi meen maaiaa ke bedhe ||",
      "translation": "The fish in the water is attached to Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਦੀਪਕ ਪਤੰਗ ਮਾਇਆ ਕੇ ਛੇਦੇ ॥",
      "transliteration": "deepak pata(n)g maaiaa ke chhede ||",
      "translation": "The moth fluttering around the lamp is pierced through by Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਕਾਮ ਮਾਇਆ ਕੁੰਚਰ ਕਉ ਬਿਆਪੈ ॥",
      "transliteration": "kaam maaiaa ku(n)char kau biaapai ||",
      "translation": "The sexual desire of Maya afflicts the elephant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭੁਇਅੰਗਮ ਭ੍ਰਿੰਗ ਮਾਇਆ ਮਹਿ ਖਾਪੇ ॥੧॥",
      "transliteration": "bhuia(n)gam bhri(n)g maaiaa mahi khaape ||1||",
      "translation": "The snakes and bumble bees are destroyed through Maya. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਾਇਆ ਐਸੀ ਮੋਹਨੀ ਭਾਈ ॥",
      "transliteration": "maaiaa aisee mohanee bhaaee ||",
      "translation": "Such are the enticements of Maya, O Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੇਤੇ ਜੀਅ ਤੇਤੇ ਡਹਕਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jete jee tete dahakaaee ||1|| rahaau ||",
      "translation": "As many living beings are there are, have been deceived. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪੰਖੀ ਮ੍ਰਿਗ ਮਾਇਆ ਮਹਿ ਰਾਤੇ ॥",
      "transliteration": "pa(n)khee mrig maaiaa mahi raate ||",
      "translation": "The birds and the deer are imbued with Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਾਕਰ ਮਾਖੀ ਅਧਿਕ ਸੰਤਾਪੇ ॥",
      "transliteration": "saakar maakhee adhik sa(n)taape ||",
      "translation": "Sugar is a deadly trap for the flies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤੁਰੇ ਉਸਟ ਮਾਇਆ ਮਹਿ ਭੇਲਾ ॥",
      "transliteration": "ture usat maaiaa mahi bhelaa ||",
      "translation": "Horses and camels are absorbed in Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਿਧ ਚਉਰਾਸੀਹ ਮਾਇਆ ਮਹਿ ਖੇਲਾ ॥੨॥",
      "transliteration": "sidh chauraaseeh maaiaa mahi khelaa ||2||",
      "translation": "The eighty-four Siddhas, the beings of miraculous spiritual powers, play in Maya. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਛਿਅ ਜਤੀ ਮਾਇਆ ਕੇ ਬੰਦਾ ॥",
      "transliteration": "chhi jatee maaiaa ke ba(n)daa ||",
      "translation": "The six celibates are slaves of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਵੈ ਨਾਥ ਸੂਰਜ ਅਰੁ ਚੰਦਾ ॥",
      "transliteration": "navai naath sooraj ar cha(n)daa ||",
      "translation": "So are the nine masters of Yoga, and the sun and the moon.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਤਪੇ ਰਖੀਸਰ ਮਾਇਆ ਮਹਿ ਸੂਤਾ ॥",
      "transliteration": "tape rakheesar maaiaa mahi sootaa ||",
      "translation": "The austere disciplinarians and the Rishis are asleep in Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਾਇਆ ਮਹਿ ਕਾਲੁ ਅਰੁ ਪੰਚ ਦੂਤਾ ॥੩॥",
      "transliteration": "maaiaa mahi kaal ar pa(n)ch dootaa ||3||",
      "translation": "Death and the five demons are in Maya. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੁਆਨ ਸਿਆਲ ਮਾਇਆ ਮਹਿ ਰਾਤਾ ॥",
      "transliteration": "suaan siaal maaiaa mahi raataa ||",
      "translation": "Dogs and jackals are imbued with Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬੰਤਰ ਚੀਤੇ ਅਰੁ ਸਿੰਘਾਤਾ ॥",
      "transliteration": "ba(n)tar cheete ar si(n)ghaataa ||",
      "translation": "Monkeys, leopards and lions,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਮਾਂਜਾਰ ਗਾਡਰ ਅਰੁ ਲੂਬਰਾ ॥",
      "transliteration": "maa(n)jaar gaadar ar loobaraa ||",
      "translation": "cats, sheep, foxes,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬਿਰਖ ਮੂਲ ਮਾਇਆ ਮਹਿ ਪਰਾ ॥੪॥",
      "transliteration": "birakh mool maaiaa mahi paraa ||4||",
      "translation": "trees and roots are planted in Maya. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਾਇਆ ਅੰਤਰਿ ਭੀਨੇ ਦੇਵ ॥",
      "transliteration": "maaiaa a(n)tar bheene dev ||",
      "translation": "Even the gods are drenched with Maya,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਾਗਰ ਇੰਦ੍ਰਾ ਅਰੁ ਧਰਤੇਵ ॥",
      "transliteration": "saagar i(n)draa ar dharatev ||",
      "translation": "as are the oceans, the sky and the earth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਜਿਸੁ ਉਦਰੁ ਤਿਸੁ ਮਾਇਆ ॥",
      "transliteration": "kahi kabeer jis udar tis maaiaa ||",
      "translation": "Says Kabeer, whoever has a belly to fill, is under the spell of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਤਬ ਛੂਟੇ ਜਬ ਸਾਧੂ ਪਾਇਆ ॥੫॥੫॥੧੩॥",
      "transliteration": "tab chhoote jab saadhoo paaiaa ||5||5||13||",
      "translation": "The mortal is emancipated only when he meets the Holy Saint. ||5||5||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਜਬ ਲਗੁ ਮੇਰੀ ਮੇਰੀ ਕਰੈ ॥",
      "transliteration": "jab lag meree meree karai ||",
      "translation": "As long as he cries out, Mine! Mine!,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਤਬ ਲਗੁ ਕਾਜੁ ਏਕੁ ਨਹੀ ਸਰੈ ॥",
      "transliteration": "tab lag kaaj ek nahee sarai ||",
      "translation": "none of his tasks is accomplished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1160_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਬ ਮੇਰੀ ਮੇਰੀ ਮਿਟਿ ਜਾਇ ॥",
      "transliteration": "jab meree meree mit jaai ||",
      "translation": "When such possessiveness is erased and removed,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1160,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
