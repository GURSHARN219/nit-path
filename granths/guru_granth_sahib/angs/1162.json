{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1162,
  "lineCount": 53,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1162_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਭਗਵਤ ਭੀਰਿ ਸਕਤਿ ਸਿਮਰਨ ਕੀ ਕਟੀ ਕਾਲ ਭੈ ਫਾਸੀ ॥",
      "transliteration": "bhagavat bheer sakat simaran kee katee kaal bhai phaasee ||",
      "translation": "With the army of God's devotees, and Shakti, the power of meditation, I have snapped the noose of the fear of death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦਾਸੁ ਕਮੀਰੁ ਚੜੑਿਓ ਗੜੑ ਊਪਰਿ ਰਾਜੁ ਲੀਓ ਅਬਿਨਾਸੀ ॥੬॥੯॥੧੭॥",
      "transliteration": "daas kameer chaRhio gaRh oopar raaj leeo abinaasee ||6||9||17||",
      "translation": "Slave Kabeer has climbed to the top of the fortress; I have obtained the eternal, imperishable domain. ||6||9||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੰਗ ਗੁਸਾਇਨਿ ਗਹਿਰ ਗੰਭੀਰ ॥",
      "transliteration": "ga(n)g gusaain gahir ga(n)bheer ||",
      "translation": "The mother Ganges is deep and profound.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੰਜੀਰ ਬਾਂਧਿ ਕਰਿ ਖਰੇ ਕਬੀਰ ॥੧॥",
      "transliteration": "ja(n)jeer baa(n)dh kar khare kabeer ||1||",
      "translation": "Tied up in chains, they took Kabeer there. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਨੁ ਨ ਡਿਗੈ ਤਨੁ ਕਾਹੇ ਕਉ ਡਰਾਇ ॥",
      "transliteration": "man na digai tan kaahe kau daraai ||",
      "translation": "My mind was not shaken; why should my body be afraid?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਚਿਤੁ ਰਹਿਓ ਸਮਾਇ ॥ ਰਹਾਉ ॥",
      "transliteration": "charan kamal chit rahio samaai || rahaau ||",
      "translation": "My consciousness remained immersed in the Lotus Feet of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੰਗਾ ਕੀ ਲਹਰਿ ਮੇਰੀ ਟੁਟੀ ਜੰਜੀਰ ॥",
      "transliteration": "ga(n)gaa kee lahar meree tutee ja(n)jeer ||",
      "translation": "The waves of the Ganges broke the chains,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮ੍ਰਿਗਛਾਲਾ ਪਰ ਬੈਠੇ ਕਬੀਰ ॥੨॥",
      "transliteration": "mrigachhaalaa par baithe kabeer ||2||",
      "translation": "and Kabeer was seated on a deer skin. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕਹਿ ਕੰਬੀਰ ਕੋਊ ਸੰਗ ਨ ਸਾਥ ॥",
      "transliteration": "kahi ka(n)beer kooo sa(n)g na saath ||",
      "translation": "Says Kabeer, I have no friend or companion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਲ ਥਲ ਰਾਖਨ ਹੈ ਰਘੁਨਾਥ ॥੩॥੧੦॥੧੮॥",
      "transliteration": "jal thal raakhan hai raghunaath ||3||10||18||",
      "translation": "On the water, and on the land, the Lord is my Protector. ||3||10||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਭੈਰਉ ਕਬੀਰ ਜੀਉ ਅਸਟਪਦੀ ਘਰੁ ੨ ॥",
      "transliteration": "bhairau kabeer jeeu asatapadee ghar 2 ||",
      "translation": "Bhairao, Kabeer Jee, Ashtpadheeyaa, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਗਮ ਦ੍ਰੁਗਮ ਗੜਿ ਰਚਿਓ ਬਾਸ ॥",
      "transliteration": "agam drugam gaR rachio baas ||",
      "translation": "God constructed a fortress, inaccessible and unreachable, in which He dwells.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾ ਮਹਿ ਜੋਤਿ ਕਰੇ ਪਰਗਾਸ ॥",
      "transliteration": "jaa mahi jot kare paragaas ||",
      "translation": "There, His Divine Light radiates forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਿਜੁਲੀ ਚਮਕੈ ਹੋਇ ਅਨੰਦੁ ॥",
      "transliteration": "bijulee chamakai hoi ana(n)d ||",
      "translation": "Lightning blazes, and bliss prevails there,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਿਹ ਪਉੜੑੇ ਪ੍ਰਭ ਬਾਲ ਗੋਬਿੰਦ ॥੧॥",
      "transliteration": "jih pauRhe prabh baal gobi(n)d ||1||",
      "translation": "where the Eternally Young Lord God abides. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਹੁ ਜੀਉ ਰਾਮ ਨਾਮ ਲਿਵ ਲਾਗੈ ॥",
      "transliteration": "ihu jeeu raam naam liv laagai ||",
      "translation": "This soul is lovingly attuned to the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਰਾ ਮਰਨੁ ਛੂਟੈ ਭ੍ਰਮੁ ਭਾਗੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaraa maran chhootai bhram bhaagai ||1|| rahaau ||",
      "translation": "It is saved from old age and death, and its doubt runs away. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਬਰਨ ਬਰਨ ਸਿਉ ਮਨ ਹੀ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "abaran baran siu man hee preet ||",
      "translation": "Those who believe in high and low social classes,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਹਉਮੈ ਗਾਵਨਿ ਗਾਵਹਿ ਗੀਤ ॥",
      "transliteration": "haumai gaavan gaavahi geet ||",
      "translation": "only sing songs and chants of egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਨਹਦ ਸਬਦ ਹੋਤ ਝੁਨਕਾਰ ॥",
      "transliteration": "anahad sabad hot jhunakaar ||",
      "translation": "The Unstruck Sound-current of the Shabad, the Word of God, resounds in that place,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਹ ਪਉੜੑੇ ਪ੍ਰਭ ਸ੍ਰੀ ਗੋਪਾਲ ॥੨॥",
      "transliteration": "jih pauRhe prabh sree gopaal ||2||",
      "translation": "where the Supreme Lord God abides. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਖੰਡਲ ਮੰਡਲ ਮੰਡਲ ਮੰਡਾ ॥",
      "transliteration": "kha(n)dal ma(n)dal ma(n)dal ma(n)daa ||",
      "translation": "He creates planets, solar systems and galaxies;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤ੍ਰਿਅ ਅਸਥਾਨ ਤੀਨਿ ਤ੍ਰਿਅ ਖੰਡਾ ॥",
      "transliteration": "tri asathaan teen tri kha(n)daa ||",
      "translation": "He destroys the three worlds, the three gods and the three qualities.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਗਮ ਅਗੋਚਰੁ ਰਹਿਆ ਅਭ ਅੰਤ ॥",
      "transliteration": "agam agochar rahiaa abh a(n)t ||",
      "translation": "The Inaccessible and Unfathomable Lord God dwells in the heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਾਰੁ ਨ ਪਾਵੈ ਕੋ ਧਰਨੀਧਰ ਮੰਤ ॥੩॥",
      "transliteration": "paar na paavai ko dharaneedhar ma(n)t ||3||",
      "translation": "No one can find the limits or the secrets of the Lord of the World. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਦਲੀ ਪੁਹਪ ਧੂਪ ਪਰਗਾਸ ॥",
      "transliteration": "kadalee puhap dhoop paragaas ||",
      "translation": "The Lord shines forth in the plantain flower and the sunshine.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਰਜ ਪੰਕਜ ਮਹਿ ਲੀਓ ਨਿਵਾਸ ॥",
      "transliteration": "raj pa(n)kaj mahi leeo nivaas ||",
      "translation": "He dwells in the pollen of the lotus flower.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੁਆਦਸ ਦਲ ਅਭ ਅੰਤਰਿ ਮੰਤ ॥",
      "transliteration": "duaadas dal abh a(n)tar ma(n)t ||",
      "translation": "The Lord's secret is within the twelve petals of the heart-lotus.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਹ ਪਉੜੇ ਸ੍ਰੀ ਕਮਲਾ ਕੰਤ ॥੪॥",
      "transliteration": "jah pauRe sree kamalaa ka(n)t ||4||",
      "translation": "The Supreme Lord, the Lord of Lakshmi dwells there. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਰਧ ਉਰਧ ਮੁਖਿ ਲਾਗੋ ਕਾਸੁ ॥",
      "transliteration": "aradh uradh mukh laago kaas ||",
      "translation": "He is like the sky, stretching across the lower, upper and middle realms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸੁੰਨ ਮੰਡਲ ਮਹਿ ਕਰਿ ਪਰਗਾਸੁ ॥",
      "transliteration": "su(n)n ma(n)dal mahi kar paragaas ||",
      "translation": "In the profoundly silent celestial realm, He radiates forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਊਹਾਂ ਸੂਰਜ ਨਾਹੀ ਚੰਦ ॥",
      "transliteration": "oohaa(n) sooraj naahee cha(n)d ||",
      "translation": "Neither the sun nor the moon are there,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਦਿ ਨਿਰੰਜਨੁ ਕਰੈ ਅਨੰਦ ॥੫॥",
      "transliteration": "aad nira(n)jan karai ana(n)d ||5||",
      "translation": "but the Primal Immaculate Lord celebrates there. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੋ ਬ੍ਰਹਮੰਡਿ ਪਿੰਡਿ ਸੋ ਜਾਨੁ ॥",
      "transliteration": "so brahama(n)d pi(n)d so jaan ||",
      "translation": "Know that He is in the universe, and in the body as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਮਾਨ ਸਰੋਵਰਿ ਕਰਿ ਇਸਨਾਨੁ ॥",
      "transliteration": "maan sarovar kar isanaan ||",
      "translation": "Take your cleansing bath in the Mansarovar Lake.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੋਹੰ ਸੋ ਜਾ ਕਉ ਹੈ ਜਾਪ ॥",
      "transliteration": "soha(n) so jaa kau hai jaap ||",
      "translation": "Chant \"Sohang\" - \"He is me.\"",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਾ ਕਉ ਲਿਪਤ ਨ ਹੋਇ ਪੁੰਨ ਅਰੁ ਪਾਪ ॥੬॥",
      "transliteration": "jaa kau lipat na hoi pu(n)n ar paap ||6||",
      "translation": "He is not affected by either virtue or vice. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਬਰਨ ਬਰਨ ਘਾਮ ਨਹੀ ਛਾਮ ॥",
      "transliteration": "abaran baran ghaam nahee chhaam ||",
      "translation": "He is not affected by either high or low social class, sunshine or shade.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਵਰ ਨ ਪਾਈਐ ਗੁਰ ਕੀ ਸਾਮ ॥",
      "transliteration": "avar na paaeeai gur kee saam ||",
      "translation": "He is in the Guru's Sanctuary, and nowhere else.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਟਾਰੀ ਨ ਟਰੈ ਆਵੈ ਨ ਜਾਇ ॥",
      "transliteration": "taaree na tarai aavai na jaai ||",
      "translation": "He is not diverted by diversions, comings or goings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੁੰਨ ਸਹਜ ਮਹਿ ਰਹਿਓ ਸਮਾਇ ॥੭॥",
      "transliteration": "su(n)n sahaj mahi rahio samaai ||7||",
      "translation": "Remain intuitively absorbed in the celestial void. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮਨ ਮਧੇ ਜਾਨੈ ਜੇ ਕੋਇ ॥",
      "transliteration": "man madhe jaanai je koi ||",
      "translation": "One who knows the Lord in the mind",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜੋ ਬੋਲੈ ਸੋ ਆਪੈ ਹੋਇ ॥",
      "transliteration": "jo bolai so aapai hoi ||",
      "translation": "whatever he says, comes to pass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੋਤਿ ਮੰਤ੍ਰਿ ਮਨਿ ਅਸਥਿਰੁ ਕਰੈ ॥",
      "transliteration": "jot ma(n)tr man asathir karai ||",
      "translation": "One who firmly implants the Lord's Divine Light, and His Mantra within the mind",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਸੋ ਪ੍ਰਾਨੀ ਤਰੈ ॥੮॥੧॥",
      "transliteration": "kahi kabeer so praanee tarai ||8||1||",
      "translation": "- says Kabeer, such a mortal crosses over to the other side. ||8||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਕੋਟਿ ਸੂਰ ਜਾ ਕੈ ਪਰਗਾਸ ॥",
      "transliteration": "kot soor jaa kai paragaas ||",
      "translation": "Millions of suns shine for Him,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੋਟਿ ਮਹਾਦੇਵ ਅਰੁ ਕਬਿਲਾਸ ॥",
      "transliteration": "kot mahaadev ar kabilaas ||",
      "translation": "millions of Shivas and Kailash mountains.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਦੁਰਗਾ ਕੋਟਿ ਜਾ ਕੈ ਮਰਦਨੁ ਕਰੈ ॥",
      "transliteration": "duragaa kot jaa kai maradan karai ||",
      "translation": "Millions of Durga goddesses massage His Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬ੍ਰਹਮਾ ਕੋਟਿ ਬੇਦ ਉਚਰੈ ॥੧॥",
      "transliteration": "brahamaa kot bed ucharai ||1||",
      "translation": "Millions of Brahmas chant the Vedas for Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਉ ਜਾਚਉ ਤਉ ਕੇਵਲ ਰਾਮ ॥",
      "transliteration": "jau jaachau tau keval raam ||",
      "translation": "When I beg, I beg only from the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਆਨ ਦੇਵ ਸਿਉ ਨਾਹੀ ਕਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aan dev siu naahee kaam ||1|| rahaau ||",
      "translation": "I have nothing to do with any other deities. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1162_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਕੋਟਿ ਚੰਦ੍ਰਮੇ ਕਰਹਿ ਚਰਾਕ ॥",
      "transliteration": "kot cha(n)drame karahi charaak ||",
      "translation": "Millions of moons twinkle in the sky.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1162,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
