{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1163,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1163_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੁਰ ਤੇਤੀਸਉ ਜੇਵਹਿ ਪਾਕ ॥",
      "transliteration": "sur teteesau jevahi paak ||",
      "translation": "Three hundred thirty million gods eat the Lord's offerings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਵ ਗ੍ਰਹ ਕੋਟਿ ਠਾਢੇ ਦਰਬਾਰ ॥",
      "transliteration": "nav grah kot thaadhe darabaar ||",
      "translation": "The nine stars, a million times over, stand at His Door.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਧਰਮ ਕੋਟਿ ਜਾ ਕੈ ਪ੍ਰਤਿਹਾਰ ॥੨॥",
      "transliteration": "dharam kot jaa kai pratihaar ||2||",
      "translation": "Millions of Righteous Judges of Dharma are His gate-keepers. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਵਨ ਕੋਟਿ ਚਉਬਾਰੇ ਫਿਰਹਿ ॥",
      "transliteration": "pavan kot chaubaare phirahi ||",
      "translation": "Millions of winds blow around Him in the four directions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਾਸਕ ਕੋਟਿ ਸੇਜ ਬਿਸਥਰਹਿ ॥",
      "transliteration": "baasak kot sej bisatharahi ||",
      "translation": "Millions of serpents prepare His bed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਮੁੰਦ ਕੋਟਿ ਜਾ ਕੇ ਪਾਨੀਹਾਰ ॥",
      "transliteration": "samu(n)d kot jaa ke paaneehaar ||",
      "translation": "Millions of oceans are His water-carriers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰੋਮਾਵਲਿ ਕੋਟਿ ਅਠਾਰਹ ਭਾਰ ॥੩॥",
      "transliteration": "romaaval kot athaarah bhaar ||3||",
      "translation": "The eighteen million loads of vegetation are His Hair. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕੋਟਿ ਕਮੇਰ ਭਰਹਿ ਭੰਡਾਰ ॥",
      "transliteration": "kot kamer bharahi bha(n)daar ||",
      "translation": "Millions of treasurers fill His Treasury.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਕੋਟਿਕ ਲਖਿਮੀ ਕਰੈ ਸੀਗਾਰ ॥",
      "transliteration": "kotik lakhimee karai seegaar ||",
      "translation": "Millions of Lakshmis adorn themselves for Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕੋਟਿਕ ਪਾਪ ਪੁੰਨ ਬਹੁ ਹਿਰਹਿ ॥",
      "transliteration": "kotik paap pu(n)n bahu hirahi ||",
      "translation": "Many millions of vices and virtues look up to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਇੰਦ੍ਰ ਕੋਟਿ ਜਾ ਕੇ ਸੇਵਾ ਕਰਹਿ ॥੪॥",
      "transliteration": "i(n)dr kot jaa ke sevaa karahi ||4||",
      "translation": "Millions of Indras serve Him. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਛਪਨ ਕੋਟਿ ਜਾ ਕੈ ਪ੍ਰਤਿਹਾਰ ॥",
      "transliteration": "chhapan kot jaa kai pratihaar ||",
      "translation": "Fifty-six million clouds are His.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਗਰੀ ਨਗਰੀ ਖਿਅਤ ਅਪਾਰ ॥",
      "transliteration": "nagaree nagaree khiat apaar ||",
      "translation": "In each and every village, His infinite fame has spread.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਲਟ ਛੂਟੀ ਵਰਤੈ ਬਿਕਰਾਲ ॥",
      "transliteration": "lat chhootee varatai bikaraal ||",
      "translation": "Wild demons with dishevelled hair move about.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕੋਟਿ ਕਲਾ ਖੇਲੈ ਗੋਪਾਲ ॥੫॥",
      "transliteration": "kot kalaa khelai gopaal ||5||",
      "translation": "The Lord plays in countless ways. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕੋਟਿ ਜਗ ਜਾ ਕੈ ਦਰਬਾਰ ॥",
      "transliteration": "kot jag jaa kai darabaar ||",
      "translation": "Millions of charitable feasts are held in His Court,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੰਧ੍ਰਬ ਕੋਟਿ ਕਰਹਿ ਜੈਕਾਰ ॥",
      "transliteration": "ga(n)dhrab kot karahi jaikaar ||",
      "translation": "and millions of celestial singers celebrate His victory.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਿਦਿਆ ਕੋਟਿ ਸਭੈ ਗੁਨ ਕਹੈ ॥",
      "transliteration": "bidiaa kot sabhai gun kahai ||",
      "translation": "Millions of sciences all sing His Praises.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਊ ਪਾਰਬ੍ਰਹਮ ਕਾ ਅੰਤੁ ਨ ਲਹੈ ॥੬॥",
      "transliteration": "taoo paarabraham kaa a(n)t na lahai ||6||",
      "translation": "Even so, the limits of the Supreme Lord God cannot be found. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਾਵਨ ਕੋਟਿ ਜਾ ਕੈ ਰੋਮਾਵਲੀ ॥",
      "transliteration": "baavan kot jaa kai romaavalee ||",
      "translation": "Rama, with millions of monkeys,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਰਾਵਨ ਸੈਨਾ ਜਹ ਤੇ ਛਲੀ ॥",
      "transliteration": "raavan sainaa jah te chhalee ||",
      "translation": "Conquered Raawan's army.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਹਸ ਕੋਟਿ ਬਹੁ ਕਹਤ ਪੁਰਾਨ ॥",
      "transliteration": "sahas kot bahu kahat puraan ||",
      "translation": "Billions of Puraanas greatly praise Him;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਦੁਰਜੋਧਨ ਕਾ ਮਥਿਆ ਮਾਨੁ ॥੭॥",
      "transliteration": "durajodhan kaa mathiaa maan ||7||",
      "translation": "He humbled the pride of Duyodhan. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕੰਦ੍ਰਪ ਕੋਟਿ ਜਾ ਕੈ ਲਵੈ ਨ ਧਰਹਿ ॥",
      "transliteration": "ka(n)drap kot jaa kai lavai na dharahi ||",
      "translation": "Millions of gods of love cannot compete with Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅੰਤਰ ਅੰਤਰਿ ਮਨਸਾ ਹਰਹਿ ॥",
      "transliteration": "a(n)tar a(n)tar manasaa harahi ||",
      "translation": "He steals the hearts of mortal beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਸੁਨਿ ਸਾਰਿਗਪਾਨ ॥",
      "transliteration": "kahi kabeer sun saarigapaan ||",
      "translation": "Says Kabeer, please hear me, O Lord of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੇਹਿ ਅਭੈ ਪਦੁ ਮਾਂਗਉ ਦਾਨ ॥੮॥੨॥੧੮॥੨੦॥",
      "transliteration": "dehi abhai pad maa(n)gau daan ||8||2||18||20||",
      "translation": "I beg for the blessing of fearless dignity. ||8||2||18||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭੈਰਉ ਬਾਣੀ ਨਾਮਦੇਉ ਜੀਉ ਕੀ ਘਰੁ ੧ ॥",
      "transliteration": "bhairau baanee naamadeu jeeu kee ghar 1 ||",
      "translation": "Bhairao, The Word Of Naam Dayv Jee, First House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰੇ ਜਿਹਬਾ ਕਰਉ ਸਤ ਖੰਡ ॥",
      "transliteration": "re jihabaa karau sat kha(n)d ||",
      "translation": "O my tongue, I will cut you into a hundred pieces,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾਮਿ ਨ ਉਚਰਸਿ ਸ੍ਰੀ ਗੋਬਿੰਦ ॥੧॥",
      "transliteration": "jaam na ucharas sree gobi(n)d ||1||",
      "translation": "if you do not chant the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਰੰਗੀ ਲੇ ਜਿਹਬਾ ਹਰਿ ਕੈ ਨਾਇ ॥",
      "transliteration": "ra(n)gee le jihabaa har kai naai ||",
      "translation": "O my tongue, be imbued with the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸੁਰੰਗ ਰੰਗੀਲੇ ਹਰਿ ਹਰਿ ਧਿਆਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sura(n)g ra(n)geele har har dhiaai ||1|| rahaau ||",
      "translation": "Meditate on the Name of the Lord, Har, Har, and imbue yourself with this most excellent color. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਿਥਿਆ ਜਿਹਬਾ ਅਵਰੇਂ ਕਾਮ ॥",
      "transliteration": "mithiaa jihabaa avare(n) kaam ||",
      "translation": "O my tongue, other occupations are false.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਿਰਬਾਣ ਪਦੁ ਇਕੁ ਹਰਿ ਕੋ ਨਾਮੁ ॥੨॥",
      "transliteration": "nirabaan pad ik har ko naam ||2||",
      "translation": "The state of Nirvaanaa comes only through the Lord's Name. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਅਸੰਖ ਕੋਟਿ ਅਨ ਪੂਜਾ ਕਰੀ ॥",
      "transliteration": "asa(n)kh kot an poojaa karee ||",
      "translation": "The performance of countless millions of other devotions",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਏਕ ਨ ਪੂਜਸਿ ਨਾਮੈ ਹਰੀ ॥੩॥",
      "transliteration": "ek na poojas naamai haree ||3||",
      "translation": "is not equal to even one devotion to the Name of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਣਵੈ ਨਾਮਦੇਉ ਇਹੁ ਕਰਣਾ ॥",
      "transliteration": "pranavai naamadeu ihu karanaa ||",
      "translation": "Prays Naam Dayv, this is my occupation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਨੰਤ ਰੂਪ ਤੇਰੇ ਨਾਰਾਇਣਾ ॥੪॥੧॥",
      "transliteration": "ana(n)t roop tere naaraainaa ||4||1||",
      "translation": "O Lord, Your Forms are endless. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਰ ਧਨ ਪਰ ਦਾਰਾ ਪਰਹਰੀ ॥",
      "transliteration": "par dhan par daaraa paraharee ||",
      "translation": "One who stays away from others' wealth and others' spouses",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਾ ਕੈ ਨਿਕਟਿ ਬਸੈ ਨਰਹਰੀ ॥੧॥",
      "transliteration": "taa kai nikat basai naraharee ||1||",
      "translation": "- the Lord abides near that person. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੋ ਨ ਭਜੰਤੇ ਨਾਰਾਇਣਾ ॥",
      "transliteration": "jo na bhaja(n)te naaraainaa ||",
      "translation": "Those who do not meditate and vibrate on the Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਿਨ ਕਾ ਮੈ ਨ ਕਰਉ ਦਰਸਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tin kaa mai na karau darasanaa ||1|| rahaau ||",
      "translation": "- I do not even want to see them. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਨ ਕੈ ਭੀਤਰਿ ਹੈ ਅੰਤਰਾ ॥",
      "transliteration": "jin kai bheetar hai a(n)taraa ||",
      "translation": "Those whose inner beings are not in harmony with the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜੈਸੇ ਪਸੁ ਤੈਸੇ ਓਇ ਨਰਾ ॥੨॥",
      "transliteration": "jaise pas taise oi naraa ||2||",
      "translation": "are nothing more than beasts. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪ੍ਰਣਵਤਿ ਨਾਮਦੇਉ ਨਾਕਹਿ ਬਿਨਾ ॥",
      "transliteration": "pranavat naamadeu naakahi binaa ||",
      "translation": "Prays Naam Dayv, a man without a nose",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾ ਸੋਹੈ ਬਤੀਸ ਲਖਨਾ ॥੩॥੨॥",
      "transliteration": "naa sohai batees lakhanaa ||3||2||",
      "translation": "does not look handsome, even if he has the thirty-two beauty marks. ||3||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਦੂਧੁ ਕਟੋਰੈ ਗਡਵੈ ਪਾਨੀ ॥",
      "transliteration": "doodh katorai gadavai paanee ||",
      "translation": "Naam Dayv milked the brown cow,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਪਲ ਗਾਇ ਨਾਮੈ ਦੁਹਿ ਆਨੀ ॥੧॥",
      "transliteration": "kapal gaai naamai duhi aanee ||1||",
      "translation": "And brought a cup of milk and a jug of water to his family god. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਦੂਧੁ ਪੀਉ ਗੋਬਿੰਦੇ ਰਾਇ ॥",
      "transliteration": "doodh peeu gobi(n)de raai ||",
      "translation": "\"Please drink this milk, O my Sovereign Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਦੂਧੁ ਪੀਉ ਮੇਰੋ ਮਨੁ ਪਤੀਆਇ ॥",
      "transliteration": "doodh peeu mero man pateeaai ||",
      "translation": "Drink this milk and my mind will be happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾਹੀ ਤ ਘਰ ਕੋ ਬਾਪੁ ਰਿਸਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naahee ta ghar ko baap risaai ||1|| rahaau ||",
      "translation": "Otherwise, my father will be angry with me.\" ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੋੁਇਨ ਕਟੋਰੀ ਅੰਮ੍ਰਿਤ ਭਰੀ ॥",
      "transliteration": "souin katoree a(n)mrit bharee ||",
      "translation": "Taking the golden cup, Naam Dayv filled it with the ambrosial milk,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਲੈ ਨਾਮੈ ਹਰਿ ਆਗੈ ਧਰੀ ॥੨॥",
      "transliteration": "lai naamai har aagai dharee ||2||",
      "translation": "and placed it before the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਏਕੁ ਭਗਤੁ ਮੇਰੇ ਹਿਰਦੇ ਬਸੈ ॥",
      "transliteration": "ek bhagat mere hirade basai ||",
      "translation": "The Lord looked upon Naam Dayv and smiled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਮੇ ਦੇਖਿ ਨਰਾਇਨੁ ਹਸੈ ॥੩॥",
      "transliteration": "naame dekh naraain hasai ||3||",
      "translation": "\"This one devotee abides within my heart.\" ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1163_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਦੂਧੁ ਪੀਆਇ ਭਗਤੁ ਘਰਿ ਗਇਆ ॥",
      "transliteration": "doodh peeaai bhagat ghar gaiaa ||",
      "translation": "The Lord drank the milk, and the devotee returned home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1163,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
