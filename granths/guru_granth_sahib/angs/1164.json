{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1164,
  "lineCount": 51,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1164_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਮੇ ਹਰਿ ਕਾ ਦਰਸਨੁ ਭਇਆ ॥੪॥੩॥",
      "transliteration": "naame har kaa darasan bhaiaa ||4||3||",
      "translation": "Thus did Naam Dayv come to receive the Blessed Vision of the Lord's Darshan. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮੈ ਬਉਰੀ ਮੇਰਾ ਰਾਮੁ ਭਤਾਰੁ ॥",
      "transliteration": "mai bauree meraa raam bhataar ||",
      "translation": "I am crazy - the Lord is my Husband.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਰਚਿ ਰਚਿ ਤਾ ਕਉ ਕਰਉ ਸਿੰਗਾਰੁ ॥੧॥",
      "transliteration": "rach rach taa kau karau si(n)gaar ||1||",
      "translation": "I decorate and adorn myself for Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਭਲੇ ਨਿੰਦਉ ਭਲੇ ਨਿੰਦਉ ਭਲੇ ਨਿੰਦਉ ਲੋਗੁ ॥",
      "transliteration": "bhale ni(n)dau bhale ni(n)dau bhale ni(n)dau log ||",
      "translation": "Slander me well, slander me well, slander me well, O people.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਰਾਮ ਪਿਆਰੇ ਜੋਗੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tan man raam piaare jog ||1|| rahaau ||",
      "translation": "My body and mind are united with my Beloved Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਾਦੁ ਬਿਬਾਦੁ ਕਾਹੂ ਸਿਉ ਨ ਕੀਜੈ ॥",
      "transliteration": "baad bibaad kaahoo siu na keejai ||",
      "translation": "Do not engage in any arguments or debates with anyone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਰਸਨਾ ਰਾਮ ਰਸਾਇਨੁ ਪੀਜੈ ॥੨॥",
      "transliteration": "rasanaa raam rasaain peejai ||2||",
      "translation": "With your tongue, savor the Lord's sublime essence. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਬ ਜੀਅ ਜਾਨਿ ਐਸੀ ਬਨਿ ਆਈ ॥",
      "transliteration": "ab jee jaan aisee ban aaee ||",
      "translation": "Now, I know within my soul, that such an arrangement has been made;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਿਲਉ ਗੁਪਾਲ ਨੀਸਾਨੁ ਬਜਾਈ ॥੩॥",
      "transliteration": "milau gupaal neesaan bajaaee ||3||",
      "translation": "I will meet with my Lord by the beat of the drum. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਉਸਤਤਿ ਨਿੰਦਾ ਕਰੈ ਨਰੁ ਕੋਈ ॥",
      "transliteration": "usatat ni(n)daa karai nar koee ||",
      "translation": "Anyone can praise or slander me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਮੇ ਸ੍ਰੀਰੰਗੁ ਭੇਟਲ ਸੋਈ ॥੪॥੪॥",
      "transliteration": "naame sreera(n)g bhetal soee ||4||4||",
      "translation": "Naam Dayv has met the Lord. ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਬਹੂ ਖੀਰਿ ਖਾਡ ਘੀਉ ਨ ਭਾਵੈ ॥",
      "transliteration": "kabahoo kheer khaad gheeu na bhaavai ||",
      "translation": "Sometimes, people do not appreciate milk, sugar and ghee.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਬਹੂ ਘਰ ਘਰ ਟੂਕ ਮਗਾਵੈ ॥",
      "transliteration": "kabahoo ghar ghar took magaavai ||",
      "translation": "Sometimes, they have to beg for bread from door to door.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਬਹੂ ਕੂਰਨੁ ਚਨੇ ਬਿਨਾਵੈ ॥੧॥",
      "transliteration": "kabahoo kooran chane binaavai ||1||",
      "translation": "Sometimes, they have to pick out the grain from the chaff. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਉ ਰਾਮੁ ਰਾਖੈ ਤਿਉ ਰਹੀਐ ਰੇ ਭਾਈ ॥",
      "transliteration": "jiu raam raakhai tiu raheeai re bhaaee ||",
      "translation": "As the Lord keeps us, so do we live, O Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਰਿ ਕੀ ਮਹਿਮਾ ਕਿਛੁ ਕਥਨੁ ਨ ਜਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har kee mahimaa kichh kathan na jaaee ||1|| rahaau ||",
      "translation": "The Lord's Glory cannot even be described. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਬਹੂ ਤੁਰੇ ਤੁਰੰਗ ਨਚਾਵੈ ॥",
      "transliteration": "kabahoo ture tura(n)g nachaavai ||",
      "translation": "Sometimes, people prance around on horses.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਬਹੂ ਪਾਇ ਪਨਹੀਓ ਨ ਪਾਵੈ ॥੨॥",
      "transliteration": "kabahoo paai panaheeo na paavai ||2||",
      "translation": "Sometimes, they do not even have shoes for their feet. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਬਹੂ ਖਾਟ ਸੁਪੇਦੀ ਸੁਵਾਵੈ ॥",
      "transliteration": "kabahoo khaat supedee suvaavai ||",
      "translation": "Sometimes, people sleep on cozy beds with white sheets.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਬਹੂ ਭੂਮਿ ਪੈਆਰੁ ਨ ਪਾਵੈ ॥੩॥",
      "transliteration": "kabahoo bhoom paiaar na paavai ||3||",
      "translation": "Sometimes, they do not even have straw to put down on the ground. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਭਨਤਿ ਨਾਮਦੇਉ ਇਕੁ ਨਾਮੁ ਨਿਸਤਾਰੈ ॥",
      "transliteration": "bhanat naamadeu ik naam nisataarai ||",
      "translation": "Naam Dayv prays, only the Naam, the Name of the Lord, can save us.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਹ ਗੁਰੁ ਮਿਲੈ ਤਿਹ ਪਾਰਿ ਉਤਾਰੈ ॥੪॥੫॥",
      "transliteration": "jih gur milai tih paar utaarai ||4||5||",
      "translation": "One who meets the Guru, is carried across to the other side. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਹਸਤ ਖੇਲਤ ਤੇਰੇ ਦੇਹੁਰੇ ਆਇਆ ॥",
      "transliteration": "hasat khelat tere dehure aaiaa ||",
      "translation": "Laughing and playing, I came to Your Temple, O Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਗਤਿ ਕਰਤ ਨਾਮਾ ਪਕਰਿ ਉਠਾਇਆ ॥੧॥",
      "transliteration": "bhagat karat naamaa pakar uthaaiaa ||1||",
      "translation": "While Naam Dayv was worshipping, he was grabbed and driven out. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਹੀਨੜੀ ਜਾਤਿ ਮੇਰੀ ਜਾਦਿਮ ਰਾਇਆ ॥",
      "transliteration": "heenaRee jaat meree jaadim raaiaa ||",
      "translation": "I am of a low social class, O Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਛੀਪੇ ਕੇ ਜਨਮਿ ਕਾਹੇ ਕਉ ਆਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "chheepe ke janam kaahe kau aaiaa ||1|| rahaau ||",
      "translation": "why was I born into a family of fabric dyers? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਲੈ ਕਮਲੀ ਚਲਿਓ ਪਲਟਾਇ ॥",
      "transliteration": "lai kamalee chalio palataai ||",
      "translation": "I picked up my blanket and went back,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਦੇਹੁਰੈ ਪਾਛੈ ਬੈਠਾ ਜਾਇ ॥੨॥",
      "transliteration": "dehurai paachhai baithaa jaai ||2||",
      "translation": "to sit behind the temple. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਉ ਜਿਉ ਨਾਮਾ ਹਰਿ ਗੁਣ ਉਚਰੈ ॥",
      "transliteration": "jiu jiu naamaa har gun ucharai ||",
      "translation": "As Naam Dayv uttered the Glorious Praises of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਭਗਤ ਜਨਾਂ ਕਉ ਦੇਹੁਰਾ ਫਿਰੈ ॥੩॥੬॥",
      "transliteration": "bhagat janaa(n) kau dehuraa phirai ||3||6||",
      "translation": "the temple turned around to face the Lord's humble devotee. ||3||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭੈਰਉ ਨਾਮਦੇਉ ਜੀਉ ਘਰੁ ੨ ॥",
      "transliteration": "bhairau naamadeu jeeu ghar 2 ||",
      "translation": "Bhairao, Naam Dayv Jee, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜੈਸੀ ਭੂਖੇ ਪ੍ਰੀਤਿ ਅਨਾਜ ॥",
      "transliteration": "jaisee bhookhe preet anaaj ||",
      "translation": "As the hungry person loves food,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤ੍ਰਿਖਾਵੰਤ ਜਲ ਸੇਤੀ ਕਾਜ ॥",
      "transliteration": "trikhaava(n)t jal setee kaaj ||",
      "translation": "and the thirsty person is obsessed with water,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜੈਸੀ ਮੂੜ ਕੁਟੰਬ ਪਰਾਇਣ ॥",
      "transliteration": "jaisee mooR kuta(n)b paraain ||",
      "translation": "and as the fool is attached to his family",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਐਸੀ ਨਾਮੇ ਪ੍ਰੀਤਿ ਨਰਾਇਣ ॥੧॥",
      "transliteration": "aisee naame preet naraain ||1||",
      "translation": "- just so, the Lord is very dear to Naam Dayv. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਮੇ ਪ੍ਰੀਤਿ ਨਾਰਾਇਣ ਲਾਗੀ ॥",
      "transliteration": "naame preet naaraain laagee ||",
      "translation": "Naam Dayv is in love with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਹਜ ਸੁਭਾਇ ਭਇਓ ਬੈਰਾਗੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sahaj subhaai bhaio bairaagee ||1|| rahaau ||",
      "translation": "He has naturally and intuitively become detached from the world. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜੈਸੀ ਪਰ ਪੁਰਖਾ ਰਤ ਨਾਰੀ ॥",
      "transliteration": "jaisee par purakhaa rat naaree ||",
      "translation": "Like the woman who falls in love with another man,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਲੋਭੀ ਨਰੁ ਧਨ ਕਾ ਹਿਤਕਾਰੀ ॥",
      "transliteration": "lobhee nar dhan kaa hitakaaree ||",
      "translation": "and the greedy man who loves only wealth,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਾਮੀ ਪੁਰਖ ਕਾਮਨੀ ਪਿਆਰੀ ॥",
      "transliteration": "kaamee purakh kaamanee piaaree ||",
      "translation": "and the sexually promiscuous man who loves women and sex,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਐਸੀ ਨਾਮੇ ਪ੍ਰੀਤਿ ਮੁਰਾਰੀ ॥੨॥",
      "transliteration": "aisee naame preet muraaree ||2||",
      "translation": "just so, Naam Dayv is in love with the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਾਈ ਪ੍ਰੀਤਿ ਜਿ ਆਪੇ ਲਾਏ ॥",
      "transliteration": "saaee preet j aape laae ||",
      "translation": "But that alone is real love, which the Lord Himself inspires;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਦੁਬਿਧਾ ਜਾਏ ॥",
      "transliteration": "gur parasaadee dubidhaa jaae ||",
      "translation": "by Guru's Grace, duality is eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਬਹੁ ਨ ਤੂਟਸਿ ਰਹਿਆ ਸਮਾਇ ॥",
      "transliteration": "kabahu na tootas rahiaa samaai ||",
      "translation": "Such love never breaks; through it, the mortal remains merged in the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਮੇ ਚਿਤੁ ਲਾਇਆ ਸਚਿ ਨਾਇ ॥੩॥",
      "transliteration": "naame chit laaiaa sach naai ||3||",
      "translation": "Naam Dayv has focused his consciousness on the True Name. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜੈਸੀ ਪ੍ਰੀਤਿ ਬਾਰਿਕ ਅਰੁ ਮਾਤਾ ॥",
      "transliteration": "jaisee preet baarik ar maataa ||",
      "translation": "Like the love between the child and its mother,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਐਸਾ ਹਰਿ ਸੇਤੀ ਮਨੁ ਰਾਤਾ ॥",
      "transliteration": "aisaa har setee man raataa ||",
      "translation": "so is my mind imbued with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਪ੍ਰਣਵੈ ਨਾਮਦੇਉ ਲਾਗੀ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "pranavai naamadeu laagee preet ||",
      "translation": "Prays Naam Dayv, I am in love with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗੋਬਿਦੁ ਬਸੈ ਹਮਾਰੈ ਚੀਤਿ ॥੪॥੧॥੭॥",
      "transliteration": "gobid basai hamaarai cheet ||4||1||7||",
      "translation": "The Lord of the Universe abides within my consciousness. ||4||1||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1164_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਘਰ ਕੀ ਨਾਰਿ ਤਿਆਗੈ ਅੰਧਾ ॥",
      "transliteration": "ghar kee naar tiaagai a(n)dhaa ||",
      "translation": "The blind fool abandons the wife of his own home,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1164,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
