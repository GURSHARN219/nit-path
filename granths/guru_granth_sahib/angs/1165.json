{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1165,
  "lineCount": 50,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1165_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਰ ਨਾਰੀ ਸਿਉ ਘਾਲੈ ਧੰਧਾ ॥",
      "transliteration": "par naaree siu ghaalai dha(n)dhaa ||",
      "translation": "and has an affair with another woman.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜੈਸੇ ਸਿੰਬਲੁ ਦੇਖਿ ਸੂਆ ਬਿਗਸਾਨਾ ॥",
      "transliteration": "jaise si(n)bal dekh sooaa bigasaanaa ||",
      "translation": "He is like the parrot, who is pleased to see the simbal tree;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅੰਤ ਕੀ ਬਾਰ ਮੂਆ ਲਪਟਾਨਾ ॥੧॥",
      "transliteration": "a(n)t kee baar mooaa lapataanaa ||1||",
      "translation": "but in the end, he dies, stuck to it. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਾਪੀ ਕਾ ਘਰੁ ਅਗਨੇ ਮਾਹਿ ॥",
      "transliteration": "paapee kaa ghar agane maahi ||",
      "translation": "The home of the sinner is on fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਲਤ ਰਹੈ ਮਿਟਵੈ ਕਬ ਨਾਹਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jalat rahai mitavai kab naahi ||1|| rahaau ||",
      "translation": "It keeps burning, and the fire cannot be extinguished. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਰਿ ਕੀ ਭਗਤਿ ਨ ਦੇਖੈ ਜਾਇ ॥",
      "transliteration": "har kee bhagat na dekhai jaai ||",
      "translation": "He does not go to see where the Lord is being worshipped.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਾਰਗੁ ਛੋਡਿ ਅਮਾਰਗਿ ਪਾਇ ॥",
      "transliteration": "maarag chhod amaarag paai ||",
      "translation": "He abandons the Lord's Path, and takes the wrong path.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮੂਲਹੁ ਭੂਲਾ ਆਵੈ ਜਾਇ ॥",
      "transliteration": "moolahu bhoolaa aavai jaai ||",
      "translation": "He forgets the Primal Lord God, and is caught in the cycle of reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਡਾਰਿ ਲਾਦਿ ਬਿਖੁ ਖਾਇ ॥੨॥",
      "transliteration": "a(n)mrit daar laad bikh khaai ||2||",
      "translation": "He throws away the Ambrosial Nectar, and gathers poison to eat. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਉ ਬੇਸ੍ਵਾ ਕੇ ਪਰੈ ਅਖਾਰਾ ॥",
      "transliteration": "jiu besvaa ke parai akhaaraa ||",
      "translation": "He is like the prostitute, who comes to dance,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਾਪਰੁ ਪਹਿਰਿ ਕਰਹਿ ਸਂੀਗਾਰਾ ॥",
      "transliteration": "kaapar pahir karahi sa(n)eegaaraa ||",
      "translation": "wearing beautiful clothes, decorated and adorned.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਪੂਰੇ ਤਾਲ ਨਿਹਾਲੇ ਸਾਸ ॥",
      "transliteration": "poore taal nihaale saas ||",
      "translation": "She dances to the beat, exciting the breath of those who watch her.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਵਾ ਕੇ ਗਲੇ ਜਮ ਕਾ ਹੈ ਫਾਸ ॥੩॥",
      "transliteration": "vaa ke gale jam kaa hai phaas ||3||",
      "translation": "But the noose of the Messenger of Death is around her neck. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਾ ਕੇ ਮਸਤਕਿ ਲਿਖਿਓ ਕਰਮਾ ॥",
      "transliteration": "jaa ke masatak likhio karamaa ||",
      "translation": "One who has good karma recorded on his forehead,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੋ ਭਜਿ ਪਰਿ ਹੈ ਗੁਰ ਕੀ ਸਰਨਾ ॥",
      "transliteration": "so bhaj par hai gur kee saranaa ||",
      "translation": "hurries to enter the Guru's Sanctuary.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਹਤ ਨਾਮਦੇਉ ਇਹੁ ਬੀਚਾਰੁ ॥",
      "transliteration": "kahat naamadeu ihu beechaar ||",
      "translation": "Says Naam Dayv, consider this:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਇਨ ਬਿਧਿ ਸੰਤਹੁ ਉਤਰਹੁ ਪਾਰਿ ॥੪॥੨॥੮॥",
      "transliteration": "in bidh sa(n)tahu utarahu paar ||4||2||8||",
      "translation": "O Saints, this is the way to cross over to the other side. ||4||2||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੰਡਾ ਮਰਕਾ ਜਾਇ ਪੁਕਾਰੇ ॥ ਪੜੈ ਨਹੀ ਹਮ ਹੀ ਪਚਿ ਹਾਰੇ ॥",
      "transliteration": "sa(n)daa marakaa jaai pukaare || paRai nahee ham hee pach haare ||",
      "translation": "Sanda and Marka went and complained to Harnaakhash, \"Your son does not read his lessons. We are tired of trying to teach him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਰਾਮੁ ਕਹੈ ਕਰ ਤਾਲ ਬਜਾਵੈ ਚਟੀਆ ਸਭੈ ਬਿਗਾਰੇ ॥੧॥",
      "transliteration": "raam kahai kar taal bajaavai chateeaa sabhai bigaare ||1||",
      "translation": "He chants the Lord's Name, clapping his hands to keep the beat; he has spoiled all the other students. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰਾਮ ਨਾਮਾ ਜਪਿਬੋ ਕਰੈ ॥",
      "transliteration": "raam naamaa japibo karai ||",
      "translation": "He chants the Lord's Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਹਿਰਦੈ ਹਰਿ ਜੀ ਕੋ ਸਿਮਰਨੁ ਧਰੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "hiradai har jee ko simaran dharai ||1|| rahaau ||",
      "translation": "and he has enshrined meditative remembrance of the Lord within his heart.\" ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਸੁਧਾ ਬਸਿ ਕੀਨੀ ਸਭ ਰਾਜੇ ਬਿਨਤੀ ਕਰੈ ਪਟਰਾਨੀ ॥",
      "transliteration": "basudhaa bas keenee sabh raaje binatee karai pataraanee ||",
      "translation": "\"Your father the king has conquered the whole world\", said his mother the queen.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪੂਤੁ ਪ੍ਰਹਿਲਾਦੁ ਕਹਿਆ ਨਹੀ ਮਾਨੈ ਤਿਨਿ ਤਉ ਅਉਰੈ ਠਾਨੀ ॥੨॥",
      "transliteration": "poot prahilaad kahiaa nahee maanai tin tau aurai thaanee ||2||",
      "translation": "\"O Prahlad my son, you do not obey him, so he has decided to deal with you in another way.\" ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੁਸਟ ਸਭਾ ਮਿਲਿ ਮੰਤਰ ਉਪਾਇਆ ਕਰਸਹ ਅਉਧ ਘਨੇਰੀ ॥",
      "transliteration": "dusat sabhaa mil ma(n)tar upaaiaa karasah audh ghaneree ||",
      "translation": "The council of villians met and resolved to send Prahlaad into the life hereafter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗਿਰਿ ਤਰ ਜਲ ਜੁਆਲਾ ਭੈ ਰਾਖਿਓ ਰਾਜਾ ਰਾਮਿ ਮਾਇਆ ਫੇਰੀ ॥੩॥",
      "transliteration": "gir tar jal juaalaa bhai raakhio raajaa raam maaiaa pheree ||3||",
      "translation": "Prahlaad was thrown off a mountain, into the water, and into a fire, but the Sovereign Lord God saved him, by changing the laws of nature. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਾਢਿ ਖੜਗੁ ਕਾਲੁ ਭੈ ਕੋਪਿਓ ਮੋਹਿ ਬਤਾਉ ਜੁ ਤੁਹਿ ਰਾਖੈ ॥",
      "transliteration": "kaadh khaRag kaal bhai kopio mohi bataau j tuhi raakhai ||",
      "translation": "Harnaakhash thundered with rage and threatened to kill Prahlaad. \"Tell me, who can save you?\"",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੀਤ ਪੀਤਾਂਬਰ ਤ੍ਰਿਭਵਣ ਧਣੀ ਥੰਭ ਮਾਹਿ ਹਰਿ ਭਾਖੈ ॥੪॥",
      "transliteration": "peet peetaa(n)bar tribhavan dhanee tha(n)bh maahi har bhaakhai ||4||",
      "translation": "Prahlaad answered, \"The Lord, the Master of the three worlds, is contained even in this pillar to which I am tied.\" ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹਰਨਾਖਸੁ ਜਿਨਿ ਨਖਹ ਬਿਦਾਰਿਓ ਸੁਰਿ ਨਰ ਕੀਏ ਸਨਾਥਾ ॥",
      "transliteration": "haranaakhas jin nakhah bidaario sur nar keee sanaathaa ||",
      "translation": "The Lord who tore Harnaakhash apart with His nails proclaimed Himself the Lord of gods and men.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਹਿ ਨਾਮਦੇਉ ਹਮ ਨਰਹਰਿ ਧਿਆਵਹ ਰਾਮੁ ਅਭੈ ਪਦ ਦਾਤਾ ॥੫॥੩॥੯॥",
      "transliteration": "kahi naamadeu ham narahar dhiaavah raam abhai pad daataa ||5||3||9||",
      "translation": "Says Naam Dayv, I meditate on the Lord, the Man-lion, the Giver of fearless dignity. ||5||3||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੁਲਤਾਨੁ ਪੂਛੈ ਸੁਨੁ ਬੇ ਨਾਮਾ ॥",
      "transliteration": "sulataan poochhai sun be naamaa ||",
      "translation": "The Sultan said, \"Listen, Naam Dayv:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦੇਖਉ ਰਾਮ ਤੁਮੑਾਰੇ ਕਾਮਾ ॥੧॥",
      "transliteration": "dekhau raam tumhaare kaamaa ||1||",
      "translation": "let me see the actions of your Lord.\" ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਮਾ ਸੁਲਤਾਨੇ ਬਾਧਿਲਾ ॥",
      "transliteration": "naamaa sulataane baadhilaa ||",
      "translation": "The Sultan arrested Naam Dayv,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੇਖਉ ਤੇਰਾ ਹਰਿ ਬੀਠੁਲਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dekhau teraa har beethulaa ||1|| rahaau ||",
      "translation": "and said, \"Let me see your Beloved Lord.\" ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਿਸਮਿਲਿ ਗਊ ਦੇਹੁ ਜੀਵਾਇ ॥",
      "transliteration": "bisamil gaoo dehu jeevaai ||",
      "translation": "\"Bring this dead cow back to life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਤਰੁ ਗਰਦਨਿ ਮਾਰਉ ਠਾਂਇ ॥੨॥",
      "transliteration": "naatar garadan maarau thaa(n)i ||2||",
      "translation": "Otherwise, I shall cut off your head here and now.\" ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਾਦਿਸਾਹ ਐਸੀ ਕਿਉ ਹੋਇ ॥",
      "transliteration": "baadisaah aisee kiu hoi ||",
      "translation": "Naam Dayv answered, \"O king, how can this happen?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਿਸਮਿਲਿ ਕੀਆ ਨ ਜੀਵੈ ਕੋਇ ॥੩॥",
      "transliteration": "bisamil keeaa na jeevai koi ||3||",
      "translation": "No one can bring the dead back to life. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮੇਰਾ ਕੀਆ ਕਛੂ ਨ ਹੋਇ ॥",
      "transliteration": "meraa keeaa kachhoo na hoi ||",
      "translation": "I cannot do anything by my own actions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਰਿ ਹੈ ਰਾਮੁ ਹੋਇ ਹੈ ਸੋਇ ॥੪॥",
      "transliteration": "kar hai raam hoi hai soi ||4||",
      "translation": "Whatever the Lord does, that alone happens.\" ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਾਦਿਸਾਹੁ ਚੜੑਿਓ ਅਹੰਕਾਰਿ ॥",
      "transliteration": "baadisaahu chaRhio aha(n)kaar ||",
      "translation": "The arrogant king was enraged at this reply.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗਜ ਹਸਤੀ ਦੀਨੋ ਚਮਕਾਰਿ ॥੫॥",
      "transliteration": "gaj hasatee deeno chamakaar ||5||",
      "translation": "He incited an elephant to attack. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰੁਦਨੁ ਕਰੈ ਨਾਮੇ ਕੀ ਮਾਇ ॥",
      "transliteration": "rudan karai naame kee maai ||",
      "translation": "Naam Dayv's mother began to cry,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਛੋਡਿ ਰਾਮੁ ਕੀ ਨ ਭਜਹਿ ਖੁਦਾਇ ॥੬॥",
      "transliteration": "chhod raam kee na bhajahi khudaai ||6||",
      "translation": "And she said, \"Why don't you abandon your Lord Raam, and worship his Lord Allah?\" ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨ ਹਉ ਤੇਰਾ ਪੂੰਗੜਾ ਨ ਤੂ ਮੇਰੀ ਮਾਇ ॥",
      "transliteration": "na hau teraa poo(n)gaRaa na too meree maai ||",
      "translation": "Naam Dayv answered, \"I am not your son, and you are not my mother.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪਿੰਡੁ ਪੜੈ ਤਉ ਹਰਿ ਗੁਨ ਗਾਇ ॥੭॥",
      "transliteration": "pi(n)d paRai tau har gun gaai ||7||",
      "translation": "Even if my body dies, I will still sing the Glorious Praises of the Lord.\" ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਰੈ ਗਜਿੰਦੁ ਸੁੰਡ ਕੀ ਚੋਟ ॥",
      "transliteration": "karai gaji(n)d su(n)d kee chot ||",
      "translation": "The elephant attacked him with his trunk,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਮਾ ਉਬਰੈ ਹਰਿ ਕੀ ਓਟ ॥੮॥",
      "transliteration": "naamaa ubarai har kee ot ||8||",
      "translation": "but Naam Dayv was saved, protected by the Lord. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਾਜੀ ਮੁਲਾਂ ਕਰਹਿ ਸਲਾਮੁ ॥",
      "transliteration": "kaajee mulaa(n) karahi salaam ||",
      "translation": "The king said, \"The Qazis and the Mullahs bow down to me,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਇਨਿ ਹਿੰਦੂ ਮੇਰਾ ਮਲਿਆ ਮਾਨੁ ॥੯॥",
      "transliteration": "in hi(n)doo meraa maliaa maan ||9||",
      "translation": "but this Hindu has trampled my honor.\" ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1165_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬਾਦਿਸਾਹ ਬੇਨਤੀ ਸੁਨੇਹੁ ॥",
      "transliteration": "baadisaah benatee sunehu ||",
      "translation": "The people pleaded with the king, \"Hear our prayer, O king.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1165,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
