{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1166,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1166_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਮੇ ਸਰ ਭਰਿ ਸੋਨਾ ਲੇਹੁ ॥੧੦॥",
      "transliteration": "naame sar bhar sonaa lehu ||10||",
      "translation": "Here, take Naam Dayvs weight in gold, and release him.\" ||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਾਲੁ ਲੇਉ ਤਉ ਦੋਜਕਿ ਪਰਉ ॥",
      "transliteration": "maal leu tau dojak parau ||",
      "translation": "The king replied, \"If I take the gold, then I will be consigned to hell,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੀਨੁ ਛੋਡਿ ਦੁਨੀਆ ਕਉ ਭਰਉ ॥੧੧॥",
      "transliteration": "deen chhod duneeaa kau bharau ||11||",
      "translation": "by forsaking my faith and gathering worldly wealth.\" ||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪਾਵਹੁ ਬੇੜੀ ਹਾਥਹੁ ਤਾਲ ॥",
      "transliteration": "paavahu beRee haathahu taal ||",
      "translation": "With his feet in chains, Naam Dayv kept the beat with his hands,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਮਾ ਗਾਵੈ ਗੁਨ ਗੋਪਾਲ ॥੧੨॥",
      "transliteration": "naamaa gaavai gun gopaal ||12||",
      "translation": "singing the Praises of the Lord. ||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੰਗ ਜਮੁਨ ਜਉ ਉਲਟੀ ਬਹੈ ॥",
      "transliteration": "ga(n)g jamun jau ulatee bahai ||",
      "translation": "\"Even if the Ganges and the Jamunaa rivers flow backwards,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਉ ਨਾਮਾ ਹਰਿ ਕਰਤਾ ਰਹੈ ॥੧੩॥",
      "transliteration": "tau naamaa har karataa rahai ||13||",
      "translation": "I will still continue singing the Praises of the Lord.\" ||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਾਤ ਘੜੀ ਜਬ ਬੀਤੀ ਸੁਣੀ ॥",
      "transliteration": "saat ghaRee jab beetee sunee ||",
      "translation": "Three hours passed,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਜਹੁ ਨ ਆਇਓ ਤ੍ਰਿਭਵਣ ਧਣੀ ॥੧੪॥",
      "transliteration": "ajahu na aaio tribhavan dhanee ||14||",
      "translation": "and even then, the Lord of the three worlds had not come. ||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਾਖੰਤਣ ਬਾਜ ਬਜਾਇਲਾ ॥",
      "transliteration": "paakha(n)tan baaj bajaailaa ||",
      "translation": "Playing on the instrument of the feathered wings,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗਰੁੜ ਚੜੑੇ ਗੋਬਿੰਦ ਆਇਲਾ ॥੧੫॥",
      "transliteration": "garuR chaRhe gobi(n)d aailaa ||15||",
      "translation": "the Lord of the Universe came, mounted on the eagle garura. ||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਪਨੇ ਭਗਤ ਪਰਿ ਕੀ ਪ੍ਰਤਿਪਾਲ ॥",
      "transliteration": "apane bhagat par kee pratipaal ||",
      "translation": "He cherished His devotee,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗਰੁੜ ਚੜੑੇ ਆਏ ਗੋਪਾਲ ॥੧੬॥",
      "transliteration": "garuR chaRhe aae gopaal ||16||",
      "translation": "and the Lord came, mounted on the eagle garura. ||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਹਹਿ ਤ ਧਰਣਿ ਇਕੋਡੀ ਕਰਉ ॥",
      "transliteration": "kahahi ta dharan ikodee karau ||",
      "translation": "The Lord said to him, \"If you wish, I shall turn the earth sideways.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਹਹਿ ਤ ਲੇ ਕਰਿ ਊਪਰਿ ਧਰਉ ॥੧੭॥",
      "transliteration": "kahahi ta le kar oopar dharau ||17||",
      "translation": "If you wish, I shall turn it upside down. ||17||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਹਹਿ ਤ ਮੁਈ ਗਊ ਦੇਉ ਜੀਆਇ ॥",
      "transliteration": "kahahi ta muee gaoo deu jeeaai ||",
      "translation": "If you wish, I shall bring the dead cow back to life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਭੁ ਕੋਈ ਦੇਖੈ ਪਤੀਆਇ ॥੧੮॥",
      "transliteration": "sabh koee dekhai pateeaai ||18||",
      "translation": "Everyone will see and be convinced.\" ||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮਾ ਪ੍ਰਣਵੈ ਸੇਲ ਮਸੇਲ ॥",
      "transliteration": "naamaa pranavai sel masel ||",
      "translation": "Naam Dayv prayed, and milked the cow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗਊ ਦੁਹਾਈ ਬਛਰਾ ਮੇਲਿ ॥੧੯॥",
      "transliteration": "gaoo duhaaee bachharaa mel ||19||",
      "translation": "He brought the calf to the cow, and milked her. ||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਦੂਧਹਿ ਦੁਹਿ ਜਬ ਮਟੁਕੀ ਭਰੀ ॥",
      "transliteration": "doodhahi duhi jab matukee bharee ||",
      "translation": "When the pitcher was filled with milk,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਲੇ ਬਾਦਿਸਾਹ ਕੇ ਆਗੇ ਧਰੀ ॥੨੦॥",
      "transliteration": "le baadisaah ke aage dharee ||20||",
      "translation": "Naam Dayv took it and placed it before the king. ||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬਾਦਿਸਾਹੁ ਮਹਲ ਮਹਿ ਜਾਇ ॥",
      "transliteration": "baadisaahu mahal mahi jaai ||",
      "translation": "The king went into his palace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਉਘਟ ਕੀ ਘਟ ਲਾਗੀ ਆਇ ॥੨੧॥",
      "transliteration": "aughat kee ghat laagee aai ||21||",
      "translation": "and his heart was troubled. ||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਾਜੀ ਮੁਲਾਂ ਬਿਨਤੀ ਫੁਰਮਾਇ ॥",
      "transliteration": "kaajee mulaa(n) binatee phuramaai ||",
      "translation": "Through the Qazis and the Mullahs, the king offered his prayer,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਖਸੀ ਹਿੰਦੂ ਮੈ ਤੇਰੀ ਗਾਇ ॥੨੨॥",
      "transliteration": "bakhasee hi(n)doo mai teree gaai ||22||",
      "translation": "\"Forgive me, please, O Hindu; I am just a cow before you.\" ||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਮਾ ਕਹੈ ਸੁਨਹੁ ਬਾਦਿਸਾਹ ॥",
      "transliteration": "naamaa kahai sunahu baadisaah ||",
      "translation": "Naam Dayv said, \"Listen, O king:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਇਹੁ ਕਿਛੁ ਪਤੀਆ ਮੁਝੈ ਦਿਖਾਇ ॥੨੩॥",
      "transliteration": "ihu kichh pateeaa mujhai dikhaai ||23||",
      "translation": "have I done this miracle? ||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਇਸ ਪਤੀਆ ਕਾ ਇਹੈ ਪਰਵਾਨੁ ॥",
      "transliteration": "is pateeaa kaa ihai paravaan ||",
      "translation": "The purpose of this miracle is",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਾਚਿ ਸੀਲਿ ਚਾਲਹੁ ਸੁਲਿਤਾਨ ॥੨੪॥",
      "transliteration": "saach seel chaalahu sulitaan ||24||",
      "translation": "that you, O king, should walk on the path of truth and humility.\" ||24||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਾਮਦੇਉ ਸਭ ਰਹਿਆ ਸਮਾਇ ॥",
      "transliteration": "naamadeu sabh rahiaa samaai ||",
      "translation": "Naam Dayv became famous everywhere for this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਿਲਿ ਹਿੰਦੂ ਸਭ ਨਾਮੇ ਪਹਿ ਜਾਹਿ ॥੨੫॥",
      "transliteration": "mil hi(n)doo sabh naame pahi jaahi ||25||",
      "translation": "The Hindus all went together to Naam Dayv. ||25||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਉ ਅਬ ਕੀ ਬਾਰ ਨ ਜੀਵੈ ਗਾਇ ॥",
      "transliteration": "jau ab kee baar na jeevai gaai ||",
      "translation": "If the cow had not been revived,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤ ਨਾਮਦੇਵ ਕਾ ਪਤੀਆ ਜਾਇ ॥੨੬॥",
      "transliteration": "ta naamadev kaa pateeaa jaai ||26||",
      "translation": "people would have lost faith in Naam Dayv. ||26||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਮੇ ਕੀ ਕੀਰਤਿ ਰਹੀ ਸੰਸਾਰਿ ॥",
      "transliteration": "naame kee keerat rahee sa(n)saar ||",
      "translation": "The fame of Naam Dayv spread throughout the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਗਤ ਜਨਾਂ ਲੇ ਉਧਰਿਆ ਪਾਰਿ ॥੨੭॥",
      "transliteration": "bhagat janaa(n) le udhariaa paar ||27||",
      "translation": "The humble devotees were saved and carried across with him. ||27||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਗਲ ਕਲੇਸ ਨਿੰਦਕ ਭਇਆ ਖੇਦੁ ॥",
      "transliteration": "sagal kales ni(n)dak bhaiaa khed ||",
      "translation": "All sorts of troubles and pains afflicted the slanderer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਮੇ ਨਾਰਾਇਨ ਨਾਹੀ ਭੇਦੁ ॥੨੮॥੧॥੧੦॥",
      "transliteration": "naame naaraain naahee bhed ||28||1||10||",
      "translation": "There is no difference between Naam Dayv and the Lord. ||28||1||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਘਰੁ ੨ ॥",
      "transliteration": "ghar 2 ||",
      "translation": "Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਮਿਲੈ ਮੁਰਾਰਿ ॥",
      "transliteration": "jau guradeu ta milai muraar ||",
      "translation": "By the Grace of the Divine Guru, one meets the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਉਤਰੈ ਪਾਰਿ ॥",
      "transliteration": "jau guradeu ta utarai paar ||",
      "translation": "By the Grace of the Divine Guru, one is carried across to the other side.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਬੈਕੁੰਠ ਤਰੈ ॥",
      "transliteration": "jau guradeu ta baiku(n)th tarai ||",
      "translation": "By the Grace of the Divine Guru, one swims across to heaven.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਜੀਵਤ ਮਰੈ ॥੧॥",
      "transliteration": "jau guradeu ta jeevat marai ||1||",
      "translation": "By the Grace of the Divine Guru, one remains dead while yet alive. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਤਿ ਸਤਿ ਸਤਿ ਸਤਿ ਸਤਿ ਗੁਰਦੇਵ ॥",
      "transliteration": "sat sat sat sat sat guradev ||",
      "translation": "True, True, True True, True is the Divine Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਝੂਠੁ ਝੂਠੁ ਝੂਠੁ ਝੂਠੁ ਆਨ ਸਭ ਸੇਵ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jhooth jhooth jhooth jhooth aan sabh sev ||1|| rahaau ||",
      "translation": "False, false, false, false is all other service. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਨਾਮੁ ਦ੍ਰਿੜਾਵੈ ॥",
      "transliteration": "jau guradeu ta naam driRaavai ||",
      "translation": "When the Divine Guru grants His Grace, the Naam, the Name of the Lord, is implanted within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਨ ਦਹ ਦਿਸ ਧਾਵੈ ॥",
      "transliteration": "jau guradeu na dah dis dhaavai ||",
      "translation": "When the Divine Guru grants His Grace, one does not wander in the ten directions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਪੰਚ ਤੇ ਦੂਰਿ ॥",
      "transliteration": "jau guradeu pa(n)ch te door ||",
      "translation": "When the Divine Guru grants His Grace, the five demons are kept far away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਨ ਮਰਿਬੋ ਝੂਰਿ ॥੨॥",
      "transliteration": "jau guradeu na maribo jhoor ||2||",
      "translation": "When the Divine Guru grants His Grace, one does not die regretting. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਅੰਮ੍ਰਿਤ ਬਾਨੀ ॥",
      "transliteration": "jau guradeu ta a(n)mrit baanee ||",
      "translation": "When the Divine Guru grants His Grace, one is blessed with the Ambrosial Bani of the Word.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਅਕਥ ਕਹਾਨੀ ॥",
      "transliteration": "jau guradeu ta akath kahaanee ||",
      "translation": "When the Divine Guru grants His Grace, one speaks the Unspoken Speech.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਅੰਮ੍ਰਿਤ ਦੇਹ ॥",
      "transliteration": "jau guradeu ta a(n)mrit deh ||",
      "translation": "When the Divine Guru grants His Grace, one's body becomes like ambrosial nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਨਾਮੁ ਜਪਿ ਲੇਹਿ ॥੩॥",
      "transliteration": "jau guradeu naam jap lehi ||3||",
      "translation": "When the Divine Guru grants His Grace, one utters and chants the Naam, the Name of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਭਵਨ ਤ੍ਰੈ ਸੂਝੈ ॥",
      "transliteration": "jau guradeu bhavan trai soojhai ||",
      "translation": "When the Divine Guru grants His Grace, one sees the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਊਚ ਪਦ ਬੂਝੈ ॥",
      "transliteration": "jau guradeu ooch pad boojhai ||",
      "translation": "When the Divine Guru grants His Grace, one understands the state of supreme dignity.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਸੀਸੁ ਅਕਾਸਿ ॥",
      "transliteration": "jau guradeu ta sees akaas ||",
      "translation": "When the Divine Guru grants His Grace, one's head is in the Akaashic ethers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਸਦਾ ਸਾਬਾਸਿ ॥੪॥",
      "transliteration": "jau guradeu sadaa saabaas ||4||",
      "translation": "When the Divine Guru grants His Grace, one is always congratulated everywhere. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਸਦਾ ਬੈਰਾਗੀ ॥",
      "transliteration": "jau guradeu sadaa bairaagee ||",
      "translation": "When the Divine Guru grants His Grace, one remains detached forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1166_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਪਰ ਨਿੰਦਾ ਤਿਆਗੀ ॥",
      "transliteration": "jau guradeu par ni(n)daa tiaagee ||",
      "translation": "When the Divine Guru grants His Grace, one forsakes the slander of others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1166,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
