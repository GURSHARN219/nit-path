{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1167,
  "lineCount": 49,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1167_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਬੁਰਾ ਭਲਾ ਏਕ ॥",
      "transliteration": "jau guradeu buraa bhalaa ek ||",
      "translation": "When the Divine Guru grants His Grace, one looks upon good and bad as the same.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਲਿਲਾਟਹਿ ਲੇਖ ॥੫॥",
      "transliteration": "jau guradeu lilaatahi lekh ||5||",
      "translation": "When the Divine Guru grants His Grace, one has good destiny written on his forehead. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਕੰਧੁ ਨਹੀ ਹਿਰੈ ॥",
      "transliteration": "jau guradeu ka(n)dh nahee hirai ||",
      "translation": "When the Divine Guru grants His Grace, the wall of the body is not eroded.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਦੇਹੁਰਾ ਫਿਰੈ ॥",
      "transliteration": "jau guradeu dehuraa phirai ||",
      "translation": "When the Divine Guru grants His Grace, the temple turns itself towards the mortal.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਛਾਪਰਿ ਛਾਈ ॥",
      "transliteration": "jau guradeu ta chhaapar chhaaee ||",
      "translation": "When the Divine Guru grants His Grace, one's home is constructed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਸਿਹਜ ਨਿਕਸਾਈ ॥੬॥",
      "transliteration": "jau guradeu sihaj nikasaaee ||6||",
      "translation": "When the Divine Guru grants His Grace, one's bed is lifted up out of the water. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਅਠਸਠਿ ਨਾਇਆ ॥",
      "transliteration": "jau guradeu ta athasath naaiaa ||",
      "translation": "When the Divine Guru grants His Grace, one has bathed at the sixty-eight sacred shrines of pilgrimage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤਨਿ ਚਕ੍ਰ ਲਗਾਇਆ ॥",
      "transliteration": "jau guradeu tan chakr lagaaiaa ||",
      "translation": "When the Divine Guru grants His Grace, one's body is stamped with the sacred mark of Vishnu.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਦੁਆਦਸ ਸੇਵਾ ॥",
      "transliteration": "jau guradeu ta duaadas sevaa ||",
      "translation": "When the Divine Guru grants His Grace, one has performed the twelve devotional services.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਸਭੈ ਬਿਖੁ ਮੇਵਾ ॥੭॥",
      "transliteration": "jau guradeu sabhai bikh mevaa ||7||",
      "translation": "When the Divine Guru grants His Grace, all poison is transformed into fruit. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਸੰਸਾ ਟੂਟੈ ॥",
      "transliteration": "jau guradeu ta sa(n)saa tootai ||",
      "translation": "When the Divine Guru grants His Grace, skepticism is shattered.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਜਮ ਤੇ ਛੂਟੈ ॥",
      "transliteration": "jau guradeu ta jam te chhootai ||",
      "translation": "When the Divine Guru grants His Grace, one escapes from the Messenger of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਭਉਜਲ ਤਰੈ ॥",
      "transliteration": "jau guradeu ta bhaujal tarai ||",
      "translation": "When the Divine Guru grants His Grace, one crosses over the terrifying world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਤ ਜਨਮਿ ਨ ਮਰੈ ॥੮॥",
      "transliteration": "jau guradeu ta janam na marai ||8||",
      "translation": "When the Divine Guru grants His Grace, one is not subject to the cycle of reincarnation. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਅਠਦਸ ਬਿਉਹਾਰ ॥",
      "transliteration": "jau guradeu athadas biuhaar ||",
      "translation": "When the Divine Guru grants His Grace, one understands the rituals of the eighteen Puraanas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਉ ਗੁਰਦੇਉ ਅਠਾਰਹ ਭਾਰ ॥",
      "transliteration": "jau guradeu athaarah bhaar ||",
      "translation": "When the Divine Guru grants His Grace, it is as if one has made an offering of the eighten loads of vegetation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਨੁ ਗੁਰਦੇਉ ਅਵਰ ਨਹੀ ਜਾਈ ॥",
      "transliteration": "bin guradeu avar nahee jaaee ||",
      "translation": "When the Divine Guru grants His Grace, one needs no other place of rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮਦੇਉ ਗੁਰ ਕੀ ਸਰਣਾਈ ॥੯॥੧॥੨॥੧੧॥",
      "transliteration": "naamadeu gur kee saranaaee ||9||1||2||11||",
      "translation": "Naam Dayv has entered the Sanctuary of the Guru. ||9||1||2||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਭੈਰਉ ਬਾਣੀ ਰਵਿਦਾਸ ਜੀਉ ਕੀ ਘਰੁ ੨ ॥",
      "transliteration": "bhairau baanee ravidaas jeeu kee ghar 2 ||",
      "translation": "Bhairao, The Word Of Ravi Daas Jee, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਨੁ ਦੇਖੇ ਉਪਜੈ ਨਹੀ ਆਸਾ ॥",
      "transliteration": "bin dekhe upajai nahee aasaa ||",
      "translation": "Without seeing something, the yearning for it does not arise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੋ ਦੀਸੈ ਸੋ ਹੋਇ ਬਿਨਾਸਾ ॥",
      "transliteration": "jo deesai so hoi binaasaa ||",
      "translation": "Whatever is seen, shall pass away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਰਨ ਸਹਿਤ ਜੋ ਜਾਪੈ ਨਾਮੁ ॥",
      "transliteration": "baran sahit jo jaapai naam ||",
      "translation": "Whoever chants and praises the Naam, the Name of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸੋ ਜੋਗੀ ਕੇਵਲ ਨਿਹਕਾਮੁ ॥੧॥",
      "transliteration": "so jogee keval nihakaam ||1||",
      "translation": "is the true Yogi, free of desire. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਪਰਚੈ ਰਾਮੁ ਰਵੈ ਜਉ ਕੋਈ ॥",
      "transliteration": "parachai raam ravai jau koee ||",
      "translation": "When someone utters the Name of the Lord with love,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਪਾਰਸੁ ਪਰਸੈ ਦੁਬਿਧਾ ਨ ਹੋਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "paaras parasai dubidhaa na hoee ||1|| rahaau ||",
      "translation": "it is as if he has touched the philosopher's stone; his sense of duality is eradicated. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੋ ਮੁਨਿ ਮਨ ਕੀ ਦੁਬਿਧਾ ਖਾਇ ॥",
      "transliteration": "so mun man kee dubidhaa khaai ||",
      "translation": "He alone is a silent sage, who destroys the duality of his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਿਨੁ ਦੁਆਰੇ ਤ੍ਰੈ ਲੋਕ ਸਮਾਇ ॥",
      "transliteration": "bin duaare trai lok samaai ||",
      "translation": "Keeping the doors of his body closed, he merges in the Lord of the three worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਨ ਕਾ ਸੁਭਾਉ ਸਭੁ ਕੋਈ ਕਰੈ ॥",
      "transliteration": "man kaa subhaau sabh koee karai ||",
      "translation": "Everyone acts according to the inclinations of the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਰਤਾ ਹੋਇ ਸੁ ਅਨਭੈ ਰਹੈ ॥੨॥",
      "transliteration": "karataa hoi s anabhai rahai ||2||",
      "translation": "Attuned to the Creator Lord, one remains free of fear. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਫਲ ਕਾਰਨ ਫੂਲੀ ਬਨਰਾਇ ॥",
      "transliteration": "phal kaaran phoolee banaraai ||",
      "translation": "Plants blossom forth to produce fruit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਫਲੁ ਲਾਗਾ ਤਬ ਫੂਲੁ ਬਿਲਾਇ ॥",
      "transliteration": "phal laagaa tab phool bilaai ||",
      "translation": "When the fruit is produced, the flowers wither away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗਿਆਨੈ ਕਾਰਨ ਕਰਮ ਅਭਿਆਸੁ ॥",
      "transliteration": "giaanai kaaran karam abhiaas ||",
      "translation": "For the sake of spiritual wisdom, people act and practice rituals.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗਿਆਨੁ ਭਇਆ ਤਹ ਕਰਮਹ ਨਾਸੁ ॥੩॥",
      "transliteration": "giaan bhaiaa tah karamah naas ||3||",
      "translation": "When spiritual wisdom wells up, then actions are left behind. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਘ੍ਰਿਤ ਕਾਰਨ ਦਧਿ ਮਥੈ ਸਇਆਨ ॥",
      "transliteration": "ghrit kaaran dadh mathai saiaan ||",
      "translation": "For the sake of ghee, wise people churn milk.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜੀਵਤ ਮੁਕਤ ਸਦਾ ਨਿਰਬਾਨ ॥",
      "transliteration": "jeevat mukat sadaa nirabaan ||",
      "translation": "Those who are Jivan-mukta, liberated while yet alive - are forever in the state of Nirvaanaa.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਹਿ ਰਵਿਦਾਸ ਪਰਮ ਬੈਰਾਗ ॥",
      "transliteration": "kahi ravidaas param bairaag ||",
      "translation": "Says Ravi Daas, O you unfortunate people,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਿਦੈ ਰਾਮੁ ਕੀ ਨ ਜਪਸਿ ਅਭਾਗ ॥੪॥੧॥",
      "transliteration": "ridai raam kee na japas abhaag ||4||1||",
      "translation": "why not meditate on the Lord with love in your heart? ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਮਦੇਵ ॥",
      "transliteration": "naamadev ||",
      "translation": "Naam Dayv:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਆਉ ਕਲੰਦਰ ਕੇਸਵਾ ॥",
      "transliteration": "aau kala(n)dar kesavaa ||",
      "translation": "Come, O Lord of beautiful hair,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰਿ ਅਬਦਾਲੀ ਭੇਸਵਾ ॥ ਰਹਾਉ ॥",
      "transliteration": "kar abadaalee bhesavaa || rahaau ||",
      "translation": "wearing the robes of a Sufi Saint. ||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਨਿ ਆਕਾਸ ਕੁਲਹ ਸਿਰਿ ਕੀਨੀ ਕਉਸੈ ਸਪਤ ਪਯਾਲਾ ॥",
      "transliteration": "jin aakaas kulah sir keenee kausai sapat payaalaa ||",
      "translation": "Your cap is the realm of the Akaashic ethers; the seven nether worlds are Your sandals.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਚਮਰ ਪੋਸ ਕਾ ਮੰਦਰੁ ਤੇਰਾ ਇਹ ਬਿਧਿ ਬਨੇ ਗੁਪਾਲਾ ॥੧॥",
      "transliteration": "chamar pos kaa ma(n)dar teraa ih bidh bane gupaalaa ||1||",
      "translation": "The body covered with skin is Your temple; You are so beautiful, O Lord of the World. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਛਪਨ ਕੋਟਿ ਕਾ ਪੇਹਨੁ ਤੇਰਾ ਸੋਲਹ ਸਹਸ ਇਜਾਰਾ ॥",
      "transliteration": "chhapan kot kaa pehan teraa solah sahas ijaaraa ||",
      "translation": "The fifty-six million clouds are Your gowns, the 16,000 milkmaids are your skirts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਭਾਰ ਅਠਾਰਹ ਮੁਦਗਰੁ ਤੇਰਾ ਸਹਨਕ ਸਭ ਸੰਸਾਰਾ ॥੨॥",
      "transliteration": "bhaar athaarah mudagar teraa sahanak sabh sa(n)saaraa ||2||",
      "translation": "The eighteen loads of vegetation is Your stick, and all the world is Your plate. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੇਹੀ ਮਹਜਿਦਿ ਮਨੁ ਮਉਲਾਨਾ ਸਹਜ ਨਿਵਾਜ ਗੁਜਾਰੈ ॥",
      "transliteration": "dehee mahajid man maulaanaa sahaj nivaaj gujaarai ||",
      "translation": "The human body is the mosque, and the mind is the priest, who peacefully leads the prayer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬੀਬੀ ਕਉਲਾ ਸਉ ਕਾਇਨੁ ਤੇਰਾ ਨਿਰੰਕਾਰ ਆਕਾਰੈ ॥੩॥",
      "transliteration": "beebee kaulaa sau kaain teraa nira(n)kaar aakaarai ||3||",
      "translation": "You are married to Maya, O Formless Lord, and so You have taken form. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਭਗਤਿ ਕਰਤ ਮੇਰੇ ਤਾਲ ਛਿਨਾਏ ਕਿਹ ਪਹਿ ਕਰਉ ਪੁਕਾਰਾ ॥",
      "transliteration": "bhagat karat mere taal chhinaae kih pahi karau pukaaraa ||",
      "translation": "Performing devotional worship services to You, my cymbals were taken away; unto whom should I complain?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1167_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਮੇ ਕਾ ਸੁਆਮੀ ਅੰਤਰਜਾਮੀ ਫਿਰੇ ਸਗਲ ਬੇਦੇਸਵਾ ॥੪॥੧॥",
      "transliteration": "naame kaa suaamee a(n)tarajaamee phire sagal bedesavaa ||4||1||",
      "translation": "Naam Dayv's Lord and Master, the Inner-knower, the Searcher of hearts, wanders everywhere; He has no specific home. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1167,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
