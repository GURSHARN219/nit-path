{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1169,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1169_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਾਮਿ ਨ ਭੀਜੈ ਸਾਚ ਨਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaam na bheejai saach naai ||1|| rahaau ||",
      "translation": "if you are not drenched with the True Name. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਦਸ ਅਠ ਲੀਖੇ ਹੋਵਹਿ ਪਾਸਿ ॥",
      "transliteration": "das ath leekhe hovahi paas ||",
      "translation": "One may have the eighteen Puraanas written in his own hand;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਚਾਰੇ ਬੇਦ ਮੁਖਾਗਰ ਪਾਠਿ ॥",
      "transliteration": "chaare bed mukhaagar paath ||",
      "translation": "he may recite the four Vedas by heart,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪੁਰਬੀ ਨਾਵੈ ਵਰਨਾਂ ਕੀ ਦਾਤਿ ॥",
      "transliteration": "purabee naavai varanaa(n) kee daat ||",
      "translation": "and take ritual baths at holy festivals and give charitable donations;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਵਰਤ ਨੇਮ ਕਰੇ ਦਿਨ ਰਾਤਿ ॥੨॥",
      "transliteration": "varat nem kare din raat ||2||",
      "translation": "he may observe the ritual fasts, and perform religious ceremonies day and night. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਜੀ ਮੁਲਾਂ ਹੋਵਹਿ ਸੇਖ ॥",
      "transliteration": "kaajee mulaa(n) hovahi sekh ||",
      "translation": "He may be a Qazi, a Mullah or a Shaykh,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜੋਗੀ ਜੰਗਮ ਭਗਵੇ ਭੇਖ ॥",
      "transliteration": "jogee ja(n)gam bhagave bhekh ||",
      "translation": "a Yogi or a wandering hermit wearing saffron-colored robes;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕੋ ਗਿਰਹੀ ਕਰਮਾ ਕੀ ਸੰਧਿ ॥",
      "transliteration": "ko girahee karamaa kee sa(n)dh ||",
      "translation": "he may be a householder, working at his job;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਨੁ ਬੂਝੇ ਸਭ ਖੜੀਅਸਿ ਬੰਧਿ ॥੩॥",
      "transliteration": "bin boojhe sabh khaReeas ba(n)dh ||3||",
      "translation": "but without understanding the essence of devotional worship, all people are eventually bound and gagged, and driven along by the Messenger of Death. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜੇਤੇ ਜੀਅ ਲਿਖੀ ਸਿਰਿ ਕਾਰ ॥",
      "transliteration": "jete jee likhee sir kaar ||",
      "translation": "Each person's karma is written on his forehead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਰਣੀ ਉਪਰਿ ਹੋਵਗਿ ਸਾਰ ॥",
      "transliteration": "karanee upar hovag saar ||",
      "translation": "According to their deeds, they shall be judged.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹੁਕਮੁ ਕਰਹਿ ਮੂਰਖ ਗਾਵਾਰ ॥",
      "transliteration": "hukam karahi moorakh gaavaar ||",
      "translation": "Only the foolish and the ignorant issue commands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਨਾਨਕ ਸਾਚੇ ਕੇ ਸਿਫਤਿ ਭੰਡਾਰ ॥੪॥੩॥",
      "transliteration": "naanak saache ke siphat bha(n)daar ||4||3||",
      "translation": "O Nanak, the treasure of praise belongs to the True Lord alone. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ਤੀਜਾ ॥",
      "transliteration": "basa(n)t mahalaa 3 teejaa ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਸਤ੍ਰ ਉਤਾਰਿ ਦਿਗੰਬਰੁ ਹੋਗੁ ॥",
      "transliteration": "basatr utaar diga(n)bar hog ||",
      "translation": "A person may take off his clothes and be naked.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਟਾਧਾਰਿ ਕਿਆ ਕਮਾਵੈ ਜੋਗੁ ॥",
      "transliteration": "jataadhaar kiaa kamaavai jog ||",
      "translation": "What Yoga does he practice by having matted and tangled hair?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਮਨੁ ਨਿਰਮਲੁ ਨਹੀ ਦਸਵੈ ਦੁਆਰ ॥",
      "transliteration": "man niramal nahee dasavai duaar ||",
      "translation": "If the mind is not pure, what use is it to hold the breath at the Tenth Gate?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਭ੍ਰਮਿ ਭ੍ਰਮਿ ਆਵੈ ਮੂੜੑਾ ਵਾਰੋ ਵਾਰ ॥੧॥",
      "transliteration": "bhram bhram aavai mooRhaa vaaro vaar ||1||",
      "translation": "The fool wanders and wanders, entering the cycle of reincarnation again and again. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਏਕੁ ਧਿਆਵਹੁ ਮੂੜੑ ਮਨਾ ॥",
      "transliteration": "ek dhiaavahu mooRh manaa ||",
      "translation": "Meditate on the One Lord, O my foolish mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪਾਰਿ ਉਤਰਿ ਜਾਹਿ ਇਕ ਖਿਨਾਂ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "paar utar jaahi ik khinaa(n) ||1|| rahaau ||",
      "translation": "and you shall cross over to the other side in an instant. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਿਮ੍ਰਿਤਿ ਸਾਸਤ੍ਰ ਕਰਹਿ ਵਖਿਆਣ ॥",
      "transliteration": "simrit saasatr karahi vakhiaan ||",
      "translation": "Some recite and expound on the Simritees and the Shaastras;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਦੀ ਬੇਦੀ ਪੜੑਹਿ ਪੁਰਾਣ ॥",
      "transliteration": "naadee bedee paRhhi puraan ||",
      "translation": "some sing the Vedas and read the Puraanas;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪਾਖੰਡ ਦ੍ਰਿਸਟਿ ਮਨਿ ਕਪਟੁ ਕਮਾਹਿ ॥",
      "transliteration": "paakha(n)d drisat man kapat kamaahi ||",
      "translation": "but they practice hypocrisy and deception with their eyes and minds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਿਨ ਕੈ ਰਮਈਆ ਨੇੜਿ ਨਾਹਿ ॥੨॥",
      "transliteration": "tin kai ramaeeaa neR naahi ||2||",
      "translation": "The Lord does not even come near them. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੇ ਕੋ ਐਸਾ ਸੰਜਮੀ ਹੋਇ ॥",
      "transliteration": "je ko aisaa sa(n)jamee hoi ||",
      "translation": "Even if someone practices such self-discipline,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕ੍ਰਿਆ ਵਿਸੇਖ ਪੂਜਾ ਕਰੇਇ ॥",
      "transliteration": "kriaa visekh poojaa karei ||",
      "translation": "compassion and devotional worship",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅੰਤਰਿ ਲੋਭੁ ਮਨੁ ਬਿਖਿਆ ਮਾਹਿ ॥",
      "transliteration": "a(n)tar lobh man bikhiaa maahi ||",
      "translation": "- if he is filled with greed, and his mind is engrossed in corruption,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਓਇ ਨਿਰੰਜਨੁ ਕੈਸੇ ਪਾਹਿ ॥੩॥",
      "transliteration": "oi nira(n)jan kaise paahi ||3||",
      "translation": "how can he find the Immaculate Lord? ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕੀਤਾ ਹੋਆ ਕਰੇ ਕਿਆ ਹੋਇ ॥",
      "transliteration": "keetaa hoaa kare kiaa hoi ||",
      "translation": "What can the created being do?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਸ ਨੋ ਆਪਿ ਚਲਾਏ ਸੋਇ ॥",
      "transliteration": "jis no aap chalaae soi ||",
      "translation": "The Lord Himself moves him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਤਾਂ ਭਰਮੁ ਚੁਕਾਏ ॥",
      "transliteration": "nadar kare taa(n) bharam chukaae ||",
      "translation": "If the Lord casts His Glance of Grace, then his doubts are dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਹੁਕਮੈ ਬੂਝੈ ਤਾਂ ਸਾਚਾ ਪਾਏ ॥੪॥",
      "transliteration": "hukamai boojhai taa(n) saachaa paae ||4||",
      "translation": "If the mortal realizes the Hukam of the Lord's Command, he obtains the True Lord. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਿਸੁ ਜੀਉ ਅੰਤਰੁ ਮੈਲਾ ਹੋਇ ॥",
      "transliteration": "jis jeeu a(n)tar mailaa hoi ||",
      "translation": "If someone's soul is polluted within,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੀਰਥ ਭਵੈ ਦਿਸੰਤਰ ਲੋਇ ॥",
      "transliteration": "teerath bhavai disa(n)tar loi ||",
      "translation": "what is the use of his traveling to sacred shrines of pilgrimage all over the world?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕ ਮਿਲੀਐ ਸਤਿਗੁਰ ਸੰਗ ॥",
      "transliteration": "naanak mileeai satigur sa(n)g ||",
      "translation": "O Nanak, when one joins the Society of the True Guru,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਉ ਭਵਜਲ ਕੇ ਤੂਟਸਿ ਬੰਧ ॥੫॥੪॥",
      "transliteration": "tau bhavajal ke tootas ba(n)dh ||5||4||",
      "translation": "then the bonds of the terrifying world-ocean are broken. ||5||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੧ ॥",
      "transliteration": "basa(n)t mahalaa 1 ||",
      "translation": "Basant, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਗਲ ਭਵਨ ਤੇਰੀ ਮਾਇਆ ਮੋਹ ॥",
      "transliteration": "sagal bhavan teree maaiaa moh ||",
      "translation": "All the worlds have been fascinated and enchanted by Your Maya, O Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮੈ ਅਵਰੁ ਨ ਦੀਸੈ ਸਰਬ ਤੋਹ ॥",
      "transliteration": "mai avar na deesai sarab toh ||",
      "translation": "I do not see any other at all - You are everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤੂ ਸੁਰਿ ਨਾਥਾ ਦੇਵਾ ਦੇਵ ॥",
      "transliteration": "too sur naathaa devaa dev ||",
      "translation": "You are the Master of Yogis, the Divinity of the divine.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਹਰਿ ਨਾਮੁ ਮਿਲੈ ਗੁਰ ਚਰਨ ਸੇਵ ॥੧॥",
      "transliteration": "har naam milai gur charan sev ||1||",
      "translation": "Serving at the Guru's Feet, the Name of the Lord is received. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮੇਰੇ ਸੁੰਦਰ ਗਹਿਰ ਗੰਭੀਰ ਲਾਲ ॥",
      "transliteration": "mere su(n)dar gahir ga(n)bheer laal ||",
      "translation": "O my Beauteous, Deep and Profound Beloved Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਰਾਮ ਨਾਮ ਗੁਨ ਗਾਏ ਤੂ ਅਪਰੰਪਰੁ ਸਰਬ ਪਾਲ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "guramukh raam naam gun gaae too apara(n)par sarab paal ||1|| rahaau ||",
      "translation": "As Gurmukh, I sing the Glorious Praises of the Lord's Name. You are Infinite, the Cherisher of all. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਿਨੁ ਸਾਧ ਨ ਪਾਈਐ ਹਰਿ ਕਾ ਸੰਗੁ ॥",
      "transliteration": "bin saadh na paaeeai har kaa sa(n)g ||",
      "translation": "Without the Holy Saint, association with the Lord is not obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਮੈਲ ਮਲੀਨ ਅੰਗੁ ॥",
      "transliteration": "bin gur mail maleen a(n)g ||",
      "translation": "Without the Guru, one's very fiber is stained with filth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਨਾਮ ਨ ਸੁਧੁ ਹੋਇ ॥",
      "transliteration": "bin har naam na sudh hoi ||",
      "translation": "Without the Lord's Name, one cannot become pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਗੁਰ ਸਬਦਿ ਸਲਾਹੇ ਸਾਚੁ ਸੋਇ ॥੨॥",
      "transliteration": "gur sabad salaahe saach soi ||2||",
      "translation": "Through the Word of the Guru's Shabad, sing the Praises of the True Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਜਾ ਕਉ ਤੂ ਰਾਖਹਿ ਰਖਨਹਾਰ ॥",
      "transliteration": "jaa kau too raakhahi rakhanahaar ||",
      "translation": "O Savior Lord, that person whom You have saved",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਤਿਗੁਰੂ ਮਿਲਾਵਹਿ ਕਰਹਿ ਸਾਰ ॥",
      "transliteration": "satiguroo milaavahi karahi saar ||",
      "translation": "- You lead him to meet the True Guru, and so take care of him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬਿਖੁ ਹਉਮੈ ਮਮਤਾ ਪਰਹਰਾਇ ॥",
      "transliteration": "bikh haumai mamataa paraharaai ||",
      "translation": "You take away his poisonous egotism and attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਭਿ ਦੂਖ ਬਿਨਾਸੇ ਰਾਮ ਰਾਇ ॥੩॥",
      "transliteration": "sabh dookh binaase raam raai ||3||",
      "translation": "You dispel all his sufferings, O Sovereign Lord God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਊਤਮ ਗਤਿ ਮਿਤਿ ਹਰਿ ਗੁਨ ਸਰੀਰ ॥",
      "transliteration": "ootam gat mit har gun sareer ||",
      "translation": "His state and condition are sublime; the Lord's Glorious Virtues permeate his body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰਮਤਿ ਪ੍ਰਗਟੇ ਰਾਮ ਨਾਮ ਹੀਰ ॥",
      "transliteration": "guramat pragate raam naam heer ||",
      "translation": "Through the Word of the Guru's Teachings, the diamond of the Lord's Name is revealed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਲਿਵ ਲਾਗੀ ਨਾਮਿ ਤਜਿ ਦੂਜਾ ਭਾਉ ॥",
      "transliteration": "liv laagee naam taj doojaa bhaau ||",
      "translation": "He is lovingly attuned to the Naam; he is rid of the love of duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਹਰਿ ਗੁਰੁ ਗੁਰ ਮਿਲਾਉ ॥੪॥੫॥",
      "transliteration": "jan naanak har gur gur milaau ||4||5||",
      "translation": "O Lord, let servant Nanak meet the Guru. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੧ ॥",
      "transliteration": "basa(n)t mahalaa 1 ||",
      "translation": "Basant, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਮੇਰੀ ਸਖੀ ਸਹੇਲੀ ਸੁਨਹੁ ਭਾਇ ॥",
      "transliteration": "meree sakhee sahelee sunahu bhaai ||",
      "translation": "O my friends and companions, listen with love in your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਮੇਰਾ ਪਿਰੁ ਰੀਸਾਲੂ ਸੰਗਿ ਸਾਇ ॥",
      "transliteration": "meraa pir reesaaloo sa(n)g saai ||",
      "translation": "My Husband Lord is Incomparably Beautiful; He is always with me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1169_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਓਹੁ ਅਲਖੁ ਨ ਲਖੀਐ ਕਹਹੁ ਕਾਇ ॥",
      "transliteration": "ohu alakh na lakheeai kahahu kaai ||",
      "translation": "He is Unseen - He cannot be seen. How can I describe Him?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1169,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
