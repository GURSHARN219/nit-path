{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1172,
  "lineCount": 52,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1172_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਜਿਨ ਕਉ ਤਖਤਿ ਮਿਲੈ ਵਡਿਆਈ ਗੁਰਮੁਖਿ ਸੇ ਪਰਧਾਨ ਕੀਏ ॥",
      "transliteration": "jin kau takhat milai vadiaaee guramukh se paradhaan keee ||",
      "translation": "Those who are blessed with the glory of the Lord's Throne - those Gurmukhs are renowned as supreme.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪਾਰਸੁ ਭੇਟਿ ਭਏ ਸੇ ਪਾਰਸ ਨਾਨਕ ਹਰਿ ਗੁਰ ਸੰਗਿ ਥੀਏ ॥੪॥੪॥੧੨॥",
      "transliteration": "paaras bhet bhae se paaras naanak har gur sa(n)g theee ||4||4||12||",
      "translation": "Touching the philosopher's stone, they themselves becomes the philosopher's stone; they become the companions of the Lord, the Guru. ||4||4||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ਘਰੁ ੧ ਦੁਤੁਕੇ ॥",
      "transliteration": "basa(n)t mahalaa 3 ghar 1 dutuke ||",
      "translation": "Basant, Third Mehl, First House, Dho-Thukay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਾਹਾ ਰੁਤੀ ਮਹਿ ਸਦ ਬਸੰਤੁ ॥",
      "transliteration": "maahaa rutee mahi sad basa(n)t ||",
      "translation": "Throughout the months and the seasons, the Lord is always in bloom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਜਿਤੁ ਹਰਿਆ ਸਭੁ ਜੀਅ ਜੰਤੁ ॥",
      "transliteration": "jit hariaa sabh jee ja(n)t ||",
      "translation": "He rejuvenates all beings and creatures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਿਆ ਹਉ ਆਖਾ ਕਿਰਮ ਜੰਤੁ ॥",
      "transliteration": "kiaa hau aakhaa kiram ja(n)t ||",
      "translation": "What can I say? I am just a worm.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੇਰਾ ਕਿਨੈ ਨ ਪਾਇਆ ਆਦਿ ਅੰਤੁ ॥੧॥",
      "transliteration": "teraa kinai na paaiaa aad a(n)t ||1||",
      "translation": "No one has found Your beginning or Your end, O Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤੈ ਸਾਹਿਬ ਕੀ ਕਰਹਿ ਸੇਵ ॥",
      "transliteration": "tai saahib kee karahi sev ||",
      "translation": "Those who serve You, Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪਰਮ ਸੁਖ ਪਾਵਹਿ ਆਤਮ ਦੇਵ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "param sukh paavahi aatam dev ||1|| rahaau ||",
      "translation": "obtain the greatest peace; their souls are so divine. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਰਮੁ ਹੋਵੈ ਤਾਂ ਸੇਵਾ ਕਰੈ ॥",
      "transliteration": "karam hovai taa(n) sevaa karai ||",
      "translation": "If the Lord is merciful, then the mortal is allowed to serve Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਜੀਵਤ ਮਰੈ ॥",
      "transliteration": "gur parasaadee jeevat marai ||",
      "translation": "By Guru's Grace, he remains dead while yet alive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਨਦਿਨੁ ਸਾਚੁ ਨਾਮੁ ਉਚਰੈ ॥",
      "transliteration": "anadin saach naam ucharai ||",
      "translation": "Night and day, he chants the True Name;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਇਨ ਬਿਧਿ ਪ੍ਰਾਣੀ ਦੁਤਰੁ ਤਰੈ ॥੨॥",
      "transliteration": "in bidh praanee dutar tarai ||2||",
      "translation": "in this way, he crosses over the treacherous world-ocean. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਿਖੁ ਅੰਮ੍ਰਿਤੁ ਕਰਤਾਰਿ ਉਪਾਏ ॥",
      "transliteration": "bikh a(n)mrit karataar upaae ||",
      "translation": "The Creator created both poison and nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੰਸਾਰ ਬਿਰਖ ਕਉ ਦੁਇ ਫਲ ਲਾਏ ॥",
      "transliteration": "sa(n)saar birakh kau dui phal laae ||",
      "translation": "He attached these two fruits to the world-plant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਆਪੇ ਕਰਤਾ ਕਰੇ ਕਰਾਏ ॥",
      "transliteration": "aape karataa kare karaae ||",
      "translation": "The Creator Himself is the Doer, the Cause of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਤਿਸੈ ਖਵਾਏ ॥੩॥",
      "transliteration": "jo tis bhaavai tisai khavaae ||3||",
      "translation": "He feeds all as He pleases. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਨਕ ਜਿਸ ਨੋ ਨਦਰਿ ਕਰੇਇ ॥",
      "transliteration": "naanak jis no nadar karei ||",
      "translation": "O Nanak, when He casts His Glance of Grace,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਆਪੇ ਦੇਇ ॥",
      "transliteration": "a(n)mrit naam aape dei ||",
      "translation": "He Himself bestows His Ambrosial Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਖਿਆ ਕੀ ਬਾਸਨਾ ਮਨਹਿ ਕਰੇਇ ॥",
      "transliteration": "bikhiaa kee baasanaa manahi karei ||",
      "translation": "Thus, the desire for sin and corruption is ended.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਪਣਾ ਭਾਣਾ ਆਪਿ ਕਰੇਇ ॥੪॥੧॥",
      "transliteration": "apanaa bhaanaa aap karei ||4||1||",
      "translation": "The Lord Himself carries out His Own Will. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰਾਤੇ ਸਾਚਿ ਹਰਿ ਨਾਮਿ ਨਿਹਾਲਾ ॥",
      "transliteration": "raate saach har naam nihaalaa ||",
      "translation": "Those who are attuned to the True Lord's Name are happy and exalted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਦਇਆ ਕਰਹੁ ਪ੍ਰਭ ਦੀਨ ਦਇਆਲਾ ॥",
      "transliteration": "daiaa karahu prabh deen daiaalaa ||",
      "translation": "Take pity on me, O God, Merciful to the meek.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਿਸੁ ਬਿਨੁ ਅਵਰੁ ਨਹੀ ਮੈ ਕੋਇ ॥",
      "transliteration": "tis bin avar nahee mai koi ||",
      "translation": "Without Him, I have no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਿਉ ਭਾਵੈ ਤਿਉ ਰਾਖੈ ਸੋਇ ॥੧॥",
      "transliteration": "jiu bhaavai tiu raakhai soi ||1||",
      "translation": "As it pleases His Will, He keeps me. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੁਰ ਗੋਪਾਲ ਮੇਰੈ ਮਨਿ ਭਾਏ ॥",
      "transliteration": "gur gopaal merai man bhaae ||",
      "translation": "The Guru, the Lord, is pleasing to my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਰਹਿ ਨ ਸਕਉ ਦਰਸਨ ਦੇਖੇ ਬਿਨੁ ਸਹਜਿ ਮਿਲਉ ਗੁਰੁ ਮੇਲਿ ਮਿਲਾਏ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "rahi na sakau darasan dekhe bin sahaj milau gur mel milaae ||1|| rahaau ||",
      "translation": "I cannot even survive, without the Blessed Vision of His Darshan. But I shall easily unite with the Guru, if He unites me in His Union. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਲੋਭੀ ਲੋਭਿ ਲੁਭਾਨਾ ॥",
      "transliteration": "ihu man lobhee lobh lubhaanaa ||",
      "translation": "The greedy mind is enticed by greed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਰਾਮ ਬਿਸਾਰਿ ਬਹੁਰਿ ਪਛੁਤਾਨਾ ॥",
      "transliteration": "raam bisaar bahur pachhutaanaa ||",
      "translation": "Forgetting the Lord, it regrets and repents in the end.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਿਛੁਰਤ ਮਿਲਾਇ ਗੁਰ ਸੇਵ ਰਾਂਗੇ ॥",
      "transliteration": "bichhurat milaai gur sev raa(n)ge ||",
      "translation": "The separated ones are reunited, when they are inspired to serve the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰਿ ਨਾਮੁ ਦੀਓ ਮਸਤਕਿ ਵਡਭਾਗੇ ॥੨॥",
      "transliteration": "har naam deeo masatak vadabhaage ||2||",
      "translation": "They are blessed with the Lord's Name - such is the destiny written on their foreheads. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਪਉਣ ਪਾਣੀ ਕੀ ਇਹ ਦੇਹ ਸਰੀਰਾ ॥",
      "transliteration": "paun paanee kee ih deh sareeraa ||",
      "translation": "This body is built of air and water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਉਮੈ ਰੋਗੁ ਕਠਿਨ ਤਨਿ ਪੀਰਾ ॥",
      "transliteration": "haumai rog kathin tan peeraa ||",
      "translation": "The body is afflicted with the terribly painful illness of egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਰਾਮ ਨਾਮ ਦਾਰੂ ਗੁਣ ਗਾਇਆ ॥",
      "transliteration": "guramukh raam naam daaroo gun gaaiaa ||",
      "translation": "The Gurmukh has the Medicine: singing the Glorious Praises of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਗੁਰਿ ਰੋਗੁ ਗਵਾਇਆ ॥੩॥",
      "transliteration": "kar kirapaa gur rog gavaaiaa ||3||",
      "translation": "Granting His Grace, the Guru has cured the illness. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਚਾਰਿ ਨਦੀਆ ਅਗਨੀ ਤਨਿ ਚਾਰੇ ॥",
      "transliteration": "chaar nadeeaa aganee tan chaare ||",
      "translation": "The four evils are the four rivers of fire flowing through the body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤ੍ਰਿਸਨਾ ਜਲਤ ਜਲੇ ਅਹੰਕਾਰੇ ॥",
      "transliteration": "trisanaa jalat jale aha(n)kaare ||",
      "translation": "It is burning in desire, and burning in egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਰਿ ਰਾਖੇ ਵਡਭਾਗੀ ਤਾਰੇ ॥",
      "transliteration": "gur raakhe vadabhaagee taare ||",
      "translation": "Those whom the Guru protects and saves are very fortunate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਉਰਿ ਹਰਿ ਅੰਮ੍ਰਿਤੁ ਧਾਰੇ ॥੪॥੨॥",
      "transliteration": "jan naanak ur har a(n)mrit dhaare ||4||2||",
      "translation": "Servant Nanak enshrines the Ambrosial Name of the Lord in his heart. ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਰਿ ਸੇਵੇ ਸੋ ਹਰਿ ਕਾ ਲੋਗੁ ॥",
      "transliteration": "har seve so har kaa log ||",
      "translation": "One who serves the Lord is the Lord's person.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਾਚੁ ਸਹਜੁ ਕਦੇ ਨ ਹੋਵੈ ਸੋਗੁ ॥",
      "transliteration": "saach sahaj kade na hovai sog ||",
      "translation": "He dwells in intuitive peace, and never suffers in sorrow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮਨਮੁਖ ਮੁਏ ਨਾਹੀ ਹਰਿ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "manamukh mue naahee har man maahi ||",
      "translation": "The self-willed manmukhs are dead; the Lord is not within their minds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਰਿ ਮਰਿ ਜੰਮਹਿ ਭੀ ਮਰਿ ਜਾਹਿ ॥੧॥",
      "transliteration": "mar mar ja(n)mahi bhee mar jaahi ||1||",
      "translation": "They die and die again and again, and are reincarnated, only to die once more. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੇ ਜਨ ਜੀਵੇ ਜਿਨ ਹਰਿ ਮਨ ਮਾਹਿ ॥",
      "transliteration": "se jan jeeve jin har man maahi ||",
      "translation": "They alone are alive, whose minds are filled with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਾਚੁ ਸਮੑਾਲਹਿ ਸਾਚਿ ਸਮਾਹਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saach samhaalahi saach samaahi ||1|| rahaau ||",
      "translation": "They contemplate the True Lord, and are absorbed in the True Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹਰਿ ਨ ਸੇਵਹਿ ਤੇ ਹਰਿ ਤੇ ਦੂਰਿ ॥",
      "transliteration": "har na sevahi te har te door ||",
      "translation": "Those who do not serve the Lord are far away from the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਦਿਸੰਤਰੁ ਭਵਹਿ ਸਿਰਿ ਪਾਵਹਿ ਧੂਰਿ ॥",
      "transliteration": "disa(n)tar bhavahi sir paavahi dhoor ||",
      "translation": "They wander in foreign lands, with dust thrown on their heads.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਹਰਿ ਆਪੇ ਜਨ ਲੀਏ ਲਾਇ ॥",
      "transliteration": "har aape jan leee laai ||",
      "translation": "The Lord Himself enjoins His humble servants to serve Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1172_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤਿਨ ਸਦਾ ਸੁਖੁ ਹੈ ਤਿਲੁ ਨ ਤਮਾਇ ॥੨॥",
      "transliteration": "tin sadaa sukh hai til na tamaai ||2||",
      "translation": "They live in peace forever, and have no greed at all. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1172,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
