{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1173,
  "lineCount": 59,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1173_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਦਰਿ ਕਰੇ ਚੂਕੈ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "nadar kare chookai abhimaan ||",
      "translation": "When the Lord bestows His Glance of Grace, egotism is eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਚੀ ਦਰਗਹ ਪਾਵੈ ਮਾਨੁ ॥",
      "transliteration": "saachee daragah paavai maan ||",
      "translation": "Then, the mortal is honored in the Court of the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਰਿ ਜੀਉ ਵੇਖੈ ਸਦ ਹਜੂਰਿ ॥",
      "transliteration": "har jeeu vekhai sad hajoor ||",
      "translation": "He sees the Dear Lord always close at hand, ever-present.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਰਹਿਆ ਭਰਪੂਰਿ ॥੩॥",
      "transliteration": "gur kai sabad rahiaa bharapoor ||3||",
      "translation": "Through the Word of the Guru's Shabad, he sees the Lord pervading and permeating all. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਕੀ ਕਰੇ ਪ੍ਰਤਿਪਾਲ ॥",
      "transliteration": "jee ja(n)t kee kare pratipaal ||",
      "translation": "The Lord cherishes all beings and creatures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਸਦ ਸਮੑਾਲ ॥",
      "transliteration": "gur parasaadee sad samhaal ||",
      "translation": "By Guru's Grace, contemplate Him forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਦਰਿ ਸਾਚੈ ਪਤਿ ਸਿਉ ਘਰਿ ਜਾਇ ॥",
      "transliteration": "dar saachai pat siu ghar jaai ||",
      "translation": "You shall go to your true home in the Lord's Court with honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਵਡਾਈ ਪਾਇ ॥੪॥੩॥",
      "transliteration": "naanak naam vadaaee paai ||4||3||",
      "translation": "O Nanak, through the Naam, the Name of the Lord, you shall be blessed with glorious greatness. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅੰਤਰਿ ਪੂਜਾ ਮਨ ਤੇ ਹੋਇ ॥",
      "transliteration": "a(n)tar poojaa man te hoi ||",
      "translation": "One who worships the Lord within his mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਏਕੋ ਵੇਖੈ ਅਉਰੁ ਨ ਕੋਇ ॥",
      "transliteration": "eko vekhai aur na koi ||",
      "translation": "sees the One and Only Lord, and no other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਦੂਜੈ ਲੋਕੀ ਬਹੁਤੁ ਦੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "doojai lokee bahut dukh paaiaa ||",
      "translation": "People in duality suffer terrible pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਮੈਨੋ ਏਕੁ ਦਿਖਾਇਆ ॥੧॥",
      "transliteration": "satigur maino ek dikhaaiaa ||1||",
      "translation": "The True Guru has shown me the One Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੇਰਾ ਪ੍ਰਭੁ ਮਉਲਿਆ ਸਦ ਬਸੰਤੁ ॥",
      "transliteration": "meraa prabh mauliaa sad basa(n)t ||",
      "translation": "My God is in bloom, forever in spring.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਮਉਲਿਆ ਗਾਇ ਗੁਣ ਗੋਬਿੰਦ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ihu man mauliaa gaai gun gobi(n)d ||1|| rahaau ||",
      "translation": "This mind blossoms forth, singing the Glorious Praises of the Lord of the Universe. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰ ਪੂਛਹੁ ਤੁਮੑ ਕਰਹੁ ਬੀਚਾਰੁ ॥",
      "transliteration": "gur poochhahu tumh karahu beechaar ||",
      "translation": "So consult the Guru, and reflect upon His wisdom;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਾਂ ਪ੍ਰਭ ਸਾਚੇ ਲਗੈ ਪਿਆਰੁ ॥",
      "transliteration": "taa(n) prabh saache lagai piaar ||",
      "translation": "then, you shall be in love with the True Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਪੁ ਛੋਡਿ ਹੋਹਿ ਦਾਸਤ ਭਾਇ ॥",
      "transliteration": "aap chhod hohi daasat bhaai ||",
      "translation": "Abandon your self-conceit, and be His loving servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤਉ ਜਗਜੀਵਨੁ ਵਸੈ ਮਨਿ ਆਇ ॥੨॥",
      "transliteration": "tau jagajeevan vasai man aai ||2||",
      "translation": "Then, the Life of the World shall come to dwell in your mind. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਭਗਤਿ ਕਰੇ ਸਦ ਵੇਖੈ ਹਜੂਰਿ ॥",
      "transliteration": "bhagat kare sad vekhai hajoor ||",
      "translation": "Worship Him with devotion, and see Him always ever-present, close at hand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮੇਰਾ ਪ੍ਰਭੁ ਸਦ ਰਹਿਆ ਭਰਪੂਰਿ ॥",
      "transliteration": "meraa prabh sad rahiaa bharapoor ||",
      "translation": "My God is forever permeating and pervading all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਇਸੁ ਭਗਤੀ ਕਾ ਕੋਈ ਜਾਣੈ ਭੇਉ ॥",
      "transliteration": "is bhagatee kaa koee jaanai bheu ||",
      "translation": "Only a rare few know the mystery of this devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਭੁ ਮੇਰਾ ਪ੍ਰਭੁ ਆਤਮ ਦੇਉ ॥੩॥",
      "transliteration": "sabh meraa prabh aatam deu ||3||",
      "translation": "My God is the Enlightener of all souls. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਪੇ ਸਤਿਗੁਰੁ ਮੇਲਿ ਮਿਲਾਏ ॥",
      "transliteration": "aape satigur mel milaae ||",
      "translation": "The True Guru Himself unites us in His Union.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਗਜੀਵਨ ਸਿਉ ਆਪਿ ਚਿਤੁ ਲਾਏ ॥",
      "transliteration": "jagajeevan siu aap chit laae ||",
      "translation": "He Himself links our consciousness to the Lord, the Life of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਹਰਿਆ ਸਹਜਿ ਸੁਭਾਏ ॥",
      "transliteration": "man tan hariaa sahaj subhaae ||",
      "translation": "Thus, our minds and bodies are rejuvenated with intuitive ease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਰਹੇ ਲਿਵ ਲਾਏ ॥੪॥੪॥",
      "transliteration": "naanak naam rahe liv laae ||4||4||",
      "translation": "O Nanak, through the Naam, the Name of the Lord, we remain attuned to the String of His Love. ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਭਗਤਿ ਵਛਲੁ ਹਰਿ ਵਸੈ ਮਨਿ ਆਇ ॥",
      "transliteration": "bhagat vachhal har vasai man aai ||",
      "translation": "The Lord is the Lover of His devotees; He dwells within their minds,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਸਹਜ ਸੁਭਾਇ ॥",
      "transliteration": "gur kirapaa te sahaj subhaai ||",
      "translation": "by Guru's Grace, with intuitive ease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਭਗਤਿ ਕਰੇ ਵਿਚਹੁ ਆਪੁ ਖੋਇ ॥",
      "transliteration": "bhagat kare vichahu aap khoi ||",
      "translation": "Through devotional worship, self-conceit is eradicated from within,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਦ ਹੀ ਸਾਚਿ ਮਿਲਾਵਾ ਹੋਇ ॥੧॥",
      "transliteration": "tad hee saach milaavaa hoi ||1||",
      "translation": "and then, one meets the True Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਭਗਤ ਸੋਹਹਿ ਸਦਾ ਹਰਿ ਪ੍ਰਭ ਦੁਆਰਿ ॥",
      "transliteration": "bhagat sohahi sadaa har prabh duaar ||",
      "translation": "His devotees are forever beauteous at the Door of the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰ ਕੈ ਹੇਤਿ ਸਾਚੈ ਪ੍ਰੇਮ ਪਿਆਰਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur kai het saachai prem piaar ||1|| rahaau ||",
      "translation": "Loving the Guru, they have love and affection for the True Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਭਗਤਿ ਕਰੇ ਸੋ ਜਨੁ ਨਿਰਮਲੁ ਹੋਇ ॥",
      "transliteration": "bhagat kare so jan niramal hoi ||",
      "translation": "That humble being who worships the Lord with devotion becomes immaculate and pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰਸਬਦੀ ਵਿਚਹੁ ਹਉਮੈ ਖੋਇ ॥",
      "transliteration": "gurasabadee vichahu haumai khoi ||",
      "translation": "Through the Word of the Guru's Shabad, egotism is eradicated from within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਰਿ ਜੀਉ ਆਪਿ ਵਸੈ ਮਨਿ ਆਇ ॥",
      "transliteration": "har jeeu aap vasai man aai ||",
      "translation": "The Dear Lord Himself comes to dwell within the mind,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਦਾ ਸਾਂਤਿ ਸੁਖਿ ਸਹਜਿ ਸਮਾਇ ॥੨॥",
      "transliteration": "sadaa saa(n)t sukh sahaj samaai ||2||",
      "translation": "and the mortal remains immersed in peace, tranquility and intuitive ease. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਾਚਿ ਰਤੇ ਤਿਨ ਸਦ ਬਸੰਤ ॥",
      "transliteration": "saach rate tin sad basa(n)t ||",
      "translation": "Those who are imbued with Truth, are forever in the bloom of spring.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਹਰਿਆ ਰਵਿ ਗੁਣ ਗੁਵਿੰਦ ॥",
      "transliteration": "man tan hariaa rav gun guvi(n)d ||",
      "translation": "Their minds and bodies are rejuvenated, uttering the Glorious Praises of the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਸੂਕਾ ਸੰਸਾਰੁ ॥",
      "transliteration": "bin naavai sookaa sa(n)saar ||",
      "translation": "Without the Lord's Name, the world is dry and parched.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਅਗਨਿ ਤ੍ਰਿਸਨਾ ਜਲੈ ਵਾਰੋ ਵਾਰ ॥੩॥",
      "transliteration": "agan trisanaa jalai vaaro vaar ||3||",
      "translation": "It burns in the fire of desire, over and over again. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸੋਈ ਕਰੇ ਜਿ ਹਰਿ ਜੀਉ ਭਾਵੈ ॥",
      "transliteration": "soee kare j har jeeu bhaavai ||",
      "translation": "One who does only that which is pleasing to the Dear Lord",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਦਾ ਸੁਖੁ ਸਰੀਰਿ ਭਾਣੈ ਚਿਤੁ ਲਾਵੈ ॥",
      "transliteration": "sadaa sukh sareer bhaanai chit laavai ||",
      "translation": "- his body is forever at peace, and his consciousness is attached to the Lord's Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਪਣਾ ਪ੍ਰਭੁ ਸੇਵੇ ਸਹਜਿ ਸੁਭਾਇ ॥",
      "transliteration": "apanaa prabh seve sahaj subhaai ||",
      "translation": "He serves His God with intuitive ease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਵਸੈ ਮਨਿ ਆਇ ॥੪॥੫॥",
      "transliteration": "naanak naam vasai man aai ||4||5||",
      "translation": "O Nanak, the Naam, the Name of the Lord, comes to abide in his mind. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਾਇਆ ਮੋਹੁ ਸਬਦਿ ਜਲਾਏ ॥",
      "transliteration": "maaiaa mohu sabad jalaae ||",
      "translation": "Attachment to Maya is burnt away by the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਹਰਿਆ ਸਤਿਗੁਰ ਭਾਏ ॥",
      "transliteration": "man tan hariaa satigur bhaae ||",
      "translation": "The mind and body are rejuvenated by the Love of the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਫਲਿਓੁ ਬਿਰਖੁ ਹਰਿ ਕੈ ਦੁਆਰਿ ॥",
      "transliteration": "saphaliou birakh har kai duaar ||",
      "translation": "The tree bears fruit at the Lord's Door,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸਾਚੀ ਬਾਣੀ ਨਾਮ ਪਿਆਰਿ ॥੧॥",
      "transliteration": "saachee baanee naam piaar ||1||",
      "translation": "in love with the True Bani of the Guru's Word, and the Naam, the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਏ ਮਨ ਹਰਿਆ ਸਹਜ ਸੁਭਾਇ ॥",
      "transliteration": "e man hariaa sahaj subhaai ||",
      "translation": "This mind is rejuvenated, with intuitive ease;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਚ ਫਲੁ ਲਾਗੈ ਸਤਿਗੁਰ ਭਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sach phal laagai satigur bhaai ||1|| rahaau ||",
      "translation": "loving the True Guru, it bears the fruit of truth. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਆਪੇ ਨੇੜੈ ਆਪੇ ਦੂਰਿ ॥",
      "transliteration": "aape neRai aape door ||",
      "translation": "He Himself is near, and He Himself is far away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਵੇਖੈ ਸਦ ਹਜੂਰਿ ॥",
      "transliteration": "gur kai sabad vekhai sad hajoor ||",
      "translation": "Through the Word of the Guru's Shabad, He is seen to be ever-present, close at hand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਛਾਵ ਘਣੀ ਫੂਲੀ ਬਨਰਾਇ ॥",
      "transliteration": "chhaav ghanee phoolee banaraai ||",
      "translation": "The plants have blossomed forth, giving a dense shade.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਬਿਗਸੈ ਸਹਜਿ ਸੁਭਾਇ ॥੨॥",
      "transliteration": "guramukh bigasai sahaj subhaai ||2||",
      "translation": "The Gurmukh blossoms forth, with intuitive ease. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਅਨਦਿਨੁ ਕੀਰਤਨੁ ਕਰਹਿ ਦਿਨ ਰਾਤਿ ॥",
      "transliteration": "anadin keeratan karahi din raat ||",
      "translation": "Night and day, he sings the Kirtan of the Lord's Praises, day and night.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1173_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਗਵਾਈ ਵਿਚਹੁ ਜੂਠਿ ਭਰਾਂਤਿ ॥",
      "transliteration": "satigur gavaaee vichahu jooth bharaa(n)t ||",
      "translation": "The True Guru drives out sin and doubt from within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1173,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
