{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1174,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1174_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪਰਪੰਚ ਵੇਖਿ ਰਹਿਆ ਵਿਸਮਾਦੁ ॥",
      "transliteration": "parapa(n)ch vekh rahiaa visamaad ||",
      "translation": "Gazing upon the wonder of God's Creation, I am wonder-struck and amazed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਪਾਈਐ ਨਾਮ ਪ੍ਰਸਾਦੁ ॥੩॥",
      "transliteration": "guramukh paaeeai naam prasaad ||3||",
      "translation": "The Gurmukh obtains the Naam, the Name of the Lord, by His Grace. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਪੇ ਕਰਤਾ ਸਭਿ ਰਸ ਭੋਗ ॥",
      "transliteration": "aape karataa sabh ras bhog ||",
      "translation": "The Creator Himself enjoys all delights.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕਰੇ ਸੋਈ ਪਰੁ ਹੋਗ ॥",
      "transliteration": "jo kichh kare soee par hog ||",
      "translation": "Whatever He does, surely comes to pass.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਵਡਾ ਦਾਤਾ ਤਿਲੁ ਨ ਤਮਾਇ ॥",
      "transliteration": "vadaa daataa til na tamaai ||",
      "translation": "He is the Great Giver; He has no greed at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਨਕ ਮਿਲੀਐ ਸਬਦੁ ਕਮਾਇ ॥੪॥੬॥",
      "transliteration": "naanak mileeai sabad kamaai ||4||6||",
      "translation": "O Nanak, living the Word of the Shabad, the mortal meets with God. ||4||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪੂਰੈ ਭਾਗਿ ਸਚੁ ਕਾਰ ਕਮਾਵੈ ॥",
      "transliteration": "poorai bhaag sach kaar kamaavai ||",
      "translation": "By perfect destiny, one acts in truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਏਕੋ ਚੇਤੈ ਫਿਰਿ ਜੋਨਿ ਨ ਆਵੈ ॥",
      "transliteration": "eko chetai phir jon na aavai ||",
      "translation": "Remembering the One Lord, one does not have to enter the cycle of reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਫਲ ਜਨਮੁ ਇਸੁ ਜਗ ਮਹਿ ਆਇਆ ॥",
      "transliteration": "saphal janam is jag mahi aaiaa ||",
      "translation": "Fruitful is the coming into the world, and the life of one",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਾਚਿ ਨਾਮਿ ਸਹਜਿ ਸਮਾਇਆ ॥੧॥",
      "transliteration": "saach naam sahaj samaaiaa ||1||",
      "translation": "who remains intuitively absorbed in the True Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਕਾਰ ਕਰਹੁ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "guramukh kaar karahu liv laai ||",
      "translation": "The Gurmukh acts, lovingly attuned to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਰਿ ਨਾਮੁ ਸੇਵਹੁ ਵਿਚਹੁ ਆਪੁ ਗਵਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har naam sevahu vichahu aap gavaai ||1|| rahaau ||",
      "translation": "Be dedicated to the Lord's Name, and eradicate self-conceit from within. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਕੀ ਹੈ ਸਾਚੀ ਬਾਣੀ ॥",
      "transliteration": "tis jan kee hai saachee baanee ||",
      "translation": "True is the speech of that humble being;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਜਗ ਮਾਹਿ ਸਮਾਣੀ ॥",
      "transliteration": "gur kai sabad jag maahi samaanee ||",
      "translation": "through the Word of the Guru's Shabad, it is spread throughout the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਚਹੁ ਜੁਗ ਪਸਰੀ ਸਾਚੀ ਸੋਇ ॥",
      "transliteration": "chahu jug pasaree saachee soi ||",
      "translation": "Throughout the four ages, his fame and glory spread.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਨਾਮਿ ਰਤਾ ਜਨੁ ਪਰਗਟੁ ਹੋਇ ॥੨॥",
      "transliteration": "naam rataa jan paragat hoi ||2||",
      "translation": "Imbued with the Naam, the Name of the Lord, the Lord's humble servant is recognized and renowned. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਇਕਿ ਸਾਚੈ ਸਬਦਿ ਰਹੇ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "ik saachai sabad rahe liv laai ||",
      "translation": "Some remain lovingly attuned to the True Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੇ ਜਨ ਸਾਚੇ ਸਾਚੈ ਭਾਇ ॥",
      "transliteration": "se jan saache saachai bhaai ||",
      "translation": "True are those humble beings who love the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਾਚੁ ਧਿਆਇਨਿ ਦੇਖਿ ਹਜੂਰਿ ॥",
      "transliteration": "saach dhiaain dekh hajoor ||",
      "translation": "They meditate on the True Lord, and behold Him near at hand, ever-present.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਕੀ ਪਗ ਪੰਕਜ ਧੂਰਿ ॥੩॥",
      "transliteration": "sa(n)t janaa kee pag pa(n)kaj dhoor ||3||",
      "translation": "They are the dust of the lotus feet of the humble Saints. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਏਕੋ ਕਰਤਾ ਅਵਰੁ ਨ ਕੋਇ ॥",
      "transliteration": "eko karataa avar na koi ||",
      "translation": "There is only One Creator Lord; there is no other at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਰਸਬਦੀ ਮੇਲਾਵਾ ਹੋਇ ॥",
      "transliteration": "gurasabadee melaavaa hoi ||",
      "translation": "Through the Word of the Guru's Shabad, comes Union with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਿਨਿ ਸਚੁ ਸੇਵਿਆ ਤਿਨਿ ਰਸੁ ਪਾਇਆ ॥",
      "transliteration": "jin sach seviaa tin ras paaiaa ||",
      "translation": "Whoever serves the True Lord finds joy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਨਕ ਸਹਜੇ ਨਾਮਿ ਸਮਾਇਆ ॥੪॥੭॥",
      "transliteration": "naanak sahaje naam samaaiaa ||4||7||",
      "translation": "O Nanak, he is intuitively absorbed in the Naam, the Name of the Lord. ||4||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਭਗਤਿ ਕਰਹਿ ਜਨ ਦੇਖਿ ਹਜੂਰਿ ॥",
      "transliteration": "bhagat karahi jan dekh hajoor ||",
      "translation": "The Lord's humble servant worships Him, and beholds Him ever-present, near at hand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਕੀ ਪਗ ਪੰਕਜ ਧੂਰਿ ॥",
      "transliteration": "sa(n)t janaa kee pag pa(n)kaj dhoor ||",
      "translation": "He is the dust of the lotus feet of the humble Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਰਿ ਸੇਤੀ ਸਦ ਰਹਹਿ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "har setee sad rahahi liv laai ||",
      "translation": "Those who remain lovingly attuned to the Lord forever",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪੂਰੈ ਸਤਿਗੁਰਿ ਦੀਆ ਬੁਝਾਇ ॥੧॥",
      "transliteration": "poorai satigur deeaa bujhaai ||1||",
      "translation": "are blessed with understanding by the Perfect True Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦਾਸਾ ਕਾ ਦਾਸੁ ਵਿਰਲਾ ਕੋਈ ਹੋਇ ॥",
      "transliteration": "daasaa kaa daas viralaa koee hoi ||",
      "translation": "How rare are those who become the slave of the Lord's slaves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਊਤਮ ਪਦਵੀ ਪਾਵੈ ਸੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ootam padavee paavai soi ||1|| rahaau ||",
      "translation": "They attain the supreme status. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਏਕੋ ਸੇਵਹੁ ਅਵਰੁ ਨ ਕੋਇ ॥",
      "transliteration": "eko sevahu avar na koi ||",
      "translation": "So serve the One Lord, and no other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਿਤੁ ਸੇਵਿਐ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "jit seviai sadaa sukh hoi ||",
      "translation": "Serving Him, eternal peace is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾ ਓਹੁ ਮਰੈ ਨ ਆਵੈ ਜਾਇ ॥",
      "transliteration": "naa ohu marai na aavai jaai ||",
      "translation": "He does not die; He does not come and go in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤਿਸੁ ਬਿਨੁ ਅਵਰੁ ਸੇਵੀ ਕਿਉ ਮਾਇ ॥੨॥",
      "transliteration": "tis bin avar sevee kiu maai ||2||",
      "translation": "Why should I serve any other than Him, O my mother? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੇ ਜਨ ਸਾਚੇ ਜਿਨੀ ਸਾਚੁ ਪਛਾਣਿਆ ॥",
      "transliteration": "se jan saache jinee saach pachhaaniaa ||",
      "translation": "True are those humble beings who realize the True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਪੁ ਮਾਰਿ ਸਹਜੇ ਨਾਮਿ ਸਮਾਣਿਆ ॥",
      "transliteration": "aap maar sahaje naam samaaniaa ||",
      "translation": "Conquering their self-conceit, they merge intuitively into the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਮੁ ਪਰਾਪਤਿ ਹੋਇ ॥",
      "transliteration": "guramukh naam paraapat hoi ||",
      "translation": "The Gurmukhs gather in the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਨੁ ਨਿਰਮਲੁ ਨਿਰਮਲ ਸਚੁ ਸੋਇ ॥੩॥",
      "transliteration": "man niramal niramal sach soi ||3||",
      "translation": "Their minds are immaculate, and their reputations are immaculate. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਜਿਨਿ ਗਿਆਨੁ ਕੀਆ ਤਿਸੁ ਹਰਿ ਤੂ ਜਾਣੁ ॥",
      "transliteration": "jin giaan keeaa tis har too jaan ||",
      "translation": "Know the Lord, who gave you spiritual wisdom,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਾਚ ਸਬਦਿ ਪ੍ਰਭੁ ਏਕੁ ਸਿਞਾਣੁ ॥",
      "transliteration": "saach sabad prabh ek sinjaan ||",
      "translation": "and realize the One God, through the True Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਰਿ ਰਸੁ ਚਾਖੈ ਤਾਂ ਸੁਧਿ ਹੋਇ ॥",
      "transliteration": "har ras chaakhai taa(n) sudh hoi ||",
      "translation": "When the mortal tastes the sublime essence of the Lord, he becomes pure and holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ ਸਚੁ ਸੋਇ ॥੪॥੮॥",
      "transliteration": "naanak naam rate sach soi ||4||8||",
      "translation": "O Nanak, those who are imbued with the Naam - their reputations are true. ||4||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਕੁਲਾਂ ਕਾ ਕਰਹਿ ਉਧਾਰੁ ॥",
      "transliteration": "naam rate kulaa(n) kaa karahi udhaar ||",
      "translation": "Those who are imbued with the Naam, the Name of the Lord - their generations are redeemed and saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਾਚੀ ਬਾਣੀ ਨਾਮ ਪਿਆਰੁ ॥",
      "transliteration": "saachee baanee naam piaar ||",
      "translation": "True is their speech; they love the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਨਮੁਖ ਭੂਲੇ ਕਾਹੇ ਆਏ ॥",
      "transliteration": "manamukh bhoole kaahe aae ||",
      "translation": "Why have the wandering self-willed manmukhs even come into the world?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਮਹੁ ਭੂਲੇ ਜਨਮੁ ਗਵਾਏ ॥੧॥",
      "transliteration": "naamahu bhoole janam gavaae ||1||",
      "translation": "Forgetting the Naam, the mortals waste their lives away. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜੀਵਤ ਮਰੈ ਮਰਿ ਮਰਣੁ ਸਵਾਰੈ ॥",
      "transliteration": "jeevat marai mar maran savaarai ||",
      "translation": "One who dies while yet alive, truly dies, and embellishes his death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਸਾਚੁ ਉਰ ਧਾਰੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur kai sabad saach ur dhaarai ||1|| rahaau ||",
      "translation": "Through the Word of the Guru's Shabad, he enshrines the True Lord within his heart. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਚੁ ਭੋਜਨੁ ਪਵਿਤੁ ਸਰੀਰਾ ॥",
      "transliteration": "guramukh sach bhojan pavit sareeraa ||",
      "translation": "Truth is the food of the Gurmukh; his body is sanctified and pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਨੁ ਨਿਰਮਲੁ ਸਦ ਗੁਣੀ ਗਹੀਰਾ ॥",
      "transliteration": "man niramal sad gunee gaheeraa ||",
      "translation": "His mind is immaculate; he is forever the ocean of virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜੰਮੈ ਮਰੈ ਨ ਆਵੈ ਜਾਇ ॥",
      "transliteration": "ja(n)mai marai na aavai jaai ||",
      "translation": "He is not forced to come and go in the cycle of birth and death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਸਾਚਿ ਸਮਾਇ ॥੨॥",
      "transliteration": "gur parasaadee saach samaai ||2||",
      "translation": "By Guru's Grace, he merges in the True Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਾਚਾ ਸੇਵਹੁ ਸਾਚੁ ਪਛਾਣੈ ॥",
      "transliteration": "saachaa sevahu saach pachhaanai ||",
      "translation": "Serving the True Lord, one realizes Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1174_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਹਰਿ ਦਰਿ ਨੀਸਾਣੈ ॥",
      "transliteration": "gur kai sabad har dar neesaanai ||",
      "translation": "Through the Word of the Guru's Shabad, he goes to the Lord's Court with his banners flying proudly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1174,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
