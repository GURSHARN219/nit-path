{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1175,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1175_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦਰਿ ਸਾਚੈ ਸਚੁ ਸੋਭਾ ਹੋਇ ॥",
      "transliteration": "dar saachai sach sobhaa hoi ||",
      "translation": "In the Court of the True Lord, he obtains true glory.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਿਜ ਘਰਿ ਵਾਸਾ ਪਾਵੈ ਸੋਇ ॥੩॥",
      "transliteration": "nij ghar vaasaa paavai soi ||3||",
      "translation": "He comes to dwell in the home of his own inner being. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਪਿ ਅਭੁਲੁ ਸਚਾ ਸਚੁ ਸੋਇ ॥",
      "transliteration": "aap abhul sachaa sach soi ||",
      "translation": "He cannot be fooled; He is the Truest of the True.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹੋਰਿ ਸਭਿ ਭੂਲਹਿ ਦੂਜੈ ਪਤਿ ਖੋਇ ॥",
      "transliteration": "hor sabh bhoolahi doojai pat khoi ||",
      "translation": "All others are deluded; in duality, they lose their honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਚਾ ਸੇਵਹੁ ਸਾਚੀ ਬਾਣੀ ॥",
      "transliteration": "saachaa sevahu saachee baanee ||",
      "translation": "So serve the True Lord, through the True Bani of His Word.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੇ ਸਾਚਿ ਸਮਾਣੀ ॥੪॥੯॥",
      "transliteration": "naanak naame saach samaanee ||4||9||",
      "translation": "O Nanak, through the Naam, merge in the True Lord. ||4||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਿਨੁ ਕਰਮਾ ਸਭ ਭਰਮਿ ਭੁਲਾਈ ॥",
      "transliteration": "bin karamaa sabh bharam bhulaaee ||",
      "translation": "Without the grace of good karma, all are deluded by doubt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਾਇਆ ਮੋਹਿ ਬਹੁਤੁ ਦੁਖੁ ਪਾਈ ॥",
      "transliteration": "maaiaa mohi bahut dukh paaee ||",
      "translation": "In attachment to Maya, they suffer in terrible pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨਮੁਖ ਅੰਧੇ ਠਉਰ ਨ ਪਾਈ ॥",
      "transliteration": "manamukh a(n)dhe thaur na paaee ||",
      "translation": "The blind, self-willed manmukhs find no place of rest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਸਟਾ ਕਾ ਕੀੜਾ ਬਿਸਟਾ ਮਾਹਿ ਸਮਾਈ ॥੧॥",
      "transliteration": "bisataa kaa keeRaa bisataa maahi samaaee ||1||",
      "translation": "They are like maggots in manure, rotting away in manure. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹੁਕਮੁ ਮੰਨੇ ਸੋ ਜਨੁ ਪਰਵਾਣੁ ॥",
      "transliteration": "hukam ma(n)ne so jan paravaan ||",
      "translation": "That humble being who obeys the Hukam of the Lord's Command is accepted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਨਾਮਿ ਨੀਸਾਣੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur kai sabad naam neesaan ||1|| rahaau ||",
      "translation": "Through the Word of the Guru's Shabad, he is blessed with the insignia and the banner of the Naam, the Name of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਾਚਿ ਰਤੇ ਜਿਨੑਾ ਧੁਰਿ ਲਿਖਿ ਪਾਇਆ ॥",
      "transliteration": "saach rate jinhaa dhur likh paaiaa ||",
      "translation": "Those who have such pre-ordained destiny are imbued with the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਸਦਾ ਮਨਿ ਭਾਇਆ ॥",
      "transliteration": "har kaa naam sadaa man bhaaiaa ||",
      "translation": "The Name of the Lord is forever pleasing to their minds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਤਿਗੁਰ ਕੀ ਬਾਣੀ ਸਦਾ ਸੁਖੁ ਹੋਇ ॥",
      "transliteration": "satigur kee baanee sadaa sukh hoi ||",
      "translation": "Through the Bani, the Word of the True Guru, eternal peace is found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜੋਤੀ ਜੋਤਿ ਮਿਲਾਏ ਸੋਇ ॥੨॥",
      "transliteration": "jotee jot milaae soi ||2||",
      "translation": "Through it, one's light merges into the Light. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਏਕੁ ਨਾਮੁ ਤਾਰੇ ਸੰਸਾਰੁ ॥",
      "transliteration": "ek naam taare sa(n)saar ||",
      "translation": "Only the Naam, the Name of the Lord, can save the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਨਾਮ ਪਿਆਰੁ ॥",
      "transliteration": "gur parasaadee naam piaar ||",
      "translation": "By Guru's Grace, one comes to love the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਨੁ ਨਾਮੈ ਮੁਕਤਿ ਕਿਨੈ ਨ ਪਾਈ ॥",
      "transliteration": "bin naamai mukat kinai na paaee ||",
      "translation": "Without the Naam, no one obtains liberation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਤੇ ਨਾਮੁ ਪਲੈ ਪਾਈ ॥੩॥",
      "transliteration": "poore gur te naam palai paaee ||3||",
      "translation": "Through the Perfect Guru, the Naam is obtained. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੋ ਬੂਝੈ ਜਿਸੁ ਆਪਿ ਬੁਝਾਏ ॥",
      "transliteration": "so boojhai jis aap bujhaae ||",
      "translation": "He alone understands, whom the Lord Himself causes to understand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਤਿਗੁਰ ਸੇਵਾ ਨਾਮੁ ਦ੍ਰਿੜੑਾਏ ॥",
      "transliteration": "satigur sevaa naam driRhaae ||",
      "translation": "Serving the True Guru, the Naam is implanted within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਿਨ ਇਕੁ ਜਾਤਾ ਸੇ ਜਨ ਪਰਵਾਣੁ ॥",
      "transliteration": "jin ik jaataa se jan paravaan ||",
      "translation": "Those humble beings who know the One Lord are approved and accepted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਰਤੇ ਦਰਿ ਨੀਸਾਣੁ ॥੪॥੧੦॥",
      "transliteration": "naanak naam rate dar neesaan ||4||10||",
      "translation": "O Nanak, imbued with the Naam, they go to the Lord's Court with His banner and insignia. ||4||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਕਰੇ ਸਤਿਗੁਰੂ ਮਿਲਾਏ ॥",
      "transliteration": "kripaa kare satiguroo milaae ||",
      "translation": "Granting His Grace, the Lord leads the mortal to meet the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਆਪੇ ਆਪਿ ਵਸੈ ਮਨਿ ਆਏ ॥",
      "transliteration": "aape aap vasai man aae ||",
      "translation": "The Lord Himself comes to abide in his mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਿਹਚਲ ਮਤਿ ਸਦਾ ਮਨ ਧੀਰ ॥",
      "transliteration": "nihachal mat sadaa man dheer ||",
      "translation": "His intellect becomes steady and stable, and his mind is strengthened forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਹਰਿ ਗੁਣ ਗਾਵੈ ਗੁਣੀ ਗਹੀਰ ॥੧॥",
      "transliteration": "har gun gaavai gunee gaheer ||1||",
      "translation": "He sings the Glorious Praises of the Lord, the Ocean of Virtue. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਨਾਮਹੁ ਭੂਲੇ ਮਰਹਿ ਬਿਖੁ ਖਾਇ ॥",
      "transliteration": "naamahu bhoole marahi bikh khaai ||",
      "translation": "Those who forget the Naam, the Name of the Lord - those mortals die eating poison.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬ੍ਰਿਥਾ ਜਨਮੁ ਫਿਰਿ ਆਵਹਿ ਜਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "brithaa janam phir aavahi jaai ||1|| rahaau ||",
      "translation": "Their lives are wasted uselessly, and they continue coming and going in reincarnation. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਹੁ ਭੇਖ ਕਰਹਿ ਮਨਿ ਸਾਂਤਿ ਨ ਹੋਇ ॥",
      "transliteration": "bahu bhekh karahi man saa(n)t na hoi ||",
      "translation": "They wear all sorts of religious robes, but their minds are not at peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਹੁ ਅਭਿਮਾਨਿ ਅਪਣੀ ਪਤਿ ਖੋਇ ॥",
      "transliteration": "bahu abhimaan apanee pat khoi ||",
      "translation": "In great egotism, they lose their honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੇ ਵਡਭਾਗੀ ਜਿਨ ਸਬਦੁ ਪਛਾਣਿਆ ॥",
      "transliteration": "se vadabhaagee jin sabad pachhaaniaa ||",
      "translation": "But those who realize the Word of the Shabad, are blessed by great good fortune.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਾਹਰਿ ਜਾਦਾ ਘਰ ਮਹਿ ਆਣਿਆ ॥੨॥",
      "transliteration": "baahar jaadaa ghar mahi aaniaa ||2||",
      "translation": "They bring their distractible minds back home. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਘਰ ਮਹਿ ਵਸਤੁ ਅਗਮ ਅਪਾਰਾ ॥",
      "transliteration": "ghar mahi vasat agam apaaraa ||",
      "translation": "Within the home of the inner self is the inaccessible and infinite substance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗੁਰਮਤਿ ਖੋਜਹਿ ਸਬਦਿ ਬੀਚਾਰਾ ॥",
      "transliteration": "guramat khojahi sabad beechaaraa ||",
      "translation": "Those who find it, by following the Guru's Teachings, contemplate the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਮੁ ਨਵ ਨਿਧਿ ਪਾਈ ਘਰ ਹੀ ਮਾਹਿ ॥",
      "transliteration": "naam nav nidh paaee ghar hee maahi ||",
      "translation": "Those who obtain the nine treasures of the Naam within the home of their own inner being,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਦਾ ਰੰਗਿ ਰਾਤੇ ਸਚਿ ਸਮਾਹਿ ॥੩॥",
      "transliteration": "sadaa ra(n)g raate sach samaahi ||3||",
      "translation": "are forever dyed in the color of the Lord's Love; they are absorbed in the Truth. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਪਿ ਕਰੇ ਕਿਛੁ ਕਰਣੁ ਨ ਜਾਇ ॥",
      "transliteration": "aap kare kichh karan na jaai ||",
      "translation": "God Himself does everything; no one can do anything at all by himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਆਪੇ ਭਾਵੈ ਲਏ ਮਿਲਾਇ ॥",
      "transliteration": "aape bhaavai lae milaai ||",
      "translation": "When God so wills, He merges the mortal into Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਿਸ ਤੇ ਨੇੜੈ ਨਾਹੀ ਕੋ ਦੂਰਿ ॥",
      "transliteration": "tis te neRai naahee ko door ||",
      "translation": "All are near Him; no one is far away from Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਨਕ ਨਾਮਿ ਰਹਿਆ ਭਰਪੂਰਿ ॥੪॥੧੧॥",
      "transliteration": "naanak naam rahiaa bharapoor ||4||11||",
      "translation": "O Nanak, the Naam is permeating and pervading everywhere. ||4||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰਸਬਦੀ ਹਰਿ ਚੇਤਿ ਸੁਭਾਇ ॥",
      "transliteration": "gurasabadee har chet subhaai ||",
      "translation": "Through the Word of the Guru's Shabad, remember the Lord with love,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਰਸਿ ਰਹੈ ਅਘਾਇ ॥",
      "transliteration": "raam naam ras rahai aghaai ||",
      "translation": "and you shall remain satisfied by the sublime essence of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕੋਟ ਕੋਟੰਤਰ ਕੇ ਪਾਪ ਜਲਿ ਜਾਹਿ ॥",
      "transliteration": "kot kota(n)tar ke paap jal jaahi ||",
      "translation": "The sins of millions upon millions of lifetimes shall be burnt away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜੀਵਤ ਮਰਹਿ ਹਰਿ ਨਾਮਿ ਸਮਾਹਿ ॥੧॥",
      "transliteration": "jeevat marahi har naam samaahi ||1||",
      "translation": "Remaining dead while yet alive, you shall be absorbed in the Lord's Name. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਹਰਿ ਕੀ ਦਾਤਿ ਹਰਿ ਜੀਉ ਜਾਣੈ ॥",
      "transliteration": "har kee daat har jeeu jaanai ||",
      "translation": "The Dear Lord Himself knows His own bountiful blessings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਇਹੁ ਮਨੁ ਮਉਲਿਆ ਹਰਿ ਗੁਣਦਾਤਾ ਨਾਮੁ ਵਖਾਣੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur kai sabad ihu man mauliaa har gunadaataa naam vakhaanai ||1|| rahaau ||",
      "translation": "This mind blossoms forth in the Guru's Shabad, chanting the Name of the Lord, the Giver of virtue. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਭਗਵੈ ਵੇਸਿ ਭ੍ਰਮਿ ਮੁਕਤਿ ਨ ਹੋਇ ॥",
      "transliteration": "bhagavai ves bhram mukat na hoi ||",
      "translation": "No one is liberated by wandering around in saffron-colored robes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬਹੁ ਸੰਜਮਿ ਸਾਂਤਿ ਨ ਪਾਵੈ ਕੋਇ ॥",
      "transliteration": "bahu sa(n)jam saa(n)t na paavai koi ||",
      "translation": "Tranquility is not found by strict self-discipline.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗੁਰਮਤਿ ਨਾਮੁ ਪਰਾਪਤਿ ਹੋਇ ॥",
      "transliteration": "guramat naam paraapat hoi ||",
      "translation": "But by following the Guru's Teachings, one is blessed to receive the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਵਡਭਾਗੀ ਹਰਿ ਪਾਵੈ ਸੋਇ ॥੨॥",
      "transliteration": "vadabhaagee har paavai soi ||2||",
      "translation": "By great good fortune, one finds the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1175_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਕਲਿ ਮਹਿ ਰਾਮ ਨਾਮਿ ਵਡਿਆਈ ॥",
      "transliteration": "kal mahi raam naam vadiaaee ||",
      "translation": "In this Dark Age of Kali Yuga, glorious greatness comes through the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1175,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
