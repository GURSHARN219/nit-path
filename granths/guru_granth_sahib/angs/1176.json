{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1176,
  "lineCount": 54,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1176_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਤੇ ਪਾਇਆ ਜਾਈ ॥",
      "transliteration": "gur poore te paaiaa jaaee ||",
      "translation": "Through the Perfect Guru, it is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਨਾਮਿ ਰਤੇ ਸਦਾ ਸੁਖੁ ਪਾਈ ॥",
      "transliteration": "naam rate sadaa sukh paaee ||",
      "translation": "Those who are imbued with the Naam find everlasting peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਨੁ ਨਾਮੈ ਹਉਮੈ ਜਲਿ ਜਾਈ ॥੩॥",
      "transliteration": "bin naamai haumai jal jaaee ||3||",
      "translation": "But without the Naam, mortals burn in egotism. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਵਡਭਾਗੀ ਹਰਿ ਨਾਮੁ ਬੀਚਾਰਾ ॥",
      "transliteration": "vadabhaagee har naam beechaaraa ||",
      "translation": "By great good furtune, some contemplate the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਛੂਟੈ ਰਾਮ ਨਾਮਿ ਦੁਖੁ ਸਾਰਾ ॥",
      "transliteration": "chhootai raam naam dukh saaraa ||",
      "translation": "Through the Lord's Name, all sorrows are eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਿਰਦੈ ਵਸਿਆ ਸੁ ਬਾਹਰਿ ਪਾਸਾਰਾ ॥",
      "transliteration": "hiradai vasiaa s baahar paasaaraa ||",
      "translation": "He dwells within the heart, and pervades the external universe as well.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾਨਕ ਜਾਣੈ ਸਭੁ ਉਪਾਵਣਹਾਰਾ ॥੪॥੧੨॥",
      "transliteration": "naanak jaanai sabh upaavanahaaraa ||4||12||",
      "translation": "O Nanak, the Creator Lord knows all. ||4||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ਇਕ ਤੁਕੇ ॥",
      "transliteration": "basa(n)t mahalaa 3 ik tuke ||",
      "translation": "Basant, Third Mehl, Ek-Thukay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਤੇਰਾ ਕੀਆ ਕਿਰਮ ਜੰਤੁ ॥",
      "transliteration": "teraa keeaa kiram ja(n)t ||",
      "translation": "I am just a worm, created by You, O Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੇਹਿ ਤ ਜਾਪੀ ਆਦਿ ਮੰਤੁ ॥੧॥",
      "transliteration": "dehi ta jaapee aad ma(n)t ||1||",
      "translation": "If you bless me, then I chant Your Primal Mantra. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਣ ਆਖਿ ਵੀਚਾਰੀ ਮੇਰੀ ਮਾਇ ॥",
      "transliteration": "gun aakh veechaaree meree maai ||",
      "translation": "I chant and reflect on His Glorious Virtues, O my mother.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਜਪਿ ਹਰਿ ਕੈ ਲਗਉ ਪਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har jap har kai lagau paai ||1|| rahaau ||",
      "translation": "Meditating on the Lord, I fall at the Lord's Feet. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਲਾਗੇ ਨਾਮ ਸੁਆਦਿ ॥",
      "transliteration": "gur prasaad laage naam suaad ||",
      "translation": "By Guru's Grace, I am addicted to the favor of the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਾਹੇ ਜਨਮੁ ਗਵਾਵਹੁ ਵੈਰਿ ਵਾਦਿ ॥੨॥",
      "transliteration": "kaahe janam gavaavahu vair vaad ||2||",
      "translation": "Why waste your life in hatred, vengeance and conflict? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰਿ ਕਿਰਪਾ ਕੀਨੑੀ ਚੂਕਾ ਅਭਿਮਾਨੁ ॥",
      "transliteration": "gur kirapaa keenhee chookaa abhimaan ||",
      "translation": "When the Guru granted His Grace, my egotism was eradicated,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਹਜ ਭਾਇ ਪਾਇਆ ਹਰਿ ਨਾਮੁ ॥੩॥",
      "transliteration": "sahaj bhaai paaiaa har naam ||3||",
      "translation": "and then, I obtained the Lord's Name with intuitive ease. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਊਤਮੁ ਊਚਾ ਸਬਦ ਕਾਮੁ ॥",
      "transliteration": "ootam oochaa sabad kaam ||",
      "translation": "The most lofty and exalted occupation is to contemplate the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਨਕੁ ਵਖਾਣੈ ਸਾਚੁ ਨਾਮੁ ॥੪॥੧॥੧੩॥",
      "transliteration": "naanak vakhaanai saach naam ||4||1||13||",
      "translation": "Nanak chants the True Name. ||4||1||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਨਸਪਤਿ ਮਉਲੀ ਚੜਿਆ ਬਸੰਤੁ ॥",
      "transliteration": "banasapat maulee chaRiaa basa(n)t ||",
      "translation": "The season of spring has come, and all the plants have blossomed forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਮਉਲਿਆ ਸਤਿਗੁਰੂ ਸੰਗਿ ॥੧॥",
      "transliteration": "ihu man mauliaa satiguroo sa(n)g ||1||",
      "translation": "This mind blossoms forth, in association with the True Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤੁਮੑ ਸਾਚੁ ਧਿਆਵਹੁ ਮੁਗਧ ਮਨਾ ॥",
      "transliteration": "tumh saach dhiaavahu mugadh manaa ||",
      "translation": "So meditate on the True Lord, O my foolish mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਤਾਂ ਸੁਖੁ ਪਾਵਹੁ ਮੇਰੇ ਮਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "taa(n) sukh paavahu mere manaa ||1|| rahaau ||",
      "translation": "Only then shall you find peace, O my mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਇਤੁ ਮਨਿ ਮਉਲਿਐ ਭਇਆ ਅਨੰਦੁ ॥",
      "transliteration": "it man mauliai bhaiaa ana(n)d ||",
      "translation": "This mind blossoms forth, and I am in ecstasy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਫਲੁ ਪਾਇਆ ਨਾਮੁ ਗੋਬਿੰਦ ॥੨॥",
      "transliteration": "a(n)mrit phal paaiaa naam gobi(n)d ||2||",
      "translation": "I am blessed with the Ambrosial Fruit of the Naam, the Name of the Lord of the Universe. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਏਕੋ ਏਕੁ ਸਭੁ ਆਖਿ ਵਖਾਣੈ ॥",
      "transliteration": "eko ek sabh aakh vakhaanai ||",
      "translation": "Everyone speaks and says that the Lord is the One and Only.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹੁਕਮੁ ਬੂਝੈ ਤਾਂ ਏਕੋ ਜਾਣੈ ॥੩॥",
      "transliteration": "hukam boojhai taa(n) eko jaanai ||3||",
      "translation": "By understanding the Hukam of His Command, we come to know the One Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਹਤ ਨਾਨਕੁ ਹਉਮੈ ਕਹੈ ਨ ਕੋਇ ॥",
      "transliteration": "kahat naanak haumai kahai na koi ||",
      "translation": "Says Nanak, no one can describe the Lord by speaking through ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਆਖਣੁ ਵੇਖਣੁ ਸਭੁ ਸਾਹਿਬ ਤੇ ਹੋਇ ॥੪॥੨॥੧੪॥",
      "transliteration": "aakhan vekhan sabh saahib te hoi ||4||2||14||",
      "translation": "All speech and insight comes from our Lord and Master. ||4||2||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਭਿ ਜੁਗ ਤੇਰੇ ਕੀਤੇ ਹੋਏ ॥",
      "transliteration": "sabh jug tere keete hoe ||",
      "translation": "All the ages were created by You, O Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਭੇਟੈ ਮਤਿ ਬੁਧਿ ਹੋਏ ॥੧॥",
      "transliteration": "satigur bhetai mat budh hoe ||1||",
      "translation": "Meeting with the True Guru, one's intellect is awakened. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਹਰਿ ਜੀਉ ਆਪੇ ਲੈਹੁ ਮਿਲਾਇ ॥",
      "transliteration": "har jeeu aape laihu milaai ||",
      "translation": "O Dear Lord, please blend me with Yourself;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਸਚ ਨਾਮਿ ਸਮਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur kai sabad sach naam samaai ||1|| rahaau ||",
      "translation": "let me merge in the True Name, through the Word of the Guru's Shabad. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਨਿ ਬਸੰਤੁ ਹਰੇ ਸਭਿ ਲੋਇ ॥",
      "transliteration": "man basa(n)t hare sabh loi ||",
      "translation": "When the mind is in spring, all people are rejuvenated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਫਲਹਿ ਫੁਲੀਅਹਿ ਰਾਮ ਨਾਮਿ ਸੁਖੁ ਹੋਇ ॥੨॥",
      "transliteration": "phalahi phuleeahi raam naam sukh hoi ||2||",
      "translation": "Blossoming forth and flowering through the Lord's Name, peace is obtained. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਦਾ ਬਸੰਤੁ ਗੁਰਸਬਦੁ ਵੀਚਾਰੇ ॥",
      "transliteration": "sadaa basa(n)t gurasabad veechaare ||",
      "translation": "Contemplating the Word of the Guru's Shabad, one is in spring forever,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਮ ਨਾਮੁ ਰਾਖੈ ਉਰ ਧਾਰੇ ॥੩॥",
      "transliteration": "raam naam raakhai ur dhaare ||3||",
      "translation": "with the Lord's Name enshrined in the heart. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਨਿ ਬਸੰਤੁ ਤਨੁ ਮਨੁ ਹਰਿਆ ਹੋਇ ॥",
      "transliteration": "man basa(n)t tan man hariaa hoi ||",
      "translation": "When the mind is in spring, the body and mind are rejuvenated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾਨਕ ਇਹੁ ਤਨੁ ਬਿਰਖੁ ਰਾਮ ਨਾਮੁ ਫਲੁ ਪਾਏ ਸੋਇ ॥੪॥੩॥੧੫॥",
      "transliteration": "naanak ihu tan birakh raam naam phal paae soi ||4||3||15||",
      "translation": "O Nanak, this body is the tree which bears the fruit of the Lord's Name. ||4||3||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਿਨੑ ਬਸੰਤੁ ਜੋ ਹਰਿ ਗੁਣ ਗਾਇ ॥",
      "transliteration": "tinh basa(n)t jo har gun gaai ||",
      "translation": "They alone are in the spring season, who sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪੂਰੈ ਭਾਗਿ ਹਰਿ ਭਗਤਿ ਕਰਾਇ ॥੧॥",
      "transliteration": "poorai bhaag har bhagat karaai ||1||",
      "translation": "They come to worship the Lord with devotion, through their perfect destiny. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਇਸੁ ਮਨ ਕਉ ਬਸੰਤ ਕੀ ਲਗੈ ਨ ਸੋਇ ॥",
      "transliteration": "is man kau basa(n)t kee lagai na soi ||",
      "translation": "This mind is not even touched by spring.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਜਲਿਆ ਦੂਜੈ ਦੋਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ihu man jaliaa doojai doi ||1|| rahaau ||",
      "translation": "This mind is burnt by duality and double-mindedness. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਧੰਧੈ ਬਾਂਧਾ ਕਰਮ ਕਮਾਇ ॥",
      "transliteration": "ihu man dha(n)dhai baa(n)dhaa karam kamaai ||",
      "translation": "This mind is entangled in worldly affairs, creating more and more karma.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਾਇਆ ਮੂਠਾ ਸਦਾ ਬਿਲਲਾਇ ॥੨॥",
      "transliteration": "maaiaa moothaa sadaa bilalaai ||2||",
      "translation": "Enchanted by Maya, it cries out in suffering forever. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਛੂਟੈ ਜਾਂ ਸਤਿਗੁਰੁ ਭੇਟੈ ॥",
      "transliteration": "ihu man chhootai jaa(n) satigur bhetai ||",
      "translation": "This mind is released, only when it meets with the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਮਕਾਲ ਕੀ ਫਿਰਿ ਆਵੈ ਨ ਫੇਟੈ ॥੩॥",
      "transliteration": "jamakaal kee phir aavai na phetai ||3||",
      "translation": "Then, it does not suffer beatings by the Messenger of Death. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਛੂਟਾ ਗੁਰਿ ਲੀਆ ਛਡਾਇ ॥",
      "transliteration": "ihu man chhootaa gur leeaa chhadaai ||",
      "translation": "This mind is released, when the Guru emancipates it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਾਨਕ ਮਾਇਆ ਮੋਹੁ ਸਬਦਿ ਜਲਾਇ ॥੪॥੪॥੧੬॥",
      "transliteration": "naanak maaiaa mohu sabad jalaai ||4||4||16||",
      "translation": "O Nanak, attachment to Maya is burnt away through the Word of the Shabad. ||4||4||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੩ ॥",
      "transliteration": "basa(n)t mahalaa 3 ||",
      "translation": "Basant, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਬਸੰਤੁ ਚੜਿਆ ਫੂਲੀ ਬਨਰਾਇ ॥",
      "transliteration": "basa(n)t chaRiaa phoolee banaraai ||",
      "translation": "Spring has come, and all the plants are flowering.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1176_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਏਹਿ ਜੀਅ ਜੰਤ ਫੂਲਹਿ ਹਰਿ ਚਿਤੁ ਲਾਇ ॥੧॥",
      "transliteration": "ehi jee ja(n)t phoolahi har chit laai ||1||",
      "translation": "These beings and creatures blossom forth when they focus their consciousness on the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1176,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
