{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1180,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1180_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ਘਰੁ ੧ ਦੁਤੁਕੇ ॥",
      "transliteration": "basa(n)t mahalaa 5 ghar 1 dutuke ||",
      "translation": "Basant, Fifth Mehl, First House, Du-Thukay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੁਰੁ ਸੇਵਉ ਕਰਿ ਨਮਸਕਾਰ ॥",
      "transliteration": "gur sevau kar namasakaar ||",
      "translation": "I serve the Guru, and humbly bow to Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਆਜੁ ਹਮਾਰੈ ਮੰਗਲਚਾਰ ॥",
      "transliteration": "aaj hamaarai ma(n)galachaar ||",
      "translation": "Today is a day of celebration for me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਆਜੁ ਹਮਾਰੈ ਮਹਾ ਅਨੰਦ ॥",
      "transliteration": "aaj hamaarai mahaa ana(n)d ||",
      "translation": "Today I am in supreme bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਚਿੰਤ ਲਥੀ ਭੇਟੇ ਗੋਬਿੰਦ ॥੧॥",
      "transliteration": "chi(n)t lathee bhete gobi(n)d ||1||",
      "translation": "My anxiety is dispelled, and I have met the Lord of the Universe. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਆਜੁ ਹਮਾਰੈ ਗ੍ਰਿਹਿ ਬਸੰਤ ॥",
      "transliteration": "aaj hamaarai grihi basa(n)t ||",
      "translation": "Today, it is springtime in my household.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਨ ਗਾਏ ਪ੍ਰਭ ਤੁਮੑ ਬੇਅੰਤ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gun gaae prabh tumh bea(n)t ||1|| rahaau ||",
      "translation": "I sing Your Glorious Praises, O Infinite Lord God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਆਜੁ ਹਮਾਰੈ ਬਨੇ ਫਾਗ ॥",
      "transliteration": "aaj hamaarai bane phaag ||",
      "translation": "Today, I am celebrating the festival of Phalgun.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਪ੍ਰਭ ਸੰਗੀ ਮਿਲਿ ਖੇਲਨ ਲਾਗ ॥",
      "transliteration": "prabh sa(n)gee mil khelan laag ||",
      "translation": "Joining with God's companions, I have begun to play.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹੋਲੀ ਕੀਨੀ ਸੰਤ ਸੇਵ ॥",
      "transliteration": "holee keenee sa(n)t sev ||",
      "translation": "I celebrate the festival of Holi by serving the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰੰਗੁ ਲਾਗਾ ਅਤਿ ਲਾਲ ਦੇਵ ॥੨॥",
      "transliteration": "ra(n)g laagaa at laal dev ||2||",
      "translation": "I am imbued with the deep crimson color of the Lord's Divine Love. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਨੁ ਤਨੁ ਮਉਲਿਓ ਅਤਿ ਅਨੂਪ ॥",
      "transliteration": "man tan maulio at anoop ||",
      "translation": "My mind and body have blossomed forth, in utter, incomparable beauty.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੂਕੈ ਨਾਹੀ ਛਾਵ ਧੂਪ ॥",
      "transliteration": "sookai naahee chhaav dhoop ||",
      "translation": "They do not dry out in either sunshine or shade;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਗਲੀ ਰੂਤੀ ਹਰਿਆ ਹੋਇ ॥",
      "transliteration": "sagalee rootee hariaa hoi ||",
      "translation": "they flourish in all seasons.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਦ ਬਸੰਤ ਗੁਰ ਮਿਲੇ ਦੇਵ ॥੩॥",
      "transliteration": "sad basa(n)t gur mile dev ||3||",
      "translation": "It is always springtime, when I meet with the Divine Guru. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਰਖੁ ਜਮਿਓ ਹੈ ਪਾਰਜਾਤ ॥",
      "transliteration": "birakh jamio hai paarajaat ||",
      "translation": "The wish-fulfilling Elysian Tree has sprouted and grown.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਫੂਲ ਲਗੇ ਫਲ ਰਤਨ ਭਾਂਤਿ ॥",
      "transliteration": "phool lage phal ratan bhaa(n)t ||",
      "translation": "It bears flowers and fruits, jewels of all sorts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਤ੍ਰਿਪਤਿ ਅਘਾਨੇ ਹਰਿ ਗੁਣਹ ਗਾਇ ॥",
      "transliteration": "tripat aghaane har gunah gaai ||",
      "translation": "I am satisfied and fulfilled, singing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਹਰਿ ਹਰਿ ਹਰਿ ਧਿਆਇ ॥੪॥੧॥",
      "transliteration": "jan naanak har har har dhiaai ||4||1||",
      "translation": "Servant Nanak meditates on the Lord, Har, Har, Har. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹਟਵਾਣੀ ਧਨ ਮਾਲ ਹਾਟੁ ਕੀਤੁ ॥",
      "transliteration": "hatavaanee dhan maal haat keet ||",
      "translation": "The shopkeeper deals in merchandise for profit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੂਆਰੀ ਜੂਏ ਮਾਹਿ ਚੀਤੁ ॥",
      "transliteration": "jooaaree jooe maahi cheet ||",
      "translation": "The gambler's consciousness is focused on gambling.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਮਲੀ ਜੀਵੈ ਅਮਲੁ ਖਾਇ ॥",
      "transliteration": "amalee jeevai amal khaai ||",
      "translation": "The opium addict lives by consuming opium.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਿਉ ਹਰਿ ਜਨੁ ਜੀਵੈ ਹਰਿ ਧਿਆਇ ॥੧॥",
      "transliteration": "tiu har jan jeevai har dhiaai ||1||",
      "translation": "In the same way, the humble servant of the Lord lives by meditating on the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਪਨੈ ਰੰਗਿ ਸਭੁ ਕੋ ਰਚੈ ॥",
      "transliteration": "apanai ra(n)g sabh ko rachai ||",
      "translation": "Everyone is absorbed in his own pleasures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਿਤੁ ਪ੍ਰਭਿ ਲਾਇਆ ਤਿਤੁ ਤਿਤੁ ਲਗੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jit prabh laaiaa tit tit lagai ||1|| rahaau ||",
      "translation": "He is attached to whatever God attaches him to. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੇਘ ਸਮੈ ਮੋਰ ਨਿਰਤਿਕਾਰ ॥",
      "transliteration": "megh samai mor niratikaar ||",
      "translation": "When the clouds and the rain come, the peacocks dance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਚੰਦ ਦੇਖਿ ਬਿਗਸਹਿ ਕਉਲਾਰ ॥",
      "transliteration": "cha(n)d dekh bigasahi kaulaar ||",
      "translation": "Seeing the moon, the lotus blossoms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਮਾਤਾ ਬਾਰਿਕ ਦੇਖਿ ਅਨੰਦ ॥",
      "transliteration": "maataa baarik dekh ana(n)d ||",
      "translation": "When the mother sees her infant, she is happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਿਉ ਹਰਿ ਜਨ ਜੀਵਹਿ ਜਪਿ ਗੋਬਿੰਦ ॥੨॥",
      "transliteration": "tiu har jan jeevahi jap gobi(n)d ||2||",
      "translation": "In the same way, the humble servant of the Lord lives by meditating on the Lord of the Universe. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਿੰਘ ਰੁਚੈ ਸਦ ਭੋਜਨੁ ਮਾਸ ॥",
      "transliteration": "si(n)gh ruchai sad bhojan maas ||",
      "translation": "The tiger always wants to eat meat.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਰਣੁ ਦੇਖਿ ਸੂਰੇ ਚਿਤ ਉਲਾਸ ॥",
      "transliteration": "ran dekh soore chit ulaas ||",
      "translation": "Gazing upon the battlefield, the warrior's mind is exalted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਿਰਪਨ ਕਉ ਅਤਿ ਧਨ ਪਿਆਰੁ ॥",
      "transliteration": "kirapan kau at dhan piaar ||",
      "translation": "The miser is totally in love with his wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਹਰਿ ਜਨ ਕਉ ਹਰਿ ਹਰਿ ਆਧਾਰੁ ॥੩॥",
      "transliteration": "har jan kau har har aadhaar ||3||",
      "translation": "The humble servant of the Lord leans on the Support of the Lord, Har, Har. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਰਬ ਰੰਗ ਇਕ ਰੰਗ ਮਾਹਿ ॥",
      "transliteration": "sarab ra(n)g ik ra(n)g maahi ||",
      "translation": "All love is contained in the Love of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸਰਬ ਸੁਖਾ ਸੁਖ ਹਰਿ ਕੈ ਨਾਇ ॥",
      "transliteration": "sarab sukhaa sukh har kai naai ||",
      "translation": "All comforts are contained in the Comfort of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਿਸਹਿ ਪਰਾਪਤਿ ਇਹੁ ਨਿਧਾਨੁ ॥",
      "transliteration": "tisahi paraapat ihu nidhaan ||",
      "translation": "He alone receives this treasure,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਨਕ ਗੁਰੁ ਜਿਸੁ ਕਰੇ ਦਾਨੁ ॥੪॥੨॥",
      "transliteration": "naanak gur jis kare daan ||4||2||",
      "translation": "O Nanak, unto whom the Guru gives His gift. ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤਿਸੁ ਬਸੰਤੁ ਜਿਸੁ ਪ੍ਰਭੁ ਕ੍ਰਿਪਾਲੁ ॥",
      "transliteration": "tis basa(n)t jis prabh kripaal ||",
      "translation": "He alone experiences this springtime of the soul, unto whom God grants His Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਿਸੁ ਬਸੰਤੁ ਜਿਸੁ ਗੁਰੁ ਦਇਆਲੁ ॥",
      "transliteration": "tis basa(n)t jis gur daiaal ||",
      "translation": "He alone experiences this springtime of the soul, unto whom the Guru is merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮੰਗਲੁ ਤਿਸ ਕੈ ਜਿਸੁ ਏਕੁ ਕਾਮੁ ॥",
      "transliteration": "ma(n)gal tis kai jis ek kaam ||",
      "translation": "He alone is joyful, who works for the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਿਸੁ ਸਦ ਬਸੰਤੁ ਜਿਸੁ ਰਿਦੈ ਨਾਮੁ ॥੧॥",
      "transliteration": "tis sad basa(n)t jis ridai naam ||1||",
      "translation": "He alone experiences this eternal springtime of the soul, within whose heart the Naam, the Name of the Lord, abides. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗ੍ਰਿਹਿ ਤਾ ਕੇ ਬਸੰਤੁ ਗਨੀ ॥",
      "transliteration": "grihi taa ke basa(n)t ganee ||",
      "translation": "This spring comes only to those homes,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਾ ਕੈ ਕੀਰਤਨੁ ਹਰਿ ਧੁਨੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaa kai keeratan har dhunee ||1|| rahaau ||",
      "translation": "in which the melody of the Kirtan of the Lord's Praises resounds. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰੀਤਿ ਪਾਰਬ੍ਰਹਮ ਮਉਲਿ ਮਨਾ ॥",
      "transliteration": "preet paarabraham maul manaa ||",
      "translation": "O mortal, let your love for the Supreme Lord God blossom forth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗਿਆਨੁ ਕਮਾਈਐ ਪੂਛਿ ਜਨਾਂ ॥",
      "transliteration": "giaan kamaaeeai poochh janaa(n) ||",
      "translation": "Practice spiritual wisdom, and consult the humble servants of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸੋ ਤਪਸੀ ਜਿਸੁ ਸਾਧਸੰਗੁ ॥",
      "transliteration": "so tapasee jis saadhasa(n)g ||",
      "translation": "He alone is an ascetic, who joins the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਦ ਧਿਆਨੀ ਜਿਸੁ ਗੁਰਹਿ ਰੰਗੁ ॥੨॥",
      "transliteration": "sad dhiaanee jis gurahi ra(n)g ||2||",
      "translation": "He alone dwells in deep, continual meditation, who loves his Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸੇ ਨਿਰਭਉ ਜਿਨੑ ਭਉ ਪਇਆ ॥",
      "transliteration": "se nirabhau jinh bhau paiaa ||",
      "translation": "He alone is fearless, who has the Fear of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸੋ ਸੁਖੀਆ ਜਿਸੁ ਭ੍ਰਮੁ ਗਇਆ ॥",
      "transliteration": "so sukheeaa jis bhram gaiaa ||",
      "translation": "He alone is peaceful, whose doubts are dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸੋ ਇਕਾਂਤੀ ਜਿਸੁ ਰਿਦਾ ਥਾਇ ॥",
      "transliteration": "so ikaa(n)tee jis ridaa thaai ||",
      "translation": "He alone is a hermit, who heart is steady and stable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੋਈ ਨਿਹਚਲੁ ਸਾਚ ਠਾਇ ॥੩॥",
      "transliteration": "soee nihachal saach thaai ||3||",
      "translation": "He alone is steady and unmoving, who has found the true place. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਏਕਾ ਖੋਜੈ ਏਕ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "ekaa khojai ek preet ||",
      "translation": "He seeks the One Lord, and loves the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਦਰਸਨ ਪਰਸਨ ਹੀਤ ਚੀਤਿ ॥",
      "transliteration": "darasan parasan heet cheet ||",
      "translation": "He loves to gaze upon the Blessed Vision of the Lord's Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਹਰਿ ਰੰਗ ਰੰਗਾ ਸਹਜਿ ਮਾਣੁ ॥",
      "transliteration": "har ra(n)g ra(n)gaa sahaj maan ||",
      "translation": "He intuitively enjoys the Love of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1180_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਨਾਨਕ ਦਾਸ ਤਿਸੁ ਜਨ ਕੁਰਬਾਣੁ ॥੪॥੩॥",
      "transliteration": "naanak daas tis jan kurabaan ||4||3||",
      "translation": "Slave Nanak is a sacrifice to that humble being. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1180,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
