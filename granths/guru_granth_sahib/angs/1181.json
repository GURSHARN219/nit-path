{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1181,
  "lineCount": 63,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1181_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜੀਅ ਪ੍ਰਾਣ ਤੁਮੑ ਪਿੰਡ ਦੀਨੑ ॥",
      "transliteration": "jee praan tumh pi(n)d deenh ||",
      "translation": "You gave us our soul, breath of life and body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੁਗਧ ਸੁੰਦਰ ਧਾਰਿ ਜੋਤਿ ਕੀਨੑ ॥",
      "transliteration": "mugadh su(n)dar dhaar jot keenh ||",
      "translation": "I am a fool, but You have made me beautiful, enshrining Your Light within me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਭਿ ਜਾਚਿਕ ਪ੍ਰਭ ਤੁਮੑ ਦਇਆਲ ॥",
      "transliteration": "sabh jaachik prabh tumh daiaal ||",
      "translation": "We are all beggars, O God; You are merciful to us.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਹੋਵਤ ਨਿਹਾਲ ॥੧॥",
      "transliteration": "naam japat hovat nihaal ||1||",
      "translation": "Chanting the Naam, the Name of the Lord, we are uplifted and exalted. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਮੇਰੇ ਪ੍ਰੀਤਮ ਕਾਰਣ ਕਰਣ ਜੋਗ ॥",
      "transliteration": "mere preetam kaaran karan jog ||",
      "translation": "O my Beloved, only You have the potency to act,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਉ ਪਾਵਉ ਤੁਮ ਤੇ ਸਗਲ ਥੋਕ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "hau paavau tum te sagal thok ||1|| rahaau ||",
      "translation": "and cause all to be done. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਹੋਵਤ ਉਧਾਰ ॥",
      "transliteration": "naam japat hovat udhaar ||",
      "translation": "Chanting the Naam, the mortal is saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਸੁਖ ਸਹਜ ਸਾਰ ॥",
      "transliteration": "naam japat sukh sahaj saar ||",
      "translation": "Chanting the Naam, sublime peace and poise are found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਪਤਿ ਸੋਭਾ ਹੋਇ ॥",
      "transliteration": "naam japat pat sobhaa hoi ||",
      "translation": "Chanting the Naam, honor and glory are received.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਬਿਘਨੁ ਨਾਹੀ ਕੋਇ ॥੨॥",
      "transliteration": "naam japat bighan naahee koi ||2||",
      "translation": "Chanting the Naam, no obstacles shall block your way. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਾ ਕਾਰਣਿ ਇਹ ਦੁਲਭ ਦੇਹ ॥",
      "transliteration": "jaa kaaran ih dulabh deh ||",
      "translation": "For this reason, you have been blessed with this body, so difficult to obtain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੋ ਬੋਲੁ ਮੇਰੇ ਪ੍ਰਭੂ ਦੇਹਿ ॥",
      "transliteration": "so bol mere prabhoo dehi ||",
      "translation": "O my Dear God, please bless me to speak the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਮਹਿ ਇਹੁ ਬਿਸ੍ਰਾਮੁ ॥",
      "transliteration": "saadhasa(n)gat mahi ihu bisraam ||",
      "translation": "This tranquil peace is found in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਦਾ ਰਿਦੈ ਜਪੀ ਪ੍ਰਭ ਤੇਰੋ ਨਾਮੁ ॥੩॥",
      "transliteration": "sadaa ridai japee prabh tero naam ||3||",
      "translation": "May I always chant and meditate within my heart on Your Name, O God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤੁਝ ਬਿਨੁ ਦੂਜਾ ਕੋਇ ਨਾਹਿ ॥",
      "transliteration": "tujh bin doojaa koi naahi ||",
      "translation": "Other than You, there is no one at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਭੁ ਤੇਰੋ ਖੇਲੁ ਤੁਝ ਮਹਿ ਸਮਾਹਿ ॥",
      "transliteration": "sabh tero khel tujh mahi samaahi ||",
      "translation": "Everything is Your play; it all merges again into You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਉ ਭਾਵੈ ਤਿਉ ਰਾਖਿ ਲੇ ॥",
      "transliteration": "jiu bhaavai tiu raakh le ||",
      "translation": "As it pleases Your Will, save me, Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੁਖੁ ਨਾਨਕ ਪੂਰਾ ਗੁਰੁ ਮਿਲੇ ॥੪॥੪॥",
      "transliteration": "sukh naanak pooraa gur mile ||4||4||",
      "translation": "O Nanak, peace is obtained by meeting with the Perfect Guru. ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪ੍ਰਭ ਪ੍ਰੀਤਮ ਮੇਰੈ ਸੰਗਿ ਰਾਇ ॥",
      "transliteration": "prabh preetam merai sa(n)g raai ||",
      "translation": "My Beloved God, my King is with me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਸਹਿ ਦੇਖਿ ਹਉ ਜੀਵਾ ਮਾਇ ॥",
      "transliteration": "jisahi dekh hau jeevaa maai ||",
      "translation": "Gazing upon Him, I live, O my mother.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾ ਕੈ ਸਿਮਰਨਿ ਦੁਖੁ ਨ ਹੋਇ ॥",
      "transliteration": "jaa kai simaran dukh na hoi ||",
      "translation": "Remembering Him in meditation, there is no pain or suffering.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਕਰਿ ਦਇਆ ਮਿਲਾਵਹੁ ਤਿਸਹਿ ਮੋਹਿ ॥੧॥",
      "transliteration": "kar daiaa milaavahu tisahi mohi ||1||",
      "translation": "Please, take pity on me, and lead me on to meet Him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮੇਰੇ ਪ੍ਰੀਤਮ ਪ੍ਰਾਨ ਅਧਾਰ ਮਨ ॥",
      "transliteration": "mere preetam praan adhaar man ||",
      "translation": "My Beloved is the Support of my breath of life and mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਜੀਉ ਪ੍ਰਾਨ ਸਭੁ ਤੇਰੋ ਧਨ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jeeu praan sabh tero dhan ||1|| rahaau ||",
      "translation": "This soul, breath of life, and wealth are all Yours, O Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਾ ਕਉ ਖੋਜਹਿ ਸੁਰਿ ਨਰ ਦੇਵ ॥",
      "transliteration": "jaa kau khojahi sur nar dev ||",
      "translation": "He is sought by the angels, mortals and divine beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮੁਨਿ ਜਨ ਸੇਖ ਨ ਲਹਹਿ ਭੇਵ ॥",
      "transliteration": "mun jan sekh na lahahi bhev ||",
      "translation": "The silent sages, the humble, and the religious teachers do not understand His mystery.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਾ ਕੀ ਗਤਿ ਮਿਤਿ ਕਹੀ ਨ ਜਾਇ ॥",
      "transliteration": "jaa kee gat mit kahee na jaai ||",
      "translation": "His state and extent cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਘਟਿ ਘਟਿ ਰਹਿਆ ਸਮਾਇ ॥੨॥",
      "transliteration": "ghat ghat ghat ghat rahiaa samaai ||2||",
      "translation": "In each and every home of each and every heart, He is permeating and pervading. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਾ ਕੇ ਭਗਤ ਆਨੰਦ ਮੈ ॥",
      "transliteration": "jaa ke bhagat aana(n)d mai ||",
      "translation": "His devotees are totally in bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਾ ਕੇ ਭਗਤ ਕਉ ਨਾਹੀ ਖੈ ॥",
      "transliteration": "jaa ke bhagat kau naahee khai ||",
      "translation": "His devotees cannot be destroyed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜਾ ਕੇ ਭਗਤ ਕਉ ਨਾਹੀ ਭੈ ॥",
      "transliteration": "jaa ke bhagat kau naahee bhai ||",
      "translation": "His devotees are not afraid.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਾ ਕੇ ਭਗਤ ਕਉ ਸਦਾ ਜੈ ॥੩॥",
      "transliteration": "jaa ke bhagat kau sadaa jai ||3||",
      "translation": "His devotees are victorious forever. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਉਨ ਉਪਮਾ ਤੇਰੀ ਕਹੀ ਜਾਇ ॥",
      "transliteration": "kaun upamaa teree kahee jaai ||",
      "translation": "What Praises of Yours can I utter?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸੁਖਦਾਤਾ ਪ੍ਰਭੁ ਰਹਿਓ ਸਮਾਇ ॥",
      "transliteration": "sukhadaataa prabh rahio samaai ||",
      "translation": "God, the Giver of peace, is all-pervading, permeating everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਾਨਕੁ ਜਾਚੈ ਏਕੁ ਦਾਨੁ ॥",
      "transliteration": "naanak jaachai ek daan ||",
      "translation": "Nanak begs for this one gift.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਮੋਹਿ ਦੇਹੁ ਨਾਮੁ ॥੪॥੫॥",
      "transliteration": "kar kirapaa mohi dehu naam ||4||5||",
      "translation": "Be merciful, and bless me with Your Name. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਿਲਿ ਪਾਣੀ ਜਿਉ ਹਰੇ ਬੂਟ ॥",
      "transliteration": "mil paanee jiu hare boot ||",
      "translation": "As the plant turns green upon receiving water,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਤਿਉ ਹਉਮੈ ਛੂਟ ॥",
      "transliteration": "saadhasa(n)gat tiu haumai chhoot ||",
      "translation": "just so, in the Saadh Sangat, the Company of the Holy, egotism is eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜੈਸੀ ਦਾਸੇ ਧੀਰ ਮੀਰ ॥",
      "transliteration": "jaisee daase dheer meer ||",
      "translation": "Just as the servant is encouraged by his ruler,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੈਸੇ ਉਧਾਰਨ ਗੁਰਹ ਪੀਰ ॥੧॥",
      "transliteration": "taise udhaaran gurah peer ||1||",
      "translation": "we are saved by the Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤੁਮ ਦਾਤੇ ਪ੍ਰਭ ਦੇਨਹਾਰ ॥",
      "transliteration": "tum daate prabh denahaar ||",
      "translation": "You are the Great Giver, O Generous Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਿਮਖ ਨਿਮਖ ਤਿਸੁ ਨਮਸਕਾਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "nimakh nimakh tis namasakaar ||1|| rahaau ||",
      "translation": "Each and every instant, I humbly bow to You. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਸਹਿ ਪਰਾਪਤਿ ਸਾਧਸੰਗੁ ॥",
      "transliteration": "jisahi paraapat saadhasa(n)g ||",
      "translation": "Whoever enters the Saadh Sangat",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਤਿਸੁ ਜਨ ਲਾਗਾ ਪਾਰਬ੍ਰਹਮ ਰੰਗੁ ॥",
      "transliteration": "tis jan laagaa paarabraham ra(n)g ||",
      "translation": "that humble being is imbued with the Love of the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤੇ ਬੰਧਨ ਤੇ ਭਏ ਮੁਕਤਿ ॥",
      "transliteration": "te ba(n)dhan te bhae mukat ||",
      "translation": "He is liberated from bondage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਭਗਤ ਅਰਾਧਹਿ ਜੋਗ ਜੁਗਤਿ ॥੨॥",
      "transliteration": "bhagat araadhahi jog jugat ||2||",
      "translation": "His devotees worship Him in adoration; they are united in His Union. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨੇਤ੍ਰ ਸੰਤੋਖੇ ਦਰਸੁ ਪੇਖਿ ॥",
      "transliteration": "netr sa(n)tokhe daras pekh ||",
      "translation": "My eyes are content, gazing upon the Blessed Vision of His Darshan.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਰਸਨਾ ਗਾਏ ਗੁਣ ਅਨੇਕ ॥",
      "transliteration": "rasanaa gaae gun anek ||",
      "translation": "My tongue sings the Infinite Praises of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਤ੍ਰਿਸਨਾ ਬੂਝੀ ਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "trisanaa boojhee gur prasaad ||",
      "translation": "My thirst is quenched, by Guru's Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਨੁ ਆਘਾਨਾ ਹਰਿ ਰਸਹਿ ਸੁਆਦਿ ॥੩॥",
      "transliteration": "man aaghaanaa har rasahi suaad ||3||",
      "translation": "My mind is satisfied, with the sublime taste of the Lord's subtle essence. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸੇਵਕੁ ਲਾਗੋ ਚਰਣ ਸੇਵ ॥",
      "transliteration": "sevak laago charan sev ||",
      "translation": "Your servant is committed to the service of Your Feet,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਆਦਿ ਪੁਰਖ ਅਪਰੰਪਰ ਦੇਵ ॥",
      "transliteration": "aad purakh apara(n)par dev ||",
      "translation": "O Primal Infinite Divine Being.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਗਲ ਉਧਾਰਣ ਤੇਰੋ ਨਾਮੁ ॥",
      "transliteration": "sagal udhaaran tero naam ||",
      "translation": "Your Name is the Saving Grace of all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਨਾਨਕ ਪਾਇਓ ਇਹੁ ਨਿਧਾਨੁ ॥੪॥੬॥",
      "transliteration": "naanak paaio ihu nidhaan ||4||6||",
      "translation": "Nanak has received this teasure. ||4||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਤੁਮ ਬਡ ਦਾਤੇ ਦੇ ਰਹੇ ॥",
      "transliteration": "tum bad daate de rahe ||",
      "translation": "You are the Great Giver; You continue to give.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਜੀਅ ਪ੍ਰਾਣ ਮਹਿ ਰਵਿ ਰਹੇ ॥",
      "transliteration": "jee praan mahi rav rahe ||",
      "translation": "You permeate and pervade my soul, and my breath of life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਦੀਨੇ ਸਗਲੇ ਭੋਜਨ ਖਾਨ ॥",
      "transliteration": "deene sagale bhojan khaan ||",
      "translation": "You have given me all sorts of foods and dishes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0062",
      "lineIndex": 62,
      "gurmukhi": "ਮੋਹਿ ਨਿਰਗੁਨ ਇਕੁ ਗੁਨੁ ਨ ਜਾਨ ॥੧॥",
      "transliteration": "mohi niragun ik gun na jaan ||1||",
      "translation": "I am unworthy; I know none of Your Virtues at all. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1181_line_0063",
      "lineIndex": 63,
      "gurmukhi": "ਹਉ ਕਛੂ ਨ ਜਾਨਉ ਤੇਰੀ ਸਾਰ ॥",
      "transliteration": "hau kachhoo na jaanau teree saar ||",
      "translation": "I do not understand anything of Your Worth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1181,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
