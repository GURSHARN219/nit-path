{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1182,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1182_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤੂ ਕਰਿ ਗਤਿ ਮੇਰੀ ਪ੍ਰਭ ਦਇਆਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "too kar gat meree prabh daiaar ||1|| rahaau ||",
      "translation": "Save me, O my Merciful Lord God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਾਪ ਨ ਤਾਪ ਨ ਕਰਮ ਕੀਤਿ ॥",
      "transliteration": "jaap na taap na karam keet ||",
      "translation": "I have not practiced meditation, austerities or good actions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਆਵੈ ਨਾਹੀ ਕਛੂ ਰੀਤਿ ॥",
      "transliteration": "aavai naahee kachhoo reet ||",
      "translation": "I do not know the way to meet You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਨ ਮਹਿ ਰਾਖਉ ਆਸ ਏਕ ॥",
      "transliteration": "man mahi raakhau aas ek ||",
      "translation": "Within my mind, I have placed my hopes in the One Lord alone.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਨਾਮ ਤੇਰੇ ਕੀ ਤਰਉ ਟੇਕ ॥੨॥",
      "transliteration": "naam tere kee tarau tek ||2||",
      "translation": "The Support of Your Name shall carry me across. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਰਬ ਕਲਾ ਪ੍ਰਭ ਤੁਮੑ ਪ੍ਰਬੀਨ ॥",
      "transliteration": "sarab kalaa prabh tumh prabeen ||",
      "translation": "You are the Expert, O God, in all powers.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅੰਤੁ ਨ ਪਾਵਹਿ ਜਲਹਿ ਮੀਨ ॥",
      "transliteration": "a(n)t na paavahi jalahi meen ||",
      "translation": "The fish cannot find the limits of the water.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਗਮ ਅਗਮ ਊਚਹ ਤੇ ਊਚ ॥",
      "transliteration": "agam agam oochah te ooch ||",
      "translation": "You are Inaccessible and Unfathomable, the Highest of the High.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਮ ਥੋਰੇ ਤੁਮ ਬਹੁਤ ਮੂਚ ॥੩॥",
      "transliteration": "ham thore tum bahut mooch ||3||",
      "translation": "I am small, and You are so very Great. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਿਨ ਤੂ ਧਿਆਇਆ ਸੇ ਗਨੀ ॥",
      "transliteration": "jin too dhiaaiaa se ganee ||",
      "translation": "Those who meditate on You are wealthy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜਿਨ ਤੂ ਪਾਇਆ ਸੇ ਧਨੀ ॥",
      "transliteration": "jin too paaiaa se dhanee ||",
      "translation": "Those who attain You are rich.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਿਨਿ ਤੂ ਸੇਵਿਆ ਸੁਖੀ ਸੇ ॥",
      "transliteration": "jin too seviaa sukhee se ||",
      "translation": "Those who serve You are peaceful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸੰਤ ਸਰਣਿ ਨਾਨਕ ਪਰੇ ॥੪॥੭॥",
      "transliteration": "sa(n)t saran naanak pare ||4||7||",
      "translation": "Nanak seeks the Sanctuary of the Saints. ||4||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਤਿਸੁ ਤੂ ਸੇਵਿ ਜਿਨਿ ਤੂ ਕੀਆ ॥",
      "transliteration": "tis too sev jin too keeaa ||",
      "translation": "Serve the One who created You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਤਿਸੁ ਅਰਾਧਿ ਜਿਨਿ ਜੀਉ ਦੀਆ ॥",
      "transliteration": "tis araadh jin jeeu deeaa ||",
      "translation": "Worship the One who gave you life.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਿਸ ਕਾ ਚਾਕਰੁ ਹੋਹਿ ਫਿਰਿ ਡਾਨੁ ਨ ਲਾਗੈ ॥",
      "transliteration": "tis kaa chaakar hohi phir daan na laagai ||",
      "translation": "Become His servant, and you shall never again be punished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਤਿਸ ਕੀ ਕਰਿ ਪੋਤਦਾਰੀ ਫਿਰਿ ਦੂਖੁ ਨ ਲਾਗੈ ॥੧॥",
      "transliteration": "tis kee kar potadaaree phir dookh na laagai ||1||",
      "translation": "Become His trustee, and you shall never again suffer sorrow. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਏਵਡ ਭਾਗ ਹੋਹਿ ਜਿਸੁ ਪ੍ਰਾਣੀ ॥",
      "transliteration": "evad bhaag hohi jis praanee ||",
      "translation": "That mortal who is blessed with such great good fortune,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੋ ਪਾਏ ਇਹੁ ਪਦੁ ਨਿਰਬਾਣੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "so paae ihu pad nirabaanee ||1|| rahaau ||",
      "translation": "attains this state of Nirvaanaa. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਦੂਜੀ ਸੇਵਾ ਜੀਵਨੁ ਬਿਰਥਾ ॥",
      "transliteration": "doojee sevaa jeevan birathaa ||",
      "translation": "Life is wasted uselessly in the service of duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਛੂ ਨ ਹੋਈ ਹੈ ਪੂਰਨ ਅਰਥਾ ॥",
      "transliteration": "kachhoo na hoee hai pooran arathaa ||",
      "translation": "No efforts shall be rewarded, and no works brought to fruition.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮਾਣਸ ਸੇਵਾ ਖਰੀ ਦੁਹੇਲੀ ॥",
      "transliteration": "maanas sevaa kharee duhelee ||",
      "translation": "It is so painful to serve only mortal beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਾਧ ਕੀ ਸੇਵਾ ਸਦਾ ਸੁਹੇਲੀ ॥੨॥",
      "transliteration": "saadh kee sevaa sadaa suhelee ||2||",
      "translation": "Service to the Holy brings lasting peace and bliss. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੇ ਲੋੜਹਿ ਸਦਾ ਸੁਖੁ ਭਾਈ ॥",
      "transliteration": "je loRahi sadaa sukh bhaaee ||",
      "translation": "If you long for eternal peace, O Siblings of Destiny,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਾਧੂ ਸੰਗਤਿ ਗੁਰਹਿ ਬਤਾਈ ॥",
      "transliteration": "saadhoo sa(n)gat gurahi bataaee ||",
      "translation": "then join the Saadh Sangat, the Company of the Holy; this is the Guru's advice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਊਹਾ ਜਪੀਐ ਕੇਵਲ ਨਾਮ ॥",
      "transliteration": "oohaa japeeai keval naam ||",
      "translation": "There, the Naam, the Name of the Lord, is meditated on.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਾਧੂ ਸੰਗਤਿ ਪਾਰਗਰਾਮ ॥੩॥",
      "transliteration": "saadhoo sa(n)gat paaragaraam ||3||",
      "translation": "In the Saadh Sangat, you shall be emancipated. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸਗਲ ਤਤ ਮਹਿ ਤਤੁ ਗਿਆਨੁ ॥",
      "transliteration": "sagal tat mahi tat giaan ||",
      "translation": "Among all essences, this is the essence of spiritual wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਰਬ ਧਿਆਨ ਮਹਿ ਏਕੁ ਧਿਆਨੁ ॥",
      "transliteration": "sarab dhiaan mahi ek dhiaan ||",
      "translation": "Among all meditations, meditation on the One Lord is the most sublime.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਹਰਿ ਕੀਰਤਨ ਮਹਿ ਊਤਮ ਧੁਨਾ ॥",
      "transliteration": "har keeratan mahi ootam dhunaa ||",
      "translation": "The Kirtan of the Lord's Praises is the ultimate melody.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਨਕ ਗੁਰ ਮਿਲਿ ਗਾਇ ਗੁਨਾ ॥੪॥੮॥",
      "transliteration": "naanak gur mil gaai gunaa ||4||8||",
      "translation": "Meeting with the Guru, Nanak sings the Glorious Praises of the Lord. ||4||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਜਿਸੁ ਬੋਲਤ ਮੁਖੁ ਪਵਿਤੁ ਹੋਇ ॥",
      "transliteration": "jis bolat mukh pavit hoi ||",
      "translation": "Chanting His Name, one's mouth becomes pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜਿਸੁ ਸਿਮਰਤ ਨਿਰਮਲ ਹੈ ਸੋਇ ॥",
      "transliteration": "jis simarat niramal hai soi ||",
      "translation": "Meditating in remembrance on Him, one's reputation becomes stainless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਸੁ ਅਰਾਧੇ ਜਮੁ ਕਿਛੁ ਨ ਕਹੈ ॥",
      "transliteration": "jis araadhe jam kichh na kahai ||",
      "translation": "Worshipping Him in adoration, one is not tortured by the Messenger of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਿਸ ਕੀ ਸੇਵਾ ਸਭੁ ਕਿਛੁ ਲਹੈ ॥੧॥",
      "transliteration": "jis kee sevaa sabh kichh lahai ||1||",
      "translation": "Serving Him, everything is obtained. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਰਾਮ ਰਾਮ ਬੋਲਿ ਰਾਮ ਰਾਮ ॥",
      "transliteration": "raam raam bol raam raam ||",
      "translation": "The Lord's Name - chant the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤਿਆਗਹੁ ਮਨ ਕੇ ਸਗਲ ਕਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tiaagahu man ke sagal kaam ||1|| rahaau ||",
      "translation": "Abandon all the desires of your mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਿਸ ਕੇ ਧਾਰੇ ਧਰਣਿ ਅਕਾਸੁ ॥",
      "transliteration": "jis ke dhaare dharan akaas ||",
      "translation": "He is the Support of the earth and the sky.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਜਿਸ ਕਾ ਹੈ ਪ੍ਰਗਾਸੁ ॥",
      "transliteration": "ghat ghat jis kaa hai pragaas ||",
      "translation": "His Light illuminates each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਿਸੁ ਸਿਮਰਤ ਪਤਿਤ ਪੁਨੀਤ ਹੋਇ ॥",
      "transliteration": "jis simarat patit puneet hoi ||",
      "translation": "Meditating in remembrance on Him, even fallen sinners are sanctified;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਅੰਤ ਕਾਲਿ ਫਿਰਿ ਫਿਰਿ ਨ ਰੋਇ ॥੨॥",
      "transliteration": "a(n)t kaal phir phir na roi ||2||",
      "translation": "in the end, they will not weep and wail over and over again. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਗਲ ਧਰਮ ਮਹਿ ਊਤਮ ਧਰਮ ॥",
      "transliteration": "sagal dharam mahi ootam dharam ||",
      "translation": "Among all religions, this is the ultimate religion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਰਮ ਕਰਤੂਤਿ ਕੈ ਊਪਰਿ ਕਰਮ ॥",
      "transliteration": "karam karatoot kai oopar karam ||",
      "translation": "Among all rituals and codes of conduct, this is above all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਿਸ ਕਉ ਚਾਹਹਿ ਸੁਰਿ ਨਰ ਦੇਵ ॥",
      "transliteration": "jis kau chaahahi sur nar dev ||",
      "translation": "The angels, mortals and divine beings long for Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੰਤ ਸਭਾ ਕੀ ਲਗਹੁ ਸੇਵ ॥੩॥",
      "transliteration": "sa(n)t sabhaa kee lagahu sev ||3||",
      "translation": "To find Him, commit yourself to the service of the Society of the Saints. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਆਦਿ ਪੁਰਖਿ ਜਿਸੁ ਕੀਆ ਦਾਨੁ ॥",
      "transliteration": "aad purakh jis keeaa daan ||",
      "translation": "One whom the Primal Lord God blesses with His bounties,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤਿਸ ਕਉ ਮਿਲਿਆ ਹਰਿ ਨਿਧਾਨੁ ॥",
      "transliteration": "tis kau miliaa har nidhaan ||",
      "translation": "obtains the treasure of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਿਸ ਕੀ ਗਤਿ ਮਿਤਿ ਕਹੀ ਨ ਜਾਇ ॥",
      "transliteration": "tis kee gat mit kahee na jaai ||",
      "translation": "His state and extent cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਾਨਕ ਜਨ ਹਰਿ ਹਰਿ ਧਿਆਇ ॥੪॥੯॥",
      "transliteration": "naanak jan har har dhiaai ||4||9||",
      "translation": "Servant Nanak meditates on the Lord, Har, Har. ||4||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਮਨ ਤਨ ਭੀਤਰਿ ਲਾਗੀ ਪਿਆਸ ॥",
      "transliteration": "man tan bheetar laagee piaas ||",
      "translation": "My mind and body are gripped by thirst and desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਗੁਰਿ ਦਇਆਲਿ ਪੂਰੀ ਮੇਰੀ ਆਸ ॥",
      "transliteration": "gur daiaal pooree meree aas ||",
      "translation": "The Merciful Guru has fulfilled my hopes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਕਿਲਵਿਖ ਕਾਟੇ ਸਾਧਸੰਗਿ ॥",
      "transliteration": "kilavikh kaate saadhasa(n)g ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, all my sins have been taken away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਨਾਮੁ ਜਪਿਓ ਹਰਿ ਨਾਮ ਰੰਗਿ ॥੧॥",
      "transliteration": "naam japio har naam ra(n)g ||1||",
      "translation": "I chant the Naam, the Name of the Lord; I am in love with the Name of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦਿ ਬਸੰਤੁ ਬਨਾ ॥",
      "transliteration": "gur parasaad basa(n)t banaa ||",
      "translation": "By Guru's Grace, this spring of the soul has come.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1182_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਹਿਰਦੈ ਉਰਿ ਧਾਰੇ ਸਦਾ ਸਦਾ ਹਰਿ ਜਸੁ ਸੁਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "charan kamal hiradai ur dhaare sadaa sadaa har jas sunaa ||1|| rahaau ||",
      "translation": "I enshrine the Lord's Lotus Feet within my heart; I listen to the Lord's Praise, forever and ever. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1182,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
