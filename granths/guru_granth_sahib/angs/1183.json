{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1183,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1183_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਮਰਥ ਸੁਆਮੀ ਕਾਰਣ ਕਰਣ ॥",
      "transliteration": "samarath suaamee kaaran karan ||",
      "translation": "Our All-powerful Lord and Master is the Doer of all, the Cause of all causes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮੋਹਿ ਅਨਾਥ ਪ੍ਰਭ ਤੇਰੀ ਸਰਣ ॥",
      "transliteration": "mohi anaath prabh teree saran ||",
      "translation": "I am an orphan - I seek Your Sanctuary, God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੀਅ ਜੰਤ ਤੇਰੇ ਆਧਾਰਿ ॥",
      "transliteration": "jee ja(n)t tere aadhaar ||",
      "translation": "All beings and creatures take Your Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਲੇਹਿ ਨਿਸਤਾਰਿ ॥੨॥",
      "transliteration": "kar kirapaa prabh lehi nisataar ||2||",
      "translation": "Be merciful, God, and save me. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਭਵ ਖੰਡਨ ਦੁਖ ਨਾਸ ਦੇਵ ॥",
      "transliteration": "bhav kha(n)dan dukh naas dev ||",
      "translation": "God is the Destroyer of fear, the Remover of pain and suffering.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੁਰਿ ਨਰ ਮੁਨਿ ਜਨ ਤਾ ਕੀ ਸੇਵ ॥",
      "transliteration": "sur nar mun jan taa kee sev ||",
      "translation": "The angelic beings and silent sages serve Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਧਰਣਿ ਅਕਾਸੁ ਜਾ ਕੀ ਕਲਾ ਮਾਹਿ ॥",
      "transliteration": "dharan akaas jaa kee kalaa maahi ||",
      "translation": "The earth and the sky are in His Power.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੇਰਾ ਦੀਆ ਸਭਿ ਜੰਤ ਖਾਹਿ ॥੩॥",
      "transliteration": "teraa deeaa sabh ja(n)t khaahi ||3||",
      "translation": "All beings eat what You give them. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅੰਤਰਜਾਮੀ ਪ੍ਰਭ ਦਇਆਲ ॥",
      "transliteration": "a(n)tarajaamee prabh daiaal ||",
      "translation": "O Merciful God, O Searcher of hearts,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਪਣੇ ਦਾਸ ਕਉ ਨਦਰਿ ਨਿਹਾਲਿ ॥",
      "transliteration": "apane daas kau nadar nihaal ||",
      "translation": "please bless Your slave with Your Glance of Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਮੋਹਿ ਦੇਹੁ ਦਾਨੁ ॥",
      "transliteration": "kar kirapaa mohi dehu daan ||",
      "translation": "Please be kind and bless me with this gift,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਪਿ ਜੀਵੈ ਨਾਨਕੁ ਤੇਰੋ ਨਾਮੁ ॥੪॥੧੦॥",
      "transliteration": "jap jeevai naanak tero naam ||4||10||",
      "translation": "that Nanak may live in Your Name. ||4||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਰਾਮ ਰੰਗਿ ਸਭ ਗਏ ਪਾਪ ॥",
      "transliteration": "raam ra(n)g sabh gae paap ||",
      "translation": "Loving the Lord, one's sins are taken away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਰਾਮ ਜਪਤ ਕਛੁ ਨਹੀ ਸੰਤਾਪ ॥",
      "transliteration": "raam japat kachh nahee sa(n)taap ||",
      "translation": "Meditating on the Lord, one does not suffer at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੋਬਿੰਦ ਜਪਤ ਸਭਿ ਮਿਟੇ ਅੰਧੇਰ ॥",
      "transliteration": "gobi(n)d japat sabh mite a(n)dher ||",
      "translation": "Meditating on the Lord of the Universe, all darkness is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਤ ਕਛੁ ਨਾਹਿ ਫੇਰ ॥੧॥",
      "transliteration": "har simarat kachh naahi pher ||1||",
      "translation": "Meditating in remembrance on the Lord, the cycle of reincarnation comes to an end. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਸੰਤੁ ਹਮਾਰੈ ਰਾਮ ਰੰਗੁ ॥",
      "transliteration": "basa(n)t hamaarai raam ra(n)g ||",
      "translation": "The love of the Lord is springtime for me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸੰਤ ਜਨਾ ਸਿਉ ਸਦਾ ਸੰਗੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sa(n)t janaa siu sadaa sa(n)g ||1|| rahaau ||",
      "translation": "I am always with the humble Saints. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੰਤ ਜਨੀ ਕੀਆ ਉਪਦੇਸੁ ॥",
      "transliteration": "sa(n)t janee keeaa upades ||",
      "translation": "The Saints have shared the Teachings with me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਹ ਗੋਬਿੰਦ ਭਗਤੁ ਸੋ ਧੰਨਿ ਦੇਸੁ ॥",
      "transliteration": "jah gobi(n)d bhagat so dha(n)n des ||",
      "translation": "Blessed is that country where the devotees of the Lord of the Universe dwell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਹਰਿ ਭਗਤਿਹੀਨ ਉਦਿਆਨ ਥਾਨੁ ॥",
      "transliteration": "har bhagatiheen udiaan thaan ||",
      "translation": "But that place where the Lord's devotees are not, is wilderness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਗੁਰ ਪ੍ਰਸਾਦਿ ਘਟਿ ਘਟਿ ਪਛਾਨੁ ॥੨॥",
      "transliteration": "gur prasaad ghat ghat pachhaan ||2||",
      "translation": "By Guru's Grace, realize the Lord in each and every heart. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਰਿ ਕੀਰਤਨ ਰਸ ਭੋਗ ਰੰਗੁ ॥",
      "transliteration": "har keeratan ras bhog ra(n)g ||",
      "translation": "Sing the Kirtan of the Lord's Praises, and enjoy the nectar of His Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਨ ਪਾਪ ਕਰਤ ਤੂ ਸਦਾ ਸੰਗੁ ॥",
      "transliteration": "man paap karat too sadaa sa(n)g ||",
      "translation": "O mortal, you must always restrain yourself from committing sins.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਿਕਟਿ ਪੇਖੁ ਪ੍ਰਭੁ ਕਰਣਹਾਰ ॥",
      "transliteration": "nikat pekh prabh karanahaar ||",
      "translation": "Behold the Creator Lord God near at hand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਈਤ ਊਤ ਪ੍ਰਭ ਕਾਰਜ ਸਾਰ ॥੩॥",
      "transliteration": "eet oot prabh kaaraj saar ||3||",
      "translation": "Here and hereafter, God shall resolve your affairs. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਸਿਉ ਲਗੋ ਧਿਆਨੁ ॥",
      "transliteration": "charan kamal siu lago dhiaan ||",
      "translation": "I focus my meditation on the Lord's Lotus Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭਿ ਕੀਨੋ ਦਾਨੁ ॥",
      "transliteration": "kar kirapaa prabh keeno daan ||",
      "translation": "Granting His Grace, God has blessed me with this Gift.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੇਰਿਆ ਸੰਤ ਜਨਾ ਕੀ ਬਾਛਉ ਧੂਰਿ ॥",
      "transliteration": "teriaa sa(n)t janaa kee baachhau dhoor ||",
      "translation": "I yearn for the dust of the feet of Your Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਪਿ ਨਾਨਕ ਸੁਆਮੀ ਸਦ ਹਜੂਰਿ ॥੪॥੧੧॥",
      "transliteration": "jap naanak suaamee sad hajoor ||4||11||",
      "translation": "Nanak meditates on his Lord and Master, who is ever-present, near at hand. ||4||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਸਚੁ ਪਰਮੇਸਰੁ ਨਿਤ ਨਵਾ ॥",
      "transliteration": "sach paramesar nit navaa ||",
      "translation": "The True Transcendent Lord is always new, forever fresh.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਗੁਰ ਕਿਰਪਾ ਤੇ ਨਿਤ ਚਵਾ ॥",
      "transliteration": "gur kirapaa te nit chavaa ||",
      "translation": "By Guru's Grace, I continually chant His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪ੍ਰਭ ਰਖਵਾਲੇ ਮਾਈ ਬਾਪ ॥",
      "transliteration": "prabh rakhavaale maaee baap ||",
      "translation": "God is my Protector, my Mother and Father.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਾ ਕੈ ਸਿਮਰਣਿ ਨਹੀ ਸੰਤਾਪ ॥੧॥",
      "transliteration": "jaa kai simaran nahee sa(n)taap ||1||",
      "translation": "Meditating in remembrance on Him, I do not suffer in sorrow. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਖਸਮੁ ਧਿਆਈ ਇਕ ਮਨਿ ਇਕ ਭਾਇ ॥",
      "transliteration": "khasam dhiaaee ik man ik bhaai ||",
      "translation": "I meditate on my Lord and Master, single-mindedly, with love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕੀ ਸਦਾ ਸਰਣਾਈ ਸਾਚੈ ਸਾਹਿਬਿ ਰਖਿਆ ਕੰਠਿ ਲਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur poore kee sadaa saranaaee saachai saahib rakhiaa ka(n)th laai ||1|| rahaau ||",
      "translation": "I seek the Sanctuary of the Perfect Guru forever. My True Lord and Master hugs me close in His Embrace. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਅਪਣੇ ਜਨ ਪ੍ਰਭਿ ਆਪਿ ਰਖੇ ॥",
      "transliteration": "apane jan prabh aap rakhe ||",
      "translation": "God Himself protects His humble servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਦੁਸਟ ਦੂਤ ਸਭਿ ਭ੍ਰਮਿ ਥਕੇ ॥",
      "transliteration": "dusat doot sabh bhram thake ||",
      "translation": "The demons and wicked enemies have grown weary of struggling against Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਸਾਚੇ ਨਹੀ ਜਾਇ ॥",
      "transliteration": "bin gur saache nahee jaai ||",
      "translation": "Without the True Guru, there is no place to go.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਦੁਖੁ ਦੇਸ ਦਿਸੰਤਰਿ ਰਹੇ ਧਾਇ ॥੨॥",
      "transliteration": "dukh des disa(n)tar rahe dhaai ||2||",
      "translation": "Wandering through the lands and foreign countries, people only grow tired and suffer in pain. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕਿਰਤੁ ਓਨੑਾ ਕਾ ਮਿਟਸਿ ਨਾਹਿ ॥",
      "transliteration": "kirat onhaa kaa mitas naahi ||",
      "translation": "The record of their past actions cannot be erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਓਇ ਅਪਣਾ ਬੀਜਿਆ ਆਪਿ ਖਾਹਿ ॥",
      "transliteration": "oi apanaa beejiaa aap khaahi ||",
      "translation": "They harvest and eat what they have planted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਨ ਕਾ ਰਖਵਾਲਾ ਆਪਿ ਸੋਇ ॥",
      "transliteration": "jan kaa rakhavaalaa aap soi ||",
      "translation": "The Lord Himself is the Protector of His humble servants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਨ ਕਉ ਪਹੁਚਿ ਨ ਸਕਸਿ ਕੋਇ ॥੩॥",
      "transliteration": "jan kau pahuch na sakas koi ||3||",
      "translation": "No one can rival the humble servant of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰਭਿ ਦਾਸ ਰਖੇ ਕਰਿ ਜਤਨੁ ਆਪਿ ॥",
      "transliteration": "prabh daas rakhe kar jatan aap ||",
      "translation": "By His own efforts, God protects His slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਅਖੰਡ ਪੂਰਨ ਜਾ ਕੋ ਪ੍ਰਤਾਪੁ ॥",
      "transliteration": "akha(n)d pooran jaa ko prataap ||",
      "translation": "God's Glory is perfect and unbroken.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਣ ਗੋਬਿੰਦ ਨਿਤ ਰਸਨ ਗਾਇ ॥",
      "transliteration": "gun gobi(n)d nit rasan gaai ||",
      "translation": "So sing the Glorious Praises of the Lord of the Universe with your tongue forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਨਕੁ ਜੀਵੈ ਹਰਿ ਚਰਣ ਧਿਆਇ ॥੪॥੧੨॥",
      "transliteration": "naanak jeevai har charan dhiaai ||4||12||",
      "translation": "Nanak lives by meditating on the Feet of the Lord. ||4||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਗੁਰ ਚਰਣ ਸਰੇਵਤ ਦੁਖੁ ਗਇਆ ॥",
      "transliteration": "gur charan sarevat dukh gaiaa ||",
      "translation": "Dwelling at the Guru's Feet, pain and suffering go away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮਿ ਪ੍ਰਭਿ ਕਰੀ ਮਇਆ ॥",
      "transliteration": "paarabraham prabh karee maiaa ||",
      "translation": "The Supreme Lord God has shown mercy to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਰਬ ਮਨੋਰਥ ਪੂਰਨ ਕਾਮ ॥",
      "transliteration": "sarab manorath pooran kaam ||",
      "translation": "All my desires and tasks are fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਪਿ ਜੀਵੈ ਨਾਨਕੁ ਰਾਮ ਨਾਮ ॥੧॥",
      "transliteration": "jap jeevai naanak raam naam ||1||",
      "translation": "Chanting the Lord's Name, Nanak lives. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸਾ ਰੁਤਿ ਸੁਹਾਵੀ ਜਿਤੁ ਹਰਿ ਚਿਤਿ ਆਵੈ ॥",
      "transliteration": "saa rut suhaavee jit har chit aavai ||",
      "translation": "How beautiful is that season, when the Lord fills the mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1183_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰ ਦੀਸੈ ਬਿਲਲਾਂਤੀ ਸਾਕਤੁ ਫਿਰਿ ਫਿਰਿ ਆਵੈ ਜਾਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bin satigur deesai bilalaa(n)tee saakat phir phir aavai jaavai ||1|| rahaau ||",
      "translation": "Without the True Guru, the world weeps. The faithless cynic comes and goes in reincarnation, over and over again. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1183,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
