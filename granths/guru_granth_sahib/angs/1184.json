{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1184,
  "lineCount": 52,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1184_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸੇ ਧਨਵੰਤ ਜਿਨ ਹਰਿ ਪ੍ਰਭੁ ਰਾਸਿ ॥",
      "transliteration": "se dhanava(n)t jin har prabh raas ||",
      "translation": "They alone are rich, who have the Wealth of the Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਗੁਰ ਸਬਦਿ ਨਾਸਿ ॥",
      "transliteration": "kaam krodh gur sabad naas ||",
      "translation": "Through the Word of the Guru's Shabad, sexual desire and anger are eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਭੈ ਬਿਨਸੇ ਨਿਰਭੈ ਪਦੁ ਪਾਇਆ ॥",
      "transliteration": "bhai binase nirabhai pad paaiaa ||",
      "translation": "Their fear is dispelled, and they attain the state of fearlessness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰ ਮਿਲਿ ਨਾਨਕਿ ਖਸਮੁ ਧਿਆਇਆ ॥੨॥",
      "transliteration": "gur mil naanak khasam dhiaaiaa ||2||",
      "translation": "Meeting with the Guru, Nanak meditates on his Lord and Master. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਪ੍ਰਭਿ ਕੀਓ ਨਿਵਾਸ ॥",
      "transliteration": "saadhasa(n)gat prabh keeo nivaas ||",
      "translation": "God dwells in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਰਿ ਜਪਿ ਜਪਿ ਹੋਈ ਪੂਰਨ ਆਸ ॥",
      "transliteration": "har jap jap hoee pooran aas ||",
      "translation": "Chanting and meditating on the Lord, one's hopes are fulfilled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ ਰਵਿ ਰਹਿਆ ॥",
      "transliteration": "jal thal maheeal rav rahiaa ||",
      "translation": "God permeates and pervades the water, the land and the sky.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰ ਮਿਲਿ ਨਾਨਕਿ ਹਰਿ ਹਰਿ ਕਹਿਆ ॥੩॥",
      "transliteration": "gur mil naanak har har kahiaa ||3||",
      "translation": "Meeting with the Guru, Nanak chants the Name of the Lord, Har, Har. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਸਟ ਸਿਧਿ ਨਵ ਨਿਧਿ ਏਹ ॥",
      "transliteration": "asat sidh nav nidh eh ||",
      "translation": "The eight miraculous spiritual powers and the nine treasures are contained in the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਰਮਿ ਪਰਾਪਤਿ ਜਿਸੁ ਨਾਮੁ ਦੇਹ ॥",
      "transliteration": "karam paraapat jis naam deh ||",
      "translation": "This is bestowed when God grants His Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪ੍ਰਭ ਜਪਿ ਜਪਿ ਜੀਵਹਿ ਤੇਰੇ ਦਾਸ ॥",
      "transliteration": "prabh jap jap jeevahi tere daas ||",
      "translation": "Your slaves, O God, live by chanting and meditating on Your Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰ ਮਿਲਿ ਨਾਨਕ ਕਮਲ ਪ੍ਰਗਾਸ ॥੪॥੧੩॥",
      "transliteration": "gur mil naanak kamal pragaas ||4||13||",
      "translation": "O Nanak, the heart-lotus of the Gurmukh blossoms forth. ||4||13||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ਘਰੁ ੧ ਇਕਤੁਕੇ ॥",
      "transliteration": "basa(n)t mahalaa 5 ghar 1 ikatuke ||",
      "translation": "Basant, Fifth Mehl, First House, Ik-Thukay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਗਲ ਇਛਾ ਜਪਿ ਪੁੰਨੀਆ ॥",
      "transliteration": "sagal ichhaa jap pu(n)neeaa ||",
      "translation": "Meditating on the Lord, all desires are fulfilled,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਪ੍ਰਭਿ ਮੇਲੇ ਚਿਰੀ ਵਿਛੁੰਨਿਆ ॥੧॥",
      "transliteration": "prabh mele chiree vichhu(n)niaa ||1||",
      "translation": "and the mortal is re-united with God, after having been separated for so long. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤੁਮ ਰਵਹੁ ਗੋਬਿੰਦੈ ਰਵਣ ਜੋਗੁ ॥",
      "transliteration": "tum ravahu gobi(n)dai ravan jog ||",
      "translation": "Meditate on the Lord of the Universe, who is worthy of meditation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਤੁ ਰਵਿਐ ਸੁਖ ਸਹਜ ਭੋਗੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jit raviai sukh sahaj bhog ||1|| rahaau ||",
      "translation": "Meditating on Him, enjoy celestial peace and poise. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਨਦਰਿ ਨਿਹਾਲਿਆ ॥",
      "transliteration": "kar kirapaa nadar nihaaliaa ||",
      "translation": "Bestowing His Mercy, He blesses us with His Glance of Grace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਪਣਾ ਦਾਸੁ ਆਪਿ ਸਮੑਾਲਿਆ ॥੨॥",
      "transliteration": "apanaa daas aap samhaaliaa ||2||",
      "translation": "God Himself takes care of His slave. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੇਜ ਸੁਹਾਵੀ ਰਸਿ ਬਨੀ ॥",
      "transliteration": "sej suhaavee ras banee ||",
      "translation": "My bed has been beautified by His Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਇ ਮਿਲੇ ਪ੍ਰਭ ਸੁਖ ਧਨੀ ॥੩॥",
      "transliteration": "aai mile prabh sukh dhanee ||3||",
      "translation": "God, the Giver of Peace, has come to meet me. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੇਰਾ ਗੁਣੁ ਅਵਗਣੁ ਨ ਬੀਚਾਰਿਆ ॥",
      "transliteration": "meraa gun avagan na beechaariaa ||",
      "translation": "He does not consider my merits and demerits.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪ੍ਰਭ ਨਾਨਕ ਚਰਣ ਪੂਜਾਰਿਆ ॥੪॥੧॥੧੪॥",
      "transliteration": "prabh naanak charan poojaariaa ||4||1||14||",
      "translation": "Nanak worships at the Feet of God. ||4||1||14||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਕਿਲਬਿਖ ਬਿਨਸੇ ਗਾਇ ਗੁਨਾ ॥",
      "transliteration": "kilabikh binase gaai gunaa ||",
      "translation": "The sins are erased, singing the Glories of God;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਨਦਿਨ ਉਪਜੀ ਸਹਜ ਧੁਨਾ ॥੧॥",
      "transliteration": "anadin upajee sahaj dhunaa ||1||",
      "translation": "night and day, celestial joy wells up. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਨੁ ਮਉਲਿਓ ਹਰਿ ਚਰਨ ਸੰਗਿ ॥",
      "transliteration": "man maulio har charan sa(n)g ||",
      "translation": "My mind has blossomed forth, by the touch of the Lord's Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਸਾਧੂ ਜਨ ਭੇਟੇ ਨਿਤ ਰਾਤੌ ਹਰਿ ਨਾਮ ਰੰਗਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kar kirapaa saadhoo jan bhete nit raatau har naam ra(n)g ||1|| rahaau ||",
      "translation": "By His Grace, He has led me to meet the Holy men, the humble servants of the Lord. I remain continually imbued with the love of the Lord's Name. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਗਟੇ ਗੋੁਪਾਲ ॥",
      "transliteration": "kar kirapaa pragate goupaal ||",
      "translation": "In His Mercy, the Lord of the World has revealed Himself to me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਲੜਿ ਲਾਇ ਉਧਾਰੇ ਦੀਨ ਦਇਆਲ ॥੨॥",
      "transliteration": "laR laai udhaare deen daiaal ||2||",
      "translation": "The Lord, Merciful to the meek, has attached me to the hem of His robe and saved me. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਹੁ ਮਨੁ ਹੋਆ ਸਾਧ ਧੂਰਿ ॥",
      "transliteration": "ihu man hoaa saadh dhoor ||",
      "translation": "This mind has become the dust of the Holy;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਿਤ ਦੇਖੈ ਸੁਆਮੀ ਹਜੂਰਿ ॥੩॥",
      "transliteration": "nit dekhai suaamee hajoor ||3||",
      "translation": "I behold my Lord and Master, continually, ever-present. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਤ੍ਰਿਸਨਾ ਗਈ ॥",
      "transliteration": "kaam krodh trisanaa gaee ||",
      "translation": "Sexual desire, anger and desire have vanished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਨਾਨਕ ਪ੍ਰਭ ਕਿਰਪਾ ਭਈ ॥੪॥੨॥੧੫॥",
      "transliteration": "naanak prabh kirapaa bhaee ||4||2||15||",
      "translation": "O Nanak, God has become kind to me. ||4||2||15||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰੋਗ ਮਿਟਾਏ ਪ੍ਰਭੂ ਆਪਿ ॥",
      "transliteration": "rog mitaae prabhoo aap ||",
      "translation": "God Himself has cured the disease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਬਾਲਕ ਰਾਖੇ ਅਪਨੇ ਕਰ ਥਾਪਿ ॥੧॥",
      "transliteration": "baalak raakhe apane kar thaap ||1||",
      "translation": "He laid on His Hands, and protected His child. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਾਂਤਿ ਸਹਜ ਗ੍ਰਿਹਿ ਸਦ ਬਸੰਤੁ ॥",
      "transliteration": "saa(n)t sahaj grihi sad basa(n)t ||",
      "translation": "Celestial peace and tranquility fill my home forever, in this springtime of the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕੀ ਸਰਣੀ ਆਏ ਕਲਿਆਣ ਰੂਪ ਜਪਿ ਹਰਿ ਹਰਿ ਮੰਤੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur poore kee saranee aae kaliaan roop jap har har ma(n)t ||1|| rahaau ||",
      "translation": "I have sought the Sanctuary of the Perfect Guru; I chant the Mantra of the Name of the Lord, Har, Har, the Embodiment of emancipation. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸੋਗ ਸੰਤਾਪ ਕਟੇ ਪ੍ਰਭਿ ਆਪਿ ॥",
      "transliteration": "sog sa(n)taap kate prabh aap ||",
      "translation": "God Himself has dispelled my sorrow and suffering.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰ ਅਪੁਨੇ ਕਉ ਨਿਤ ਨਿਤ ਜਾਪਿ ॥੨॥",
      "transliteration": "gur apune kau nit nit jaap ||2||",
      "translation": "I meditate continually, continuously, on my Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਜੋ ਜਨੁ ਤੇਰਾ ਜਪੇ ਨਾਉ ॥",
      "transliteration": "jo jan teraa jape naau ||",
      "translation": "That humble being who chants Your Name,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਭਿ ਫਲ ਪਾਏ ਨਿਹਚਲ ਗੁਣ ਗਾਉ ॥੩॥",
      "transliteration": "sabh phal paae nihachal gun gaau ||3||",
      "translation": "obtains all fruits and rewards; singing the Glories of God, he becomes steady and stable. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਨਾਨਕ ਭਗਤਾ ਭਲੀ ਰੀਤਿ ॥",
      "transliteration": "naanak bhagataa bhalee reet ||",
      "translation": "O Nanak, the way of the devotees is good.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਸੁਖਦਾਤਾ ਜਪਦੇ ਨੀਤ ਨੀਤਿ ॥੪॥੩॥੧੬॥",
      "transliteration": "sukhadaataa japade neet neet ||4||3||16||",
      "translation": "They meditate continually, continuously, on the Lord, the Giver of peace. ||4||3||16||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹੁਕਮੁ ਕਰਿ ਕੀਨੑੇ ਨਿਹਾਲ ॥",
      "transliteration": "hukam kar keenhe nihaal ||",
      "translation": "By His Will, He makes us happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਅਪਨੇ ਸੇਵਕ ਕਉ ਭਇਆ ਦਇਆਲੁ ॥੧॥",
      "transliteration": "apane sevak kau bhaiaa daiaal ||1||",
      "translation": "He shows Mercy to His servant. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਸਭੁ ਪੂਰਾ ਕੀਆ ॥",
      "transliteration": "gur poorai sabh pooraa keeaa ||",
      "translation": "The Perfect Guru makes everything perfect.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮੁ ਰਿਦ ਮਹਿ ਦੀਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "a(n)mrit naam rid mahi deeaa ||1|| rahaau ||",
      "translation": "He implants the Amrosial Naam, the Name of the Lord, in the heart. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1184_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਰਮੁ ਧਰਮੁ ਮੇਰਾ ਕਛੁ ਨ ਬੀਚਾਰਿਓ ॥",
      "transliteration": "karam dharam meraa kachh na beechaario ||",
      "translation": "He does not consider the karma of my actions, or my Dharma, my spiritual practice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1184,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
