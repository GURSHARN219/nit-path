{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1187,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1187_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਤੈ ਸਾਚਾ ਮਾਨਿਆ ਕਿਹ ਬਿਚਾਰਿ ॥੧॥",
      "transliteration": "tai saachaa maaniaa kih bichaar ||1||",
      "translation": "What makes you think that it is real? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਧਨੁ ਦਾਰਾ ਸੰਪਤਿ ਗ੍ਰੇਹ ॥",
      "transliteration": "dhan daaraa sa(n)pat greh ||",
      "translation": "Wealth, spouse, property and household",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਛੁ ਸੰਗਿ ਨ ਚਾਲੈ ਸਮਝ ਲੇਹ ॥੨॥",
      "transliteration": "kachh sa(n)g na chaalai samajh leh ||2||",
      "translation": "- none of them shall go along with you; you must know that this is true! ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਇਕ ਭਗਤਿ ਨਾਰਾਇਨ ਹੋਇ ਸੰਗਿ ॥",
      "transliteration": "ik bhagat naaraain hoi sa(n)g ||",
      "translation": "Only devotion to the Lord shall go with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਭਜੁ ਤਿਹ ਏਕ ਰੰਗਿ ॥੩॥੪॥",
      "transliteration": "kahu naanak bhaj tih ek ra(n)g ||3||4||",
      "translation": "Says Nanak, vibrate and meditate on the Lord with single-minded love. ||3||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੯ ॥",
      "transliteration": "basa(n)t mahalaa 9 ||",
      "translation": "Basant, Ninth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਹਾ ਭੂਲਿਓ ਰੇ ਝੂਠੇ ਲੋਭ ਲਾਗ ॥",
      "transliteration": "kahaa bhoolio re jhoothe lobh laag ||",
      "translation": "Why do you wander lost, O mortal, attached to falsehood and greed?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਕਛੁ ਬਿਗਰਿਓ ਨਾਹਿਨ ਅਜਹੁ ਜਾਗ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kachh bigario naahin ajahu jaag ||1|| rahaau ||",
      "translation": "Nothing has been lost yet - there is still time to wake up! ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਮ ਸੁਪਨੈ ਕੈ ਇਹੁ ਜਗੁ ਜਾਨੁ ॥",
      "transliteration": "sam supanai kai ihu jag jaan ||",
      "translation": "You must realize that this world is nothing more than a dream.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਨਸੈ ਛਿਨ ਮੈ ਸਾਚੀ ਮਾਨੁ ॥੧॥",
      "transliteration": "binasai chhin mai saachee maan ||1||",
      "translation": "In an instant, it shall perish; know this as true. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੰਗਿ ਤੇਰੈ ਹਰਿ ਬਸਤ ਨੀਤ ॥",
      "transliteration": "sa(n)g terai har basat neet ||",
      "translation": "The Lord constantly abides with you.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਨਿਸ ਬਾਸੁਰ ਭਜੁ ਤਾਹਿ ਮੀਤ ॥੨॥",
      "transliteration": "nis baasur bhaj taahi meet ||2||",
      "translation": "Night and day, vibrate and meditate on Him, O my friend. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਾਰ ਅੰਤ ਕੀ ਹੋਇ ਸਹਾਇ ॥",
      "transliteration": "baar a(n)t kee hoi sahaai ||",
      "translation": "At the very last instant, He shall be your Help and Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਨ ਤਾ ਕੇ ਗਾਇ ॥੩॥੫॥",
      "transliteration": "kahu naanak gun taa ke gaai ||3||5||",
      "translation": "Says Nanak, sing His Praises. ||3||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੧ ਅਸਟਪਦੀਆ ਘਰੁ ੧ ਦੁਤੁਕੀਆ ॥",
      "transliteration": "basa(n)t mahalaa 1 asatapadeeaa ghar 1 dutukeeaa ||",
      "translation": "Basant, First Mehl, Ashtpadheeyaa, First House, Du-Tukees:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਗੁ ਕਊਆ ਨਾਮੁ ਨਹੀ ਚੀਤਿ ॥",
      "transliteration": "jag kaooaa naam nahee cheet ||",
      "translation": "The world is a crow; it does not remember the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਮੁ ਬਿਸਾਰਿ ਗਿਰੈ ਦੇਖੁ ਭੀਤਿ ॥",
      "transliteration": "naam bisaar girai dekh bheet ||",
      "translation": "Forgetting the Naam, it sees the bait, and pecks at it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਨੂਆ ਡੋਲੈ ਚੀਤਿ ਅਨੀਤਿ ॥",
      "transliteration": "manooaa dolai cheet aneet ||",
      "translation": "The mind wavers unsteadily, in guilt and deceit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਗ ਸਿਉ ਤੂਟੀ ਝੂਠ ਪਰੀਤਿ ॥੧॥",
      "transliteration": "jag siu tootee jhooth pareet ||1||",
      "translation": "I have shattered my attachment to the false world. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਬਿਖੁ ਬਜਰੁ ਭਾਰੁ ॥",
      "transliteration": "kaam krodh bikh bajar bhaar ||",
      "translation": "The burden of sexual desire, anger and corruption is unbearable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਕੈਸੇ ਗੁਨ ਚਾਰੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naam binaa kaise gun chaar ||1|| rahaau ||",
      "translation": "Without the Naam, how can the mortal maintain a virtuous lifestyle? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਘਰੁ ਬਾਲੂ ਕਾ ਘੂਮਨ ਘੇਰਿ ॥",
      "transliteration": "ghar baaloo kaa ghooman gher ||",
      "translation": "The world is like a house of sand, built on a whirlpool;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬਰਖਸਿ ਬਾਣੀ ਬੁਦਬੁਦਾ ਹੇਰਿ ॥",
      "transliteration": "barakhas baanee budabudaa her ||",
      "translation": "it is like a bubble formed by drops of rain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਮਾਤ੍ਰ ਬੂੰਦ ਤੇ ਧਰਿ ਚਕੁ ਫੇਰਿ ॥",
      "transliteration": "maatr boo(n)d te dhar chak pher ||",
      "translation": "It is formed from a mere drop, when the Lord's wheel turns round.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸਰਬ ਜੋਤਿ ਨਾਮੈ ਕੀ ਚੇਰਿ ॥੨॥",
      "transliteration": "sarab jot naamai kee cher ||2||",
      "translation": "The lights of all souls are the servants of the Lord's Name. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸਰਬ ਉਪਾਇ ਗੁਰੂ ਸਿਰਿ ਮੋਰੁ ॥",
      "transliteration": "sarab upaai guroo sir mor ||",
      "translation": "My Supreme Guru has created everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਭਗਤਿ ਕਰਉ ਪਗ ਲਾਗਉ ਤੋਰ ॥",
      "transliteration": "bhagat karau pag laagau tor ||",
      "translation": "I perform devotional worship service to You, and fall at Your Feet, O Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਨਾਮਿ ਰਤੋ ਚਾਹਉ ਤੁਝ ਓਰੁ ॥",
      "transliteration": "naam rato chaahau tujh or ||",
      "translation": "Imbued with Your Name, I long to be Yours.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਨਾਮੁ ਦੁਰਾਇ ਚਲੈ ਸੋ ਚੋਰੁ ॥੩॥",
      "transliteration": "naam duraai chalai so chor ||3||",
      "translation": "Those who do not let the Naam become manifest within themselves, depart like thieves in the end. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪਤਿ ਖੋਈ ਬਿਖੁ ਅੰਚਲਿ ਪਾਇ ॥",
      "transliteration": "pat khoee bikh a(n)chal paai ||",
      "translation": "The mortal loses his honor, gathering sin and corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਾਚ ਨਾਮਿ ਰਤੋ ਪਤਿ ਸਿਉ ਘਰਿ ਜਾਇ ॥",
      "transliteration": "saach naam rato pat siu ghar jaai ||",
      "translation": "But imbued with the Lord's Name, you shall go to your true home with honor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕੀਨੑਸਿ ਪ੍ਰਭੁ ਰਜਾਇ ॥",
      "transliteration": "jo kichh keenhs prabh rajaai ||",
      "translation": "God does whatever He wills.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਭੈ ਮਾਨੈ ਨਿਰਭਉ ਮੇਰੀ ਮਾਇ ॥੪॥",
      "transliteration": "bhai maanai nirabhau meree maai ||4||",
      "translation": "One who abides in the Fear of God, becomes fearless, O my mother. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਾਮਨਿ ਚਾਹੈ ਸੁੰਦਰਿ ਭੋਗੁ ॥",
      "transliteration": "kaaman chaahai su(n)dar bhog ||",
      "translation": "The woman desires beauty and pleasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਪਾਨ ਫੂਲ ਮੀਠੇ ਰਸ ਰੋਗ ॥",
      "transliteration": "paan phool meethe ras rog ||",
      "translation": "But betel leaves, garlands of flowers and sweet tastes lead only to disease.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਖੀਲੈ ਬਿਗਸੈ ਤੇਤੋ ਸੋਗ ॥",
      "transliteration": "kheelai bigasai teto sog ||",
      "translation": "The more she plays and enjoys, the more she suffers in sorrow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪ੍ਰਭ ਸਰਣਾਗਤਿ ਕੀਨੑਸਿ ਹੋਗ ॥੫॥",
      "transliteration": "prabh saranaagat keenhs hog ||5||",
      "translation": "But when she enters into the Sanctuary of God, whatever she wishes comes to pass. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਾਪੜੁ ਪਹਿਰਸਿ ਅਧਿਕੁ ਸੀਗਾਰੁ ॥",
      "transliteration": "kaapaR pahiras adhik seegaar ||",
      "translation": "She wears beautiful clothes with all sorts of decorations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮਾਟੀ ਫੂਲੀ ਰੂਪੁ ਬਿਕਾਰੁ ॥",
      "transliteration": "maatee phoolee roop bikaar ||",
      "translation": "But the flowers turn to dust, and her beauty leads her into evil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਸਾ ਮਨਸਾ ਬਾਂਧੋ ਬਾਰੁ ॥",
      "transliteration": "aasaa manasaa baa(n)dho baar ||",
      "translation": "Hope and desire have blocked the doorway.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਸੂਨਾ ਘਰੁ ਬਾਰੁ ॥੬॥",
      "transliteration": "naam binaa soonaa ghar baar ||6||",
      "translation": "Without the Naam, one's hearth and home are deserted. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਗਾਛਹੁ ਪੁਤ੍ਰੀ ਰਾਜ ਕੁਆਰਿ ॥",
      "transliteration": "gaachhahu putree raaj kuaar ||",
      "translation": "O princess, my daughter, run away from this place!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਨਾਮੁ ਭਣਹੁ ਸਚੁ ਦੋਤੁ ਸਵਾਰਿ ॥",
      "transliteration": "naam bhanahu sach dot savaar ||",
      "translation": "Chant the True Name, and embellish your days.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਪ੍ਰਿਉ ਸੇਵਹੁ ਪ੍ਰਭ ਪ੍ਰੇਮ ਅਧਾਰਿ ॥",
      "transliteration": "priu sevahu prabh prem adhaar ||",
      "translation": "Serve your Beloved Lord God, and lean on the Support of His Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰਸਬਦੀ ਬਿਖੁ ਤਿਆਸ ਨਿਵਾਰਿ ॥੭॥",
      "transliteration": "gurasabadee bikh tiaas nivaar ||7||",
      "translation": "Through the Word of the Guru's Shabad, abandon your thirst for corruption and poison. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮੋਹਨਿ ਮੋਹਿ ਲੀਆ ਮਨੁ ਮੋਹਿ ॥",
      "transliteration": "mohan mohi leeaa man mohi ||",
      "translation": "My Fascinating Lord has fascinated my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗੁਰ ਕੈ ਸਬਦਿ ਪਛਾਨਾ ਤੋਹਿ ॥",
      "transliteration": "gur kai sabad pachhaanaa tohi ||",
      "translation": "Through the Word of the Guru's Shabad, I have realized You, Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਨਾਨਕ ਠਾਢੇ ਚਾਹਹਿ ਪ੍ਰਭੂ ਦੁਆਰਿ ॥",
      "transliteration": "naanak thaadhe chaahahi prabhoo duaar ||",
      "translation": "Nanak stands longingly at God's Door.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤੇਰੇ ਨਾਮਿ ਸੰਤੋਖੇ ਕਿਰਪਾ ਧਾਰਿ ॥੮॥੧॥",
      "transliteration": "tere naam sa(n)tokhe kirapaa dhaar ||8||1||",
      "translation": "I am content and satisfied with Your Name; please shower me with Your Mercy. ||8||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੧ ॥",
      "transliteration": "basa(n)t mahalaa 1 ||",
      "translation": "Basant, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਨੁ ਭੂਲਉ ਭਰਮਸਿ ਆਇ ਜਾਇ ॥",
      "transliteration": "man bhoolau bharamas aai jaai ||",
      "translation": "The mind is deluded by doubt; it comes and goes in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਅਤਿ ਲੁਬਧ ਲੁਭਾਨਉ ਬਿਖਮ ਮਾਇ ॥",
      "transliteration": "at lubadh lubhaanau bikham maai ||",
      "translation": "It is lured by the poisonous lure of Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਨਹ ਅਸਥਿਰੁ ਦੀਸੈ ਏਕ ਭਾਇ ॥",
      "transliteration": "nah asathir deesai ek bhaai ||",
      "translation": "It does not remain stable in the Love of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਜਿਉ ਮੀਨ ਕੁੰਡਲੀਆ ਕੰਠਿ ਪਾਇ ॥੧॥",
      "transliteration": "jiu meen ku(n)daleeaa ka(n)th paai ||1||",
      "translation": "Like the fish, its neck is pierced by the hook. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਮਨੁ ਭੂਲਉ ਸਮਝਸਿ ਸਾਚ ਨਾਇ ॥",
      "transliteration": "man bhoolau samajhas saach naai ||",
      "translation": "The deluded mind is instructed by the True Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1187_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਗੁਰਸਬਦੁ ਬੀਚਾਰੇ ਸਹਜ ਭਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gurasabad beechaare sahaj bhaai ||1|| rahaau ||",
      "translation": "It contemplates the Word of the Guru's Shabad, with intuitive ease. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1187,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
