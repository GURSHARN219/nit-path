{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1188,
  "lineCount": 58,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1188_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਨੁ ਭੂਲਉ ਭਰਮਸਿ ਭਵਰ ਤਾਰ ॥",
      "transliteration": "man bhoolau bharamas bhavar taar ||",
      "translation": "The mind, deluded by doubt, buzzes around like a bumble bee.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਬਿਲ ਬਿਰਥੇ ਚਾਹੈ ਬਹੁ ਬਿਕਾਰ ॥",
      "transliteration": "bil birathe chaahai bahu bikaar ||",
      "translation": "The holes of the body are worthless, if the mind is filled with such great desire for corrupt passions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮੈਗਲ ਜਿਉ ਫਾਸਸਿ ਕਾਮਹਾਰ ॥",
      "transliteration": "maigal jiu phaasas kaamahaar ||",
      "translation": "It is like the elephant, trapped by its own sexual desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਕੜਿ ਬੰਧਨਿ ਬਾਧਿਓ ਸੀਸ ਮਾਰ ॥੨॥",
      "transliteration": "kaR ba(n)dhan baadhio sees maar ||2||",
      "translation": "It is caught and held tight by the chains, and beaten on its head. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮਨੁ ਮੁਗਧੌ ਦਾਦਰੁ ਭਗਤਿਹੀਨੁ ॥",
      "transliteration": "man mugadhau daadar bhagatiheen ||",
      "translation": "The mind is like a foolish frog, without devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਦਰਿ ਭ੍ਰਸਟ ਸਰਾਪੀ ਨਾਮ ਬੀਨੁ ॥",
      "transliteration": "dar bhrasat saraapee naam been ||",
      "translation": "It is cursed and condemned in the Court of the Lord, without the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤਾ ਕੈ ਜਾਤਿ ਨ ਪਾਤੀ ਨਾਮ ਲੀਨ ॥",
      "transliteration": "taa kai jaat na paatee naam leen ||",
      "translation": "He has no class or honor, and no one even mentions his name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਭਿ ਦੂਖ ਸਖਾਈ ਗੁਣਹ ਬੀਨ ॥੩॥",
      "transliteration": "sabh dookh sakhaaee gunah been ||3||",
      "translation": "That person who lacks virtue - all of his pains and sorrows are his only companions. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਨੁ ਚਲੈ ਨ ਜਾਈ ਠਾਕਿ ਰਾਖੁ ॥",
      "transliteration": "man chalai na jaaee thaak raakh ||",
      "translation": "His mind wanders out, and cannot be brought back or restrained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਰਸ ਰਾਤੇ ਪਤਿ ਨ ਸਾਖੁ ॥",
      "transliteration": "bin har ras raate pat na saakh ||",
      "translation": "Without being imbued with the sublime essence of the Lord, it has no honor or credit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੂ ਆਪੇ ਸੁਰਤਾ ਆਪਿ ਰਾਖੁ ॥",
      "transliteration": "too aape surataa aap raakh ||",
      "translation": "You Yourself are the Listener, Lord, and You Yourself are our Protector.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਧਰਿ ਧਾਰਣ ਦੇਖੈ ਜਾਣੈ ਆਪਿ ॥੪॥",
      "transliteration": "dhar dhaaran dekhai jaanai aap ||4||",
      "translation": "You are the Support of the earth; You Yourself behold and understand it. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਆਪਿ ਭੁਲਾਏ ਕਿਸੁ ਕਹਉ ਜਾਇ ॥",
      "transliteration": "aap bhulaae kis kahau jaai ||",
      "translation": "When You Yourself make me wander, unto whom can I complain?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗੁਰੁ ਮੇਲੇ ਬਿਰਥਾ ਕਹਉ ਮਾਇ ॥",
      "transliteration": "gur mele birathaa kahau maai ||",
      "translation": "Meeting the Guru, I will tell Him of my pain, O my mother.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਵਗਣ ਛੋਡਉ ਗੁਣ ਕਮਾਇ ॥",
      "transliteration": "avagan chhodau gun kamaai ||",
      "translation": "Abandoning my worthless demerits, now I practice virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰਸਬਦੀ ਰਾਤਾ ਸਚਿ ਸਮਾਇ ॥੫॥",
      "transliteration": "gurasabadee raataa sach samaai ||5||",
      "translation": "Imbued with the Word of the Guru's Shabad, I am absorbed in the True Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸਤਿਗੁਰ ਮਿਲਿਐ ਮਤਿ ਊਤਮ ਹੋਇ ॥",
      "transliteration": "satigur miliai mat ootam hoi ||",
      "translation": "Meeting with the True Guru, the intellect is elevated and exalted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਮਨੁ ਨਿਰਮਲੁ ਹਉਮੈ ਕਢੈ ਧੋਇ ॥",
      "transliteration": "man niramal haumai kadhai dhoi ||",
      "translation": "The mind becomes immaculate, and egotism is washed away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਦਾ ਮੁਕਤੁ ਬੰਧਿ ਨ ਸਕੈ ਕੋਇ ॥",
      "transliteration": "sadaa mukat ba(n)dh na sakai koi ||",
      "translation": "He is liberated forever, and no one can put him in bondage.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਦਾ ਨਾਮੁ ਵਖਾਣੈ ਅਉਰੁ ਨ ਕੋਇ ॥੬॥",
      "transliteration": "sadaa naam vakhaanai aur na koi ||6||",
      "translation": "He chants the Naam forever, and nothing else. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਨੁ ਹਰਿ ਕੈ ਭਾਣੈ ਆਵੈ ਜਾਇ ॥",
      "transliteration": "man har kai bhaanai aavai jaai ||",
      "translation": "The mind comes and goes according to the Will of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਭ ਮਹਿ ਏਕੋ ਕਿਛੁ ਕਹਣੁ ਨ ਜਾਇ ॥",
      "transliteration": "sabh mahi eko kichh kahan na jaai ||",
      "translation": "The One Lord is contained amongst all; nothing else can be said.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਭੁ ਹੁਕਮੋ ਵਰਤੈ ਹੁਕਮਿ ਸਮਾਇ ॥",
      "transliteration": "sabh hukamo varatai hukam samaai ||",
      "translation": "The Hukam of His Command pervades everywhere, and all merge in His Command.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਦੂਖ ਸੂਖ ਸਭ ਤਿਸੁ ਰਜਾਇ ॥੭॥",
      "transliteration": "dookh sookh sabh tis rajaai ||7||",
      "translation": "Pain and pleasure all come by His Will. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤੂ ਅਭੁਲੁ ਨ ਭੂਲੌ ਕਦੇ ਨਾਹਿ ॥",
      "transliteration": "too abhul na bhoolau kade naahi ||",
      "translation": "You are infallible; You never make mistakes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੁਰਸਬਦੁ ਸੁਣਾਏ ਮਤਿ ਅਗਾਹਿ ॥",
      "transliteration": "gurasabad sunaae mat agaahi ||",
      "translation": "Those who listen to the Word of the Guru's Shabad - their intellects become deep and profound.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਤੂ ਮੋਟਉ ਠਾਕੁਰੁ ਸਬਦ ਮਾਹਿ ॥",
      "transliteration": "too motau thaakur sabad maahi ||",
      "translation": "You, O my Great Lord and Master, are contained in the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਨੁ ਨਾਨਕ ਮਾਨਿਆ ਸਚੁ ਸਲਾਹਿ ॥੮॥੨॥",
      "transliteration": "man naanak maaniaa sach salaahi ||8||2||",
      "translation": "O Nanak, my mind is pleased, praising the True Lord. ||8||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੧ ॥",
      "transliteration": "basa(n)t mahalaa 1 ||",
      "translation": "Basant, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਦਰਸਨ ਕੀ ਪਿਆਸ ਜਿਸੁ ਨਰ ਹੋਇ ॥",
      "transliteration": "darasan kee piaas jis nar hoi ||",
      "translation": "That person, who thirsts for the Blessed Vision of the Lord's Darshan,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਏਕਤੁ ਰਾਚੈ ਪਰਹਰਿ ਦੋਇ ॥",
      "transliteration": "ekat raachai parahar doi ||",
      "translation": "is absorbed in the One Lord, leaving duality behind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਦੂਰਿ ਦਰਦੁ ਮਥਿ ਅੰਮ੍ਰਿਤੁ ਖਾਇ ॥",
      "transliteration": "door darad math a(n)mrit khaai ||",
      "translation": "His pains are taken away, as he churns and drinks in the Ambrosial Nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਬੂਝੈ ਏਕ ਸਮਾਇ ॥੧॥",
      "transliteration": "guramukh boojhai ek samaai ||1||",
      "translation": "The Gurmukh understands, and merges in the One Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੇਰੇ ਦਰਸਨ ਕਉ ਕੇਤੀ ਬਿਲਲਾਇ ॥",
      "transliteration": "tere darasan kau ketee bilalaai ||",
      "translation": "So many cry out for Your Darshan, Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਵਿਰਲਾ ਕੋ ਚੀਨਸਿ ਗੁਰ ਸਬਦਿ ਮਿਲਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "viralaa ko cheenas gur sabad milaai ||1|| rahaau ||",
      "translation": "How rare are those who realize the Word of the Guru's Shabad and merge with Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬੇਦ ਵਖਾਣਿ ਕਹਹਿ ਇਕੁ ਕਹੀਐ ॥",
      "transliteration": "bed vakhaan kahahi ik kaheeai ||",
      "translation": "The Vedas say that we should chant the Name of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਓਹੁ ਬੇਅੰਤੁ ਅੰਤੁ ਕਿਨਿ ਲਹੀਐ ॥",
      "transliteration": "ohu bea(n)t a(n)t kin laheeai ||",
      "translation": "He is endless; who can find His limits?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਏਕੋ ਕਰਤਾ ਜਿਨਿ ਜਗੁ ਕੀਆ ॥",
      "transliteration": "eko karataa jin jag keeaa ||",
      "translation": "There is only One Creator, who created the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਾਝੁ ਕਲਾ ਧਰਿ ਗਗਨੁ ਧਰੀਆ ॥੨॥",
      "transliteration": "baajh kalaa dhar gagan dhareeaa ||2||",
      "translation": "Without any pillars, He supports the earth and the sky. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਏਕੋ ਗਿਆਨੁ ਧਿਆਨੁ ਧੁਨਿ ਬਾਣੀ ॥",
      "transliteration": "eko giaan dhiaan dhun baanee ||",
      "translation": "Spiritual wisdom and meditation are contained in the melody of the Bani, the Word of the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਏਕੁ ਨਿਰਾਲਮੁ ਅਕਥ ਕਹਾਣੀ ॥",
      "transliteration": "ek niraalam akath kahaanee ||",
      "translation": "The One Lord is Untouched and Unstained; His story is unspoken.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਏਕੋ ਸਬਦੁ ਸਚਾ ਨੀਸਾਣੁ ॥",
      "transliteration": "eko sabad sachaa neesaan ||",
      "translation": "The Shabad, the Word, is the Insignia of the One True Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪੂਰੇ ਗੁਰ ਤੇ ਜਾਣੈ ਜਾਣੁ ॥੩॥",
      "transliteration": "poore gur te jaanai jaan ||3||",
      "translation": "Through the Perfect Guru, the Knowing Lord is known. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਏਕੋ ਧਰਮੁ ਦ੍ਰਿੜੈ ਸਚੁ ਕੋਈ ॥",
      "transliteration": "eko dharam driRai sach koee ||",
      "translation": "There is only one religion of Dharma; let everyone grasp this truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰਮਤਿ ਪੂਰਾ ਜੁਗਿ ਜੁਗਿ ਸੋਈ ॥",
      "transliteration": "guramat pooraa jug jug soee ||",
      "translation": "Through the Guru's Teachings, one becomes perfect, all the ages through.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਨਹਦਿ ਰਾਤਾ ਏਕ ਲਿਵ ਤਾਰ ॥",
      "transliteration": "anahad raataa ek liv taar ||",
      "translation": "Imbued with the Unmanifest Celestial Lord, and lovingly absorbed in the One,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਓਹੁ ਗੁਰਮੁਖਿ ਪਾਵੈ ਅਲਖ ਅਪਾਰ ॥੪॥",
      "transliteration": "ohu guramukh paavai alakh apaar ||4||",
      "translation": "the Gurmukh attains the invisible and infinite. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਏਕੋ ਤਖਤੁ ਏਕੋ ਪਾਤਿਸਾਹੁ ॥",
      "transliteration": "eko takhat eko paatisaahu ||",
      "translation": "There is one celestial throne, and One Supreme King.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਰਬੀ ਥਾਈ ਵੇਪਰਵਾਹੁ ॥",
      "transliteration": "sarabee thaaee veparavaahu ||",
      "translation": "The Independent Lord God is pervading all places.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਤਿਸ ਕਾ ਕੀਆ ਤ੍ਰਿਭਵਣ ਸਾਰੁ ॥",
      "transliteration": "tis kaa keeaa tribhavan saar ||",
      "translation": "The three worlds are the creation of that Sublime Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਓਹੁ ਅਗਮੁ ਅਗੋਚਰੁ ਏਕੰਕਾਰੁ ॥੫॥",
      "transliteration": "ohu agam agochar eka(n)kaar ||5||",
      "translation": "The One Creator of the Creation is Unfathomable and Incomprehensible. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਏਕਾ ਮੂਰਤਿ ਸਾਚਾ ਨਾਉ ॥",
      "transliteration": "ekaa moorat saachaa naau ||",
      "translation": "His Form is One, and True is His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤਿਥੈ ਨਿਬੜੈ ਸਾਚੁ ਨਿਆਉ ॥",
      "transliteration": "tithai nibaRai saach niaau ||",
      "translation": "True justice is administered there.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਸਾਚੀ ਕਰਣੀ ਪਤਿ ਪਰਵਾਣੁ ॥",
      "transliteration": "saachee karanee pat paravaan ||",
      "translation": "Those who practice Truth are honored and accepted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਸਾਚੀ ਦਰਗਹ ਪਾਵੈ ਮਾਣੁ ॥੬॥",
      "transliteration": "saachee daragah paavai maan ||6||",
      "translation": "They are honored in the Court of the True Lord. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਏਕਾ ਭਗਤਿ ਏਕੋ ਹੈ ਭਾਉ ॥",
      "transliteration": "ekaa bhagat eko hai bhaau ||",
      "translation": "Devotional worship of the One Lord is the expression of love for the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਬਿਨੁ ਭੈ ਭਗਤੀ ਆਵਉ ਜਾਉ ॥",
      "transliteration": "bin bhai bhagatee aavau jaau ||",
      "translation": "Without the Fear of God and devotional worship of Him, the mortal comes and goes in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1188_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਗੁਰ ਤੇ ਸਮਝਿ ਰਹੈ ਮਿਹਮਾਣੁ ॥",
      "transliteration": "gur te samajh rahai mihamaan ||",
      "translation": "One who obtains this understanding from the Guru dwells like an honored guest in this world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1188,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
