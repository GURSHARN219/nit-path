{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1189,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1189_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਰਿ ਰਸਿ ਰਾਤਾ ਜਨੁ ਪਰਵਾਣੁ ॥੭॥",
      "transliteration": "har ras raataa jan paravaan ||7||",
      "translation": "That humble being who is imbued with the sublime essence of the Lord is certified and approved. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਇਤ ਉਤ ਦੇਖਉ ਸਹਜੇ ਰਾਵਉ ॥",
      "transliteration": "it ut dekhau sahaje raavau ||",
      "translation": "I see Him here and there; I dwell on Him intuitively.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਤੁਝ ਬਿਨੁ ਠਾਕੁਰ ਕਿਸੈ ਨ ਭਾਵਉ ॥",
      "transliteration": "tujh bin thaakur kisai na bhaavau ||",
      "translation": "I do not love any other than You, O Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਨਾਨਕ ਹਉਮੈ ਸਬਦਿ ਜਲਾਇਆ ॥",
      "transliteration": "naanak haumai sabad jalaaiaa ||",
      "translation": "O Nanak, my ego has been burnt away by the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਸਾਚਾ ਦਰਸੁ ਦਿਖਾਇਆ ॥੮॥੩॥",
      "transliteration": "satigur saachaa daras dikhaaiaa ||8||3||",
      "translation": "The True Guru has shown me the Blessed Vision of the True Lord. ||8||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੧ ॥",
      "transliteration": "basa(n)t mahalaa 1 ||",
      "translation": "Basant, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਚੰਚਲੁ ਚੀਤੁ ਨ ਪਾਵੈ ਪਾਰਾ ॥",
      "transliteration": "cha(n)chal cheet na paavai paaraa ||",
      "translation": "The fickle consciousness cannot find the Lord's limits.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਵਤ ਜਾਤ ਨ ਲਾਗੈ ਬਾਰਾ ॥",
      "transliteration": "aavat jaat na laagai baaraa ||",
      "translation": "It is caught in non-stop coming and going.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੂਖੁ ਘਣੋ ਮਰੀਐ ਕਰਤਾਰਾ ॥",
      "transliteration": "dookh ghano mareeai karataaraa ||",
      "translation": "I am suffering and dying, O my Creator.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਨੁ ਪ੍ਰੀਤਮ ਕੋ ਕਰੈ ਨ ਸਾਰਾ ॥੧॥",
      "transliteration": "bin preetam ko karai na saaraa ||1||",
      "translation": "No one cares for me, except my Beloved. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸਭ ਊਤਮ ਕਿਸੁ ਆਖਉ ਹੀਨਾ ॥",
      "transliteration": "sabh ootam kis aakhau heenaa ||",
      "translation": "All are high and exalted; how can I call anyone low?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਭਗਤੀ ਸਚਿ ਨਾਮਿ ਪਤੀਨਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har bhagatee sach naam pateenaa ||1|| rahaau ||",
      "translation": "Devotional worship of the Lord and the True Name has satisfied me. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਉਖਧ ਕਰਿ ਥਾਕੀ ਬਹੁਤੇਰੇ ॥",
      "transliteration": "aukhadh kar thaakee bahutere ||",
      "translation": "I have taken all sorts of medicines; I am so tired of them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕਿਉ ਦੁਖੁ ਚੂਕੈ ਬਿਨੁ ਗੁਰ ਮੇਰੇ ॥",
      "transliteration": "kiu dukh chookai bin gur mere ||",
      "translation": "How can this disease be cured, without my Guru?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਭਗਤੀ ਦੂਖ ਘਣੇਰੇ ॥",
      "transliteration": "bin har bhagatee dookh ghanere ||",
      "translation": "Without devotional worship of the Lord, the pain is so great.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਦੁਖ ਸੁਖ ਦਾਤੇ ਠਾਕੁਰ ਮੇਰੇ ॥੨॥",
      "transliteration": "dukh sukh daate thaakur mere ||2||",
      "translation": "My Lord and Master is the Giver of pain and pleasure. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰੋਗੁ ਵਡੋ ਕਿਉ ਬਾਂਧਉ ਧੀਰਾ ॥",
      "transliteration": "rog vado kiu baa(n)dhau dheeraa ||",
      "translation": "The disease is so deadly; how can I find the courage?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਰੋਗੁ ਬੁਝੈ ਸੋ ਕਾਟੈ ਪੀਰਾ ॥",
      "transliteration": "rog bujhai so kaatai peeraa ||",
      "translation": "He knows my disease, and only He can take away the pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮੈ ਅਵਗਣ ਮਨ ਮਾਹਿ ਸਰੀਰਾ ॥",
      "transliteration": "mai avagan man maahi sareeraa ||",
      "translation": "My mind and body are filled with faults and demerits.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਢੂਢਤ ਖੋਜਤ ਗੁਰਿ ਮੇਲੇ ਬੀਰਾ ॥੩॥",
      "transliteration": "dhoodhat khojat gur mele beeraa ||3||",
      "translation": "I searched and searched, and found the Guru, O my brother! ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਦਾਰੂ ਹਰਿ ਨਾਉ ॥",
      "transliteration": "gur kaa sabad daaroo har naau ||",
      "translation": "The Word of the Guru's Shabad, and the Lord's Name are the cures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜਿਉ ਤੂ ਰਾਖਹਿ ਤਿਵੈ ਰਹਾਉ ॥",
      "transliteration": "jiu too raakhahi tivai rahaau ||",
      "translation": "As You keep me, so do I remain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਗੁ ਰੋਗੀ ਕਹ ਦੇਖਿ ਦਿਖਾਉ ॥",
      "transliteration": "jag rogee kah dekh dikhaau ||",
      "translation": "The world is sick; where should I look?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਰਿ ਨਿਰਮਾਇਲੁ ਨਿਰਮਲੁ ਨਾਉ ॥੪॥",
      "transliteration": "har niramaail niramal naau ||4||",
      "translation": "The Lord is Pure and Immaculate; Immaculate is His Name. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਘਰ ਮਹਿ ਘਰੁ ਜੋ ਦੇਖਿ ਦਿਖਾਵੈ ॥",
      "transliteration": "ghar mahi ghar jo dekh dikhaavai ||",
      "translation": "The Guru sees and reveals the Lord's home, deep within the home of the self;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੁਰ ਮਹਲੀ ਸੋ ਮਹਲਿ ਬੁਲਾਵੈ ॥",
      "transliteration": "gur mahalee so mahal bulaavai ||",
      "translation": "He ushers the soul-bride into the Mansion of the Lord's Presence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਨ ਮਹਿ ਮਨੂਆ ਚਿਤ ਮਹਿ ਚੀਤਾ ॥",
      "transliteration": "man mahi manooaa chit mahi cheetaa ||",
      "translation": "When the mind remains in the mind, and the consciousness in the consciousness,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਐਸੇ ਹਰਿ ਕੇ ਲੋਗ ਅਤੀਤਾ ॥੫॥",
      "transliteration": "aise har ke log ateetaa ||5||",
      "translation": "such people of the Lord remain unattached. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਹਰਖ ਸੋਗ ਤੇ ਰਹਹਿ ਨਿਰਾਸਾ ॥",
      "transliteration": "harakh sog te rahahi niraasaa ||",
      "translation": "They remain free of any desire for happiness or sorrow;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅੰਮ੍ਰਿਤੁ ਚਾਖਿ ਹਰਿ ਨਾਮਿ ਨਿਵਾਸਾ ॥",
      "transliteration": "a(n)mrit chaakh har naam nivaasaa ||",
      "translation": "tasting the Amrit, the Ambrosial Nectar, they abide in the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਪੁ ਪਛਾਣਿ ਰਹੈ ਲਿਵ ਲਾਗਾ ॥",
      "transliteration": "aap pachhaan rahai liv laagaa ||",
      "translation": "They recognize their own selves, and remain lovingly attuned to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਜਨਮੁ ਜੀਤਿ ਗੁਰਮਤਿ ਦੁਖੁ ਭਾਗਾ ॥੬॥",
      "transliteration": "janam jeet guramat dukh bhaagaa ||6||",
      "translation": "They are victorious on the battlefield of life, following the Guru's Teachings, and their pains run away. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰਿ ਦੀਆ ਸਚੁ ਅੰਮ੍ਰਿਤੁ ਪੀਵਉ ॥",
      "transliteration": "gur deeaa sach a(n)mrit peevau ||",
      "translation": "The Guru has given me the True Ambrosial Nectar; I drink it in.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਹਜਿ ਮਰਉ ਜੀਵਤ ਹੀ ਜੀਵਉ ॥",
      "transliteration": "sahaj marau jeevat hee jeevau ||",
      "translation": "Of course, I have died, and now I am alive to live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਪਣੋ ਕਰਿ ਰਾਖਹੁ ਗੁਰ ਭਾਵੈ ॥",
      "transliteration": "apano kar raakhahu gur bhaavai ||",
      "translation": "Please, protect me as Your Own, if it pleases You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤੁਮਰੋ ਹੋਇ ਸੁ ਤੁਝਹਿ ਸਮਾਵੈ ॥੭॥",
      "transliteration": "tumaro hoi s tujhahi samaavai ||7||",
      "translation": "One who is Yours, merges into You. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਭੋਗੀ ਕਉ ਦੁਖੁ ਰੋਗ ਵਿਆਪੈ ॥",
      "transliteration": "bhogee kau dukh rog viaapai ||",
      "translation": "Painful diseases afflict those who are sexually promiscuous.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਰਵਿ ਰਹਿਆ ਪ੍ਰਭੁ ਜਾਪੈ ॥",
      "transliteration": "ghat ghat rav rahiaa prabh jaapai ||",
      "translation": "God appears permeating and pervading in each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸੁਖ ਦੁਖ ਹੀ ਤੇ ਗੁਰ ਸਬਦਿ ਅਤੀਤਾ ॥",
      "transliteration": "sukh dukh hee te gur sabad ateetaa ||",
      "translation": "One who remains unattached, through the Word of the Guru's Shabad",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਨਾਨਕ ਰਾਮੁ ਰਵੈ ਹਿਤ ਚੀਤਾ ॥੮॥੪॥",
      "transliteration": "naanak raam ravai hit cheetaa ||8||4||",
      "translation": "- O Nanak, his heart and consciousness dwell upon and savor the Lord. ||8||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੧ ਇਕ ਤੁਕੀਆ ॥",
      "transliteration": "basa(n)t mahalaa 1 ik tukeeaa ||",
      "translation": "Basant, First Mehl, Ik-Tukee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਮਤੁ ਭਸਮ ਅੰਧੂਲੇ ਗਰਬਿ ਜਾਹਿ ॥",
      "transliteration": "mat bhasam a(n)dhoole garab jaahi ||",
      "translation": "Do not make such a show of rubbing ashes on your body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਨ ਬਿਧਿ ਨਾਗੇ ਜੋਗੁ ਨਾਹਿ ॥੧॥",
      "transliteration": "in bidh naage jog naahi ||1||",
      "translation": "O naked Yogi, this is not the way of Yoga! ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮੂੜੑੇ ਕਾਹੇ ਬਿਸਾਰਿਓ ਤੈ ਰਾਮ ਨਾਮ ॥",
      "transliteration": "mooRhe kaahe bisaario tai raam naam ||",
      "translation": "You fool! How can you have forgotten the Lord's Name?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅੰਤ ਕਾਲਿ ਤੇਰੈ ਆਵੈ ਕਾਮ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "a(n)t kaal terai aavai kaam ||1|| rahaau ||",
      "translation": "At the very last moment, it and it alone shall be of any use to you. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਰ ਪੂਛਿ ਤੁਮ ਕਰਹੁ ਬੀਚਾਰੁ ॥",
      "transliteration": "gur poochh tum karahu beechaar ||",
      "translation": "Consult the Guru, reflect and think it over.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਜਹ ਦੇਖਉ ਤਹ ਸਾਰਿਗਪਾਣਿ ॥੨॥",
      "transliteration": "jah dekhau tah saarigapaan ||2||",
      "translation": "Wherever I look, I see the Lord of the World. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਕਿਆ ਹਉ ਆਖਾ ਜਾਂ ਕਛੂ ਨਾਹਿ ॥",
      "transliteration": "kiaa hau aakhaa jaa(n) kachhoo naahi ||",
      "translation": "What can I say? I am nothing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਜਾਤਿ ਪਤਿ ਸਭ ਤੇਰੈ ਨਾਇ ॥੩॥",
      "transliteration": "jaat pat sabh terai naai ||3||",
      "translation": "All my status and honor are in Your Name. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਾਹੇ ਮਾਲੁ ਦਰਬੁ ਦੇਖਿ ਗਰਬਿ ਜਾਹਿ ॥",
      "transliteration": "kaahe maal darab dekh garab jaahi ||",
      "translation": "Why do you take such pride in gazing upon your property and wealth?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਚਲਤੀ ਬਾਰ ਤੇਰੋ ਕਛੂ ਨਾਹਿ ॥੪॥",
      "transliteration": "chalatee baar tero kachhoo naahi ||4||",
      "translation": "When you must leave, nothing shall go along with you. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪੰਚ ਮਾਰਿ ਚਿਤੁ ਰਖਹੁ ਥਾਇ ॥",
      "transliteration": "pa(n)ch maar chit rakhahu thaai ||",
      "translation": "So subdue the five thieves, and hold your consciousness in its place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜੋਗ ਜੁਗਤਿ ਕੀ ਇਹੈ ਪਾਂਇ ॥੫॥",
      "transliteration": "jog jugat kee ihai paa(n)i ||5||",
      "translation": "This is the basis of the way of Yoga. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਹਉਮੈ ਪੈਖੜੁ ਤੇਰੇ ਮਨੈ ਮਾਹਿ ॥",
      "transliteration": "haumai paikhaR tere manai maahi ||",
      "translation": "Your mind is tied with the rope of egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਹਰਿ ਨ ਚੇਤਹਿ ਮੂੜੇ ਮੁਕਤਿ ਜਾਹਿ ॥੬॥",
      "transliteration": "har na chetahi mooRe mukat jaahi ||6||",
      "translation": "You do not even think of the Lord - you fool! He alone shall liberate you. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਮਤ ਹਰਿ ਵਿਸਰਿਐ ਜਮ ਵਸਿ ਪਾਹਿ ॥",
      "transliteration": "mat har visariai jam vas paahi ||",
      "translation": "If you forget the Lord, you will fall into the clutches of the Messenger of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1189_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਅੰਤ ਕਾਲਿ ਮੂੜੇ ਚੋਟ ਖਾਹਿ ॥੭॥",
      "transliteration": "a(n)t kaal mooRe chot khaahi ||7||",
      "translation": "At that very last moment, you fool, you shall be beaten. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1189,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
