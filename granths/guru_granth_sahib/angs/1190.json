{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1190,
  "lineCount": 52,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1190_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੁਰਸਬਦੁ ਬੀਚਾਰਹਿ ਆਪੁ ਜਾਇ ॥",
      "transliteration": "gurasabad beechaarahi aap jaai ||",
      "translation": "Contemplate the Word of the Guru's Shabad, and be rid of your ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਚ ਜੋਗੁ ਮਨਿ ਵਸੈ ਆਇ ॥੮॥",
      "transliteration": "saach jog man vasai aai ||8||",
      "translation": "True Yoga shall come to dwell in your mind. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜਿਨਿ ਜੀਉ ਪਿੰਡੁ ਦਿਤਾ ਤਿਸੁ ਚੇਤਹਿ ਨਾਹਿ ॥",
      "transliteration": "jin jeeu pi(n)d ditaa tis chetahi naahi ||",
      "translation": "He blessed you with body and soul, but you do not even think of Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮੜੀ ਮਸਾਣੀ ਮੂੜੇ ਜੋਗੁ ਨਾਹਿ ॥੯॥",
      "transliteration": "maRee masaanee mooRe jog naahi ||9||",
      "translation": "You fool! Visiting graves and cremation grounds is not Yoga. ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਣ ਨਾਨਕੁ ਬੋਲੈ ਭਲੀ ਬਾਣਿ ॥",
      "transliteration": "gun naanak bolai bhalee baan ||",
      "translation": "Nanak chants the sublime, glorious Bani of the Word.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤੁਮ ਹੋਹੁ ਸੁਜਾਖੇ ਲੇਹੁ ਪਛਾਣਿ ॥੧੦॥੫॥",
      "transliteration": "tum hohu sujaakhe lehu pachhaan ||10||5||",
      "translation": "Understand it, and appreciate it. ||10||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੧ ॥",
      "transliteration": "basa(n)t mahalaa 1 ||",
      "translation": "Basant, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਦੁਬਿਧਾ ਦੁਰਮਤਿ ਅਧੁਲੀ ਕਾਰ ॥",
      "transliteration": "dubidhaa duramat adhulee kaar ||",
      "translation": "In duality and evil-mindedness, the mortal acts blindly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਨਮੁਖਿ ਭਰਮੈ ਮਝਿ ਗੁਬਾਰ ॥੧॥",
      "transliteration": "manamukh bharamai majh gubaar ||1||",
      "translation": "The self-willed manmukh wanders, lost in the darkness. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨੁ ਅੰਧੁਲਾ ਅੰਧੁਲੀ ਮਤਿ ਲਾਗੈ ॥",
      "transliteration": "man a(n)dhulaa a(n)dhulee mat laagai ||",
      "translation": "The blind man follows blind advice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਰ ਕਰਣੀ ਬਿਨੁ ਭਰਮੁ ਨ ਭਾਗੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur karanee bin bharam na bhaagai ||1|| rahaau ||",
      "translation": "Unless one takes the Guru's Way, his doubt is not dispelled. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਨਮੁਖਿ ਅੰਧੁਲੇ ਗੁਰਮਤਿ ਨ ਭਾਈ ॥",
      "transliteration": "manamukh a(n)dhule guramat na bhaaee ||",
      "translation": "The manmukh is blind; he does not like the Guru's Teachings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਸੂ ਭਏ ਅਭਿਮਾਨੁ ਨ ਜਾਈ ॥੨॥",
      "transliteration": "pasoo bhae abhimaan na jaaee ||2||",
      "translation": "He has become a beast; he cannot get rid of his egotistical pride. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਲਖ ਚਉਰਾਸੀਹ ਜੰਤ ਉਪਾਏ ॥",
      "transliteration": "lakh chauraaseeh ja(n)t upaae ||",
      "translation": "God created 8.4 million species of beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮੇਰੇ ਠਾਕੁਰ ਭਾਣੇ ਸਿਰਜਿ ਸਮਾਏ ॥੩॥",
      "transliteration": "mere thaakur bhaane siraj samaae ||3||",
      "translation": "My Lord and Master, by the Pleasure of His Will, creates and destroys them. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਗਲੀ ਭੂਲੈ ਨਹੀ ਸਬਦੁ ਅਚਾਰੁ ॥",
      "transliteration": "sagalee bhoolai nahee sabad achaar ||",
      "translation": "All are deluded and confused, without the Word of the Shabad and good conduct.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਸੋ ਸਮਝੈ ਜਿਸੁ ਗੁਰੁ ਕਰਤਾਰੁ ॥੪॥",
      "transliteration": "so samajhai jis gur karataar ||4||",
      "translation": "He alone is instructed in this, who is blessed by the Guru, the Creator. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਾਕਰ ਠਾਕੁਰ ਭਾਣੇ ॥",
      "transliteration": "gur ke chaakar thaakur bhaane ||",
      "translation": "The Guru's servants are pleasing to our Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਖਸਿ ਲੀਏ ਨਾਹੀ ਜਮ ਕਾਣੇ ॥੫॥",
      "transliteration": "bakhas leee naahee jam kaane ||5||",
      "translation": "The Lord forgives them, and they no longer fear the Messenger of Death. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜਿਨ ਕੈ ਹਿਰਦੈ ਏਕੋ ਭਾਇਆ ॥",
      "transliteration": "jin kai hiradai eko bhaaiaa ||",
      "translation": "Those who love the One Lord with all their heart",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਆਪੇ ਮੇਲੇ ਭਰਮੁ ਚੁਕਾਇਆ ॥੬॥",
      "transliteration": "aape mele bharam chukaaiaa ||6||",
      "translation": "- He dispels their doubts and unites them with Himself. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਬੇਮੁਹਤਾਜੁ ਬੇਅੰਤੁ ਅਪਾਰਾ ॥",
      "transliteration": "bemuhataaj bea(n)t apaaraa ||",
      "translation": "God is Independent, Endless and Infinite.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਚਿ ਪਤੀਜੈ ਕਰਣੈਹਾਰਾ ॥੭॥",
      "transliteration": "sach pateejai karanaihaaraa ||7||",
      "translation": "The Creator Lord is pleased with Truth. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਨਾਨਕ ਭੂਲੇ ਗੁਰੁ ਸਮਝਾਵੈ ॥",
      "transliteration": "naanak bhoole gur samajhaavai ||",
      "translation": "O Nanak, the Guru instructs the mistaken soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਏਕੁ ਦਿਖਾਵੈ ਸਾਚਿ ਟਿਕਾਵੈ ॥੮॥੬॥",
      "transliteration": "ek dikhaavai saach tikaavai ||8||6||",
      "translation": "He implants the Truth within him, and shows him the One Lord. ||8||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੧ ॥",
      "transliteration": "basa(n)t mahalaa 1 ||",
      "translation": "Basant, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਆਪੇ ਭਵਰਾ ਫੂਲ ਬੇਲਿ ॥",
      "transliteration": "aape bhavaraa phool bel ||",
      "translation": "He Himself is the bumble bee, the fruit and the vine.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਆਪੇ ਸੰਗਤਿ ਮੀਤ ਮੇਲਿ ॥੧॥",
      "transliteration": "aape sa(n)gat meet mel ||1||",
      "translation": "He Himself unites us with the Sangat - the Congregation, and the Guru, our Best Friend. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਐਸੀ ਭਵਰਾ ਬਾਸੁ ਲੇ ॥",
      "transliteration": "aisee bhavaraa baas le ||",
      "translation": "O bumble bee, suck in that fragrance,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤਰਵਰ ਫੂਲੇ ਬਨ ਹਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "taravar phoole ban hare ||1|| rahaau ||",
      "translation": "which causes the trees to flower, and the woods to grow lush foliage. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਆਪੇ ਕਵਲਾ ਕੰਤੁ ਆਪਿ ॥",
      "transliteration": "aape kavalaa ka(n)t aap ||",
      "translation": "He Himself is Lakshmi, and He Himself is her husband.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਆਪੇ ਰਾਵੇ ਸਬਦਿ ਥਾਪਿ ॥੨॥",
      "transliteration": "aape raave sabad thaap ||2||",
      "translation": "He established the world by Word of His Shabad, and He Himself ravishes it. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਆਪੇ ਬਛਰੂ ਗਊ ਖੀਰੁ ॥",
      "transliteration": "aape bachharoo gaoo kheer ||",
      "translation": "He Himself is the calf, the cow and the milk.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਆਪੇ ਮੰਦਰੁ ਥੰਮੑੁ ਸਰੀਰੁ ॥੩॥",
      "transliteration": "aape ma(n)dar tha(n)mh sareer ||3||",
      "translation": "He Himself is the Support of the body-mansion. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਆਪੇ ਕਰਣੀ ਕਰਣਹਾਰੁ ॥",
      "transliteration": "aape karanee karanahaar ||",
      "translation": "He Himself is the Deed, and He Himself is the Doer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਪੇ ਗੁਰਮੁਖਿ ਕਰਿ ਬੀਚਾਰੁ ॥੪॥",
      "transliteration": "aape guramukh kar beechaar ||4||",
      "translation": "As Gurmukh, He contemplates Himself. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤੂ ਕਰਿ ਕਰਿ ਦੇਖਹਿ ਕਰਣਹਾਰੁ ॥",
      "transliteration": "too kar kar dekhahi karanahaar ||",
      "translation": "You create the creation, and gaze upon it, O Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜੋਤਿ ਜੀਅ ਅਸੰਖ ਦੇਇ ਅਧਾਰੁ ॥੫॥",
      "transliteration": "jot jee asa(n)kh dei adhaar ||5||",
      "translation": "You give Your Support to the uncounted beings and creatures. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਤੂ ਸਰੁ ਸਾਗਰੁ ਗੁਣ ਗਹੀਰੁ ॥",
      "transliteration": "too sar saagar gun gaheer ||",
      "translation": "You are the Profound, Unfathomable Ocean of Virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਤੂ ਅਕੁਲ ਨਿਰੰਜਨੁ ਪਰਮ ਹੀਰੁ ॥੬॥",
      "transliteration": "too akul nira(n)jan param heer ||6||",
      "translation": "You are the Unknowable, the Immaculate, the most Sublime Jewel. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਤੂ ਆਪੇ ਕਰਤਾ ਕਰਣ ਜੋਗੁ ॥",
      "transliteration": "too aape karataa karan jog ||",
      "translation": "You Yourself are the Creator, with the Potency to create.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਿਹਕੇਵਲੁ ਰਾਜਨ ਸੁਖੀ ਲੋਗੁ ॥੭॥",
      "transliteration": "nihakeval raajan sukhee log ||7||",
      "translation": "You are the Independent Ruler, whose people are at peace. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਨਕ ਧ੍ਰਾਪੇ ਹਰਿ ਨਾਮ ਸੁਆਦਿ ॥",
      "transliteration": "naanak dhraape har naam suaad ||",
      "translation": "Nanak is satisfied with the subtle taste of the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਬਿਨੁ ਹਰਿ ਗੁਰ ਪ੍ਰੀਤਮ ਜਨਮੁ ਬਾਦਿ ॥੮॥੭॥",
      "transliteration": "bin har gur preetam janam baad ||8||7||",
      "translation": "Without the Beloved Lord and Master, life is meaningless. ||8||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਬਸੰਤੁ ਹਿੰਡੋਲੁ ਮਹਲਾ ੧ ਘਰੁ ੨ ॥",
      "transliteration": "basa(n)t hi(n)dol mahalaa 1 ghar 2 ||",
      "translation": "Basant Hindol, First Mehl, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਉ ਸਤ ਚਉਦਹ ਤੀਨਿ ਚਾਰਿ ਕਰਿ ਮਹਲਤਿ ਚਾਰਿ ਬਹਾਲੀ ॥",
      "transliteration": "nau sat chaudah teen chaar kar mahalat chaar bahaalee ||",
      "translation": "The nine regions, the seven continents, the fourteen worlds, the three qualities and the four ages - You established them all through the four sources of creation, and You seated them in Your mansions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਚਾਰੇ ਦੀਵੇ ਚਹੁ ਹਥਿ ਦੀਏ ਏਕਾ ਏਕਾ ਵਾਰੀ ॥੧॥",
      "transliteration": "chaare deeve chahu hath deee ekaa ekaa vaaree ||1||",
      "translation": "He placed the four lamps, one by one, into the hands of the four ages. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮਿਹਰਵਾਨ ਮਧੁਸੂਦਨ ਮਾਧੌ ਐਸੀ ਸਕਤਿ ਤੁਮੑਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "miharavaan madhusoodan maadhau aisee sakat tumhaaree ||1|| rahaau ||",
      "translation": "O Merciful Lord, Destroyer of demons, Lord of Lakshmi, such is Your Power - Your Shakti. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਘਰਿ ਘਰਿ ਲਸਕਰੁ ਪਾਵਕੁ ਤੇਰਾ ਧਰਮੁ ਕਰੇ ਸਿਕਦਾਰੀ ॥",
      "transliteration": "ghar ghar lasakar paavak teraa dharam kare sikadaaree ||",
      "translation": "Your army is the fire in the home of each and every heart. And Dharma - righteous living is the ruling chieftain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਧਰਤੀ ਦੇਗ ਮਿਲੈ ਇਕ ਵੇਰਾ ਭਾਗੁ ਤੇਰਾ ਭੰਡਾਰੀ ॥੨॥",
      "transliteration": "dharatee deg milai ik veraa bhaag teraa bha(n)daaree ||2||",
      "translation": "The earth is Your great cooking pot; Your beings receive their portions only once. Destiny is Your gate-keeper. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1190_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਨਾ ਸਾਬੂਰੁ ਹੋਵੈ ਫਿਰਿ ਮੰਗੈ ਨਾਰਦੁ ਕਰੇ ਖੁਆਰੀ ॥",
      "transliteration": "naa saaboor hovai phir ma(n)gai naarad kare khuaaree ||",
      "translation": "But the mortal becomes unsatisfied, and begs for more; his fickle mind brings him disgrace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1190,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
