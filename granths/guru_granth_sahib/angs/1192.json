{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1192,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1192_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ਘਰੁ ੧ ਦੁਤੁਕੀਆ ॥",
      "transliteration": "basa(n)t mahalaa 5 ghar 1 dutukeeaa ||",
      "translation": "Basant, Fifth Mehl, First House, Du-Tukee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੁਣਿ ਸਾਖੀ ਮਨ ਜਪਿ ਪਿਆਰ ॥",
      "transliteration": "sun saakhee man jap piaar ||",
      "translation": "Listen to the stories of the devotees, O my mind, and meditate with love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਜਾਮਲੁ ਉਧਰਿਆ ਕਹਿ ਏਕ ਬਾਰ ॥",
      "transliteration": "ajaamal udhariaa kahi ek baar ||",
      "translation": "Ajaamal uttered the Lord's Name once, and was saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਬਾਲਮੀਕੈ ਹੋਆ ਸਾਧਸੰਗੁ ॥",
      "transliteration": "baalameekai hoaa saadhasa(n)g ||",
      "translation": "Baalmeek found the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਧ੍ਰੂ ਕਉ ਮਿਲਿਆ ਹਰਿ ਨਿਸੰਗ ॥੧॥",
      "transliteration": "dhroo kau miliaa har nisa(n)g ||1||",
      "translation": "The Lord definitely met Dhroo. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤੇਰਿਆ ਸੰਤਾ ਜਾਚਉ ਚਰਨ ਰੇਨ ॥",
      "transliteration": "teriaa sa(n)taa jaachau charan ren ||",
      "translation": "I beg for the dust of the feet of Your Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਲੇ ਮਸਤਕਿ ਲਾਵਉ ਕਰਿ ਕ੍ਰਿਪਾ ਦੇਨ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "le masatak laavau kar kripaa den ||1|| rahaau ||",
      "translation": "Please bless me with Your Mercy, Lord, that I may apply it to my forehead. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗਨਿਕਾ ਉਧਰੀ ਹਰਿ ਕਹੈ ਤੋਤ ॥",
      "transliteration": "ganikaa udharee har kahai tot ||",
      "translation": "Ganika the prostitute was saved, when her parrot uttered the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗਜਇੰਦ੍ਰ ਧਿਆਇਓ ਹਰਿ ਕੀਓ ਮੋਖ ॥",
      "transliteration": "gajai(n)dr dhiaaio har keeo mokh ||",
      "translation": "The elephant meditated on the Lord, and was saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਪ੍ਰ ਸੁਦਾਮੇ ਦਾਲਦੁ ਭੰਜ ॥",
      "transliteration": "bipr sudaame daalad bha(n)j ||",
      "translation": "He delivered the poor Brahmin Sudama out of poverty.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਰੇ ਮਨ ਤੂ ਭੀ ਭਜੁ ਗੋਬਿੰਦ ॥੨॥",
      "transliteration": "re man too bhee bhaj gobi(n)d ||2||",
      "translation": "O my mind, you too must meditate and vibrate on the Lord of the Universe. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਧਿਕੁ ਉਧਾਰਿਓ ਖਮਿ ਪ੍ਰਹਾਰ ॥",
      "transliteration": "badhik udhaario kham prahaar ||",
      "translation": "Even the hunter who shot an arrow at Krishna was saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੁਬਿਜਾ ਉਧਰੀ ਅੰਗੁਸਟ ਧਾਰ ॥",
      "transliteration": "kubijaa udharee a(n)gusat dhaar ||",
      "translation": "Kubija the hunchback was saved, when God placed His Feet on her thumb.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਿਦਰੁ ਉਧਾਰਿਓ ਦਾਸਤ ਭਾਇ ॥",
      "transliteration": "bidar udhaario daasat bhaai ||",
      "translation": "Bidar was saved by his attitude of humility.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਰੇ ਮਨ ਤੂ ਭੀ ਹਰਿ ਧਿਆਇ ॥੩॥",
      "transliteration": "re man too bhee har dhiaai ||3||",
      "translation": "O my mind, you too must meditate on the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪ੍ਰਹਲਾਦ ਰਖੀ ਹਰਿ ਪੈਜ ਆਪ ॥",
      "transliteration": "prahalaad rakhee har paij aap ||",
      "translation": "The Lord Himself saved the honor of Prahlaad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਸਤ੍ਰ ਛੀਨਤ ਦ੍ਰੋਪਤੀ ਰਖੀ ਲਾਜ ॥",
      "transliteration": "basatr chheenat dropatee rakhee laaj ||",
      "translation": "Even when she was being disrobed in court, Dropatee's honor was preserved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜਿਨਿ ਜਿਨਿ ਸੇਵਿਆ ਅੰਤ ਬਾਰ ॥",
      "transliteration": "jin jin seviaa a(n)t baar ||",
      "translation": "Those who have served the Lord, even at the very last instant of their lives, are saved.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਰੇ ਮਨ ਸੇਵਿ ਤੂ ਪਰਹਿ ਪਾਰ ॥੪॥",
      "transliteration": "re man sev too parahi paar ||4||",
      "translation": "O my mind, serve Him, and you shall be carried across to the other side. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਧੰਨੈ ਸੇਵਿਆ ਬਾਲ ਬੁਧਿ ॥",
      "transliteration": "dha(n)nai seviaa baal budh ||",
      "translation": "Dhanna served the Lord, with the innocence of a child.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤ੍ਰਿਲੋਚਨ ਗੁਰ ਮਿਲਿ ਭਈ ਸਿਧਿ ॥",
      "transliteration": "trilochan gur mil bhaee sidh ||",
      "translation": "Meeting with the Guru, Trilochan attained the perfection of the Siddhas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬੇਣੀ ਕਉ ਗੁਰਿ ਕੀਓ ਪ੍ਰਗਾਸੁ ॥",
      "transliteration": "benee kau gur keeo pragaas ||",
      "translation": "The Guru blessed Baynee with His Divine Illumination.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਰੇ ਮਨ ਤੂ ਭੀ ਹੋਹਿ ਦਾਸੁ ॥੫॥",
      "transliteration": "re man too bhee hohi daas ||5||",
      "translation": "O my mind, you too must be the Lord's slave. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜੈਦੇਵ ਤਿਆਗਿਓ ਅਹੰਮੇਵ ॥",
      "transliteration": "jaidev tiaagio aha(n)mev ||",
      "translation": "Jai Dayv gave up his egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਨਾਈ ਉਧਰਿਓ ਸੈਨੁ ਸੇਵ ॥",
      "transliteration": "naaee udhario sain sev ||",
      "translation": "Sain the barber was saved through his selfless service.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮਨੁ ਡੀਗਿ ਨ ਡੋਲੈ ਕਹੂੰ ਜਾਇ ॥",
      "transliteration": "man deeg na dolai kahoo(n) jaai ||",
      "translation": "Do not let your mind waver or wander; do not let it go anywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਨ ਤੂ ਭੀ ਤਰਸਹਿ ਸਰਣਿ ਪਾਇ ॥੬॥",
      "transliteration": "man too bhee tarasahi saran paai ||6||",
      "translation": "O my mind, you too shall cross over; seek the Sanctuary of God. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਿਹ ਅਨੁਗ੍ਰਹੁ ਠਾਕੁਰਿ ਕੀਓ ਆਪਿ ॥",
      "transliteration": "jih anugrahu thaakur keeo aap ||",
      "translation": "O my Lord and Master, You have shown Your Mercy to them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸੇ ਤੈਂ ਲੀਨੇ ਭਗਤ ਰਾਖਿ ॥",
      "transliteration": "se tai(n) leene bhagat raakh ||",
      "translation": "You saved those devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਤਿਨ ਕਾ ਗੁਣੁ ਅਵਗਣੁ ਨ ਬੀਚਾਰਿਓ ਕੋਇ ॥",
      "transliteration": "tin kaa gun avagan na beechaario koi ||",
      "translation": "You do not take their merits and demerits into account.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਇਹ ਬਿਧਿ ਦੇਖਿ ਮਨੁ ਲਗਾ ਸੇਵ ॥੭॥",
      "transliteration": "ih bidh dekh man lagaa sev ||7||",
      "translation": "Seeing these ways of Yours, I have dedicated my mind to Your service. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਬੀਰਿ ਧਿਆਇਓ ਏਕ ਰੰਗ ॥",
      "transliteration": "kabeer dhiaaio ek ra(n)g ||",
      "translation": "Kabeer meditated on the One Lord with love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਮਦੇਵ ਹਰਿ ਜੀਉ ਬਸਹਿ ਸੰਗਿ ॥",
      "transliteration": "naamadev har jeeu basahi sa(n)g ||",
      "translation": "Naam Dayv lived with the Dear Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਵਿਦਾਸ ਧਿਆਏ ਪ੍ਰਭ ਅਨੂਪ ॥",
      "transliteration": "ravidaas dhiaae prabh anoop ||",
      "translation": "Ravi Daas meditated on God, the Incomparably Beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰ ਨਾਨਕ ਦੇਵ ਗੋਵਿੰਦ ਰੂਪ ॥੮॥੧॥",
      "transliteration": "gur naanak dev govi(n)d roop ||8||1||",
      "translation": "Guru Nanak Dayv is the Embodiment of the Lord of the Universe. ||8||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਸੰਤੁ ਮਹਲਾ ੫ ॥",
      "transliteration": "basa(n)t mahalaa 5 ||",
      "translation": "Basant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਅਨਿਕ ਜਨਮ ਭ੍ਰਮੇ ਜੋਨਿ ਮਾਹਿ ॥",
      "transliteration": "anik janam bhrame jon maahi ||",
      "translation": "The mortal wanders in reincarnation through countless lifetimes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨ ਬਿਨੁ ਨਰਕਿ ਪਾਹਿ ॥",
      "transliteration": "har simaran bin narak paahi ||",
      "translation": "Without meditating in remembrance on the Lord, he falls into hell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਗਤਿ ਬਿਹੂਨਾ ਖੰਡ ਖੰਡ ॥",
      "transliteration": "bhagat bihoonaa kha(n)d kha(n)d ||",
      "translation": "Without devotional worship, he is cut apart into pieces.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਿਨੁ ਬੂਝੇ ਜਮੁ ਦੇਤ ਡੰਡ ॥੧॥",
      "transliteration": "bin boojhe jam det da(n)d ||1||",
      "translation": "Without understanding, he is punished by the Messenger of Death. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੋਬਿੰਦ ਭਜਹੁ ਮੇਰੇ ਸਦਾ ਮੀਤ ॥",
      "transliteration": "gobi(n)d bhajahu mere sadaa meet ||",
      "translation": "Meditate and vibrate forever on the Lord of the Universe, O my friend.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਾਚ ਸਬਦ ਕਰਿ ਸਦਾ ਪ੍ਰੀਤਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "saach sabad kar sadaa preet ||1|| rahaau ||",
      "translation": "Love forever the True Word of the Shabad. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸੰਤੋਖੁ ਨ ਆਵਤ ਕਹੂੰ ਕਾਜ ॥",
      "transliteration": "sa(n)tokh na aavat kahoo(n) kaaj ||",
      "translation": "Contentment does not come by any endeavors.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਧੂੰਮ ਬਾਦਰ ਸਭਿ ਮਾਇਆ ਸਾਜ ॥",
      "transliteration": "dhoo(n)m baadar sabh maaiaa saaj ||",
      "translation": "All the show of Maya is just a cloud of smoke.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪਾਪ ਕਰੰਤੌ ਨਹ ਸੰਗਾਇ ॥",
      "transliteration": "paap kara(n)tau nah sa(n)gaai ||",
      "translation": "The mortal does not hesitate to commit sins.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਿਖੁ ਕਾ ਮਾਤਾ ਆਵੈ ਜਾਇ ॥੨॥",
      "transliteration": "bikh kaa maataa aavai jaai ||2||",
      "translation": "Intoxicated with poison, he comes and goes in reincarnation. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਹਉ ਹਉ ਕਰਤ ਬਧੇ ਬਿਕਾਰ ॥",
      "transliteration": "hau hau karat badhe bikaar ||",
      "translation": "Acting in egotism and self-conceit, his corruption only increases.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਮੋਹ ਲੋਭ ਡੂਬੌ ਸੰਸਾਰ ॥",
      "transliteration": "moh lobh doobau sa(n)saar ||",
      "translation": "The world is drowning in attachment and greed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਾਮਿ ਕ੍ਰੋਧਿ ਮਨੁ ਵਸਿ ਕੀਆ ॥",
      "transliteration": "kaam krodh man vas keeaa ||",
      "translation": "Sexual desire and anger hold the mind in its power.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸੁਪਨੈ ਨਾਮੁ ਨ ਹਰਿ ਲੀਆ ॥੩॥",
      "transliteration": "supanai naam na har leeaa ||3||",
      "translation": "Even in his dreams, he does not chant the Lord's Name. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਕਬ ਹੀ ਰਾਜਾ ਕਬ ਮੰਗਨਹਾਰੁ ॥",
      "transliteration": "kab hee raajaa kab ma(n)ganahaar ||",
      "translation": "Sometimes he is a king, and sometimes he is a beggar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਦੂਖ ਸੂਖ ਬਾਧੌ ਸੰਸਾਰ ॥",
      "transliteration": "dookh sookh baadhau sa(n)saar ||",
      "translation": "The world is bound by pleasure and pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਮਨ ਉਧਰਣ ਕਾ ਸਾਜੁ ਨਾਹਿ ॥",
      "transliteration": "man udharan kaa saaj naahi ||",
      "translation": "The mortal makes no arrangements to save himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਪਾਪ ਬੰਧਨ ਨਿਤ ਪਉਤ ਜਾਹਿ ॥੪॥",
      "transliteration": "paap ba(n)dhan nit paut jaahi ||4||",
      "translation": "The bondage of sin continues to hold him. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਈਠ ਮੀਤ ਕੋਊ ਸਖਾ ਨਾਹਿ ॥",
      "transliteration": "eeth meet kooo sakhaa naahi ||",
      "translation": "He has no beloved friends or companions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1192_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਆਪਿ ਬੀਜਿ ਆਪੇ ਹੀ ਖਾਂਹਿ ॥",
      "transliteration": "aap beej aape hee khaa(n)hi ||",
      "translation": "He himself eats what he himself plants.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1192,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
