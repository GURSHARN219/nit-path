{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1194,
  "lineCount": 61,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1194_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਣਵੰਤੁ ਜਾਗੈ ਧਰਿ ਲੰਕੂਰੁ ॥",
      "transliteration": "hanava(n)t jaagai dhar la(n)koor ||",
      "translation": "Hanuman with his tail is awake and aware.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੰਕਰੁ ਜਾਗੈ ਚਰਨ ਸੇਵ ॥",
      "transliteration": "sa(n)kar jaagai charan sev ||",
      "translation": "Shiva is awake, serving at the Lord's Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਲਿ ਜਾਗੇ ਨਾਮਾ ਜੈਦੇਵ ॥੨॥",
      "transliteration": "kal jaage naamaa jaidev ||2||",
      "translation": "Naam Dayv and Jai Dayv are awake in this Dark Age of Kali Yuga. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਾਗਤ ਸੋਵਤ ਬਹੁ ਪ੍ਰਕਾਰ ॥",
      "transliteration": "jaagat sovat bahu prakaar ||",
      "translation": "There are many ways of being awake, and sleeping.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਜਾਗੈ ਸੋਈ ਸਾਰੁ ॥",
      "transliteration": "guramukh jaagai soee saar ||",
      "translation": "To be awake as Gurmukh is the most excellent way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਇਸੁ ਦੇਹੀ ਕੇ ਅਧਿਕ ਕਾਮ ॥",
      "transliteration": "is dehee ke adhik kaam ||",
      "translation": "The most sublime of all the actions of this body,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਭਜਿ ਰਾਮ ਨਾਮ ॥੩॥੨॥",
      "transliteration": "kahi kabeer bhaj raam naam ||3||2||",
      "translation": "says Kabeer, is to meditate and vibrate on the Lord's Name. ||3||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜੋਇ ਖਸਮੁ ਹੈ ਜਾਇਆ ॥",
      "transliteration": "joi khasam hai jaaiaa ||",
      "translation": "The wife gives birth to her husband.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪੂਤਿ ਬਾਪੁ ਖੇਲਾਇਆ ॥",
      "transliteration": "poot baap khelaaiaa ||",
      "translation": "The son leads his father in play.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਬਿਨੁ ਸ੍ਰਵਣਾ ਖੀਰੁ ਪਿਲਾਇਆ ॥੧॥",
      "transliteration": "bin sravanaa kheer pilaaiaa ||1||",
      "translation": "Without breasts, the mother nurses her baby. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੇਖਹੁ ਲੋਗਾ ਕਲਿ ਕੋ ਭਾਉ ॥",
      "transliteration": "dekhahu logaa kal ko bhaau ||",
      "translation": "Behold, people! This is how it is in the Dark Age of Kali Yuga.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁਤਿ ਮੁਕਲਾਈ ਅਪਨੀ ਮਾਉ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sut mukalaaee apanee maau ||1|| rahaau ||",
      "translation": "The son marries his mother. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪਗਾ ਬਿਨੁ ਹੁਰੀਆ ਮਾਰਤਾ ॥",
      "transliteration": "pagaa bin hureeaa maarataa ||",
      "translation": "Without feet, the mortal jumps.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਬਦਨੈ ਬਿਨੁ ਖਿਰ ਖਿਰ ਹਾਸਤਾ ॥",
      "transliteration": "badanai bin khir khir haasataa ||",
      "translation": "Without a mouth, he bursts into laughter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਨਿਦ੍ਰਾ ਬਿਨੁ ਨਰੁ ਪੈ ਸੋਵੈ ॥",
      "transliteration": "nidraa bin nar pai sovai ||",
      "translation": "Without feeling sleepy, he lays down and sleeps.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਬਿਨੁ ਬਾਸਨ ਖੀਰੁ ਬਿਲੋਵੈ ॥੨॥",
      "transliteration": "bin baasan kheer bilovai ||2||",
      "translation": "Without a churn, the milk is churned. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਬਿਨੁ ਅਸਥਨ ਗਊ ਲਵੇਰੀ ॥",
      "transliteration": "bin asathan gaoo laveree ||",
      "translation": "Without udders, the cow gives milk.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪੈਡੇ ਬਿਨੁ ਬਾਟ ਘਨੇਰੀ ॥",
      "transliteration": "paide bin baat ghaneree ||",
      "translation": "Without travelling, a long journey is made.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰ ਬਾਟ ਨ ਪਾਈ ॥",
      "transliteration": "bin satigur baat na paaee ||",
      "translation": "Without the True Guru, the path is not found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਹੁ ਕਬੀਰ ਸਮਝਾਈ ॥੩॥੩॥",
      "transliteration": "kahu kabeer samajhaaee ||3||3||",
      "translation": "Says Kabeer, see this, and understand. ||3||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਪ੍ਰਹਲਾਦ ਪਠਾਏ ਪੜਨ ਸਾਲ ॥",
      "transliteration": "prahalaad pathaae paRan saal ||",
      "translation": "Prahlaad was sent to school.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸੰਗਿ ਸਖਾ ਬਹੁ ਲੀਏ ਬਾਲ ॥",
      "transliteration": "sa(n)g sakhaa bahu leee baal ||",
      "translation": "He took many of his friends along with him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਮੋ ਕਉ ਕਹਾ ਪੜੑਾਵਸਿ ਆਲ ਜਾਲ ॥",
      "transliteration": "mo kau kahaa paRhaavas aal jaal ||",
      "translation": "He asked his teacher, \"Why do you teach me about worldly affairs?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਮੇਰੀ ਪਟੀਆ ਲਿਖਿ ਦੇਹੁ ਸ੍ਰੀ ਗੋੁਪਾਲ ॥੧॥",
      "transliteration": "meree pateeaa likh dehu sree goupaal ||1||",
      "translation": "Write the Name of the Dear Lord on my tablet.\" ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਨਹੀ ਛੋਡਉ ਰੇ ਬਾਬਾ ਰਾਮ ਨਾਮ ॥",
      "transliteration": "nahee chhodau re baabaa raam naam ||",
      "translation": "O Baba, I will not forsake the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੇਰੋ ਅਉਰ ਪੜੑਨ ਸਿਉ ਨਹੀ ਕਾਮੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mero aur paRhn siu nahee kaam ||1|| rahaau ||",
      "translation": "I will not bother with any other lessons. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਸੰਡੈ ਮਰਕੈ ਕਹਿਓ ਜਾਇ ॥",
      "transliteration": "sa(n)dai marakai kahio jaai ||",
      "translation": "Sanda and Marka went to the king to complain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪ੍ਰਹਲਾਦ ਬੁਲਾਏ ਬੇਗਿ ਧਾਇ ॥",
      "transliteration": "prahalaad bulaae beg dhaai ||",
      "translation": "He sent for Prahlaad to come at once.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਤੂ ਰਾਮ ਕਹਨ ਕੀ ਛੋਡੁ ਬਾਨਿ ॥",
      "transliteration": "too raam kahan kee chhod baan ||",
      "translation": "He said to him, \"Stop uttering the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਤੁਝੁ ਤੁਰਤੁ ਛਡਾਊ ਮੇਰੋ ਕਹਿਓ ਮਾਨਿ ॥੨॥",
      "transliteration": "tujh turat chhadaaoo mero kahio maan ||2||",
      "translation": "I shall release you at once, if you obey my words.\" ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮੋ ਕਉ ਕਹਾ ਸਤਾਵਹੁ ਬਾਰ ਬਾਰ ॥",
      "transliteration": "mo kau kahaa sataavahu baar baar ||",
      "translation": "Prahlaad answered, \"Why do you annoy me, over and over again?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਪ੍ਰਭਿ ਜਲ ਥਲ ਗਿਰਿ ਕੀਏ ਪਹਾਰ ॥",
      "transliteration": "prabh jal thal gir keee pahaar ||",
      "translation": "God created the water, land, hills and mountains.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਕੁ ਰਾਮੁ ਨ ਛੋਡਉ ਗੁਰਹਿ ਗਾਰਿ ॥",
      "transliteration": "ik raam na chhodau gurahi gaar ||",
      "translation": "I shall not forsake the One Lord; if I did, I would be going against my Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮੋ ਕਉ ਘਾਲਿ ਜਾਰਿ ਭਾਵੈ ਮਾਰਿ ਡਾਰਿ ॥੩॥",
      "transliteration": "mo kau ghaal jaar bhaavai maar daar ||3||",
      "translation": "You might as well throw me into the fire and kill me.\" ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਾਢਿ ਖੜਗੁ ਕੋਪਿਓ ਰਿਸਾਇ ॥",
      "transliteration": "kaadh khaRag kopio risaai ||",
      "translation": "The king became angry and drew his sword.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤੁਝ ਰਾਖਨਹਾਰੋ ਮੋਹਿ ਬਤਾਇ ॥",
      "transliteration": "tujh raakhanahaaro mohi bataai ||",
      "translation": "\"Show me your protector now!\"",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪ੍ਰਭ ਥੰਭ ਤੇ ਨਿਕਸੇ ਕੈ ਬਿਸਥਾਰ ॥",
      "transliteration": "prabh tha(n)bh te nikase kai bisathaar ||",
      "translation": "So God emerged out of the pillar, and assumed a mighty form.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਰਨਾਖਸੁ ਛੇਦਿਓ ਨਖ ਬਿਦਾਰ ॥੪॥",
      "transliteration": "haranaakhas chhedio nakh bidaar ||4||",
      "translation": "He killed Harnaakhash, tearing him apart with his nails. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਓਇ ਪਰਮ ਪੁਰਖ ਦੇਵਾਧਿ ਦੇਵ ॥",
      "transliteration": "oi param purakh devaadh dev ||",
      "translation": "The Supreme Lord God, the Divinity of the divine,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਗਤਿ ਹੇਤਿ ਨਰਸਿੰਘ ਭੇਵ ॥",
      "transliteration": "bhagat het narasi(n)gh bhev ||",
      "translation": "for the sake of His devotee, assumed the form of the man-lion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਕੋ ਲਖੈ ਨ ਪਾਰ ॥",
      "transliteration": "kahi kabeer ko lakhai na paar ||",
      "translation": "Says Kabeer, no one can know the Lord's limits.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਪ੍ਰਹਲਾਦ ਉਧਾਰੇ ਅਨਿਕ ਬਾਰ ॥੫॥੪॥",
      "transliteration": "prahalaad udhaare anik baar ||5||4||",
      "translation": "He saves His devotees like Prahlaad over and over again. ||5||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਇਸੁ ਤਨ ਮਨ ਮਧੇ ਮਦਨ ਚੋਰ ॥",
      "transliteration": "is tan man madhe madan chor ||",
      "translation": "Within the body and mind are thieves like sexual desire,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਨਿ ਗਿਆਨ ਰਤਨੁ ਹਿਰਿ ਲੀਨ ਮੋਰ ॥",
      "transliteration": "jin giaan ratan hir leen mor ||",
      "translation": "which has stolen my jewel of spiritual wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਮੈ ਅਨਾਥੁ ਪ੍ਰਭ ਕਹਉ ਕਾਹਿ ॥",
      "transliteration": "mai anaath prabh kahau kaahi ||",
      "translation": "I am a poor orphan, O God; unto whom should I complain?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕੋ ਕੋ ਨ ਬਿਗੂਤੋ ਮੈ ਕੋ ਆਹਿ ॥੧॥",
      "transliteration": "ko ko na bigooto mai ko aahi ||1||",
      "translation": "Who has not been ruined by sexual desire? What am I? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਮਾਧਉ ਦਾਰੁਨ ਦੁਖੁ ਸਹਿਓ ਨ ਜਾਇ ॥",
      "transliteration": "maadhau daarun dukh sahio na jaai ||",
      "translation": "O Lord, I cannot endure this agonizing pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮੇਰੋ ਚਪਲ ਬੁਧਿ ਸਿਉ ਕਹਾ ਬਸਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mero chapal budh siu kahaa basaai ||1|| rahaau ||",
      "translation": "What power does my fickle mind have against it? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਨਕ ਸਨੰਦਨ ਸਿਵ ਸੁਕਾਦਿ ॥",
      "transliteration": "sanak sana(n)dan siv sukaad ||",
      "translation": "Sanak, Sanandan, Shiva and Suk Dayv",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਨਾਭਿ ਕਮਲ ਜਾਨੇ ਬ੍ਰਹਮਾਦਿ ॥",
      "transliteration": "naabh kamal jaane brahamaad ||",
      "translation": "were born out of Brahma's naval chakra.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਕਬਿ ਜਨ ਜੋਗੀ ਜਟਾਧਾਰਿ ॥",
      "transliteration": "kab jan jogee jataadhaar ||",
      "translation": "The poets and the Yogis with their matted hair",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਸਭ ਆਪਨ ਅਉਸਰ ਚਲੇ ਸਾਰਿ ॥੨॥",
      "transliteration": "sabh aapan ausar chale saar ||2||",
      "translation": "all lived their lives with good behavior. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਤੂ ਅਥਾਹੁ ਮੋਹਿ ਥਾਹ ਨਾਹਿ ॥",
      "transliteration": "too athaahu mohi thaah naahi ||",
      "translation": "You are Unfathomable; I cannot know Your depth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪ੍ਰਭ ਦੀਨਾ ਨਾਥ ਦੁਖੁ ਕਹਉ ਕਾਹਿ ॥",
      "transliteration": "prabh deenaa naath dukh kahau kaahi ||",
      "translation": "O God, Master of the meek, unto whom should I tell my pains?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮੋਰੋ ਜਨਮ ਮਰਨ ਦੁਖੁ ਆਥਿ ਧੀਰ ॥",
      "transliteration": "moro janam maran dukh aath dheer ||",
      "translation": "Please rid me of the pains of birth and death, and bless me with peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਸੁਖ ਸਾਗਰ ਗੁਨ ਰਉ ਕਬੀਰ ॥੩॥੫॥",
      "transliteration": "sukh saagar gun rau kabeer ||3||5||",
      "translation": "Kabeer utters the Glorious Praises of God, the Ocean of peace. ||3||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਨਾਇਕੁ ਏਕੁ ਬਨਜਾਰੇ ਪਾਚ ॥",
      "transliteration": "naaik ek banajaare paach ||",
      "translation": "There is one merchant and five traders.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0058",
      "lineIndex": 58,
      "gurmukhi": "ਬਰਧ ਪਚੀਸਕ ਸੰਗੁ ਕਾਚ ॥",
      "transliteration": "baradh pacheesak sa(n)g kaach ||",
      "translation": "The twenty-five oxen carry false merchandise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0059",
      "lineIndex": 59,
      "gurmukhi": "ਨਉ ਬਹੀਆਂ ਦਸ ਗੋਨਿ ਆਹਿ ॥",
      "transliteration": "nau baheeaa(n) das gon aahi ||",
      "translation": "There are nine poles which hold the ten bags.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0060",
      "lineIndex": 60,
      "gurmukhi": "ਕਸਨਿ ਬਹਤਰਿ ਲਾਗੀ ਤਾਹਿ ॥੧॥",
      "transliteration": "kasan bahatar laagee taahi ||1||",
      "translation": "The body is tied by the seventy-two ropes. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1194_line_0061",
      "lineIndex": 61,
      "gurmukhi": "ਮੋਹਿ ਐਸੇ ਬਨਜ ਸਿਉ ਨਹੀਨ ਕਾਜੁ ॥",
      "transliteration": "mohi aise banaj siu naheen kaaj ||",
      "translation": "I don't care at all about such commerce.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1194,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
