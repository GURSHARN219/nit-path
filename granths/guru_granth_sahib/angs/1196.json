{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1196,
  "lineCount": 46,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1196_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਰਾਇਣੁ ਸੁਪ੍ਰਸੰਨ ਹੋਇ ਤ ਸੇਵਕੁ ਨਾਮਾ ॥੩॥੧॥",
      "transliteration": "naaraain suprasa(n)n hoi ta sevak naamaa ||3||1||",
      "translation": "If the Lord were totally pleased, then He would let Naam Dayv be His servant. ||3||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਲੋਭ ਲਹਰਿ ਅਤਿ ਨੀਝਰ ਬਾਜੈ ॥ ਕਾਇਆ ਡੂਬੈ ਕੇਸਵਾ ॥੧॥",
      "transliteration": "lobh lahar at neejhar baajai || kaaiaa doobai kesavaa ||1||",
      "translation": "The tidal waves of greed constantly assault me. My body is drowning, O Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਸੰਸਾਰੁ ਸਮੁੰਦੇ ਤਾਰਿ ਗੋੁਬਿੰਦੇ ॥ ਤਾਰਿ ਲੈ ਬਾਪ ਬੀਠੁਲਾ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sa(n)saar samu(n)de taar goubi(n)de || taar lai baap beethulaa ||1|| rahaau ||",
      "translation": "Please carry me across the world-ocean, O Lord of the Universe. Carry me across, O Beloved Father. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਨਿਲ ਬੇੜਾ ਹਉ ਖੇਵਿ ਨ ਸਾਕਉ ॥ ਤੇਰਾ ਪਾਰੁ ਨ ਪਾਇਆ ਬੀਠੁਲਾ ॥੨॥",
      "transliteration": "anil beRaa hau khev na saakau || teraa paar na paaiaa beethulaa ||2||",
      "translation": "I cannot steer my ship in this storm. I cannot find the other shore, O Beloved Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਹੋਹੁ ਦਇਆਲੁ ਸਤਿਗੁਰੁ ਮੇਲਿ ਤੂ ਮੋ ਕਉ ॥ ਪਾਰਿ ਉਤਾਰੇ ਕੇਸਵਾ ॥੩॥",
      "transliteration": "hohu daiaal satigur mel too mo kau || paar utaare kesavaa ||3||",
      "translation": "Please be merciful, and unite me with the True Guru; Carry me across, O Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਮਾ ਕਹੈ ਹਉ ਤਰਿ ਭੀ ਨ ਜਾਨਉ ॥ ਮੋ ਕਉ ਬਾਹ ਦੇਹਿ ਬਾਹ ਦੇਹਿ ਬੀਠੁਲਾ ॥੪॥੨॥",
      "transliteration": "naamaa kahai hau tar bhee na jaanau || mo kau baah dehi baah dehi beethulaa ||4||2||",
      "translation": "Says Naam Dayv, I do not know how to swim. Give me Your Arm, give me Your Arm, O Beloved Lord. ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਹਜ ਅਵਲਿ ਧੂੜਿ ਮਣੀ ਗਾਡੀ ਚਾਲਤੀ ॥",
      "transliteration": "sahaj aval dhooR manee gaadee chaalatee ||",
      "translation": "Slowly at first, the body-cart loaded with dust starts to move.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਪੀਛੈ ਤਿਨਕਾ ਲੈ ਕਰਿ ਹਾਂਕਤੀ ॥੧॥",
      "transliteration": "peechhai tinakaa lai kar haa(n)katee ||1||",
      "translation": "Later, it is driven on by the stick. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਜੈਸੇ ਪਨਕਤ ਥ੍ਰੂਟਿਟਿ ਹਾਂਕਤੀ ॥",
      "transliteration": "jaise panakat throotit haa(n)katee ||",
      "translation": "The body moves along like the ball of dung, driven on by the dung-beetle.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਰਿ ਧੋਵਨ ਚਾਲੀ ਲਾਡੁਲੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sar dhovan chaalee laadulee ||1|| rahaau ||",
      "translation": "The beloved soul goes down to the pool to wash itself clean. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਧੋਬੀ ਧੋਵੈ ਬਿਰਹ ਬਿਰਾਤਾ ॥",
      "transliteration": "dhobee dhovai birah biraataa ||",
      "translation": "The washerman washes, imbued with the Lord's Love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਰਿ ਚਰਨ ਮੇਰਾ ਮਨੁ ਰਾਤਾ ॥੨॥",
      "transliteration": "har charan meraa man raataa ||2||",
      "translation": "My mind is imbued with the Lord's Lotus Feet. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਭਣਤਿ ਨਾਮਦੇਉ ਰਮਿ ਰਹਿਆ ॥",
      "transliteration": "bhanat naamadeu ram rahiaa ||",
      "translation": "Prays Naam Dayv, O Lord, You are All-pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਪਨੇ ਭਗਤ ਪਰ ਕਰਿ ਦਇਆ ॥੩॥੩॥",
      "transliteration": "apane bhagat par kar daiaa ||3||3||",
      "translation": "Please be kind to Your devotee. ||3||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਬਸੰਤੁ ਬਾਣੀ ਰਵਿਦਾਸ ਜੀ ਕੀ ॥",
      "transliteration": "basa(n)t baanee ravidaas jee kee ||",
      "translation": "Basant, The Word Of Ravi Daas Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤੁਝਹਿ ਸੁਝੰਤਾ ਕਛੂ ਨਾਹਿ ॥",
      "transliteration": "tujhahi sujha(n)taa kachhoo naahi ||",
      "translation": "You know nothing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਹਿਰਾਵਾ ਦੇਖੇ ਊਭਿ ਜਾਹਿ ॥",
      "transliteration": "pahiraavaa dekhe oobh jaahi ||",
      "translation": "Seeing your clothes, you are so proud of yourself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਗਰਬਵਤੀ ਕਾ ਨਾਹੀ ਠਾਉ ॥",
      "transliteration": "garabavatee kaa naahee thaau ||",
      "translation": "The proud bride shall not find a place with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤੇਰੀ ਗਰਦਨਿ ਊਪਰਿ ਲਵੈ ਕਾਉ ॥੧॥",
      "transliteration": "teree garadan oopar lavai kaau ||1||",
      "translation": "Above your head, the crow of death is cawing. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਤੂ ਕਾਂਇ ਗਰਬਹਿ ਬਾਵਲੀ ॥",
      "transliteration": "too kaa(n)i garabahi baavalee ||",
      "translation": "Why are you so proud? You are insane.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਜੈਸੇ ਭਾਦਉ ਖੂੰਬਰਾਜੁ ਤੂ ਤਿਸ ਤੇ ਖਰੀ ਉਤਾਵਲੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jaise bhaadau khoo(n)baraaj too tis te kharee utaavalee ||1|| rahaau ||",
      "translation": "Even the mushrooms of summer live longer than you. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜੈਸੇ ਕੁਰੰਕ ਨਹੀ ਪਾਇਓ ਭੇਦੁ ॥",
      "transliteration": "jaise kura(n)k nahee paaio bhed ||",
      "translation": "The deer does not know the secret;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਨਿ ਸੁਗੰਧ ਢੂਢੈ ਪ੍ਰਦੇਸੁ ॥",
      "transliteration": "tan suga(n)dh dhoodhai prades ||",
      "translation": "the musk is within its own body, but it searches for it outside.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਪ ਤਨ ਕਾ ਜੋ ਕਰੇ ਬੀਚਾਰੁ ॥",
      "transliteration": "ap tan kaa jo kare beechaar ||",
      "translation": "Whoever reflects on his own body",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਿਸੁ ਨਹੀ ਜਮਕੰਕਰੁ ਕਰੇ ਖੁਆਰੁ ॥੨॥",
      "transliteration": "tis nahee jamaka(n)kar kare khuaar ||2||",
      "translation": "- the Messenger of Death does not abuse him. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਪੁਤ੍ਰ ਕਲਤ੍ਰ ਕਾ ਕਰਹਿ ਅਹੰਕਾਰੁ ॥",
      "transliteration": "putr kalatr kaa karahi aha(n)kaar ||",
      "translation": "The man is so proud of his sons and his wife;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਠਾਕੁਰੁ ਲੇਖਾ ਮਗਨਹਾਰੁ ॥",
      "transliteration": "thaakur lekhaa maganahaar ||",
      "translation": "his Lord and Master shall call for his account.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਫੇੜੇ ਕਾ ਦੁਖੁ ਸਹੈ ਜੀਉ ॥",
      "transliteration": "pheRe kaa dukh sahai jeeu ||",
      "translation": "The soul suffers in pain for the actions it has committed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਾਛੇ ਕਿਸਹਿ ਪੁਕਾਰਹਿ ਪੀਉ ਪੀਉ ॥੩॥",
      "transliteration": "paachhe kisahi pukaarahi peeu peeu ||3||",
      "translation": "Afterwards, whom shall you call, \"Dear, Dear.\" ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਾਧੂ ਕੀ ਜਉ ਲੇਹਿ ਓਟ ॥",
      "transliteration": "saadhoo kee jau lehi ot ||",
      "translation": "If you seek the Support of the Holy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤੇਰੇ ਮਿਟਹਿ ਪਾਪ ਸਭ ਕੋਟਿ ਕੋਟਿ ॥",
      "transliteration": "tere mitahi paap sabh kot kot ||",
      "translation": "millions upon millions of your sins shall be totally erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਹਿ ਰਵਿਦਾਸ ਜੋੁ ਜਪੈ ਨਾਮੁ ॥",
      "transliteration": "kahi ravidaas jou japai naam ||",
      "translation": "Says Ravi Daas, one who chants the Naam, the Name of the Lord,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤਿਸੁ ਜਾਤਿ ਨ ਜਨਮੁ ਨ ਜੋਨਿ ਕਾਮੁ ॥੪॥੧॥",
      "transliteration": "tis jaat na janam na jon kaam ||4||1||",
      "translation": "is not concerned with social class, birth and rebirth. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਸੰਤੁ ਕਬੀਰ ਜੀਉ ॥",
      "transliteration": "basa(n)t kabeer jeeu ||",
      "translation": "Basant, Kabeer Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਰਹ ਕੀ ਜੈਸੀ ਤੇਰੀ ਚਾਲ ॥",
      "transliteration": "surah kee jaisee teree chaal ||",
      "translation": "You walk like a cow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੇਰੀ ਪੂੰਛਟ ਊਪਰਿ ਝਮਕ ਬਾਲ ॥੧॥",
      "transliteration": "teree poo(n)chhat oopar jhamak baal ||1||",
      "translation": "The hair on your tail is shiny and lustrous. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਸ ਘਰ ਮਹਿ ਹੈ ਸੁ ਤੂ ਢੂੰਢਿ ਖਾਹਿ ॥",
      "transliteration": "is ghar mahi hai s too dhoo(n)dh khaahi ||",
      "translation": "Look around, and eat anything in this house.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਅਉਰ ਕਿਸ ਹੀ ਕੇ ਤੂ ਮਤਿ ਹੀ ਜਾਹਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aur kis hee ke too mat hee jaahi ||1|| rahaau ||",
      "translation": "But do not go out to any other. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਚਾਕੀ ਚਾਟਹਿ ਚੂਨੁ ਖਾਹਿ ॥",
      "transliteration": "chaakee chaatahi choon khaahi ||",
      "translation": "You lick the grinding bowl, and eat the flour.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚਾਕੀ ਕਾ ਚੀਥਰਾ ਕਹਾਂ ਲੈ ਜਾਹਿ ॥੨॥",
      "transliteration": "chaakee kaa cheetharaa kahaa(n) lai jaahi ||2||",
      "translation": "Where have you taken the kitchen rags? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਛੀਕੇ ਪਰ ਤੇਰੀ ਬਹੁਤੁ ਡੀਠਿ ॥",
      "transliteration": "chheeke par teree bahut deeth ||",
      "translation": "Your gaze is fixed on the basket in the cupboard.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮਤੁ ਲਕਰੀ ਸੋਟਾ ਤੇਰੀ ਪਰੈ ਪੀਠਿ ॥੩॥",
      "transliteration": "mat lakaree sotaa teree parai peeth ||3||",
      "translation": "Watch out - a stick may strike you from behind. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਹਿ ਕਬੀਰ ਭੋਗ ਭਲੇ ਕੀਨ ॥",
      "transliteration": "kahi kabeer bhog bhale keen ||",
      "translation": "Says Kabeer, you have over-indulged in your pleasures.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1196_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਮਤਿ ਕੋਊ ਮਾਰੈ ਈਂਟ ਢੇਮ ॥੪॥੧॥",
      "transliteration": "mat kooo maarai ee(n)t dhem ||4||1||",
      "translation": "Watch out - someone may throw a brick at you. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1196,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
