{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1229,
  "lineCount": 47,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1229_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਾਰੰਗ ਮਹਲਾ ੫ ਚਉਪਦੇ ਘਰੁ ੫ ॥",
      "transliteration": "saara(n)g mahalaa 5 chaupade ghar 5 ||",
      "translation": "Saarang, Fifth Mehl, Chau-Padhay, Fifth House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਹਰਿ ਭਜਿ ਆਨ ਕਰਮ ਬਿਕਾਰ ॥",
      "transliteration": "har bhaj aan karam bikaar ||",
      "translation": "Meditate, vibrate on the Lord; other actions are corrupt.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਾਨ ਮੋਹੁ ਨ ਬੁਝਤ ਤ੍ਰਿਸਨਾ ਕਾਲ ਗ੍ਰਸ ਸੰਸਾਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "maan mohu na bujhat trisanaa kaal gras sa(n)saar ||1|| rahaau ||",
      "translation": "Pride, attachment and desire are not quenched; the world is in the grip of death. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਖਾਤ ਪੀਵਤ ਹਸਤ ਸੋਵਤ ਅਉਧ ਬਿਤੀ ਅਸਾਰ ॥",
      "transliteration": "khaat peevat hasat sovat audh bitee asaar ||",
      "translation": "Eating, drinking, laughing and sleeping, life passes uselessly.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਰਕ ਉਦਰਿ ਭ੍ਰਮੰਤ ਜਲਤੋ ਜਮਹਿ ਕੀਨੀ ਸਾਰ ॥੧॥",
      "transliteration": "narak udar bhrama(n)t jalato jamahi keenee saar ||1||",
      "translation": "The mortal wanders in reincarnation, burning in the hellish environment of the womb; in the end, he is destroyed by death. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਰ ਦ੍ਰੋਹ ਕਰਤ ਬਿਕਾਰ ਨਿੰਦਾ ਪਾਪ ਰਤ ਕਰ ਝਾਰ ॥",
      "transliteration": "par droh karat bikaar ni(n)daa paap rat kar jhaar ||",
      "translation": "He practices fraud, cruelty and slander against others; he sins, and washes his hands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਬਿਨਾ ਸਤਿਗੁਰ ਬੂਝ ਨਾਹੀ ਤਮ ਮੋਹ ਮਹਾਂ ਅੰਧਾਰ ॥੨॥",
      "transliteration": "binaa satigur boojh naahee tam moh mahaa(n) a(n)dhaar ||2||",
      "translation": "Without the True Guru, he has no understanding; he is lost in the utter darkness of anger and attachment. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਿਖੁ ਠਗਉਰੀ ਖਾਇ ਮੂਠੋ ਚਿਤਿ ਨ ਸਿਰਜਨਹਾਰ ॥",
      "transliteration": "bikh thagauree khaai mootho chit na sirajanahaar ||",
      "translation": "He takes the intoxicating drugs of cruelty and corruption, and is plundered. He is not conscious of the Creator Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੋਬਿੰਦ ਗੁਪਤ ਹੋਇ ਰਹਿਓ ਨਿਆਰੋ ਮਾਤੰਗ ਮਤਿ ਅਹੰਕਾਰ ॥੩॥",
      "transliteration": "gobi(n)d gupat hoi rahio niaaro maata(n)g mat aha(n)kaar ||3||",
      "translation": "The Lord of the Universe is hidden and unattached. The mortal is like a wild elephant, intoxicated with the wine of egotism. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਰਿ ਕ੍ਰਿਪਾ ਪ੍ਰਭ ਸੰਤ ਰਾਖੇ ਚਰਨ ਕਮਲ ਅਧਾਰ ॥",
      "transliteration": "kar kripaa prabh sa(n)t raakhe charan kamal adhaar ||",
      "translation": "In His Mercy, God saves His Saints; they have the Support of His Lotus Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕਰ ਜੋਰਿ ਨਾਨਕੁ ਸਰਨਿ ਆਇਓ ਗੋੁਪਾਲ ਪੁਰਖ ਅਪਾਰ ॥੪॥੧॥੧੨੯॥",
      "transliteration": "kar jor naanak saran aaio goupaal purakh apaar ||4||1||129||",
      "translation": "With his palms pressed together, Nanak has come to the Sanctuary of the Primal Being, the Infinite Lord God. ||4||1||129||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਸਾਰਗ ਮਹਲਾ ੫ ਘਰੁ ੬ ਪੜਤਾਲ ॥",
      "transliteration": "saarag mahalaa 5 ghar 6 paRataal ||",
      "translation": "Saarang, Fifth Mehl, Sixth House, Partaal:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁਭ ਬਚਨ ਬੋਲਿ ਗੁਨ ਅਮੋਲ ॥",
      "transliteration": "subh bachan bol gun amol ||",
      "translation": "Chant His Sublime Word and His Priceless Glories.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਕਿੰਕਰੀ ਬਿਕਾਰ ॥",
      "transliteration": "ki(n)karee bikaar ||",
      "translation": "Why are you indulding in corrupt actions?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੇਖੁ ਰੀ ਬੀਚਾਰ ॥",
      "transliteration": "dekh ree beechaar ||",
      "translation": "Look at this, see and understand!",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰਸਬਦੁ ਧਿਆਇ ਮਹਲੁ ਪਾਇ ॥",
      "transliteration": "gurasabad dhiaai mahal paai ||",
      "translation": "Meditate on the Word of the Guru's Shabad, and attain the Mansion of the Lord's Presence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਰੰਗ ਕਰਤੀ ਮਹਾ ਕੇਲ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "har sa(n)g ra(n)g karatee mahaa kel ||1|| rahaau ||",
      "translation": "Imbued with the Love of the Lord, you shall totally play with Him. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸੁਪਨ ਰੀ ਸੰਸਾਰੁ ॥",
      "transliteration": "supan ree sa(n)saar ||",
      "translation": "The world is a dream.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਿਥਨੀ ਬਿਸਥਾਰੁ ॥",
      "transliteration": "mithanee bisathaar ||",
      "translation": "Its expanse is false.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਖੀ ਕਾਇ ਮੋਹਿ ਮੋਹਿਲੀ ਪ੍ਰਿਅ ਪ੍ਰੀਤਿ ਰਿਦੈ ਮੇਲ ॥੧॥",
      "transliteration": "sakhee kaai mohi mohilee pri preet ridai mel ||1||",
      "translation": "O my companion, why are you so enticed by the Enticer? Enshrine the Love of Your Beloved within your heart. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਰਬ ਰੀ ਪ੍ਰੀਤਿ ਪਿਆਰੁ ॥",
      "transliteration": "sarab ree preet piaar ||",
      "translation": "He is total love and affection.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪ੍ਰਭੁ ਸਦਾ ਰੀ ਦਇਆਰੁ ॥",
      "transliteration": "prabh sadaa ree daiaar ||",
      "translation": "God is always merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਕਾਂਏਂ ਆਨ ਆਨ ਰੁਚੀਐ ॥",
      "transliteration": "kaa(n)e(n) aan aan rucheeai ||",
      "translation": "Others - why are you involved with others?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਰਿ ਸੰਗਿ ਸੰਗਿ ਖਚੀਐ ॥",
      "transliteration": "har sa(n)g sa(n)g khacheeai ||",
      "translation": "Remain involved with the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਉ ਸਾਧਸੰਗ ਪਾਏ ॥",
      "transliteration": "jau saadhasa(n)g paae ||",
      "translation": "When you join the Saadh Sangat, the Company of the Holy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਹਰਿ ਧਿਆਏ ॥",
      "transliteration": "kahu naanak har dhiaae ||",
      "translation": "says Nanak, meditate on the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਬ ਰਹੇ ਜਮਹਿ ਮੇਲ ॥੨॥੧॥੧੩੦॥",
      "transliteration": "ab rahe jamahi mel ||2||1||130||",
      "translation": "Now, your association with death is ended. ||2||1||130||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਾਰਗ ਮਹਲਾ ੫ ॥",
      "transliteration": "saarag mahalaa 5 ||",
      "translation": "Saarang, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕੰਚਨਾ ਬਹੁ ਦਤ ਕਰਾ ॥",
      "transliteration": "ka(n)chanaa bahu dat karaa ||",
      "translation": "You may make donations of gold,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਭੂਮਿ ਦਾਨੁ ਅਰਪਿ ਧਰਾ ॥",
      "transliteration": "bhoom daan arap dharaa ||",
      "translation": "and give away land in charity",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਮਨ ਅਨਿਕ ਸੋਚ ਪਵਿਤ੍ਰ ਕਰਤ ॥",
      "transliteration": "man anik soch pavitr karat ||",
      "translation": "and purify your mind in various ways,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਹੀ ਰੇ ਨਾਮ ਤੁਲਿ ਮਨ ਚਰਨ ਕਮਲ ਲਾਗੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naahee re naam tul man charan kamal laage ||1|| rahaau ||",
      "translation": "but none of this is equal to the Lord's Name. Remain attached to the Lord's Lotus Feet. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚਾਰਿ ਬੇਦ ਜਿਹਵ ਭਨੇ ॥",
      "transliteration": "chaar bed jihav bhane ||",
      "translation": "You may recite the four Vedas with your tongue,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਦਸ ਅਸਟ ਖਸਟ ਸ੍ਰਵਨ ਸੁਨੇ ॥",
      "transliteration": "das asat khasat sravan sune ||",
      "translation": "and listen to the eighteen Puraanas and the six Shaastras with your ears,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਹੀ ਤੁਲਿ ਗੋਬਿਦ ਨਾਮ ਧੁਨੇ ॥",
      "transliteration": "nahee tul gobid naam dhune ||",
      "translation": "but these are not equal to the celestial melody of the Naam, the Name of the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨ ਚਰਨ ਕਮਲ ਲਾਗੇ ॥੧॥",
      "transliteration": "man charan kamal laage ||1||",
      "translation": "Remain attached to the Lord's Lotus Feet. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਬਰਤ ਸੰਧਿ ਸੋਚ ਚਾਰ ॥",
      "transliteration": "barat sa(n)dh soch chaar ||",
      "translation": "You may observe fasts, and say your prayers, purify yourself",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕ੍ਰਿਆ ਕੁੰਟਿ ਨਿਰਾਹਾਰ ॥",
      "transliteration": "kriaa ku(n)t niraahaar ||",
      "translation": "and do good deeds; you may go on pilgrimages everywhere and eat nothing at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਅਪਰਸ ਕਰਤ ਪਾਕਸਾਰ ॥",
      "transliteration": "aparas karat paakasaar ||",
      "translation": "You may cook your food without touching anyone;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਨਿਵਲੀ ਕਰਮ ਬਹੁ ਬਿਸਥਾਰ ॥",
      "transliteration": "nivalee karam bahu bisathaar ||",
      "translation": "you may make a great show of cleansing techniques,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਧੂਪ ਦੀਪ ਕਰਤੇ ਹਰਿ ਨਾਮ ਤੁਲਿ ਨ ਲਾਗੇ ॥",
      "transliteration": "dhoop deep karate har naam tul na laage ||",
      "translation": "and burn incense and devotional lamps, but none of these are equal to the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਾਮ ਦਇਆਰ ਸੁਨਿ ਦੀਨ ਬੇਨਤੀ ॥",
      "transliteration": "raam daiaar sun deen benatee ||",
      "translation": "O Merciful Lord, please hear the prayer of the meek and the poor.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1229_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਦੇਹੁ ਦਰਸੁ ਨੈਨ ਪੇਖਉ ਜਨ ਨਾਨਕ ਨਾਮ ਮਿਸਟ ਲਾਗੇ ॥੨॥੨॥੧੩੧॥",
      "transliteration": "dehu daras nain pekhau jan naanak naam misat laage ||2||2||131||",
      "translation": "Please grant me the Blessed Vision of Your Darshan, that I may see You with my eyes. The Naam is so sweet to servant Nanak. ||2||2||131||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1229,
      "hindi": "",
      "hindiTransliteration": ""
    },
