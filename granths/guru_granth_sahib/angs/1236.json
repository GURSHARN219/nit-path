{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1236,
  "lineCount": 51,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1236_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਅਨਿਕ ਪੁਰਖ ਅੰਸਾ ਅਵਤਾਰ ॥",
      "transliteration": "anik purakh a(n)saa avataar ||",
      "translation": "Many beings take incarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਅਨਿਕ ਇੰਦ੍ਰ ਊਭੇ ਦਰਬਾਰ ॥੩॥",
      "transliteration": "anik i(n)dr oobhe darabaar ||3||",
      "translation": "Many Indras stand at the Lord's Door. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਨਿਕ ਪਵਨ ਪਾਵਕ ਅਰੁ ਨੀਰ ॥",
      "transliteration": "anik pavan paavak ar neer ||",
      "translation": "Many winds, fires and waters.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅਨਿਕ ਰਤਨ ਸਾਗਰ ਦਧਿ ਖੀਰ ॥",
      "transliteration": "anik ratan saagar dadh kheer ||",
      "translation": "Many jewels, and oceans of butter and milk.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਅਨਿਕ ਸੂਰ ਸਸੀਅਰ ਨਖਿਆਤਿ ॥",
      "transliteration": "anik soor saseear nakhiaat ||",
      "translation": "Many suns, moons and stars.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅਨਿਕ ਦੇਵੀ ਦੇਵਾ ਬਹੁ ਭਾਂਤਿ ॥੪॥",
      "transliteration": "anik devee devaa bahu bhaa(n)t ||4||",
      "translation": "Many gods and goddesses of so many kinds. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਅਨਿਕ ਬਸੁਧਾ ਅਨਿਕ ਕਾਮਧੇਨ ॥",
      "transliteration": "anik basudhaa anik kaamadhen ||",
      "translation": "Many earths, many wish-fulfilling cows.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਨਿਕ ਪਾਰਜਾਤ ਅਨਿਕ ਮੁਖਿ ਬੇਨ ॥",
      "transliteration": "anik paarajaat anik mukh ben ||",
      "translation": "Many miraculous Elysian trees, many Krishnas playing the flute.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਨਿਕ ਅਕਾਸ ਅਨਿਕ ਪਾਤਾਲ ॥",
      "transliteration": "anik akaas anik paataal ||",
      "translation": "Many Akaashic ethers, many nether regions of the underworld.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਨਿਕ ਮੁਖੀ ਜਪੀਐ ਗੋਪਾਲ ॥੫॥",
      "transliteration": "anik mukhee japeeai gopaal ||5||",
      "translation": "Many mouths chant and meditate on the Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਨਿਕ ਸਾਸਤ੍ਰ ਸਿਮ੍ਰਿਤਿ ਪੁਰਾਨ ॥",
      "transliteration": "anik saasatr simrit puraan ||",
      "translation": "Many Shaastras, Simritees and Puraanas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅਨਿਕ ਜੁਗਤਿ ਹੋਵਤ ਬਖਿਆਨ ॥",
      "transliteration": "anik jugat hovat bakhiaan ||",
      "translation": "Many ways in which we speak.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਅਨਿਕ ਸਰੋਤੇ ਸੁਨਹਿ ਨਿਧਾਨ ॥",
      "transliteration": "anik sarote sunahi nidhaan ||",
      "translation": "Many listeners listen to the Lord of Treasure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਰਬ ਜੀਅ ਪੂਰਨ ਭਗਵਾਨ ॥੬॥",
      "transliteration": "sarab jee pooran bhagavaan ||6||",
      "translation": "The Lord God totally permeates all beings. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਅਨਿਕ ਧਰਮ ਅਨਿਕ ਕੁਮੇਰ ॥",
      "transliteration": "anik dharam anik kumer ||",
      "translation": "Many righteous judges of Dharma, many gods of wealth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਨਿਕ ਬਰਨ ਅਨਿਕ ਕਨਿਕ ਸੁਮੇਰ ॥",
      "transliteration": "anik baran anik kanik sumer ||",
      "translation": "Many gods of water, many mountains of gold.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਅਨਿਕ ਸੇਖ ਨਵਤਨ ਨਾਮੁ ਲੇਹਿ ॥",
      "transliteration": "anik sekh navatan naam lehi ||",
      "translation": "Many thousand-headed snakes, chanting ever-new Names of God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਕਾ ਅੰਤੁ ਨ ਤੇਹਿ ॥੭॥",
      "transliteration": "paarabraham kaa a(n)t na tehi ||7||",
      "translation": "They do not know the limits of the Supreme Lord God. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਨਿਕ ਪੁਰੀਆ ਅਨਿਕ ਤਹ ਖੰਡ ॥",
      "transliteration": "anik pureeaa anik tah kha(n)d ||",
      "translation": "Many solar systems, many galaxies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਨਿਕ ਰੂਪ ਰੰਗ ਬ੍ਰਹਮੰਡ ॥",
      "transliteration": "anik roop ra(n)g brahama(n)d ||",
      "translation": "Many forms, colors and celestial realms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਨਿਕ ਬਨਾ ਅਨਿਕ ਫਲ ਮੂਲ ॥",
      "transliteration": "anik banaa anik phal mool ||",
      "translation": "Many gardens, many fruits and roots.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਆਪਹਿ ਸੂਖਮ ਆਪਹਿ ਅਸਥੂਲ ॥੮॥",
      "transliteration": "aapahi sookham aapahi asathool ||8||",
      "translation": "He Himself is mind, and He Himself is matter. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਨਿਕ ਜੁਗਾਦਿ ਦਿਨਸ ਅਰੁ ਰਾਤਿ ॥",
      "transliteration": "anik jugaad dinas ar raat ||",
      "translation": "Many ages, days and nights.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅਨਿਕ ਪਰਲਉ ਅਨਿਕ ਉਤਪਾਤਿ ॥",
      "transliteration": "anik paralau anik utapaat ||",
      "translation": "Many apocalypses, many creations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅਨਿਕ ਜੀਅ ਜਾ ਕੇ ਗ੍ਰਿਹ ਮਾਹਿ ॥",
      "transliteration": "anik jee jaa ke grih maahi ||",
      "translation": "Many beings are in His home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਰਮਤ ਰਾਮ ਪੂਰਨ ਸ੍ਰਬ ਠਾਂਇ ॥੯॥",
      "transliteration": "ramat raam pooran srab thaa(n)i ||9||",
      "translation": "The Lord is perfectly pervading all places. ||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਅਨਿਕ ਮਾਇਆ ਜਾ ਕੀ ਲਖੀ ਨ ਜਾਇ ॥",
      "transliteration": "anik maaiaa jaa kee lakhee na jaai ||",
      "translation": "Many Mayas, which cannot be known.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਅਨਿਕ ਕਲਾ ਖੇਲੈ ਹਰਿ ਰਾਇ ॥",
      "transliteration": "anik kalaa khelai har raai ||",
      "translation": "Many are the ways in which our Sovereign Lord plays.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਅਨਿਕ ਧੁਨਿਤ ਲਲਿਤ ਸੰਗੀਤ ॥",
      "transliteration": "anik dhunit lalit sa(n)geet ||",
      "translation": "Many exquisite melodies sing of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਨਿਕ ਗੁਪਤ ਪ੍ਰਗਟੇ ਤਹ ਚੀਤ ॥੧੦॥",
      "transliteration": "anik gupat pragate tah cheet ||10||",
      "translation": "Many recording scribes of the conscious and subconscious are revealed there. ||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਭ ਤੇ ਊਚ ਭਗਤ ਜਾ ਕੈ ਸੰਗਿ ॥",
      "transliteration": "sabh te ooch bhagat jaa kai sa(n)g ||",
      "translation": "He is above all, and yet He dwells with His devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਆਠ ਪਹਰ ਗੁਨ ਗਾਵਹਿ ਰੰਗਿ ॥",
      "transliteration": "aath pahar gun gaavahi ra(n)g ||",
      "translation": "Twenty-four hours a day, they sing His Praises with love.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਨਿਕ ਅਨਾਹਦ ਆਨੰਦ ਝੁਨਕਾਰ ॥",
      "transliteration": "anik anaahad aana(n)d jhunakaar ||",
      "translation": "Many unstruck melodies resound and resonate with bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਉਆ ਰਸ ਕਾ ਕਛੁ ਅੰਤੁ ਨ ਪਾਰ ॥੧੧॥",
      "transliteration": "uaa ras kaa kachh a(n)t na paar ||11||",
      "translation": "There is no end or limit of that sublime essence. ||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਤਿ ਪੁਰਖੁ ਸਤਿ ਅਸਥਾਨੁ ॥",
      "transliteration": "sat purakh sat asathaan ||",
      "translation": "True is the Primal Being, and True is His dwelling.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਊਚ ਤੇ ਊਚ ਨਿਰਮਲ ਨਿਰਬਾਨੁ ॥",
      "transliteration": "ooch te ooch niramal nirabaan ||",
      "translation": "He is the Highest of the high, Immaculate and Detached, in Nirvaanaa.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਪੁਨਾ ਕੀਆ ਜਾਨਹਿ ਆਪਿ ॥",
      "transliteration": "apunaa keeaa jaanahi aap ||",
      "translation": "He alone knows His handiwork.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਆਪੇ ਘਟਿ ਘਟਿ ਰਹਿਓ ਬਿਆਪਿ ॥",
      "transliteration": "aape ghat ghat rahio biaap ||",
      "translation": "He Himself pervades each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕ੍ਰਿਪਾ ਨਿਧਾਨ ਨਾਨਕ ਦਇਆਲ ॥",
      "transliteration": "kripaa nidhaan naanak daiaal ||",
      "translation": "The Merciful Lord is the Treasure of Compassion, O Nanak.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਜਿਨਿ ਜਪਿਆ ਨਾਨਕ ਤੇ ਭਏ ਨਿਹਾਲ ॥੧੨॥੧॥੨॥੨॥੩॥੭॥",
      "transliteration": "jin japiaa naanak te bhae nihaal ||12||1||2||2||3||7||",
      "translation": "Those who chant and meditate on Him, O Nanak, are exalted and enraptured. ||12||1||2||2||3||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਾਰਗ ਛੰਤ ਮਹਲਾ ੫ ॥",
      "transliteration": "saarag chha(n)t mahalaa 5 ||",
      "translation": "Saarang, Chhant, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਭ ਦੇਖੀਐ ਅਨਭੈ ਕਾ ਦਾਤਾ ॥",
      "transliteration": "sabh dekheeai anabhai kaa daataa ||",
      "translation": "See the Giver of fearlessness in all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਪੂਰਨ ਹੈ ਅਲਿਪਾਤਾ ॥",
      "transliteration": "ghat ghat pooran hai alipaataa ||",
      "translation": "The Detached Lord is totally permeating each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਪੂਰਨੁ ਕਰਿ ਬਿਸਥੀਰਨੁ ਜਲ ਤਰੰਗ ਜਿਉ ਰਚਨੁ ਕੀਆ ॥",
      "transliteration": "ghat ghat pooran kar bisatheeran jal tara(n)g jiu rachan keeaa ||",
      "translation": "Like waves in the water, He created the creation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਭਿ ਰਸ ਮਾਣੇ ਭੋਗ ਘਟਾਣੇ ਆਨ ਨ ਬੀਆ ਕੋ ਥੀਆ ॥",
      "transliteration": "habh ras maane bhog ghataane aan na beeaa ko theeaa ||",
      "translation": "He enjoys all tastes, and takes pleasure in all hearts. There is no other like Him at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਰਿ ਰੰਗੀ ਇਕ ਰੰਗੀ ਠਾਕੁਰੁ ਸੰਤਸੰਗਿ ਪ੍ਰਭੁ ਜਾਤਾ ॥",
      "transliteration": "har ra(n)gee ik ra(n)gee thaakur sa(n)tasa(n)g prabh jaataa ||",
      "translation": "The color of the Lord's Love is the one color of our Lord and Master; in the Saadh Sangat, the Company of the Holy, God is realized.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨਾਨਕ ਦਰਸਿ ਲੀਨਾ ਜਿਉ ਜਲ ਮੀਨਾ ਸਭ ਦੇਖੀਐ ਅਨਭੈ ਕਾ ਦਾਤਾ ॥੧॥",
      "transliteration": "naanak daras leenaa jiu jal meenaa sabh dekheeai anabhai kaa daataa ||1||",
      "translation": "O Nanak, I am drenched with the Blessed Vision of the Lord, like the fish in the water. I see the Giver of fearlessness in all. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕਉਨ ਉਪਮਾ ਦੇਉ ਕਵਨ ਬਡਾਈ ॥",
      "transliteration": "kaun upamaa deu kavan badaaee ||",
      "translation": "What praises should I give, and what approval should I offer to Him?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਪੂਰਨ ਪੂਰਿ ਰਹਿਓ ਸ੍ਰਬ ਠਾਈ ॥",
      "transliteration": "pooran poor rahio srab thaaee ||",
      "translation": "The Perfect Lord is totally pervading and permeating all places.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1236_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪੂਰਨ ਮਨਮੋਹਨ ਘਟ ਘਟ ਸੋਹਨ ਜਬ ਖਿੰਚੈ ਤਬ ਛਾਈ ॥",
      "transliteration": "pooran manamohan ghat ghat sohan jab khi(n)chai tab chhaaee ||",
      "translation": "The Perfect Enticing Lord adorns each and every heart. When He withdraws, the mortal turns to dust.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1236,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
