{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1256,
  "lineCount": 50,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1256_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਦੁਖ ਸੁਖ ਦੋਊ ਸਮ ਕਰਿ ਜਾਨੈ ਬੁਰਾ ਭਲਾ ਸੰਸਾਰ ॥",
      "transliteration": "dukh sukh dooo sam kar jaanai buraa bhalaa sa(n)saar ||",
      "translation": "He sees pleasure and pain as both the same, along with good and bad in the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸੁਧਿ ਬੁਧਿ ਸੁਰਤਿ ਨਾਮਿ ਹਰਿ ਪਾਈਐ ਸਤਸੰਗਤਿ ਗੁਰ ਪਿਆਰ ॥੨॥",
      "transliteration": "sudh budh surat naam har paaeeai satasa(n)gat gur piaar ||2||",
      "translation": "Wisdom, understanding and awareness are found in the Name of the Lord. In the Sat Sangat, the True Congregation, embrace love for the Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਲਾਹਾ ਹਰਿ ਨਾਮੁ ਪਰਾਪਤਿ ਗੁਰੁ ਦਾਤਾ ਦੇਵਣਹਾਰੁ ॥",
      "transliteration": "ahinis laahaa har naam paraapat gur daataa devanahaar ||",
      "translation": "Day and night, profit is obtained through the Lord's Name. The Guru, the Giver, has given this gift.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਸਿਖ ਸੋਈ ਜਨੁ ਪਾਏ ਜਿਸ ਨੋ ਨਦਰਿ ਕਰੇ ਕਰਤਾਰੁ ॥੩॥",
      "transliteration": "guramukh sikh soee jan paae jis no nadar kare karataar ||3||",
      "translation": "That Sikh who becomes Gurmukh obtains it. The Creator blesses him with His Glance of Grace. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕਾਇਆ ਮਹਲੁ ਮੰਦਰੁ ਘਰੁ ਹਰਿ ਕਾ ਤਿਸੁ ਮਹਿ ਰਾਖੀ ਜੋਤਿ ਅਪਾਰ ॥",
      "transliteration": "kaaiaa mahal ma(n)dar ghar har kaa tis mahi raakhee jot apaar ||",
      "translation": "The body is a mansion, a temple, the home of the Lord; He has infused His Infinite Light into it.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਮਹਲਿ ਬੁਲਾਈਐ ਹਰਿ ਮੇਲੇ ਮੇਲਣਹਾਰ ॥੪॥੫॥",
      "transliteration": "naanak guramukh mahal bulaaeeai har mele melanahaar ||4||5||",
      "translation": "O Nanak, the Gurmukh is invited to the Mansion of the Lord's Presence; the Lord unites him in His Union. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੧ ਘਰੁ ੨ ॥",
      "transliteration": "malaar mahalaa 1 ghar 2 ||",
      "translation": "Malaar, First Mehl, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਪਵਣੈ ਪਾਣੀ ਜਾਣੈ ਜਾਤਿ ॥",
      "transliteration": "pavanai paanee jaanai jaat ||",
      "translation": "Know that the creation was formed through air and water;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਕਾਇਆਂ ਅਗਨਿ ਕਰੇ ਨਿਭਰਾਂਤਿ ॥",
      "transliteration": "kaaiaa(n) agan kare nibharaa(n)t ||",
      "translation": "have no doubt that the body was made through fire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਜੰਮਹਿ ਜੀਅ ਜਾਣੈ ਜੇ ਥਾਉ ॥",
      "transliteration": "ja(n)mahi jee jaanai je thaau ||",
      "translation": "And if you know where the soul comes from,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸੁਰਤਾ ਪੰਡਿਤੁ ਤਾ ਕਾ ਨਾਉ ॥੧॥",
      "transliteration": "surataa pa(n)dit taa kaa naau ||1||",
      "translation": "you shall be known as a wise religious scholar. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੁਣ ਗੋਬਿੰਦ ਨ ਜਾਣੀਅਹਿ ਮਾਇ ॥",
      "transliteration": "gun gobi(n)d na jaaneeahi maai ||",
      "translation": "Who can know the Glorious Praises of the Lord of the Universe, O mother?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਣਡੀਠਾ ਕਿਛੁ ਕਹਣੁ ਨ ਜਾਇ ॥",
      "transliteration": "anadeethaa kichh kahan na jaai ||",
      "translation": "Without seeing Him, we cannot say anything about Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਕਿਆ ਕਰਿ ਆਖਿ ਵਖਾਣੀਐ ਮਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kiaa kar aakh vakhaaneeai maai ||1|| rahaau ||",
      "translation": "How can anyone speak and describe Him, O mother? ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਊਪਰਿ ਦਰਿ ਅਸਮਾਨਿ ਪਇਆਲਿ ॥",
      "transliteration": "oopar dar asamaan paiaal ||",
      "translation": "He is high above the sky, and beneath the nether worlds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਿਉ ਕਰਿ ਕਹੀਐ ਦੇਹੁ ਵੀਚਾਰਿ ॥",
      "transliteration": "kiu kar kaheeai dehu veechaar ||",
      "translation": "How can I speak of Him? Let me understand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਬਿਨੁ ਜਿਹਵਾ ਜੋ ਜਪੈ ਹਿਆਇ ॥",
      "transliteration": "bin jihavaa jo japai hiaai ||",
      "translation": "Who knows what sort of Name is chanted,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕੋਈ ਜਾਣੈ ਕੈਸਾ ਨਾਉ ॥੨॥",
      "transliteration": "koee jaanai kaisaa naau ||2||",
      "translation": "In the heart, without the tongue? ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਕਥਨੀ ਬਦਨੀ ਰਹੈ ਨਿਭਰਾਂਤਿ ॥",
      "transliteration": "kathanee badanee rahai nibharaa(n)t ||",
      "translation": "Undoubtedly, words fail me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸੋ ਬੂਝੈ ਹੋਵੈ ਜਿਸੁ ਦਾਤਿ ॥",
      "transliteration": "so boojhai hovai jis daat ||",
      "translation": "He alone understands, who is blessed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅਹਿਨਿਸਿ ਅੰਤਰਿ ਰਹੈ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "ahinis a(n)tar rahai liv laai ||",
      "translation": "Day and night, deep within, he remains lovingly attuned to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸੋਈ ਪੁਰਖੁ ਜਿ ਸਚਿ ਸਮਾਇ ॥੩॥",
      "transliteration": "soee purakh j sach samaai ||3||",
      "translation": "He is the true person, who is merged in the True Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਜਾਤਿ ਕੁਲੀਨੁ ਸੇਵਕੁ ਜੇ ਹੋਇ ॥",
      "transliteration": "jaat kuleen sevak je hoi ||",
      "translation": "If someone of high social standing becomes a selfless servant,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤਾ ਕਾ ਕਹਣਾ ਕਹਹੁ ਨ ਕੋਇ ॥",
      "transliteration": "taa kaa kahanaa kahahu na koi ||",
      "translation": "then his praises cannot even be expressed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਵਿਚਿ ਸਨਾਤਂੀ ਸੇਵਕੁ ਹੋਇ ॥",
      "transliteration": "vich sanaata(n)ee sevak hoi ||",
      "translation": "And if someone from a low social class becomes a selfless servant,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਨਕ ਪਣ੍ਹੀਆ ਪਹਿਰੈ ਸੋਇ ॥੪॥੧॥੬॥",
      "transliteration": "naanak panheeaa pahirai soi ||4||1||6||",
      "translation": "O Nanak, he shall wear shoes of honor. ||4||1||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੧ ॥",
      "transliteration": "malaar mahalaa 1 ||",
      "translation": "Malaar, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੁਖੁ ਵੇਛੋੜਾ ਇਕੁ ਦੁਖੁ ਭੂਖ ॥",
      "transliteration": "dukh vechhoRaa ik dukh bhookh ||",
      "translation": "The pain of separation - this is the hungry pain I feel.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਕੁ ਦੁਖੁ ਸਕਤਵਾਰ ਜਮਦੂਤ ॥",
      "transliteration": "ik dukh sakatavaar jamadoot ||",
      "translation": "Another pain is the attack of the Messenger of Death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਇਕੁ ਦੁਖੁ ਰੋਗੁ ਲਗੈ ਤਨਿ ਧਾਇ ॥",
      "transliteration": "ik dukh rog lagai tan dhaai ||",
      "translation": "Another pain is the disease consuming my body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਵੈਦ ਨ ਭੋਲੇ ਦਾਰੂ ਲਾਇ ॥੧॥",
      "transliteration": "vaid na bhole daaroo laai ||1||",
      "translation": "O foolish doctor, don't give me medicine. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਵੈਦ ਨ ਭੋਲੇ ਦਾਰੂ ਲਾਇ ॥",
      "transliteration": "vaid na bhole daaroo laai ||",
      "translation": "O foolish doctor, don't give me medicine.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਦਰਦੁ ਹੋਵੈ ਦੁਖੁ ਰਹੈ ਸਰੀਰ ॥",
      "transliteration": "darad hovai dukh rahai sareer ||",
      "translation": "The pain persists, and the body continues to suffer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਐਸਾ ਦਾਰੂ ਲਗੈ ਨ ਬੀਰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aisaa daaroo lagai na beer ||1|| rahaau ||",
      "translation": "Your medicine has no effect on me. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਖਸਮੁ ਵਿਸਾਰਿ ਕੀਏ ਰਸ ਭੋਗ ॥",
      "transliteration": "khasam visaar keee ras bhog ||",
      "translation": "Forgetting his Lord and Master, the mortal enjoys sensual pleasures;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਤਾਂ ਤਨਿ ਉਠਿ ਖਲੋਏ ਰੋਗ ॥",
      "transliteration": "taa(n) tan uth khaloe rog ||",
      "translation": "then, disease rises up in his body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਨ ਅੰਧੇ ਕਉ ਮਿਲੈ ਸਜਾਇ ॥",
      "transliteration": "man a(n)dhe kau milai sajaai ||",
      "translation": "The blind mortal receives his punishment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਵੈਦ ਨ ਭੋਲੇ ਦਾਰੂ ਲਾਇ ॥੨॥",
      "transliteration": "vaid na bhole daaroo laai ||2||",
      "translation": "O foolish doctor, don't give me medicine. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਚੰਦਨ ਕਾ ਫਲੁ ਚੰਦਨ ਵਾਸੁ ॥",
      "transliteration": "cha(n)dan kaa phal cha(n)dan vaas ||",
      "translation": "The value of sandalwood lies in its fragrance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਮਾਣਸ ਕਾ ਫਲੁ ਘਟ ਮਹਿ ਸਾਸੁ ॥",
      "transliteration": "maanas kaa phal ghat mahi saas ||",
      "translation": "The value of the human lasts only as long as the breath in the body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਾਸਿ ਗਇਐ ਕਾਇਆ ਢਲਿ ਪਾਇ ॥",
      "transliteration": "saas gaiai kaaiaa dhal paai ||",
      "translation": "When the breath is taken away, the body crumbles into dust.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤਾ ਕੈ ਪਾਛੈ ਕੋਇ ਨ ਖਾਇ ॥੩॥",
      "transliteration": "taa kai paachhai koi na khaai ||3||",
      "translation": "After that, no one takes any food. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਕੰਚਨ ਕਾਇਆ ਨਿਰਮਲ ਹੰਸੁ ॥",
      "transliteration": "ka(n)chan kaaiaa niramal ha(n)s ||",
      "translation": "The mortal's body is golden, and the soul-swan is immaculate and pure,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਜਿਸੁ ਮਹਿ ਨਾਮੁ ਨਿਰੰਜਨ ਅੰਸੁ ॥",
      "transliteration": "jis mahi naam nira(n)jan a(n)s ||",
      "translation": "if even a tiny particle of the Immaculate Naam is within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੂਖ ਰੋਗ ਸਭਿ ਗਇਆ ਗਵਾਇ ॥",
      "transliteration": "dookh rog sabh gaiaa gavaai ||",
      "translation": "All pain and disease are eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਨਕ ਛੂਟਸਿ ਸਾਚੈ ਨਾਇ ॥੪॥੨॥੭॥",
      "transliteration": "naanak chhootas saachai naai ||4||2||7||",
      "translation": "O Nanak, the mortal is saved through the True Name. ||4||2||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੧ ॥",
      "transliteration": "malaar mahalaa 1 ||",
      "translation": "Malaar, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਦੁਖ ਮਹੁਰਾ ਮਾਰਣ ਹਰਿ ਨਾਮੁ ॥",
      "transliteration": "dukh mahuraa maaran har naam ||",
      "translation": "Pain is the poison. The Lord's Name is the antidote.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1256_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਿਲਾ ਸੰਤੋਖ ਪੀਸਣੁ ਹਥਿ ਦਾਨੁ ॥",
      "transliteration": "silaa sa(n)tokh peesan hath daan ||",
      "translation": "Grind it up in the mortar of contentment, with the pestle of charitable giving.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1256,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
