{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1262,
  "lineCount": 49,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1262_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਨਾਮਿ ਸਮਾਹਾ ॥੪॥੨॥੧੧॥",
      "transliteration": "naanak guramukh naam samaahaa ||4||2||11||",
      "translation": "O Nanak, the Gurmukh merges in the Naam. ||4||2||11||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੩ ॥",
      "transliteration": "malaar mahalaa 3 ||",
      "translation": "Malaar, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਜੀਵਤ ਮੁਕਤ ਗੁਰਮਤੀ ਲਾਗੇ ॥",
      "transliteration": "jeevat mukat guramatee laage ||",
      "translation": "Those who are attached to the Guru's Teachings, are Jivan-mukta, liberated while yet alive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਰਿ ਕੀ ਭਗਤਿ ਅਨਦਿਨੁ ਸਦ ਜਾਗੇ ॥",
      "transliteration": "har kee bhagat anadin sad jaage ||",
      "translation": "They remain forever awake and aware night and day, in devotional worship of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵਹਿ ਆਪੁ ਗਵਾਇ ॥",
      "transliteration": "satigur sevahi aap gavaai ||",
      "translation": "They serve the True Guru, and eradicate their self-conceit.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਹਉ ਤਿਨ ਜਨ ਕੇ ਸਦ ਲਾਗਉ ਪਾਇ ॥੧॥",
      "transliteration": "hau tin jan ke sad laagau paai ||1||",
      "translation": "I fall at the feet of such humble beings. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਹਉ ਜੀਵਾਂ ਸਦਾ ਹਰਿ ਕੇ ਗੁਣ ਗਾਈ ॥",
      "transliteration": "hau jeevaa(n) sadaa har ke gun gaaee ||",
      "translation": "Constantly singing the Glorious Praises of the Lord, I live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਮਹਾ ਰਸੁ ਮੀਠਾ ਹਰਿ ਕੈ ਨਾਮਿ ਮੁਕਤਿ ਗਤਿ ਪਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur kaa sabad mahaa ras meethaa har kai naam mukat gat paaee ||1|| rahaau ||",
      "translation": "The Word of the Guru's Shabad is such totally sweet elixir. Through the Name of the Lord, I have attained the state of liberation. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਾਇਆ ਮੋਹੁ ਅਗਿਆਨੁ ਗੁਬਾਰੁ ॥",
      "transliteration": "maaiaa mohu agiaan gubaar ||",
      "translation": "Attachment to Maya leads to the darkness of ignorance.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਨਮੁਖ ਮੋਹੇ ਮੁਗਧ ਗਵਾਰ ॥",
      "transliteration": "manamukh mohe mugadh gavaar ||",
      "translation": "The self-willed manukhs are attached, foolish and ignorant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਅਨਦਿਨੁ ਧੰਧਾ ਕਰਤ ਵਿਹਾਇ ॥",
      "transliteration": "anadin dha(n)dhaa karat vihaai ||",
      "translation": "Night and day, their lives pass away in worldly entanglements.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਮਰਿ ਮਰਿ ਜੰਮਹਿ ਮਿਲੈ ਸਜਾਇ ॥੨॥",
      "transliteration": "mar mar ja(n)mahi milai sajaai ||2||",
      "translation": "They die and die again and again, only to be reborn and receive their punishment. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਰਾਮ ਨਾਮਿ ਲਿਵ ਲਾਈ ॥",
      "transliteration": "guramukh raam naam liv laaee ||",
      "translation": "The Gurmukh is lovingly attuned to the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਕੂੜੈ ਲਾਲਚਿ ਨਾ ਲਪਟਾਈ ॥",
      "transliteration": "kooRai laalach naa lapataaee ||",
      "translation": "He does not cling to false greed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਹੋਵੈ ਸਹਜਿ ਸੁਭਾਇ ॥",
      "transliteration": "jo kichh hovai sahaj subhaai ||",
      "translation": "Whatever he does, he does with intuitive poise.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਹਰਿ ਰਸੁ ਪੀਵੈ ਰਸਨ ਰਸਾਇ ॥੩॥",
      "transliteration": "har ras peevai rasan rasaai ||3||",
      "translation": "He drinks in the sublime essence of the Lord; his tongue delights in its flavor. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕੋਟਿ ਮਧੇ ਕਿਸਹਿ ਬੁਝਾਈ ॥",
      "transliteration": "kot madhe kisahi bujhaaee ||",
      "translation": "Among millions, hardly any understand.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਆਪੇ ਬਖਸੇ ਦੇ ਵਡਿਆਈ ॥",
      "transliteration": "aape bakhase de vadiaaee ||",
      "translation": "The Lord Himself forgives, and bestows His glorious greatness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਜੋ ਧੁਰਿ ਮਿਲਿਆ ਸੁ ਵਿਛੁੜਿ ਨ ਜਾਈ ॥",
      "transliteration": "jo dhur miliaa s vichhuR na jaaee ||",
      "translation": "Whoever meets with the Primal Lord God, shall never be separated again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਨਕ ਹਰਿ ਹਰਿ ਨਾਮਿ ਸਮਾਈ ॥੪॥੩॥੧੨॥",
      "transliteration": "naanak har har naam samaaee ||4||3||12||",
      "translation": "Nanak is absorbed in the Name of the Lord, Har, Har. ||4||3||12||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੩ ॥",
      "transliteration": "malaar mahalaa 3 ||",
      "translation": "Malaar, Third Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਰਸਨਾ ਨਾਮੁ ਸਭੁ ਕੋਈ ਕਹੈ ॥",
      "transliteration": "rasanaa naam sabh koee kahai ||",
      "translation": "Everyone speaks the Name of the Lord with the tongue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵੇ ਤਾ ਨਾਮੁ ਲਹੈ ॥",
      "transliteration": "satigur seve taa naam lahai ||",
      "translation": "But only by serving the True Guru does the mortal receive the Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਬੰਧਨ ਤੋੜੇ ਮੁਕਤਿ ਘਰਿ ਰਹੈ ॥",
      "transliteration": "ba(n)dhan toRe mukat ghar rahai ||",
      "translation": "His bonds are shattered, and he stays in the house of liberation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰਸਬਦੀ ਅਸਥਿਰੁ ਘਰਿ ਬਹੈ ॥੧॥",
      "transliteration": "gurasabadee asathir ghar bahai ||1||",
      "translation": "Through the Word of the Guru's Shabad, he sits in the eternal, unchanging house. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮੇਰੇ ਮਨ ਕਾਹੇ ਰੋਸੁ ਕਰੀਜੈ ॥",
      "transliteration": "mere man kaahe ros kareejai ||",
      "translation": "O my mind, why are you angry?",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਲਾਹਾ ਕਲਜੁਗਿ ਰਾਮ ਨਾਮੁ ਹੈ ਗੁਰਮਤਿ ਅਨਦਿਨੁ ਹਿਰਦੈ ਰਵੀਜੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "laahaa kalajug raam naam hai guramat anadin hiradai raveejai ||1|| rahaau ||",
      "translation": "In this Dark Age of Kali Yuga, the Lord's Name is the source of profit. Contemplate and appreciate the Guru's Teachings within your heart, night and day. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਬਾਬੀਹਾ ਖਿਨੁ ਖਿਨੁ ਬਿਲਲਾਇ ॥",
      "transliteration": "baabeehaa khin khin bilalaai ||",
      "translation": "Each and every instant, the rainbird cries and calls.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਬਿਨੁ ਪਿਰ ਦੇਖੇ ਨਂੀਦ ਨ ਪਾਇ ॥",
      "transliteration": "bin pir dekhe na(n)eed na paai ||",
      "translation": "Without seeing her Beloved, she does not sleep at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਇਹੁ ਵੇਛੋੜਾ ਸਹਿਆ ਨ ਜਾਇ ॥",
      "transliteration": "ihu vechhoRaa sahiaa na jaai ||",
      "translation": "She cannot endure this separation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਮਿਲੈ ਤਾਂ ਮਿਲੈ ਸੁਭਾਇ ॥੨॥",
      "transliteration": "satigur milai taa(n) milai subhaai ||2||",
      "translation": "When she meets the True Guru, then she intuitively meets her Beloved. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਾਮਹੀਣੁ ਬਿਨਸੈ ਦੁਖੁ ਪਾਇ ॥",
      "transliteration": "naamaheen binasai dukh paai ||",
      "translation": "Lacking the Naam, the Name of the Lord, the mortal suffers and dies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤ੍ਰਿਸਨਾ ਜਲਿਆ ਭੂਖ ਨ ਜਾਇ ॥",
      "transliteration": "trisanaa jaliaa bhookh na jaai ||",
      "translation": "He is burnt in the fire of desire, and his hunger does not depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਵਿਣੁ ਭਾਗਾ ਨਾਮੁ ਨ ਪਾਇਆ ਜਾਇ ॥",
      "transliteration": "vin bhaagaa naam na paaiaa jaai ||",
      "translation": "Without good destiny, he cannot find the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬਹੁ ਬਿਧਿ ਥਾਕਾ ਕਰਮ ਕਮਾਇ ॥੩॥",
      "transliteration": "bahu bidh thaakaa karam kamaai ||3||",
      "translation": "He performs all sorts of rituals until he is exhausted. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਤ੍ਰੈ ਗੁਣ ਬਾਣੀ ਬੇਦ ਬੀਚਾਰੁ ॥",
      "transliteration": "trai gun baanee bed beechaar ||",
      "translation": "The mortal thinks about the Vedic teachings of the three gunas, the three dispositions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਬਿਖਿਆ ਮੈਲੁ ਬਿਖਿਆ ਵਾਪਾਰੁ ॥",
      "transliteration": "bikhiaa mail bikhiaa vaapaar ||",
      "translation": "He deals in corruption, filth and vice.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਰਿ ਜਨਮਹਿ ਫਿਰਿ ਹੋਹਿ ਖੁਆਰੁ ॥",
      "transliteration": "mar janamahi phir hohi khuaar ||",
      "translation": "He dies, only to be reborn; he is ruined over and over again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਤੁਰੀਆ ਗੁਣੁ ਉਰਿ ਧਾਰੁ ॥੪॥",
      "transliteration": "guramukh tureeaa gun ur dhaar ||4||",
      "translation": "The Gurmukh enshrines the glory of the supreme state of celestial peace. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਰੁ ਮਾਨੈ ਮਾਨੈ ਸਭੁ ਕੋਇ ॥",
      "transliteration": "gur maanai maanai sabh koi ||",
      "translation": "One who has faith in the Guru - everyone has faith in him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗੁਰ ਬਚਨੀ ਮਨੁ ਸੀਤਲੁ ਹੋਇ ॥",
      "transliteration": "gur bachanee man seetal hoi ||",
      "translation": "Through the Guru's Word, the mind is cooled and soothed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਚਹੁ ਜੁਗਿ ਸੋਭਾ ਨਿਰਮਲ ਜਨੁ ਸੋਇ ॥",
      "transliteration": "chahu jug sobhaa niramal jan soi ||",
      "translation": "Throughout the four ages, that humble being is known to be pure.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਵਿਰਲਾ ਕੋਇ ॥੫॥੪॥੧੩॥੯॥੧੩॥੨੨॥",
      "transliteration": "naanak guramukh viralaa koi ||5||4||13||9||13||22||",
      "translation": "O Nanak, that Gurmukh is so rare. ||5||4||13||9||13||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਰਾਗੁ ਮਲਾਰ ਮਹਲਾ ੪ ਘਰੁ ੧ ਚਉਪਦੇ ॥",
      "transliteration": "raag malaar mahalaa 4 ghar 1 chaupade ||",
      "translation": "Raag Malaar, Fourth Mehl, First House, Chau-Padhay:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਅਨਦਿਨੁ ਹਰਿ ਹਰਿ ਧਿਆਇਓ ਹਿਰਦੈ ਮਤਿ ਗੁਰਮਤਿ ਦੂਖ ਵਿਸਾਰੀ ॥",
      "transliteration": "anadin har har dhiaaio hiradai mat guramat dookh visaaree ||",
      "translation": "Night and day, I meditate on the Lord, Har, Har, within my heart; through the Guru's Teachings, my pain is forgotten.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸਭ ਆਸਾ ਮਨਸਾ ਬੰਧਨ ਤੂਟੇ ਹਰਿ ਹਰਿ ਪ੍ਰਭਿ ਕਿਰਪਾ ਧਾਰੀ ॥੧॥",
      "transliteration": "sabh aasaa manasaa ba(n)dhan toote har har prabh kirapaa dhaaree ||1||",
      "translation": "The chains of all my hopes and desires have been snapped; my Lord God has showered me with His Mercy. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਨੈਨੀ ਹਰਿ ਹਰਿ ਲਾਗੀ ਤਾਰੀ ॥",
      "transliteration": "nainee har har laagee taaree ||",
      "translation": "My eyes gaze eternally on the Lord, Har, Har.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1262_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਦੇਖਿ ਮੇਰਾ ਮਨੁ ਬਿਗਸਿਓ ਜਨੁ ਹਰਿ ਭੇਟਿਓ ਬਨਵਾਰੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "satigur dekh meraa man bigasio jan har bhetio banavaaree ||1|| rahaau ||",
      "translation": "Gazing on the True Guru, my mind blossoms forth. I have met with the Lord, the Lord of the World. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1262,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
