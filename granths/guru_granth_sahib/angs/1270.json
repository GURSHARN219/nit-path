{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1270,
  "lineCount": 45,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1270_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਲਾਰ ਮਃ ੫ ॥",
      "transliteration": "malaar mah 5 ||",
      "translation": "Malaar, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪ੍ਰਭ ਕੋ ਭਗਤਿ ਬਛਲੁ ਬਿਰਦਾਇਓ ॥",
      "transliteration": "prabh ko bhagat bachhal biradaaio ||",
      "translation": "It is God's Nature to love His devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਿੰਦਕ ਮਾਰਿ ਚਰਨ ਤਲ ਦੀਨੇ ਅਪੁਨੋ ਜਸੁ ਵਰਤਾਇਓ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "ni(n)dak maar charan tal deene apuno jas varataaio ||1|| rahaau ||",
      "translation": "He destroys the slanderers, crushing them beneath His Feet. His Glory is manifest everywhere. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜੈ ਜੈ ਕਾਰੁ ਕੀਨੋ ਸਭ ਜਗ ਮਹਿ ਦਇਆ ਜੀਅਨ ਮਹਿ ਪਾਇਓ ॥",
      "transliteration": "jai jai kaar keeno sabh jag mahi daiaa jeean mahi paaio ||",
      "translation": "His Victory is celebrated all throughout the world. He blesses all creatures with compassion.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਕੰਠਿ ਲਾਇ ਅਪੁਨੋ ਦਾਸੁ ਰਾਖਿਓ ਤਾਤੀ ਵਾਉ ਨ ਲਾਇਓ ॥੧॥",
      "transliteration": "ka(n)th laai apuno daas raakhio taatee vaau na laaio ||1||",
      "translation": "Hugging him close in His Embrace, the Lord saves and protects His slave. The hot winds cannot even touch him. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਅੰਗੀਕਾਰੁ ਕੀਓ ਮੇਰੇ ਸੁਆਮੀ ਭ੍ਰਮੁ ਭਉ ਮੇਟਿ ਸੁਖਾਇਓ ॥",
      "transliteration": "a(n)geekaar keeo mere suaamee bhram bhau met sukhaaio ||",
      "translation": "My Lord and Master has made me His Own; dispelling my doubts and fears, He has made me happy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਮਹਾ ਅਨੰਦ ਕਰਹੁ ਦਾਸ ਹਰਿ ਕੇ ਨਾਨਕ ਬਿਸ੍ਵਾਸੁ ਮਨਿ ਆਇਓ ॥੨॥੧੪॥੧੮॥",
      "transliteration": "mahaa ana(n)d karahu daas har ke naanak bisvaas man aaio ||2||14||18||",
      "translation": "The Lord's slaves enjoy ultimate ecstasy; O Nanak, faith has welled up in my mind. ||2||14||18||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਰਾਗੁ ਮਲਾਰ ਮਹਲਾ ੫ ਚਉਪਦੇ ਘਰੁ ੨ ॥",
      "transliteration": "raag malaar mahalaa 5 chaupade ghar 2 ||",
      "translation": "Raag Malaar, Fifth Mehl, Chau-Padhay, Second House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਦੀਸੈ ਬ੍ਰਹਮ ਪਸਾਰੁ ॥",
      "transliteration": "guramukh deesai braham pasaar ||",
      "translation": "The Gurmukh sees God pervading everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਤ੍ਰੈ ਗੁਣੀਆਂ ਬਿਸਥਾਰੁ ॥",
      "transliteration": "guramukh trai guneeaa(n) bisathaar ||",
      "translation": "The Gurmukh knows that the universe is the extension of the three gunas, the three dispositions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰਮੁਖਿ ਨਾਦ ਬੇਦ ਬੀਚਾਰੁ ॥",
      "transliteration": "guramukh naad bed beechaar ||",
      "translation": "The Gurmukh reflects on the Sound-current of the Naad, and the wisdom of the Vedas.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਬਿਨੁ ਗੁਰ ਪੂਰੇ ਘੋਰ ਅੰਧਾਰੁ ॥੧॥",
      "transliteration": "bin gur poore ghor a(n)dhaar ||1||",
      "translation": "Without the Perfect Guru, there is only pitch-black darkness. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਮੇਰੇ ਮਨ ਗੁਰੁ ਗੁਰੁ ਕਰਤ ਸਦਾ ਸੁਖੁ ਪਾਈਐ ॥",
      "transliteration": "mere man gur gur karat sadaa sukh paaeeai ||",
      "translation": "O my mind, calling on the Guru, eternal peace is found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰ ਉਪਦੇਸਿ ਹਰਿ ਹਿਰਦੈ ਵਸਿਓ ਸਾਸਿ ਗਿਰਾਸਿ ਅਪਣਾ ਖਸਮੁ ਧਿਆਈਐ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur upades har hiradai vasio saas giraas apanaa khasam dhiaaeeai ||1|| rahaau ||",
      "translation": "Following the Guru's Teachings, the Lord comes to dwell within the heart; I meditate on my Lord and Master with every breath and morsel of food. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਣ ਵਿਟਹੁ ਬਲਿ ਜਾਉ ॥",
      "transliteration": "gur ke charan vitahu bal jaau ||",
      "translation": "I am a sacrifice to the Guru's Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰ ਕੇ ਗੁਣ ਅਨਦਿਨੁ ਨਿਤ ਗਾਉ ॥",
      "transliteration": "gur ke gun anadin nit gaau ||",
      "translation": "Night and day, I continually sing the Glorious Praises of the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਗੁਰ ਕੀ ਧੂੜਿ ਕਰਉ ਇਸਨਾਨੁ ॥",
      "transliteration": "gur kee dhooR karau isanaan ||",
      "translation": "I take my cleansing bath in the dust of the Guru's Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਾਚੀ ਦਰਗਹ ਪਾਈਐ ਮਾਨੁ ॥੨॥",
      "transliteration": "saachee daragah paaeeai maan ||2||",
      "translation": "I am honored in the True Court of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗੁਰੁ ਬੋਹਿਥੁ ਭਵਜਲ ਤਾਰਣਹਾਰੁ ॥",
      "transliteration": "gur bohith bhavajal taaranahaar ||",
      "translation": "The Guru is the boat, to carry me across the terrifying world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਗੁਰਿ ਭੇਟਿਐ ਨ ਹੋਇ ਜੋਨਿ ਅਉਤਾਰੁ ॥",
      "transliteration": "gur bhetiai na hoi jon autaar ||",
      "translation": "Meeting with the Guru, I shall not be reincarnated ever again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰ ਕੀ ਸੇਵਾ ਸੋ ਜਨੁ ਪਾਏ ॥",
      "transliteration": "gur kee sevaa so jan paae ||",
      "translation": "That humble being serves the Guru,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਜਾ ਕਉ ਕਰਮਿ ਲਿਖਿਆ ਧੁਰਿ ਆਏ ॥੩॥",
      "transliteration": "jaa kau karam likhiaa dhur aae ||3||",
      "translation": "who has such karma inscribed on his forehead by the Primal Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਰੁ ਮੇਰੀ ਜੀਵਨਿ ਗੁਰੁ ਆਧਾਰੁ ॥",
      "transliteration": "gur meree jeevan gur aadhaar ||",
      "translation": "The Guru is my life; the Guru is my support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰੁ ਮੇਰੀ ਵਰਤਣਿ ਗੁਰੁ ਪਰਵਾਰੁ ॥",
      "transliteration": "gur meree varatan gur paravaar ||",
      "translation": "The Guru is my way of life; the Guru is my family.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਗੁਰੁ ਮੇਰਾ ਖਸਮੁ ਸਤਿਗੁਰ ਸਰਣਾਈ ॥",
      "transliteration": "gur meraa khasam satigur saranaaee ||",
      "translation": "The Guru is my Lord and Master; I seek the Sanctuary of the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਨਕ ਗੁਰੁ ਪਾਰਬ੍ਰਹਮੁ ਜਾ ਕੀ ਕੀਮ ਨ ਪਾਈ ॥੪॥੧॥੧੯॥",
      "transliteration": "naanak gur paarabraham jaa kee keem na paaee ||4||1||19||",
      "translation": "O Nanak, the Guru is the Supreme Lord God; His value cannot be estimated. ||4||1||19||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੫ ॥",
      "transliteration": "malaar mahalaa 5 ||",
      "translation": "Malaar, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰ ਕੇ ਚਰਨ ਹਿਰਦੈ ਵਸਾਏ ॥",
      "transliteration": "gur ke charan hiradai vasaae ||",
      "translation": "I enshrine the Lord's Feet within my heart;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭਿ ਆਪਿ ਮਿਲਾਏ ॥",
      "transliteration": "kar kirapaa prabh aap milaae ||",
      "translation": "in His Mercy, God has united me with Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਅਪਨੇ ਸੇਵਕ ਕਉ ਲਏ ਪ੍ਰਭੁ ਲਾਇ ॥",
      "transliteration": "apane sevak kau lae prabh laai ||",
      "translation": "God enjoins His servant to his tasks.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਤਾ ਕੀ ਕੀਮਤਿ ਕਹੀ ਨ ਜਾਇ ॥੧॥",
      "transliteration": "taa kee keemat kahee na jaai ||1||",
      "translation": "His worth cannot be expressed. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪੂਰਨ ਸੁਖਦਾਤੇ ॥",
      "transliteration": "kar kirapaa pooran sukhadaate ||",
      "translation": "Please be merciful to me, O Perfect Giver of peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਤੁਮੑਰੀ ਕ੍ਰਿਪਾ ਤੇ ਤੂੰ ਚਿਤਿ ਆਵਹਿ ਆਠ ਪਹਰ ਤੇਰੈ ਰੰਗਿ ਰਾਤੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tumhree kripaa te too(n) chit aavahi aath pahar terai ra(n)g raate ||1|| rahaau ||",
      "translation": "By Your Grace, You come to mind; I am imbued with Your Love, twenty-four hours a day. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਗਾਵਣੁ ਸੁਨਣੁ ਸਭੁ ਤੇਰਾ ਭਾਣਾ ॥",
      "transliteration": "gaavan sunan sabh teraa bhaanaa ||",
      "translation": "Singing and listening, it is all by Your Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਹੁਕਮੁ ਬੂਝੈ ਸੋ ਸਾਚਿ ਸਮਾਣਾ ॥",
      "transliteration": "hukam boojhai so saach samaanaa ||",
      "translation": "One who understands the Hukam of Your Command is absorbed in Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਜਪਿ ਜਪਿ ਜੀਵਹਿ ਤੇਰਾ ਨਾਂਉ ॥",
      "transliteration": "jap jap jeevahi teraa naa(n)u ||",
      "translation": "Chanting and meditating on Your Name, I live.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤੁਝ ਬਿਨੁ ਦੂਜਾ ਨਾਹੀ ਥਾਉ ॥੨॥",
      "transliteration": "tujh bin doojaa naahee thaau ||2||",
      "translation": "Without You, there is no place at all. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਦੁਖ ਸੁਖ ਕਰਤੇ ਹੁਕਮੁ ਰਜਾਇ ॥",
      "transliteration": "dukh sukh karate hukam rajaai ||",
      "translation": "Pain and pleasure come by Your Command, O Creator Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਭਾਣੈ ਬਖਸ ਭਾਣੈ ਦੇਇ ਸਜਾਇ ॥",
      "transliteration": "bhaanai bakhas bhaanai dei sajaai ||",
      "translation": "By the Pleasure of Your Will You forgive, and by the Pleasure of Your Will You award punishment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਦੁਹਾਂ ਸਿਰਿਆਂ ਕਾ ਕਰਤਾ ਆਪਿ ॥",
      "transliteration": "duhaa(n) siriaa(n) kaa karataa aap ||",
      "translation": "You are the Creator of both realms.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕੁਰਬਾਣੁ ਜਾਂਈ ਤੇਰੇ ਪਰਤਾਪ ॥੩॥",
      "transliteration": "kurabaan jaa(n)ee tere parataap ||3||",
      "translation": "I am a sacrifice to Your Glorious Grandeur. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੇਰੀ ਕੀਮਤਿ ਤੂਹੈ ਜਾਣਹਿ ॥",
      "transliteration": "teree keemat toohai jaanahi ||",
      "translation": "You alone know Your value.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤੂ ਆਪੇ ਬੂਝਹਿ ਸੁਣਿ ਆਪਿ ਵਖਾਣਹਿ ॥",
      "transliteration": "too aape boojhahi sun aap vakhaanahi ||",
      "translation": "You alone understand, You Yourself speak and listen.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1270_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸੇਈ ਭਗਤ ਜੋ ਤੁਧੁ ਭਾਣੇ ॥",
      "transliteration": "seee bhagat jo tudh bhaane ||",
      "translation": "They alone are devotees, who are pleasing to Your Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1270,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
