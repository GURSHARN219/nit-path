{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1271,
  "lineCount": 50,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1271_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਨਾਨਕ ਤਿਨ ਕੈ ਸਦ ਕੁਰਬਾਣੇ ॥੪॥੨॥੨੦॥",
      "transliteration": "naanak tin kai sad kurabaane ||4||2||20||",
      "translation": "Nanak is forever a sacrifice to them. ||4||2||20||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੫ ॥",
      "transliteration": "malaar mahalaa 5 ||",
      "translation": "Malaar, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪਰਮੇਸਰੁ ਹੋਆ ਦਇਆਲੁ ॥",
      "transliteration": "paramesar hoaa daiaal ||",
      "translation": "The Transcendent Lord God has become merciful;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮੇਘੁ ਵਰਸੈ ਅੰਮ੍ਰਿਤ ਧਾਰ ॥",
      "transliteration": "megh varasai a(n)mrit dhaar ||",
      "translation": "Ambrosial Nectar is raining down from the clouds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਗਲੇ ਜੀਅ ਜੰਤ ਤ੍ਰਿਪਤਾਸੇ ॥",
      "transliteration": "sagale jee ja(n)t tripataase ||",
      "translation": "All beings and creatures are satisfied;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਕਾਰਜ ਆਏ ਪੂਰੇ ਰਾਸੇ ॥੧॥",
      "transliteration": "kaaraj aae poore raase ||1||",
      "translation": "their affairs are perfectly resolved. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਮਨ ਨਾਮੁ ਸਮੑਾਲਿ ॥",
      "transliteration": "sadaa sadaa man naam samhaal ||",
      "translation": "O my mind, dwell on the Lord, forever and ever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕੀ ਸੇਵਾ ਪਾਇਆ ਐਥੈ ਓਥੈ ਨਿਬਹੈ ਨਾਲਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur poore kee sevaa paaiaa aithai othai nibahai naal ||1|| rahaau ||",
      "translation": "Serving the Perfect Guru, I have obtained it. It shall stay with me both here and hereafter. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਦੁਖੁ ਭੰਨਾ ਭੈ ਭੰਜਨਹਾਰ ॥",
      "transliteration": "dukh bha(n)naa bhai bha(n)janahaar ||",
      "translation": "He is the Destroyer of pain, the Eradicator of fear.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਆਪਣਿਆ ਜੀਆ ਕੀ ਕੀਤੀ ਸਾਰ ॥",
      "transliteration": "aapaniaa jeeaa kee keetee saar ||",
      "translation": "He takes care of His beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਰਾਖਨਹਾਰ ਸਦਾ ਮਿਹਰਵਾਨ ॥",
      "transliteration": "raakhanahaar sadaa miharavaan ||",
      "translation": "The Savior Lord is kind and compassionate forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਜਾਈਐ ਕੁਰਬਾਨ ॥੨॥",
      "transliteration": "sadaa sadaa jaaeeai kurabaan ||2||",
      "translation": "I am a sacrifice to Him, forever and ever. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਕਾਲੁ ਗਵਾਇਆ ਕਰਤੈ ਆਪਿ ॥",
      "transliteration": "kaal gavaaiaa karatai aap ||",
      "translation": "The Creator Himself has eliminated death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਮਨ ਤਿਸ ਨੋ ਜਾਪਿ ॥",
      "transliteration": "sadaa sadaa man tis no jaap ||",
      "translation": "Meditate on Him forever and ever, O my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਦ੍ਰਿਸਟਿ ਧਾਰਿ ਰਾਖੇ ਸਭਿ ਜੰਤ ॥",
      "transliteration": "drisat dhaar raakhe sabh ja(n)t ||",
      "translation": "He watches all with His Glance of Grace and protects them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਣ ਗਾਵਹੁ ਨਿਤ ਨਿਤ ਭਗਵੰਤ ॥੩॥",
      "transliteration": "gun gaavahu nit nit bhagava(n)t ||3||",
      "translation": "Continually and continuously, sing the Glorious Praises of the Lord God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਏਕੋ ਕਰਤਾ ਆਪੇ ਆਪ ॥",
      "transliteration": "eko karataa aape aap ||",
      "translation": "The One and Only Creator Lord is Himself by Himself.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਹਰਿ ਕੇ ਭਗਤ ਜਾਣਹਿ ਪਰਤਾਪ ॥",
      "transliteration": "har ke bhagat jaanahi parataap ||",
      "translation": "The Lord's devotees know His Glorious Grandeur.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਨਾਵੈ ਕੀ ਪੈਜ ਰਖਦਾ ਆਇਆ ॥",
      "transliteration": "naavai kee paij rakhadaa aaiaa ||",
      "translation": "He preserves the Honor of His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਾਨਕੁ ਬੋਲੈ ਤਿਸ ਕਾ ਬੋਲਾਇਆ ॥੪॥੩॥੨੧॥",
      "transliteration": "naanak bolai tis kaa bolaaiaa ||4||3||21||",
      "translation": "Nanak speaks as the Lord inspires him to speak. ||4||3||21||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੫ ॥",
      "transliteration": "malaar mahalaa 5 ||",
      "translation": "Malaar, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰ ਸਰਣਾਈ ਸਗਲ ਨਿਧਾਨ ॥",
      "transliteration": "gur saranaaee sagal nidhaan ||",
      "translation": "All treasures are found in the Sanctuary of the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਸਾਚੀ ਦਰਗਹਿ ਪਾਈਐ ਮਾਨੁ ॥",
      "transliteration": "saachee daragahi paaeeai maan ||",
      "translation": "Honor is obtained in the True Court of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭ੍ਰਮੁ ਭਉ ਦੂਖੁ ਦਰਦੁ ਸਭੁ ਜਾਇ ॥",
      "transliteration": "bhram bhau dookh darad sabh jaai ||",
      "translation": "Doubt, fear, pain and suffering are taken away,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਸਦ ਹਰਿ ਗੁਣ ਗਾਇ ॥੧॥",
      "transliteration": "saadhasa(n)g sad har gun gaai ||1||",
      "translation": "forever singing the Glorious Praises of the Lord in the Saadh Sangat, the Company of the Holy. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਨ ਮੇਰੇ ਗੁਰੁ ਪੂਰਾ ਸਾਲਾਹਿ ॥",
      "transliteration": "man mere gur pooraa saalaahi ||",
      "translation": "O my mind, praise the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਨਾਮੁ ਨਿਧਾਨੁ ਜਪਹੁ ਦਿਨੁ ਰਾਤੀ ਮਨ ਚਿੰਦੇ ਫਲ ਪਾਇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "naam nidhaan japahu din raatee man chi(n)de phal paai ||1|| rahaau ||",
      "translation": "Chant the treasure of the Naam, the Name of the Lord, day and night. You shall obtain the fruits of your mind's desires. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਤਿਗੁਰ ਜੇਵਡੁ ਅਵਰੁ ਨ ਕੋਇ ॥",
      "transliteration": "satigur jevad avar na koi ||",
      "translation": "No one else is as great as the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗੁਰੁ ਪਾਰਬ੍ਰਹਮੁ ਪਰਮੇਸਰੁ ਸੋਇ ॥",
      "transliteration": "gur paarabraham paramesar soi ||",
      "translation": "The Guru is the Supreme Lord, the Transcendent Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਨਮ ਮਰਣ ਦੂਖ ਤੇ ਰਾਖੈ ॥",
      "transliteration": "janam maran dookh te raakhai ||",
      "translation": "He saves us from the pains of death and birth,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਮਾਇਆ ਬਿਖੁ ਫਿਰਿ ਬਹੁੜਿ ਨ ਚਾਖੈ ॥੨॥",
      "transliteration": "maaiaa bikh phir bahuR na chaakhai ||2||",
      "translation": "and we will not have to taste the poison of Maya ever again. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰ ਕੀ ਮਹਿਮਾ ਕਥਨੁ ਨ ਜਾਇ ॥",
      "transliteration": "gur kee mahimaa kathan na jaai ||",
      "translation": "The Guru's glorious grandeur cannot be described.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਗੁਰੁ ਪਰਮੇਸਰੁ ਸਾਚੈ ਨਾਇ ॥",
      "transliteration": "gur paramesar saachai naai ||",
      "translation": "The Guru is the Transcendent Lord, in the True Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਚੁ ਸੰਜਮੁ ਕਰਣੀ ਸਭੁ ਸਾਚੀ ॥",
      "transliteration": "sach sa(n)jam karanee sabh saachee ||",
      "translation": "True is His self-discipline, and True are all His actions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸੋ ਮਨੁ ਨਿਰਮਲੁ ਜੋ ਗੁਰ ਸੰਗਿ ਰਾਚੀ ॥੩॥",
      "transliteration": "so man niramal jo gur sa(n)g raachee ||3||",
      "translation": "Immaculate and pure is that mind, which is imbued with love for the Guru. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰੁ ਪੂਰਾ ਪਾਈਐ ਵਡ ਭਾਗਿ ॥",
      "transliteration": "gur pooraa paaeeai vad bhaag ||",
      "translation": "The Perfect Guru is obtained by great good fortune.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਕਾਮੁ ਕ੍ਰੋਧੁ ਲੋਭੁ ਮਨ ਤੇ ਤਿਆਗਿ ॥",
      "transliteration": "kaam krodh lobh man te tiaag ||",
      "translation": "Drive out sexual desire, anger and greed from your mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਗੁਰ ਚਰਣ ਨਿਵਾਸਿ ॥",
      "transliteration": "kar kirapaa gur charan nivaas ||",
      "translation": "By His Grace, the Guru's Feet are enshrined within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਨਾਨਕ ਕੀ ਪ੍ਰਭ ਸਚੁ ਅਰਦਾਸਿ ॥੪॥੪॥੨੨॥",
      "transliteration": "naanak kee prabh sach aradaas ||4||4||22||",
      "translation": "Nanak offers his prayer to the True Lord God. ||4||4||22||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਰਾਗੁ ਮਲਾਰ ਮਹਲਾ ੫ ਪੜਤਾਲ ਘਰੁ ੩ ॥",
      "transliteration": "raag malaar mahalaa 5 paRataal ghar 3 ||",
      "translation": "Raag Malaar, Fifth Mehl, Partaal, Third House:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਗੁਰ ਮਨਾਰਿ ਪ੍ਰਿਅ ਦਇਆਰ ਸਿਉ ਰੰਗੁ ਕੀਆ ॥",
      "transliteration": "gur manaar pri daiaar siu ra(n)g keeaa ||",
      "translation": "Pleasing the Guru, I have fallen in love with my Merciful Beloved Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਕੀਨੋ ਰੀ ਸਗਲ ਸਂੀਗਾਰ ॥",
      "transliteration": "keeno ree sagal sa(n)eegaar ||",
      "translation": "I have made all my decorations,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਤਜਿਓ ਰੀ ਸਗਲ ਬਿਕਾਰ ॥",
      "transliteration": "tajio ree sagal bikaar ||",
      "translation": "and renounced all corruption;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਧਾਵਤੋ ਅਸਥਿਰੁ ਥੀਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dhaavato asathir theeaa ||1|| rahaau ||",
      "translation": "my wandering mind has become steady and stable. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਐਸੇ ਰੇ ਮਨ ਪਾਇ ਕੈ ਆਪੁ ਗਵਾਇ ਕੈ ਕਰਿ ਸਾਧਨ ਸਿਉ ਸੰਗੁ ॥",
      "transliteration": "aise re man paai kai aap gavaai kai kar saadhan siu sa(n)g ||",
      "translation": "O my mind, lose your self-conceit by associating with the Holy, and you shall find Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਾਜੇ ਬਜਹਿ ਮ੍ਰਿਦੰਗ ਅਨਾਹਦ ਕੋਕਿਲ ਰੀ ਰਾਮ ਨਾਮੁ ਬੋਲੈ ਮਧੁਰ ਬੈਨ ਅਤਿ ਸੁਹੀਆ ॥੧॥",
      "transliteration": "baaje bajahi mrida(n)g anaahad kokil ree raam naam bolai madhur bain at suheeaa ||1||",
      "translation": "The unstruck celestial melody vibrates and resounds; like a song-bird, chant the Lord's Name, with words of sweetness and utter beauty. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਐਸੀ ਤੇਰੇ ਦਰਸਨ ਕੀ ਸੋਭ ਅਤਿ ਅਪਾਰ ਪ੍ਰਿਅ ਅਮੋਘ ਤੈਸੇ ਹੀ ਸੰਗਿ ਸੰਤ ਬਨੇ ॥",
      "transliteration": "aisee tere darasan kee sobh at apaar pri amogh taise hee sa(n)g sa(n)t bane ||",
      "translation": "Such is the glory of Your Darshan, so utterly inifinte and fruitful, O my Love; so do we become by associating with the Saints.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਭਵ ਉਤਾਰ ਨਾਮ ਭਨੇ ॥",
      "transliteration": "bhav utaar naam bhane ||",
      "translation": "Vibrating, chanting Your Name, we cross over the terrifying world-ocean.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1271_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਰਮ ਰਾਮ ਰਾਮ ਮਾਲ ॥",
      "transliteration": "ram raam raam maal ||",
      "translation": "They dwell on the Lord, Raam, Raam, chanting on their malas;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1271,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
