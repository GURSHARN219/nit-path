{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1272,
  "lineCount": 49,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1272_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਨਿ ਫੇਰਤੇ ਹਰਿ ਸੰਗਿ ਸੰਗੀਆ ॥",
      "transliteration": "man pherate har sa(n)g sa(n)geeaa ||",
      "translation": "their minds are turned towards the Lord in the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਪ੍ਰਿਉ ਪ੍ਰੀਤਮੁ ਥੀਆ ॥੨॥੧॥੨੩॥",
      "transliteration": "jan naanak priu preetam theeaa ||2||1||23||",
      "translation": "O servant Nanak, their Beloved Lord seems so sweet to them. ||2||1||23||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੫ ॥",
      "transliteration": "malaar mahalaa 5 ||",
      "translation": "Malaar, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਮਨੁ ਘਨੈ ਭ੍ਰਮੈ ਬਨੈ ॥",
      "transliteration": "man ghanai bhramai banai ||",
      "translation": "My mind wanders through the dense forest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਉਮਕਿ ਤਰਸਿ ਚਾਲੈ ॥",
      "transliteration": "umak taras chaalai ||",
      "translation": "It walks with eagerness and love,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪ੍ਰਭ ਮਿਲਬੇ ਕੀ ਚਾਹ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "prabh milabe kee chaah ||1|| rahaau ||",
      "translation": "hoping to meet God. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਤ੍ਰੈ ਗੁਨ ਮਾਈ ਮੋਹਿ ਆਈ ਕਹੰਉ ਬੇਦਨ ਕਾਹਿ ॥੧॥",
      "transliteration": "trai gun maaee mohi aaee kaha(n)u bedan kaahi ||1||",
      "translation": "Maya with her three gunas - the three dispositions - has come to entice me; whom can I tell of my pain? ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਨ ਉਪਾਵ ਸਗਰ ਕੀਏ ਨਹਿ ਦੂਖ ਸਾਕਹਿ ਲਾਹਿ ॥",
      "transliteration": "aan upaav sagar keee nahi dookh saakahi laahi ||",
      "translation": "I tried everything else, but nothing could rid me of my sorrow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਭਜੁ ਸਰਨਿ ਸਾਧੂ ਨਾਨਕਾ ਮਿਲੁ ਗੁਨ ਗੋਬਿੰਦਹਿ ਗਾਹਿ ॥੨॥੨॥੨੪॥",
      "transliteration": "bhaj saran saadhoo naanakaa mil gun gobi(n)dahi gaahi ||2||2||24||",
      "translation": "So hurry to the Sanctuary of the Holy, O Nanak; joining them, sing the Glorious Praises of the Lord of the Universe. ||2||2||24||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੫ ॥",
      "transliteration": "malaar mahalaa 5 ||",
      "translation": "Malaar, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਪ੍ਰਿਅ ਕੀ ਸੋਭ ਸੁਹਾਵਨੀ ਨੀਕੀ ॥",
      "transliteration": "pri kee sobh suhaavanee neekee ||",
      "translation": "The glory of my Beloved is noble and sublime.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਹਾਹਾ ਹੂਹੂ ਗੰਧ੍ਰਬ ਅਪਸਰਾ ਅਨੰਦ ਮੰਗਲ ਰਸ ਗਾਵਨੀ ਨੀਕੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "haahaa hoohoo ga(n)dhrab apasaraa ana(n)d ma(n)gal ras gaavanee neekee ||1|| rahaau ||",
      "translation": "The celestial singers and angels sing His Sublime Praises in ecstasy, happiness and joy. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਧੁਨਿਤ ਲਲਿਤ ਗੁਨਗੵ ਅਨਿਕ ਭਾਂਤਿ ਬਹੁ ਬਿਧਿ ਰੂਪ ਦਿਖਾਵਨੀ ਨੀਕੀ ॥੧॥",
      "transliteration": "dhunit lalit gunagy anik bhaa(n)t bahu bidh roop dikhaavanee neekee ||1||",
      "translation": "The most worthy beings sing God's Praises in beautiful harmonies, in all sorts of ways, in myriads of sublime forms. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਗਿਰਿ ਤਰ ਥਲ ਜਲ ਭਵਨ ਭਰਪੁਰਿ ਘਟਿ ਘਟਿ ਲਾਲਨ ਛਾਵਨੀ ਨੀਕੀ ॥",
      "transliteration": "gir tar thal jal bhavan bharapur ghat ghat laalan chhaavanee neekee ||",
      "translation": "Throughout the mountains, trees, deserts, oceans and galaxies, permeating each and every heart, the sublime grandeur of my Love is totally pervading.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਰਾਮਈਆ ਰਸੁ ਪਾਇਓ ਨਾਨਕ ਜਾ ਕੈ ਭਾਵਨੀ ਨੀਕੀ ॥੨॥੩॥੨੫॥",
      "transliteration": "saadhasa(n)g raamaeeaa ras paaio naanak jaa kai bhaavanee neekee ||2||3||25||",
      "translation": "In the Saadh Sangat, the Company of the Holy, the Love of the Lord is found; O Nanak, sublime is that faith. ||2||3||25||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੫ ॥",
      "transliteration": "malaar mahalaa 5 ||",
      "translation": "Malaar, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਗੁਰ ਪ੍ਰੀਤਿ ਪਿਆਰੇ ਚਰਨ ਕਮਲ ਰਿਦ ਅੰਤਰਿ ਧਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur preet piaare charan kamal rid a(n)tar dhaare ||1|| rahaau ||",
      "translation": "With love for the Guru, I enshrine the Lotus Feet of my Lord deep within my heart. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਦਰਸੁ ਸਫਲਿਓ ਦਰਸੁ ਪੇਖਿਓ ਗਏ ਕਿਲਬਿਖ ਗਏ ॥",
      "transliteration": "daras saphalio daras pekhio gae kilabikh gae ||",
      "translation": "I gaze on the Blessed Vision of His Fruitful Darshan; my sins are erased and taken away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਮਨ ਨਿਰਮਲ ਉਜੀਆਰੇ ॥੧॥",
      "transliteration": "man niramal ujeeaare ||1||",
      "translation": "My mind is immaculate and enlightened. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਬਿਸਮ ਬਿਸਮੈ ਬਿਸਮ ਭਈ ॥",
      "transliteration": "bisam bisamai bisam bhaee ||",
      "translation": "I am wonderstruck, stunned and amazed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਅਘ ਕੋਟਿ ਹਰਤੇ ਨਾਮ ਲਈ ॥",
      "transliteration": "agh kot harate naam laee ||",
      "translation": "Chanting the Naam, the Name of the Lord, millions of sins are destroyed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਗੁਰ ਚਰਨ ਮਸਤਕੁ ਡਾਰਿ ਪਹੀ ॥",
      "transliteration": "gur charan masatak daar pahee ||",
      "translation": "I fall at His Feet, and touch my forehead to them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਪ੍ਰਭ ਏਕ ਤੂੰਹੀ ਏਕ ਤੁਹੀ ॥",
      "transliteration": "prabh ek too(n)hee ek tuhee ||",
      "translation": "You alone are, You alone are, O God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਭਗਤ ਟੇਕ ਤੁਹਾਰੇ ॥",
      "transliteration": "bhagat tek tuhaare ||",
      "translation": "Your devotees take Your Support.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਸਰਨਿ ਦੁਆਰੇ ॥੨॥੪॥੨੬॥",
      "transliteration": "jan naanak saran duaare ||2||4||26||",
      "translation": "Servant Nanak has come to the Door of Your Sanctuary. ||2||4||26||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੫ ॥",
      "transliteration": "malaar mahalaa 5 ||",
      "translation": "Malaar, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਰਸੁ ਸਰਸੁ ਆਗਿਆ ॥",
      "transliteration": "baras saras aagiaa ||",
      "translation": "Rain down with happiness in God's Will.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਹੋਹਿ ਆਨੰਦ ਸਗਲ ਭਾਗ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "hohi aana(n)d sagal bhaag ||1|| rahaau ||",
      "translation": "Bless me with total bliss and good fortune. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੰਤ ਸੰਗੇ ਮਨੁ ਪਰਫੜੈ ਮਿਲਿ ਮੇਘ ਧਰ ਸੁਹਾਗ ॥੧॥",
      "transliteration": "sa(n)t sa(n)ge man paraphaRai mil megh dhar suhaag ||1||",
      "translation": "My mind blossoms forth in the Society of the Saints; soaking up the rain, the earth is blessed and beautified. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਘਨਘੋਰ ਪ੍ਰੀਤਿ ਮੋਰ ॥",
      "transliteration": "ghanaghor preet mor ||",
      "translation": "The peacock loves the thunder of the rain clouds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਚਿਤੁ ਚਾਤ੍ਰਿਕ ਬੂੰਦ ਓਰ ॥",
      "transliteration": "chit chaatrik boo(n)d or ||",
      "translation": "The rainbird's mind is drawn to the rain-drop",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਐਸੋ ਹਰਿ ਸੰਗੇ ਮਨ ਮੋਹ ॥",
      "transliteration": "aiso har sa(n)ge man moh ||",
      "translation": "- so is my mind enticed by the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਿਆਗਿ ਮਾਇਆ ਧੋਹ ॥",
      "transliteration": "tiaag maaiaa dhoh ||",
      "translation": "I have renounced Maya, the deceiver.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਮਿਲਿ ਸੰਤ ਨਾਨਕ ਜਾਗਿਆ ॥੨॥੫॥੨੭॥",
      "transliteration": "mil sa(n)t naanak jaagiaa ||2||5||27||",
      "translation": "Joining with the Saints, Nanak is awakened. ||2||5||27||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੫ ॥",
      "transliteration": "malaar mahalaa 5 ||",
      "translation": "Malaar, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਨ ਗੋੁਪਾਲ ਗਾਉ ਨੀਤ ॥",
      "transliteration": "gun goupaal gaau neet ||",
      "translation": "Sing forever the Glorious Praises of the Lord of the World.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਧਾਰਿ ਚੀਤ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "raam naam dhaar cheet ||1|| rahaau ||",
      "translation": "Enshrine the Lord's Name in your consciousness. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਛੋਡਿ ਮਾਨੁ ਤਜਿ ਗੁਮਾਨੁ ਮਿਲਿ ਸਾਧੂਆ ਕੈ ਸੰਗਿ ॥",
      "transliteration": "chhod maan taj gumaan mil saadhooaa kai sa(n)g ||",
      "translation": "Forsake your pride, and abandon your ego; join the Saadh Sangat, the Company of the Holy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਿ ਏਕ ਰੰਗਿ ਮਿਟਿ ਜਾਂਹਿ ਦੋਖ ਮੀਤ ॥੧॥",
      "transliteration": "har simar ek ra(n)g mit jaa(n)hi dokh meet ||1||",
      "translation": "Meditate in loving remembrance on the One Lord; your sorrows shall be ended, O friend. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਭਏ ਦਇਆਲ ॥",
      "transliteration": "paarabraham bhae daiaal ||",
      "translation": "The Supreme Lord God has become merciful;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਬਿਨਸਿ ਗਏ ਬਿਖੈ ਜੰਜਾਲ ॥",
      "transliteration": "binas gae bikhai ja(n)jaal ||",
      "translation": "corrupt entanglements have come to an end.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸਾਧ ਜਨਾਂ ਕੈ ਚਰਨ ਲਾਗਿ ॥",
      "transliteration": "saadh janaa(n) kai charan laag ||",
      "translation": "Grasping the feet of the Holy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਨਾਨਕ ਗਾਵੈ ਗੋਬਿੰਦ ਨੀਤ ॥੨॥੬॥੨੮॥",
      "transliteration": "naanak gaavai gobi(n)d neet ||2||6||28||",
      "translation": "Nanak sings forever the Glorious Praises of the Lord of the World. ||2||6||28||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਮਲਾਰ ਮਹਲਾ ੫ ॥",
      "transliteration": "malaar mahalaa 5 ||",
      "translation": "Malaar, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਘਨੁ ਗਰਜਤ ਗੋਬਿੰਦ ਰੂਪ ॥",
      "transliteration": "ghan garajat gobi(n)d roop ||",
      "translation": "The Embodiment of the Lord of the Universe roars like the thunder-cloud.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਗੁਨ ਗਾਵਤ ਸੁਖ ਚੈਨ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gun gaavat sukh chain ||1|| rahaau ||",
      "translation": "Singing His Glorious Praises brings peace and bliss. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਹਰਿ ਚਰਨ ਸਰਨ ਤਰਨ ਸਾਗਰ ਧੁਨਿ ਅਨਹਤਾ ਰਸ ਬੈਨ ॥੧॥",
      "transliteration": "har charan saran taran saagar dhun anahataa ras bain ||1||",
      "translation": "The Sanctuary of the Lord's Feet carries us across the world-ocean. His Sublime Word is the unstruck celestial melody. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪਥਿਕ ਪਿਆਸ ਚਿਤ ਸਰੋਵਰ ਆਤਮ ਜਲੁ ਲੈਨ ॥",
      "transliteration": "pathik piaas chit sarovar aatam jal lain ||",
      "translation": "The thirsty traveller's consciousness obtains the water of the soul from the pool of nectar.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1272_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਹਰਿ ਦਰਸ ਪ੍ਰੇਮ ਜਨ ਨਾਨਕ ਕਰਿ ਕਿਰਪਾ ਪ੍ਰਭ ਦੈਨ ॥੨॥੭॥੨੯॥",
      "transliteration": "har daras prem jan naanak kar kirapaa prabh dain ||2||7||29||",
      "translation": "Servant Nanak loves the Blessed Vision of the Lord; in His Mercy, God has blessed him with it. ||2||7||29||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1272,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
