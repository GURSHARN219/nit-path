{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1338,
  "lineCount": 51,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1338_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਕਿਰਤ ਸੰਜੋਗੀ ਪਾਇਆ ਭਾਲਿ ॥",
      "transliteration": "kirat sa(n)jogee paaiaa bhaal ||",
      "translation": "By pre-ordained destiny, I have searched and found God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਮਹਿ ਬਸੇ ਗੁਪਾਲ ॥",
      "transliteration": "saadhasa(n)gat mahi base gupaal ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, the Lord of the World abides.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਗੁਰ ਮਿਲਿ ਆਏ ਤੁਮਰੈ ਦੁਆਰ ॥",
      "transliteration": "gur mil aae tumarai duaar ||",
      "translation": "Meeting with the Guru, I have come to Your Door.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਜਨ ਨਾਨਕ ਦਰਸਨੁ ਦੇਹੁ ਮੁਰਾਰਿ ॥੪॥੧॥",
      "transliteration": "jan naanak darasan dehu muraar ||4||1||",
      "translation": "O Lord, please bless servant Nanak with the Blessed Vision of Your Darshan. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "prabhaatee mahalaa 5 ||",
      "translation": "Prabhaatee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਸੇਵਾ ਜਨ ਕੀ ਸੋਭਾ ॥",
      "transliteration": "prabh kee sevaa jan kee sobhaa ||",
      "translation": "Serving God, His humble servant is glorified.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਮਿਟੇ ਤਿਸੁ ਲੋਭਾ ॥",
      "transliteration": "kaam krodh mite tis lobhaa ||",
      "translation": "Unfulfilled sexual desire, unresolved anger and unsatisfied greed are eradicated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਨਾਮੁ ਤੇਰਾ ਜਨ ਕੈ ਭੰਡਾਰਿ ॥",
      "transliteration": "naam teraa jan kai bha(n)daar ||",
      "translation": "Your Name is the treasure of Your humble servant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਗੁਨ ਗਾਵਹਿ ਪ੍ਰਭ ਦਰਸ ਪਿਆਰਿ ॥੧॥",
      "transliteration": "gun gaavahi prabh daras piaar ||1||",
      "translation": "Singing His Praises, I am in love with the Blessed Vision of God's Darshan. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਤੁਮਰੀ ਭਗਤਿ ਪ੍ਰਭ ਤੁਮਹਿ ਜਨਾਈ ॥",
      "transliteration": "tumaree bhagat prabh tumahi janaaee ||",
      "translation": "You are known, O God, by Your devotees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਕਾਟਿ ਜੇਵਰੀ ਜਨ ਲੀਏ ਛਡਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kaat jevaree jan leee chhadaaee ||1|| rahaau ||",
      "translation": "Breaking their bonds, You emancipate them. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜੋ ਜਨੁ ਰਾਤਾ ਪ੍ਰਭ ਕੈ ਰੰਗਿ ॥",
      "transliteration": "jo jan raataa prabh kai ra(n)g ||",
      "translation": "Those humble beings who are imbued with God's Love",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਤਿਨਿ ਸੁਖੁ ਪਾਇਆ ਪ੍ਰਭ ਕੈ ਸੰਗਿ ॥",
      "transliteration": "tin sukh paaiaa prabh kai sa(n)g ||",
      "translation": "find peace in God's Congregation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜਿਸੁ ਰਸੁ ਆਇਆ ਸੋਈ ਜਾਨੈ ॥",
      "transliteration": "jis ras aaiaa soee jaanai ||",
      "translation": "They alone understand this, to whom this subtle essence comes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪੇਖਿ ਪੇਖਿ ਮਨ ਮਹਿ ਹੈਰਾਨੈ ॥੨॥",
      "transliteration": "pekh pekh man mahi hairaanai ||2||",
      "translation": "Beholding it, and gazing upon it, in their minds they are wonderstruck. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸੋ ਸੁਖੀਆ ਸਭ ਤੇ ਊਤਮੁ ਸੋਇ ॥",
      "transliteration": "so sukheeaa sabh te ootam soi ||",
      "translation": "They are at peace, the most exalted of all,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਾ ਕੈ ਹ੍ਰਿਦੈ ਵਸਿਆ ਪ੍ਰਭੁ ਸੋਇ ॥",
      "transliteration": "jaa kai hridai vasiaa prabh soi ||",
      "translation": "within whose hearts God dwells.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਸੋਈ ਨਿਹਚਲੁ ਆਵੈ ਨ ਜਾਇ ॥",
      "transliteration": "soee nihachal aavai na jaai ||",
      "translation": "They are stable and unchanging; they do not come and go in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਨਦਿਨੁ ਪ੍ਰਭ ਕੇ ਹਰਿ ਗੁਣ ਗਾਇ ॥੩॥",
      "transliteration": "anadin prabh ke har gun gaai ||3||",
      "translation": "Night and day, they sing the Glorious Praises of the Lord God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਤਾ ਕਉ ਕਰਹੁ ਸਗਲ ਨਮਸਕਾਰੁ ॥",
      "transliteration": "taa kau karahu sagal namasakaar ||",
      "translation": "All bow down in humble respect to those",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਾ ਕੈ ਮਨਿ ਪੂਰਨੁ ਨਿਰੰਕਾਰੁ ॥",
      "transliteration": "jaa kai man pooran nira(n)kaar ||",
      "translation": "whose minds are filled with the Formless Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਮੋਹਿ ਠਾਕੁਰ ਦੇਵਾ ॥",
      "transliteration": "kar kirapaa mohi thaakur devaa ||",
      "translation": "Show mercy unto me, O my Divine Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਨਕੁ ਉਧਰੈ ਜਨ ਕੀ ਸੇਵਾ ॥੪॥੨॥",
      "transliteration": "naanak udharai jan kee sevaa ||4||2||",
      "translation": "May Nanak be saved, by serving these humble beings. ||4||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "prabhaatee mahalaa 5 ||",
      "translation": "Prabhaatee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਨ ਗਾਵਤ ਮਨਿ ਹੋਇ ਅਨੰਦ ॥",
      "transliteration": "gun gaavat man hoi ana(n)d ||",
      "translation": "Singing His Glorious Praises, the mind is in ecstasy.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਆਠ ਪਹਰ ਸਿਮਰਉ ਭਗਵੰਤ ॥",
      "transliteration": "aath pahar simarau bhagava(n)t ||",
      "translation": "Twenty-four hours a day, I meditate in remembrance on God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਜਾ ਕੈ ਸਿਮਰਨਿ ਕਲਮਲ ਜਾਹਿ ॥",
      "transliteration": "jaa kai simaran kalamal jaahi ||",
      "translation": "Remembering Him in meditation, the sins go away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਤਿਸੁ ਗੁਰ ਕੀ ਹਮ ਚਰਨੀ ਪਾਹਿ ॥੧॥",
      "transliteration": "tis gur kee ham charanee paahi ||1||",
      "translation": "I fall at the Feet of that Guru. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਸੁਮਤਿ ਦੇਵਹੁ ਸੰਤ ਪਿਆਰੇ ॥",
      "transliteration": "sumat devahu sa(n)t piaare ||",
      "translation": "O beloved Saints, please bless me with wisdom;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਸਿਮਰਉ ਨਾਮੁ ਮੋਹਿ ਨਿਸਤਾਰੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "simarau naam mohi nisataare ||1|| rahaau ||",
      "translation": "let me meditate on the Naam, the Name of the Lord, and be emancipated. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਨਿ ਗੁਰਿ ਕਹਿਆ ਮਾਰਗੁ ਸੀਧਾ ॥",
      "transliteration": "jin gur kahiaa maarag seedhaa ||",
      "translation": "The Guru has shown me the straight path;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਗਲ ਤਿਆਗਿ ਨਾਮਿ ਹਰਿ ਗੀਧਾ ॥",
      "transliteration": "sagal tiaag naam har geedhaa ||",
      "translation": "I have abandoned everything else. I am enraptured with the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਤਿਸੁ ਗੁਰ ਕੈ ਸਦਾ ਬਲਿ ਜਾਈਐ ॥",
      "transliteration": "tis gur kai sadaa bal jaaeeai ||",
      "translation": "I am forever a sacrifice to that Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਰਿ ਸਿਮਰਨੁ ਜਿਸੁ ਗੁਰ ਤੇ ਪਾਈਐ ॥੨॥",
      "transliteration": "har simaran jis gur te paaeeai ||2||",
      "translation": "I meditate in remembrance on the Lord, through the Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਬੂਡਤ ਪ੍ਰਾਨੀ ਜਿਨਿ ਗੁਰਹਿ ਤਰਾਇਆ ॥",
      "transliteration": "boodat praanee jin gurahi taraaiaa ||",
      "translation": "The Guru carries those mortal beings across, and saves them from drowning.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਸੁ ਪ੍ਰਸਾਦਿ ਮੋਹੈ ਨਹੀ ਮਾਇਆ ॥",
      "transliteration": "jis prasaad mohai nahee maaiaa ||",
      "translation": "By His Grace, they are not enticed by Maya;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਹਲਤੁ ਪਲਤੁ ਜਿਨਿ ਗੁਰਹਿ ਸਵਾਰਿਆ ॥",
      "transliteration": "halat palat jin gurahi savaariaa ||",
      "translation": "in this world and the next, they are embellished and exalted by the Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਤਿਸੁ ਗੁਰ ਊਪਰਿ ਸਦਾ ਹਉ ਵਾਰਿਆ ॥੩॥",
      "transliteration": "tis gur oopar sadaa hau vaariaa ||3||",
      "translation": "I am forever a sacrifice to that Guru. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਮਹਾ ਮੁਗਧ ਤੇ ਕੀਆ ਗਿਆਨੀ ॥",
      "transliteration": "mahaa mugadh te keeaa giaanee ||",
      "translation": "From the most ignorant, I have been made spiritually wise,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਰ ਪੂਰੇ ਕੀ ਅਕਥ ਕਹਾਨੀ ॥",
      "transliteration": "gur poore kee akath kahaanee ||",
      "translation": "through the Unspoken Speech of the Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮ ਨਾਨਕ ਗੁਰਦੇਵ ॥",
      "transliteration": "paarabraham naanak guradev ||",
      "translation": "The Divine Guru, O Nanak, is the Supreme Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਵਡੈ ਭਾਗਿ ਪਾਈਐ ਹਰਿ ਸੇਵ ॥੪॥੩॥",
      "transliteration": "vadai bhaag paaeeai har sev ||4||3||",
      "translation": "By great good fortune, I serve the Lord. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "prabhaatee mahalaa 5 ||",
      "translation": "Prabhaatee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਗਲੇ ਦੂਖ ਮਿਟੇ ਸੁਖ ਦੀਏ ਅਪਨਾ ਨਾਮੁ ਜਪਾਇਆ ॥",
      "transliteration": "sagale dookh mite sukh deee apanaa naam japaaiaa ||",
      "translation": "Eradicating all my pains, He has blessed me with peace, and inspired me to chant His Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਅਪਨੀ ਸੇਵਾ ਲਾਏ ਸਗਲਾ ਦੁਰਤੁ ਮਿਟਾਇਆ ॥੧॥",
      "transliteration": "kar kirapaa apanee sevaa laae sagalaa durat mitaaiaa ||1||",
      "translation": "In His Mercy, He has enjoined me to His service, and has purged me of all my sins. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਮ ਬਾਰਿਕ ਸਰਨਿ ਪ੍ਰਭ ਦਇਆਲ ॥",
      "transliteration": "ham baarik saran prabh daiaal ||",
      "translation": "I am only a child; I seek the Sanctuary of God the Merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਅਵਗਣ ਕਾਟਿ ਕੀਏ ਪ੍ਰਭਿ ਅਪੁਨੇ ਰਾਖਿ ਲੀਏ ਮੇਰੈ ਗੁਰ ਗੋਪਾਲਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "avagan kaat keee prabh apune raakh leee merai gur gopaal ||1|| rahaau ||",
      "translation": "Erasing my demerits and faults, God has made me His Own. My Guru, the Lord of the World, protects me. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਤਾਪ ਪਾਪ ਬਿਨਸੇ ਖਿਨ ਭੀਤਰਿ ਭਏ ਕ੍ਰਿਪਾਲ ਗੁਸਾਈ ॥",
      "transliteration": "taap paap binase khin bheetar bhae kripaal gusaaee ||",
      "translation": "My sicknesses and sins were erased in an instant, when the Lord of the World became merciful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਸਾਸਿ ਸਾਸਿ ਪਾਰਬ੍ਰਹਮੁ ਅਰਾਧੀ ਅਪੁਨੇ ਸਤਿਗੁਰ ਕੈ ਬਲਿ ਜਾਈ ॥੨॥",
      "transliteration": "saas saas paarabraham araadhee apune satigur kai bal jaaee ||2||",
      "translation": "With each and very breath, I worship and adore the Supreme Lord God; I am a sacrifice to the True Guru. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਅਗਮ ਅਗੋਚਰੁ ਬਿਅੰਤੁ ਸੁਆਮੀ ਤਾ ਕਾ ਅੰਤੁ ਨ ਪਾਈਐ ॥",
      "transliteration": "agam agochar bia(n)t suaamee taa kaa a(n)t na paaeeai ||",
      "translation": "My Lord and Master is Inaccessible, Unfathomable and Infinite. His limits cannot be found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1338_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਲਾਹਾ ਖਾਟਿ ਹੋਈਐ ਧਨਵੰਤਾ ਅਪੁਨਾ ਪ੍ਰਭੂ ਧਿਆਈਐ ॥੩॥",
      "transliteration": "laahaa khaat hoeeai dhanava(n)taa apunaa prabhoo dhiaaeeai ||3||",
      "translation": "We earn the profit, and become wealthy, meditating on our God. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1338,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
