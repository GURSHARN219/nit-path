{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1339,
  "lineCount": 53,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1339_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਆਠ ਪਹਰ ਪਾਰਬ੍ਰਹਮੁ ਧਿਆਈ ਸਦਾ ਸਦਾ ਗੁਨ ਗਾਇਆ ॥",
      "transliteration": "aath pahar paarabraham dhiaaee sadaa sadaa gun gaaiaa ||",
      "translation": "Twenty-four hours a day, I meditate on the Supreme Lord God; I sing His Glorious Praises forever and ever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਮੇਰੇ ਪੂਰੇ ਮਨੋਰਥ ਪਾਰਬ੍ਰਹਮੁ ਗੁਰੁ ਪਾਇਆ ॥੪॥੪॥",
      "transliteration": "kahu naanak mere poore manorath paarabraham gur paaiaa ||4||4||",
      "translation": "Says Nanak, my desires have been fulfilled; I have found my Guru, the Supreme Lord God. ||4||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "prabhaatee mahalaa 5 ||",
      "translation": "Prabhaatee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਸਿਮਰਤ ਨਾਮੁ ਕਿਲਬਿਖ ਸਭਿ ਨਾਸੇ ॥",
      "transliteration": "simarat naam kilabikh sabh naase ||",
      "translation": "Meditating in rememberance on the Naam, all my sins have been erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਸਚੁ ਨਾਮੁ ਗੁਰਿ ਦੀਨੀ ਰਾਸੇ ॥",
      "transliteration": "sach naam gur deenee raase ||",
      "translation": "The Guru has blessed me with the Capital of the True Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪ੍ਰਭ ਕੀ ਦਰਗਹ ਸੋਭਾਵੰਤੇ ॥",
      "transliteration": "prabh kee daragah sobhaava(n)te ||",
      "translation": "God's servants are embellished and exalted in His Court;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸੇਵਕ ਸੇਵਿ ਸਦਾ ਸੋਹੰਤੇ ॥੧॥",
      "transliteration": "sevak sev sadaa soha(n)te ||1||",
      "translation": "serving Him, they look beauteous forever. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਪਹੁ ਮੇਰੇ ਭਾਈ ॥",
      "transliteration": "har har naam japahu mere bhaaee ||",
      "translation": "Chant the Name of the Lord, Har, Har, O my Siblings of Destiny.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਸਗਲੇ ਰੋਗ ਦੋਖ ਸਭਿ ਬਿਨਸਹਿ ਅਗਿਆਨੁ ਅੰਧੇਰਾ ਮਨ ਤੇ ਜਾਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "sagale rog dokh sabh binasahi agiaan a(n)dheraa man te jaaee ||1|| rahaau ||",
      "translation": "All sickness and sin shall be erased; your mind shall be rid of the darkness of ignorance. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਨਮ ਮਰਨ ਗੁਰਿ ਰਾਖੇ ਮੀਤ ॥",
      "transliteration": "janam maran gur raakhe meet ||",
      "translation": "The Guru has saved me from death and rebirth, O friend;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਹਰਿ ਕੇ ਨਾਮ ਸਿਉ ਲਾਗੀ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "har ke naam siu laagee preet ||",
      "translation": "I am in love with the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਕੋਟਿ ਜਨਮ ਕੇ ਗਏ ਕਲੇਸ ॥",
      "transliteration": "kot janam ke gae kales ||",
      "translation": "The suffering of millions of incarnations is gone;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੋ ਤਿਸੁ ਭਾਵੈ ਸੋ ਭਲ ਹੋਸ ॥੨॥",
      "transliteration": "jo tis bhaavai so bhal hos ||2||",
      "translation": "whatever pleases Him is good. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਤਿਸੁ ਗੁਰ ਕਉ ਹਉ ਸਦ ਬਲਿ ਜਾਈ ॥",
      "transliteration": "tis gur kau hau sad bal jaaee ||",
      "translation": "I am forever a sacrifice to the Guru;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜਿਸੁ ਪ੍ਰਸਾਦਿ ਹਰਿ ਨਾਮੁ ਧਿਆਈ ॥",
      "transliteration": "jis prasaad har naam dhiaaee ||",
      "translation": "by His Grace, I meditate on the Lord's Name.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਐਸਾ ਗੁਰੁ ਪਾਈਐ ਵਡਭਾਗੀ ॥",
      "transliteration": "aisaa gur paaeeai vadabhaagee ||",
      "translation": "By great good fortune, such a Guru is found;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਜਿਸੁ ਮਿਲਤੇ ਰਾਮ ਲਿਵ ਲਾਗੀ ॥੩॥",
      "transliteration": "jis milate raam liv laagee ||3||",
      "translation": "meeting Him, one is lovingly attuned to the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਪਾਰਬ੍ਰਹਮ ਸੁਆਮੀ ॥",
      "transliteration": "kar kirapaa paarabraham suaamee ||",
      "translation": "Please be merciful, O Supreme Lord God, O Lord and Master,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਗਲ ਘਟਾ ਕੇ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "sagal ghataa ke a(n)tarajaamee ||",
      "translation": "Inner-knower, Searcher of Hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਆਠ ਪਹਰ ਅਪੁਨੀ ਲਿਵ ਲਾਇ ॥",
      "transliteration": "aath pahar apunee liv laai ||",
      "translation": "Twenty-four hours a day, I am lovingly attuned to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜਨੁ ਨਾਨਕੁ ਪ੍ਰਭ ਕੀ ਸਰਨਾਇ ॥੪॥੫॥",
      "transliteration": "jan naanak prabh kee saranaai ||4||5||",
      "translation": "Servant Nanak has come to the Sanctuary of God. ||4||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "prabhaatee mahalaa 5 ||",
      "translation": "Prabhaatee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਕਰਿ ਕਿਰਪਾ ਅਪੁਨੇ ਪ੍ਰਭਿ ਕੀਏ ॥",
      "transliteration": "kar kirapaa apune prabh keee ||",
      "translation": "In His Mercy, God has made me His Own.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਹਰਿ ਕਾ ਨਾਮੁ ਜਪਨ ਕਉ ਦੀਏ ॥",
      "transliteration": "har kaa naam japan kau deee ||",
      "translation": "He has blessed me with the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਆਠ ਪਹਰ ਗੁਨ ਗਾਇ ਗੁਬਿੰਦ ॥",
      "transliteration": "aath pahar gun gaai gubi(n)d ||",
      "translation": "Twenty-four hours a day, I sing the Glorious Praises of the Lord of the Universe.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਭੈ ਬਿਨਸੇ ਉਤਰੀ ਸਭ ਚਿੰਦ ॥੧॥",
      "transliteration": "bhai binase utaree sabh chi(n)d ||1||",
      "translation": "Fear is dispelled, and all anxiety has been alleviated. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਉਬਰੇ ਸਤਿਗੁਰ ਚਰਨੀ ਲਾਗਿ ॥",
      "transliteration": "ubare satigur charanee laag ||",
      "translation": "I have been saved, touching the Feet of the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਜੋ ਗੁਰੁ ਕਹੈ ਸੋਈ ਭਲ ਮੀਠਾ ਮਨ ਕੀ ਮਤਿ ਤਿਆਗਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jo gur kahai soee bhal meethaa man kee mat tiaag ||1|| rahaau ||",
      "translation": "Whatever the Guru says is good and sweet to me. I have renounced the intellectual wisdom of my mind. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਨਿ ਤਨਿ ਵਸਿਆ ਹਰਿ ਪ੍ਰਭੁ ਸੋਈ ॥",
      "transliteration": "man tan vasiaa har prabh soee ||",
      "translation": "That Lord God abides within my mind and body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਲਿ ਕਲੇਸ ਕਿਛੁ ਬਿਘਨੁ ਨ ਹੋਈ ॥",
      "transliteration": "kal kales kichh bighan na hoee ||",
      "translation": "There are no conflicts, pains or obstacles.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਪ੍ਰਭੁ ਜੀਅ ਕੈ ਸੰਗਿ ॥",
      "transliteration": "sadaa sadaa prabh jee kai sa(n)g ||",
      "translation": "Forever and ever, God is with my soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਉਤਰੀ ਮੈਲੁ ਨਾਮ ਕੈ ਰੰਗਿ ॥੨॥",
      "transliteration": "utaree mail naam kai ra(n)g ||2||",
      "translation": "Filth and pollution are washed away by the Love of the Name. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਸਿਉ ਲਾਗੋ ਪਿਆਰੁ ॥",
      "transliteration": "charan kamal siu laago piaar ||",
      "translation": "I am in love with the Lotus Feet of the Lord;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਬਿਨਸੇ ਕਾਮ ਕ੍ਰੋਧ ਅਹੰਕਾਰ ॥",
      "transliteration": "binase kaam krodh aha(n)kaar ||",
      "translation": "I am no longer consumed by sexual desire, anger and egotism.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪ੍ਰਭ ਮਿਲਨ ਕਾ ਮਾਰਗੁ ਜਾਨਾਂ ॥",
      "transliteration": "prabh milan kaa maarag jaanaa(n) ||",
      "translation": "Now, I know the way to meet God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਭਾਇ ਭਗਤਿ ਹਰਿ ਸਿਉ ਮਨੁ ਮਾਨਾਂ ॥੩॥",
      "transliteration": "bhaai bhagat har siu man maanaa(n) ||3||",
      "translation": "Through loving devotional worship, my mind is pleased and appeased with the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਸੁਣਿ ਸਜਣ ਸੰਤ ਮੀਤ ਸੁਹੇਲੇ ॥",
      "transliteration": "sun sajan sa(n)t meet suhele ||",
      "translation": "Listen, O friends, Saints, my exalted companions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਨਾਮੁ ਰਤਨੁ ਹਰਿ ਅਗਹ ਅਤੋਲੇ ॥",
      "transliteration": "naam ratan har agah atole ||",
      "translation": "The Jewel of the Naam, the Name of the Lord, is unfathomable and immeasurable.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਸਦਾ ਸਦਾ ਪ੍ਰਭੁ ਗੁਣ ਨਿਧਿ ਗਾਈਐ ॥",
      "transliteration": "sadaa sadaa prabh gun nidh gaaeeai ||",
      "translation": "Forever and ever, sing the Glories of God, the Treasure of Virtue.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਵਡਭਾਗੀ ਪਾਈਐ ॥੪॥੬॥",
      "transliteration": "kahu naanak vadabhaagee paaeeai ||4||6||",
      "translation": "Says Nanak, by great good fortune, He is found. ||4||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "prabhaatee mahalaa 5 ||",
      "translation": "Prabhaatee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਸੇ ਧਨਵੰਤ ਸੇਈ ਸਚੁ ਸਾਹਾ ॥",
      "transliteration": "se dhanava(n)t seee sach saahaa ||",
      "translation": "They are wealthy, and they are the true merchants,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਹਰਿ ਕੀ ਦਰਗਹ ਨਾਮੁ ਵਿਸਾਹਾ ॥੧॥",
      "transliteration": "har kee daragah naam visaahaa ||1||",
      "translation": "who have the credit of the Naam in the Court of the Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਰਿ ਹਰਿ ਨਾਮੁ ਜਪਹੁ ਮਨ ਮੀਤ ॥",
      "transliteration": "har har naam japahu man meet ||",
      "translation": "So chant the Name of the Lord, Har, Har, in your mind, my friends.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰੁ ਪੂਰਾ ਪਾਈਐ ਵਡਭਾਗੀ ਨਿਰਮਲ ਪੂਰਨ ਰੀਤਿ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur pooraa paaeeai vadabhaagee niramal pooran reet ||1|| rahaau ||",
      "translation": "The Perfect Guru is found by great good fortune, and then one's lifestyle becomes perfect and immaculate. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਪਾਇਆ ਲਾਭੁ ਵਜੀ ਵਾਧਾਈ ॥",
      "transliteration": "paaiaa laabh vajee vaadhaaee ||",
      "translation": "They earn the profit, and the congratulations pour in;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੰਤ ਪ੍ਰਸਾਦਿ ਹਰਿ ਕੇ ਗੁਨ ਗਾਈ ॥੨॥",
      "transliteration": "sa(n)t prasaad har ke gun gaaee ||2||",
      "translation": "by the Grace of the Saints, they sing the Glorious Praises of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸਫਲ ਜਨਮੁ ਜੀਵਨ ਪਰਵਾਣੁ ॥",
      "transliteration": "saphal janam jeevan paravaan ||",
      "translation": "Their lives are fruitful and prosperous, and their birth is approved;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਹਰਿ ਰੰਗੁ ਮਾਣੁ ॥੩॥",
      "transliteration": "gur parasaadee har ra(n)g maan ||3||",
      "translation": "by Guru's Grace, they enjoy the Love of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬਿਨਸੇ ਕਾਮ ਕ੍ਰੋਧ ਅਹੰਕਾਰ ॥",
      "transliteration": "binase kaam krodh aha(n)kaar ||",
      "translation": "Sexuality, anger and egotism are wiped away;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਨਾਨਕ ਗੁਰਮੁਖਿ ਉਤਰਹਿ ਪਾਰਿ ॥੪॥੭॥",
      "transliteration": "naanak guramukh utarahi paar ||4||7||",
      "translation": "O Nanak, as Gurmukh, they are carried across to the other shore. ||4||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "prabhaatee mahalaa 5 ||",
      "translation": "Prabhaatee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1339_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਗੁਰੁ ਪੂਰਾ ਪੂਰੀ ਤਾ ਕੀ ਕਲਾ ॥",
      "transliteration": "gur pooraa pooree taa kee kalaa ||",
      "translation": "The Guru is Perfect, and Perfect is His Power.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1339,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
