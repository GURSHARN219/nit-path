{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1340,
  "lineCount": 55,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1340_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਗੁਰ ਕਾ ਸਬਦੁ ਸਦਾ ਸਦ ਅਟਲਾ ॥",
      "transliteration": "gur kaa sabad sadaa sad atalaa ||",
      "translation": "The Word of the Guru's Shabad is unchanging, forever and ever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਗੁਰ ਕੀ ਬਾਣੀ ਜਿਸੁ ਮਨਿ ਵਸੈ ॥",
      "transliteration": "gur kee baanee jis man vasai ||",
      "translation": "Those, whose minds are filled with the Word of the Guru's Bani,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੂਖੁ ਦਰਦੁ ਸਭੁ ਤਾ ਕਾ ਨਸੈ ॥੧॥",
      "transliteration": "dookh darad sabh taa kaa nasai ||1||",
      "translation": "All pains and afflictions run away from them. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਹਰਿ ਰੰਗਿ ਰਾਤਾ ਮਨੁ ਰਾਮ ਗੁਨ ਗਾਵੈ ॥",
      "transliteration": "har ra(n)g raataa man raam gun gaavai ||",
      "translation": "Imbued with the Lord's Love, they sing the Glorious Praises of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਮੁਕਤੋੁ ਸਾਧੂ ਧੂਰੀ ਨਾਵੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "mukatou saadhoo dhooree naavai ||1|| rahaau ||",
      "translation": "They are liberated, bathing in the dust of the feet of the Holy. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਗੁਰ ਪਰਸਾਦੀ ਉਤਰੇ ਪਾਰਿ ॥",
      "transliteration": "gur parasaadee utare paar ||",
      "translation": "By Guru's Grace, they are carried across to the other shore;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਭਉ ਭਰਮੁ ਬਿਨਸੇ ਬਿਕਾਰ ॥",
      "transliteration": "bhau bharam binase bikaar ||",
      "translation": "they are rid of fear, doubt and corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਮਨ ਤਨ ਅੰਤਰਿ ਬਸੇ ਗੁਰ ਚਰਨਾ ॥",
      "transliteration": "man tan a(n)tar base gur charanaa ||",
      "translation": "The Guru's Feet abide deep within their minds and bodies.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਨਿਰਭੈ ਸਾਧ ਪਰੇ ਹਰਿ ਸਰਨਾ ॥੨॥",
      "transliteration": "nirabhai saadh pare har saranaa ||2||",
      "translation": "The Holy are fearless; they take to the Sanctuary of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਅਨਦ ਸਹਜ ਰਸ ਸੂਖ ਘਨੇਰੇ ॥",
      "transliteration": "anad sahaj ras sookh ghanere ||",
      "translation": "They are blessed with abundant bliss, happiness, pleasure and peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਦੁਸਮਨੁ ਦੂਖੁ ਨ ਆਵੈ ਨੇਰੇ ॥",
      "transliteration": "dusaman dookh na aavai nere ||",
      "translation": "Enemies and pains do not even approach them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਅਪੁਨੇ ਕਰਿ ਰਾਖੇ ॥",
      "transliteration": "gur poorai apune kar raakhe ||",
      "translation": "The Perfect Guru makes them His Own, and protects them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਹਰਿ ਨਾਮੁ ਜਪਤ ਕਿਲਬਿਖ ਸਭਿ ਲਾਥੇ ॥੩॥",
      "transliteration": "har naam japat kilabikh sabh laathe ||3||",
      "translation": "Chanting the Lord's Name, they are rid of all their sins. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸੰਤ ਸਾਜਨ ਸਿਖ ਭਏ ਸੁਹੇਲੇ ॥",
      "transliteration": "sa(n)t saajan sikh bhae suhele ||",
      "translation": "The Saints, spiritual companions and Sikhs are exalted and uplifted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਗੁਰਿ ਪੂਰੈ ਪ੍ਰਭ ਸਿਉ ਲੈ ਮੇਲੇ ॥",
      "transliteration": "gur poorai prabh siu lai mele ||",
      "translation": "The Perfect Guru leads them to meet God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜਨਮ ਮਰਨ ਦੁਖ ਫਾਹਾ ਕਾਟਿਆ ॥",
      "transliteration": "janam maran dukh phaahaa kaatiaa ||",
      "translation": "The painful noose of death and rebirth is snapped.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰਿ ਪੜਦਾ ਢਾਕਿਆ ॥੪॥੮॥",
      "transliteration": "kahu naanak gur paRadaa dhaakiaa ||4||8||",
      "translation": "Says Nanak, the Guru covers their faults. ||4||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "prabhaatee mahalaa 5 ||",
      "translation": "Prabhaatee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਪੂਰੈ ਨਾਮੁ ਦੀਆ ॥",
      "transliteration": "satigur poorai naam deeaa ||",
      "translation": "The Perfect True Guru has bestowed the Naam, the Name of the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਅਨਦ ਮੰਗਲ ਕਲਿਆਣ ਸਦਾ ਸੁਖੁ ਕਾਰਜੁ ਸਗਲਾ ਰਾਸਿ ਥੀਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "anad ma(n)gal kaliaan sadaa sukh kaaraj sagalaa raas theeaa ||1|| rahaau ||",
      "translation": "I am blessed with bliss and happiness, emancipation and eternal peace. All my affairs have been resolved. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਗੁਰ ਕੇ ਮਨਿ ਵੂਠੇ ॥",
      "transliteration": "charan kamal gur ke man voothe ||",
      "translation": "The Lotus Feet of the Guru abide within my mind.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਦੂਖ ਦਰਦ ਭ੍ਰਮ ਬਿਨਸੇ ਝੂਠੇ ॥੧॥",
      "transliteration": "dookh darad bhram binase jhoothe ||1||",
      "translation": "I am rid of pain, suffering, doubt and fraud. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਿਤ ਉਠਿ ਗਾਵਹੁ ਪ੍ਰਭ ਕੀ ਬਾਣੀ ॥",
      "transliteration": "nit uth gaavahu prabh kee baanee ||",
      "translation": "Rise early, and sing the Glorious Word of God's Bani.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਆਠ ਪਹਰ ਹਰਿ ਸਿਮਰਹੁ ਪ੍ਰਾਣੀ ॥੨॥",
      "transliteration": "aath pahar har simarahu praanee ||2||",
      "translation": "Twenty-four hours a day, meditate in remembrance on the Lord, O mortal. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਘਰਿ ਬਾਹਰਿ ਪ੍ਰਭੁ ਸਭਨੀ ਥਾਈ ॥",
      "transliteration": "ghar baahar prabh sabhanee thaaee ||",
      "translation": "Inwardly and outwardly, God is everywhere.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੰਗਿ ਸਹਾਈ ਜਹ ਹਉ ਜਾਈ ॥੩॥",
      "transliteration": "sa(n)g sahaaee jah hau jaaee ||3||",
      "translation": "Wherever I go, He is always with me, my Helper and Support. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਦੁਇ ਕਰ ਜੋੜਿ ਕਰੀ ਅਰਦਾਸਿ ॥",
      "transliteration": "dui kar joR karee aradaas ||",
      "translation": "With my palms pressed together, I offer this prayer.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਦਾ ਜਪੇ ਨਾਨਕੁ ਗੁਣਤਾਸੁ ॥੪॥੯॥",
      "transliteration": "sadaa jape naanak gunataas ||4||9||",
      "translation": "O Nanak, I meditate forever on the Lord, the Treasure of Virtue. ||4||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "prabhaatee mahalaa 5 ||",
      "translation": "Prabhaatee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਪ੍ਰਭੁ ਸੁਘੜ ਸੁਜਾਣੁ ॥",
      "transliteration": "paarabraham prabh sughaR sujaan ||",
      "translation": "The Supreme Lord God is All-wise and All-knowing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਗੁਰੁ ਪੂਰਾ ਪਾਈਐ ਵਡਭਾਗੀ ਦਰਸਨ ਕਉ ਜਾਈਐ ਕੁਰਬਾਣੁ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "gur pooraa paaeeai vadabhaagee darasan kau jaaeeai kurabaan ||1|| rahaau ||",
      "translation": "The Perfect Guru is found by great good fortune. I am a sacrifice to the Blessed Vision of His Darshan. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਿਲਬਿਖ ਮੇਟੇ ਸਬਦਿ ਸੰਤੋਖੁ ॥",
      "transliteration": "kilabikh mete sabad sa(n)tokh ||",
      "translation": "My sins are cut away, through the Word of the Shabad, and I have found contentment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਨਾਮੁ ਅਰਾਧਨ ਹੋਆ ਜੋਗੁ ॥",
      "transliteration": "naam araadhan hoaa jog ||",
      "translation": "I have become worthy of worshipping the Naam in adoration.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਾਧਸੰਗਿ ਹੋਆ ਪਰਗਾਸੁ ॥",
      "transliteration": "saadhasa(n)g hoaa paragaas ||",
      "translation": "In the Saadh Sangat, the Company of the Holy, I have been enlightened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਚਰਨ ਕਮਲ ਮਨ ਮਾਹਿ ਨਿਵਾਸੁ ॥੧॥",
      "transliteration": "charan kamal man maahi nivaas ||1||",
      "translation": "The Lord's Lotus Feet abide within my mind. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਜਿਨਿ ਕੀਆ ਤਿਨਿ ਲੀਆ ਰਾਖਿ ॥",
      "transliteration": "jin keeaa tin leeaa raakh ||",
      "translation": "The One who made us, protects and preserves us.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪ੍ਰਭੁ ਪੂਰਾ ਅਨਾਥ ਕਾ ਨਾਥੁ ॥",
      "transliteration": "prabh pooraa anaath kaa naath ||",
      "translation": "God is Perfect, the Master of the masterless.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਜਿਸਹਿ ਨਿਵਾਜੇ ਕਿਰਪਾ ਧਾਰਿ ॥",
      "transliteration": "jisahi nivaaje kirapaa dhaar ||",
      "translation": "Those, upon whom He showers His Mercy",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪੂਰਨ ਕਰਮ ਤਾ ਕੇ ਆਚਾਰ ॥੨॥",
      "transliteration": "pooran karam taa ke aachaar ||2||",
      "translation": "- they have perfect karma and conduct. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਗੁਣ ਗਾਵੈ ਨਿਤ ਨਿਤ ਨਿਤ ਨਵੇ ॥",
      "transliteration": "gun gaavai nit nit nit nave ||",
      "translation": "They sing the Glories of God, continually, continuously, forever fresh and new.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਲਖ ਚਉਰਾਸੀਹ ਜੋਨਿ ਨ ਭਵੇ ॥",
      "transliteration": "lakh chauraaseeh jon na bhave ||",
      "translation": "They do not wander in the 8.4 million incarnations.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਈਹਾਂ ਊਹਾਂ ਚਰਣ ਪੂਜਾਰੇ ॥",
      "transliteration": "eehaa(n) oohaa(n) charan poojaare ||",
      "translation": "Here and hereafter, they worship the Lord's Feet.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਮੁਖੁ ਊਜਲੁ ਸਾਚੇ ਦਰਬਾਰੇ ॥੩॥",
      "transliteration": "mukh oojal saache darabaare ||3||",
      "translation": "Their faces are radiant, and they are honored in the Court of the Lord. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਸੁ ਮਸਤਕਿ ਗੁਰਿ ਧਰਿਆ ਹਾਥੁ ॥",
      "transliteration": "jis masatak gur dhariaa haath ||",
      "translation": "That person, upon whose forehead the Guru places His Hand",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਕੋਟਿ ਮਧੇ ਕੋ ਵਿਰਲਾ ਦਾਸੁ ॥",
      "transliteration": "kot madhe ko viralaa daas ||",
      "translation": "out of millions, how rare is that slave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਜਲਿ ਥਲਿ ਮਹੀਅਲਿ ਪੇਖੈ ਭਰਪੂਰਿ ॥",
      "transliteration": "jal thal maheeal pekhai bharapoor ||",
      "translation": "He sees God pervading and permeating the water, the land and the sky.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਨਾਨਕ ਉਧਰਸਿ ਤਿਸੁ ਜਨ ਕੀ ਧੂਰਿ ॥੪॥੧੦॥",
      "transliteration": "naanak udharas tis jan kee dhoor ||4||10||",
      "translation": "Nanak is saved by the dust of the feet of such a humble being. ||4||10||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "prabhaatee mahalaa 5 ||",
      "translation": "Prabhaatee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਕੁਰਬਾਣੁ ਜਾਈ ਗੁਰ ਪੂਰੇ ਅਪਨੇ ॥",
      "transliteration": "kurabaan jaaee gur poore apane ||",
      "translation": "I am a sacrifice to my Perfect Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਜਿਸੁ ਪ੍ਰਸਾਦਿ ਹਰਿ ਹਰਿ ਜਪੁ ਜਪਨੇ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jis prasaad har har jap japane ||1|| rahaau ||",
      "translation": "By His Grace, I chant and meditate on the Lord, Har, Har. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਬਾਣੀ ਸੁਣਤ ਨਿਹਾਲ ॥",
      "transliteration": "a(n)mrit baanee sunat nihaal ||",
      "translation": "Listening to the Ambrosial Word of His Bani, I am exalted and enraptured.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਬਿਨਸਿ ਗਏ ਬਿਖਿਆ ਜੰਜਾਲ ॥੧॥",
      "transliteration": "binas gae bikhiaa ja(n)jaal ||1||",
      "translation": "My corrupt and poisonous entanglements are gone. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਸਾਚ ਸਬਦ ਸਿਉ ਲਾਗੀ ਪ੍ਰੀਤਿ ॥",
      "transliteration": "saach sabad siu laagee preet ||",
      "translation": "I am in love with the True Word of His Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਹਰਿ ਪ੍ਰਭੁ ਅਪੁਨਾ ਆਇਆ ਚੀਤਿ ॥੨॥",
      "transliteration": "har prabh apunaa aaiaa cheet ||2||",
      "translation": "The Lord God has come into my consciousness. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1340_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਨਾਮੁ ਜਪਤ ਹੋਆ ਪਰਗਾਸੁ ॥",
      "transliteration": "naam japat hoaa paragaas ||",
      "translation": "Chanting the Naam, I am enlightened.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1340,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
