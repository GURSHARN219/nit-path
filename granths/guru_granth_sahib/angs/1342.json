{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1342,
  "lineCount": 53,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1342_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਅਸਟਪਦੀਆ ਮਹਲਾ ੧ ਬਿਭਾਸ ॥",
      "transliteration": "prabhaatee asatapadeeaa mahalaa 1 bibhaas ||",
      "translation": "Prabhaatee, Ashtpadheeyaa, First Mehl, Bibhaas:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਦੁਬਿਧਾ ਬਉਰੀ ਮਨੁ ਬਉਰਾਇਆ ॥",
      "transliteration": "dubidhaa bauree man bauraaiaa ||",
      "translation": "The insanity of duality has driven the mind insane.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਝੂਠੈ ਲਾਲਚਿ ਜਨਮੁ ਗਵਾਇਆ ॥",
      "transliteration": "jhoothai laalach janam gavaaiaa ||",
      "translation": "In false greed, life is wasting away.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਲਪਟਿ ਰਹੀ ਫੁਨਿ ਬੰਧੁ ਨ ਪਾਇਆ ॥",
      "transliteration": "lapat rahee phun ba(n)dh na paaiaa ||",
      "translation": "Duality clings to the mind; it cannot be restrained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਤਿਗੁਰਿ ਰਾਖੇ ਨਾਮੁ ਦ੍ਰਿੜਾਇਆ ॥੧॥",
      "transliteration": "satigur raakhe naam driRaaiaa ||1||",
      "translation": "The True Guru saves us, implanting the Naam, the Name of the Lord within. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਨਾ ਮਨੁ ਮਰੈ ਨ ਮਾਇਆ ਮਰੈ ॥",
      "transliteration": "naa man marai na maaiaa marai ||",
      "translation": "Without subduing the mind, Maya cannot be subdued.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਜਿਨਿ ਕਿਛੁ ਕੀਆ ਸੋਈ ਜਾਣੈ ਸਬਦੁ ਵੀਚਾਰਿ ਭਉ ਸਾਗਰੁ ਤਰੈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "jin kichh keeaa soee jaanai sabad veechaar bhau saagar tarai ||1|| rahaau ||",
      "translation": "The One who created this, He alone understands. Contemplating the Word of the Shabad, one is carried across the terrifying world-ocean. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਮਾਇਆ ਸੰਚਿ ਰਾਜੇ ਅਹੰਕਾਰੀ ॥",
      "transliteration": "maaiaa sa(n)ch raaje aha(n)kaaree ||",
      "translation": "Gathering the wealth of Maya, kings become proud and arrogant.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਮਾਇਆ ਸਾਥਿ ਨ ਚਲੈ ਪਿਆਰੀ ॥",
      "transliteration": "maaiaa saath na chalai piaaree ||",
      "translation": "But this Maya that they love so much shall not go along with them in the end.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਮਾਇਆ ਮਮਤਾ ਹੈ ਬਹੁ ਰੰਗੀ ॥",
      "transliteration": "maaiaa mamataa hai bahu ra(n)gee ||",
      "translation": "There are so many colors and flavors of attachment to Maya.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਕੋ ਸਾਥਿ ਨ ਸੰਗੀ ॥੨॥",
      "transliteration": "bin naavai ko saath na sa(n)gee ||2||",
      "translation": "Except for the Name, no one has any friend or companion. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜਿਉ ਮਨੁ ਦੇਖਹਿ ਪਰ ਮਨੁ ਤੈਸਾ ॥",
      "transliteration": "jiu man dekhahi par man taisaa ||",
      "translation": "According to one's own mind, one sees the minds of others.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਜੈਸੀ ਮਨਸਾ ਤੈਸੀ ਦਸਾ ॥",
      "transliteration": "jaisee manasaa taisee dasaa ||",
      "translation": "According to one's desires, one's condition is determined.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਜੈਸਾ ਕਰਮੁ ਤੈਸੀ ਲਿਵ ਲਾਵੈ ॥",
      "transliteration": "jaisaa karam taisee liv laavai ||",
      "translation": "According to one's actions, one is focused and tuned in.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਪੂਛਿ ਸਹਜ ਘਰੁ ਪਾਵੈ ॥੩॥",
      "transliteration": "satigur poochh sahaj ghar paavai ||3||",
      "translation": "Seeking the advice of the True Guru, one finds the home of peace and poise. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਰਾਗਿ ਨਾਦਿ ਮਨੁ ਦੂਜੈ ਭਾਇ ॥",
      "transliteration": "raag naad man doojai bhaai ||",
      "translation": "In music and song, the mind is caught by the love of duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਅੰਤਰਿ ਕਪਟੁ ਮਹਾ ਦੁਖੁ ਪਾਇ ॥",
      "transliteration": "a(n)tar kapat mahaa dukh paai ||",
      "translation": "Filled with deception deep within, one suffers in terrible pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਭੇਟੈ ਸੋਝੀ ਪਾਇ ॥",
      "transliteration": "satigur bhetai sojhee paai ||",
      "translation": "Meeting with the True Guru, one is blessed with clear understanding,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਸਚੈ ਨਾਮਿ ਰਹੈ ਲਿਵ ਲਾਇ ॥੪॥",
      "transliteration": "sachai naam rahai liv laai ||4||",
      "translation": "and remains lovingly attuned to the True Name. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਸਚੈ ਸਬਦਿ ਸਚੁ ਕਮਾਵੈ ॥",
      "transliteration": "sachai sabad sach kamaavai ||",
      "translation": "Through the True Word of the Shabad, one practices Truth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਸਚੀ ਬਾਣੀ ਹਰਿ ਗੁਣ ਗਾਵੈ ॥",
      "transliteration": "sachee baanee har gun gaavai ||",
      "translation": "He sings the Glorious Praises of the Lord, through the True Word of His Bani.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਿਜ ਘਰਿ ਵਾਸੁ ਅਮਰ ਪਦੁ ਪਾਵੈ ॥",
      "transliteration": "nij ghar vaas amar pad paavai ||",
      "translation": "He dwells in the home of his own heart deep within, and obtains the immortal status.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਤਾ ਦਰਿ ਸਾਚੈ ਸੋਭਾ ਪਾਵੈ ॥੫॥",
      "transliteration": "taa dar saachai sobhaa paavai ||5||",
      "translation": "Then, he is blessed with honor in the Court of the True Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਗੁਰ ਸੇਵਾ ਬਿਨੁ ਭਗਤਿ ਨ ਹੋਈ ॥",
      "transliteration": "gur sevaa bin bhagat na hoee ||",
      "translation": "Without serving the Guru, there is no devotional worship,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਅਨੇਕ ਜਤਨ ਕਰੈ ਜੇ ਕੋਈ ॥",
      "transliteration": "anek jatan karai je koee ||",
      "translation": "even though one may make all sorts of efforts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਹਉਮੈ ਮੇਰਾ ਸਬਦੇ ਖੋਈ ॥",
      "transliteration": "haumai meraa sabade khoee ||",
      "translation": "If one eradicates egotism and selfishness through the Shabad,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਨਿਰਮਲ ਨਾਮੁ ਵਸੈ ਮਨਿ ਸੋਈ ॥੬॥",
      "transliteration": "niramal naam vasai man soee ||6||",
      "translation": "the Immaculate Naam comes to abide in the mind. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਇਸੁ ਜਗ ਮਹਿ ਸਬਦੁ ਕਰਣੀ ਹੈ ਸਾਰੁ ॥",
      "transliteration": "is jag mahi sabad karanee hai saar ||",
      "translation": "In this world, the practice of the Shabad is the most excellent occupation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਬਿਨੁ ਸਬਦੈ ਹੋਰੁ ਮੋਹੁ ਗੁਬਾਰੁ ॥",
      "transliteration": "bin sabadai hor mohu gubaar ||",
      "translation": "Without the Shabad, everything else is the darkness of emotional attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਸਬਦੇ ਨਾਮੁ ਰਖੈ ਉਰਿ ਧਾਰਿ ॥",
      "transliteration": "sabade naam rakhai ur dhaar ||",
      "translation": "Through the Shabad, the Naam is enshrined within the heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਸਬਦੇ ਗਤਿ ਮਤਿ ਮੋਖ ਦੁਆਰੁ ॥੭॥",
      "transliteration": "sabade gat mat mokh duaar ||7||",
      "translation": "Through the Shabad, one obtains clear understanding and the door of salvation. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਅਵਰੁ ਨਾਹੀ ਕਰਿ ਦੇਖਣਹਾਰੋ ॥",
      "transliteration": "avar naahee kar dekhanahaaro ||",
      "translation": "There is no other Creator except the All-seeing Lord God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਸਾਚਾ ਆਪਿ ਅਨੂਪੁ ਅਪਾਰੋ ॥",
      "transliteration": "saachaa aap anoop apaaro ||",
      "translation": "The True Lord Himself is Infinite and Incomparably Beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਰਾਮ ਨਾਮ ਊਤਮ ਗਤਿ ਹੋਈ ॥",
      "transliteration": "raam naam ootam gat hoee ||",
      "translation": "Through the Lord's Name, one obtains the most sublime and exalted state.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਨਾਨਕ ਖੋਜਿ ਲਹੈ ਜਨੁ ਕੋਈ ॥੮॥੧॥",
      "transliteration": "naanak khoj lahai jan koee ||8||1||",
      "translation": "O Nanak, how rare are those humble beings, who seek and find the Lord. ||8||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "prabhaatee mahalaa 1 ||",
      "translation": "Prabhaatee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਮਾਇਆ ਮੋਹਿ ਸਗਲ ਜਗੁ ਛਾਇਆ ॥",
      "transliteration": "maaiaa mohi sagal jag chhaaiaa ||",
      "translation": "Emotional attachment to Maya is spread out all over the world.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਕਾਮਣਿ ਦੇਖਿ ਕਾਮਿ ਲੋਭਾਇਆ ॥",
      "transliteration": "kaaman dekh kaam lobhaaiaa ||",
      "translation": "Seeing a beautiful woman, the man is overcome with sexual desire.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੁਤ ਕੰਚਨ ਸਿਉ ਹੇਤੁ ਵਧਾਇਆ ॥",
      "transliteration": "sut ka(n)chan siu het vadhaaiaa ||",
      "translation": "His love for his children and gold steadily increases.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਸਭੁ ਕਿਛੁ ਅਪਨਾ ਇਕੁ ਰਾਮੁ ਪਰਾਇਆ ॥੧॥",
      "transliteration": "sabh kichh apanaa ik raam paraaiaa ||1||",
      "translation": "He sees everything as his own, but he does not own the One Lord. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਐਸਾ ਜਾਪੁ ਜਪਉ ਜਪਮਾਲੀ ॥",
      "transliteration": "aisaa jaap japau japamaalee ||",
      "translation": "I meditate as I chant on such a mala,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਦੁਖ ਸੁਖ ਪਰਹਰਿ ਭਗਤਿ ਨਿਰਾਲੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dukh sukh parahar bhagat niraalee ||1|| rahaau ||",
      "translation": "that I rise above pleasure and pain; I attain the most wondrous devotional worship of the Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਗੁਣ ਨਿਧਾਨ ਤੇਰਾ ਅੰਤੁ ਨ ਪਾਇਆ ॥",
      "transliteration": "gun nidhaan teraa a(n)t na paaiaa ||",
      "translation": "O Treasure of Virtue, Your limits cannot be found.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਾਚ ਸਬਦਿ ਤੁਝ ਮਾਹਿ ਸਮਾਇਆ ॥",
      "transliteration": "saach sabad tujh maahi samaaiaa ||",
      "translation": "Through the True Word of the Shabad, I am absorbed into You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਆਵਾ ਗਉਣੁ ਤੁਧੁ ਆਪਿ ਰਚਾਇਆ ॥",
      "transliteration": "aavaa gaun tudh aap rachaaiaa ||",
      "translation": "You Yourself created the comings and goings of reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਸੇਈ ਭਗਤ ਜਿਨ ਸਚਿ ਚਿਤੁ ਲਾਇਆ ॥੨॥",
      "transliteration": "seee bhagat jin sach chit laaiaa ||2||",
      "translation": "They alone are devotees, who focus their consciousness on You. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਗਿਆਨੁ ਧਿਆਨੁ ਨਰਹਰਿ ਨਿਰਬਾਣੀ ॥",
      "transliteration": "giaan dhiaan narahar nirabaanee ||",
      "translation": "Spiritual wisdom and meditation on the Lord, the Lord of Nirvaanaa",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰ ਭੇਟੇ ਕੋਇ ਨ ਜਾਣੀ ॥",
      "transliteration": "bin satigur bhete koi na jaanee ||",
      "translation": "- without meeting the True Guru, no one knows this.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਸਗਲ ਸਰੋਵਰ ਜੋਤਿ ਸਮਾਣੀ ॥",
      "transliteration": "sagal sarovar jot samaanee ||",
      "translation": "The Lord's Light fills the sacred pools of all beings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਆਨਦ ਰੂਪ ਵਿਟਹੁ ਕੁਰਬਾਣੀ ॥੩॥",
      "transliteration": "aanad roop vitahu kurabaanee ||3||",
      "translation": "I am a sacrifice to the Embodiment of Bliss. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਭਾਉ ਭਗਤਿ ਗੁਰਮਤੀ ਪਾਏ ॥",
      "transliteration": "bhaau bhagat guramatee paae ||",
      "translation": "Through the Guru's Teachings, one achieves loving devotional worship.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1342_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਹਉਮੈ ਵਿਚਹੁ ਸਬਦਿ ਜਲਾਏ ॥",
      "transliteration": "haumai vichahu sabad jalaae ||",
      "translation": "The Shabad burns away egotism from within.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1342,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
