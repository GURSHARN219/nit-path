{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1343,
  "lineCount": 53,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1343_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਧਾਵਤੁ ਰਾਖੈ ਠਾਕਿ ਰਹਾਏ ॥",
      "transliteration": "dhaavat raakhai thaak rahaae ||",
      "translation": "The wandering mind is restrained and held in its place.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਸਚਾ ਨਾਮੁ ਮੰਨਿ ਵਸਾਏ ॥੪॥",
      "transliteration": "sachaa naam ma(n)n vasaae ||4||",
      "translation": "The True Name is enshrined in the mind. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਬਿਸਮ ਬਿਨੋਦ ਰਹੇ ਪਰਮਾਦੀ ॥",
      "transliteration": "bisam binod rahe paramaadee ||",
      "translation": "The exciting and intoxicating worldly plays come to an end,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਗੁਰਮਤਿ ਮਾਨਿਆ ਏਕ ਲਿਵ ਲਾਗੀ ॥",
      "transliteration": "guramat maaniaa ek liv laagee ||",
      "translation": "for those who accept the Guru's Teachings, and become lovingly attuned to the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਦੇਖਿ ਨਿਵਾਰਿਆ ਜਲ ਮਹਿ ਆਗੀ ॥",
      "transliteration": "dekh nivaariaa jal mahi aagee ||",
      "translation": "Seeing this, the fire in the water is extinguished.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸੋ ਬੂਝੈ ਹੋਵੈ ਵਡਭਾਗੀ ॥੫॥",
      "transliteration": "so boojhai hovai vadabhaagee ||5||",
      "translation": "They alone realize this, who are blessed by great good fortune. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵੇ ਭਰਮੁ ਚੁਕਾਏ ॥",
      "transliteration": "satigur seve bharam chukaae ||",
      "translation": "Serving the True Guru, doubt is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਅਨਦਿਨੁ ਜਾਗੈ ਸਚਿ ਲਿਵ ਲਾਏ ॥",
      "transliteration": "anadin jaagai sach liv laae ||",
      "translation": "Those who are lovingly attuned to the True Lord remain awake and aware night and day.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਏਕੋ ਜਾਣੈ ਅਵਰੁ ਨ ਕੋਇ ॥",
      "transliteration": "eko jaanai avar na koi ||",
      "translation": "They know the One Lord, and no other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸੁਖਦਾਤਾ ਸੇਵੇ ਨਿਰਮਲੁ ਹੋਇ ॥੬॥",
      "transliteration": "sukhadaataa seve niramal hoi ||6||",
      "translation": "Serving the Giver of peace, they become immaculate. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੇਵਾ ਸੁਰਤਿ ਸਬਦਿ ਵੀਚਾਰਿ ॥",
      "transliteration": "sevaa surat sabad veechaar ||",
      "translation": "Selfless service and intuitive awareness come by reflecting upon the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਜਪੁ ਤਪੁ ਸੰਜਮੁ ਹਉਮੈ ਮਾਰਿ ॥",
      "transliteration": "jap tap sa(n)jam haumai maar ||",
      "translation": "Chanting, intensive meditation and austere self-discipline come by subduing the ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਜੀਵਨ ਮੁਕਤੁ ਜਾ ਸਬਦੁ ਸੁਣਾਏ ॥",
      "transliteration": "jeevan mukat jaa sabad sunaae ||",
      "translation": "One becomes Jivan-mukta - liberated while yet alive, by listening to the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਸਚੀ ਰਹਤ ਸਚਾ ਸੁਖੁ ਪਾਏ ॥੭॥",
      "transliteration": "sachee rahat sachaa sukh paae ||7||",
      "translation": "Living a truthful way of life, one finds true peace. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਸੁਖਦਾਤਾ ਦੁਖੁ ਮੇਟਣਹਾਰਾ ॥",
      "transliteration": "sukhadaataa dukh metanahaaraa ||",
      "translation": "The Giver of peace is the Eradicator of pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਵਰੁ ਨ ਸੂਝਸਿ ਬੀਜੀ ਕਾਰਾ ॥",
      "transliteration": "avar na soojhas beejee kaaraa ||",
      "translation": "I cannot conceive of serving any other.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤਨੁ ਮਨੁ ਧਨੁ ਹਰਿ ਆਗੈ ਰਾਖਿਆ ॥",
      "transliteration": "tan man dhan har aagai raakhiaa ||",
      "translation": "I place my body, mind and wealth in offering before Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਨਾਨਕੁ ਕਹੈ ਮਹਾ ਰਸੁ ਚਾਖਿਆ ॥੮॥੨॥",
      "transliteration": "naanak kahai mahaa ras chaakhiaa ||8||2||",
      "translation": "Says Nanak, I have tasted the supreme, sublime Essence of the Lord. ||8||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੧ ॥",
      "transliteration": "prabhaatee mahalaa 1 ||",
      "translation": "Prabhaatee, First Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਨਿਵਲੀ ਕਰਮ ਭੁਅੰਗਮ ਭਾਠੀ ਰੇਚਕ ਪੂਰਕ ਕੁੰਭ ਕਰੈ ॥",
      "transliteration": "nivalee karam bhua(n)gam bhaathee rechak poorak ku(n)bh karai ||",
      "translation": "You may perform exercises of inner purification, and fire up the furnace of the Kundalini, inhaling and exhaling and holding the breath.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰ ਕਿਛੁ ਸੋਝੀ ਨਾਹੀ ਭਰਮੇ ਭੂਲਾ ਬੂਡਿ ਮਰੈ ॥",
      "transliteration": "bin satigur kichh sojhee naahee bharame bhoolaa bood marai ||",
      "translation": "Without the True Guru, you will not understand; deluded by doubt, you shall drown and die.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅੰਧਾ ਭਰਿਆ ਭਰਿ ਭਰਿ ਧੋਵੈ ਅੰਤਰ ਕੀ ਮਲੁ ਕਦੇ ਨ ਲਹੈ ॥",
      "transliteration": "a(n)dhaa bhariaa bhar bhar dhovai a(n)tar kee mal kade na lahai ||",
      "translation": "The spiritually blind are filled with filth and pollution; they may wash, but the filth within shall never depart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਨਾਮ ਬਿਨਾ ਫੋਕਟ ਸਭਿ ਕਰਮਾ ਜਿਉ ਬਾਜੀਗਰੁ ਭਰਮਿ ਭੁਲੈ ॥੧॥",
      "transliteration": "naam binaa phokat sabh karamaa jiu baajeegar bharam bhulai ||1||",
      "translation": "Without the Naam, the Name of the Lord, all their actions are useless, like the magician who deceives through illuions. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਖਟੁ ਕਰਮ ਨਾਮੁ ਨਿਰੰਜਨੁ ਸੋਈ ॥",
      "transliteration": "khat karam naam nira(n)jan soee ||",
      "translation": "The merits of the six religious rituals are obtained through the Immaculate Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਤੂ ਗੁਣ ਸਾਗਰੁ ਅਵਗੁਣ ਮੋਹੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "too gun saagar avagun mohee ||1|| rahaau ||",
      "translation": "You, O Lord, are the Ocean of virtue; I am so unworthy. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਮਾਇਆ ਧੰਧਾ ਧਾਵਣੀ ਦੁਰਮਤਿ ਕਾਰ ਬਿਕਾਰ ॥",
      "transliteration": "maaiaa dha(n)dhaa dhaavanee duramat kaar bikaar ||",
      "translation": "Running around chasing the entanglements of Maya is an evil-minded act of corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਮੂਰਖੁ ਆਪੁ ਗਣਾਇਦਾ ਬੂਝਿ ਨ ਸਕੈ ਕਾਰ ॥",
      "transliteration": "moorakh aap ganaaidaa boojh na sakai kaar ||",
      "translation": "The fool makes a show of his self-conceit; he does not know how to behave.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਮਨਸਾ ਮਾਇਆ ਮੋਹਣੀ ਮਨਮੁਖ ਬੋਲ ਖੁਆਰ ॥",
      "transliteration": "manasaa maaiaa mohanee manamukh bol khuaar ||",
      "translation": "The self-willed manmukh is enticed by his desires for Maya; his words are useless and empty.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਜਨੁ ਝੂਠਾ ਚੰਡਾਲ ਕਾ ਫੋਕਟ ਚਾਰ ਸੀਂਗਾਰ ॥੨॥",
      "transliteration": "majan jhoothaa cha(n)daal kaa phokat chaar see(n)gaar ||2||",
      "translation": "The ritual cleansings of the sinner are fradulent; his rituals and decorations are useless and empty. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਝੂਠੀ ਮਨ ਕੀ ਮਤਿ ਹੈ ਕਰਣੀ ਬਾਦਿ ਬਿਬਾਦੁ ॥",
      "transliteration": "jhoothee man kee mat hai karanee baad bibaad ||",
      "translation": "False is the wisdom of the mind; its actions inspire useless disputes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਝੂਠੇ ਵਿਚਿ ਅਹੰਕਰਣੁ ਹੈ ਖਸਮ ਨ ਪਾਵੈ ਸਾਦੁ ॥",
      "transliteration": "jhoothe vich aha(n)karan hai khasam na paavai saad ||",
      "translation": "The false are filled with egotism; they do not obtain the sublime taste of their Lord and Master.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਬਿਨੁ ਨਾਵੈ ਹੋਰੁ ਕਮਾਵਣਾ ਫਿਕਾ ਆਵੈ ਸਾਦੁ ॥",
      "transliteration": "bin naavai hor kamaavanaa phikaa aavai saad ||",
      "translation": "Without the Name, whatever else they do is tasteless and insipid.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੁਸਟੀ ਸਭਾ ਵਿਗੁਚੀਐ ਬਿਖੁ ਵਾਤੀ ਜੀਵਣ ਬਾਦਿ ॥੩॥",
      "transliteration": "dusatee sabhaa vigucheeai bikh vaatee jeevan baad ||3||",
      "translation": "Associating with their enemies, they are plundered and ruined. Their speech is poison, and their lives are useless. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਏ ਭ੍ਰਮਿ ਭੂਲੇ ਮਰਹੁ ਨ ਕੋਈ ॥",
      "transliteration": "e bhram bhoole marahu na koee ||",
      "translation": "Do not be deluded by doubt; do not invite your own death.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਸਤਿਗੁਰੁ ਸੇਵਿ ਸਦਾ ਸੁਖੁ ਹੋਈ ॥",
      "transliteration": "satigur sev sadaa sukh hoee ||",
      "translation": "Serve the True Guru, and you shall be at peace forever.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰ ਮੁਕਤਿ ਕਿਨੈ ਨ ਪਾਈ ॥",
      "transliteration": "bin satigur mukat kinai na paaee ||",
      "translation": "Without the True Guru, no one is liberated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਆਵਹਿ ਜਾਂਹਿ ਮਰਹਿ ਮਰਿ ਜਾਈ ॥੪॥",
      "transliteration": "aavahi jaa(n)hi marahi mar jaaee ||4||",
      "translation": "They come and go in reincarnation; they die, only to be reborn and die again. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਏਹੁ ਸਰੀਰੁ ਹੈ ਤ੍ਰੈ ਗੁਣ ਧਾਤੁ ॥",
      "transliteration": "ehu sareer hai trai gun dhaat ||",
      "translation": "This body wanders, caught in the three dispositions.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਸ ਨੋ ਵਿਆਪੈ ਸੋਗ ਸੰਤਾਪੁ ॥",
      "transliteration": "is no viaapai sog sa(n)taap ||",
      "translation": "It is afflicted by sorrow and suffering.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸੋ ਸੇਵਹੁ ਜਿਸੁ ਮਾਈ ਨ ਬਾਪੁ ॥",
      "transliteration": "so sevahu jis maaee na baap ||",
      "translation": "So serve the One who has no mother or father.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਵਿਚਹੁ ਚੂਕੈ ਤਿਸਨਾ ਅਰੁ ਆਪੁ ॥੫॥",
      "transliteration": "vichahu chookai tisanaa ar aap ||5||",
      "translation": "Desire and selfishness shall depart from within. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਜਹ ਜਹ ਦੇਖਾ ਤਹ ਤਹ ਸੋਈ ॥",
      "transliteration": "jah jah dekhaa tah tah soee ||",
      "translation": "Wherever I look, I see Him.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰ ਭੇਟੇ ਮੁਕਤਿ ਨ ਹੋਈ ॥",
      "transliteration": "bin satigur bhete mukat na hoee ||",
      "translation": "Without meeting the True Guru, no one is liberated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਹਿਰਦੈ ਸਚੁ ਏਹ ਕਰਣੀ ਸਾਰੁ ॥",
      "transliteration": "hiradai sach eh karanee saar ||",
      "translation": "Enshrine the True One in your heart; this is the most excellent action.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਹੋਰੁ ਸਭੁ ਪਾਖੰਡੁ ਪੂਜ ਖੁਆਰੁ ॥੬॥",
      "transliteration": "hor sabh paakha(n)d pooj khuaar ||6||",
      "translation": "All other hypocritical actions and devotions bring only ruin. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਦੁਬਿਧਾ ਚੂਕੈ ਤਾਂ ਸਬਦੁ ਪਛਾਣੁ ॥",
      "transliteration": "dubidhaa chookai taa(n) sabad pachhaan ||",
      "translation": "When one is rid of duality, then he realizes the Word of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਘਰਿ ਬਾਹਰਿ ਏਕੋ ਕਰਿ ਜਾਣੁ ॥",
      "transliteration": "ghar baahar eko kar jaan ||",
      "translation": "Inside and out, he knows the One Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਏਹਾ ਮਤਿ ਸਬਦੁ ਹੈ ਸਾਰੁ ॥",
      "transliteration": "ehaa mat sabad hai saar ||",
      "translation": "This is the most Excellent Wisdom of the Shabad.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਵਿਚਿ ਦੁਬਿਧਾ ਮਾਥੈ ਪਵੈ ਛਾਰੁ ॥੭॥",
      "transliteration": "vich dubidhaa maathai pavai chhaar ||7||",
      "translation": "Ashes fall on the heads of those who are in duality. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਕਰਣੀ ਕੀਰਤਿ ਗੁਰਮਤਿ ਸਾਰੁ ॥",
      "transliteration": "karanee keerat guramat saar ||",
      "translation": "To praise the Lord through the Guru's Teachings is the most excellent action.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਸੰਤ ਸਭਾ ਗੁਣ ਗਿਆਨੁ ਬੀਚਾਰੁ ॥",
      "transliteration": "sa(n)t sabhaa gun giaan beechaar ||",
      "translation": "In the Society of the Saints, contemplate the Glories of God and His spiritual wisdom.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਨੁ ਮਾਰੇ ਜੀਵਤ ਮਰਿ ਜਾਣੁ ॥",
      "transliteration": "man maare jeevat mar jaan ||",
      "translation": "Whoever subdues his mind, knows the state of being dead while yet alive.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1343_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਨਾਨਕ ਨਦਰੀ ਨਦਰਿ ਪਛਾਣੁ ॥੮॥੩॥",
      "transliteration": "naanak nadaree nadar pachhaan ||8||3||",
      "translation": "O Nanak, by His Grace, the Gracious Lord is realized. ||8||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1343,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
