{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1347,
  "lineCount": 47,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1347_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਹਉਮੈ ਵਿਚਿ ਜਾਗ੍ਰਣੁ ਨ ਹੋਵਈ ਹਰਿ ਭਗਤਿ ਨ ਪਵਈ ਥਾਇ ॥",
      "transliteration": "haumai vich jaagran na hovaee har bhagat na pavaee thaai ||",
      "translation": "In egotism, one cannot remain awake and aware, and one's devotional worship of the Lord is not accepted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਮਨਮੁਖ ਦਰਿ ਢੋਈ ਨਾ ਲਹਹਿ ਭਾਇ ਦੂਜੈ ਕਰਮ ਕਮਾਇ ॥੪॥",
      "transliteration": "manamukh dar dhoee naa lahahi bhaai doojai karam kamaai ||4||",
      "translation": "The self-willed manmukhs find no place in the Court of the Lord; they do their deeds in the love of duality. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਧ੍ਰਿਗੁ ਖਾਣਾ ਧ੍ਰਿਗੁ ਪੈਨੑਣਾ ਜਿਨੑਾ ਦੂਜੈ ਭਾਇ ਪਿਆਰੁ ॥",
      "transliteration": "dhrig khaanaa dhrig painhnaa jinhaa doojai bhaai piaar ||",
      "translation": "Cursed is the food, and cursed are the clothes, of those who are attached to the love of duality.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਬਿਸਟਾ ਕੇ ਕੀੜੇ ਬਿਸਟਾ ਰਾਤੇ ਮਰਿ ਜੰਮਹਿ ਹੋਹਿ ਖੁਆਰੁ ॥੫॥",
      "transliteration": "bisataa ke keeRe bisataa raate mar ja(n)mahi hohi khuaar ||5||",
      "translation": "They are like maggots in manure, sinking into manure. In death and rebirth, they are wasted away to ruin. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਜਿਨ ਕਉ ਸਤਿਗੁਰੁ ਭੇਟਿਆ ਤਿਨਾ ਵਿਟਹੁ ਬਲਿ ਜਾਉ ॥",
      "transliteration": "jin kau satigur bhetiaa tinaa vitahu bal jaau ||",
      "translation": "I am a sacrifice to those who meet with the True Guru.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਤਿਨ ਕੀ ਸੰਗਤਿ ਮਿਲਿ ਰਹਾਂ ਸਚੇ ਸਚਿ ਸਮਾਉ ॥੬॥",
      "transliteration": "tin kee sa(n)gat mil rahaa(n) sache sach samaau ||6||",
      "translation": "I shall continue to associate with them; devoted to Truth, I am absorbed in Truth. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪੂਰੈ ਭਾਗਿ ਗੁਰੁ ਪਾਈਐ ਉਪਾਇ ਕਿਤੈ ਨ ਪਾਇਆ ਜਾਇ ॥",
      "transliteration": "poorai bhaag gur paaeeai upaai kitai na paaiaa jaai ||",
      "translation": "By perfect destiny, the Guru is found. He cannot be found by any efforts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਸਤਿਗੁਰ ਤੇ ਸਹਜੁ ਊਪਜੈ ਹਉਮੈ ਸਬਦਿ ਜਲਾਇ ॥੭॥",
      "transliteration": "satigur te sahaj oopajai haumai sabad jalaai ||7||",
      "translation": "Through the True Guru, intuitive wisdom wells up; through the Word of the Shabad, egotism is burnt away. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਹਰਿ ਸਰਣਾਈ ਭਜੁ ਮਨ ਮੇਰੇ ਸਭ ਕਿਛੁ ਕਰਣੈ ਜੋਗੁ ॥",
      "transliteration": "har saranaaee bhaj man mere sabh kichh karanai jog ||",
      "translation": "O my mind, hurry to the Sanctuary of the Lord; He is Potent to do everything.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਨਾਨਕ ਨਾਮੁ ਨ ਵੀਸਰੈ ਜੋ ਕਿਛੁ ਕਰੈ ਸੁ ਹੋਗੁ ॥੮॥੨॥੭॥੨॥੯॥",
      "transliteration": "naanak naam na veesarai jo kichh karai s hog ||8||2||7||2||9||",
      "translation": "O Nanak, never forget the Naam, the Name of the Lord. Whatever He does, comes to pass. ||8||2||7||2||9||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਬਿਭਾਸ ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੫ ਅਸਟਪਦੀਆ ॥",
      "transliteration": "bibhaas prabhaatee mahalaa 5 asatapadeeaa ||",
      "translation": "Bibhaas, Prabhaatee, Fifth Mehl, Ashtpadheeyaa:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਮਾਤ ਪਿਤਾ ਭਾਈ ਸੁਤੁ ਬਨਿਤਾ ॥",
      "transliteration": "maat pitaa bhaaee sut banitaa ||",
      "translation": "Mother, father, siblings, children and spouse",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਚੂਗਹਿ ਚੋਗ ਅਨੰਦ ਸਿਉ ਜੁਗਤਾ ॥",
      "transliteration": "choogahi chog ana(n)d siu jugataa ||",
      "translation": "involved with them, people eat the food of bliss.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਉਰਝਿ ਪਰਿਓ ਮਨ ਮੀਠ ਮੋੁਹਾਰਾ ॥",
      "transliteration": "urajh pario man meeth mouhaaraa ||",
      "translation": "The mind is entangled in sweet emotional attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਗੁਨ ਗਾਹਕ ਮੇਰੇ ਪ੍ਰਾਨ ਅਧਾਰਾ ॥੧॥",
      "transliteration": "gun gaahak mere praan adhaaraa ||1||",
      "translation": "Those who seek God's Glorious Virtues are the support of my breath of life. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਏਕੁ ਹਮਾਰਾ ਅੰਤਰਜਾਮੀ ॥",
      "transliteration": "ek hamaaraa a(n)tarajaamee ||",
      "translation": "My One Lord is the Inner-Knower, the Searcher of hearts.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਧਰ ਏਕਾ ਮੈ ਟਿਕ ਏਕਸੁ ਕੀ ਸਿਰਿ ਸਾਹਾ ਵਡ ਪੁਰਖੁ ਸੁਆਮੀ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "dhar ekaa mai tik ekas kee sir saahaa vad purakh suaamee ||1|| rahaau ||",
      "translation": "He alone is my Support; He is my only Protection. My Great Lord and Master is over and above the heads of kings. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਛਲ ਨਾਗਨਿ ਸਿਉ ਮੇਰੀ ਟੂਟਨਿ ਹੋਈ ॥",
      "transliteration": "chhal naagan siu meree tootan hoee ||",
      "translation": "I have broken my ties to that deceitful serpent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਗੁਰਿ ਕਹਿਆ ਇਹ ਝੂਠੀ ਧੋਹੀ ॥",
      "transliteration": "gur kahiaa ih jhoothee dhohee ||",
      "translation": "The Guru has told me that it is false and fraudulent.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਮੁਖਿ ਮੀਠੀ ਖਾਈ ਕਉਰਾਇ ॥",
      "transliteration": "mukh meethee khaaee kauraai ||",
      "translation": "Its face is sweet, but it tastes very bitter.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਅੰਮ੍ਰਿਤ ਨਾਮਿ ਮਨੁ ਰਹਿਆ ਅਘਾਇ ॥੨॥",
      "transliteration": "a(n)mrit naam man rahiaa aghaai ||2||",
      "translation": "My mind remains satisfied with the Ambrosial Naam, the Name of the Lord. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਲੋਭ ਮੋਹ ਸਿਉ ਗਈ ਵਿਖੋਟਿ ॥",
      "transliteration": "lobh moh siu gaee vikhot ||",
      "translation": "I have broken my ties with greed and emotional attachment.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਗੁਰਿ ਕ੍ਰਿਪਾਲਿ ਮੋਹਿ ਕੀਨੀ ਛੋਟਿ ॥",
      "transliteration": "gur kripaal mohi keenee chhot ||",
      "translation": "The Merciful Guru has rescued me from them.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਇਹ ਠਗਵਾਰੀ ਬਹੁਤੁ ਘਰ ਗਾਲੇ ॥",
      "transliteration": "ih thagavaaree bahut ghar gaale ||",
      "translation": "These cheating thieves have plundered so many homes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹਮ ਗੁਰਿ ਰਾਖਿ ਲੀਏ ਕਿਰਪਾਲੇ ॥੩॥",
      "transliteration": "ham gur raakh leee kirapaale ||3||",
      "translation": "The Merciful Guru has protected and saved me. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਕਾਮ ਕ੍ਰੋਧ ਸਿਉ ਠਾਟੁ ਨ ਬਨਿਆ ॥",
      "transliteration": "kaam krodh siu thaat na baniaa ||",
      "translation": "I have no dealings whatsoever with sexual desire and anger.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਗੁਰ ਉਪਦੇਸੁ ਮੋਹਿ ਕਾਨੀ ਸੁਨਿਆ ॥",
      "transliteration": "gur upades mohi kaanee suniaa ||",
      "translation": "I listen to the Guru's Teachings.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਜਹ ਦੇਖਉ ਤਹ ਮਹਾ ਚੰਡਾਲ ॥",
      "transliteration": "jah dekhau tah mahaa cha(n)daal ||",
      "translation": "Wherever I look, I see the most horrible goblins.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਰਾਖਿ ਲੀਏ ਅਪੁਨੈ ਗੁਰਿ ਗੋਪਾਲ ॥੪॥",
      "transliteration": "raakh leee apunai gur gopaal ||4||",
      "translation": "My Guru, the Lord of the World, has saved me from them. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਦਸ ਨਾਰੀ ਮੈ ਕਰੀ ਦੁਹਾਗਨਿ ॥",
      "transliteration": "das naaree mai karee duhaagan ||",
      "translation": "I have made widows of the ten sensory organs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰਿ ਕਹਿਆ ਏਹ ਰਸਹਿ ਬਿਖਾਗਨਿ ॥",
      "transliteration": "gur kahiaa eh rasahi bikhaagan ||",
      "translation": "The Guru has told me that these pleasures are the fires of corruption.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਇਨ ਸਨਬੰਧੀ ਰਸਾਤਲਿ ਜਾਇ ॥",
      "transliteration": "in sanaba(n)dhee rasaatal jaai ||",
      "translation": "Those who associate with them go to hell.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਹਮ ਗੁਰਿ ਰਾਖੇ ਹਰਿ ਲਿਵ ਲਾਇ ॥੫॥",
      "transliteration": "ham gur raakhe har liv laai ||5||",
      "translation": "The Guru has saved me; I am lovingly attuned to the Lord. ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਅਹੰਮੇਵ ਸਿਉ ਮਸਲਤਿ ਛੋਡੀ ॥",
      "transliteration": "aha(n)mev siu masalat chhodee ||",
      "translation": "I have forsaken the advice of my ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗੁਰਿ ਕਹਿਆ ਇਹੁ ਮੂਰਖੁ ਹੋਡੀ ॥",
      "transliteration": "gur kahiaa ihu moorakh hodee ||",
      "translation": "The Guru has told me that this is foolish stubbornness.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਇਹੁ ਨੀਘਰੁ ਘਰੁ ਕਹੀ ਨ ਪਾਏ ॥",
      "transliteration": "ihu neeghar ghar kahee na paae ||",
      "translation": "This ego is homeless; it shall never find a home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਹਮ ਗੁਰਿ ਰਾਖਿ ਲੀਏ ਲਿਵ ਲਾਏ ॥੬॥",
      "transliteration": "ham gur raakh leee liv laae ||6||",
      "translation": "The Guru has saved me; I am lovingly attuned to the Lord. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਇਨ ਲੋਗਨ ਸਿਉ ਹਮ ਭਏ ਬੈਰਾਈ ॥",
      "transliteration": "in logan siu ham bhae bairaaee ||",
      "translation": "I have become alienated from these people.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਏਕ ਗ੍ਰਿਹ ਮਹਿ ਦੁਇ ਨ ਖਟਾਂਈ ॥",
      "transliteration": "ek grih mahi dui na khataa(n)ee ||",
      "translation": "We cannot both live together in one home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਆਏ ਪ੍ਰਭ ਪਹਿ ਅੰਚਰਿ ਲਾਗਿ ॥",
      "transliteration": "aae prabh pahi a(n)char laag ||",
      "translation": "Grasping the hem of the Guru's Robe, I have come to God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਕਰਹੁ ਤਪਾਵਸੁ ਪ੍ਰਭ ਸਰਬਾਗਿ ॥੭॥",
      "transliteration": "karahu tapaavas prabh sarabaag ||7||",
      "translation": "Please be fair with me, All-knowing Lord God. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਪ੍ਰਭ ਹਸਿ ਬੋਲੇ ਕੀਏ ਨਿਆਂਏਂ ॥",
      "transliteration": "prabh has bole keee niaa(n)e(n) ||",
      "translation": "God smiled at me and spoke, passing judgement.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਗਲ ਦੂਤ ਮੇਰੀ ਸੇਵਾ ਲਾਏ ॥",
      "transliteration": "sagal doot meree sevaa laae ||",
      "translation": "He made all the demons perform service for me.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਤੂੰ ਠਾਕੁਰੁ ਇਹੁ ਗ੍ਰਿਹੁ ਸਭੁ ਤੇਰਾ ॥",
      "transliteration": "too(n) thaakur ihu grihu sabh teraa ||",
      "translation": "You are my Lord and Master; all this home belongs to You.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਹੁ ਨਾਨਕ ਗੁਰਿ ਕੀਆ ਨਿਬੇਰਾ ॥੮॥੧॥",
      "transliteration": "kahu naanak gur keeaa niberaa ||8||1||",
      "translation": "Says Nanak, the Guru has passed judgement. ||8||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1347_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "prabhaatee mahalaa 5 ||",
      "translation": "Prabhaatee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1347,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
