{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1348,
  "lineCount": 56,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1348_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਮਨ ਮਹਿ ਕ੍ਰੋਧੁ ਮਹਾ ਅਹੰਕਾਰਾ ॥",
      "transliteration": "man mahi krodh mahaa aha(n)kaaraa ||",
      "translation": "Within the mind dwell anger and massive ego.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪੂਜਾ ਕਰਹਿ ਬਹੁਤੁ ਬਿਸਥਾਰਾ ॥",
      "transliteration": "poojaa karahi bahut bisathaaraa ||",
      "translation": "Worship services are performed with great pomp and ceremony.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਕਰਿ ਇਸਨਾਨੁ ਤਨਿ ਚਕ੍ਰ ਬਣਾਏ ॥",
      "transliteration": "kar isanaan tan chakr banaae ||",
      "translation": "Ritual cleansing baths are taken, and sacred marks are applied to the body.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਅੰਤਰ ਕੀ ਮਲੁ ਕਬ ਹੀ ਨ ਜਾਏ ॥੧॥",
      "transliteration": "a(n)tar kee mal kab hee na jaae ||1||",
      "translation": "But still, the filth and pollution within never depart. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਇਤੁ ਸੰਜਮਿ ਪ੍ਰਭੁ ਕਿਨ ਹੀ ਨ ਪਾਇਆ ॥",
      "transliteration": "it sa(n)jam prabh kin hee na paaiaa ||",
      "translation": "No one has ever found God in this way.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਭਗਉਤੀ ਮੁਦ੍ਰਾ ਮਨੁ ਮੋਹਿਆ ਮਾਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "bhagautee mudraa man mohiaa maaiaa ||1|| rahaau ||",
      "translation": "The sacred mudras - ritualistic hand gestures - are made, but the mind remains enticed by Maya. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਪਾਪ ਕਰਹਿ ਪੰਚਾਂ ਕੇ ਬਸਿ ਰੇ ॥",
      "transliteration": "paap karahi pa(n)chaa(n) ke bas re ||",
      "translation": "They commit sins, under the influence of the five thieves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਤੀਰਥਿ ਨਾਇ ਕਹਹਿ ਸਭਿ ਉਤਰੇ ॥",
      "transliteration": "teerath naai kahahi sabh utare ||",
      "translation": "They bathe at sacred shrines, and claim that everything has been washed off.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਹੁਰਿ ਕਮਾਵਹਿ ਹੋਇ ਨਿਸੰਕ ॥",
      "transliteration": "bahur kamaavahi hoi nisa(n)k ||",
      "translation": "Then they commit them again, without fear of the consequences.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਜਮ ਪੁਰਿ ਬਾਂਧਿ ਖਰੇ ਕਾਲੰਕ ॥੨॥",
      "transliteration": "jam pur baa(n)dh khare kaala(n)k ||2||",
      "translation": "The sinners are bound and gagged, and taken to the City of Death. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਘੂਘਰ ਬਾਧਿ ਬਜਾਵਹਿ ਤਾਲਾ ॥",
      "transliteration": "ghooghar baadh bajaavahi taalaa ||",
      "translation": "The ankle-bells shake and the cymbals vibrate,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਅੰਤਰਿ ਕਪਟੁ ਫਿਰਹਿ ਬੇਤਾਲਾ ॥",
      "transliteration": "a(n)tar kapat phirahi betaalaa ||",
      "translation": "but those who have deception within wander lost like demons.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਵਰਮੀ ਮਾਰੀ ਸਾਪੁ ਨ ਮੂਆ ॥",
      "transliteration": "varamee maaree saap na mooaa ||",
      "translation": "By destroying its hole, the snake is not killed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਪ੍ਰਭੁ ਸਭ ਕਿਛੁ ਜਾਨੈ ਜਿਨਿ ਤੂ ਕੀਆ ॥੩॥",
      "transliteration": "prabh sabh kichh jaanai jin too keeaa ||3||",
      "translation": "God, who created you, knows everything. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਪੂੰਅਰ ਤਾਪ ਗੇਰੀ ਕੇ ਬਸਤ੍ਰਾ ॥",
      "transliteration": "poo(n)ar taap geree ke basatraa ||",
      "translation": "You worship fire and wear saffron colored robes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਅਪਦਾ ਕਾ ਮਾਰਿਆ ਗ੍ਰਿਹ ਤੇ ਨਸਤਾ ॥",
      "transliteration": "apadaa kaa maariaa grih te nasataa ||",
      "translation": "Stung by your misfortune, you abandon your home.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਦੇਸੁ ਛੋਡਿ ਪਰਦੇਸਹਿ ਧਾਇਆ ॥",
      "transliteration": "des chhod paradesahi dhaaiaa ||",
      "translation": "Leaving your own country, you wander in foreign lands.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਪੰਚ ਚੰਡਾਲ ਨਾਲੇ ਲੈ ਆਇਆ ॥੪॥",
      "transliteration": "pa(n)ch cha(n)daal naale lai aaiaa ||4||",
      "translation": "But you bring the five rejects with you. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਕਾਨ ਫਰਾਇ ਹਿਰਾਏ ਟੂਕਾ ॥",
      "transliteration": "kaan pharaai hiraae tookaa ||",
      "translation": "You have split your ears, and now you steal crumbs.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਘਰਿ ਘਰਿ ਮਾਂਗੈ ਤ੍ਰਿਪਤਾਵਨ ਤੇ ਚੂਕਾ ॥",
      "transliteration": "ghar ghar maa(n)gai tripataavan te chookaa ||",
      "translation": "You beg from door to door, but you fail to be satisfied.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਬਨਿਤਾ ਛੋਡਿ ਬਦ ਨਦਰਿ ਪਰ ਨਾਰੀ ॥",
      "transliteration": "banitaa chhod bad nadar par naaree ||",
      "translation": "You have abandoned your own wife, but now you sneak glances at other women.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਵੇਸਿ ਨ ਪਾਈਐ ਮਹਾ ਦੁਖਿਆਰੀ ॥੫॥",
      "transliteration": "ves na paaeeai mahaa dukhiaaree ||5||",
      "translation": "God is not found by wearing religious robes; you are utterly miserable! ||5||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬੋਲੈ ਨਾਹੀ ਹੋਇ ਬੈਠਾ ਮੋਨੀ ॥",
      "transliteration": "bolai naahee hoi baithaa monee ||",
      "translation": "He does not speak; he is on silence.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਅੰਤਰਿ ਕਲਪ ਭਵਾਈਐ ਜੋਨੀ ॥",
      "transliteration": "a(n)tar kalap bhavaaeeai jonee ||",
      "translation": "But he is filled with desire; he is made to wander in reincarnation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਅੰਨ ਤੇ ਰਹਤਾ ਦੁਖੁ ਦੇਹੀ ਸਹਤਾ ॥",
      "transliteration": "a(n)n te rahataa dukh dehee sahataa ||",
      "translation": "Abstaining from food, his body suffers in pain.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਹੁਕਮੁ ਨ ਬੂਝੈ ਵਿਆਪਿਆ ਮਮਤਾ ॥੬॥",
      "transliteration": "hukam na boojhai viaapiaa mamataa ||6||",
      "translation": "He does not realize the Hukam of the Lord's Command; he is afflicted by possessiveness. ||6||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰ ਕਿਨੈ ਨ ਪਾਈ ਪਰਮ ਗਤੇ ॥",
      "transliteration": "bin satigur kinai na paaee param gate ||",
      "translation": "Without the True Guru, no one has attained the supreme status.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਪੂਛਹੁ ਸਗਲ ਬੇਦ ਸਿੰਮ੍ਰਿਤੇ ॥",
      "transliteration": "poochhahu sagal bed si(n)mrite ||",
      "translation": "Go ahead and ask all the Vedas and the Simritees.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਮਨਮੁਖ ਕਰਮ ਕਰੈ ਅਜਾਈ ॥",
      "transliteration": "manamukh karam karai ajaaee ||",
      "translation": "The self-willed manmukhs do useless deeds.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਜਿਉ ਬਾਲੂ ਘਰ ਠਉਰ ਨ ਠਾਈ ॥੭॥",
      "transliteration": "jiu baaloo ghar thaur na thaaee ||7||",
      "translation": "They are like a house of sand, which cannot stand. ||7||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਜਿਸ ਨੋ ਭਏ ਗੋੁਬਿੰਦ ਦਇਆਲਾ ॥",
      "transliteration": "jis no bhae goubi(n)d daiaalaa ||",
      "translation": "One unto whom the Lord of the Universe becomes Merciful,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਗੁਰ ਕਾ ਬਚਨੁ ਤਿਨਿ ਬਾਧਿਓ ਪਾਲਾ ॥",
      "transliteration": "gur kaa bachan tin baadhio paalaa ||",
      "translation": "sews the Word of the Guru's Shabad into his robes.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕੋਟਿ ਮਧੇ ਕੋਈ ਸੰਤੁ ਦਿਖਾਇਆ ॥",
      "transliteration": "kot madhe koee sa(n)t dikhaaiaa ||",
      "translation": "Out of millions, it is rare that such a Saint is seen.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਨਾਨਕੁ ਤਿਨ ਕੈ ਸੰਗਿ ਤਰਾਇਆ ॥੮॥",
      "transliteration": "naanak tin kai sa(n)g taraaiaa ||8||",
      "translation": "O Nanak, with him, we are carried across. ||8||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਜੇ ਹੋਵੈ ਭਾਗੁ ਤਾ ਦਰਸਨੁ ਪਾਈਐ ॥",
      "transliteration": "je hovai bhaag taa darasan paaeeai ||",
      "translation": "If one has such good destiny, then the Blessed Vision of His Darshan is obtained.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਆਪਿ ਤਰੈ ਸਭੁ ਕੁਟੰਬੁ ਤਰਾਈਐ ॥੧॥ ਰਹਾਉ ਦੂਜਾ ॥੨॥",
      "transliteration": "aap tarai sabh kuta(n)b taraaeeai ||1|| rahaau doojaa ||2||",
      "translation": "He saves himself, and carries across all his family as well. ||1||SECOND PAUSE||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਮਹਲਾ ੫ ॥",
      "transliteration": "prabhaatee mahalaa 5 ||",
      "translation": "Prabhaatee, Fifth Mehl:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਿਮਰਤ ਨਾਮੁ ਕਿਲਬਿਖ ਸਭਿ ਕਾਟੇ ॥",
      "transliteration": "simarat naam kilabikh sabh kaate ||",
      "translation": "Meditating in remembrance on the Naam, all the sins are erased.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਧਰਮ ਰਾਇ ਕੇ ਕਾਗਰ ਫਾਟੇ ॥",
      "transliteration": "dharam raai ke kaagar phaate ||",
      "translation": "The accounts held by the Righteous Judge of Dharma are torn up.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਸਾਧਸੰਗਤਿ ਮਿਲਿ ਹਰਿ ਰਸੁ ਪਾਇਆ ॥",
      "transliteration": "saadhasa(n)gat mil har ras paaiaa ||",
      "translation": "Joining the Saadh Sangat, the Company of the Holy,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਪਾਰਬ੍ਰਹਮੁ ਰਿਦ ਮਾਹਿ ਸਮਾਇਆ ॥੧॥",
      "transliteration": "paarabraham rid maahi samaaiaa ||1||",
      "translation": "I have found the Sublime Essence of the Lord. The Supreme Lord God has melted into my heart. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਾਮ ਰਮਤ ਹਰਿ ਹਰਿ ਸੁਖੁ ਪਾਇਆ ॥",
      "transliteration": "raam ramat har har sukh paaiaa ||",
      "translation": "Dwelling on the Lord, Har, Har, I have found peace.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਤੇਰੇ ਦਾਸ ਚਰਨ ਸਰਨਾਇਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tere daas charan saranaaiaa ||1|| rahaau ||",
      "translation": "Your slaves seek the Sanctuary of Your Feet. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਚੂਕਾ ਗਉਣੁ ਮਿਟਿਆ ਅੰਧਿਆਰੁ ॥",
      "transliteration": "chookaa gaun mitiaa a(n)dhiaar ||",
      "translation": "The cycle of reincarnation is ended, and darkness is dispelled.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਗੁਰਿ ਦਿਖਲਾਇਆ ਮੁਕਤਿ ਦੁਆਰੁ ॥",
      "transliteration": "gur dikhalaaiaa mukat duaar ||",
      "translation": "The Guru has revealed the door of liberation.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਹਰਿ ਪ੍ਰੇਮ ਭਗਤਿ ਮਨੁ ਤਨੁ ਸਦ ਰਾਤਾ ॥",
      "transliteration": "har prem bhagat man tan sad raataa ||",
      "translation": "My mind and body are forever imbued with loving devotion to the Lord.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪ੍ਰਭੂ ਜਨਾਇਆ ਤਬ ਹੀ ਜਾਤਾ ॥੨॥",
      "transliteration": "prabhoo janaaiaa tab hee jaataa ||2||",
      "translation": "Now I know God, because He has made me know Him. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਅੰਤਰਿ ਰਵਿਆ ਸੋਇ ॥",
      "transliteration": "ghat ghat a(n)tar raviaa soi ||",
      "translation": "He is contained in each and every heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਤਿਸੁ ਬਿਨੁ ਬੀਜੋ ਨਾਹੀ ਕੋਇ ॥",
      "transliteration": "tis bin beejo naahee koi ||",
      "translation": "Without Him, there is no one at all.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਬੈਰ ਬਿਰੋਧ ਛੇਦੇ ਭੈ ਭਰਮਾਂ ॥",
      "transliteration": "bair birodh chhede bhai bharamaa(n) ||",
      "translation": "Hatred, conflict, fear and doubt have been eliminated.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਪ੍ਰਭਿ ਪੁੰਨਿ ਆਤਮੈ ਕੀਨੇ ਧਰਮਾ ॥੩॥",
      "transliteration": "prabh pu(n)n aatamai keene dharamaa ||3||",
      "translation": "God, the Soul of Pure Goodness, has manifested His Righteousness. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਮਹਾ ਤਰੰਗ ਤੇ ਕਾਂਢੈ ਲਾਗਾ ॥",
      "transliteration": "mahaa tara(n)g te kaa(n)dhai laagaa ||",
      "translation": "He has rescued me from the most dangerous waves.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਨਮ ਜਨਮ ਕਾ ਟੂਟਾ ਗਾਂਢਾ ॥",
      "transliteration": "janam janam kaa tootaa gaa(n)dhaa ||",
      "translation": "Separated from Him for countless lifetimes, I am united with Him once again.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਜਪੁ ਤਪੁ ਸੰਜਮੁ ਨਾਮੁ ਸਮੑਾਲਿਆ ॥",
      "transliteration": "jap tap sa(n)jam naam samhaaliaa ||",
      "translation": "Chanting, intense meditation and strict self-discipline are the contemplation of the Naam.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਅਪੁਨੈ ਠਾਕੁਰਿ ਨਦਰਿ ਨਿਹਾਲਿਆ ॥੪॥",
      "transliteration": "apunai thaakur nadar nihaaliaa ||4||",
      "translation": "My Lord and Master has blessed me with His Glance of Grace. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1348_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਮੰਗਲ ਸੂਖ ਕਲਿਆਣ ਤਿਥਾਈਂ ॥",
      "transliteration": "ma(n)gal sookh kaliaan tithaaee(n) ||",
      "translation": "Bliss, peace and salvation are found in that place,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1348,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
