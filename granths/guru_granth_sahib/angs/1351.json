{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1351,
  "lineCount": 47,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1351_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਸਭੋ ਹੁਕਮੁ ਹੁਕਮੁ ਹੈ ਆਪੇ ਨਿਰਭਉ ਸਮਤੁ ਬੀਚਾਰੀ ॥੩॥",
      "transliteration": "sabho hukam hukam hai aape nirabhau samat beechaaree ||3||",
      "translation": "He Himself is the Commander; all are under His Command. The Fearless Lord looks on all alike. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਜੋ ਜਨ ਜਾਨਿ ਭਜਹਿ ਪੁਰਖੋਤਮੁ ਤਾ ਚੀ ਅਬਿਗਤੁ ਬਾਣੀ ॥",
      "transliteration": "jo jan jaan bhajahi purakhotam taa chee abigat baanee ||",
      "translation": "That humble being who knows, and meditates on the Supreme Primal Being - his word becomes eternal.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਨਾਮਾ ਕਹੈ ਜਗਜੀਵਨੁ ਪਾਇਆ ਹਿਰਦੈ ਅਲਖ ਬਿਡਾਣੀ ॥੪॥੧॥",
      "transliteration": "naamaa kahai jagajeevan paaiaa hiradai alakh bidaanee ||4||1||",
      "translation": "Says Naam Dayv, I have found the Invisible, Wondrous Lord, the Life of the World, within my heart. ||4||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ॥",
      "transliteration": "prabhaatee ||",
      "translation": "Prabhaatee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਆਦਿ ਜੁਗਾਦਿ ਜੁਗਾਦਿ ਜੁਗੋ ਜੁਗੁ ਤਾ ਕਾ ਅੰਤੁ ਨ ਜਾਨਿਆ ॥",
      "transliteration": "aad jugaad jugaad jugo jug taa kaa a(n)t na jaaniaa ||",
      "translation": "He existed in the beginning, in the primeval age, and all throughout the ages; His limits cannot be known.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਸਰਬ ਨਿਰੰਤਰਿ ਰਾਮੁ ਰਹਿਆ ਰਵਿ ਐਸਾ ਰੂਪੁ ਬਖਾਨਿਆ ॥੧॥",
      "transliteration": "sarab nira(n)tar raam rahiaa rav aisaa roop bakhaaniaa ||1||",
      "translation": "The Lord is pervading and permeating amongst all; this is how His Form can be described. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਗੋਬਿਦੁ ਗਾਜੈ ਸਬਦੁ ਬਾਜੈ ॥",
      "transliteration": "gobid gaajai sabad baajai ||",
      "translation": "The Lord of the Universe appears when the Word of His Shabad is chanted.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਆਨਦ ਰੂਪੀ ਮੇਰੋ ਰਾਮਈਆ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "aanad roopee mero raamaeeaa ||1|| rahaau ||",
      "translation": "My Lord is the Embodiment of Bliss. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਬਾਵਨ ਬੀਖੂ ਬਾਨੈ ਬੀਖੇ ਬਾਸੁ ਤੇ ਸੁਖ ਲਾਗਿਲਾ ॥",
      "transliteration": "baavan beekhoo baanai beekhe baas te sukh laagilaa ||",
      "translation": "The beautiful fragrance of sandalwood emanates from the sandalwood tree, and attaches to the other trees of the forest.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਸਰਬੇ ਆਦਿ ਪਰਮਲਾਦਿ ਕਾਸਟ ਚੰਦਨੁ ਭੈਇਲਾ ॥੨॥",
      "transliteration": "sarabe aad paramalaad kaasat cha(n)dan bhaiilaa ||2||",
      "translation": "God, the Primal Source of everything, is like the sandalwood tree; He transforms us woody trees into fragrant sandalwood. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਤੁਮੑ ਚੇ ਪਾਰਸੁ ਹਮ ਚੇ ਲੋਹਾ ਸੰਗੇ ਕੰਚਨੁ ਭੈਇਲਾ ॥",
      "transliteration": "tumh che paaras ham che lohaa sa(n)ge ka(n)chan bhaiilaa ||",
      "translation": "You, O Lord, are the Philosopher's Stone, and I am iron; associating with You, I am transformed into gold.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਤੂ ਦਇਆਲੁ ਰਤਨੁ ਲਾਲੁ ਨਾਮਾ ਸਾਚਿ ਸਮਾਇਲਾ ॥੩॥੨॥",
      "transliteration": "too daiaal ratan laal naamaa saach samaailaa ||3||2||",
      "translation": "You are Merciful; You are the gem and the jewel. Naam Dayv is absorbed in the Truth. ||3||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ॥",
      "transliteration": "prabhaatee ||",
      "translation": "Prabhaatee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਅਕੁਲ ਪੁਰਖ ਇਕੁ ਚਲਿਤੁ ਉਪਾਇਆ ॥",
      "transliteration": "akul purakh ik chalit upaaiaa ||",
      "translation": "The Primal Being has no ancestry; He has staged this play.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਘਟਿ ਘਟਿ ਅੰਤਰਿ ਬ੍ਰਹਮੁ ਲੁਕਾਇਆ ॥੧॥",
      "transliteration": "ghat ghat a(n)tar braham lukaaiaa ||1||",
      "translation": "God is hidden deep within each and every heart. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਜੀਅ ਕੀ ਜੋਤਿ ਨ ਜਾਨੈ ਕੋਈ ॥",
      "transliteration": "jee kee jot na jaanai koee ||",
      "translation": "No one knows the Light of the soul.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਤੈ ਮੈ ਕੀਆ ਸੁ ਮਾਲੂਮੁ ਹੋਈ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "tai mai keeaa s maaloom hoee ||1|| rahaau ||",
      "translation": "Whatever I do, is known to You, Lord. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਜਿਉ ਪ੍ਰਗਾਸਿਆ ਮਾਟੀ ਕੁੰਭੇਉ ॥",
      "transliteration": "jiu pragaasiaa maatee ku(n)bheu ||",
      "translation": "Just as the pitcher is made from clay,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਆਪ ਹੀ ਕਰਤਾ ਬੀਠੁਲੁ ਦੇਉ ॥੨॥",
      "transliteration": "aap hee karataa beethul deu ||2||",
      "translation": "everything is made from the Beloved Divine Creator Himself. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਜੀਅ ਕਾ ਬੰਧਨੁ ਕਰਮੁ ਬਿਆਪੈ ॥",
      "transliteration": "jee kaa ba(n)dhan karam biaapai ||",
      "translation": "The mortal's actions hold the soul in the bondage of karma.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਜੋ ਕਿਛੁ ਕੀਆ ਸੁ ਆਪੈ ਆਪੈ ॥੩॥",
      "transliteration": "jo kichh keeaa s aapai aapai ||3||",
      "translation": "Whatever he does, he does on his own. ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਪ੍ਰਣਵਤਿ ਨਾਮਦੇਉ ਇਹੁ ਜੀਉ ਚਿਤਵੈ ਸੁ ਲਹੈ ॥",
      "transliteration": "pranavat naamadeu ihu jeeu chitavai s lahai ||",
      "translation": "Prays Naam Dayv, whatever this soul wants, it obtains.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਅਮਰੁ ਹੋਇ ਸਦ ਆਕੁਲ ਰਹੈ ॥੪॥੩॥",
      "transliteration": "amar hoi sad aakul rahai ||4||3||",
      "translation": "Whoever abides in the Lord, becomes immortal. ||4||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਪ੍ਰਭਾਤੀ ਭਗਤ ਬੇਣੀ ਜੀ ਕੀ ॥",
      "transliteration": "prabhaatee bhagat benee jee kee ||",
      "translation": "Prabhaatee, The Word Of Devotee Baynee Jee:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ੴ ਸਤਿਗੁਰ ਪ੍ਰਸਾਦਿ ॥",
      "transliteration": "ikOankaar satigur prasaad ||",
      "translation": "One Universal Creator God. By The Grace Of The True Guru:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਤਨਿ ਚੰਦਨੁ ਮਸਤਕਿ ਪਾਤੀ ॥",
      "transliteration": "tan cha(n)dan masatak paatee ||",
      "translation": "You rub your body with sandalwood oil, and place basil leaves on your forehead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਰਿਦ ਅੰਤਰਿ ਕਰ ਤਲ ਕਾਤੀ ॥",
      "transliteration": "rid a(n)tar kar tal kaatee ||",
      "translation": "But you hold a knife in the hand of your heart.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਠਗ ਦਿਸਟਿ ਬਗਾ ਲਿਵ ਲਾਗਾ ॥",
      "transliteration": "thag disat bagaa liv laagaa ||",
      "translation": "You look like a thug; pretending to meditate, you pose like a crane.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਦੇਖਿ ਬੈਸਨੋ ਪ੍ਰਾਨ ਮੁਖ ਭਾਗਾ ॥੧॥",
      "transliteration": "dekh baisano praan mukh bhaagaa ||1||",
      "translation": "You try to look like a Vaishnaav, but the breath of life escapes through your mouth. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਕਲਿ ਭਗਵਤ ਬੰਦ ਚਿਰਾਂਮੰ ॥",
      "transliteration": "kal bhagavat ba(n)d chiraa(n)ma(n) ||",
      "translation": "You pray for hours to God the Beautiful.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਕ੍ਰੂਰ ਦਿਸਟਿ ਰਤਾ ਨਿਸਿ ਬਾਦੰ ॥੧॥ ਰਹਾਉ ॥",
      "transliteration": "kroor disat rataa nis baada(n) ||1|| rahaau ||",
      "translation": "But your gaze is evil, and your nights are wasted in conflict. ||1||Pause||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਨਿਤਪ੍ਰਤਿ ਇਸਨਾਨੁ ਸਰੀਰੰ ॥",
      "transliteration": "nitaprat isanaan sareera(n) ||",
      "translation": "You perform daily cleansing rituals,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਦੁਇ ਧੋਤੀ ਕਰਮ ਮੁਖਿ ਖੀਰੰ ॥",
      "transliteration": "dui dhotee karam mukh kheera(n) ||",
      "translation": "wear two loin-cloths, perform religious rituals and put only milk in your mouth.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਰਿਦੈ ਛੁਰੀ ਸੰਧਿਆਨੀ ॥",
      "transliteration": "ridai chhuree sa(n)dhiaanee ||",
      "translation": "But in your heart, you have drawn out the sword.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਪਰ ਦਰਬੁ ਹਿਰਨ ਕੀ ਬਾਨੀ ॥੨॥",
      "transliteration": "par darab hiran kee baanee ||2||",
      "translation": "You routinely steal the property of others. ||2||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਸਿਲ ਪੂਜਸਿ ਚਕ੍ਰ ਗਣੇਸੰ ॥",
      "transliteration": "sil poojas chakr ganesa(n) ||",
      "translation": "You worship the stone idol, and paint ceremonial marks of Ganesha.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਨਿਸਿ ਜਾਗਸਿ ਭਗਤਿ ਪ੍ਰਵੇਸੰ ॥",
      "transliteration": "nis jaagas bhagat pravesa(n) ||",
      "translation": "You remain awake throughout the night, pretending to worship God.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਪਗ ਨਾਚਸਿ ਚਿਤੁ ਅਕਰਮੰ ॥",
      "transliteration": "pag naachas chit akarama(n) ||",
      "translation": "You dance, but your consciousness is filled with evil.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਏ ਲੰਪਟ ਨਾਚ ਅਧਰਮੰ ॥੩॥",
      "transliteration": "e la(n)pat naach adharama(n) ||3||",
      "translation": "You are lewd and depraved - this is such an unrighteous dance! ||3||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਮ੍ਰਿਗ ਆਸਣੁ ਤੁਲਸੀ ਮਾਲਾ ॥",
      "transliteration": "mrig aasan tulasee maalaa ||",
      "translation": "You sit on a deer-skin, and chant on your mala.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਕਰ ਊਜਲ ਤਿਲਕੁ ਕਪਾਲਾ ॥",
      "transliteration": "kar oojal tilak kapaalaa ||",
      "translation": "You put the sacred mark, the tilak, on your forehead.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਰਿਦੈ ਕੂੜੁ ਕੰਠਿ ਰੁਦ੍ਰਾਖੰ ॥",
      "transliteration": "ridai kooR ka(n)th rudraakha(n) ||",
      "translation": "You wear the rosary beads of Shiva around your neck, but your heart is filled with falsehood.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਰੇ ਲੰਪਟ ਕ੍ਰਿਸਨੁ ਅਭਾਖੰ ॥੪॥",
      "transliteration": "re la(n)pat krisan abhaakha(n) ||4||",
      "translation": "You are lewd and depraved - you do not chant God's Name. ||4||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਜਿਨਿ ਆਤਮ ਤਤੁ ਨ ਚੀਨੑਿਆ ॥",
      "transliteration": "jin aatam tat na cheenhiaa ||",
      "translation": "Whoever does not realize the essence of the soul",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਸਭ ਫੋਕਟ ਧਰਮ ਅਬੀਨਿਆ ॥",
      "transliteration": "sabh phokat dharam abeeniaa ||",
      "translation": "all his religious actions are hollow and false.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਕਹੁ ਬੇਣੀ ਗੁਰਮੁਖਿ ਧਿਆਵੈ ॥",
      "transliteration": "kahu benee guramukh dhiaavai ||",
      "translation": "Says Baynee, as Gurmukh, meditate.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1351_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਬਿਨੁ ਸਤਿਗੁਰ ਬਾਟ ਨ ਪਾਵੈ ॥੫॥੧॥",
      "transliteration": "bin satigur baat na paavai ||5||1||",
      "translation": "Without the True Guru, you shall not find the Way. ||5||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1351,
