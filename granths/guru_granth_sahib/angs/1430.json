{
  "granthId": "guru_granth_sahib",
  "granthName": "Sri Guru Granth Sahib Ji",
  "source": "SGGS",
  "ang": 1430,
  "lineCount": 57,
  "contentVersion": "3",
  "lines": [
    {
      "id": "sggs_ang_1430_line_0001",
      "lineIndex": 1,
      "gurmukhi": "ਪੰਚ ਰਾਗਨੀ ਸੰਗਿ ਉਚਰਹੀ ॥",
      "transliteration": "pa(n)ch raaganee sa(n)g ucharahee ||",
      "translation": "It is accompanied by the voices of its five Raaginis:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0002",
      "lineIndex": 2,
      "gurmukhi": "ਪ੍ਰਥਮ ਭੈਰਵੀ ਬਿਲਾਵਲੀ ॥",
      "transliteration": "pratham bhairavee bilaavalee ||",
      "translation": "First come Bhairavee, and Bilaavalee;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0003",
      "lineIndex": 3,
      "gurmukhi": "ਪੁੰਨਿਆਕੀ ਗਾਵਹਿ ਬੰਗਲੀ ॥",
      "transliteration": "pu(n)niaakee gaavahi ba(n)galee ||",
      "translation": "then the songs of Punni-aakee and Bangalee;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0004",
      "lineIndex": 4,
      "gurmukhi": "ਪੁਨਿ ਅਸਲੇਖੀ ਕੀ ਭਈ ਬਾਰੀ ॥",
      "transliteration": "pun asalekhee kee bhaee baaree ||",
      "translation": "and then Asalaykhee.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0005",
      "lineIndex": 5,
      "gurmukhi": "ਏ ਭੈਰਉ ਕੀ ਪਾਚਉ ਨਾਰੀ ॥",
      "transliteration": "e bhairau kee paachau naaree ||",
      "translation": "These are the five consorts of Bhairao.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0006",
      "lineIndex": 6,
      "gurmukhi": "ਪੰਚਮ ਹਰਖ ਦਿਸਾਖ ਸੁਨਾਵਹਿ ॥",
      "transliteration": "pa(n)cham harakh disaakh sunaavahi ||",
      "translation": "The sounds of Pancham, Harakh and Disaakh;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0007",
      "lineIndex": 7,
      "gurmukhi": "ਬੰਗਾਲਮ ਮਧੁ ਮਾਧਵ ਗਾਵਹਿ ॥੧॥",
      "transliteration": "ba(n)gaalam madh maadhav gaavahi ||1||",
      "translation": "the songs of Bangaalam, Madh and Maadhav. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0008",
      "lineIndex": 8,
      "gurmukhi": "ਲਲਤ ਬਿਲਾਵਲ ਗਾਵਹੀ ਅਪੁਨੀ ਅਪੁਨੀ ਭਾਂਤਿ ॥",
      "transliteration": "lalat bilaaval gaavahee apunee apunee bhaa(n)t ||",
      "translation": "Lalat and Bilaaval - each gives out its own melody.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0009",
      "lineIndex": 9,
      "gurmukhi": "ਅਸਟ ਪੁਤ੍ਰ ਭੈਰਵ ਕੇ ਗਾਵਹਿ ਗਾਇਨ ਪਾਤ੍ਰ ॥੧॥",
      "transliteration": "asat putr bhairav ke gaavahi gaain paatr ||1||",
      "translation": "when these eight sons of Bhairao are sung by accomplished musicians. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0010",
      "lineIndex": 10,
      "gurmukhi": "ਦੁਤੀਆ ਮਾਲਕਉਸਕ ਆਲਾਪਹਿ ॥",
      "transliteration": "duteeaa maalakausak aalaapahi ||",
      "translation": "In the second family is Maalakausak,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0011",
      "lineIndex": 11,
      "gurmukhi": "ਸੰਗਿ ਰਾਗਨੀ ਪਾਚਉ ਥਾਪਹਿ ॥",
      "transliteration": "sa(n)g raaganee paachau thaapahi ||",
      "translation": "who brings his five Raaginis:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0012",
      "lineIndex": 12,
      "gurmukhi": "ਗੋਂਡਕਰੀ ਅਰੁ ਦੇਵਗੰਧਾਰੀ ॥",
      "transliteration": "go(n)dakaree ar devaga(n)dhaaree ||",
      "translation": "Gondakaree and Dayv Gandhaaree,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0013",
      "lineIndex": 13,
      "gurmukhi": "ਗੰਧਾਰੀ ਸੀਹੁਤੀ ਉਚਾਰੀ ॥",
      "transliteration": "ga(n)dhaaree seehutee uchaaree ||",
      "translation": "the voices of Gandhaaree and Seehutee,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0014",
      "lineIndex": 14,
      "gurmukhi": "ਧਨਾਸਰੀ ਏ ਪਾਚਉ ਗਾਈ ॥",
      "transliteration": "dhanaasaree e paachau gaaee ||",
      "translation": "and the fifth song of Dhanaasaree.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0015",
      "lineIndex": 15,
      "gurmukhi": "ਮਾਲ ਰਾਗ ਕਉਸਕ ਸੰਗਿ ਲਾਈ ॥",
      "transliteration": "maal raag kausak sa(n)g laaee ||",
      "translation": "This chain of Maalakausak brings along :",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0016",
      "lineIndex": 16,
      "gurmukhi": "ਮਾਰੂ ਮਸਤਅੰਗ ਮੇਵਾਰਾ ॥",
      "transliteration": "maaroo masataa(n)g mevaaraa ||",
      "translation": "Maaroo, Masta-ang and Mayvaaraa,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0017",
      "lineIndex": 17,
      "gurmukhi": "ਪ੍ਰਬਲਚੰਡ ਕਉਸਕ ਉਭਾਰਾ ॥",
      "transliteration": "prabalacha(n)d kausak ubhaaraa ||",
      "translation": "Prabal, Chandakausak,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0018",
      "lineIndex": 18,
      "gurmukhi": "ਖਉਖਟ ਅਉ ਭਉਰਾਨਦ ਗਾਏ ॥",
      "transliteration": "khaukhat au bhauraanad gaae ||",
      "translation": "Khau, Khat and Bauraanad singing.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0019",
      "lineIndex": 19,
      "gurmukhi": "ਅਸਟ ਮਾਲਕਉਸਕ ਸੰਗਿ ਲਾਏ ॥੧॥",
      "transliteration": "asat maalakausak sa(n)g laae ||1||",
      "translation": "These are the eight sons of Maalakausak. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0020",
      "lineIndex": 20,
      "gurmukhi": "ਪੁਨਿ ਆਇਅਉ ਹਿੰਡੋਲੁ ਪੰਚ ਨਾਰਿ ਸੰਗਿ ਅਸਟ ਸੁਤ ॥",
      "transliteration": "pun aaiau hi(n)dol pa(n)ch naar sa(n)g asat sut ||",
      "translation": "Then comes Hindol with his five wives and eight sons;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0021",
      "lineIndex": 21,
      "gurmukhi": "ਉਠਹਿ ਤਾਨ ਕਲੋਲ ਗਾਇਨ ਤਾਰ ਮਿਲਾਵਹੀ ॥੧॥",
      "transliteration": "uthahi taan kalol gaain taar milaavahee ||1||",
      "translation": "it rises in waves when the sweet-voiced chorus sings. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0022",
      "lineIndex": 22,
      "gurmukhi": "ਤੇਲੰਗੀ ਦੇਵਕਰੀ ਆਈ ॥",
      "transliteration": "tela(n)gee devakaree aaee ||",
      "translation": "There come Taylangee and Darvakaree;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0023",
      "lineIndex": 23,
      "gurmukhi": "ਬਸੰਤੀ ਸੰਦੂਰ ਸੁਹਾਈ ॥",
      "transliteration": "basa(n)tee sa(n)door suhaaee ||",
      "translation": "Basantee and Sandoor follow;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0024",
      "lineIndex": 24,
      "gurmukhi": "ਸਰਸ ਅਹੀਰੀ ਲੈ ਭਾਰਜਾ ॥",
      "transliteration": "saras aheeree lai bhaarajaa ||",
      "translation": "then Aheeree, the finest of women.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0025",
      "lineIndex": 25,
      "gurmukhi": "ਸੰਗਿ ਲਾਈ ਪਾਂਚਉ ਆਰਜਾ ॥",
      "transliteration": "sa(n)g laaee paa(n)chau aarajaa ||",
      "translation": "These five wives come together.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0026",
      "lineIndex": 26,
      "gurmukhi": "ਸੁਰਮਾਨੰਦ ਭਾਸਕਰ ਆਏ ॥",
      "transliteration": "suramaana(n)d bhaasakar aae ||",
      "translation": "The sons: Surmaanand and Bhaaskar come,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0027",
      "lineIndex": 27,
      "gurmukhi": "ਚੰਦ੍ਰਬਿੰਬ ਮੰਗਲਨ ਸੁਹਾਏ ॥",
      "transliteration": "cha(n)drabi(n)b ma(n)galan suhaae ||",
      "translation": "Chandrabinb and Mangalan follow.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0028",
      "lineIndex": 28,
      "gurmukhi": "ਸਰਸਬਾਨ ਅਉ ਆਹਿ ਬਿਨੋਦਾ ॥",
      "transliteration": "sarasabaan au aahi binodaa ||",
      "translation": "Sarasbaan and Binodaa then come,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0029",
      "lineIndex": 29,
      "gurmukhi": "ਗਾਵਹਿ ਸਰਸ ਬਸੰਤ ਕਮੋਦਾ ॥",
      "transliteration": "gaavahi saras basa(n)t kamodaa ||",
      "translation": "and the thrilling songs of Basant and Kamodaa.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0030",
      "lineIndex": 30,
      "gurmukhi": "ਅਸਟ ਪੁਤ੍ਰ ਮੈ ਕਹੇ ਸਵਾਰੀ ॥",
      "transliteration": "asat putr mai kahe savaaree ||",
      "translation": "These are the eight sons I have listed.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0031",
      "lineIndex": 31,
      "gurmukhi": "ਪੁਨਿ ਆਈ ਦੀਪਕ ਕੀ ਬਾਰੀ ॥੧॥",
      "transliteration": "pun aaee deepak kee baaree ||1||",
      "translation": "Then comes the turn of Deepak. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0032",
      "lineIndex": 32,
      "gurmukhi": "ਕਛੇਲੀ ਪਟਮੰਜਰੀ ਟੋਡੀ ਕਹੀ ਅਲਾਪਿ ॥",
      "transliteration": "kachhelee patama(n)jaree todee kahee alaap ||",
      "translation": "Kachhaylee, Patamanjaree and Todee are sung;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0033",
      "lineIndex": 33,
      "gurmukhi": "ਕਾਮੋਦੀ ਅਉ ਗੂਜਰੀ ਸੰਗਿ ਦੀਪਕ ਕੇ ਥਾਪਿ ॥੧॥",
      "transliteration": "kaamodee au goojaree sa(n)g deepak ke thaap ||1||",
      "translation": "Kaamodee and Goojaree accompany Deepak. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0034",
      "lineIndex": 34,
      "gurmukhi": "ਕਾਲੰਕਾ ਕੁੰਤਲ ਅਉ ਰਾਮਾ ॥",
      "transliteration": "kaala(n)kaa ku(n)tal au raamaa ||",
      "translation": "Kaalankaa, Kuntal and Raamaa,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0035",
      "lineIndex": 35,
      "gurmukhi": "ਕਮਲਕੁਸਮ ਚੰਪਕ ਕੇ ਨਾਮਾ ॥",
      "transliteration": "kamalakusam cha(n)pak ke naamaa ||",
      "translation": "Kamalakusam and Champak are their names;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0036",
      "lineIndex": 36,
      "gurmukhi": "ਗਉਰਾ ਅਉ ਕਾਨਰਾ ਕਲੵਾਨਾ ॥",
      "transliteration": "gauraa au kaanaraa kalyaanaa ||",
      "translation": "Gauraa, Kaanaraa and Kaylaanaa;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0037",
      "lineIndex": 37,
      "gurmukhi": "ਅਸਟ ਪੁਤ੍ਰ ਦੀਪਕ ਕੇ ਜਾਨਾ ॥੧॥",
      "transliteration": "asat putr deepak ke jaanaa ||1||",
      "translation": "these are the eight sons of Deepak. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0038",
      "lineIndex": 38,
      "gurmukhi": "ਸਭ ਮਿਲਿ ਸਿਰੀਰਾਗ ਵੈ ਗਾਵਹਿ ॥",
      "transliteration": "sabh mil sireeraag vai gaavahi ||",
      "translation": "All join together and sing Siree Raag,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0039",
      "lineIndex": 39,
      "gurmukhi": "ਪਾਂਚਉ ਸੰਗਿ ਬਰੰਗਨ ਲਾਵਹਿ ॥",
      "transliteration": "paa(n)chau sa(n)g bara(n)gan laavahi ||",
      "translation": "which is accompanied by its five wives.:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0040",
      "lineIndex": 40,
      "gurmukhi": "ਬੈਰਾਰੀ ਕਰਨਾਟੀ ਧਰੀ ॥",
      "transliteration": "bairaaree karanaatee dharee ||",
      "translation": "Bairaaree and Karnaatee,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0041",
      "lineIndex": 41,
      "gurmukhi": "ਗਵਰੀ ਗਾਵਹਿ ਆਸਾਵਰੀ ॥",
      "transliteration": "gavaree gaavahi aasaavaree ||",
      "translation": "the songs of Gawree and Aasaavaree;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0042",
      "lineIndex": 42,
      "gurmukhi": "ਤਿਹ ਪਾਛੈ ਸਿੰਧਵੀ ਅਲਾਪੀ ॥",
      "transliteration": "tih paachhai si(n)dhavee alaapee ||",
      "translation": "then follows Sindhavee.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0043",
      "lineIndex": 43,
      "gurmukhi": "ਸਿਰੀਰਾਗ ਸਿਉ ਪਾਂਚਉ ਥਾਪੀ ॥੧॥",
      "transliteration": "sireeraag siu paa(n)chau thaapee ||1||",
      "translation": "These are the five wives of Siree Raag. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0044",
      "lineIndex": 44,
      "gurmukhi": "ਸਾਲੂ ਸਾਰਗ ਸਾਗਰਾ ਅਉਰ ਗੋਂਡ ਗੰਭੀਰ ॥",
      "transliteration": "saaloo saarag saagaraa aur go(n)d ga(n)bheer ||",
      "translation": "Saaloo, Saarang, Saagaraa, Gond and Gambheer",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0045",
      "lineIndex": 45,
      "gurmukhi": "ਅਸਟ ਪੁਤ੍ਰ ਸ੍ਰੀਰਾਗ ਕੇ ਗੁੰਡ ਕੁੰਭ ਹਮੀਰ ॥੧॥",
      "transliteration": "asat putr sreeraag ke gu(n)d ku(n)bh hameer ||1||",
      "translation": "- the eight sons of Siree Raag include Gund, Kumb and Hameer. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0046",
      "lineIndex": 46,
      "gurmukhi": "ਖਸਟਮ ਮੇਘ ਰਾਗ ਵੈ ਗਾਵਹਿ ॥",
      "transliteration": "khasatam megh raag vai gaavahi ||",
      "translation": "In the sixth place, Maygh Raag is sung,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0047",
      "lineIndex": 47,
      "gurmukhi": "ਪਾਂਚਉ ਸੰਗਿ ਬਰੰਗਨ ਲਾਵਹਿ ॥",
      "transliteration": "paa(n)chau sa(n)g bara(n)gan laavahi ||",
      "translation": "with its five wives in accompaniment:",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0048",
      "lineIndex": 48,
      "gurmukhi": "ਸੋਰਠਿ ਗੋਂਡ ਮਲਾਰੀ ਧੁਨੀ ॥",
      "transliteration": "sorath go(n)d malaaree dhunee ||",
      "translation": "Sorat'h, Gond, and the melody of Malaaree;",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0049",
      "lineIndex": 49,
      "gurmukhi": "ਪੁਨਿ ਗਾਵਹਿ ਆਸਾ ਗੁਨ ਗੁਨੀ ॥",
      "transliteration": "pun gaavahi aasaa gun gunee ||",
      "translation": "then the harmonies of Aasaa are sung.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0050",
      "lineIndex": 50,
      "gurmukhi": "ਊਚੈ ਸੁਰਿ ਸੂਹਉ ਪੁਨਿ ਕੀਨੀ ॥",
      "transliteration": "oochai sur soohau pun keenee ||",
      "translation": "And finally comes the high tone Soohau.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0051",
      "lineIndex": 51,
      "gurmukhi": "ਮੇਘ ਰਾਗ ਸਿਉ ਪਾਂਚਉ ਚੀਨੀ ॥੧॥",
      "transliteration": "megh raag siu paa(n)chau cheenee ||1||",
      "translation": "These are the five with Maygh Raag. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0052",
      "lineIndex": 52,
      "gurmukhi": "ਬੈਰਾਧਰ ਗਜਧਰ ਕੇਦਾਰਾ ॥",
      "transliteration": "bairaadhar gajadhar kedaaraa ||",
      "translation": "Bairaadhar, Gajadhar, Kaydaaraa,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0053",
      "lineIndex": 53,
      "gurmukhi": "ਜਬਲੀਧਰ ਨਟ ਅਉ ਜਲਧਾਰਾ ॥",
      "transliteration": "jabaleedhar nat au jaladhaaraa ||",
      "translation": "Jabaleedhar, Nat and Jaladhaaraa.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0054",
      "lineIndex": 54,
      "gurmukhi": "ਪੁਨਿ ਗਾਵਹਿ ਸੰਕਰ ਅਉ ਸਿਆਮਾ ॥",
      "transliteration": "pun gaavahi sa(n)kar au siaamaa ||",
      "translation": "Then come the songs of Shankar and Shi-aamaa.",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0055",
      "lineIndex": 55,
      "gurmukhi": "ਮੇਘ ਰਾਗ ਪੁਤ੍ਰਨ ਕੇ ਨਾਮਾ ॥੧॥",
      "transliteration": "megh raag putran ke naamaa ||1||",
      "translation": "These are the names of the sons of Maygh Raag. ||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0056",
      "lineIndex": 56,
      "gurmukhi": "ਖਸਟ ਰਾਗ ਉਨਿ ਗਾਏ ਸੰਗਿ ਰਾਗਨੀ ਤੀਸ ॥",
      "transliteration": "khasat raag un gaae sa(n)g raaganee tees ||",
      "translation": "So all together, they sing the six Raagas and the thirty Raaginis,",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    },
    {
      "id": "sggs_ang_1430_line_0057",
      "lineIndex": 57,
      "gurmukhi": "ਸਭੈ ਪੁਤ੍ਰ ਰਾਗੰਨ ਕੇ ਅਠਾਰਹ ਦਸ ਬੀਸ ॥੧॥੧॥",
      "transliteration": "sabhai putr raaga(n)n ke athaarah das bees ||1||1||",
      "translation": "and all the forty-eight sons of the Raagas. ||1||1||",
      "punjabiViakhya": "",
      "source": "SGGS",
      "ang": 1430,
      "hindi": "",
      "hindiTransliteration": ""
    }
  ]
}
